    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ashira_ltsur_nora_a_piyyut_for_hanukkah_by_salomon_berdugo_of_meknes">
        <tei:head>אָשִׁירָה לְצוּר נוֹרָא</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashira_ltsur_nora_a_piyyut_for_hanukkah_by_salomon_berdugo_of_meknes/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אָ</tei:seg>שִׁירָה לְצוּר נוֹרָא</tei:l>
          <tei:l>קָדוֹשׁ עוֹשֶׂה פְּלָאִים</tei:l>
          <tei:l>בְּכֹֽחַ וּבִגְבוּרָה</tei:l>
          <tei:l>הָרַס מִבְצְרֵי גֵּאִים</tei:l>
          <tei:l>קוֹנַי֘ שׂוֹטְנַי֘ מוֹנַי֘</tei:l>
          <tei:l>הִכּ֣וּנִי פְצָע֑וּנִי׃</tei:l>
          <tei:l>אֲרוֹמִמְךָ֣ יְ֭הֹוָה כִּ֣י דִלִּיתָ֑נִי׃ <tei:bibl>(תהלים ל:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashira_ltsur_nora_a_piyyut_for_hanukkah_by_salomon_berdugo_of_meknes/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נִ</tei:seg>סִּים גְּדוֹלִים עָשָׂה</tei:l>
          <tei:l>צוּר מַצְמִֽיחַ יְשׁוּעָה</tei:l>
          <tei:l>נָתַן צָרָיו לִמְשִׁסָה</tei:l>
          <tei:l>מַלְכוּת יָוָן הָרְשָׁעָה</tei:l>
          <tei:l>אָמְרוּ֘ עָרוּ֘ גָּזְרוּ֘</tei:l>
          <tei:l>דָּת לְהַעֲבִירֵֽנִי׃</tei:l>
          <tei:l>אֲרוֹמִמְךָ֣ יְ֭הֹוָה כִּ֣י דִלִּיתָ֑נִי׃ <tei:bibl>(תהלים ל:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashira_ltsur_nora_a_piyyut_for_hanukkah_by_salomon_berdugo_of_meknes/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>עֲצוּ עַל־עַמֵּֽנוּ</tei:l>
          <tei:l>בְּמִרְמָה וְתַחְבּוּלָה</tei:l>
          <tei:l>לְהָפֵר בְּרִיתֵֽנוּ</tei:l>
          <tei:l>שַׁבָּת רֹאשׁ חֹֽדֶשׁ מִילָה</tei:l>
          <tei:l>צוּרִי֘ נֵרִי֘ אוֹרִי֘</tei:l>
          <tei:l>לָאוֹרָה הוֹצִיאֵֽנִי׃</tei:l>
          <tei:l>אֲרוֹמִמְךָ֣ יְ֭הֹוָה כִּ֣י דִלִּיתָ֑נִי׃ <tei:bibl>(תהלים ל:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashira_ltsur_nora_a_piyyut_for_hanukkah_by_salomon_berdugo_of_meknes/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שִׁ</tei:seg>לֵּם גְּמוּלָם לָהֵם</tei:l>
          <tei:l>עַל־יַד בְּנֵי חַשְׁמוֹנַאי</tei:l>
          <tei:l>נָפְלוּ עַל־חֲלָלֵיהֶם</tei:l>
          <tei:l>בְּיַד עֲדַת כֹּהֲנַי</tei:l>
          <tei:l>שָׂחוּ֮ אָרְחוּ֘ בָּרְחוּ֘</tei:l>
          <tei:l>מְ֭רֵעִים הִקִּיפ֑וּנִי׃</tei:l>
          <tei:l>אֲרוֹמִמְךָ֣ יְ֭הֹוָה כִּ֣י דִלִּיתָ֑נִי׃ <tei:bibl>(תהלים ל:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashira_ltsur_nora_a_piyyut_for_hanukkah_by_salomon_berdugo_of_meknes/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">לֹ</tei:seg>א־נִמְצָא שֶֽׁמֶן זַֽיִת</tei:l>
          <tei:l>כִּי נִטְמְאָה הָעֲזָרָה</tei:l>
          <tei:l>וְזֹ֖את תּוֹרַ֥ת הַבָּֽיִת</tei:l>
          <tei:l>לְהַדְלִיק בּוֹ מְנוֹרָה</tei:l>
          <tei:l>בָּאוּ֘ רָאוּ֘ מָצְאוּ֘</tei:l>
          <tei:l>פַּךְ שֶֽׁמֶן בְּדוּכָנִי׃</tei:l>
          <tei:l>אֲרוֹמִמְךָ֣ יְ֭הֹוָה כִּ֣י דִלִּיתָ֑נִי׃ <tei:bibl>(תהלים ל:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashira_ltsur_nora_a_piyyut_for_hanukkah_by_salomon_berdugo_of_meknes/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מָ</tei:seg>צְאוּ בּוֹ שִׁיעוּר לַֽיְלָה</tei:l>
          <tei:l>לְנֵרוֹת מַעֲרָכָה</tei:l>
          <tei:l>גָּזַר נוֹרָא עֲלִילָה</tei:l>
          <tei:l>לִשְׁרוֹת בּוֹ הַבְּרָכָה</tei:l>
          <tei:l>חָזְקוּ֘ סָפְקוּ֘ דָּלְקוּ֘</tei:l>
          <tei:l>עַד־בֹּא יוֹם הַשְׁמִינִי׃</tei:l>
          <tei:l>אֲרוֹמִמְךָ֣ יְ֭הֹוָה כִּ֣י דִלִּיתָ֑נִי׃ <tei:bibl>(תהלים ל:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashira_ltsur_nora_a_piyyut_for_hanukkah_by_salomon_berdugo_of_meknes/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הֵ</tei:seg>ם קִבְּלוּ עֲלֵיהֶם</tei:l>
          <tei:l>אֶת־הַנֵּרוֹת הַלָּֽלוּ</tei:l>
          <tei:l>וְזַרְעָם אַחֲרֵיהֶם</tei:l>
          <tei:l>אֶת־הַיָּמִים הַלָּֽלוּ</tei:l>
          <tei:l>קָבְעוּ֘ זָעוּ֘ כָּרְעוּ֘</tei:l>
          <tei:l>לָאֵל בְּצָרוֹת עֲזָרָֽנִי׃</tei:l>
          <tei:l>אֲרוֹמִמְךָ֣ יְ֭הֹוָה כִּ֣י דִלִּיתָ֑נִי׃ <tei:bibl>(תהלים ל:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashira_ltsur_nora_a_piyyut_for_hanukkah_by_salomon_berdugo_of_meknes/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חֶֽ</tei:seg>סֶד אֵל כׇּל־הַיָּמִים</tei:l>
          <tei:l>לְדוֹר וָדוֹר הִגִּֽידוּ</tei:l>
          <tei:l>הַפּוֹדֶה</tei:l>
          <tei:l>מִיַּד קָמִים</tei:l>
          <tei:l>זֶ֭רַע אַבְרָהָ֣ם עַבְדּ֑וֹ</tei:l>
          <tei:l>גִּילוּ֘ סֹלוּ֘ חַלוּ֘</tei:l>
          <tei:l>פְּנֵי אֵל צוּר מָגִנִּי׃</tei:l>
          <tei:l>אֲרוֹמִמְךָ֣ יְ֭הֹוָה כִּ֣י דִלִּיתָ֑נִי׃ <tei:bibl>(תהלים ל:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashira_ltsur_nora_a_piyyut_for_hanukkah_by_salomon_berdugo_of_meknes/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זַ</tei:seg>מְּרוּ צוּר צְבָאוֹת</tei:l>
          <tei:l>גָ֘בַ֤ר עָלֵ֨ינוּ ׀ חַסְדּ֗וֹ</tei:l>
          <tei:l>נִסִּים וְגַם נִפְלָאוֹת</tei:l>
          <tei:l>גְּדוֹלוֹת לוֹ לְבַדּוֹ</tei:l>
          <tei:l>שִׁירָה֘ זִמְרָה֘ אוֹמְרָה֘</tei:l>
          <tei:l>לָאֵל בְּפִי וּלְשׁוֹנִי׃</tei:l>
          <tei:l>אֲרוֹמִמְךָ֣ יְ֭הֹוָה כִּ֣י דִלִּיתָ֑נִי׃ <tei:bibl>(תהלים ל:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashira_ltsur_nora_a_piyyut_for_hanukkah_by_salomon_berdugo_of_meknes/10"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ק</tei:seg>וּמָה נָא וּגְאָלֵֽנוּ</tei:l>
          <tei:l>גְּאֻלָּה הָעֲתִידָה</tei:l>
          <tei:l>וְקַבֵּץ פְּזוּרֵֽינוּ</tei:l>
          <tei:l>יִשְׂרָאֵל וִיהוּדָה</tei:l>
          <tei:l>שָׂא נֵס֘ שַׁנֵּס֘ כַּנֵּס֘</tei:l>
          <tei:l>לְבֵיתְךָ עֵֽדֶר צֹאנִי</tei:l>
          <tei:l>אָז בְּשִׁירָה לַיהוָה</tei:l>
          <tei:l>וְ֝רוֹמַ֗ם תַּ֣חַת לְשׁוֹנִֽי׃</tei:l>
          <tei:l>אֲרוֹמִמְךָ֣ יְ֭הֹוָה כִּ֣י דִלִּיתָ֑נִי׃ <tei:bibl>(תהלים ל:א)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
