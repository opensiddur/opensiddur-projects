    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_the_prosperity_of_his_royal_majesty_ii">
        <tei:head>הַנּוֹתֵן תְּשׁוּעָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_prosperity_of_his_royal_majesty_ii/1"/>
        <tei:lg>
          <tei:l>הַנּוֹתֵן תְּשׁוּעָה לַמְּלָכִים</tei:l>
          <tei:l>וּמֶמְשָׁלָה לַנְּסִיכִים</tei:l>
          <tei:l>[מַלְכוּתְךָ וּמֶמְשֶׁלְתְּךָ כָּל־עוֹלָמִים]</tei:l>
          <tei:l>הַפּוֹצֶה אֶת דָּוִד עַבְדּוֹ מֵחֶרֶב רָעָה</tei:l>
          <tei:l>הַנּוֹתֵן בַּיַם דֶרֶךְ</tei:l>
          <tei:l>וּבְמַיִם עַזִּים נְתִיבָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_prosperity_of_his_royal_majesty_ii/2"/>
        <tei:lg>
          <tei:l>הוּא יְבָרֵךְ וְיִשְׁמוֹר וְיַעֲזוֹר וִיגַדֵּל</tei:l>
          <tei:l>וִינַשֵּׂא לְמַֽעְלָה לְמַֽעְלָה לַאֲדוֹנֵנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_prosperity_of_his_royal_majesty_ii/3"/>
        <tei:lg>
          <tei:l>הַמֶּלֶךְ מַלְכֵי הַמְלָכִים</tei:l>
          <tei:l>בְּרַחֲמָיו</tei:l>
          <tei:l>יִשְׁמְרֶהוּ וִיחַיֵיהוּ וּמִכָּל צָרָה וָנֶזֶק יַצִילֵהוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_prosperity_of_his_royal_majesty_ii/4"/>
        <tei:lg>
          <tei:l>מֶֽלֶךְ מַלְכֵי הַמְלָכִים</tei:l>
          <tei:l>יָרִוּם וְיַגְבִּיהַ כּוֹכַב מַעֲרַכְתָּוֹ</tei:l>
          <tei:l>וְיַאֲרִיךְ יָמִים עַל מַמְלָכְתּוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_prosperity_of_his_royal_majesty_ii/5"/>
        <tei:lg>
          <tei:l>מֶלֶךְ מַלְכֵי הַמְלָכִים</tei:l>
          <tei:l>יִתֵּן בְּלבּוֹ</tei:l>
          <tei:l>וּבְּלֵב כָּל יוֹעֲצַיו וְשָׂרָיו</tei:l>
          <tei:l>רַחֲמָנוּת לַעֲשׂוֹת טוֹבָה עִמָּנוּ</tei:l>
          <tei:l>וְעִם כָּל יִשְּׂרָאֵל אַחֵינוּ</tei:l>
          <tei:l>אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
