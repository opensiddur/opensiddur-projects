  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:morning_prayer_creditor">
        <tei:head>Morning Prayer, by Rabbi Menachem Creditor</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:morning_prayer_creditor/1"/>
        <tei:lg>
          <tei:l>How grateful I am to You</tei:l>
          <tei:l>Source of my Soul</tei:l>
          <tei:l>for this breath</tei:l>
          <tei:l>inhaled amidst</tei:l>
          <tei:l>the brilliance of a new day.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:morning_prayer_creditor/2"/>
        <tei:lg>
          <tei:l>I am yet unaware</tei:l>
          <tei:l>what today holds</tei:l>
          <tei:l>but I am deeply aware</tei:l>
          <tei:l>of being held</tei:l>
          <tei:l>in Your light.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
