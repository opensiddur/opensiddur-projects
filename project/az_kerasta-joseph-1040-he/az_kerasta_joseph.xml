  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:az_kerasta_joseph">
        <tei:head>אָז כְּאֵרַֽשְׂתָּ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:az_kerasta_joseph/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אָ</tei:seg>ז כְּאֵרַֽשְׂתָּ בְּתוּלָה בְּמֹֽהַר וְקִדּוּשִׁים</tei:l>
          <tei:l>בְּ<tei:seg type="acrostic">אֶֽ</tei:seg>רֶץ פַּתְרוֹס הׇגְרָרָה בֵּין־קְדֵשִׁים</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>הַגִּֽיעַ זְמַן חֻפָּה בָּרִאשׁוֹן לֶחֳדָשִׁים</tei:l>
          <tei:l><tei:seg type="acrostic">בַּ</tei:seg>עֲדָהּ שַׁתָּה שַׁדְכָנִים יְשָׁרִים וּקְדוֹשִׁים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:az_kerasta_joseph/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">גָּֽ</tei:seg>שׁוּ אִי כַפְתּוֹר כְּהׇפְקְדוּ יְדִידִים</tei:l>
          <tei:l><tei:seg type="acrostic">גַּ</tei:seg>ם־הִרְצוּ דְבָרִים לְמִסְתּוֹלֵל וּגְדוּדִים</tei:l>
          <tei:l><tei:seg type="acrostic">דְּ</tei:seg>עוּ כִּי־עַלְמָה בְּבָתֵּיכֶם שׁוֹדְדִים</tei:l>
          <tei:l><tei:seg type="acrostic">דְּ</tei:seg>רוּשָׁה לְנִשּׂוּאִין וְעִתָּהּ עֵת דֹּדִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:az_kerasta_joseph/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הַ</tei:seg>מֶּֽלֶךְ הַקָּדוֹשׁ כְּמוֹ קִדְּשָׁהּ בַּחֲתֻנָּה</tei:l>
          <tei:l><tei:seg type="acrostic">הַ</tei:seg>רְבֵּה סִבְלוֹנוֹת שִׁגֵּר לָהּ בְּמַתָּנָה</tei:l>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>נִשְׁבַּע־לָהּ לְהַכְנִיסָהּ כְּשֶׁתַּעֲמֹד בְּאֵיתָנָהּ</tei:l>
          <tei:l><tei:seg type="acrostic">וּ</tei:seg>מֵאָז וְעַד־עַתָּה לְדוֹדָהּ הִמְתִּינָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:az_kerasta_joseph/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זְ</tei:seg>דוֹן לִבְּכֶם הִשִּׁיאֲכֶם הַמַּלְכָּה לִכְבּוֹשׁ</tei:l>
          <tei:l><tei:seg type="acrostic">זְ</tei:seg>מַנָּהּ לְהַעֲבִיר וּלְעַכְּבָהּ עַד־בּוֹשׁ</tei:l>
          <tei:l><tei:seg type="acrostic">חֽ</tei:seg>וּשׁוּ־נָא וְהֵחָלְצוּ מַכָּתָהּ לַחֲבוֹשׁ</tei:l>
          <tei:l><tei:seg type="acrostic">חָ</tei:seg>תָן פֶּן־יַעֲבֹר נָקָם יַֽעַט לִלְבֹּשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:az_kerasta_joseph/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">טָ</tei:seg>ף אֱוִיל וְהֵשִׁיב דִּבְרֵי מִרְמָה</tei:l>
          <tei:l><tei:seg type="acrostic">ט</tei:seg>וֹבַת־חֵן שֶׁאֲמַרְתֶּם מְצָאתִֽיהָ עֲרֻמָּה</tei:l>
          <tei:l><tei:seg type="acrostic">יְ</tei:seg>רוּדָה עַד־עָפָר פְּרוּעָה וּפְרוּמָה</tei:l>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>דֶֽיהָ אֲסוּרוֹת אֲבָל חֲכָמָה בְעׇרְמָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:az_kerasta_joseph/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כְּ</tei:seg>נַסְתִּֽיהָ בְּהֵיכָלִי כְּעֵין פַּרְתְּמִים וּפֶחָה</tei:l>
          <tei:l><tei:seg type="acrostic">כִּ</tei:seg>לְכַּלְתִּֽיהָ בְּרַעֲבוֹן פֶּן־נַפְשָׁהּ נָפֵחָה</tei:l>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>עֵת חֲזוֹתִי כִּי־גָדְלָה מִשְׁפָּחָה</tei:l>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>קַחְתִּֽיהָ בְּעַד־כַּסְפִּי הֱיוֹת־לִי לְשִׁפְחָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:az_kerasta_joseph/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מַ</tei:seg>ה־יִּקָּחֲךָ לִבְּךָ תֹּאֲנִים בַּהֲשִׁיבָךְ</tei:l>
          <tei:l><tei:seg type="acrostic">מָֽ</tei:seg>וֶת קְרָאַתְכֶם כִּכְלוֹת כׇּל־תְּנוּבָךְ</tei:l>
          <tei:l><tei:seg type="acrostic">נֻ</tei:seg>צַּלְתֶּם בְּחׇכְמָתָהּ וּפִֽיךָ עָנָה־בָךְ</tei:l>
          <tei:l><tei:seg type="acrostic">נָ</tei:seg>דַֽרְתָּ בִּרְצוֹנְךָ לְהוֹרִישָׁהּ כׇּל־טוּבָךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:az_kerasta_joseph/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">סֵֽ</tei:seg>פֶר מַתָּנָה הׇפְרַע־לָהּ בִּנְחִיצָה</tei:l>
          <tei:l><tei:seg type="acrostic">סֹ</tei:seg>ב הַיְצֵא כַלָּה מֵאַרְצְךָ חֽוּצָה</tei:l>
          <tei:l><tei:seg type="acrostic">עֲ</tei:seg>מָלָהּ תְּשַׁלֵּם אִם־תִּשְׁמַע לְעֵצָה</tei:l>
          <tei:l><tei:seg type="acrostic">עַ</tei:seg>ד לֹא־תִּתְחַבַּל בְּכָלָה וְנֶחֱרָצָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:az_kerasta_joseph/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פִּ</tei:seg>שְׁפַּֽשְׁתִּי בְּבֵית גְּנָזַי פִּנְקָסִים וּסְפָרִים</tei:l>
          <tei:l><tei:seg type="acrostic">פֶּ</tei:seg>ן־אֶמְצָא הֶחָתָן שָׁאַתֶּם מְסַפְּרִים</tei:l>
          <tei:l><tei:seg type="acrostic">צָ</tei:seg>בָא הֲיֵשׁ־לוֹ וַעֲיָרִים וּכְפָרִים</tei:l>
          <tei:l><tei:seg type="acrostic">צִ</tei:seg>פִּֽיתִי וָאַֽיִן שְׁעוּ־לָכֶם עֳפָרִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:az_kerasta_joseph/10"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>צַֽפְתָּ בְּנִבְלוּת־פֶּה וּקְלוֹנְךָ נִתְגַּלָּה</tei:l>
          <tei:l><tei:seg type="acrostic">קְ</tei:seg>דוֹשֵֽׁנוּ רַב־חֵילוֹ וּמְפֹאָר בַּעֲגֻלָּה</tei:l>
          <tei:l><tei:seg type="acrostic">רִ</tei:seg>יב כְּהִתְגַּלַּע נוֹדַע לְמִי הַסְּגֻלָּה</tei:l>
          <tei:l><tei:seg type="acrostic">רִ</tei:seg>דְתְּךָ לְסוֹף בְּעַצְמְךָ לְהִשְׁתַּחֲוֹת לְרַגְלָהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:az_kerasta_joseph/11"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שֹֽׁ</tei:seg>רֶשׁ נָחָשׁ בְּשׇׁמְעוֹ מַאֲמַר פֵּרוּשָׁם</tei:l>
          <tei:l><tei:seg type="acrostic">שָׁ</tei:seg>ב וְהִתְעַבֵּר וְצִוָּה חוּצָה לְגׇרְשָׁם</tei:l>
          <tei:l><tei:seg type="acrostic">תִּ</tei:seg>כְבַּד הָעֲבוֹדָה עֲלֵי כַלָּה כְּהֻרְשָׁם</tei:l>
          <tei:l><tei:seg type="acrostic">תְּ</tei:seg>אוֹמִים סִפְּרוּ מַעֲשֶׂה לַהוֹלֵךְ בְּרֹאשָׁם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:az_kerasta_joseph/12"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>רַד וְהִתְאִיר חֲנִית מַסָּע וְשִׁרְיָה</tei:l>
          <tei:l><tei:seg type="acrostic">וַ</tei:seg>יִּשְׁלַח חִצָּיו לַהֲפוֹךְ עִיר וְקִרְיָה</tei:l>
          <tei:l><tei:seg type="acrostic">סִ</tei:seg>בְּבוּם עֲשָׂרָה עֵדִים בְּמַכָּה טְרִיָּה</tei:l>
          <tei:l><tei:seg type="acrostic">פָּֽ</tei:seg>צוּ צְאִי כַלָּה עֲנֵפָה וּפֹרִיָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:az_kerasta_joseph/13"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בִּ</tei:seg>מְחוֹל מְשַׂחֲקִים אָז־יָצְתָה אֲהוּבָה</tei:l>
          <tei:l><tei:seg type="acrostic">נ</tei:seg>וֹהֶֽגֶת לִרְקָמוֹת עִם־כַּסְפָּהּ וּזְהָבָהּ</tei:l>
          <tei:l><tei:seg type="acrostic">שׁ</tei:seg>וֹדְדִים בַּחֲזוֹתָם בָּעֲרָה בָם לֶהָבָה</tei:l>
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>הֲרוּ לִרְדּוֹף כִּי־שָׁבְתָה מַדְהֵבָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:az_kerasta_joseph/14"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וַ</tei:seg>יִּגְעַר בְּיַם־סוּף וַיִּדְרְכוּ בְנַעֲלָם</tei:l>
          <tei:l><tei:seg type="acrostic">א</tei:seg>וֹיְבִים הִטְבִּֽיעַ וְהִמְצִיאָם כְּפִי־פׇעֳלָם</tei:l>
          <tei:l><tei:seg type="acrostic">לָ</tei:seg>כֵן שׁוֹרְרוּ יְדִידִים לְמֶֽלֶךְ נֶעֱלָם</tei:l>
          <tei:l>עוֹזֵר אֲבוֹתֵֽינוּ אַתָּה הוּא מֵעוֹלָם׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
