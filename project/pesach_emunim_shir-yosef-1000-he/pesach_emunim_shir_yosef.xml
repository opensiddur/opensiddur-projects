    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:pesach_emunim_shir_yosef">
        <tei:head>פֶּֽסַח אֱמוּנִים שִׁיר</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:pesach_emunim_shir_yosef/1"/>
        <tei:lg>
          <tei:l>פֶּֽסַח <tei:seg type="acrostic">אֱ</tei:seg>מוּנִים שִׁיר שׁוֹרֲרֽוּהוּ</tei:l>
          <tei:l>וַיּֽוֹשַׁע יְיָ בַּיּוֹם הַהוּא</tei:l>
          <tei:l>פֶּֽסַח מִצְרָֽיִם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:pesach_emunim_shir_yosef/2"/>
        <tei:lg>
          <tei:l>פֶּֽסַח <tei:seg type="acrostic">בַּ</tei:seg>ת קוֹל יִשָּׁמַע מִמְּרוֹמִים</tei:l>
          <tei:l>יִשְׂרָאֵל נוֹשַע בַּיָי תְּשׁוּעַת עוֹלָמִים <tei:bibl>(ישעיה מה:יז)</tei:bibl></tei:l>
          <tei:l>פֶּֽסַח לֶעָתִיד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:pesach_emunim_shir_yosef/3"/>
        <tei:lg>
          <tei:l>פֶּֽסַח <tei:seg type="acrostic">גְ</tei:seg>אוּלִים עָבְרוּ בְּמַשְׂאַת יָד</tei:l>
          <tei:l>וַיַּרְא יִשְׂרָאֵל אֶת הַיָּד</tei:l>
          <tei:l>פֶּֽסַח מִצְרָֽיִם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:pesach_emunim_shir_yosef/4"/>
        <tei:lg>
          <tei:l>פֶּֽסַח <tei:seg type="acrostic">דָּ</tei:seg>גוּל בְּעֹז כְּבוֹדוֹ</tei:l>
          <tei:l>יוֹסִיף אֲדֹנָי שֵׁנִית יָדוֹ</tei:l>
          <tei:l>פֶּֽסַח לֶעָתִיד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:pesach_emunim_shir_yosef/5"/>
        <tei:lg>
          <tei:l>פֶּֽסַח <tei:seg type="acrostic">הֲ</tei:seg>מוֹן חֲיָלָיו בְּטוּב דַּיָּם</tei:l>
          <tei:l>הָלְכוּ בַיַּבָּשָׁה בְּתוֹךְ הַיָּם</tei:l>
          <tei:l>פֶּֽסַח מִצְרָֽיִם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:pesach_emunim_shir_yosef/6"/>
        <tei:lg>
          <tei:l>פֶּֽסַח <tei:seg type="acrostic">וְ</tei:seg>הֵנִיף יָדוֹ בְּרֽוּחַ בַּעְיָם</tei:l>
          <tei:l>וְהֶחֱרִים יְיָ אֵת לְשׁוֹן יָם <tei:bibl>(ישעיה טו:יא)</tei:bibl></tei:l>
          <tei:l>פֶּֽסַח לֶעָתִיד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:pesach_emunim_shir_yosef/7"/>
        <tei:lg>
          <tei:l>פֶּֽסַח <tei:seg type="acrostic">זִ</tei:seg>לְעַף בְּמִכְתָּב שֻׁנָּן</tei:l>
          <tei:l>מַחֲנֵה מִצְרַֽיִם בְּעַמּוּד אֵשׁ וְעָנָן</tei:l>
          <tei:l>פֶּֽסַח מִצְרָֽיִם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:pesach_emunim_shir_yosef/8"/>
        <tei:lg>
          <tei:l>פֶּֽסַח <tei:seg type="acrostic">חִ</tei:seg>דּוּשׁ מוֹפֵת עֲלֵי יָשָׁן</tei:l>
          <tei:l>דָּם וָאֵשׁ וְתִימְרוֹת עָשָׁן</tei:l>
          <tei:l>פֶּֽסַח לֶעָתִיד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:pesach_emunim_shir_yosef/9"/>
        <tei:lg>
          <tei:l>פֶּֽסַח <tei:seg type="acrostic">טִ</tei:seg>כֵּם בְּצָרָיו לְהַחֲרִֽימָה</tei:l>
          <tei:l>וּבְנֵי יִשְׂרָאֵל יוֹצְאִים בְּיָד רָמָה</tei:l>
          <tei:l>פֶּֽסַח מִצְרָֽיִם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:pesach_emunim_shir_yosef/10"/>
        <tei:lg>
          <tei:l>פֶּֽסַח <tei:seg type="acrostic">יֶֽ</tei:seg>שַׁע וְתַעֲצוּם שָׁלוֹם</tei:l>
          <tei:l>בְּשִׂמְחָה תֵצֵֽאוּ וּבְשָׁלוֹם</tei:l>
          <tei:l>פֶּֽסַח לֶעָתִיד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:pesach_emunim_shir_yosef/11"/>
        <tei:lg>
          <tei:l>פֶּֽסַח <tei:seg type="acrostic">כְּ</tei:seg>לִיל עֲנָמִים לְהַצְמֵת</tei:l>
          <tei:l>כִּי אֵין בַּֽיִת אֲשֶׁר אֵין שָׁם מֵת</tei:l>
          <tei:l>פֶּֽסַח מִצְרָֽיִם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:pesach_emunim_shir_yosef/12"/>
        <tei:lg>
          <tei:l>פֶּֽסַח <tei:seg type="acrostic">לְ</tei:seg>אֻמִּים יֶהְגּוּ רִיק לְנָגְפָה</tei:l>
          <tei:l>וְזֹאת תִּהְיֶה הַמַּגֵּפָה <tei:bibl>(זכריה יד:יט)</tei:bibl></tei:l>
          <tei:l>פֶּֽסַח לֶעָתִיד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:pesach_emunim_shir_yosef/13"/>
        <tei:lg>
          <tei:l>פֶּֽסַח <tei:seg type="acrostic">מִ</tei:seg>לּוּי שְׁעָרִים פָתַח</tei:l>
          <tei:l>וּפָסַח יְיָ עַל הַפֶּֽתַח</tei:l>
          <tei:l>פֶּֽסַח מִצְרָֽיִם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:pesach_emunim_shir_yosef/14"/>
        <tei:lg>
          <tei:l>פֶּֽסַח <tei:seg type="acrostic">נ</tei:seg>וֹרָאוֹת עִזּוּז רַב וְשַׁלִּיט</tei:l>
          <tei:l>גָּנוֹן וְהִצִּיל פָּסֽוֹחַ וְהִמְלִיט</tei:l>
          <tei:l>פֶּֽסַח לֶעָתִיד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:pesach_emunim_shir_yosef/15"/>
        <tei:lg>
          <tei:l>פֶּֽסַח <tei:seg type="acrostic">סְ</tei:seg>גוּלִים לְמַטַּע שִׁירָֽיִם</tei:l>
          <tei:l>כִּי יְיָ נִלְחָם לָהֶם בְּמִצְרָֽיִם</tei:l>
          <tei:l>פֶּֽסַח מִצְרָֽיִם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:pesach_emunim_shir_yosef/16"/>
        <tei:lg>
          <tei:l>פֶּֽסַח <tei:seg type="acrostic">עָ</tei:seg>תִיד לְפִדְיוֹן שְׁבוּיִם</tei:l>
          <tei:l>וְיָצָא יְיָ וְנִלְחַם בַּגוֹיִם</tei:l>
          <tei:l>פֶּֽסַח לֶעָתִיד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:pesach_emunim_shir_yosef/17"/>
        <tei:lg>
          <tei:l>פֶּֽסַח <tei:seg type="acrostic">פְּ</tei:seg>תִיחַת קוֹל עָנְתָה נְבִיאָה</tei:l>
          <tei:l>שִֽׁירוּ לַיְיָ כִּי גָאֹה גָּאָה <tei:bibl>(שמות טו:כא)</tei:bibl></tei:l>
          <tei:l>פֶּֽסַח מִצְרָֽיִם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:pesach_emunim_shir_yosef/18"/>
        <tei:lg>
          <tei:l>פֶּֽסַח <tei:seg type="acrostic">צָ</tei:seg>פוּי בְּאוֹת אֲשֶׁר נַעֲשָׂה</tei:l>
          <tei:l>זַמְּרוּ יְיָ כִּי גֵאוּת עָשָׂה</tei:l>
          <tei:l>פֶּֽסַח לֶעָתִיד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:pesach_emunim_shir_yosef/19"/>
        <tei:lg>
          <tei:l>פֶּֽסַח <tei:seg type="acrostic">קִ</tei:seg>דֵּר לְצָרָיו מְאֽוֹרֵי אוֹר</tei:l>
          <tei:l>וּלְכׇל בְּנֵי יִשְׂרָאֵל הָֽיָה אוֹר</tei:l>
          <tei:l>פֶּֽסַח מִצְרָֽיִם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:pesach_emunim_shir_yosef/20"/>
        <tei:lg>
          <tei:l>פֶּֽסַח <tei:seg type="acrostic">רָ</tei:seg>צוּי בְּמַאֲמַר צוּרֵךְ</tei:l>
          <tei:l>קֽוּמִי אֽוֹרִי כִּי בָא אוֹרֵךְ</tei:l>
          <tei:l>פֶּֽסַח לֶעָתִיד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:pesach_emunim_shir_yosef/21"/>
        <tei:lg>
          <tei:l>פֶּֽסַח <tei:seg type="acrostic">שִׁ</tei:seg>בְּחֽוּהוּ בְּעֹז תַּעֲצוּמוֹ</tei:l>
          <tei:l>כִּי פָקַד יְיָ אֶת עַמּוֹ</tei:l>
          <tei:l>פֶּֽסַח מִצְרָֽיִם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:pesach_emunim_shir_yosef/22"/>
        <tei:lg>
          <tei:l>פֶּֽסַח <tei:seg type="acrostic">תֹּֽ</tei:seg>קֶף תּהִלּוֹת רִשּׁוּמוֹ</tei:l>
          <tei:l>גּוֹאֲלֵֽנוּ יְיָ צְבָאוֹת שְׁמוֹ</tei:l>
          <tei:l>פֶּֽסַח לֶעָתִיד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:pesach_emunim_shir_yosef/23"/>
        <tei:lg>
          <tei:l>פֶּֽסַח יוֹסֵף עַל יְשׁוּעוֹת יְשׁוּעָה.</tei:l>
          <tei:l>בְּרִיתוֹ יִזְכּוֹר לְהושִֽׁיעָה</tei:l>
          <tei:l>עַם קְרוֹבוֹ בְּאַֽהַב לְהִוָּשֵֽׁעָה</tei:l>
          <tei:l>כַּאֲשֶׁר שֵֽׁמַע לְמִצְרַֽיִם לְצוֹר נִשְׁמָֽעָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:pesach_emunim_shir_yosef/24"/>
        <tei:lg>
          <tei:l>בְּגִילָה ‎בְּרִנָּה בְּשִׂמְחָה רַבָּה וְאָמְרוּ כֻלָּם...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
