      <tei:div corresp="urn:x-opensiddur:text:prayer:ochilah_lael_goldman">
        <tei:head>אוֹחִילָה לָאֵל</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ochilah_lael_goldman/5"/>
        <tei:lg>
          <tei:l>אוֹחִילָה לָאֵל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ochilah_lael_goldman/6"/>
        <tei:lg>
          <tei:l>אוֹחִילָה לָאֵל</tei:l>
          <tei:l>אֲחַלֶּה פָנָיו</tei:l>
          <tei:l>אֶשְׁאֲלָה מִמֶּנּוּ מַעֲנֵה לָשׁוֹן</tei:l>
          <tei:l>אֲשֶׁר בִּקְהַל עָם אָשִׁיר עֻזּוֹ</tei:l>
          <tei:l>אַבִּיעָה רְנָנוֹת בְּעַד מִפְעָלָיו</tei:l>
          <tei:l>לְאָדָם מַעַרְכֵי לֵב וּמֵה׳ מַעֲנֵה לָשׁוֹן</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
