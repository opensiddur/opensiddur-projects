    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_the_children_of_the_world_hefetz">
        <tei:head>תפילה למען ילדי העולם</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_children_of_the_world_hefetz/1"/>
        <tei:lg>
          <tei:l>אֲדוֹן כׇּל הַבְּרוּאִים, מֶלֶךְ שֶׁהַשָּׁלוֹם שֶׁלּוֹ,</tei:l>
          <tei:l>בָּרֵךְ אֶת יְלָדֵינוּ וְאֶת יַלְדֵי כׇּל הָעוֹלָם</tei:l>
          <tei:l>בִּבְרִיאוּת הַגּוּף, בְּרִיאוּת הַנֶּפֶשׁ וּבְרִיאוּת הָרוּחַ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_children_of_the_world_hefetz/2"/>
        <tei:lg>
          <tei:l>אַתָּה שֶׁבָּרָאתָ אוֹתָם בְּצַלְמֶךָ,</tei:l>
          <tei:l>וּבְאַהֲבָה רַבָּה נָפַחְתָּ בָּם רוּחֲךָ</tei:l>
          <tei:l>הַצְלַח דָּרְכָם בְּעוֹלָמְךָ אֲשֶׁר בָּרָאתָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_children_of_the_world_hefetz/3"/>
        <tei:lg>
          <tei:l>הָרֵק מֵחָסְנֶךָ עֲלֵיהֶם וְחָזֵק בְּרִיחֵי גּוּפָם וְנַפְשָׁם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_children_of_the_world_hefetz/4"/>
        <tei:lg>
          <tei:l>הֶיֵה שׁוֹמְרָם וּמַצִּילָם מִיַּד רְשָׁעָה,</tei:l>
          <tei:l>כִּי רַב חֶסֶד וְאֱמֶת אַתָּה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_children_of_the_world_hefetz/5"/>
        <tei:lg>
          <tei:l>שִׂים שָׁלוֹם בָּאָרֶץ וְשִׂמְחַת עוֹלָם לְכׇל יוֹשְׁבֶיהָ.</tei:l>
          <tei:l>אָמֵן, כֵּן יְהִי רָצוֹן.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
