    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:weekday_affirmations_based_on_the_amidah_schachter_shalomi">
        <tei:head>עמידה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_affirmations_based_on_the_amidah_schachter_shalomi/3"/>
        <tei:lg>
          <tei:l>אָבוֹת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_affirmations_based_on_the_amidah_schachter_shalomi/4"/>
        <tei:lg>
          <tei:l>תְּחִיָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_affirmations_based_on_the_amidah_schachter_shalomi/5"/>
        <tei:lg>
          <tei:l>קְדֻשָּׁה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_affirmations_based_on_the_amidah_schachter_shalomi/6"/>
        <tei:lg>
          <tei:l>שׁוֹבֵר אוֹיְבִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_affirmations_based_on_the_amidah_schachter_shalomi/7"/>
        <tei:lg>
          <tei:l>אַתָּה חוֹנֵן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_affirmations_based_on_the_amidah_schachter_shalomi/8"/>
        <tei:lg>
          <tei:l>הֲשִׁיבֵנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_affirmations_based_on_the_amidah_schachter_shalomi/9"/>
        <tei:lg>
          <tei:l>סְלִיחָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_affirmations_based_on_the_amidah_schachter_shalomi/10"/>
        <tei:lg>
          <tei:l>גְּאֻלָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_affirmations_based_on_the_amidah_schachter_shalomi/11"/>
        <tei:lg>
          <tei:l>רְפוּאָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_affirmations_based_on_the_amidah_schachter_shalomi/12"/>
        <tei:lg>
          <tei:l>בְּרָכָה, מָשִׁיחַ, שְׁכִינָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_affirmations_based_on_the_amidah_schachter_shalomi/13"/>
        <tei:lg>
          <tei:l>קִבּוּץ גָּלוּיוֹת, יְרוּשָׁלַיִם, מוֹדִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_affirmations_based_on_the_amidah_schachter_shalomi/14"/>
        <tei:lg>
          <tei:l>צְדָקָה וּמִשְּׁפַּת, צַדִּיקִים, שָׁלוֹם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_affirmations_based_on_the_amidah_schachter_shalomi/15"/>
        <tei:lg>
          <tei:l>שׁוֹמֵעַ תְּפִלָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_affirmations_based_on_the_amidah_schachter_shalomi/16"/>
        <tei:lg>
          <tei:l>אָמֵן...אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
