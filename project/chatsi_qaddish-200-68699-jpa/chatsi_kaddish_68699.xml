  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:chatsi_kaddish_68699">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:chatsi_kaddish_68699/1"/>
        <tei:lg>
          <tei:l>יִתְגַּדַּל וְיִתְֿקַדַּשׁ</tei:l>
          <tei:l>שְׁמֵיהּ רַבָּא אָמֵן</tei:l>
          <tei:l>בְּעָלְמָא דִּי בְֿרָא</tei:l>
          <tei:l>כִֿרְעוּתֵֿיהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:chatsi_kaddish_68699/2"/>
        <tei:lg>
          <tei:l>וְיַמְלִיךְ מַלְכוּתֵיה</tei:l>
          <tei:l>בְּחַיֵּיכוֹן וּבְֿיוֹמֵיכֿוֹן</tei:l>
          <tei:l>וּבְחַיֵּי דְּכָֿל בֵּית יִשְׂרָאֵל</tei:l>
          <tei:l>בַּעֲגָֿלָא וּבִֿזְמַן קָרִיב׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:chatsi_kaddish_68699/3"/>
        <tei:lg>
          <tei:l>אָמֵן</tei:l>
          <tei:l>יְהֵא שְׁמֵיהּ רַבָּא מְבָֿרַךְ</tei:l>
          <tei:l>לְעָלַם וּלְעָלְמֵי עָלְמַיָּא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:chatsi_kaddish_68699/4"/>
        <tei:lg>
          <tei:l>יִתְֿבָּרַךְ אָמֵן</tei:l>
          <tei:l>וְיִשְׁתַּבַּח וְיִתְֿפָאַר</tei:l>
          <tei:l>וְיִתְֿרוֹמָם וְיִתְֿנַשֵׂא</tei:l>
          <tei:l>וְיִתְֿהַדַּר וְיִתְֿעַלֶּה וְיִתְֿקַלֵּס</tei:l>
          <tei:l>שְׁמֵיה דְּקוּדְֿשָׁא</tei:l>
          <tei:l>בְּרִיךְ הוּא</tei:l>
          <tei:l>לְעֵילָּא</tei:l>
          <tei:l>מִכָּל בִּרְכָתָֿא שִׁירָתָֿא</tei:l>
          <tei:l>וְתּוּשְׁבְּחָתָֿא וְנֶחָמָתָֿא</tei:l>
          <tei:l>דַּאֲמִירָן בְּעָלְמָא</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
