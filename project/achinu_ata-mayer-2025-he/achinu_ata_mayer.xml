    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:achinu_ata_mayer">
        <tei:head>אָחִֽינוּ אַתָּה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:achinu_ata_mayer/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אַ</tei:seg>בְרָהָם הוּא אָבִֽיךָ אִמְּךָ הִיא שָׂרָה.</tei:l>
          <tei:l>אָחִֽינוּ אַתָּה! אָחִֽינוּ אַתָּה!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:achinu_ata_mayer/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בָּ</tei:seg>רוּךְ הַמְּקַבֵּל עֹל מִצְוֺת הַתּוֹרָה.</tei:l>
          <tei:l>אָחִֽינוּ אַתָּה! אָחִֽינוּ אַתָּה!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:achinu_ata_mayer/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">גָּ</tei:seg>ר כָּאֶזְרָח כֵּן כָּתוּב בַּמִּקְרָא.</tei:l>
          <tei:l>אָחִֽינוּ אַתָּה! אָחִֽינוּ אַתָּה!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:achinu_ata_mayer/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">דַּ</tei:seg>ם בְּרִית הִטַּֽפְתָּ לַמִּילָה הַטְּהוֹרָה.</tei:l>
          <tei:l>אָחִֽינוּ אַתָּה! אָחִֽינוּ אַתָּה!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:achinu_ata_mayer/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הֵ</tei:seg>״א מִיּוֹ״ד הֵ״א לַקּוֹנֶה הַמְּעָרָה.</tei:l>
          <tei:l>אָחִֽינוּ אַתָּה! אָחִֽינוּ אַתָּה!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:achinu_ata_mayer/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וָ</tei:seg>י״ו הֵ״א נָתַן הֵ״א לָאֵם וְהוֹרָה.</tei:l>
          <tei:l>אָחִֽינוּ אַתָּה! אָחִֽינוּ אַתָּה!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:achinu_ata_mayer/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זְ</tei:seg>כׇר־נָא עַמִּי אַל־תִּלְחַץ פֶּן־יִקְרָא.</tei:l>
          <tei:l>אָחִֽינוּ אַתָּה! אָחִֽינוּ אַתָּה!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:achinu_ata_mayer/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ח</tei:seg>וֹבֵב הַגֵּרִים הַגִּבּוֹר וְנוֹרָא.</tei:l>
          <tei:l>אָחִֽינוּ אַתָּה! אָחִֽינוּ אַתָּה!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:achinu_ata_mayer/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">טֻ</tei:seg>מְאָתְךָ הִשְׁלַֽחְתָּ בִּטְבִילָה בָּרָה.</tei:l>
          <tei:l>אָחִֽינוּ אַתָּה! אָחִֽינוּ אַתָּה!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:achinu_ata_mayer/10"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יְ</tei:seg>הוּדִי אַתָּה בְּשִׂמְחָה וְאוֹרָה.</tei:l>
          <tei:l>אָחִֽינוּ אַתָּה! אָחִֽינוּ אַתָּה!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:achinu_ata_mayer/11"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כֵּ</tei:seg>ן עֲמֹד פלוני בֶּן־אַבְרָהָם עוֹלֶה לַתּוֹרָה!</tei:l>
          <tei:l>אָחִֽינוּ אַתָּה! אָחִֽינוּ אַתָּה!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
