    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:eshet_neurim_haahuvah_yom">
        <tei:head>אֵשֶׁת נְעוּרִים הָאֲהוּבָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eshet_neurim_haahuvah_yom/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אֵ</tei:seg>שֶׁת נְעוּרִים הָאֲהוּבָה</tei:l>
          <tei:l>אֲשֶׁר אֵרַשְׂתָּ בְּרֹב מֹהַר וְרֹב טוֹבָה</tei:l>
          <tei:l>וְאֵיךְ עַתָּה יוֹשֶׁבֶת עֲלוּבָה</tei:l>
          <tei:l>גְּעוּלָה וּמְאוּסָה וַעֲזוּבָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eshet_neurim_haahuvah_yom/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>בוּשָׁהּ בַּעֲדִי עֲדָיִים</tei:l>
          <tei:l>אֲשֶׁר הִתְנֵיתָ בִּבְרִית וּבִתְנָאִים</tei:l>
          <tei:l>וְאֵיךְ עַתָּה סוֹבֶבֶת דְּלָתַיִם</tei:l>
          <tei:l>וְשׁוֹכֶבֶת בֵּין שְׁפַתָּיִם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eshet_neurim_haahuvah_yom/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חֲ</tei:seg>בוּשָׁה בְּשֵׁשׁ וּמֶשִׁי כְּלוּלָה</tei:l>
          <tei:l>הִיא הָיְתָה בְּכָל הָאָרֶץ מְהֻלָּלָה</tei:l>
          <tei:l>וְאֵיךְ עַתָּה נֶחְשֶׁבֶת מֵחֻלָּלָה</tei:l>
          <tei:l>לְלַעַג וּלְבֹשֶׁת וְלִקְלָלָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eshet_neurim_haahuvah_yom/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נְ</tei:seg>וַת פַּעֲמַיִם בִּנְעָלֶיהָ</tei:l>
          <tei:l>אֲשֶׁר כְּנָפֶיךָ פְּרוּשִׂים עָלֶיהָ</tei:l>
          <tei:l>וְאֵיךְ עַתָּה נִגְּפוּ רַגְלֶיהָ</tei:l>
          <tei:l>עַל הֶהָרִים אַחַר עוֹלָלֶיהָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eshet_neurim_haahuvah_yom/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נָ</tei:seg>א יוֹשֵׁב הַכְּרוּבִים</tei:l>
          <tei:l>תֵּרֶא בְּכָל זֹאת לֹא פָנְתָה אֶל רְהָבִים</tei:l>
          <tei:l>לֹא עַל פָּרָשִׁים וְלֹא עַל רוֹכְבִים</tei:l>
          <tei:l>כִּי עַל רַחֲמֶיךָ הָרַבִּים</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
