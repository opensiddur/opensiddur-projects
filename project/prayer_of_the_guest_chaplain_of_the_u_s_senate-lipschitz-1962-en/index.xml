      <tei:div type="colophon" subtype="introduction">
        <tei:p>Guest Chaplain: Rabbi Chaim U. Lipschitz, editor of the <tei:hi rend="italic">Jewish Press</tei:hi>, Brooklyn, New York</tei:p>
        <tei:p>Sponsor: n/a</tei:p>
        <tei:p>Date of Prayer: 28 March 1962</tei:p>
      </tei:div>
      <j:endConditional target="#osp_55015_introduction"/>
      <j:conditional xml:id="osp_55015_notes">
        <tei:fs type="opensiddur:paratext">
          <tei:f name="include">
            <tei:binary value="true"/>
          </tei:f>
        </tei:fs>
      </j:conditional>
      <tei:div type="colophon" subtype="notes">
        <tei:p>This prayer of the guest chaplain was offered in the third month of the second session of the 87th US Congress in the Senate, and published in the <tei:hi rend="italic">Congressional Record</tei:hi>, vol. 108, part 4 (1962), page 5205. Rabbi Lipschitz offered the exact same prayer when he was guest chaplain before the Senate on 25 March 1965 (as found in <tei:hi rend="italic">Congressional Record</tei:hi>, vol. 111, part 5 (1965), page 5813.)</tei:p>
      </tei:div>
      <j:endConditional target="#osp_55015_notes"/>
