  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:universal_praise_carvalho">
        <tei:head>Universal Praise, a hymn by David Nunes Carvalho (Reformed Society of Israelites, Charleston, South Carolina, 1826)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:universal_praise_carvalho/1"/>
        <tei:lg>
          <tei:l>Praise to thee, thou great Creator!</tei:l>
          <tei:l>Praise to thee from every tongue!</tei:l>
          <tei:l>Join my soul with every creature,</tei:l>
          <tei:l>Join the universal song!</tei:l>
          <tei:l>(<tei:hi rend="italic">Hallelujah</tei:hi>)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:universal_praise_carvalho/2"/>
        <tei:lg>
          <tei:l>For ten thousand blessings given,</tei:l>
          <tei:l>For the hopes of future joy,</tei:l>
          <tei:l>Sound his praise thro’ earth and Heaven,</tei:l>
          <tei:l>Sound YHVH’s praise on high!</tei:l>
          <tei:l>(<tei:hi rend="italic">Halelujah!</tei:hi>)</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
