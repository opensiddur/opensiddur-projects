  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:morning_prayer_levy">
        <tei:head>Morning Prayer (for Older Children) by Rabbi Clifton Harby Levy (1927)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:morning_prayer_levy/1"/>
        <tei:lg>
          <tei:l>Sweet was the rest of the night, O God,</tei:l>
          <tei:l>and beautiful is the day as I awake.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:morning_prayer_levy/2"/>
        <tei:lg>
          <tei:l>Make it a good day for me,</tei:l>
          <tei:l>a day of kindness,</tei:l>
          <tei:l>of real trying to learn</tei:l>
          <tei:l>and to play fair.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:morning_prayer_levy/3"/>
        <tei:lg>
          <tei:l>Help me to obey the wish</tei:l>
          <tei:l>of all older than I,</tei:l>
          <tei:l>for they are trying to show me</tei:l>
          <tei:l>the right way to live.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:morning_prayer_levy/4"/>
        <tei:lg>
          <tei:l>Keep me strong,</tei:l>
          <tei:l>willing and happy</tei:l>
          <tei:l>all day long,</tei:l>
          <tei:l>so that I may grow up</tei:l>
          <tei:l>in love for You</tei:l>
          <tei:l>and for all around me.</tei:l>
          <tei:l><tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
