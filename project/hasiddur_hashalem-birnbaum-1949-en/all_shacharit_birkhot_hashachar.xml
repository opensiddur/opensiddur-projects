          <tei:note type="instruction" xml:lang="en" resp="urn:x-opensiddur:contributor:opensiddur.org/efraim-feinstein">On weekdays, except Shabbat, Yom Tov and Tish‘ah b’Av morning; on Ḥol ha-Mo‘ed, according to the custom of wearing tefillin:</tei:note>
<j:all><j:none>          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="yom-tov">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:holiday">
            <tei:f name="tisha-bav">
              <tei:numeric value="1"/>
            </tei:f>
          </tei:fs></j:none><j:any><j:none>          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="chol-hamoed">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs></j:none>          <tei:fs type="opensiddur:practice">
            <tei:f name="tefillin-on-chol-hamoed">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs></j:any></j:all>
        </j:conditional>
