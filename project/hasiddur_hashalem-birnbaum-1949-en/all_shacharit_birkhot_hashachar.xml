        <tei:head xml:lang="en">PRELIMINARY MORNING SERVICE</tei:head>
        <tei:note type="instruction" xml:lang="en">Upon entering the synagogue:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:mah_tovu"/>
        <tei:head xml:lang="en">PUTTING ON THE TALLITH</tei:head>
        <tei:note type="instruction" xml:lang="en">Before putting on the <tei:foreign xml:lang="he-Latn">tallith</tei:foreign>:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:tallith/barkhi_nafshi"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:tallith/hineni_mitattef"/>
        <tei:note type="instruction" xml:lang="en">When putting on the <tei:foreign xml:lang="he-Latn">tallith</tei:foreign>:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:tallith/lehitattef"/>
