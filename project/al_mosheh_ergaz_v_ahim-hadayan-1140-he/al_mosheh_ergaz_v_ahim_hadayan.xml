    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:al_mosheh_ergaz_v_ahim_hadayan">
        <tei:head>עַל־מֹשֶׁה אֶרְגָּז וְאָהִים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:al_mosheh_ergaz_v_ahim_hadayan/1"/>
        <tei:lg>
          <tei:l>עַל־מֹשֶׁה אֶרְגָּז וְאָהִים</tei:l>
          <tei:l>כִּי־לָקַח אֹתוֹ אֱלֹהִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:al_mosheh_ergaz_v_ahim_hadayan/2"/>
        <tei:lg>
          <tei:l>שַׁׄדַּי הוֹדִיעוֹ בְּחֶפְצוֹ</tei:l>
          <tei:l>שׁוֹכֵן בִּשְׁחָקָיו וְאַרְצוֹ</tei:l>
          <tei:l>כִּי־קָרְבוּ יָמָיו וְקִצּוֹ</tei:l>
          <tei:l>רוּחֲךָ תַּעֲלֶה אֶל־גְּבוֹהִים</tei:l>
          <tei:l>גַּם תָּשׁוּב אֶל־אֱלֹהִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:al_mosheh_ergaz_v_ahim_hadayan/3"/>
        <tei:lg>
          <tei:l>עַל־מֹשֶׁה אֶרְגָּז וְאָהִים</tei:l>
          <tei:l>כִּי־לָקַח אֹתוֹ אֱלֹהִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:al_mosheh_ergaz_v_ahim_hadayan/4"/>
        <tei:lg>
          <tei:l>מֹׄשֶׁה קָרָא אֵין כְּאִישׁ חוֹל</tei:l>
          <tei:l>אָמוּת וּשְׁכִינָה בְּאֶתְמוֹל</tei:l>
          <tei:l>שַׁרְתִּי וָאֶשְׁמַע דְבַר קוֹל</tei:l>
          <tei:l>וָאֶקַּח לוּחוֹת נוֹגְהִים</tei:l>
          <tei:l>כְּתוּבִים בְּאֶצְבַּע אֱלֹהִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:al_mosheh_ergaz_v_ahim_hadayan/5"/>
        <tei:lg>
          <tei:l>עַל־מֹשֶׁה אֶרְגָּז וְאָהִים</tei:l>
          <tei:l>כִּי־לָקַח אֹתוֹ אֱלֹהִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:al_mosheh_ergaz_v_ahim_hadayan/6"/>
        <tei:lg>
          <tei:l>וַׄיֹּֽאמֶר לוֹ צוּר מְרוֹמִים</tei:l>
          <tei:l>מֵאֶֽרֶץ טֻמְאָה וְדָמִים</tei:l>
          <tei:l>קוּם וַעֲלֵה לִמְלוֹן תְּמִימִים</tei:l>
          <tei:l>הַהוֹלְכִים אַחֲרַי וְנוֹהִים</tei:l>
          <tei:l>וַיֶּחֱזוּ אֶת־הָאֱלֹהִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:al_mosheh_ergaz_v_ahim_hadayan/7"/>
        <tei:lg>
          <tei:l>עַל־מֹשֶׁה אֶרְגָּז וְאָהִים</tei:l>
          <tei:l>כִּי־לָקַח אֹתוֹ אֱלֹהִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:al_mosheh_ergaz_v_ahim_hadayan/8"/>
        <tei:lg>
          <tei:l>אֵׄיךְ אֶעֱזֹב צֹאנְךָ פְּזוֹרוֹת</tei:l>
          <tei:l>מֵהוֹדִיעָם חֻקִּים וְתוֹרוֹת</tei:l>
          <tei:l>וַאֲנִי שַׂמְתִּים כִּמְאוֹרוֹת</tei:l>
          <tei:l>אוֹרָם מִלִּהְיוֹת תְּמֵהִים</tei:l>
          <tei:l>אֶדַּדֵּם עַד־בֵּית אֱלֹהִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:al_mosheh_ergaz_v_ahim_hadayan/9"/>
        <tei:lg>
          <tei:l>עַל־מֹשֶׁה אֶרְגָּז וְאָהִים</tei:l>
          <tei:l>כִּי־לָקַח אֹתוֹ אֱלֹהִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:al_mosheh_ergaz_v_ahim_hadayan/10"/>
        <tei:lg>
          <tei:l>לֵׄךְ אַל־תּוֹסֵף עוֹד דְּבָרִים</tei:l>
          <tei:l>קוּם וַעֲלֵה אֶל־הַר הָעֲבָרִים</tei:l>
          <tei:l>וּטְמֹן גֹּֽלֶם בַּעֲפָרִים</tei:l>
          <tei:l>בָּךְ לֶעָתִיד עַם כְּמֵהִים</tei:l>
          <tei:l>יַגִּֽידוּ פֹּעַל אֱלֹהִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:al_mosheh_ergaz_v_ahim_hadayan/11"/>
        <tei:lg>
          <tei:l>עַל־מֹשֶׁה אֶרְגָּז וְאָהִים</tei:l>
          <tei:l>כִּי־לָקַח אֹתוֹ אֱלֹהִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:al_mosheh_ergaz_v_ahim_hadayan/12"/>
        <tei:lg>
          <tei:l>צָׄעֲקָה יוֹכֶֽבֶד וְאִשֶּׁה</tei:l>
          <tei:l>תַּמְרוּר בִּלְבָבָהּ לְמֹשֶׁה</tei:l>
          <tei:l>בִּכְאִיבָה תֶּחֱרַד וְתֶחֱשֶׁה</tei:l>
          <tei:l>מַר לָכֶם מֵעַי בְּלוּהִים</tei:l>
          <tei:l>לָמָּה יִקְצֹף הָאֱלֹהִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:al_mosheh_ergaz_v_ahim_hadayan/13"/>
        <tei:lg>
          <tei:l>עַל־מֹשֶׁה אֶרְגָּז וְאָהִים</tei:l>
          <tei:l>כִּי־לָקַח אֹתוֹ אֱלֹהִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:al_mosheh_ergaz_v_ahim_hadayan/14"/>
        <tei:lg>
          <tei:l>וַׄתֹּֽאמֶר אֶפְקוֹד יְלִידִי</tei:l>
          <tei:l>אֶל־יָדְךָ הַדָּן יְחִידִי</tei:l>
          <tei:l>אַתָּה תֵּדַע מָרַת כְּבֵדִי</tei:l>
          <tei:l>שִׂים מַהֲלָכָיו בֵּין־נְגוֹהִים</tei:l>
          <tei:l>וּבְתוֹךְ עֵֽדֶן גַּן אֱלֹהִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:al_mosheh_ergaz_v_ahim_hadayan/15"/>
        <tei:lg>
          <tei:l>עַל־מֹשֶׁה אֶרְגָּז וְאָהִים</tei:l>
          <tei:l>כִּי־לָקַח אֹתוֹ אֱלֹהִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:al_mosheh_ergaz_v_ahim_hadayan/16"/>
        <tei:lg>
          <tei:l>בֹּׄא בֶּן־עַמְרָם אֶל־מְחִיצָה</tei:l>
          <tei:l>לֹא־בָּא־לָהּ עוֹד אִישׁ מְרוּצָה</tei:l>
          <tei:l>נִלְקַח בִּנְשִׁיקָה וְנִרְצָה</tei:l>
          <tei:l>מֵעַי הוֹמִים־לוֹ וְרוֹהִים</tei:l>
          <tei:l>נִגְלוּ אֵלָיו הָאֱלֹהִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:al_mosheh_ergaz_v_ahim_hadayan/17"/>
        <tei:lg>
          <tei:l>עַל־מֹשֶׁה אֶרְגָּז וְאָהִים</tei:l>
          <tei:l>כִּי־לָקַח אֹתוֹ אֱלֹהִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:al_mosheh_ergaz_v_ahim_hadayan/18"/>
        <tei:lg>
          <tei:l>הַׄיּוֹם יִשְׂרָאֵל יְשִׂימוּן</tei:l>
          <tei:l>שִׂמְחָה לַתּוֹרָה גַּם יְהִימוּן</tei:l>
          <tei:l>עַל־מֹשֶׁה וּבְקוֹל יְרִימוּן</tei:l>
          <tei:l>כֻּלָּם בּוֹכִים הֵם וְנוֹהִים</tei:l>
          <tei:l>עַל־מֹשֶׁה אִישׁ הָאֱלֹהִים׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
