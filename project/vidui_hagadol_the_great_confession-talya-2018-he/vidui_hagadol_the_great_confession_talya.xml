    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:vidui_hagadol_the_great_confession_talya">
        <tei:head>וידוי הגדול</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:vidui_hagadol_the_great_confession_talya/1"/>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ</tei:l>
          <tei:l>כְּשֶׁהִרְעַבְנוּ אֶת נִשְׁמָתֵנוּ מִמָּה</tei:l>
          <tei:l>שֶׁבְּכֹחוֹ לְהָזִין אוֹתָהּ;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:vidui_hagadol_the_great_confession_talya/2"/>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ לִפְנֵי גּוּפֵינוּ</tei:l>
          <tei:l>בְּהַזְנָחָה;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:vidui_hagadol_the_great_confession_talya/3"/>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ</tei:l>
          <tei:l>בְּהַדְחָקָה וְהִתְעַלְּמוּת מִכְּאֵבֵנוּ;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:vidui_hagadol_the_great_confession_talya/4"/>
        <tei:lg>
          <tei:l>וְעַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ</tei:l>
          <tei:l>בְּבִּקוֹרְתִּיּוּת יְתֵרָה וּבְהַלְקָאָה עַצְמִית;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:vidui_hagadol_the_great_confession_talya/5"/>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ לִפְנֵי עָצְמָתֵנוּ הָאֲמִתִּית</tei:l>
          <tei:l>בְּקָרְבָּנוּת לִשְׁמָהּ;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:vidui_hagadol_the_great_confession_talya/6"/>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ</tei:l>
          <tei:l>בְּהִתְכַּחֲשׁוּת לְאוֹר־הַיְּקָרוֹת הַמָּצוּי בְּתוֹכֵנוּ;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:vidui_hagadol_the_great_confession_talya/7"/>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ</tei:l>
          <tei:l>בְּהִתְכַּחֲשׁוּת לְחוּלְשׁוֹתֵינוּ וְטָעֻיּוֹתֵינוּ,</tei:l>
          <tei:l>מִתּוֹךְ יֵצֶר גַּאֲוָה;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:vidui_hagadol_the_great_confession_talya/8"/>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ כְּלַפֵּי מִישֶׁהוּ</tei:l>
          <tei:l>בְּהַאֲשָׁמָה,</tei:l>
          <tei:l>בִּמְקוֹם לָקַחַת אַחְרָיוּת;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:vidui_hagadol_the_great_confession_talya/9"/>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ</tei:l>
          <tei:l>כְּשֶׁהֶאֱמַנּוּ לִפְחָדֵינוּ,</tei:l>
          <tei:l>סָגַרְנוּ אֶת לִבֵּנוּ וְסֵרַבְנוּ לָתֵת אֵמוּן;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:vidui_hagadol_the_great_confession_talya/10"/>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ</tei:l>
          <tei:l>בְּהִתְרַכְּזוּת בָּנוּ וּבִבְנֵי מִשְׁפַּחְתֵּנוּ</tei:l>
          <tei:l>וּבִמְנִיעַת טוּבֵנוּ מֵאֲחֵרִים;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:vidui_hagadol_the_great_confession_talya/11"/>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ</tei:l>
          <tei:l>בְּדוֹבְרֵנוּ דְּבַר שֶׁקֶר</tei:l>
          <tei:l>כִּי פָּחַדְנוּ מִתּוֹצְאוֹת חֲשִׂיפַת הָאֱמֶת;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:vidui_hagadol_the_great_confession_talya/12"/>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ לִפְנֵי הוֹרֵינוּ</tei:l>
          <tei:l>בְּשִׁפּוּטִיּוֹת חַסְרַת חֶמְלָה;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:vidui_hagadol_the_great_confession_talya/13"/>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ לִפְנֵי אֲהוּבֵינוּ</tei:l>
          <tei:l>בְּצִמְצוּם גִּלּוּיֵי אַהֲבָה;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:vidui_hagadol_the_great_confession_talya/14"/>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ לִפְנֵי כָּל הָעוֹלָם</tei:l>
          <tei:l>בָּאֲטִימַת לִבֵּינוּ לְעֹנִי, לְדִכּוּי, לִשְׁחִיתוּת, לְמִלְחָמוֹת;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:vidui_hagadol_the_great_confession_talya/15"/>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ</tei:l>
          <tei:l>בִּתְבִיעַת בַּעֲלוּת עַל הָאֲדָמָה,</tei:l>
          <tei:l>עַל מַשְׁאַבֵּי הַטֶּבַע,</tei:l>
          <tei:l>עַל אָהוּב, עַל אֲהוּבָהּ;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:vidui_hagadol_the_great_confession_talya/16"/>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ</tei:l>
          <tei:l>בְּנִצּוּל כֹּחֵנוּ עַל פְּנֵי אֲחֵרִים:</tei:l>
          <tei:l>שְׁכֵנִים, אֲהוּבִים, שֻׁתָּפִים, בַּעֲלֵי הַחַיִּים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:vidui_hagadol_the_great_confession_talya/17"/>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ</tei:l>
          <tei:l>בְּהַשְׁחָתַת תְּנָאֵי הַחַיִּים עַל כַּדּוּר הָאָרֶץ;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:vidui_hagadol_the_great_confession_talya/18"/>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ</tei:l>
          <tei:l>בְּהִסְתַּפְּקֵנוּ בְּמַסָּדִים שֶׁל כֹּחַ, שְׁלִיטָה וְנוֹחִיּוּת –</tei:l>
          <tei:l>כִּמְקוֹרוֹת לְבִטְחוֹנֵנוּ;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:vidui_hagadol_the_great_confession_talya/19"/>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ</tei:l>
          <tei:l>בְּהַשְׁאִרֵנוּ אֶת בְּעָיוֹת הָעוֹלָם</tei:l>
          <tei:l>מִחוּץ לִגְּבוּלוֹת הַשָּׂגָתֵנוּ;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:vidui_hagadol_the_great_confession_talya/20"/>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ</tei:l>
          <tei:l>בְּהַאָמִינֵנוּ כִּי אֵין בְּאֶפְשָׁרוּתֵנוּ לְשַׁנּוֹת</tei:l>
          <tei:l>וְנוֹתַרְנוּ אִלְּמִים מוּל מַעֲשֵׂי עָוֶל;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:vidui_hagadol_the_great_confession_talya/21"/>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ</tei:l>
          <tei:l>כְּשֶׁסֵּרַבְנוּ לְהִתְעוֹרֵר,</tei:l>
          <tei:l>לִלְמֹד מִטָּעֻיּוֹת,</tei:l>
          <tei:l>לְהִשְׁתַּנּוֹת;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:vidui_hagadol_the_great_confession_talya/22"/>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ</tei:l>
          <tei:l>בְּהַעֲמִידֵנוּ “תְּנָאִים” לְהַכָּרָתֵנוּ בְּתוֹקֵף יָפְיָיֽם שֶׁל חַיֵּינוּ;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:vidui_hagadol_the_great_confession_talya/23"/>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ</tei:l>
          <tei:l>כְּשֶׁהִתְבַּלְבַּלְנוּ בֵּין מְשִׂימוֹת הֶכְרֵחִיּוֹת לְקִיּוּמֵנוּ</tei:l>
          <tei:l>לְבֵין מַשְׁמָעוּת חַיֵּינוּ;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:vidui_hagadol_the_great_confession_talya/24"/>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ</tei:l>
          <tei:l>בְּשִׁכְחַת הַתַּכְלִית לְבֹאֵנוּ לְעוֹלָם;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:vidui_hagadol_the_great_confession_talya/25"/>
        <tei:lg>
          <tei:l>וְעַל כֻּלָּם</tei:l>
          <tei:l>אֱלֹהַּ סְלִיחוֹת</tei:l>
          <tei:l>סְלַח לָנוּ,</tei:l>
          <tei:l>מָחַל לָנוּ,</tei:l>
          <tei:l>כַּפֵּר לָנוּ.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
