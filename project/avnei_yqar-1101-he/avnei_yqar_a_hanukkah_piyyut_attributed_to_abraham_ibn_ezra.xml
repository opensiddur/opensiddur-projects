  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:avnei_yqar_a_hanukkah_piyyut_attributed_to_abraham_ibn_ezra">
        <tei:head>אַבְנֵי יְקָר</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:avnei_yqar_a_hanukkah_piyyut_attributed_to_abraham_ibn_ezra/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אַ</tei:seg>בְנֵי יְקָר</tei:l>
          <tei:l>עַל־הַר צְבִי הִתְפָּרְקוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:avnei_yqar_a_hanukkah_piyyut_attributed_to_abraham_ibn_ezra/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בָּ</tei:seg>אוּ יְמֵי</tei:l>
          <tei:l>שִׁלּוּם עֲדֵי הִתְחַזְּקוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:avnei_yqar_a_hanukkah_piyyut_attributed_to_abraham_ibn_ezra/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רָ</tei:seg>מָה יְמִינָם</tei:l>
          <tei:l>יוֹם יְוָנִים דָּלְקוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:avnei_yqar_a_hanukkah_piyyut_attributed_to_abraham_ibn_ezra/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הֵ</tei:seg>יכָל אֲזַי</tei:l>
          <tei:l>חָנְכוּ וְנֵרוֹת דָּלְקוּ,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:avnei_yqar_a_hanukkah_piyyut_attributed_to_abraham_ibn_ezra/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>צּוּף יְשׁוּעוֹת</tei:l>
          <tei:l>אֶל־לְבָבוֹת מָתְקוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:avnei_yqar_a_hanukkah_piyyut_attributed_to_abraham_ibn_ezra/6"/>
        <tei:lg>
          <tei:l>עַל־זֹאת לְבָרֵךְ</tei:l>
          <tei:l>שֵׁם כְּבוֹדוֹ חָשְׁקוּ</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
