  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:tefillin">
        <tei:head>ברכת תפלין</tei:head>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>ברכת תפלין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tefillin/lehanniach"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם</tei:l>
          <tei:l>אֲשֶׁר קִדְּשָׁנוּ בְּמִצְוֺתָיו</tei:l>
          <tei:l>וְצִוָּנוּ לְהָנִיחַ תְּפִלִּין:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ואם הפסיק בדבור בין תפלין של יד לתפלין של ראש יברך</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tefillin/al_mitzvat"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם</tei:l>
          <tei:l>אֲשֶׁר קִדְּשָׁנוּ בְּמִצְוֺתָיו</tei:l>
          <tei:l>וְצִוָּנוּ עַל מִצְוַת תְּפִלִּין:</tei:l>
        </tei:lg>
