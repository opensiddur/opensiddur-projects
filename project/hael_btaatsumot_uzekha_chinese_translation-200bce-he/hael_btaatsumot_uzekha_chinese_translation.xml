      <tei:div corresp="urn:x-opensiddur:text:poem:hael_btaatsumot_uzekha_chinese_translation">
        <tei:head>הָאֵל בְּתַעֲצֻמוֹת עֻזֶּךָ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hael_btaatsumot_uzekha_chinese_translation/1"/>
        <tei:lg>
          <tei:l>הָאֵל בְּתַעֲצֻמוֹת עֻזֶּךָ,</tei:l>
          <tei:l>הַגָּדוֹל בִּכְבוֹד שְׁמֶךָ, הַגִּבּוֹר</tei:l>
          <tei:l>לָנֶצַח וְהַנּוֹרָא בְּנוֹרְאוֹתֶיךָ</tei:l>
          <tei:l>הַמֶּלֶךְ הַיּושֵׁב עַל כִּסֵּא רָם וְנִשָּׂא׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
