    </tei:note>
    <tei:note type="commentary" n="2" target="#note_2">
      <tei:p>lit. “flesh and blood”</tei:p>
    </tei:note>
    <tei:note type="commentary" n="3" target="#note_3">
      <tei:p>lit. “Endow us from your...”</tei:p>
    </tei:note>
