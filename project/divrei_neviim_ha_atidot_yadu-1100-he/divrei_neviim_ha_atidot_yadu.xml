      <tei:div corresp="urn:x-opensiddur:text:poem:divrei_neviim_ha_atidot_yadu">
        <tei:head>דִּבְרֵי נְבִיאִים הָעֲתִידוֹת יָדְעוּ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:divrei_neviim_ha_atidot_yadu/1"/>
        <tei:lg>
          <tei:l>דִּבְרֵי נְבִיאִים הָעֲתִידוֹת יָדְעוּ</tei:l>
          <tei:l>מֵאָז בְּכׇל־עַם הָאֱלֹהִים נִשְׁמְעוּ׃</tei:l>
          <tei:l>לֵאמוֹר לְצוּרְכֶם הַלְּבָבוֹת קָרְעוּ</tei:l>
          <tei:l>אַךְ עָמְלוּ לָרִיק וְלַשָּׁוְא יָגְעוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:divrei_neviim_ha_atidot_yadu/2"/>
        <tei:lg>
          <tei:l>לֹא־הֶאֱזִֽנוּ תּוֹכְחוֹתֵיהֶם וְלֹא־שָׁמְעוּ</tei:l>
          <tei:l>וּמוֹסַר הָאֱלֹהִים פָּרְעוּ׃</tei:l>
          <tei:l>הֶגְלוּם חֲטָאֶיהֵם עֲדֵי מִזְרָח וְיָם</tei:l>
          <tei:l>וּלְבֵית שְׁבִי מִנַּחֲלָתָם נָסְעוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:divrei_neviim_ha_atidot_yadu/3"/>
        <tei:lg>
          <tei:l>הוּעַם מְאוֹד אוֹרָם וְגָֽלוּ מִזְּבוּל קֹֽדֶשׁ</tei:l>
          <tei:l>וְעַד־תַּחְתִּית אֲדָמָה נִשְׁקְעוּ׃</tei:l>
          <tei:l>אֶבְכֶּה בְּכִי יַעְזֵר לְהַוָּתָם</tei:l>
          <tei:l>וְעַל־זֶה צָלְלוּ אׇזְנַי וְעֵינַי דָּמְעוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:divrei_neviim_ha_atidot_yadu/4"/>
        <tei:lg>
          <tei:l>רַחֵם עֲלֵיהֶם צוּר בְּאַרְצוֹת הַזָּרִים</tei:l>
          <tei:l>כִּי מִפְּנֵי יָדְךָ וְזַעַמְךָ יִכְרְעוּ׃</tei:l>
          <tei:l>גּוֹאֵל שְׁלַח לָהֶם</tei:l>
          <tei:l>וְתַזְרִֽיחַ מְאוֹר עֻזָּךְ וְאוֹרֶֽךָ אֲזַי יִבָּקְעוּ׃</tei:l>
        </tei:lg>
