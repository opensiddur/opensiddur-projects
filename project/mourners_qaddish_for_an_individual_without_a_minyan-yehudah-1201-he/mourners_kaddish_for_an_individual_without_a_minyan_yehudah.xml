    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:mourners_kaddish_for_an_individual_without_a_minyan_yehudah">
        <tei:head>קדיש יתום ליחיד</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mourners_kaddish_for_an_individual_without_a_minyan_yehudah/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">אָדָם שֶׁהוּא דָּר בַּכְּפָר וְאֵין עִמּוֹ עֲשָׂרָה לוֹמַר דָּבָר שֶׁבִּקְדֻשָּׁה אוֹ בִּמְּקוֹם קְּהִלָּה וְאִחֵר לָבֹא עַד אֲשֶׁר אָמְרוּ כְּבָר יְהֵא שְׁמֵי׳ רַבָּא יֹאמַר</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mourners_kaddish_for_an_individual_without_a_minyan_yehudah/2"/>
        <tei:lg>
          <tei:l>וְעַתָּה יִגְדַּל נָא כֹּחַ אֲדֹנָי</tei:l>
          <tei:l>כַּאֲשֶׁר דִבַּרְתָּ לֵאמֹר׃ <tei:bibl>(במדבר יד:יז)</tei:bibl>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mourners_kaddish_for_an_individual_without_a_minyan_yehudah/3"/>
        <tei:lg>
          <tei:l>וְהִתְגַּדִּלְתִּי וְהִתְקַדִּשְׁתִּי</tei:l>
          <tei:l>וְנוֹדַעְתִּי לְעֵינֵי גּוֹיִם רַבִּים</tei:l>
          <tei:l>וְיָדְעוּ כִּי אֲנִי ה׳׃ <tei:bibl>(יחזקאל לח:כג)</tei:bibl>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mourners_kaddish_for_an_individual_without_a_minyan_yehudah/4"/>
        <tei:lg>
          <tei:l>יְהִי שֵׁם ה׳ מְּבֹרָךְ מֵעַתָּה וְעַד עוֹלָם׃ <tei:bibl>(תהלים קיג:ב)</tei:bibl>.</tei:l>
        </tei:lg>
      </tei:div>
