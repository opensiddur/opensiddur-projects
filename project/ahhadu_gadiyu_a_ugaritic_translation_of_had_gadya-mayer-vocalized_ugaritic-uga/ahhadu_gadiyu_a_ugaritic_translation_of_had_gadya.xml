  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ahhadu_gadiyu_a_ugaritic_translation_of_had_gadya">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahhadu_gadiyu_a_ugaritic_translation_of_had_gadya/1"/>
        <tei:lg>
          <tei:l>ʾaḥḥadu gādiyu, ʾaḥḥadu gādiyu</tei:l>
          <tei:l>dū qanaya ʾabî bi naṣpi kaspi</tei:l>
          <tei:l>ʾaḥḥadu gādiyu, ʾaḥḥadu gādiyu</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahhadu_gadiyu_a_ugaritic_translation_of_had_gadya/2"/>
        <tei:lg>
          <tei:l>wā maǵaya šurānnu</tei:l>
          <tei:l>wā laḥama gādiya</tei:l>
          <tei:l>dā qanaya ʾabî bi naṣpi kaspi</tei:l>
          <tei:l>ʾaḥḥadu gādiyu, ʾaḥḥadu gādiyu</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahhadu_gadiyu_a_ugaritic_translation_of_had_gadya/3"/>
        <tei:lg>
          <tei:l>wā maǵaya kalbu</tei:l>
          <tei:l>wā naṯaka šurānna</tei:l>
          <tei:l>dā laḥama gādiya</tei:l>
          <tei:l>dā qanaya ʾabî bi naṣpi kaspi</tei:l>
          <tei:l>ʾaḥḥadu gādiyu, ʾaḥḥadu gādiyu</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahhadu_gadiyu_a_ugaritic_translation_of_had_gadya/4"/>
        <tei:lg>
          <tei:l>wā maǵaya ḫaṭṭu</tei:l>
          <tei:l>wā miḫḫaṣa kalba</tei:l>
          <tei:l>dā naṯaka šurānna</tei:l>
          <tei:l>dā laḥama gādiya</tei:l>
          <tei:l>dā qanaya ʾabî bi naṣpi kaspi</tei:l>
          <tei:l>ʾaḥḥadu gādiyu, ʾaḥḥadu gādiyu</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahhadu_gadiyu_a_ugaritic_translation_of_had_gadya/5"/>
        <tei:lg>
          <tei:l>wā maǵayat ı͗šatu</tei:l>
          <tei:l>wā šarapat ḫaṭṭa</tei:l>
          <tei:l>dā miḫḫaṣa kalba</tei:l>
          <tei:l>dā naṯaka šurānna</tei:l>
          <tei:l>dā laḥama gādiya</tei:l>
          <tei:l>dā qanaya ʾabî bi naṣpi kaspi</tei:l>
          <tei:l>ʾaḥḥadu gādiyu, ʾaḥḥadu gādiyu</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahhadu_gadiyu_a_ugaritic_translation_of_had_gadya/6"/>
        <tei:lg>
          <tei:l>wā maǵayū mêmu</tei:l>
          <tei:l>wā killayū ʾišata</tei:l>
          <tei:l>dāti šarapat ḫaṭṭa</tei:l>
          <tei:l>dā miḫḫaṣa kalba</tei:l>
          <tei:l>dā naṯaka šurānna</tei:l>
          <tei:l>dā laḥama gādiya</tei:l>
          <tei:l>dā qanaya ʾabî bi naṣpi kaspi</tei:l>
          <tei:l>ʾaḥḥadu gādiyu, ʾaḥḥadu gādiyu</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahhadu_gadiyu_a_ugaritic_translation_of_had_gadya/7"/>
        <tei:lg>
          <tei:l>wā maǵaya ʾalpu</tei:l>
          <tei:l>wā šataya mêma</tei:l>
          <tei:l>dūti killayū ʾišata</tei:l>
          <tei:l>dāti šarapat ḫaṭṭa</tei:l>
          <tei:l>dā miḫḫaṣa kalba</tei:l>
          <tei:l>dā naṯaka šurānna</tei:l>
          <tei:l>dā laḥama gādiya</tei:l>
          <tei:l>dā qanaya ʾabî bi naṣpi kaspi</tei:l>
          <tei:l>ʾaḥḥadu gādiyu, ʾaḥḥadu gādiyu</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahhadu_gadiyu_a_ugaritic_translation_of_had_gadya/8"/>
        <tei:lg>
          <tei:l>wā maǵaya šaḫīṭu</tei:l>
          <tei:l>wā ṭabaḫa ʾalpa</tei:l>
          <tei:l>dā šataya mêma</tei:l>
          <tei:l>dūti killayū ʾišata</tei:l>
          <tei:l>dāti šarapat ḫaṭṭa</tei:l>
          <tei:l>dā miḫḫaṣa kalba</tei:l>
          <tei:l>dā naṯaka šurānna</tei:l>
          <tei:l>dā laḥama gādiya</tei:l>
          <tei:l>dā qanaya ʾabî bi naṣpi kaspi</tei:l>
          <tei:l>ʾaḥḥadu gādiyu, ʾaḥḥadu gādiyu</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahhadu_gadiyu_a_ugaritic_translation_of_had_gadya/9"/>
        <tei:lg>
          <tei:l>wā maǵaya môtu</tei:l>
          <tei:l>wā ṭabaḫa šaḫīṭa</tei:l>
          <tei:l>dā ṭabaḫa ʾalpa</tei:l>
          <tei:l>dā šataya mêma</tei:l>
          <tei:l>dūti killayū ʾišata</tei:l>
          <tei:l>dāti šarapat ḫaṭṭa</tei:l>
          <tei:l>dā miḫḫaṣa kalba</tei:l>
          <tei:l>dā naṯaka šurānna</tei:l>
          <tei:l>dā laḥama gādiya</tei:l>
          <tei:l>dā qanaya ʾabî bi naṣpi kaspi</tei:l>
          <tei:l>ʾaḥḥadu gādiyu, ʾaḥḥadu gādiyu</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahhadu_gadiyu_a_ugaritic_translation_of_had_gadya/10"/>
        <tei:lg>
          <tei:l>wā maǵaya qudšu mubarruku huwa</tei:l>
          <tei:l>wā ṭabaḫa môta</tei:l>
          <tei:l>dā ṭabaḫa šaḫīṭa</tei:l>
          <tei:l>dā ṭabaḫa ʾalpa</tei:l>
          <tei:l>dā šataya mêma</tei:l>
          <tei:l>dūti killayū ʾišata</tei:l>
          <tei:l>dāti šarapat ḫaṭṭa</tei:l>
          <tei:l>dā miḫḫaṣa kalba</tei:l>
          <tei:l>dā naṯaka šurānna</tei:l>
          <tei:l>dā laḥama gādiya</tei:l>
          <tei:l>dā qanaya ʾabî bi naṣpi kaspi</tei:l>
          <tei:l>ʾaḥḥadu gādiyu, ʾaḥḥadu gādiyu</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
