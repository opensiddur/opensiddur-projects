  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:kavvanah_before_eating_or_drinking_on_yom_kippur_lyisrael">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kavvanah_before_eating_or_drinking_on_yom_kippur_lyisrael/1"/>
        <tei:lg>
          <tei:l>הִנְנִי</tei:l>
          <tei:l>מוּכָן וּמְזֻמָּן</tei:l>
          <tei:l>לְקַיֵּם מִצְוַת</tei:l>
          <tei:l>אֲכִילָה וּשְׁתִיָּה בְּיוֹם הַכִּפּוּרִים,</tei:l>
          <tei:l>כְּמוֹ שֶׁכָּתַבְתָּ בְּתוֹרָתֶךָ</tei:l>
          <tei:l>”וּשְׁמַרְתֶּם אֶת־חֻקֹּתַי וְאֶת־מִשְׁפָּטַי</tei:l>
          <tei:l>אֲשֶׁר יַעֲשֶׂה אֹתָם הָאָדָם וָחַי בָּהֶם</tei:l>
          <tei:l>אֲנִי ה׳׃“ <tei:bibl>(ויקרא יח:ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kavvanah_before_eating_or_drinking_on_yom_kippur_lyisrael/2"/>
        <tei:lg>
          <tei:l>וּבְכֹחַ אֲכִילָתִי וּשְׁתִיָּתִי</tei:l>
          <tei:l>אֶעֱמֹד אֵיתָן עַל מִשְׁמַר אַרְצֵנוּ</tei:l>
          <tei:l>וְעָרֵי אֱלֹהֵינוּ.</tei:l>
          <tei:l>וּבִזְכוּת קִיּוּם מִצְוָה זוֹ</tei:l>
          <tei:l>תַּחְתֹּם אוֹתִי</tei:l>
          <tei:l>וְאֶת כׇּל עַמְּךָ יִשְׂרָאֵל</tei:l>
          <tei:l>לְחַיִּים טוֹבִים וַאֲרֻכִּים</tei:l>
          <tei:l>וּלְשָׁלוֹם.</tei:l>
          <tei:l>אָמֵן</tei:l>
          <tei:l>וְכֵן יְהִי רָצוֹן.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
