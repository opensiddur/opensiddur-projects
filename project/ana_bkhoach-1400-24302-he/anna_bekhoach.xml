  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:anna_bekhoach">
        <tei:head>אָנָּא בְּכֹחַ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:anna_bekhoach/1-7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אָ</tei:seg>נָא בְּכֹחַ גְּדוּלַת יְמִינֶךָ</tei:l>
          <tei:l>תַּתִּיר צְרוּרָה</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קַ</tei:seg>בֵּל רִנַּת עַמֶךָ</tei:l>
          <tei:l>שַׂגְּבֵנוּ טַהֲרֵנוּ נוֹרָא</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נָ</tei:seg>א גִבּוֹר דּוֹרְשֵׁי יִחוּדֶךָ</tei:l>
          <tei:l>כְּבָבַת שׁוֹמְרֵם</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בָּ</tei:seg>רְכֵם טַהֲרֵם רַחֲמֵי צִדְקָתֶךָ</tei:l>
          <tei:l>תָּמִיד גּוֹמְלֵם</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חָ</tei:seg>סִין קָדוֹשׁ בְּרֹב טוּבְךָ</tei:l>
          <tei:l>נַהֵל עֲדָתֶךָ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>חִיד גֵּאֶה לְעַמְּךָ פְנֵה</tei:l>
          <tei:l>זוֹכְרֵי קְדוּשָׁתֶךָ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שַׁ</tei:seg>וְעָתֵנוּ קַבֵּל</tei:l>
          <tei:l>וּשְׁמַע צַעֲקָתֵנוּ</tei:l>
          <tei:l>יוֹדֵעַ תַּעֲלוּמוֹת׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
