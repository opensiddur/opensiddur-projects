    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yah_ezrati_min_shemayya_aboud">
        <tei:head>יָהּ עֶזְרָתִי מִן שְׁמַיָּא</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yah_ezrati_min_shemayya_aboud/1"/>
        <tei:lg>
          <tei:l>יָהּ עֶזְרָתִי מִן שְׁמַיָּא</tei:l>
          <tei:l>שְׁלַח נָא גֽוֹאֲלִי</tei:l>
          <tei:l>דִּמְעָה תִזַּל מִן עֵינַיָּה</tei:l>
          <tei:l>עַל־כָּל־מַֽעֲלָלִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yah_ezrati_min_shemayya_aboud/2"/>
        <tei:lg>
          <tei:l>אֵל רָם אָשִׁיר לָךְ תָּמִיד אֵל חַי וְקַיָּם</tei:l>
          <tei:l>חַיִּים וּמָזוֹן תֵן לְעַם עוֹבֵד יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yah_ezrati_min_shemayya_aboud/3"/>
        <tei:lg>
          <tei:l>כַּמָּה זְמָן הִסְגַּרְתַּנִי</tei:l>
          <tei:l>בְּיַד אוֹיֵב לוֹחֵם</tei:l>
          <tei:l>שׁוּב אֵל חֲבִֽיבִי רְעֵנִי</tei:l>
          <tei:l>וְגַם תְּנָה לִי חֵן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yah_ezrati_min_shemayya_aboud/4"/>
        <tei:lg>
          <tei:l>אֵל רָם אָשִׁיר לָךְ תָּמִיד אֵל חַי וְקַיָּם</tei:l>
          <tei:l>חַיִּים וּמָזוֹן תֵן לְעַם עוֹבֵד יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yah_ezrati_min_shemayya_aboud/5"/>
        <tei:lg>
          <tei:l>בֵּית קָדְשִׁי לָֽמָּה עֲזַבְתּוֹ</tei:l>
          <tei:l>הַשְׁרֵה שְׁכִינְתָּךְ עֲלֵהּ</tei:l>
          <tei:l>הַחְזֵר יָהּ אָבִי תִפְאַרְתּוֹ</tei:l>
          <tei:l>וּלְצָרוֹתַי שִׂים קֵץ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yah_ezrati_min_shemayya_aboud/6"/>
        <tei:lg>
          <tei:l>אֵל רָם אָשִׁיר לָךְ תָּמִיד אֵל חַי וְקַיָּם</tei:l>
          <tei:l>חַיִּים וּמָזוֹן תֵן לְעַם עוֹבֵד יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yah_ezrati_min_shemayya_aboud/7"/>
        <tei:lg>
          <tei:l>שְׁעֵה אֵל רַֽחֲמָן שִׂיחָתִי אָהּ</tei:l>
          <tei:l>וּשְׁפַע עָלַי מֵהוֹדָךְ</tei:l>
          <tei:l>יָהּ עֶזְרָתִי יָהּ חֶמְדָּתִי</tei:l>
          <tei:l>יָהּ תִּקְוָתִי מִן שְׁמַיָּא</tei:l>
          <tei:l>חוּס וַֽחֲמֹל עָלַי יָהּ מִן שְׁמַיָּא</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
