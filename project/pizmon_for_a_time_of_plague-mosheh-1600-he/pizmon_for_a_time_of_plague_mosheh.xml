  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:pizmon_for_a_time_of_plague_mosheh">
        <tei:head>פזמון בשעת המגפה ח״ו</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:pizmon_for_a_time_of_plague_mosheh/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">פזמון בניגון חננו יי חננו</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">לעצור ולבטל המגפה והמות הבא בעירינו.</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">ושם המחבר</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">הרב הגאון מוהר״ר משה ר׳ מענדלש</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">ז״ל מקראקא</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">שהיה אב״ד ור״מ בק״ק פראג</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">חתום שמו ואח״כ מיוסד ע״פ א״ב</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:pizmon_for_a_time_of_plague_mosheh/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מ</tei:seg>וֹשֵׁל בָּעֶלְיוֹנִים</tei:l>
          <tei:l>אַתָּה יָדַֽעְתָּ אֵת כׇּל־הַתְּלָאָה</tei:l>
          <tei:l><tei:seg type="acrostic">שַׁ</tei:seg>לִּיט בַּתַּחְתּוֹנִים</tei:l>
          <tei:l>הַשּׁוֹלֵֽחַ צֳרִי וּמָזוֹר וּרְפוּאָה</tei:l>
          <tei:l><tei:seg type="acrostic">הַ</tei:seg>סּוֹלֵֽחַ לַעֲוֺנִים</tei:l>
          <tei:l>נֹשֵׂא עָוֺן וָפֶֽשַׁע וְחַטָּאָה׃</tei:l>
          <tei:l>לַיי אֱלֹהֵֽינוּ חָטָֽאנוּ</tei:l>
          <tei:l>אֵל נָא רְפָא נָא לָֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:pizmon_for_a_time_of_plague_mosheh/3"/>
        <tei:lg>
          <tei:l>אִם <tei:seg type="acrostic">אָ</tei:seg>שַֽׁמְנוּ בַּעֲוֺן נְדָרִים</tei:l>
          <tei:l>לַחֲטִיא אֶת־בְּשָׂרֵֽנוּ</tei:l>
          <tei:l><tei:seg type="acrostic">בָּ</tei:seg>כֹה תִּבְכֶּה נַפְשֵֽׁנוּ בְּמִסְתָּרִים</tei:l>
          <tei:l>פְּנֵי צוּרֵֽנוּ וְיוֹצְרֵֽנוּ</tei:l>
          <tei:l><tei:seg type="acrostic">גַּ</tei:seg>לֵּה נַרְתֵּק מַרְפֵּה בְשָׂרֵֽנוּ</tei:l>
          <tei:l>שַׁוְעֵֽנוּ אֵלֶֽיךָ וְתִרְפָּאֶנּוּ׃</tei:l>
          <tei:l>לַיי אֱלֹהֵֽינוּ חָטָֽאנוּ</tei:l>
          <tei:l>אֵל נָא רְפָא נָא לָֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:pizmon_for_a_time_of_plague_mosheh/4"/>
        <tei:lg>
          <tei:l>אִם <tei:seg type="acrostic">דַּ</tei:seg>לְתֵי הַתּוֹרָה סָגַֽרְנוּ</tei:l>
          <tei:l>לְחַבֵּל מַעֲשֵׂה יָדֵֽינוּ</tei:l>
          <tei:l><tei:seg type="acrostic">הִ</tei:seg>נֵּה בְּקִרְבֵּֽנוּ רֽוּחַ שִׂבַּֽרְנוּ</tei:l>
          <tei:l>פְּנֵי אֲדֹנָי אֲדוֹנֵֽינוּ</tei:l>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>יִשְׁלַח מַרְפֵּה לְכׇל־בְּשָׂרֵֽנוּ</tei:l>
          <tei:l>שִׁבְרֵֽנוּ רְפָא אֱלֹהֵֽינוּ</tei:l>
          <tei:l>לַיי אֱלֹהֵֽינוּ חָטָֽאנוּ</tei:l>
          <tei:l>אֵל נָא רְפָא נָא לָֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:pizmon_for_a_time_of_plague_mosheh/5"/>
        <tei:lg>
          <tei:l>אִם <tei:seg type="acrostic">זִ</tei:seg>לְזַֽלְנוּ מִצְוַת מְזוּזָה</tei:l>
          <tei:l>לְהַרְבּוֹת יְמֵי זַרְעֵֽנוּ</tei:l>
          <tei:l><tei:seg type="acrostic">חֲ</tei:seg>רָדָה בִּעַֽתְנוּ וּרְעָדָה אָחֲזָה</tei:l>
          <tei:l>פְּנֵי אֱלֹהֵי יִשְׁעֵֽנוּ</tei:l>
          <tei:l><tei:seg type="acrostic">טַ</tei:seg>פֵּֽנוּ יַצִּיל בְּאַהֲבָה עַזָּה</tei:l>
          <tei:l>שְׁמַע קוֹלֵֽנוּ וְהוֹשִׁיעֵֽנוּ׃</tei:l>
          <tei:l>לַיי אֱלֹהֵֽינוּ חָטָֽאנוּ</tei:l>
          <tei:l>אֵל נָא רְפָא נָא לָֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:pizmon_for_a_time_of_plague_mosheh/6"/>
        <tei:lg>
          <tei:l>אִם <tei:seg type="acrostic">יְ</tei:seg>כֹֽלֶת עֲוֺן צִיצִית</tei:l>
          <tei:l>לְמַעֵט יְמֵי בָנֵֽינוּ</tei:l>
          <tei:l><tei:seg type="acrostic">כַּ</tei:seg>ף סָפַֽקְנוּ עָוֺן נִרְצִית</tei:l>
          <tei:l>פְּנֵי אֱלֹהֵֽינוּ תַּחֲנוּנֵֽינוּ</tei:l>
          <tei:l><tei:seg type="acrostic">לָ</tei:seg>שׁוֹן מַרְפֵּה עֲמֹד בְּפִרְצוֹת</tei:l>
          <tei:l>שְׁמַע קוֹלִי רִנּוּנֵֽנוּ׃</tei:l>
          <tei:l>לַיי אֱלֹהֵֽינוּ חָטָֽאנוּ</tei:l>
          <tei:l>אֵל נָא רְפָא נָא לָֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:pizmon_for_a_time_of_plague_mosheh/7"/>
        <tei:lg>
          <tei:l>אִם <tei:seg type="acrostic">מָ</tei:seg>עַֽלְנוּ בְּשִׂנְאַת חִנָּם</tei:l>
          <tei:l>לְהָמִית בָּנִים וּבָנוֹת</tei:l>
          <tei:l><tei:seg type="acrostic">נְ</tei:seg>הִי וּבְכִי עֶזְרָם וּמָגִנָּם</tei:l>
          <tei:l>פְּנֵי מַאֲזִין תְּחִנּוֹת</tei:l>
          <tei:l><tei:seg type="acrostic">סְ</tei:seg>לַח לְחַטָּאת עִמָּךְ וַעֲוֺנוֹת</tei:l>
          <tei:l>שְׁלַח רְפוּאָה מִמְּעוֹנוֹת׃</tei:l>
          <tei:l>לַיי אֱלֹהֵֽינוּ חָטָֽאנוּ</tei:l>
          <tei:l>אֵל נָא רְפָא נָא לָֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:pizmon_for_a_time_of_plague_mosheh/8"/>
        <tei:lg>
          <tei:l>אִם <tei:seg type="acrostic">עָ</tei:seg>וִֽינוּ בִּשְׁבוּעוֹת שֶֽׁקֶר</tei:l>
          <tei:l>לְמַעֵט בְּנֵי אָדָם</tei:l>
          <tei:l><tei:seg type="acrostic">פָּ</tei:seg>נִים כָּבַֽשְׁנוּ לְאֵין חֵֽקֶר</tei:l>
          <tei:l>פְּנֵי יוֹצֵר הָאָדָם</tei:l>
          <tei:l><tei:seg type="acrostic">צֳ</tei:seg>רִי וּמָזוֹר לְצֹאנְךָ תְּבַקֵּר</tei:l>
          <tei:l>שְׁאֵרִיתָם מִשְּׁאוֹל תִּפְדֵם׃</tei:l>
          <tei:l>לַיי אֱלֹהֵֽינוּ חָטָֽאנוּ</tei:l>
          <tei:l>אֵל נָא רְפָא נָא לָֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:pizmon_for_a_time_of_plague_mosheh/9"/>
        <tei:lg>
          <tei:l>אִם <tei:seg type="acrostic">קִ</tei:seg>לְקוּל שְׁבוּעַת שָׁוְא</tei:l>
          <tei:l>לִבְנֵי אָדָם מִעֲטָה</tei:l>
          <tei:l><tei:seg type="acrostic">רְ</tei:seg>עָדָה אֲחָזַֽתְנוּ לְדַרְכֵּֽנוּ מְתַעֵב</tei:l>
          <tei:l>פְּנֵי אוֹר עוֹטֶה</tei:l>
          <tei:l><tei:seg type="acrostic">שֶֽׁ</tei:seg>מֶשׁ לֹא יַכֶּֽנּוּ וְשָׁרָב</tei:l>
          <tei:l>שְׁמַע יי וְהַבִּֽיטָה׃</tei:l>
          <tei:l>לַיי אֱלֹהֵֽינוּ חָטָֽאנוּ</tei:l>
          <tei:l>אֵל נָא רְפָא נָא לָֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:pizmon_for_a_time_of_plague_mosheh/10"/>
        <tei:lg>
          <tei:l>אִם <tei:seg type="acrostic">תִּ</tei:seg>עַֽבְנוּ בְּחִלּוּל שַׁבָּת</tei:l>
          <tei:l>לְמַעֵט יְמֵי שְׁנוֹתֵֽינוּ</tei:l>
          <tei:l><tei:seg type="acrostic">מַ</tei:seg>סֹּֽנוּ כִּקְדֹֽחַ אֵשׁ וְלַבָּת</tei:l>
          <tei:l>פְּנֵי שׁוֹמֵֽעַ תְּחִנָּתֵֽנוּ</tei:l>
          <tei:l><tei:seg type="acrostic">שׇׁ</tei:seg>מְרֵֽנוּ כְּאִישׁוֹן עַֽיִן וּבָבַת</tei:l>
          <tei:l>שְׁלַח רְפוּאָה לְמַכּוֹתֵֽינוּ׃</tei:l>
          <tei:l>לַיי אֱלֹהֵֽינוּ חָטָֽאנוּ</tei:l>
          <tei:l>אֵל נָא רְפָא נָא לָֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:pizmon_for_a_time_of_plague_mosheh/11"/>
        <tei:lg>
          <tei:l>אִם <tei:seg type="acrostic">הֶ</tei:seg>עֱוִֽינוּ בְּחִלּוּל הַשֵּׁם</tei:l>
          <tei:l>לְמַעֵט פְּרִי בִטְנֵֽנוּ</tei:l>
          <tei:l><tei:seg type="acrostic">בֹּֽ</tei:seg>שְׁנוּ וְשַֽׂמְנוּ נַפְשֵֽׁנוּ אָשָׁם</tei:l>
          <tei:l>פְּנֵי מַאֲזִין חִנּוּנֵֽינוּ</tei:l>
          <tei:l><tei:seg type="acrostic">נָ</tei:seg>א תָּיו חַיִּים בְּרֶֽשֶׁם</tei:l>
          <tei:l>שֶֽׁמֶן שָׂשׂוֹן מֵחֲבֵרֵֽינוּ׃</tei:l>
          <tei:l>לַיי אֱלֹהֵֽינוּ חָטָֽאנוּ</tei:l>
          <tei:l>אֵל נָא רְפָא נָא לָֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:pizmon_for_a_time_of_plague_mosheh/12"/>
        <tei:lg>
          <tei:l>אִם <tei:seg type="acrostic">מָ</tei:seg>עַֽלְנוּ בְּפֶה מְנֻבַּל</tei:l>
          <tei:l>לְמַעֵט אֶת־צֶאֱצָאֵֽינוּ</tei:l>
          <tei:l><tei:seg type="acrostic">הִ</tei:seg>נֵּה נַפְשֵֽׁנוּ מִתְהַפֵּךְ בְּתַחְבּוּל</tei:l>
          <tei:l>פְּנֵי אָבִֽינוּ רוֹעֵֽנוּ</tei:l>
          <tei:l><tei:seg type="acrostic">רַ</tei:seg>חֵם פְּרִי בֶּֽטֶן מִלְּחַבֵּל</tei:l>
          <tei:l>שֶֽׁמֶשׁ צְדָקָה רְפָאֵֽנוּ׃</tei:l>
          <tei:l>לַיי אֱלֹהֵֽינוּ חָטָֽאנוּ</tei:l>
          <tei:l>אֵל נָא רְפָא נָא לָֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:pizmon_for_a_time_of_plague_mosheh/13"/>
        <tei:lg>
          <tei:l>אִם <tei:seg type="acrostic">רָ</tei:seg>שַֽׁעְנוּ בְּמִינֵי בְרָכוֹת</tei:l>
          <tei:l>לָמוּת מְמוֹתֵי תַּחֲלוּאִים</tei:l>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>גוֹן בְּלִבֵּֽנוּ וְהַרְבּוֹת בִּכְיוֹת</tei:l>
          <tei:l>פְּנֵי רוֹפֵא חֳלָאִים</tei:l>
          <tei:l><tei:seg type="acrostic">שַׁ</tei:seg>לַּח רְצוּצִים חׇפְשִׁים בִּשְׂמָחוֹת</tei:l>
          <tei:l>שָׂשׂוֹן וְשִׂמְחָה תַּשְׁמִיעֵם׃</tei:l>
          <tei:l>לַיי אֱלֹהֵֽינוּ חָטָֽאנוּ</tei:l>
          <tei:l>אֵל נָא רְפָא נָא לָֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:pizmon_for_a_time_of_plague_mosheh/14"/>
        <tei:lg>
          <tei:l>אִם <tei:seg type="acrostic">עָ</tei:seg>וִֽינוּ בִּתְפִלּוֹת צִבּוּר</tei:l>
          <tei:l>לֹא מָצָֽאנוּ חַיִּים</tei:l>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>גַֽעְנוּ בְּקׇרְאֵֽנוּ בְּפֶה וּבְדִבּוּר</tei:l>
          <tei:l>פְּנֵי אֱלֹהִים חַיִּים</tei:l>
          <tei:l><tei:seg type="acrostic">ה</tei:seg>וּא יַחֲבֹשׁ פֶּֽצַע וַחֲבַרְבּוּר</tei:l>
          <tei:l>שׁוּב מֵחֲרוֹן אַפַּֽיִם׃</tei:l>
          <tei:l>לַיי אֱלֹהֵֽינוּ חָטָֽאנוּ</tei:l>
          <tei:l>אֵל נָא רְפָא נָא לָֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:pizmon_for_a_time_of_plague_mosheh/15"/>
        <tei:lg>
          <tei:l>אִם <tei:seg type="acrostic">מֵ</tei:seg>עַצְלוּת אֲבֵלוּת אָדָם הָגוּן</tei:l>
          <tei:l>לְהָמִית כְּעָרוּד מֵמִית</tei:l>
          <tei:l><tei:seg type="acrostic">נַ</tei:seg>פְשֵֽׁנוּ עַד־אָֽנָה בְּיָגוֹן</tei:l>
          <tei:l>פְּנֵי מְחַיֶּה וּמֵמִית</tei:l>
          <tei:l><tei:seg type="acrostic">ח</tei:seg>וֹסִים בּוֹ הוּא מָגֵן</tei:l>
          <tei:l>שְׁלַח אוֹרְךָ וֶאֱמֶת׃</tei:l>
          <tei:l>לַיי אֱלֹהֵֽינוּ חָטָֽאנוּ</tei:l>
          <tei:l>אֵל נָא רְפָא נָא לָֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:pizmon_for_a_time_of_plague_mosheh/16"/>
        <tei:lg>
          <tei:l>אִם <tei:seg type="acrostic">מֵ</tei:seg>חֲמַת כְּבוֹד תַּלְמִידִים</tei:l>
          <tei:l>לֻכַּֽדְנוּ בִּמְצוּדָה רָעָה</tei:l>
          <tei:l><tei:seg type="acrostic">זָ</tei:seg>לְגוּ עֵינֵֽינוּ וּבְשָׂרֵֽנוּ חֲרוּדִים</tei:l>
          <tei:l>פְּנֵי מִתְרַצֶּה בְּדִמְעָה</tei:l>
          <tei:l><tei:seg type="acrostic">לָ</tei:seg>תֵת רִפְאוּת לְזֶֽרַע יְהוּדִים</tei:l>
          <tei:l>שׁוּבֵֽנוּ לְחַיֵּי שָׁעָה׃</tei:l>
          <tei:l>לַיי אֱלֹהֵֽינוּ חָטָֽאנוּ</tei:l>
          <tei:l>אֵל נָא רְפָא נָא לָֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:pizmon_for_a_time_of_plague_mosheh/17"/>
        <tei:lg>
          <tei:l>אִם <tei:seg type="acrostic">חַ</tei:seg>טַּאת עֲוֺן הָעֵֽגֶל</tei:l>
          <tei:l>לִפְקוֹד בֵּינֵֽינוּ בְּיוֹם פְּקוּדָה</tei:l>
          <tei:l><tei:seg type="acrostic">זֹ</tei:seg>את נֶחָמָתִי רַחֲמָיו לְגַלְגֵּל</tei:l>
          <tei:l>פָּנָיו נְקַדְּמָה בְּתוֹדָה</tei:l>
          <tei:l><tei:seg type="acrostic">קֶֽ</tei:seg>צֶף שַׁכַּךְ מֵעַם סֶֽגֶל</tei:l>
          <tei:l>שַׁוְעַת יִשְׂרָאֵל וִיהוּדָה׃</tei:l>
          <tei:l>לַיי אֱלֹהֵֽינוּ חָטָֽאנוּ</tei:l>
          <tei:l>אֵל נָא רְפָא נָא לָֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:pizmon_for_a_time_of_plague_mosheh/18"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">[אחר כך:]</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">אל מלך וכו׳</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">ויעבור וכו׳</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">זכור רחמיך וכו׳ עד ואל חטאתו׃</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">אל נא תשת וכו׳ עד רפא נא לה׃</tei:note>
          </tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
