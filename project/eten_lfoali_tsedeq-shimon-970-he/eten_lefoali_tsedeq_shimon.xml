    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:eten_lefoali_tsedeq_shimon">
        <tei:head>אֶתֵּן לְפוֹעֲלִי צֶֽדֶק</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eten_lefoali_tsedeq_shimon/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אֶ</tei:seg>תֵּן לְפוֹעֲלִי צֶֽדֶק</tei:l>
          <tei:l><tei:seg type="acrostic">בַּ</tei:seg>יּוֹם הַנִּבְחַר מַֽעַשׂ לְהִבָּדֵק׃</tei:l>
          <tei:l><tei:seg type="acrostic">גַּ</tei:seg>אֲוָתוֹ מְאֹד גָּדְלָה</tei:l>
          <tei:l><tei:seg type="acrostic">דֶּֽ</tei:seg>רֶךְ עֲנָוָתוֹ לְפִי הַגְּדֻלָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eten_lefoali_tsedeq_shimon/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ה</tei:seg>וּא אֲדוֹן הָעוֹלָם</tei:l>
          <tei:l><tei:seg type="acrostic">וּ</tei:seg>מִי הִקְשָׁה אֵלָיו וַיִּשְׁלָם׃</tei:l>
          <tei:l><tei:seg type="acrostic">ז</tei:seg>וֹכֵר הוֹלֵךְ בַּתֹּם</tei:l>
          <tei:l><tei:seg type="acrostic">ח</tei:seg>וֹנֵן וְעוֹשֶׂה דִּין יָתוֹם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eten_lefoali_tsedeq_shimon/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">טָ</tei:seg>הוֹר מָרוֹם וְנִשָּׂא</tei:l>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>פֶה בְעִתּוֹ הַכֹּל עָשָׂה׃</tei:l>
          <tei:l><tei:seg type="acrostic">כַּ</tei:seg>בִּיר לֹא יִמְאַס</tei:l>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>נִבְזֶה בְעֵינָיו נִמְאָס׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eten_lefoali_tsedeq_shimon/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מְ</tei:seg>פֹאָר רוֹכֵב עֲרָבוֹת</tei:l>
          <tei:l><tei:seg type="acrostic">נֹֽ</tei:seg>גַהּ נֶגְדּוֹ וְאֵשׁ לֶהָבוֹת׃</tei:l>
          <tei:l><tei:seg type="acrostic">ס</tei:seg>וֹעֵף בַּחֲרָבוֹת שְׁנוּנוֹת</tei:l>
          <tei:l><tei:seg type="acrostic">עֲ</tei:seg>בוּר יְתוֹמִים וְאַלְמָנוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eten_lefoali_tsedeq_shimon/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פֹּֽ</tei:seg>עַל אָדָם יְשַׁלֵּם</tei:l>
          <tei:l><tei:seg type="acrostic">צָ</tei:seg>ר פֶּה וּמֵשִׂים אִלֵּם׃</tei:l>
          <tei:l><tei:seg type="acrostic">ק</tei:seg>וֹנֵה הַכֹּל בְּרַחֲמִים</tei:l>
          <tei:l><tei:seg type="acrostic">רָ</tei:seg>ם וּמַשְׁפִּיל רָמִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eten_lefoali_tsedeq_shimon/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שׁ</tei:seg>וֹפֵט יְצוּרָיו בַּחֲנִינָה</tei:l>
          <tei:l><tei:seg type="acrostic">תְּ</tei:seg>מִים פֹּֽעַל אֵל אֱמוּנָה׃</tei:l>
          <tei:l><tei:seg type="acrostic">שֽׁ</tei:seg>וֹפְטֵי אֶֽרֶץ כַּתֹּֽהוּ</tei:l>
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>פַּחְדּוֹ יִבָּהֲלוּ וְיִתְמָֽהוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eten_lefoali_tsedeq_shimon/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ע</tei:seg>וֹשֶׂה מִשְׁפַּט עַמּוֹ</tei:l>
          <tei:l><tei:seg type="acrostic">וּ</tei:seg>תְחִלָּה מְקַדְּמָם מִפְּנֵי זַעְמוֹ׃</tei:l>
          <tei:l><tei:seg type="acrostic">נְ</tei:seg>דִיבִים בְּדִקְדּוּקָם יָחִֽילוּ</tei:l>
          <tei:l><tei:seg type="acrostic">בַּ</tei:seg>אֲשֶׁר מִשְׁפָּטוֹ פָּעָֽלוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eten_lefoali_tsedeq_shimon/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ר</tei:seg>וֹאֶה כׇּל תַּעֲלוּמוֹת</tei:l>
          <tei:l><tei:seg type="acrostic">י</tei:seg>וֹשֵׁב בְּגָבְהֵי מְרוֹמוֹת׃</tei:l>
          <tei:l><tei:seg type="acrostic">צ</tei:seg>וֹפֶה כׇּל נוֹלָדוֹת</tei:l>
          <tei:l><tei:seg type="acrostic">ח</tei:seg>וֹפֵשׂ כׇּל הָעֲתִידוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eten_lefoali_tsedeq_shimon/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ק</tei:seg>וֹרֵא הַדּוֹרוֹת מֵרֹאשׁ</tei:l>
          <tei:l><tei:seg type="acrostic">חִ</tei:seg>קְרֵי לֵב לָתוּר וְלִדְרוֹשׁ׃</tei:l>
          <tei:l><tei:seg type="acrostic">ז</tei:seg>וֹכֵר בְּרִית רִאשׁוֹנִים</tei:l>
          <tei:l><tei:seg type="acrostic">קַ</tei:seg>יֵּם שְׁבוּעָה לָאַחֲרוֹנִים׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
