  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_of_the_guest_chaplain_of_the_u_s_house_goldman_55495">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_of_the_guest_chaplain_of_the_u_s_house_goldman_55495/2"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>ה׳ אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם</tei:l>
          <tei:l>שֶׁנָּתַן מֵחׇכְמָתוֹ</tei:l>
          <tei:l>לְבָשָׂר וָדָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_of_the_guest_chaplain_of_the_u_s_house_goldman_55495/3"/>
        <tei:lg>
          <tei:l>אַתָּה חוֹנֵן לְאָדָם דַּעַת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_of_the_guest_chaplain_of_the_u_s_house_goldman_55495/7"/>
        <tei:lg>
          <tei:l>חָנֵּנוּ מֵאִתְּךָ</tei:l>
        </tei:lg>
      </tei:div>
