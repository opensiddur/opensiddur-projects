  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:mah_tovu">
        <tei:head>מַה־טֹּבוּ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mah_tovu/mah_tovu-varani"/>
        <tei:lg>
          <tei:l>מַה־נּוֺרָֽה הַמָּקֽוֺם הַזֶּֽה,</tei:l>
          <tei:l>אֵין זֶה כִּי אִם־בֵּית אֶלֹהִים,</tei:l>
          <tei:l>וְזֶה שַׁעַר הַשָּׁמָֽיִם׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וַֽאֲנִי, בְּרֹֽב חַסְדְּךָ, אָבֹֽא בֵיתֶֽךָ,</tei:l>
          <tei:l>אֶשְׁתַּֽחֲוֶה אֶל־הֵיכַל קָדְשְׁךָ, בְּיִרְאָתֶֽךָ׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בְּבֵֽית אֱלֹהִים נְהַלֵּֽךְ בְּרָֽגֶשׁ׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>מַה־טֹּבֽוּ אֹהָלֶֽיךָ יַעֲקֹב, מִשְׁכְּנֹתֶֽיךָ, יִשְׂרָאֵל:</tei:l>
          <tei:l>וַֽאֲנִי, בְּרֹב חַסְדְּךָ, אָבֹא בֵיתֶֽךָ,</tei:l>
          <tei:l>אֶשְׁתַּֽחֲוֶה אֶל־הֵיכַל קָדְשְׁךָ, בְּיִרְאָתֶֽךָ:</tei:l>
          <tei:l>יְהֹוָה, אָהַבְתִּי מְעוֹן בֵּיתֶֽךָ, וּמְקוֹם, מִשְׁכַּן כְּבוֹדֶֽךָ:</tei:l>
          <tei:l>וַֽאֲנִי אֶשְׁתַּחֲוֶה וְאֶכְרָֽעָה, אֶבְרְכָה לִפְנֵי־יְהֹוָה עֹשִׂי:</tei:l>
          <tei:l>וַֽאֲנִי תְפִילָתִי־לְךָ ׀ יְהֹוָה עֵת רָצוֹן.</tei:l>
          <tei:l>אֱלֹהִים, בְּרָב־חַסְדֶּךָ, עֲנֵֽנִי בֶּאֱמֶת יִשְׁעֶֽךָ:</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
