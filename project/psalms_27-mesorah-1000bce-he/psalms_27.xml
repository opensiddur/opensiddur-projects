      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/27">
        <tei:head>תהלים כ״ז</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/27/1"/>
        <tei:lg>
          <tei:l>לְדָוִ֨ד ׀</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>יְהוָ֤ה ׀ אוֹרִ֣י וְ֭יִשְׁעִי</tei:l>
          <tei:l>מִמִּ֣י אִירָ֑א</tei:l>
          <tei:l>יְהוָ֥ה מָֽעוֹז־חַ֝יַּ֗י</tei:l>
          <tei:l>מִמִּ֥י אֶפְחָֽד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/27/2"/>
        <tei:lg>
          <tei:l>בִּקְרֹ֤ב עָלַ֨י ׀ מְרֵעִים֮</tei:l>
          <tei:l>לֶאֱכֹ֪ל אֶת־בְּשָׂ֫רִ֥י</tei:l>
          <tei:l>צָרַ֣י</tei:l>
          <tei:l>וְאֹיְבַ֣י לִ֑י הֵ֖מָּה</tei:l>
          <tei:l>כָשְׁל֣וּ וְנָפָֽלוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/27/3-4"/>
        <tei:lg>
          <tei:l>אִם־תַּחֲנֶ֬ה עָלַ֨י ׀ מַחֲנֶה֮</tei:l>
          <tei:l>לֹֽא־יִירָ֪א לִ֫בִּ֥י</tei:l>
          <tei:l>אִם־תָּק֣וּם עָ֭לַי מִלְחָמָ֑ה</tei:l>
          <tei:l>בְּ֝זֹ֗את אֲנִ֣י בוֹטֵֽחַ׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>אַחַ֤ת ׀ שָׁאַ֣לְתִּי מֵֽאֵת־יְהוָה֮</tei:l>
          <tei:l>אוֹתָ֪הּ אֲבַ֫קֵּ֥שׁ</tei:l>
          <tei:l>שִׁבְתִּ֣י בְּבֵית־יְ֭הוָה כָּל־יְמֵ֣י חַיַּ֑י</tei:l>
          <tei:l>לַחֲז֥וֹת בְּנֹֽעַם־יְ֝הוָ֗ה</tei:l>
          <tei:l>וּלְבַקֵּ֥ר בְּהֵיכָלֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/27/5"/>
        <tei:lg>
          <tei:l>כִּ֤י יִצְפְּנֵ֨נִי ׀ בְּסֻכֹּה֮ בְּי֪וֹם רָ֫עָ֥ה</tei:l>
          <tei:l>יַ֭סְתִּרֵנִי בְּסֵ֣תֶר אָהֳל֑וֹ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/27/6-14"/>
        <tei:lg>
          <tei:l>בְּ֝צ֗וּר יְרוֹמְמֵֽנִי׃</tei:l>
          <tei:l>וְעַתָּ֨ה יָר֪וּם רֹאשִׁ֡י עַ֤ל אֹֽיְבַ֬י סְֽבִיבוֹתַ֗י</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְאֶזְבְּחָ֣ה בְ֭אָהֳלוֹ זִבְחֵ֣י תְרוּעָ֑ה</tei:l>
          <tei:l>אָשִׁ֥ירָה וַ֝אֲזַמְּרָ֗ה לַיהוָֽה׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>שְׁמַע־יְהוָ֖ה</tei:l>
          <tei:l>קוֹלִ֥י אֶקְרָ֗א</tei:l>
          <tei:l>וְחָנֵּ֥נִי</tei:l>
          <tei:l>וַעֲנֵֽנִי׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>לְךָ֤ ׀ אָמַ֣ר לִ֭בִּי בַּקְּשׁ֣וּ פָנָ֑י</tei:l>
          <tei:l>אֶת־פָּנֶ֖יךָ יְהוָ֣ה אֲבַקֵּֽשׁ׃</tei:l>
          <tei:l>אַל־תַּסְתֵּ֬ר פָּנֶ֨יךָ ׀ מִמֶּנִּי֮</tei:l>
          <tei:l>אַֽל־תַּט־בְּאַ֗ף עַ֫בְדֶּ֥ךָ</tei:l>
          <tei:l>עֶזְרָתִ֥י הָיִ֑יתָ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>אַֽל־תִּטְּשֵׁ֥נִי</tei:l>
          <tei:l>וְאַל־תַּֽ֝עַזְבֵ֗נִי אֱלֹהֵ֥י יִשְׁעִֽי׃</tei:l>
          <tei:l>כִּי־אָבִ֣י וְאִמִּ֣י עֲזָב֑וּנִי</tei:l>
          <tei:l>וַֽיהוָ֣ה יַֽאַסְפֵֽנִי׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>ה֤וֹרֵ֥נִי יְהוָ֗ה דַּ֫רְכֶּ֥ךָ</tei:l>
          <tei:l>וּ֭נְחֵנִי בְּאֹ֣רַח מִישׁ֑וֹר</tei:l>
          <tei:l>לְ֝מַ֗עַן שׁוֹרְרָֽי׃</tei:l>
          <tei:l>אַֽל־תִּ֭תְּנֵנִי בְּנֶ֣פֶשׁ צָרָ֑י</tei:l>
          <tei:l>כִּ֥י קָֽמוּ־בִ֥י עֵֽדֵי־שֶׁ֝֗קֶר וִיפֵ֥חַ חָמָֽס׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>לׅׄוּלֵׅׄ֗אׅׄ הֶ֭אֱמַנְתִּי לִרְא֥וֹת בְּֽטוּב־יְהוָ֗ה בְּאֶ֣רֶץ חַיִּֽים׃</tei:l>
          <tei:l>קַוֵּ֗ה אֶל־יְה֫וָ֥ה</tei:l>
          <tei:l>חֲ֭זַק וְיַאֲמֵ֣ץ לִבֶּ֑ךָ</tei:l>
          <tei:l>וְ֝קַוֵּ֗ה אֶל־יְהוָֽה׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
