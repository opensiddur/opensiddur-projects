    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:thirty_two_mitsvot_one_can_do_with_consciousness_alone_roth">
        <tei:head>הַל״ב מִצְוֺת הַתְלוּיוֹת בַּלֵּב</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:thirty_two_mitsvot_one_can_do_with_consciousness_alone_roth/1"/>
        <tei:lg>
          <tei:l>הֲרֵינִי מְזַמֵּן אֶת פִּי וּמֹחִי וְלִבִּי</tei:l>
          <tei:l>לְקַיֵּם מִצְוֺת בּוֹרְאִי וְיוֹצְרִי יִתְבָּרַךְ שְׁמוֹ,</tei:l>
          <tei:l>מֵהַמִּצְוֺת הַתְלֻיּוֹת בַּמֹּחַ בַּלֵּב וּבַפֶּה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:thirty_two_mitsvot_one_can_do_with_consciousness_alone_roth/2"/>
        <tei:lg>
          <tei:l>לְהַאֲמִין בֶּאֱמוּנַת הַשֵּׁם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:thirty_two_mitsvot_one_can_do_with_consciousness_alone_roth/3"/>
        <tei:lg>
          <tei:l>לְהַאֲמִין בְּאַחְדוּת הַשֵּׁם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:thirty_two_mitsvot_one_can_do_with_consciousness_alone_roth/4"/>
        <tei:lg>
          <tei:l>לִזְכֹּר הַשֵּׁם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:thirty_two_mitsvot_one_can_do_with_consciousness_alone_roth/5"/>
        <tei:lg>
          <tei:l>לְהִתְבּוֹנֵן בִּגְדֻלַּת הַשֵּׁם.</tei:l>
          <tei:l>לְהִתְבּוֹנֵן בְּשִׁפְלוּת עַצְמוֹ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:thirty_two_mitsvot_one_can_do_with_consciousness_alone_roth/6"/>
        <tei:lg>
          <tei:l>לָשׁוּב לְהַשֵּׁם.</tei:l>
          <tei:l>לֵיבּוֹשׁ מֵהַשֵּׁם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:thirty_two_mitsvot_one_can_do_with_consciousness_alone_roth/7"/>
        <tei:lg>
          <tei:l>לִירֹא מֵהַשֵּׁם.</tei:l>
          <tei:l>לֶאֱהוֹב הַשֵּׁם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:thirty_two_mitsvot_one_can_do_with_consciousness_alone_roth/8"/>
        <tei:lg>
          <tei:l>לְקַבֵּל עוֹל מִצְוֺת הַשֵּׁם.</tei:l>
          <tei:l>לִשְׂמֹחַ בַּשֵּׁם.</tei:l>
          <tei:l>לִבְטֹחַ בַּשֵּׁם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:thirty_two_mitsvot_one_can_do_with_consciousness_alone_roth/9"/>
        <tei:lg>
          <tei:l>לְבַטֵל אֶת כׇּל הַמַּחֲשָׁבוֹת הַפְּסוּלוֹת הָעוֹלוֹת בַּלֵּב.</tei:l>
          <tei:l>וְהוּא בִּכְלָל אִבּוּד עֲבוֹדָה זָרָה ומְשַׁמְּשֶׁיהָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:thirty_two_mitsvot_one_can_do_with_consciousness_alone_roth/10"/>
        <tei:lg>
          <tei:l>לְזְכּוֹר וּלְהוֹדוֹת חַסְדֵּי הַשֵּׁם.</tei:l>
          <tei:l>לִמְסֹר נַפְשׁוֹ לְהַשֵּׁם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:thirty_two_mitsvot_one_can_do_with_consciousness_alone_roth/11"/>
        <tei:lg>
          <tei:l>לְזְכּוֹר אֶת יְרוּשָׁלַיִם.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>לְצַפּוֹת לִישׁוּעַת הַשֵּׁם</tei:l>
          <tei:l>וֶאֱמוּנַת הַגְּאֻלָּה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:thirty_two_mitsvot_one_can_do_with_consciousness_alone_roth/12"/>
        <tei:lg>
          <tei:l>לִמְחֹק אֶת עֲמָלֵק.</tei:l>
          <tei:l>לֶאֱהֹב כׇּל בַּר יִשְׂרָאֵל.</tei:l>
          <tei:l>לִדָּבֵק בְּהַשֵּׁם.</tei:l>
          <tei:l>לָלֶכֶת בְּדַרְכֵי הַשֵּׁם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:thirty_two_mitsvot_one_can_do_with_consciousness_alone_roth/13"/>
        <tei:lg>
          <tei:l>לִהְיוֹת כִּסֵּא</tei:l>
          <tei:l>וּמִשְׁכַּן לְהַשֵּׁם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:thirty_two_mitsvot_one_can_do_with_consciousness_alone_roth/14"/>
        <tei:lg>
          <tei:l>לְהִשְׁתּוֹקֵק לִדְבֵקוּת וְאַהֲבַת הַשֵּׁם.</tei:l>
          <tei:l>לְהִתְחַזֵּק</tei:l>
          <tei:l>בַּעֲבוֹדַת הַשֵּׁם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:thirty_two_mitsvot_one_can_do_with_consciousness_alone_roth/15"/>
        <tei:lg>
          <tei:l>לְהַצְדִּיק מַעֲשֵׂי הַשֵּׁם.</tei:l>
          <tei:l>לִזְכּוֹר</tei:l>
          <tei:l>יְצִיאַת מִצְרַיִם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:thirty_two_mitsvot_one_can_do_with_consciousness_alone_roth/16"/>
        <tei:lg>
          <tei:l>שֶׁלֹּא לְהַעֲלוֹת</tei:l>
          <tei:l>בַּלֵּב שׁוּם</tei:l>
          <tei:l>מַחֲשָׁבָה שֶׁהִיא נֶגֶד הָאֱמוּנָה</tei:l>
          <tei:l>וַעֲבוֹדַת הַשֵּׁם</tei:l>
          <tei:l>וֶאֱמוּנָת תּוֹרָתוֹ הַקְדוֹשָׁה, חַס וְשָׁלוֹם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:thirty_two_mitsvot_one_can_do_with_consciousness_alone_roth/17"/>
        <tei:lg>
          <tei:l>שֶׁלֹּא לְהִתְגָּאוֹת.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:thirty_two_mitsvot_one_can_do_with_consciousness_alone_roth/18"/>
        <tei:lg>
          <tei:l>שֶׁלֹּא לִשְׁנוֹא שׁוּם</tei:l>
          <tei:l>בַּר יִשְׂרָאֵל בַּלֵּב.</tei:l>
          <tei:l>שֶׁלֹּא לִהְיוֹת</tei:l>
          <tei:l>צַדִּיק</tei:l>
          <tei:l>בְּעֵינָיו.</tei:l>
          <tei:l>שֶׁלֹּא לִשְׁכֹּחַ</tei:l>
          <tei:l>מַה שֶּׁהִקְצִיף לְהַשֵּׁם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:thirty_two_mitsvot_one_can_do_with_consciousness_alone_roth/19"/>
        <tei:lg>
          <tei:l>שֶׁלֹּא לִשְׁכֹּחַ</tei:l>
          <tei:l>הַשֵּׁם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:thirty_two_mitsvot_one_can_do_with_consciousness_alone_roth/20"/>
        <tei:lg>
          <tei:l>אָמֵן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:thirty_two_mitsvot_one_can_do_with_consciousness_alone_roth/21"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן מִלְפָנֶיךָ</tei:l>
          <tei:l>אָבִינוּ שֶׁבַּשָּׁמַיִם,</tei:l>
          <tei:l>שֶׁבִזְכוּת וְכֹחַ</tei:l>
          <tei:l>הַזְכָּרַת</tei:l>
          <tei:l>אֵלּוּ הַמִצְוֺת</tei:l>
          <tei:l>בְּפִי,</tei:l>
          <tei:l>יִתְעוֹרְרוּ</tei:l>
          <tei:l>כֹּחָם שֶׁל מִצְוֺת אֵלּוּ</tei:l>
          <tei:l>בּשָׁרְשָׁם הָעֶלְיוֹנָה,</tei:l>
          <tei:l>לְהַמְשִׁיךְ עָלַי</tei:l>
          <tei:l>אוֹר קְדֻשָּׁה הָעֶלְיוֹנָה,</tei:l>
          <tei:l>לִשְׁמֹר אֶת מַחְשְבוֹתַי</tei:l>
          <tei:l>קוֹלִי וְדִבּוּרַי</tei:l>
          <tei:l>מִכׇּל פְּגָם</tei:l>
          <tei:l>וְזֻהֲמָא וְסִיג וּפְסֹלֶת.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:thirty_two_mitsvot_one_can_do_with_consciousness_alone_roth/22"/>
        <tei:lg>
          <tei:l>וְיוּמְשַׁךְ עָלַי שֶׁפַע</tei:l>
          <tei:l>לְטַהֵר</tei:l>
          <tei:l>מַחְשְׁבוֹתַי וְלִבִּי</tei:l>
          <tei:l>קוֹלִי וְדִבּוּרַי,</tei:l>
          <tei:l>שֶּׁיִּהְיוּ כֻלָּם מְשֻׁעְבָּדִים לַעֲבוֹדָתוֹ</tei:l>
          <tei:l>יִתְבָּרַךְ שְׁמוֹ,</tei:l>
          <tei:l>עַד שֶׁאֶזְכֶּה</tei:l>
          <tei:l>לְהִתְקַשֵּׁר</tei:l>
          <tei:l>בִּדְבֵקוּת וְאַהֲבַת שְׁמוֹ יִתְבָּרַךְ,</tei:l>
          <tei:l>וּלְהַגִּיעַ לְקִיּוּם</tei:l>
          <tei:l>מִצְוַת עֲשֵׂה</tei:l>
          <tei:l>”וּלְדָבְקָה בוֹ“.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:thirty_two_mitsvot_one_can_do_with_consciousness_alone_roth/23"/>
        <tei:lg>
          <tei:l>וְאֶזְכֶּה</tei:l>
          <tei:l>לִהְיוֹת כִּסֵּא</tei:l>
          <tei:l>וּמֶרְכָּבָה</tei:l>
          <tei:l>לִשְׁכִינַת כְּבוֹדוֹ יִתְבָּרַךְ שְׁמוֹ,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:thirty_two_mitsvot_one_can_do_with_consciousness_alone_roth/24"/>
        <tei:lg>
          <tei:l>וְלֹא יֶחְשַׁךְ וְלֹא יִכְבֶּה</tei:l>
          <tei:l>אוֹר כֹּחַ נִשְׁמָתִי</tei:l>
          <tei:l>וְנִיצוֹץ אֱלֺהֵי</tei:l>
          <tei:l>שֶׁבְּקִרְבִּי</tei:l>
          <tei:l>מֵעַתָּה וְעַד עוֹלָם,</tei:l>
          <tei:l>אָמֵן</tei:l>
          <tei:l>כֵּן יְהִי רָצוֹן.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
