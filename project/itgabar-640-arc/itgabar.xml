  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:itgabar">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itgabar/1"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">אִ</tei:seg>יתְגַּבַּר בְּחֵילֵיהּ אֲדוֹנִיָּה בַר־חַגִּית</tei:l>
          <tei:l>כַּד־קָם בַּעֲצָתֵיהּ יוֹאָב בַּר־צְרוּיָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itgabar/2"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">בֵּ</tei:seg>ינֵי טוּרַיָּא צְוַח יוֹאָב</tei:l>
          <tei:l>וְכׇל־בִּרְיָתָא שָׁמְעִין קָלֵיהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itgabar/3"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">גִּ</tei:seg>יבָּר הֲוֵינָא וְלֵית דִּכְוָתִי</tei:l>
          <tei:l>וְכׇל־גְּבוּרְתִי מָה אַהְנֵית לִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itgabar/4"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">דְּ</tei:seg>יָתֵיב מַלְכָּא שְׁלֹמֹה וְחָשֵׁיב עֲלַי לְמִקְטְלִי</tei:l>
          <tei:l>וְלָא־צָבֵי שְׁמַע לְקַל מִילָּתִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itgabar/5"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">הֲ</tei:seg>לָא מִדְכַּר לִי מַלְכָּא שְׁלֹמֹה</tei:l>
          <tei:l>כׇּל־טֵיבוּ דַּעֲבָדִית עִם־דָּוִד אֲבוּהִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itgabar/6"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>כַרְכִין וּמָחוֹזִין כַּבֵּישִׁית קֳדָמוֹהִי</tei:l>
          <tei:l>נַחְלֵי יַמָּא וְכׇל־יַבֶּשְׁתָּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itgabar/7"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">זָ</tei:seg>עוּ מִינִּי כׇּל־רַבְרְבַיָּא</tei:l>
          <tei:l>וְכׇל־גִּיבָּרַיָּא עֲרַקוּ מִן־קֳדָמַי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itgabar/8"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">חֲ</tei:seg>בַל עַל־הָדֵין עָלְמָא אִם דֵּין הוּא דִינָא</tei:l>
          <tei:l>דְּגִיבָּר דִּכְוָתִי מִתְקְטֵיל בְּחַרְבָּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itgabar/9"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">טְ</tei:seg>עַם יוֹאָב טַעְמָא דְּמוֹתָא</tei:l>
          <tei:l>כַּד שְׁמַע אָמְרִין אֵיתוּ וְנִקְטְלִינֵּיהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itgabar/10"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>אֵי דִינְכוֹן דְּתִקְטְלוּן יָתִי</tei:l>
          <tei:l>בָּתַר דִּקְטֵילִית כׇּל־שַׂנְאֵיכוֹן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itgabar/11"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">כַּ</tei:seg>ד חֲמָא יוֹאָב דִּמְקַטְּלִין יָתֵיהּ</tei:l>
          <tei:l>שָׁרִי צָוַח לְיוֹאֵל בְּרֵיהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itgabar/12"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">לָ</tei:seg>ךְ יוֹאֵל בְּרִי אֲנָא מְפַקֵּד יָתָךְ</tei:l>
          <tei:l>אוֹרָיְתָא תִיטַּר וְלַאֲחוּךְ תְּרַבֵּי וּלְאִמָּךְ תְּיַקַּר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itgabar/13"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">מַ</tei:seg>ה אַעֲבֵיד לֵיהּ לְמַלְכָּא שְׁלֹמֹה</tei:l>
          <tei:l>אֵיךְ הוּא אַכְזָר לְמִיקְטַל יָתִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itgabar/14"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">נְ</tei:seg>הַם יוֹאָב בְּשַׁעְתָּא הַהִיא</tei:l>
          <tei:l>וְאִישְׁתְּמַע קָלֵיהּ בְּכׇל־אַרְעָא דְּיִשְׂרָאֵל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itgabar/15"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">סְ</tei:seg>בוֹל גַּרְמָךְ וְלָא תִקְטְלִינַּנִי</tei:l>
          <tei:l>דַּעֲתִיד לְמֵיתֵי יוֹמָא דְּתִידְכַּר יָתִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itgabar/16"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">עֲ</tei:seg>נִי לֵיה מַלְכָּא שְׁלֹמֹה</tei:l>
          <tei:l>דְּכִיר לָךְ דְּמָא דְאַבְנֵר בֶּן־נֵר</tei:l>
          <tei:l>וְדַעֲמָשָׂא בֶּן־יֶתֶר לָא־תַּשְׁנִיק רוּחָךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itgabar/17"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>תַח פּוּמֵיהּ יוֹאָב בַּר־צְרוּיָה</tei:l>
          <tei:l>וַאֲזַל וּבְכָא עִם־כׇּל־חַבְרוֹהִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itgabar/18"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">צְ</tei:seg>וַח יוֹאָב בְּשַׁעְתָּא הַהִיא</tei:l>
          <tei:l>וְכׇל־גִּיבָּרַיָּא נְטַלוּ זֵינֵיהוֹן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itgabar/19"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>לֵיהּ אֲרֵים מַלְכָּא שְׁלֹמֹה</tei:l>
          <tei:l>וְשָׁרִי צָוַח לִרְחַבְעָם בְּרֵיהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itgabar/20"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">רְ</tei:seg>חַבְעָם בְּרִי קוּם שְׁלוֹף זֵינָךְ</tei:l>
          <tei:l>וְתִידְכַּר לָךְ דְּמָא דְאַבְשָׁלוֹם דּוֹדָךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itgabar/21"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">שָׁ</tei:seg>מְעִין קָלֵיהּ כׇּל־יִשְׂרָאֵל</tei:l>
          <tei:l>שָׁרְיָן עֵינֵיהוֹן דִּמְעִין מְדַלְּגִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itgabar/22"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">תְּ</tei:seg>מַהּ שְׁלֹמֹה וַאֲמַר בְּלִיבֵּיהּ</tei:l>
          <tei:l>מַה אִיעֲבֵיד לִשְׁבוּעֲתָא דְּאַבָּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itgabar/23"/>
        <tei:lg xml:lang="he">
          <tei:l>כַּד שְׁמַע יוֹאָב בַּר־צְרוּיָה</tei:l>
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>תַח פּוּמֵיהּ יוֹאָב שָׁרִי צָוַח לִבְנָיָהוּ בֶן־יְהוֹיָדָע</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itgabar/24"/>
        <tei:lg xml:lang="he">
          <tei:l>בְּנָיָה בְּנָיָה לָא־תַשְׁנִיק רוּחָךְ</tei:l>
          <tei:l><tei:seg type="acrostic">צַ</tei:seg>וָּארִי תְּקֵיף וְסַיְפָךְ חֲלִישׁ וְלָא אַתְּ יָכֵיל לְמִיקְטַל יָתִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itgabar/25"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">קִ</tei:seg>יצֵּץ בְּנָיָה רֵישֵׁיהּ דְּיוֹאָב</tei:l>
          <tei:l>וְרֵישֵיהּ דְּיוֹאָב עָל לְבֵית מַלְכָּא שְׁלֹמֹה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itgabar/26"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">שְׁ</tei:seg>מָעוּ עַמְמַיָּא דְּאִיקְּטֵיל יוֹאָב</tei:l>
          <tei:l>בְּפוּמְהוֹן חַדְיָן וּבְלִיבְּהוֹן בַּכְיָן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itgabar/27"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">תְּ</tei:seg>וַהוֹ וּבְכוֹ בְּנֵי יִשְׂרָאֵל בִּכְיָא רַבָּא</tei:l>
          <tei:l>עַל־דְּאִיתְקְטֵיל יוֹאָב בַּר־צְרוּיָה׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
