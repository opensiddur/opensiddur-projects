    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:eikh_mishkenai_elyon_yosef">
        <tei:head>אֵיךְ מִשְׁכְּנֵי עֶלְיוֹן</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eikh_mishkenai_elyon_yosef/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אֵ</tei:seg>יךְ מִשְׁכְּנֵי עֶלְיוֹן לְשַׁמָּה נִתְּנוּ</tei:l>
          <tei:l><tei:seg type="acrostic">בָּ</tei:seg>נִים בְּגָלוּת מִגְּבוּלָם רָחֲקוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eikh_mishkenai_elyon_yosef/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נָֽ</tei:seg>צוּ וְנָֽעוּ בֵּין כְּפָרִים שָׁאֲגוּ</tei:l>
          <tei:l><tei:seg type="acrostic">אָ</tei:seg>כֵן צְעִירֵיהֶם עֲלֵיהֶם שָׂחֲקוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eikh_mishkenai_elyon_yosef/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">לֹ</tei:seg>א עָמְדוּ יוֹם מִפְּנֵי זָר נֶהְדָּֽפוּ</tei:l>
          <tei:l><tei:seg type="acrostic">בִּ</tei:seg>בְכִי יְגוֹנוֹתָם אֲבָנִים שָׁחֲקוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eikh_mishkenai_elyon_yosef/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נָ</tei:seg>שׂוּ כְלִמָּתָם וְחֶרְפָּתָם בְּכֵן</tei:l>
          <tei:l><tei:seg type="acrostic">שִׂ</tei:seg>פְתֵי מְשׁוּבָתָם בְּלַעַג פָּשְׂקוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eikh_mishkenai_elyon_yosef/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וַ</tei:seg>יִּסְפְּקוּ כַף בַּעֲוֺנָם שָׁקְעוּ</tei:l>
          <tei:l><tei:seg type="acrostic">לֹ</tei:seg>א שָׁקְעוּ רִשְׁפֵּי לֶהָבִים נָשְׁקוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eikh_mishkenai_elyon_yosef/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">י</tei:seg>וֹם יוֹם יְחַלּוּ אֶת־פְּנֵי צוּר גָּבְהוּ</tei:l>
          <tei:l><tei:seg type="acrostic">הָ</tei:seg>רֵי חֲסָדָיו גַּם שְׁפָטָיו צָדְקוּ</tei:l>
          <tei:l><tei:seg type="acrostic">ח</tei:seg>וֹבֵשׁ לְשֶֽׁבֶר נִֽשְׁבְּרֵי־לֵב נִכְסְפוּ</tei:l>
          <tei:l>אֶל־נָעֳמוֹ יוֹם עַל־דְּלָתָיו דָּפְקוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eikh_mishkenai_elyon_yosef/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זֶֽ</tei:seg>מֶר לְהִדָּבֵק בְּיוֹצְרָם יִשְׂאוּ</tei:l>
          <tei:l><tei:seg type="acrostic">נַ</tei:seg>פְשׁוֹת חֲסִידִים בֵּאלֹהִים דָּבְקוּ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
