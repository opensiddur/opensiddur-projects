    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:hamavdil_bein_qodesh_lechol">
        <tei:head>הַמַּבְדִּיל בֵּין קֹדֶשׁ לְחֹל</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hamavdil_bein_qodesh_lechol/1"/>
        <tei:lg>
          <tei:l>הַמַּבְדִּיל</tei:l>
          <tei:l>בֵּין קֹדֶשׁ לְחֹל</tei:l>
          <tei:l>חַטֹאתֵינוּ הוּא יִמְחוֹל</tei:l>
          <tei:l>זַרְעֵנוּ וְכַסְפֵּנוּ</tei:l>
          <tei:l>יַרְבֶּה כַּחוֹל</tei:l>
          <tei:l>וְכַכּוֹכָבִים בַּלָּיְלָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hamavdil_bein_qodesh_lechol/2"/>
        <tei:lg>
          <tei:l>יוֹם פָּנָה כְּצֵל תֹּמֶר</tei:l>
          <tei:l>אֶקְרָא לָאֵל עָלַי גּוֹמֵר</tei:l>
          <tei:l>יוֹם אֲשֶׁר אָמַר שׁוֹמֵר</tei:l>
          <tei:l>אָתָא בֹּקֶר וְגַם לָיְלָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hamavdil_bein_qodesh_lechol/3-9"/>
        <tei:lg xml:lang="es">
          <tei:l>A la derecha Mihael</tei:l>
          <tei:l>I a la izkierda Gavriel</tei:l>
          <tei:l>I sovre su kavesa Shehinat El</tei:l>
          <tei:l>Kada dia i kada noche</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
