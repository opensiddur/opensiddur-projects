  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:kavvanah_and_prayer_for_zot_hanukkah_5784_by_david_seidenberg_neohasid_org">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kavvanah_and_prayer_for_zot_hanukkah_5784_by_david_seidenberg_neohasid_org/18"/>
        <tei:lg>
          <tei:l>עַל הַנִּסִּים</tei:l>
          <tei:l>וְעַל הַגְּבוּרוֹת</tei:l>
          <tei:l>וְעַל הַתְּשׁוּעוֹת</tei:l>
          <tei:l>וְעַל הַנֶּחָמוֹת</tei:l>
          <tei:l>שֶׁתַּעֲשֶׂה לָנוּ</tei:l>
          <tei:l>בַּיָּמִים הַבָּאִים</tei:l>
          <tei:l>בַּזְּמַן הַזֶּה</tei:l>
          <tei:l>כֵּן יְהִי רָצוֹן</tei:l>
          <tei:l>אָמֵן וְאָמֵן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kavvanah_and_prayer_for_zot_hanukkah_5784_by_david_seidenberg_neohasid_org/21"/>
        <tei:lg>
          <tei:l>יְהוָה הֵפִיר עֲצַת גּוֹיִם</tei:l>
          <tei:l>הֵנִיא מַחְשְׁבוֹת עַמִּים</tei:l>
          <tei:l>מִמֶּנּוּ יָגוּרוּ</tei:l>
          <tei:l>כָּל־יֹשְׁבֵי תֵבֵל</tei:l>
          <tei:l>כָל־מַעֲשֵׂהוּ בֶּאֱמוּנָה</tei:l>
          <tei:l>אֹהֵב צְדָקָה וּמִשְׁפָּט</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>חֶסֶד יְהוָה מָלְאָה הָאָרֶץ</tei:l>
          <tei:l>אֵין נוֹשָׁע בְּרָב־חָיִל</tei:l>
          <tei:l>לֹא בְחַיִל וְלֹא בְכֹחַ כִּי אִם־בְּרוּחִי <tei:bibl>(זכריה ד:ו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kavvanah_and_prayer_for_zot_hanukkah_5784_by_david_seidenberg_neohasid_org/23"/>
        <tei:lg>
          <tei:l>אָנָּא יְהוָה הוֹשִׁיעָה נָא</tei:l>
          <tei:l>אָנָּא יְהוָה הַצְלִיחָה נָא</tei:l>
          <tei:l>הַצִּיל מִמָּוֶת נַפְשֵׁנוּ לְחַיּוֹתָם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/33/22"/>
        <tei:lg>
          <tei:l>יְהִי חַסְדֵךְ יְהוָה עָלֵינוּ</tei:l>
          <tei:l>כַּאֲשֶׁר יִחַלְנוּ לָךְ</tei:l>
        </tei:lg>
      </tei:div>
