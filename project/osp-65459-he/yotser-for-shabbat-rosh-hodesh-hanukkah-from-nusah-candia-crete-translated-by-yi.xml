  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotzer_or/opening"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם</tei:l>
          <tei:l>יוֹצֵר אוֹר וּבוֹרֵא חֹשֶׁךְ</tei:l>
          <tei:l>עֹשֶׂה שָׁלוֹם וּבוֹרֵא אֶת הַכֹּל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/2"/>
        <tei:lg>
          <tei:l>אוֹר עוֹלָם בְּאוֹצַר חַיִּים</tei:l>
          <tei:l>אוֹרוֹת מֵאֹפֶל אָמַר וַיֶּהִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/3"/>
        <tei:lg>
          <tei:l>꙳ ꙳ ꙳</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אֲ</tei:seg>נוֹבֵב וְשִׂיחִי אֶשְׁפְּכָה</tei:l>
          <tei:l>בְּעַד עֲנֻגָּה וְרַכָּה</tei:l>
          <tei:l>בְּשַׁבָּת וְרֹאשׁ חֹֽדֶשׁ וַחֲנֻכָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>מוֹעֵצוֹת וּבַשָּׁלִישִׁים</tei:l>
          <tei:l>וּבִשְׂמָחוֹת מְשֻׁלָּשִׁים</tei:l>
          <tei:l>הִנְחִיל לַקְּדוֹשִׁים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">גִּ</tei:seg>יל יוֹם מְנוּחָה</tei:l>
          <tei:l>וְיָרֵֽחַ וְשִׂמְחָה</tei:l>
          <tei:l>לְגוֹחִי הַלֵּל אַפְצִֽיחָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/7"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">פזמון:</tei:note>
          </tei:l>
          <tei:l>אֲמַלֵּל בְּדָת מְשִׁיבַת</tei:l>
          <tei:l>לְנוֹצְרִי כְּבָבַת</tei:l>
          <tei:l>מִזְמוֹר שִׁיר לְיוֹם הַשַּׁבָּת</tei:l>
          <tei:l>קָדוֹשׁ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">דֻּ</tei:seg>בׇּֽקוּ כְּאַחַת</tei:l>
          <tei:l>שְׁלָשְׁתָּם חֲנֻכָּה וָחֹֽדֶשׁ וְנַֽחַת</tei:l>
          <tei:l>שׁוֹמְרֵיהֶם יֻחְשָֽׁכוּ מִשַּֽׁחַת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הַ</tei:seg>מְּשַׁמְּרִים יוֹם עֲנֻגָּה</tei:l>
          <tei:l>יֻצׇּֽלוּ מִדְּאָגָה</tei:l>
          <tei:l>וּבְכָל שַׁבָּת לְהִתְעַנְּגָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/10"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וּ</tei:seg>מְחַשְּׁבֵי חֶשְׁבּוֹן כׇּל חֹֽדֶשׁ</tei:l>
          <tei:l>פְּדוּתָם פִּתְאוֹם תְּחַדֵּשׁ</tei:l>
          <tei:l>כְּתִקּוּן מִקְדַּשׁ קֹֽדֶשׁ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/11"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">פזמון:</tei:note>
          </tei:l>
          <tei:l>וְאַתָּה אֲשֶׁר בִּצְדָקָה נִקְדָּשׁ</tei:l>
          <tei:l>יְשׁוּעָה לְעַמְּךָ תְחֻדׇּשׁ</tei:l>
          <tei:l>מִזְמוֹר שִֽׁירוּ לַיְיָ שִׁיר חָדָשׁ</tei:l>
          <tei:l>קָדוֹשׁ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/12"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זְ</tei:seg>כוֹר עַם בְּךְ חוֹסִים</tei:l>
          <tei:l>וְהַצִּילֵם מִיַּד שׁוֹסִים</tei:l>
          <tei:l>בַּעֲשׂוֹתְךָ בַּזְּמַן הַזֶּה נִסִּים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/13"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חֽ</tei:seg>וּסָה יְיָ עַל עַם הֲמוֹנַי</tei:l>
          <tei:l>וְהַפִּֽילָה אֵשׁ עַל מְעַנַּי</tei:l>
          <tei:l>כְּעַל יַד חַשְׁמוֹנַי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/14"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ט</tei:seg>וּב דְּבָרְךָ תָקִים</tei:l>
          <tei:l>וְאַל נָשׁוּב רֵקִים</tei:l>
          <tei:l>בְּפַלְּלֵֽנוּ לְפָנֶֽיךָ נוֹאֲקִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/15"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">פזמון:</tei:note>
          </tei:l>
          <tei:l>וְנֶחָמוֹת אוֹתָֽנוּ תַזְבִּיד</tei:l>
          <tei:l>וּלְךָ מְלוּכָה נַזְבִּיד</tei:l>
          <tei:l>מִזְמוֹר שִׁיר חֲנֻכַּת הַבַּֽיִת לְדָוִד</tei:l>
          <tei:l>קָדוֹשׁ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/16"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>הּ עוֹשֶׂה נִפְלָאוֹת</tei:l>
          <tei:l>נְהַדֶּרְךָ בְּמוֹרָאוֹת</tei:l>
          <tei:l>עַל פְּעָלְךָ עִמָּֽנוּ נִפְלָאוֹת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/17"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כּ</tei:seg>וֹתְבֵי עֲרוּכוֹת וּשְׁמוּרוֹת</tei:l>
          <tei:l>מְשַׁבְּחִים לְךְ שִׁירוֹת</tei:l>
          <tei:l>עַל עֲשׂוֹתְךָ גְּבוּרוֹת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/18"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ל</tei:seg>וֹמְדֵי שַׁעֲשׁוּעוֹת</tei:l>
          <tei:l>מִתְחַנְּנִים בְּשַׁוְעוֹת</tei:l>
          <tei:l>וּמַזְכִּירִים אֶת הַתְּשׁוּעוֹת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/19"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">פזמון:</tei:note>
          </tei:l>
          <tei:l>אֲמַלֵּל בְּדָת מְשִׁיבַת</tei:l>
          <tei:l>לְנוֹצְרִי כְּבָבַת</tei:l>
          <tei:l>מִזְמוֹר שִׁיר לְיוֹם הַשַּׁבָּת</tei:l>
          <tei:l>קָדוֹשׁ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/20"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מְ</tei:seg>שַׁנְּנֵי חׇכְמוֹת</tei:l>
          <tei:l>עֵינֵיהֶם בִּימִין רוֹמֵמוֹת</tei:l>
          <tei:l>וּמְתַנִּים עֲשׂוֹת מִלְחָמוֹת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/21"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נֶ</tei:seg>גְדְּךָ עֵינֵֽינוּ</tei:l>
          <tei:l>סְכוֹת צַעֲקָתֵֽנוּ</tei:l>
          <tei:l>כִּי כָל טוּב עָשִֽׂיתָ עִמָּֽנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/22"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">סַ</tei:seg>גֵּף כׇּל שׂוֹנְאֵֽינוּ</tei:l>
          <tei:l>וְהַכְחֵד כׇּל מְעַנֵּֽנוּ</tei:l>
          <tei:l>וַעֲשֵׂה לָֽנוּ כַּאֲשֶׁר עָשִֽׂיתָ לַאֲבוֹתֵֽינוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/23"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">פזמון:</tei:note>
          </tei:l>
          <tei:l>וְאַתָּה אֲשֶׁר בִּצְדָקָה נִקְדָּשׁ</tei:l>
          <tei:l>יְשׁוּעָה לְעַמְּךָ תְחֻדׇּשׁ</tei:l>
          <tei:l>מִזְמוֹר שִֽׁירוּ לַיְיָ שִׁיר חָדָשׁ</tei:l>
          <tei:l>קָדוֹשׁ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/24"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">עֱ</tei:seg>נוּתֵֽנוּ אַל תִּבְזֶה</tei:l>
          <tei:l>מִמָּרוֹם אוֹתָֽנוּ תֶחֶזֶה</tei:l>
          <tei:l>כְּבַֽטְתָּ בַּזְּמַן הַזֶּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/25"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פּ</tei:seg>וֹדֶה תָּחִישׁ יְשׁוּעָה</tei:l>
          <tei:l>וּבְךָ נִשְׁתַּעְשְׁעָה</tei:l>
          <tei:l>בְּאַבֶּדְךָ מַלְכוּת יָוָן הָרְשָׁעָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/26"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">צְ</tei:seg>פֶה צִדְקוֹתֵֽינוּ</tei:l>
          <tei:l>וּסְכוֹת נַאֲקוֹתֵֽינוּ</tei:l>
          <tei:l>וְהוֹשִׁיעֵֽנוּ בְּעֵת צָרָתֵֽנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/27"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">פזמון:</tei:note>
          </tei:l>
          <tei:l>וְנֶחָמוֹת אוֹתָֽנוּ תַזְבִּיד</tei:l>
          <tei:l>וּלְךָ מְלוּכָה נַזְבִּיד</tei:l>
          <tei:l>מִזְמוֹר שִׁיר חֲנֻכַּת הַבַּֽיִת לְדָוִד</tei:l>
          <tei:l>קָדוֹשׁ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/28"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>דוֹשׁ רַֽבְתָּ רִיבָם</tei:l>
          <tei:l>וְשָׁכַֽנְתָּ בְקִרְבָּם</tei:l>
          <tei:l>וְנִחַֽמְתָּ אֶת לִבָּם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/29"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רִ</tei:seg>חַֽמְתָּ הֲמוֹנָם</tei:l>
          <tei:l>הַמְיַחֲדִים בְּעִנְיָנָם</tei:l>
          <tei:l>וְדַֽנְתָּ אֶת דִּינָם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/30"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שָׁ</tei:seg>מַֽעְתָּ שַׁוְעָתָם</tei:l>
          <tei:l>חָמַֽלְתָּ עַל עֲדָתָם</tei:l>
          <tei:l>וְנָקַֽמְתָּ אֶת נִקְמָתָם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/31"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">פזמון:</tei:note>
          </tei:l>
          <tei:l><tei:seg type="acrostic">תּ</tei:seg>וֹפִֽיעַ לְשַׁמֵּֽחַ עַמְּךָ</tei:l>
          <tei:l>וּלְכוֹנֵן בֵּית אוּלָמְּךָ</tei:l>
          <tei:l>וּנְפָאֶרְךָ וּנְרוֹמֶמְךָ</tei:l>
          <tei:l>קָדוֹשׁ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotser_for_shabbat_rosh_hodesh_hanukkah_from_nusah_candia_crete_translated_by_yitzchak_dickman/32"/>
        <tei:lg>
          <tei:l>꙳ ꙳ ꙳</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yotzer_or/hakol_yodukha"/>
        <tei:lg>
          <tei:l>הַכֹּל יוֹדוּךָ וְהַכֹּל יְשַׁבְּחוּךָ וְהַכֹּל יֹאמְרוּ אֵין קָדוֹשׁ כַּיְְיָ...</tei:l>
        </tei:lg>
      </tei:div>
