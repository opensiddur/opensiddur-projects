  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:eftach_pi_le_hodot">
        <tei:head>אֶפְתַּח פִּי לְהוֹדוֹת</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eftach_pi_le_hodot/1"/>
        <tei:lg>
          <tei:l>אֶפְתַּח פִּי לְהוֹדוֹת וְגַם אֶצְרַח בְּקוֹל מַר</tei:l>
          <tei:l>אֲבָרֵךְ לֵאלֹהִים בְּבָרוּךְ שֶׁאָמַר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eftach_pi_le_hodot/2"/>
        <tei:lg>
          <tei:l>עַל־חׇרְבַּן בֵּית אֵל עֵינַי מְקוֹר דִּמְעָה</tei:l>
          <tei:l>מַֽיִם הוֹרִֽידוּ כַּנַּֽחַל עַל־בִּקְעָה</tei:l>
          <tei:l>עַל־בָּנִים שׁוֹמֵמִים כְּשִׁמְמוּת קִיר גִּבְעָה</tei:l>
          <tei:l>עֵת גְּזַר דִּין נֶחְתַּם וְגַם נִגְמַר׃</tei:l>
          <tei:l>אֲבָרֵךְ...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eftach_pi_le_hodot/3"/>
        <tei:lg>
          <tei:l>יוֹם חָרַב הֵיכָל גָּבְרוּ צָרוֹתַי</tei:l>
          <tei:l>בּֽוֹשְׁתִּי וְנִכְלַֽמְתִּי עַל־רֹב מְצוּקוֹתַי</tei:l>
          <tei:l>כָּֽלוּ אוֹר עֵינַי לְאוֹתוֹתַי</tei:l>
          <tei:l>חַיּוֹת וְאוֹפַנִּים עוֹנִים מִמִּשְׁמָר׃</tei:l>
          <tei:l>אֲבָרֵךְ...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eftach_pi_le_hodot/4"/>
        <tei:lg>
          <tei:l>חַיָּב כׇּל־אָדָם לְבָרֵךְ עַל־הַטּוֹבָה</tei:l>
          <tei:l>וְאִם רָעָה בָּא לוֹ לְהוֹדוֹת בִּתְשׁוּבָה</tei:l>
          <tei:l>הֲשִׁיבֵ֨נוּ יְהֹוָ֤ה ׀ אֵלֶ֙יךָ֙ וְֽנָשׁ֔וּבָ</tei:l>
          <tei:l>לְעוֹרֵר וּלְהָשִׁיב עַל־כׇּל־מִזְמָר׃</tei:l>
          <tei:l>אֲבָרֵךְ...</tei:l>
        </tei:lg>
      </tei:div>
