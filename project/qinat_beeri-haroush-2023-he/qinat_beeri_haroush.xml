    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:qinat_beeri_haroush">
        <tei:head>קִינָת בְּאֵרִי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:qinat_beeri_haroush/1"/>
        <tei:lg>
          <tei:l>אֵיכָה בְּאֵרִי</tei:l>
          <tei:l>הָפְכָה לְקִבְרִי</tei:l>
          <tei:l>וְיוֹם מְאוֹרִי</tei:l>
          <tei:l>הָפַךְ שְׁחוֹרִי</tei:l>
          <tei:l>וְהֻשְׁחַת כָּל פְּרִי</tei:l>
          <tei:l>וְנֶהְפַּךְ שִׁירִי</tei:l>
          <tei:l>עֵינִי נוֹבְעָה מַיִם</tei:l>
          <tei:l>מֵעֹמֶק שִׁבְרִי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:qinat_beeri_haroush/2"/>
        <tei:lg>
          <tei:l>אֵיכָה תּוֹרָה</tei:l>
          <tei:l>עֲרוּכָה וּסְדוּרָה</tei:l>
          <tei:l>וְכָל פְּאֵרָהּ</tei:l>
          <tei:l>לֹא עָמַד לְעֶזְרָה</tei:l>
          <tei:l>וּבְיוֹם הֲדָרָהּ</tei:l>
          <tei:l>הֻשְׁחַת תָּאֳרִי</tei:l>
          <tei:l>עֵינִי נוֹבְעָה מַיִם</tei:l>
          <tei:l>מֵעֹמֶק שִׁבְרִי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:qinat_beeri_haroush/3"/>
        <tei:lg>
          <tei:l>אֵיכָה יִשְׂרָאֵל</tei:l>
          <tei:l>בְּיוֹם קְרוֹא אֵל</tei:l>
          <tei:l>וְחַיִּים שׁוֹאֵל</tei:l>
          <tei:l>וּמְהוּמָה קִבֵּל</tei:l>
          <tei:l>זָקֵן וְעוֹלֵל</tei:l>
          <tei:l>בְּדַם מִתְגּוֹלֵל</tei:l>
          <tei:l>וְחַגּוֹ חִלֵּל</tei:l>
          <tei:l>אוֹיֵב אַכְזָרִי</tei:l>
          <tei:l>עֵינִי נוֹבְעָה מַיִם</tei:l>
          <tei:l>מֵעֹמֶק שִׁבְרִי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:qinat_beeri_haroush/4"/>
        <tei:lg>
          <tei:l>אֵיכָה אִמָּהוֹת</tei:l>
          <tei:l>וִילָדוֹת וּנְעָרוֹת</tei:l>
          <tei:l>בִּשְׁבִי מוּלָכוֹת</tei:l>
          <tei:l>כְּבִימֵי פְרָעוֹת</tei:l>
          <tei:l>וְנִפְרְצוּ גִּדְרוֹת</tei:l>
          <tei:l>צֹאן יְשָׁרוֹת</tei:l>
          <tei:l>וּפָסְקוּ מְחוֹלוֹת</tei:l>
          <tei:l>וּנְגִינוֹת מְשׁוֹרְרִי</tei:l>
          <tei:l>עֵינִי נוֹבְעָה מַיִם</tei:l>
          <tei:l>מֵעֹמֶק שִׁבְרִי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:qinat_beeri_haroush/5"/>
        <tei:lg>
          <tei:l>וְאֵיכָה אֶתְמַהּ</tei:l>
          <tei:l>בּוֹרֵא רוּמָה</tei:l>
          <tei:l>עַד אָן אֻמָּה</tei:l>
          <tei:l>תִּהְיֶה מְהוּמָה</tei:l>
          <tei:l>עַד אָן קוֹמָה</tei:l>
          <tei:l>תֻּשְׁפַּל אֲדָמָה</tei:l>
          <tei:l>וְעַתָּה קוּמָה</tei:l>
          <tei:l>לְהָאִיר נֵרִי</tei:l>
          <tei:l>וּבְעֵין רַחֲמֶיךָ</tei:l>
          <tei:l>תְּרַפֵּא שִׁבְרִי</tei:l>
          <tei:l>וְעֵינִי הַנּוֹבַעַת</tei:l>
          <tei:l>תַּשְׁקֶה בְּאֵרִי</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
