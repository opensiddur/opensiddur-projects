    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer">
        <tei:head>A Sanctification of the New Month, reconstructed from Masekhet Soferim by Isaac Gantwerk Mayer</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/1"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">Prayer-leader:</tei:note> Blessed are You,</tei:l>
          <tei:l>CAUSE our God,</tei:l>
          <tei:l>Sovereign of eternity,</tei:l>
          <tei:l>who creates the vine-fruit!</tei:l>
          <tei:l><tei:note type="instruction">Community:</tei:note> <tei:hi rend="italic">Amen!</tei:hi></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/2"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">Prayer-leader:</tei:note> Blessed are You,</tei:l>
          <tei:l>CAUSE our God,</tei:l>
          <tei:l>Sovereign of eternity,</tei:l>
          <tei:l>who revealed the secret of the moon’s renewal,</tei:l>
          <tei:l>taught them and instructed them eras, months, and good days,</tei:l>
          <tei:l>appointed understanding ones who put the times in order.</tei:l>
          <tei:l>Our Rock balanced the most miniscule moments,</tei:l>
          <tei:l>and with them fixes the very months and seasons,</tei:l>
          <tei:l>as written: The moon, made for the seasons;</tei:l>
          <tei:l>the sun knowing its course. <tei:bibl>(Psalms 104:19)</tei:bibl></tei:l>
          <tei:l>And it is said: “For it is like the new heavens</tei:l>
          <tei:l>and the new earth that I make.” <tei:bibl>(Isaiah 66:22)</tei:bibl></tei:l>
          <tei:l>Blessed are You, CAUSE,</tei:l>
          <tei:l>who sanctifies Israel</tei:l>
          <tei:l>and the new months.</tei:l>
          <tei:l><tei:note type="instruction">Community:</tei:note> <tei:hi rend="italic">Amen!</tei:hi></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/3"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">Prayer-leader:</tei:note> Thank the CAUSE who is good;</tei:l>
          <tei:l><tei:note type="instruction">Community:</tei:note> who is eternally kind! <tei:bibl>(Psalms 136:1)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/4"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">Prayer-leader:</tei:note> (<tei:note type="instruction">Added within Jerusalem’s borders:</tei:note> On this day in Jerusalem)</tei:l>
          <tei:l>we all will rejoice and celebrate together in the PRESENT ONE.</tei:l>
          <tei:l>Elijah the prophet, speedily may he come to us!</tei:l>
          <tei:l>May the anointed sovereign cause to sprout in our days</tei:l>
          <tei:l>the years of the building of the Holy Temple!</tei:l>
          <tei:l><tei:note type="instruction">Community:</tei:note> <tei:hi rend="italic">Amen!</tei:hi></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/5"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">Prayer-leader:</tei:note> May celebrations increase in Israel!</tei:l>
          <tei:l><tei:note type="instruction">Community:</tei:note> <tei:hi rend="italic">Amen!</tei:hi></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/6"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">Prayer-leader:</tei:note> May good tidings increase in Israel!</tei:l>
          <tei:l><tei:note type="instruction">Community:</tei:note> <tei:hi rend="italic">Amen!</tei:hi></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/7"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">Prayer-leader:</tei:note> May good days increase in Israel!</tei:l>
          <tei:l><tei:note type="instruction">Community:</tei:note> <tei:hi rend="italic">Amen!</tei:hi></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/8"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">Prayer-leader:</tei:note> May Torah students increase in Israel!</tei:l>
          <tei:l><tei:note type="instruction">Community:</tei:note> <tei:hi rend="italic">Amen!</tei:hi></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/9"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">Prayer-leader:</tei:note> Sanctified is the month!</tei:l>
          <tei:l><tei:note type="instruction">Community:</tei:note> Sanctified!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/10"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">Prayer-leader:</tei:note> Sanctified on the new month!</tei:l>
          <tei:l><tei:note type="instruction">Community:</tei:note> Sanctified!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/11"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">Prayer-leader:</tei:note> Sanctified in its time!</tei:l>
          <tei:l><tei:note type="instruction">Community:</tei:note> Sanctified!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/12"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">Prayer-leader:</tei:note>Sanctified in its passage!</tei:l>
          <tei:l><tei:note type="instruction">Community:</tei:note> Sanctified!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/13"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">Prayer-leader:</tei:note> Sanctified in the Torah!</tei:l>
          <tei:l><tei:note type="instruction">Community:</tei:note> Sanctified!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/14"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">Prayer-leader:</tei:note> Sanctified in the halakha!</tei:l>
          <tei:l><tei:note type="instruction">Community:</tei:note> Sanctified!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/15"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">Prayer-leader:</tei:note> Sanctified in the upper spheres!</tei:l>
          <tei:l><tei:note type="instruction">Community:</tei:note> Sanctified!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/16"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">Prayer-leader:</tei:note> Sanctified in the lower spheres!</tei:l>
          <tei:l><tei:note type="instruction">Community:</tei:note> Sanctified!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/17"/>
        <tei:lg>
          <tei:l>(<tei:note type="instruction">Added within Israel’s borders:</tei:note></tei:l>
          <tei:l><tei:note type="instruction">Prayer-leader:</tei:note> Sanctified in the Land of Israel!</tei:l>
          <tei:l><tei:note type="instruction">Community:</tei:note> Sanctified!)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/18"/>
        <tei:lg>
          <tei:l>(<tei:note type="instruction">Added within Jerusalem’s borders:</tei:note></tei:l>
          <tei:l><tei:note type="instruction">Prayer-leader:</tei:note> Sanctified in Ẓion!</tei:l>
          <tei:l><tei:note type="instruction">Community:</tei:note> Sanctified!)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/19"/>
        <tei:lg>
          <tei:l>(<tei:note type="instruction">Added within Jerusalem’s borders:</tei:note></tei:l>
          <tei:l><tei:note type="instruction">Prayer-leader:</tei:note>Sanctified in Jerusalem!</tei:l>
          <tei:l><tei:note type="instruction">Community:</tei:note> Sanctified!)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/20"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">Prayer-leader:</tei:note> Sanctified in all the places of Israel!</tei:l>
          <tei:l><tei:note type="instruction">Community:</tei:note> Sanctified!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/21"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">Prayer-leader:</tei:note> Sanctified by the mouth of our rabbis!</tei:l>
          <tei:l><tei:note type="instruction">Community:</tei:note> Sanctified!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/22"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">Prayer-leader:</tei:note> Sanctified in the house of meeting!</tei:l>
          <tei:l><tei:note type="instruction">Community:</tei:note> Sanctified!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/23"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">Prayer-leader:</tei:note> Thank the CAUSE who is good;</tei:l>
          <tei:l>who is eternally kind! <tei:bibl>(Psalms 136:1)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/24"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">Prayer-leader:</tei:note> And all of you are blessed!</tei:l>
          <tei:l><tei:note type="instruction">Community:</tei:note>And you too are blessed!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
