    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:shema">
        <tei:head>שְׁמַע</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:shema/torah_procession-barukh_shem"/>
        <tei:lg>
          <tei:l>שְׁמַ֖ע יִשְׂרָאֵ֑ל</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>יְהוָ֥ה אֱלֹהֵ֖ינוּ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>יְהוָ֥ה ׀ אֶחָֽד׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וּכְתַבְתָּ֛ם עַל־מְזוּזֹ֥ת בֵּיתֶ֖ךָ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וּבִשְׁעָרֶֽיךָ׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְהָיָה אִם שָׁמֹעַ תִּשְׁמְעוּ</tei:l>
          <tei:l>אֶל מִצְוֺתַי</tei:l>
          <tei:l>אֲשֶׁר אָנֹכִי מְצַוֶּה אֶתְכֶם הַיּוֹם,</tei:l>
          <tei:l>לְאַהֲבָה אֶת יְיָ אֱלֹהֵיכֶם</tei:l>
          <tei:l>וּלְעָבְדוֹ בְּכָל לְבַבְכֶם וּבְכָל נַפְשְׁכֶם׃</tei:l>
          <tei:l>וְנָתַתִּי מְטַר אַרְצְכֶם בְּעִתּוֹ יוֹרֶה וּמַלְקוֹשׁ,</tei:l>
          <tei:l>וְאָסַפְתָּ דְגָנֶךָ,</tei:l>
          <tei:l>וְתִירֹשְׁךָ וְיִצְהָרֶךָ:</tei:l>
          <tei:l>וְנָתַתִּי עֵשֶׂב בְּשָׂדְךָ לִבְהֶמְתֶּךָ,</tei:l>
          <tei:l>וְאָכַלְתָּ וְשָׂבָעְתָּ׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>הִשָּׁמְרוּ לָכֶם</tei:l>
          <tei:l>פֶּן יִפְתֶּה לְבַבְכֶם,</tei:l>
          <tei:l>וְסַרְתֶּם</tei:l>
          <tei:l>וַעֲבַדְתֶּם אֱלֹהִים אֲחֵרִים</tei:l>
          <tei:l>וְהִשְׁתַּחֲוִיתֶם לָהֶם׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְחָרָה אַף יְיָ בָּכֶם וְעָצַר אֶת הַשָּׁמַיִם</tei:l>
          <tei:l>וְלֹא יִהְיֶה מָטָר</tei:l>
          <tei:l>וְהָאֲדָמָה</tei:l>
          <tei:l>לֹא תִתֵּן אֶת יְבוּלָהּ,</tei:l>
          <tei:l>וַאֲבַדְתֶּם מְהֵרָה</tei:l>
          <tei:l>מֵעַל הָאָרֶץ הַטֹּבָה</tei:l>
          <tei:l>אֲשֶׁר יְיָ נֹתֵן לָכֶם׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְהָיָ֣ה לָכֶם֮ לְצִיצִת֒ וּרְאִיתֶ֣ם אֹת֗וֹ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וּזְכַרְתֶּם֙ אֶת־כָּל־מִצְוֺ֣ת יְהוָ֔ה</tei:l>
          <tei:l>וַעֲשִׂיתֶ֖ם אֹתָ֑ם</tei:l>
          <tei:l>וְלֹֽא־תָתֻ֜רוּ אַחֲרֵ֤י לְבַבְכֶם֙ וְאַחֲרֵ֣י עֵֽינֵיכֶ֔ם</tei:l>
          <tei:l>אֲשֶׁר־אַתֶּ֥ם זֹנִ֖ים אַחֲרֵיהֶֽם׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
