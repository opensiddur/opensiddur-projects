  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yom_kemo_ned">
        <tei:head>יוֹם כְּמוֹ נֵד</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_kemo_ned/1"/>
        <tei:lg>
          <tei:l>יוֹם כְּמוֹ נֵד עָמְדוּ דְּמָעַי בְּפָנַי</tei:l>
          <tei:l>עַל קְדוֹשִׁים זֶ֜רַע בְּרוּכֵ֤י יְהֹוָה֙ <tei:bibl>(ישעיה סה:כג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_kemo_ned/2"/>
        <tei:lg>
          <tei:l>כׇּל־כְּבוֹדָם גָּלָה וְשָׁח עֹז פְּאֵרָם</tei:l>
          <tei:l>כִּי בְחֵמָה נִצָּ֥ב לְרִיבָם יְהֹוָ֑ה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_kemo_ned/3"/>
        <tei:lg>
          <tei:l>הַנְּבִיאִים עָטוּ כְלִמּוֹת וְחָפוּ</tei:l>
          <tei:l>רֹאשׁ וְחָז֖וֹן לֹא־מָצְא֥וּ מֵיְהֹוָֽה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_kemo_ned/4"/>
        <tei:lg>
          <tei:l>הֵם בְּשִׁבְיָם מַחֲזִיקִים יְדֵיהֶם</tei:l>
          <tei:l>בֶּאֱמוּנָה רַח֣וּם וְחַנּ֣וּן יְהֹוָ֑ה׃ <tei:bibl>(תהלים קג:ח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_kemo_ned/5"/>
        <tei:lg>
          <tei:l>מַעֲרִיצִים גַּם־קוֹרְאִים אִישׁ לְאָחִיו</tei:l>
          <tei:l>הַלְלוּ־אֵל וּ֝בָרְכ֗וּ אֶת־יְהֹוָֽה׃ <tei:bibl>(תהלים קלד:ב)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
