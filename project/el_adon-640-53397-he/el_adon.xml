    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:el_adon">
        <tei:head>אֵל אָדוֹן (אשכנז)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_adon/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אֵ</tei:seg>ל אָדוֹן עַל כָּל־הַמַּעֲשִׂים</tei:l>
          <tei:l><tei:seg type="acrostic">בָּ</tei:seg>רוּךְ וּמְבֹרָךְ בְּפִי כָּל נְשָׁמָה</tei:l>
          <tei:l><tei:seg type="acrostic">גָּ</tei:seg>דְלוֹ וְטוּבוֹ מָלֵא עוֹלָם</tei:l>
          <tei:l><tei:seg type="acrostic">דַּֽ</tei:seg>עַת וּתְבוּנָה סֹבְבִים אוֹתוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_adon/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הַ</tei:seg>מִּתְגָּאֶה עַל חַיּוֹת הַקֹּדֶשׁ</tei:l>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>נֶהְדָּר בְּכָבוֹד עַל הַמֶּרְכָּבָה</tei:l>
          <tei:l><tei:seg type="acrostic">זְ</tei:seg>כוּת וּמִישׁוֹר לִפְנֵי כִסְאוֹ</tei:l>
          <tei:l><tei:seg type="acrostic">חֶֽ</tei:seg>סֶד וְרַחֲמִים מָלֵא כְבוֹדוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_adon/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ט</tei:seg>וֹבִים מְאוֹרוֹת שֶׁבָּרָא אֱלֹהֵינוּ</tei:l>
          <tei:l><tei:seg type="acrostic">יְ</tei:seg>צָרָם בְּדַֽעַת בְּבִינָה וּבְהַשְׂכֵּל</tei:l>
          <tei:l><tei:seg type="acrostic">כֹּֽ</tei:seg>חַ וּגְבוּרָה נָתַן בָּהֶם</tei:l>
          <tei:l><tei:seg type="acrostic">לִ</tei:seg>הְיוֹת מוֹשְׁלִים בְּקֶֽרֶב תֵּבֵל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_adon/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מְ</tei:seg>לֵאִים זִיו וּמְפִיקִים נֹֽגַהּ</tei:l>
          <tei:l><tei:seg type="acrostic">נָ</tei:seg>אֶה זִיוָם בְּכָל־הָעוֹלָם</tei:l>
          <tei:l><tei:seg type="acrostic">שְׂ</tei:seg>מֵחִים בְּצֵאתָם וְשָׂשִׂים בְּבוֹאָם</tei:l>
          <tei:l><tei:seg type="acrostic">עֹ</tei:seg>שִׂים בְּאֵימָה רְצוֹן קוֹנָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_adon/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>אֵר וְכָבוֹד נוֹתְנִים לִשְׁמוֹ</tei:l>
          <tei:l><tei:seg type="acrostic">צָ</tei:seg>הֳלָה וְרִנָּה לְזֵֽכֶר מַלְכוּתוֹ</tei:l>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>רָא לַשֶּֽׁמֶשׁ וַיִּזְרַח אוֹר</tei:l>
          <tei:l><tei:seg type="acrostic">רָ</tei:seg>אָה וְהִתְקִין צוּרַת הַלְּבָנָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_adon/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שֶֽׁ</tei:seg>בַח נוֹתְנִים לוֹ כָּל־צְבָא מָרוֹם</tei:l>
          <tei:l><tei:seg type="acrostic">תִּ</tei:seg>פְאֶֽרֶת וּגְדֻלָּה</tei:l>
          <tei:l>שְׂרָפִים וְאוֹפַנִּים וְחַיּוֹת הַקֹּדֶשׁ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
