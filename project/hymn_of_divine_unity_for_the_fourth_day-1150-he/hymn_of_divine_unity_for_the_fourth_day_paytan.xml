    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan">
        <tei:head>שִׁיר הַיִּחוּד לְיוֹם רְבִיעִי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אֲ</tei:seg>רוֹמֵם אֱלֹהֵי אָבִי וְאֵלִי</tei:l>
          <tei:l>אַנְוֶה אֱלֹהַי צוּרִי וְגוֹאֲלֵי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/2"/>
        <tei:lg>
          <tei:l>אֲיַחֵד אֱלֹהֵי הַשָּׁמַיִם</tei:l>
          <tei:l>וְהָאָרֶץ בְּכׇל יוֹם פַּעֲמִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/3"/>
        <tei:lg>
          <tei:l>אֵל חַי אֶחָד הוּא בְרָאָנוּ</tei:l>
          <tei:l>אֲבִיר יַעֲקֹב אָב לְכֻלָּנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/4"/>
        <tei:lg>
          <tei:l>אֲדֹנֵנוּ אֲדוֹן כׇּל הָאָרֶץ</tei:l>
          <tei:l>מָה אַדִּיר שִׁמְךָ בְּכׇל הָאָרֶץ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/5"/>
        <tei:lg>
          <tei:l>אֵין כָּאֵל אֵשׁ אוֹכְלָה וְקַנָּא</tei:l>
          <tei:l>לְעוֹלָם יְיָ אֱמֶת אֵל אֱמוּנָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/6"/>
        <tei:lg>
          <tei:l>אֵל אֶרֶךְ אַפַּיִם הוּא</tei:l>
          <tei:l>מְשַׁלֵּם וְנוֹתֵן לְאִישׁ כְּמַעֲשֵׂהוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/7"/>
        <tei:lg>
          <tei:l>אוֹרִי וְיִשְׁעִי מָעוֹז חַיָּי</tei:l>
          <tei:l>עָלָיו תְּלוּיִם כׇּל מַאֲוַיָּי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/8"/>
        <tei:lg>
          <tei:l>אֱלֹהִים אֱמֶת הוּא אֱלֹהִים חַיִּים</tei:l>
          <tei:l>לֹא יָכִילָא זָעֲמוֹ גּוֹיִם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/9"/>
        <tei:lg>
          <tei:l>אַדִּיר וְאַמִּיץ כֹּחַ וְרַב אוֹנִים</tei:l>
          <tei:l>אֱלֹהֵי הָאֱלֹהִים וַאֲדֹנֵי הָאֲדֹנִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/10"/>
        <tei:lg>
          <tei:l>אֱלֹהַּ עוֹשִׂי אִישִׁי וּבוֹעֲלִי</tei:l>
          <tei:l>אַלּוּף נְעוּרַי שׁוֹמְרִי וְצִלִּי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/11"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בּ</tei:seg>וֹרֵא כֹל וְיִשְׂרָאֵל גּוֹאֵל</tei:l>
          <tei:l>בָּרוּךְ אֱלֹהִים אֱלֹהֵי יִשְׂרָאֵל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/12"/>
        <tei:lg>
          <tei:l>בּוֹרֵא רוּחַ הָרִים יוֹצֵר</tei:l>
          <tei:l>מִמְּךְ מְזִמָּה לֹא יִבָּצֵר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/13"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">גֵּ</tei:seg>אֶה מֵשִׁיב גְּמוּל עַל גֵּאִים</tei:l>
          <tei:l>עַל הָרָמִים וְעַל הַנִּשָּׂאִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/14"/>
        <tei:lg>
          <tei:l>גִּבּוֹר בְּקוּמוֹ לַעֲרֹץ בְּעֶבְרָה</tei:l>
          <tei:l>מֵהֲדַר גְּאוֹנוֹ מִי לֹא יִירָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/15"/>
        <tei:lg>
          <tei:l>גָּבוֹהַּ כׇּל אֲשֶׁר תַּחְתָּיו נוֹשֵׂא</tei:l>
          <tei:l>וּגְדָל כֹּחַ גְּדוֹלוֹת עוֹשֶׂה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/16"/>
        <tei:lg>
          <tei:l>גָּדוֹל הוּא וּשְׁמוֹ בִּגְבוּרָה</tei:l>
          <tei:l>אַרְיֵה שָׁאַג מִי לֹא יִירָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/17"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">דּ</tei:seg>וֹדִי דָּגוּל הוּא מֵרְבָבָה</tei:l>
          <tei:l>אֵל נַעֲרָץ בְּסוֹד קְדוֹשִׁים רַבָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/18"/>
        <tei:lg>
          <tei:l>דַּיָּן יָתֵב כְּעַתִּיק יוֹמִין</tei:l>
          <tei:l>וּצְבָאָיו עַל שְׂמֹאל וְעַל יָמִין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/19"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הָ</tei:seg>דָר הוּא לְכׇל חֲסִידָיו</tei:l>
          <tei:l>הֲדָרוֹ וְהוֹדוֹ עַל בְּנֵי עֲבָדָיו</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/20"/>
        <tei:lg>
          <tei:l>הוּא אֵל אֱלֹהֵי הָרוּחוֹת לְכֹל</tei:l>
          <tei:l>בָּשָׂר שׁוֹמֵעַ תְּפִלָּה מִכֹּל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/21"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וַ</tei:seg>דַּאי וָתִיק יוֹדֵע וָעֵד</tei:l>
          <tei:l>יְיָ יִמְלֹךְ לְעֹלָם וָעֶד</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/22"/>
        <tei:lg>
          <tei:l>וַאֲשֶׁר חֶרֶב גַּאֲוָתֵנוּ</tei:l>
          <tei:l>לְהִלָּחֵם מִלְחֲמוֹתֵינוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/23"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ז</tei:seg>וֹכֵר לְעוֹלָם בְּרִית רִאשׁוֹנִים</tei:l>
          <tei:l>כְּיּוֹם אֶתְמוֹל לוֹ אֶלֶף שָׁנִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/24"/>
        <tei:lg>
          <tei:l>זֶה אֱלֹהֵינוּ וְלוֹ קִוִּינוּ</tei:l>
          <tei:l>וְזִמְרָת יָהּ הוּא יוֹשִׁיעֵנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/25"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חֵ</tei:seg>לֶק יַעֲקֹב יוֹצֵר הַכֹּל</tei:l>
          <tei:l>חַנוּן יְיָ וְחָסִיד בַּכֹּל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/26"/>
        <tei:lg>
          <tei:l>חַי הָעוֹלָם יְיָ חֶלְקִי</tei:l>
          <tei:l>חֲכַם הָרָזִים יְיָ חִזְקִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/27"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ט</tei:seg>וֹב וּמֵטִיב הַמְּלַמֵּד דֵּעָה</tei:l>
          <tei:l>טְהוֹר עֵינַיִם מַרְאוֹת בְּרָעָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/28"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>שָׁר יְיָ וְיָשָׁר דְּבָרוֹ</tei:l>
          <tei:l>יְדִידֵי יְדִידוּת מִשְׁכְּנוֹת דְּבִירוֹ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/29"/>
        <tei:lg>
          <tei:l>יוֹעֵץ וְגוֹזֵר מִי יְפִרֶנָּה</tei:l>
          <tei:l>וְיַחְתּוֹף וְיִפְעַל וּמִי יְשִׁבֶנָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/30"/>
        <tei:lg>
          <tei:l>יָפֶה דּוֹדִי יָפְיוֹ וְטוּבוֹ</tei:l>
          <tei:l>יִרְאוּ וַיֶּחֱזוּ צִיּוֹן בְּשׁוּבוֹ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/31"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כְּ</tei:seg>גִּבּוֹר יֵצֵא כְּאִישׁ מִלְחָמוֹת</tei:l>
          <tei:l>יָעִיר קִנְאָה לַעֲשׂוֹת נְקָמוֹת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/32"/>
        <tei:lg>
          <tei:l>כְּנֶשֶׁר עַל כַּנְפֵי נְשָׁרִים</tei:l>
          <tei:l>נָשָׂא עֲבָדָיו וְיִשֵּׁר הֲדוּרִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/33"/>
        <tei:lg>
          <tei:l>כְּדֹב שַׁכּוּל וּכְנָמֵר שׁוֹקֵד</tei:l>
          <tei:l>דְּבָרוֹ לַעֲשׂוֹת כְּמַקֵּל שָׁקֵד</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/34"/>
        <tei:lg>
          <tei:l>כַּבִּיר כֹּחַ לֵב כְּמוֹ שַׁחַל</tei:l>
          <tei:l>כְּלָבִיא וְכַאֲרִי וְרוּחוֹ כְּנַחַל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/35"/>
        <tei:lg>
          <tei:l>כְּאֶרֶז בָּחוּר בִּגְדֻלָּתוֹ</tei:l>
          <tei:l>כִּבְרוֹשׁ רַעֲנָן עִנְוְתָנוּתוֹ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/36"/>
        <tei:lg>
          <tei:l>כְּתַפּוּחַ בְּרֵיחוֹ עֹז אַהֲבָתוֹ</tei:l>
          <tei:l>עַל יִשְׂרָאֵל גַּם גַּאֲוָתוֹ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/37"/>
        <tei:lg>
          <tei:l>כְּתַפּוּחַ בַּעֲצֵי הַיַּעַר</tei:l>
          <tei:l>כֵּן דּוֹדִי עִם יוֹשְׁבֵי שָׁעַר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/38"/>
        <tei:lg>
          <tei:l>כַּבִּיר כֹּחַ לְמַרְגִּיזֵי אֵל</tei:l>
          <tei:l>נוֹקֵם וְכַטַּל הוּא לְיִשְׂרָאֵל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/39"/>
        <tei:lg>
          <tei:l>כּוֹסִי מְנַת חֶלְקִי וְגוֹרָלִי</tei:l>
          <tei:l>אֲנִי לְדוֹדִי נַחֲלָה וְדוֹדִי לִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/40"/>
        <tei:lg>
          <tei:l>כְּבוֹד יְיָ לֹא אֲמִירֶנּוּ</tei:l>
          <tei:l>הֶאֱמַרְנוּהוּ וְהֶאֱמִירָנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/41"/>
        <tei:lg>
          <tei:l>כְּאַרְיֵה יִשְׁאַג וְכַכְּפִיר יִנְהָם</tei:l>
          <tei:l>אַל יִהְיֶה כְּגֵר וּכְאִישׁ נִדְהָם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/42"/>
        <tei:lg>
          <tei:l>כְּרוֹעֶה גִּבּוֹר אֲשֶׁר לֹא יוּכַל</tei:l>
          <tei:l>צֹאנוֹ לְהַצִּיל וְהָיָה לְמַאֲכָל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/43"/>
        <tei:lg>
          <tei:l>כְּגִבּוֹר אֵין אֱיָל וּכְאוֹרֵחַ</tei:l>
          <tei:l>נָס וּבוֹרֵחַ וּמַר צוֹרֵחַ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/44"/>
        <tei:lg>
          <tei:l>כְּאַרְיֵה מַשְׁחִית וְכַכְּפִיר לְעֹזְבָיו</tei:l>
          <tei:l>כָּרָקָב גַּם כָּעָשׁ לְאוֹיְבָיו</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/45"/>
        <tei:lg>
          <tei:l>כַּבִּיר כֹּחַ כַּשָּׁמִיר וְשַׁית</tei:l>
          <tei:l>וְלֹא יַשְׁאִיר כְּנֹקֶף זָיִת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/46"/>
        <tei:lg>
          <tei:l>כְּשָׁמִיר וָשַׁיִת צָרִים יְמַגֵּן</tei:l>
          <tei:l>כְּצִפֳּרִים עָפוֹת עָלֵינוּ יָגֵן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/47"/>
        <tei:lg>
          <tei:l>כְּגִשְׁמֵי נְדָבָה לָנוּ יָבֹא</tei:l>
          <tei:l>כְּמַלְקוֹשׁ וְכַטַּל לַדְּבֵקִים בּוֹ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/48"/>
        <tei:lg>
          <tei:l>כְּנֶשֶׁר יְרַחֵף עַל גּוֹזָלָיו</tei:l>
          <tei:l>וּבְצֵל כְּנָפָיו יֶחֱסוּ מְיַחֲלָיו</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/49"/>
        <tei:lg>
          <tei:l>כְּצִפֳּרִים עַל עִירוֹ יָגֵן</tei:l>
          <tei:l>וּבְצֵל כְּנָפָיו רְנָנוֹת נְנַגֵּן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/50"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>בַדּוֹ יְיָ הוּא וְנִפְלָאוֹת</tei:l>
          <tei:l>גְּדוֹלוֹת עוֹשֶׂה וְרַב נוֹרָאוֹת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/51"/>
        <tei:lg>
          <tei:l>לִצְבִי וּלְעֹפֶר דּוֹמֶה דּוֹדִי</tei:l>
          <tei:l>כִּי יְקַדְּמֵנִי אֱלֹהֵי חַסְדִּי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/52"/>
        <tei:lg>
          <tei:l>לִפְנֵי עַמּוֹ יְיַשֵּׁר הֲדוּרִים</tei:l>
          <tei:l>וִינַשְּׂאֵם עַל כַּנְפֵי נְשָׁרִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/53"/>
        <tei:lg>
          <tei:l>לְעוֹלָם חֶלְקִי הוּא וְצוּר לְבָבִי</tei:l>
          <tei:l>כַּלָּה שְׁאֵרֵי לוֹ וּלְבָבִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/54"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מָ</tei:seg>קוֹם וּמָעוֹן אַתָּה לְעוֹלָמֶךָ</tei:l>
          <tei:l>וְאֵין יוֹדֵעַ אֶת מְקוֹמֶךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/55"/>
        <tei:lg>
          <tei:l>מוֹרָאִי אֵל רוֹעִי וְיוֹצְרִי</tei:l>
          <tei:l>צוּר יְלָדַנִי מְחוֹלְלִי וְצוּרִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/56"/>
        <tei:lg>
          <tei:l>מָרוֹם וּמָעוֹז מְעוֹנָה וּמַחְסִי</tei:l>
          <tei:l>מִגְדַּל עֹז שֵׁם יְיָ מְנוּסִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/57"/>
        <tei:lg>
          <tei:l>מֶלֶךְ יַעֲקֹב מִשְׂגָּב לָנוּ</tei:l>
          <tei:l>הוּא מְחוֹקְקֵנוּ וּמוֹשִׁיעֵנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/58"/>
        <tei:lg>
          <tei:l>מִגְדּוֹל יְשׁוּעוֹת מִשְׁעָן לִי</tei:l>
          <tei:l>מִבְטַח אֱלֹהִים יְיָ חֵילִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/59"/>
        <tei:lg>
          <tei:l>מוֹשֵׁל לְעוֹלָם מַלְכוּתֶךָ</tei:l>
          <tei:l>בְּכׇל דּוֹר וָדוֹר מֶמְשַׁלְתֶּךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/60"/>
        <tei:lg>
          <tei:l>מִי יִתֶּנְךָ כְּאָח לִי לְצָרָה</tei:l>
          <tei:l>הוֹשַׁע כִּי יָדְךָ לֹא קְצָרָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/61"/>
        <tei:lg>
          <tei:l>מְקוֹר חַיִּים מִקְוֵה יִשְׂרָאֵל</tei:l>
          <tei:l>לֹא אֶעֱזֹוב כִּי מָעֻזִּי אֵל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/62"/>
        <tei:lg>
          <tei:l>מָגֵן יִשְׁעִי וְחֶרֶב גַּאֲוָה</tei:l>
          <tei:l>לְשִׁמְךָ וּלְזִכְרְךָ נֶפֶשׁ תַּאֲוָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/63"/>
        <tei:lg>
          <tei:l>מָגֵן הוּא לְכֹל הַחֹסִים בּוֹ</tei:l>
          <tei:l>אַשְׁרֵי אָדָם אֲשֶׁר עֹז לוֹ בּוֹ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/64"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נָ</tei:seg>בָר וְנָעִים נָאוֹר וְנוֹרָא</tei:l>
          <tei:l>נֶאְדָּר וְנֶאְזָר שְׁמוֹ בִּגְבוּרָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/65"/>
        <tei:lg>
          <tei:l>נֶאֱמָן נֵצַח יִשְׂרָאֵל לֹא</tei:l>
          <tei:l>יְשַׁקֵּר אַשְׁרֵי כׇּל חוֹכֵי לוֹ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/66"/>
        <tei:lg>
          <tei:l>נֵצַח יִשְׂרָאֵל הָאֵל הַנֶּאֱמָן</tei:l>
          <tei:l>מֵאֱלֹהָיו יְהוּדָה לֹא אַלְמָן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/67"/>
        <tei:lg>
          <tei:l>נִפְלָא עַל כׇּל הַנִּפְלָאִים</tei:l>
          <tei:l>וּמִתְנַשֵּׂא עַל כׇּל הַנִּשָּׂאִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/68"/>
        <tei:lg>
          <tei:l>נִקְדַּשׁ וְנַעֲרָץ אֱלֹהַי קְדוֹשִׁי</tei:l>
          <tei:l>נָכוֹן וְנִשְׂגָּב יְיָ נִסִּי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/69"/>
        <tei:lg>
          <tei:l>נוֹקֵם וְנוֹטֵר וּבַעַל חֵמָה</tei:l>
          <tei:l>לְצָרָיו לְאוֹיְבָיו אִישׁ מִלְחָמָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/70"/>
        <tei:lg>
          <tei:l>נֵרִי יְיָ בְּהִלּוֹ נֵרוֹ</tei:l>
          <tei:l>עֲלֵי רֹאשִׁי וְנֵר לְרַגְלִי דְּבָרוֹ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/71"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ס</tei:seg>וֹמֵךְ וְסוֹעֵד יְיָ סַלְעִי</tei:l>
          <tei:l>סוֹבֵל וְסוֹלֵחַ וְנוֹשֵׂא לְפִשְׁעִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/72"/>
        <tei:lg>
          <tei:l>סָהֲדֵי יְיָ סַלְעִי וְסִתְרִי</tei:l>
          <tei:l>סוֹלֵחַ וְסוֹבֵל סַעֲדִי וְסִבְרִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/73"/>
        <tei:lg>
          <tei:l>סַלְעֵנוּ וּמְצוּדָתֵנוּ</tei:l>
          <tei:l>עֶזְרָתֵנוּ וּמִפַלְּטֵנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/74"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">עִ</tei:seg>זוּז וְגִבּוֹר עֻזִּי וְעֶזְרִי</tei:l>
          <tei:l>עֶלְיוֹן עֹז לִי וְאַל יְהִי עָרִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/75"/>
        <tei:lg>
          <tei:l>עִיר וְקַדִּישׁ שָׁת סְבִיבָיו סֵתֶר</tei:l>
          <tei:l>אָכֵן אַתָּה אֵל מִסְתַּתֵּר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/76"/>
        <tei:lg>
          <tei:l>עֵד מְמַהֵר גְּמוּל לְשַׁלֵּם לְאוֹיְבָיו</tei:l>
          <tei:l>שׁוֹמֵר הַבְּרִית וְהַחֶסֶד לְאֹוהֲבָיו</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/77"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פּ</tei:seg>וֹדֶה אֶת אַבְרָהָם יְדִידוֹ</tei:l>
          <tei:l>הוּא יִפְדֶּה יִשְׂרָאֵל עָבְדּוֹ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/78"/>
        <tei:lg>
          <tei:l>פָּחַד יִצְחָק יִתֵּן פַּחְדוֹ</tei:l>
          <tei:l>עַל צָרֵי בְּנֵי יַעֲקֹב עָבְדּוֹ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/79"/>
        <tei:lg>
          <tei:l>פּוֹעֵל וְחוֹקֵר וְדוֹרֵשׁ וּבוֹדֵק</tei:l>
          <tei:l>כׇּל הַלְּבָבוֹת לוֹ אֶתֵּן צֶדֶק</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/80"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">צְ</tei:seg>רוֹר הַמּוֹר אֶשְׁכּוֹל הַכֹּפֶר</tei:l>
          <tei:l>נוֹתֵן לְעַמּוֹ צָרָיו כֹּפֶר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/81"/>
        <tei:lg>
          <tei:l>צַח וְאָדוֹם בִּצְבָאָיו אוֹת</tei:l>
          <tei:l>עַל כֵּן נִקְרָא יְיָ צְבָאוֹת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/82"/>
        <tei:lg>
          <tei:l>צַדִּיק יְיָ הַצּוּר תָּמִים</tei:l>
          <tei:l>אֶבְטַח עֲדֵי עַד בְּצוּר עוֹלָמִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/83"/>
        <tei:lg>
          <tei:l>צְבָא הַשָּׁמַיִם מִשְׁתַּחֲוִים לוֹ</tei:l>
          <tei:l>שְׂרָפִים עוֹמְדִים מִמַּעַל לוֹ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/84"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>דוֹשׁ הוּא בְּכׇל מִינֵי קְדֻשּׁוֹת</tei:l>
          <tei:l>כִּתּוֹת שָׁלֹשׁ קָדוֹשׁ מְשַׁלְּשׁוֹת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/85"/>
        <tei:lg>
          <tei:l>קַיָּם לְעָלְמִין אֱלָהָא חַיָּא</tei:l>
          <tei:l>מָרֵא דְּאַרְעָא וּמָרֵא דִּשְׁמַיָּא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/86"/>
        <tei:lg>
          <tei:l>קוֹנִי מֵרֶחֶם מְקַנֵּא לְשׂוֹנְאָיו</tei:l>
          <tei:l>קֶרֶן יִשְׁעִי וְקָרוֹב לְקוֹרְאָיו</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/87"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רָ</tei:seg>חוֹק מִכֹּל וְאֶת כֹּל רוֹאֶה</tei:l>
          <tei:l>כִּי רָם יְיָ וְשָׁפָל יִרְאֶה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/88"/>
        <tei:lg>
          <tei:l>רוֹעִי יְיָ לֹא אֶחְסַר כֹּל</tei:l>
          <tei:l>וְרַב כֹּחַ וְרַב חֶסֶד לַכֹּל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/89"/>
        <tei:lg>
          <tei:l>רַחוּם יְיָ רוֹפֵא וּמְחַבֵּשׁ</tei:l>
          <tei:l>לִשְׁבוּרֵי לֵב וְעָוֹן כּוֹבֵשׁ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/90"/>
        <tei:lg>
          <tei:l>רֵעִי כֻּלּוֹ הוּא מַחֲמַדִּים</tei:l>
          <tei:l>מִשְׁפָּטָיו אֱמֶת מְתוּקִים וַחֲמוּדִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/91"/>
        <tei:lg>
          <tei:l>רִאשׁוֹן וְאַחֲרוֹן מֵעוֹלָם וְעַד</tei:l>
          <tei:l>עוֹלָם אַתָּה אֵל שׁוֹכֵן עַד</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/92"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שַׁ</tei:seg>לִּיט מֶלֶךְ שְׁמַיָּא בְּכׇל דָּר וְדָר</tei:l>
          <tei:l>לֵהּ אֲנָּא מְשַׁבַּח מְרוֹמֵם וּמְהַדָּר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/93"/>
        <tei:lg>
          <tei:l>שֶׁמֶשׁ וּמָגֵן יְיָ אֱלֹהִים</tei:l>
          <tei:l>שׁוֹפֵט צֶדֶק וּמַשְׁפִּיל גְּבוֹהִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/94"/>
        <tei:lg>
          <tei:l>שָׂגִּיא כֹחַ לֹא מְצָאנוּהוּ</tei:l>
          <tei:l>יַשְׂגִּיב בְּכֹחוֹ וּמִי כָּמֹהוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/95"/>
        <tei:lg>
          <tei:l>שְׁלֹמֹה שְׁמוֹ כִּי שֶׁלּוֹ שָׁלוֹם</tei:l>
          <tei:l>וַיִּקְרָא לוֹ יְיָ שָׁלוֹם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/96"/>
        <tei:lg>
          <tei:l>שֵׁם יְיָ אֶהְיֶה אֲשֶׁר אֶהְיֶה</tei:l>
          <tei:l>תּוֹעֲפוֹת רְאֵם לוֹ כַּכְּפִיר וְכָאַרְיֵה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/97"/>
        <tei:lg>
          <tei:l>שַׁדַּי מְאוֹרִי מַלְכִּי וְאֵלִי</tei:l>
          <tei:l>הַלְלוּיָהּ שְׁמוֹ נַפְשִׁי הַלֵּלִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/98"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">תִּ</tei:seg>תַּמָּם עִם יוֹשְׁבֵי נְטָעִים</tei:l>
          <tei:l>הַשָּׂרִיגִים שְׁלֹשֶׁת הָרוֹעִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/99"/>
        <tei:lg>
          <tei:l>תִּתְחַסָּד תִּתַּבָּר עִמָּם</tei:l>
          <tei:l>וְעִם עִקְּשִׁים תִּתַּפָּל לְהֻמָּם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/100"/>
        <tei:lg>
          <tei:l>תָּמִים דַּרְכְּךָ תַּקִּיף מִכֹּל</tei:l>
          <tei:l>תּוּכַל לְבַדְּךָ לַעֲשׂוֹת אֶת כֹּל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/101"/>
        <tei:lg>
          <tei:l>תּוֹחַלְתִּי וְסִבְרִי וְתִקְוָתִי</tei:l>
          <tei:l>תַּאֲוַת נַפְשִׁי וּתְשׁוּקָתִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/102"/>
        <tei:lg>
          <tei:l>תְּהִלָּתִי וְתִפְאַרְתִּי וְעֻזִּי</tei:l>
          <tei:l>מִמְּעֵי אִמִּי גּוֹחִי וְגוֹזִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/103"/>
        <tei:lg>
          <tei:l>תְּמִים דֵּעִים אֵל דֵּעוֹת אֶחָד</tei:l>
          <tei:l>כׇּל הַלְּבָבוֹת דּוֹרֵשׁ יָחַד׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
