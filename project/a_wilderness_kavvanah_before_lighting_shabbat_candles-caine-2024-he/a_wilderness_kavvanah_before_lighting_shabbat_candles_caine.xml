    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_wilderness_kavvanah_before_lighting_shabbat_candles_caine">
        <tei:head>כוונה לפני הדלקת נרות שבת – כוונת הלב לישימון</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_wilderness_kavvanah_before_lighting_shabbat_candles_caine/1"/>
        <tei:lg>
          <tei:l>אֱלֹהַי וֶאֱלֹהֵי אִמּוֹתַי וַאֲבוֹתַי,</tei:l>
          <tei:l>אִמָּא אֲדָמָה, אֵם כָּל הָאִמָּהוֹת כֻּלָּן.</tei:l>
          <tei:l>אֵל שַׁדַּי, אֵל הַשָּׂדוֹת,</tei:l>
          <tei:l>אֲדוֹן הַיָּם הַגָּדוֹל,</tei:l>
          <tei:l>בַּעַל מֶרְחֲבֵי הַבָּר,</tei:l>
          <tei:l>בַּעֲלַת יַעֲרוֹת הָעַד,</tei:l>
          <tei:l>בַּעֲלַת נְהָרוֹת,</tei:l>
          <tei:l>בַּעֲלַת בִּצּוֹת,</tei:l>
          <tei:l>אֵלַת הַיְּשִׁימוֹן.</tei:l>
          <tei:l>רוּחַ שׁוֹרֶקֶת בֵּין סְלָעִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_wilderness_kavvanah_before_lighting_shabbat_candles_caine/2"/>
        <tei:lg>
          <tei:l>קַבָּלִי בְּאַהֲבָה וּבְחֶמְלָה נֵרוֹת שַׁבָּת אֵלֶּה.</tei:l>
          <tei:l>קַבְּלִי אֶת הָאֵשׁ שֶׁאֲנִי מַעֲלָה כְּעוֹלֶה</tei:l>
          <tei:l>וְאֶת מִלּוֹת תְּפִלָּתִי כְּמִנְחָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_wilderness_kavvanah_before_lighting_shabbat_candles_caine/3"/>
        <tei:lg>
          <tei:l>שְׁמָרֵי עַל מִשְׁפַּחְתִּי בְּתוֹךְ הֲמֻלַּת הַיּוֹם יוֹם,</tei:l>
          <tei:l>שְׁמָרֵי עַל [<tei:note type="instruction">הוסף:</tei:note> יַלְדֵי וְעַל אִישִׁי / אִשְׁתִּי],</tei:l>
          <tei:l>שֶׁלֹּא תֹּאבַד דַּרְכֵּנוּ וְנֵדַע לְהַבְדִּיל</tei:l>
          <tei:l>בֵּין עֲבוֹדָה לְעַבְדוּת.</tei:l>
          <tei:l>שֶׁנֵּדַע לִשְׁמֹט.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_wilderness_kavvanah_before_lighting_shabbat_candles_caine/4"/>
        <tei:lg>
          <tei:l>שְׁמָרֵי עַל הַיָּם,</tei:l>
          <tei:l>עַל הַיְּעָרוֹת הַגְּדוֹלִים,</tei:l>
          <tei:l>שְׁמָרֵי בְּרַחֲמַיִךְ עַל כָּל אֲתָר וַאֲתָר.</tei:l>
          <tei:l>עֶזְרִי לָנוּ לִזְכֹּר</tei:l>
          <tei:l>שֶׁאֵין מָקוֹם פָּנוּי מִקְּדֻשָּׁתְךָ הַנּוֹרָאָה</tei:l>
          <tei:l>אַךְ מְקוֹמוֹת רַבִּים פְּנוּיִים מִקְּדֻשָּׁתֵנוּ,</tei:l>
          <tei:l>וְטוֹב לָהֶם כָּךְ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_wilderness_kavvanah_before_lighting_shabbat_candles_caine/5"/>
        <tei:lg>
          <tei:l>בַּעֲלַת רַחֲמִים,</tei:l>
          <tei:l>אֵל שַׁדַּי,</tei:l>
          <tei:l>קַבְּלִי תְּפִלָּתִי</tei:l>
          <tei:l>וְסַיְּעִי לִי לְכַוֵּן לִבִּי אֶל הַיְּשִׁימוֹן.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
