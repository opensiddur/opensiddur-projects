      <tei:div corresp="urn:x-opensiddur:text:prayer:al_cheyt">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:al_cheyt/21"/>
        <tei:lg>
          <tei:l>וְעַל כֻּלָּם,</tei:l>
          <tei:l>אֱלֽוֹהַּ סְלִיחוֹת,</tei:l>
          <tei:l>סְלַח לָֽנוּ,</tei:l>
          <tei:l>מְחַל לָֽנוּ,</tei:l>
          <tei:l>כַּפֶּר־לָֽנוּ.</tei:l>
        </tei:lg>
