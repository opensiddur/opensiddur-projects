  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:mikhael_is_on_my_right">
        <tei:head>"Mikhael is on my right," the angelic invocation for divine protection from the Ḳriyat Shema al haMitah</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mikhael_is_on_my_right/1"/>
        <tei:lg>
          <tei:l>In the name of YHVH Elohei Yisrael –</tei:l>
          <tei:l>May Mikhael be at my right,</tei:l>
          <tei:l>and Gavriel at my left,</tei:l>
          <tei:l>before me, Uriel,</tei:l>
          <tei:l>and behind me, Refael,</tei:l>
          <tei:l>and above my head, the Shekhinah of El.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
