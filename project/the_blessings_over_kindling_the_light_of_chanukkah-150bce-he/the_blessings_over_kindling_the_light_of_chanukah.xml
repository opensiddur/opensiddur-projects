    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:the_blessings_over_kindling_the_light_of_chanukah">
        <tei:head>ברכות לנרות חנוכה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hadlaqat_ner_chanukah/blessing"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם</tei:l>
          <tei:l>אֲשֶׁר קִדְּשָׁנוּ בְּמִצְוֺתָיו</tei:l>
          <tei:l>וְצִוָּנוּ לְהַדְלִיק נֵר שֶׁל חֲנֻכָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:sheasah_nissim"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם</tei:l>
          <tei:l>שֶׁעָשָׂה נִסִּים לַאֲבוֹתֵינוּ</tei:l>
          <tei:l>בַּיָּמִים הָהֵם</tei:l>
          <tei:l>בַּזְּמַן הַזֶּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:shehecheyanu"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם</tei:l>
          <tei:l>שֶׁהֶחֱיָנוּ</tei:l>
          <tei:l>וְקִיְּמָנוּ</tei:l>
          <tei:l>וְהִגִּיעָנוּ לַזְּמַן הַזֶּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_blessings_over_kindling_the_light_of_chanukah/4"/>
        <tei:lg>
          <tei:l>נֵס גָדוֹל הַיָה שָׁם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_blessings_over_kindling_the_light_of_chanukah/5"/>
        <tei:lg>
          <tei:l>הַנֵּרוֹת הַאֵלוּ אָנוּ מַדְלִיקִין</tei:l>
          <tei:l>עַל הַיְשׁוּעוֹת</tei:l>
          <tei:l>וְעַל הַנִּסִּים</tei:l>
          <tei:l>וְעַל הַנִּפְלָאוֹת</tei:l>
          <tei:l>אֲשֶׁר עָשִׂיתָ לַאֲבוֹתֵינוּ</tei:l>
          <tei:l>עַל יְדֵי כֹּהֲנֶיךָ הַקְּדוֹשִׁים</tei:l>
          <tei:l>וְכׇל (מִצְוֺת) שְׁמוֹנַת יְמֵי חֲנֻכָּה</tei:l>
          <tei:l>הַנֵּרוֹת הַאֵלוּ קוֹדֶשׁ</tei:l>
          <tei:l>וְאֵין לָנוּ רְשׁוּת לְהִשְׁתַּמֵּשׁ בָּהֶם</tei:l>
          <tei:l>אֶלָּא לִרְאוֹתָן בִּלְבָד</tei:l>
          <tei:l>כְּדֵי לְהוֹדוֹת לְשִׁמְךָ</tei:l>
          <tei:l>עַל נִפְלְאוֹתֶיךָ</tei:l>
          <tei:l>וְעַל נִסֶּיךָ</tei:l>
          <tei:l>וְעַל יְשׁוּעָתֶךָ׃ <tei:bibl>(מסכת סופרים כ:ו)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
