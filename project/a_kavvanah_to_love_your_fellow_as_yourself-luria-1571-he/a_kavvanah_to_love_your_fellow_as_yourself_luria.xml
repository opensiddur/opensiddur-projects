    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_kavvanah_to_love_your_fellow_as_yourself_luria">
        <tei:head>הֲרֵינִי מְקַבֵּל עָלַי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_kavvanah_to_love_your_fellow_as_yourself_luria/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">נכון לומר קודם התפלה (דשחרית):</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_kavvanah_to_love_your_fellow_as_yourself_luria/2"/>
        <tei:lg>
          <tei:l>הֲרֵינִי מְקַבֵּל עָלַי מִצְוַת עֲשֵׂה שֶׁל</tei:l>
          <tei:l>וְאָהַבְתָּ לְרֵעֲךָ כָּמוֹךָ. <tei:bibl>(ויקרא יט:יח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_kavvanah_to_love_your_fellow_as_yourself_luria/3"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">לאחרי התפלה יאמר:</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_kavvanah_to_love_your_fellow_as_yourself_luria/4"/>
        <tei:lg>
          <tei:l>אַךְ צַדִּיקִים יוֹדוּ לִשְׁמֶךָ</tei:l>
          <tei:l>יֵשְׁבוּ יְשָׁרִים אֶת פָּנֶיךָ. <tei:bibl>(תהלים קמ:יד)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
