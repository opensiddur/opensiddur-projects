    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:zemer_for_tu_beav_abraham">
        <tei:head>זֶמֶר לְט״וּ בְּאָב</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:zemer_for_tu_beav_abraham/1"/>
        <tei:lg>
          <tei:l>הִתְבַּשֵּׂ֫רוּ בְנֵי עֶלְיוֹן</tei:l>
          <tei:l>כִּי נִחַם יְיָ צִיּוֹן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:zemer_for_tu_beav_abraham/2"/>
        <tei:lg>
          <tei:l>אַזְכִּיר חֲסָדֶ֫יךָ מַלְכִּי</tei:l>
          <tei:l>לְנֶ֫גֶד כָּל נִבְרָאֶ֫יךָ</tei:l>
          <tei:l>וּדְבַר גְּבוּרוֹת יְחַו חִכִּי</tei:l>
          <tei:l>אֲשֶׁר פְּעַלְתָּם לִירֵאֶ֫יךָ</tei:l>
          <tei:l>בַּחֲמִשָּׁה־עָשָׂר בְּאָב, כִּי</tei:l>
          <tei:l>נִמְלְצוּ לְחִכִּי פְלָאֶ֫יךָ</tei:l>
          <tei:l>וְאֶכְתְּבֵ֫ימוֹ עַל גִּלָּיוֹן</tei:l>
          <tei:l>וְאָשִׁיר בָּם עֲלֵי הִגָּיוֹן</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>הִתְבַּשֵּׂ֫רוּ בְנֵי עֶלְיוֹן</tei:l>
          <tei:l>כִּי נִחַם יְיָ צִיּוֹן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:zemer_for_tu_beav_abraham/3"/>
        <tei:lg>
          <tei:l>בְּיוֹם זֶה נֶעְצַר מִקֶּ֫דֶם</tei:l>
          <tei:l>נֶ֫גֶף מִמֵּיתֵי מִדְבָּר</tei:l>
          <tei:l>וּבִנְיָמִין צָעִיר רוֹדֵם</tei:l>
          <tei:l>לְשִׁבְטֵי יָהּ בּוֹ הִתְחַבָּר</tei:l>
          <tei:l>וְרָצָה בָהֶם צוּר פּוֹדֵם</tei:l>
          <tei:l>אַחֲרֵי בָ֫מוֹ הִתְעַבָּר</tei:l>
          <tei:l>כִּי טִיהֲרוּ לֵבָב וְרַעְיוֹן</tei:l>
          <tei:l>וְרָחֲצוּ כַפָּם בְּנִקָּיוֹן</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>הִתְבַּשֵּׂ֫רוּ בְנֵי עֶלְיוֹן</tei:l>
          <tei:l>כִּי נִחַם יְיָ צִיּוֹן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:zemer_for_tu_beav_abraham/4"/>
        <tei:lg>
          <tei:l>רוֹן פָּצְחוּ שְׁבָטִים בְּיוֹם זֶה</tei:l>
          <tei:l>וְיֶ֫שַׁע וְעוֹז הִתְאַזָּ֫רוּ</tei:l>
          <tei:l>כִּי בוֹ לָבוֹא זֶה בָזֶה</tei:l>
          <tei:l>וּלְהִתְחַבֵּר הֻתָּ֫רוּ</tei:l>
          <tei:l>וַהֲרוּגִים בְּיַד צָר נִבְזֶה</tei:l>
          <tei:l>בְּבֵית־תֵּר הַיּוֹם נִקְבָּ֫רוּ</tei:l>
          <tei:l>כִּי לֹא יַעֲשֶׂה כִּלָּיוֹן</tei:l>
          <tei:l>צוּר וְיָחוֹס עַל דַּל וְאֶבְיוֹן</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>הִתְבַּשֵּׂ֫רוּ בְנֵי עֶלְיוֹן</tei:l>
          <tei:l>כִּי נִחַם יְיָ צִיּוֹן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:zemer_for_tu_beav_abraham/5"/>
        <tei:lg>
          <tei:l>הַיּוֹם בִּיטֵּל בֶּן־אֵלָה</tei:l>
          <tei:l>שׁוֹמְרֵי אוֹרַח תַּהֲלוּכָה</tei:l>
          <tei:l>שָׂם יְרָבְעָם עַל מְסִלָּה</tei:l>
          <tei:l>לְהַשְׁמִיד חַג מֵעִיר בְּרוּכָה</tei:l>
          <tei:l>וּבוֹ פָסְקוּ שָׂרֵי סְגֻלָּה</tei:l>
          <tei:l>לִכְרוֹת עֵצִים לְמַעֲרָכָה</tei:l>
          <tei:l>כִּי מָצְאוּ בַשֶּׁ֫מֶשׁ רִפְיוֹן</tei:l>
          <tei:l>וְחֻומָּהּ נִסְתַּר בְּתוֹךְ חֶבְיוֹן</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>הִתְבַּשֵּׂ֫רוּ בְנֵי עֶלְיוֹן</tei:l>
          <tei:l>כִּי נִיחַם יְיָ צִיּוֹן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:zemer_for_tu_beav_abraham/6"/>
        <tei:lg>
          <tei:l>מָתַי יְחֻדַּשׁ הוֹד בּוֹלֶה</tei:l>
          <tei:l>לְבֵן בַּגּוֹלָה זָנ֫וּחַ</tei:l>
          <tei:l>וּמָתַי יְנֻחַם לֵב חוֹלֶה</tei:l>
          <tei:l>וּמֵעֹל אוֹיְבַי אָנ֫וּחַ</tei:l>
          <tei:l>מְהֵרָה מְשִׁיחִי יִגָּלֶה</tei:l>
          <tei:l>וְנָחָה עָלָיו הָר֫וּחַ</tei:l>
          <tei:l>וְיִקְרָא לַאֲסִירַי פִּדְיוֹן</tei:l>
          <tei:l>ק֫וּמוּ וְנַעֲלֶה צִיּוֹן</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>הִתְבַּשֵּׂ֫רוּ בְנֵי עֶלְיוֹן</tei:l>
          <tei:l>כִּי נִחַם יְיָ צִיּוֹן</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
