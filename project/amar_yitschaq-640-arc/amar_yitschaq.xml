  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:amar_yitschaq">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_yitschaq/1"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">אֲ</tei:seg>מַר יִצְחָק לְאַבְרָהָם אֲבוּהִי</tei:l>
          <tei:l>מַה־נָאֶה מַדְבְּחָא דִּבְנֵית לִי אַבָּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_yitschaq/2"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">בִּ</tei:seg>פְרִיע פְּשׁוֹט יְדָךְ וְסַב סַכִּינָךְ</tei:l>
          <tei:l>עַד דַּאֲנָא מְצַלִּי קֳדָם רִיבּוֹנִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_yitschaq/3"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">גַּ</tei:seg>לֵּי אֶדְרְעָךְ וְאֵסוֹר חַרְצָךְ</tei:l>
          <tei:l>וְתֶהֱוֵי כְגִבָּר דְעָבֵיד שֵׁירוּי לְמָרֵיהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_yitschaq/4"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">דֵּ</tei:seg>ין הוּא יוֹמָא דְּיֶהֱווּן אָמְרִין</tei:l>
          <tei:l>אַבָּא לָא־חָס עַל־בְּרֵיהּ וּבְרֵיהּ לָא־עַכַּב׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_yitschaq/5"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">הֵ</tei:seg>יךְ תֵּיזִיל וְתֵימוּר לְשָׂרָה אִמִּי</tei:l>
          <tei:l>הֵיךְ תִּפְרוֹשׁ מִינִּי וְתֵיזִיל לְבֵיתָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_yitschaq/6"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">וּ</tei:seg>נְשַׁק יִצְחָק לְאַבְרָהָם אֲבוּהִי</tei:l>
          <tei:l>וּפַקֵּיד יָתֵיהּ וְהַכְּדֵין אֲמַר לֵיהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_yitschaq/7"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">זְ</tei:seg>רוֹק דְּמִי עַל גַבֵּי מַדְבְּחָא</tei:l>
          <tei:l>וּכְנוֹשׁ קִטְמִי וְאוֹבִילֵיהּ לְאִמִּי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_yitschaq/8"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">חַ</tei:seg>יֵּי וּמוֹתָא כּוּלָּא בִּידֵיהּ</tei:l>
          <tei:l>וּמוֹדֵי אֲנָא לֵיהּ דְּהַכְּדֵין בְּחַר בִּי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_yitschaq/9"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">ט</tei:seg>וּבָךְ אַבָּא דְּיֶהֱווּן אָמְרִין</tei:l>
          <tei:l>דַּאֲנָא אִימַּר עָלָתָא דְּמַלְכָּא חַיָּיא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_yitschaq/10"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">יִ</tei:seg>תְקוֹף רוּגְזָךְ וַחֲמָתָךְ אַבָּא</tei:l>
          <tei:l>וְתֶהֱוֵי כִגְּבַר דְּלָא־חָס עַל־בְּרֵיהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_yitschaq/11"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">כִּ</tei:seg>גְבַר אַכְזְרִי סַב סַכִּינָךְ</tei:l>
          <tei:l>וְתִיכּוֹס יָתִי וְלָא תְסָאֵיבְנִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_yitschaq/12"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">לָ</tei:seg>א תָהֵי<tei:anchor xml:id="note_5"/> דִידִי דְלָא אִיעַכְּבָךְ</tei:l>
          <tei:l>דְּלֵית אֲנָא מִן־יְדָךְ נָסֵיב גַּרְמִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_yitschaq/13"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">מַ</tei:seg>ה תִּבְכֵּי אֲמַר יִצְחָק לְאַבְרָהָם אֲבוּהִי</tei:l>
          <tei:l>טוּבִי דִּבְחַר בִּי קִירִיס מִכׇּל־קוֹזְמוֹז׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_yitschaq/14"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">נִ</tei:seg>יחָא רוּחָא דְּשָׂרָה אִמִּי</tei:l>
          <tei:l>הֵיךְ נַפְקִינָּן תְּרֵינַן בְּלִיבָּא שְׁלֵימָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_yitschaq/15"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">סַ</tei:seg>כִּינָךְ הַב לִי אַבָּא וַאֲגוֹשִׁינֵיהּ</tei:l>
          <tei:l>בְּבָעוּ מִינָךְ דְּלָא תְסָאֵיבְנִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_yitschaq/16"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">עֵ</tei:seg>ינַי חָמְיָין קֵיסִין מְסַדְּרִין</tei:l>
          <tei:l>נוּר דָּלֵיק בְּיוֹם קׇרְבָּנִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_yitschaq/17"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>תַח פּוּמָךְ וּבָרֵיךְ אַבָּא</tei:l>
          <tei:l>וְאֶשְׁמַע אֲנָא וְאֵימַר אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_yitschaq/18"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">צַ</tei:seg>וָּארִי פְּשׁוּט לָךְ אַבָּא</tei:l>
          <tei:l>וּמַה דְּנִיחָא לָךְ קוּם עִבֵיד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_yitschaq/19"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>מוּ מַלְאֲכַיָּא וּמְפַיְּיסִין לְמָרֵיהוֹן</tei:l>
          <tei:l>בְּבָעוּ מִינָךְ חוּס עַל־טַלְיָיא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_yitschaq/20"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">רַ</tei:seg>חֲמוֹי דַּאֲבוּהִי אֲנַן מַדְכְּרִינַּן</tei:l>
          <tei:l>דְּאַכְלִינַּן עִימֵּיהּ מְלַח בְּבֵיתֵיהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_yitschaq/21"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">שַׁ</tei:seg>דַּי אֲמַר לֵיהּ לָא תִדְחַל טַלְיָא</tei:l>
          <tei:l>דַּאֲנָא הוּא פָרוֹקָא וְאֶפְרוֹק יָתָךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_yitschaq/22"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">תַּ</tei:seg>קִיף הוּא אֱלָהַנָא וְתַקִּיפִין עוֹבָדוֹהִי</tei:l>
          <tei:l>לֵית אֳחׇרָן כְּוָתֵיהּ וְלֵית דְּדָמֵי לֵיהּ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" n="5" target="#note_5">
      <tei:p>Some texts add קׇרְבָּנָא this sacrifice or דָּא this here</tei:p>
    </tei:note>
  </tei:standOff>
