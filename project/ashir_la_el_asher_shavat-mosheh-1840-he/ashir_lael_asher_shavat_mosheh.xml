    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ashir_lael_asher_shavat_mosheh">
        <tei:head>אָשִׁיר לָאֵל אֲשֶׁר שָׁבַת</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashir_lael_asher_shavat_mosheh/1"/>
        <tei:lg>
          <tei:l>אָשִׁיר לָאֵל אֲשֶׁר שָׁבַת</tei:l>
          <tei:l>מִמְּלַאכְתּוֹ בְּיוֹם שַׁבָּת</tei:l>
          <tei:l>נְתָנוֹ לְעַם כְּבָבַת</tei:l>
          <tei:l>עַיִן תָּמִיד</tei:l>
          <tei:l>יִנְצְרֶנְהוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashir_lael_asher_shavat_mosheh/2"/>
        <tei:lg>
          <tei:l>מְכֻבָּד הוּא מִכָּל יָמִים</tei:l>
          <tei:l>כִּי בוֹ שָׁבַת צוּר עוֹלָמִים</tei:l>
          <tei:l>יָנוּחַ בּוֹ לֵב עֲגוּמִים</tei:l>
          <tei:l>שַׂמֵּחַ יְשַׂמְּחֶנְהוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashir_lael_asher_shavat_mosheh/3"/>
        <tei:lg>
          <tei:l>שַׁבַּת קֹדֶשׁ יוֹם מְנוּחָה</tei:l>
          <tei:l>בּוֹ נָסוּ יָגוֹן וַאֲנָחָה</tei:l>
          <tei:l>עַם אֵל בְּהַשְׁקֵט</tei:l>
          <tei:l>וּבְבִטְחָה</tei:l>
          <tei:l>שַׁבָּת עֹנֶג יִקְרָאוּהוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashir_lael_asher_shavat_mosheh/4"/>
        <tei:lg>
          <tei:l>הָאֵל אֲשֶׁר בָּחַר בָּנוּ</tei:l>
          <tei:l>שַׁבַּת קָדְשׁוֹ הִנְחִילָנוּ</tei:l>
          <tei:l>מִן הָעַמִּים הִבְדִּילָנוּ</tei:l>
          <tei:l>לִהְיוֹת לָנוּ לֵאלֹהִים הוּא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashir_lael_asher_shavat_mosheh/5"/>
        <tei:lg>
          <tei:l>הַלְוִיִּם רִנָּה יִפְצְחוּ</tei:l>
          <tei:l>לִכְבוֹד שַׁבָּת כִּי בוֹ נָחוּ</tei:l>
          <tei:l>כָּל יִשְׂרָאֵל בּוֹ יִשְׂמָחוּ</tei:l>
          <tei:l>שִׂמְחַת עוֹלָם</tei:l>
          <tei:l>עַל רֹאשָׁם הוּא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashir_lael_asher_shavat_mosheh/6"/>
        <tei:lg>
          <tei:l>חָזָק יִשְׁלַח מְשִׁיחֵנוּ</tei:l>
          <tei:l>וְיָשִׁיב אֶת שְׁבִיתֵנוּ</tei:l>
          <tei:l>וְאָז נִשְׁבּוֹת שַׁבָּתֵּנוּ</tei:l>
          <tei:l>עוֹלָם שֶׁכֻּלּוֹ שַׁבָּת הוּא</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
