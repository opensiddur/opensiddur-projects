  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:priere_pour_lempereur_durlacher">
        <tei:head>תפלה לשלום המלכות</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:priere_pour_lempereur_durlacher/1"/>
        <tei:lg>
          <tei:l>אֶלֹהִים חַיִּים וּמֶלֶךְ עוֹלָם .</tei:l>
          <tei:l>הַמַּגְבִּיהִי לָשָׁבֶת</tei:l>
          <tei:l>הַמַּשְׁפִּילִי לִרְאוֹת</tei:l>
          <tei:l>בַּשָּׁמַיִם וּבָאָרֶץ .</tei:l>
          <tei:l>בְּיָדְךָ כֹּחַ וּגְבוּרָה</tei:l>
          <tei:l>לְגַדֵּל וּלְחַזֵּק לַכֹּל.</tei:l>
          <tei:l>אֲשֶׁר מִפִּיךָ מְלָכִים יִמְלֹכוּ .</tei:l>
          <tei:l>וּמִיָּדְךָ לָמוֹ מַטֵּה עֹז .</tei:l>
          <tei:l>שֵׁבֶט מִישׁוֹר לְנַהֵל לְאֻמִּים .</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:priere_pour_lempereur_durlacher/2"/>
        <tei:lg>
          <tei:l>הַשְׁקִיפָה מִמְעוֹן קָדְשְׁךָ וּבָרֵךְ</tei:l>
          <tei:l>וּנְצוֹר וּשְׁמוֹר אֶת אֲדוֹנֵנוּ</tei:l>
          <tei:l>לואי נאפאלעאן השלישי קיסר הצרפתים</tei:l>
          <tei:l>אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:priere_pour_lempereur_durlacher/3"/>
        <tei:lg>
          <tei:l>בִּרְכוֹת שָׁמַיִם מֵעָל תְּצַו אִתּוֹ.</tei:l>
          <tei:l>יַאֲרִיךְ יַמִים</tei:l>
          <tei:l>וּשְׁנוֹת חַיִּים עַל מַמְלַכְתּוֹ .</tei:l>
          <tei:l>אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:priere_pour_lempereur_durlacher/4"/>
        <tei:lg>
          <tei:l>כְּאִישׁוֹן בַּת עַיִן תִּנְצְרֵהו .</tei:l>
          <tei:l>עֲטֶרֶת תִּפְאֶרֶת נֶצַח תְּמַגְּנֵהוּ .</tei:l>
          <tei:l>אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:priere_pour_lempereur_durlacher/5"/>
        <tei:lg>
          <tei:l>שְׁלַח אוֹרְךָ וַאֲמִתְּךָ</tei:l>
          <tei:l>הֵמָּה יַנְחוּהוּ .</tei:l>
          <tei:l>חֶסֶד וֶאֱמֶת תָּמִיד . יִצְּרוּהוּ .</tei:l>
          <tei:l>אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:priere_pour_lempereur_durlacher/6"/>
        <tei:lg>
          <tei:l>מְאֹד מְאֹד יָרוּם אֲדוֹנֵנוּ וְנִשָּׂא וְגָבַהּ .</tei:l>
          <tei:l>עִם כׇּל בְּנֵי מִשְׁפַּחְתּוֹ הַנִּשְֺגָּבָה .</tei:l>
          <tei:l>אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:priere_pour_lempereur_durlacher/7"/>
        <tei:lg>
          <tei:l>בְּאַרְצֵנוּ רַב שָׁלוֹם יִפְרַח .</tei:l>
          <tei:l>וְיוֹשְבֶיהָ לָעַד שִשְׁכְּנוּ לָבֶטַח .</tei:l>
          <tei:l>אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:priere_pour_lempereur_durlacher/8"/>
        <tei:lg>
          <tei:l>יִהְיוּ לְרָצוֹן אִמְרֵי פִינוּ</tei:l>
          <tei:l>וְהֶגְיוֹן לִבֵּנוּ</tei:l>
          <tei:l>לְפָנֶיךָ יְיָ</tei:l>
          <tei:l>צוּרֵנוּ וְגוֹאֲלֵנוּ .</tei:l>
          <tei:l>אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:priere_pour_lempereur_durlacher/9"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">בקצת קהלות אומרים תפלה זו</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:priere_pour_lempereur_durlacher/10"/>
        <tei:lg>
          <tei:l>הַנּוֹתֵן תְּשׁוּעָה לַמְּלָכִים וּמֶמְשָׁלָה לַנְּסִיכִים</tei:l>
          <tei:l>מַלְכוּתוֹ מַלְכוּת כׇּל עוֹלָמִים</tei:l>
          <tei:l>הַפּוֹצֶה אֶת־דָּוִד עַבְדּוֹ מֵחֶֽרֶב רָעָה</tei:l>
          <tei:l>הַנּוֹתֵן בַּיָּם דָּֽרֶךְ וּבְמַֽיִם עַזִּים נְתִיבָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:priere_pour_lempereur_durlacher/11"/>
        <tei:lg>
          <tei:l>הוּא יְבָרֵךְ וְיִשְׁמוֹר וְיִנְצוֹר וְיַעֲזוֹר</tei:l>
          <tei:l>וִירוֹמֵם וִיגַדֵּל וִינַשֵּׂא לְמַֽעְלָה</tei:l>
          <tei:l>אֶת אֲדוֹנֵנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:priere_pour_lempereur_durlacher/12"/>
        <tei:lg>
          <tei:l>מֶֽלֶךְ מַלְכֵי הַמְּלָכִים</tei:l>
          <tei:l>בְּרַחֲמָיו יְחַיֵּֽהוּ</tei:l>
          <tei:l>וְיִשְׁמְרֵֽהוּ וּמִכׇּל צָרָה</tei:l>
          <tei:l>וְיָגוֹן וָנֶֽזֶק יַצִּילֵֽהוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:priere_pour_lempereur_durlacher/13"/>
        <tei:lg>
          <tei:l>וַיְדַבֵּר עַמִּים תַּחַת רַגְלָיו</tei:l>
          <tei:l>וְיַפִּיל שׂוֹנְאָיו לְפָנָיו</tei:l>
          <tei:l>וּבְכָל אֲשֶׁר יִפְנֶה יַצְלִיחַ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:priere_pour_lempereur_durlacher/14"/>
        <tei:lg>
          <tei:l>מֶלֶךְ מַלְכֵי הַמְּלָכִים</tei:l>
          <tei:l>בְּרַחֲמָיו יִתֵּן בְּלִבּוֹ</tei:l>
          <tei:l>וּבְלֵב כׇּל יוֹעֲצָיו וְשָׂרָיו</tei:l>
          <tei:l>רַחֲמָנוּת לַעֲשׂוֹת טוֹבָה עִמָּנוּ</tei:l>
          <tei:l>וְעִם כׇּל יִשְׂרָאֵל.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:priere_pour_lempereur_durlacher/15"/>
        <tei:lg>
          <tei:l>בְּיָמָיו וּבְיָמֵינוּ</tei:l>
          <tei:l>תִּוָּשַׁע יְהוּדָה.</tei:l>
          <tei:l>וְיִשְׂרָאֵל יִשְׁכּוֹן לָבֶטַח</tei:l>
          <tei:l>וּבָא לְצִיּוֹן גּוֹאֵל.</tei:l>
          <tei:l>וְכֵן יְהִי רָצוֹן</tei:l>
          <tei:l>וְנֺאמַר אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
