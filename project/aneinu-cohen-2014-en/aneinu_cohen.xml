  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:aneinu_cohen">
        <tei:head>Aneinu, Answer us: a seliḥah in advance of the Shmitah year by Emmy Cohen</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:aneinu_cohen/1"/>
        <tei:lg>
          <tei:l><tei:hi rend="italic">Aneinu</tei:hi>, Answer us</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:aneinu_cohen/2"/>
        <tei:lg>
          <tei:l>How can this year be made holy?</tei:l>
          <tei:l>Let us feel full, while living a year of emptiness.</tei:l>
          <tei:l>Help us find peace in the confusion.</tei:l>
          <tei:l>Give us the power to heal.</tei:l>
          <tei:l>May we only learn from peace.</tei:l>
          <tei:l>Grant us the courage to keep seeking.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:aneinu_cohen/3"/>
        <tei:lg>
          <tei:l>Answer us, let us never stop asking.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>
            <tei:hi rend="italic">Aneinu</tei:hi>
          </tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
