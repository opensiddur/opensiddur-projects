  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai/2"/>
        <tei:lg>
          <tei:l>לָא קָאדִּר סַוָא אַלְלָה,</tei:l>
          <tei:l>וַלָא מַבְּרוּךְּ כַּבִּן עַמְרָם,</tei:l>
          <tei:l>וַלָא אַעְטַׄם מִן אַל־תּוֹרָה,</tei:l>
          <tei:l>וַדָּארִסְהָא כַּיִשְׂרָאֵל׃</tei:l>
          <tei:l>מִפִּי אֵל...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai/3"/>
        <tei:lg>
          <tei:l>לָא גָׄאלִי סַוָא אַלְלָה,</tei:l>
          <tei:l>וַלָא עַזִיז כַּבִּן עַמְרָם,</tei:l>
          <tei:l>וַלָא אַוְצַׄח מִן אַל־תּוֹרָה,</tei:l>
          <tei:l>וַעָאשִׁקְהָא כַּיִשְׂרָאֵל׃</tei:l>
          <tei:l>מִפִּי אֵל...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai/4"/>
        <tei:lg>
          <tei:l>לָא טָאהִר סַוָא אַלְלָה,</tei:l>
          <tei:l>וַלָא עָאדִּל כַּבִּן עַמְרָם,</tei:l>
          <tei:l>וַלָא אַוְקַר מִן אַל־תּוֹרָה,</tei:l>
          <tei:l>וַקָארִיְהָא כַּיִשְׂרָאֵל׃</tei:l>
          <tei:l>מִפִּי אֵל...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai/5"/>
        <tei:lg>
          <tei:l>לָא סֻלְטָאן סַוָא אַלְלָה,</tei:l>
          <tei:l>וַלָא אַמִין כַּבִּן עַמְרָם,</tei:l>
          <tei:l>וַלָא אִסְנַדּ מִן אַל־תּוֹרָה,</tei:l>
          <tei:l>וַוַאצִפְׄהָא כַּיִשְׂרָאֵל׃</tei:l>
          <tei:l>מִפִּי אֵל...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai/6"/>
        <tei:lg>
          <tei:l>לָא פָ֗אדִּי סַוָא אַלְלָה,</tei:l>
          <tei:l>וַלָא צָאדִּק כַּבִּן עַמְרָם,</tei:l>
          <tei:l>וַלָא מֻקַדַּ֘ם כַּאל־תּוֹרָה,</tei:l>
          <tei:l>וַתַּאקִנְהָא כַּיִשְׂרָאֵל׃</tei:l>
          <tei:l>מִפִּי אֵל...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai/7"/>
        <tei:lg>
          <tei:l>לָא כָּאמִל סַוָא אַלְלָה,</tei:l>
          <tei:l>וַלָא מֻתַּמִּם כַּבִּן עַמְרָם,</tei:l>
          <tei:l>וַלָא אַכְּמַל מִן אַל־תּוֹרָה,</tei:l>
          <tei:l>וַסָאנִדְּהָא כַּיִשְׂרָאֵל׃</tei:l>
          <tei:l>מִפִּי אֵל...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
