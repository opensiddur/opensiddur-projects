  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:positive_vidui_weiss">
        <tei:head>ודוי חיובית</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:positive_vidui_weiss/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אָ</tei:seg>הַבְנוּ,</tei:l>
          <tei:l><tei:seg type="acrostic">בֵּ</tei:seg>רַכְנוּ,</tei:l>
          <tei:l><tei:seg type="acrostic">גָּ</tei:seg>דַלְנוּ,</tei:l>
          <tei:l><tei:seg type="acrostic">דִּ</tei:seg>בַּרְנוּ יֹפִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:positive_vidui_weiss/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הֶ</tei:seg>עֱלִינוּ,</tei:l>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>חַסְנוּ,</tei:l>
          <tei:l><tei:seg type="acrostic">זֵ</tei:seg>רַזְנוּ,</tei:l>
          <tei:l><tei:seg type="acrostic">חָ</tei:seg>מַלְנוּ,</tei:l>
          <tei:l><tei:seg type="acrostic">טִ</tei:seg>פַּחְנוּ אֱמֶת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:positive_vidui_weiss/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>עַצְנוּ טוֹב,</tei:l>
          <tei:l><tei:seg type="acrostic">כִּ</tei:seg>בַּדְנוּ,</tei:l>
          <tei:l><tei:seg type="acrostic">לָ</tei:seg>מַדְנוּ,</tei:l>
          <tei:l><tei:seg type="acrostic">מָ</tei:seg>חַלְנוּ,</tei:l>
          <tei:l><tei:seg type="acrostic">נִ</tei:seg>חַמְנוּ,</tei:l>
          <tei:l><tei:seg type="acrostic">סָ</tei:seg>לַלְנוּ,</tei:l>
          <tei:l><tei:seg type="acrostic">ע</tei:seg>וֹרַרְנוּ,</tei:l>
          <tei:l><tei:seg type="acrostic">פָּ</tei:seg>עַלְנוּ,</tei:l>
          <tei:l><tei:seg type="acrostic">צָ</tei:seg>דַקְנוּ,</tei:l>
          <tei:l><tei:seg type="acrostic">קִ</tei:seg>וִּינוּ לָאָרֶץ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:positive_vidui_weiss/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רִ</tei:seg>חַמְנוּ,</tei:l>
          <tei:l><tei:seg type="acrostic">שָׁ</tei:seg>קַדְנוּ,</tei:l>
          <tei:l><tei:seg type="acrostic">תָּ</tei:seg>מַכְנוּ,</tei:l>
          <tei:l>תָּרַמְנוּ,</tei:l>
          <tei:l>תִּקַּנּוּ</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
