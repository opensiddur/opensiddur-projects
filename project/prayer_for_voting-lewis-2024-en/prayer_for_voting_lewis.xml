  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_voting_lewis">
        <tei:head>Prayer for Voting, by Rachie Lewis (Keshet 2024)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_voting_lewis/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">As you prepare to fill out your ballot, take three deep breaths.</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">Then recite the following prayer:</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_voting_lewis/2"/>
        <tei:lg>
          <tei:l>May it be Your will,</tei:l>
          <tei:l><j:divineName>God of our ancestors</j:divineName>,</tei:l>
          <tei:l><j:divineName>Divine spirit</j:divineName> who makes change</tei:l>
          <tei:l>and inspires change,</tei:l>
          <tei:l>that You accompany us</tei:l>
          <tei:l>as we carry out our civic duty</tei:l>
          <tei:l>to vote,</tei:l>
          <tei:l>to concern ourselves with the fate of our community,</tei:l>
          <tei:l>for we are all responsible for one another.<tei:anchor xml:id="note_1"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_voting_lewis/3"/>
        <tei:lg>
          <tei:l>May it be Your will</tei:l>
          <tei:l>that all endowed with the right to vote</tei:l>
          <tei:l>recognize their power,</tei:l>
          <tei:l>exercise their power;</tei:l>
          <tei:l>that You bless the work of our hands,<tei:anchor xml:id="note_2"/></tei:l>
          <tei:l>striving to build a world</tei:l>
          <tei:l>that honors Your creations,</tei:l>
          <tei:l>every one made <tei:hi rend="italic">B’tselem Elohim</tei:hi> — in Your image;<tei:anchor xml:id="note_3"/></tei:l>
          <tei:l>that You grant us the wisdom</tei:l>
          <tei:l>to choose holiness,</tei:l>
          <tei:l>to choose love,</tei:l>
          <tei:l>to choose life.<tei:anchor xml:id="note_4"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_voting_lewis/4"/>
        <tei:lg>
          <tei:l>Blessed are You <j:divineName>God</j:divineName>,</tei:l>
          <tei:l>who hears our prayer,</tei:l>
          <tei:l>who spreads over us a sukkah,</tei:l>
          <tei:l>a voting booth,</tei:l>
          <tei:l>of peace.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
