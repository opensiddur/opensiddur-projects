    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:interpretive_al_cheyt_for_yom_kippur_kapor_mater">
        <tei:head>עַל חֵטְא</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:interpretive_al_cheyt_for_yom_kippur_kapor_mater/1"/>
        <tei:lg>
          <tei:l>עַל חֵטְא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:interpretive_al_cheyt_for_yom_kippur_kapor_mater/2"/>
        <tei:lg>
          <tei:l>א</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ בְּאֹנֶס וּבְרָצוֹן:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:interpretive_al_cheyt_for_yom_kippur_kapor_mater/3"/>
        <tei:lg>
          <tei:l>בּ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְעַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ בִּבְלִי דָעַת:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:interpretive_al_cheyt_for_yom_kippur_kapor_mater/4"/>
        <tei:lg>
          <tei:l>ג</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ בְּגִלּוּי עֲרָיוֹת:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:interpretive_al_cheyt_for_yom_kippur_kapor_mater/5"/>
        <tei:lg>
          <tei:l>ד</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְעַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ בְּדַעַת וּבְמִרְמָה:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:interpretive_al_cheyt_for_yom_kippur_kapor_mater/6"/>
        <tei:lg>
          <tei:l>ה</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ בְּהוֹנָאַת רֵעַ:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:interpretive_al_cheyt_for_yom_kippur_kapor_mater/7"/>
        <tei:lg>
          <tei:l>ו</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְעַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ בִּוְעִידַת זְנוּת:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:interpretive_al_cheyt_for_yom_kippur_kapor_mater/8"/>
        <tei:lg>
          <tei:l>ז</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ בְּזִלְזוּל הוֹרִים וּמוֹרִים:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:interpretive_al_cheyt_for_yom_kippur_kapor_mater/9"/>
        <tei:lg>
          <tei:l>ח</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְעַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ בְּחֹזֶק יָד:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:interpretive_al_cheyt_for_yom_kippur_kapor_mater/10"/>
        <tei:lg>
          <tei:l>ט</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ בְּטֻמְאַת שְׂפָתָיִם:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:interpretive_al_cheyt_for_yom_kippur_kapor_mater/11"/>
        <tei:lg>
          <tei:l>י</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְעַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ בְּיֵצֶר הָרָע:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:interpretive_al_cheyt_for_yom_kippur_kapor_mater/12"/>
        <tei:lg>
          <tei:l>וְעַל כֻּלָּם אֱלוֹהַּ סְלִיחוֹת. סְלַח לָנוּ. מְחַל לָנוּ. כַּפֶּר לָנוּ:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:interpretive_al_cheyt_for_yom_kippur_kapor_mater/13"/>
        <tei:lg>
          <tei:l>כ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ בְּכַחַשׁ וּבְכָזָב:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:interpretive_al_cheyt_for_yom_kippur_kapor_mater/14"/>
        <tei:lg>
          <tei:l>ל</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְעַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ בְּלָצוֹן:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:interpretive_al_cheyt_for_yom_kippur_kapor_mater/15"/>
        <tei:lg>
          <tei:l>מ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ בְּמַשָּׂא וּבְמַתָּן:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:interpretive_al_cheyt_for_yom_kippur_kapor_mater/16"/>
        <tei:lg>
          <tei:l>נ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְעַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ בְּנֶשֶׁךְ וּבְמַרְבִּית:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:interpretive_al_cheyt_for_yom_kippur_kapor_mater/17"/>
        <tei:lg>
          <tei:l>ס</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ בְּשִׂיחַ שִׂפְתוֹתֵינוּ:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:interpretive_al_cheyt_for_yom_kippur_kapor_mater/18"/>
        <tei:lg>
          <tei:l>ע</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְעַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ בְּעֵינַיִם רָמוֹת:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:interpretive_al_cheyt_for_yom_kippur_kapor_mater/19"/>
        <tei:lg>
          <tei:l>וְעַל כֻּלָּם אֱלוֹהַּ סְלִיחוֹת. סְלַח לָנוּ. מְחַל לָנוּ. כַּפֶּר לָנוּ:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:interpretive_al_cheyt_for_yom_kippur_kapor_mater/20"/>
        <tei:lg>
          <tei:l>פ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ בִּפְרִיקַת עוֹל:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:interpretive_al_cheyt_for_yom_kippur_kapor_mater/21"/>
        <tei:lg>
          <tei:l>צ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְעַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ בִּצְדִיַּת רֵעַ:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:interpretive_al_cheyt_for_yom_kippur_kapor_mater/22"/>
        <tei:lg>
          <tei:l>ק</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ בְּקַלּוּת רֹאשׁ:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:interpretive_al_cheyt_for_yom_kippur_kapor_mater/23"/>
        <tei:lg>
          <tei:l>ר</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְעַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ בְּרִיצַת רַגְלַיִם לְהָרַע:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:interpretive_al_cheyt_for_yom_kippur_kapor_mater/24"/>
        <tei:lg>
          <tei:l>ש</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>עַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ בִּשְׁבוּעַת שָׁוְא:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:interpretive_al_cheyt_for_yom_kippur_kapor_mater/25"/>
        <tei:lg>
          <tei:l>ת</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְעַל חֵטְא שֶׁחָטָאנוּ לְפָנֶיךָ בִּתְשׂוּמֶת יָד:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:interpretive_al_cheyt_for_yom_kippur_kapor_mater/26"/>
        <tei:lg>
          <tei:l>וְעַל כֻּלָּם אֱלוֹהַּ סְלִיחוֹת. סְלַח לָנוּ. מְחַל לָנוּ. כַּפֶּר לָנוּ:</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
