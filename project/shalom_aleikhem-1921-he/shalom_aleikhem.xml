  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:shalom_aleikhem">
        <tei:head>שָׁלוֹם עֲלֵיכֶם</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shalom_aleikhem/1"/>
        <tei:lg>
          <tei:l>שָׁלוֹם עֲלֵיכֶם</tei:l>
          <tei:l>מַלְאֲכֵי הַשָּׁרֵת</tei:l>
          <tei:l>מַלְאֲכֵי עֶלְיוֹן</tei:l>
          <tei:l>מִמֶּלֶךְ מַלְכֵי הַמְּלָכִים</tei:l>
          <tei:l>הַקָּדוֹשׁ בָּרוּךְ הוּא.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shalom_aleikhem/2"/>
        <tei:lg>
          <tei:l>בּוֹאֲכֶם לְשָׁלוֹם</tei:l>
          <tei:l>מַלְאֲכֵי הַשָּׁלוֹם</tei:l>
          <tei:l>מַלְאֲכֵי עֶלְיוֹן</tei:l>
          <tei:l>מִמֶּלֶךְ מַלְכֵי הַמְּלָכִים</tei:l>
          <tei:l>הַקָּדוֹשׁ בָּרוּךְ הוּא.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shalom_aleikhem/3"/>
        <tei:lg>
          <tei:l>בָּרְכוּנִי לְשָׁלוֹם</tei:l>
          <tei:l>מַלְאֲכֵי הַשָּׁלוֹם</tei:l>
          <tei:l>מַלְאֲכֵי עֶלְיוֹן</tei:l>
          <tei:l>מִמֶּלֶךְ מַלְכֵי הַמְּלָכִים</tei:l>
          <tei:l>הַקָּדוֹשׁ בָּרוּךְ הוּא.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shalom_aleikhem/4"/>
        <tei:lg>
          <tei:l>צֵאתְכֶם לְשָׁלוֹם</tei:l>
          <tei:l>מַלְאֲכֵי הַשָּׁלוֹם</tei:l>
          <tei:l>מַלְאֲכֵי עֶלְיוֹן</tei:l>
          <tei:l>מִמֶּלֶךְ מַלְכֵי הַמְּלָכִים</tei:l>
          <tei:l>הַקָּדוֹשׁ בָּרוּךְ הוּא.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
