    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:modeh_ani">
        <tei:head>Modah/Modeh Ani, by Moshe ibn Makhir (translation by Andrew Shaw)</tei:head>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>Thankful am I in your Presence,</tei:l>
          <tei:l>Spirit who lives and endures,</tei:l>
          <tei:l>for You’ve returned to me my soul</tei:l>
          <tei:l>with compassion.</tei:l>
          <tei:l>Abundant is your faith!</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">Proceed to hand washing</tei:note>
          </tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
