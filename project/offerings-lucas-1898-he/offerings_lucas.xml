  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:offerings_lucas">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:offerings_lucas/1"/>
        <tei:lg>
          <tei:l>וַיְדַבֵּר יְהוָה אֶל־מֹשֶׁה לֵּאמֹר׃</tei:l>
          <tei:l>דַּבֵּר אֶל־בְּנֵי יִשְׂרָאֵל</tei:l>
          <tei:l>וְיִקְחוּ־לִי תְּרוּמָה</tei:l>
          <tei:l>מֵאֵת כָּל־אִישׁ אֲשֶׁר יִדְּבֶנּוּ לִבּוֹ</tei:l>
          <tei:l>תִּקְחוּ אֶת־תְּרוּמָתִי׃ <tei:bibl>(שמות כה:א-ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:offerings_lucas/2"/>
        <tei:lg>
          <tei:l>וַיֹּאמֶר הַמֶּלֶךְ דָּוִיד לְאָרְנָן ...</tei:l>
          <tei:l>לֹא־אֶשָּׂא אֲשֶׁר־לְךָ לַיהוָה</tei:l>
          <tei:l>וְהַעֲלוֹת עוֹלָה חִנָּם׃ <tei:bibl>(דברי הימים א׳ כא:כד)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
