      <tei:div corresp="urn:x-opensiddur:text:poem:che_volera">
        <tei:head>קְי ווֹלְירַה קְי אְינטְינדְירַה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:che_volera/1"/>
        <tei:lg>
          <tei:l>מָה רָצוּי, מָה יָדוּעַ,</tei:l>
          <tei:l>מָה הַדָּבָר שֶׁיִּשָּׁבֵעַ?</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:che_volera/2"/>
        <tei:lg>
          <tei:l>אֶחָד מִי יוֹדֵעַ</tei:l>
          <tei:l>רַק אֶחָד הוּא הַבּוֹרֵא</tei:l>
          <tei:l>בָּרוּךְ הוּא וּבָרוּךְ שְׁמוֹ׃</tei:l>
          <tei:l>אָמֵן!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:che_volera/3"/>
        <tei:lg>
          <tei:l>שְׁנַיִם מִי יוֹדֵעַ.</tei:l>
          <tei:l>שְׁנֵי לֻחוֹת הַבְּרִית.</tei:l>
          <tei:l>רַק אֶחָד הוּא הַבּוֹרֵא</tei:l>
          <tei:l>בָּרוּךְ הוּא וּבָרוּךְ שְׁמוֹ׃</tei:l>
          <tei:l>אָמֵן!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:che_volera/4"/>
        <tei:lg>
          <tei:l>שְׁלֹשָׁה מִי יוֹדֵעַ.</tei:l>
          <tei:l>שְׁלֹשָׁה אָבוֹת.</tei:l>
          <tei:l>אַבְרָהָם יִצְחָק וְיַעֲקֹב</tei:l>
          <tei:l>שְׁנֵי לֻחוֹת הַבְּרִית.</tei:l>
          <tei:l>רַק אֶחָד הוּא הַבּוֹרֵא</tei:l>
          <tei:l>בָּרוּךְ הוּא וּבָרוּךְ שְׁמוֹ׃</tei:l>
          <tei:l>אָמֵן!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:che_volera/5"/>
        <tei:lg>
          <tei:l>אַרְבַּע מִי יוֹדֵעַ.</tei:l>
          <tei:l>אַרְבַּע אִמָּהוֹת.</tei:l>
          <tei:l>שָׂרָה רִבְקָה רָחֵל וְלֵאָה</tei:l>
          <tei:l>שְׁלֹשָׁה אָבוֹת.</tei:l>
          <tei:l>אַבְרָהָם יִצְחָק וְיַעֲקֹב</tei:l>
          <tei:l>שְׁנֵי לֻחוֹת הַבְּרִית.</tei:l>
