  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:tiqun_for_rosh_chodesh_nisan">
        <tei:head>תיקון לראש חודש ניסן</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_rosh_chodesh_nisan/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">יש לאנשי מעשה ללמוד ביום ר״ח ניסן</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">מיד אחר התפלה בפרשת הקמת המשכן</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">זכר למשכן שהוקם בו ביום:</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_rosh_chodesh_nisan/2"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">קריאות</tei:note>
          </tei:l>
          <tei:l>שמות לט:לג–מ:לח</tei:l>
          <tei:l>במדבר ז:א–יז</tei:l>
          <tei:l>יחזקאל לז</tei:l>
          <tei:l>תהלים קכב</tei:l>
          <tei:l>זוהר במדבר ג</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_rosh_chodesh_nisan/3"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ואחר קריאה זאת יום ראשון יאמר</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_rosh_chodesh_nisan/4"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן מִלְּפָנֶֽיךָ</tei:l>
          <tei:l>יְהָוְהָ אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ</tei:l>
          <tei:l>שֶׁיְּהֵא חָשׁוּב וּמְרֻצֶּה קְרִיאָתֵֽנוּ בַּתּוֹרָה</tei:l>
          <tei:l>סֵֽדֶר קׇרְבַּן נָשִׂיא נַחְשׁוֹן בֶּן־עַמִּינָדָב</tei:l>
          <tei:l>מִשֵּֽׁבֶט יְהוּדָה הֶחָתוּם בְּמַלְכוּת</tei:l>
          <tei:l>קׇרְבָּנוֹ אֲשֶׁר הִקְרִיב</tei:l>
          <tei:l>לַחֲנֻכַּת מִזְבָּחָךְ הַקָּדוֹשׁ</tei:l>
          <tei:l>וְתַעֲלֶה עָלֵֽינוּ</tei:l>
          <tei:l>כְּאִֽלּוּ הִשְׂגַּֽבְנוּ כׇּל־הַסּוֹדוֹת</tei:l>
          <tei:l>וְכׇל־שְׁמוֹת הַקֹּֽדֶשׁ</tei:l>
          <tei:l>הַיּוֹצְאִים מֵרָאשֵׁי תֵּבוֹת וְסוֹפִי תֵּבוֹת</tei:l>
          <tei:l>מִקְרָאֵי קֹֽדֶשׁ</tei:l>
          <tei:l>אֵֽלֶּה וּֽנְשַׁלְּמָ֥ה פָרִ֖ים שְׂפָתֵֽינוּ <tei:bibl>(הושע יד:ג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_rosh_chodesh_nisan/5"/>
        <tei:lg>
          <tei:l>וְיָאִֽירוּ־נָא עָלֵֽינוּ</tei:l>
          <tei:l>וְעַל־כׇּל־בֵּית יִשְׂרָאֵל אַחֵֽינוּ</tei:l>
          <tei:l>כׇּל־נִיצוֹצוֹת הַקְּדֻשָּׁה</tei:l>
          <tei:l>וְכׇל־הָאוֹרוֹת הַקְּדוֹשׁוֹת</tei:l>
          <tei:l>הַכְּלוּלוֹת בִּקְדֻשַּׁת זֶה הַשֵּֽׁבֶט</tei:l>
          <tei:l>וְנִהְיֶה מְלֻבָּשִׁים כִּקְדֻשַּׁת זֶה הַשֵּֽׁבֶט</tei:l>
          <tei:l>לְהָכִין וּלְהַשְׂכִּיל בְּתוֹרָתָךְ</tei:l>
          <tei:l>וּבְיִרְאָתָךְ יִרְאַת הָרוֹמְמוּת</tei:l>
          <tei:l>לַעֲשׂוֹת רְצוֹנָךְ כִּרְצוֹנָךְ</tei:l>
          <tei:l>כׇּל־יְמֵי חַיֵּֽינוּ</tei:l>
          <tei:l>אֲנַֽחְנוּ וְזַרְעֵֽנוּ</tei:l>
          <tei:l>וְזֶֽרַע זַרְעֵֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_rosh_chodesh_nisan/6"/>
        <tei:lg>
          <tei:l>וּכְשֵׁם שֶׁכַּחֹֽדֶשׁ הַזֶּה</tei:l>
          <tei:l>פָּדִֽיתָ אֶת־עַמָּךְ</tei:l>
          <tei:l>שִׁבְטֵי נַחֲלָתָךְ</tei:l>
          <tei:l>מִכּוּר הַבַּרְזֶל מִמִּצְרַֽיִם</tei:l>
          <tei:l>וְזָכַרְתָּ בְּאַהֲבָה לִתְהִלָּה</tei:l>
          <tei:l>לְשֵׁם וּלְתִפְאֶֽרֶת</tei:l>
          <tei:l>לִשְׁמוֹת מַטּוֹת אֲבֹתָם</tei:l>
          <tei:l>עַל־הַנִּסִּים עַל־הַפֻּרְקָן</tei:l>
          <tei:l>עַל־הַגְּבוּרוֹת וְעַל־הַתְּשׁוּעוֹת</tei:l>
          <tei:l>שֶׁעָשִֽׂיתָ עִמָּהֶם</tei:l>
          <tei:l>כֵּן יְיָ אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ</tei:l>
          <tei:l>צֹאנָךְ בְּרַחֲמִים תִּפְקוֹד</tei:l>
          <tei:l>וּזְכׇר־לָֽנוּ אַהֲבַת הַקַּדְמוֹנִים</tei:l>
          <tei:l>שִׁבְטֵי יָהּ בְּגָלֻת הָחֵל הַזֶּה</tei:l>
          <tei:l>שֵֽׁבֶט יְהוּדָה בְּדֹֽחַק וּבְצַֽעַר</tei:l>
          <tei:l>וּכְשֵׁם שֶׁהוֹדוּ לַיְיָ</tei:l>
          <tei:l>חַסְדּוֹ בִּיצִיאַת מִצְרַֽיִם</tei:l>
          <tei:l>בִּזְכוּת יְהוּדָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_rosh_chodesh_nisan/7"/>
        <tei:lg>
          <tei:l>כֵּן נוֹדֶה לָךְ</tei:l>
          <tei:l>יְיָ אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ</tei:l>
          <tei:l>עַל־גְּאֻלָּתֵֽנוּ וְעַל־פְּדוּת נַפְשֵֽׁנוּ</tei:l>
          <tei:l>בִּזְכוּת יְהוּדָה מֶֽלֶךְ בְּאָחִיו</tei:l>
          <tei:l>וְלֹֽא־יָס֥וּר שֵׁ֙בֶט֙ מִֽיהוּדָ֔ה</tei:l>
          <tei:l>וּמְחֹקֵ֖ק מִבֵּ֣ין רַגְלָ֑יו</tei:l>
          <tei:l>וְזַ֭רְעוֹ לְעוֹלָ֣ם יִהְיֶ֑ה</tei:l>
          <tei:l>וְכִסְא֖וֹ כַשֶּׁ֣מֶשׁ נֶגְדָּךְ</tei:l>
          <tei:l>מֶ֥לֶךְ בְּיׇפְי֖וֹ תֶּחֱזֶ֣ינָה עֵינֵֽינוּ</tei:l>
          <tei:l>וְיִשְׂמַח לִבֵּֽנוּ</tei:l>
          <tei:l>וְתִמְלֹךְ אַתָּה הוּא יְיָ אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מְהֵרָה עַל־כׇּל־מַעֲשֶֽׂיךָ</tei:l>
          <tei:l>בְּהַר צִיּוֹן מִשְׁכַּן כְּבוֹדָךְ</tei:l>
          <tei:l>וּבִירוּשָׁלִַֽם עִיר מִקְדָּשָׁךְ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_rosh_chodesh_nisan/8"/>
        <tei:lg>
          <tei:l>כַּכָּתוּב בְּדִבְרֵי קׇדְשָׁךְ</tei:l>
          <tei:l>יִמְלֹ֤ךְ יְהֹוָ֨ה ׀ לְעוֹלָ֗ם</tei:l>
          <tei:l>אֱלֹהַ֣יִךְ צִ֭יּוֹן לְדֹ֥ר וָדֹ֗ר</tei:l>
          <tei:l>הַֽלְלוּ־יָֽהּ׃ <tei:bibl>(תהלים קמו:י)</tei:bibl></tei:l>
          <tei:l>וְנֶאֱמַר כִּ֣י לַ֭יהֹוָה הַמְּלוּכָ֑ה</tei:l>
          <tei:l>וּ֝מֹשֵׁ֗ל בַּגּוֹיִֽם׃ <tei:bibl>(תהלים כב:כט)</tei:bibl></tei:l>
          <tei:l>וְהָיָ֧ה יְהֹוָ֛ה לְמֶ֖לֶךְ עַל־כׇּל־הָאָ֑רֶץ</tei:l>
          <tei:l>בַּיּ֣וֹם הַה֗וּא יִהְיֶ֧ה יְהֹוָ֛ה אֶחָ֖ד</tei:l>
          <tei:l>וּשְׁמ֥וֹ אֶחָֽד׃ <tei:bibl>(זכריה יד:ט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_rosh_chodesh_nisan/9"/>
        <tei:lg>
          <tei:l>יִ֥הְיֽוּ־לְרָצ֨וֹן ׀ אִמְרֵי־פִ֡י</tei:l>
          <tei:l>וְהֶגְי֣וֹן לִבִּ֣י</tei:l>
          <tei:l>לְפָנֶ֑יךָ</tei:l>
          <tei:l>יְ֝הֹוָ֗ה צוּרִ֥י וְגֹאֲלִֽי׃</tei:l>
          <tei:l>שַׁׄוְעָתֵֽנוּ קַׄבֵּל</tei:l>
          <tei:l>וּׄשְׁמַע צַׄעֲקָתֵֽנוּ</tei:l>
          <tei:l>יׄוֹדֵֽעַ תַּׄעֲלוּמוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_rosh_chodesh_nisan/10"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ואחר כך יאמר תפלה זו בכל יום</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">לעילוי הנשמות</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_rosh_chodesh_nisan/11"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן מִלְּפָנֶֽיךָ</tei:l>
          <tei:l>ה׳ אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ</tei:l>
          <tei:l>שֶׁתָּאִיר הַיּוֹם בְּחַסְדָּךְ הַגָּדוֹל</tei:l>
          <tei:l>עַל־הַנְּשָׁמוֹת הַקְּדוֹשׁוֹת הָעוֹמְדוֹת בִּשְׁלֹשָׁה שׁוּרוֹת שֶׁבְּעֵֽדֶן</tei:l>
          <tei:l>הַמְּצַפְצְפִין בְּקוֹלָן כְּצִפּוֹרִים</tei:l>
          <tei:l>וְכׇל־נִשְׁמָתָם תְּהַלֵּל־יָהּ</tei:l>
          <tei:l>לְשַׁבֵּֽחַ וּלְפָאֵר אֶת־הוֹד שְׁמָךְ מַלְכֵּֽנוּ</tei:l>
          <tei:l>וּמַעֲתִירִים עֲתִרַת הַחַיִּים וְהַשָּׁלוֹם עָלֵֽינוּ</tei:l>
          <tei:l>בְּנֵי יְדִידֶֽיךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_rosh_chodesh_nisan/12"/>
        <tei:lg>
          <tei:l>אָנָּא בְּכֹֽחַ גְּדֻלַּת רַחֲמֶֽיךָ</tei:l>
          <tei:l>תִּהְיֶ֣ינָה אׇ֭זְנֶיךָ קַשֻּׁב֑וֹת אֲלֵיהֶם</tei:l>
          <tei:l>וּתְפִלָּתָם שְׁעֵה בְּרַחֲמִים</tei:l>
          <tei:l>לְבַטֵּל מֵעָלֵֽינוּ</tei:l>
          <tei:l>וּמֵעַל־כׇּל־בֵּית יִשְׂרָאֵל</tei:l>
          <tei:l>כׇּל־חֲרוֹן אַף</tei:l>
          <tei:l>וְכׇל־מִינֵי מַשְׁחִית</tei:l>
          <tei:l>וְכׇל־מִינֵי פּוּרְעָנוּת</tei:l>
          <tei:l>וְתַאֲרִיךְ יָמֵֽינוּ בְּטוֹב</tei:l>
          <tei:l>וּשְׁנוֹתֵֽינוּ בַּנְּעִימִים</tei:l>
          <tei:l>חַיִּים שֶׁל־שַׁלְוָה</tei:l>
          <tei:l>חַיִּים שֶׁל־טוֹבָה</tei:l>
          <tei:l>חַיִּים שֶׁל־בְּרָכָה</tei:l>
          <tei:l>חַיִּים שֶׁל־פַּרְנָסָה</tei:l>
          <tei:l>חַיִּים שֶׁל־חִלּוּץ עֲצָמוֹת</tei:l>
          <tei:l>חַיִּים שֶׁיֵּשׁ־בָּהֶם יִרְאַת חֵטְא</tei:l>
          <tei:l>חַיִּים שֶׁאֵין־בָּהֶם בּוּשָׁה וּכְלִמָּה</tei:l>
          <tei:l>חַיִּים שֶׁל־עֹֽשֶׁר וְכָבוֹד לַעֲבוֹדָתָךְ</tei:l>
          <tei:l>חַיִּים שֶׁתְּהֵא־בָּֽנוּ אַהֲבַת תּוֹרָה לִשְׁמָהּ</tei:l>
          <tei:l>חַיִּים שֶׁתִּמָּלֵא מִשְׁאֲלוֹת לִבֵּֽנוּ לְטוֹבָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_rosh_chodesh_nisan/13"/>
        <tei:lg>
          <tei:l>וִיהִי־נָא חַסְדָּךְ עַל־הַנְּשָׁמוֹת הַקְּדוֹשׁוֹת הָאֵֽלֶּה</tei:l>
          <tei:l>וְיַעֲלֶה</tei:l>
          <tei:l>וְיָבֹא יַגִּֽיעַ</tei:l>
          <tei:l>יֵרָאֶה וְיֵרָצֶה</tei:l>
          <tei:l>יִשָּׁמַע יִפָּקֵד</tei:l>
          <tei:l>וְיִזָּכֵר זִכְרוֹנָן הַטּוֹב</tei:l>
          <tei:l>לִפְנֵי כִּסֵּא כְּבוֹדָךְ</tei:l>
          <tei:l>וּמְצָאָן מְנוּחָה</tei:l>
          <tei:l>וְתִצְרֹר נִשְׁמָתָם לִפְנַי וְלִפְנִים</tei:l>
          <tei:l>אֶל־מְקוֹם הַקֹּֽדֶשׁ</tei:l>
          <tei:l>עַ֣יִן לֹֽא־רָאָ֗תָה אֱלֹהִים֙ זוּלָ֣תְךָ֔</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_rosh_chodesh_nisan/14"/>
        <tei:lg>
          <tei:l>וְתַשְׁבִּֽיעַ בְּצֶאֱצָאוֹת נַפְשׁוֹתָם</tei:l>
          <tei:l>יִ֭רְוְיֻן מִדֶּ֣שֶׁן בֵּיתֶ֑ךָ</tei:l>
          <tei:l>וְנַ֖חַל עֲדָנֶ֣יךָ תַשְׁקֵֽם</tei:l>
          <tei:l>וְשִׂים חֶלְקֵֽנוּ עִמָּהֶם</tei:l>
          <tei:l>וְנִזְכֶּה וְנִחְיֶה</tei:l>
          <tei:l>וְנִירַשׁ טוֹבָה וּבְרָכָה</tei:l>
          <tei:l>לְחַיֵּי הָעוֹלָם הַבָּא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_rosh_chodesh_nisan/15"/>
        <tei:lg>
          <tei:l>וְאוֹתָם הַנְּשָׁמוֹת</tei:l>
          <tei:l>הַנִּדָּחוֹת וְהַפּוֹרְחוֹת כַּאֲוִיר הָעוֹלָם</tei:l>
          <tei:l>וְאוֹתָם שֶׁמֵּֽתוּ קֹֽדֶם זְמַנָּם</tei:l>
          <tei:l>וְנִמְסְרוּ לְדוּמָה</tei:l>
          <tei:l>וְאוֹתָם הַטְּמוּנִים בָּאָֽרֶץ</tei:l>
          <tei:l>וְיָצִ֥יצוּ מֵ֝עִ֗יר</tei:l>
          <tei:l>כְּעֵ֣שֶׂב הָאָֽרֶץ</tei:l>
          <tei:l>שֶׁלֹּא־עָצְרוּ כֹּֽחַ עֲדַֽיִן</tei:l>
          <tei:l>לָבֹא אֶל־מְנוּחָתָם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_rosh_chodesh_nisan/16"/>
        <tei:lg>
          <tei:l>אַתָּה הָאֵל</tei:l>
          <tei:l>הַמֵּאִיר לָאָֽרֶץ</tei:l>
          <tei:l>וְלַדָּרִים עָלֶֽיהָ</tei:l>
          <tei:l>בְּרַחֲמִים</tei:l>
          <tei:l>הָאֵר פָּנֶֽיךָ</tei:l>
          <tei:l>וּתְכַסֶּה עַל־עֲוֺנָם וּפְשָׁעָם</tei:l>
          <tei:l>וְתֹאמֵר לַמַּלְאָךְ הַמְמֻנֶּה עֲלֵיהֶם</tei:l>
          <tei:l>לְהָקֵל מֵעֲלֵיהֶם</tei:l>
          <tei:l>מִשְׁפָּטָם וְדִינָם</tei:l>
          <tei:l>וְעֹל סׇבְלָם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_rosh_chodesh_nisan/17"/>
        <tei:lg>
          <tei:l>יִתֵּ֤ן יְהֹוָה֙ לָכֶ֔ם</tei:l>
          <tei:l>וּמְצֶ֣אןָ מְנוּחָ֔ה</tei:l>
          <tei:l>נְכוֹנָה אִ֧ישׁ עַֽל־מַחֲנֵ֛הוּ</tei:l>
          <tei:l>בִּמְנוּחַת שָׁלוֹם</tei:l>
          <tei:l>הַשְׁקֵ֥ט וָבֶ֖טַח</tei:l>
          <tei:l>עַד־עוֹלָֽם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_rosh_chodesh_nisan/18"/>
        <tei:lg>
          <tei:l>וּבְצֵל שַׁדַּי</tei:l>
          <tei:l>יִתְלוֹנְנוּ תַּֽחַת כַּנְפֵי הַכְּרוּבִים</tei:l>
          <tei:l>מִמַּדְרֵגָה לְמַדְרֵגָה</tei:l>
          <tei:l>וּמִמַּעֲלֶה לְמַעֲלֶה</tei:l>
          <tei:l>יָקִֽימוּ וְיַעֲלוּ</tei:l>
          <tei:l>וַאֲשֶׁר אֵין־לוֹ זָכִיּוֹת לַעֲלוֹת</tei:l>
          <tei:l>עֲשֵׂה עִמּוֹ חֶֽסֶד וּמַתְּנַת חִנָּם</tei:l>
          <tei:l>כְּמוֹ שֶׁנֶּאֱמַר</tei:l>
          <tei:l>וַיֹּ֗אמֶר אֲנִ֨י אַעֲבִ֤יר כׇּל־טוּבִי֙ עַל־פָּנֶ֔יךָ</tei:l>
          <tei:l>וְקָרָ֧אתִֽי בְשֵׁ֛ם יְהֹוָ֖ה לְפָנֶ֑יךָ</tei:l>
          <tei:l>וְחַנֹּתִי֙ אֶת־אֲשֶׁ֣ר אָחֹ֔ן</tei:l>
          <tei:l>וְרִחַמְתִּ֖י אֶת־אֲשֶׁ֥ר אֲרַחֵֽם׃ <tei:bibl>(דברים לג:יט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_rosh_chodesh_nisan/19"/>
        <tei:lg>
          <tei:l>יִ֥הְיֽוּ־לְרָצ֨וֹן ׀ אִמְרֵי־פִ֡י</tei:l>
          <tei:l>וְהֶגְי֣וֹן לִבִּ֣י</tei:l>
          <tei:l>לְפָנֶ֑יךָ</tei:l>
          <tei:l>יְ֝הֹוָ֗ה צוּרִ֥י וְגֹאֲלִֽי׃ <tei:bibl>(תהלים יט:טו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_rosh_chodesh_nisan/20"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ואחר כך יאמרו קדוש.</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_rosh_chodesh_nisan/21"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">עוד מבואר שם שיש לקרות ביום ר״ח ניסן</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">אחר קריאת הנשיא</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">שמונה פרשיות שנאמרו ביום ר״ח ניסן</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">ואלו הן׃</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_rosh_chodesh_nisan/22"/>
        <tei:lg>
          <tei:l>ויקרא כא:א–טו</tei:l>
          <tei:l>במדבר ח:ה–ט:יד</tei:l>
          <tei:l>במדבר ה:א–ד</tei:l>
          <tei:l>ויקרא טז:א–לד</tei:l>
          <tei:l>ויקרא י:ח–יא</tei:l>
          <tei:l>במדבר ח:א–ד</tei:l>
          <tei:l>במדבר יט:א–כב</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_rosh_chodesh_nisan/23"/>
        <tei:lg>
          <tei:l>בָּר֖וּךְ יְהֹוָ֥ה לְעוֹלָ֗ם</tei:l>
          <tei:l>אָ֘מֵ֥ן ׀ וְאָמֵֽן׃ <tei:bibl>(תהלים פט:נג)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
