  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:tefillat_hageschem_bar_ami">
        <tei:head>Tefilat haGeschem (Gebet um Regen)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tefillat_hageschem_bar_ami/1"/>
        <tei:lg>
          <tei:l><j:divineName>Wellspring of Living Water</j:divineName>,</tei:l>
          <tei:l>Remember Sarah,</tei:l>
          <tei:l>who laughed with joy at the promise of a child,</tei:l>
          <tei:l>like the rain that brings life to the earth.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tefillat_hageschem_bar_ami/2"/>
        <tei:lg>
          <tei:l>Remember Abraham,</tei:l>
          <tei:l>who journeyed through parched lands,</tei:l>
          <tei:l>seeking your presence</tei:l>
          <tei:l>and finding wellsprings of hope.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tefillat_hageschem_bar_ami/3"/>
        <tei:lg>
          <tei:l>Remember Rebecca,</tei:l>
          <tei:l>who drew water for a stranger and his camels,</tei:l>
          <tei:l>an act of kindness that flowed like a refreshing stream.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tefillat_hageschem_bar_ami/4"/>
        <tei:lg>
          <tei:l>Remember Isaac,</tei:l>
          <tei:l>who meditated in the fields,</tei:l>
          <tei:l>seeking solace and connection with the Divine,</tei:l>
          <tei:l>like water quenching his soul.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tefillat_hageschem_bar_ami/5"/>
        <tei:lg>
          <tei:l>Remember Rachel,</tei:l>
          <tei:l>whose tears watered the earth,</tei:l>
          <tei:l>as she prayed for her children to return.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tefillat_hageschem_bar_ami/6"/>
        <tei:lg>
          <tei:l>Remember Leah’s faith and determination</tei:l>
          <tei:l>flowing like a steady stream,</tei:l>
          <tei:l>just as water sustains the earth.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tefillat_hageschem_bar_ami/7"/>
        <tei:lg>
          <tei:l>Remember Jacob,</tei:l>
          <tei:l>who dreamt of a ladder to the heavens,</tei:l>
          <tei:l>where angels ascended and descended like raindrops.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tefillat_hageschem_bar_ami/8"/>
        <tei:lg>
          <tei:l>Remember Moses,</tei:l>
          <tei:l>who was drawn from the waters of the Nile,</tei:l>
          <tei:l>a leader who brought your message like rain to the parched.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tefillat_hageschem_bar_ami/9"/>
        <tei:lg>
          <tei:l>Remember Miriam,</tei:l>
          <tei:l>who danced with joy by the sea,</tei:l>
          <tei:l>as the waters of the Red Sea parted in awe.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tefillat_hageschem_bar_ami/10"/>
        <tei:lg>
          <tei:l>Remember Aaron, the High Priest,</tei:l>
          <tei:l>who purified himself with water,</tei:l>
          <tei:l>and sprinkled it on the people for their atonement.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tefillat_hageschem_bar_ami/11"/>
        <tei:lg>
          <tei:l>Remember Joseph,</tei:l>
          <tei:l>who emerged from the depths of a well,</tei:l>
          <tei:l>to rise to greatness and save a people.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tefillat_hageschem_bar_ami/12"/>
        <tei:lg>
          <tei:l>Remember the Children of Israel</tei:l>
          <tei:l>whom You led through the divided waters,</tei:l>
          <tei:l>a nation born in the waters of the Red Sea.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tefillat_hageschem_bar_ami/13"/>
        <tei:lg>
          <tei:l>For our sake,</tei:l>
          <tei:l>for the sake of our ancestors,</tei:l>
          <tei:l>We implore You,</tei:l>
          <tei:l>do not withhold the gift of rain.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tefillat_hageschem_bar_ami/14"/>
        <tei:lg>
          <tei:l>You are <j:divineName>Adonai</j:divineName>, <j:divineName>our God</j:divineName>,</tei:l>
          <tei:l>You cause the wind to blow and the rain to fall.</tei:l>
          <tei:l>For blessing and not for curse.</tei:l>
          <tei:l>For life and not for death.</tei:l>
          <tei:l>For plenty and not for lack.</tei:l>
          <tei:l>Together, let us say: <tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
