  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:graduation_blessing_duhan_kaplan">
        <tei:head>Graduation Blessing, by Rabbi Dr. Laura Duhan-Kaplan (2017)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:graduation_blessing_duhan_kaplan/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">To graduates:</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:graduation_blessing_duhan_kaplan/2"/>
        <tei:lg>
          <tei:l>Two words in Hebrew:</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>“Go forth and learn!”</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:graduation_blessing_duhan_kaplan/3"/>
        <tei:lg>
          <tei:l>And two words in Aramaic:</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>“Come in and discern!” —</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>
            <tei:hi rend="italic">In all your comings</tei:hi>
          </tei:l>
          <tei:l>
            <tei:hi rend="italic">and in all your goings</tei:hi>
          </tei:l>
          <tei:l>
            <tei:hi rend="italic">In all your learning</tei:hi>
          </tei:l>
          <tei:l>
            <tei:hi rend="italic">and in all your discerning</tei:hi>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:graduation_blessing_duhan_kaplan/4"/>
        <tei:lg>
          <tei:l>May the Holy One bless you</tei:l>
          <tei:l>and hold you precious <tei:bibl>(Numbers 6:24)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:graduation_blessing_duhan_kaplan/5"/>
        <tei:lg>
          <tei:l>May the Holy One’s presence shine through you</tei:l>
          <tei:l>and fill you with grace <tei:bibl>(Numbers 6:25)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:graduation_blessing_duhan_kaplan/6"/>
        <tei:lg>
          <tei:l>May the Holy One look towards you,</tei:l>
          <tei:l>and set you on a path of peace. <tei:bibl>(Numbers 6:26)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:graduation_blessing_duhan_kaplan/7"/>
        <tei:lg>
          <tei:l>
            <tei:hi rend="italic">Go, and be a blessing!</tei:hi>
          </tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
