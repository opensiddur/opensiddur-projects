    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:mi_yitneni_eved_eloah_oseni_yehudah">
        <tei:head>מִי יִתְּנֵנִי עֶבֶד אֱלוֹהַּ עוֹשֵׂנִי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_yitneni_eved_eloah_oseni_yehudah/1"/>
        <tei:lg>
          <tei:l>מִי יִתְּנֵנִי</tei:l>
          <tei:l>עֶבֶד</tei:l>
          <tei:l>אֱלוֹהַּ עוֹשֵׂנִי,</tei:l>
          <tei:l>וִירַחֲקֵנִי</tei:l>
          <tei:l>כָל־דּוֹד</tei:l>
          <tei:l>וְהוּא יַקְרִיבֵנִי!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_yitneni_eved_eloah_oseni_yehudah/2"/>
        <tei:lg>
          <tei:l>יוֹצְרִי וְרוֹעִי,</tei:l>
          <tei:l>נַפְשִׁי וְגֵוִי קָנִיתָ,</tei:l>
          <tei:l>בַּנְתַּ לְרֵעִי וּמַחְשְׁבוֹתַי רָאִיתָ,</tei:l>
          <tei:l>אָרְחִי וְרִבְעִי וְכָל־דְּרָכַי זֵרִיתָ.</tei:l>
          <tei:l>אִם תַּעְזְרֵנִי — מִי זֶה אֲשֶר יַכְשִׁילֵנִי!</tei:l>
          <tei:l>אוֹ תַּעְצְרֵנִי — מִי בִּלְתְךָ יַתִּירֵנִי?</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>מִי יִתְּנֵנִי עֶבֶד אֱלוֹהַּ עוֹשֵׂנִי...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_yitneni_eved_eloah_oseni_yehudah/3"/>
        <tei:lg>
          <tei:l>הָמוּ קְרָבַי</tei:l>
          <tei:l>לִהְיוֹת קְרוֹבִים אֵלֶיךָ,</tei:l>
          <tei:l>אוּלָם עֲצָבַי יְרַחֲקוּם מֵעָלֶיךָ,</tei:l>
          <tei:l>יַטּוּ נְתִיבַי מֵעַל נְתִיב מַעְגָּלֶיךָ,</tei:l>
          <tei:l>יָהּ, לַמְּדֵנִי בַּאְמִתְּךָ הַדְרִיכֵנִי,</tei:l>
          <tei:l>וּלְאַט נְחַנִי בַדִּין, וְאַל תַּרְשִׁיעֵנִי!</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>מִי יִתְּנֵנִי עֶבֶד אֱלוֹהַּ עוֹשֵׂנִי...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_yitneni_eved_eloah_oseni_yehudah/4"/>
        <tei:lg>
          <tei:l>וַאְנִי בְּעֶדְנָה</tei:l>
          <tei:l>לַעְשׂוֹת רְצוֹנְךָ מִתְרַפֶּה.</tei:l>
          <tei:l>אַף כִּי בְזִקְנָה — מַה זֶה אֲיַחֵל וַאְצַפֶּה?</tei:l>
          <tei:l>אֵל, נָא רְפָא נָא, כּיִ עמְּךָ אֵל הַמַּרְפֵּא.</tei:l>
          <tei:l>יוֹם תִתְּשֵׁנִי זִקְנָה, וְכֹחִי יִנְשַׁנִי,</tei:l>
          <tei:l>אַל תִּטְּשֵנִי, צוּרִי, וְאַל תַּעַזְבֵנִי!</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>מִי יִתְּנֵנִי עֶבֶד אֱלוֹהַּ עוֹשֵׂנִי...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_yitneni_eved_eloah_oseni_yehudah/5"/>
        <tei:lg>
          <tei:l>דַּכָּא וְאֻמְלָל</tei:l>
          <tei:l>אֵשֵׁב, וְחָרֵד לִרְגָעָי,</tei:l>
          <tei:l>עָרוֹם וְשׁוֹלָל אֵלֵךְ בְּהֵבְלֵי תַעְתּוּעָי,</tei:l>
          <tei:l>וַאְנִי מְחֹלָל מֵרֹב חֲטָאַי וּפְשָׁעָי,</tei:l>
          <tei:l>בֵּינְךָ וּבֵינִי עָוֹן אֲשׁר יַבְדִּיֵלִני,</tei:l>
          <tei:l>וַיַחְשְׂכֵנִי לִראוֹת בְאוֹרֶךָ עֵינִי!</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>מִי יִתְּנֵנִי עֶבֶד אֱלוֹהַּ עוֹשֵׂנִי...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_yitneni_eved_eloah_oseni_yehudah/6"/>
        <tei:lg>
          <tei:l>הַטֵּה לְבָבִי</tei:l>
          <tei:l>לַעְבֹד עֲבֹדַת מַלְכוּתְךָ,</tei:l>
          <tei:l>וּמַחֲשָׁבִי טַהֵר, לְדֵעָה אֱלֹהוּתְךָ,</tei:l>
          <tei:l>וּבְעֵת כְּאֵבִי אַל נָא תְאַחֵר רִפְאוּתְךָ.</tei:l>
          <tei:l>אֵלִי עֲנֵנִי, אַל תֶּחֱשֶׁה וּתְעַנֵּנִי,</tei:l>
          <tei:l>שֵנִית קְנֵנִי וֶאְמֹר לְעַבְדֶּךְ: הִנֵּנִי!</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>מִי יִתְּנֵנִי עֶבֶד אֱלוֹהַּ עוֹשֵׂנִי...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
