  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ki_yasis_mayer">
        <tei:head>כִּי יָשִׂישׂ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ki_yasis_mayer/1"/>
        <tei:lg>
          <tei:l><tei:seg type="quotation">כִּ֛י</tei:seg> <tei:seg type="acrostic">יָ</tei:seg>שִׂישׂ עָלָי כְּחָתָן הַמָּקוֹם</tei:l>
          <tei:l><tei:seg type="quotation">וַתִּשָּׂאֵ֣נִי</tei:seg> <tei:seg type="acrostic">צׇ</tei:seg>הֳלָתִי לְמָקוֹם <tei:seg type="quotation">קָדוֹשׁ</tei:seg>׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ki_yasis_mayer/2"/>
        <tei:lg>
          <tei:l><tei:seg type="quotation">נַ֥עַר</tei:seg> <tei:seg type="acrostic">ח</tei:seg>מוּד וְנַעֲרַת תִּפְאֶֽרֶת</tei:l>
          <tei:l><tei:seg type="quotation">ר֔וּחַ</tei:seg> <tei:seg type="acrostic">קְ</tei:seg>דוֹשָׁה אוֹמֶֽרֶת <tei:seg type="quotation">בָּרוּךְ</tei:seg>׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ki_yasis_mayer/3"/>
        <tei:lg>
          <tei:l><tei:seg type="quotation">יִשְׂרָאֵ֖ל</tei:seg> <tei:seg type="acrostic">ה</tei:seg>וּא עַם מְשׁוֹרְרִים</tei:l>
          <tei:l><tei:seg type="quotation">וָאֶשְׁמַ֣ע</tei:seg> <tei:seg type="acrostic">רַ</tei:seg>בְרְבֵי מַֽעַל מְזַמְּרִים <tei:seg type="quotation">קָדוֹשׁ</tei:seg>׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ki_yasis_mayer/4"/>
        <tei:lg>
          <tei:l><tei:seg type="quotation">וָאֹהֲבֵ֑הוּ</tei:seg> <tei:seg type="acrostic">אַ</tei:seg>ף־עַל־פִּי כׇּל־צַֽעַר</tei:l>
          <tei:l><tei:seg type="quotation">אַחֲרַ֔י</tei:seg> <tei:seg type="acrostic">לִ</tei:seg>פְתֹּֽחַ אֶת־הַשַּֽׁעַר <tei:seg type="quotation">בָּרוּךְ</tei:seg>׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ki_yasis_mayer/5"/>
        <tei:lg>
          <tei:l><tei:seg type="quotation">וּמִמִּצְרַ֖יִם</tei:seg> <tei:seg type="acrostic">חֻ</tei:seg>זַּק הָרַֽעַם</tei:l>
          <tei:l><tei:seg type="quotation">ק֖וֹל</tei:seg> <tei:seg type="acrostic">זִ</tei:seg>קְנֵי עַם <tei:seg type="quotation">קָדוֹשׁ</tei:seg>׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ki_yasis_mayer/6"/>
        <tei:lg>
          <tei:l><tei:seg type="quotation">קָרָ֥אתִי</tei:seg> <tei:seg type="acrostic">קְ</tei:seg>רָא זֶה אֶל־זֶה</tei:l>
          <tei:l><tei:seg type="quotation">רַ֣עַשׁ</tei:seg> <tei:seg type="acrostic">אֵ</tei:seg>ל רָאָה חוֹזֶה <tei:seg type="quotation">בָּרוּךְ</tei:seg>׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ki_yasis_mayer/7"/>
        <tei:lg>
          <tei:l><tei:seg type="quotation">לִבְנִֽי</tei:seg> <tei:seg type="acrostic">מְ</tei:seg>כֻנֶּה יְשֻׁרוּן</tei:l>
          <tei:l><tei:seg type="quotation">גָּד֑וֹל</tei:seg> <tei:seg type="acrostic">נָ</tei:seg>שִֽׁירָה לוֹ מוּל יְשִׁירוּן <tei:seg type="quotation">קָדוֹשׁ</tei:seg> וּ<tei:seg type="quotation">בָרוּךְ</tei:seg>׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
