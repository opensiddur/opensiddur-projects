  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:an_alternative_opening_for_aleinu_seidenberg">
        <tei:head>עלינו</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:an_alternative_opening_for_aleinu_seidenberg/1"/>
        <tei:lg>
          <tei:l>עָלֵינוּ לְשַׁבֵּֽחַ לַאֲדוֹן הַכֹּל</tei:l>
          <tei:l>לָתֵת גְּדֻלָּה לְיוֹצֵר בְּרֵאשִׁית,‏</tei:l>
          <tei:l>שֶׁהוּא עָשָׂה גוֹיִם רַבִּים</tei:l>
          <tei:l>וְכוּלָם חֲפֵצִים</tei:l>
          <tei:l>לְהַבְחִין בִּדְרָכָיו,‏</tei:l>
          <tei:l>וְנָתַן לָנוּ גּוֹרָל מְיוּחָד</tei:l>
          <tei:l>שֶׁגִלָּה לָנוּ אֶת מִשְׁפָּטָיו׃</tei:l>
          <tei:l>וַאַנָחְנוּ כּוֹרְעִים...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
