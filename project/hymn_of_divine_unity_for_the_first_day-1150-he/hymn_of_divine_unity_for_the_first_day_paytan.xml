    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan">
        <tei:head>שִׁיר הַיִּחוּד לְיוֹם רִאשׁוֹן</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/1"/>
        <tei:lg>
          <tei:l>אָשִׁירָה וַאֲזַמְרָה לֵאלֹהֵי בְּעוֹדִי</tei:l>
          <tei:l>הָאֱלֹהִים הָרוֹעֶה אוֹתִי מֵעוֹדִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/2"/>
        <tei:lg>
          <tei:l>עַד הַיוֹם הַזֶּה הֶחֱזַקְתָּ בְּיָדִי</tei:l>
          <tei:l>חַיִּים וָחֶסֶד עָשִׂיתַ עִמָּדִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/3"/>
        <tei:lg>
          <tei:l>בָּרוּךְ יְיָ וּבָרוּךְ שֵׁם כְּבוֹדוֹ</tei:l>
          <tei:l>כִּי עַל עַבְדּוֹ הִפְלִיא חַסְדּוֹ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/4"/>
        <tei:lg>
          <tei:l>אֱלֹהֵי מָרוֹם בַּמָּה אֲקַדֵּם</tei:l>
          <tei:l>וּבַמָּה אִכַּף לֵאלֹהֵי קֶדֶם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/5"/>
        <tei:lg>
          <tei:l>אִלּוּ הָרִים הֵם לְמַעֲרָכָה</tei:l>
          <tei:l>וְכׇל עֲצֵי לְבָנוֹן בַּכַֹל עֲרוּכָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/6"/>
        <tei:lg>
          <tei:l>וְאִם כׇּל בְּהֵמוֹת וְחַיּוֹת קְרוּצִים</tei:l>
          <tei:l>נְתָחִים עֲרוּכִים עַל הָעֵצִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/7"/>
        <tei:lg>
          <tei:l>וְאַף זָוִיּוֹת מִזְבֵּחַ מְבוּסִים</tei:l>
          <tei:l>דָּם כַּמַּיִם לַיָּם מְכַסִּים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/8"/>
        <tei:lg>
          <tei:l>וְכַחוֹל סֹלֶת דָשֵׁן וְשָׁמֵן</tei:l>
          <tei:l>בָּלוּל בְּרִבֲבוֹת נַחֲלֵי שָׁמֶן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/9"/>
        <tei:lg>
          <tei:l>וּלְאַזְכָּרָה לְבוֹנָה וְסַמִּים</tei:l>
          <tei:l>וְלִקְטֹרֶת כׇּל רָאֹשֵׁי בְשָׂמִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/10"/>
        <tei:lg>
          <tei:l>וְאִלּוּ נֵרוֹת עַל הַמְּנוֹרוֹת</tei:l>
          <tei:l>יִהְיוּ מְאִירוֹת כִּשְׁנֵי הַמְּאוֹרוֹת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/11"/>
        <tei:lg>
          <tei:l>וּכְהַרֲרֵי אֵל לֶחֶם הַפָּנִים</tei:l>
          <tei:l>עַל שֻׁלְחָנוֹת עֲרוּכִים בְּפָנִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/12"/>
        <tei:lg>
          <tei:l>וְיַיִן כְּמוֹ מְטַר הַשָּׁמַיִם</tei:l>
          <tei:l>וְשֵׁכָר לְנֶסֶךְ כְּעֵינוֹת מָיִם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/13"/>
        <tei:lg>
          <tei:l>וְאִלּוּ כׇּל בְּנֵי אָדָם כֹּהֲנִים</tei:l>
          <tei:l>לְוִיִּם מְשׁוֹרֲרִים בִּכְנַף רְנָנִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/14"/>
        <tei:lg>
          <tei:l>וְכׇל עֲצֵי עֵדֶן וְכׇל עֲצֵי יְעֲרִים</tei:l>
          <tei:l>לְכִנּוֹרוֹת וּנְבָלִים לְשִׁירִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/15"/>
        <tei:lg>
          <tei:l>וְכׇל בְּנֵי אֱלֹהִים בְּקוֹל תְּרוּעָתָם</tei:l>
          <tei:l>וְהַכּוֹכָבִים מִמְּסִלּוֹתָם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/16"/>
        <tei:lg>
          <tei:l>וְכׇל הַלְּבָנוֹן וְחַיָּה כֻּלָּהּ</tei:l>
          <tei:l>אֵין דֵּי בָעֵר וְאֵין דֵּי עוֹלָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/17"/>
        <tei:lg>
          <tei:l>הֵן בְּכׇל אֵלֶּה אֵין דֵּי לַעֲבוֹד</tei:l>
          <tei:l>וְאֵין דֵּי לְקַדֵּם לְמֶלֶךְ הַכָּבוֹד</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/18"/>
        <tei:lg>
          <tei:l>כִּי נִכְבַּדְתָּ מְאֹד מַלְכֵּנוּ</tei:l>
          <tei:l>וּבַמֶּה נִכַּף לַאֲדֹנֵנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/19"/>
        <tei:lg>
          <tei:l>אָמְנָם לֹא יוּכְלוּ כַבְּדֶךָ</tei:l>
          <tei:l>כׇּל חַי אַף כִּי אֲנִי עַבְדֶּךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/20"/>
        <tei:lg>
          <tei:l>וַאֲנִי נִבְזֶה וַחֲדַל אִישִׁים</tei:l>
          <tei:l>נִמְאָס בְּעֵינַי וּשְׁפַל אֲנָשִׁים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/21"/>
        <tei:lg>
          <tei:l>וְאֵין לְעַבְדְּךָ כֹּל לִכַבְּדֶךָ</tei:l>
          <tei:l>לְהָשִׁיב גְמוּל לְךָ עַל חֲסָדֶיךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/22"/>
        <tei:lg>
          <tei:l>כִּי הִרְבִּיתָ טוֹבוֹת אֵלָי</tei:l>
          <tei:l>כִּי הִגְדַּלְתָּ חַסְדְּךָ עָלָי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/23"/>
        <tei:lg>
          <tei:l>וְרַב שִׁלּוּמִים לְךָ חֻיַּבְתִּי</tei:l>
          <tei:l>כִּי עָשִׂיתָ טוֹבוֹת אִתִּי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/24"/>
        <tei:lg>
          <tei:l>וְלֹא חֻיַּבְתָּ לִּי גְּמוּלֶךָ</tei:l>
          <tei:l>כׇּל טוֹבָתִי בַּל עָלֶיךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/25"/>
        <tei:lg>
          <tei:l>עַל הַטּוֹבוֹת לֹא עֲבַדְתִּיךָ</tei:l>
          <tei:l>אַחַת לְרִבֹּא לֹא גְמַלְתִּיךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/26"/>
        <tei:lg>
          <tei:l>אִם אָמַרְתִּי אֲסַפְּרָה כְמוֹ</tei:l>
          <tei:l>לֹא יָדַעְתִּי סְפוֹרוֹת לָמוֹ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/27"/>
        <tei:lg>
          <tei:l>מָה אָשִׁיב לְךָ וְהַכֹּל שֶׁלָּךָ</tei:l>
          <tei:l>לְךָ שָׁמַיִם אַף אֶרֶץ לָךְ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/28"/>
        <tei:lg>
          <tei:l>יַמִּים וְכׇל אֲשֶׁר בָּם בְּיָדֶךָ</tei:l>
          <tei:l>וְכֻלָּם יִשְׂבְּעוּן מִיָּדֶךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/29"/>
        <tei:lg>
          <tei:l>וַאֲנַחְנוּ עַמְּךָ וְצֹאנֶךָ</tei:l>
          <tei:l>הַחֲפֵצִים לַעֲשׂוֹת רְצוֹנֶךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/30"/>
        <tei:lg>
          <tei:l>וְאֵיךְ נַעֲבֹד וְאֵין לְאֵל יָדֵנוּ</tei:l>
          <tei:l>וְלִשְׂרֵפַת אֵשׁ בֵּית מִקְדָּשֵׁנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/31"/>
        <tei:lg>
          <tei:l>וְאֵיךְ נַעֲבֹד וְאֵין זֶבַח וּמִנְחָה</tei:l>
          <tei:l>כִּי לֹא בָאנוּ אֶל הַמְּנוּחָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/32"/>
        <tei:lg>
          <tei:l>וּמַיִם אַיִן לְהַעֲבִיר טֻמְאָה</tei:l>
          <tei:l>וַאֲנַחְנוּ עַל אֲדָמָה טְמֵאָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/33"/>
        <tei:lg>
          <tei:l>שָׂשׂ אָנֹכִי עַל אֲמָרֶיךָ</tei:l>
          <tei:l>וְהִנֵּה בָאתִי בִּדְבָרֶיךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/34"/>
        <tei:lg>
          <tei:l>כִּי כָתוּב לֹא עַל זְבָחֶיךָ</tei:l>
          <tei:l>וְעוֹלֹתֶיךָ אוֹכִיחֶךָ <tei:bibl>(תהלים נ:ח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/35"/>
        <tei:lg>
          <tei:l>עַל דְּבַר זֶבַח וְעוֹלוֹתֵיכֶם</tei:l>
          <tei:l>לֹא צִוִּיתִי אֶת אֲבוֹתֵיכֶם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/36"/>
        <tei:lg>
          <tei:l>מַה שָּׁאַלְתִּי וּמַה דָּרַשְׁתִּי</tei:l>
          <tei:l>מִמְּךָ כִּי אִם לְיִרְאָה אוֹתִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/37"/>
        <tei:lg>
          <tei:l>לַעֲבוֹד בְּשִׂמְחָה וּבְלֵבָב טוֹב</tei:l>
          <tei:l>הִנֵּה שְׁמֹעַ מִזְּבַח טוֹב</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/38"/>
        <tei:lg>
          <tei:l>וְלֵב נִשְׁבָּר מִמִּנְחָה טְהוֹרָה</tei:l>
          <tei:l>זִבְחֵי אֱלֹהִים רוּחַ נִשְׁבָּרָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/39"/>
        <tei:lg>
          <tei:l>זֶבַח וּמִנְחָה לֹא חָפַצְתָּ</tei:l>
          <tei:l>חַטָּאת וְעוֹלָה לֹא שָׁאָלְתָּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/40"/>
        <tei:lg>
          <tei:l>מִזְבַּח אֲבָנִים בְּשָׂרִי וְלִבִּי</tei:l>
          <tei:l>וַאֲשַׁבְּרָה אֶת רוּחִי בְּקִרְבִּי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/41"/>
        <tei:lg>
          <tei:l>רוּם לֵב אַשְׁפִּיל וְאַף רוּם עֵינָי</tei:l>
          <tei:l>וְאֶקְרַע לְבָבִי לְמַעַן אֲדֹנָי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/42"/>
        <tei:lg>
          <tei:l>שִׁבְרֵי לִבִּי הֵם זְבָחֶיךָ</tei:l>
          <tei:l>יַעֲלוּ לְרָצוֹן עַל מִזְבְּחֶךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/43"/>
        <tei:lg>
          <tei:l>וְאַשְׁמִיעַ בְּקוֹל הֲוָיוֹתֶיךָ</tei:l>
          <tei:l>וַאֲסַפְּרָה כׇּל נִפְלְאוֹתֶיךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/44"/>
        <tei:lg>
          <tei:l>אֲשֶׁר יָדְעָה נַפְשִׁי אַחְבִּירָה</tei:l>
          <tei:l>אֲמַלֵּל גְּבוּרוֹת וַאֲדַבֵּרָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/45"/>
        <tei:lg>
          <tei:l>וּמָה אֶעֱרֹךְ וְלֹא יָדַעְתִּי מָה</tei:l>
          <tei:l>הֲיָכוֹל אוּכַל דַּבֵּר מְאוּמָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/46"/>
        <tei:lg>
          <tei:l>כִּי אֵין חֵקֶר לִגְדֻלָּתוֹ</tei:l>
          <tei:l>כִּי אֵין מִסְפָּר לִתְבוּנָתוֹ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/47"/>
        <tei:lg>
          <tei:l>חֲכַם לֵבָב מִי כָמוֹהוּ</tei:l>
          <tei:l>שַׂגִּיא כֹחַ לֹא מְצָאנוּהוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/48"/>
        <tei:lg>
          <tei:l>עוֹשֶׂה גְדוֹלוֹת וְרַב נוֹרָאוֹת</tei:l>
          <tei:l>גָּדוֹל אַתָּה וְעוֹשֵֹה נִפְלָאוֹת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/49"/>
        <tei:lg>
          <tei:l>עַד אֵין מִסְפָּר וְעַד אֵין חֵקֶר</tei:l>
          <tei:l>וְלֹא נוֹדַע כִּי לֹא יֵחָקֵר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/50"/>
        <tei:lg>
          <tei:l>אֵיזוֹ עַיִן אֲשֶׁר תְּעִידֶךָ</tei:l>
          <tei:l>וְאֵיזֶה פֶּה אֲשֶׁר יַגִּידֶךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/51"/>
        <tei:lg>
          <tei:l>חַי לֹא רַאֲךָ וְלֵב לֹא יְדָעֶךָ</tei:l>
          <tei:l>וְאֵיזֶה שֶׁבַח יַצִּיעֶךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/52"/>
        <tei:lg>
          <tei:l>גַּם מְשָׁרְתֶיךָ לֹא רָאוּךָ</tei:l>
          <tei:l>וְכׇל חַכְמֵי לֵב לֹא מְצָאוּךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/53"/>
        <tei:lg>
          <tei:l>אַתָּה לְבַדְּךָ מַכִּיר שִׁבְחֶךָ</tei:l>
          <tei:l>וְאֵין זוּלָתְךָ יוֹדֵעַ כֹּחֶךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/54"/>
        <tei:lg>
          <tei:l>וְאֵין יוֹדֵעַ בִּלְעָדֶיךָ</tei:l>
          <tei:l>שְׁבָחוֹת רְאוּיוֹת לִכְבוֹדֶךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/55"/>
        <tei:lg>
          <tei:l>עַל כֵּן תְּבֹרַךְ כָּרָאוּי לָךָ</tei:l>
          <tei:l>כְּפִי קָדְשָׁךְ כְּפִי כְּבוֹדָךְ וְגָדְלָךְ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/56"/>
        <tei:lg>
          <tei:l>וּמִפִּי הַכֹּל כְּכׇל אֱיָלוּתָם</tei:l>
          <tei:l>כְּפִי מַדָּע אֲשֶׁר אַתָּה חֲנַנְתָּם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/57"/>
        <tei:lg>
          <tei:l>יוֹדוּ פִלְאֲךָ הַשָׁמַיִם</tei:l>
          <tei:l>וִיאַדְּרוּךָ קוֹלוֹת מָיִם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/58"/>
        <tei:lg>
          <tei:l>וְיָרִיעוּ לְךָ כׇּל הָאָרֶץ</tei:l>
          <tei:l>יוֹדוּךָ כׇּל מַלְכֵי אָרֶץ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/59"/>
        <tei:lg>
          <tei:l>אַף יוֹדוּךָ כׇּל הָעַמׇּים</tei:l>
          <tei:l>וִישַׁבְּחוּךָ כׇּל הָאֻמִּים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/60"/>
        <tei:lg>
          <tei:l>כׇּל זֶרַע יַעֲקֹב עֲבָדֶיךָ</tei:l>
          <tei:l>כִּי עָלֵיהֶם גָּבְרוּ חֲסָדֶיךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_first_day_paytan/61"/>
        <tei:lg>
          <tei:l>אֶת שֵׁם יְיָ יְהַלְלוּ כֻלָּם</tei:l>
          <tei:l>אֵל אֱלֹהִים אֱמֶת וּמֶלֶךְ עוֹלָם׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
