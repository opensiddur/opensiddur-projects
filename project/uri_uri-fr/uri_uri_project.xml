  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:uri_uri_project">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:uri_uri_project/1"/>
        <tei:lg>
          <tei:l>Dresse-toi ô voyageuse en haute mer,</tei:l>
          <tei:l>Fille de Sion, et porte ta voix</tei:l>
          <tei:l>Tel un fleuve son cours –</tei:l>
          <tei:l>Tel que le firent Myriam et Déborah.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:uri_uri_project/2"/>
        <tei:lg>
          <tei:l>En ce jour où Dieu fît sombrer</tei:l>
          <tei:l>L’armée du Pharaon dans l’abime des mers,</tei:l>
          <tei:l>Jouez une louange au tambourin!</tei:l>
          <tei:l>Ainsi s’exclama Myriam</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Dresse-toi...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:uri_uri_project/3"/>
        <tei:lg>
          <tei:l>Je chante et célèbre</tei:l>
          <tei:l>La justice du Roi éternel;</tei:l>
          <tei:l>Il mit une fin à nos malfaiteurs!</tei:l>
          <tei:l>Ainsi chanta Déborah</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Dresse-toi...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:uri_uri_project/4"/>
        <tei:lg>
          <tei:l>Pour avoir fait traverser Son peuple</tei:l>
          <tei:l>Une mer sur la terre ferme,</tei:l>
          <tei:l>Entonnez un chant de reconnaissance!</tei:l>
          <tei:l>Ainsi s’exclama Myriam</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Dresse-toi...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:uri_uri_project/5"/>
        <tei:lg>
          <tei:l>Puisse Celui qui de Ses enfants protège les fruits</tei:l>
          <tei:l>Contre chaos et malheurs</tei:l>
          <tei:l>Hâtivement ramener leurs captifs –</tei:l>
          <tei:l>Ainsi chanta Déborah</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Dresse-toi...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
