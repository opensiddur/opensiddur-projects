      <tei:div corresp="urn:x-opensiddur:text:prayer:blessing_for_joy_a_poetic_rendering_of_sheva_brakhah_no_6_kieval">
        <tei:head>הברכה שמח תשמח</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_for_joy_a_poetic_rendering_of_sheva_brakhah_no_6_kieval/1"/>
        <tei:lg>
          <tei:l>שַׂמֵּֽחַ תְּשַׂמַּח רֵעִים הָאֲהוּבִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_for_joy_a_poetic_rendering_of_sheva_brakhah_no_6_kieval/2"/>
        <tei:lg>
          <tei:l>כְּשַׂמֵּחֲךָ יְצִירְךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_for_joy_a_poetic_rendering_of_sheva_brakhah_no_6_kieval/3"/>
        <tei:lg>
          <tei:l>בְּגַן עֵֽדֶן מִקֶּֽדֶם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_for_joy_a_poetic_rendering_of_sheva_brakhah_no_6_kieval/6"/>
        <tei:lg>
          <tei:l>‏בָּרוּךְ אַתָּה יְיָ מְשַׂמֵּֽחַ חָתָן וְכַלָּה׃‏</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
