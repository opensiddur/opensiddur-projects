    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_for_the_sick_citing_biblical_and_talmudic">
        <tei:head>מִי שֶׁבֵּירַךְ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_for_the_sick_citing_biblical_and_talmudic/1"/>
        <tei:lg>
          <tei:l>מִי שֶׁבֵּירַךְ אֲבוֹתֵֽינוּ</tei:l>
          <tei:l>אַבְרָהָם יִצְחָק וְיַעֲקֹב</tei:l>
          <tei:l>מֹשֶׁה וְאַהֲרֹן</tei:l>
          <tei:l>דָּוִד וּשְׁלֹמֹה</tei:l>
          <tei:l>וַחֲסִידִים הָרִאשׁוֹנִים</tei:l>
          <tei:l>וּמִי שֶׁהִמְתִּיק מֵי מָרָה</tei:l>
          <tei:l>עַל־יְדֵי מֹשֶׁה רַבֵּֽנוּ עָלָיו הַשָּׁלוֹם</tei:l>
          <tei:l>וְרַפֵּא מִרְיָם הַנְּבִיאָה מִצָּרַעְתָּהּ</tei:l>
          <tei:l>וְרַפֵּא מֵי יְרֵחוֹ עַל־יְדֵי אֱלִישָׁע</tei:l>
          <tei:l>וְרַפֵּא חִזְקִיָּֽהוּ מֶֽלֶךְ יְהוּדָה מֵחׇלְיוֹ</tei:l>
          <tei:l>וּבִנְיָמִין הַצַּדִּיק מֵחׇלְיוֹ</tei:l>
          <tei:l>הוּא יְבָרֵךְ וִירַפֵּא אֶת הַחוֹלֶה פב”פ</tei:l>
          <tei:l>בַּעֲבוּר שֶׁר’ פב”פ נוֹתֵן צְדָקָה בַּעֲדוֹ</tei:l>
          <tei:l>וְגַם קְהַל הַקָּדוֹשׁ נוֹתֵן צְדָקָה בַּעֲדוֹ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_for_the_sick_citing_biblical_and_talmudic/2"/>
        <tei:lg>
          <tei:l>בִּשְׂכַר זֶה הַמָּקוֹם בָּרוּךְ הוּא</tei:l>
          <tei:l>יִרְפָּאֵֽהוּ וִיחַזְּקֵֽהוּ</tei:l>
          <tei:l>וְיַבְרֵֽהוּ וִיחַיֵּֽהוּ</tei:l>
          <tei:l>וְיִבְרָאֵֽהוּ וְיַחֲלִימֵֽהוּ</tei:l>
          <tei:l>וְיַעֲמִידֵֽהוּ עַל־בֻּרְיוֹ</tei:l>
          <tei:l>וְיִשְׁלַח לוֹ רְפוּאָה שְׁלֵמָה</tei:l>
          <tei:l>לְכׇל־גּוּפוֹ</tei:l>
          <tei:l>וּלְכׇל־בְּשָׂרוֹ</tei:l>
          <tei:l>וּלְכׇל־אֵיבָרָיו</tei:l>
          <tei:l>וּבְתוֹךְ שְׁאָר חוֹלֵי יִשְׂרָאֵל</tei:l>
          <tei:l>הַשְׁתָּא בַּעֲגָלָה וּבִזְמַן קָרִיב</tei:l>
          <tei:l>וְנֹאמַר אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
