    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:tsoneh_eilim_kvasim_urchelim_mayer">
        <tei:head>צֹנֶה אֵילִים כְּבָשִׂים וּרְחֵלִים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tsoneh_eilim_kvasim_urchelim_mayer/1"/>
        <tei:lg>
          <tei:l>צֹנֶ֣ה <tei:seg type="acrostic">אֵ</tei:seg>ילִים כְּבָשִׂים וּרְחֵלִים</tei:l>
          <tei:l>וַאֲלָפִ֣ים <tei:seg type="acrostic">בָּ</tei:seg>קָר שׁוֹר פָּרוֹת וַעֲגָלִים</tei:l>
          <tei:l>כֻּלָּ֑ם <tei:seg type="acrostic">גּ</tei:seg>וֹעִים לְפָנֶיךָ לְהִנָּתֵן מַאֲכָלִים</tei:l>
          <tei:l>וְ֝גַ֗ם <tei:seg type="acrostic">דָּ</tei:seg>ג וְעוֹף שֶׁעַד־שָׁמַֽיִם עוֹלִים</tei:l>
          <tei:l>בַּהֲמ֥וֹת <tei:seg type="acrostic">הַ</tei:seg>רְרֵי־אֶֽלֶף יִקְרָא־לְךָ תְּהִלִּים</tei:l>
          <tei:l>שָׂדָֽי <tei:seg type="acrostic">וְ</tei:seg>כׇל־אֲשֶׁר־בּוֹ לְךָ יוֹדֶה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tsoneh_eilim_kvasim_urchelim_mayer/2"/>
        <tei:lg>
          <tei:l>חַיּוֹת הַקֹּֽדֶשׁ עִם־חַיּוֹת הַשָּׂדֶה׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>צִפּ֣וֹר <tei:seg type="acrostic">זִ</tei:seg>יז־שָׂדַי אַף־הוּא לֹא־יַעֲלֶה עַד</tei:l>
          <tei:l>שָׁ֭מַיִם <tei:seg type="acrostic">חַ</tei:seg>לּוֹנוֹת־אוֹר כִּי־כְּבוֹדְךָ לָעַד</tei:l>
          <tei:l>וּדְגֵ֣י <tei:seg type="acrostic">טֶֽ</tei:seg>בַע רוֹאִים כִּי חַסְדְּךָ יוּעַד</tei:l>
          <tei:l>הַיָּ֑ם <tei:seg type="acrostic">יִ</tei:seg>תְגַּעֵשׁ בְּקוֹלְךָ הַמַּרְעִיד רַֽעַד</tei:l>
          <tei:l>עֹ֝בֵ֗ר <tei:seg type="acrostic">כׇּ</tei:seg>ל־מַלְאָךְ אֲשֶׁר־לְשִׁירָה מוּעָד</tei:l>
          <tei:l>אׇרְח֥וֹת <tei:seg type="acrostic">לִ</tei:seg>כְתֹּת מִמָּקוֹר עַד־יַֽעַד</tei:l>
          <tei:l>יַמִּֽים <tei:seg type="acrostic">מְ</tei:seg>רוֹמוֹת וְתֵבֵל לִכְבוֹדְךָ כֹּל מוֹדֶה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tsoneh_eilim_kvasim_urchelim_mayer/3"/>
        <tei:lg>
          <tei:l>חַיּוֹת הַקֹּֽדֶשׁ עִם־חַיּוֹת הַשָּׂדֶה׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>יְהֹוָ֥ה <tei:seg type="acrostic">נ</tei:seg>וֹתֵן לְזֶה וְלָזֶה כְּנֶֽגֶד כׇּל־צְרָכָיו</tei:l>
          <tei:l>אֲדֹנֵ֑ינוּ <tei:seg type="acrostic">ס</tei:seg>וֹעֵד לַכֹּל לִיצוּרָיו וּלְמַלְאָכָיו</tei:l>
          <tei:l>מָה־<tei:seg type="acrostic">עָ</tei:seg>שִׁיר וּמָה־פּוֹרֶה עוֹלָמְךָ בְּמַעֲרָכָיו</tei:l>
          <tei:l>אַדִּ֥יר <tei:seg type="acrostic">פִּ</tei:seg>לְאִי הוּא מִי־מָדַד רְחָבָיו וּמִי אֳרָכָיו</tei:l>
          <tei:l>שִׁ֝מְךָ֗ <tei:seg type="acrostic">צ</tei:seg>וֹפֶה שֵׁם כׇּל־יְצוּר כָּתוּב בִּשְׁנֵי כְּרָכָיו</tei:l>
          <tei:l>בְּכׇל <tei:seg type="acrostic">קְ</tei:seg>הַל אִישׁ וּבְהֵמָה יִכְרְעוּ כׇּל־בִּרְכָּיו</tei:l>
          <tei:l>הָאָֽרֶץ <tei:seg type="acrostic">רֹ</tei:seg>אשׁ מְרִימָה כִּי יָהּ מִמַּאֲכֶלֶת פּוֹדֶה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tsoneh_eilim_kvasim_urchelim_mayer/4"/>
        <tei:lg>
          <tei:l>חַיּוֹת הַקֹּֽדֶשׁ עִם־חַיּוֹת הַשָּׂדֶה׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בָּר֥וּךְ <tei:seg type="acrostic">שֶׁ</tei:seg>נָּתַן לָהֶם אֶת־אׇכְלָם בְּעִתּוֹ בְּיָד רָמָה</tei:l>
          <tei:l>כְּבֹוד־<tei:seg type="acrostic">שְׁ</tei:seg>מוֹ כׇּל־עַֽיִן יִרְאֶה תִּשְׁתַּחֲוֶה כׇּל־קוֹמָה</tei:l>
          <tei:l>יְהוָ֖ה <tei:seg type="acrostic">תְּ</tei:seg>הַלֵּל כׇּל־חַיָּה אָדָם וּבְהֵמָה</tei:l>
          <tei:l>מִמְּקֹומֹֽו <tei:seg type="acrostic">תִּ</tei:seg>שָּׁמַע זִמְרָה וְאֶת־שְׁמוֹ תַּעֲדֶה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tsoneh_eilim_kvasim_urchelim_mayer/5"/>
        <tei:lg>
          <tei:l>חַיּוֹת הַקֹּֽדֶשׁ עִם־חַיּוֹת הַשָּׂדֶה׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְהַחַיּוֹת יְשׁוֹרֵֽרוּ</tei:l>
          <tei:l>וּכְרוּבִים יְפָאֵֽרוּ</tei:l>
          <tei:l>וּשְׂרָפִים יָרֹֽנּוּ</tei:l>
          <tei:l>וְאֶרְאֶלִּים יְבָרֵֽכוּ פְּנֵי כׇּל־חַיָּה</tei:l>
          <tei:l>וְאוֹפָן וּכְרוּב לְעֻמַּת שְׂרָפִים</tei:l>
          <tei:l>לְעֻמָּתָם מְשַׁבְּחִים וְאוֹמְרִים —</tei:l>
          <tei:l>בָּר֥וּךְ כְּבֹוד־יְהוָ֖ה</tei:l>
          <tei:l>מִמְּקֹומֹֽו <tei:bibl>(יחזקאל ג:יב)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
