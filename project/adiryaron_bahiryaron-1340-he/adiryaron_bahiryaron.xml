  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:adiryaron_bahiryaron">
        <tei:head>אַדִירְיַרוֹן בַהִירְיַרוֹן</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:adiryaron_bahiryaron/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אַ</tei:seg>דִירְיַרוֹן בַהִירְיָרוֹן גְבִירְיַרוֹן</tei:l>
          <tei:l>יִגְבָּהְיָה תְּלַמְיָה צְתַנְיָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:adiryaron_bahiryaron/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קְ</tei:seg>רַמְיָה רְגַרְיָה עַדִירְיָה</tei:l>
          <tei:l>שְׁגַנְיָה טְלַטְיָה נְהַרְיָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:adiryaron_bahiryaron/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נִ</tei:seg>שְׁמַרְיָה גְעַרְיָה דוֹהַרְיָה</tei:l>
          <tei:l>יְעַלְיָה כַסְיָה שִׁיגְיוֹנָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:adiryaron_bahiryaron/4"/>
        <tei:lg>
          <tei:l>(פ)בוֹעֶלְיָה טוֹרֶדְיָה רַמְיָא</tei:l>
          <tei:l>צַצְצִיָה (נְ)תְּהַבְהִיָה גַלְגַלְיָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:adiryaron_bahiryaron/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חַ</tei:seg>נַנְיָה קָתְקַיָה בְּהַוְ־הוֹוַיָה</tei:l>
          <tei:l>[טַוְטַהְיָה (עַ)נְגְנִיָה עַמְמָיָה]</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:adiryaron_bahiryaron/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יְ</tei:seg>דָל־שַׂרְיָה גוֹרְרְיַה לְמֵימַרְיָה</tei:l>
          <tei:l>פְּקוֹדְקַדְיָה זוֹהָר־זְהַרְיַה קַוֹוְלַיָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:adiryaron_bahiryaron/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שַׁ</tei:seg>תְהוֹדַרְיָה קְדוֹשְיָה וְהַאֵלְ־אִלְיָה</tei:l>
          <tei:l>צַעְדֵיָה יָהְ־הַרְיָה תַּמְתִילְיָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:adiryaron_bahiryaron/8"/>
        <tei:lg>
          <tei:l>והיה ניהויה חוֹנַנְיָה קַתְקַיָה וְהָאֵל־אִלְיָה וָיְהוַה יה׃</tei:l>
          <tei:l>בָּרוּךְ שֵׁם כְּבוֹד מַלְכוּתוֹ לְעוֹלָם וָעֶד:‏</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
