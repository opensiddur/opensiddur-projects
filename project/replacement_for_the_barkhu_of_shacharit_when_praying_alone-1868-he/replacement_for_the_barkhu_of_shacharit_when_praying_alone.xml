    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:replacement_for_the_barkhu_of_shacharit_when_praying_alone">
        <tei:head>תשלומי שחרית ברכו ליחיד (אשכנז)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:replacement_for_the_barkhu_of_shacharit_when_praying_alone/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">מי שאינו יכול להתפלל עם הציבור או שאיחר לבוא לביה״כ ולא שמע קדיש או ברכו או קדושה הוא ישלים חסרונו בפסוקים וברייתות המדברות מענינים אלו, וע״פ הנוסחאות הנאות.</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:replacement_for_the_barkhu_of_shacharit_when_praying_alone/2"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">מי שלא שמע ברכו של שחרית יאמר זה אחר תחנון׃</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:replacement_for_the_barkhu_of_shacharit_when_praying_alone/3"/>
        <tei:lg>
          <tei:l>זֶה אוֹמֵר אֲנִי בִּמְקוֹם בָּרֲכוּ שֶׁל־שַׁחֲרִית׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:replacement_for_the_barkhu_of_shacharit_when_praying_alone/4"/>
        <tei:lg>
          <tei:l>בִּפְרֹ֤עַ פְּרָעוֹת֙ בְּיִשְׂרָאֵ֔ל</tei:l>
          <tei:l>בְּהִתְנַדֵּ֖ב עָ֑ם</tei:l>
          <tei:l>בָּֽרְכ֖וּ יְהֹוָֽה׃ <tei:bibl>(שופטים ה:ב)</tei:bibl></tei:l>
          <tei:l>בָּרְכוּ֙ אֶת־יְהֹוָ֣ה אֱלֹֽהֵיכֶ֔ם</tei:l>
          <tei:l>מִן־הָעוֹלָ֖ם עַד־הָעוֹלָ֑ם</tei:l>
          <tei:l>וִיבָֽרְכוּ֙ שֵׁ֣ם כְּבֹדֶ֔ךָ</tei:l>
          <tei:l>וּמְרוֹמַ֥ם עַל־כׇּל־בְּרָכָ֖ה וּתְהִלָּֽה׃ <tei:bibl>(נחמיה ט:ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:replacement_for_the_barkhu_of_shacharit_when_praying_alone/5"/>
        <tei:lg>
          <tei:l>יְהִ֤י שֵׁ֣ם יְהֹוָ֣ה מְבֹרָ֑ךְ</tei:l>
          <tei:l>מֵ֝עַתָּ֗ה וְעַד־עוֹלָֽם׃ <tei:bibl>(תהלים קיג:ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:replacement_for_the_barkhu_of_shacharit_when_praying_alone/6"/>
        <tei:lg>
          <tei:l>בָּר֤וּךְ ׀ יְהֹוָ֣ה אֱ֭לֹהִים אֱלֹהֵ֣י יִשְׂרָאֵ֑ל</tei:l>
          <tei:l>עֹשֵׂ֖ה נִפְלָא֣וֹת לְבַדּֽוֹ׃</tei:l>
          <tei:l>וּבָר֤וּךְ ׀ שֵׁ֥ם כְּבוֹד֗וֹ לְע֫וֹלָ֥ם</tei:l>
          <tei:l>וְיִמָּלֵ֣א כְ֭בוֹדוֹ אֶת־כֹּ֥ל הָאָ֗רֶץ</tei:l>
          <tei:l>אָ֘מֵ֥ן ׀ וְאָמֵֽן׃ <tei:bibl>(תהלים עב:יח-יט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:replacement_for_the_barkhu_of_shacharit_when_praying_alone/7"/>
        <tei:lg>
          <tei:l>אָמַר רַבִּי עֲקִיבָה</tei:l>
          <tei:l>בְּכׇל־יוֹם וָיוֹם מַלְאָךְ אֶחָד עוֹמֵד</tei:l>
          <tei:l>בְּאֶמְצַע הָרָקִיעַ שַׁחֲרִית</tei:l>
          <tei:l>וְאוֹמֵר יְהֹוָה מֶלֶךְ יְהֹוָה מָלַךְ</tei:l>
          <tei:l>יְהֹוָה יִמְלֹךְ לְעֹלָם וָעֶד</tei:l>
          <tei:l>וְכׇל־גְּדוּדֵי מַעְלָה עוֹנִים אַחֲרָיו</tei:l>
          <tei:l>עַד־שֶׁמַּגִּיעַ לְבָרֲכוּ. כְּשֶׁמַּגִּיעַ לְבָרֲכוֹ</tei:l>
          <tei:l>חַיָּה אַחַת שֶׁשְּׁמָהּ יִשְׂרָאֵל</tei:l>
          <tei:l>וְחָקוּק עַל־מִצְחָהּ יִשְׂרָאֵל</tei:l>
          <tei:l>עוֹמֶדֶת בְּאֶמְצַע הָרָקִיעַ</tei:l>
          <tei:l>וְאוֹמֶרֶת בְּקוֹל רָם</tei:l>
          <tei:l>בָּרֲכוּ אֶת־יְהֹוָה הַמְּבֹרָךְ</tei:l>
          <tei:l>וְכׇל־גְּדוּדֵי מַעְלָה עוֹנִים</tei:l>
          <tei:l>בָּרוּךְ יְהֹוָה הַמְּבֹרָךְ</tei:l>
          <tei:l>לְעוֹלָם וָעֶד׃ <tei:bibl>(הכלות רבתי לא:ד)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
