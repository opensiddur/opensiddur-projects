  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:elohai_netsor_giorgio_rubin">
        <tei:head>Elohai Netsor, a paraliturgical adaptation by Rabbi David Einhorn (1858)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohai_netsor_giorgio_rubin/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">In silent devotion:</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohai_netsor_giorgio_rubin/2"/>
        <tei:lg>
          <tei:l>O God, keep my tongue from evil,</tei:l>
          <tei:l>and my lips from speaking deceit.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohai_netsor_giorgio_rubin/3"/>
        <tei:lg>
          <tei:l>Arm me with meekness against ill-will;</tei:l>
          <tei:l>implant humility in my soul,</tei:l>
          <tei:l>and faith in my heart.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohai_netsor_giorgio_rubin/4"/>
        <tei:lg>
          <tei:l>Be my support when grief silences my voice,</tei:l>
          <tei:l>and my comfort when trouble burdens my spirit.</tei:l>
          <tei:l>Let Your truth illumine my path, and guide me,</tei:l>
          <tei:l>for You are my God and my Deliverer.</tei:l>
          <tei:l>In You I trust day after day.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohai_netsor_giorgio_rubin/5"/>
        <tei:lg>
          <tei:l>Receive with kindness the words of my lips</tei:l>
          <tei:l>and the meditation of my heart,</tei:l>
          <tei:l>O my Maker and Redeemer.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohai_netsor_giorgio_rubin/6"/>
        <tei:lg>
          <tei:l>As You preserve peace in the heavenly spheres,</tei:l>
          <tei:l>so preserve it unto us</tei:l>
          <tei:l>and unto all who invoke Your holy name.</tei:l>
          <tei:l><tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
      </tei:div>
