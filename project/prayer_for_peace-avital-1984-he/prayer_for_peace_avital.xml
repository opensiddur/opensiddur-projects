  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_peace_avital">
        <tei:head>תְּפִלָה לְשָׁלוֹם</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_peace_avital/1"/>
        <tei:lg>
          <tei:l>אָנָּא</tei:l>
          <tei:l>בְּעֶזְרַת שְׁמֶךָ הַגָּדוֹל</tei:l>
          <tei:l>פְּתַח לְבָבֵנוּ,</tei:l>
          <tei:l>קַדְמוֹן רָם</tei:l>
          <tei:l>הַנְחֵה עוֹלָמֵנוּ בְּדַרְכֵי שָׁלוֹם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_peace_avital/2"/>
        <tei:lg>
          <tei:l>אָנָּא</tei:l>
          <tei:l>הָאֵל יָחִיד הַמְּיוּחָד</tei:l>
          <tei:l>פְּקַח עֵינֵינוּ,</tei:l>
          <tei:l>הַשְׁמִיעֵנוּ דִמְמַת קוֹלֶךָ,</tei:l>
          <tei:l>חַזְקֵנוּ בִּבְרִית הַשָׁלוֹם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_peace_avital/3"/>
        <tei:lg>
          <tei:l>אָנָּא</tei:l>
          <tei:l>בּוֹרֵא הַכֹּל,</tei:l>
          <tei:l>בִּרְצוֹנֶךָ הָאֵר דְרָכֵינוּ,</tei:l>
          <tei:l>לְמַעַן יְצִירֵי כַּפֶּךָ,</tei:l>
          <tei:l>בִּלְבָבֵנוּ שִׂים שָׁלוֹם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_peace_avital/4"/>
        <tei:lg>
          <tei:l>אָנָּא</tei:l>
          <tei:l>מֶלֶךְ הַיְּקוּם,</tei:l>
          <tei:l>בְּכַוָּונַת־לֵב, הַאֲזֵן לְשַׁוְעָתֵנוּ,</tei:l>
          <tei:l>לְמַעַן דְבַר קְדוּשָׁתֶךָ,</tei:l>
          <tei:l>בָּרֵךְ עוֹלָמֶךָ בְּשָׁלוֹם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_peace_avital/5"/>
        <tei:lg>
          <tei:l>אָנָּא</tei:l>
          <tei:l>בּוֹרְאֵנוּ יוֹצְרֵנוּ עוֹשֵׂנוּ</tei:l>
          <tei:l>וַעֲטֶרֶת רֹאשֵׁנוּ,</tei:l>
          <tei:l>הַאֲצֵל עָלֵינוּ רוּחֲךָ הַטּוֹבָה</tei:l>
          <tei:l>בְּחֶדְוַת הַשָׁלוֹם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_peace_avital/6"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אֱלֹהֵינוּ שֶׁאָמַר</tei:l>
          <tei:l>וְהָיָה הָעוֹלָם בַּהֲוָויָתֵנוּ,</tei:l>
          <tei:l>פִּינוּ מוֹדֶה,</tei:l>
          <tei:l>לְשׁוֹנֵנוּ תְּשַׁבֵּחַ,</tei:l>
          <tei:l>וּבִרְכֵּנוּ תִּכְרַע בְּשָׁלוֹם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_peace_avital/7"/>
        <tei:lg>
          <tei:l>שְׁמַע קוֹלֵנוּ,</tei:l>
          <tei:l>קַבֵּל תוֹרָתֵנוּ</tei:l>
          <tei:l>בִּשְׁעַת רָצוֹן,</tei:l>
          <tei:l>בָּרוּךָ הַבּוֹחֵן לְבָבוֹת,</tei:l>
          <tei:l>הַשּׁוֹמֵעַ תְּפִלָּה לְשָׁלוֹם.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
