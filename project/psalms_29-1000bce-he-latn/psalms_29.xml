  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/29">
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>Havu l’YHVH</tei:l>
          <tei:l>bnei elim</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Havu l’YHVH kavod va’oz</tei:l>
          <tei:l>Havu l’YHVH kvod sh’mo,</tei:l>
          <tei:l>hishtachavu l’YHVH b’hadrat kodesh</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Kol YHVH al hamayim</tei:l>
          <tei:l>el hakavod hir’im</tei:l>
          <tei:l>YHVH al mayim rabim</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/29/4/a"/>
        <tei:lg>
          <tei:l>Kol YHVH bakoach,</tei:l>
          <tei:l>kol YHVH behadar</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/29/5/a"/>
        <tei:lg>
          <tei:l>Kol YHVH shover arazim</tei:l>
          <tei:l>Vayishaber YHVH et arzei halvanon</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/29/6/a"/>
        <tei:lg>
          <tei:l>Vayarkidem k’mo egel</tei:l>
          <tei:l>l’vanon v’shiryon k’mo ven r’emim</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>Kol YHVH chotzev lahavot esh</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/29/8/a"/>
        <tei:lg>
          <tei:l>Kol YHVH yachil midbar,</tei:l>
          <tei:l>yachil YHVH midbar kadesh,</tei:l>
          <tei:l>Kol YHVH y’cholel ayalot</tei:l>
          <tei:l>Vayechesof yarot</tei:l>
          <tei:l>u’v’hechalo</tei:l>
          <tei:l>kulo omer kavod</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/29/10/a"/>
        <tei:lg>
          <tei:l>YHVH lamabul yashav</tei:l>
          <tei:l>Vayeshev YHVH melech l’olam</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/29/11/a"/>
        <tei:lg>
          <tei:l>YHVH oz l’amo yiten</tei:l>
          <tei:l>YHVH yivarech et amo vashalom</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
