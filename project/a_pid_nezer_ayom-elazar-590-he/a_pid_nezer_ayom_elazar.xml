  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_pid_nezer_ayom_elazar">
        <tei:head>אַאְפִּיד נֵֽזֶר אָיוֹם</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_pid_nezer_ayom_elazar/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אַ</tei:seg>אְפִּיד נֵֽזֶר אָיוֹם</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>שִׁלּוּשׁ קְדֻשָּׁה בַּיּוֹם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_pid_nezer_ayom_elazar/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">גִּ</tei:seg>בּֽוֹרֵי כֹחַ גְּדֻלָּה</tei:l>
          <tei:l><tei:seg type="acrostic">דַּ</tei:seg>הֲרֽוּהוּ בְּבֵית דְּגִילָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_pid_nezer_ayom_elazar/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הֽ</tei:seg>וֹגֵי הֶֽגֶה הֲמֻלָּה</tei:l>
          <tei:l><tei:seg type="acrostic">וַ</tei:seg>תְּקֽוּהוּ בְּהַלֵּל וּמִלָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_pid_nezer_ayom_elazar/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ז</tei:seg>וֹכֵר לָעַד זְכֻיּוֹת</tei:l>
          <tei:l><tei:seg type="acrostic">חַ</tei:seg>דְּשֽׁוּהוּ זֶֽמֶר חַיּוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_pid_nezer_ayom_elazar/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ט</tei:seg>וֹב עוֹמֵס טֹֽרַח</tei:l>
          <tei:l><tei:seg type="acrostic">יַ</tei:seg>חֲדֽוּהוּ בְּחִדּוּשׁ יָֽרֵחַ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_pid_nezer_ayom_elazar/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כּ</tei:seg>וֹבֵשׁ כׇּל כְּעָסִים</tei:l>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>בַל אַף לְהָשִׂים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_pid_nezer_ayom_elazar/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מְ</tei:seg>שָׁרְתֵי בְּחִיל מוֹרָא</tei:l>
          <tei:l><tei:seg type="acrostic">נָ</tei:seg>כְחָם הַלֲלוּ נוֹרָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_pid_nezer_ayom_elazar/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שַׂ</tei:seg>רְפֵי סְבִיב סְעָרָה</tei:l>
          <tei:l><tei:seg type="acrostic">עֱ</tei:seg>נוּ לְמַעֲבִיר עֶבְרָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_pid_nezer_ayom_elazar/10"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>לִיאִים פִּצְחוּ פֶה</tei:l>
          <tei:l><tei:seg type="acrostic">צַ</tei:seg>לְצְלוּ הַכֹּל צוֹפֶה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_pid_nezer_ayom_elazar/11"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קְ</tei:seg>הִלּוֹת עַם קְדוֹשִׁים</tei:l>
          <tei:l><tei:seg type="acrostic">ר</tei:seg>וֹמֲמֽוּהוּ רִבֲבוֹת רוֹעֲשִׁים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_pid_nezer_ayom_elazar/12"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שֶֽׁ</tei:seg>מַע קוֹל שׁוֹפָר</tei:l>
          <tei:l><tei:seg type="acrostic">תַּ</tei:seg>אֲזִין וְאַשְׁמָה תוּפָר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_pid_nezer_ayom_elazar/13"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">חזן:</tei:note> תְּשַׁלֵּשׁ שׁוֹפָרוֹת בְּהַר הַקֹּדֶשׁ</tei:l>
          <tei:l>וַאֲשַׁלֵּשׁ קְדֻשָּׁה בַּקֹּדֶשׁ.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
