      <tei:div corresp="urn:x-opensiddur:text:prayer:berakhot_sheasani_silverman">
        <tei:head>בְּרָכוֹת שֶׁעֲשָׁנִי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:berakhot_sheasani_silverman/1"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>שֶׁעָשַֽׂנִי בְּצָלְמוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:berakhot_sheasani_silverman/2"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>שֶׁעָשַֽׂנִי בֶּן חוֹרִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:berakhot_sheasani_silverman/3"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>שֶׁעָשַֽׂנִי יִשְׂרָאֵל׃</tei:l>
        </tei:lg>
