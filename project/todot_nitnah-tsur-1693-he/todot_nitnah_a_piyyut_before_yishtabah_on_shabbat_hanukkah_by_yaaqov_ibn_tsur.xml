    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:todot_nitnah_a_piyyut_before_yishtabah_on_shabbat_hanukkah_by_yaaqov_ibn_tsur">
        <tei:head>תּוֹדוֹת נִתְּנָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:todot_nitnah_a_piyyut_before_yishtabah_on_shabbat_hanukkah_by_yaaqov_ibn_tsur/1"/>
        <tei:lg>
          <tei:l>תּוֹדוֹת נִתְּנָה לְצוּר יִשְׁעֵֽנוּ</tei:l>
          <tei:l>שֶׁעָשָׂה נִסִּים לַאֲבוֹתֵֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:todot_nitnah_a_piyyut_before_yishtabah_on_shabbat_hanukkah_by_yaaqov_ibn_tsur/2"/>
        <tei:lg>
          <tei:l>יָמִים שְׁמוֹנָה הֵמָּה נוֹדָֽעוּ</tei:l>
          <tei:l>בַּיָּמִים הַהֵם בָּנִים נוֹשָֽׁעוּ</tei:l>
          <tei:l>אַךְ יְוָנִים הֵן אָבְדוּ נִגְדָּֽעוּ</tei:l>
          <tei:l>גָּבְרוּ עֲלֵיהֶם אָז כֹּהֲנֵֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:todot_nitnah_a_piyyut_before_yishtabah_on_shabbat_hanukkah_by_yaaqov_ibn_tsur/3"/>
        <tei:lg>
          <tei:l>עַל־כֵּן כׇּל־לָֽיְלָה נֵרוֹת נַסְדִּֽירָה</tei:l>
          <tei:l>בִּמְזוּזַת שְׂמֹאל בְּתוֹךְ עֲשָׂרָה</tei:l>
          <tei:l>לְפַרְסֵם בָּהֶם נִסֵּי אֵל נוֹרָא</tei:l>
          <tei:l>אֱיָלוּתֵֽנוּ צוּר מִשְׂגַּבֵּֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:todot_nitnah_a_piyyut_before_yishtabah_on_shabbat_hanukkah_by_yaaqov_ibn_tsur/4"/>
        <tei:lg>
          <tei:l>קְבָעוּם רַבִּים מוֹרֵי הוֹרָאָה</tei:l>
          <tei:l>בְּהַלֵּל גָּמוּר וְגַם הוֹדָאָה</tei:l>
          <tei:l>לְפָאֵר שֵׁם אֵל כִּי גָּאֹה גָּאָה</tei:l>
          <tei:l>הַנִּפְרָע לָֽנוּ מִכׇּל־צָרֵֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:todot_nitnah_a_piyyut_before_yishtabah_on_shabbat_hanukkah_by_yaaqov_ibn_tsur/5"/>
        <tei:lg>
          <tei:l>בְּעֻזְּךָ נָאוֹר תָּמִיד נִבְטְחָה</tei:l>
          <tei:l>וּבְךָ נָגִֽילָה וְגַם נִשְׂמְחָה</tei:l>
          <tei:l>נִפְלְאוֹתֶֽיךָ נָגִיד נָשִֽׂיחָה</tei:l>
          <tei:l>יִשְׁתַּבַּח שִׁמְךָ לָעַד מַלְכֵּֽנוּ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
