  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:supplemental_stanza_to_maoz_tzur_with_regard_to_the_present_yirmiyah">
        <tei:head>תוספת בית למעוז צור</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:supplemental_stanza_to_maoz_tzur_with_regard_to_the_present_yirmiyah/1"/>
        <tei:lg>
          <tei:l>יְׄהִי רָׄצוֹן מִׄלְּפָנֶֽיךָ</tei:l>
          <tei:l>יָׄחִיד הׄוֹד וְׄהָדָר</tei:l>
          <tei:l>גְּאַל שְׁאֵרִית צֹאנֶֽךָ</tei:l>
          <tei:l>מֵאֱדוֹם יִשְׁמָעֵאל וְקֵדָר</tei:l>
          <tei:l>רַחוּם בַּקֹּֽדֶשׁ נֶאְדָּר</tei:l>
          <tei:l>רֶֽוַח תָּשִׂים לָעֵֽדֶר</tei:l>
          <tei:l>נַחֲלָתְךָ הוֹשִֽׁיעַ<tei:anchor xml:id="note_1"/></tei:l>
          <tei:l>אֵ֖ל נְקָמ֣וֹת הוֹפִֽיעַ<tei:anchor xml:id="note_2"/></tei:l>
          <tei:l>בַּֽעֲמָלֵ֑ק מִדֹּ֖ר דֹּֽר׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" n="1" target="#note_1">
      <tei:p>נ״א הוֹשִֽׁיעָה</tei:p>
    </tei:note>
    <tei:note type="commentary" n="2" target="#note_2">
      <tei:p>נ״א הוֹפִֽיעָה וזהו נוסח טעות לפי הפסוק מתהלים צד א</tei:p>
    </tei:note>
  </tei:standOff>
