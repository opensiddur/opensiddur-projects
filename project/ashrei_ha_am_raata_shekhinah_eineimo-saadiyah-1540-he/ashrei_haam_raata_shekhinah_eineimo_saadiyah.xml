    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah">
        <tei:head>אַשְׁרֵי הָעָם רָאֲתָה שְׁכִינָה עֵינֵֽימוֹ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/1"/>
        <tei:lg>
          <tei:l>אַשְׁרֵי הָעָם רָאֲתָה שְׁכִינָה עֵינֵֽימוֹ</tei:l>
          <tei:l>מִסִּינַ֥י בָּא֙ וְזָרַ֤ח מִשֵּׂעִיר֙ לָ֔מוֹ</tei:l>
          <tei:l>מִימִינ֕וֹ אֵ֥שׁ דָּ֖ת לָֽמוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/2"/>
        <tei:lg>
          <tei:l>בַּשִּׁשִׁי בְשַׁבָּת</tei:l>
          <tei:l>נִגְלֹה נִגְלָה הָאֵל בְּחִבַּת</tei:l>
          <tei:l>לָתֵת לְעַם זוּ דָּת נֶֽפֶשׁ מְשִׁיבַת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/3"/>
        <tei:lg>
          <tei:l>שִׁשָּׁה יָמִים לְחֹֽדֶשׁ סִיוָן</tei:l>
          <tei:l>יָרְדָה שְׁכִינָה תִּפְאֶֽרֶת יִשְׂרָאֵל וְזִיוָן</tei:l>
          <tei:l>כִּֽי־יַעֲקֹ֗ב בָּחַ֣ר ל֣וֹ יָ֑הּ וְאִוָּן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/4"/>
        <tei:lg>
          <tei:l>שְׁנַת אַלְפַּיִם וְאַרְבַּע מֵאוֹת וְאַרְבָּעִים וּשְׁמוֹנָה לִבְרִיאַת עוֹלָם</tei:l>
          <tei:l>פָּקַד הָאֵל עַמּוֹ וּגְאָלָם</tei:l>
          <tei:l>וְחֶ֤סֶד יְהֹוָ֨ה ׀ מֵעוֹלָ֣ם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/5"/>
        <tei:lg>
          <tei:l>לְמִנְיָן שֶׁאָֽנוּ מוֹנִין בְּהַר סִינַי</tei:l>
          <tei:l>אַלּוּפַי אֲצִילַי וּזְקֵנַי</tei:l>
          <tei:l>שֶׁאָמְרוּ נַעֲשֶׂה כֹּ֛ל אֲשֶׁר־דִּבֶּ֥ר יְהֹוָ֖ה׃ <tei:bibl>(שמות יט:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/6"/>
        <tei:lg>
          <tei:l>דְּעַל נְהַר הַחׇכְמָה יָשַׁב</tei:l>
          <tei:l>וּמִמֵּימֵי הַשֵּֽׂכֶל וְהַמַּדָּע קָשַׁב</tei:l>
          <tei:l>לוֹ אִ֝וָּ֗הּ לְמוֹשָׁ֥ב׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/7"/>
        <tei:lg>
          <tei:l>אֵיךְ הֶחָתָן הַנָּעִים</tei:l>
          <tei:l>אַבִּיר הָרוֹעִים</tei:l>
          <tei:l>הֲבֵן֩ יַקִּ֨יר לִ֜י אֶפְרַ֗יִם אִ֚ם יֶ֣לֶד שַׁעֲשֻׁעִ֔ים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/8"/>
        <tei:lg>
          <tei:l>בָּרוּךְ מִבָּנִים וּמִכׇּל־הָעַמִּים</tei:l>
          <tei:l>זֶֽרַע אָבוֹת הַקְּדוּמִים</tei:l>
          <tei:l>יִרְאֶ֥ה זֶ֖רַע יַאֲרִ֣יךְ יָמִ֑ים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/9"/>
        <tei:lg>
          <tei:l>הַגְּבִיר וּמְעְלָּה</tei:l>
          <tei:l>אֲשֶׁר בְּכֶ֣תֶם אוֹפִ֑יר לֹא יְסֻלֶּה</tei:l>
          <tei:l>עוֹשֶׂה אֵֽלֶּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/10"/>
        <tei:lg>
          <tei:l>הַמִּצְוֺת וְהַחֻקִּים לוֹ לְמָנָה</tei:l>
          <tei:l>וְנוֹתֵן לָהֶם שְׁאֵר כְּסוּת וְעוֹנָה</tei:l>
          <tei:l>ר֧וּחַ חׇכְמָ֣ה וּבִינָ֗ה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/11"/>
        <tei:lg>
          <tei:l>הֶחָכָם הַשָּׁלֵם בְּכׇל־הַשְּׁלֵמוּיוֹת</tei:l>
          <tei:l>מִגְדַּל־עֹ֭ז בָּנ֖וּי לְתַלְפִּיּ֑וֹת</tei:l>
          <tei:l>וּמַגִּיד אוֹתִיּוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/12"/>
        <tei:lg>
          <tei:l>כְּמֹהָ״ר יִשְׂרָאֵל נֵר״וֹ</tei:l>
          <tei:l>בַּיּוֹם יָאִיר אוֹרוֹ</tei:l>
          <tei:l>וּ֭בַלַּיְלָה שִׁירֹ֣ה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/13"/>
        <tei:lg>
          <tei:l>בְּנָן שֶׁל קְדוֹשִׁים</tei:l>
          <tei:l>רָאשֵׁי הַשְּׁלִישִׁים וְזֹֽהַר תַּרְשִׁישִׁים</tei:l>
          <tei:l>שִׁבְטֵי יָהּ הַחֲמוּשִׁים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/14"/>
        <tei:lg>
          <tei:l>נֶֽכֶד אֲבוֹת הָעוֹלָם וַאֲצִילֶֽיהָ</tei:l>
          <tei:l>עַמּוּדֶֽיהָ וְאֹהָלֶֽיהָ</tei:l>
          <tei:l>חַיָּֽלֶיהָ וְאַיָּֽלֶיהָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/15"/>
        <tei:lg>
          <tei:l>אָמַר לַכַּלָּה הַיְקָרָה וְהַנְּעִימָה</tei:l>
          <tei:l>אַלְפַּֽיִם שָׁנָה קְדוּמָה</tei:l>
          <tei:l>תּ֘וֹרַ֤ת יְהֹוָ֣ה תְּ֭מִימָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/16"/>
        <tei:lg>
          <tei:l>הַכְּלוּלָה הַבַּת הַבְּתוּלָה</tei:l>
          <tei:l>אֲשֶׁר עַל־מֵי הַמַּדָּע שְׁתוּלָה</tei:l>
          <tei:l>וּמִמֵּימֵי הַחׇכְמָה דוֹלָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/17"/>
        <tei:lg>
          <tei:l>שׁוֹשַׁנַּ֖ת הָעֲמָקִֽים</tei:l>
          <tei:l>זֹֽהַר פָּנֶֽיהָ כַבְּרָקִים</tei:l>
          <tei:l>בָּהִיר הוּא בַשְּׁחָקִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/18"/>
        <tei:lg>
          <tei:l>אַיֶּ֥לֶת אֲהָבִ֗ים וְֽיַ֫עֲלַת־חֵ֥ן</tei:l>
          <tei:l>בְּעֵינֵי כְלָיוֹת בּוֹחֵן</tei:l>
          <tei:l>שֶׁ֣קֶר הַ֭חֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/19"/>
        <tei:lg>
          <tei:l>הַמְּכֻתֶּֽרֶת בְּכֶֽתֶר הַיֹּֽפִי</tei:l>
          <tei:l>הַשְּׁלֵמָה מִכׇּל־מוּם וְדֹֽפִי</tei:l>
          <tei:l>הֶ֣בֶל הַיֹּ֑פִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/20"/>
        <tei:lg>
          <tei:l>כַּלָּה נָאָה וַחֲסוּדָה</tei:l>
          <tei:l>בְּכׇל־מִדּוֹת טוֹבוֹת מְלֻמָּדָה</tei:l>
          <tei:l>מִבֶּֽטֶן וּמִלֵידָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/21"/>
        <tei:lg>
          <tei:l>רָא֤וּהָ בָנוֹת֙ וַֽיְאַשְּׁר֔וּהָ</tei:l>
          <tei:l>וּבַעֲבוֹתוֹת הָאַהֲבָה קְשָׁרֽוּהָ</tei:l>
          <tei:l>חֲפָר֣וּהָ שָׂרִ֗ים כָּר֙וּהָ֙׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/22"/>
        <tei:lg>
          <tei:l>הֲלֹא הִיא הַכְּבוּדָה וְהַיְקָרָה</tei:l>
          <tei:l>כַּלְבָנָה וְכַחַמָּה בָּרָה</tei:l>
          <tei:l>לֹא־יִכְבֶּ֖ה בַלַּ֣יְלָה נֵרָֽהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/23"/>
        <tei:lg>
          <tei:l>בַּת הַמֶּֽלֶךְ הַגָּדוֹל הַגִּבּוֹר וְהַנּוֹרָא</tei:l>
          <tei:l>לוֹ הַמֶּמְשָׁלָה וְהַגְּבוּרָה</tei:l>
          <tei:l>עוֹטֶה כַּשָּׂלְמָה אוֹרָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/24"/>
        <tei:lg>
          <tei:l>אֲדוֹן הָאֲדוֹנִים וְהַנְּסִיכִים</tei:l>
          <tei:l>וְהַכֹּל לְחַסְדּוֹ צְרִיכִים</tei:l>
          <tei:l>וְיִשְׁתַּחֲווּ־ל֥וֹ כׇל־מְלָכִ֑ים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/25"/>
        <tei:lg>
          <tei:l>אֲשֶׁר אֵין קֵץ לְגׇדְלוֹ</tei:l>
          <tei:l>וּמִי יוּכַל לְסַפֵּר מַהֲלָלוֹ</tei:l>
          <tei:l>שְׂרָפִ֨ים עֹמְדִ֤ים ׀ מִמַּ֙עַל֙ ל֔וֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/26"/>
        <tei:lg>
          <tei:l>הֱוִי לִי לְאִינְתּוּ כַדָּת וְכַהֲלָכָה</tei:l>
          <tei:l>כִּי אַעֲלֶה לָךְ אֲרוּכָה</tei:l>
          <tei:l>וַתִּצְלְחִי לִמְלוּכָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/27"/>
        <tei:lg>
          <tei:l>וַאֲנָא בְסִיַּעְתָּא דִשְׁמַיָּא אֶפְלַח וְאוֹקֵיר וֶאֱזוּן וַאֲפַרְנֵס וַאֲכַלְכֵּל וַאֲכַסֶּה יָתִֽיכִי</tei:l>
          <tei:l>חֶֽסֶד וְרַחֲמִים אֲעַטְּרֵכִי</tei:l>
          <tei:l>וַאֲחַדֵּשׁ כַּנֶּ֣שֶׁר נְעוּרָֽיְכִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/28"/>
        <tei:lg>
          <tei:l>כְּהִלְכַת גּוּבְרִין יְהוּדָאִין דְּפָלְחִין וּמוֹקְרִין וְזָנִין יָת־נְשֵׁיהוֹן בְּקוּשְׁטָא</tei:l>
          <tei:l>וְאֶתֵּן לִֽיכִי טַֽעַם וְעֵיטָא</tei:l>
          <tei:l>מֵאַלְפָא־בֵּיתָא רַבְּתָא עַד אַלְפָא־בֵּיתָא זוּטָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/29"/>
        <tei:lg>
          <tei:l>וּצְבִיאַת כַּלְתָא אוֹרָיְתָא דָּא לְהִנָּשֵׂא</tei:l>
          <tei:l>וְהִכְנִיסָה לוֹ בְתוֹרַת נְדוּנְיָא</tei:l>
          <tei:l>רַמַּ״ח מִצְוֺת עֲשֵׂה וְשַׁסַּ״הּ מִצְוֺת לֹא־תַעֲשֶׂה</tei:l>
          <tei:l>לְמִסְתּוֹר וּלְמַחְסֶה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/30"/>
        <tei:lg>
          <tei:l>וַהֲוָת לֵיהּ לַחֲתָנָא דְנָא לְאִינְתּוּ</tei:l>
          <tei:l>וּבְרִית הָאַהֲבָה בֵינֵיהֶם כָּרְתוּ</tei:l>
          <tei:l>עַל־לֽוּחַ לִבָּם חָרְתוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/31"/>
        <tei:lg>
          <tei:l>וְדָא נְדוּנְיָא דְהַנְעָלַת לֵיהּ כַּלְתָא דָא מִצְוֺת וּמִשְׁפָּטִים</tei:l>
          <tei:l>שֶׁיֵּשׁ בָּהֶם כְּלָלִים וּפְרָטִים</tei:l>
          <tei:l>בָּתֵּי הַנֶּֽפֶשׁ וְהַחֲרִיטִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/32"/>
        <tei:lg>
          <tei:l>וְכֻלָּם נִכְלָלִים בַּעֲשֶֽׂרֶת הַדְּבָרִים</tei:l>
          <tei:l>עַל־שְׁנֵי לוּחוֹת סַפִּירִים בְּהִירִים</tei:l>
          <tei:l>מְזֻקָקִים טְהוֹרִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/33"/>
        <tei:lg>
          <tei:l>אָֽנֹכִ֖י֙ וְלֹֽ֣א־יִהְיֶ֥͏ֽה־לְךָ֛֩ אֱלֹהִ֥֨ים אֲחֵרִ֖֜ים</tei:l>
          <tei:l>וְלֹ֥א תִשָּׂ֛א לַשָּׁוְא שְׁבוּעוֹת שְׁקָרִים</tei:l>
          <tei:l>וְקַדֵּשׁ שַׁבָּת בְּאַרְבָּעִים מְלָאכוֹת חָסֵר אַחַת אֲסוּרִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/34"/>
        <tei:lg>
          <tei:l>גַּם לְכַבֵּד אָב וָאֵם וְהוֹרִים</tei:l>
          <tei:l>וְלֹא־תִשְׁפֹּךְ דָּם נְקִיִּים וּבָרִים</tei:l>
          <tei:l>וְלֹא־קְדֵשׁוֹת וַעֲרָיוֹת וְזָרִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/35"/>
        <tei:lg>
          <tei:l>וְלֹ֣֖א תִּֿגְנֹֽ֔ב נְפָשׁוֹת מֵעַם נִבְחָרִים</tei:l>
          <tei:l>וְלֹֽא־תַעֲנֶ֥ה שְׁקָרִים בִּבְנֵי חֲבֵרִים</tei:l>
          <tei:l>וְלֹ֥א תַחְמֹ֖ד וְתִתְאַוֶּה כׇל־שְׁאָר הַדְּבָרִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/36"/>
        <tei:lg>
          <tei:l>וּצְבִי חֲתָנָא דְנָא וְהוֹסִיף מִדִּילֵיהּ תַּקְנוֹת וּסְיָגִים</tei:l>
          <tei:l>וְחֻמְרוֹת וּמִנְהָגִים</tei:l>
          <tei:l>בַּשּׁוֹשַׁנָּה סוּגִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/37"/>
        <tei:lg>
          <tei:l>וְתוֹסֶֽפֶת עַל עִקַּר הַכְּתֻבָּה</tei:l>
          <tei:l>כׇּל־הַחֲפָצִים לֹ֣א יִֽשְׁווּ־בָֽהּ</tei:l>
          <tei:l>לֹֽא־תֶחְסַ֥ר כֹּ֖ל בָּ֑הּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/38"/>
        <tei:lg>
          <tei:l>נִמְצָא הַכֹּל נְדוּנְיָא וְתוֹסֶֽפֶת סַךְ תַּרְיַ״ג מִצְוֺת יְקָרוֹת</tei:l>
          <tei:l>וְאַלְפֵי אֲלָפִים סְיָגִים וְחוּמְרוֹת</tei:l>
          <tei:l>אַזְהָרוֹת וְחֻקִּים וְתוֹרוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/39"/>
        <tei:lg>
          <tei:l>הַכֹּל קִבְּלָם חֲתָנָא עַל־עַצְמוֹ</tei:l>
          <tei:l>לְדַבֵּר בָּהֶם בְּשִׁבְתּוֹ וּבְקוּמוֹ</tei:l>
          <tei:l>וּבְלֶכְתּוֹ בַדֶּֽרֶךְ יוֹלִיכֶם עַמּוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/40"/>
        <tei:lg>
          <tei:l>וּבָֽאוּ לְיָדוֹ וְנַעֲשׂוּ בִרְשׁוּתוֹ</tei:l>
          <tei:l>לַהֲגוֹת בָּהֶם כׇּל־יְמֵי חַיָּיו וּבְיוֹם מוֹתוֹ</tei:l>
          <tei:l>יֵלְכוּ עִמּוֹ לְלַוּוֹת אוֹתוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/41"/>
        <tei:lg>
          <tei:l>וּזְקָפָן עַל־עַצְמוֹ בְּמִלְוָה וּרְשׁוּ</tei:l>
          <tei:l>כְּדֵי שֶׁמִּפִּיו לֹא־יָמוּשׁוּ</tei:l>
          <tei:l>וּ֝פְתָיִ֗ים עָבְר֥וּ וְֽנֶעֱנָֽשׁוּ׃ <tei:bibl>(משלי כב:ג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/42"/>
        <tei:lg>
          <tei:l>וּכְנִכְסֵי צֹאן בַּרְזֶל יִהְיוּ בִגְבוּלוֹ</tei:l>
          <tei:l>מְנָת חֶלְקוֹ וְגוֹרָלוֹ</tei:l>
          <tei:l>אִם־פִּחֲתוּ פִּחֲתוּ לוֹ וְאִם־הוֹתִֽירוּ הוֹתִֽירוּ לוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/43"/>
        <tei:lg>
          <tei:l>וְכָךְ אָמַר לָֽנָא חֲתָנָא</tei:l>
          <tei:l>דְנָא אַחֲרָיוּת כְּתֻבָּה וּנְדוּנְיָא וְתוֹסֶֽפֶת אִילִין קַבֵּילִית עָלַי שֶׁלֹא־אֶשְׁכָּחֵם</tei:l>
          <tei:l>וְעַל־לֽוּחַ לִבִּי אַנִּיחֵם</tei:l>
          <tei:l>וּמִלְחֲמוֹת יְהֹוָה אֶהְיֶה לוֹחֵם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/44"/>
        <tei:lg>
          <tei:l>קַבֵּילִית עָלַי וְעַל־יָרְתַאי בָּתְרַאי</tei:l>
          <tei:l>לִלְמֹד בָּהֶם קֶֽבַע וְלֹא־עֲרַאי</tei:l>
          <tei:l>וְנָקָם אָשִׁיב לְצָרָי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/45"/>
        <tei:lg>
          <tei:l>וְעַל־כׇּל־שְׁפַר אֲרַג נְכָסִים וְקִנְיָנִין דְּאִית־לִי תְּחוֹת כׇּל־שְׁמַיָּא</tei:l>
          <tei:l>לְמִהְגֵּה בָּהּ לֵילְיָא וְיוֹמַיָּא</tei:l>
          <tei:l>וְאַף בֵּין אוּמַיָּא וְלִישָׁנַיָּיא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/46"/>
        <tei:lg>
          <tei:l>הַתְּנָאִים שֶׁהִתְנוּ בֵּינֵיהֶם הֶחָתָן וְהַכַּלָּה יִשְׁמְרֵם צוּרָם</tei:l>
          <tei:l>לִהְיוֹת בַּיהֹוָה שִׂבְרָם</tei:l>
          <tei:l>מָגִנָּם וְעֶזְרָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/47"/>
        <tei:lg>
          <tei:l>וְשֶׁלֹּא יַעֲשֹׂק בִּמְלָאכָה אַחֶֽרֶת רַק לֶאֱכֹל מִלַּחְמָהּ</tei:l>
          <tei:l>וְלִשְׁתּוֹת מִיֵּינָהּ וְשַׁמְנָהּ וּמֵימָהּ</tei:l>
          <tei:l>לִשְׁכַּ֥ב אֶצְלָ֖הּ לִהְי֥וֹת עִמָּֽהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/48"/>
        <tei:lg>
          <tei:l>וְשֶׁלֹּא יִשָּׂא אִשָּׁה אַחֶֽרֶת עָלֶֽיהָ</tei:l>
          <tei:l>וְלִשְׁמֹר כְּלָלֶֽיהָ וּפְרָטֶֽיהָ</tei:l>
          <tei:l>וְזָר לֹא יִקְרַב אֵלֶֽיהָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/49"/>
        <tei:lg>
          <tei:l>וְשֶׁלֹּא יְפַתֶּנָּה לִמְחֹל לוֹ כְּתֻבָּתָהּ</tei:l>
          <tei:l>לֹא־כֻלָּהּ וְלֹא־מִקְצָתָהּ</tei:l>
          <tei:l>בְּאַהֲבָת֖וֹ אֹתָֽהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/50"/>
        <tei:lg>
          <tei:l>וְאִם מָחֲלָה לוֹ לֹא־יְהִי מָחוּל כְּלָל וְעִקָּר</tei:l>
          <tei:l>כִּי־אִם־שָׁגֹה יִשְׁגֶּה וְשִׁקַּר</tei:l>
          <tei:l>וְאָדָם בַּל־יָלִין בִּיקָר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/51"/>
        <tei:lg>
          <tei:l>וְהַדִּירָה לִרְצוֹנָהּ בְּבָתֵּי כְנֵסִיּוֹת וּבְבָתֵּי מִדְרָשׁוֹת</tei:l>
          <tei:l>כְּדֵי שֶׁיִּהְיוּ דְבָרֶֽיהָ עַל־לִבּוֹ חֲרוּתוֹת</tei:l>
          <tei:l>דִינֵי מָמוֹנוֹת וְדִינֵי נְפָשׁוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/52"/>
        <tei:lg>
          <tei:l>וְשֶׁלֹּא יֵלֵךְ לְאֶֽרֶץ אַחֶֽרֶת וְיַנִיחֶֽנָּה יְחִידָה וְגַלְמוּדָה</tei:l>
          <tei:l>וְאִם־יֵלֶךְ יִקָחֶֽנָּה עִמּוֹ הַצִּדָּה</tei:l>
          <tei:l>נֵ֣רְדְּ ׀ וְכַרְכֹּ֗ם קָנֶה֙ וְקִדָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/53"/>
        <tei:lg>
          <tei:l>וְהַיְרֻשָּׁה כְּדִין תּוֹרָה הַקְּדוֹשָׁה</tei:l>
          <tei:l>כִּֽי־יִקַּ֥ח אִ֖ישׁ אִשָּׁ֑ה</tei:l>
          <tei:l>תּוֹרָ֥ה צִוָּה־לָ֖נוּ מֹשֶׁ֑ה מוֹרָשָׁ֖ה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/54"/>
        <tei:lg>
          <tei:l>וְשֶׁלֹּא יִמְכֹּר וִימַשְׁכֵּן שׁוּם דָּבָר מִתַּכְשִׁיטֶֽיהָ</tei:l>
          <tei:l>וְכֻלָּם יִהְיוּ לְמוּלֶֽיהָ</tei:l>
          <tei:l>וְזָר לֹא יִקְרַב אֵלֶֽיהָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/55"/>
        <tei:lg>
          <tei:l>וְחֹֽמֶר וְחֹֽזֶק שְׁטַר כְּתֻבָּה דָא</tei:l>
          <tei:l>יוֹתֵר מֵחֹֽמֶר וְחֹֽזֶק כׇּל־שִׁטְרֵי בְנוֹת יִשְׂרָאֵל וִיהוּדָה</tei:l>
          <tei:l>לְתוֹרָ֖ה וְלִתְעוּדָ֑ה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/56"/>
        <tei:lg>
          <tei:l>דְּלָא־כְאַסְמַכְתָּא וּדְלָא־כְּטוֹפְסֵי דְשִׁטְרֵי</tei:l>
          <tei:l>דְּכָתְבֵי יָתְהוֹן אַלָּמֵי וְשַׁקָּרִי</tei:l>
          <tei:l>אֶת־הָאֱלֹהִ֖ים אֲנִ֥י יָרֵֽא׃ <tei:bibl>(בראשית מב:יח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/57"/>
        <tei:lg>
          <tei:l>אֶֽלָּא כְּהֹֽגֶן וּכְתִקּוּן חֲכָמִים זִכְרוֹנָם לִבְרָכָה</tei:l>
          <tei:l>אֲשֶׁר הוֹרֽוּנוּ כַדָּת וְכַהֲלָכָה</tei:l>
          <tei:l>מִשְׁפָּט הַמְּלוּכָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/58"/>
        <tei:lg>
          <tei:l>וְקָנֵינָא מֵחֲתָנָא דְנָא קִנְיָן גָּמוּר</tei:l>
          <tei:l>לְקַיֵּם כׇּל־הַכָּתוּב כָּאָמוּר</tei:l>
          <tei:l>מִנְהָג וּסְיָג וְקַל וְחָמוּר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/59"/>
        <tei:lg>
          <tei:l>וְנִשְׁבַּע הֶחָתָן שְׁבוּעָה חֲמוּרָה לְקַיֵּם כׇּל־הַמִּצְוֺת וְהַמִּשְׁפָּטִים וְהַחֻקִּים</tei:l>
          <tei:l>וְלֹא יִהְיֶה כְּאַחַד הָרֵיקִים</tei:l>
          <tei:l>לַעֲבֹר עַל־אֲשֶׁר לֹא־יָקִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/60"/>
        <tei:lg>
          <tei:l>וְכָתוֹב וְהָעֵד עֵדִים נֶאֱמָנִים הַשָּׁמַֽיִם וְהָאָֽרֶץ וְהַיָּם</tei:l>
          <tei:l>וְאִם־יְקַיֵּם כׇּל־הַכָּתוּב יִתְּנוּ פִרְיָם</tei:l>
          <tei:l>וְהַכֹּל שָׁרִיר וּבָרִיר וְקַיָּם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashrei_haam_raata_shekhinah_eineimo_saadiyah/61"/>
        <tei:lg>
          <tei:l>וְכׇל־צְבָא הַשָּׁמַיִם נָשְׂאוּ קוֹלָם</tei:l>
          <tei:l>וּבְנֵי הָאֲדָמָה עוֹמְדִים לְמוּלָם</tei:l>
          <tei:l>וְכִלָּם אָמְרוּ יִמְלֹ֤ךְ יְהֹוָ֨ה ׀ לְעוֹלָ֗ם׃ <tei:bibl>(תהלים קמו:י)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
