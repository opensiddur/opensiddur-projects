  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yigdal_project">
        <tei:head>יִגְדַּל מֻתְקָן</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yigdal_project/1"/>
        <tei:lg>
          <tei:l>יִגְדַּל אֱלֹהִים חַי וְיִשְׁתַּבַּח,</tei:l>
          <tei:l>נִמְצָא וְאֵין עֵת אֶל מְצִיאוּתוֹ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yigdal_project/2"/>
        <tei:lg>
          <tei:l>אֶחָד וְאֵין יָחִיד כְּיִחוּדוֹ,</tei:l>
          <tei:l>נֶעְלָם וְגַם אֵין סוֹף לְאַחְדּוּתוֹ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yigdal_project/3"/>
        <tei:lg>
          <tei:l>אֵין לוֹ דְמוּת הַגּוּף וְאֵינוֹ גּוּף,</tei:l>
          <tei:l>לֹא נַעֲרֹךְ אֵלָיו קְדֻשָּׁתוֹ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yigdal_project/4"/>
        <tei:lg>
          <tei:l>קַדְמוֹן לְכׇל־דָּבָר אֲשֶׁר נִבְרָא,</tei:l>
          <tei:l>רִאשׁוֹן וְאֵין רֵאשִׁית לְרֵאשִׁיתוֹ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yigdal_project/5"/>
        <tei:lg>
          <tei:l>הִנּוֹ אֶֽדֶן עוֹלָם,</tei:l>
          <tei:l>וְכׇל־נוֹצָר יוֹרֶה גְּדֻלָּתוֹ וּמַלְכוּתוֹ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yigdal_project/6"/>
        <tei:lg>
          <tei:l>שֶֽׁפַע נְבוּאָתוֹ נְתָנוֹ</tei:l>
          <tei:l>אֶל אַנְשֵׁי סְגֻלָּתוֹ וְתִפְאַרְתּוֹ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yigdal_project/7"/>
        <tei:lg>
          <tei:l>לֹא קָם בְּיִשְׂרָאֵל כְּמֹשֶׁה עוֹד נָבִיא</tei:l>
          <tei:l>וּמַבִּיט אֶת־תְּמוּנָתוֹ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yigdal_project/8"/>
        <tei:lg>
          <tei:l>תּוֹרַת אֱמֶת נָתַן לְעַמּוֹ אֵל,</tei:l>
          <tei:l>עַל יַד נְבִיאוֹ נֶאֱמַן בֵּיתוֹ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yigdal_project/9"/>
        <tei:lg>
          <tei:l>לֹא יַחֲלִיף הָאֵל וְלֹא יָמִיר דָּתוֹ</tei:l>
          <tei:l>לְעוֹלָמִים לְזוּלָתוֹ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yigdal_project/10"/>
        <tei:lg>
          <tei:l>צוֹפֶה וְיוֹדֵֽעַ סְתָרֵֽינוּ,</tei:l>
          <tei:l>מַבִּיט לְסוֹף דָּבָר בְּקַדְמָתוֹ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yigdal_project/11"/>
        <tei:lg>
          <tei:l>שׁוֹמֵר לְעוֹשֶׂה חֶֽסֶד תְּמִימוּת נַּפְשׁוֹ,</tei:l>
          <tei:l>נוֹתֵן לְעוֹשֶׂה רָע יַד לִתְשׁוּבָתוֹ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yigdal_project/12"/>
        <tei:lg>
          <tei:l>יִשְׁלַח לְקֵץ יָמִין מְשִׁיחֵֽנוּ,</tei:l>
          <tei:l>לִפְדּוֹת מְחַכֵּי קֵץ יְשׁוּעָתוֹ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yigdal_project/13"/>
        <tei:lg>
          <tei:l>מֵתִים יְחַיֶּה אֵל בְּרֹב חַסְדּוֹ,</tei:l>
          <tei:l>בָּרוּךְ עֲדֵי עַד שֵׁם תְּהִלָּתוֹ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
