      <tei:div corresp="urn:x-opensiddur:text:poem:zeh_yom_rishon_qaraite_33719">
        <tei:head>זֶה יוֹם רִאשׁוֹן [ב׳]‏</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:zeh_yom_rishon_qaraite_33719/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">שיר נוסף ליום תרועה מאת החכם זרח בן נתן ע”ה מקה”ק טרוקי:</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:zeh_yom_rishon_qaraite_33719/2"/>
        <tei:lg>
          <tei:l>זֶה יוֹם רִאשׁוֹן אֶל הַתְּשׁוּבָה</tei:l>
          <tei:l>אֶל אִישׁ, יַעְזֹב אֶת הַמְּשׁוּבָה.</tei:l>
          <tei:l>יָשִׁיב אֵלָיו וְנָשֽׁוּבָה.</tei:l>
          <tei:l>זֶה יוֹם רִאשׁוֹן אֶל הַתְּשׁוּבָה.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>יָשִׁיב אֵלָיו וְנָשֽׁוּבָה.</tei:l>
          <tei:l>זֶה יוֹם רִאשׁוֹן אֶל הַתְּשׁוּבָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:zeh_yom_rishon_qaraite_33719/3"/>
        <tei:lg>
          <tei:l>רֹאשׁ הַחֹֽדֶשׁ הוּא הַשְּׁבִיעִי,</tei:l>
          <tei:l>רֶֽמֶז נֶֽפֶשׁ הוּא מַשְׁפִּיעִי,</tei:l>
          <tei:l>עַל הַשֵּֽׂכֶל הוּא מַבִּיעִי,</tei:l>
          <tei:l>סוֹד הַתּוֹרָה הוּא מַגִּיעִי,</tei:l>
          <tei:l>אֶל גַּן עֵֽדֶן, עוֹלָם הַבָּא.</tei:l>
          <tei:l>זֶה יוֹם רִאשׁוֹן אֶל הַתְּשׁוּבָה.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>יָשִׁיב אֵלָיו וְנָשֽׁוּבָה</tei:l>
          <tei:l>זֶה יוֹם רִאשׁוֹן אֶל הַתְּשׁוּבָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:zeh_yom_rishon_qaraite_33719/4"/>
        <tei:lg>
          <tei:l>חַסְדּוֹ הָרָם גַּם הַנִּפְלָא</tei:l>
          <tei:l>מִצַּד נִסְתַּר, מִצַּד נִגְלָה</tei:l>
          <tei:l>אֶל עוֹבְדָיו. עִלַּת עִלָּה</tei:l>
          <tei:l>עִם לֵב תָּמִים, אַף בְּמִלָּה</tei:l>
          <tei:l>בִּדְרֹשׁ סוֹדוֹ, עִם רֹב אַהֲבָה</tei:l>
          <tei:l>זֶה יוֹם רִאשׁוֹן אֶל הַתְּשׁוּבָה</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>יָשִׁיב אֵלָיו וְנָשֽׁוּבָה</tei:l>
          <tei:l>זֶה יוֹם רִאשׁוֹן אֶל הַתְּשׁוּבָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:zeh_yom_rishon_qaraite_33719/5"/>
        <tei:lg>
          <tei:l>בִּקְצָת סוֹדוֹ אַטִּיף מִזְעָר</tei:l>
          <tei:l>עֶֽבֶד הָאֵל בִּמְאֹד נִזְהָר</tei:l>
          <tei:l>מִסְפַּר שֶֽׁבַע הוּא הַנִּבְחָר</tei:l>
          <tei:l>סוֹדוֹ יָקָר מִכָּל מִסְחָר</tei:l>
          <tei:l>עִיּוּן נֶֽפֶשׁ אָז נַשִּׂיג בָּהּ</tei:l>
          <tei:l>זֶה יוֹם רִאשׁוֹן אֶל הַתְּשׁוּבָה</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>יָשִׁיב אֵלָיו וְנָשֽׁוּבָה</tei:l>
          <tei:l>זֶה יוֹם רִאשׁוֹן אֶל הַתְּשׁוּבָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:zeh_yom_rishon_qaraite_33719/6"/>
        <tei:lg>
          <tei:l>נֶֽפֶשׁ מִכַּת הַמַּלְאָכִים</tei:l>
          <tei:l>הֵם הַסּוֹבְבִים אֶת הַפְּלָכִים</tei:l>
          <tei:l>הֵם מַשְׁפִּיעִים עַל הַמְּלָכִים.</tei:l>
          <tei:l>נִפְלֵאת הִיא, לַחְקֹר נִמְלָכִים</tei:l>
          <tei:l>לֹא בְמִסְפָּר רַק מַחְשָׁבָה</tei:l>
          <tei:l>זֶה יוֹם רִאשׁוֹן אֶל הַתְּשׁוּבָה</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>יָשִׁיב אֵלָיו וְנָשֽׁוּבָה</tei:l>
          <tei:l>זֶה יוֹם רִאשׁוֹן אֶל הַתְּשׁוּבָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:zeh_yom_rishon_qaraite_33719/7"/>
        <tei:lg>
          <tei:l>נִשְׁמָתֵֽנוּ, תּוֹךְ גּוּפֵֽנוּ</tei:l>
          <tei:l>אִם הִיא תָאִיר, אָז מוּמֵֽינוּ</tei:l>
          <tei:l>נַכִּיר אוֹתוֹ. כָּל יָמֵֽינוּ</tei:l>
          <tei:l>אָז נָשִׂים בָּהּ מַעֲיָנֵֽנוּ</tei:l>
          <tei:l>הִתְבּוֹדֵד עַד גַּם הַצָּבָא</tei:l>
          <tei:l>זֶה יוֹם רִאשׁוֹן אֶל הַתְּשׁוּבָה</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>יָשִׁיב אֵלָיו וְנָשֽׁוּבָה</tei:l>
          <tei:l>זֶה יוֹם רִאשׁוֹן אֶל הַתְּשׁוּבָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:zeh_yom_rishon_qaraite_33719/8"/>
        <tei:lg>
          <tei:l>נָא יוֹם מִשְׁקַל מַעְבָּדֵֽנוּ</tei:l>
          <tei:l>גַּם שִׂיחֵֽנוּ אַף סוֹדֵֽנוּ –</tei:l>
          <tei:l>אָז יִוָּדַע עוֹד הוֹדֵֽינוּ,</tei:l>
          <tei:l>שׁוּב בִּתְשׁוּבָה, בִּמְאֹדֵֽנוּ</tei:l>
          <tei:l>יֵרֵד כַּף רֶֽשַׁע אוֹ יִגְבַּהּ</tei:l>
          <tei:l>זֶה יוֹם רִאשׁוֹן אֶל הַתְּשׁוּבָה</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>יָשִׁיב אֵלָיו וְנָשֽׁוּבָה</tei:l>
          <tei:l>זֶה יוֹם רִאשׁוֹן אֶל הַתְּשׁוּבָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:zeh_yom_rishon_qaraite_33719/9"/>
        <tei:lg>
          <tei:l>חַזֵּק לִבֵּֽנוּ, עַל יוֹם זֶה</tei:l>
          <tei:l>כִּי יֵשׁ לוֹ סוֹד, אַף גַּם רָזֶה</tei:l>
          <tei:l>יֵחָשֶׁב לוֹ כְּשׁוֹק חָזֶה</tei:l>
          <tei:l>עֵת הַקְרִיבוֹ קָרְבָּן מַזֶּה</tei:l>
          <tei:l>עֵת שִׁיר הַלֵּל תּוֹדָה נָאוָה</tei:l>
          <tei:l>זֶה יוֹם רִאשׁוֹן אֶל הַתְּשׁוּבָה</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>יָשִׁיב אֵלָיו וְנָשֽׁוּבָה</tei:l>
          <tei:l>זֶה יוֹם רִאשׁוֹן אֶל הַתְּשׁוּבָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:zeh_yom_rishon_qaraite_33719/10"/>
        <tei:lg>
          <tei:l>אַמֵּץ רוּחֵֽנוּ לִתְשׁוּבָה.</tei:l>
          <tei:l>נַעֲזֹב דַּרְכֵּֽנוּ הַמְּשׁוּבָה,</tei:l>
          <tei:l>נַחְמֹל נַפְשֵֽׁנוּ הַחֲשׁוּבָה,</tei:l>
          <tei:l>אַף גּוּפָתֵֽנוּ הָעֲזוּבָה.</tei:l>
          <tei:l>סוֹף דָּבָר הַכֹּל נִשְׁמָע בָּהּ.</tei:l>
          <tei:l>זֶה יוֹם רִאשׁוֹן אֶל הַתְּשׁוּבָה.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>יָשִׁיב אֵלָיו וְנָשֽׁוּבָה</tei:l>
          <tei:l>זֶה יוֹם רִאשׁוֹן אֶל הַתְּשׁוּבָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:zeh_yom_rishon_qaraite_33719/11"/>
        <tei:lg>
          <tei:l>ככתוב: ס֥וֹף דָּבָ֖ר הַכֹּ֣ל נִשְׁמָ֑ע</tei:l>
          <tei:l>אֶת־הָאֱלֹהִ֤ים יְרָא֙ וְאֶת־מִצְוֺתָ֣יו שְׁמ֔וֹר</tei:l>
          <tei:l>כִּי־זֶ֖ה כׇּל־הָאָדָֽם׃ <tei:bibl>(קהלת יב:יג)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
