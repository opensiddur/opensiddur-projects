  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:kavvanot_for_a_shacharit_service_goldsmith">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kavvanot_for_a_shacharit_service_goldsmith/4"/>
        <tei:lg>
          <tei:l>ברוך אתה ה׳ יוצר המאורות׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kavvanot_for_a_shacharit_service_goldsmith/6"/>
        <tei:lg>
          <tei:l>ברוך אתה ה׳ אוהב עמו ישראל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kavvanot_for_a_shacharit_service_goldsmith/8"/>
        <tei:lg xml:lang="yi">
          <tei:l>גאָט זאָל דיק בענטשן און דיך היטן!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kavvanot_for_a_shacharit_service_goldsmith/9"/>
        <tei:lg xml:lang="yi">
          <tei:l>גאָט זאָל דערלײַכטן זײַן פָּנִים צו דיר און דיך לײטזעליקן!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kavvanot_for_a_shacharit_service_goldsmith/10"/>
        <tei:lg xml:lang="yi">
          <tei:l>גאָט זאָל אױפֿהײגן זײַן פָּנִים צו דיר און דיר באַשערן שָׁלוֹם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kavvanot_for_a_shacharit_service_goldsmith/11"/>
        <tei:lg>
          <tei:l>שמע ישראל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kavvanot_for_a_shacharit_service_goldsmith/12"/>
        <tei:lg>
          <tei:l>אחד אלהינו</tei:l>
        </tei:lg>
      </tei:div>
