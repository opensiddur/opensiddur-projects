  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:orah_hee_hammer">
        <tei:head>Orah Hee (She is light), a piyyuṭ by Rabbi Jill Hammer (2008)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:orah_hee_hammer/1"/>
        <tei:lg>
          <tei:l>She is light, She is light.</tei:l>
          <tei:l>may She build her house</tei:l>
          <tei:l>soon, soon,</tei:l>
          <tei:l>speedily and in our days.</tei:l>
          <tei:l>Elah, build your house soon —</tei:l>
          <tei:l>close to us in time and space.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:orah_hee_hammer/2"/>
        <tei:lg>
          <tei:l>She is wisdom,</tei:l>
          <tei:l>She is joy,</tei:l>
          <tei:l>She is tears.</tei:l>
          <tei:l>may She build her house</tei:l>
          <tei:l>soon, soon,</tei:l>
          <tei:l>speedily and in our days.</tei:l>
          <tei:l>Elah, build your house soon —</tei:l>
          <tei:l>close to us in time and space.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:orah_hee_hammer/3"/>
        <tei:lg>
          <tei:l>She is splendor,</tei:l>
          <tei:l>She is a rose,</tei:l>
          <tei:l>She is a flowing stream.</tei:l>
          <tei:l>may She build her house</tei:l>
          <tei:l>soon, soon,</tei:l>
          <tei:l>speedily and in our days.</tei:l>
          <tei:l>Elah, build your house soon —</tei:l>
          <tei:l>close to us in time and space.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:orah_hee_hammer/4"/>
        <tei:lg>
          <tei:l>She is renewal,</tei:l>
          <tei:l>She is the center,</tei:l>
          <tei:l>She is oneness.</tei:l>
          <tei:l>may She build her house</tei:l>
          <tei:l>soon, soon,</tei:l>
          <tei:l>speedily and in our days.</tei:l>
          <tei:l>Elah, build your house soon —</tei:l>
          <tei:l>close to us in time and space.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:orah_hee_hammer/5"/>
        <tei:lg>
          <tei:l>She is the full moon,<tei:anchor xml:id="note_1"/></tei:l>
          <tei:l>She is birth,</tei:l>
          <tei:l>She is the fountain-source.</tei:l>
          <tei:l>may She build her house</tei:l>
          <tei:l>soon, soon,</tei:l>
          <tei:l>speedily and in our days.</tei:l>
          <tei:l>Elah, build your house soon —</tei:l>
          <tei:l>close to us in time and space.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:orah_hee_hammer/6"/>
        <tei:lg>
          <tei:l>She is comfort,</tei:l>
          <tei:l>She is forgiveness,</tei:l>
          <tei:l>She is strength.</tei:l>
          <tei:l>may She build her house</tei:l>
          <tei:l>soon, soon,</tei:l>
          <tei:l>speedily and in our days.</tei:l>
          <tei:l>Elah, build your house soon —</tei:l>
          <tei:l>close to us in time and space.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:orah_hee_hammer/7"/>
        <tei:lg>
          <tei:l>She is redemption,</tei:l>
          <tei:l>She is righteousness,</tei:l>
          <tei:l>She is holiness.</tei:l>
          <tei:l>may She build her house</tei:l>
          <tei:l>soon, soon,</tei:l>
          <tei:l>speedily and in our days.</tei:l>
          <tei:l>Elah, build your house soon —</tei:l>
          <tei:l>close to us in time and space.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:orah_hee_hammer/8"/>
        <tei:lg>
          <tei:l>She is a beloved companion,</tei:l>
          <tei:l>She is always changing,</tei:l>
          <tei:l>She is complete and perfect.</tei:l>
          <tei:l>may She build her house</tei:l>
          <tei:l>soon, soon,</tei:l>
          <tei:l>speedily and in our days.</tei:l>
          <tei:l>Elah, build your house soon —</tei:l>
          <tei:l>close to us in time and space.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
