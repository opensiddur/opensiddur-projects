  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:charoset_waskow">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:charoset_waskow/24"/>
        <tei:lg>
          <tei:l>סַמְּכוּנִי בָּאֲשִׁישׁוֹת רַפְּדוּנִי בַּתַּפּוּחִים...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:charoset_waskow/25"/>
        <tei:lg>
          <tei:l>...טוֹבִים דֹּדֶיךָ מִיָּיִן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:charoset_waskow/26"/>
        <tei:lg>
          <tei:l>...וְרֵיחַ אַפֵּךְ כַּתַּפּוּחִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:charoset_waskow/27"/>
        <tei:lg>
          <tei:l>לְחָיָו כַּעֲרוּגַת הַבֹּשֶׂם...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:charoset_waskow/28"/>
        <tei:lg>
          <tei:l>הַתְּאֵנָה חָנְטָה פַגֶּיהָ...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:charoset_waskow/29"/>
        <tei:lg>
          <tei:l>אֶל גִּנַּת אֱגוֹז יָרַדְתִּי...</tei:l>
        </tei:lg>
      </tei:div>
