  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/126">
        <tei:head>תהלים קכ״ו</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/126/1"/>
        <tei:lg>
          <tei:l>שִׁיר, הַמַּעֲלוֹת</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בְּשׁוּב יְהוָה, אֶת־שִׁיבַת צִיּוֹן– הָיִינוּ, כְּחֹלְמִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/126/2"/>
        <tei:lg>
          <tei:l>אָז יִמָּלֵא שְׂחוֹק, פִּינוּ– וּלְשׁוֹנֵנוּ רִנָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>אָז, יֹאמְרוּ בַגּוֹיִם– הִגְדִּיל יְהוָה, לַעֲשׂוֹת עִם־אֵלֶּה</tei:l>
          <tei:l>הִגְדִּיל יְהוָה, לַעֲשׂוֹת עִמָּנוּ– הָיִינוּ שְׂמֵחִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/126/4/a"/>
        <tei:lg>
          <tei:l>שׁוּבָה יְהוָה, אֶת שְׁבִיתֵנוּ כַּאֲפִיקִים בַּנֶּגֶב</tei:l>
          <tei:l>הַזֹּרְעִים בְּדִמְעָה– בְּרִנָּה יִקְצֹרוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/126/6"/>
        <tei:lg>
          <tei:l>הָלוֹךְ יֵלֵךְ, וּבָכֹה– נֹשֵׂא מֶשֶׁךְ־הַזָּרַע</tei:l>
          <tei:l>בֹּא־יָבֹא בְרִנָּה– נֹשֵׂא, אֲלֻמֹּתָיו</tei:l>
        </tei:lg>
      </tei:div>
