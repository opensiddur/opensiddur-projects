  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:chronicles_1/29">
        <tei:head>וַיְבָרֶךְ דָּוִיד</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:chronicles_1/29/10/a"/>
        <tei:lg>
          <tei:l>וַיְבָ֤רֶךְ דָּוִיד֙ אֶת־יְהוָ֔ה</tei:l>
          <tei:l>לְעֵינֵ֖י כָּל־הַקָּהָ֑ל</tei:l>
          <tei:l>וַיֹּ֣אמֶר דָּוִ֗יד</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בָּר֨וּךְ אַתָּ֤ה יְהוָה֙</tei:l>
          <tei:l>אֱלֹהֵי֙ יִשְׂרָאֵ֣ל אָבִ֔ינוּ</tei:l>
          <tei:l>מֵעוֹלָ֖ם וְעַד־עוֹלָֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:chronicles_1/29/11/a"/>
        <tei:lg>
          <tei:l>לְךָ֣ יְ֠הוָה</tei:l>
          <tei:l>הַגְּדֻלָּ֨ה</tei:l>
          <tei:l>וְהַגְּבוּרָ֤ה</tei:l>
          <tei:l>וְהַתִּפְאֶ֙רֶת֙</tei:l>
          <tei:l>וְהַנֵּ֣צַח</tei:l>
          <tei:l>וְהַה֔וֹד</tei:l>
          <tei:l>כִּי־כֹ֖ל בַּשָּׁמַ֣יִם וּבָאָ֑רֶץ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>לְךָ֤ יְהוָה֙ הַמַּמְלָכָ֔ה</tei:l>
          <tei:l>וְהַמִּתְנַשֵּׂ֖א לְכֹ֥ל ׀ לְרֹֽאשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:chronicles_1/29/12/a"/>
        <tei:lg>
          <tei:l>וְהָעֹ֤שֶׁר וְהַכָּבוֹד֙</tei:l>
          <tei:l>מִלְּפָנֶ֔יךָ</tei:l>
          <tei:l>וְאַתָּה֙ מוֹשֵׁ֣ל בַּכֹּ֔ל</tei:l>
          <tei:l>וּבְיָדְךָ֖ כֹּ֣חַ וּגְבוּרָ֑ה</tei:l>
          <tei:l>וּבְיָ֣דְךָ֔ לְגַדֵּ֥ל וּלְחַזֵּ֖ק לַכֹּֽל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:chronicles_1/29/13/a"/>
        <tei:lg>
          <tei:l>וְעַתָּ֣ה</tei:l>
          <tei:l>אֱלֹהֵ֔ינוּ</tei:l>
          <tei:l>מוֹדִ֥ים אֲנַ֖חְנוּ לָ֑ךְ</tei:l>
          <tei:l>וּֽמְהַֽלְלִ֖ים לְשֵׁ֥ם</tei:l>
          <tei:l>תִּפְאַרְתֶּֽךָ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
