    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_sukkot_zucker">
        <tei:head>הושענא למען השיקום, שנת תשפ״ו</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_sukkot_zucker/1"/>
        <tei:lg>
          <tei:l>הוֹשִׁיעָה נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_sukkot_zucker/2"/>
        <tei:lg>
          <tei:l>אָנָּא פְּתַח־נָא שַׁעֲרֵי יְשׁוּעָתְךָ מֵחָדָשׁ</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_sukkot_zucker/3"/>
        <tei:lg>
          <tei:l>לְמַעַנְךָ וּלְמַעֲנֵנוּ</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_sukkot_zucker/4"/>
        <tei:lg>
          <tei:l>לְמַעַן זִכְרָם שֶׁל כָּל הַהֲרוּגִים, אֲנָשִׁים, נָשִׁים וָטַף</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_sukkot_zucker/5"/>
        <tei:lg>
          <tei:l>לְמַעַן חֲזָרָתָם שֶׁל כָּל החֲטוּפוֹת וַהחֲטוּפִים, השְׁבוּיוֹת וּהשְׁבוּיִים</tei:l>
          <tei:l>[או לְמַעַן החֲטוּפוֹת וַהחֲטוּפִים, השְׁבוּיוֹת וּהשְׁבוּיִים הַמִּשְׁתַּחְרְרִים מִשִּׁבְיָם]</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_sukkot_zucker/6"/>
        <tei:lg>
          <tei:l>לְמַעַן מְנוּחָתָם שֶׁל הַחֲלָלִים שֶׁמָּקוֹם קְבוּרָתָם לֹא נוֹדַע.</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_sukkot_zucker/7"/>
        <tei:lg>
          <tei:l>לְמַעַן הַבְרָאָתָם שֶׁל כָּל פְּדוּיֵי הַשֶּׁבִי הָאָיֹם וּמִשְׁפְּחוֹתֵיהֶם</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_sukkot_zucker/8"/>
        <tei:lg>
          <tei:l>לְמַעַן רְפוּאָתָם שֶׁל הַפְּצוּעִים בַּגּוּף וּבַנֶּפֶשׁ</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_sukkot_zucker/9"/>
        <tei:lg>
          <tei:l>לְמַעַן שׁוּבָם שֶׁל הָעֲקוּרִים לְבָתֵּיהֶם</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_sukkot_zucker/10"/>
        <tei:lg>
          <tei:l>לְמַעַן חַיָּלֵי הַסָּדִיר והַמִּלּוּאִים הַמַּמְשִׁיכִים לְשָׁרֵת בְּנֶאֱמָנוּת</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_sukkot_zucker/11"/>
        <tei:lg>
          <tei:l>לְמַעַן הַמִּשְׁפָּחוֹת הַתּוֹמְכוֹת בָּעֹרֶף</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_sukkot_zucker/12"/>
        <tei:lg>
          <tei:l>לְמַעַן מַעֲשֵׂי הַחֶסֶד וְהִתְנַדְּבוּת הָרַבִּים</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_sukkot_zucker/13"/>
        <tei:lg>
          <tei:l>לְמַעַן הַיִּשּׁוּבִים הַקָּמִים מֵחֻרְבָּנָם</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_sukkot_zucker/14"/>
        <tei:lg>
          <tei:l>לְמַעַן כָּל אֵלּוּ שֶׁאֲנַחְנוּ מַזְכִּירִים בַּלֵּב</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_sukkot_zucker/15"/>
        <tei:lg>
          <tei:l>לְמַעַן אִחוּי הַקְּרָעִים בָּעָם</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_sukkot_zucker/16"/>
        <tei:lg>
          <tei:l>לְמַעַן קִיּוּם עַם יִשְׂרָאֵל בְּאַרְצוֹ</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_sukkot_zucker/17"/>
        <tei:lg>
          <tei:l>לְמַעַן הַסִּכּוּי לְשָׁלוֹם בַּר קְיָמָא</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_sukkot_zucker/18"/>
        <tei:lg>
          <tei:l>אָנָּא ה׳ הוֹשִׁיעָה נָּא</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
