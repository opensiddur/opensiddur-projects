      <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/first_day/before_piyyut">
        <j:transclude target="urn:x-opensiddur:text:prayer:miqveh_yisrael"/>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/first_day/after_first_selihah_rubric">
          <tei:pb n="12" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n26_medium.jpg"/>
          <j:conditional xml:id="after_first_selihah_rubric_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="repetitions_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:note type="instruction" xml:lang="en">Say from “Like a father hath compassion,” till “when we call,” page 9, then say the verses “For we do not presume,” and “O Lord hear,” pp. 9, 10. </tei:note>
          <j:endConditional target="#after_first_selihah_rubric_printed"/>
          <j:conditional xml:id="after_first_selihah_rubric_expanded">
            <tei:fs type="asher:expansions">
              <tei:f name="repetitions_present">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <j:transclude target="urn:x-opensiddur:text:prayer:adonai_boqer_tishma_qoli/repeat"/>
          <j:transclude target="urn:x-opensiddur:text:prayer:hateh_elohai_oznekha/repeat"/>
          <j:endConditional target="#after_first_selihah_rubric_expanded"/>
        </tei:div>
        <j:transclude target="urn:x-opensiddur:text:poem:im_avoneinu_rabu_lehagdil"/>
