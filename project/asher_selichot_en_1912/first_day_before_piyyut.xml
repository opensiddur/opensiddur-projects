            <tei:fs type="asher:expansions">
              <tei:f name="repetitions_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:note type="instruction" xml:lang="en">Say “Omnipotent King,” “And the Eternal passed,” &amp;c., pp. 11, 12. </tei:note>
          <j:endConditional target="#after_second_selihah_prayers_printed"/>
          <j:conditional xml:id="after_second_selihah_prayers_expanded">
            <tei:fs type="asher:expansions">
              <tei:f name="repetitions_present">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
