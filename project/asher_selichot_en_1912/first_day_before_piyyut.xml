          <j:transclude target="urn:x-opensiddur:text:prayer:hateh_elohai_oznekha/repeat"/>
          <j:endConditional target="#after_second_selihah_verses_expanded"/>
        </tei:div>
        <j:transclude target="urn:x-opensiddur:text:poem:tavo_lefanekha_shavat_hinnun"/>
