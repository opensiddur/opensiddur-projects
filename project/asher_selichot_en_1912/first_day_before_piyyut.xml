          </j:conditional>
          <tei:note type="instruction" xml:lang="en">Say from “Like a father hath compassion,” till “when we call,” page 9, then say the verses “For we do not presume,” and “O Lord hear,” pp. 9, 10. </tei:note>
          <j:endConditional target="#after_second_selihah_verses_printed"/>
