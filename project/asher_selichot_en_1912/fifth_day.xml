            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/fifth_day/final_prayer_cue/printed">
            <tei:pb n="41" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n84_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say “Omnipotent King,” “And the Eternal passed,” &amp;c., pp. 11, 12. </tei:note>
          </tei:div>
          <j:endConditional target="#fifth_final_prayer_cue_printed"/>
          <j:conditional xml:id="fifth_final_prayer_cue_expanded">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
