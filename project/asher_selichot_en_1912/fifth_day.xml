            <tei:pb n="41" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n84_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Conclude the Service as on the first day, commencing from “O Lord remember thy mercy,” page 16. The Reader says Kaddish. </tei:note>
          </tei:div>
          <j:endConditional target="#fifth_conclusion_instruction_printed"/>
