            <tei:fs type="opensiddur:holiday-aggregate">
              <tei:f name="aseret-ymei-tshuva">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:declare>
          <j:transclude target="urn:x-opensiddur:text:prayer:ashrei"/>
          <j:transclude target="urn:x-opensiddur:text:prayer:kaddish/selichot_preface"/>
          <j:transclude target="urn:x-opensiddur:text:prayer:kaddish/chatzi"/>
