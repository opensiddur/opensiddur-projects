        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tzom_gedaliah/selah_lanu_avinu">
          <tei:pb n="91" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n184_medium.jpg"/>
          <tei:p>Pardon us, our Father! for in the greatness of our folly we have gone astray. Forgive us, O our King! for our iniquities are numerous. </tei:p>
        </tei:div>
        <j:transclude target="urn:x-opensiddur:text:poem:az_terem_nimtehu_nivlei_shehaqim"/>
