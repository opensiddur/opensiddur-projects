      <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tzom_gedaliah">
        <tei:pb n="91" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n184_medium.jpg"/>
        <tei:head>PROPITIATORY PRAYERS FOR THE FAST OF GEDALIAH.</tei:head>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tzom_gedaliah/opening_instruction">
