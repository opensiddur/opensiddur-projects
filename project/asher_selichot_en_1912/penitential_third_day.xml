        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_third_day/selah_lanu_avinu">
          <tei:pb n="116" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n234_medium.jpg"/>
          <tei:p>Pardon us, our Father! for in the greatness of our folly we have gone astray. Forgive us, O our King! for our iniquities are numerous. </tei:p>
        </tei:div>
        <j:transclude target="urn:x-opensiddur:text:poem:eleikha_lev_venefesh_nishpokh_kamayim"/>
