        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_third_day/shuvah_adonai">
          <tei:pb n="122" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n246_medium.jpg"/>
          <tei:p>Turn again our captivity, O Lord, as the streams in the south. Return, O Lord, deliver my soul: O save me for thy mercies’ sake, and render unto our neighbours sevenfold into their bosom their reproach, wherewith they have reproached thee, O Lord. </tei:p>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_third_day/verses_after_shuvah">
