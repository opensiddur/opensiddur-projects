      <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_third_day">
        <tei:pb n="116" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n234_medium.jpg"/>
        <tei:head>PROPITIATORY PRAYERS FOR THE 3rd OF THE PENITENTIAL DAYS.</tei:head>
