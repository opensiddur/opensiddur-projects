          <j:transclude target="urn:x-opensiddur:text:prayer:vayaavor"/>
          <j:endConditional target="#seventh_first_prayer_cue_expanded"/>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/seventh_day/al_tiqtsof_ad_meod">
          <tei:pb n="46" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n94_medium.jpg"/>
          <tei:p>Be not sore wroth, O Lord, neither remember iniquity for ever; behold, we beseech thee, we are all thy people. Thy holy cities are a wilderness, Zion is a wilderness, Jerusalem a desolation. Our holy and our beautiful house, where our fathers praised thee, is burnt up with fire, and all our pleasant things are laid waste. The living, the living, he shall praise thee, as I do this day, the father shall make known thy truth to the children. </tei:p>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/seventh_day/verses_instruction">
          <j:conditional xml:id="seventh_verses_instruction_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/seventh_day/verses_instruction/printed">
            <tei:pb n="46" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n94_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say from “Like a father hath compassion,” till “when we call,” page 9, then say the verses “For we do not presume,” and “O Lord hear,” pp. 9, 10. </tei:note>
          </tei:div>
          <j:endConditional target="#seventh_verses_instruction_printed"/>
