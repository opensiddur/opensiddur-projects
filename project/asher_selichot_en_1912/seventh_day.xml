          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/seventh_day/refrain_instruction/printed">
            <tei:pb n="48" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n98_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Wherever the words (Help us, &amp;c.), occur at the end of the verses, repeat from “Help us,” till “we rest on thee.” </tei:note>
          </tei:div>
