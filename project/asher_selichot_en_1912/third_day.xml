          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/third_day/refrain_instruction/printed">
            <tei:pb n="32" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n64_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Wherever the words (Let my life, &amp;c.) occur at the end of the verses, repeat “Let my life,” till “my people at my request.” </tei:note>
          </tei:div>
