              </tei:f>
            </tei:fs>
          </j:conditional>
          <j:transclude target="urn:x-opensiddur:text:prayer:el_melekh_yoshev"/>
          <j:transclude target="urn:x-opensiddur:text:prayer:vayaavor"/>
          <j:endConditional target="#third_first_prayer_cue_expanded"/>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/third_day/keayal_taarog">
          <tei:pb n="31" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n66_medium.jpg"/>
          <tei:p>As the hart panteth after the brooks of water, so panteth my soul after thee, O God. For our soul is bowed down to the dust, our belly cleaveth unto the earth. Pour out thy wrath upon the heathen that have not known thee, and upon the kingdoms that have not called upon thy name, for they have devoured Jacob, and laid waste his dwelling-place. Arise, and be a help unto us, and redeem us for the sake of thy mercy. </tei:p>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/third_day/verses_instruction">
          <j:conditional xml:id="third_verses_instruction_printed">
