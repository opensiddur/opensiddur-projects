        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_fifth_day/eleikha_shivaati">
          <tei:pb n="143" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n288_medium.jpg"/>
          <tei:p>Unto thee, O Lord, have I cried; and in the morning shall my prayer prevent thee. Unto thee we lift up our eyes, O thou who dwellest in heaven. Unto thee, O Lord, I lift up my soul; have mercy upon us, O Lord, have mercy upon us: for we are exceedingly filled with contempt. </tei:p>
        </tei:div>
