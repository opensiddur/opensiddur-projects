      <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_fifth_day">
        <tei:pb n="140" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n282_medium.jpg"/>
        <tei:head>PROPITIATORY PRAYERS FOR THE FIFTH OF THE PENITENTIAL DAYS.</tei:head>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_fifth_day/opening_instruction">
