        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_fifth_day/haazinah_tefillatenu">
          <tei:pb n="148" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n298_medium.jpg"/>
          <tei:p>Give ear, O Lord, to our prayer, and attend to the voice of our supplication. Hear, O Lord, when we cry with our voice; have mercy also upon us, and answer us. Hear the right, O Lord, attend unto our cry; hear, O Lord, and have mercy upon us: Lord, be thou our helper. </tei:p>
        </tei:div>
