        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_fourth_day/selah_lanu_avinu">
          <tei:pb n="128" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n258_medium.jpg"/>
          <tei:p>Pardon us, our Father! for in the greatness of our folly we have gone astray. Forgive us, O our King! for our iniquities are numerous. </tei:p>
        </tei:div>
        <j:transclude target="urn:x-opensiddur:text:poem:eshet_neurim_haahuvah"/>
