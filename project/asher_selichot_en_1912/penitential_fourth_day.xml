      <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_fourth_day">
        <tei:pb n="128" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n258_medium.jpg"/>
        <tei:head>PROPITIATORY PRAYERS FOR THE FOURTH OF THE PENITENTIAL DAYS.</tei:head>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_fourth_day/opening_instruction">
