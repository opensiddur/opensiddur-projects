            <tei:note type="instruction" xml:lang="en">Say from “Enter not into judgment,” till “when we call,” page 52, then say the verses “For we do not presume,” and “O Lord, hear,” in the same page. </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_fourth_day_verses_after_veatah_printed"/>
