              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/fourth_day/verses_instruction/printed">
            <tei:pb n="35" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n72_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say from “Like a father hath compassion,” till “when we call,” page 9, then say the verses “For we do not presume,” and “O Lord hear,” pp. 9, 10. </tei:note>
          </tei:div>
          <j:endConditional target="#fourth_verses_instruction_printed"/>
