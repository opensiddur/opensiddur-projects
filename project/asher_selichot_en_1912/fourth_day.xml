            <tei:pb n="35" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n72_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say “Omnipotent King,” “And the Eternal passed,” &amp;c., pp. 11, 12. </tei:note>
          </tei:div>
          <j:endConditional target="#fourth_first_prayer_cue_printed"/>
          <j:conditional xml:id="fourth_first_prayer_cue_expanded">
