          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/fourth_day/refrain_instruction/printed">
            <tei:pb n="36" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n74_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Wherever the words (O my King and my God, &amp;c.), occur at the end of the verses, repeat from “O my King,” till “for unto thee I pray.” </tei:note>
          </tei:div>
