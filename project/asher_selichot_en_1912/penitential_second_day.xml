            <tei:pb n="104" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n210_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say from “Happy are they,” page 2, till “for it is great,” page 7, after which say the following— </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_second_day_opening_instruction_printed"/>
