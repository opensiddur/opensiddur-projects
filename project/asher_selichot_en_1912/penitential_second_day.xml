      <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_second_day">
        <tei:pb n="104" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n210_medium.jpg"/>
        <tei:head>PROPITIATORY PRAYERS FOR THE 2nd OF THE PENITENTIAL DAYS.</tei:head>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_second_day/opening_instruction">
