        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_second_day/selah_lanu_avinu">
          <tei:pb n="104" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n210_medium.jpg"/>
          <tei:p>Pardon us, our Father! for in the greatness of our folly we have gone astray. Forgive us, O our King! for our iniquities are numerous. </tei:p>
        </tei:div>
        <j:transclude target="urn:x-opensiddur:text:poem:shiharnukha_biqshanukha_yotser_harim"/>
