            <tei:note type="instruction" xml:lang="en">Say “For we confide in thee,” “O Omnipotent!” “And the Eternal passed,” pp. 8, 9. </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_second_day_after_shiharnukha_printed"/>
