        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_second_day/heitivah">
          <tei:pb n="108" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n218_medium.jpg"/>
          <tei:p>Do good in thy good pleasure unto Zion: build thou the walls of Jerusalem. Save us, O God, for the waters are come in unto our soul. Shew us thy mercy, O Lord, and grant us thy salvation. </tei:p>
        </tei:div>
