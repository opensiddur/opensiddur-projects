        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_second_day/atah_adonai">
          <tei:pb n="107" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n216_medium.jpg"/>
          <tei:p>Withhold not thou thy tender mercies from us, O Lord: let thy loving-kindness and thy truth continually preserve us. O Israel, return unto the Lord thy God; for thou hast fallen by thine iniquity. For the Lord heareth the poor, and despiseth not his prisoners. </tei:p>
        </tei:div>
