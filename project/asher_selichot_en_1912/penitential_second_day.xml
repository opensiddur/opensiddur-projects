          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_second_day/verses_after_ki_immekha/printed">
            <tei:pb n="110" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n222_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say from “Thy mercy is great,” till “when we call,” page 52, then say the verses “For we do not presume,” and “O Lord, hear,” in the same page. </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_second_day_verses_after_ki_immekha_printed"/>
