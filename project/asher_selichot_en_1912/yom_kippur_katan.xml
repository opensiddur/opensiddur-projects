              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/pair_after_hashivenu/printed">
            <tei:pb n="191" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n384_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say “Omnipotent King,” “And the Eternal passed,” &amp;c., pp. 11, 12. </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_yom-kippur-katan_day_pair_after_hashivenu_printed"/>
          <j:conditional xml:id="penitential_yom-kippur-katan_day_pair_after_hashivenu_expanded">
