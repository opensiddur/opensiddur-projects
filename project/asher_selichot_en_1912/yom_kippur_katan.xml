              </tei:f>
            </tei:fs>
          </j:declare>
          <j:transclude target="urn:x-opensiddur:text:prayer:kaddish/shalem"/>
          <j:endDeclare target="#penitential_yom-kippur-katan_reader_kaddish_conclusion_kaddish"/>
          <j:endConditional target="#penitential_yom-kippur-katan_day_reader_kaddish_conclusion_expanded"/>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/psalm_end_instruction">
          <tei:pb n="202" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n406_medium.jpg"/>
          <tei:note type="instruction" xml:lang="en">If the Eve of New Moon is on Sabbath or Sunday the Psalm, page 190, is said instead of the following— </tei:note>
        </tei:div>
        <j:transclude target="urn:x-opensiddur:text:bible:psalms/8"/>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/conclusion">
          <j:conditional xml:id="penitential_yom-kippur-katan_day_conclusion_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/conclusion/printed">
            <tei:pb n="203" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n408_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say “It is incumbent on us.” A Mourner says Kaddish. </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_yom-kippur-katan_day_conclusion_printed"/>
          <j:conditional xml:id="penitential_yom-kippur-katan_day_conclusion_expanded">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <j:transclude target="urn:x-opensiddur:text:siddur:chol/shacharit/conclusion/aleinu"/>
          <tei:div>
            <tei:note type="instruction" xml:lang="en">Mourner.</tei:note>
          </tei:div>
