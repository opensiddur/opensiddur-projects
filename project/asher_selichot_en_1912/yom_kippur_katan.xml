            <tei:milestone unit="prayer" corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/verses_after_tov/expanded"/>
            <tei:p><j:transclude target="urn:x-opensiddur:text:prayer:adonai_boqer_tishma_qoli/repeat" type="inline"/> <j:transclude target="urn:x-opensiddur:text:prayer:hateh_elohai_oznekha/repeat" type="inline"/> </tei:p>
            <tei:milestone unit="prayer"/>
          </tei:div>
          <j:endConditional target="#penitential_yom-kippur-katan_day_verses_after_tov_expanded"/>
        </tei:div>
