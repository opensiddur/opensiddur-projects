              </tei:f>
            </tei:fs>
          </j:declare>
          <j:transclude target="urn:x-opensiddur:text:prayer:kaddish/yatom"/>
          <j:endDeclare target="#penitential_yom-kippur-katan_conclusion_kaddish"/>
