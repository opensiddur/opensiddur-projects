      <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan">
        <tei:pb n="188" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n378_medium.jpg"/>
        <tei:head>PRAYERS FOR THE DAY BEFORE NEW MOON.</tei:head>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/opening_instruction">
          <tei:pb n="188" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n378_medium.jpg"/>
          <tei:note type="instruction" xml:lang="en">It is customary for the pious to fast on the day preceding the New Moon. If the New Moon falls on Sabbath or Sunday the fast is held on the preceding Thursday. Those who fast put on the Taleth and Tephillin. The Reader commences the following— </tei:note>
        </tei:div>
        <j:transclude target="urn:x-opensiddur:text:bible:psalms/102"/>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/refrain_instruction">
          <j:conditional xml:id="penitential_yom-kippur-katan_day_refrain_instruction_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="refrains_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/refrain_instruction/printed">
            <tei:pb n="189" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n380_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Wherever the words (Let, &amp;c.) occur at the end of verses, repeat from “Let the weight,” till “bring forth buds.” </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_yom-kippur-katan_day_refrain_instruction_printed"/>
        </tei:div>
        <j:transclude target="urn:x-opensiddur:text:poem:yom_zeh_yehi_mishqal_kol_hattotai"/>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/psalm_order_instruction">
          <tei:pb n="190" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n382_medium.jpg"/>
          <tei:note type="instruction" xml:lang="en">Some Congregations say here Psalm viii., page 202, instead of the following Psalm, and say the following Psalm at the end of the Service. But when the New Moon is on Sabbath or Sunday, the order of Service is not altered. </tei:note>
        </tei:div>
        <j:transclude target="urn:x-opensiddur:text:bible:psalms/20"/>
