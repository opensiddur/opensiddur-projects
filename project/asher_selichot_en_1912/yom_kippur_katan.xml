        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/rahmana_instruction">
          <tei:pb n="196" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n394_medium.jpg"/>
