  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:inauguration_day_benediction_for_president_john_f_kennedy_glueck">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:inauguration_day_benediction_for_president_john_f_kennedy_glueck/6"/>
        <tei:lg>
          <tei:l>יברכך יי</tei:l>
          <tei:l>וישמרך:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:inauguration_day_benediction_for_president_john_f_kennedy_glueck/7"/>
        <tei:lg>
          <tei:l>יאר יי פניו אליך</tei:l>
          <tei:l>ויחנך:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:inauguration_day_benediction_for_president_john_f_kennedy_glueck/8"/>
        <tei:lg>
          <tei:l>ישא יי פניו אליך</tei:l>
          <tei:l>וישם לך שלום:</tei:l>
        </tei:lg>
      </tei:div>
