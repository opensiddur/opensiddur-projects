      <tei:div corresp="urn:x-opensiddur:text:poem:shalom_lekh_dodi_gabirol">
        <tei:head>שָׁלוֹם לְךָ (לְבֶן) דּוֹדִי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shalom_lekh_dodi_gabirol/1"/>
        <tei:lg>
          <tei:l>שָׁלוֹם לְךָ (לְבֶן) דּוֹדִי</tei:l>
          <tei:l>הַצַּח וְהָאַדְמוֹן</tei:l>
          <tei:l>שָׁלוֹם לְךָ מֵאֵת</tei:l>
          <tei:l>רַקָּה כְמוֹ רִמּוֹן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shalom_lekh_dodi_gabirol/2"/>
        <tei:lg>
          <tei:l>לִקְרַאת אֲחוֹתְךָ רוּץ</tei:l>
          <tei:l>צֵא נָא לְהוֹשִׁיעָהּ</tei:l>
          <tei:l>וּצְלַח כְּבֶן יִשָׁי</tei:l>
          <tei:l>רַבַּת בְּנֵי עַמּוֹן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shalom_lekh_dodi_gabirol/3"/>
        <tei:lg>
          <tei:l>מַה לָּךְ יְפֵהפִיָּה</tei:l>
          <tei:l>כִּי תְעוֹרְרִי אַהֲבָה</tei:l>
          <tei:l>וּתְצַלְצְלִי קוֹלֵךְ</tei:l>
          <tei:l>כַּמְעִיל בְּקוֹל פַּעֲמוֹן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shalom_lekh_dodi_gabirol/4"/>
        <tei:lg>
          <tei:l>הָעֵת אֲשֶׁר תַּחְפּוֹץ</tei:l>
          <tei:l>אַהֲבָה אֲחִישֶׁנָּה</tei:l>
          <tei:l>עִתָּהּ וְעָלַיִךְ</tei:l>
          <tei:l>אֵרֵד כְּטַל חֶרְמוֹן</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
