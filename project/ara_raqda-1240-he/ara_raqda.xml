    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ara_raqda">
        <tei:head>אַרְעָא רַקְדָא</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ara_raqda/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אַ</tei:seg>רְעָא רַקְדָא שְׁמַיָּא זַמָרוּ</tei:l>
          <tei:l>כָד אֶרִיס קֵירִיס לִבְרַתֶּיהּ דְּיַעֲקֹב בְּמִיפְּקָה לְחֵירוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ara_raqda/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>אֶצְבַּעְתֵּיהּ יְהַב לַהּ חָמֶשׁ עִיזְקַן דִּנְהִירוּ</tei:l>
          <tei:l>עַל כׇּל עִיזְקָא וְעִיזְקָא אַרְבָּעָא טָבְּעִין בִּבְהִירוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ara_raqda/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">גְ</tei:seg>בִילָן בְּצִדְקָא חֲסִימַן בְּרִינָא</tei:l>
          <tei:l>נְקִישַׁן בְּחִסְדָּא טְבִיעַן בַּחֲסִינָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ara_raqda/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">דְּ</tei:seg>הַב אוֹבְרִיזָא אִינוּן עִזְקַן אַחֲסָנָא</tei:l>
          <tei:l>חֲמֶשׁ סִפְרֵי אוֹרָיְתָא מוֹהֲרָא דְּמַטְרוֹנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ara_raqda/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ה</tei:seg>וּא יְהַב בִּיְדָא עֲשָׂר יְקְַנְתָּיָא</tei:l>
          <tei:l>מוֹהֲרָא קַדְמָאָה דַּחֲבִיבָיָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ara_raqda/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וּ</tei:seg>תְלַת מַאֲוַן וְשִׁיתִּין וְחָמֶשׁ מַרְגְּלַיָא</tei:l>
          <tei:l>מוֹהֲרָא תִנְיָינָא דַחֲבִיבְתָּא בְּאַפְּרֵי אַפְּרַיָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ara_raqda/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זְ</tei:seg>מַרַגְדִין אַרְבֲּעִין וְתַמְנֵי וּתַרְתֵּין מַאֲוַן</tei:l>
          <tei:l>מַתְלְיַן עַל צַוְארָא דְּכַלְתָא וּבְסִפְוַן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ara_raqda/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חֲ</tei:seg>טַף לַאֲרוּסְתֵּיהּ מִבֵּין בַּתְרַיָא בְּחֶזֶוַן</tei:l>
          <tei:l>כַּד אַרְתֶּיק עַל תַּרְעָא וְהָוַת דַּמְכַא בְּתַוַן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ara_raqda/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">טְ</tei:seg>עַן יָתָהּ עַל גַּפֵּי נִישְׁרִין</tei:l>
          <tei:l>וְאוֹכִיל לָהּ סִילְוָא בְּאוּרְתָּא וּמַנָּא בְּצַפְרִין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ara_raqda/10"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>מָא בְּזַע לַהּ גְנוֹן בְּסִינַי קְטַר לָהּ בִּזֵיהוֹרִין</tei:l>
          <tei:l>מַלְאֲכָיָא שׁוֹשְׁבִינִין וּמֹשֶׁה בַּר גְּנוֹן דְּפַנְטֵירִין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ara_raqda/11"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כְּ</tei:seg>לִיל מַלְכוּ בְּרֵישָא וְעַל יְדָהָא שֵׁירִין</tei:l>
          <tei:l>עֲגִילִין בְּאוּדְנָא וְטַבְּעִין אַנְחִירִין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ara_raqda/12"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>בוּשָׁא דְּרִקְמָא מְסָאֲנָה דְּסַסְגוֹנִין מְצַיְרִין</tei:l>
          <tei:l>לְבוּשׁ שְׁזִיר וְתִכְלָא הֲוַת פֵירְזוֹמָא בְּשׁוּפְרִין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ara_raqda/13"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>ן צוּרְתָּא דְּאָבוּהָא כַּד אָתָת לְמִיפַּק</tei:l>
          <tei:l>אֲעַלַת לַאֲרִיסטֵיהּ תַּרְעִין דְּקוּסְמָרִין בְּעִיבִידְתֵּיה לְמִרְפַּק</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ara_raqda/14"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נַ</tei:seg>עֲבֵּיד וּנְקַבֵּיל מִשְׁתָּעִין בַּתְרֵיהוֹן דְּלָא לְפַקְפֶּק</tei:l>
          <tei:l>וּמִתְפַּרְשִׁין קֳדָם חַתְנָא וְיֶחֱדֵי וְכַלְתָא תִּידּוּץ בִּדְיַסְפֶּק</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ara_raqda/15"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">סְ</tei:seg>לִים יִתְקְבַע לָהּ דְּתִיסַק לִגְנוּנָא</tei:l>
          <tei:l>מִן צוּרְתָּא דְּאָבוּהָא לְכוּרְסֵיהּ דְחַתְנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ara_raqda/16"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">עָ</tei:seg>דְרִין בָּהּ שַׁבְעִין בְּתוּלִין לְשָׁנָנָא</tei:l>
          <tei:l>דְּלֵיהֲוַן הַכְּכָמָכָא בַּחֲלָבָא עַל דּוּבְשָׁא לְאִיתְלַבָּנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ara_raqda/17"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>רַת לְמִקְטוֹר בְּמַדְבְּרָא גְּנוֹן נְהוֹרָא לַאֲרוּסְתָּא</tei:l>
          <tei:l>גְּנוֹן לְגוֹ מִן גְּנוֹן דְלֵיהֱוָן צְנוּעִין בִּשְׁבִיסְתָּא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ara_raqda/18"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">צַ</tei:seg>וְארָהּ לְמִידְמוּךְ בֵּינֵי תְּרֵין בְּרִיזָתָא</tei:l>
          <tei:l>וְקַצְוַתָא דִּרְסִיסִין תַּלְיַן אַפּוּתָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ara_raqda/19"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ק</tei:seg>וֹמְתָה כְּתַמְרָא כִסְגוּלִין תַּדְיָא</tei:l>
          <tei:l>קְדָלָא שִׁיַע כְּעֲמּוּד שֵׁן דְּפִילָיָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ara_raqda/20"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רֵ</tei:seg>ישָׁא כְּכַרְמְלָא קְלִיעָתָא בְּאַרְגְּוָנַיָא</tei:l>
          <tei:l>רֵיחָא דִּנְחִירָא כְּרֵיחָא דְחִיזוּרָיָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ara_raqda/21"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שַׁ</tei:seg>רְרָא לְאִדְּרָא דְּזֵיתָא כְּגוֹן עֲרֵימַת חִיטִין</tei:l>
          <tei:l>מַקְפַן שׁוֹשַׁנִּין חֲנִיטִין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ara_raqda/22"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">תְּ</tei:seg>קוֹף עֵינָהָא כִּתְרֵין בְּרֵיכַן דְחַבְטִין בְּאַפִּין קְשִׁיטִין</tei:l>
          <tei:l>וּנְחִירָא זְקִיף כְצִפִּיתָא דְּדַמָשֶׁק וְלָא מְחַמְטִין</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
