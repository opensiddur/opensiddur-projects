    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:candlelighting_for_rosh_hashanah_waskow">
        <tei:head>לִשְׁמֹר הַשָּׁנָה שֶׁל שְׁמִטָּה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:candlelighting_for_rosh_hashanah_waskow/1"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה [בְּרוּכַה אַתְּ] יָהּ</tei:l>
          <tei:l>אֱלֹהֵֽינוּ רוּחַ הָעוֹלָם</tei:l>
          <tei:l>אֲשֶׁר קִדְּשָֽׁנוּ בְּמִצְוֺת</tei:l>
          <tei:l>וְצִוָּֽנוּ לִשְׁמֹר הַשָּׁנָה שֶׁל שְׁמִטָּה</tei:l>
          <tei:l>שַׁבַּת שַׁבָּתוֹן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:candlelighting_for_rosh_hashanah_waskow/2"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה [בְּרוּכַה אַתְּ] יָהּ</tei:l>
          <tei:l>אֱלֹהֵֽינוּ רוּחַ הָעוֹלָם</tei:l>
          <tei:l>כִּי לֵךְ הָאָרֶץ</tei:l>
          <tei:l>כִּי גֵּרִים וְתוֹשָׁבִים אֲנַחְנוּ אִמֵּךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:candlelighting_for_rosh_hashanah_waskow/3"/>
        <tei:lg>
          <tei:l>בְּרוּכַה אַתְּ [בָּרוּךְ אַתָּה] יָהּ</tei:l>
          <tei:l>אֱלֹהֵֽינוּ רוּחַ הָעוֹלָם</tei:l>
          <tei:l>אֲשֶׁר קִדְּשָֽׁנוּ בְּמִצְוֺת</tei:l>
          <tei:l>וְצִוָּנוּ לְהַדְלִיק נֵר שֶׁל שֶׁל יוֹם טוֹב (<tei:note type="instruction">או:</tei:note> שַׁבָּת)׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:candlelighting_for_rosh_hashanah_waskow/4"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה [בְּרוּכַה אַתְּ] יָהּ</tei:l>
          <tei:l>אֱלֹהֵֽינוּ רוּחַ הָעוֹלָם</tei:l>
          <tei:l>שֶׁהֶחֱיָֽנוּ</tei:l>
          <tei:l>וְקִיְּמָנֽוּ</tei:l>
          <tei:l>וְהִגִּיעָֽנוּ לַזְּמַן הַזֶּה׃</tei:l>
        </tei:lg>
      </tei:div>
