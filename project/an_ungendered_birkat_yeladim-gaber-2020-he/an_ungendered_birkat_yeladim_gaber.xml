    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:an_ungendered_birkat_yeladim_gaber">
        <tei:head>ברכת הילדים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:an_ungendered_birkat_yeladim_gaber/1"/>
        <tei:lg>
          <tei:l>יְשִֽׂמְךָ֣ אֱלֹהִ֔ים כְּאֶפְרַ֖יִם וְכִמְנַשֶּׁ֑ה׃ <tei:bibl>(בראשית מח:כ)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:an_ungendered_birkat_yeladim_gaber/2"/>
        <tei:lg>
          <tei:l>יְשַׁלֵּ֥ם יְהוָ֖ה פָּעֳלֵ֑ךְ וּתְהִ֨י מַשְׂכֻּרְתֵּ֜ךְ שְׁלֵמָ֗ה׃ <tei:bibl>(רות ב:יב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:an_ungendered_birkat_yeladim_gaber/3"/>
        <tei:lg>
          <tei:l>יְבָרֶכְךָ֥ יְהוָ֖ה וְיִשְׁמְרֶֽךָ׃</tei:l>
          <tei:l>יָאֵ֨ר יְהוָ֧ה ׀ פָּנָ֛יו אֵלֶ֖יךָ וִֽיחֻנֶּֽךָּ׃</tei:l>
          <tei:l>יִשָּׂ֨א יְהוָ֤ה ׀ פָּנָיו֙ אֵלֶ֔יךָ וְיָשֵׂ֥ם לְךָ֖ שָׁלֽוֹם׃ <tei:bibl>(במדבר ו:כד-כו)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
