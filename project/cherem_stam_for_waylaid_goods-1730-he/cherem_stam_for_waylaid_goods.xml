    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:cherem_stam_for_waylaid_goods">
        <tei:head>חֵרֶם סְתָם</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:cherem_stam_for_waylaid_goods/1"/>
        <tei:lg>
          <tei:l>בְּבֵית־דִּין שֶׁל־מַעֲלָה וּבְבֵית־דִּין שֶׁל־מַטָּה</tei:l>
          <tei:l>עַל־דַּֽעַת הַמָּקוֹם בָּרוּךְ הוּא</tei:l>
          <tei:l>וְעַל־דַּֽעַת הַקָּהָל</tei:l>
          <tei:l>אָֽנוּ גּוֹזְרִין בְּחֵֽרֶם חָמוּר</tei:l>
          <tei:l>עַל כׇּל־אִישׁ וְאִשָּׁה</tei:l>
          <tei:l>אוֹ בָּחוּר אוֹ בְּתוּלָה</tei:l>
          <tei:l>אֲשֶׁר יָדְעוּ רֶֽמֶז אוֹ רְמִיזָה</tei:l>
          <tei:l>מִגְּנֵיבַת אוֹ מַאֲבִידַת</tei:l>
          <tei:l>מִכׇּל־מָה שֶׁהִכְרִיז הַשַּׁמָּשׁ</tei:l>
          <tei:l>יָבוֹא וְיַגִּיד לְרפב״פ</tei:l>
          <tei:l>וְאִם־ל֥וֹא יַגִּ֖יד וְנָשָׂ֥א עֲוֺנֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:cherem_stam_for_waylaid_goods/2"/>
        <tei:lg>
          <tei:l>לֹא־יֹאבֶ֣ה יְהֹוָה֮ סְלֹ֣חַֽ לוֹ֒</tei:l>
          <tei:l>כִּ֣י אָ֠ז יֶעְשַׁ֨ן אַף־יְהֹוָ֤ה</tei:l>
          <tei:l>וְקִנְאָתוֹ֙ בָּאִ֣ישׁ הַה֔וּא אוֹ בְּאִשָּׁה הַהִיא</tei:l>
          <tei:l>וְרָ֤בְצָה בּוֹ֙ כׇּל־הָ֣אָלָ֔ה הַכְּתוּבָ֖ה בַּסֵּ֣פֶר הַתּוֹרָה הַזֶּ֑ה</tei:l>
          <tei:l>וּמָחָ֤ה יְהֹוָה֙ אֶת־שְׁמ֔וֹ מִתַּ֖חַת הַשָּׁמָֽיִם׃</tei:l>
          <tei:l>וְהִבְדִּיל֤וֹ יְהֹוָה֙ לְרָעָ֔ה מִכֹּ֖ל שִׁבְטֵ֣י יִשְׂרָאֵ֑ל</tei:l>
          <tei:l>כְּכֹל֙ אָל֣וֹת הַבְּרִ֔ית הַכְּתוּבָ֕ה בְּסֵ֥פֶר הַתּוֹרָ֖ה הַזֶּֽה׃ <tei:bibl>(דברים כט:כ)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:cherem_stam_for_waylaid_goods/3"/>
        <tei:lg>
          <tei:l>וּשְׁאֵרִית יִשְׂרָאֵל יִהְיוּ נְקִיִּים</tei:l>
          <tei:l>וְנֹאמַר אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:cherem_stam_for_waylaid_goods/4"/>
        <tei:lg>
          <tei:l>מִי שֶׁבֵּירַךְ אֲבוֹתֵֽינוּ</tei:l>
          <tei:l>אַבְרָהָם יִצְחָק וְיַעֲקֹב</tei:l>
          <tei:l>מֹשֶׁה וְאַהֲרֹן</tei:l>
          <tei:l>דָּוִד וּשְׁלֹמֹה</tei:l>
          <tei:l>הוּא יְבָרֵךְ אֶת כׇּל־מִי־וָמִי שֶׁאֵינוֹ יוֹדֵֽעַ מֵעִנְיְנֵי גְּנֵיבוֹת וַאֲבֵידוֹת</tei:l>
          <tei:l>מִכׇּל־מָה שֶׁהִכְרִיז הַשַּׁמָּשׁ</tei:l>
          <tei:l>אוֹ מִי שֶׁיּוֹדֵֽעַ וְיָבוֹא וְיַגִּיד</tei:l>
          <tei:l>וְלֹא־יַעֲלִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:cherem_stam_for_waylaid_goods/5"/>
        <tei:lg>
          <tei:l>יַהֲפֹךְ יְהֹוָה עָלָיו אֶת־כׇּל־הַקְּלָלוֹת לִבְרָכוֹת</tei:l>
          <tei:l>וְיִשְׁמְרֵֽהוּ וְיַצִּילֵֽהוּ</tei:l>
          <tei:l>מִכׇּל־צָרָה וְצוּקָה</tei:l>
          <tei:l>וּמִכׇּל־נֶֽגַע וּמַחֲלָה</tei:l>
          <tei:l>וְיִשְׁלַח בְּרָכָה וְהַצְלָחָה בְּכׇל־מַעֲשֵׂה יָדָיו</tei:l>
          <tei:l>עִם כׇּל־יִשְׂרָאֵל אֶחָיו</tei:l>
          <tei:l>וְנֹאמַר אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
