  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:amulet_for_protection_from_the_plague_teitelbaum">
        <tei:head>קמע לשמירת המגפה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:amulet_for_protection_from_the_plague_teitelbaum/1"/>
        <tei:lg>
          <tei:l>בזה השער, לא יבוא צער׃</tei:l>
          <tei:l>בזה הדלת, לא יבוא בהלת׃</tei:l>
          <tei:l>בזה הפתח, לא יבוא רצח׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:amulet_for_protection_from_the_plague_teitelbaum/2"/>
        <tei:lg>
          <tei:l>וַיַּעֲמֹ֣ד פִּֽ֭ינְחָס וַיְפַלֵּ֑ל</tei:l>
          <tei:l>וַ֝תֵּעָצַ֗ר הַמַּגֵּפָֽה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:amulet_for_protection_from_the_plague_teitelbaum/3"/>
        <tei:lg>
          <tei:l>רבש״ע</tei:l>
          <tei:l>כשם שפסחת על בתי בני ישראל במצרים</tei:l>
          <tei:l>ולא נתת המשחית לבוא אל בתיהם</tei:l>
          <tei:l>כן תעצור המשחית מלבוא אל בתינו</tei:l>
          <tei:l>ובבתי כל ישראל</tei:l>
          <tei:l>אמן סלה ועד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:amulet_for_protection_from_the_plague_teitelbaum/4"/>
        <tei:lg>
          <tei:l>אימי׳ דאברהם אבינו׃</tei:l>
          <tei:l>אמתלאי בת כרנבו׃</tei:l>
          <tei:l>ושם בת אשר סרח׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:amulet_for_protection_from_the_plague_teitelbaum/5"/>
        <tei:lg xml:lang="yi">
          <tei:l>דוא האטמאן שױן געפאקט געמוזעלט אין געשארלאכט</tei:l>
        </tei:lg>
      </tei:div>
