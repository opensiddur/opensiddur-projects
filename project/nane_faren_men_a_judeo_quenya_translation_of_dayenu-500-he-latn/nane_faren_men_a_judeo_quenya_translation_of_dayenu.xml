  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu/1"/>
        <tei:lg xml:lang="qya">
          <tei:l>Rimi márë tyeller nar i iluasto menna!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu/2"/>
        <tei:lg xml:lang="qya">
          <tei:l>Qui men ettulyanë Lenwalto,</tei:l>
          <tei:l>apa lá carnë tien námai,</tei:l>
          <tei:l>nánë faren men!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu/3"/>
        <tei:lg xml:lang="qya">
          <tei:l>Qui carnë tien námai,</tei:l>
          <tei:l>apa lá carnë cordontin,</tei:l>
          <tei:l>nánë faren men!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu/4"/>
        <tei:lg xml:lang="qya">
          <tei:l>Qui carnë cordontin,</tei:l>
          <tei:l>apa lá nacantë minnónantain,</tei:l>
          <tei:l>nánë faren men!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu/5"/>
        <tei:lg xml:lang="qya">
          <tei:l>Qui nacantë minnónantain,</tei:l>
          <tei:l>apa lá men antanë armantá,</tei:l>
          <tei:l>nánë faren men!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu/6"/>
        <tei:lg xml:lang="qya">
          <tei:l>Qui men antanë armantá,</tei:l>
          <tei:l>apa lá rámen hyandë i ëara,</tei:l>
          <tei:l>nánë faren men!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu/7"/>
        <tei:lg xml:lang="qya">
          <tei:l>Qui rámen hyandë i ëara,</tei:l>
          <tei:l>apa lá men tertulyanes parcain,</tei:l>
          <tei:l>nánë faren men!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu/8"/>
        <tei:lg xml:lang="qya">
          <tei:l>Qui men tertulyanes parcain,</tei:l>
          <tei:l>apa lá quostanë cottor mis,</tei:l>
          <tei:l>nánë faren men!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu/9"/>
        <tei:lg xml:lang="qya">
          <tei:l>Qui quostanë cottor mis,</tei:l>
          <tei:l>apa lá sornë sangiëmman ravandassë ter canquain yénion,</tei:l>
          <tei:l>nánë faren men!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu/10"/>
        <tei:lg xml:lang="qya">
          <tei:l>Qui sornë sangiëmman ravandassë ter canquain yénion,</tei:l>
          <tei:l>apa lá men maitanë i menelmatson,<tei:anchor xml:id="note_1"/></tei:l>
          <tei:l>nánë faren men!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu/11"/>
        <tei:lg xml:lang="qya">
          <tei:l>Qui men maitanë i menelmatson,</tei:l>
          <tei:l>apa lá men antanë i sendaren,</tei:l>
          <tei:l>nánë faren men!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu/12"/>
        <tei:lg xml:lang="qya">
          <tei:l>Qui men antanë i sendaren,</tei:l>
          <tei:l>apa lá men amnatulyanë Oronta Sinayo,</tei:l>
          <tei:l>nánë faren men!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu/13"/>
        <tei:lg xml:lang="qya">
          <tei:l>Qui men amnatulyanë Oronta Sinayo,</tei:l>
          <tei:l>apa lá men antanë i Axaní,</tei:l>
          <tei:l>nánë faren men!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu/14"/>
        <tei:lg xml:lang="qya">
          <tei:l>Qui men antanë i Axaní,</tei:l>
          <tei:l>apa lá men mitulyanë nórenna Irrahelo,</tei:l>
          <tei:l>nánë faren men!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu/15"/>
        <tei:lg xml:lang="qya">
          <tei:l>Qui men mitulyanë nórenna Irrahelo,</tei:l>
          <tei:l>apa lá men carastanë oromára cilmëo,</tei:l>
          <tei:l>nánë faren men!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" n="1" target="#note_1">
      <tei:p>Purposely using the more archaic form matso rather than the standard NQ matto because it sounds like “matzo” and I think that’s fun for a Pesaḥ song</tei:p>
    </tei:note>
  </tei:standOff>
