    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:asher_biglal_avot_banim_gidel">
        <tei:head>אֲשֶׁר בִּגְלַל אָבוֹת בָּנִים גִּדֵּל</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:asher_biglal_avot_banim_gidel/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אֲ</tei:seg>שֶׁר בִּגְלַל אָבוֹת בָּנִים גִּדֵּל</tei:l>
          <tei:l>וּבַעֲבוּרָם תּוֹרָה נָתַן.</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>גַלְגַּלֵּי רֽוּחַ יהוה נִגְלֶה</tei:l>
          <tei:l>בְּמַלְאֲכֵי צָבָא בְּאַלְפֵי שִׁנְאָן.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:asher_biglal_avot_banim_gidel/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">גִּ</tei:seg>בּוֹר גֵּאִים אֱלֽוֹהַּ אַדִּיר</tei:l>
          <tei:l>קָרָא לְמֹשֶׁה לְקַבֵּל לוּחוֹת.</tei:l>
          <tei:l><tei:seg type="acrostic">דִּ</tei:seg>בְרֵי אֵל־חַי שָׁמְעָה הָאָֽרֶץ</tei:l>
          <tei:l>וְ֝עַמּוּדֶ֗יהָ יִתְפַּלָּצֽוּן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:asher_biglal_avot_banim_gidel/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הִ</tei:seg>טָּה שָׁמַֽיִם וַיֵּֽרֶד בִּכְרוּב</tei:l>
          <tei:l>וַ֝יֵּ֗דֶא עַל־כַּנְפֵי־רֽוּחַ׃</tei:l>
          <tei:l><tei:seg type="acrostic">וַ</tei:seg>יֵּצְאוּ דְּבָרִים מִתּוֹךְ הָאֵשׁ</tei:l>
          <tei:l>וַיִּתְחוֹקְקוּ עַל־לוּחוֹת הָאֶֽבֶן.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:asher_biglal_avot_banim_gidel/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זְ</tei:seg>מִירוֹת נָתְנוּ כׇּל־בְּנֵי אֱלֹהִים</tei:l>
          <tei:l>שׁוֹפָר תָּקַע מִשְּׁמֵי מָרוֹם.</tei:l>
          <tei:l><tei:seg type="acrostic">חֲ</tei:seg>רֵדָה לָבְשׁוּ כׇּל־בְּנֵי עֵשָׂו</tei:l>
          <tei:l>כִּי מִשֵּׂעִיר יהוה זָרָח.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:asher_biglal_avot_banim_gidel/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">טָ</tei:seg>פְחוּ כֻּלָּם בְּנֵי יִשְׁמָעֵאל</tei:l>
          <tei:l>כִּי מִפָּרַן יהוה הוֹפִֽיעַ.</tei:l>
          <tei:l><tei:seg type="acrostic">יְ</tei:seg>מִין יהוה טְפָחַֽיִם בַּלּוּחוֹת</tei:l>
          <tei:l>וִימִין מֹשֶׁה טְפָחַֽיִם בְּלוּחוֹת.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:asher_biglal_avot_banim_gidel/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כִּ</tei:seg>י אֹֽרֶךְ הַלּוּחוֹת שִׁשָּׁה טְפָחִים</tei:l>
          <tei:l>וּטְפָחַֽיִם מֻפְרָשׁ בֵּין־יָד לְיָד.</tei:l>
          <tei:l><tei:seg type="acrostic">לֵ</tei:seg>ךְ מֹשֶׁה שְׂמַח בִּגְדֻלָּתֶֽךָ</tei:l>
          <tei:l>כִּי אֵין־כָּמֽוֹךָ בְּכׇל־הַנְּבִיאִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:asher_biglal_avot_banim_gidel/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>י עָלָה לְתוֹךְ הֶעָנָן</tei:l>
          <tei:l>וּמִי רָאָה תְּמוּנַת אֱלֹהֵֽינוּ?</tei:l>
          <tei:l>מֹשֶׁה עָלָה לְתוֹךְ הֶעָנָן</tei:l>
          <tei:l>וְגַם־הוּא רָאָה תְּמוּנַת אֱלֹהֵיֽנוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:asher_biglal_avot_banim_gidel/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נְ</tei:seg>שִׂיא נְשִׂיאִים הָיָה מֹשֶׁה רַבֵּֽנוּ</tei:l>
          <tei:l>אָב לַחֲכָמִים וְרֹאשׁ לַנְּבִיאִים.</tei:l>
          <tei:l><tei:seg type="acrostic">סָ</tei:seg>גַר הַיָּם בִּתְפִלָּתוֹ</tei:l>
          <tei:l>וְעַל־יַד שְׁלוּחוֹ חֲרוֹן אַף הֵשִׁיב.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:asher_biglal_avot_banim_gidel/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">עָ</tei:seg>נָה יהוה וְאָמַר לְעַמּוֹ׃</tei:l>
          <tei:l>אָֽנֹכִ֖י֙ יְהֹוָ֣ה אֱלֹהֶ֑֔יךָ</tei:l>
          <tei:l>אֲשֶׁ֧ר הוֹצֵאתִ֛יךָ מֵאֶ֥רֶץ מִצְרַ֖יִם</tei:l>
          <tei:l>מִבֵּ֣֥ית עֲבָדִ֑͏ֽים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:asher_biglal_avot_banim_gidel/10"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פָּ</tei:seg>תְחוּ כֻּלָּם פִּיהֶם וְאָמְרוּ׃</tei:l>
          <tei:l>יהוה מֶֽלֶךְ</tei:l>
          <tei:l>יהוה מָלָךְ</tei:l>
          <tei:l>יְהֹוָ֥ה ׀ יִמְלֹ֖ךְ לְעֹלָ֥ם וָעֶֽד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:asher_biglal_avot_banim_gidel/11"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">צָ</tei:seg>עַק מֹשֶׁה צְעָקָה גְּדוֹלָה וּמָרָה</tei:l>
          <tei:l>בְּשָׁעָה שֶׁאָמַר לוֹ הַקָּדוֹשׁ בָּרוּךְ הוּא קוּם עֲלֵה וּמוֹת בָּהָר.</tei:l>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>רַע בְּגָדָיו וְהֵרִים קוֹלוֹ</tei:l>
          <tei:l>יְהוֹשֻֽׁעַ בִּן־נוּן שְׁמוֹר־נא צֹאנִי!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:asher_biglal_avot_banim_gidel/12"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רָ</tei:seg>אָה מֹשֶׁה מֵרֹאשׁ הַפִּסְגָּה</tei:l>
          <tei:l>סְגֻלַּת שְׁבָטִים עוֹמְדִים לְפָנָיו.</tei:l>
          <tei:l><tei:seg type="acrostic">שָׁ</tei:seg>ם מֵת מֹשֶׁה עֶֽבֶד יהוה</tei:l>
          <tei:l>מוּל בֵּית־פְּעוֹר אָסְפוֹ אֱלֹהֵֽינוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:asher_biglal_avot_banim_gidel/13"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">תְּ</tei:seg>פִלָּתוֹ לְעוֹלָם לֹא יָשׁוּב רֵיקָם</tei:l>
          <tei:l>כִּי רוֹעֶה נֶאֱמָן הָיָה מֹשֶׁה רַבֵּֽנוּ לְיִשְׂרָאֵל.</tei:l>
          <tei:l><tei:seg type="acrostic">תָּ</tei:seg>נֽוּחַ בְּרָכָה עַל־אֲסִיפָתוֹ</tei:l>
          <tei:l>כִּי עַל־פִּי יהוה מֵת מֹשֶׁה רַבֵּֽנוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:asher_biglal_avot_banim_gidel/14"/>
        <tei:lg>
          <tei:l>מֹשֶׁה מֵת! מִי לֹא יָמוּת?</tei:l>
          <tei:l>עַל־פִּי יהוה מֵת מֹשֶׁה רַבֵּֽנוּ.</tei:l>
          <tei:l>יְהוֹשֻֽׁעַ בִּן־נוּן קָם אַחֲרֵי מֹשֶׁה</tei:l>
          <tei:l>וְגַם־הוּא לִמֵּד תּוֹרָה לַשְּׁבָטִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:asher_biglal_avot_banim_gidel/15"/>
        <tei:lg>
          <tei:l>תְּפִלַּת מֹשֶׁה קָרַע רָקִֽיעַ</tei:l>
          <tei:l>בָּעֵת כִּי־נֶאֱסַף אִישׁ הָאֱלֹהִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:asher_biglal_avot_banim_gidel/16"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יהוה</tei:l>
          <tei:l>הַבּוֹחֵר בַּצַּדִּיקִים</tei:l>
          <tei:l>וְנוֹתֵן תּוֹרָה לְעַמּוֹ יִשְׂרָאֵל</tei:l>
          <tei:l>עַל־יְדֵי מֹשֶׁה רַבֵּֽנוּ:</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
