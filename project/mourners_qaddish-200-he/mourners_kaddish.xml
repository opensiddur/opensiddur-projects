  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:mourners_kaddish">
        <tei:head>קדיש יתום</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mourners_kaddish/1"/>
        <tei:lg>
          <tei:l>יִתְגַּדַּל וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא.</tei:l>
          <tei:l>בְּעָלְמָא דִּי בְרָא כִרְעוּתֵהּ</tei:l>
          <tei:l>וְיַמְלִיךְ מַלְכוּתֵהּ,</tei:l>
          <tei:l>בְּחַיֵּיכוֺן</tei:l>
          <tei:l>וּבְיוֹמֵיכוֹן</tei:l>
          <tei:l>וּבְחַיֵּי דְכָל בֵּית יִשְׂרָאֵל,</tei:l>
          <tei:l>בַּעֲגָלָא וּבִזְמַן קָרִיב.</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mourners_kaddish/2"/>
        <tei:lg>
          <tei:l>יְהֵא שְׁמֵהּ רַבָּא מְבָרַךְ לְעָלַם וּלְעָלְמֵי עָלְמַיָּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mourners_kaddish/3"/>
        <tei:lg>
          <tei:l>יִתְבָּרַךְ,</tei:l>
          <tei:l>וְיִשְׁתַּבַּח, וְיִתְפָּאֵר,</tei:l>
          <tei:l>וְיִתְרוֹמֵם,</tei:l>
          <tei:l>וְיִתְנַשּׂא,</tei:l>
          <tei:l>וְיִתְהַדָּר,</tei:l>
          <tei:l>וְיִתְעַלֶּה,</tei:l>
          <tei:l>וְיִתְהַלָּל,</tei:l>
          <tei:l>שְׁמֵהּ דְקֻדְשָׁא בְּרִיךְ הוּא.</tei:l>
          <tei:l>לְעֵלָּא מִן כָּל בִּרְכָתָא</tei:l>
          <tei:l>וְשִׁירָתָא,</tei:l>
          <tei:l>תֻּשְׁבְּחָתָא</tei:l>
          <tei:l>וְנֶחֱמָתָא,</tei:l>
          <tei:l>דַּאֲמִירָן בְּעָלְמָא,</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mourners_kaddish/4"/>
        <tei:lg>
          <tei:l>יְהֵא שְׁלָמָה רַבָּא מִן שְׁמַיָּא וְחַיִּים</tei:l>
          <tei:l>וְעַל כָּל יִשְֹרָאֵל,</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mourners_kaddish/5"/>
        <tei:lg>
          <tei:l>עוֹשֶׂה שָׁלוֹם בִּמְרוֹמָיו</tei:l>
          <tei:l>הוּא יַעֲשֶׂה שָׁלוֹם עָלֵינוּ</tei:l>
          <tei:l>(וְעַל כָּל יִשְׂרָאֵל)</tei:l>
          <tei:l>וְעַל כָּל יוֺשְׁבֵי תֵבֶל</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
