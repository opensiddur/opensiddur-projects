  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:priere_pour_sa_majeste_imperiale_et_royale_cologna">
        <tei:head>ברכה לקסר ומלך</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:priere_pour_sa_majeste_imperiale_et_royale_cologna/1"/>
        <tei:lg>
          <tei:l>ברכה לקסר ומלך</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:priere_pour_sa_majeste_imperiale_et_royale_cologna/2"/>
        <tei:lg>
          <tei:l>אֱלֹהִים חַיִים וּמֶּלֶךְ עוֹלָם,</tei:l>
          <tei:l>הַמַּגְבִּיהִי לָשֶׁבֶת</tei:l>
          <tei:l>הַמַּשְׁפִּילְי לִרְאוֹת</tei:l>
          <tei:l>בַּשָׁמָיִם וּבָאָרֶץ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:priere_pour_sa_majeste_imperiale_et_royale_cologna/3"/>
        <tei:lg>
          <tei:l>בְּיָדְךָ כֹּחַ וּגְבוּרָה</tei:l>
          <tei:l>וּלְגַדֵּל</tei:l>
          <tei:l>וּלְחַזֵק לַכֹּל</tei:l>
          <tei:l>אֲשֶׁר מִפִּיךָ מְלָכִים יִמְלֹכוּ׃</tei:l>
          <tei:l>וּמִיָדְךָ לָמוֹ מַטֵה עֹז שֶׁבֶט מִישׁוֹר</tei:l>
          <tei:l>לְנַהֵל לְאֻמִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:priere_pour_sa_majeste_imperiale_et_royale_cologna/4"/>
        <tei:lg>
          <tei:l>הַשְׁקִיפָה מִמְּעוֹן קָּדְשֶׁךָ וּבָרֵךְ</tei:l>
          <tei:l>וּנְצוֹר וָעֲזוֹר אֶת אֲדוֹנֵנוּ</tei:l>
          <tei:l>NAPOLÉON Empereur de Français et Roi d’Italie.</tei:l>
          <tei:l>אמן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:priere_pour_sa_majeste_imperiale_et_royale_cologna/5"/>
        <tei:lg>
          <tei:l>בִּרְכוֹת שָׁמַיִם מֵעַל תְּצַו אִתּוֹ</tei:l>
          <tei:l>יַאֲרִיךְ יָמִים וּשְׁנוֹת חַיִּים עַל מַמְלַכְתּוֹ׃</tei:l>
          <tei:l>אמן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:priere_pour_sa_majeste_imperiale_et_royale_cologna/6"/>
        <tei:lg>
          <tei:l>כְּאִישׁוֹן בַּת עַיִן תִּנְצְרֵהוּ</tei:l>
          <tei:l>עֲטֶרֶת תִּפְאֶרֶת נֶצַח תְּמַגְּנֵהוּ׃</tei:l>
          <tei:l>אמן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:priere_pour_sa_majeste_imperiale_et_royale_cologna/7"/>
        <tei:lg>
          <tei:l>תַּחְתָּיו תַּכְרִיעַ קָמָיו</tei:l>
          <tei:l>שָׁלוֹם וָשֶׁקֶט יִהְיֶה בְּיָמָיו׃</tei:l>
          <tei:l>אמן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:priere_pour_sa_majeste_imperiale_et_royale_cologna/8"/>
        <tei:lg>
          <tei:l>שְׁלַח אוֹרְךָ וְעֶזְרְךָ הֵמָה יַנְחוּהוּ</tei:l>
          <tei:l>חֶסֶד וֶאֶמֶת תָּמִיד יִצְּרוּהוּ׃</tei:l>
          <tei:l>אמן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:priere_pour_sa_majeste_imperiale_et_royale_cologna/9"/>
        <tei:lg>
          <tei:l>תַּעְטֶה הוֹד וְהָדָר גַם בְּרָכוֹת</tei:l>
          <tei:l>מַחְמַד עֵינוֹ Louise תִּפְאֶרֶת מְלָכוֹת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:priere_pour_sa_majeste_imperiale_et_royale_cologna/10"/>
        <tei:lg>
          <tei:l>מְאֹד מְאֹד יָרוּם אֲדוֹנֵינוּ וְנִשָּׂא וְגָבָהּ</tei:l>
          <tei:l>עִם כׇּל־בְּנֵי מִשְׁפַּחְתּוֹ הַנִשְׂגָבָה׃</tei:l>
          <tei:l>אמן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:priere_pour_sa_majeste_imperiale_et_royale_cologna/11"/>
        <tei:lg>
          <tei:l>תִתְּנֵנוּ לְפַנָיו וְלִפְנֵי כׇּל יוֹעֲצָיו לַחֲנִינָה וּלְרַחֲמִים</tei:l>
          <tei:l>לְטוֹב לְעַמְךָ יִשְׂרָאֵל כׇּל־הַיָמִים׃</tei:l>
          <tei:l>אמן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:priere_pour_sa_majeste_imperiale_et_royale_cologna/12"/>
        <tei:lg>
          <tei:l>יִהְיוּ לְרָצוֹן אִמְרֵי פִינוּ וְהֶגְיוֹן לִבֵּנוּ</tei:l>
          <tei:l>יְיָ צוּרֵנוּ וְגוֹאֲלֵנוּ׃</tei:l>
          <tei:l>אמן</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>