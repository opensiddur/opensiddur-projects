  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yom_purim_mohr">
        <tei:head>יוֹם פּוּרִים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_purim_mohr/1"/>
        <tei:lg>
          <tei:l>יוֹם פּוּרִים אֵין לִשְׁכֹּֽחַ</tei:l>
          <tei:l>זִכְרוּ כְּרֵֽיחַ הַנִּיחֽוֹחַ</tei:l>
          <tei:l>יַֽיִן מָצָא בּוֹ מָנֽוֹחַ</tei:l>
          <tei:l>וְשָׂם יִשְׁתּוּ וְיַחֲלִֽיפוּ כֹּֽחַ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_purim_mohr/2"/>
        <tei:lg>
          <tei:l>הַיּוֹם יִשְׁתּוּ בְּנֵי אֱמוּנִים</tei:l>
          <tei:l>זְהִירִים לִדְבַשׁ אָבוֹת וּבָנִים</tei:l>
          <tei:l>חָקוּק שִׁכָּרוֹן עַל־כׇּל־פָּנִים</tei:l>
          <tei:l>מֵרֹב יַֽיִן אַמִּיץ כֹּֽחַ׃</tei:l>
          <tei:l>יַֽיִן מָצָא...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_purim_mohr/3"/>
        <tei:lg>
          <tei:l>וּבָאוּ כֻּלָּם בִּבְרִית יַֽחַד</tei:l>
          <tei:l>נִשְׁתֶּה וְנִרְוֶה אָמְרוּ כְּאֶחָד</tei:l>
          <tei:l>וּפָתְחוּ וּפָֽצוּ פֶּה אֶחָד</tei:l>
          <tei:l>בָּרוּךְ הַנּוֹתֵן לִשְׁכֹּר כֹּֽחַ׃</tei:l>
          <tei:l>יַֽיִן מָצָא...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_purim_mohr/4"/>
        <tei:lg>
          <tei:l>דִּבֵּר בְּיֵינוֹ לוֹט הַשִּׁכּוֹר</tei:l>
          <tei:l>יוֹם הַפּוּרִים זָכוֹר וְשָׁמוֹר</tei:l>
          <tei:l>וְכׇל־כַּדָּיו יַֽחַד לִגְמֹר</tei:l>
          <tei:l>חַזֵּק מׇתְנַֽיִם כְּבֶן־מָנֽוֹחַ׃</tei:l>
          <tei:l>יַֽיִן מָצָא...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_purim_mohr/5"/>
        <tei:lg>
          <tei:l>הָעָם אֲשֶׁר נָע בְּשֵׁכָר תָּעָה</tei:l>
          <tei:l>יִשְׁכֹּר לְקַיֵּם מִצְוַת שְׁתִיָּה</tei:l>
          <tei:l>לְבַל־יַעֲבׇר־בָּם מִקְרֶה רָעָה</tei:l>
          <tei:l>לֹא־יִישָׁן וַיִּתְגַּל בְּאׇהֳלוֹ כְּנֹֽחַ׃</tei:l>
          <tei:l>יַֽיִן מָצָא...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
