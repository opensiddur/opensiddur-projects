    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yonah_nikhavah_yehudah">
        <tei:head>יוֹנָה נִכְאָבָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yonah_nikhavah_yehudah/1"/>
        <tei:lg>
          <tei:l>יוֹנָה נִכְאָבָה</tei:l>
          <tei:l>נַפְשָׁהּ דָּאֲבָה</tei:l>
          <tei:l>הֵיכַל דָּר עֲרָבוֹת</tei:l>
          <tei:l>יוֹם יוֹם סוֹבְבָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yonah_nikhavah_yehudah/2"/>
        <tei:lg>
          <tei:l>הוֹמִיָּה בְּקוֹלָהּ תִּתְחַנֵּן לְדוֹד</tei:l>
          <tei:l>נוֹדַע כִּי בְּכִסְלָהּ הִרְבָּה הַנְּדֹד</tei:l>
          <tei:l>לוּ הִתְעַגְּבָה עַל־דָּת דַּהֲבָא</tei:l>
          <tei:l>כְּאִישׁוֹן וּבָנוֹת צוּרַת הַשָּׁבָה׃</tei:l>
          <tei:l>יוֹנָה נִכְאָבָה...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yonah_nikhavah_yehudah/3"/>
        <tei:lg>
          <tei:l>הַבַּת הַיְקָרָה קוּמִי־נָא שְׁבִי</tei:l>
          <tei:l>יִפְעַת־לָךְ נְהוֹרָא לָךְ בַּת־הַצְּבִי</tei:l>
          <tei:l>עָבְרָה הָעֶבְרָה לֹא־תִּהְיֶה שְׁבִי</tei:l>
          <tei:l>כִּי כׇּל־מֵי שְׁבָא גַּם מֵימֵי סְבָא</tei:l>
          <tei:l>לֹ֤א יֽוּכְלוּ֙ לְכַבּ֣וֹת אֶת־הָֽאַהֲבָ֔ה׃</tei:l>
          <tei:l>יוֹנָה נִכְאָבָה...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
