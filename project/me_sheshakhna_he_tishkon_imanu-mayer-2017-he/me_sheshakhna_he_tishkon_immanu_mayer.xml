  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:me_sheshakhna_he_tishkon_immanu_mayer">
        <tei:head>מִי שֶׁשָּׁכְנָה... הִיא תִּשְׁכֹּן עִמָּנוּ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:me_sheshakhna_he_tishkon_immanu_mayer/1"/>
        <tei:lg>
          <tei:l>מִי שֶׁשָּׁכְנָה עִם שָׂרָה אִמֵּנוּ‏</tei:l>
          <tei:l>אַחֲרֵי בָּלְתָה,</tei:l>
          <tei:l>הִיא תִּשְׁכֹּן עִמָּנוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:me_sheshakhna_he_tishkon_immanu_mayer/2"/>
        <tei:lg>
          <tei:l>מִי שֶׁשָּׁכְנָה עִם רִבְקָה</tei:l>
          <tei:l>כְּשֶׁבָּנֶיהָ הִתְרוֹצְצוּ בְּבִטְנָהּ,</tei:l>
          <tei:l>הִיא תִּשְׁכֹּן עִמָּנוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:me_sheshakhna_he_tishkon_immanu_mayer/3"/>
        <tei:lg>
          <tei:l>מִי שֶׁשָּׁכְנָה עִם רָחֵל</tei:l>
          <tei:l>בַּעֲקָרוּתָהּ,</tei:l>
          <tei:l>הִיא תִּשְׁכֹּן עִמָּנוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:me_sheshakhna_he_tishkon_immanu_mayer/4"/>
        <tei:lg>
          <tei:l>מִי שֶׁשָּׁכְנָה עִם לֵאָה</tei:l>
          <tei:l>בְּעׇנְיָהּ,</tei:l>
          <tei:l>הִיא תִּשְׁכֹּן עִמָּנוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:me_sheshakhna_he_tishkon_immanu_mayer/5"/>
        <tei:lg>
          <tei:l>מִי שֶׁשָּׁכְנָה עִם תָּמָר</tei:l>
          <tei:l>בְּפֶתַח עֵינַיִם אֲשֶׁר עַל־דֶּרֶךְ תִּמְנָתָה,</tei:l>
          <tei:l>הִיא תִּשְׁכֹּן עִמָּנוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:me_sheshakhna_he_tishkon_immanu_mayer/6"/>
        <tei:lg>
          <tei:l>מִי שֶׁשָּׁכְנָה עִם שִׁפְרָה וְעִם פּוּעָה</tei:l>
          <tei:l>כְּשֶׁקָּרָא לָהֶן פַּרְעֹה,</tei:l>
          <tei:l>הִיא תִּשְׁכֹּן עִמָּנוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:me_sheshakhna_he_tishkon_immanu_mayer/7"/>
        <tei:lg>
          <tei:l>מִי שֶׁשָּׁכְנָה עִם יוֹכֶבֶד</tei:l>
          <tei:l>עַל־שְׂפַת־הַיְאֹֽר,</tei:l>
          <tei:l>הִיא תִּשְׁכֹּן עִמָּנוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:me_sheshakhna_he_tishkon_immanu_mayer/8"/>
        <tei:lg>
          <tei:l>מִי שֶׁשָּׁכְנָה עִם מִרְיָם</tei:l>
          <tei:l>עַל־יַד בַּאֲרָהּ,</tei:l>
          <tei:l>הִיא תִּשְׁכֹּן עִמָּנוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:me_sheshakhna_he_tishkon_immanu_mayer/9"/>
        <tei:lg>
          <tei:l>מִי שֶׁשָּׁכְנָה עִם בְּנוֹת צְלׇפְחָד</tei:l>
          <tei:l>כְּשֶׁאֲבִיהֶן מֵת בַּמִּדְבָּר,</tei:l>
          <tei:l>הִיא תִּשְׁכֹּן עִמָּנוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:me_sheshakhna_he_tishkon_immanu_mayer/10"/>
        <tei:lg>
          <tei:l>מִי שֶׁשָּׁכְנָה עִם דְּבוֹרָה</tei:l>
          <tei:l>בִּישִׁיבָתָהּ תַּחַת תׇּמְרֶיהָ,</tei:l>
          <tei:l>הִיא תִּשְׁכֹּן עִמָּנוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:me_sheshakhna_he_tishkon_immanu_mayer/11"/>
        <tei:lg>
          <tei:l>מִי שֶׁשָּׁכְנָה עִם רוּת</tei:l>
          <tei:l>בְּבֵית־לֶחֶם יְהוּדָה,</tei:l>
          <tei:l>הִיא תִּשְׁכֹּן עִמָּנוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:me_sheshakhna_he_tishkon_immanu_mayer/12"/>
        <tei:lg>
          <tei:l>מִי שֶׁשָּׁכְנָה עִם חַנָּה</tei:l>
          <tei:l>בְּהֵיכַל שִׁלֹה,</tei:l>
          <tei:l>הִיא תִּשְׁכֹּן עִמָּנוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:me_sheshakhna_he_tishkon_immanu_mayer/13"/>
        <tei:lg>
          <tei:l>מִי שֶׁשָּׁכְנָה עִם אֲבִיגַיִל</tei:l>
          <tei:l>כְּשֶׁנָּפְלָה עַל־פָּנֶיהָ לְאַפֵּי דָוִד,</tei:l>
          <tei:l>הִיא תִּשְׁכֹּן עִמָּנוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:me_sheshakhna_he_tishkon_immanu_mayer/14"/>
        <tei:lg>
          <tei:l>מִי שֶׁשָּׁכְנָה עִם אִשָּׁה הַחֲכָמָה</tei:l>
          <tei:l>בְּאָבֵל בֵּית־מֲעַכָה,</tei:l>
          <tei:l>הִיא תִּשְׁכֹּן עִמָּנוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:me_sheshakhna_he_tishkon_immanu_mayer/15"/>
        <tei:lg>
          <tei:l>מִי שֶׁשָׁכְנָה עִם הַשּׁוּנַמִּית</tei:l>
          <tei:l>כְּשֶׁנַּעֲרָהּ‏ מֻשְׁכָּב עַל־הַמִּטָּה,</tei:l>
          <tei:l>הִיא תִּשְׁכֹּן עִמָּנוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:me_sheshakhna_he_tishkon_immanu_mayer/16"/>
        <tei:lg>
          <tei:l>מִי שֶׁשָׁכְנָה עִם חֻלְדָּה</tei:l>
          <tei:l>בִּמְצִיאַת סֵפֶר הַתּוֹרָה,</tei:l>
          <tei:l>הִיא תִּשְׁכֹּן עִמָּנוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:me_sheshakhna_he_tishkon_immanu_mayer/17"/>
        <tei:lg>
          <tei:l>מִי שֶׁשָׁכְנָה עִם אֶסְתֵּר</tei:l>
          <tei:l>בְּשׁוּשַׁן הַבִּירָה,</tei:l>
          <tei:l>הִיא תִּשְׁכֹּן עִמָּנוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:me_sheshakhna_he_tishkon_immanu_mayer/18"/>
        <tei:lg>
          <tei:l>מִי שֶׁשָׁכְנָה עִם כׇּל הַצַּדִּיקוֹת וְהַחֲסִידוֹת וְהַתְּמִימוֹת וְהַיְּשָׁרוֹת,</tei:l>
          <tei:l>הִיא תִּשְׁכֹּן עִמָּנוּ.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
