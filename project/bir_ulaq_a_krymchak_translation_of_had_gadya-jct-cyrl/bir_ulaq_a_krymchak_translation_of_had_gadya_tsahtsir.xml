  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:bir_ulaq_a_krymchak_translation_of_had_gadya_tsahtsir">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bir_ulaq_a_krymchak_translation_of_had_gadya_tsahtsir/1"/>
        <tei:lg>
          <tei:l>Bir ulaq, bir ulaq,</tei:l>
          <tei:l>ki satın aldı atam eki aqçağa.</tei:l>
          <tei:l>Bir ulaq, bir ulaq.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bir_ulaq_a_krymchak_translation_of_had_gadya_tsahtsir/2"/>
        <tei:lg>
          <tei:l>Daa geldi mışıq,</tei:l>
          <tei:l>ve aşadı ulaqni,</tei:l>
          <tei:l>ki satın aldı atam eki aqçağa.</tei:l>
          <tei:l>Bir ulaq, bir ulaq.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bir_ulaq_a_krymchak_translation_of_had_gadya_tsahtsir/3"/>
        <tei:lg>
          <tei:l>Daa geldi köpek,</tei:l>
          <tei:l>ve dişledi mışıqnı,</tei:l>
          <tei:l>ki aşağan edı ulaqni,</tei:l>
          <tei:l>ki satın aldı atam eki aqçağa.</tei:l>
          <tei:l>Bir ulaq, bir ulaq.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bir_ulaq_a_krymchak_translation_of_had_gadya_tsahtsir/4"/>
        <tei:lg>
          <tei:l>Daa geldi tayah,</tei:l>
          <tei:l>ve urdu köpekni,</tei:l>
          <tei:l>ki dişledi mışıqnı,</tei:l>
          <tei:l>ki aşağan edı ulaqni,</tei:l>
          <tei:l>ki satın aldı atam eki aqçağa.</tei:l>
          <tei:l>Bir ulaq, bir ulaq.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bir_ulaq_a_krymchak_translation_of_had_gadya_tsahtsir/5"/>
        <tei:lg>
          <tei:l>Daa geldi ot,</tei:l>
          <tei:l>ve yaqti tayahni,</tei:l>
          <tei:l>ki urdu köpekni,</tei:l>
          <tei:l>ki dişledi mışıqnı,</tei:l>
          <tei:l>ki aşağan edı ulaqni,</tei:l>
          <tei:l>ki satın aldı atam eki aqçağa.</tei:l>
          <tei:l>Bir ulaq, bir ulaq.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bir_ulaq_a_krymchak_translation_of_had_gadya_tsahtsir/6"/>
        <tei:lg>
          <tei:l>Daa geldi suv,</tei:l>
          <tei:l>ve söndürdı ol otnı,</tei:l>
          <tei:l>ki yaqti tayahni,</tei:l>
          <tei:l>ki urdu köpekni,</tei:l>
          <tei:l>ki dişledi mışıqnı,</tei:l>
          <tei:l>ki aşağan edı ulaqni,</tei:l>
          <tei:l>ki satın aldı atam eki aqçağa.</tei:l>
          <tei:l>Bir ulaq, bir ulaq.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bir_ulaq_a_krymchak_translation_of_had_gadya_tsahtsir/7"/>
        <tei:lg>
          <tei:l>Daa geldi ögüz,</tei:l>
          <tei:l>ve içti suvni,</tei:l>
          <tei:l>ki söndürdı ol otnı,</tei:l>
          <tei:l>ki yaqti tayahni,</tei:l>
          <tei:l>ki urdu köpekni,</tei:l>
          <tei:l>ki dişledi mışıqnı,</tei:l>
          <tei:l>ki aşağan edı ulaqni,</tei:l>
          <tei:l>ki satın aldı atam eki aqçağa.</tei:l>
          <tei:l>Bir ulaq, bir ulaq.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bir_ulaq_a_krymchak_translation_of_had_gadya_tsahtsir/8"/>
        <tei:lg>
          <tei:l>Daa geldi şöhet,</tei:l>
          <tei:l>ve soydı ögüzni,</tei:l>
          <tei:l>ki içti suvni,</tei:l>
          <tei:l>ki söndürdı ol otnı,</tei:l>
          <tei:l>ki yaqti tayahni,</tei:l>
          <tei:l>ki urdu köpekni,</tei:l>
          <tei:l>ki dişledi mışıqnı,</tei:l>
          <tei:l>ki aşağan edı ulaqni,</tei:l>
          <tei:l>ki satın aldı atam eki aqçağa.</tei:l>
          <tei:l>Bir ulaq, bir ulaq.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bir_ulaq_a_krymchak_translation_of_had_gadya_tsahtsir/9"/>
        <tei:lg>
          <tei:l>Daa geldi malah amavet,</tei:l>
          <tei:l>ve soydı şöhetni,</tei:l>
          <tei:l>ki soydı ögüzni,</tei:l>
          <tei:l>ki içti suvni,</tei:l>
          <tei:l>ki söndürdı ol otnı,</tei:l>
          <tei:l>ki yaqti tayahni,</tei:l>
          <tei:l>ki urdu köpekni,</tei:l>
          <tei:l>ki dişledi mışıqnı,</tei:l>
          <tei:l>ki aşağan edı ulaqni,</tei:l>
          <tei:l>ki satın aldı atam eki aqçağa.</tei:l>
          <tei:l>Bir ulaq, bir ulaq.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bir_ulaq_a_krymchak_translation_of_had_gadya_tsahtsir/10"/>
        <tei:lg>
          <tei:l>Daa gelecek dir aQadöş Baruh U,</tei:l>
          <tei:l>Da soyacaq dir malahamavetni,</tei:l>
          <tei:l>ki soydı şöhetni,</tei:l>
          <tei:l>ki soydı ögüzni,</tei:l>
          <tei:l>ki içti suvni,</tei:l>
          <tei:l>ki söndürdı ol otnı,</tei:l>
          <tei:l>ki yaqti tayahni,</tei:l>
          <tei:l>ki urdu köpekni,</tei:l>
          <tei:l>ki dişledi mışıqnı,</tei:l>
          <tei:l>ki aşağan edı ulaqni,</tei:l>
          <tei:l>ki satın aldı atam eki aqçağa.</tei:l>
          <tei:l>Bir ulaq, bir ulaq.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
