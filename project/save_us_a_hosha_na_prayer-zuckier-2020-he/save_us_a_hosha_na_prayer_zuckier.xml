    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:save_us_a_hosha_na_prayer_zuckier">
        <tei:head>הושענא להושענא רבא תשפ״א</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:save_us_a_hosha_na_prayer_zuckier/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">א</tei:seg>רבע אמות רחוקים,</tei:l>
          <tei:l><tei:seg type="acrostic">ב</tei:seg>ביתם סגורים,</tei:l>
          <tei:l><tei:seg type="acrostic">ג</tei:seg>דולים והמונים,</tei:l>
          <tei:l><tei:seg type="acrostic">ד</tei:seg>לתות סגורים,</tei:l>
          <tei:l><tei:seg type="acrostic">ה</tei:seg>שמים צועקים,</tei:l>
          <tei:l><tei:seg type="acrostic">ו</tei:seg>לבותם נשברים,</tei:l>
          <tei:l><tei:seg type="acrostic">ז</tei:seg>ה מזה רחוקים,</tei:l>
          <tei:l><tei:seg type="acrostic">ח</tei:seg>בושים בבתים,</tei:l>
          <tei:l><tei:seg type="acrostic">ט</tei:seg>ף וזקנים,</tei:l>
          <tei:l><tei:seg type="acrostic">י</tei:seg>גונים ואבלים,</tei:l>
          <tei:l><tei:seg type="acrostic">כ</tei:seg>תר לך נותנים,</tei:l>
          <tei:l><tei:seg type="acrostic">ל</tei:seg>נפשם מפקחים,</tei:l>
          <tei:l><tei:seg type="acrostic">מ</tei:seg>צוותיך נוטרים,</tei:l>
          <tei:l><tei:seg type="acrostic">נ</tei:seg>פל גורלם בפורים,</tei:l>
          <tei:l><tei:seg type="acrostic">ס</tei:seg>ובלים ומעונים,</tei:l>
          <tei:l><tei:seg type="acrostic">ע</tei:seg>ליך הרוגים,</tei:l>
          <tei:l><tei:seg type="acrostic">פ</tei:seg>יות לך מתפללים,</tei:l>
          <tei:l><tei:seg type="acrostic">צ</tei:seg>דיקים וחסידים,</tei:l>
          <tei:l><tei:seg type="acrostic">ק</tei:seg>דושים וישרים,</tei:l>
          <tei:l><tei:seg type="acrostic">ר</tei:seg>אשם חפויים,</tei:l>
          <tei:l><tei:seg type="acrostic">ש</tei:seg>מך מקדשים ומחללים,</tei:l>
          <tei:l><tei:seg type="acrostic">ת</tei:seg>ורתך שומרים.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
