  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:tsedeq_tuv_kahenzade">
        <tei:head>צֶדֶק טוּב</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tsedeq_tuv_kahenzade/1"/>
        <tei:lg>
          <tei:l>צֶדֶק טוּב, וּמֵטִיב לַכֹּל מִכֹּל וּבְכֹל</tei:l>
          <tei:l>מֵאֲשֶׁר אֹשֶׁר לַמְּאֻשָּׁר בְּמִישׁוֹר</tei:l>
          <tei:l>אַשְׁרֵי־הָאִישׁ אֲשֶׁר צַדִּיק לְמַעַן צֶדֶק׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tsedeq_tuv_kahenzade/2"/>
        <tei:lg>
          <tei:l>רְצוֹן־הָאָדוֹן תּוֹרַת־תִּפְאֶרֶת תָּמִיד</tei:l>
          <tei:l>חֹק־הַשֹּׁפֵט מִשְׁפַּט־צֶדֶק נִצְחִי</tei:l>
          <tei:l>אָכֵן כֵּן הוּא הָרֹעֶה לִירֵאָיו לְעֹלָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tsedeq_tuv_kahenzade/3"/>
        <tei:lg>
          <tei:l>וַיִּשְׁתַּחֲווּ לַמֶּלֶךְ שֶׁחָפֵץ לְהַצְדֵּק</tei:l>
          <tei:l>וִירַנְּנוּ עַמּוֹ עִמּוֹ בְּרִנָּה נְהִירָה</tei:l>
          <tei:l>כִּי אֵלָיו הַמַּמְלָכָה לְעֹלְמֵי עֹלָמִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tsedeq_tuv_kahenzade/4"/>
        <tei:lg>
          <tei:l>אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
