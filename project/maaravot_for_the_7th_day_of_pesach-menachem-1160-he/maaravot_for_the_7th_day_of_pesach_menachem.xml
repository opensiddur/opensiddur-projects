    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem">
        <tei:head>מַעֲרָבוֹת לְיוֹם שְׁבִיעִי שֶׁל־פֶּסַח</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/1"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">חזן</tei:note> בָּרְכוּ אֶת־יְהֹוָה הַמְבֹרָךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/2"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">קהל וחזן אחריהם</tei:note>
          </tei:l>
          <tei:l>בָּרוּךְ יְהֹוָה הַמְבֹרָךְ לְעֹלָם וָעֶד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/3"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְהֹוָה אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>אֲשֶׁר בִּדְבָרוֹ מַעֲרִיב עֲרָבִים</tei:l>
          <tei:l>בְּחׇכְמָה פּוֹתֵֽחַ שְׁעָרִים</tei:l>
          <tei:l>וּבִתְבוּנָה מְשַׁנֶּה עִתִּים</tei:l>
          <tei:l>וּמַחֲלִיף אֶת־הַזְּמַנִּים</tei:l>
          <tei:l>וּמְסַדֵּר אֶת־הַכּוֹכָבִים בְּמִשְׁמְרוֹתֵיהֶם בָּרָקִֽיעַ</tei:l>
          <tei:l>כִּרְצוֹנוֹ.</tei:l>
          <tei:l>בּוֹרֵא יוֹם וָלָֽיְלָה</tei:l>
          <tei:l>גּוֹלֵל אוֹר מִפְּנֵי־חֹֽשֶׁךְ</tei:l>
          <tei:l>וְחֹֽשֶׁךְ מִפְּנֵי־אוֹר</tei:l>
          <tei:l>וּמַעֲבִיר יוֹם וּמֵבִיא לָֽיְלָה</tei:l>
          <tei:l>וּמַבְדִּיל בֵּין יוֹם וּבֵין לָֽיְלָה</tei:l>
          <tei:l>יְהֹוָה צְבָאוֹת שְׁמוֹ</tei:l>
          <tei:l>אֵל חַי וְקַיָּם</tei:l>
          <tei:l>תָּמִיד יִמְלוֹךְ עָלֵֽינוּ</tei:l>
          <tei:l>לְעוֹלָם וָעֶד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">א</tei:seg>וֹרִי וְיִשְׁעִי עַל־הַיָּם נִגְלָה</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>הַחֲשִׁיכוֹ לְצָרַי וְלִי הֵאִיר אֲפֵלָה</tei:l>
          <tei:l><tei:seg type="acrostic">גְּדֻ</tei:seg>לַּת מַעֲשָׂיו נִפְלָאִים וְנוֹרָאִים לְהַלְּלָה</tei:l>
          <tei:l>וַיְהִ֤י הֶֽעָנָן֙ וְהַחֹ֔שֶׁךְ וַיָּ֖אֶר אֶת־הַלָּ֑יְלָה׃ <tei:bibl>(שמות יד:כ)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/5"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה הַמַּעֲרִיב עֲרָבִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/6"/>
        <tei:lg>
          <tei:l>אַהֲבַת עוֹלָם בֵּית יִשְׂרָאֵל עַמְּךָ אָהַבְתָּ</tei:l>
          <tei:l>תּוֹרָה וּמִצְוֹת חֻקִּים וּמִשְׁפָּטִים אוֹתָנוּ לִמַּדְתָּ׃</tei:l>
          <tei:l>עַל־כֵּן יהוה אֱלֹהֵֽינוּ</tei:l>
          <tei:l>בְּשׇׁכְבֵֽנוּ וּבְקוּמֵֽנוּ</tei:l>
          <tei:l>נָשִֽׂיחַ בְּחֻקֶּֽיךָ</tei:l>
          <tei:l>וְנִשְׂמַח בְּדִבְרֵי תּוֹרָתֶֽךָ וּמִצְוֹתֶֽיךָ</tei:l>
          <tei:l>לְעוֹלָם וָעֶד</tei:l>
          <tei:l>כִּי הֵם חַיֵּֽינוּ וְאֹֽרֶךְ יָמֵֽינוּ</tei:l>
          <tei:l>וּבָהֶם נֶהְגֶּה יוֹמָם וָלָֽיְלָה׃</tei:l>
          <tei:l>וְאַהֲבָתְךָ אַל־תָּסִיר מִמֶּֽנּוּ לְעוֹלָמִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הֵ</tei:seg>עִיר בְּרִית יְשֵׁנִים לְשַׁלֵּם בָּנִים גְּמוּלָם</tei:l>
          <tei:l><tei:seg type="acrostic">וַ</tei:seg>יּוֹצֵא עַמּוֹ בְּשָׂשׂוֹן בְּאֶבְרָתוֹ נְטָלָם</tei:l>
          <tei:l><tei:seg type="acrostic">זָ</tei:seg>כַר <tei:seg type="acrostic">חַ</tei:seg>סְדּוֹ וֶאֱמוּנָתוֹ בִּידִידוּת לְנַהֲלָם</tei:l>
          <tei:l>בְּאַהֲבָת֥וֹ וּבְחֶמְלָת֖וֹ ה֣וּא גְאָלָ֑ם׃ <tei:bibl>(ישעיה סג:ט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/8"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה אוֹהֵב עַמּוֹ יִשְׂרָאֵל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/9"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ממשיכים משְׁמַ֖ע עד מֹשֶׁה וּבְנֵי־יִשְׂרָאֵל לְךָ עָנוּ שִׁירָה...</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/10"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">א</tei:seg>וֹדֶה חַסְדּוֹ הִפְלָא</tei:l>
          <tei:l>מַעֲשָׂיו וְנִפְלְאוֹתָיו בִּמְצוּלָה</tei:l>
          <tei:l>נ֝וֹרָא֗וֹת עַל־יַם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/11"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בִּ</tei:seg>קְהַל עָם אֲהַלְלָה</tei:l>
          <tei:l>בְּמוֹשַׁב זְקֵנִים אֲגַדְּלָה</tei:l>
          <tei:l>רֹגַ֣ע הַיָּ֔ם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/12"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">גִּ</tei:seg>זְבָּר בִּנְטוֹת יָדוֹ</tei:l>
          <tei:l>גָּֽאוּ גַּלִּים נֶגְדּוֹ</tei:l>
          <tei:l>יִֽרְעַ֥ם הַ֝יָּ֗ם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/13"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">דָּ</tei:seg>גוּל בִּכְבוֹדוֹ נִגְלָה</tei:l>
          <tei:l>אָז נִקְרַע בְּחַלְחָלָה</tei:l>
          <tei:l>וַיַּעֲמֹ֥ד הַיָּ֖ם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/14"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הֱ</tei:seg>שִׁיבוֹ נֶאֱמָן בְּזַעְפּוֹ</tei:l>
          <tei:l>גְּאוֹן גַּלֶּֽיךָ אֵיפוֹא</tei:l>
          <tei:l>מַה־לְּךָ֣ הַ֭יָּם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/15"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>שִׁבְטֵי־יָהּ הָמְמוּ</tei:l>
          <tei:l>שָׂרֵי יְהוּדָה רָגְמוּ</tei:l>
          <tei:l>אֶל־תּ֖וֹךְ הַיָּֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/16"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זָ</tei:seg>כָה מְלוּכָה לְהַשְׁרִישׁוֹ</tei:l>
          <tei:l>הָיְתָ֣ה יְהוּדָ֣ה לְקׇדְשׁ֑וֹ</tei:l>
          <tei:l>בִּמְצֻל֥וֹת יָ֖ם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/17"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חָ</tei:seg>צָה לִגְזוּרִים וּמֻלִים</tei:l>
          <tei:l>דֶּֽרֶךְ לַעֲבֹר גְּאוּלִים</tei:l>
          <tei:l>מַֽעֲמַקֵּי־יָ֔ם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/18"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ט</tei:seg>וֹב בְּכֵן שִׁירָתוֹ</tei:l>
          <tei:l>פָּתַח בְּאָז זְמִירָתוֹ</tei:l>
          <tei:l>צָהֲל֖וּ מִיָּֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/19"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יְ</tei:seg>שָׁרִים קִדְּמוּ רוֹנְנִים</tei:l>
          <tei:l>אַחַר אֵלִים מְנַגְּנִים</tei:l>
          <tei:l>מ֭וֹשֵׁל בְּגֵא֣וּת הַיָּ֑ם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/20"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כְּ</tei:seg>בוֹלוֹס צְדָדִים הִקְפָּה</tei:l>
          <tei:l>וּמִלְּמַֽעְלָה כְּמִין כִּפָּה</tei:l>
          <tei:l>יְכַסּ֥וּ עַל־יָֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/21"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>כׇל־אֲפָסִים נִגְלוּ</tei:l>
          <tei:l>אוֹתוֹתָיו כִּי גָּדְלוּ</tei:l>
          <tei:l>קַצְוֵי־אֶ֗֝רֶץ וְיָ֣ם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/22"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>י כָמֽוֹהוּ נֶהְדָּר</tei:l>
          <tei:l>חָסִין בְּכֹֽחַ נֶאְדָּר</tei:l>
          <tei:l>הַקּוֹרֵ֣א לְמֵֽי־הַיָּ֗ם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/23"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נִ</tei:seg>הֵל יְדִידָיו בְּאַֽהַב</tei:l>
          <tei:l>זְרוֹעוֹ מַחְצֶֽבֶת רַֽהַב</tei:l>
          <tei:l>הִיא֙ הַמַּחֲרֶ֣בֶת יָ֔ם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/24"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">סְ</tei:seg>לָעִים הָפַךְ זֵידוֹנִים</tei:l>
          <tei:l>שִׁבַּר רָאשֵׁי תַּנִּינִים</tei:l>
          <tei:l>הָפַךְ לְיַבָּשָׁה יָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/25"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">עֲ</tei:seg>רֵמוֹת מַֽיִם נֶעֶרְמוּ</tei:l>
          <tei:l>תְּהוֹמוֹת בָּהֶם נִלְחָֽמוּ</tei:l>
          <tei:l>בְּקַרְקַ֣ע הַיָּ֔ם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/26"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פֵּ</tei:seg>רוּרִים בְּעֻזּוֹ פּוֹרָֽרוּ</tei:l>
          <tei:l>נֵד אֶחָד נִצְבָּֽרוּ</tei:l>
          <tei:l>כַּ֭נֵּד מֵ֣י הַיָּ֑ם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/27"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">צֶֽ</tei:seg>מֶד סוּסִים וְרוֹכְבִים</tei:l>
          <tei:l>עוֹלִים וְיוֹרְדִים מְשֻׁלָּבִים</tei:l>
          <tei:l>עַד־נִבְכֵי־יָ֑ם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/28"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קִ</tei:seg>לְּעָם בְּבִזָּה מְעֻטָּרִים</tei:l>
          <tei:l>קִשּׁוּטֵי זְהָבִים וְתוֹרִים</tei:l>
          <tei:l>עַל־שְׂפַ֥ת הַיָּֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/29"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רִ</tei:seg>בָּה פְּלָאָיו לְנוֹסְסָה</tei:l>
          <tei:l>נֶֽגֶד אֲבוֹתָם עָשָׂה</tei:l>
          <tei:l>בָּ֣קַע יָ֭ם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/30"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שְׁ</tei:seg>בִילָיו רָֽאוּ וַהֲלִיכוֹתָיו</tei:l>
          <tei:l>וְלֹא־נוֹדְעוּ עִקְּבוֹתָיו</tei:l>
          <tei:l>אֱלֹהִים בַּיָּם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/31"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">תְּ</tei:seg>מוּנַת גִּבּוֹר נִדְמָה</tei:l>
          <tei:l>יְהֹוָ֖ה אִ֣ישׁ מִלְחָמָ֑ה</tei:l>
          <tei:l>יָרָ֣ה בַיָּ֑ם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/32"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מַ</tei:seg>פְלִיא מִקֶּֽדֶם נוֹרָאוֹת</tei:l>
          <tei:l>עוֹד יַרְאֵֽנוּ נִפְלָאוֹת</tei:l>
          <tei:l>וּמַטֵּ֙הוּ֙ עַל־הַיָּ֔ם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/33"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נִ</tei:seg>דָּחִים יַדְרִיךְ בַּנְּעָלִים</tei:l>
          <tei:l>וְהִכָּֽהוּ לְשִׁבְעָה נְחָלִים</tei:l>
          <tei:l>אֵ֚ת לְשׁ֣וֹן יָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/34"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חׇ</tei:seg>פְשִׁים יַדְרִיר שִׁירַֽיִם</tei:l>
          <tei:l>נִשְׁאָרִים מֵאַשּׁוּר וּמִמִּצְרַֽיִם</tei:l>
          <tei:l>וּמֵאִיֵּ֖י הַיָּֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/35"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מֵ</tei:seg>אֲרָצוֹת יְקַבֵּץ לְגׇאֳלָם</tei:l>
          <tei:l>יְנַטְּלֵם כִּימֵי עוֹלָם</tei:l>
          <tei:l>מִצָּפ֣וֹן וּמִיָּ֔ם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/36"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>חַצְרוֹת אֱלֹהֵֽינוּ יֵצְאוּ</tei:l>
          <tei:l>מַֽיִם חַיִּים וְיֵרָפְאוּ</tei:l>
          <tei:l>חֶצְיָ֗ם אֶל־הַיָּם֙׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/37"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רַבִּי</tei:seg>ם מוֹשְׁכִים וְהוֹלְכִים</tei:l>
          <tei:l>וּמִן־הַמִּקְדָּשׁ מְפַכִּים</tei:l>
          <tei:l>הֹלְכִ֣ים אֶל־הַיָּ֔ם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/38"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יַעֲ</tei:seg>לוּ עַל־שָׂפָה</tei:l>
          <tei:l>עֲצֵי מַאֲכָל לִתְרוּפָה</tei:l>
          <tei:l>קְצִירֶ֣הָ עַד־יָ֑ם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/39"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קְ</tei:seg>צִין עַם יַפְרֵשׁ</tei:l>
          <tei:l>מִגֶּֽזַע יִשַׁי שֹֽׁרֶשׁ</tei:l>
          <tei:l>וְ֭יֵרְדְּ מִיָּ֣ם עַד־יָ֑ם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/40"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>יָמֵֽינוּ יוֹפִֽיעַ הֲדָרוֹ</tei:l>
          <tei:l>יָקֵ֥ם יְהֹוָ֖ה אֶת־דְּבָר֑וֹ</tei:l>
          <tei:l>עָשָׂ֥ה אֶת־הַיָּ֖ם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/41"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">טְ</tei:seg>לָאָיו נִהֵל כְּאוֹמֵן מוֹשִֽׁיעַ וְגוֹאֵל</tei:l>
          <tei:l><tei:seg type="acrostic">יְ</tei:seg>קַר זִיו רָֽאוּ וְהִכִּֽירוּ כְּבוֹד אֵל</tei:l>
          <tei:l>כִּלְ כְּלָם דְּבַשׁ מִסֶּֽלַע הֶחֱסָם בְּצִלּוֹ לְהִצָּאֵל</tei:l>
          <tei:l>בְּֽ֭מַקְהֵלוֹת בָּרְכ֣וּ אֱלֹהִ֑ים אֲ֝דֹנָ֗י מִמְּק֥וֹר יִשְׂרָאֵֽל׃ <tei:bibl>(תהלים סח:כז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/42"/>
        <tei:lg>
          <tei:l>בְּגִילָה בְּרִינָה בְּשִׂמְחָה רַבָּה</tei:l>
          <tei:l>וְאָמְרוּ כֻלָּם</tei:l>
          <tei:l>מִֽי־כָמֹ֤כָה בָּֽאֵלִם֙ יְהֹוָ֔ה</tei:l>
          <tei:l>מִ֥י כָּמֹ֖כָה נֶאְדָּ֣ר בַּקֹּ֑דֶשׁ</tei:l>
          <tei:l>נוֹרָ֥א תְהִלֹּ֖ת עֹ֥שֵׂה פֶֽלֶא׃ <tei:bibl>(שמות טו:יא)</tei:bibl></tei:l>
          <tei:l>מַלְכוּתְךָ רָאוּ בָנֶֽיךָ</tei:l>
          <tei:l>בּוֹקֵֽעַ יָם לִפְנֵי מֹשֶׁה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/43"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>פְעַל <tei:seg type="acrostic">נ</tei:seg>וֹרְאוֹתָיו <tei:seg type="acrostic">סָ</tei:seg>פוּן מִי לְגַדְּלֵֽהוּ</tei:l>
          <tei:l><tei:seg type="acrostic">עֹֽ</tei:seg>צֶם <tei:seg type="acrostic">פְּ</tei:seg>לָאוֹתָיו אֲשֶׁר הִפְלִיא לַמַּעֲנֵֽהוּ</tei:l>
          <tei:l><tei:seg type="acrostic">צֶֽ</tei:seg>מַח <tei:seg type="acrostic">קְ</tei:seg>דֹשָׁיו אָֽנִי וְלִי מוֹרָשָׁה לְקַלְּסֵֽהוּ׃</tei:l>
          <tei:l>זֶ֤ה אֵלִי֙ וְאַנְוֵ֔הוּ אֱלֹהֵ֥י אָבִ֖י וַאֲרֹמְמֶֽנְהוּ׃ <tei:bibl>(שמות טו:יא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/44"/>
        <tei:lg>
          <tei:l>זֶה צוּר יִשְׂעֵֽנוּ</tei:l>
          <tei:l>פָּצוּ פֶה וְאָמְרוּ׃</tei:l>
          <tei:l>יְהֹוָ֥ה ׀ יִמְלֹ֖ךְ לְעֹלָ֥ם וָעֶֽד׃ <tei:bibl>(שמות טו:יח)</tei:bibl></tei:l>
          <tei:l>וְנֶאֱמַר</tei:l>
          <tei:l>כִּֽי־פָדָ֥ה יְהֹוָ֖ה אֶֽת־יַעֲקֹ֑ב</tei:l>
          <tei:l>וּגְאָל֕וֹ מִיַּ֖ד חָזָ֥ק מִמֶּֽנּוּ׃ <tei:bibl>(ירמיה לא:י)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/45"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רָ</tei:seg>כַב עַל כְּרוּב בְּרָקִים רָב מַלְכִּי</tei:l>
          <tei:l><tei:seg type="acrostic">שָׁ</tei:seg>לַח מִמָּרוֹם הִמְשַֽׁנִי מִמַּֽיִם הִמְשִׁיכִי</tei:l>
          <tei:l><tei:seg type="acrostic">תַּ</tei:seg>מָּתִי רַעְיָתִי פָּץ קוּמִי וּלְכִי</tei:l>
          <tei:l>כִּ֣י אׇמְנָ֔ם כִּ֥י גֹאֵ֖ל אָנֹ֑כִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/46"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה מֶֽלֶךְ צוּר יִשְׂרָאֵל וְגוֹאֲלוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/47"/>
        <tei:lg>
          <tei:l>הַשְׁכִּיבֵֽנוּ יְהֹוָה אֱלֹהֵֽינוּ לְשָׁלוֹם</tei:l>
          <tei:l>וְהַעֲמִידֵֽנוּ מַלְכֵּֽנוּ לְחַיִּים</tei:l>
          <tei:l>וּפְרוֹשׂ עָלֵֽינוּ סֻכַּת שְׁלוֹמֶֽךָ</tei:l>
          <tei:l>וְתַקְּנֵֽנוּ בְּעֵצָה טוֹבָה מִלְּפָנֶֽיךָ</tei:l>
          <tei:l>וְהוֹשִׁיעֵֽנוּ לְמַֽעַן שְׁמֶֽךָ</tei:l>
          <tei:l>וְהָגֵן בַּעֲדֵֽנוּ וְהָסֵר מֵעָלֵֽינוּ אוֹיֵב</tei:l>
          <tei:l>דֶּֽבֶר וְחֶֽרֶב וְרָעָב וְיָגוֹן</tei:l>
          <tei:l>וְהָסֵר שָׂטָן מִלְּפָנֵֽינוּ וּמֵאַחֲרֵֽינוּ</tei:l>
          <tei:l>וּבְצֵל כְּנָפֶֽיךָ תַּסְתִּירֵֽנוּ</tei:l>
          <tei:l>כִּי אֵל שׁוֹמְרֵֽנוּ וּמַצִּילֵֽנוּ אָֽתָּה</tei:l>
          <tei:l>כִּי אֵל מֶֽלֶךְ חַנּוּן וְרַחוּם אָֽתָּה</tei:l>
          <tei:l>וּשְׁמוֹר צֵאתֵֽנוּ וּבוֹאֵֽנוּ לְחַיִּים וּלְשָׁלוֹם</tei:l>
          <tei:l>מֵעַתָּה וְעַד־עוֹלָם</tei:l>
          <tei:l>וּפְרֹשׂ עָלֵֽינוּ סֻכַּת שְׁלוֹמֶֽךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/48"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מָ</tei:seg>תַי אָבוֹא וְאֵרָאֶה פְּנֵי אֱלֹהִים לְהַקְבִּילָה</tei:l>
          <tei:l><tei:seg type="acrostic">נ</tei:seg>וֹי חוֹמוֹת מַגִּיעוֹת כִּסֵּא כָבוֹד לְמַֽעְלָה</tei:l>
          <tei:l><tei:seg type="acrostic">חֵ</tei:seg>יל וְאַרְמוֹן עַל־מִשְׁפָּטוֹ וְהָעִיר עַל־תִּלָּהּ</tei:l>
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>כְלַל יֹֽפִי יוֹפִֽיעַ כְּעִיר שֶׁחֻבְּרָה לָהּ בַּמְּסִלָּה</tei:l>
          <tei:l>בֵּית אֵל עוֹלָה שְׂרִידֵי גּוֹלָה לְהָגִילָה</tei:l>
          <tei:l>אֱלֹ֘הִ֤ים יְכוֹנְנֶ֖הָ עַד־עוֹלָ֣ם סֶֽלָה׃ <tei:bibl>(תהלים מח:ט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/49"/>
        <tei:lg>
          <tei:l>נִכְסְפָ֬ה וְגַם־כָּלְתָ֨ה ׀ נַפְשִׁי֮ אֶל־יֹֽפִי מִכְלוֹלֶֽיהָ</tei:l>
          <tei:l>מִדֵּי חׇדְשָׁהּ וְשַׁבַּתָּהּ לְהֵרָאוֹת תָּמִיד עָלֶֽיהָ</tei:l>
          <tei:l>בַּעֲלוֹת כָּעָב קְרוּאֶֽיהָ לְשַׁלֵּשׁ פַּעֲמֵי רְגָלֶֽיהָ</tei:l>
          <tei:l>לְסַבֵּב צִיּוֹן וּלְהַקִּיף וְלִסְפֹּר אֶת־מִגְדָּלֶֽיהָ</tei:l>
          <tei:l>בִּירָנִיּוֹת נוֹסָפִין לָהּ לְמִשְׁמַר נוֹי זְבוּלֶֽיהָ</tei:l>
          <tei:l>יִקְרְא֤וּ לִירוּשָׁלַ֙͏ִם֙ כִּסֵּ֣א יְהֹוָ֔ה וְנִקְו֨וּ אֵלֶ֧יהָ׃ <tei:bibl>(ירמיה ג:יז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/50"/>
        <tei:lg>
          <tei:l>חִכִּֽיתִי לַיהֹוָה אוֹתוֹתָיו כִּימֵי עוֹלָם לְמַשְׁמֵשׁ</tei:l>
          <tei:l>עַל־אֱדוֹם עֶֽשֶׂר נְגָעִים עוֹד יְחַמֵּשׁ</tei:l>
          <tei:l>תֹּֽהוּ וָבֹֽהוּ רוֹמִי לְשַׁמֵּשׁ</tei:l>
          <tei:l>וְעָלַֽיִךְ צִיּוֹן כְּבוֹדוֹ יֵרָאֶה בֹּֽקֶר וָרֶֽמֶשׁ</tei:l>
          <tei:l>יְהֹוָה לְאוֹר עוֹלָם יִהְיֶה שַֽׁחַר וָאֶֽמֶשׁ</tei:l>
          <tei:l>לְאוֹר עוֹלָם לֹא יִהְיֶה לָּךְ עוֹד הַשֶּֽׁמֶשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/51"/>
        <tei:lg>
          <tei:l>מְאוֹר מְשָׁרְתָיו יַזְהִיר כְּזֹֽהַר הָרָקִֽיעַ לְהִתְחַדֵּשׁ</tei:l>
          <tei:l>הַנּוֹתָר בְּצִיּוֹן קָדוֹשׁ יֵאָמֵר לוֹ לְהִתְקַדֵּשׁ</tei:l>
          <tei:l>אַדִּיר יְהֹוָה שָׁם לֹא יַעַבְרֶֽנּוּ טָמֵא לְהָדֵשׁ</tei:l>
          <tei:l>לֹא־יוֹסִיף לָבוֹא בּוֹ עָרֵל וְקָדֵשׁ</tei:l>
          <tei:l>שְׂרִידִים אֲשֶׁר יְהֹוָה קוֹרֵא יִכָּנְסוּ לַפַּרְדֵּס</tei:l>
          <tei:l>לִבְשִׁ֣י ׀ בִּגְדֵ֣י תִפְאַרְתֵּ֗ךְ יְרוּשָׁלַ֙͏ִם֙ עִ֣יר הַקֹּ֔דֶשׁ׃ <tei:bibl>(ישעיה נב:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/52"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בְּרֹ</tei:seg>אשׁ חֲמִשָּׁה הָרִים מִקְדַּשׁ אֵל לְכוֹנְנָה</tei:l>
          <tei:l><tei:seg type="acrostic">בֵּי</tei:seg>ת אֱלֹהִים תַּֽחַת זִיו כְּבוֹדוֹ לְגוֹנְנָה</tei:l>
          <tei:l><tei:seg type="acrostic">יַ</tei:seg>רְחִֽיבוּ אֹהָלֶֽיהָ יְרִיעוֹת מִשְׁכְּנֹתֶֽיהָ יַֽטּוּ לְשַׁכְּנָה</tei:l>
          <tei:l><tei:seg type="acrostic">ע</tei:seg>וֹלָה וּמַרְחֶֽבֶת לְמַֽעְלָה וְנָסְבָה וְרָחֲבָה בָּעֶלְיוֹנָה</tei:l>
          <tei:l><tei:seg type="acrostic">קְב</tei:seg>וּצֵי גָּלֻיּוֹת מִתְקַבְּצוֹת וְנָחוֹת בְּבֵית מְלוֹנָה</tei:l>
          <tei:l>וּפְדוּיֵ֨י יְהֹוָ֜ה יְשֻׁב֗וּן וּבָ֤אוּ צִיּוֹן֙ בְּרִנָּ֔ה׃ <tei:bibl>(ישעיה לה:י)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/53"/>
        <tei:lg>
          <tei:l>חָׄזָׄקׄ וְׄאַׄמִּׄץׄ לְעֵינֵֽינוּ רוּחוֹ הַטּוֹבָה יָעִיר</tei:l>
          <tei:l>שְׁנַת גְּאֻלָּה יַרְאֵֽנוּ יְחַיֵּֽנוּ רַב וְצָעִיר</tei:l>
          <tei:l>מִיַּד בֶּן־נֵכָר יִפְצֵֽנוּ מִיַּד בְּנֵי שֵׂעִיר</tei:l>
          <tei:l>קוֹל מֵהֵיכָל קוֹל שָׁאוֹן מַחֲרִיבָיו יַסְעִיר</tei:l>
          <tei:l>חוֹמַת אֵשׁ סָבִיב לָהּ שַׁלֵּם יְשַׁלֵּם הַמַּבְעִיר</tei:l>
          <tei:l>הִתְפַּלְלוּ בַעֲדָהּ וְדִרְשׁוּ אֶת־שְׁלוֹם הָעִיר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_7th_day_of_pesach_menachem/54"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה</tei:l>
          <tei:l>הַפּוֹרֵשׂ סֻכַּת שָׁלוֹם עָלֵֽינוּ</tei:l>
          <tei:l>וְעַל־כׇּל־עַמּוֹ יִשְׂרָאֵל</tei:l>
          <tei:l>וְעַל־יְרוּשָׁלָיִם׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
