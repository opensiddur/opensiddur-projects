  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/133">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/133/1"/>
        <tei:lg>
          <tei:l>שִׁ֥יר הַֽמַּעֲל֗וֹת לְדָ֫וִ֥ד</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>הִנֵּ֣ה מַה־טּ֭וֹב וּמַה־נָּעִ֑ים</tei:l>
          <tei:l>שֶׁ֖בֶת אַחִ֣ים גַּם־יָֽחַד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/133/2/a"/>
        <tei:lg>
          <tei:l>כַּשֶּׁ֤מֶן הַטּ֨וֹב ׀</tei:l>
          <tei:l>עַל־הָרֹ֗אשׁ יֹרֵ֗ד עַֽל־הַזָּקָ֥ן זְקַֽן־אַהֲרֹ֑ן</tei:l>
          <tei:l>שֶׁ֝יֹּרֵ֗ד עַל־פִּ֥י מִדּוֹתָֽיו׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/133/2/b"/>
        <tei:lg>
          <tei:l>כְּטַל־חֶרְמ֗וֹן שֶׁיֹּרֵד֮ עַל־הַרְרֵ֢י צִ֫יּ֥וֹן</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>כִּ֤י שָׁ֨ם ׀ צִוָּ֣ה יְ֭הֹוָה אֶת־הַבְּרָכָ֑ה</tei:l>
          <tei:l>חַ֝יִּ֗ים עַד־הָעוֹלָֽם׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
