  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:adamah_veshamayim_polisson">
        <tei:head>אדמה ושמים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adamah_veshamayim_polisson/1"/>
        <tei:lg>
          <tei:l>אני יושב וצופה על העשבים הירוקים</tei:l>
          <tei:l>חורש העצים לפני, לשמאל</tei:l>
          <tei:l>אני שר</tei:l>
          <tei:l>אדמה ושמים</tei:l>
          <tei:l>חום האש</tei:l>
          <tei:l>צליל המיים</tei:l>
          <tei:l>אני מרגיש זאת</tei:l>
          <tei:l>בגופי</tei:l>
          <tei:l>ברוחי</tei:l>
          <tei:l>ובנשמתי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adamah_veshamayim_polisson/2"/>
        <tei:lg>
          <tei:l>אבל האם אני מרגיש</tei:l>
          <tei:l>את הכאב</tei:l>
          <tei:l>את הסבל</tei:l>
          <tei:l>של בני אדם עמיתים, בני חוה</tei:l>
          <tei:l>בני עדן</tei:l>
          <tei:l>בני אדמה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adamah_veshamayim_polisson/3"/>
        <tei:lg>
          <tei:l>תשובה, חזרה, היא</tei:l>
          <tei:l>לשוב לעדן, כן</tei:l>
          <tei:l>אבל גם שוב לגיהנום</tei:l>
          <tei:l>שבו גופים הוקרבו</tei:l>
          <tei:l>לאלים כוזבים</tei:l>
          <tei:l>של שנאה ואש</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adamah_veshamayim_polisson/4"/>
        <tei:lg>
          <tei:l>יהי גשם שמיני עצרת</tei:l>
          <tei:l>יבא מהר</tei:l>
          <tei:l>לשטוף את השנאה</tei:l>
          <tei:l>לכבות את הלהבות</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adamah_veshamayim_polisson/5"/>
        <tei:lg>
          <tei:l>יהי אדמה ושמים</tei:l>
          <tei:l>יתדחשו ויחדשו אותנו</tei:l>
          <tei:l>סולחים את חטאתינו</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adamah_veshamayim_polisson/6"/>
        <tei:lg>
          <tei:l>יהי המלך בשדה</tei:l>
          <tei:l>ישיבינו ונשובה</tei:l>
          <tei:l>מחדש ימינו כקדם</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
