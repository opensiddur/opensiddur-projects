      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_an_organ_transplant_recipient_levine">
        <tei:head>תְּפִלָּה קֹדֶם קַבָּלַת תְּרוּמַת אֵיבָר</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_an_organ_transplant_recipient_levine/1"/>
        <tei:lg>
          <tei:l>חַסְדֵי ה׳ כִּי לֹא תָמְנוּ</tei:l>
          <tei:l>כִּי לֹא כָלוּ רַחֲמָיו <tei:bibl>(איכה ג:כב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_an_organ_transplant_recipient_levine/2"/>
        <tei:lg>
          <tei:l>רִבּוֹנוֹ שֶׁל עוֹלָם,</tei:l>
          <tei:l>נִצָּב/נִצֶּבֶת אֲנִי לְפָנֶיךָ עַתָּה</tei:l>
          <tei:l>בְּיִרְאָה וּבְאַהֲבָה,</tei:l>
          <tei:l>בְּחֶרְדַּת קֹדֶשׁ עֲצוּמָה,</tei:l>
          <tei:l>וּבְהַכָּרַת טוֹב אַדִּירָה,</tei:l>
          <tei:l>קֹדֶם שֶׁאֲנִי עוֹמֵד/עוֹמֶדֶת לַעֲבֹר נִתּוּחַ לְהַשְׁתָּלַת אֵיבָר בְּגוּפִי.</tei:l>
          <tei:l>נוֹשֵׂא/נוֹשֵׂאת אֲנִי אֶת עֵינַי אֵלֶיךָ הַשָּׁמַיְמָה</tei:l>
          <tei:l>שֶׁתְּחָנֵּנִי וְתַשְׁפִּיעַ בִּרְכוֹתֶיךָ עָלַי,</tei:l>
          <tei:l>וְהַהַשְׁתָּלָה שֶׁאֶעֱבֹר תִּצְלַח,</tei:l>
          <tei:l>וְגוּפִי יִקְלֹט אֶת הָאֵיבָר הַמֻּשְׁתָּל,</tei:l>
          <tei:l>וְלֹא יִדְחֶה אוֹתוֹ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_an_organ_transplant_recipient_levine/3"/>
        <tei:lg>
          <tei:l>וְזַכֵּנִי לְהִתְרַפֵּא בִּרְפוּאָה שְׁלֵמָה,</tei:l>
          <tei:l>לִהְיוֹת בָּרִיא אוּלָם,</tei:l>
          <tei:l>וּלְהַאֲרִיךְ יָמִים וְשָׁנִים בַּטּוֹב</tei:l>
          <tei:l>וּבַנְּעִימִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_an_organ_transplant_recipient_levine/4"/>
        <tei:lg>
          <tei:l>וְתַצְלִיחַ אֶת דַּרְכָּם שֶׁל הָרוֹפְאִים</tei:l>
          <tei:l>וְהַצְּוָתִים הָרְפוּאִיִּים</tei:l>
          <tei:l>הָעוֹמְדִים לְבַצֵּעַ בִּי אֶת הַהַשְׁתָּלָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_an_organ_transplant_recipient_levine/5"/>
        <tei:lg>
          <tei:l>אֲסִיר/אֲסִירַת תּוֹדָה אֲנִי מֵעִמְקֵי הֲוָיָתִי</tei:l>
          <tei:l>עַל הַחֶסֶד הֶעָצוּם הַנַּעֲשֶׂה עִמָּדִי,</tei:l>
          <tei:l>שֶׁאֵיבְרֵי הַנִּפְטָר נִתְרָמִים לְאַחַר מוֹתוֹ.</tei:l>
          <tei:l>תַּעֲמֹד זְכוּת זוֹ שֶׁל הַצָּלַת חַיִּים</tei:l>
          <tei:l>לְעִלּוּי נִשְׁמָתוֹ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_an_organ_transplant_recipient_levine/6"/>
        <tei:lg>
          <tei:l>מוֹדֶה/מוֹדָה אֲנִי מִקֶּרֶב לֵב לִבְנֵי מִשְׁפַּחְתּוֹ</tei:l>
          <tei:l>הָעוֹסְקִים בִּמְלֶאכֶת הַתְּרוּמָה</tei:l>
          <tei:l>וּבְהוֹצָאָתָהּ מִן הַכּוֹחַ אֶל הַפֹּעַל.</tei:l>
          <tei:l>הָרוֹפֵא לִשְׁבוּרֵי לֵב,</tei:l>
          <tei:l>אָנָּא חַזְּקֵם וְאַמְּצֵם עַתָּה לְאַחַר אָבְדַן שְׁאֵר בְּשָׂרָם,</tei:l>
          <tei:l>וּבָרְכֵם בִּכְלַל הַבְּרָכוֹת הָאֲמוּרוֹת וְהַכְּתוּבוֹת בַּתּוֹרָה.</tei:l>
          <tei:l>כִּי אֵל שׁוֹמֵעַ תְּפִלּוֹת וְתַחֲנוּנִים אַתָּה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_an_organ_transplant_recipient_levine/7"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה שׁוֹמֵעַ תְּפִלָּה.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
