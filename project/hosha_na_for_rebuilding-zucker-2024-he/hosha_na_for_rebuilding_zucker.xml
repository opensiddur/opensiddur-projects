    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_zucker">
        <tei:head>הוֹשִׁיעָה נָא לשנת תשפ״ה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_zucker/1"/>
        <tei:lg>
          <tei:l>הוֹשִׁיעָה נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_zucker/2"/>
        <tei:lg>
          <tei:l>אָנָּא פְּתַח־נָא שַׁעֲרֵי יְשׁוּעָתְךָ מֵחָדָשׁ</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_zucker/3"/>
        <tei:lg>
          <tei:l>לְמַעַנְךָ וּלְמַעֲנֵנוּ</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_zucker/4"/>
        <tei:lg>
          <tei:l>לְמַעַן זִכְרָם שֶׁל כָּל הַהֲרוּגִים,</tei:l>
          <tei:l>אֲנָשִׁים, נָשִׁים וָטַף</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_zucker/5"/>
        <tei:lg>
          <tei:l>לְמַעַן חֲזָרָתָם שֶׁל חֲטוּפוֹת וַחֲטוּפִים, שְׁבוּיוֹת וּשְׁבוּיִים</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_zucker/6"/>
        <tei:lg>
          <tei:l>לְמַעַן שׁוּבָם שֶׁל הָעֲקוּרִים לְבֵיתָם</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_zucker/7"/>
        <tei:lg>
          <tei:l>לְמַעַן רְפוּאָתָם שֶׁל הַפְּצוּעִים</tei:l>
          <tei:l>בַּגּוּף וּבַנֶּפֶשׁ</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_zucker/8"/>
        <tei:lg>
          <tei:l>לְמַעַן הַחַיָּלִים הַלּוֹחֲמִים בְּעֹז</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_zucker/9"/>
        <tei:lg>
          <tei:l>לְמַעַן חַיָּלֵי הַסָּדִיר שֶׁלֹּא מִשְׁתַּחְרְרִים</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_zucker/10"/>
        <tei:lg>
          <tei:l>לְמַעַן חַיָּלֵי הַמִּלּוּאִים הָעוֹזְבִים מִשְׁפָּחוֹת, לִמּוּדִים וַעֲבוֹדָה</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_zucker/11"/>
        <tei:lg>
          <tei:l>לְמַעַן הַמִּשְׁפָּחוֹת הַתּוֹמְכוֹת בָּעֹרֶף</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_zucker/12"/>
        <tei:lg>
          <tei:l>לְמַעַן מַעֲשֵׂי הַחֶסֶד הָרַבִּים</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_zucker/13"/>
        <tei:lg>
          <tei:l>לְמַעַן אַלְפֵי הַמִּתְנַדְּבִים בָּעָם</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_zucker/14"/>
        <tei:lg>
          <tei:l>לְמַעַן חַקְלָאִים וּמִפְעָלִים הַמַּמְשֵׁיכֶם תַּחַת אֵשׁ</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_zucker/15"/>
        <tei:lg>
          <tei:l>לְמַעַן הַיִּשּׁוּבִים הַקָּמִים מֵחֻרְבָּנָם</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_zucker/16"/>
        <tei:lg>
          <tei:l>לְמַעַן כָּל אֵלּוּ שֶׁאֲנַחְנוּ מַזְכִּירִים בַּלֵּב</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_zucker/17"/>
        <tei:lg>
          <tei:l>לְמַעַן קִיּוּם עַם יִשְׂרָאֵל בְּאַרְצוֹ</tei:l>
          <tei:l>הוֹשַׁע נָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_rebuilding_zucker/18"/>
        <tei:lg>
          <tei:l>אָנָּא ה׳</tei:l>
          <tei:l>הוֹשִׁיעָה נָּא</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
