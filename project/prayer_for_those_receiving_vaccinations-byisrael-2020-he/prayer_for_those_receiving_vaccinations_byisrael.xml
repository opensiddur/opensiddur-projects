  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_those_receiving_vaccinations_byisrael">
        <tei:head>תפילה למתחסן/ת</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_those_receiving_vaccinations_byisrael/1"/>
        <tei:lg>
          <tei:l>הָאֵל הָעוֹנֶה בְּעֵת צָרָה וּמוֹשִׁיעַ,</tei:l>
          <tei:l>הָרֹפֵא לִשְׁבוּרֵי לֵב</tei:l>
          <tei:l>וּמְחַבֵּשׁ לְעַצְּבוֹתָם <tei:bibl>(תהלים קמז:ג)</tei:bibl>,</tei:l>
          <tei:l>שֶׁחָלַק מֵחָכְמָתוֹ לְבָשָׂר וָדָם</tei:l>
          <tei:l>אֲשֶׁר הֵבִיאוּ לִיצִירַת חִסּוּן זֶה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_those_receiving_vaccinations_byisrael/2"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן מִלְּפָנֶיךָ,</tei:l>
          <tei:l>שֶׁבְּכֹחַ מַעֲשֵׂי אֱנוֹשׁ</tei:l>
          <tei:l>בְּעֶזְרַת הַחוֹנֵן לְאָדָם דַּעַת</tei:l>
          <tei:l>וּמְלַמֵּד לֶאֱנוֹשׁ בִּינָה, מַדָּע וְהַשְׂכֵּל</tei:l>
          <tei:l>אֶזְכֶּה לִבְרִיאוּת וְחֹסֶן</tei:l>
          <tei:l>וִיקֻיַּם בָּנוּ הַכָּתוּב</tei:l>
          <tei:l>”וַהֲסִרֹתִי מַחֲלָה מִקִּרְבֶּךָ“ <tei:bibl>(שמות כג:כה)</tei:bibl></tei:l>
          <tei:l>”כִּי אֲנִי ה׳ רֹפְאֶךָ“ <tei:bibl>(שמות טו:כו)</tei:bibl>.</tei:l>
          <tei:l>”יוֹדוּ לַה׳ חַסְדּוֹ</tei:l>
          <tei:l>וְנִפְלְאוֹתָיו לִבְנֵי אָדָם“. <tei:bibl>(תהלים קז:ח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_those_receiving_vaccinations_byisrael/3"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה,</tei:l>
          <tei:l>רוֹפֵא כׇל בָּשָׂר</tei:l>
          <tei:l>וּמַפְלִיא לַעֲשׂוֹת.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
