  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/120">
        <tei:head>תהלים ק״כ</tei:head>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">הַיּוֹם יוֹם צוֹם גְּדַלְיָהוּ הוּא צוֹם הַשְּׁבִיעִי וּבוֹ יֵשׁ אוֹמְרִים׃ תהלים קכ, קכא:א-ב</tei:note>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>שִׁ֗יר הַֽמַּ֫עֲל֥וֹת</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>אֶל־יְ֭הֹוָה בַּצָּרָ֣תָה לִּ֑י</tei:l>
          <tei:l>קָ֝רָ֗אתִי וַֽיַּעֲנֵֽנִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/120/2/a"/>
        <tei:lg>
          <tei:l>יְֽהֹוָ֗ה הַצִּ֣ילָה נַ֭פְשִׁי מִשְּׂפַת־שֶׁ֑קֶר</tei:l>
          <tei:l>מִלָּשׁ֥וֹן רְמִיָּֽה׃</tei:l>
          <tei:l>מַה־יִּתֵּ֣ן לְ֭ךָ וּמַה־יֹּסִ֥יף לָ֗ךְ</tei:l>
          <tei:l>לָשׁ֥וֹן רְמִיָּֽה׃</tei:l>
          <tei:l>חִצֵּ֣י גִבּ֣וֹר שְׁנוּנִ֑ים</tei:l>
          <tei:l>עִ֗֝ם גַּחֲלֵ֥י רְתָמִֽים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/120/5/a"/>
        <tei:lg>
          <tei:l>
            <tei:seg type="cantillation" subtype="job">אֽוֹיָה־לִ֭י כִּי־גַ֣רְתִּי מֶ֑שֶׁךְ</tei:seg>
          </tei:l>
          <tei:l>
            <tei:seg type="cantillation" subtype="job">שָׁ֝כַ֗נְתִּי עִֽם־אׇהֳלֵ֥י קֵדָֽר׃</tei:seg>
          </tei:l>
          <tei:l>
            <tei:seg type="cantillation" subtype="job">רַ֭בַּת שָֽׁכְנָה־לָּ֣הּ נַפְשִׁ֑י</tei:seg>
          </tei:l>
          <tei:l>
            <tei:seg type="cantillation" subtype="job">עִ֗֝ם שׂוֹנֵ֥א שָׁלֽוֹם׃</tei:seg>
          </tei:l>
          <tei:l>
            <tei:seg type="cantillation" subtype="job">אֲֽנִי־שָׁ֭לוֹם וְכִ֣י אֲדַבֵּ֑ר</tei:seg>
          </tei:l>
          <tei:l>
            <tei:seg type="cantillation" subtype="job">הֵ֗֝מָּה לַמִּלְחָמָֽה׃</tei:seg>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/120/5/b"/>
        <tei:lg>
          <tei:l>שִׁ֗יר לַֽמַּ֫עֲל֥וֹת</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>אֶשָּׂ֣א עֵ֭ינַי אֶל־הֶהָרִ֑ים</tei:l>
          <tei:l>מֵ֝אַ֗יִן יָבֹ֥א עֶזְרִֽי׃</tei:l>
          <tei:l>עֶ֭זְרִי מֵעִ֣ם יְהֹוָ֑ה</tei:l>
          <tei:l>עֹ֝שֵׂ֗ה שָׁמַ֥יִם וָאָֽרֶץ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
