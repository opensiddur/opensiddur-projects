  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:supplemental_stanza_to_maoz_tzur_with_regard_to_the_present">
        <tei:head>תוספת בית למעוז צור</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:supplemental_stanza_to_maoz_tzur_with_regard_to_the_present/1"/>
        <tei:lg>
          <tei:l>מֵׄעוֹלָם הָיִֽיתָ יִשְׁעִי</tei:l>
          <tei:l>כְּבוֹדִי וּמֵרִים רֹאשִׁי</tei:l>
          <tei:l>שְׁׄמַע־נָא<tei:anchor xml:id="note_1"/> קוֹל שַׁוְּעִי</tei:l>
          <tei:l>מַלְכִּי אֱלֹהֵי<tei:anchor xml:id="note_2"/> קְדוֹשִׁי</tei:l>
          <tei:l>הַׄעֲבֵר חָטָאתִי וּפִשְׁעִי</tei:l>
          <tei:l>גַּם בַּגָּלוּת הַשְּׁלִישִׁי<tei:anchor xml:id="note_3"/></tei:l>
          <tei:l>וּמַכְנִֽיעַ<tei:anchor xml:id="note_4"/> יִשְׁמָעֵאל</tei:l>
          <tei:l>חַׄזֵּׄקׄ יִשְׂרָאֵל</tei:l>
          <tei:l>וּמֵאֱדוֹם תִּפְדֶּה נַפְשִׁי׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" n="1" target="#note_1">
      <tei:p>נ״א יִשְׁמַע־נָא וזהו נוסח טעות לפי האקרוסטיקון</tei:p>
    </tei:note>
    <tei:note type="commentary" n="2" target="#note_2">
      <tei:p>נ״א וֵאלֹהֵי</tei:p>
    </tei:note>
    <tei:note type="commentary" n="3" target="#note_3">
      <tei:p>נ״א הָרְבִיעִי וזהו נוסח טעות לפי סכמת החריזה</tei:p>
    </tei:note>
    <tei:note type="commentary" n="4" target="#note_4">
      <tei:p>נ״א וְתַכְנִֽיעַ</tei:p>
    </tei:note>
  </tei:standOff>
