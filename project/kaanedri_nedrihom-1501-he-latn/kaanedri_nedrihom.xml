    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:kaanedri_nedrihom">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:kaanedri_nedrihom/1"/>
        <tei:lg xml:lang="aju-Latn">
          <tei:l>Kaa-nədri nədri-hom!</tei:l>
          <tei:l>Nədri-hom bəl-waaḥəd.</tei:l>
          <tei:l>Waaḥəd huwaa Allah.</tei:l>
          <tei:l>Barouḵ hu barouḵ səmo. <tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:kaanedri_nedrihom/2"/>
        <tei:lg xml:lang="aju-Latn">
          <tei:l>Kaa-nədri nədri-hom!</tei:l>
          <tei:l>Nədri-hom bəl-zouz.</tei:l>
          <tei:l>Zouz Mose w-Aharon.</tei:l>
          <tei:l>Waaḥəd huwaa Allah.</tei:l>
          <tei:l>Barouḵ hu barouḵ səmo. <tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:kaanedri_nedrihom/3"/>
        <tei:lg xml:lang="aju-Latn">
          <tei:l>Kaa-nədri nədri-hom!</tei:l>
          <tei:l>Nədri-hom bəl-təlaataa.</tei:l>
          <tei:l>Təlaataa huma Aḇot —</tei:l>
          <tei:l>Aḇraham, Yiṣḥaq, Yaȝaqoḇ.</tei:l>
          <tei:l>Zouz Mose w-Aharon.</tei:l>
          <tei:l>Waaḥəd huwaa Allah.</tei:l>
          <tei:l>Barouḵ hu barouḵ səmo. <tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:kaanedri_nedrihom/4"/>
        <tei:lg xml:lang="aju-Latn">
          <tei:l>Kaa-nədri nədri-hom!</tei:l>
          <tei:l>Nədri-hom bəl-arbəȝa.</tei:l>
          <tei:l>Arbəȝa dəl-Imahot —</tei:l>
          <tei:l>Sara, Riḇqa, Lea, Raḥel.</tei:l>
          <tei:l>Təlaataa huma Aḇot —</tei:l>
          <tei:l>Aḇraham, Yiṣḥaq, Yaȝaqoḇ.</tei:l>
          <tei:l>Zouz Mose w-Aharon.</tei:l>
          <tei:l>Waaḥəd huwaa Allah.</tei:l>
          <tei:l>Barouḵ hu barouḵ səmo. <tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:kaanedri_nedrihom/5"/>
        <tei:lg xml:lang="aju-Latn">
          <tei:l>Kaa-nədri nədri-hom!</tei:l>
          <tei:l>Nədri-hom bəl-ḥəmsaa.</tei:l>
          <tei:l>Ḥəmsaa ḥəmas əl-Tora.</tei:l>
          <tei:l>Arbəȝa dəl-Imahot —</tei:l>
          <tei:l>Sara, Riḇqa, Lea, Raḥel.</tei:l>
          <tei:l>Təlaataa huma Aḇot —</tei:l>
          <tei:l>Aḇraham, Yiṣḥaq, Yaȝaqoḇ.</tei:l>
          <tei:l>Zouz Mose w-Aharon.</tei:l>
          <tei:l>Waaḥəd huwaa Allah.</tei:l>
          <tei:l>Barouḵ hu barouḵ səmo. <tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:kaanedri_nedrihom/6"/>
        <tei:lg xml:lang="aju-Latn">
          <tei:l>Kaa-nədri nədri-hom!</tei:l>
          <tei:l>Nədri-hom bəl-səttaa.</tei:l>
          <tei:l>Səttaa sidre Misna.</tei:l>
          <tei:l>Ḥəmsaa ḥəmas əl-Tora.</tei:l>
          <tei:l>Arbəȝa dəl-Imahot —</tei:l>
          <tei:l>Sara, Riḇqa, Lea, Raḥel.</tei:l>
          <tei:l>Təlaataa huma Aḇot —</tei:l>
          <tei:l>Aḇraham, Yiṣḥaq, Yaȝaqoḇ.</tei:l>
          <tei:l>Zouz Mose w-Aharon.</tei:l>
          <tei:l>Waaḥəd huwaa Allah.</tei:l>
          <tei:l>Barouḵ hu barouḵ səmo. <tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:kaanedri_nedrihom/7"/>
        <tei:lg xml:lang="aju-Latn">
          <tei:l>Kaa-nədri nədri-hom!</tei:l>
          <tei:l>Nədri-hom bəl-səbȝaa.</tei:l>
          <tei:l>Səbȝi-yaam dəl-ḥuppa.</tei:l>
          <tei:l>Səttaa sidre Misna.</tei:l>
          <tei:l>Ḥəmsaa ḥəmas əl-Tora.</tei:l>
          <tei:l>Arbəȝa dəl-Imahot —</tei:l>
          <tei:l>Sara, Riḇqa, Lea, Raḥel.</tei:l>
          <tei:l>Təlaataa huma Aḇot —</tei:l>
          <tei:l>Aḇraham, Yiṣḥaq, Yaȝaqoḇ.</tei:l>
          <tei:l>Zouz Mose w-Aharon.</tei:l>
          <tei:l>Waaḥəd huwaa Allah.</tei:l>
          <tei:l>Barouḵ hu barouḵ səmo. <tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:kaanedri_nedrihom/8"/>
        <tei:lg xml:lang="aju-Latn">
          <tei:l>Kaa-nədri nədri-hom!</tei:l>
          <tei:l>Nədri-hom bəl-təmniyyaa.</tei:l>
          <tei:l>Təmniy-yaam dəl-milla.</tei:l>
          <tei:l>Səbȝi-yaam dəl-ḥuppa.</tei:l>
          <tei:l>Səttaa sidre Misna.</tei:l>
          <tei:l>Ḥəmsaa ḥəmas əl-Tora.</tei:l>
          <tei:l>Arbəȝa dəl-Imahot —</tei:l>
          <tei:l>Sara, Riḇqa, Lea, Raḥel.</tei:l>
          <tei:l>Təlaataa huma Aḇot —</tei:l>
          <tei:l>Aḇraham, Yiṣḥaq, Yaȝaqoḇ.</tei:l>
          <tei:l>Zouz Mose w-Aharon.</tei:l>
          <tei:l>Waaḥəd huwaa Allah.</tei:l>
          <tei:l>Barouḵ hu barouḵ səmo. <tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:kaanedri_nedrihom/9"/>
        <tei:lg xml:lang="aju-Latn">
          <tei:l>Kaa-nədri nədri-hom!</tei:l>
          <tei:l>Nədri-hom bəl-təsȝoud.</tei:l>
          <tei:l>Təsȝa səhur dəl-ḥabəlaa.</tei:l>
          <tei:l>Təmniy-yaam dəl-milla.</tei:l>
          <tei:l>Səbȝi-yaam dəl-ḥuppa.</tei:l>
          <tei:l>Səttaa sidre Misna.</tei:l>
          <tei:l>Ḥəmsaa ḥəmas əl-Tora.</tei:l>
          <tei:l>Arbəȝa dəl-Imahot —</tei:l>
          <tei:l>Sara, Riḇqa, Lea, Raḥel.</tei:l>
          <tei:l>Təlaataa huma Aḇot —</tei:l>
          <tei:l>Aḇraham, Yiṣḥaq, Yaȝaqoḇ.</tei:l>
          <tei:l>Zouz Mose w-Aharon.</tei:l>
          <tei:l>Waaḥəd huwaa Allah.</tei:l>
          <tei:l>Barouḵ hu barouḵ səmo. <tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:kaanedri_nedrihom/10"/>
        <tei:lg xml:lang="aju-Latn">
          <tei:l>Kaa-nədri nədri-hom!</tei:l>
          <tei:l>Nədri-hom bəl-ȝasraa.</tei:l>
          <tei:l>Ȝasraa di minyan.</tei:l>
          <tei:l>Təsȝa səhur dəl-ḥabəlaa.</tei:l>
          <tei:l>Təmniy-yaam dəl-milla.</tei:l>
          <tei:l>Səbȝi-yaam dəl-ḥuppa.</tei:l>
          <tei:l>Səttaa sidre Misna.</tei:l>
          <tei:l>Ḥəmsaa ḥəmas əl-Tora.</tei:l>
          <tei:l>Arbəȝa dəl-Imahot —</tei:l>
          <tei:l>Sara, Riḇqa, Lea, Raḥel.</tei:l>
          <tei:l>Təlaataa huma Aḇot —</tei:l>
          <tei:l>Aḇraham, Yiṣḥaq, Yaȝaqoḇ.</tei:l>
          <tei:l>Zouz Mose w-Aharon.</tei:l>
          <tei:l>Waaḥəd huwaa Allah.</tei:l>
          <tei:l>Barouḵ hu barouḵ səmo. <tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:kaanedri_nedrihom/11"/>
        <tei:lg xml:lang="aju-Latn">
          <tei:l>Kaa-nədri nədri-hom!</tei:l>
          <tei:l>Nədri-hom bəl-ḥədaas.</tei:l>
          <tei:l>Ḥədaas dəl-koḵaḇim.</tei:l>
          <tei:l>Ȝasraa di minyan.</tei:l>
          <tei:l>Təsȝa səhur dəl-ḥabəlaa.</tei:l>
          <tei:l>Təmniy-yaam dəl-milla.</tei:l>
          <tei:l>Səbȝi-yaam dəl-ḥuppa.</tei:l>
          <tei:l>Səttaa sidre Misna.</tei:l>
          <tei:l>Ḥəmsaa ḥəmas əl-Tora.</tei:l>
          <tei:l>Arbəȝa dəl-Imahot —</tei:l>
          <tei:l>Sara, Riḇqa, Lea, Raḥel.</tei:l>
          <tei:l>Təlaataa huma Aḇot —</tei:l>
          <tei:l>Aḇraham, Yiṣḥaq, Yaȝaqoḇ.</tei:l>
          <tei:l>Zouz Mose w-Aharon.</tei:l>
          <tei:l>Waaḥəd huwaa Allah.</tei:l>
          <tei:l>Barouḵ hu barouḵ səmo. <tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:kaanedri_nedrihom/12"/>
        <tei:lg xml:lang="aju-Latn">
          <tei:l>Kaa-nədri nədri-hom!</tei:l>
          <tei:l>Nədri-hom bəl-tənaas.</tei:l>
          <tei:l>Tənaas dəl-səḇaṭim.</tei:l>
          <tei:l>Ḥədaas dəl-koḵaḇim.</tei:l>
          <tei:l>Ȝasraa di minyan.</tei:l>
          <tei:l>Təsȝa səhur dəl-ḥabəlaa.</tei:l>
          <tei:l>Təmniy-yaam dəl-milla.</tei:l>
          <tei:l>Səbȝi-yaam dəl-ḥuppa.</tei:l>
          <tei:l>Səttaa sidre Misna.</tei:l>
          <tei:l>Ḥəmsaa ḥəmas əl-Tora.</tei:l>
          <tei:l>Arbəȝa dəl-Imahot —</tei:l>
          <tei:l>Sara, Riḇqa, Lea, Raḥel.</tei:l>
          <tei:l>Təlaataa huma Aḇot —</tei:l>
          <tei:l>Aḇraham, Yiṣḥaq, Yaȝaqoḇ.</tei:l>
          <tei:l>Zouz Mose w-Aharon.</tei:l>
          <tei:l>Waaḥəd huwaa Allah.</tei:l>
          <tei:l>Barouḵ hu barouḵ səmo. <tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:kaanedri_nedrihom/13"/>
        <tei:lg xml:lang="aju-Latn">
          <tei:l>Kaa-nədri nədri-hom!</tei:l>
          <tei:l>Nədri-hom bəl-təltaas.</tei:l>
          <tei:l>Təltaas dəl-təfillin.</tei:l>
          <tei:l>Tənaas dəl-səḇaṭim.</tei:l>
          <tei:l>Ḥədaas dəl-koḵaḇim.</tei:l>
          <tei:l>Ȝasraa di minyan.</tei:l>
          <tei:l>Təsȝa səhur dəl-ḥabəlaa.</tei:l>
          <tei:l>Təmniy-yaam dəl-milla.</tei:l>
          <tei:l>Səbȝi-yaam dəl-ḥuppa.</tei:l>
          <tei:l>Səttaa sidre Misna.</tei:l>
          <tei:l>Ḥəmsaa ḥəmas əl-Tora.</tei:l>
          <tei:l>Arbəȝa dəl-Imahot —</tei:l>
          <tei:l>Sara, Riḇqa, Lea, Raḥel.</tei:l>
          <tei:l>Təlaataa huma Aḇot —</tei:l>
          <tei:l>Aḇraham, Yiṣḥaq, Yaȝaqoḇ.</tei:l>
          <tei:l>Zouz Mose w-Aharon.</tei:l>
          <tei:l>Waaḥəd huwaa Allah.</tei:l>
          <tei:l>Barouḵ hu barouḵ səmo. <tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
      </tei:div>
