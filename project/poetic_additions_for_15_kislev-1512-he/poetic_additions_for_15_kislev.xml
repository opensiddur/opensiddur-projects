      <tei:div corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev">
        <tei:head>יום טוב של ק״ק קארפינטראס לט״ו בחדש כסליו</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">בלילה קודם ברכו אומרים פיוט זה</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/2"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ואם חל במוצ״ש אומרים תחלה׃</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/3"/>
        <tei:lg>
          <tei:l>יוֹד֖וּךָ עַמִּ֥ים ׀ אֱלֹהִ֑ים</tei:l>
          <tei:l>י֝וֹד֗וּךָ עַמִּ֥ים כֻּלָּֽם׃</tei:l>
          <tei:l>אֶ֭רֶץ נָתְנָ֣ה יְבוּלָ֑הּ</tei:l>
          <tei:l>יְ֝בָרְכֵ֗נוּ אֱלֹהִ֥ים אֱלֹהֵֽינוּ׃</tei:l>
          <tei:l>יְבָרְכֵ֥נוּ אֱלֹהִ֑ים</tei:l>
          <tei:l>וְיִֽירְא֥וּ א֝וֹת֗וֹ כׇּל־אַפְסֵי־אָֽרֶץ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/4"/>
        <tei:lg>
          <tei:l>שְׁאָלֽוּנִי בְּעֵת נְדוֹד רַעְיוֹנַי</tei:l>
          <tei:l>אֵי יְמִין אֵל <tei:note type="instruction">(×3)</tei:note></tei:l>
          <tei:l>וְאֵי זְרֽוֹעַ יְהֹוָה?</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/5"/>
        <tei:lg>
          <tei:l>אֵי הֲדָרוֹ וְאֵי יְקָרוֹ וְאֵי עֹז יַד גְּאוֹנוֹ</tei:l>
          <tei:l>הֲקָצְרָה <tei:note type="instruction">(×3)</tei:note></tei:l>
          <tei:l>יָד יְהֹוָה?</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/6"/>
        <tei:lg>
          <tei:l>מִגְּאוֹל עַם אֲשֶׁר בְּמַחְשָׁךְ הוּא מְקַוֶּה</tei:l>
          <tei:l>אוֹר יְשׁוּעָה <tei:note type="instruction">(×3)</tei:note></tei:l>
          <tei:l>וְנוֹדַע יָד יְהֹוָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/7"/>
        <tei:lg>
          <tei:l>יוֹם לְיוֹם כׇּל־יְמֵי הֱיוֹתְכֶם בְּעוֹדְכֶם</tei:l>
          <tei:l>קַדְּשׁוּ אֵל <tei:note type="instruction">(×3)</tei:note></tei:l>
          <tei:l>וּבָרְכוּ אֶת־יְהֹוָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/8"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ואומרים ערבית כמו בחול עד כי מעולם קוינו לך ואמרים,/span&gt;</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/9"/>
        <tei:lg>
          <tei:l>עַל הַנִּסִּים הֶרְאֵתָ אֵלֵינוּ</tei:l>
          <tei:l>קְהַל הָעִבְרִים</tei:l>
          <tei:l>אַתָּ֣ה הָ֭אֵל עֹ֣שֵׂה פֶ֑לֶא</tei:l>
          <tei:l>הָֽיְתָה־לָֽנוּ לְמוֹשָׁעוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/10"/>
        <tei:lg>
          <tei:l>בְּיוֹם חֲמִשָּׁה עָשָׂר לְחֹֽדֶשׁ כִּסְלֵו׃</tei:l>
          <tei:l>בְּקוֹם נֶגְדֵּֽנוּ אַנְשֵׁי הַגְּדוּד נׇכְרִים בָּֽאוּ שְׁעָרֵֽינוּ</tei:l>
          <tei:l>דָּיֵק וְסוֹלְלָה פָּרְשׂוּ לְהַכְחִידֵֽנוּ׃</tei:l>
          <tei:l>וּלְהַכְרִית זֵֽכֶר שְׁאֵרִיתֵֽנוּ</tei:l>
          <tei:l>בְּנֵי בְלִיַּֽעַל בִּעַתּֽוּנוּ הֲמָמֽוּנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/11"/>
        <tei:lg>
          <tei:l>וַתְּהִי צַעֲקַת הַיְּלָדִים רַכִּים גְּדוֹלָה וּמָרָה</tei:l>
          <tei:l>כִּי נַפְשָׁם לַמָּֽוֶת הֶעֱרָה׃</tei:l>
          <tei:l>וְהַנָּשִׁים מְתוֹפְפוֹת עַל־לִבְּהֶן</tei:l>
          <tei:l>וַתִּשֶּֽׂאנָה קִינָה בֵּינֵיהֶן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/12"/>
        <tei:lg>
          <tei:l>לוּלֵי הָאָדוֹן יְהֹוָה צְבָאוֹת</tei:l>
          <tei:l>כִּ֥י נֵע֖וֹר מִמְּע֥וֹן קׇדְשֽׁוֹ גָּמַל עָלֵֽינוּ</tei:l>
          <tei:l>לְהָקִים אֶת־סֻכָּתֵֽנוּ הִצִּיל</tei:l>
          <tei:l>וַיְגָרְשֵׁם מֵעַל גְּבוּלֵֽנוּ׃</tei:l>
          <tei:l>הוֹתִ֥יר לָ֛נוּ שָׂרִ֖יד</tei:l>
          <tei:l>כִּמְעָ֑ט רֶָׄגַׄעׄ חָלְפוּ וְאֵינָם</tei:l>
          <tei:l>וַיֹּאבְדוּ הֵם וְכׇל־הֲמוֹנָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/13"/>
        <tei:lg>
          <tei:l>אוֹהֵב יְהֹוָה שַׁעֲרֵי צִיּוֹן</tei:l>
          <tei:l>הַשָּׁם עֻזּוֹ בְּחֶבְיוֹן׃</tei:l>
          <tei:l>הָֽיָה לָֽנוּ לְחוֹמַת אֵשׁ</tei:l>
          <tei:l>מִגְּאֻלָּתוֹ לֹא נִתְיָאֵשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/14"/>
        <tei:lg>
          <tei:l>כִּי אַתָּה מַלְכֵּֽנוּ וְגוֹאֲלֵֽנוּ</tei:l>
          <tei:l>הַחוֹנֵן הַמַּשְׁגִּֽיחַ תִּקְצַר לְשׁוֹנֵֽנוּ׃</tei:l>
          <tei:l>לְהָלִיץ כֹּֽחַ עַצְמוּתֶֽךָ וַאֲצִילוּתֶֽךָ׃</tei:l>
          <tei:l>וְלָֽנוּ דּוּמִיָּה תְּהִלָּה</tei:l>
          <tei:l>אֲנַֽחְנוּ עֲבָדֶֽיךָ בְּנֵי הַגּוֹלָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/15"/>
        <tei:lg>
          <tei:l>לֹא בְּצִדְקוֹתֵֽינוּ וּבְכִשְׁרוֹן מַעֲשֵֽׂינוּ</tei:l>
          <tei:l>הִשְׁקַֽפְתָּ מִמְּעוֹן קׇדְשְׁךָ לְהַחֲיוֹתֵֽנוּ׃</tei:l>
          <tei:l>כִּי אִם בִּזְכוּת אֵיתָנֵי עוֹלָם</tei:l>
          <tei:l>לִבָּם נָכוֹן כְּפִתְחוֹ שֶׁל אוּלָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/16"/>
        <tei:lg>
          <tei:l>וּלְסִבַּת רֹֽעַ מַעֲלָלֵֽינוּ</tei:l>
          <tei:l>אֵין לָֽנוּ לְהָבִיא קׇרְבַּן תּוֹדָה</tei:l>
          <tei:l>עַל פִּלְאֵי הָעֵדָה׃</tei:l>
          <tei:l>עַל כֵּן בָּֽאוּ פְּדוּיֶֽיךָ</tei:l>
          <tei:l>לְבַקֵּר הֵיכָלֶֽךָ בְּקוֹל רִנָּה</tei:l>
          <tei:l>תִּהְיֶֽינָה יָדֵֽינוּ אֱמוּנָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/17"/>
        <tei:lg>
          <tei:l>וְקָבַֽעְנוּ יוֹם זֶה שִׂמְחָה וַחֲגִיגָה</tei:l>
          <tei:l>לָתֵת שֶֽׁבַח וְהִלּוּל רַב</tei:l>
          <tei:l>אֶל־מְרוֹם כְּבוֹדֶֽךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/18"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ועל כולם...</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">וכן אומרים בברכת המזון בברכת הארץ קודם על הכול׃</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">ואומרים קדיש תתקבל וברכו ועלינו לשבח.</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">ובשחרית אומרים זמירות כמו בחול עד ובתורתך כתוב לאמור ואח״כ אומרים</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/19"/>
        <tei:lg>
          <tei:l>רשות</tei:l>
          <tei:l>
            <tei:note type="instruction">לנועם יסוד הכל</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/20"/>
        <tei:lg>
          <tei:l>אֱלֹהַּ חַי אֲשֶׁר הַכֹּל בְּיָדוֹ</tei:l>
          <tei:l>מְגַלֶּה סִתְרוֹ וְרָזוֹ וְסוֹדוֹ</tei:l>
          <tei:l>יְמִין עֻזּוֹ גְּלוּיָה לְעַבְדּוֹ</tei:l>
          <tei:l>וְהוּא הֵחִישׁ יְשׁוּעָתָם</tei:l>
          <tei:l>וְעָנָה בְּצָרָתָם</tei:l>
          <tei:l>בְּרוּם עֻזּוֹ וְהוֹדוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/21"/>
        <tei:lg>
          <tei:l>מחרך</tei:l>
          <tei:l>לנועם מציב אדמה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/22"/>
        <tei:lg>
          <tei:l>לְאֵל חֵי נַפְשִׁי צְאִי תָּמִיד גְּבוּרוֹת</tei:l>
          <tei:l>עַל־הַנִּסִּים וְעַל־הַגְּבוּרוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/23"/>
        <tei:lg>
          <tei:l>אֶעֱרֹךְ שִׁירַי לְשׁוֹכֵן מֵעוֹנַי</tei:l>
          <tei:l>הֶחֱרִיד צָרַי וְהִפְחִיד מוֹנַי</tei:l>
          <tei:l>חַסְדֵי יְהֹוָה הִקְרָה לְפָנַי</tei:l>
          <tei:l>וּמָצָא לְעֵינַי עֶזְרָה בַּצָּרוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/24"/>
        <tei:lg>
          <tei:l>בַּצַּר הֶעֱמִיד בַּמֶּרְחָב רַגְלִי</tei:l>
          <tei:l>אֶתֵּן תָּמִיד תְּהִלָּה לְאֵלִי</tei:l>
          <tei:l>אוֹיֵב הִשְׁמִיד בְּחַסְדּוֹ לֹא לִי</tei:l>
          <tei:l>לַעֲשׂוֹת הִפְלִיא מֵאֵין סְפוּרוֹת</tei:l>
          <tei:l>לְאֵל חֵי נַפְשִׁי צְאִי תָּמִיד גְּבוּרוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/25"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">נשמת כל חי... עד ...לבדך אנחנו מודים׃</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/26"/>
        <tei:lg>
          <tei:l>נִשְׁמַת בָּנֶֽיךָ הוֹצֵאתֶם מֵאֲנָחָה לְהַנָּחָה</tei:l>
          <tei:l>תְּסַפֵּר נִפְלְאוֹתֶֽיךָ</tei:l>
          <tei:l>עֵת הוֹשַׁעְתָּם מִצָּרָה וְהָיְתָה הָרְוָחָה</tei:l>
          <tei:l>הָפַ֣כְתָּ מִסְפְּדִי֮...</tei:l>
          <tei:l>פִּתַּ֥חְתָּ שַׂקִּ֑י וַֽתְּאַזְּרֵ֥נִי שִׂמְחָֽה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/27"/>
        <tei:lg>
          <tei:l>נִשְׁמַת אֲיֻמָּה נְתוּנָה לָטֶבַח בְּיַד צַר</tei:l>
          <tei:l>תִּתְפַּלֵּל אֶל־יְהוָה</tei:l>
          <tei:l>וּבָכֹה תִּבְכֶּה לֵאמֹר הוֹשִֽׁיעָה יְהֹוָה</tei:l>
          <tei:l>כִּי יָדְךָ לֹא־תִּקְצַר</tei:l>
          <tei:l>הָֽבָה־לָּ֣נוּ עֶזְרָ֣ת מִצָּ֑ר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/28"/>
        <tei:lg>
          <tei:l>נִשְׁמַת אֱמוּנִים יְהַלְּלֽוּךָ</tei:l>
          <tei:l>עַל־רֹב פְּלָאוֹת עֲשִׂיתָם</tei:l>
          <tei:l>נוֹרָ֥א תְהִלֹּ֖ת</tei:l>
          <tei:l>יוֹדוּ כִּי בְחַסְדֶּֽךָ וְלֹא־בְּצִדְקָתָם</tei:l>
          <tei:l>יְמִינְךָ... וְא֥וֹר פָּנֶ֗יךָ כִּ֣י רְצִיתָֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/29"/>
        <tei:lg>
          <tei:l>נִשְׁמַת הַיָּמִים הָאֵֽלֶּה</tei:l>
          <tei:l>הֵם וְגִזְעָם קִיְּמ֣ו וְקִבְּלֻ֣ עֲלֵיהֶם</tei:l>
          <tei:l>לִזְכֹּר יְמֵי יִשְׁעֵם</tei:l>
          <tei:l>וְזִכְרָ֖ם לֹא־יָס֥וּף מִזַּרְעָֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/30"/>
        <tei:lg>
          <tei:l>נִשְׁמַת הַנִּקְרָאִים בְּשֵׁם יַעֲקֹב</tei:l>
          <tei:l>קוֹרְאִים לְעֹֽשֶׂה פֶּֽלֶא</tei:l>
          <tei:l>בְּקוֹל־רִנָּ֥ה וְתוֹדָ֗ה</tei:l>
          <tei:l>מְהַלְּלִים לְאֵל עֲמֻקּוֹת גּוֹלָה</tei:l>
          <tei:l>אוֹמְרִים וְאִֽלּוּ פִנּֽוּ מָלֵא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/31"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">וגומר התפלה כמו שאר ימי החול ואומרים על הנסים בהודאה</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">ואחר העמידה אומרים הלל גמור בלא ברכה׃</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/32"/>
        <tei:lg>
          <tei:l>פיוט להלל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/33"/>
        <tei:lg>
          <tei:l>יִשְׁעֲךָ תִּשְׁלַח אֶל־עַם גּוֹלֶה יוֹרֵד פֶּֽלֶא</tei:l>
          <tei:l>תּוֹךְ בּוֹר כֶּֽלֶא׃</tei:l>
          <tei:l>בִּמְקוֹם קׇרְבָּנוֹ לְךָ יַעֲלֶה שִׁיר מִזְמוֹר</tei:l>
          <tei:l>הַלֵּל הַגָּדוֹל לִגְמֹר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/34"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">קודם הוצאת התורה</tei:note>
          </tei:l>
          <tei:l>
            <tei:bibl>מזמור ק״ז</tei:bibl>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/35"/>
        <tei:lg>
          <tei:l>הֹד֣וּ לַיהֹוָ֣ה כִּי־ט֑וֹב</tei:l>
          <tei:l>כִּ֖י לְעוֹלָ֣ם חַסְדּֽוֹ׃</tei:l>
          <tei:l>יֹ֭אמְרוּ גְּאוּלֵ֣י יְהֹוָ֑ה</tei:l>
          <tei:l>אֲשֶׁ֥ר גְּ֝אָלָ֗ם מִיַּד־צָֽר׃</tei:l>
          <tei:l>וּֽמֵאֲרָצ֗וֹת קִ֫בְּצָ֥ם</tei:l>
          <tei:l>מִמִּזְרָ֥ח וּמִֽמַּעֲרָ֑ב מִצָּפ֥וֹן וּמִיָּֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/36"/>
        <tei:lg>
          <tei:l>תָּע֣וּ בַ֭מִּדְבָּר</tei:l>
          <tei:l>בִּישִׁימ֣וֹן דָּ֑רֶךְ</tei:l>
          <tei:l>עִ֥יר מ֝וֹשָׁ֗ב לֹ֣א מָצָֽאוּ׃</tei:l>
          <tei:l>רְעֵבִ֥ים גַּם־צְמֵאִ֑ים</tei:l>
          <tei:l>נַ֝פְשָׁ֗ם בָּהֶ֥ם תִּתְעַטָּֽף׃</tei:l>
          <tei:l>וַיִּצְעֲק֣וּ אֶל־יְ֭הֹוָה בַּצַּ֣ר לָהֶ֑ם</tei:l>
          <tei:l>מִ֝מְּצ֥וּקוֹתֵיהֶ֗ם יַצִּילֵֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/37"/>
        <tei:lg>
          <tei:l>וַֽ֭יַּדְרִיכֵם בְּדֶ֣רֶךְ יְשָׁרָ֑ה</tei:l>
          <tei:l>לָ֝לֶ֗כֶת אֶל־עִ֥יר מוֹשָֽׁב׃</tei:l>
          <tei:l>יוֹד֣וּ לַיהֹוָ֣ה חַסְדּ֑וֹ</tei:l>
          <tei:l>וְ֝נִפְלְאוֹתָ֗יו לִבְנֵ֥י אָדָֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:poetic_additions_for_15_kislev/38"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ומוציאים ס״ת</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">וקורין ג׳ גברי ב״פ בשלח</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">כהן — מה תצעק אלי</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">לוי — נטה את ידך על הים</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">ישראל — אז ישיר משה</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">וחוזרים ס״ת למקומו</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">וגומרים התפלה כמו שאר ימי החול שאין אומרים בהם תחנות׃</tei:note>
          </tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
