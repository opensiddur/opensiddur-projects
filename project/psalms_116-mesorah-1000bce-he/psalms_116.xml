    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/116">
        <tei:head>תהלים קט״ז</tei:head>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>אָ֭הַבְתִּי כִּֽי־יִשְׁמַ֥ע ׀ יְהוָ֑ה</tei:l>
          <tei:l>אֶת־ק֝וֹלִ֗י תַּחֲנוּנָֽי׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>כִּֽי־הִטָּ֣ה אָזְנ֣וֹ לִ֑י</tei:l>
          <tei:l>וּבְיָמַ֥י אֶקְרָֽא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/116/3/a"/>
        <tei:lg>
          <tei:l>אֲפָפ֤וּנִי ׀ חֶבְלֵי־מָ֗וֶת</tei:l>
          <tei:l>וּמְצָרֵ֣י שְׁא֣וֹל מְצָא֑וּנִי</tei:l>
          <tei:l>צָרָ֖ה וְיָג֣וֹן אֶמְצָֽא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/116/4/a"/>
        <tei:lg>
          <tei:l>וּבְשֵֽׁם־יְהוָ֥ה אֶקְרָ֑א</tei:l>
          <tei:l>אָנָּ֥ה יְ֝הוָ֗ה מַלְּטָ֥ה נַפְשִֽׁי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>חַנּ֣וּן יְהֹוָ֣ה וְצַדִּ֑יק</tei:l>
          <tei:l>וֵ֖אלֹהֵ֣ינוּ מְרַחֵֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/116/6/a"/>
        <tei:lg>
          <tei:l>שֹׁמֵ֣ר פְּתָאיִ֣ם יְהֹוָ֑ה</tei:l>
          <tei:l>דַּ֝לּוֹתִ֗י וְלִ֣י יְהוֹשִֽׁיעַ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/116/7/a"/>
        <tei:lg>
          <tei:l>שׁוּבִ֣י נַ֭פְשִׁי לִמְנוּחָ֑יְכִי</tei:l>
          <tei:l>כִּֽי־יְ֝הוָ֗ה גָּמַ֥ל עָלָֽיְכִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/116/8"/>
        <tei:lg>
          <tei:l>כִּ֤י חִלַּ֥צְתָּ נַפְשִׁ֗י מִ֫מָּ֥וֶת</tei:l>
          <tei:l>אֶת־עֵינִ֥י מִן־דִּמְעָ֑ה</tei:l>
          <tei:l>אֶת־רַגְלִ֥י מִדֶּֽחִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>אֶ֭תְהַלֵּךְ לִפְנֵ֣י יְהוָ֑ה</tei:l>
          <tei:l>בְּ֝אַרְצ֗וֹת הַֽחַיִּֽים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/116/10/a"/>
        <tei:lg>
          <tei:l>הֶ֭אֱמַנְתִּי כִּ֣י אֲדַבֵּ֑ר</tei:l>
          <tei:l>אֲ֝נִ֗י עָנִ֥יתִי מְאֹֽד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>אֲ֭נִי אָמַ֣רְתִּי בְחָפְזִ֑י</tei:l>
          <tei:l>כָּֽל־הָאָדָ֥ם כֹּזֵֽב׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/116/12/a"/>
        <tei:lg>
          <tei:l>מָֽה־אָשִׁ֥יב לַיהוָ֑ה</tei:l>
          <tei:l>כָּֽל־תַּגְמוּל֥וֹהִי עָלָֽי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>כּוֹס־יְשׁוּע֥וֹת אֶשָּׂ֑א</tei:l>
          <tei:l>וּבְשֵׁ֖ם יְהוָ֣ה אֶקְרָֽא׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>נְ֭דָרַי לַיהוָ֣ה אֲשַׁלֵּ֑ם</tei:l>
          <tei:l>נֶגְדָה־נָּ֝֗א לְכָל־עַמּֽוֹ׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>יָ֭קָר בְּעֵינֵ֣י יְהוָ֑ה</tei:l>
          <tei:l>הַ֝מָּ֗וְתָה לַחֲסִידָֽיו׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/116/16"/>
        <tei:lg>
          <tei:l>אָֽנָּ֣ה יְהוָה֮ כִּֽי־אֲנִ֪י עַ֫בְדֶּ֥ךָ</tei:l>
          <tei:l>אֲֽנִי־עַ֭בְדְּךָ בֶּן־אֲמָתֶ֑ךָ</tei:l>
          <tei:l>פִּ֝תַּ֗חְתָּ לְמוֹסֵרָֽי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/116/17/a"/>
        <tei:lg>
          <tei:l>לְֽךָ־אֶ֭זְבַּח זֶ֣בַח תּוֹדָ֑ה</tei:l>
          <tei:l>וּבְשֵׁ֖ם יְהוָ֣ה אֶקְרָֽא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>נְ֭דָרַי לַיהוָ֣ה אֲשַׁלֵּ֑ם</tei:l>
          <tei:l>נֶגְדָה־נָּ֝֗א לְכָל־עַמּֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/116/19"/>
        <tei:lg>
          <tei:l>בְּחַצְר֤וֹת ׀ בֵּ֤ית יְהוָ֗ה</tei:l>
          <tei:l>בְּֽת֘וֹכֵ֤כִי יְֽרוּשָׁלִָ֗ם</tei:l>
          <tei:l>הַֽלְלוּ־יָֽהּ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
