    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_prayer_before_torah_study_schachter_shalomi">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_before_torah_study_schachter_shalomi/6"/>
        <tei:lg>
          <tei:l>כְּמַאֲמַר</tei:l>
          <tei:l>נְעִים זְמִירוֺת יִשְׂרָאֵל:</tei:l>
          <tei:l>“גַּל־עֵינַ֥י</tei:l>
          <tei:l>וְאַבִּ֑יטָה נִ֝פְלָא֗וֹת מִתּוֹרָתֶֽךָ.‏”‏ <tei:bibl>(תהלים קיט:יח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_before_torah_study_schachter_shalomi/7"/>
        <tei:lg>
          <tei:l>יִֽהְי֥וּ לְרָצ֨וֹן ׀ אִמְרֵי־פִ֡י</tei:l>
          <tei:l>וְהֶגְי֣וֹן לִבִּ֣י</tei:l>
          <tei:l>לְפָנֶ֑יךָ יְ֝הוָ֗ה</tei:l>
          <tei:l>צוּרִ֥י וְגֹאֲלִֽי׃ <tei:bibl>(תהלים יט:טו)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
