    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:kavvanah_for_the_separation_of_chalah_before_shabbat_mazor">
        <tei:head>כוונה להפרשת חלה לשבת</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:kavvanah_for_the_separation_of_chalah_before_shabbat_mazor/1"/>
        <tei:lg>
          <tei:l>עֵת בָּאָה שַׁבָּת אֶל בֵּיתֵנוּ,</tei:l>
          <tei:l>עֵת עוֹרְכִים אָנוּ אֶת הַשֻּׁלְחָן,</tei:l>
          <tei:l>נַעֲלֶה הַתְּפִלָּה מִלִּבֵּנוּ,</tei:l>
          <tei:l>כִּתְרוּמַת הַבָּצֵק הַמּוּכָן.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:kavvanah_for_the_separation_of_chalah_before_shabbat_mazor/2"/>
        <tei:lg>
          <tei:l>שֶׁנֵּדַע לְהַפְרִישׁ מִזְּמַנֵּנוּ,</tei:l>
          <tei:l>מִן הַיְּכֹלֶת וּמִן הַנְּכָסִים,</tei:l>
          <tei:l>שֶׁנֵּדַע לְפָרֵשׁ מִלּוֹתֵינוּ,</tei:l>
          <tei:l>גְּלוּיִים וְלֹא מְכֻסִּים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:kavvanah_for_the_separation_of_chalah_before_shabbat_mazor/3"/>
        <tei:lg>
          <tei:l>שֶׁמֶּחֱווֹת הַזּוּלַת יִתְפָּרְשׁוּ כָּאן</tei:l>
          <tei:l>לְכַף זְכוּת וּבְעַיִן טוֹבָה,</tei:l>
          <tei:l>וְיִפְרֹשׁ מֵעָלֵינוּ כָּל צַעַר,</tei:l>
          <tei:l>כָּל מַכְאוֹב וְכָל דְּאָבָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:kavvanah_for_the_separation_of_chalah_before_shabbat_mazor/4"/>
        <tei:lg>
          <tei:l>שֶׁנִּפְרֹשׁ מִיָּמִים שֶׁחָלְפוּ כְּבָר,</tei:l>
          <tei:l>נַשְׁאִירֵם מֵאָחוֹר בְּחִיּוּךְ,</tei:l>
          <tei:l>וְנִפְרֹשׂ בְּשִׂמְחָה עַל בֵּיתֵנוּ,</tei:l>
          <tei:l>יוֹם שַׁבָּת מְנַחֵם וּבָרוּךְ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:kavvanah_for_the_separation_of_chalah_before_shabbat_mazor/5"/>
        <tei:lg>
          <tei:l>אֵת סֻכַּת שְׁלוֹמֶךָ פְּרֹשׂ עָלֵינוּ,</tei:l>
          <tei:l>רַחֲמִים וְחַיִּים וְשָׁלוֹם,</tei:l>
          <tei:l>לְהַנִּיחַ בְּרָכָה אֶל בֵּיתֵנוּ,</tei:l>
          <tei:l>לְפָרֵשׁ מִלִּבֵּנוּ חֲלוֹם.</tei:l>
        </tei:lg>
      </tei:div>
