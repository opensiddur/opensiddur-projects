    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yotzer_piyyut_for_the_shabbat_before_shavuot_binyamin">
        <tei:head>יוצר לשבת לפני שבעות</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotzer_piyyut_for_the_shabbat_before_shavuot_binyamin/1"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְהֹוָה אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>יוֹצֵר אוֹר וּבֽוֹרֵא חֹֽשֶׁךְ</tei:l>
          <tei:l>עֹשֶׂה שָׁלוֹם וּבוֹרֵא אֶת־הַכֹּל׃</tei:l>
          <tei:l>אוֹר עוֹלָם בְּאוֹצַר חַיִּים</tei:l>
          <tei:l>אוֹרוֹת מֵאֹֽפֶל אָמַר וַיֶּֽהִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotzer_piyyut_for_the_shabbat_before_shavuot_binyamin/2"/>
        <tei:lg>
          <tei:l>אֲהַלֵּל בְּצִֽלְצְלֵי שָֽׁמַע לָאֵל אֱלֹהִים יְהֹוָה</tei:l>
          <tei:l>אוֹתִיּוֹת תּוֹרָתוֹ אֲבָאֵר לְעַם הֲמוֹנַי</tei:l>
          <tei:l>אֲשֶׁר הִפְלִיא וְהִגְדִּיל וּמָסַר לְמֹשֶׁה מִסִּינַי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotzer_piyyut_for_the_shabbat_before_shavuot_binyamin/3"/>
        <tei:lg>
          <tei:l>אָלֶ״ף</tei:l>
          <tei:l><tei:seg type="acrostic">א</tei:seg>וֹת רִאשׁוֹנָה אַחַת הִיא וְנִקְרֵאת בְּשָׁלֹשׁ</tei:l>
          <tei:l>רֶֽמֶז לְיִחוּד הַשֵּׁם הַנִּקְדָּשׁ בִּקְדֻשּׁוֹת שָׁלֹשׁ</tei:l>
          <tei:l>זֶה פְּרוּשׁוֹ אֶחָד וְאוֹתִיּוֹת שָׁלֹשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotzer_piyyut_for_the_shabbat_before_shavuot_binyamin/4"/>
        <tei:lg>
          <tei:l>בֵּי״ת</tei:l>
          <tei:l><tei:seg type="acrostic">בֵּ</tei:seg>ין שְׁתַּֽיִם מְנוּיָה וּטְעָמֶֽיהָ מוֹדִיעִים</tei:l>
          <tei:l>כִּי עָתִיד עוֹלָם לֵחָרֵב פַּעֲמַֽיִם בְּשִׁקּוּעִים</tei:l>
          <tei:l>אַחַת בְּדוֹר הַמַּבּוּל וְאַחַת בְּשֵֽׁשֶׁת אֲלָפִים וְשָׁלֹשׁ וְתִשְׁעִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotzer_piyyut_for_the_shabbat_before_shavuot_binyamin/5"/>
        <tei:lg>
          <tei:l>גִּֽימֶ״ל</tei:l>
          <tei:l><tei:seg type="acrostic">גְּ</tei:seg>מוּל חַסְדּוֹ אֲשֶׁר גָּמַל בְּעוֹלָמוֹ</tei:l>
          <tei:l>מֵכִין נְשָׁמוֹת וּמִחְיָה וְעֵצָה מְעִמּוֹ</tei:l>
          <tei:l>וּשְׁאָר צׇרְכֵּי יְצוּרָיו הַחוֹסִים בִּשְׁמוֹ׃</tei:l>
          <tei:l>קָדוֹשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotzer_piyyut_for_the_shabbat_before_shavuot_binyamin/6"/>
        <tei:lg>
          <tei:l>דַּֽלֶ״ת</tei:l>
          <tei:l><tei:seg type="acrostic">דְּ</tei:seg>מוּת פָּנֶֽיהָ לָמָּה כְּלַפֵּי הֵ״א מוּבָא</tei:l>
          <tei:l>כִּי כל־מַצְלִֽיחַ בָּזֶּה יִדַּל לָעוֹלָם הַבָּא</tei:l>
          <tei:l>כְּגוֹן עֵשָׂו וַחֲבֵרָיו עוֹשֵׂי רָעָה רַבָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotzer_piyyut_for_the_shabbat_before_shavuot_binyamin/7"/>
        <tei:lg>
          <tei:l>הֵ״א</tei:l>
          <tei:l><tei:seg type="acrostic">הֶ</tei:seg>גְיוֹנָהּ מְשֻׁנֶּה מִכׇּל־אוֹתִיּוֹת</tei:l>
          <tei:l>בְּכֻלָּם הֶרְגֵּשׁ שָׂפָה וּבְהֵ״א אֵינוֹ מָצוּי לִהְיוֹת</tei:l>
          <tei:l>לְלַמֶּדְךָ כִּי בְּהֵ״א נִבְרְאוּ תּוֹלְדוֹת חוּג וַעֲלִיּוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotzer_piyyut_for_the_shabbat_before_shavuot_binyamin/8"/>
        <tei:lg>
          <tei:l>וָי״ו</tei:l>
          <tei:l><tei:seg type="acrostic">וָ</tei:seg>וֵי עַמּוּדֵי אֵשׁ צָגִים פְּנֵי אֵל אֵלִים</tei:l>
          <tei:l>הֵם שֵׁמוֹת הַמְּפֹרָשִׁים וּמִכׇּל־שֵׁמוֹת מְעֻלִּים</tei:l>
          <tei:l>בְּסוֹד רָזֵיהֶם מִשְׁתַּמְּשִׁים אֶרְאֵלִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotzer_piyyut_for_the_shabbat_before_shavuot_binyamin/9"/>
        <tei:lg>
          <tei:l>זַֽיִ״ן</tei:l>
          <tei:l><tei:seg type="acrostic">זֶ</tei:seg>ה כֹּֽחַ שֵׁשׁ עֶשְׂרֵה מַפְתְּחוֹת</tei:l>
          <tei:l>כְּגוֹן רֶֽחֶם וּמָטָר וְקִבְרֵי מֵתֵי רוּחוֹת</tei:l>
          <tei:l>וְאַחֲרוֹנָה שֶׁבְּכֻלָּם מַפְתֵּֽחַ עֲלוּקוֹת שׁוּחוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotzer_piyyut_for_the_shabbat_before_shavuot_binyamin/10"/>
        <tei:lg>
          <tei:l>חֵי״ת</tei:l>
          <tei:l><tei:seg type="acrostic">חֵ</tei:seg>טְא פֵּרוּשׁוֹ אֲשֶׁר חוֹטְאִים רִשְׁעֵי יִשְׂרָאֵל</tei:l>
          <tei:l>עֲתִידִים לַעֲשׂוֹת תְּשׁוּבָה וּלְהָעִיד אֵין כָּאֵל</tei:l>
          <tei:l>וּמִיָּד יֵחָשְׁבוּ כִּשְׁאָר צַדִּיקֵי יִשְׂרָאֵל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotzer_piyyut_for_the_shabbat_before_shavuot_binyamin/11"/>
        <tei:lg>
          <tei:l>טֵי״ת</tei:l>
          <tei:l><tei:seg type="acrostic">טִ</tei:seg>יט הָעוֹלָם הַבָּא שֶׁחֲסִידִים מֶֽנּוּ נִצְמָחִים</tei:l>
          <tei:l>כִּתּוֹת וַחֲבוּרוֹת יְקָרִים וּמְשֻׁבָּחִים</tei:l>
          <tei:l>וְרֵֽיחַ לְבוּשֵׁיהֶם כְּרֵֽיחַ נִיחוֹחִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotzer_piyyut_for_the_shabbat_before_shavuot_binyamin/12"/>
        <tei:lg>
          <tei:l>יוֹ״ד</tei:l>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>ד וָשֵׁם וַעֲטֶֽרֶת תִּפְאֶֽרֶת</tei:l>
          <tei:l>יַעֲנִיד לִסְגֻלָּתוֹ בְּרַאֲיָה וּמָסֹֽרֶת</tei:l>
          <tei:l>שֵׁ֤ם עוֹלָם֙ אֶתֶּן־ל֔וֹ אֲשֶׁ֖ר לֹ֥א יִכָּרֵֽת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotzer_piyyut_for_the_shabbat_before_shavuot_binyamin/13"/>
        <tei:lg>
          <tei:l>כַּ״ף</tei:l>
          <tei:l><tei:seg type="acrostic">כַּ</tei:seg>פָּיו אֵל יִסְפֹּק בְּשַׂמֵּֽחַ אֹם מֵאֻמּוֹת</tei:l>
          <tei:l>בְּנַחֲלַת שְׁלֹשׁ מֵאוֹת וַעֲשָׂרָה עוֹלָמוֹת</tei:l>
          <tei:l>וְתַעֲנוּג זִיז שָׂדַי לִוְיָתָן וּבְהֵמוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotzer_piyyut_for_the_shabbat_before_shavuot_binyamin/14"/>
        <tei:lg>
          <tei:l>לָֽמֶ״ד</tei:l>
          <tei:l><tei:seg type="acrostic">לֵ</tei:seg>ב אָדָם שָׁקוּל כְּכׇל־הָאֵבָרִים</tei:l>
          <tei:l>בְּעַֽיִן וְאֹֽזֶן וְדִבּוּר וּבְרֹב שְׁאָר דְּבָרִים</tei:l>
          <tei:l>וּבוֹ סְמוּכָה וּתְלוּיָה יִרְאַת מַשְׁפִּיל וּמֵרִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotzer_piyyut_for_the_shabbat_before_shavuot_binyamin/15"/>
        <tei:lg>
          <tei:l>מֵ״ם</tei:l>
          <tei:l><tei:seg type="acrostic">מַ</tei:seg>ה טַֽעַם מָשָׁל לִשְׁנַֽיִם דָּרִים בְּאֶחָד מָדוֹר</tei:l>
          <tei:l>כִּי בְּכִסֵּא הַכָּבוֹד מְקַלְּסִים וְשׂוֹחֲחִים לִסְדֹּר</tei:l>
          <tei:l>מַֽלְכוּתְךָ֗ מַלְכ֥וּת כׇּל־עֹלָמִ֑ים וּ֝מֶֽמְשַׁלְתְּךָ֗ בְּכׇל־דּ֥וֹר וָדֹֽר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotzer_piyyut_for_the_shabbat_before_shavuot_binyamin/16"/>
        <tei:lg>
          <tei:l>נוּ״ן</tei:l>
          <tei:l><tei:seg type="acrostic">נֵ</tei:seg>ר יְהֹוָה נִשְׁמַת אָדָם וְלֹא־נִשְׁמַת בְּהֵמָה</tei:l>
          <tei:l>אַף כִּי לְפִי מִיתָתָם זוֹ לְזוֹ דּוֹמָה</tei:l>
          <tei:l>לִתְחִיַּת הַמֵּתִים לְרֽוּחַ אָדָם תְּקוּמָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotzer_piyyut_for_the_shabbat_before_shavuot_binyamin/17"/>
        <tei:lg>
          <tei:l>סַמֶ״ךְ</tei:l>
          <tei:l><tei:seg type="acrostic">ס</tei:seg>וֹד מִשְׁכָּן שֶׁסּוֹמְכִים לוֹ אֲמָנָה</tei:l>
          <tei:l>מַחֲנֵה יְהוּדָה מִזְרָֽחָה וּמַחֲנֵה רְאוּבֵן תֵּימָֽנָה</tei:l>
          <tei:l>וּמַחֲנֵה אֶפְרַֽיִם יָֽמָּה וּמַחֲנֵה דָּן צָפֽוֹנָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotzer_piyyut_for_the_shabbat_before_shavuot_binyamin/18"/>
        <tei:lg>
          <tei:l>עַיִ״ן</tei:l>
          <tei:l><tei:seg type="acrostic">עֵ</tei:seg>ץ חַיִּים הִיא לְעוֹשֶֽׂיהָ כַּאֲפַרְכֶּֽסֶת אׇזְנַֽיִם</tei:l>
          <tei:l>מְעִידָה עַל־עַֽיִן וּמַכְרַֽעַת צֶֽדֶק בְּמֹאזְנַֽיִם</tei:l>
          <tei:l>מִצְוַ֥ת יְהֹוָ֥ה בָּ֝רָ֗ה מְאִירַ֥ת עֵינָֽיִם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotzer_piyyut_for_the_shabbat_before_shavuot_binyamin/19"/>
        <tei:lg>
          <tei:l>פֵּ״א</tei:l>
          <tei:l><tei:seg type="acrostic">פֶּ</tei:seg>ה שֶׁל כְבַד־פֶּ֛ה וּכְבַ֥ד לָשׁ֖וֹן</tei:l>
          <tei:l>פָּץ תְּנָה־לִּי שִׂיחָה כִּי לְכָךְ נוֹצַר הַלָּשׁוֹן</tei:l>
          <tei:l>הֱשִׁיבוֹ מִ֣י שָׂ֣ם פֶּה֮ לָֽאָדָם֒ הָרִאשׁוֹן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotzer_piyyut_for_the_shabbat_before_shavuot_binyamin/20"/>
        <tei:lg>
          <tei:l>צָֽדִ״י</tei:l>
          <tei:l><tei:seg type="acrostic">צִ</tei:seg>דְקַת אֱלֹהֵֽינוּ עִם־בָּשָׂר וָדָם</tei:l>
          <tei:l>מְלַמְּדָם דֶּֽרֶךְ צֶֽדֶק וְרַב־טוּב לְהַעֲתִידָם</tei:l>
          <tei:l>גְּבוּרוֹת מִפְעֲלוֹתָיו לְהוֹדִֽיעַ לִבְנֵי אָדָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotzer_piyyut_for_the_shabbat_before_shavuot_binyamin/21"/>
        <tei:lg>
          <tei:l>קוֹ״ף</tei:l>
          <tei:l><tei:seg type="acrostic">קֶֽ</tei:seg>רֶן עוֹר פְּנֵי פוֹדֶה הִקִּיף כׇּל־דְּבַר חׇכְמָה</tei:l>
          <tei:l>דִּבּוּרוֹ כְּצֵאת שַׁלְהֶֽבֶת וּפָנָיו כְּזִיו הַחַמָּה</tei:l>
          <tei:l>לְהָקֵל עֹל הַכָּבֵד מֵעַל־יוֹנָה תַּמָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotzer_piyyut_for_the_shabbat_before_shavuot_binyamin/22"/>
        <tei:lg>
          <tei:l>רֵי״שׁ</tei:l>
          <tei:l><tei:seg type="acrostic">רֵ</tei:seg>אשִׁית תְּבוּאַת בְּנֵי שְׁלֹֽשֶׁת אָבוֹת</tei:l>
          <tei:l>נְתוּנִים לְכׇל־אֻמָּה לְרֹאשׁ וְלֹא־לִזְנָבוֹת</tei:l>
          <tei:l>הַיֹּשְׁבִ֥ים רִאשֹׁנָ֖ה בַּמַּלְכֽוּת רֹכֵב עֲרָבוֹת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotzer_piyyut_for_the_shabbat_before_shavuot_binyamin/23"/>
        <tei:lg>
          <tei:l>שִׁי״ן</tei:l>
          <tei:l><tei:seg type="acrostic">שְׁ</tei:seg>לֹשָׁה עֲנָפִים יֶשׁ לָהּ כְּמוֹ כִּסֵּא מַשְׁבֵּר</tei:l>
          <tei:l>כִּי שָׁלֹשׁ פְּעָמִים שִׁנֵּי רְשָׁעִים יְשַׁבֵּר</tei:l>
          <tei:l>וּלְעַמּוֹ יִתְר֥וֹן הַכְשֵׁ֖יר וַחֲיָלִ֖ים יְגַבֵּ֑ר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotzer_piyyut_for_the_shabbat_before_shavuot_binyamin/24"/>
        <tei:lg>
          <tei:l>תָּי״ו</tei:l>
          <tei:l><tei:seg type="acrostic">תַּ</tei:seg>אֲוַת אָדָם מִתְאַוֶּה לִדְבָרִים רַבִּים</tei:l>
          <tei:l>לְעֹשֶׁר וּגְדֻלָּה וְכָבוֹד וּבוֹרוֹת חֲצוּבִים</tei:l>
          <tei:l>וּבְמוֹתוֹ לֹא־יְלַוּֽוּהוּ כִּי־אִם תּוֹרָה וּמַעֲשִׂים טוֹבִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotzer_piyyut_for_the_shabbat_before_shavuot_binyamin/25"/>
        <tei:lg>
          <tei:l>בְּׄכֵן אֲשֶׁר בְּחָרָן וְצָר בָּהֶן כׇּל־מְלַאכְתּוֹ</tei:l>
          <tei:l>נָׄטַע חוּג לַהֲדוֹמוֹ וְשַׁחַק לִמְכוֹן שִׁבְתּוֹ</tei:l>
          <tei:l>יִׄפָּה צַר וָאוֹר וּמַזָּלוֹת מֶמְשַׁלְתּוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotzer_piyyut_for_the_shabbat_before_shavuot_binyamin/26"/>
        <tei:lg>
          <tei:l>מֵׄימוֹת שׇׁעֳלוֹ לְצַד הָעוֹלָם הֵשִׂים</tei:l>
          <tei:l>יִׄשֵּׁב וּמִלֵּא כׇּל־קְצוֹת אֶֽרֶץ וַאֲפָסִים</tei:l>
          <tei:l>נָׄפַשׁ לְסוֹף פֹּֽעַל וְשָׁבַת מִכׇּל־הַמַּעֲשִׂים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotzer_piyyut_for_the_shabbat_before_shavuot_binyamin/27"/>
        <tei:lg>
          <tei:l>גִּֽימֶ״ל</tei:l>
          <tei:l>גְּמוּל חַסְדּוֹ אֲשֶׁר גָּמַל בְּעוֹלָמוֹ</tei:l>
          <tei:l>מֵכִין נְשָׁמוֹת וּמִחְיָה וְעֵצָה מְעִמּוֹ</tei:l>
          <tei:l>וּשְׁאָר צׇרְכֵּי יְצוּרָיו הַחוֹסִים בִּשְׁמוֹ׃</tei:l>
          <tei:l>קָדוֹשׁ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
