  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:before_sleeping_levy">
        <tei:head>[Prayer] Before Sleeping (for Very Young Children) by Rabbi Clifton Harby Levy (1927)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:before_sleeping_levy/1"/>
        <tei:lg>
          <tei:l>Dear God,</tei:l>
          <tei:l>I thank You for the good things</tei:l>
          <tei:l>that have been mine all day.</tei:l>
          <tei:l>For the love of dear Papa and Mama;</tei:l>
          <tei:l>for all the nice food they give me,</tei:l>
          <tei:l>for the good time I have had at play.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:before_sleeping_levy/2"/>
        <tei:lg>
          <tei:l>May sweet sleep come to me,</tei:l>
          <tei:l>and may I wake to the new day</tei:l>
          <tei:l>well and ready for all it brings.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:before_sleeping_levy/3"/>
        <tei:lg>
          <tei:l>Bless all I love</tei:l>
          <tei:l>and make them happy.</tei:l>
          <tei:l><tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
