  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:acheinu">
        <tei:head>Aḥeinu (Our siblings)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:acheinu/1"/>
        <tei:lg>
          <tei:l>Our siblings,</tei:l>
          <tei:l>the whole house of Yisrael,</tei:l>
          <tei:l>who are in distress and captivity</tei:l>
          <tei:l>who wander over sea and over land,</tei:l>
          <tei:l>may <j:divineName>the Maqom</j:divineName><tei:anchor xml:id="note_1"/> have mercy on them,</tei:l>
          <tei:l>and bring them from distress to comfort,</tei:l>
          <tei:l>from darkness to light,</tei:l>
          <tei:l>from subjugation to redemption,</tei:l>
          <tei:l>now, swiftly, and soon.</tei:l>
          <tei:l><tei:note type="instruction">and may we say:</tei:note> <tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" n="1" target="#note_1">
      <tei:p>lit. the Place, an epithet for the Divine in rabbinic Judaism.</tei:p>
    </tei:note>
  </tei:standOff>
