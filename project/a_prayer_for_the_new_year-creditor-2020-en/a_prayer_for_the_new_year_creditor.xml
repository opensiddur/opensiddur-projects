  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_prayer_for_the_new_year_creditor">
        <tei:head>A Prayer for the New Year (5781), by Rabbi Menachem Creditor</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_the_new_year_creditor/1"/>
        <tei:lg>
          <tei:l>Dear God,</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>May we learn/remember how</tei:l>
          <tei:l>to open up our hearts and minds and souls.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_the_new_year_creditor/2"/>
        <tei:lg>
          <tei:l>May we reclaim the headlines</tei:l>
          <tei:l>with the shocking good we’ll do.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_the_new_year_creditor/3"/>
        <tei:lg>
          <tei:l>May our children inherit some good decisions</tei:l>
          <tei:l>we’ll make to offset our countless mistakes.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_the_new_year_creditor/4"/>
        <tei:lg>
          <tei:l>May we take really good care</tei:l>
          <tei:l>of each other and heal this fragile world.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_the_new_year_creditor/5"/>
        <tei:lg>
          <tei:l>Amen.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
