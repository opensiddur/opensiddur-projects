  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_prayer_for_today_held">
        <tei:head>A Prayer for Today (US Election Day 2020), by Rabbi Shai Held</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_today_held/1"/>
        <tei:lg>
          <tei:l>May it be Your will,</tei:l>
          <tei:l>YHVH our god and god of our ancestors,</tei:l>
          <tei:l>that good triumph over evil,</tei:l>
          <tei:l>light triumph over darkness,</tei:l>
          <tei:l>and that love and kindness triumph over hatred and cruelty.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_today_held/2"/>
        <tei:lg>
          <tei:l>God of the universe,</tei:l>
          <tei:l>be with us and aid us in our struggle</tei:l>
          <tei:l>to remove the government of malice from the world.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_today_held/3"/>
        <tei:lg>
          <tei:l>Grant residents of our land a heart of flesh,</tei:l>
          <tei:l>and teach us all, as one,</tei:l>
          <tei:l>to love loving kindness and pursue justice;</tei:l>
          <tei:l>give us the courage</tei:l>
          <tei:l>to love the migrant, the orphan and the widow,</tei:l>
          <tei:l>and to protect the poor and downtrodden.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_today_held/4"/>
        <tei:lg>
          <tei:l>Please,</tei:l>
          <tei:l>give us the power and desire</tei:l>
          <tei:l>to start again from the beginning.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_today_held/5"/>
        <tei:lg>
          <tei:l>May the words of our mouths,</tei:l>
          <tei:l>the meditations of our hearts</tei:l>
          <tei:l>and the work of our hands<tei:anchor xml:id="note_1"/></tei:l>
          <tei:l>find favor in your sight YHVH,</tei:l>
          <tei:l>our Rock and our Redeemer.<tei:anchor xml:id="note_2"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_today_held/6"/>
        <tei:lg>
          <tei:l><tei:hi rend="italic">Amen amen</tei:hi>.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
