    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:hoshanot_for_purim_mohr">
        <tei:head>הוֹשַֽׁעְנוֹת לַפּוּרִים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hoshanot_for_purim_mohr/1"/>
        <tei:lg>
          <tei:l>הוֹשַֽׁעְנָא לְמַעַנְךָ יֵינֵֽנוּ הוֹשַֽׁעְנָאּ׃</tei:l>
          <tei:l>הוֹשַֽׁעְנָא לְמַעַנְךָ תִּירוֹשֵֽׁנוּ הוֹשַֽׁעְנָאּ׃</tei:l>
          <tei:l>הוֹשַֽׁעְנָא לְמַעַנְךָ גַּפְנֵֽנוּ הוֹשַֽׁעְנָאּ׃</tei:l>
          <tei:l>הוֹשַֽׁעְנָא לְמַעַנְךָ דִּבְשֵֽׁנוּ הוֹשַֽׁעְנָאּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hoshanot_for_purim_mohr/2"/>
        <tei:lg>
          <tei:l>הוֹשַֽׁעְנָא לְמַֽעַן אֲמִתֶּֽךָ... לְמַֽעַן בּוֹצְרֶֽךָ... לְמַֽעַן גְּבִיעֶֽךָ... לְמַֽעַן דָּגֶֽיךָ... לְמַֽעַן הִינֶֽךָ... לְמַֽעַן וִעוּדֶֽיךָ... וּמַעַן זָגֶֽיךָ... לְמַֽעַן חַרְצַנֶּֽיךָ... לְמַֽעַן טַעֲמֶֽךָ... לְמַֽעַן יְקָבֶֽיךָ... לְמַֽעַן כַּרְמֶֽךָ... לְמַֽעַן לְבִיבוֹתֶֽיךָ... לְמַֽעַן מַעֲדַנֶּֽיךָ... לְמַֽעַן נְגִינוֹתֶֽיךָ... לְמַֽעַן סְמָדַרֶֽךָ... לְמַֽעַן עֲנָבֶֽיךָ... לְמַֽעַן פַּרְשַׁנְדָּתֶֽךָ... לְמַֽעַן צִמּוּקֶֽיךָ... לְמַֽעַן קַעֲרוֹתֶֽיךָ... וּמַעַן רֵעֶֽיךָ הָרַבִּים... לְמַֽעַן שׁוֹתֶֽיךָ... לְמַֽעַן תִּירוֹשֶֽׁךָ הוֹשַֽׁעְנָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hoshanot_for_purim_mohr/3"/>
        <tei:lg>
          <tei:l>הוֹשַֽׁעְנָא אֶֽבֶן שְׁתִיָּה... בֵּית הַמִּשְׁתֶּה... גַּת דְּרוּכָה... דָּגִים מְלוּחִים... הִין צֶֽדֶק... וּצְחוֹק יֵרָאֶה... זוֹלֵל וְסוֹבֵא... חָבִית דְּבַשׁ... טְבֽוֹחַ טֶֽבַח... יַֽיִן שָׂרָף... כּוֹס מָלֵא... לוּז וֶאֱגוֹז... מַאֲפֶה תַּנּוּר... נְזִיד עֲדָשִׁים... סִיר הַבָּשָׂר... עַרְמוֹן זָרִים... פּוֹצֵי פֶּה... צְלִי אֵשׁ... קֵבָה וּבֶֽטֶן... רֹאשׁ מָחוּץ... שִׁכּוֹרֵי אֶפְרַֽיִם... תִּירוֹשׁ וְיִצְהָר הוֹשַׁעְנָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hoshanot_for_purim_mohr/4"/>
        <tei:lg>
          <tei:l>רַחֵם־נָא קְהַל עֲדַת שִׁכּוֹרִים</tei:l>
          <tei:l>שְׁלַח וּמַלֵּא אֶת־גְּרוֹנָם</tei:l>
          <tei:l>וְהַשְׁקֵֽנוּ יַֽיִן מִשְׁתֵּֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hoshanot_for_purim_mohr/5"/>
        <tei:lg>
          <tei:l>שַׁעֲרֵי הַמַּרְתֵּף פְּתַח</tei:l>
          <tei:l>וְיֵינְךָ הַטּוֹב לָֽנוּ תִּפְתַּח</tei:l>
          <tei:l>תַּשְׁפִּיעֵֽנוּ וּמַֽיִם אַל־תִּשְׁפַּךְ</tei:l>
          <tei:l>וְהַשְׁקֵֽנוּ מֶֽסֶךְ יַי״שֵֽׁנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hoshanot_for_purim_mohr/6"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">קוֹל מְשַׁכֵּר מְשַׁכֵּר וְאוֹמֵר!</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hoshanot_for_purim_mohr/7"/>
        <tei:lg>
          <tei:l>מְנוּיָה וּגְמוּרָה מִסּוֹד חַכְמֵי מִשְׁתֶּה</tei:l>
          <tei:l>טוֹב לָאָדָם שֶׁיִּשְׁתֶּה מִשֶּׁלֹּא יִשְׁתֶּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hoshanot_for_purim_mohr/8"/>
        <tei:lg>
          <tei:l>שִׂישׂוּ וְשִׂמְחוּ בְּשִׂמְחַת פּוּרִים</tei:l>
          <tei:l>וּתְנוּ כָּבוֹד לַעֲדַת שִׁכּוֹרִים</tei:l>
          <tei:l>כִּי טוֹב הַיַּֽיִן לַעֲנִיִּים וַעֲשִׁירִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hoshanot_for_purim_mohr/9"/>
        <tei:lg>
          <tei:l>מִפָּז וּמִפְּנִימִים יְקָרָה</tei:l>
          <tei:l>נָגִיל וְנָשִׂישׂ בְּיֶֽקֶב וּפוּרָה</tei:l>
          <tei:l>כִּי־הֵם לָֽנוּ עֹז וְאוֹרָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hoshanot_for_purim_mohr/10"/>
        <tei:lg>
          <tei:l>אֲהַלֵּל יֵינִי וְאֶשְׂמַח בּוֹ</tei:l>
          <tei:l>וְאָשִֽׂימָה שְׁתִיָּתִי בּוֹ</tei:l>
          <tei:l>אַגְמִיאֶֽנּוּ בְּסוֹד עַם קְרוֹבוֹ</tei:l>
          <tei:l>יֵינִי תִּירוֹשִׁי אֶרְוֶה בּוֹ׃</tei:l>
          <tei:l>נָגִיל...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hoshanot_for_purim_mohr/11"/>
        <tei:lg>
          <tei:l>בְּכׇל־פֶּה אָרִיק גְּבִיעֶֽךָ</tei:l>
          <tei:l>וּבְצַוַּאר עָתָק אֶשְׁתֶּה כַּדֶּֽיךָ</tei:l>
          <tei:l>בְּשָׂשׂוֹן תְּנַהֲלֵֽנוּ לְבֵיתֶֽךָ</tei:l>
          <tei:l>עַל־חָזְקֶֽךָ וְעַל־טַעֲמֶֽךָ׃</tei:l>
          <tei:l>נָגִיל...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hoshanot_for_purim_mohr/12"/>
        <tei:lg>
          <tei:l>גֶּֽפֶן תָּחִישׁ מַשְׁקֶה טוֹב</tei:l>
          <tei:l>כִּי אַתָּה שִׁכָּרוֹן עַז וְטוֹב</tei:l>
          <tei:l>גִּבּוֹרִים יִשְׁתּֽוּךָ בְּפֶה טוֹב</tei:l>
          <tei:l>הוֹדוּ לְיַֽיִן כִּי־טוֹב׃</tei:l>
          <tei:l>נָגִיל...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hoshanot_for_purim_mohr/13"/>
        <tei:lg>
          <tei:l>דְּבַשׁ הַשְׁקֵה־נָא הֲמוֹנַי</tei:l>
          <tei:l>כִּי אֵין־כָּמֽוֹךָ בְּעֵינַי</tei:l>
          <tei:l>דָּגִים יְסוֹבְבֽוּךְ לְפָנַֽי</tei:l>
          <tei:l>מִי יְמַלֵּל גְּבֻרוֹת מַעֲדַנַּי׃</tei:l>
          <tei:l>נָגִיל...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hoshanot_for_purim_mohr/14"/>
        <tei:lg>
          <tei:l>הֲלוֹא בְּאַהֲבָתוֹ בָּֽחַר־בָּֽנוּ</tei:l>
          <tei:l>דַּם עֲנָבָיו הִשְׁקָֽנוּ</tei:l>
          <tei:l>הָאָדֹם הָאָדֹם הִשְׁכִּירָֽנוּ</tei:l>
          <tei:l>כִּי לְעוֹלָם חַסְדּוֹ עִמָּֽנוּ׃</tei:l>
          <tei:l>נָגִיל...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
