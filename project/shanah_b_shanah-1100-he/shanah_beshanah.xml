      <tei:div corresp="urn:x-opensiddur:text:poem:shanah_beshanah">
        <tei:head>שָׁנָה בְּשָׁנָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shanah_beshanah/1"/>
        <tei:lg>
          <tei:l>שָׁנָה בְּשָׁנָה</tei:l>
          <tei:l>אֶהְגֶּה כְּיוֹנָה</tei:l>
          <tei:l>כִּי עִיר עֲדִינָה</tei:l>
          <tei:l>הָיְתָה לְזוֹנָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shanah_beshanah/2"/>
        <tei:lg>
          <tei:l>יָרְדוּ פְלָאִים מַלְכָּהּ וְעַמָּהּ</tei:l>
          <tei:l>נָשְׂאוּ מְשַׂנְּאִים חֶלְיָהּ וְנִזְמָהּ</tei:l>
          <tei:l>לִמְעוֹן פְּרָאִים הׇהְפַּךְ מְקוֹמָהּ</tei:l>
          <tei:l>תַּנִּים וְיַעֲנָה בִּמְקוֹם שְׁכִינָה</tei:l>
          <tei:l>וּנְהִי וְקִינָה תַּחַת רְנָנָה׃</tei:l>
          <tei:l>שָׁנָה בְּשָׁנָה...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shanah_beshanah/3"/>
        <tei:lg>
          <tei:l>בַּמֶּה יְנֻחַם יוֹדְעָהּ וְרוֹאָהּ</tei:l>
          <tei:l>קֵדָר וּבֶן־חַם יוֹשְׁבִים בְּכִסְּאָהּ</tei:l>
          <tei:l>אֵיכָה תְּנֻחַם וְעוֹדָהּ בְּחֶטְאָהּ</tei:l>
          <tei:l>וּלְכׇל־מְדִינָה הָיְתָה שְׁנִינָה</tei:l>
          <tei:l>חֶרְפָּה וּבֹשְׁנָה לָקְחָה לְמָנָה׃</tei:l>
          <tei:l>שָׁנָה בְּשָׁנָה...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shanah_beshanah/4"/>
        <tei:lg>
          <tei:l>פְּנֵה לְהֶגְיוֹן נִבְזֶה וְעַרְעַר</tei:l>
          <tei:l>עַם דַּל וְאֶבְיוֹן שׁוֹכְבִים בְּצַֽעַר</tei:l>
          <tei:l>קַבֵּץ לְצִיּוֹן נִדָּח בְּשִׁנְעָר</tei:l>
          <tei:l>בּֽוֹאוּ בְּרִנָּה גִּבְעַת לְבוֹנָה</tei:l>
          <tei:l>מֵרֹאשׁ אֲמָנָה אֵל בָּרְכוּ־נָא׃</tei:l>
        </tei:lg>
      </tei:div>
