  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd/1"/>
        <tei:lg>
          <tei:l>כִּ֝סְא֗וֹת לְבֵ֣ית דָּוִֽד שַׁ֭אֲלוּ שְׁל֣וֹם יְרוּשָׁלָ֑͏ִם׃׃ <tei:bibl>(תהלים קכב:ה-ו)</tei:bibl></tei:l>
          <tei:l>יְרוּשָׁלַ֥͏ִם הַבְּנוּיָ֑ה כְּ֝עִ֗יר שֶׁחֻבְּרָה־לָּ֥הּ יַחְדָּֽו׃ <tei:bibl>(תהלים קכב:ג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd/2"/>
        <tei:lg>
          <tei:l>הַהַגָּדָה הַגָּדַת</tei:l>
          <tei:l>יְרוּשָׁלַיִם</tei:l>
          <tei:l>הַהַגָּדָה הַהַגָּדָה שְׁמָעוּ!</tei:l>
          <tei:l>הַהַגָּדָה הַגָּדַת</tei:l>
          <tei:l>בֵּית הַמִּקְדָּשׁ</tei:l>
          <tei:l>הַהַגָּדָה הַהַגָּדָה שְׁמָעוּ!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd/3"/>
        <tei:lg>
          <tei:l>לְמַֽעַן</tei:l>
          <tei:l>בֵּ֣ית דָּוִֽד שַׁ֭אֲלוּ שְׁל֣וֹם יְרוּשָׁלָ֑͏ִם׃ <tei:bibl>(תהלים קכב:ה-ו)</tei:bibl></tei:l>
          <tei:l>לְ֭מַעַן בֵּית־יְהֹוָ֣ה אֱלֹהֵ֑ינוּ אֲבַקְשָׁ֖ה ט֣וֹב לָֽךְ׃ <tei:bibl>(תהלים קכא:ז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd/4"/>
        <tei:lg>
          <tei:l>אֲבַקְשָׁה כֵּן אֲבַקְשָׁה׃</tei:l>
          <tei:l>אֲבַקְשָׁה כֵּן אֲבַקְשָׁה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd/5"/>
        <tei:lg>
          <tei:l>אֵֽלֶּה שֶׁיְּשָׁרְתוּ בְּתוֹךְ בֵּיתִי יִירְשׁוּ אֶת־אוֹצְרוֹתַי׃</tei:l>
          <tei:l>אֵֽלֶּה שֶׁיְּשַׁמְּרוּ בְּתוֹךְ בֵּיתִי יִירְשׁוּ אֶת־אוֹצְרוֹתַי׃</tei:l>
          <tei:l>הָבִיאוּ עָנִי וְאֶבְיוֹן וְהוֹשִׁיבוּם תּוֹךְ־בָּתֵּיכֶם׃</tei:l>
          <tei:l>הָבִיאוּ עָנִי וָגֵר וְהוֹשִׁיבוּם תּוֹךְ־בָּתֵּיכֶם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd/6"/>
        <tei:lg>
          <tei:l>(Agaw translation needed)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd/7"/>
        <tei:lg>
          <tei:l>גַּם־צִפּ֨וֹר מָ֪צְאָה בַ֡יִת׃ <tei:bibl>(תהלים פג:ד חלק א׳)</tei:bibl></tei:l>
          <tei:l>יַקְדִּישׁוּ אֶת־שְׁמִי בֵּית יַעֲקֹב</tei:l>
          <tei:l>יַקְדִּישׁוּ אֶת־שְׁמִי בֵּית יִשְׂרָאֵל׃</tei:l>
          <tei:l>רָאשֵׁי֙ בֵּ֣ית יַעֲקֹ֔ב</tei:l>
          <tei:l>וּקְצִינֵ֖י בֵּ֣ית יִשְׂרָאֵ֑ל׃ <tei:bibl>(מיכה ג:ט)</tei:bibl></tei:l>
          <tei:l>וְעַתָּה בֵּית יַעֲקֹב</tei:l>
          <tei:l>שִׁמְעוּ־נָא לִי בֵּית יִשְׂרָאֵל׃</tei:l>
          <tei:l>שְׂא֤וּ שְׁעָרִ֨ים ׀ רָֽאשֵׁיכֶ֗ם וְֽ֭הִנָּשְׂאוּ פִּתְחֵ֣י עוֹלָ֑ם <tei:bibl>(תהלים כג:ט חלק א׳)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
