    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:nafshi_ivitikha_balailah_mosheh">
        <tei:head>נַפְשִׁי אִוִּיתִיךָ בַּלַּיְלָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nafshi_ivitikha_balailah_mosheh/1"/>
        <tei:lg>
          <tei:l>נַפְשִׁי אִוִּיתִיךָ בַּלַּיְלָה <tei:bibl>(ישעיה כו:ט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nafshi_ivitikha_balailah_mosheh/2"/>
        <tei:lg>
          <tei:l>אִוְּתָה נַפְשִׁי אֶל מְקוֹם נַפְשָׁהּ</tei:l>
          <tei:l>וְכָלְתָה אֶל מְקוֹר שָׁרְשָׁהּ</tei:l>
          <tei:l>וְנִכְסְפָה לִנְוֵה קָדְשָׁהּ,</tei:l>
          <tei:l>לָלֶכֶת יוֹמָם וָלָיְלָה!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nafshi_ivitikha_balailah_mosheh/3"/>
        <tei:lg>
          <tei:l>נֹעַם הַכָּבוֹד בְּעֵין הַדַּעַת תִּרְאֶה</tei:l>
          <tei:l>וּמִבְּלִי אֵבֶר אֵלָיו תִּדְאֶה</tei:l>
          <tei:l>וְתִשְׁאַף עָדָיו וְתִשְׁתָּאֶה –</tei:l>
          <tei:l>בְּנֶשֶׁף, בְּעֶרֶב יוֹם, בְּאִישׁוֹן לָיְלָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nafshi_ivitikha_balailah_mosheh/4"/>
        <tei:lg>
          <tei:l>יְקָרוֹ תָשׁוּר עַל יְדֵי פְעָלָיו</tei:l>
          <tei:l>וְתִתְאַו לָגֶשֶׁת אֵלָיו,</tei:l>
          <tei:l>יוֹם לְיוֹם תַּבִּיעַ אֹמֶר מַהֲלָלָיו</tei:l>
          <tei:l>וְלַיְלָה לְּלָיְלָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nafshi_ivitikha_balailah_mosheh/5"/>
        <tei:lg>
          <tei:l>מֵעוֹדִי עָלַי דֶּגֶל חַסְדְּךָ נוֹדַע</tei:l>
          <tei:l>וְאֹהֶל יִרְאָתְךָ מִלִּבִּי בַּל נִגְדַּע.</tei:l>
          <tei:l>אֲדֹנָי, חֲקַרְתַּנִי וַתֵּדַע,</tei:l>
          <tei:l>בָּחַנְתָּ לִבִּי פָּקַדְתָּ לָיְלָה!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nafshi_ivitikha_balailah_mosheh/6"/>
        <tei:lg>
          <tei:l>שָׂבַעְתִּי נְדוּדִים עַל עַרְשׂוֹת אֲנוּשִׁים,</tei:l>
          <tei:l>הֱרִיצוּנִי פְעָמַי לִמְעוֹנוֹת קְדוֹשִׁים,</tei:l>
          <tei:l>בִּנְפֹל תַּרְדֵּמָה עַל אֲנָשִׁים</tei:l>
          <tei:l>בִּשְׂעִפִּים מֵחֶזְיוֹנוֹת לָיְלָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nafshi_ivitikha_balailah_mosheh/7"/>
        <tei:lg>
          <tei:l>הִסְכַּלְתִּי וָאֶשְׁגֶּה כָּל יְמֵי שַׁחֲרוּתִי</tei:l>
          <tei:l>וְנִכְלַמְתִּי כִּי הָבַלְתִּי זְמַן יַלְדּוּתִי,</tei:l>
          <tei:l>לְזֹאת הָיְתָה לִּי דִמְעָתִי</tei:l>
          <tei:l>לֶחֶם יוֹמָם וָלָיְלָה!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nafshi_ivitikha_balailah_mosheh/8"/>
        <tei:lg>
          <tei:l>בָּרָה, בִּכְלוּא הַגּוּף נֶעֱצֶרֶת,</tei:l>
          <tei:l>הִתְבּוֹנְנִי כִּי הָעוֹלָם מַעְבֶּרֶת,</tei:l>
          <tei:l>עוּרִי עוּרִי לְרֹאשׁ אַשְׁמֹרֶת,</tei:l>
          <tei:l>קוּמִי רֹנִי בַלָּיְלָה!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nafshi_ivitikha_balailah_mosheh/9"/>
        <tei:lg>
          <tei:l>רוּצִי, זַכָּה, יֵצֶר תַּאֲוָה לִשְׁבֹּר</tei:l>
          <tei:l>וְדֶרֶךְ יְשָׁרָה כָּל יְמוֹתַיִךְ לָבֹר,</tei:l>
          <tei:l>הֲכִי חֶלְדֵּךְ כְּיוֹם אֶתְמוֹל כִּי יַעֲבֹר</tei:l>
          <tei:l>וְאַשְׁמוּרָה בַלָּיְלָה!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nafshi_ivitikha_balailah_mosheh/10"/>
        <tei:lg>
          <tei:l>בְּעַל כָּרְחוֹ אֱנוֹשׁ יוּלַּד לְעָמָל,</tei:l>
          <tei:l>וְכָל יֵצֶר מַחְשְׁבוֹתָיו אָוֶן וְעָמָל,</tei:l>
          <tei:l>וְהוּא כְצִיץ יָצָא וַיִּמָּל,</tei:l>
          <tei:l>וְיֻדַּד כְּחֶזְיוֹן לַָיְלָה!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nafshi_ivitikha_balailah_mosheh/11"/>
        <tei:lg>
          <tei:l>יָמִים עֲלֵיהֶם יִשְׂאוּ קוֹלָם,</tei:l>
          <tei:l>מָוֶת יִרְעֵם וְיָסוּר צִלָּם,</tei:l>
          <tei:l>וְעָזְבוּ לַאֲחֵרִים חֵילָם,</tei:l>
          <tei:l>רֶגַע יָמוּתוּ וַחֲצוֹת לָיְלָה!<tei:anchor xml:id="note_2"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nafshi_ivitikha_balailah_mosheh/12"/>
        <tei:lg>
          <tei:l>יִכְבַּד עָלַי עֹל יְגוֹנִי בְּחַטָּאתִי,</tei:l>
          <tei:l>כִּי לֹא שַׁבְתִּי עַד כֹּה מִמְּשׁוּבָתִי,</tei:l>
          <tei:l>יָגַעְתִּי בְאַנְחָתִי, וּמִטָּתִי בְדִמְעָתִי</tei:l>
          <tei:l>אַשְׂחֶה בְכָל לָיְלָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nafshi_ivitikha_balailah_mosheh/13"/>
        <tei:lg>
          <tei:l>עֵינִי בְּחֹם לִבִּי נִגְּרָה וְלֹא תִדְמֶה,</tei:l>
          <tei:l>לִקְאַת מִדְבָּר אֲנִי דוֹמֶה,</tei:l>
          <tei:l>יוֹמָם בְּמִסְתָּרִים נַפְשִׁי תֶהֱמֶה</tei:l>
          <tei:l>וַתָּקָם בְּעוֹד לָיְלָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nafshi_ivitikha_balailah_mosheh/14"/>
        <tei:lg>
          <tei:l>קוֹדֶרֶת בְּגָלוּת יְמֵי שִׁבְיָהּ,</tei:l>
          <tei:l>הוֹרִידָה לָאָרֶץ עֶדְיָהּ,</tei:l>
          <tei:l>תָּנוּד וְדִמְעָתָהּ עַל לֶחֱיָהּ –</tei:l>
          <tei:l>בָּכוֹ תִבְכֶּה בַּלָּיְלָה!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nafshi_ivitikha_balailah_mosheh/15"/>
        <tei:lg>
          <tei:l>בַּנֶּשֶׁף קִדַּמְתִּי דִמְעָתִי וְלֹא אָנוּחָה,</tei:l>
          <tei:l>אֶשְׁפְּכָה דַם לְבָבִי וְאָגִיחָה.</tei:l>
          <tei:l>נַפְשִׁי עָלַי תִּשְׁתּוֹחָח, וְעִם לְבָבִי אָשִׂיחָה׃</tei:l>
          <tei:l>אֶזְכְּרָה נְגִינָתִי בַּלָּיְלָה!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nafshi_ivitikha_balailah_mosheh/16"/>
        <tei:lg>
          <tei:l>חָלְפוּ כְצֵל יְמֵי עֲלוּמוֹתַי</tei:l>
          <tei:l>וְקַלּוּ מִנְּשָׁרִים שְׁנוֹתַי</tei:l>
          <tei:l>וְלֹא אֶזְכֹּר מִזְּמָן שִׂמְחוֹתַי</tei:l>
          <tei:l>לֹא יוֹם וְלֹא לָיְלָה!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nafshi_ivitikha_balailah_mosheh/17"/>
        <tei:lg>
          <tei:l>זֵדִים הֱצִיקוּנִי וְהִגְדִּילוּ עָלַי בְּפִיהֶם,</tei:l>
          <tei:l>דּוֹבְרִים שָׁלוֹם וְנוֹשְׁכִים בְּשִׁנֵּיהֶם –</tei:l>
          <tei:l>נָא יִזָּכֵר רֹעַ מַעַלְלֵיהֶם</tei:l>
          <tei:l>לְפָנֶיךָ הַיּוֹם – יוֹמָם וָלָיְלָה!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nafshi_ivitikha_balailah_mosheh/18"/>
        <tei:lg>
          <tei:l>קַדְּשׁוּ עֲצָרָה וְרַחֲצוּ וְהִתְקַדָּשׁוּ,</tei:l>
          <tei:l>הָבֵרוּ סִיג לְבָבוֹת וְהִתְאוֹשָׁשׁוּ.</tei:l>
          <tei:l>הַמַּזְכִּירִים אֶת אֲדֹנָי, אַל תֶּחֱשׁוּ</tei:l>
          <tei:l>כָּל הַיּוֹם וְכָל הַלָּיְלָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nafshi_ivitikha_balailah_mosheh/19"/>
        <tei:lg>
          <tei:l>הִתְבַּשְּׂרִי, בִּתִּי, כִּי עוֹד אַנְחִילֵךְ חִנִּי</tei:l>
          <tei:l>וּלְאַט אַנְחֵךְ וְאַנִּיחֵךְ בִּמְעוֹנִי,</tei:l>
          <tei:l>כִּי אֵין גּוֹאֵל קָרוֹב מִמֶּנִּי –</tei:l>
          <tei:l>לִינִי הַלָּיְלָה!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
