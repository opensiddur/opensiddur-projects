  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:addir_lo_yanum">
        <tei:head>אַדִּיר לֹא יָנוּם</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/1"/>
        <tei:lg>
          <tei:l>עֵת דּוֹדִים</tei:l>
          <tei:l>כַּלָּה בּוֹאִי לַגַּנִּים</tei:l>
          <tei:l>פָּרְחָה הַגֶּֽפֶן</tei:l>
          <tei:l>הֵנֵֽצוּ הָרִמּוֹנִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אַ</tei:seg>דִּיר לֹא יָנוּם</tei:l>
          <tei:l><tei:seg type="acrostic">בָּ</tei:seg>רוּךְ לֹא יִישַׁן</tei:l>
          <tei:l>הִנֵּ֣ה לֹֽא־יָ֭נוּם וְלֹ֣א יִישָׁ֑ן שׁ֝וֹמֵ֗ר יִשְׂרָאֵֽל׃ <tei:bibl>(תהלים קכא:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">גָּ</tei:seg>דוֹל לֹא יָנוּם</tei:l>
          <tei:l><tei:seg type="acrostic">דָּ</tei:seg>גוּל לֹא יִישַׁן</tei:l>
          <tei:l>הִנֵּ֣ה לֹֽא־יָ֭נוּם וְלֹ֣א יִישָׁ֑ן שׁ֝וֹמֵ֗ר יִשְׂרָאֵֽל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הָ</tei:seg>דוּר לֹא יָנוּם</tei:l>
          <tei:l><tei:seg type="acrostic">וָ</tei:seg>תִיק לֹא יִישַׁן</tei:l>
          <tei:l>הִנֵּ֣ה לֹֽא־יָ֭נוּם וְלֹ֣א יִישָׁ֑ן שׁ֝וֹמֵ֗ר יִשְׂרָאֵֽל׃ <tei:bibl>(תהלים קכא:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זַ</tei:seg>כַּאי לֹא יָנוּם</tei:l>
          <tei:l><tei:seg type="acrostic">חָ</tei:seg>נוּן לֹא יִישַׁן</tei:l>
          <tei:l>הִנֵּ֣ה לֹֽא־יָ֭נוּם וְלֹ֣א יִישָׁ֑ן שׁ֝וֹמֵ֗ר יִשְׂרָאֵֽל׃ <tei:bibl>(תהלים קכא:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/6"/>
        <tei:lg>
          <tei:l>עֵת דּוֹדִים</tei:l>
          <tei:l>כַּלָּה בּוֹאִי לַגַּנִּים</tei:l>
          <tei:l>פָּרְחָה הַגֶּֽפֶן</tei:l>
          <tei:l>הֵנֵֽצוּ הָרִמּוֹנִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">טָ</tei:seg>הוֹר לֹא יָנוּם</tei:l>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>שָׁר לֹא יִישַׁן</tei:l>
          <tei:l>הִנֵּ֣ה לֹֽא־יָ֭נוּם וְלֹ֣א יִישָׁ֑ן שׁ֝וֹמֵ֗ר יִשְׂרָאֵֽל׃ <tei:bibl>(תהלים קכא:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כַּ</tei:seg>בִּיר לֹא יָנוּם</tei:l>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>בוּשׁ־צְדָקָה<tei:anchor xml:id="note_1"/> לֹא יִישַׁן</tei:l>
          <tei:l>הִנֵּ֣ה לֹֽא־יָ֭נוּם וְלֹ֣א יִישָׁ֑ן שׁ֝וֹמֵ֗ר יִשְׂרָאֵֽל׃ <tei:bibl>(תהלים קכא:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מָ</tei:seg>רוֹם<tei:anchor xml:id="note_2"/> לֹא יָנוּם</tei:l>
          <tei:l><tei:seg type="acrostic">נ</tei:seg>וֹרָא לֹא יִישַׁן</tei:l>
          <tei:l>הִנֵּ֣ה לֹֽא־יָ֭נוּם וְלֹ֣א יִישָׁ֑ן שׁ֝וֹמֵ֗ר יִשְׂרָאֵֽל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/10"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ס</tei:seg>וֹמֵךְ לֹא יָנוּם</tei:l>
          <tei:l><tei:seg type="acrostic">ע</tei:seg>וֹזֵר לֹא יִישַׁן</tei:l>
          <tei:l>הִנֵּ֣ה לֹֽא־יָ֭נוּם וְלֹ֣א יִישָׁ֑ן שׁ֝וֹמֵ֗ר יִשְׂרָאֵֽל׃ <tei:bibl>(תהלים קכא:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/11"/>
        <tei:lg>
          <tei:l>עֵת דּוֹדִים</tei:l>
          <tei:l>כַּלָּה בּוֹאִי לַגַּנִּים</tei:l>
          <tei:l>פָּרְחָה הַגֶּֽפֶן</tei:l>
          <tei:l>הֵנֵֽצוּ הָרִמּוֹנִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/12"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פּ</tei:seg>וֹדֶה לֹא יָנוּם</tei:l>
          <tei:l><tei:seg type="acrostic">צַ</tei:seg>דִּיק לֹא יִישַׁן</tei:l>
          <tei:l>הִנֵּ֣ה לֹֽא־יָ֭נוּם וְלֹ֣א יִישָׁ֑ן שׁ֝וֹמֵ֗ר יִשְׂרָאֵֽל׃ <tei:bibl>(תהלים קכא:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/13"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>דוֹשׁ לֹא יָנוּם</tei:l>
          <tei:l><tei:seg type="acrostic">רַ</tei:seg>חוּם<tei:anchor xml:id="note_3"/> לֹא יִישַׁן</tei:l>
          <tei:l>הִנֵּ֣ה לֹֽא־יָ֭נוּם וְלֹ֣א יִישָׁ֑ן שׁ֝וֹמֵ֗ר יִשְׂרָאֵֽל׃ <tei:bibl>(תהלים קכא:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/14"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שַׁ</tei:seg>דַּי<tei:anchor xml:id="note_4"/> לֹא יָנוּם</tei:l>
          <tei:l><tei:seg type="acrostic">תָּ</tei:seg>מִים לֹא יִישַׁן</tei:l>
          <tei:l>הִנֵּ֣ה לֹֽא־יָ֭נוּם וְלֹ֣א יִישָׁ֑ן שׁ֝וֹמֵ֗ר יִשְׂרָאֵֽל׃ <tei:bibl>(תהלים קכא:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/15"/>
        <tei:lg>
          <tei:l>אֲדֹנָי לֹא יָנוּם</tei:l>
          <tei:l>מֶֽלֶךְ לֹא יִישַׁן</tei:l>
          <tei:l>הִנֵּ֣ה לֹֽא־יָ֭נוּם וְלֹ֣א יִישָׁ֑ן שׁ֝וֹמֵ֗ר יִשְׂרָאֵֽל׃ <tei:bibl>(תהלים קכא:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/16"/>
        <tei:lg>
          <tei:l>עֵת דּוֹדִים</tei:l>
          <tei:l>כַּלָּה בּוֹאִי לַגַּנִּים</tei:l>
          <tei:l>פָּרְחָה הַגֶּֽפֶן</tei:l>
          <tei:l>הֵנֵֽצוּ הָרִמּוֹנִים׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" n="1" target="#note_1">
      <tei:p>In the customary reading of Sefaradim, the variation here has לָעַד (forever).</tei:p>
    </tei:note>
    <tei:note type="commentary" n="2" target="#note_2">
      <tei:p>In the customary reading of Sefaradim, the variation here has מֶֽלֶךְ (king, sovereign).</tei:p>
    </tei:note>
    <tei:note type="commentary" n="3" target="#note_3">
      <tei:p>In the customary reading of Sefaradim, the Alef-bet acrostic elides the letter resh.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="4" target="#note_4">
      <tei:p>In the customary reading of Sefaradim, the Alef-bet acrostic elides the letter shin.</tei:p>
    </tei:note>
  </tei:standOff>
</tei:TEI>