    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:mi_sheanah_hu_yaanenu_a_star_trek_selichah_mayer">
        <tei:head>מִי שֶׁעָנָה...הוּא יַעֲנֵנוּ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheanah_hu_yaanenu_a_star_trek_selichah_mayer/1"/>
        <tei:lg>
          <tei:l>מִי שֶׁעָנָה לְקִירְק הַקְּבַרְנִיט</tei:l>
          <tei:l>בְּקֻּמְפּוֹן שֶׁנֶּאֱבַק גּוֹרֶן עִמוֹ,</tei:l>
          <tei:l>הוּא יַעֲנֵנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheanah_hu_yaanenu_a_star_trek_selichah_mayer/2"/>
        <tei:lg>
          <tei:l>מִי שֶׁעָנָה לִשְׂפּוֹךְ</tei:l>
          <tei:l>בָּעֲבֵירָתוֹ אֶת תַּקָּנָה־הַכְּלָלִית הַשְּׁבִיעִית,</tei:l>
          <tei:l>הוּא יַעֲנֵנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheanah_hu_yaanenu_a_star_trek_selichah_mayer/3"/>
        <tei:lg>
          <tei:l>מִי שֶׁעָנָה לִמְקוֹי הָרוֹפֵא</tei:l>
          <tei:l>בְּאַדְמַת קְפֵילַת־אָרְבַּע,</tei:l>
          <tei:l>הוּא יַעֲנֵנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheanah_hu_yaanenu_a_star_trek_selichah_mayer/4"/>
        <tei:lg>
          <tei:l>מִי שֶׁעָנָה לְפִיקָרְד הַקְּבַרְנִיט</tei:l>
          <tei:l>בָּאֲנִיסַתוֹ מֵהַבּוֹרְג,</tei:l>
          <tei:l>הוּא יַעֲנֵנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheanah_hu_yaanenu_a_star_trek_selichah_mayer/5"/>
        <tei:lg>
          <tei:l>מִי שֶׁעָנָה לְרַיקֶר אִישׁ־אֶחָד</tei:l>
          <tei:l>בִּקְרַב־זְאֵב שָׂטָ׳ן,</tei:l>
          <tei:l>הוּא יַעֲנֵנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheanah_hu_yaanenu_a_star_trek_selichah_mayer/6"/>
        <tei:lg>
          <tei:l>מִי שֶׁעָנָה לְדֵיטָא</tei:l>
          <tei:l>בְּעָקַב אוֹתוֹ אָחִיו,</tei:l>
          <tei:l>הוּא יַעֲנֵנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheanah_hu_yaanenu_a_star_trek_selichah_mayer/7"/>
        <tei:lg>
          <tei:l>מִי שֶׁעָנָה לְסִסְקוֹא</tei:l>
          <tei:l>בַּמַּחֲזוֹתָיו מִין הַנְּבִיאִים,</tei:l>
          <tei:l>הוּא יַעֲנֵנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheanah_hu_yaanenu_a_star_trek_selichah_mayer/8"/>
        <tei:lg>
          <tei:l>מִי שֶׁעָנָה לְקִירָה</tei:l>
          <tei:l>בִּלְחִיצַת קָרְדַּצִיָה אֶת־בְּנֵי־בָּדְזוֹר בְּחׇזְקָה חֲמִשִּׁים שָׁנָה,</tei:l>
          <tei:l>הוּא יַעֲנֵנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheanah_hu_yaanenu_a_star_trek_selichah_mayer/9"/>
        <tei:lg>
          <tei:l>מִי שֶׁעָנָה לְעֹדוֹ</tei:l>
          <tei:l>בְּקֶשֶׁר הַגָּדוֹל,</tei:l>
          <tei:l>הוּא יַעֲנֵנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheanah_hu_yaanenu_a_star_trek_selichah_mayer/10"/>
        <tei:lg>
          <tei:l>מִי שֶׁעָנָה לְכׇל־עוֹבְרֵי אֳנִיַּת־הַכּוֹכָבִים נוֹסֵעַ</tei:l>
          <tei:l>בְּרֹבַע הַדָּלֶ״ת,</tei:l>
          <tei:l>הוּא יַעֲנֵנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheanah_hu_yaanenu_a_star_trek_selichah_mayer/11"/>
        <tei:lg>
          <tei:l>מִי שֶׁעָנָה לְכׇל־חֶבְרָת יְשֻׁיּוֹתֶיךָ</tei:l>
          <tei:l>‎ בִּצְבַא־הַכּוֹכָבִים‎,</tei:l>
          <tei:l>הוּא יַעֲנֵנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheanah_hu_yaanenu_a_star_trek_selichah_mayer/12"/>
        <tei:lg>
          <tei:l>מִי שֶׁעָנָה לְכׇל־הַצָּדִיקִים וְהַחֲסִידִים וְהַתְּמִימִים וְהַיְּשָׁרִים</tei:l>
          <tei:l>בָּעוֹלָם הַזֶּה וּבְכׇל־עוֹלְמֵי־עוֹלָמִים,</tei:l>
          <tei:l>הוּא יַעֲנֵנוּ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
