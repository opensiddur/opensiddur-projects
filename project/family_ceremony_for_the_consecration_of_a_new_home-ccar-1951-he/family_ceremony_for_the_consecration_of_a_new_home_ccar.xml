  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:family_ceremony_for_the_consecration_of_a_new_home_ccar">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:family_ceremony_for_the_consecration_of_a_new_home_ccar/3"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם</tei:l>
          <tei:l>שֶׁהֶחֱיָנוּ</tei:l>
          <tei:l>וְקִיְּמָנוּ</tei:l>
          <tei:l>וְהִגִּיעָנוּ לַזְּמַן הַזֶּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:family_ceremony_for_the_consecration_of_a_new_home_ccar/15"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְהֹוָה אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>הַמוֹצִיא לֶֽחֶם מִן הָאֲרֶץ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:family_ceremony_for_the_consecration_of_a_new_home_ccar/18"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם,</tei:l>
          <tei:l>בּוֹרֵא פְּרִי הַגָּפֶן.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:family_ceremony_for_the_consecration_of_a_new_home_ccar/21"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם</tei:l>
          <tei:l>אֲשֶׁר קִדְּשָׁנוּ בְּמִצְוֺתָיו</tei:l>
          <tei:l>וְצִוָּנוּ לַעֲסוֹק בְּדִבְרֵי תוֹרָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:family_ceremony_for_the_consecration_of_a_new_home_ccar/26"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם</tei:l>
          <tei:l>אֲשֶׁר קִדְּשָׁנוּ בְּמִצְוֹתָיו</tei:l>
          <tei:l>וְצִוָּנוּ לִקְבֹּעַ מְזוּזָה׃</tei:l>
        </tei:lg>
      </tei:div>
