    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:heikhal_yitschak">
        <tei:head>הֵיכַל ה׳</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:heikhal_yitschak/1"/>
        <tei:lg>
          <tei:l>הֵיכַ֤ל יְהֹוָה֙ הֵיכַ֣ל יְהֹוָ֔ה הֵיכַ֥ל יְהֹוָ֖ה <tei:bibl>(ירמיה ז:ד)</tei:bibl></tei:l>
          <tei:l>הַעַל שְׁאוֹנוֹ רַבּוּ זְדוֹנַי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:heikhal_yitschak/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">י</tei:seg>וֹם מִדְּבִירִי עָלָה כְּרוּבִי</tei:l>
          <tei:l>אֶזְעַק אֲהָהּ עַל זְמַן מַדְאִיבִי</tei:l>
          <tei:l>יִמַּס לְבָבִי מֵעֹז כְּאֵבִי</tei:l>
          <tei:l>יַעֲנֶה בְּפָנַי עַל־רֹב עֲוֺנַי</tei:l>
          <tei:l>כַּחֲשִׁי וּבָא קוֹל פְּחָדִים בְּאָזְנַי׃</tei:l>
          <tei:l>הֵיכַ֤ל...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:heikhal_yitschak/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">צ</tei:seg>וּרִי בְּחֶטְאִי הִשְׂחִית הֲדָרִי</tei:l>
          <tei:l>מֵרוּם לָאָֽרֶץ הִשְׁלִיךְ פְּאֵרִי</tei:l>
          <tei:l>מֵחִיל תְּסַמֵּר שַׂעֲרַת בְּשָׂרִי</tei:l>
          <tei:l>מֵי רֹאשׁ וְלַעֲנַי נַֽחַל עֲדָנַי</tei:l>
          <tei:l>נֶהְפַּךְ לְחֹֽשֶׁךְ שִׁמְשִׁי לְעֵינַי׃</tei:l>
          <tei:l>הֵיכַ֤ל...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:heikhal_yitschak/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חָ</tei:seg>שַׁב בְּגוֹרָל צַר מַחֲשָׁבוֹת</tei:l>
          <tei:l>עָלַי וְהִפִּיל כַּמָּה רְבָבוֹת</tei:l>
          <tei:l>מֵתוּ בְּפַֽחַד אִבְחַת חֲרָבוֹת</tei:l>
          <tei:l>הֵכִין לַטֶּֽבַח לְוִיַּי וְכֹהֲנַי</tei:l>
          <tei:l>עִם אֶל־הוּרַם מֵאָז בְּסִינַי׃</tei:l>
          <tei:l>הֵיכַ֤ל...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:heikhal_yitschak/5"/>
        <tei:lg>
          <tei:l>מָתַי תְּנַחֵם בָּנִים אֲבֵלִים</tei:l>
          <tei:l>תָּשִׁיב לְצִיּוֹן שְׁאֵרִית אַצִּילִים</tei:l>
          <tei:l>מִשָּׁם תְּבַעֵר אֶת־הַפְּסִילִים</tei:l>
          <tei:l>אוֹמֵר בְּהַכְרִית אוֹיְבֶֽיךָ</tei:l>
          <tei:l>מַה־גָּדְל֣וּ מַעֲשֶׂ֣יךָ יְהֹוָ֑ה׃ <tei:bibl>(תהלים צב:ו)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
