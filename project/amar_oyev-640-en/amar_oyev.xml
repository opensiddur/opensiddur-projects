  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:amar_oyev">
        <tei:head>Amar Oyev (The Enemy Said) — a piyyuṭ for the Seder Meturgeman of the 7th Day of Pesaḥ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_oyev/1"/>
        <tei:lg>
          <tei:l>The enemy said...</tei:l>
          <tei:l><tei:seg type="acrostic">A</tei:seg>rrange my ride!</tei:l>
          <tei:l><tei:seg type="acrostic">B</tei:seg>y undefeatable sword,</tei:l>
          <tei:l><tei:seg type="acrostic">C</tei:seg>ome, mighty, to battle!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_oyev/2"/>
        <tei:lg>
          <tei:l>The enemy said...</tei:l>
          <tei:l><tei:seg type="acrostic">D</tei:seg>ash after my slaves!</tei:l>
          <tei:l><tei:seg type="acrostic">E</tei:seg>re 210 years under my hand</tei:l>
          <tei:l><tei:seg type="acrostic">F</tei:seg>leeing from my servitude!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_oyev/3"/>
        <tei:lg>
          <tei:l>The enemy said...</tei:l>
          <tei:l><tei:seg type="acrostic">G</tei:seg>o after them, I’ll heroically be with you!</tei:l>
          <tei:l><tei:seg type="acrostic">H</tei:seg>ostage on the road, no way across!</tei:l>
          <tei:l><tei:seg type="acrostic">I</tei:seg>n both sea and desert we blocked them!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_oyev/4"/>
        <tei:lg>
          <tei:l>The enemy said...</tei:l>
          <tei:l><tei:seg type="acrostic">J</tei:seg>ust my power can defeat theirs.</tei:l>
          <tei:l><tei:seg type="acrostic">K</tei:seg>eep my orders to their camps.</tei:l>
          <tei:l><tei:seg type="acrostic">L</tei:seg>et’s split the spoils!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_oyev/5"/>
        <tei:lg>
          <tei:l>The enemy said...</tei:l>
          <tei:l><tei:seg type="acrostic">M</tei:seg>ake off with their stuff.</tei:l>
          <tei:l><tei:seg type="acrostic">N</tei:seg>ow kill their men!</tei:l>
          <tei:l><tei:seg type="acrostic">O</tei:seg>r abuse their women!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_oyev/6"/>
        <tei:lg>
          <tei:l>The enemy said...</tei:l>
          <tei:l><tei:seg type="acrostic">P</tei:seg>eformed the bloody work!</tei:l>
          <tei:l><tei:seg type="acrostic">Q</tei:seg>uiet them from under heaven,</tei:l>
          <tei:l><tei:seg type="acrostic">R</tei:seg>elease my bow, and they run!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_oyev/7"/>
        <tei:lg>
          <tei:l>The enemy said...</tei:l>
          <tei:l><tei:seg type="acrostic">S</tei:seg>o kill them with much killing!</tei:l>
          <tei:l><tei:seg type="acrostic">T</tei:seg>o let my nobles split the spoils,</tei:l>
          <tei:l><tei:seg type="acrostic">U</tei:seg>pend all their faces to doom!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_oyev/8"/>
        <tei:lg>
          <tei:l>Moses said...</tei:l>
          <tei:l><tei:seg type="acrostic">V</tei:seg>erily, Shepherd of Israel, listen!</tei:l>
          <tei:l><tei:seg type="acrostic">W</tei:seg>ho leads Joseph like a flock!</tei:l>
          <tei:l><tei:seg type="acrostic">Y</tei:seg>ou enthroned on the cherubim, shine forth!<tei:anchor xml:id="note_1"/></tei:l>
        </tei:lg>
      </tei:div>
