  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:qillus_lepurim_lilmegillah">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qillus_lepurim_lilmegillah/1"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">אֶ</tei:seg>תְנֵה בִּכְנִישְׁתִּי שֶֽׁבַח לֶאֱלָהּ אֲבָהָתִי</tei:l>
          <tei:l>אֲהוֹדַע לְאוּמָּתִי מָא דְּמָטָא יָתִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qillus_lepurim_lilmegillah/2"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>יוֹמֽוֹהִי דְּסַֽבָא בְּחִֽירָא אִתְגְרִי לֵיהּ נִמְרֹד גּֽוּבְרָא</tei:l>
          <tei:l>וְטַלְקֵיהּ לְנֽוּרָא וְשֵׁיזַב יָתֵיהּ נוֹרָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qillus_lepurim_lilmegillah/3"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">גַּ</tei:seg>דְיָין כַּד אַיתִי יַעֲקֹב לְאִמֵּיהּ וְאוֹכִיל לַאֲבֽוּהִי רַחֲמֵיהּ</tei:l>
          <tei:l>אֲתָא עֱשָׂו מִן־יוֹמֵיהּ וְנַטְרֵיהּ וְסַטְמֵיהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qillus_lepurim_lilmegillah/4"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">דְּ</tei:seg>בָבוּתֵיהּ כַּד חֲמַת אִמֵּיהּ שְׁלָחַת יָתֵיהּ לְגַב לָבָן לְגַרְמֵיהּ</tei:l>
          <tei:l>וְאִתְגְלִי עֲלֽוֹהִי רְחִימֵיהּ וּמַלֵּיל עִמֵּיהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qillus_lepurim_lilmegillah/5"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">הָ</tei:seg>א עֶסְרִין שְׁנִין הֲוָה רְעֵי עִם לָבָן עָנִין</tei:l>
          <tei:l>וּקְנָה בְּנָן וּבְנִין וְעִיזִּין וְאִמְּרִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qillus_lepurim_lilmegillah/6"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>כַד אֲתָא לְמַחֲזוֹר לְאַתְרֵיהּ רְדַף לָבָן בַּתְרֵיהּ</tei:l>
          <tei:l>וּבְעָא לְמֽוֹבְדָא עִיקָּרֵיהּ וּנְטֽוּרָא נַטְרֵיהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qillus_lepurim_lilmegillah/7"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">זְ</tei:seg>רָז עֱשָׂו מִן־שִׁנְתֵיהּ וּנְפַק לִקְדָמוּתֵיהּ</tei:l>
          <tei:l>וּבְעָא לְמֽוֹבְדָא יָתֵיהּ לוּלֵי אֱלָהּ אֲבָהָתֵיהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qillus_lepurim_lilmegillah/8"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">חֵ</tei:seg>ילְוָן דְּמַלְאָכִין שְׁלַח לֵיהּ מֶֽלֶךְ מַלְכִין</tei:l>
          <tei:l>דִּיהֲווּן עִמֵּיהּ דַּרְכִין וּקְדָמֽוֹהִי מְהַלְכִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qillus_lepurim_lilmegillah/9"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">טַ</tei:seg>עֲנוּ יַתֵיהּ בָּנוֹי כֵּיוָן וּנְחָתוּ לְמִצְרַֽיִם בְּשִׁבְעִין חֵילְוָן</tei:l>
          <tei:l>וְאִיתּוֹתִֽיבוּ תַּמָּן שְׁנִין עֶֽסֶר וְתַרְתֵּין מַאֲוָן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qillus_lepurim_lilmegillah/10"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">יַ</tei:seg>לְדֵיהוֹן לְנַֽהֲרָא זְרַק פַּרְעֹה מַמְזֵֽירָא</tei:l>
          <tei:l>וּטְבַע יָתֵיהּ אֱלָֽהָא גִּיבָּֽרָא בְּיַֽמָּא כְּאֲבָֽרָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qillus_lepurim_lilmegillah/11"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">כַּ</tei:seg>ד נְפָֽקוּ מִן יַֽמָּא בְּמֵימְרֵיהּ דְּרָֽמָא</tei:l>
          <tei:l>אֲתַא עֲמָלֵק מְחַֽרְמָא מִנְּהוֹן לְמִתְגַֽרְמָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qillus_lepurim_lilmegillah/12"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">לֶ</tei:seg>אֱלָהּ עִילַֽיָא תְּלָא יְדֽוֹהִי מֹשֶׁה מַעְלְיָא</tei:l>
          <tei:l>וְאִתְיְהֵב עֲמָלֵק לִכְלָֽיָא בְּיַד יְהוֹשֻֽׁעַ טַֽלְיָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qillus_lepurim_lilmegillah/13"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>נְּהוֹן סְכֵי לְמִתְפַּֽרְעָא סִיסְרָא רְשִֽׁיעָא</tei:l>
          <tei:l>וּלְשֵׁיצֵיא יַתְהוֹן בְּעַא מִן־גוֹ אַֽרְעָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qillus_lepurim_lilmegillah/14"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">נׄ</tei:seg>וּרָא מִן־שְׁמַֽיָּא זְרַק עֲלֽוֹהִי מִכּוֹכְבַֽיָּא</tei:l>
          <tei:l>וּסְדָֽרוּ עִמֵּיהּ קְרָבַֽיָּא בְּגִין עַֽמָּא רְחִימַֽיָּא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qillus_lepurim_lilmegillah/15"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">סַ</tei:seg>נְחֵרִיב גְּרַשׁ חֵילוֹתֵיהּ וְאִתְגְאֵי בְּמַלְכוּתֵיהּ</tei:l>
          <tei:l>וַחֲרַף בְּנַבְלוּתֵיהּ לְמַן דִּי־בְרָא נִשְׁמַתֵיהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qillus_lepurim_lilmegillah/16"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">עַ</tei:seg>בֵיד קְרָבִין שְׁלַח מַלְאָכֵיהּ בְּגִין חֲבִיבִין</tei:l>
          <tei:l>וּקְטַל מִן־אוּכְלְסֽוֹי טַלְיָין וְסַבִין מֵאָה וּתְּמָנָן וַחֲמִשָׁה אַלְפֵי כְּתִיבִין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qillus_lepurim_lilmegillah/17"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>רַא מַלְכְּהוֹן דְּבַבְלָאֵי וְאַיתִי עִמְּהוֹן כַּסְדַּאֵי</tei:l>
          <tei:l>חֲרָב בֵּיתְהוֹן דְּעִבְרָאֵי וְאַגְלֵי עַמָּא יְהוּדָאֵי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qillus_lepurim_lilmegillah/18"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">צַ</tei:seg>דִּיקִּין אַרְבְּעָה כַּד קָמוּן וּצְלוּן וְצָמוּן</tei:l>
          <tei:l>מַלְכֽוּתָא מִנֵּיהּ אַשְׁלִמוּן וּבְמַפַּלְתֵּיהּ חָמוּן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qillus_lepurim_lilmegillah/19"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>ם שִׁמְשַׁי סָפְרָא וְאַסְגֵּי בְּעוּתְרָא</tei:l>
          <tei:l>וּתְקַל אַֽלְפִין עַֽסְרָה לְאוֹבָֽדָא אֽוּמָּא מַֽעְסְרָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qillus_lepurim_lilmegillah/20"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">רָֽ</tei:seg>מָא פְּסַל כַּסְפֵּיהּ וּטְמַע אַלְפֵיהּ</tei:l>
          <tei:l>וּבַלְבֵּל סוֹפֵיהּ וְעַל־שָׁרִיתֵיהּ אִצְטְלַב גּוּפֵיהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qillus_lepurim_lilmegillah/21"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">שָׁ</tei:seg>דַּי מָרֵי שְׁמַֽיָּה יְעוֹרֵר נִסַּֽיָּא</tei:l>
          <tei:l>וְיַצְמַח בְּאִלֵּין יוֹמַֽיָּא יְשׁוּעָה לִבְנַֽיָּא רְחִימַֽיָּא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qillus_lepurim_lilmegillah/22"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">תִּ</tei:seg>קְרַב שַֽׁעֲתָא וְתִתְפְּרֵק אֽוּמְּתָא</tei:l>
          <tei:l>וְתִסְגֵּי לָן וּלְכוֹן חֶדְוָֽתָא הֵיךְ דַּהֲוָה בְּשׁוּשָׁן בִּֽירְתָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qillus_lepurim_lilmegillah/23"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">שַׁ</tei:seg>לִּֽיטָא יַדֵיק בְּרַחֲמִין מִשְּׁמֵי מְרוֹמִין</tei:l>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>מִפְרוֹק עַם רְחִימִין מִשִּׁבְעִין אוּמִּין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qillus_lepurim_lilmegillah/24"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">מַן</tei:seg> דְּאִתְפְּרַע מִן־קַדְמַֽיָא הוּא יְשֵׁיצֵי אׇחֲרַֽיָא</tei:l>
          <tei:l>וְיִתְנְקֵם מִן־רוֹמַיָּא וְסַרְקַיָּא בְּיַד עַמָּא יְהוּדַיָּא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qillus_lepurim_lilmegillah/25"/>
        <tei:lg xml:lang="he">
          <tei:l>כָּכַּתוּב — וְנָתַתִּ֨י אֶת־נִקְמָתִ֜י בֶּאֱד֗וֹם</tei:l>
          <tei:l>בְּיַד֙ עַמִּ֣י יִשְׂרָאֵ֔ל</tei:l>
          <tei:l>וְעָשׂ֣וּ בֶאֱד֔וֹם כְּאַפִּ֖י</tei:l>
          <tei:l>וְכַחֲמָתִ֑י וְיָֽדְעוּ֙ אֶת־נִקְמָתִ֔י</tei:l>
          <tei:l>נְאֻ֖ם אֲדֹנָ֥י יֱהֹוִֽה׃ <tei:bibl>(יחזקאל כה:יד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qillus_lepurim_lilmegillah/26"/>
        <tei:lg xml:lang="he">
          <tei:l>וְנֶאֱמַר — לַיְּהוּדִ֕ים הָֽיְתָ֥ה אוֹרָ֖ה וְשִׂמְחָ֑ה וְשָׂשֹׂ֖ן וִיקָֽר׃ <tei:bibl>(אסתר ח:טז)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
