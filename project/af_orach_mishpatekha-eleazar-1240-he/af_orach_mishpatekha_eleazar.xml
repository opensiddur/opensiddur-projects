      <tei:div corresp="urn:x-opensiddur:text:poem:af_orach_mishpatekha_eleazar">
        <tei:head>אַף אֹרַח מִשְׁפָּטֶיךָ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:af_orach_mishpatekha_eleazar/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אַ֣</tei:seg>ף אֹ֧רַח מִשְׁפָּטֶ֛יךָ יְהֹוָ֖ה קִוִּינ֑וּךָ</tei:l>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>שִׁמְךָ֥ וּלְזִכְרְךָ֖ תַּאֲוַת־נָֽפֶשׁ<tei:anchor xml:id="note_1"/> אִוִּינֽוּךָ</tei:l>
          <tei:l><tei:seg type="acrostic">עָ</tei:seg>מְדוּ לְוִיִּים עַל־דּוּכָנָם כְּבָשׁוּם לֹא עֲזַבְנֽוּךָ</tei:l>
          <tei:l><tei:seg type="acrostic">זֶ</tei:seg>ה אֱלֹהֵֽינוּ הִסְתַּרְתָּ פָּנִים וַאֲנַֽחְנוּ לֹא שְׁכַחְנֽוּךָ</tei:l>
          <tei:l><tei:seg type="acrostic">רָ</tei:seg>אִֽיתָ וְלֹא חָמַֽלְתָּ כְּמוֹ מֵעוֹלָם לֹא יְדַעֲנֽוּךָ</tei:l>
          <tei:l><tei:seg type="acrostic">הִ</tei:seg>רְאִיתָֽנוּ קָשֶׁה מִן־הַמֵּצַר קְרָאנֽוּךָ</tei:l>
          <tei:l><tei:seg type="acrostic">קִ</tei:seg>נְאָתְךָ וּגְבוּרֹתֶֽךָ אַיֵּה אֵיךְ הִתְאַפַּֽקְתָּ זְכַרְנֽוּךָ</tei:l>
          <tei:l><tei:seg type="acrostic">טָ</tei:seg>בַ֖חְתָּ לֹ֥א חָמָֽלְתָּ<tei:anchor xml:id="note_2"/> שָׂרַֽפְתָּ מְקוֹם בּוֹ בְּחָנֽוּךָ</tei:l>
          <tei:l><tei:seg type="acrostic">נָ</tei:seg>טַֽשְׁתָּ נַחֲלָתֶֽיךָ עָשׂוּ קָמֶֽיךָ וְלֹא חֲנָנֽוּךָ</tei:l>
          <tei:l>הֵשַֽׁבְתָּ יְמִין אָחוֹר כְּאִֽלּוּ קָמֶֽיךָ דָּנֽוּךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:af_orach_mishpatekha_eleazar/2"/>
        <tei:lg>
          <tei:l>הוֹשִֽׁיעָה נָא יְמִינְךָ לְקֵץ הַיָּמִין בִּפְלִילוּת</tei:l>
          <tei:l>מֶ֖לֶךְ אָס֥וּר<tei:anchor xml:id="note_3"/> בְּֽכָל־צָרָתָ֣ם ל֣וֹ צָ֗ר<tei:anchor xml:id="note_4"/> בְּסִכְלוּת</tei:l>
          <tei:l>הֲמוֹן מַֽעְלָה הֻשְׁתְּקוּ וְהֻשְׁפְּלוּ בְּזִילוּת</tei:l>
          <tei:l>וְהֽוּא־אָס֤וּר בָּֽאזִקִּים֙ בְּת֨וֹךְ כׇּל־גָּל֤וּת׃<tei:anchor xml:id="note_5"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:af_orach_mishpatekha_eleazar/3"/>
        <tei:lg>
          <tei:l>בֵּית תִּפְאַרְתֵּֽנוּ לִשְׂרֵפַת אֵשׁ הֲמוֹן גּוֹיִים יֶהֱמָיוּן</tei:l>
          <tei:l>קוֹל נָתְנוּ בְּבֵית קׇדְשֶֽׁךָ לְוִיֶּֽיךָ יַחַד יִכְלַיוּן</tei:l>
          <tei:l>הִשְׁלַֽכְתָּ מִשָּׁמַֽיִם אֶֽרֶץ תִּפְאַרְתָּם בַּל־יֶחֱזָיוּן</tei:l>
          <tei:l>הֵ֚ן אֶרְאֶלָּ֔ם צָעֲק֖וּ חֻ֑צָה מַלְאֲכֵ֣י שָׁל֔וֹם מַ֖ר יִבְכָּיֽוּן׃<tei:anchor xml:id="note_6"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:af_orach_mishpatekha_eleazar/4"/>
        <tei:lg>
          <tei:l>אַחֲרִ֖ישׁ אֶתְאַפָּ֑ק<tei:anchor xml:id="note_7"/> לֻקָּח הַיּוֹם קְלָלָה</tei:l>
          <tei:l>אׇהֳלִ֣י שֻׁדָּ֔ד וְכׇל־מֵיתָרַ֖י נִתָּ֑קוּ<tei:anchor xml:id="note_8"/> לְחַלְלָהּ</tei:l>
          <tei:l>שָׁבַת גְּאוֹן עַלִּיזִים הֻמַּר שִׁיר לִיְלָלָה</tei:l>
          <tei:l>וְלֹא־קָרַ֥ב זֶ֛ה אֶל־זֶ֖ה כׇּל־הַלָּֽיְלָה׃<tei:anchor xml:id="note_9"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:af_orach_mishpatekha_eleazar/5"/>
        <tei:lg>
          <tei:l>בְּקִרְבְּךָ קָדוֹשׁ לֹא אָבוֹא בְּעִיר לְהִכָּנֵס</tei:l>
          <tei:l>עַל־חֽוֹמֹתַ֣יִךְ יְרוּשָׁלַ֗͏ִם הִפְקַ֙דְתִּי֙ שֹֽׁמְרִ֔ים<tei:anchor xml:id="note_10"/> לְשַׁנֵּס</tei:l>
          <tei:l>אַתָּ֣ה תָ֭קוּם תְּרַחֵ֣ם צִיּ֑וֹן<tei:anchor xml:id="note_11"/> לְהַרְאוֹת אֶת־נֵס</tei:l>
          <tei:l>בּוֹנֵ֣ה יְרוּשָׁלַ֣͏ִם יהו֑ה נִדְחֵ֖י יִשְׂרָאֵ֣ל יְכַנֵּֽס׃<tei:anchor xml:id="note_12"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:af_orach_mishpatekha_eleazar/6"/>
        <tei:lg>
          <tei:l>שׁ֤וּבוּ אֵלַי֙ וְאָשׁ֣וּבָה אֲלֵיכֶ֔ם<tei:anchor xml:id="note_13"/> לַחֲדוֹשׁ</tei:l>
          <tei:l>שׂוֹנְאֵיכֶם אַצְמִית וְכׇל־אוֹיבֵיכֶם לַהֲדוֹשׁ</tei:l>
          <tei:l>אַצְמִיחַ קֶרֶן לְדָוִד בֵּית תִּפְאַרְתִּי לִגְדוֹשׁ</tei:l>
          <tei:l>וְקָרָ֨א זֶ֤ה אֶל־זֶה֙ וְאָמַ֔ר קָד֧וֹשׁ ׀ קָד֛וֹשׁ קָד֖וֹשׁ<tei:anchor xml:id="note_14"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:af_orach_mishpatekha_eleazar/7"/>
        <tei:lg>
          <tei:l>וְהַחַיּוֹת יְשׁוֹרֵרוּ</tei:l>
          <tei:l>וּכְרוּבִים יְפָאֵרוּ</tei:l>
          <tei:l>וּשְׂרָפִים יָרֹנּוּ</tei:l>
          <tei:l>וְאֶרְאֶלִּים יְבָרֵכוּ</tei:l>
          <tei:l>פְּנֵי כׇּל־חַיָּה וְאוֹפַן וּכְרוּב</tei:l>
          <tei:l>לְעֻמַּת שְׂרָפִים</tei:l>
          <tei:l>לְעֻמָּתָם מְשַׁבְּחִים וְאוֹמְרִים׃</tei:l>
          <tei:l>בָּר֥וּךְ כְּבוֹד־יהו֖ה מִמְּקוֹמֽוֹ׃<tei:anchor xml:id="note_15"/></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
