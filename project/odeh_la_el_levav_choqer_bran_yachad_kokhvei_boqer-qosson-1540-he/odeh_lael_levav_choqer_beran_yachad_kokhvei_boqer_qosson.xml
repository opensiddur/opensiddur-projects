    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:odeh_lael_levav_choqer_beran_yachad_kokhvei_boqer_qosson">
        <tei:head>אוֹדֶה לָאֵל</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:odeh_lael_levav_choqer_beran_yachad_kokhvei_boqer_qosson/1"/>
        <tei:lg>
          <tei:l>שִׂימוּ לֵב עַל הַנְּשָׁמָה</tei:l>
          <tei:l>לֶשֶׁם שְׁבוֹ וְאַחְלָמָה</tei:l>
          <tei:l>וְאוֹרָהּ כְּאוֹר הַחַמָּה</tei:l>
          <tei:l>שִׁבְעָתַיִם כְּאוֹר בֹּקֶר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:odeh_lael_levav_choqer_beran_yachad_kokhvei_boqer_qosson/2"/>
        <tei:lg>
          <tei:l>אוֹדֶה לָאֵל</tei:l>
          <tei:l>לֵבָב חוֹקֵר</tei:l>
          <tei:l>בְּרָן־יַחַד</tei:l>
          <tei:l>כּוֹכְבֵי בֹקֶר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:odeh_lael_levav_choqer_beran_yachad_kokhvei_boqer_qosson/3"/>
        <tei:lg>
          <tei:l>מִכִּסֵּא כָבוֹד חֻצָּבָה</tei:l>
          <tei:l>לָגוּר בְּאֶרֶץ עֲרָבָה</tei:l>
          <tei:l>לְהַצִילָהּ מִלֶּהָבָה</tei:l>
          <tei:l>וּלְהָאִירָהּ לִפְנוֹת בֹּקֶר</tei:l>
          <tei:l>אוֹדֶה לָאֵל...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:odeh_lael_levav_choqer_beran_yachad_kokhvei_boqer_qosson/4"/>
        <tei:lg>
          <tei:l>עוּרוּ נָא כִּי בְכָל לַיְלָה</tei:l>
          <tei:l>נִשְׁמַתְכֶם עוֹלָה לְמַעְלָה</tei:l>
          <tei:l>לָתֵת דִּין חֶשְׁבּוֹן מִפְעָלָהּ</tei:l>
          <tei:l>לְיוֹצֵר עֶרֶב וָבֹקֶר</tei:l>
          <tei:l>אוֹדֶה לָאֵל...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:odeh_lael_levav_choqer_beran_yachad_kokhvei_boqer_qosson/5"/>
        <tei:lg>
          <tei:l>יִמְצָאוּהָ מְטֻנֶפֶת</tei:l>
          <tei:l>בַּעֲוֹנוֹת וּבְתוֹסֶפֶת</tei:l>
          <tei:l>כְּמוֹ שִׁפְחָה נֶחֱרֶפֶת</tei:l>
          <tei:l>תָּמִיד בַּבֹּקֶר בַּבֹּקֶר</tei:l>
          <tei:l>אוֹדֶה לָאֵל...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:odeh_lael_levav_choqer_beran_yachad_kokhvei_boqer_qosson/6"/>
        <tei:lg>
          <tei:l>ִמְצָאוּהָ מְחֻדֶּשֶׁת [מְקֻדֶשֶׁת] [יִמְצָאָהּ מְקֻשֶׁטֶת]</tei:l>
          <tei:l>בְּזָכִיוֹת וּבְתוֹסֶפֶת [בְּמִצְוֹת וּבְתוֹסֶפֶת/בְּטַלִית וְטוֹטֶפֶת]]</tei:l>
          <tei:l>כְּמוֹ כַלָּה מְקֻשֶׁטֶת</tei:l>
          <tei:l>תָּמִיד בַּבֹּקֶר בַּבֹּקֶר</tei:l>
          <tei:l>אוֹדֶה לָאֵל...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:odeh_lael_levav_choqer_beran_yachad_kokhvei_boqer_qosson/7"/>
        <tei:lg>
          <tei:l>הַנֶּאֱמָן בְּפִקְדוֹנוֹ</tei:l>
          <tei:l>יַחֲזִירֶנָּה לוֹ כִּרְצוֹנוֹ</tei:l>
          <tei:l>אִישׁ לֹא גָוַע בַּעֲוֹנוֹ</tei:l>
          <tei:l>וַיְהִי עֶרֶב וַיְהִי בֹקֶר</tei:l>
          <tei:l>אוֹדֶה לָאֵל...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:odeh_lael_levav_choqer_beran_yachad_kokhvei_boqer_qosson/8"/>
        <tei:lg>
          <tei:l>קוּמוּ כִּי [לֹא] זֹאת הַמְּנוּחָה</tei:l>
          <tei:l>מִדַּת רַחֲמִים מְתוּחָה</tei:l>
          <tei:l>שׁוּבוּ כִּי יָדוֹ פְתוּחָה</tei:l>
          <tei:l>לְכָל מַשְׁכִּימֵי בַבֹּקֶר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:odeh_lael_levav_choqer_beran_yachad_kokhvei_boqer_qosson/9"/>
        <tei:lg>
          <tei:l>וְשֵׁנָה אַל תֶּאֱהָבוּ</tei:l>
          <tei:l>לְהַקְדִישׁ לָאֵל אֱהָבוּ</tei:l>
          <tei:l>הָבוּ לַה׳ הָבוּ</tei:l>
          <tei:l>כָּבוֹד וְהָיָה הַבֹּקֶר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:odeh_lael_levav_choqer_beran_yachad_kokhvei_boqer_qosson/10"/>
        <tei:lg>
          <tei:l>סָלּוּהָ כְּמוֹ עֲרֵמִים [עֲרוּמִים]</tei:l>
          <tei:l>נֶפֶשׁ בְּהֵמוֹת נִרְדָּמִים</tei:l>
          <tei:l>יַעַן לְמִשְׁטַח חֲרָמִים</tei:l>
          <tei:l>לְסֵדֶר עוֹלַת הַבֹּקֶר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:odeh_lael_levav_choqer_beran_yachad_kokhvei_boqer_qosson/11"/>
        <tei:lg>
          <tei:l>וְהַחֲיוּ הָעֲנִיָּה</tei:l>
          <tei:l>יְחִידָה תַמָּה וּנְקִיָּה</tei:l>
          <tei:l>וַאֲשֶר נַפְשׁוֹ לֹא חִיָּה</tei:l>
          <tei:l>אֵיךְ יִזְכֶּה לְאוֹר הַבֹּקֶר</tei:l>
          <tei:l>אוֹדֶה לָאֵל...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:odeh_lael_levav_choqer_beran_yachad_kokhvei_boqer_qosson/12"/>
        <tei:lg>
          <tei:l>נֹעַם ה׳ לַחֲזוֹת</tei:l>
          <tei:l>נִזְכֶּה וּבַשָּׁנָה הַזֹּאת</tei:l>
          <tei:l>בִּשְׂמָחוֹת תַּחַת רְגָזוֹת</tei:l>
          <tei:l>בֹּקֶר תִּשְׁמַע קוֹלִי בֹּקֶר</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
