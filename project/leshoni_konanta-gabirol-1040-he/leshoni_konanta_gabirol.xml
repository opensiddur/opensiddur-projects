  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:leshoni_konanta_gabirol">
        <tei:head>לְשׁוֹנִי כּוֹנַנְתָּ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:leshoni_konanta_gabirol/1"/>
        <tei:lg>
          <tei:l>לְשׁוֹנִי כּוֹנַנְתָּ</tei:l>
          <tei:l>אֱלֹהַי וַתִּבְחַר</tei:l>
          <tei:l>בְּשִׁירִים שֶׁשַּׂמְתָּ</tei:l>
          <tei:l>בְּפִי טוֹב מִמִּסְחַר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:leshoni_konanta_gabirol/2"/>
        <tei:lg>
          <tei:l>וְנֶגְדָּךְ כּוֹנַנְתָּ</tei:l>
          <tei:l>צְעָדַי מִמִּשְׁחַר</tei:l>
          <tei:l>וְלִי גָרוֹן תַּתָּה</tei:l>
          <tei:l>בְּקָרְאִי לֹא נִחַר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:leshoni_konanta_gabirol/3"/>
        <tei:lg>
          <tei:l>וְיִצְרִי הִלְבַּנְתָּ</tei:l>
          <tei:l>כְּמוֹ צֶמֶר צַחַר</tei:l>
          <tei:l>וְלָכֵן לֹא שַׁתָּה</tei:l>
          <tei:l>לְבָבִי בִּי סְחַרְחַר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:leshoni_konanta_gabirol/4"/>
        <tei:lg>
          <tei:l>הֱיֵה סִתְרִי עַתָּה</tei:l>
          <tei:l>כְּאֶתְמוֹל וּכְמָחָר</tei:l>
          <tei:l>וּמָגִנִּי אַתָּה</tei:l>
          <tei:l>אֱלֹהַי אַל תְּאַחַר</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
