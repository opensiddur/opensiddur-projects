  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_prayer_for_travel_creditor">
        <tei:head>A Prayer for Travel, by Rabbi Menachem Creditor</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_travel_creditor/1"/>
        <tei:lg>
          <tei:l><tei:hi rend="italic">Yehi Ratson Milfanekha</tei:hi> –</tei:l>
          <tei:l>May it be Your will, Eternal One, God of our ancestors,</tei:l>
          <tei:l>that we journey toward peace,</tei:l>
          <tei:l>that our footsteps be guided towards peace,</tei:l>
          <tei:l>and that we reach our desired destinations for life, gladness, and peace.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_travel_creditor/2"/>
        <tei:lg>
          <tei:l>May we be protected from every obstacle along the way,</tei:l>
          <tei:l>and from all manner of challenge the world endures.</tei:l>
          <tei:l>May there be blessing in the works of our hands,</tei:l>
          <tei:l>and may we be granted peace, kindness, and mercy</tei:l>
          <tei:l>in the eyes of all who see us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_travel_creditor/3"/>
        <tei:lg>
          <tei:l>May our prayer be heard,</tei:l>
          <tei:l>for You are the One who hears and holds all prayer.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_travel_creditor/4"/>
        <tei:lg>
          <tei:l><tei:hi rend="italic">Barukh atah Adonai, shomei’ah tefilah</tei:hi>.</tei:l>
          <tei:l>Blessed are You, Eternal One, who hears prayer.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
