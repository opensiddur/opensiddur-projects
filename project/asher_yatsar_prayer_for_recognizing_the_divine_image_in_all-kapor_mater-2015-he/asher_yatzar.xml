    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:asher_yatzar">
        <tei:head>אשר יצר</tei:head>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם,</tei:l>
          <tei:l>אֲשֶׁר יָצַר אֶת הָאָדָם בְּחׇכְמָה,</tei:l>
          <tei:l>וּבָרָא בָֽנוּ נְקָבִים נְקָבִים חֲלוּלִים חֲלוּלִים.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>מוֹדוֹת אֲנַֽחְנוּ לָךְ, שֶׁנָּתַֽתָּ בְּכֹּחֵֽנוּ</tei:l>
          <tei:l>לְהַכִּיר בִּקְדֻשָּׁת צֶֽלֶם אֱלֹהִים,</tei:l>
          <tei:l>לְהִתְיַצֵר לְאֹֽרֶךְ יָמֵֽינוּ,</tei:l>
          <tei:l>וּלְהִתְקַיֵּם לְפָנֶֽיךָ.</tei:l>
          <tei:l>מָה רַבּוּ מַעֲשֶֽׂיךָ יְיָ,</tei:l>
          <tei:l>כֻּלָם בְּחׇכְמָה עָשִֽׂיתָ. <tei:bibl>(תהלים קד:כד)</tei:bibl></tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְיָ,</tei:l>
          <tei:l>רוֹפֵא כׇל בָּשָׂר וּמַפְלִיא לַעֲשׂוֹת׃</tei:l>
        </tei:lg>
      </tei:div>
