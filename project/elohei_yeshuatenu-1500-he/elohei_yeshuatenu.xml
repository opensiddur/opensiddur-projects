    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:elohei_yeshuatenu">
        <tei:head>אֱלֹהֵי יְשׁוּעָתֵֽנוּ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohei_yeshuatenu/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אֱ</tei:seg>לֹהֵי יְשׁוּעָתֵֽנוּ</tei:l>
          <tei:l>שְׁעֵה שַׁוְעָתֵֽנוּ</tei:l>
          <tei:l>וּרְאֵה שׁוֹמְמוֹתֵֽינוּ</tei:l>
          <tei:l>וְאֹֽרֶךְ גָּלוּתֵֽנוּ</tei:l>
          <tei:l>מִדֵּי שָׁנָה בְשָׁנָה בְּזׇכְרֵֽנוּ עֱנוּתֵֽנוּ</tei:l>
          <tei:l>בְּיוֹם חֲמִשָּׁה דְבָרִים אֵרְעוּ אֶת־אֲבוֹתֵֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohei_yeshuatenu/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נָ</tei:seg>א אֱלֹהֵי הָרוּחוֹת</tei:l>
          <tei:l>וּבוֹחֵן סִתְרֵי טוּחוֹת</tei:l>
          <tei:l>שְׁעֵה שֵׂיוֹת נִדָּחוֹת</tei:l>
          <tei:l>נְפוּצוֹת בְּאַרְבַּע רוּחוֹת</tei:l>
          <tei:l>מִדֵּי שָׁנָה בְשָׁנָה בִּזְמַן זֶה נֶאֱנָחוֹת</tei:l>
          <tei:l>בְּיוֹם עֵֽקֶב מַדּוּחוֹת</tei:l>
          <tei:l>נִשְׁתַּבְּרוּ הַלּוּחוֹת</tei:l>
          <tei:l>וּבוֹ כׇּל־יְמֵי שְׁנוֹתֵֽינוּ</tei:l>
          <tei:l>נְמָרֵר עַל־יְגוֹנֵֽנוּ</tei:l>
          <tei:l>בְּיוֹם חֲמִשָּׁה דְבָרִים אֵרְעוּ אֶת־אֲבוֹתֵֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohei_yeshuatenu/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">דְּ</tei:seg>לֵה מִטִּיט הַיָּוֵן</tei:l>
          <tei:l>טְבוּעִים בּוֹ וְאֵין מַעֲמִיד</tei:l>
          <tei:l>עֵֽדֶר תַּֽתָּה לְמַאֲכָל לְבִזָּה וּלְהַשְׁמִיד</tei:l>
          <tei:l>מִדֵּי שָׁנָה בְשָׁנָה בְּיוֹם זֶה עֶֽצֶב מַצְמִיד</tei:l>
          <tei:l>יוֹם בּוֹ יַד זָר הֶאֱמִיר</tei:l>
          <tei:l>וּבוֹ בֻּטַּל הַתָּמִיד</tei:l>
          <tei:l>עַל־רֹב עֲוֺנוֹתֵֽינוּ</tei:l>
          <tei:l>וְעֹֽצֶם חַטֹּאתֵֽינוּ</tei:l>
          <tei:l>בְּיוֹם חֲמִשָּׁה דְבָרִים אֵרְעוּ אֶת־אֲבוֹתֵֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohei_yeshuatenu/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>הּ אֲשֶׁר הַכֹּל יוּכַל</tei:l>
          <tei:l>פְּדֵה מִשְּׁכוֹל שָׁכַל</tei:l>
          <tei:l>מִיַּד עִקֵּשׁ וְסָכָל</tei:l>
          <tei:l>וּשְׁאַר יַעֲקֹב אָכַל</tei:l>
          <tei:l>מִדֵּי שָׁנָה בְּשָׁנָה בְּיוֹם זֶה מַמְּרֹר אוֹכַל</tei:l>
          <tei:l>בְּהַעֲמִיד זָר לְמוּלִי בּוֹ צֶֽלֶם בַּהֵיכָל</tei:l>
          <tei:l>עַל־כׇּל־קוֹרוֹתֵֽינוּ</tei:l>
          <tei:l>יִזְּלוּ דִמְעוֹתֵֽינוּ</tei:l>
          <tei:l>בְּיוֹם חֲמִשָּׁה דְבָרִים אֵרְעוּ אֶת־אֲבוֹתֵֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohei_yeshuatenu/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שִׁ</tei:seg>בְרֵֽנוּ מַה נּוֹרָא</tei:l>
          <tei:l>כִּי סַֽרְנוּ מִמּוֹרָא</tei:l>
          <tei:l>נָאוֹר עֹטֶה אוֹרָה</tei:l>
          <tei:l>גְּמוּלִי לַכֹּל הוֹרָה</tei:l>
          <tei:l>מִדֵּי שָׁנָה בְשָׁנָה נֶֽהִי בְּיוֹם זֶה אֶחְקֹֽרָה</tei:l>
          <tei:l>יַֽעַן כִּי בוֹ שָׂרַף אַפּוֹסְטְמוֹס אֶת־הַתּוֹרָה</tei:l>
          <tei:l>לְזֹאת נִשְׁכְּבָה בְּבׇשְׁתֵּֽנוּ</tei:l>
          <tei:l>לְשֹׁד בֵּית תִּפְאַרְתֵּֽנוּ</tei:l>
          <tei:l>בְּיוֹם חֲמִשָּׁה דְבָרִים אֵרְעוּ אֶת־אֲבוֹתֵֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohei_yeshuatenu/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רַ</tei:seg>חוּם יְכַפֵּר עָוֺן</tei:l>
          <tei:l>וְכׇל־חֲמָתוֹ לֹא־יָעִיר</tei:l>
          <tei:l>פְּדֵה חִישׁ מִידֵי שֵׂעִיר</tei:l>
          <tei:l>פְּזוּרֵי הַצֹּאן וְצָעִיר</tei:l>
          <tei:l>מִדֵּי שָׁנָה בְשָׁנָה בְּיוֹם זֶה הֶמְיַת מֵעָיו יַסְעִיר</tei:l>
          <tei:l>יוֹם גָּבְרוּ הַזָּרִים וַתִּבָּקַע הָעִיר</tei:l>
          <tei:l>כִּי הָיִֽינוּ לְלַֽעַג וָקֶֽלֶס לִסְבִיבוֹתֵֽינוּ</tei:l>
          <tei:l>בְּיוֹם חֲמִשָּׁה דְבָרִים אֵרְעוּ אֶת־אֲבוֹתֵֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohei_yeshuatenu/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רַ</tei:seg>חֲמָן בְּרַחֲמִים שֽׁוּבָה</tei:l>
          <tei:l>אֶל־צִיּוֹן הָעֲלוּבָה</tei:l>
          <tei:l>וְחִישׁ־נָא לְאִשָּׁה עֲצוּבָה</tei:l>
          <tei:l>נֶחָמָה הַכְּתוּבָה</tei:l>
          <tei:l>וְאָז־שִׁירָה נָנֽוּבָה</tei:l>
          <tei:l>בִּבְנוֹתְךָ הַחֲרֵבָה</tei:l>
          <tei:l>בְּקִבּוּץ נְפוּצוֹתֵֽינוּ</tei:l>
          <tei:l>וּבְשׁוּבְךָ אֶת־שְׁבוּתֵֽנוּ</tei:l>
          <tei:l>בְּיוֹם חֲמִשָּׁה דְבָרִים אֵרְעוּ אֶת־אֲבוֹתֵֽינוּ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
