  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:blessing_before_the_recitation_of_psalms">
        <tei:head>ברכה לפני קריאת תהלים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_before_the_recitation_of_psalms/1"/>
        <tei:lg>
          <tei:l>בָּר֣וּךְ אַתָּ֑ה</tei:l>
          <tei:l>יְהֹוָ֥ה אֱ֝לֹהֵ֗ינוּ</tei:l>
          <tei:l>מֶ֣לֶךְ הָעוֹלָֽם׃</tei:l>
          <tei:l>אֲשֶׁר־בָּחַ֣ר בְּדָוִ֬ד עַבְדּ֗וֹ</tei:l>
          <tei:l>וְרָצָ֨ה בִּתְהִלָּתוֹ֮ וּבְשִׁירֵ֪י קׇ֫דְשׁ֥וֹ</tei:l>
          <tei:l>לְהַלְּל֣וֹ וּלְשַׁבְּח֣וֹ וּלְפָאֲר֑וֹ</tei:l>
          <tei:l>עַל־רֹ֥ב גְּ֝בוּרֹתָ֗יו</tei:l>
          <tei:l>כׇּל־הַיָּמִֽים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_before_the_recitation_of_psalms/2"/>
        <tei:lg>
          <tei:l>בָּר֨וּךְ אַתָּ֤ה ׀ יְ֘הֹוָ֤ה</tei:l>
          <tei:l>מַצְמִ֬יחַ יְשׁוּעָ֗ה שְׁלֵ֣מָה קְ֭רוֹבָֽה</tei:l>
          <tei:l>לְעַמּ֣וֹ יִשְׂרָאֵ֑ל</tei:l>
          <tei:l>מְנַחֵ֥ם צִ֝יּ֗וֹן</tei:l>
          <tei:l>וּבֹנֶ֥ה יְרוּשָׁלָֽיִם׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
