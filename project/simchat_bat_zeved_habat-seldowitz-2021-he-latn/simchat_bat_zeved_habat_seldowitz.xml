  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:simchat_bat_zeved_habat_seldowitz">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:simchat_bat_zeved_habat_seldowitz/5"/>
        <tei:lg>
          <tei:l>Le’Torah u’le’Ḥupah u’l’Ma’asim Tovim</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:simchat_bat_zeved_habat_seldowitz/8"/>
        <tei:lg>
          <tei:l>Barukh atah</tei:l>
          <tei:l>Adonai Elohenu</tei:l>
          <tei:l>melekh ha’olam</tei:l>
          <tei:l>Ha’gomel l’ḥayavim tovot</tei:l>
          <tei:l>Sheg’malani kol tov</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:simchat_bat_zeved_habat_seldowitz/9"/>
        <tei:lg>
          <tei:l>Amen!</tei:l>
          <tei:l>Mi shegamal’kha tov,</tei:l>
          <tei:l>Hu yig’malekh kol tov, selah!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:simchat_bat_zeved_habat_seldowitz/13"/>
        <tei:lg>
          <tei:l>Barukh atah Adonai</tei:l>
          <tei:l>Elohenu melekh ha’olam</tei:l>
          <tei:l>Ha’tov ve’hamay’teev.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:simchat_bat_zeved_habat_seldowitz/14"/>
        <tei:lg>
          <tei:l>Barukh atah</tei:l>
          <tei:l>Adonai Elohenu</tei:l>
          <tei:l>melekh ha’olam</tei:l>
          <tei:l>sheheḥeyanu veqiymanu</tei:l>
          <tei:l>vehigi’anu lazman<tei:anchor xml:id="note_2"/> hazeh.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" n="2" target="#note_2">
      <tei:p>Others say “lizman” (לִזְּמַן)</tei:p>
    </tei:note>
  </tei:standOff>
