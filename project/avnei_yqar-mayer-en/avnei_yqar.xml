  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:avnei_yqar">
        <tei:head>Avnei Y’qar — a Ḥanukkah piyyuṭ attributed to Rabbi Abraham ibn Ezra</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:avnei_yqar/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">A</tei:seg>s stones of fame,</tei:l>
          <tei:l>upon the fairest hill were breached</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:avnei_yqar/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">B</tei:seg>ad days came,</tei:l>
          <tei:l>we strengthened till requital was reached.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:avnei_yqar/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">R</tei:seg>iding high,</tei:l>
          <tei:l>the day the Greeks pursued,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:avnei_yqar/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">A</tei:seg>nd by the by,</tei:l>
          <tei:l>they kindled lamps, the Palace renewed.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:avnei_yqar/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">H</tei:seg>oneyed success</tei:l>
          <tei:l>brought sweetness to their mind,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:avnei_yqar/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">A</tei:seg>nd so to bless</tei:l>
          <tei:l>the <tei:seg type="acrostic">M</tei:seg>oniker of Glory they assigned.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
