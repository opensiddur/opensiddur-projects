    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:miriam_received_the_torah_from_sinai_safania">
        <tei:head>מִרְיָם קִבְּלָה תּוֹרָה מִסִּינַי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:miriam_received_the_torah_from_sinai_safania/1"/>
        <tei:lg>
          <tei:l>מִרְיָם קִבְּלָה תּוֹרָה מִסִּינַי</tei:l>
          <tei:l>וּמְסָרַתָּהּ לִבְנוֹת צְלָפְחָד</tei:l>
          <tei:l>וּבְנוֹת צְלָפְחָד לִדְבוֹרָה,</tei:l>
          <tei:l>וּדְבוֹרָה לְרוּת,</tei:l>
          <tei:l>וְרוּת מְסָרַתָּהּ לִבְרוּרְיָה</tei:l>
          <tei:l>הֵן אָמְרוּ שְׁלֹשָׁה דְּבָרִים:</tei:l>
          <tei:l>הַשְׁמִיעוּ אֶת קוֹלְכֶן</tei:l>
          <tei:l>וְהַעֲמִידוּ תַּלְמִידוֹת הַרְבֵּה</tei:l>
          <tei:l>וַעֲשׂוּ דְּרָשׁ לַתּוֹרָה.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
