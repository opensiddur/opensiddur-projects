  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/15">
        <tei:head>תהלים ט״ו</tei:head>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>מִזְמ֗וֹר לְדָ֫וִ֥ד</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>יְ֭הֹוָה</tei:l>
          <tei:l>מִי־יָג֣וּר בְּאָהֳלֶ֑ךָ</tei:l>
          <tei:l>מִֽי־יִ֝שְׁכֹּ֗ן</tei:l>
          <tei:l>בְּהַ֣ר קָדְשֶֽׁךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/15/2/a"/>
        <tei:lg>
          <tei:l>הוֹלֵ֣ךְ תָּ֭מִים</tei:l>
          <tei:l>וּפֹעֵ֥ל צֶ֑דֶק</tei:l>
          <tei:l>וְדֹבֵ֥ר אֱ֝מֶ֗ת</tei:l>
          <tei:l>בִּלְבָבֽוֹ׃</tei:l>
          <tei:l>לֹֽא־רָגַ֨ל ׀ עַל־לְשֹׁנ֗וֹ</tei:l>
          <tei:l>לֹא־עָשָׂ֣ה לְרֵעֵ֣הוּ רָעָ֑ה</tei:l>
          <tei:l>וְ֝חֶרְפָּ֗ה לֹא־נָשָׂ֥א עַל־קְרֹֽבוֹ׃</tei:l>
          <tei:l>נִבְזֶ֤ה ׀ בְּֽעֵ֘ינָ֤יו נִמְאָ֗ס</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/15/2/b"/>
        <tei:lg>
          <tei:l>וְאֶת־יִרְאֵ֣י</tei:l>
          <tei:l>יְהוָ֣ה יְכַבֵּ֑ד</tei:l>
          <tei:l>נִשְׁבַּ֥ע</tei:l>
          <tei:l>לְ֝הָרַ֗ע</tei:l>
          <tei:l>וְלֹ֣א יָמִֽר׃</tei:l>
          <tei:l>כַּסְפּ֤וֹ ׀ לֹא־נָתַ֣ן בְּנֶשֶׁךְ֮</tei:l>
          <tei:l>וְשֹׁ֥חַד עַל־נָקִ֗י</tei:l>
          <tei:l>לֹ֥א לָ֫קָ֥ח</tei:l>
          <tei:l>עֹֽשֵׂה־אֵ֑לֶּה</tei:l>
          <tei:l>לֹ֖א יִמּ֣וֹט לְעוֹלָֽם׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
