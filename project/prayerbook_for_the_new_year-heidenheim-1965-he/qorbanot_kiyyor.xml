    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:qorbanot/kiyyor" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n53.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n53.jpg" n="9"/><tei:milestone unit="chapter" n="30"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/30/17" n="17"/>וַיְדַבֵּר <j:divineName>יְהֹוָה</j:divineName> אֶל־מֹשֶׁה לֵּאמֹר: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/30/18" n="18"/>וְעָשִׂיתָ כִּיּוֹר נְחֹשֶׁת וְכַנּוֹ נְחֹשֶׁת לְרָחְצָה וְנָתַתָּ אֹתוֹ בֵּין־אֹהֶל מוֹעֵד וּבֵין הַמִּזְבֵּחַ וְנָתַתָּ שָׁמָּה מָיִם: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/30/19" n="19"/>וְרָחֲצוּ אַהֲרֹן וּבָנָיו מִמֶּנּוּ אֶת־יְדֵיהֶם וְאֶת־רַגְלֵיהֶם: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/30/20" n="20"/>בְּבֹאָם אֶל־אֹהֶל מוֹעֵד יִרְחֲצוּ־מַיִם וְלֹא יָמֻתוּ אוֹ בְגִשְׁתָּם אֶל־הַמִּזְבֵּחַ לְשָׁרֵת לְהַקְטִיר אִשֶּׁה לַ<j:divineName>יהֹוָה</j:divineName>: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/30/21" n="21"/>וְרָחֲצוּ יְדֵיהֶם וְרַגְלֵיהֶם וְלֹא יָמֻתוּ וְהָיְתָה לָהֶם חָק־עוֹלָם לוֹ וּלְזַרְעוֹ לְדֹרֹתָם: <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
