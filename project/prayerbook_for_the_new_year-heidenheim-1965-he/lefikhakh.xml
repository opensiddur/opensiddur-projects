      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/morning_blessings/lefikhakh">
        <tei:div facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n51.jpg">
          <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n51.jpg" n="8"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:lefikhakh"/>לְפִיכָךְ אֲנַחְנוּ חַיָּבִים לְהוֹדוֹת לְךָ וּלְשַׁבֵּחֲךָ וּלְפָאֶרְךָ וּלְבָרֵךְ וּלְקַדֵּשׁ וְלָתֶת־שֶׁבַח וְהוֹדָיָה לִשְׁמֶךָ: אַשְׁרֵינוּ מַה־טּוֹב חֶלְקֵנוּ וּמַה־נָּעִים גּוֹרָלֵנוּ וּמַה־יָּפָה יְרֻשָּׁתֵנוּ <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:lefikhakh/ashreinu"/>אַשְׁרֵינוּ שֶׁאֲנַחְנוּ מַשְׁכִּימִים וּמַעֲרִיבִים עֶרֶב וָבֹקֶר וְאוֹמְרִים פַּעֲמַיִם בְּכָל־יוֹם <tei:milestone unit="prayer-part"/></tei:p>
        </tei:div>
