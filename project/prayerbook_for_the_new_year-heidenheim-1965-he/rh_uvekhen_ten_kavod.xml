      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/minchah_maariv/amidah/uvekhen_ten_kavod">
        <tei:div facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n25.jpg">
          <tei:p><tei:seg source="urn:x-opensiddur:text:prayer:amidah/uvekhen_ten_kavod">וּבְכֵן תֵּן כָּבוֹד <j:divineName>יְיָ</j:divineName> לְעַמֶּךָ תְּהִלָּה לִירֵאֶיךָ וְתִקְוָה לְדוֹרְשֶׁיךָ וּפִתְחוֹן פֶּה לַמְיַחֲלִים לָךְ שִׂמְחָה לְאַרְצֶךָ</tei:seg> <tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n27.jpg" n="17"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/uvekhen_ten_kavod">וְשָׂשׂוֹן לְעִירֶךָ וּצְמִיחַת קֶרֶן לְדָוִד עַבְדֶּךָ וַעֲרִיכַת נֵר לְבֶן־יִשַׁי מְשִׁיחֶךָ בִּמְהֵרָה בְּיָמֵינוּ:</tei:seg> </tei:p>
        </tei:div>
      </tei:div>
