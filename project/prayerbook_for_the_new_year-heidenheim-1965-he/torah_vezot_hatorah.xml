      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vezot_hatorah" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n173.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n173.jpg" n="76"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/vezot_hatorah/text"/><tei:milestone unit="chapter" n="4" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vezot_hatorah/quotations/vezot"/><tei:milestone unit="verse" n="44" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vezot_hatorah/quotations/vezot/44"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/4/44">וְזֹאת הַתּוֹרָה אֲשֶׁר־שָׂם מֹשֶׁה לִפְנֵי בְּנֵי יִשְׂרָאֵל</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>   <tei:milestone unit="chapter" n="9" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vezot_hatorah/quotations/al_pi"/><tei:milestone unit="verse" n="23" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vezot_hatorah/quotations/al_pi/23"/><tei:milestone unit="verse-part" n="al_pi" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vezot_hatorah/quotations/al_pi/23/al_pi"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/9/23/al_pi">עַל־פִּי <j:divineName>יְיָ</j:divineName> בְּיַד־מֹשֶׁה:</tei:seg><tei:milestone unit="verse-part"/><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>   <tei:milestone unit="chapter" n="3" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vezot_hatorah/quotations/etz"/><tei:milestone unit="verse" n="18" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vezot_hatorah/quotations/etz/18"/><tei:seg source="urn:x-opensiddur:text:bible:proverbs/3/18">עֵץ־חַיִּים הִיא לַמַּחֲזִיקִים בָּהּ וְתוֹמְכֶיהָ מְאֻשָּׁר:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>   <tei:milestone unit="chapter" n="3" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vezot_hatorah/quotations/derakheha"/><tei:milestone unit="verse" n="17" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vezot_hatorah/quotations/derakheha/17"/><tei:seg source="urn:x-opensiddur:text:bible:proverbs/3/17">דְּרָכֶיהָ דַרְכֵי־נֹעַם וְכָל־נְתִיבֹתֶיהָ שָׁלוֹם:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>   <tei:milestone unit="chapter" n="3" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vezot_hatorah/quotations/orekh"/><tei:milestone unit="verse" n="16" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vezot_hatorah/quotations/orekh/16"/><tei:seg source="urn:x-opensiddur:text:bible:proverbs/3/16">אֹרֶךְ יָמִים בִּימִינָהּ בִּשְׂמֹאלָהּ עֹשֶׁר וְכָבוֹד:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>   <tei:milestone unit="chapter" n="42" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vezot_hatorah/quotations/chafetz"/><tei:milestone unit="verse" n="21" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vezot_hatorah/quotations/chafetz/21"/><tei:seg source="urn:x-opensiddur:text:bible:isaiah/42/21"><j:divineName>יְיָ</j:divineName> חָפֵץ לְמַעַן צִדְקוֹ יַגְדִּיל תּוֹרָה וְיַאְדִּיר:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
