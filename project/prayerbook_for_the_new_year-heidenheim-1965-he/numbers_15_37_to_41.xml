  <tei:text>
    <tei:body>
      <tei:div facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n19.jpg">
        <tei:p><tei:milestone unit="chapter" n="15"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/15/37" n="37"/>וַֽיֹּ֥אמֶר <j:divineName>יְהוָ֖ה</j:divineName> אֶל־מֹשֶׁ֥ה לֵּאמֹֽר: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/15/38" n="38"/>דַּבֵּ֞ר אֶל־בְּנֵ֤י יִשְׂרָאֵל֙ וְאָמַרְתָּ֣ אֲלֵהֶ֔ם וְעָשׂ֨וּ לָהֶ֥ם צִיצִ֛ת עַל־כַּנְפֵ֥י בִגְדֵיהֶ֖ם לְדֹרֹתָ֑ם וְנָֽתְנ֛וּ עַל־צִיצִ֥ת הַכָּנָ֖ף פְּתִ֥יל תְּכֵֽלֶת: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/15/39" n="39"/>וְהָיָ֣ה לָכֶם֮ לְצִיצִת֒ וּרְאִיתֶ֣ם אֹת֗וֹ וּזְכַרְתֶּם֙ אֶת־כָּל־מִצְוֹ֣ת <j:divineName>יְהוָ֔ה</j:divineName> וַֽעֲשִׂיתֶ֖ם אֹתָ֑ם <tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n21.jpg" n="14"/>וְלֹא תָת֜וּרוּ אַחֲרֵ֤י לְבַבְכֶם֙ וְאַחֲרֵ֣י עֵינֵיכֶ֔ם אֲשֶׁר־אַתֶּ֥ם זֹנִ֖ים אַחֲרֵיהֶֽם: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/15/40" n="40"/>לְמַ֣עַן תִּזְכְּר֔וּ וַֽעֲשִׂיתֶ֖ם אֶת־כָּל־מִצְוֹתָ֑י וִהְיִיתֶ֥ם קְדֹשִׁ֖ים לֵאלֹהֵיכֶֽם: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/15/41" n="41"/>אֲנִ֞י <j:divineName>יְהוָ֣ה</j:divineName> אֱלֹהֵיכֶ֗ם אֲשֶׁ֨ר הוֹצֵ֤אתִי אֶתְכֶם֙ מֵאֶ֣רֶץ מִצְרַ֔יִם לִהְי֥וֹת לָכֶ֖ם לֵאלֹהִ֑ים אֲנִ֖י <j:divineName>יְהוָ֥ה</j:divineName> אֱלֹהֵיכֶֽם: <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
