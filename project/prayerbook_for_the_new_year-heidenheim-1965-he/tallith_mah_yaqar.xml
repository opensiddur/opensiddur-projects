    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:tallith/mah_yaqar" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n38.jpg">
        <tei:lg>
          <tei:l><tei:milestone unit="chapter" n="36"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/36/8" n="8"/>מַה־יָּקָר חַסְדְּךָ אֱלֹהִים וּבְנֵי אָדָם בְּצֵל כְּנָפֶיךָ יֶחֱסָיוּן: </tei:l>
          <tei:l><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/36/9" n="9"/>יִרְוְיֻן מִדֶּשֶׁן בֵּיתֶךָ וְנַחַל עֲדָנֶיךָ תַשְׁקֵם: </tei:l>
          <tei:l><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/36/10" n="10"/>כִּי עִמְּךָ מְקוֹר חַיִּים, בְּאוֹרְךָ נִרְאֶה־אוֹר: </tei:l>
          <tei:l><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/36/11" n="11"/>מְשֹׁךְ חַסְדְּךָ לְיֹדְעֶיךָ וְצִדְקָתְךָ לְיִשְׁרֵי־לֵב: <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
