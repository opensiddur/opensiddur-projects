    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/uvenuchoh" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n195.jpg">
        <tei:note type="description" xml:lang="en">When the scroll of the Torah is returned to the Holy Ark:</tei:note>
        <tei:p><tei:milestone unit="chapter" n="10" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/numbers_10"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/numbers_10/36" n="36"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/10/36">וּבְנֻחֹה יֹאמַר שׁוּבָה <j:divineName>יְיָ</j:divineName> רִבְבוֹת אַלְפֵי יִשְׂרָאֵל:</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="chapter" n="132" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/psalms_132"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/psalms_132/8" n="8"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/132/8">קוּמָה <j:divineName>יְיָ</j:divineName> לִמְנוּחָתֶךָ אַתָּה וַאֲרוֹן עֻזֶּךָ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/psalms_132/9" n="9"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/132/9">כֹּהֲנֶיךָ יִלְבְּשׁוּ־צֶדֶק וַחֲסִידֶיךָ יְרַנֵּנוּ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/psalms_132/10" n="10"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/132/10">בַּעֲבוּר דָּוִד עַבְדֶּךָ אַל־תָּשֵׁב פְּנֵי מְשִׁיחֶךָ:</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="chapter" n="4" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/proverbs_4"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/proverbs_4/2" n="2"/><tei:seg source="urn:x-opensiddur:text:bible:proverbs/4/2">כִּי לֶקַח טוֹב נָתַתִּי לָכֶם תּוֹרָתִי אַל־תַּעֲזֹבוּ:</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="chapter" n="3" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/proverbs_3"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/proverbs_3/18" n="18"/><tei:seg source="urn:x-opensiddur:text:bible:proverbs/3/18">עֵץ חַיִּים הִיא לַמַּחֲזִיקִים בָּהּ וְתֹמְכֶיהָ מְאֻשָּׁר:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/proverbs_3/17" n="17"/><tei:seg source="urn:x-opensiddur:text:bible:proverbs/3/17">דְּרָכֶיהָ דַרְכֵי־נֹעַם וְכָל־נְתִיבוֹתֶיהָ שָׁלוֹם:</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="chapter" n="5" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/lamentations_5"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/lamentations_5/21" n="21"/><tei:seg source="urn:x-opensiddur:text:bible:lamentations/5/21">הֲשִׁיבֵנוּ <j:divineName>יְיָ</j:divineName> אֵלֶיךָ וְנָשׁוּבָה חַדֵּשׁ יָמֵינוּ כְּקֶדֶם:</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
