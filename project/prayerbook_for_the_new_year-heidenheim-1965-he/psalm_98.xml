  <tei:text>
    <tei:body>
      <tei:div facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n14.jpg">
        <tei:p><tei:milestone unit="chapter" n="98" corresp="urn:x-opensiddur:text:bible:psalms/98"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/98/1" n="1"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note>מִזְמוֹר שִׁירוּ לַ<j:divineName>ייָ</j:divineName> שִׁיר חָדָשׁ כִּי־נִפְלָאוֹת עָשָׂה הוֹשִׁיעָה־לּוֹ יְמִינוֹ וּזְרוֹעַ קָדְשׁוֹ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/98/2" n="2"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note>הוֹדִיעַ <j:divineName>יְיָ</j:divineName> יְשׁוּעָתוֹ לְעֵינֵי הַגּוֹיִם גִּלָּה צִדְקָתוֹ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/98/3" n="3"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note>זָכַר חַסְדּוֹ וֶאֱמוּנָתוֹ לְבֵית יִשְׂרָאֵל רָאוּ כָל־אַפְסֵי־אָרֶץ אֵת יְשׁוּעַת אֱלֹהֵינוּ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/98/4" n="4"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note>הָרִיעוּ לַ<j:divineName>ייָ</j:divineName> כָּל־הָאָרֶץ פִּצְחוּ וְרַנְּנוּ וְזַמֵּרוּ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/98/5" n="5"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note>זַמְּרוּ לַ<j:divineName>ייָ</j:divineName> בְּכִנּוֹר בְּכִנּוֹר וְקוֹל זִמְרָה: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/98/6" n="6"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note>בַּחֲצֹצְרוֹת וְקוֹל שׁוֹפָר הָרִיעוּ לִפְנֵי הַמֶּלֶךְ <j:divineName>יְיָ</j:divineName>: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/98/7" n="7"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note>יִרְעַם הַיָּם וּמְלֹאוֹ תֵּבֵל וְיֹשְׁבֵי בָהּ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/98/8" n="8"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note>נְהָרוֹת יִמְחֲאוּ־כָף יַחַד הָרִים יְרַנֵּנוּ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/98/9" n="9"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>קו״ח</tei:abbr><tei:expan>קהל וחזן</tei:expan></tei:choice></tei:note>לִפְנֵי <j:divineName>יְיָ</j:divineName> כִּי בָא לִשְׁפֹּט הָאָרֶץ יִשְׁפֹּט־תֵּבֵל בְּצֶדֶק וְעַמִּים בְּמֵישָׁרִים: <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
