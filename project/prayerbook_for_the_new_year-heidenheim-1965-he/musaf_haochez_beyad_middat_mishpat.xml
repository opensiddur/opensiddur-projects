    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n247.jpg">
        <tei:note type="description" xml:lang="he">ע״ס א״ב כפול.</tei:note>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/haochez"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he">חזן.</tei:note> הָאוֹחֵז בְּיַד מִדַּת מִשְׁפָּט:<tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he">קהל.</tei:note>  וְכֹל מַאֲמִינִים שֶׁהוּא אֵל אֱמוּנָה: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/habochen"/>הַבּוֹחֵן וּבוֹדֵק גִּנְזֵי נִסְתָּרוֹת: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא בּוֹחֵן כְּלָיוֹת: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hagoel"/>הַגּוֹאֵל מִמָּוֶת וּפוֹדֶה מִשַּׁחַת: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא גּוֹאֵל חָזָק: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hadan"/>הַדָּן יְחִידִי לְבָאֵי עוֹלָם: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא דַּיַּן אֱמֶת: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hehagui"/>הֶהָגוּי בְּ<tei:seg source="urn:x-opensiddur:text:bible:exodus/3/14" type="quotation"><tei:milestone unit="chapter" n="3" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hehagui/quotations/quoted_exodus_3_14"/><tei:milestone unit="verse" n="14" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hehagui/quotations/quoted_exodus_3_14/14"/>אֶהְיֶה אֲשֶׁר אֶהְיֶה<tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:seg>: <tei:choice><tei:abbr>וְמַ״</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהָיָה  <j:conditional type="marked" xml:id="musaf_haochez_beyad_middat_mishpat_segment_10"><j:all><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:poem:haochez_beyad_middat_mishpat/hehagui/vehoveh"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional>וְהֹוֶה<j:endConditional target="#musaf_haochez_beyad_middat_mishpat_segment_10"/> וְיִהְיֶה: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/havaddai"/>הַוַּדַּי שְׁמוֹ כֵּן תְּהִלָּתוֹ: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא וְאֵין בִּלְתּוֹ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hazokher"/>הַזּוֹכֵר לְמַזְכִּירָיו טוֹבוֹת זִכְרוֹנוֹת: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא זוֹכֵר הַבְּרִית: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hachotekh"/>הַחוֹתֵךְ חַיִּים לְכָל־חָי: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא חַי וְקַיָּם: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hatov"/>הַטּוֹב וּמֵטִיב לָרָעִים וְלַטּוֹבִים: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא טוֹב לַכֹּל: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hayodea"/>הַיּוֹדֵעַ יֵצֶר כָּל יְצוּרִים: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא יוֹצְרָם בַּבָּטֶן: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hakol"/>הַכֹּל יוֹכָל וְכֹלֲלָם יַחַד: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא כֹּל יוֹכָל: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/halan"/>הַלָּן בְּסֵתֶר בְּצֵל, שַׁדַּי: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא לְבַדּוֹ הוּא: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hamamlikh"/>הַמַּמְלִיךְ מְלָכִים וְלוֹ הַמְּלוּכָה: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא מֶלֶךְ עוֹלָם: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hanoheg"/>הַנּוֹהֵג בְּחַסְדּוֹ כָּל־דּוֹר: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא נוֹצֵר חֶסֶד: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hasovel"/>הַסּוֹבֵל וּמַעֲלִים עַיִן מִסּוֹרֲרִים: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא סוֹלֵחַ סֶלָה: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/haelyon"/>הָעֶלְיוֹן, וְעֵינוֹ אֶל יְרֵאָיו: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא עוֹנֶה לָחַשׁ: </tei:p>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n249.jpg" n="115"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hapoteach"/>הַפּוֹתֵחַ פִּתְחוֹ לְדוֹפְקֵי בִּתְשׁוּבָה: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא פְּתוּחָה יָדוֹ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hatzofeh"/>הַצּוֹפֶה לָרָשָׁע וְחָפֵץ בְּהִצַּדְקוֹ: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא צַדִּיק וְיָשָׁר: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/haqetzar"/>הַקְּצַר בְּזַֽעַם וּמַאֲרִיךְ אַף: <tei:choice><tei:abbr>וְ״מ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא קָשֶׁה לִכְעוֹס: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/harachum"/>הָרַחוּם, וּמַקְדִּים רַחֲמִים לְרֹגֶז: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> <tei:choice><tei:sic>שֶׁחוּא</tei:sic><tei:corr>שֶׁהוּא</tei:corr></tei:choice> רַךְ לִרְצוֹת: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hashaveh"/>הַשָּׁוֶה, וּמַשְׁוֶה קָטוֹן וְגָדוֹל: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא שׁוֹפֵט צֶדֶק: <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hatam"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>קו״ח</tei:abbr><tei:expan>קהל וחזן</tei:expan></tei:choice></tei:note> הַתָּם וּמִתַּמֵּם עִם תְּמִימִים: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא תָּמִים פָּעֳלוֹ: <tei:milestone unit="stanza"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>
