    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n159.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n159.jpg" n="69"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/yitgaddal"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he">חזן</tei:note> <tei:seg source="urn:x-opensiddur:text:prayer:kaddish/yitgaddal">יִתְגַּדַּל וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא בְּעָלְמָא דִּי־בְרָא כִרְעוּתֵהּ וְיַמְלִיךְ מַלְכוּתֵהּ בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן וּבְחַיֵּי דְכָל־בֵּית־יִשְׂרָאֵל בַּעֲגָלָא וּבִזְמַן קָרִיב וְאִמְרוּ אָמֵן.</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/yehe_shemeh"/><tei:seg source="urn:x-opensiddur:text:prayer:kaddish/yehe_shemeh">יְהֵא שְׁמֵהּ רַבָּא מְבָרַךְ לְעָלַם וּלְעָלְמֵי עָלְמַיָּא.</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/yitbarakh"/><tei:seg source="urn:x-opensiddur:text:prayer:kaddish/yitbarakh">יִתְבָּרַךְ וְיִשְׁתַּבַּח וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְנַשֵּׂא וְיִתְהַדָּר וְיִתְעַלֶּה וְיִתְהַלָּל שְׁמֵהּ דְּקֻדְשָׁא בְּרִיךְ הוּא לְעֵלָּא וּלְעֵלָּא מִכָּל־בִּרְכָתָא וְשִׁירָתָא תֻּשְׁבְּחָתָא וְנֶחֱמָתָא דַּאֲמִירָן בְּעָלְמָא. וְאִמְרוּ אָמֵן:</tei:seg> <tei:milestone unit="prayer-part"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/response_1"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> קַבֵּל בְּרַחֲמִים וּבְרָצוֹן אֶת־תְּפִלָּתֵנוּ: <tei:milestone unit="prayer-part"/></tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/titqabbal_text"/><tei:seg source="urn:x-opensiddur:text:prayer:kaddish/titqabbal/text">תִּתְקַבַּל צְלוֹתְהוֹן וּבָעוּתְהוֹן דְּכָל־יִשְׂרָאֵל קֳדָם אֲבוּהוֹן דִּי בִשְׁמַיָּא וְאִמְרוּ אָמֵן:</tei:seg> <tei:milestone unit="prayer-part"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/response_2"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> <tei:milestone unit="chapter" n="113" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/quotations/response_psalms_113"/><tei:milestone unit="verse" n="2" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/quotations/response_psalms_113/2"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/113/2">יְהִי שֵׁם <j:divineName>יְיָ</j:divineName> מְבֹרָךְ מֵעַתָּה וְעַד עוֹלָם:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/yatom_yehe_shelama"/><tei:seg source="urn:x-opensiddur:text:prayer:kaddish/yatom/yehe_shelama">יְהֵא שְׁלָמָא רַבָּא מִן־שְׁמַיָּא וְחַיִּים עָלֵינוּ וְעַל־כָּל־יִשְׂרָאֵל וְאִמְרוּ אָמֵן:</tei:seg> <tei:milestone unit="prayer-part"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/response_3"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> <tei:milestone unit="chapter" n="121" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/quotations/response_psalms_121"/><tei:milestone unit="verse" n="2" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/quotations/response_psalms_121/2"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/121/2">עֶזְרִי מֵעִם <j:divineName>יְיָ</j:divineName> עֹשֵׂה שָׁמַיִם וָאָרֶץ:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/yatom_oseh_shalom"/><tei:seg source="urn:x-opensiddur:text:prayer:kaddish/yatom/oseh_shalom">עֹשֶׂה שָׁלוֹם בִּמְרוֹמָיו הוּא יַעֲשֶׂה שָׁלוֹם עָלֵינוּ וְעַל־כָּל־יִשְׂרָאֵל וְאִמְרוּ אָמֵן:</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
