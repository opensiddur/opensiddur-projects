      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/morning_barekhu" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n95.jpg">
