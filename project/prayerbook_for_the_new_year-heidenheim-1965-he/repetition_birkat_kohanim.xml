        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n154.jpg" n="66"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/birkat_kohanim/birkat_kohanim"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/birkat_kohanim_leshatz">אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ בָּרְכֵנוּ בַבְּרָכָה הַמְשֻׁלֶּשֶׁת בַּתּוֹרָה הַכְּתוּבָה עַל יְדֵי מֹשֶׁה עַבְדֶּךָ הָאֲמוּרָה מִפִּי אַהֲרֹן וּבָנָיו כֹּהֲנִים עַם קְדוֹשֶׁךָ כָּאָמוּר: </tei:seg> <tei:milestone unit="chapter" n="6" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/birkat_kohanim/quotations/numbers_6_24"/><tei:milestone unit="verse" n="24" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/birkat_kohanim/quotations/numbers_6_24/24"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/6/24">יְבָרֶכְךָ <j:divineName>יְיָ</j:divineName> וְיִשְׁמְרֶךָ:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:seg source="urn:x-opensiddur:text:prayer:amidah/birkat_kohanim_leshatz"> </tei:seg> <tei:milestone unit="chapter" n="6" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/birkat_kohanim/quotations/numbers_6_25"/><tei:milestone unit="verse" n="25" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/birkat_kohanim/quotations/numbers_6_25/25"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/6/25">יָאֵר <j:divineName>יְיָ</j:divineName> פָּנָיו אֵלֶיךָ וִיחֻנֶּךָ:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:seg source="urn:x-opensiddur:text:prayer:amidah/birkat_kohanim_leshatz"> </tei:seg> <tei:milestone unit="chapter" n="6" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/birkat_kohanim/quotations/numbers_6_26"/><tei:milestone unit="verse" n="26" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/birkat_kohanim/quotations/numbers_6_26/26"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/6/26">יִשָּׂא <j:divineName>יְיָ</j:divineName> פָּנָיו אֵלֶיךָ וְיָשֵׂם לְךָ שָׁלוֹם:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
