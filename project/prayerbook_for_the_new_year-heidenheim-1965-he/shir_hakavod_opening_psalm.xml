    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:hosafot/shir_hakavod/opening_psalm">
        <tei:div facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n343.jpg">
          <tei:p>
            <tei:milestone unit="chapter" n="24" corresp="urn:x-opensiddur:text:siddur:hosafot/shir_hakavod/opening_psalm/quotation/psalms/24"/>
            <tei:milestone unit="verse" n="7" corresp="urn:x-opensiddur:text:siddur:hosafot/shir_hakavod/opening_psalm/quotation/psalms/24/7"/>
            <tei:seg source="urn:x-opensiddur:text:bible:psalms/24/7" type="quotation">שְׂאוּ שְׁעָרִים רָאשֵׁיכֶם וְהִנָּשְׂאוּ פִּתְחֵי עוֹלָם. וְיָבוֹא מֶֽלֶךְ הַכָּבוֹד:</tei:seg>
            <tei:milestone unit="verse"/>
          </tei:p>
          <tei:p>
            <tei:milestone unit="verse" n="8" corresp="urn:x-opensiddur:text:siddur:hosafot/shir_hakavod/opening_psalm/quotation/psalms/24/8"/>
            <tei:seg source="urn:x-opensiddur:text:bible:psalms/24/8" type="quotation">מִי זֶה מֶֽלֶךְ הַכָּבוֹד. <j:divineName>יְיָ</j:divineName> עִזּוּז וְגִבּוֹר <j:divineName>יְיָ</j:divineName> גִּבּוֹר מִלְחָמָה:</tei:seg>
            <tei:milestone unit="verse"/>
          </tei:p>
          <tei:p>
            <tei:milestone unit="verse" n="9" corresp="urn:x-opensiddur:text:siddur:hosafot/shir_hakavod/opening_psalm/quotation/psalms/24/9"/>
            <tei:seg source="urn:x-opensiddur:text:bible:psalms/24/9" type="quotation">שְׂאוּ שְׁעָרִים רָאשֵׁיכֶם וּשְׂאוּ פִּתְחֵי עוֹלָם. וְיָבֹא מֶֽלֶךְ הַכָּבוֹד:</tei:seg>
            <tei:milestone unit="verse"/>
          </tei:p>
          <tei:p>
            <tei:milestone unit="verse" n="10" corresp="urn:x-opensiddur:text:siddur:hosafot/shir_hakavod/opening_psalm/quotation/psalms/24/10"/>
            <tei:seg source="urn:x-opensiddur:text:bible:psalms/24/10" type="quotation">מִי הוּא זֶה מֶֽלֶךְ הַכָּבוֹד. <j:divineName>יְיָ</j:divineName> צְבָאוֹת הוּא מֶֽלֶךְ הַכָּבוֹד סֶֽלָה:</tei:seg>
            <tei:milestone unit="verse"/>
            <tei:milestone unit="chapter"/>
          </tei:p>
        </tei:div>
