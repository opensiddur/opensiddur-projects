      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/conclusion/psalm_81" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n321.jpg">
        <tei:p><tei:milestone unit="chapter" n="81" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/conclusion/psalm_81/quotation/psalms/81"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/conclusion/psalm_81/quotation/psalms/81/1" n="1"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/81/1">לַמְנַצֵּחַ עַל־הַגִּתִּית לְאָסָף:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/conclusion/psalm_81/quotation/psalms/81/2" n="2"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/81/2">הַרְנִֽינוּ לֵאלֹהִים עוּזֵּֽנוּ הָרִֽיעוּ לֵאלֹהֵי יַעֲקֹב:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/conclusion/psalm_81/quotation/psalms/81/3" n="3"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/81/3">שְׂאוּ־זִמְרָה וּתְנוּ־תֹף כִּנּוֹר נָעִים עִם־נָֽבֶל:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/conclusion/psalm_81/quotation/psalms/81/4" n="4"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/81/4">תִּקְעוּ בַחֹֽדֶשׁ שׁוֹפָר בַּכֶּֽסֶה לְיוֹם חַגֵּֽנוּ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/conclusion/psalm_81/quotation/psalms/81/5" n="5"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/81/5">כִּי חֹק לְיִשְׂרָאֵל הוּא מִשְׁפָּט לֵאלֹהֵי יַעֲקֹב:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/conclusion/psalm_81/quotation/psalms/81/6" n="6"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/81/6">עֵדוּת בִּיהוֹסֵף שָׂמוֹ בְּצֵאתוֹ עַל־אֶֽרֶץ מִצְרָֽיִם שְׂפַת לֹא־יָדַֽעְתִּי אֶשְׁמָע:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/conclusion/psalm_81/quotation/psalms/81/7" n="7"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/81/7">הֲסִירוֹתִי מִסֵּֽבֶל שִׁכְמוֹ כַּפָּיו מִדּוּד תַּעֲבֹֽרְנָה:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/conclusion/psalm_81/quotation/psalms/81/8" n="8"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/81/8">בַּצָּרָה קָרָֽאתָ וָאֲחַלְּצֶֽךָּ אֶעֶנְךָ בְּסֵֽתֶר רַֽעַם אֶבְחָנְךָ עַל־מֵי מְרִיבָה סֶֽלָה:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/conclusion/psalm_81/quotation/psalms/81/9" n="9"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/81/9">שְׁמַע עַמִּי וְאָעִֽידָה בָּךְ יִשְׂרָאֵל אִם־תִּשְׁמַע־לִי:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/conclusion/psalm_81/quotation/psalms/81/10" n="10"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/81/10">לֹא־יִהְיֶה בְךָ אֵל זָר וְלֹא תִשְׁתַּחֲוֶה לְאֵל נֵכָר:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/conclusion/psalm_81/quotation/psalms/81/11" n="11"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/81/11">אָנֹכִי <j:divineName>יְהוָֹה</j:divineName> אֱלֹהֶֽיךָ הַמַּעַלְךָ מֵאֶֽרֶץ מִצְרָֽיִם הַרְחֶב־פִּיךָ וַאֲמַלְאֵֽהוּ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/conclusion/psalm_81/quotation/psalms/81/12" n="12"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/81/12">וְלֹא־שָׁמַע עַמִּי לְקוֹלִי וְיִשְׂרָאֵל לֹא־אָבָה לִי:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/conclusion/psalm_81/quotation/psalms/81/13" n="13"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/81/13">וָאֲשַׁלְּחֵהוּ בִּשְׁרִירוּת לִבָּם יֵלְכוּ בְּמוֹעֲצוֹתֵיהֶם:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/conclusion/psalm_81/quotation/psalms/81/14" n="14"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/81/14">לוּ עַמִּי שֹׁמֵֽעַ לִי יִשְׂרָאֵל בִּדְרָכַי יְהַלֵּֽכוּ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/conclusion/psalm_81/quotation/psalms/81/15" n="15"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/81/15">כִּמְעַט אוֹיְבֵיהֶם אַכְנִֽיעַ וְעַל־צָרֵיהֶם אָשִׁיב יָדִי:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/conclusion/psalm_81/quotation/psalms/81/16" n="16"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/81/16">מְשַׂנְאֵי <j:divineName>יְהוָֹה</j:divineName> יְכַחֲשׁוּ־לוֹ וִיהִי עִתָּם לְעוֹלָם:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/conclusion/psalm_81/quotation/psalms/81/17" n="17"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/81/17">וַיַּאֲכִילֵֽהוּ מֵחֵֽלֶב חִטָּה וּמִצּוּר דְּבַשׁ אַשְׂבִּיעֶֽךָ:</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
