  <tei:text>
    <tei:body>
      <tei:div facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n16.jpg">
        <tei:p><tei:milestone unit="chapter" n="92" corresp="urn:x-opensiddur:text:bible:psalms/92"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/1" n="1"/>מִזְמוֹר שִׁיר לְיוֹם הַשַּׁבָּת: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/2" n="2"/>טוֹב לְהֹדוֹת לַ<j:divineName>יהֹוָה</j:divineName> וּלְזַמֵּר לְשִׁמְךָ עֶלְיוֹן: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/3" n="3"/>לְהַגִּיד בַּבֹּקֶר חַסְדֶּךָ וֶאֱמוּנָתְךָ בַּלֵּילוֹת: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/4" n="4"/>עֲלֵי־עָשׂוֹר וַעֲלֵי־נָבֶל עֲלֵי הִגָּיוֹן בְּכִנּוֹר: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/5" n="5"/>כִּי שִׂמַּחְתַּנִי <j:divineName>יְהֹוָה</j:divineName> בְּפָעֳלֶךָ בְּמַעֲשֵׂי יָדֶיךָ אֲרַנֵּן: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/6" n="6"/>מַה־גָּדְלוּ מַעֲשֶׂיךָ <j:divineName>יְהֹוָה</j:divineName> מְאֹד עָמְקוּ מַחְשְׁבֹתֶיךָ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/7" n="7"/>אִישׁ בַּעַר לֹא יֵדָע וּכְסִיל לֹא־יָבִין אֶת־זֹאת: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/8" n="8"/>בִּפְרֹחַ רְשָׁעִים כְּמוֹ עֵשֶׂב וַיָּצִיצוּ כָּל־פֹּעֲלֵי אָוֶן לְהִשָּׁמְדָם עֲדֵי־עַד: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/9" n="9"/>וְאַתָּה מָרוֹם לְעֹלָם <j:divineName>יְהֹוָה</j:divineName>: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/10" n="10"/>כִּי הִנֵּה אֹיְבֶיךָ <j:divineName>יְהֹוָה</j:divineName> כִּי־הִנֵּה אֹיְבֶיךָ יֹאבֵדוּ יִתְפָּרְדוּ כָּל־פֹּעֲלֵי אָוֶן: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/11" n="11"/>וַתָּרֶם כִּרְאֵים קַרְנִי בַּלֹּתִי בְּשֶׁמֶן רַעֲנָן: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/12" n="12"/>וַתַּבֵּט עֵינִי בְּשׁוּרָי בַּקָּמִים עָלַי מְרֵעִים תִּשְׁמַעְנָה אָזְנָי: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/13" n="13"/>צַדִּיק כַּתָּמָר יִפְרָח כְּאֶרֶז בַּלְּבָנוֹן יִשְׂגֶּה: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/14" n="14"/>שְׁתוּלִים בְּבֵית <j:divineName>יְהֹוָה</j:divineName> בְּחַצְרוֹת אֱלֹהֵינוּ יַפְרִיחוּ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/15" n="15"/>עוֹד יְנוּבוּן בְּשֵׂיבָה דְּשֵׁנִים וְרַעֲנַנִּים יִהְיוּ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/16" n="16"/>לְהַגִּיד כִּי־יָשָׁר <j:divineName>יְהֹוָה</j:divineName> צוּרִי וְלֹא־עַוְלָתָה בּוֹ: <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
