    <tei:body>
      <tei:div facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n16.jpg">
        <tei:p><tei:milestone unit="chapter" n="92" corresp="urn:x-opensiddur:text:bible:psalms/92"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/1" n="1"/>מִזְמוֹר שִׁיר לְיוֹם הַשַּׁבָּת: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/2" n="2"/><tei:choice><j:option corresp="urn:x-opensiddur:condition:bible:psalms/92/2/heidenheim_1965_opening">טוֹב לְהֹדוֹת לַ<j:divineName>יהֹוָה</j:divineName> וּלְזַמֵּר לְשִׁמְךָ עֶלְיוֹן:</j:option><j:option corresp="urn:x-opensiddur:condition:bible:psalms/92/2/heidenheim_1965_daily_appendix">טוֹב לְהֹדוֹת לַ<j:divineName>ייָ</j:divineName>. וּלְזַמֵּר לְשִׁמְךָ עֶלְיוֹן:</j:option></tei:choice> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/3" n="3"/><tei:choice><j:option corresp="urn:x-opensiddur:condition:bible:psalms/92/3/heidenheim_1965_opening">לְהַגִּיד בַּבֹּקֶר חַסְדֶּךָ וֶאֱמוּנָתְךָ בַּלֵּילוֹת:</j:option><j:option corresp="urn:x-opensiddur:condition:bible:psalms/92/3/heidenheim_1965_daily_appendix">לְהַגִּיד בַּבֹּֽקֶר חַסְדֶּֽךָ. וֶאֱמוּנָתְךָ בַּלֵּילוֹת:</j:option></tei:choice> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/4" n="4"/><tei:choice><j:option corresp="urn:x-opensiddur:condition:bible:psalms/92/4/heidenheim_1965_opening">עֲלֵי־עָשׂוֹר וַעֲלֵי־נָבֶל עֲלֵי הִגָּיוֹן בְּכִנּוֹר:</j:option><j:option corresp="urn:x-opensiddur:condition:bible:psalms/92/4/heidenheim_1965_daily_appendix">עֲלֵי־עָשׂוֹר וַעֲלֵי־נָֽבֶל. עֲלֵי הִגָּיוֹן בְּכִנּוֹר:</j:option></tei:choice> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/5" n="5"/><tei:choice><j:option corresp="urn:x-opensiddur:condition:bible:psalms/92/5/heidenheim_1965_opening">כִּי שִׂמַּחְתַּנִי <j:divineName>יְהֹוָה</j:divineName> בְּפָעֳלֶךָ בְּמַעֲשֵׂי יָדֶיךָ אֲרַנֵּן:</j:option><j:option corresp="urn:x-opensiddur:condition:bible:psalms/92/5/heidenheim_1965_daily_appendix">כִּי שִׂמַּחְתַּֽנִי <j:divineName>יְיָ</j:divineName> בְּפָעֳלֶֽךָ. בְּמַעֲשֵׂי יָדֶֽיךָ אֲרַנֵּן:</j:option></tei:choice> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/6" n="6"/><tei:choice><j:option corresp="urn:x-opensiddur:condition:bible:psalms/92/6/heidenheim_1965_opening">מַה־גָּדְלוּ מַעֲשֶׂיךָ <j:divineName>יְהֹוָה</j:divineName> מְאֹד עָמְקוּ מַחְשְׁבֹתֶיךָ:</j:option><j:option corresp="urn:x-opensiddur:condition:bible:psalms/92/6/heidenheim_1965_daily_appendix">מַה־גָּדְלוּ מַעֲשֶֽׂיךָ <j:divineName>יְיָ</j:divineName>. מְאֹד עָמְקוּ מַחְשְׁבֹתֶֽיךָ:</j:option></tei:choice> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/7" n="7"/><tei:choice><j:option corresp="urn:x-opensiddur:condition:bible:psalms/92/7/heidenheim_1965_opening">אִישׁ בַּעַר לֹא יֵדָע וּכְסִיל לֹא־יָבִין אֶת־זֹאת:</j:option><j:option corresp="urn:x-opensiddur:condition:bible:psalms/92/7/heidenheim_1965_daily_appendix">אִישׁ בַּֽעַר לֹא יֵדָע. וּכְסִיל לֹא־יָבִין אֶת־זֹאת:</j:option></tei:choice> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/8" n="8"/><tei:choice><j:option corresp="urn:x-opensiddur:condition:bible:psalms/92/8/heidenheim_1965_opening">בִּפְרֹחַ רְשָׁעִים כְּמוֹ עֵשֶׂב וַיָּצִיצוּ כָּל־פֹּעֲלֵי אָוֶן לְהִשָּׁמְדָם עֲדֵי־עַד:</j:option><j:option corresp="urn:x-opensiddur:condition:bible:psalms/92/8/heidenheim_1965_daily_appendix">בִּפְרֹֽחַ רְשָׁעִים כְּמוֹ־עֵֽשֶׂב וַיָּצִֽיצוּ כָּל־פֹּֽעֲלֵי אָֽוֶן. לְהִשָּׁמְדָם עֲדֵי־עַד:</j:option></tei:choice> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/9" n="9"/><tei:choice><j:option corresp="urn:x-opensiddur:condition:bible:psalms/92/9/heidenheim_1965_opening">וְאַתָּה מָרוֹם לְעֹלָם <j:divineName>יְהֹוָה</j:divineName>:</j:option><j:option corresp="urn:x-opensiddur:condition:bible:psalms/92/9/heidenheim_1965_daily_appendix">וְאַתָּה מָרוֹם לְעֹלָם <j:divineName>יְיָ</j:divineName>:</j:option></tei:choice> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/10" n="10"/><tei:choice><j:option corresp="urn:x-opensiddur:condition:bible:psalms/92/10/heidenheim_1965_opening">כִּי הִנֵּה אֹיְבֶיךָ <j:divineName>יְהֹוָה</j:divineName> כִּי־הִנֵּה אֹיְבֶיךָ יֹאבֵדוּ יִתְפָּרְדוּ כָּל־פֹּעֲלֵי אָוֶן:</j:option><j:option corresp="urn:x-opensiddur:condition:bible:psalms/92/10/heidenheim_1965_daily_appendix">כִּי הִנֵּה אֹיְבֶֽיךָ <j:divineName>יְיָ</j:divineName> כִּי־הִנֵּה אֹיְבֶֽיךָ יֹאבֵֽדוּ. יִתְפָּרְדוּ כָּל־פֹּֽעֲלֵי אָֽוֶן:</j:option></tei:choice> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/11" n="11"/><tei:choice><j:option corresp="urn:x-opensiddur:condition:bible:psalms/92/11/heidenheim_1965_opening">וַתָּרֶם כִּרְאֵים קַרְנִי בַּלֹּתִי בְּשֶׁמֶן רַעֲנָן:</j:option><j:option corresp="urn:x-opensiddur:condition:bible:psalms/92/11/heidenheim_1965_daily_appendix">וַתָּֽרֶם כִּרְאֵים קַרְנִי. בַּלֹּתִי בְּשֶֽׁמֶן רַעֲנָן:</j:option></tei:choice> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/12" n="12"/><tei:choice><j:option corresp="urn:x-opensiddur:condition:bible:psalms/92/12/heidenheim_1965_opening">וַתַּבֵּט עֵינִי בְּשׁוּרָי בַּקָּמִים עָלַי מְרֵעִים תִּשְׁמַעְנָה אָזְנָי:</j:option><j:option corresp="urn:x-opensiddur:condition:bible:psalms/92/12/heidenheim_1965_daily_appendix">וַתַּבֵּט עֵינִי בְּשׁוּרָי. בַּקָּמִים עָלַי מְרֵעִים תִּשְׁמַֽעְנָה אָזְנָי:</j:option></tei:choice> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/13" n="13"/><tei:choice><j:option corresp="urn:x-opensiddur:condition:bible:psalms/92/13/heidenheim_1965_opening">צַדִּיק כַּתָּמָר יִפְרָח כְּאֶרֶז בַּלְּבָנוֹן יִשְׂגֶּה:</j:option><j:option corresp="urn:x-opensiddur:condition:bible:psalms/92/13/heidenheim_1965_daily_appendix">צַדִּיק כַּתָּמָר יִפְרָח. כָּאֶֽרֶז בַּלְּבָנוֹן יִשְׂגֶּה:</j:option></tei:choice> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/14" n="14"/><tei:choice><j:option corresp="urn:x-opensiddur:condition:bible:psalms/92/14/heidenheim_1965_opening">שְׁתוּלִים בְּבֵית <j:divineName>יְהֹוָה</j:divineName> בְּחַצְרוֹת אֱלֹהֵינוּ יַפְרִיחוּ:</j:option><j:option corresp="urn:x-opensiddur:condition:bible:psalms/92/14/heidenheim_1965_daily_appendix">שְׁתוּלִים בְּבֵית <j:divineName>יְיָ</j:divineName>. בְּחַצְרוֹת אֱלֹהֵֽינוּ יַפְרִֽיחוּ:</j:option></tei:choice> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/15" n="15"/><tei:choice><j:option corresp="urn:x-opensiddur:condition:bible:psalms/92/15/heidenheim_1965_opening">עוֹד יְנוּבוּן בְּשֵׂיבָה דְּשֵׁנִים וְרַעֲנַנִּים יִהְיוּ:</j:option><j:option corresp="urn:x-opensiddur:condition:bible:psalms/92/15/heidenheim_1965_daily_appendix">עוֹד יְנוּבוּן בְּשֵׂיבָה. דְּשֵׁנִים וְרַעֲנַנִּים יִהְיוּ:</j:option></tei:choice> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/16" n="16"/><tei:choice><j:option corresp="urn:x-opensiddur:condition:bible:psalms/92/16/heidenheim_1965_opening">לְהַגִּיד כִּי־יָשָׁר <j:divineName>יְהֹוָה</j:divineName> צוּרִי וְלֹא־עַוְלָתָה בּוֹ:</j:option><j:option corresp="urn:x-opensiddur:condition:bible:psalms/92/16/heidenheim_1965_daily_appendix">לְהַגִּיד כִּי־יָשָׁר <j:divineName>יְיָ</j:divineName>. צוּרִי וְלֹא־עַוְלָֽתָה בּוֹ:</j:option></tei:choice> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
