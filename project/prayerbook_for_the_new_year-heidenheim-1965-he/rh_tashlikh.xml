      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/tashlikh" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n325.jpg">
        <tei:p><tei:milestone unit="chapter" n="7" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/tashlikh/quotation/18/micah/7"/><tei:milestone unit="verse" n="18" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/text/micah/micah/7/18"/><tei:seg source="urn:x-opensiddur:text:bible:micah/7/18">מִי אֵל כָּמֽוֹךָ נֹשֵׂא עָוֹן וְעֹבֵר עַל־פֶּֽשַׁע לִשְׁאֵרִית נַחֲלָתוֹ. לֹא־הֶחֱזִיק לָעַד אַפּוֹ כִּי חָפֵץ חֶֽסֶד הוּא: </tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="chapter" n="7" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/tashlikh/quotation/19/micah/7"/><tei:milestone unit="verse" n="19" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/text/micah/micah/7/19"/><tei:seg source="urn:x-opensiddur:text:bible:micah/7/19">יָשׁוּב יְרַחֲמֵֽנוּ יִכְבֹּשׁ עֲוֹנֹתֵינוּ וְתַשְׁלִיךְ בִּמְצֻלוֹת יָם כָּל־חַטֹּאתָם: </tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/tashlikh/vekhol_chattot_ammekha"/>וְכָל־חַטֹּאת עַמְּךָ בֵּית יִשְׂרָאֵל תַּשְׁלִיךְ בִּמְקוֹם אֲשֶׁר לֹא־יִזָּכְרוּ וְלֹא־יִפָּקְדוּ וְלֹא־יַעֲלוּ עַל־לֵב לְעוֹלָם:  <tei:milestone unit="prayer-part"/><tei:milestone unit="chapter" n="7" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/tashlikh/quotation/20/micah/7"/><tei:milestone unit="verse" n="20" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/text/micah/micah/7/20"/><tei:seg source="urn:x-opensiddur:text:bible:micah/7/20">תִּתֵּן אֱמֶת לְיַעֲקֹב חֶֽסֶד לְאַבְרָהָם אֲשֶׁר־נִשְׁבַּֽעְתָּ לַאֲבֹתֵֽינוּ מִֽימֵי קֶֽדֶם:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> </tei:p>
      </tei:div>
    </tei:body>
