    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/zikhronot_blessing" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n213.jpg">
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/zikhronot_blessing/text"/><tei:seg source="urn:x-opensiddur:text:prayer:zokher_haberit">כִּי זוֹכֵר כָּל־הַנִּשְׁכָּחוֹת אַתָּה הוּא מֵעוֹלָם וְאֵין שִׁכְחָה לִפְנֵי כִסֵּא כְבוֹדֶךָ. וַעֲקֵדַת יִצְחָק <tei:choice><j:option>לְזַרְעוֹ</j:option><j:option>לְזַרְעוֹ שֶׁל יַעֲקֹב</j:option></tei:choice> הַיּוֹם בְּרַחֲמִים תִּזְכּוֹר. בָּרוּךְ אַתָּה <j:divineName>יְיָ</j:divineName> זוֹכֵר הַבְּרִית:</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
