    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/qedushah/conclusion_parts">
        <tei:div facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n245.jpg">
          <tei:p><tei:milestone unit="prayer" corresp="urn:x-opensiddur:text:prayer:amidah/ki_maqdishekha"/>כִּי מַקְדִּישֶׁיךָ <tei:choice xml:id="musaf_qedushah_conclusion_parts_source_variant_1"><j:option corresp="urn:x-opensiddur:condition:prayer:amidah/ki_maqdishekha/biqdushatekha">בִּקְדֻשָּׁתְךָ</j:option><j:option corresp="urn:x-opensiddur:condition:prayer:amidah/ki_maqdishekha/keerkekha">כערכך</j:option></tei:choice> קִדַּשְׁתָּ. נָאֶה לְקָדוֹשׁ פְּאֵר מִקְּדוֹשִׁים. וּבְכֵן יִתְקַדַּשׁ שִׁמְךָ <j:divineName>יְיָ</j:divineName> <tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n247.jpg" n="114"/>אֱלֹהֵינוּ. עַל יִשְׂרָאֵל עַמֶּךָ. וְעַל יְרוּשָׁלַיִם עִירֶךָ. וְעַל צִיּוֹן מִשְׁכַּן כְּבוֹדֶךָ. וְעַל מַלְכוּת בֵּית דָּוִד מְשִׁיחֶךָ. וְעַל מְכוֹנְךָ וְהֵיכָלֶךָ: <tei:milestone unit="prayer" corresp="urn:x-opensiddur:text:prayer:amidah/od_yizkor_lanu"/>עוֹד יִזְכָּר לָנוּ אַהֲבַת אֵיתָן, אֲדוֹנֵינוּ. וּבֵן הַנֶּעֱקָד יַשְׁבִּית מְדַיְּנֵנוּ. וּבִזְכוּת הַתָּם יוֹצִיא <tei:choice xml:id="musaf_qedushah_conclusion_parts_source_variant_2"><j:option corresp="urn:x-opensiddur:condition:prayer:amidah/od_yizkor_lanu/ayom">אָיוֹם</j:option><j:option corresp="urn:x-opensiddur:condition:prayer:amidah/od_yizkor_lanu/hayom">היום</j:option></tei:choice> לְצֶדֶק דִּינֵנוּ. כִּי קָדוֹשׁ הַיּוֹם לַאֲדֹנֵינוּ: בְּאֵין מֵלִיץ יֹשֶׁר מוּל מָגִּיד פֶּשַׁע. תַּגִּיד לְיַעֲקֹב דָּבָר חק וּמִשְׁפָּט. וְצַדְּקֵנוּ בְּמִשְׁפָּט הַמֶּלֶךְ הַמִּשְׁפָּט. <tei:milestone unit="prayer"/></tei:p>
