      <tei:div corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n161.jpg">
        <tei:note type="instruction" xml:lang="he">תפלה משערי ציון לאמר בשעת הוצאת ס״ת.</tei:note>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n161.jpg" n="70"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/text"/><tei:milestone unit="chapter" n="34" corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/adonai"/><tei:milestone unit="verse" n="6" corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/adonai/6"/><tei:milestone unit="verse-part" n="adonai_adonai" corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/adonai/6/adonai_adonai"/><tei:seg source="urn:x-opensiddur:text:bible:exodus/34/6/adonai_adonai"><j:divineName>יְהוָה</j:divineName> <j:divineName>יְהוָה</j:divineName> אֵל רַחוּם וְחַנּוּן אֶרֶךְ אַפַּיִם וְרַב־חֶסֶד וֶאֱמֶת:</tei:seg><tei:milestone unit="verse-part"/><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>   <tei:milestone unit="chapter" n="34" corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/notzer"/><tei:milestone unit="verse" n="7" corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/notzer/7"/><tei:milestone unit="verse-part" n="notzer_chesed" corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/notzer/7/notzer_chesed"/><tei:seg source="urn:x-opensiddur:text:bible:exodus/34/7/notzer_chesed">נֹצֵר חֶסֶד לָאֲלָפִים נֹשֵׂא עָוֹן וָפֶשַׁע וְחַטָּאָה </tei:seg><tei:milestone unit="verse-part"/><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="chapter" n="34" corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/venakeh"/><tei:milestone unit="verse" n="7" corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/venakeh/7"/><tei:milestone unit="verse-part" n="venakeh" corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/venakeh/7/venakeh"/><tei:seg source="urn:x-opensiddur:text:bible:exodus/34/7/venakeh">וְנַקֵּה:</tei:seg><tei:milestone unit="verse-part"/><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/><tei:note type="instruction" xml:lang="he"><tei:ref target="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening@prayerbook_for_the_new_year-heidenheim-1965-he">ג״פ.</tei:ref></tei:note></tei:p>
