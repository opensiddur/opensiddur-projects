    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/al_ken" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n205.jpg">
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/al_ken/text"/><tei:seg source="urn:x-opensiddur:text:siddur:chol/shacharit/conclusion/aleinu/al_ken">עַל־כֵּן נְקַוֶּה לְךָ <j:divineName>יְיָ</j:divineName> אֱלֹהֵינוּ לִרְאוֹת מְהֵרָה בְּתִפְאֶרֶת עֻזֶּךָ לְהַעֲבִיר גִּלּוּלִים מִן־הָאָרֶץ וְהָאֱלִילִים כָּרוֹת יִכָּרֵתוּן. לְתַקֵּן עוֹלָם בְּמַלְכוּת שַׁדַּי וְכָל־בְּנֵי בָשָׂר יִקְרְאוּ בִשְׁמֶךָ. לְהַפְנוֹת אֵלֶיךָ כָּל־רִשְׁעֵי אָרֶץ. יַכִּירוּ וְיֵדְעוּ כָּל־יוֹשְׁבֵי תֵבֵל כִּי לְךָ</tei:seg> <tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n207.jpg" n="94"/><tei:seg source="urn:x-opensiddur:text:siddur:chol/shacharit/conclusion/aleinu/al_ken">תִּכְרַע כָּל־בֶּרֶךְ תִּשָּׁבַע כָּל־לָשׁוֹן: לְפָנֶיךָ <j:divineName>יְיָ</j:divineName> אֱלֹהֵינוּ יִכְרְעוּ וְיִפּוֹלוּ. וְלִכְבוֹד שִׁמְךָ יְקָר יִתֵּנוּ. וִיקַבְּלוּ כֻלָּם אֶת־עֹל מַלְכוּתֶךָ. וְתִמְלוֹךְ עֲלֵיהֶם מְהֵרָה לְעוֹלָם וָעֶד. כִּי הַמַּלְכוּת שֶׁלְּךָ הִיא וּלְעוֹלְמֵי עַד תִּמְלוֹךְ בְּכָבוֹד:</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
