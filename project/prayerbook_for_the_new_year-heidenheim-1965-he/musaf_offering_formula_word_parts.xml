    <tei:body>
      <tei:div facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n205.jpg">
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/offering_formula/text"/><tei:choice><j:option corresp="urn:x-opensiddur:condition:siddur:rosh_hashanah/musaf/offering_formula/text/he/quiet_printing">וּמִנְחָתָם וְנִסְכֵּיהֶם כַּמְדֻבָּר שְׁלֹשָׁה עֶשְׂרֹנִים לַפָּר וּשְׁנֵי עֶשְׂרֹנִים לָאָיִל וְעִשָּׂרוֹן לַכֶּבֶשׂ וְיַיִן כְּנִסְכּוֹ </j:option><j:option corresp="urn:x-opensiddur:condition:siddur:rosh_hashanah/musaf/offering_formula/text/he/repetition_printing">וּמִנְחָתָם וְנִסְכֵּיהֶם כִּמְדֻבָּר שְׁלשָׁה עֶשְׂרֹנִים לַפָּר וּשְׁנֵי עֶשְׂרֹנִים לָאָיִל וְעִשָּׂרוֹן לַכֶּבֶשׂ וְיַיִן כְּנִסְכּוֹ</j:option></tei:choice> <tei:milestone unit="prayer-part"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/offering_formula/ushenei_seirim"/>וּשְׁנֵי שְׂעִירִים לְכַפֵּר. וּשְׁנֵי תְמִידִים כְּהִלְכָתָם: מִלְּבַד עֹלַת הַחֹדֶשׁ וּמִנְחָתָהּ. וְעֹלַת הַתָּמִיד וּמִנְחָתָהּ. וְנִסְכֵּיהֶם כְּמִשְׁפָּטָם לְרֵיחַ נִיחֹחַ אִשֶּׁה לַ<j:divineName>יְיָ</j:divineName>: <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
