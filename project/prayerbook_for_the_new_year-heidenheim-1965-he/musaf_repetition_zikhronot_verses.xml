      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n287.jpg">
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/intro_1"/>כַּכָּתוּב בְּתוֹרָתֶךָ <tei:milestone unit="prayer-part"/><tei:milestone unit="chapter" n="8" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/quotes/genesis_8_1/genesis_8"/><tei:milestone unit="verse" n="1" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/quotes/genesis_8_1/genesis_8/1"/><tei:seg source="urn:x-opensiddur:text:bible:genesis/8/1">וַיִּזְכֹּר אֱלֹהִים אֶת־נֹחַ וְאֵת כָּל־הַחַיָּה וְאֶת־כָּל־הַבְּהֵמָה אֲשֶׁר אִתּוֹ בַּתֵּבָה וַיַּעֲבֵר אֱלֹהִים רוּחַ עַל־הָאָרֶץ וַיָּשֹׁכּוּ הַמָּיִם:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/intro_2"/>וְנֶאֱמַר <tei:milestone unit="prayer-part"/><tei:milestone unit="chapter" n="2" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/quotes/exodus_2_24/exodus_2"/><tei:milestone unit="verse" n="24" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/quotes/exodus_2_24/exodus_2/24"/><tei:seg source="urn:x-opensiddur:text:bible:exodus/2/24">וַיִּשְׁמַע אֱלֹהִים אֶת־נַאֲקָתָם וַיִּזְכֹּר אֱלֹהִים אֶת־בְּרִיתוֹ אֶת־<tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n289.jpg" n="135"/>אַבְרָהָם אֶת־יִצְחָק וְאֶת־יַעֲקֹב:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/intro_3"/>וְנֶאֱמַר <tei:milestone unit="prayer-part"/><tei:milestone unit="chapter" n="26" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/quotes/leviticus_26_42/leviticus_26"/><tei:milestone unit="verse" n="42" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/quotes/leviticus_26_42/leviticus_26/42"/><tei:seg source="urn:x-opensiddur:text:bible:leviticus/26/42">וְזָכַרְתִּי אֶת־בְּרִיתִי יַעֲקוֹב וְאַף אֶת־בְּרִיתִי יִצְחָק וְאַף אֶת־בְּרִיתִי אַבְרָהָם אֶזְכֹּר וְהָאָרֶץ אֶזְכֹּר:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/intro_4"/>וּבְדִבְרֵי קָדְשְׁךָ כָּתוּב לֵאמֹר <tei:milestone unit="prayer-part"/><tei:milestone unit="chapter" n="111" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/quotes/psalms_111_4/psalms_111"/><tei:milestone unit="verse" n="4" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/quotes/psalms_111_4/psalms_111/4"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/111/4">זֵכֶר עָשָׂה לְנִפְלְאֹתָיו חַנּוּן וְרַחוּם <j:divineName>יְיָ</j:divineName>:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/intro_5"/>וְנֶאֱמַר <tei:milestone unit="prayer-part"/><tei:milestone unit="chapter" n="111" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/quotes/psalms_111_5/psalms_111"/><tei:milestone unit="verse" n="5" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/quotes/psalms_111_5/psalms_111/5"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/111/5">טֶרֶף נָתַן לִירֵאָיו יִזְכּוֹר לְעוֹלָם בְּרִיתוֹ:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/intro_6"/>וְנֶאֱמַר <tei:milestone unit="prayer-part"/><tei:milestone unit="chapter" n="106" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/quotes/psalms_106_45/psalms_106"/><tei:milestone unit="verse" n="45" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/quotes/psalms_106_45/psalms_106/45"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/106/45">וַיִּזְכֹּר לָהֶם בְּרִיתוֹ וַיִּנָּחֵם כְּרֹב חֲסָדָיו:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/intro_7"/>וְעַל־יְדֵי עֲבָדֶיךָ הַנְּבִיאִים כָּתוּב לֵאמֹר <tei:milestone unit="prayer-part"/><tei:milestone unit="chapter" n="2" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/quotes/jeremiah_2_2/jeremiah_2"/><tei:milestone unit="verse" n="2" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/quotes/jeremiah_2_2/jeremiah_2/2"/><tei:seg source="urn:x-opensiddur:text:bible:jeremiah/2/2">הָלֹךְ וְקָרָאתָ בְאָזְנֵי יְרוּשָׁלַֽ͏ִם לֵאמֹר כֹּה אָמַר <j:divineName>יְיָ</j:divineName> זָכַרְתִּי לָךְ חֶסֶד נְעוּרַיִךְ אַהֲבַת כְּלוּלֹתָיִךְ לֶכְתֵּךְ אַחֲרַי בַּמִּדְבָּר בְּאֶרֶץ לֹא זְרוּעָה:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/intro_8"/>וְנֶאֱמַר <tei:milestone unit="prayer-part"/><tei:milestone unit="chapter" n="16" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/quotes/ezekiel_16_60/ezekiel_16"/><tei:milestone unit="verse" n="60" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/quotes/ezekiel_16_60/ezekiel_16/60"/><tei:seg source="urn:x-opensiddur:text:bible:ezekiel/16/60">וְזָכַרְתִּי אֲנִי אֶת־בְּרִיתִי אוֹתָךְ בִּימֵי נְעוּרָיִךְ וַהֲקִימוֹתִי לָךְ בְּרִית עוֹלָם:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/final_intro"/>וְנֶאֱמַר <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
