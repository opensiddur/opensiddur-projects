      <tei:div corresp="urn:x-opensiddur:text:siddur:regalim/musaf/text/addir_bamarom" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n313.jpg">
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:addir_bamarom_shokhen"/><tei:choice><j:option corresp="urn:x-opensiddur:condition:prayer:addir_bamarom_shokhen/heidenheim_1965_printing_1/earlier">אַדִּיר בַּמָּרוֹם שׁוֹכֵן בִּגְבוּרָה. אַתָּה שָׁלוֹם וְשִׁמְךָ שָׁלוֹם. יְהִי רָצוֹן שֶׁתָּשִׂים עָלֵֽינוּ וְעַל עַמְּךָ בֵּית יִשְׂרָאֵל חַיִּים וּבְרָכָה לְמִשְׁמֶֽרֶת שָׁלוֹם:</j:option><j:option corresp="urn:x-opensiddur:condition:prayer:addir_bamarom_shokhen/heidenheim_1965_printing_1/kohanim_appendix">אַדִּיר בַּמָּרוֹם שׁוֹכֵן בִּגְבוּרָה. אַתָּה שָׁלוֹם וְשִׁמְךָ שָׁלוֹם. יְהִי רָצוֹן שֶׁתָּשִׂים עָלֵֽינוּ וְעַל־עַמְּךָ בֵּית יִשְׂרָאֵל חַיִּים וּבְרָכָה לְמִשְׁמֶֽרֶת שָׁלוֹם:</j:option></tei:choice> <tei:milestone unit="prayer-part"/></tei:p>
