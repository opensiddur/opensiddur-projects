    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:lael_orekh_din" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n143.jpg">
        <tei:note type="description" xml:lang="he">ע״ס א״ב.</tei:note>
        <tei:lg>
          <tei:l><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n143.jpg" n="58"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/1"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he">חזן.</tei:note> לְאֵל עוֹרֵךְ דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/2"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he">קהל.</tei:note> לְבוֹחֵן לְבָבוֹת בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/3"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">חזן</tei:note> לְגוֹלֶה עֲמוּקוֹת בַּדִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/4"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">קהל</tei:note> לְדוֹבֵר מֵישָׁרִים בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/5"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">חזן</tei:note> לְהוֹגֶה דֵּעוֹת בַּדִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/6"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">קהל</tei:note> לְוָתִיק וְעֹשֶׂה חֶסֶד בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/7"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">חזן</tei:note> לְזוֹכֵר בְּרִיתוֹ בַּדִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/8"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">קהל</tei:note> לְחוֹמֵל מַעֲשָׂיו בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/9"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">חזן</tei:note> לְטַהֵר חוֹסָיו בַּדִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/10"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">קהל</tei:note> לְיוֹדֵעַ מַחֲשָׁבוֹת בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/11"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">חזן</tei:note> לְכוֹבֵשׁ כַּעֲסוֹ בַּדִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/12"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">קהל</tei:note> לְלוֹבֵשׁ צְדָקוֹת בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n145.jpg" n="59"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/13"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">חזן</tei:note> לְמוֹחֵל עֲוֹנוֹת בַּדִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/14"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">קהל</tei:note> לְנוֹרָא תְהִלּוֹת בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/15"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">חזן</tei:note> לְסוֹלֵחַ לַעֲמוּסָיו בַּדִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/16"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">קהל</tei:note> לְעוֹנֶה לְקוֹרְאָיו בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/17"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">חזן</tei:note> לְפוֹעֵל רַחֲמָיו בַּדִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/18"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">קהל</tei:note> לְצוֹפֶה נִסְתָּרוֹת בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/19"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">חזן</tei:note> לְקוֹנֶה עֲבָדָיו בַּדִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/20"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>קו״ח</tei:abbr><tei:expan>קהל וחזן</tei:expan></tei:choice></tei:note> לְרַחֵם עַמּוֹ בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/21"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">חזן</tei:note> לְשׁוֹמֵר אֹהֲבָיו בַּדִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/22"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">קהל</tei:note> לְתוֹמֵךְ תְּמִימָיו בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
