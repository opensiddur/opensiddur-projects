    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:barekhu" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n17.jpg">
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:barekhu/call"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="yi">פֿאָרבעטער;</tei:note> בָּרְכוּ אֶת־<j:divineName>יְיָ</j:divineName> הַמְבֹרָךְ: </tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:barekhu/response"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>קו״ח</tei:abbr><tei:expan>קהל וחזן</tei:expan></tei:choice></tei:note> בָּרוּךְ <j:divineName>יְיָ</j:divineName> הַמְבֹרָךְ לְעוֹלָם וָעֶד: </tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:barekhu/yitbarakh"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="yi">געמיינדע:</tei:note> יִתְבָּרַךְ וְיִשְׁתַּבַּח וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְנַשֵּׂא שְׁמוֹ שֶׁל מֶלֶךְ מַלְכֵי הַמְּלָכִים הַקָּדוֹשׁ בָּרוּךְ הוּא שֶׁהוּא רִאשׁוֹן וְהוּא אַחֲרוֹן וּמִבַּלְעָדָיו אֵין אֱלֹהִים סֹלּוּ לָרֹכֵב בָּעֲרָבוֹת בְּיָהּ שְׁמוֹ וְעִלְזוּ לְפָנָיו. וּשְׁמוֹ מְרוֹמָם עַל־כָּל־בְּרָכָה וּתְהִלָּה: </tei:p>
        <tei:p>בָּרוּךְ שֵׁם כְּבוֹד מַלְכוּתוֹ לְעֹלָם וָעֶד: </tei:p>
        <tei:p><tei:seg source="urn:x-opensiddur:text:bible:psalms/113/2"><tei:milestone unit="chapter" n="113"/><tei:milestone unit="verse" n="2" corresp="urn:x-opensiddur:text:bible:psalms/113/2"/>יְהִי שֵׁם <j:divineName>יְיָ</j:divineName> מְבֹרָךְ מֵעַתָּה וְעַד עוֹלָם:<tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
