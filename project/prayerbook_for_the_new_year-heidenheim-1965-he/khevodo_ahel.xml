  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:khevodo_ahel" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n105.jpg">
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:khevodo_ahel/1"/>כְּבוֹדוֹ. אֹהֶל בְּיוֹם בְּרַחֲמִים מֶלֶךְ. <tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> בּוֹחֵן כָּל־עֶשְׁתּוֹנוֹת צָעִיר וָרַב. מֶלֶךְ. גֵּאוּת וָעוֹז הִתְאַזַּר מֶלֶךְ. דּוֹק וָחֶלֶד יֶחֶרְדוּן מֵאֵימַת מֶלֶךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:khevodo_ahel/2"/>הַיּוֹצֵר יַחַד לִבָּם יָחֹן מֶלֶךְ. וּמֵבִין אֶל־כָּל־מַעֲשֵׂיהֶם יַצְדִּיק מֶלֶךְ. זִכָּרוֹן הוּא יוֹם תְּרוּעַת מֶלֶךְ. <tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> חֹק לְיִשְׂרָאֵל הוּא לְזַכּוֹתָם מֶלֶךְ. טֶרֶף נָתַן לִירֵאָיו מַמְלִיךְ כָּל־מֶלֶךְ. יִזְכֹּר לְעוֹלָם בְּרִיתוֹ בְּזִכְרוֹן טוֹב מֶלֶךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:khevodo_ahel/3"/>כָּלָה אַל תַּעַשׂ לִשְׁאֵרִית בְּנֵי מֶלֶךְ. לָכֵן אָתָנוּ לְךָ מַלְכֵּנוּ מֶלֶךְ. מֵאֶתְמוֹל קִדַּמְנוּךָ לְחַלּוֹתְךָ <tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n107.jpg" n="40"/>מֶלֶךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:khevodo_ahel/4"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> נָא נְצֹר חֶסֶד לְנִינֵי שָׁלְחוּ לוֹ שְׁלֹשֶׁת אֵילֵי מֶלֶךְ. סְכוֹת בָּאֵי בְתַחַן לְמַר בָּכוּ אֶרְאֶלֵּי מֶלֶךְ. עֲנוּתָם בַּל תְּבֶז לְלָן בַּמָּקוֹם עָלוּ וְיָרְדוּ בוֹ מַלְאֲכֵי מֶלֶךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:khevodo_ahel/5"/>פְּדֵם הַיּוֹם מִדִּין גָּמוּר מִלְּחַיְּבֵם מֶלֶךְ. <tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> צַדְּקֵם בְּרַחֲמִים וּפָקְדֵם לְטוֹבָה מֶלֶךְ. <j:conditional xml:id="khevodo_ahel_segment_18"><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="false"/></tei:f></tei:fs></j:all></j:conditional>קְשׁוֹב קוֹל תְּקִיעָה מְתוֹקְעֵי <j:endConditional target="#khevodo_ahel_segment_18"/><j:conditional type="marked" xml:id="khevodo_ahel_segment_19"><tei:note type="instruction" xml:lang="de-Hebr">אם שבת</tei:note><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional>קְשׁוֹב זִכְרוֹן תְּקִיעָה מְזוֹכְרֵי <j:endConditional target="#khevodo_ahel_segment_19"/>לְךָ הַיּוֹם מֶלֶךְ. רַחֲמִים תְּעוֹרֵר לִמְחַכֶּיךָ מֶלֶךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:khevodo_ahel/6"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>קו״ח</tei:abbr><tei:expan>קהל וחזן</tei:expan></tei:choice></tei:note> שְׁעֵה שַׁוְעַת עַם מְשַׁחֲרֶיךָ מֶלֶךְ. תֵּפֶן בְּתוֹמְכֵי בָרוּךְ וּנְבָרֶכְךָ אֱלֹהִים חַיִּים וּמֶלֶךְ: <tei:milestone unit="stanza"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>
