      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/yismechu" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n205.jpg">
        <j:conditional type="marked" xml:id="musaf_yismechu_condition">
          <tei:note type="instruction" xml:lang="de-Hebr">(אַם שַׁבָּת:)</tei:note>
          <j:all>
            <tei:fs type="opensiddur:holiday-aggregate">
              <tei:f name="shabbat">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:all>
        </j:conditional>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/yismechu/text"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/yismechu_vemalkhutekha">יִשְׂמְחוּ בְּמַלְכוּתְךָ שֹׁמְרֵי שַׁבָּת וְקוֹרְאֵי עֹנֶג עַם מְקַדְּשֵׁי שְׁבִיעִי. כֻּלָּם יִשְׂבְּעוּ וְיִתְעַנְּגוּ מִטּוּבֶךָ וּבַשְּׁבִיעִי רָצִיתָ בּוֹ וְקִדַּשְׁתּוֹ חֶמְדַּת יָמִים אוֹתוֹ קָרָאתָ זֵכֶר לְמַעֲשֵׂה בְרֵאשִׁית:</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
        <j:endConditional target="#musaf_yismechu_condition"/>
