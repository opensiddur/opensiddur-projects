    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/text/elohai_netzor" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n31.jpg">
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:amidah/elohai_netzor/text"/>אֱלֹהַי. נְצוֹר לְשׁוֹנִי מֵרָע וּשְׂפָתַי מִדַּבֵּר מִרְמָה. וְלִמְקַלְלַי נַפְשִׁי תִדּוֹם וְנַפְשִׁי כֶּעָפָר לַכֹּל תִּהְיֶה: פְּתַח לִבִּי בְּתוֹרָתֶךָ וּבְמִצְוֹתֶיךָ תִּרְדּוֹף נַפְשִׁי. וְכָל הַחוֹשְׁבִים עָלַי רָעָה מְהֵרָה הָפֵר עֲצָתָם וְקַלְקֵל מַחֲשַׁבְתָּם. עֲשֵׂה לְמַעַן שְׁמֶךָ. עֲשֵׂה לְמַעַן יְמִינֶךָ. עֲשֵׂה לְמַעַן קְדֻשָּׁתֶךָ. עֲשֵׂה לְמַעַן תּוֹרָתֶךָ. <tei:milestone unit="chapter" n="60"/><tei:milestone unit="verse" n="7" corresp="urn:x-opensiddur:text:bible:psalms/60/7"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/60/7">לְמַעַן יֵחָלְצוּן יְדִידֶיךָ. הוֹשִׁיעָה יְמִינְךָ וַעֲנֵנִי:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="chapter" n="19"/><tei:milestone unit="verse" n="15" corresp="urn:x-opensiddur:text:bible:psalms/19/15"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/19/15">יִהְיוּ לְרָצוֹן אִמְרֵי־פִי וְהֶגְיוֹן לִבִּי לְפָנֶיךָ <j:divineName>יְיָ</j:divineName> צוּרִי וְגֹאֲלִי:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> עֹשֶׂה שָׁלוֹם בִּמְרוֹמָיו הוּא יַעֲשֶׂה שָׁלוֹם עָלֵינוּ וְעַל כָּל־יִשְׂרָאֵל וְאִמְרוּ אָמֵן: <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
