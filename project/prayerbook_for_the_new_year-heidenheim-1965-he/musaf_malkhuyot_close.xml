  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/malkhuyot_close" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n207.jpg">
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/malkhuyot_close/text"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam">אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ. מְלוֹךְ עַל כָּל־הָעוֹלָם כֻּלּוֹ בִּכְבוֹדֶךָ וְהִנָּשֵׂא עַל כָּל־הָאָרֶץ בִּיקָרֶךָ וְהוֹפַע בַּהֲדַר גְּאוֹן עֻזֶּךָ עַל כָּל־יוֹשְׁבֵי תֵבֵל אַרְצֶךָ. וְיֵדַע כָּל־פָּעוּל כִּי אַתָּה פְּעַלְתּוֹ וְיָבִין כָּל־יָצוּר כִּי אַתָּה יְצַרְתּוֹ וְיֹאמַר</tei:seg> <tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n209.jpg" n="95"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam">כֹּל אֲשֶׁר נְשָׁמָה בְאַפּוֹ <j:divineName>יְיָ</j:divineName> אֱלֹהֵי יִשְׂרָאֵל מֶלֶךְ וּמַלְכוּתוֹ בַּכֹּל מָשָׁלָה: </tei:seg> <j:conditional type="marked" xml:id="musaf_malkhuyot_close_segment_2"><tei:note type="instruction" xml:lang="de-Hebr">אַם שַׁבָּת.</tei:note><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam">אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ רְצֵה בִמְנוּחָתֵנוּ</tei:seg> <j:endConditional target="#musaf_malkhuyot_close_segment_2"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam"> קַדְּשֵׁנוּ בְּמִצְוֹתֶיךָ וְתֵן חֶלְקֵנוּ בְּתוֹרָתֶךָ שַׂבְּעֵנוּ מִטּוּבֶךָ וְשַׂמְּחֵנוּ בִּישׁוּעָתֶךָ. </tei:seg> <j:conditional type="marked" xml:id="musaf_malkhuyot_close_segment_4"><tei:note type="instruction" xml:lang="de-Hebr">אַם שַׁבָּת.</tei:note><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam">וְהַנְחִילֵנוּ <j:divineName>יְיָ</j:divineName> אֱלֹהֵינוּ בְּאַהֲבָה וּבְרָצוֹן שַׁבַּת קָדְשֶׁךָ וְיָנוּחוּ בָהּ יִשְׂרָאֵל מְקַדְּשֵׁי שְׁמֶךָ.</tei:seg> <j:endConditional target="#musaf_malkhuyot_close_segment_4"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam"> וְטַהֵר לִבֵּנוּ לְעָבְדְךָ בֶּאֱמֶת כִּי אַתָּה אֱלֹהִים אֱמֶת וּדְבָרְךָ </tei:seg> <j:conditional type="marked" xml:id="musaf_malkhuyot_close_segment_6"><j:all><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/melokh_al_kol_haolam/malkenu"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam">מלכנו</tei:seg> <j:endConditional target="#musaf_malkhuyot_close_segment_6"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam"> אֱמֶת וְקַיָּם לָעַד. בָּרוּךְ אַתָּה <j:divineName>יְיָ</j:divineName> מֶלֶךְ עַל כָּל־הָאָרֶץ מְקַדֵּשׁ </tei:seg> <j:conditional type="marked" xml:id="musaf_malkhuyot_close_segment_8"><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam">הַשַּׁבָּת וְ</tei:seg><j:endConditional target="#musaf_malkhuyot_close_segment_8"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam">יִשְׂרָאֵל וְיוֹם הַזִּכָּרוֹן:</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
