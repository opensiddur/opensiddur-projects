      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/offering_formula/useir_lekhapper" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n205.jpg">
        <j:conditional xml:id="musaf_useir_lekhapper_condition">
          <tei:note type="instruction" xml:lang="he"><tei:choice><tei:abbr>בק״ק</tei:abbr><tei:expan>בקהלה קדושה</tei:expan></tei:choice> <tei:choice><tei:abbr>פפ״דמ</tei:abbr><tei:expan>פרנקפורט דמיין</tei:expan></tei:choice> <tei:choice><tei:abbr>ובנותי׳</tei:abbr><tei:expan>ובנותיה</tei:expan></tei:choice> אומרים.</tei:note>
          <j:all>
            <tei:fs type="opensiddur:rite">
              <tei:f name="frankfurt_am_main">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:all>
        </j:conditional>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/offering_formula/useir_lekhapper/text"/>וּשְׂעִיר לְכַפֵּר מִלְּבַד עֹלַת הַחֹדֶשׁ וּמִנְחָתָהּ וּשְׂעִיר לְחַטָּאת וְנִסְכֵּיהֶם כְּמִשְׁפָּטָם וּשְׁנֵי תְמִידִים כְּהִלְכָתָם: <tei:milestone unit="prayer-part"/></tei:p>
