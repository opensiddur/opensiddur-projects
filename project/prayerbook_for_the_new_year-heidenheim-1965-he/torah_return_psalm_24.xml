  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n195.jpg">
        <tei:p><tei:milestone unit="chapter" n="24" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/1" n="1"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/24/1">לְדָוִד מִזְמוֹר. לַ<j:divineName>יהוָה</j:divineName> הָאָֽרֶץ וּמְלוֹאָהּ תֵּבֵל וְיֹשְׁבֵי בָהּ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/2" n="2"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/24/2">כִּי הוּא עַל־יַמִּים יְסָדָהּ וְעַל־נְהָרוֹת יְכוֹנְנֶהָ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/3" n="3"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/24/3">מִי־יַעֲלֶה בְהַר־<j:divineName>יְהוָה</j:divineName> וּמִי־יָקוּם בִּמְקוֹם קָדְשׁוֹ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/4" n="4"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/24/4">נְקִי כַפַּיִם וּבַר־לֵבָב אֲשֶׁר לֹא־נָשָׂא לַשָּׁוְא נַפְשִׁי וְלֹא נִשְׁבַּע לְמִרְמָה:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/5" n="5"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/24/5">יִשָּׂא בְרָכָה מֵאֵת <j:divineName>יְהוָה</j:divineName> וּצְדָקָה מֵאֱלֹהֵי יִשְׁעוֹ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/6" n="6"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/24/6">זֶה דּוֹר דֹּרְשָׁו מְבַקְשֵׁי פָנֶיךָ יַעֲקֹב סֶלָה:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/7" n="7"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/24/7">שְׂאוּ שְׁעָרִים רָאשֵׁיכֶם וְהִנָּשְׂאוּ פִּתְחֵי עוֹלָם וְיָבוֹא מֶלֶךְ הַכָּבוֹד:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/8" n="8"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/24/8">מִי זֶה מֶלֶךְ הַכָּבוֹד <j:divineName>יְהוָה</j:divineName> עִזּוּז וְגִבּוֹר <j:divineName>יְהוָה</j:divineName> גִּבּוֹר מִלְחָמָה:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/9" n="9"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/24/9">שְׂאוּ שְׁעָרִים רָאשֵׁיכֶם וּשְׂאוּ פִּתְחֵי עוֹלָם וְיָבֹא מֶלֶךְ הַכָּבוֹד:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/10" n="10"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/24/10">מִי הוּא זֶה מֶלֶךְ הַכָּבוֹד <j:divineName>יְהוָה</j:divineName> צְבָאוֹת הוּא מֶלֶךְ הַכָּבוֹד סֶלָה:</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
