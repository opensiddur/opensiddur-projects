  <tei:text>
    <tei:body>
      <tei:div facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n13.jpg">
        <tei:p><tei:milestone unit="chapter" n="96" corresp="urn:x-opensiddur:text:bible:psalms/96"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/96/1" n="1"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> שִׁירוּ לַ<j:divineName>ייָ</j:divineName> שִׁיר חָדָשׁ שִׁירוּ לַ<j:divineName>ייָ</j:divineName> כָּל־הָאָרֶץ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/96/2" n="2"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> שִׁירוּ לַ<j:divineName>ייָ</j:divineName> בָּרְכוּ שְׁמוֹ בַּשְּׂרוּ מִיּוֹם־לְיוֹם יְשׁוּעָתוֹ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/96/3" n="3"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> סַפְּרוּ בַגּוֹיִם כְּבוֹדוֹ בְּכָל־הָעַמִּים נִפְלְאוֹתָיו: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/96/4" n="4"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> כִּי גָדוֹל <j:divineName>יְיָ</j:divineName> וּמְהֻלָּל מְאֹד נוֹרָא הוּא עַל־כָּל־אֱלֹהִים: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/96/5" n="5"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> כִּי כָּל־אֱלֹהֵי הָעַמִּים אֱלִילִים וַ<j:divineName>ייָ</j:divineName> שָׁמַיִם עָשָׂה: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/96/6" n="6"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> הוֹד־וְהָדָר לְפָנָיו עֹז וְתִפְאֶרֶת בְּמִקְדָּשׁוֹ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/96/7" n="7"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> הָבוּ לַ<j:divineName>ייָ</j:divineName> מִשְׁפְּחוֹת עַמִּים הָבוּ לַ<j:divineName>ייָ</j:divineName> כָּבוֹד וָעֹז: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/96/8" n="8"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> הָבוּ לַ<j:divineName>ייָ</j:divineName> כְּבוֹד שְׁמוֹ שְׂאוּ מִנְחָה וּבֹאוּ לְחַצְרוֹתָיו: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/96/9" n="9"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> הִשְׁתַּחֲווּ לַ<j:divineName>ייָ</j:divineName> בְּהַדְרַת־קֹדֶשׁ חִילוּ מִפָּנָיו כָּל־הָאָרֶץ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/96/10" n="10"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> אִמְרוּ בַגּוֹיִם <j:divineName>יְיָ</j:divineName> מָלָךְ אַף־תִּכּוֹן תֵּבֵל בַּל־תִּמּוֹט יָדִין עַמִּים בְּמֵישָׁרִים: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/96/11" n="11"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> יִשְׂמְחוּ הַשָּׁמַיִם וְתָגֵל הָאָרֶץ יִרְעַם הַיָּם וּמְלֹאוֹ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/96/12" n="12"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> יַעֲלֹז שָׂדַי וְכָל־אֲשֶׁר־בּוֹ אָז יְרַנְּנוּ כָּל־עֲצֵי־יָעַר: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/96/13" n="13"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>קו״ח</tei:abbr><tei:expan>קהל וחזן</tei:expan></tei:choice></tei:note> לִפְנֵי <j:divineName>יְיָ</j:divineName> כִּי בָא כִּי בָא לִשְׁפֹּט הָאָרֶץ יִשְׁפֹּט־תֵּבֵל בְּצֶדֶק וְעַמִּים בֶּאֱמוּנָתוֹ: <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
