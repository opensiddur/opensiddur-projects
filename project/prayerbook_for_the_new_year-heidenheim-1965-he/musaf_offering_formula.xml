      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/offering_formula" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n205.jpg">
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/offering_formula/text"/>וּמִנְחָתָם וְנִסְכֵּיהֶם כַּמְדֻבָּר שְׁלֹשָׁה עֶשְׂרֹנִים לַפָּר וּשְׁנֵי עֶשְׂרֹנִים לָאָיִל וְעִשָּׂרוֹן לַכֶּבֶשׂ וְיַיִן כְּנִסְכּוֹ  <tei:milestone unit="prayer-part"/><j:conditional xml:id="musaf_offering_formula_segment_1"><j:all><tei:fs type="opensiddur:rite"><tei:f name="frankfurt_am_main"><tei:binary value="false"/></tei:f></tei:fs></j:all></j:conditional><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/offering_formula/ushenei_seirim"/>וּשְׁנֵי־שְׂעִירִים לְכַפֵּר. וּשְׁנֵי תְמִידִים כְּהִלְכָתָם: מִלְּבַד עֹלַת הַחֹדֶשׁ וּמִנְחָתָהּ. וְעֹלַת הַתָּמִיד וּמִנְחָתָהּ. וְנִסְכֵּיהֶם כְּמִשְׁפָּטָם לְרֵיחַ נִיחֹחַ אִשֶּׁה לַ<j:divineName>יְיָ</j:divineName>: <tei:milestone unit="prayer-part"/><j:endConditional target="#musaf_offering_formula_segment_1"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
