    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:even_chug" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n129.jpg">
        <tei:note type="description" xml:lang="he">ע״ס א״ת ב״ש.</tei:note>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n129.jpg" n="51"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/even_chug/part_1"/>אֶבֶן חוּג מְצוּק נְשִׁיָּה. תְּהוֹם רַבָּה צוּל שְׁאִיָּה. בְּפִנַּת רֹאשׁ יְסוֹד שְׁלִישִׁיָּה. שֻׁתְּתוֹ שְׁעוֹן בָּהּ לִשְׁעִיָּה. גִּבְעַת שֹׁרֶשׁ מְאוּסַת בּוֹנִים. רֻבְּעָה הַיּוֹם מֵאַרְבָּעָה אֲבָנִים. דְּמָעוֹת מְבַכָּה עַל בָּנִים. קָשְׁבָה מִנְעִי אֵם הַבָּנִים: הָאַדְמוֹן כְּבַט שֶׁלֹּא חָלָה. צָבָה לְקַחְתָּה לוֹ וְנִתְבֶּהָלָה. וּפִלְּלָה רַבִּים בְּעַד הַתּוֹחֵלָה. פְּדוֹתָהּ מִזֵּד וְלֹא חֻלָּלָה. זָכַר לָהּ יֹשֶׁר אֳרָחוֹת. עוֹבֵר לְהָמִיר בְּבֶטֶן אָחוֹת. הֻשְּׁבָה כְּהַיּוֹם זִכְרָהּ לְהֵאָחוֹת. סִלּוּף דִּינָה בִּיהוֹסֵף לְהַנְחוֹת: טֶבַע כִּכְלִי יוֹצֵר הֶעֱבִיר. נִסֵּי חֲיָלִים לְהַעֲצִים וּלְהַגְבִּיר. יָהּ כְּסָכַת אֶנְקַת גְּבִיר. מַטּוֹרַת שְׁנַיִם מֶנָּהּ הִסְבִּיר: כַּעֲקֶרֶת בַּיִת בְּתֶחֶל נֻכָּרָה. כִּבְכוֹר רֵאשִׁית בְּתֶכֶל בֻּכָּרָה. <tei:milestone unit="prayer-part"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/even_chug/part_2"/>לְבַדֶּֽיהָ תַעֲמוֹד בְּיוֹם זְכִירָה. לְהִזָּכֵר לָמוֹ כְּמוֹ נִזְכָּרָה: <tei:milestone unit="prayer-part"/></tei:p>
