  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/numbers_15" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n111.jpg">
        <tei:p><tei:milestone unit="chapter" n="15" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/numbers_15/chapter"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/numbers_15/chapter/37" n="37"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/15/37">וַיֹּ֥אמֶר <j:divineName>יְהוָ֖ה</j:divineName> אֶל־מֹשֶׁ֥ה לֵּאמֹֽר:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/numbers_15/chapter/38" n="38"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/15/38">דַּבֵּ֞ר אֶל־בְּנֵ֤י יִשְׂרָאֵל֙ וְאָמַרְתָּ֣ אֲלֵהֶ֔ם וְעָשׂ֨וּ לָהֶ֥ם צִיצִ֛ת עַל־כַּנְפֵ֥י בִגְדֵיהֶ֖ם לְדֹרֹתָ֑ם וְנָ֥תְנוּ עַל־צִיצִ֥ת הַכָּנָ֖ף פְּתִ֥יל תְּכֵֽלֶת:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/numbers_15/chapter/39" n="39"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/15/39">וְהָיָ֣ה לָכֶם֮ לְצִיצִת֒ וּרְאִיתֶ֣ם אֹת֗וֹ וּזְכַרְתֶּם֙ אֶת־כָּל־מִצְוֹ֣ת <j:divineName>יְהוָ֔ה</j:divineName> וַעֲשִׂיתֶ֖ם אֹתָ֑ם וְלֹא תָת֜וּרוּ אַחֲרֵ֤י לְבַבְכֶם֙ וְאַחֲרֵ֣י עֵינֵיכֶ֔ם אֲשֶׁר־אַתֶּ֥ם זֹנִ֖ים אַחֲרֵיהֶֽם:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/numbers_15/chapter/40" n="40"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/15/40">לְמַ֣עַן תִּזְכְּר֔וּ וַעֲשִׂיתֶ֖ם אֶת־כָּל־מִצְוֹתָ֑י וִהְיִיתֶ֥ם קְדֹשִׁ֖ים לֵאלֹֽהֵיכֶֽם:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/numbers_15/chapter/41" n="41"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/15/41">אֲנִ֞י <j:divineName>יְהוָ֣ה</j:divineName> אֱלֹֽהֵיכֶ֗ם אֲשֶׁ֨ר הוֹצֵ֤אתִי אֶתְכֶם֙ מֵאֶ֣רֶץ מִצְרַ֔יִם לִהְי֥וֹת לָכֶ֖ם לֵאלֹהִ֑ים אֲנִ֖י <j:divineName>יְהוָ֥ה</j:divineName> אֱלֹהֵיכֶֽם:</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
