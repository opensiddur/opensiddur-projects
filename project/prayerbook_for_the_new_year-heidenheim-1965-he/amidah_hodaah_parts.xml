      <tei:div facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n29.jpg">
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:amidah/hodaah/modim"/><tei:choice><j:option corresp="urn:x-opensiddur:condition:prayer:amidah/hodaah/modim/heidenheim_1965_printing_1/earlier">מוֹדִים אֲנַחְנוּ לָךְ שָׁאַתָּה הוּא <j:divineName>יְיָ</j:divineName> אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ לְעוֹלָם וָעֶד. צוּר חַיֵּינוּ מָגֵן יִשְׁעֵנוּ אַתָּה הוּא לְדוֹר וָדוֹר נוֹדֶה לְךָ וּנְסַפֵּר תְּהִלָּתֶךָ עַל חַיֵּינוּ הַמְּסוּרִים בְּיָדֶךָ וְעַל נִשְׁמוֹתֵינוּ הַפְּקוּדוֹת לָךְ וְעַל נִסֶּיךָ שֶׁבְּכָל־יוֹם עִמָּנוּ וְעַל נִפְלְאוֹתֶיךָ</j:option><j:option corresp="urn:x-opensiddur:condition:prayer:amidah/hodaah/modim/heidenheim_1965_printing_1/kohanim_appendix">מוֹדִים אֲנַֽחְנוּ לָךְ שָׁאַתָּה הוּא <j:divineName>יְיָ</j:divineName> אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ לְעוֹלָם וָעֶד. צוּר חַיֵּֽינוּ מָגֵן יִשְׁעֵֽנוּ אַתָּה הוּא לְדוֹר וָדוֹר. נוֹדֶה לְךָ וּנְסַפֵּר תְּהִלָּתֶֽךָ עַל חַיֵּֽינוּ הַמְּסוּרִים בְּיָדֶֽךָ וְעַל נִשְׁמוֹתֵֽינוּ הַפְּקוּדוֹת לָךְ וְעַל <tei:pb ed="1965 rosh_hashanah/hosafot/birkat_kohanim/modim" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n347.jpg" n="22" xml:id="printing_kohanim_appendix_modim_s348"/>נִסֶּֽיךָ שֶׁבְּכָל־יוֹם עִמָּֽנוּ וְעַל נִפְלְאוֹתֶֽיךָ</j:option></tei:choice> <tei:choice><j:option corresp="urn:x-opensiddur:condition:prayer:amidah/hodaah/modim/heidenheim_1965_printing_2/earlier">וְטוֹבוֹתֶיךָ שֶׁבְּכָל־עֵת עֶרֶב וָבֹקֶר וְצָהֳרָיִם. הַטּוֹב כִּי לֹא־כָלוּ רַחֲמֶיךָ וְהַמְרַחֵם כִּי לֹא־תַמּוּ חֲסָדֶיךָ מֵעוֹלָם קִוִּינוּ לָךְ:</j:option><j:option corresp="urn:x-opensiddur:condition:prayer:amidah/hodaah/modim/heidenheim_1965_printing_2/kohanim_appendix">וְטוֹבוֹתֶֽיךָ שֶׁבְּכָל־עֵת עֶֽרֶב וָבֹֽקֶר וְצָהֳרָֽיִם הַטּוֹב כִּי לֹא־כָלוּ רַחֲמֶֽיךָ וְהַמְרַחֵם כִּי לֹא־תַֽמּוּ חֲסָדֶֽיךָ. מֵעוֹלָם קִוִּֽינוּ לָךְ.</j:option></tei:choice> </tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:amidah/hodaah/veal_kullam"/><tei:choice><j:option corresp="urn:x-opensiddur:condition:prayer:amidah/hodaah/veal_kullam/heidenheim_1965_printing_1/earlier">וְעַל כֻּלָּם יִתְבָּרַךְ וְיִתְרוֹמַם שִׁמְךָ מַלְכֵּנוּ תָּמִיד לְעוֹלָם וָעֶד:</j:option><j:option corresp="urn:x-opensiddur:condition:prayer:amidah/hodaah/veal_kullam/heidenheim_1965_printing_1/kohanim_appendix">וְעַל כֻּלָּם יִתְבָּרַךְ וְיִתְרוֹמַם שִׁמְךָ מַלְכֵּֽנוּ תָּמִיד לְעוֹלָם וָעֶד.</j:option></tei:choice> </tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:amidah/hodaah/ukhetov"/><tei:choice><j:option corresp="urn:x-opensiddur:condition:prayer:amidah/hodaah/ukhetov/heidenheim_1965_printing_1/earlier">וּכְתוֹב לְחַיִּים טוֹבִים כָּל־בְּנֵי בְרִיתֶךָ:</j:option><j:option corresp="urn:x-opensiddur:condition:prayer:amidah/hodaah/ukhetov/heidenheim_1965_printing_1/kohanim_appendix">וּכְתוֹב לְחַיִּים טוֹבִים כָּל־בְּנֵי בְרִיתֶֽךָ:</j:option></tei:choice> </tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/text/vekhol_hachayyim"/><tei:choice><j:option corresp="urn:x-opensiddur:condition:siddur:rosh_hashanah/text/vekhol_hachayyim/heidenheim_1965_printing_1/earlier">וְכֹל הַחַיִּים יוֹדוּךָ סֶּלָה וִיהַלְלוּ אֶת־שִׁמְךָ בֶּאֱמֶת הָאֵל יְשׁוּעָתֵנוּ וְעֶזְרָתֵנוּ סֶלָה. בָּרוּךְ אַתָּה <j:divineName>יְיָ</j:divineName> הַטּוֹב שִׁמְךָ וּלְךָ נָאֶה לְהוֹדוֹת:</j:option><j:option corresp="urn:x-opensiddur:condition:siddur:rosh_hashanah/text/vekhol_hachayyim/heidenheim_1965_printing_1/kohanim_appendix">וְכֹל הַחַיִּים יוֹדוּךָ סֶּֽלָה וִיהַלֲלוּ אֶת־שִׁמְךָ בֶּאֱמֶת הָאֵל יְשׁוּעָתֵֽנוּ וְעֶזְרָתֵֽנוּ סֶֽלָה. בָּרוּךְ אַתָּה <j:divineName>יְיָ</j:divineName> הַטּוֹב שִׁמְךָ וּלְךָ נָאֶה לְהוֹדוֹת:</j:option></tei:choice> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
