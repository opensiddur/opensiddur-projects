  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:shachar_avaqeshkha_gabirol" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n39.jpg">
        <tei:note type="description" xml:lang="he">בקשה ל<tei:choice><tei:abbr>ר׳</tei:abbr><tei:expan>רבי</tei:expan></tei:choice> שלמה בן גבירול. <tei:choice><tei:abbr>ב׳</tei:abbr><tei:expan>שתי</tei:expan></tei:choice> תנועות ויתד <tei:choice><tei:abbr>וב׳</tei:abbr><tei:expan>ושתי</tei:expan></tei:choice> תנועות.</tei:note>
        <tei:lg>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shachar_avaqeshkha_gabirol_39123/1"/>שַׁחַר אֲבַקֶּשְׁךָ. צוּרִי וּמִשְׂגַּבִּי. אֶעְרוֹךְ לְפָנֶיךָ. שַׁחְרִי וְגַם־עַרְבִּי: </tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shachar_avaqeshkha_gabirol_39123/2"/>לִפְנֵי גְדֻלָּתְךָ. אֶעְמֹד וְאֶבָּהֵל. כִּי־עֵינְךָ תִרְאֶה. כָּל־מַחְשְׁבוֹת לִבִּי: </tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shachar_avaqeshkha_gabirol_39123/3"/>מַה־זֶּה אֲשֶׁר יוּכַל. הַלֵּב וְהַלָּשׁוֹן לַעֲשׂוֹת, וּמַה־כֹּחִי. רוּחִי בְּתוֹךְ קִרְבִּי: </tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shachar_avaqeshkha_gabirol_39123/4"/>הִנֵּה לְךָ תִיטַב. זִמְרַת אֱנוֹשׁ, עַל־כֵּן אוֹדְךָ בְּעוֹד תִּהְיֶה. נִשְׁמַת אֱלוֹהַּ בִּי: <tei:milestone unit="stanza"/></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
