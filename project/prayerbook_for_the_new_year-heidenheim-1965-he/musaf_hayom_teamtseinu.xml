      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/hayom_teamtseinu" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n315.jpg">
        <tei:lg>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/1"/>הַיּוֹם תְּאַמְּצֵֽנוּ: <tei:milestone unit="stanza"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/hayom_teamtseinu/amen/teametz"/>אָמֵן: <tei:milestone unit="prayer-part"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/2"/>הַיּוֹם תְּבָרְכֵֽנוּ: <tei:milestone unit="stanza"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/hayom_teamtseinu/amen/tevarekh"/>אָמֵן: <tei:milestone unit="prayer-part"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/3"/>הַיּוֹם תְּגַדְּלֵֽנוּ: <tei:milestone unit="stanza"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/hayom_teamtseinu/amen/tegaddel"/>אָמֵן: <tei:milestone unit="prayer-part"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/4"/>הַיּוֹם תִּדְרְשֵֽׁנוּ לְטוֹבָה: <tei:milestone unit="stanza"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/hayom_teamtseinu/amen/tidrosh"/>אָמֵן: <tei:milestone unit="prayer-part"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/techaddesh"/>הַיּוֹם תְּחַדֵּשׁ עָלֵֽינוּ שָׁנָה טוֹבָה: <tei:milestone unit="stanza"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/hayom_teamtseinu/amen/techaddesh"/>אָמֵן: <tei:milestone unit="prayer-part"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/21"/>הַיּוֹם תִּשְׁמַע שַׁוְעָתֵֽנוּ: <tei:milestone unit="stanza"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/hayom_teamtseinu/amen/tishma"/>אָמֵן: <tei:milestone unit="prayer-part"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/teqabbel"/>הַיּוֹם תְּקַבֵּל בְּרַחֲמִים וּבְרָצוֹן אֶת תְּפִלָּתֵֽנוּ: <tei:milestone unit="stanza"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/hayom_teamtseinu/amen/teqabbel"/>אָמֵן: <tei:milestone unit="prayer-part"/></tei:l>
