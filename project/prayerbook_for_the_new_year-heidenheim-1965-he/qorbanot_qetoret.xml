    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:qorbanot/qetoret" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n54.jpg">
        <tei:p><tei:milestone unit="chapter" n="30"/><tei:milestone unit="verse" n="34" corresp="urn:x-opensiddur:text:bible:exodus/30/34"/><tei:seg source="urn:x-opensiddur:text:bible:exodus/30/34">וַיֹּאמֶר <j:divineName>יְהֹוָה</j:divineName> אֶל־מֹשֶׁה קַח־לְךָ סַמִּים נָטָף וּשְׁחֵלֶת וְחֶלְבְּנָה סַמִּים וּלְבֹנָה זַכָּה בַּד בְּבַד יִהְיֶה:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="chapter" n="30"/><tei:milestone unit="verse" n="35" corresp="urn:x-opensiddur:text:bible:exodus/30/35"/><tei:seg source="urn:x-opensiddur:text:bible:exodus/30/35">וְעָשִׂיתָ אֹתָהּ קְטֹרֶת רֹקַח מַעֲשֵׂה רוֹקֵחַ מְמֻלָּח טָהוֹר קֹדֶשׁ:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="chapter" n="30"/><tei:milestone unit="verse" n="36" corresp="urn:x-opensiddur:text:bible:exodus/30/36"/><tei:seg source="urn:x-opensiddur:text:bible:exodus/30/36">וְשָׁחַקְתָּ מִמֶּנָּה הָדֵק וְנָתַתָּה מִמֶּנָּה לִפְנֵי הָעֵדֻת בְּאֹהֶל מוֹעֵד אֲשֶׁר אִוָּעֵד לְךָ שָׁמָּה קֹדֶשׁ קָדָשִׁים תִּהְיֶה לָכֶם:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> וְנֶאֱמַר <tei:milestone unit="chapter" n="30"/><tei:milestone unit="verse" n="7" corresp="urn:x-opensiddur:text:bible:exodus/30/7"/><tei:seg source="urn:x-opensiddur:text:bible:exodus/30/7">וְהִקְטִיר עָלָיו אַהֲרֹן קְטֹרֶת סַמִּים בַּבֹּקֶר בַּבֹּקֶר בְּהֵיטִיבוֹ אֶת־הַנֵּרֹת יַקְטִירֶנָּה:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="chapter" n="30"/><tei:milestone unit="verse" n="8" corresp="urn:x-opensiddur:text:bible:exodus/30/8"/><tei:seg source="urn:x-opensiddur:text:bible:exodus/30/8">וּבְהַעֲלֹת אַהֲרֹן אֶת־הַנֵּרֹת בֵּין הָעַרְבַּיִם יַקְטִירֶנָּה קְטֹרֶת תָּמִיד לִפְנֵי <j:divineName>יְהֹוָה</j:divineName> לְדֹרֹתֵיכֶם:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> </tei:p>
      </tei:div>
