    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:efchad_bemaasai" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n277.jpg">
        <tei:p><tei:pb ed="1965 rosh_hashanah/musaf/repetition/efchad_bemaasai" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n277.jpg" n="129"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_1"/>אֶפְחַד בְּמַעֲשַׂי. אֶדְאַג בְּכָל עֵת. אִירָא בְּיוֹם דִּין. בְּבוֹאִי לְזִכָּרוֹן: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_2"/>אֶדְרוֹשׁ לְחַנּוּן. אֲחַלֶּה לְרַחוּם. אֲחַנֵּן לְחַק לִי. יוֹם לְזִכָּרוֹן: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_3"/>בְּבוֹאִי לְמִשְׁפָּט. בְּמִי אֶשָּׁעֵן. וּמִי יְחַפֶּשׂ לִי. צֶֽדֶק לְזִכָּרוֹן: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_4"/>בָּאָבוֹת בָּטַֽחְתִּי. וּפָעֳלָם אָכַֽלְתִּי. וְהֵם הָיוּ לִי. קֶֽדֶם לְזִכָּרוֹן: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_5"/>גָּבְרָה זְרוֹעִי. כְּשָׂח מְחֵנִי נָא. לְבַל יִמַּח מֶנִּי. שֵׁם וְזִכָּרוֹן: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_6"/>גֶּֽבֶר אִם יַעֲמוֹד לְפָנָיו הֲיוֹעִיל. בְּעֵת יְבֻקַּשׁ מֶנִּי. זְכוּת לְזִכָּרוֹן: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_7"/>דַּצְתִּי בְּלוֹבֵשׁ אֵפוֹד. וְחֹֽשֶׁן הַמִּשְׁפָּט. אֲשֶׁר בָּם הוּחַק. שְׁמִי לְזִכָּרוֹן: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_8"/>דִּלֵּג בְּמַחְתָּה. עַד יֵעָצֵר נֶֽגֶף. בְּגֶֽשֶׁת זָר מְכַהֵן. יָקוּד לְזִכָּרוֹן: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_9"/>הַבִּֽיטָה אֵל. בְּעָמְדִי לְפָנֶֽיךָ. אֵין בְּקִרְבִּי אֱנוֹשׁ. תָּוִי לְזִכָּרוֹן: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_10"/>הֲיֵשׁ מִי יְפַלֵּל. וְיָשִׁיב <tei:pb ed="1965 rosh_hashanah/musaf/repetition/efchad_bemaasai" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n279.jpg" n="130"/>חֵמָה. וְיוּחַק לַדּוֹרֹת. שְׁמוֹ לְזִכָּרוֹן: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_11"/>וּמִי שׂוֹנֵא בֶֽצַע. יְדַבֵּר עֲנוּ בִי. וַיַּעַן וְיֹאמַר עֵד. אָדוֹן לְזִכָּרוֹן: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_12"/>וּבְטָלֵה חָלָב. יְכַפֵּר בַּעֲדֵנוּ. וּכְנֶֽגֶד שְׁנֵי עֳפָרִים. יַעַל לְזִכָּרוֹן: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_13"/>זַֽעַף יֵרָא וְיֹאמַר. תְּהִי יָדְךָ בִי. אֲשֶׁר כְּלֵב אֱלֹהָיו. הוּא לְזִכָּרוֹן: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_14"/>זָעַק וְהֵשִׁיב. חֶֽרֶב אֶל נְדָנָהּ. וְהוּשַׁת לוֹ כַּשֶּֽׁמֶשׁ. כֵּס לְזִכָּרוֹן: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_15"/>חִכֵּתִי בְּעֵת עֶצֶר. לְפוֹתֵחַ וּמַמְטִיר. כְּמֵשִׁיב רוּחַ לַיֶּֽלֶד. אָבוּד מִזִּכָּרוֹן: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_16"/>חַי לִרְאוֹת בְּרִית. בְּדַבְּרוֹ קִנֵּאתִי. כִּי עָזְבוּ עָם. בְּרִית וְזִכָּרוֹן: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_17"/>טֶֽרֶם הָיָה לִי. מְכַפֵּר פָּנִים. מִנְחָה הֹלֶֽכֶת. כַּשֹּׁחַד לְזִכָּרוֹן: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_18"/>טֶֽרֶף נֵרְדְּ וְסַמִּים. לְמֵסַב חֲדָרָיו. דַּם וָחֵֽלֶב לְנִיחֹחַ. וְלֶֽחֶם הַפָּנִים לְזִכָּרוֹן: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_19"/>יֻצַּֽגְתִּי עַל גֶּחָלֵי רֵיקָה. כִּי לֹא אַלְמָן. שַׁתִּי לְזִכָּרוֹן: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_20"/>יָהּ אֶבְטַח בָּךְ. וְלֹא <tei:pb ed="1965 rosh_hashanah/musaf/repetition/efchad_bemaasai" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n281.jpg" n="131"/>בִּנְדִיבִים. כִּי הֵם בַּקֶּבֶר. וְלָנֶצַח שִׁמְךָ לְזִכָּרוֹן: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_21"/>כָּל אֵלֶּה סְמָכוּנִי. וְרַחֲמֶיךָ בִּקַּשְׁתִּי. לוּלֵא הֵם תַּמֹּתִי. וְאֵינִי לְזִכָּרוֹן: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_22"/>כִּי הֵם בִּזְרוֹעַ. עָדֶיךָ לֹא בָאוּ. רוֹמְמוּתֶיךָ בְּפִיהֶם. שָׂמוּ לְזִכָּרוֹן: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_23"/>לְיוֹם זֶה נִכְמָס. סֶכֶם חֶשְׁבּוֹנוֹת. תְּחִלָּה לְיָמִים. וְרֹאשׁ לְזִכָּרֹן: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_24"/>לְהִקָּרֵא בוֹ. כְּתַב עֵט וְשָׁמִיר. גָּלוּי וּבָאֵר. וְיָדוּעַ לְזִכָּרוֹן: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_25"/>מָוֶת וְחַיִּים. שָׁלוֹם וּמִלְחָמוֹת. צַחֲצָחוֹת וָשׂוֹבַע. בָּאִים לְזִכָּרוֹן: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_26"/>מַעַלְלֵי גֶבֶר. וּמִסְפַּר צְעָדָיו. נִשְׁכְּחוּ מֵאֱנוֹשׁ. וְלָאֵל לְזִכָּרוֹן: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_27"/>נִסְתְּרָה דַרְכִּי. מִי יוּכַל שִׂיחַ. לַשָּׁוְא נִכְתַּב לִי. חֵטְא לְזִכָּרוֹן: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_28"/>נֶגֶד פְּנֵי גֶבֶר. מַעֲשָׂיו יוֹכִיחוּ. וְיַעֲנֶה בּוֹ כַּחֲשׁוֹ. עֵד לְזִכָּרוֹן: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_29"/>שִׂיחוּ מְזִמּוֹת אֵל. יַחַד כָּל בְּנֵי אִישׁ. עוֹבְרֵי תַּחַת שֵׁבֶט. כַּצֹּאן לְזִכָּרוֹן: <tei:milestone unit="stanza"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_30"/>סוֹגֵר <tei:pb ed="1965 rosh_hashanah/musaf/repetition/efchad_bemaasai" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n283.jpg" n="132"/>דֶּלֶת. בְּעַד תְּמִימִים בְּזַעַם. עַד בֹּא קִצָּם. צֵאת לְזִכָּרוֹן: <tei:milestone unit="stanza"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_genesis_8_1/intro_1"/>כַּכָּתוּב בְּתוֹרָתֶךָ <tei:milestone unit="prayer-part"/><tei:milestone unit="chapter" n="8" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_genesis_8_1/quotes/genesis_8_1/genesis_8"/><tei:milestone unit="verse" n="1" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_genesis_8_1/quotes/genesis_8_1/genesis_8/1"/><tei:seg source="urn:x-opensiddur:text:bible:genesis/8/1">וַיִּזְכֹּר אֱלֹהִים אֶת־נֹחַ וְאֵת כָּל־הַחַיָּה וְאֶת־כָּל־הַבְּהֵמָה אֲשֶׁר אִתּוֹ בַּתֵּבָה וַיַּעֲבֵר אֱלֹהִים רוּחַ עַל־הָאָרֶץ וַיָּשֹׁכּוּ הַמָּיִם:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_31"/>עֲשֵׂה פֶלֶא לְחַיִּים. לְבַל יִהְיוּ כַּמֵּתִים. הֲיֵשׁ אֲמִתֶּךָ. בַּקֶּבֶר לְזִכָּרוֹן: <tei:milestone unit="stanza"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_32"/>עוֹרַרְתָּ אָז בְּפֹעַל. עוֹרְרֵנוּ בְּלֹא פֹעַל. הֲלֹא לְנִפְלְאוֹתֶיךָ. תַּעַשׂ לְזִכָּרוֹן: <tei:milestone unit="stanza"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_psalms_111_4_5/intro_1"/>כַּכָּתוּב בְּדִבְרֵי קָדְשֶׁךָ <tei:milestone unit="prayer-part"/><tei:milestone unit="chapter" n="111" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_psalms_111_4_5/quotes/psalms_111_4/psalms_111"/><tei:milestone unit="verse" n="4" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_psalms_111_4_5/quotes/psalms_111_4/psalms_111/4"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/111/4">זֵכֶר עָשָׂה לְנִפְלְאוֹתָיו חַנּוּן וְרַחוּם <j:divineName>יְיָ</j:divineName>:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_psalms_111_4_5/intro_2"/>וְנֶאֱמַר <tei:milestone unit="prayer-part"/><tei:milestone unit="chapter" n="111" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_psalms_111_4_5/quotes/psalms_111_5/psalms_111"/><tei:milestone unit="verse" n="5" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_psalms_111_4_5/quotes/psalms_111_5/psalms_111/5"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/111/5">טֶרֶף נָתַן לִירֵאָיו יִזְכֹּר לְעֹלָם בְּרִיתוֹ:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_33"/>פְּנֵה אֱלֹהִים. בְּיוֹשְׁבֵי גַנִּים. מַקְשִׁיב לְנִדְבָּרֵימוֹ. בְּדַת לְזִכָּרוֹן: <tei:milestone unit="stanza"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_34"/>פָּעֳלָם לְפָנֶיךָ. וּשְׂכָרָם אִתָּךְ. אוֹכְלֵי לֶחֶם הָעֲצָבִים. בַּסֵּפֶר לְזִכָּרוֹן: <tei:milestone unit="stanza"/><tei:pb ed="1965 rosh_hashanah/musaf/repetition/efchad_bemaasai" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n285.jpg" n="133"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_malachi_3_16/intro_1"/>כַּכָּתוּב עַל־יַד נְבִיאֶךָ <tei:milestone unit="prayer-part"/><tei:milestone unit="chapter" n="3" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_malachi_3_16/quotes/malachi_3_16/malachi_3"/><tei:milestone unit="verse" n="16" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_malachi_3_16/quotes/malachi_3_16/malachi_3/16"/><tei:seg source="urn:x-opensiddur:text:bible:malachi/3/16">אָז נִדְבְּרוּ יִרְאֵי <j:divineName>יְיָ</j:divineName> אִישׁ אֶל רֵעֵהוּ וַיַּקְשֵׁב <j:divineName>יְיָ</j:divineName> וַיִּשְׁמָע וַיִּכָּתֵב סֵפֶר זִכָּרוֹן לְפָנָיו לְיִרְאֵי <j:divineName>יְיָ</j:divineName> וּלְחוֹשְׁבֵי שְׁמוֹ:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_35"/>צָצוּ שֻׁעָלִים. מְחַבְּלִים כְּרָמִים. לְהַכְרִית מִגֶּפֶן. שֹׁרֶשׁ וְזִכָּרוֹן: <tei:milestone unit="stanza"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_36"/>צְרָרוּם בְּפֶרֶךְ. נָאֲקוּ וְנוֹשָׁעוּ. בְּכֹשֶׁר הֲרָרֵי קֶדֶם. הוּחַק לְזִכָּרוֹן: <tei:milestone unit="stanza"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_exodus_2_24/intro_1"/>כַּכָּתוּב בְּתוֹרָתֶךָ <tei:milestone unit="prayer-part"/><tei:milestone unit="chapter" n="2" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_exodus_2_24/quotes/exodus_2_24/exodus_2"/><tei:milestone unit="verse" n="24" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_exodus_2_24/quotes/exodus_2_24/exodus_2/24"/><tei:seg source="urn:x-opensiddur:text:bible:exodus/2/24">וַיִּשְׁמַע אֱלֹהִים אֶת־נַאֲקָתָם וַיִּזְכֹּר אֱלֹהִים אֶת־בְּרִיתוֹ אֶת־אַבְרָהָם אֶת־יִצְחָק וְאֶת־יַעֲקֹב:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_37"/>קֶדֶם בַּנְתָּה לַדּוֹרוֹת. אֵין בָּהֶם חֵפֶץ. חִלַּפְתָּם וְאִבַּדְתָּם. מִהְיוֹת לְזִכָּרוֹן: <tei:milestone unit="stanza"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_38"/>קֲחְתָּה דּוֹר מֵאֶלֶף. אֲמָרֶיךָ הִנְחַלְתָּם. לְמַעֲנָם בְּכָל דּוֹר. חַקְתָּה לְזִכָּרוֹן: <tei:milestone unit="stanza"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_psalms_105_8/intro_1"/>כַּכָּתוּב בְּדִבְרֵי קָדְשֶׁךָ <tei:milestone unit="prayer-part"/><tei:milestone unit="chapter" n="105" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_psalms_105_8/quotes/psalms_105_8/psalms_105"/><tei:milestone unit="verse" n="8" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_psalms_105_8/quotes/psalms_105_8/psalms_105/8"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/105/8">זָכַר לְעֹלָם בְּרִיתוֹ דָּבָר צִוָּה לְאֶלֶף דּוֹר:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:pb ed="1965 rosh_hashanah/musaf/repetition/efchad_bemaasai" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n287.jpg" n="134"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_39"/>רָם חָשַׁק מְאֹד. בְּכַלַּת נְעוּרִים. הֲרוּגֶיהָ וַעֲנִיֶּיהָ. תַּתָּה לְזִכָּרוֹן: <tei:milestone unit="stanza"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_40"/>רָצָה אַחֲרֶיךָ. בְּגֵיא צִיָּה וְצַלְמָוֶת. אַהֲבַת כְּלוּלוֹתֶיהָ. תַּעַשׂ לְזִכָּרוֹן: <tei:milestone unit="stanza"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_jeremiah_2_2/intro_1"/>כַּכָּתוּב עַל יַד נְבִיאֶךָ <tei:milestone unit="prayer-part"/><tei:milestone unit="chapter" n="2" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_jeremiah_2_2/quotes/jeremiah_2_2/jeremiah_2"/><tei:milestone unit="verse" n="2" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_jeremiah_2_2/quotes/jeremiah_2_2/jeremiah_2/2"/><tei:seg source="urn:x-opensiddur:text:bible:jeremiah/2/2">הָלֹךְ וְקָרָאתָ בְאָזְנֵי יְרוּשָׁלַֽ͏ִם לֵאמֹר כֹּה אָמַר <j:divineName>יְיָ</j:divineName> זָכַרְתִּי לָךְ חֶסֶד נְעוּרַיִךְ אַהֲבַת כְּלוּלֹתָיִךְ לֶכְתֵּךְ אַחֲרַי בַּמִּדְבָּר בְּאֶרֶץ לֹא זְרוּעָה:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_41"/>שִׁחֲתוּ עַם זוּ. שְׂאֵת שִׁמְצָה בְּקָמֵיהֶם. שֵׂם פֶּסֶל וְלֹא אֵל. שָׁתוּ לְזִכָּרוֹן: <tei:milestone unit="stanza"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_42"/>שֶׁכָּלוּ כִּמְעַט רֶגַע. לוּלֵי קָם בַּפֶּרֶץ. מְעוֹרֵר שְׁבוּעָה. וּבְרִית לְזִכָּרוֹן: <tei:milestone unit="stanza"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_exodus_32_13/intro_1"/>כַּכָּתוּב בְּתוֹרָתֶךָ <tei:milestone unit="prayer-part"/><tei:milestone unit="chapter" n="32" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_exodus_32_13/quotes/exodus_32_13/exodus_32"/><tei:milestone unit="verse" n="13" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_exodus_32_13/quotes/exodus_32_13/exodus_32/13"/><tei:seg source="urn:x-opensiddur:text:bible:exodus/32/13">זְכֹר לְאַבְרָהָם לְיִצְחָק וּלְיִשְׂרָאֵל עֲבָדֶיךָ אֲשֶׁר נִשְׁבַּעְתָּ לָהֶם בָּךְ וַתְּדַבֵּר אֲלֵהֶם אַרְבֶּה אֶת־זַרְעֲכֶם כְּכֹכְבֵי הַשָּׁמָיִם וְכָל הָאָרֶץ הַזֹּאת אֲשֶׁר אָמַרְתִּי אֶתֵּן לְזַרְעֲכֶם וְנָחֲלוּ לְעֹלָם:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_43"/>תִּעַבְתָּ מֵאָז. עֲדַת כָּל לְאֻמִּים. חֲשַׁקְתָּנוּ מֵהֶם. <tei:pb ed="1965 rosh_hashanah/musaf/repetition/efchad_bemaasai" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n289.jpg" n="135"/>עֵדוּת לְזִכָּרוֹן: <tei:milestone unit="stanza"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_44"/>תְּמוּר כֶּסֶף נִמְאָס. דּוֹר נִשְׁכַּח קַחְתָּ. קְנֵנוּ שֵׁנִית. כִּי שֻׁכַּחְנוּ מִזִּכָּרוֹן: <tei:milestone unit="stanza"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_psalms_74_2/intro_1"/>כַּכָּתוּב בְּדִבְרֵי קָדְשֶׁךָ <tei:milestone unit="prayer-part"/><tei:milestone unit="chapter" n="74" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_psalms_74_2/quotes/psalms_74_2/psalms_74"/><tei:milestone unit="verse" n="2" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_psalms_74_2/quotes/psalms_74_2/psalms_74/2"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/74/2">זְכֹר עֲדָתְךָ קָנִיתָ קֶדֶם גָּאַלְתָּ שֵׁבֶט נַחֲלָתֶךָ הַר צִיּוֹן זֶה שָׁכַנְתָּ בּוֹ:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_45"/>תָּר אִישׁ תָּם בְּמִי זַרְעוֹ יְכֻנֶּה. שִׂכֵּל יָדָיו. לְאוֹת וְזִכָּרוֹן: <tei:milestone unit="stanza"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_46"/>תְּרַפֵּק מְשׁוּל אֶפְרַיִם. בְּשַׁעֲשׁוּעַ יֶלֶד וּבֵן יַקִּיר. הֲלֹא בְּכוֹרִי הוּא. חַקְתָּ לְזִכָּרוֹן: <tei:milestone unit="stanza"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
