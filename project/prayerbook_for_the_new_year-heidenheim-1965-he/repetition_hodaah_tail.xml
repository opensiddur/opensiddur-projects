    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/hodaah/tail" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n154.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n154.jpg" n="66"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/hodaah/tail/veall_kullam"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/hodaah/veal_kullam">וְעַל־כֻּלָּם יִתְבָּרַךְ וְיִתְרוֹמָם שִׁמְךָ מַלְכֵּנוּ תָּמִיד לְעוֹלָם וָעֶד:</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/hodaah/tail/ukhetov"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/hodaah/ukhetov">וּכְתוֹב לְחַיִּים טוֹבִים כָּל־בְּנֵי בְרִיתֶךָ:</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/hodaah/tail/vekhol_hachayyim"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/hodaah/hatov_shimkha">וְכֹל הַחַיִּים יוֹדוּךָ סֶּלָה וִיהַלְלוּ אֶת־שִׁמְךָ בֶּאֱמֶת הָאֵל יְשׁוּעָתֵנוּ וְעֶזְרָתֵנוּ סֶלָה. בָּרוּךְ אַתָּה <j:divineName>יְיָ</j:divineName> הַטּוֹב שִׁמְךָ וּלְךָ נָאֶה לְהוֹדוֹת:</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
