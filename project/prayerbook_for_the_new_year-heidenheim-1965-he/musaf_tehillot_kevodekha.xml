  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:tehillot_kevodekha" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n245.jpg">
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tehillot_kevodekha/tehillot"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> תְּהִלּוֹת כְּבוֹדְךָ, אָמְצְךָ מְלֹא כָל הָאָרֶץ. שִׁמְעֲךָ דִּין מִשָּׁמַיִם, בְּכֵן יָרְאָה וְשָׁקְטָה הָאָרֶץ. רַעַשׁ יוֹם מִשְׁפָּט, <tei:choice xml:id="musaf_tehillot_kevodekha_source_variant_1"><j:option corresp="urn:x-opensiddur:condition:poem:tehillot_kevodekha/tehillot/gaashu">גָּעֲשׁוּ</j:option><j:option corresp="urn:x-opensiddur:condition:poem:tehillot_kevodekha/tehillot/geash">גֵּעַשׁ</j:option></tei:choice> תְּהוֹמוֹת הָאָרֶץ. קוֹל שׁוֹפָר חָזָק, דִּבֵּר וַיִּקְרָא אָרֶץ. צְבִי לַצַּדִּיק בְּזֶמֶר, הִשְׁמִיעָה כְּנַף הָאָרֶץ. פַּחַד וָפַחַת וָפַח, וּפַלָּצוּת יַבְעִיתוּ אָרֶץ. עֵת תָּקוּם לַמִּשְׁפָּט, זְעוֹם כָּל אַפְסֵי אָרֶץ.  <tei:milestone unit="stanza"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tehillot_kevodekha/sollu_pannu"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> <tei:choice xml:id="musaf_tehillot_kevodekha_source_variant_2"><j:option corresp="urn:x-opensiddur:condition:poem:tehillot_kevodekha/sollu_pannu/sollu_pannu">סֹלּוּ פַּנּוּ</j:option><j:option corresp="urn:x-opensiddur:condition:poem:tehillot_kevodekha/sollu_pannu/suru_minni">סוּרוּ מִנִּי</j:option></tei:choice> דֶּרֶךְ יְנוֹבְבוּ, חֲרֵדִים מֵחֶרְדַּת הָאָרֶץ. נָאוֹר וְאַדִּיר, טַעַם תָּשִׁיב לָאָרֶץ. מַה תִּירְאִי אֲדָמָה, יָרִיעוּ תַּחְתִּיֹּת אָרֶץ: <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tehillot_kevodekha/lehitvadda"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>קו״ח</tei:abbr><tei:expan>קהל וחזן</tei:expan></tei:choice></tei:note> לְהִתְוַדַּע וּלְהִגָּלוֹת, כִּי הוּא מֶלֶךְ עַל כָּל הָאָרֶץ. כְּמוֹ פֵּאֲרוּהוּ מֵאָז בַּשַּׁחַק, יֻרְשׁוּ בְּחוּנָיו לְפָאֲרוֹ בָּאָרֶץ: <tei:milestone unit="stanza"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
