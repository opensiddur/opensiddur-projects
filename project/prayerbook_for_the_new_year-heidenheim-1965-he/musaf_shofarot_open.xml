    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/shofarot_open" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n213.jpg">
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/shofarot_open/text"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/attah_nigleita">אַתָּה נִגְלֵיתָ בַּעֲנַן כְּבוֹדֶךָ עַל עַם קָדְשְׁךָ לְדַבֵּר עִמָּם מִן הַשָּׁמַיִם הִשְׁמַעְתָּם קוֹלֶךָ וְנִגְלֵיתָ עֲלֵיהֶם בְּעַרְפַלֵּי־טֹהַר. גַּם </tei:seg> <j:conditional type="marked" xml:id="musaf_shofarot_open_segment_1"><j:all><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/attah_nigleita/kol"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional><tei:seg source="urn:x-opensiddur:text:prayer:amidah/attah_nigleita">כָּל</tei:seg> <j:endConditional target="#musaf_shofarot_open_segment_1"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/attah_nigleita"> הָעוֹלָם כֻּלּוֹ חָל מִפָּנֶיךָ וּבְרִיּוֹת בְּרֵאשִׁית חָרְדוּ מִמֶּךָ בְּהִגָּלוֹתְךָ מַלְכֵּנוּ עַל־הַר סִינַי לְלַמֵּד לְעַמְּךָ תּוֹרָה וּמִצְווֹת. וַתַּשְׁמִיעֵם אֶת־הוֹד קוֹלֶךָ וְדִבְּרוֹת קָדְשְׁךָ מִלַּהֲבוֹת אֵשׁ, בְּקֹלוֹת וּבְרָקִים עֲלֵיהֶם נִגְלֵיתָ וּבְקוֹל שֹׁפָר עֲלֵיהֶם הוֹפָעְתָּ: כַּכָּתוּב בְּתוֹרָתֶךָ,</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
