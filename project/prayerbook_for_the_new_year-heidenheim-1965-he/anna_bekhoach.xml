  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:anna_bekhoach" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n55.jpg">
        <tei:lg>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:anna_bekhoach/1"/>אָנָּא בְּכֹחַ גְּדֻלַּת יְמִינְךָ תַּתִּיר צְרוּרָה. </tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:anna_bekhoach/2"/>קַבֵּל רִנַּת עַמְּךָ שַׂגְּבֵנוּ טַהֲרֵנוּ נוֹרָא. </tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:anna_bekhoach/3"/>נָא גִבּוֹר דּוֹרְשֵׁי יִחוּדְךָ כְּבָבַת שָׁמְרֵם. </tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:anna_bekhoach/4"/>בָּרְכֵם טַהֲרֵם רַחֲמֵם צִדְקָתְךָ תָּמִיד גָּמְלֵם: </tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:anna_bekhoach/5"/>חֲסִין קָדוֹשׁ בְּרֹב טוּבְךָ נַהֵל עֲדָתֶךָ. </tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:anna_bekhoach/6"/>יָחִיד גֵּאֶה לְעַמְּךָ פְנֵה זוֹכְרֵי קְדֻשָּׁתֶךָ. </tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:anna_bekhoach/7"/>שַׁוְעָתֵנוּ קַבֵּל וּשְׁמַע צַעֲקָתֵנוּ יוֹדֵעַ תַּעֲלֻמוֹת. <tei:milestone unit="stanza"/></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
