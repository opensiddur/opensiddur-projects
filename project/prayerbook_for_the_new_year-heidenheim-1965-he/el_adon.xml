      <tei:div corresp="urn:x-opensiddur:text:poem:el_adon" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n101.jpg">
        <j:conditional xml:id="el_adon_condition">
          <j:all>
            <tei:fs type="opensiddur:holiday-aggregate">
              <tei:f name="shabbat">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:all>
        </j:conditional>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_adon/1"/>אֵל אָדוֹן עַל כָּל־הַמַּעֲשִׂים. בָּרוּךְ וּמְבֹרָךְ בְּפִי כָל־נְשָׁמָה: גָּדְלוֹ וְטוּבוֹ מָלֵא עוֹלָם. דַּעַת וּתְבוּנָה סוֹבְבִים אוֹתוֹ:  <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_adon/2"/>הַמִּתְגָּאֶה עַל־חַיּוֹת הַקֹּדֶשׁ. וְנֶהְדָּר בְּכָבוֹד עַל־הַמֶּרְכָּבָה: <j:conditional xml:id="el_adon_segment_2"><tei:note type="instruction" xml:lang="de-Hebr">אַם שַׁבָּת.</tei:note><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n103.jpg" n="38"/>זְכוּת וּמִישׁוֹר לִפְנֵי כִסְאוֹ. חֶסֶד וְרַחֲמִים לִפְנֵי כְבוֹדוֹ:  <j:endConditional target="#el_adon_segment_2"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_adon/3"/>טוֹבִים מְאוֹרוֹת שֶׁבָּרָא אֱלֹהֵינוּ. יְצָרָם בְּדַעַת בְּבִינָה וּבְהַשְׂכֵּל: כֹּחַ וּגְבוּרָה נָתַן בָּהֶם. לִהְיוֹת מוֹשְׁלִים בְּקֶרֶב תֵּבֵל:  <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_adon/4"/>מְלֵאִים זִיו וּמְפִיקִים נֹגַהּ. נָאֶה זִיוָם בְּכָל־הָעוֹלָם. שְׂמֵחִים בְּצֵאתָם וְשָׂשִׂים בְּבוֹאָם. עוֹשִׂים בְּאֵימָה רְצוֹן קוֹנָם:  <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_adon/5"/>פְּאֵר וְכָבוֹד נוֹתְנִים לִשְׁמוֹ. צָהֳלָה וְרִנָּה לְזֵכֶר מַלְכוּתוֹ: קָרָא לַשֶּׁמֶשׁ וַיִּזְרַח־אוֹר. רָאָה וְהִתְקִין צוּרַת הַלְּבָנָה:  <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_adon/6"/>שֶׁבַח נוֹתְנִים לוֹ כָּל־צְבָא מָרוֹם. תִּפְאֶרֶת וּגְדֻלָּה שְׂרָפִים וְאוֹפַנִּים וְחַיּוֹת הַקֹּדֶשׁ: <tei:milestone unit="stanza"/></tei:p>
        <j:endConditional target="#el_adon_condition"/>
      </tei:div>
