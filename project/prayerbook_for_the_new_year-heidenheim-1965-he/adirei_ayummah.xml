  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:adirei_ayummah" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n141.jpg">
        <tei:note type="description" xml:lang="he"><tei:choice><tei:abbr>ש״ץ</tei:abbr><tei:expan>שליח צבור</tei:expan></tei:choice> מנגן. והקהל חוזר.</tei:note>
        <tei:note type="description" xml:lang="he">ע״ס א״ב משולש.</tei:note>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n141.jpg" n="57"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/1"/>אַדִּירֵי אֲיֻמָּה יַאְדִּירוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מֶלֶךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/2"/>בְּרוּאֵי בָרָק יְבָרְכוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מָלָךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/3"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> גִּבּוֹרֵי גֹבַהּ יַגְבִּירוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> יִמְלֹךְ: <j:divineName>יְיָ</j:divineName> מֶלֶךְ <j:divineName>יְיָ</j:divineName> מָלָךְ <tei:milestone unit="chapter" n="15" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/quotations/refrain_3/chapter"/><tei:milestone unit="verse" n="18" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/quotations/refrain_3/chapter/18"/><tei:seg source="urn:x-opensiddur:text:bible:exodus/15/18"><j:divineName>יְיָ</j:divineName> יִמְלֹךְ לְעֹלָם וָעֶד:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/4"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> דּוֹהֲרֵי דוֹלְקִים יְדוֹבְבוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מֶלֶךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/5"/>הֲמוֹנֵי הֲמֻלָּה יְהַלְלוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מָלָךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/6"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> וַחֲיָלִים וְחַיּוֹת יְוַעֲדוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> יִמְלֹךְ: <j:divineName>יְיָ</j:divineName> מֶלֶךְ <j:divineName>יְיָ</j:divineName> מָלָךְ <tei:milestone unit="chapter" n="15" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/quotations/refrain_6/chapter"/><tei:milestone unit="verse" n="18" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/quotations/refrain_6/chapter/18"/><tei:seg source="urn:x-opensiddur:text:bible:exodus/15/18"><j:divineName>יְיָ</j:divineName> יִמְלֹךְ לְעֹלָם וָעֶד:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/7"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> זוֹכְרֵי זְמִירוֹת יְזַמְּרוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מֶלֶךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/8"/>חַכְמֵי חִידוֹת יְחַסְּנוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מָלָךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/9"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> טַפְסְרֵי טְפוּחִים יְטַכְּסוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> יִמְלֹךְ: <j:divineName>יְיָ</j:divineName> מֶלֶךְ <j:divineName>יְיָ</j:divineName> מָלָךְ <tei:milestone unit="chapter" n="15" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/quotations/refrain_9/chapter"/><tei:milestone unit="verse" n="18" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/quotations/refrain_9/chapter/18"/><tei:seg source="urn:x-opensiddur:text:bible:exodus/15/18"><j:divineName>יְיָ</j:divineName> יִמְלֹךְ לְעֹלָם וָעֶד:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/10"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> יוֹרְשֵׁי יְקָרָה יְיַשְּׁרוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מֶלֶךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/11"/>כַּבִּירֵי כֹחַ יַכְתִּירוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מָלָךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/12"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> לְבוּשֵׁי לֶהָבוֹת יְלַבְּבוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> יִמְלֹךְ: <j:divineName>יְיָ</j:divineName> מֶלֶךְ <j:divineName>יְיָ</j:divineName> מָלָךְ <tei:milestone unit="chapter" n="15" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/quotations/refrain_12/chapter"/><tei:milestone unit="verse" n="18" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/quotations/refrain_12/chapter/18"/><tei:seg source="urn:x-opensiddur:text:bible:exodus/15/18"><j:divineName>יְיָ</j:divineName> יִמְלֹךְ לְעֹלָם וָעֶד:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/13"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> מַנְעִימֵי מֶלֶל יְמַלְּלוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מֶלֶךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/14"/>נִצְּצֵי נֹגַהּ יְנַצְּחוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מָלָךְ: </tei:p>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n143.jpg" n="58"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/15"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> שְׂרָפִים סוֹבְבִים יְסַלְסְלוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> יִמְלֹךְ: <j:divineName>יְיָ</j:divineName> מֶלֶךְ <j:divineName>יְיָ</j:divineName> מָלָךְ <tei:milestone unit="chapter" n="15" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/quotations/refrain_15/chapter"/><tei:milestone unit="verse" n="18" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/quotations/refrain_15/chapter/18"/><tei:seg source="urn:x-opensiddur:text:bible:exodus/15/18"><j:divineName>יְיָ</j:divineName> יִמְלֹךְ לְעֹלָם וָעֶד:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/16"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> עוֹרְכֵי עֹז יַעֲנוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מֶלֶךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/17"/>פְּחוּדֵי פְלָאֶיךָ יְפַצְּחוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מָלָךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/18"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> צִבְאוֹת צֹאנְךָ יְצַלְצְלוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> יִמְלֹךְ: <j:divineName>יְיָ</j:divineName> מֶלֶךְ <j:divineName>יְיָ</j:divineName> מָלָךְ <tei:milestone unit="chapter" n="15" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/quotations/refrain_18/chapter"/><tei:milestone unit="verse" n="18" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/quotations/refrain_18/chapter/18"/><tei:seg source="urn:x-opensiddur:text:bible:exodus/15/18"><j:divineName>יְיָ</j:divineName> יִמְלֹךְ לְעֹלָם וָעֶד:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/19"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> קְהִלּוֹת קֹדֶשׁ יַקְדִּישׁוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מֶלֶךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/20"/>רִבְבוֹת רְבָבָה יְרַנְּנוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מָלָךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/21"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> שְׁבִיבֵי שַׁלְהָבוֹת יְשַׁנְּנוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> יִמְלֹךְ: <j:divineName>יְיָ</j:divineName> מֶלֶךְ <j:divineName>יְיָ</j:divineName> מָלָךְ <tei:milestone unit="chapter" n="15" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/quotations/refrain_21/chapter"/><tei:milestone unit="verse" n="18" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/quotations/refrain_21/chapter/18"/><tei:seg source="urn:x-opensiddur:text:bible:exodus/15/18"><j:divineName>יְיָ</j:divineName> יִמְלֹךְ לְעֹלָם וָעֶד:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/22"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> תּוֹמְכֵי תְהִלּוֹת יַתְמִידוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מֶלֶךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/23"/>תּוֹקְפֵי תִפְאַרְתֶּךָ יְתַמִּימוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מָלָךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/24"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>קו״ח</tei:abbr><tei:expan>קהל וחזן</tei:expan></tei:choice></tei:note> תְּמִימֵי תְעוּדָה יְתַנּוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> יִמְלֹךְ: <j:divineName>יְיָ</j:divineName> מֶלֶךְ <j:divineName>יְיָ</j:divineName> מָלָךְ <tei:milestone unit="chapter" n="15" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/quotations/refrain_24/chapter"/><tei:milestone unit="verse" n="18" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/quotations/refrain_24/chapter/18"/><tei:seg source="urn:x-opensiddur:text:bible:exodus/15/18"><j:divineName>יְיָ</j:divineName> יִמְלֹךְ לְעֹלָם וָעֶד:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="stanza"/></tei:p>
      </tei:div>
    </tei:body>
