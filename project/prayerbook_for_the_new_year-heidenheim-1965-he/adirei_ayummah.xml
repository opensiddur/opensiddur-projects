    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:adirei_ayummah" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n141.jpg">
        <tei:note type="description" xml:lang="he">ש״ץ מנגן. והקהל חוזר.</tei:note>
        <tei:note type="description" xml:lang="he">ע״ס א״ב משולש.</tei:note>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n141.jpg" n="57"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/1"/>אַדִּירֵי אֲיֻמָּה יַאֲדִירוּךָ בְקוֹל. <j:divineName>יְיָ</j:divineName> מֶלֶךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/2"/>בְּרוּאֵי בָרָק יְבָרְכוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מָלָךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/3"/>גִּבּוֹרֵי גֹבַהּ יַגְבִּירוּךָ בְקוֹל. <j:divineName>יְיָ</j:divineName> יִמְלֹךְ: <j:divineName>יְיָ</j:divineName> מֶלֶךְ <j:divineName>יְיָ</j:divineName> מָלָךְ <j:divineName>יְיָ</j:divineName> יִמְלֹךְ לְעוֹלָם וָעֶד: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/4"/>דּוֹהֲרֵי דוֹלְקִים יְדוֹבְבוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מֶלֶךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/5"/>הֲמוֹנֵי הֲמֻלָּה יְהַלְלוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מָלָךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/6"/>וְחַיִל וְחַיוֹת יָעִידוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> יִמְלֹךְ: <j:divineName>יְיָ</j:divineName> מֶלֶךְ <j:divineName>יְיָ</j:divineName> מָלָךְ <j:divineName>יְיָ</j:divineName> יִמְלֹךְ לְעוֹלָם וָעֶד: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/7"/>זוֹכְרֵי זְמִירוֹת יְזַמְּרוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מֶלֶךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/8"/>חַכְמֵי חִידוֹת יְחַפְּנוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מָלָךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/9"/>טַפְסְרֵי טְפוּחִים יְטַכְּסוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> יִמְלֹךְ: <j:divineName>יְיָ</j:divineName> מֶלֶךְ <j:divineName>יְיָ</j:divineName> מָלָךְ <j:divineName>יְיָ</j:divineName> יִמְלֹךְ לְעוֹלָם וָעֶד: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/10"/>יוֹרְשֵׁי יְקָרָה יְיַשְׁרוּךָ בְקוֹל. <j:divineName>יְיָ</j:divineName> מֶלֶךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/11"/>כַּבִּירֵי כֹחַ יְכַתְּרוּךָ בְקוֹל. <j:divineName>יְיָ</j:divineName> מָלָךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/12"/>לְבוּשֵׁי לַהֲבוֹת יְלַבְּנוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> יִמְלֹךְ: <j:divineName>יְיָ</j:divineName> מֶלֶךְ <j:divineName>יְיָ</j:divineName> מָלָךְ <j:divineName>יְיָ</j:divineName> יִמְלֹךְ לְעוֹלָם וָעֶד: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/13"/>מַטְעִימֵי מֶלֶל יְמַלְּלוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מֶלֶךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/14"/>נִצּוֹצֵי נֹגַהּ יְנַצְּחוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מָלָךְ: </tei:p>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n143.jpg" n="58"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/15"/>שְׂרָפִים סוֹבְבִים יְסַלְסְלוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> יִמְלֹךְ: <j:divineName>יְיָ</j:divineName> מֶלֶךְ <j:divineName>יְיָ</j:divineName> מָלָךְ <j:divineName>יְיָ</j:divineName> יִמְלֹךְ לְעוֹלָם וָעֶד: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/16"/>עוֹרְכֵי עֹז יַעֲנוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מֶלֶךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/17"/>פַּחֲדֵי פְלָאֶיךָ יְפַצְּחוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מָלָךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/18"/>צִבְאוֹת צֹאנְךָ יְצַלְצְלוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> יִמְלֹךְ: <j:divineName>יְיָ</j:divineName> מֶלֶךְ <j:divineName>יְיָ</j:divineName> מָלָךְ <j:divineName>יְיָ</j:divineName> יִמְלֹךְ לְעוֹלָם וָעֶד: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/19"/>קְהִלּוֹת קֹדֶשׁ יַקְדִּישׁוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מֶלֶךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/20"/>רִבְבוֹת רְבָבָה יְרַנְּנוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מָלָךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/21"/>שְׁבִיבֵי שַׁלְהָבוֹת יְשַׁנְּנוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> יִמְלֹךְ: <j:divineName>יְיָ</j:divineName> מֶלֶךְ <j:divineName>יְיָ</j:divineName> מָלָךְ <j:divineName>יְיָ</j:divineName> יִמְלֹךְ לְעוֹלָם וָעֶד: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/22"/>סוֹמְכֵי תְהִלּוֹת יַתְמִידוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מֶלֶךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/23"/>תּוֹקְפֵי תִפְאַרְתֶּךָ יְתַמְּמוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מָלָךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/24"/>תְּמִימֵי תְעוּדָה יְתַנּוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> יִמְלֹךְ: <j:divineName>יְיָ</j:divineName> מֶלֶךְ <j:divineName>יְיָ</j:divineName> מָלָךְ <j:divineName>יְיָ</j:divineName> יִמְלֹךְ לְעוֹלָם וָעֶד: <tei:milestone unit="stanza"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
