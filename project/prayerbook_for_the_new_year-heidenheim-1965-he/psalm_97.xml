  <tei:text>
    <tei:body>
      <tei:div facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n13.jpg">
        <tei:p><tei:milestone unit="chapter" n="97" corresp="urn:x-opensiddur:text:bible:psalms/97"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/97/1" n="1"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> <j:divineName>יְיָ</j:divineName> מָלָךְ תָּגֵל הָאָרֶץ יִשְׂמְחוּ אִיִּים רַבִּים: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/97/2" n="2"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> עָנָן וַעֲרָפֶל סְבִיבָיו צֶדֶק וּמִשְׁפָּט מְכוֹן כִּסְאוֹ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/97/3" n="3"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> אֵשׁ לְפָנָיו תֵּלֵךְ וּתְלַהֵט סָבִיב צָרָיו: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/97/4" n="4"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> הֵאִירוּ בְרָקָיו תֵּבֵל רָאֲתָה וַתָּחֵל הָאָרֶץ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/97/5" n="5"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> הָרִים כַּדּוֹנַג נָמַסּוּ מִלִּפְנֵי <j:divineName>יְיָ</j:divineName> מִלִּפְנֵי אֲדוֹן כָּל־הָאָרֶץ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/97/6" n="6"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> הִגִּידוּ הַשָּׁמַיִם צִדְקוֹ וְרָאוּ כָל־הָעַמִּים כְּבוֹדוֹ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/97/7" n="7"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> יֵבֹשׁוּ כָּל־עֹבְדֵי פֶסֶל הַמִּתְהַלְלִים בָּאֱלִילִים הִשְׁתַּחֲווּ־לוֹ כָּל־אֱלֹהִים: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/97/8" n="8"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> שָׁמְעָה וַתִּשְׂמַח צִיּוֹן וַתָּגֵלְנָה בְּנוֹת יְהוּדָה לְמַעַן מִשְׁפָּטֶיךָ <j:divineName>יְיָ</j:divineName>: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/97/9" n="9"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> כִּי־אַתָּה <j:divineName>יְיָ</j:divineName> עֶלְיוֹן עַל־כָּל־הָאָרֶץ מְאֹד נַעֲלֵיתָ עַל־כָּל־<tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n14.jpg" n="9"/>אֱלֹהִים: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/97/10" n="10"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> אֹהֲבֵי <j:divineName>יְיָ</j:divineName> שִׂנְאוּ רָע שֹׁמֵר נַפְשׁוֹת חֲסִידָיו מִיַּד רְשָׁעִים יַצִּילֵם: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/97/11" n="11"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> אוֹר־זָרֻעַ לַצַּדִּיק וּלְיִשְׁרֵי־לֵב שִׂמְחָה: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/97/12" n="12"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>קו״ח</tei:abbr><tei:expan>קהל וחזן</tei:expan></tei:choice></tei:note> שִׂמְחוּ צַדִּיקִים בַּ<j:divineName>ייָ</j:divineName> וְהוֹדוּ לְזֵכֶר קָדְשׁוֹ: <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>
