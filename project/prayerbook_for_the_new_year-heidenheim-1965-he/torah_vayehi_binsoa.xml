      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vayehi_binsoa" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n161.jpg">
        <tei:pb ed="1965" n="70" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n161.jpg"/>
        <tei:head xml:lang="he">סֵדֶר הוֹצָאַת סֵפֶר הַתּוֹרָה.</tei:head>
        <tei:note type="instruction" xml:lang="en">The Holy Ark is opened and, while the reader takes out two Torah scrolls, the congregation says:</tei:note>
        <tei:p><tei:milestone unit="chapter" n="10"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/10/35" n="35"/>וַיְהִי בִּנְסֹעַ הָאָרֹן וַיֹּאמֶר מֹשֶׁה קוּמָה <j:divineName>יְיָ</j:divineName> וְיָפֻצוּ אֹיְבֶיךָ וְיָנֻסוּ מְשַׂנְאֶיךָ מִפָּנֶיךָ: <tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vayehi_binsoa/ki_mitziyyon"/><tei:milestone unit="chapter" n="2" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vayehi_binsoa/quotations/ki_mitziyyon"/><tei:milestone unit="verse" n="3" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vayehi_binsoa/quotations/ki_mitziyyon/3"/><tei:milestone unit="half-verse" n="b" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vayehi_binsoa/quotations/ki_mitziyyon/3/b"/><tei:seg source="urn:x-opensiddur:text:bible:isaiah/2/3/b"> כִּי מִצִּיּוֹן תֵּצֵא תוֹרָה וּדְבַר <j:divineName>יְיָ</j:divineName> מִירוּשָׁלָֽ͏ִם:</tei:seg><tei:milestone unit="half-verse"/><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vayehi_binsoa/barukh"/>בָּרוּךְ שֶׁנָּתַן תּוֹרָה לְעַמּוֹ יִשְׂרָאֵל בִּקְדֻשָּׁתוֹ: <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
