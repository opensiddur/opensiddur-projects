  <tei:text>
    <tei:body>
      <tei:div facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n83.jpg">
        <tei:p><tei:milestone unit="chapter" n="150" corresp="urn:x-opensiddur:text:bible:psalms/150"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/150/1" n="1"/>הַלֲלוּיָהּ הַלֲלוּ־אֵל בְּקָדְשׁוֹ הַלֲלוּהוּ בִּרְקִיעַ עֻזּוֹ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/150/2" n="2"/>הַלֲלוּהוּ בִגְבוּרֹתָיו הַלֲלוּהוּ כְּרֹב גֻּדְלוֹ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/150/3" n="3"/>הַלֲלוּהוּ בְּתֵקַע שׁוֹפָר הַלֲלוּהוּ בְּנֵבֶל וְכִנּוֹר: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/150/4" n="4"/>הַלֲלוּהוּ בְתֹף וּמָחוֹל <tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n85.jpg" n="28"/>הַלֲלוּהוּ בְּמִנִּים וְעֻגָב: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/150/5" n="5"/>הַלֲלוּהוּ בְצִלְצְלֵי־שָׁמַע הַלֲלוּהוּ בְּצִלְצְלֵי תְרוּעָה: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/150/6" n="6"/>כל הַנְּשָׁמָה תְּהַלֵּל יָהּ הַלֲלוּיָהּ: <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
