      <tei:div corresp="urn:x-opensiddur:text:prayer:tallith">
        <tei:pb ed="1965" n="1" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n38.jpg"/>
        <tei:head xml:lang="he">סֵֽדֶר עֲטִיפַת הַטַּלִּית.</tei:head>
        <tei:note type="description" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n38.jpg" xml:lang="en">Before draping oneself in the <tei:foreign xml:lang="he">טלית</tei:foreign> the following is said:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:tallith/hineni_mitattef@prayerbook_for_the_new_year-heidenheim-1965-he"/>
        <tei:note type="description" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n38.jpg" xml:lang="en">Then this <tei:foreign xml:lang="he">ברכה</tei:foreign> is recited while standing:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:tallith/lehitattef@prayerbook_for_the_new_year-heidenheim-1965-he"/>
        <tei:note type="instruction" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n38.jpg" xml:lang="en">One then drapes oneself in the <tei:foreign xml:lang="he">טלית</tei:foreign> and says:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:tallith/mah_yaqar@prayerbook_for_the_new_year-heidenheim-1965-he"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:tallith/yehi_ratzon@prayerbook_for_the_new_year-heidenheim-1965-he"/>
        <tei:note type="instruction" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n38.jpg" xml:lang="en">One then removes the <tei:foreign xml:lang="he">טלית</tei:foreign> from the face and drapes oneself in such a way that there should be one <tei:foreign xml:lang="he">ציצת</tei:foreign> in front and one behind on each side.</tei:note>
      </tei:div>
