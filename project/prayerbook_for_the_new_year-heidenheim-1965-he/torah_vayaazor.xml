    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:vayaazor" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n165.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n165.jpg" n="72"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:vayaazor/text"/>וְיַעֲזוֹר וְיָגֵן וְיוֹשִׁיעַ לְכָל הַחוֹסִים בּוֹ וְנֹאמַר אָמֵן: הַכֹּל הָבוּ גֹדֶל לֵאלֹהֵינוּ וּתְנוּ כָבוֹד לַתּוֹרָה כֹּהֵן קְרָב. יַעֲמוֹד (פלוני בר פלוני הכהן): בָּרוּךְ שֶׁנָּתַן תּוֹרָה לְעַמּוֹ יִשְׂרָאֵל בִּקְדֻשָּׁתוֹ:  <tei:milestone unit="chapter" n="19" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/torat"/><tei:milestone unit="verse" n="8" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/torat/8"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/19/8">תּוֹרַת <j:divineName>יְיָ</j:divineName> תְּמִימָה מְשִׁיבַת נָפֶשׁ עֵדוּת <j:divineName>יְיָ</j:divineName> נֶאֱמָנָה מַחְכִּימַת פֶּתִי:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>   <tei:milestone unit="chapter" n="19" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/piqqudei"/><tei:milestone unit="verse" n="9" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/piqqudei/9"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/19/9">פִּקּוּדֵי <j:divineName>יְיָ</j:divineName> יְשָׁרִים מְשַׂמְּחֵי לֵב מִצְוַת <j:divineName>יְיָ</j:divineName> בָּרָה מְאִירַת עֵינָיִם:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>   <tei:milestone unit="chapter" n="29" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/oz"/><tei:milestone unit="verse" n="11" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/oz/11"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/11"><j:divineName>יְיָ</j:divineName> עֹז לְעַמּוֹ יִתֵּן <j:divineName>יְיָ</j:divineName> יְבָרֵךְ אֶת עַמּוֹ בַשָּׁלוֹם:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>   <tei:milestone unit="chapter" n="18" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/hael"/><tei:milestone unit="verse" n="31" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/hael/31"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/18/31">הָאֵל תָּמִים דַּרְכּוֹ אִמְרַת <j:divineName>יְיָ</j:divineName> צְרוּפָה מָגֵן הוּא לְכֹל הַחֹסִים בּוֹ:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
