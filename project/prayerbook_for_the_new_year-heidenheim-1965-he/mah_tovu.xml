    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:mah_tovu">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n6.jpg" n="1"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:prayer:mah_tovu/mah_tovu"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/24/5">מַה־טֹּבוּ אֹהָלֶיךָ יַעֲקֹב מִשְׁכְּנֹתֶיךָ יִשְׂרָאֵל:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:prayer:mah_tovu/varani"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/5/8">וַאֲנִי בְּרֹב חַסְדְּךָ אָבֹא בֵיתֶךָ אֶשְׁתַּחֲוֶה אֶל־הֵיכַל קָדְשְׁךָ בְּיִרְאָתֶךָ:</tei:seg> <tei:seg source="urn:x-opensiddur:text:bible:psalms/26/8"><j:divineName>יְיָ</j:divineName> אָהַבְתִּי מְעוֹן בֵּיתֶךָ וּמְקוֹם מִשְׁכַּן כְּבוֹדֶךָ:</tei:seg> <tei:seg source="urn:x-opensiddur:text:bible:psalms/95/6" type="adaptation">וַאֲנִי אֶשְׁתַּחֲוֶה וְאֶכְרָעָה אֶבְרְכָה לִפְנֵי־<j:divineName>יְיָ</j:divineName> עֹשִׂי:</tei:seg> <tei:seg source="urn:x-opensiddur:text:bible:psalms/69/14">וַאֲנִי תְפִלָּתִי־לְךָ <j:divineName>יְיָ</j:divineName> עֵת רָצוֹן אֱלֹהִים בְּרָב־חַסְדֶּךָ עֲנֵנִי בֶּאֱמֶת יִשְׁעֶךָ:</tei:seg> </tei:p>
