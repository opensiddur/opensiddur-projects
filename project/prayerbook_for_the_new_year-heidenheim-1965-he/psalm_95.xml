  <tei:text>
    <tei:body>
      <tei:div facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n12.jpg">
        <tei:p><tei:milestone unit="chapter" n="95" corresp="urn:x-opensiddur:text:bible:psalms/95"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/95/1" n="1"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note>לְכוּ נְרַנְּנָה לַ<j:divineName>ייָ</j:divineName> נָרִיעָה לְצוּר יִשְׁעֵנוּ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/95/2" n="2"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note>נְקַדְּמָה פָנָיו בְּתוֹדָה בִּזְמִרוֹת נָרִיעַ לוֹ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/95/3" n="3"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note>כִּי אֵל גָּדוֹל <j:divineName>יְיָ</j:divineName> וּמֶלֶךְ גָּדוֹל עַל־כָּל־אֱלֹהִים: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/95/4" n="4"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note>אֲשֶׁר בְּיָדוֹ מֶחְקְרֵי־אָרֶץ וְתוֹעֲפוֹת הָרִים לוֹ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/95/5" n="5"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note>אֲשֶׁר־לוֹ הַיָּם וְהוּא עָשָׂהוּ וְיַבֶּשֶׁת יָדָיו יָצָרוּ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/95/6" n="6"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note>בֹּאוּ נִשְׁתַּחֲוֶה וְנִכְרָעָה נִבְרְכָה לִפְנֵי־<j:divineName>יְיָ</j:divineName> עֹשֵׂנוּ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/95/7" n="7"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note>כִּי הוּא אֱלֹהֵינוּ וַאֲנַחְנוּ עַם מַרְעִיתוֹ וְצֹאן יָדוֹ הַיּוֹם אִם־בְּקֹלוֹ תִשְׁמָעוּ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/95/8" n="8"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note>אַל־תַּקְשׁוּ לְבַבְכֶם כִּמְרִיבָה כְּיוֹם מַסָּה בַּמִּדְבָּר: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/95/9" n="9"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note>אֲשֶׁר נִסּוּנִי אֲבוֹתֵיכֶם בְּחָנוּנִי גַּם־רָאוּ פָעֳלִי: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/95/10" n="10"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note>אַרְבָּעִים שָׁנָה <tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n13.jpg" n="8"/>אָקוּט בְּדוֹר וָאֹמַר עַם תֹּעֵי לֵבָב הֵם וְהֵם לֹא־יָדְעוּ דְרָכָי: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/95/11" n="11"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>קו״ח</tei:abbr><tei:expan>קהל וחזן</tei:expan></tei:choice></tei:note>אֲשֶׁר־נִשְׁבַּעְתִּי בְאַפִּי אִם־יְבֹאוּן אֶל־מְנוּחָתִי: <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
