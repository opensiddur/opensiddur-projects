        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n127.jpg" n="50"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/melekh_bedin/part_1"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> מֶלֶךְ בַדִּין עֲלוֹת בִּתְרוּעָה. גֵּיא עִם דָּרֶיהָ לְרוֹעֲעָה.  <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/melekh_bedin/part_2"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note>  <j:conditional xml:id="melekh_bedin_segment_2"><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="false"/></tei:f></tei:fs></j:all></j:conditional>בַּשּׁוֹפָר <j:endConditional target="#melekh_bedin_segment_2"/><j:conditional type="marked" xml:id="melekh_bedin_segment_3"><tei:note type="instruction" xml:lang="he">אם שבת</tei:note><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional>בְּזִכְרוֹן שׁוֹפָר <j:endConditional target="#melekh_bedin_segment_3"/>  <tei:choice><j:option>אֲפַתֶּנּוּ</j:option><j:option>אֲרַצֶּֽנוּ</j:option></tei:choice>: <tei:anchor xml:id="melekh_bedin_variant"/>  וּבְבֶרֶךְ כְּרִיעָה. בְּטַלְלֵי תֶֽחִי בְּגַנּוֹ אֶתְרוֹעָֽעָה: <tei:milestone unit="prayer-part"/></tei:p>
