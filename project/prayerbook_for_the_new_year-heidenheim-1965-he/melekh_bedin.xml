        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n127.jpg" n="50"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/melekh_bedin/part_1"/>מֶלֶךְ בְּדִין עָלוֹת בִּתְרוּעָה. גֵּא עִם דָּרֶיהָ לְרוֹעֲעָה.  <j:conditional xml:id="melekh_bedin_segment_1"><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="false"/></tei:f></tei:fs></j:all></j:conditional>בְּשׁוֹפָר <j:endConditional target="#melekh_bedin_segment_1"/><j:conditional type="marked" xml:id="melekh_bedin_segment_2"><tei:note type="instruction" xml:lang="he">אם שבת</tei:note><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional>בְּזִכְרוֹן שׁוֹפָר <j:endConditional target="#melekh_bedin_segment_2"/>  <tei:anchor xml:id="melekh_bedin_variant"/>אֲפַתֶּנּוּ. וּבְבֶרֶךְ כְּרָעָה. בְּטַלְלֵי תְחִי בְּגַנּוֹ אֲתְרוֹעֲעָה: <tei:milestone unit="prayer-part"/></tei:p>
