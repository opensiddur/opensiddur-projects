  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n195.jpg">
        <tei:p><tei:milestone unit="chapter" n="29" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/1" n="1"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/1">מִזְמוֹר לְדָוִד. הָבוּ לַ<j:divineName>יהוָה</j:divineName> בְּנֵי אֵלִים הָבוּ לַ<j:divineName>יהוָה</j:divineName> כָּבוֹד וָעֹז:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/2" n="2"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/2">הָבוּ לַ<j:divineName>יהוָה</j:divineName> כְּבוֹד שְׁמוֹ הִשְׁתַּחֲווּ לַ<j:divineName>יהוָה</j:divineName> בְּהַדְרַת־קֹדֶשׁ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/3" n="3"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/3">קוֹל <j:divineName>יְהוָה</j:divineName> עַל־הַמָּיִם אֵל־הַכָּבוֹד הִרְעִים <j:divineName>יְהוָה</j:divineName> עַל־מַיִם רַבִּים:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/4" n="4"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/4">קוֹל־<j:divineName>יְהוָה</j:divineName> בַּכֹּחַ קוֹל <j:divineName>יְהוָה</j:divineName> בֶּהָדָר:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/5" n="5"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/5">קוֹל <j:divineName>יְהוָה</j:divineName> שֹׁבֵר אֲרָזִים וַיְשַׁבֵּר <j:divineName>יְהוָה</j:divineName> אֶת־אַרְזֵי הַלְּבָנוֹן:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/6" n="6"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/6">וַיַּרְקִידֵם כְּמוֹ־עֵגֶל לְבָנוֹן וְשִׂרְיֹן כְּמוֹ בֶן־רְאֵמִים:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/7" n="7"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/7">קוֹל־<j:divineName>יְהוָה</j:divineName> חֹצֵב לַהֲבוֹת אֵשׁ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/8" n="8"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/8">קוֹל <j:divineName>יְהוָה</j:divineName> יָחִיל מִדְבָּר יָחִיל <j:divineName>יְהוָה</j:divineName> מִדְבַּר קָדֵשׁ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/9" n="9"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/9">קוֹל <j:divineName>יְהוָה</j:divineName> יְחוֹלֵל אַיָּלוֹת וַיֶּחֱשֹׂף יְעָרוֹת וּבְהֵיכָלוֹ כֻּלּוֹ אֹמֵר כָּבוֹד:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/10" n="10"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/10"><j:divineName>יְהוָה</j:divineName> לַמַּבּוּל יָשָׁב וַיֵּשֶׁב <j:divineName>יְהוָה</j:divineName> מֶלֶךְ לְעוֹלָם:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/11" n="11"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/11"><j:divineName>יְהוָה</j:divineName> עֹז לְעַמּוֹ יִתֵּן <j:divineName>יְהוָה</j:divineName> יְבָרֵךְ אֶת־עַמּוֹ בַשָּׁלוֹם:</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
