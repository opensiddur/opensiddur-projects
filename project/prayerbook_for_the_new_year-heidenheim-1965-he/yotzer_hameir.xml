      <tei:div corresp="urn:x-opensiddur:text:prayer:yotzer_or/hameir" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n101.jpg">
        <j:conditional xml:id="yotzer_hameir_condition">
          <j:all>
            <tei:fs type="opensiddur:holiday-aggregate">
              <tei:f name="shabbat">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:all>
        </j:conditional>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n101.jpg" n="37"/>הַמֵּאִיר לָאָרֶץ וְלַדָּרִים עָלֶיהָ בְּרַחֲמִים. וּבְטוּבוֹ מְחַדֵּשׁ בְּכָל־יוֹם תָּמִיד מַעֲשֵׂה בְרֵאשִׁית:  <tei:milestone unit="chapter" n="104"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/104/24" n="24"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/104/24">מָה רַבּוּ מַעֲשֶׂיךָ <j:divineName>יְיָ</j:divineName> כֻּלָּם בְּחָכְמָה עָשִׂיתָ. מָלְאָה הָאָרֶץ קִנְיָנֶךָ: </tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/>הַמֶּלֶךְ הַמְרוֹמָם לְבַדּוֹ מֵאָז. הַמְשֻׁבָּח וְהַמְפֹאָר וְהַמִּתְנַשֵּׂא מִימוֹת עוֹלָם: אֱלֹהֵי עוֹלָם בְּרַחֲמֶיךָ הָרַבִּים רַחֵם עָלֵינוּ. אֲדוֹן <tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n103.jpg" n="38"/>עֻזֵּנוּ צוּר מִשְׂגַּבֵּנוּ. מָגֵן יִשְׁעֵנוּ מִשְׂגָּב בַּעֲדֵנוּ: </tei:p>
        <j:endConditional target="#yotzer_hameir_condition"/>
