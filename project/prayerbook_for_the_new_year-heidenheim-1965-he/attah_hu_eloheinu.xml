  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n131.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n131.jpg" n="52"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/1"/>אַתָּה הוּא אֱלֹהֵינוּ. בַּשָּׁמַיִם וּבָאָרֶץ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/2"/>גִּבּוֹר וְנַעֲרָץ. דָּגוּל מֵרְבָבָה: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/3"/>הוּא שָׂח וַיֶּהִי. וְצִוָּה וְנִבְרָאוּ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/4"/>זִכְרוֹ לָנֶצַח. חַי עוֹלָמִים: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/5"/>טְהוֹר עֵינַיִם. יוֹשֵׁב סֵתֶר: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/6"/>כִּתְרוֹ יְשׁוּעָה. לְבוּשׁוֹ צְדָקָה: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/7"/>מַעֲטֵהוּ קִנְאָה. נֶאְפָּד נְקָמָה: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/8"/>סִתְרוֹ יֹשֶׁר. עֲצָתוֹ אֱמוּנָה: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/9"/>פְּעֻלָּתוֹ אֱמֶת. צַדִּיק וְיָשָׁר: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/10"/>קָרוֹב לְקוֹרְאָיו בֶּאֱמֶת. רָם וּמִתְנַשֵּׂא: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/11"/>שׁוֹכֵן שְׁחָקִים. תּוֹלֶה אֶרֶץ עַל בְּלִימָה: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/12"/>חַי וְקַיָּם נוֹרָא בַמָּרוֹם וְקָדוֹשׁ: <tei:milestone unit="stanza"/></tei:p>
      </tei:div>
