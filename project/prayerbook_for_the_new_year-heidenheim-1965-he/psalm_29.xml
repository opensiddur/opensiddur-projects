    <tei:body>
      <tei:div facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n14.jpg">
        <tei:p><tei:milestone unit="chapter" n="29" corresp="urn:x-opensiddur:text:bible:psalms/29"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/29/1" n="1"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> מִזְמוֹר לְדָוִד הָבוּ לַ<j:divineName>יהֹוָה</j:divineName> בְּנֵי אֵלִים הָבוּ לַ<j:divineName>יהֹוָה</j:divineName> כָּבוֹד וָעֹז: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/29/2" n="2"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> הָבוּ לַ<j:divineName>יהֹוָה</j:divineName> כְּבוֹד שְׁמוֹ הִשְׁתַּחֲווּ לַ<j:divineName>יהֹוָה</j:divineName> בְּהַדְרַת־<tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n15.jpg" n="10"/>קֹדֶשׁ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/29/3" n="3"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> קוֹל <j:divineName>יְהֹוָה</j:divineName> עַל־הַמָּיִם אֵל־הַכָּבוֹד הִרְעִים <j:divineName>יְהֹוָה</j:divineName> עַל־מַיִם רַבִּים: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/29/4" n="4"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> קוֹל־<j:divineName>יְהֹוָה</j:divineName> בַּכֹּחַ קוֹל <j:divineName>יְהֹוָה</j:divineName> בֶּהָדָר: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/29/5" n="5"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> קוֹל <j:divineName>יְהֹוָה</j:divineName> שֹׁבֵר אֲרָזִים וַיְשַׁבֵּר <j:divineName>יְהֹוָה</j:divineName> אֶת־אַרְזֵי הַלְּבָנוֹן: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/29/6" n="6"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> וַיַּרְקִידֵם כְּמוֹ־עֵגֶל לְבָנוֹן וְשִׂרְיוֹן כְּמוֹ בֶן־רְאֵמִים: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/29/7" n="7"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> קוֹל־<j:divineName>יְהֹוָה</j:divineName> חֹצֵב לַהֲבוֹת אֵשׁ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/29/8" n="8"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> קוֹל <j:divineName>יְהֹוָה</j:divineName> יָחִיל מִדְבָּר יָחִיל <j:divineName>יְהֹוָה</j:divineName> מִדְבַּר קָדֵשׁ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/29/9" n="9"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> קוֹל <j:divineName>יְהֹוָה</j:divineName> יְחוֹלֵל אַיָּלוֹת וַיֶּחֱשֹׂף יְעָרוֹת וּבְהֵיכָלוֹ כֻּלּוֹ אֹמֵר כָּבוֹד: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/29/10" n="10"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> <j:divineName>יְהֹוָה</j:divineName> לַמַּבּוּל יָשָׁב וַיֵּשֶׁב <j:divineName>יְהֹוָה</j:divineName> מֶלֶךְ לְעוֹלָם: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/29/11" n="11"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>קו״ח</tei:abbr><tei:expan>קהל וחזן</tei:expan></tei:choice></tei:note> <j:divineName>יְהֹוָה</j:divineName> עֹז לְעַמּוֹ יִתֵּן <j:divineName>יְהֹוָה</j:divineName> יְבָרֵךְ אֶת־עַמּוֹ בַשָּׁלוֹם: <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
