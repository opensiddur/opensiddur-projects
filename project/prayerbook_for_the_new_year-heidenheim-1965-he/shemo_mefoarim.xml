    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:shemo_mefoarim" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n131.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n131.jpg" n="52"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/shemo"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>חו״ק</tei:abbr><tei:expan>חזן וקהל</tei:expan></tei:choice></tei:note> שְׁמוֹ מְפָאֲרִים עֲדַת חֶבְלוֹ. וְנַעֲרִיץ בְּאֶרְאֶלֵּי קֹדֶשׁ הִלּוּלוֹ. וּבְהֵיכָלוֹ כָּבוֹד אָמַר כּוּלּוֹ. קָדוֹשׁ: <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/shomerei"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>חו״ק</tei:abbr><tei:expan>חזן וקהל</tei:expan></tei:choice></tei:note> שׁוֹמְרֵי מִצְווֹתָיו עוֹד יְשׁוּבוּן לְבִצָּרוֹן. נִדְבָּרִים יְרֵאָיו בְּטֹהַר וְיִתְרוֹן. וַיַּקְשֵׁב <j:divineName>יְיָ</j:divineName> וַיִּשְׁמַע וַיִּכָּתֵב בְּסֵפֶר זִכָּרוֹן. קָדוֹשׁ: <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/shapru"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>חו״ק</tei:abbr><tei:expan>חזן וקהל</tei:expan></tei:choice></tei:note> שַׁפְּרוּ מַעֲשִׂים וּבְרִית לֹא תוּפָר. נַאֲקַתְכֶם יַאֲזִין שְׁחָקִים שִׁפַּר. וְתִיטַב לַ<j:divineName>יְיָ</j:divineName> מִשּׁוֹר פָּר. קָדוֹשׁ: <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n133.jpg" n="53"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/shivtei"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>חו״ק</tei:abbr><tei:expan>חזן וקהל</tei:expan></tei:choice></tei:note> שִׁבְטֵי מְקוֹרָאֶךָ עֲלֵה וּמְשׁוֹל. נְטִישׁוֹת צָרִים כְּהִתְוִיז לְנַשֵּׁל. כִּי לַ<j:divineName>יְיָ</j:divineName> הַמְּלוּכָה וּמוֹשֵׁל. קָדוֹשׁ: <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/shevutenu"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>חו״ק</tei:abbr><tei:expan>חזן וקהל</tei:expan></tei:choice></tei:note> שְׁבוּתֵנוּ מִמֶּרְחָק עֲלוֹת לְהַר קָדְשׁוֹ. וּנְפָאֲרֶנּוּ תָּמִיד בִּדְבִיר מִקְדָּשׁוֹ. כִּי זָכַר אֶת דְּבַר קָדְשׁוֹ. קָדוֹשׁ: <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/kol_yoshvei"/> <j:conditional type="marked" xml:id="shemo_mefoarim_segment_6"><j:all><tei:fs type="opensiddur:rite"><tei:f name="metz"><tei:binary value="false"/></tei:f></tei:fs></j:all></j:conditional>כָּל יוֹשְׁבֵי תֵבֵל וְשׁוֹכְנֵי אָרֶץ. יֹאמְרוּ תָמִיד הִגְדִּיל <j:divineName>יְיָ</j:divineName> לַעֲשׂוֹת בָּאָרֶץ. וְהָיָה <j:divineName>יְיָ</j:divineName> לְמֶלֶךְ עַל כָּל הָאָרֶץ. קָדוֹשׁ: <j:endConditional target="#shemo_mefoarim_segment_6"/> <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/adar"/>אֲדָר וָהוֹד אֶתֵּן בְּצִבְיוֹן. שׁוּעַ אֶעֶרְכָה בְּנִיב וְהִגָּיוֹן.  <tei:milestone unit="chapter" n="57" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/adar_1/chapter"/><tei:milestone unit="verse" n="3" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/adar_1/chapter/3"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/57/3">אֶקְרָא לֵאלֹהִים עֶלְיוֹן:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  בְּיוֹם הַנִּבְחָר מִשְּׁמֵי עָרִיץ. מֵישָׁרִים לִשְׁפֹּט קְדֻשָּׁתוֹ לְהַעֲרִיץ.  <tei:milestone unit="chapter" n="97" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/adar_2/chapter"/><tei:milestone unit="verse" n="1" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/adar_2/chapter/1"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/97/1"><j:divineName>יְיָ</j:divineName> מָלָךְ תָּגֵל הָאָרֶץ:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  גֵּאוּתוֹ גָּדְלָה עוֹלָם מֵהָכִיל. עֱזוּזוֹ לְסַפֵּר כֹּחַ מִי יָכִיל.  <tei:milestone unit="chapter" n="47" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/adar_3/chapter"/><tei:milestone unit="verse" n="8" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/adar_3/chapter/8"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/47/8">מֶלֶךְ עַל כָּל הָאָרֶץ אֱלֹהִים זַמְּרוּ מַשְׂכִּיל:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="stanza"/><tei:milestone unit="navigation" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/shabbat_cues/adar"/><tei:note type="instruction" xml:lang="he"><tei:ref target="urn:x-opensiddur:text:poem:shemo_mefoarim/shemo@prayerbook_for_the_new_year-heidenheim-1965-he">שְׁמוֹ מְפָאֲרִים.</tei:ref></tei:note><tei:milestone unit="navigation"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/dea"/>דַּע יִשְׁמוּ כָּל בְּרִיוֹתָיו. וְיֵדְעוּ כִּי גָדְלוּ גְּבוּרוֹתָיו.  <tei:milestone unit="chapter" n="111" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/dea_4/chapter"/><tei:milestone unit="verse" n="4" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/dea_4/chapter/4"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/111/4">זֵכֶר עָשָׂה לְנִפְלְאוֹתָיו:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  הִצִּיב וְיָדָה אֶבֶן פִּנָּתוֹ. נַחֲלִיאֵל עֲבוּר לְשַׁעֲשֵׁעַ בְּאֻמָּתוֹ.  <tei:milestone unit="chapter" n="111" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/dea_5/chapter"/><tei:milestone unit="verse" n="5" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/dea_5/chapter/5"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/111/5">יִזְכֹּר לְעוֹלָם בְּרִיתוֹ:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n135.jpg" n="54"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/varasham"/>וְרָשַׁם בְּחֹק דַּת הֶגְיוֹנִי. בְּכָל שָׁנָה וְשָׁנָה לִפְקוֹד זִכְרוֹנִי. לְזִכָּרוֹן בְּהֵיכַל <j:divineName>יְיָ</j:divineName> <tei:milestone unit="stanza"/><tei:milestone unit="navigation" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/shabbat_cues/varasham"/><tei:note type="instruction" xml:lang="he"><tei:ref target="urn:x-opensiddur:text:poem:shemo_mefoarim/shomerei@prayerbook_for_the_new_year-heidenheim-1965-he">שׁוֹמְרֵי מִצְווֹתָיו.</tei:ref></tei:note><tei:milestone unit="navigation"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/zevach"/>זֶבַח קֹדֶשׁ כְּהֻכְשַׁר אָז בְּעֵינָיו. רֶגֶל תְּמוּרָתוֹ אַיִל לְהַקְרִיב לְפָנָיו. אַחַר נֶאֱחַז בַּסְּבַךְ בְּקַרְנָיו: חִנֵּם חֲנִיטָיו לִתְקוֹעַ בְּזֶה חֹדֶשׁ. יוֹם זֶה אִם יִקְרֶה בְּשַׁבַּת קֹדֶשׁ. זִכְרוֹן תְּרוּעָה מִקְרָא קֹדֶשׁ: טִבְעוֹן אִם בְּחֹל יְבֹאָכֶם. צַוּוּ לִתְקוֹעַ בְּכָל גְּבוּלְכֶם. יוֹם תְּרוּעָה יִהְיֶה לָכֶם: <tei:milestone unit="stanza"/><tei:milestone unit="navigation" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/shabbat_cues/zevach"/><tei:note type="instruction" xml:lang="he"><tei:ref target="urn:x-opensiddur:text:poem:shemo_mefoarim/shapru@prayerbook_for_the_new_year-heidenheim-1965-he">שַׁפְּרוּ.</tei:ref></tei:note><tei:milestone unit="navigation"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/yarum"/>יָרוּם צוּר יִשְׁעִי פִּי כָל־אֻמִּים. חֲשׂוֹף זְרוֹעֲךָ לְהוֹשִׁיעַ מִמִּתְקוֹמְמִים.  <tei:milestone unit="chapter" n="145" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/yarum_6/chapter"/><tei:milestone unit="verse" n="13" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/yarum_6/chapter/13"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/145/13">מַלְכוּתְךָ מַלְכוּת כָּל עוֹלָמִים:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  כְּהִגָּלוֹתְךָ לְעֵין כֹּל שְׁכִינָה לְהוֹעֵד. קְהִלּוֹת וְרִבְבוֹת בְּנִימוֹ לְהָעֵד.  <tei:milestone unit="chapter" n="15" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/yarum_7/chapter"/><tei:milestone unit="verse" n="18" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/yarum_7/chapter/18"/><tei:seg source="urn:x-opensiddur:text:bible:exodus/15/18"><j:divineName>יְיָ</j:divineName> יִמְלֹךְ לְעֹלָם וָעֶד:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  לְךָ יָאֲתָה כָּבוֹד  <tei:anchor xml:id="yarum_variant"/>וְעֹז הַגּוֹיִם. חֶלֶד וְכָל שׁוֹכְנֶיהָ וְכָל הָאִיִּים.  <tei:milestone unit="chapter" n="10" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/yarum_8/chapter"/><tei:milestone unit="verse" n="7" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/yarum_8/chapter/7"/><tei:seg source="urn:x-opensiddur:text:bible:jeremiah/10/7">מִי לֹא יִרָאֲךָ מֶלֶךְ הַגּוֹיִם:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="stanza"/><tei:milestone unit="navigation" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/shabbat_cues/yarum"/><tei:note type="instruction" xml:lang="he"><tei:ref target="urn:x-opensiddur:text:poem:shemo_mefoarim/shivtei@prayerbook_for_the_new_year-heidenheim-1965-he">שִׁבְטֵי.</tei:ref></tei:note><tei:milestone unit="navigation"/></tei:p>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n137.jpg" n="55"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/motot"/>מוֹטַת צָרִים שְׁבֹר וְהַכְחִידֵם. וּדְחוּיֶיךָ קַבֵּץ וְחִנָּם תִּפְדֵּם.  <tei:milestone unit="chapter" n="74" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/motot_9/chapter"/><tei:milestone unit="verse" n="2" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/motot_9/chapter/2"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/74/2">זְכוֹר עֲדָתְךָ קָנִיתָ קֶדֶם:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  נְדִיבֵי עַמִּים נַחֲמוּ בְּכִפְלַיִם. קָמֵיהֶם עַל פָּנֵימוֹ גַּלֵּה שׁוּלַיִם.  <tei:milestone unit="chapter" n="137" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/motot_10/chapter"/><tei:milestone unit="verse" n="7" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/motot_10/chapter/7"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/137/7">זְכֹר <j:divineName>יְיָ</j:divineName> לִבְנֵי אֱדוֹם אֵת יוֹם יְרוּשָׁלָיִם:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  סְלִיל מְסִלָּתֵנוּ יַשֵּׁר לְצַעַד. וּבֵין יְקִירָה קַרְסֹל לֹא יִמְעַד. כִּנְאֻמַת זָכוֹר אֶזְכְּרֶנּוּ עוֹד: <tei:milestone unit="stanza"/><tei:milestone unit="navigation" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/shabbat_cues/motot"/><tei:note type="instruction" xml:lang="he"><tei:ref target="urn:x-opensiddur:text:poem:shemo_mefoarim/shevutenu@prayerbook_for_the_new_year-heidenheim-1965-he">שְׁבוּתֵנוּ.</tei:ref></tei:note><tei:milestone unit="navigation"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/qiryat"/>קִרְיַת מְשׂוֹשׂ הֵיכָל וְאוּלָם. מִזְבֵּחַ יָשִׁיב וּכְלֵי שָׁרֵת כֻּלָּם. <j:divineName>יְיָ</j:divineName> יִמְלֹךְ לְעוֹלָם: שָׁמַיִם וָאָרֶץ יְרַנְּנוּ לִשְׁמוֹ. יְעָרוֹת יִמְחֲאוּ כַף לְהַנְעִימוֹ.  <tei:milestone unit="chapter" n="1" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/qiryat_11/chapter"/><tei:milestone unit="verse" n="6" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/qiryat_11/chapter/6"/><tei:seg source="urn:x-opensiddur:text:bible:ruth/1/6">כִּי פָקַד <j:divineName>יְיָ</j:divineName> אֶת עַמּוֹ:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  תֹּקֶף אֶרְאֶלִּים וְכוֹכְבֵי צָפֶר. תְּהִלּוֹת יִתְּנוּ שֶׁבַח לְהַשְׁפִּיר.  <tei:milestone unit="chapter" n="150" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/qiryat_12/chapter"/><tei:milestone unit="verse" n="3" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/qiryat_12/chapter/3"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/150/3">הַלְלוּהוּ בְּתֵקַע שׁוֹפָר:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/shabbat_refrains/kol_yoshvei"/> <j:conditional type="marked" xml:id="shemo_mefoarim_segment_37"><j:all><tei:fs type="opensiddur:rite"><tei:f name="metz"><tei:binary value="false"/></tei:f></tei:fs></j:all></j:conditional><tei:seg source="urn:x-opensiddur:text:poem:shemo_mefoarim/kol_yoshvei">כָּל יוֹשְׁבֵי תֵבֵל וְשׁוֹכְנֵי אָרֶץ. יֹאמְרוּ תָמִיד הִגְדִּיל <j:divineName>יְיָ</j:divineName> לַעֲשׂוֹת בָּאָרֶץ. וְהָיָה <j:divineName>יְיָ</j:divineName> לְמֶלֶךְ עַל כָּל הָאָרֶץ. קָדוֹשׁ:</tei:seg> <j:endConditional target="#shemo_mefoarim_segment_37"/> <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/yishpot"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>חו״ק</tei:abbr><tei:expan>חזן וקהל</tei:expan></tei:choice></tei:note> יִשְׁפֹּט תֵּבֵל בְּצֶדֶק וּלְאֻמִּים בְּמֵישָׁרִים. הָאֵל קָדוֹשׁ: <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/vehu"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>חו״ק</tei:abbr><tei:expan>חזן וקהל</tei:expan></tei:choice></tei:note> <tei:milestone unit="chapter" n="23" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/vehu_13/chapter"/><tei:milestone unit="verse" n="13" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/vehu_13/chapter/13"/><tei:seg source="urn:x-opensiddur:text:bible:job/23/13">וְהוּא בְאֶחָד וּמִי יְשִׁיבֶנּוּ. וְנַפְשׁוֹ אִוְּתָה וַיָּעַשׂ.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  נוֹרָא וְקָדוֹשׁ: <tei:milestone unit="stanza"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
