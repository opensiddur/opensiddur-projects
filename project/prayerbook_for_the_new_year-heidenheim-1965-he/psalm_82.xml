  <tei:text>
    <tei:body>
      <tei:div facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n351.jpg">
        <tei:p><tei:milestone unit="chapter" n="82" corresp="urn:x-opensiddur:text:bible:psalms/82"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/82/1" n="1"/>מִזְמוֹר לְאָסָף. אֱלֹהִים נִצָּב בַּעֲדַת־אֵל בְּקֶֽרֶב אֱלֹהִים יִשְׁפֹּט: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/82/2" n="2"/>עַד־מָתַי תִּשְׁפְּטוּ־עָוֶל. וּפְנֵי רְשָׁעִים תִּשְׂאוּ־סֶֽלָה: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/82/3" n="3"/>שִׁפְטוּ־דַל וְיָתוֹם. עָנִי וָרָשׁ הַצְדִּֽיקוּ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/82/4" n="4"/>פַּלְּטוּ־דַל וְאֶבְיוֹן. מִיַּד רְשָׁעִים הַצִּֽילוּ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/82/5" n="5"/>לֹא יָדְעוּ וְלֹא יָבִֽינוּ בַּחֲשֵׁכָה יִתְהַלָּֽכוּ. יִמּוֹטוּ כָּל־מוֹסְדֵי אָֽרֶץ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/82/6" n="6"/>אֲנִי אָמַֽרְתִּי אֱלֹהִים אַתֶּם. וּבְנֵי עֶלְיוֹן כֻּלְּכֶם: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/82/7" n="7"/>אָכֵן כְּאָדָם תְּמוּתוּן. וּכְאַחַד הַשָּׂרִים תִּפֹּלוּ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/82/8" n="8"/>קוּמָה אֱלֹהִים שָׁפְטָה הָאָֽרֶץ. כִּי אַתָּה תִנְחַל בְּכָל־הַגּוֹיִם: <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
