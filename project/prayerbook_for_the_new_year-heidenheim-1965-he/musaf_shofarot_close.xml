    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/shofarot_close" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n215.jpg">
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/shofarot_close/text"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/teqa_beshofar_gadol_lecherutenu">אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ תְּקַע בְּשׁוֹפָר גָּדוֹל לְחֵרוּתֵנוּ וְשָׂא נֵס לְקַבֵּץ גָּלֻיּוֹתֵינוּ וְקָרֵב פְּזוּרֵינוּ מִבֵּין הַגּוֹיִם וּנְפוּצוֹתֵינוּ כַּנֵּס מִיַּרְכְּתֵי אָרֶץ וַהֲבִיאֵנוּ לְצִיּוֹן עִירְךָ בְּרִנָּה וְלִירוּשָׁלַיִם בֵּית מִקְדָּשְׁךָ בְּשִׂמְחַת עוֹלָם וְשָׁם נַעֲשֶׂה לְפָנֶיךָ אֶת קָרְבְּנוֹת חוֹבוֹתֵינוּ <tei:choice xml:id="musaf_shofarot_command_variant"><j:option>כְּמִצְוָה</j:option><j:option>כִּמְצֻוָּה</j:option></tei:choice> עָלֵינוּ בְּתוֹרָתֶךָ עַל יְדֵי מֹשֶׁה עַבְדֶּךָ מִפִּי כְבוֹדֶךָ כָּאָמוּר:</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
