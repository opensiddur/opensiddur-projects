  <tei:text>
    <tei:body>
      <tei:div facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n67.jpg">
        <tei:p><tei:milestone unit="chapter" n="91" corresp="urn:x-opensiddur:text:bible:psalms/91"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/1" n="1"/>יֹשֵׁב בְּסֵתֶר עֶלְיוֹן בְּצֵל שַׁדַּי יִתְלוֹנָן: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/2" n="2"/>אֹמַר לַ<j:divineName>יהוָה</j:divineName> <tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n69.jpg" n="20"/>מַחְסִי וּמְצוּדָתִי אֱלֹהַי אֶבְטַח־בּוֹ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/3" n="3"/>כִּי הוּא יַצִּילְךָ מִפַּח יָקוּשׁ מִדֶּבֶר הַוּוֹת: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/4" n="4"/>בְּאֶבְרָתוֹ יָסֶךְ לָךְ וְתַחַת כְּנָפָיו תֶּחְסֶה צִנָּה וְסֹחֵרָה אֲמִתּוֹ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/5" n="5"/>לֹא־תִירָא מִפַּחַד לָיְלָה מֵחֵץ יָעוּף יוֹמָם: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/6" n="6"/>מִדֶּבֶר בָּאֹפֶל יַהֲלֹךְ מִקֶּטֶב יָשׁוּד צָהֳרָיִם: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/7" n="7"/>יִפֹּל מִצִּדְּךָ אֶלֶף וּרְבָבָה מִימִינֶךָ אֵלֶיךָ לֹא יִגָּשׁ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/8" n="8"/>רַק בְּעֵינֶיךָ תַבִּיט וְשִׁלֻּמַת רְשָׁעִים תִּרְאֶה: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/9" n="9"/>כִּי־אַתָּה <j:divineName>יְהוָה</j:divineName> מַחְסִי עֶלְיוֹן שַׂמְתָּ מְעוֹנֶךָ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/10" n="10"/>לֹא־תְאֻנֶּה אֵלֶיךָ רָעָה וְנֶגַע לֹא־יִקְרַב בְּאָהֳלֶךָ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/11" n="11"/>כִּי מַלְאָכָיו יְצַוֶּה־לָּךְ לִשְׁמָרְךָ בְּכָל־דְּרָכֶיךָ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/12" n="12"/>עַל־כַּפַּיִם יִשָּׂאוּנְךָ פֶּן־תִּגֹּף בָּאֶבֶן רַגְלֶךָ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/13" n="13"/>עַל־שַׁחַל וָפֶתֶן תִּדְרֹךְ תִּרְמֹס כְּפִיר וְתַנִּין: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/14" n="14"/>כִּי בִי חָשַׁק וַאֲפַלְּטֵהוּ אֲשַׂגְּבֵהוּ כִּי־יָדַע שְׁמִי: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/15" n="15"/>יִקְרָאֵנִי וְאֶעֱנֵהוּ עִמּוֹ אָנֹכִי בְצָרָה אֲחַלְּצֵהוּ וַאֲכַבְּדֵהוּ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/16" n="16"/>אֹרֶךְ יָמִים אַשְׂבִּיעֵהוּ וְאַרְאֵהוּ בִּישׁוּעָתִי: <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
