        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n203.jpg" n="92"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/vattitten_lanu/text"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/vattitten_lanu_hashem">וַתִּתֶּן־לָֽנוּ <j:divineName>יְיָ</j:divineName> אֱלֹהֵינוּ בְּאַהֲבָה אֶת־יוֹם </tei:seg> <j:conditional type="marked" xml:id="musaf_vattitten_lanu_segment_1"><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional><tei:seg source="urn:x-opensiddur:text:prayer:amidah/vattitten_lanu_hashem">הַשַּׁבָּת הַזֶּה וְאֶת יוֹם</tei:seg> <j:endConditional target="#musaf_vattitten_lanu_segment_1"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/vattitten_lanu_hashem"> הַזִּכָּרוֹן הַזֶּה. יוֹם </tei:seg> <j:conditional type="marked" xml:id="musaf_vattitten_lanu_segment_3"><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional><tei:seg source="urn:x-opensiddur:text:prayer:amidah/vattitten_lanu_hashem">זִכְרוֹן</tei:seg> <j:endConditional target="#musaf_vattitten_lanu_segment_3"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/vattitten_lanu_hashem"> תְּרוּעָה </tei:seg> <j:conditional type="marked" xml:id="musaf_vattitten_lanu_segment_5"><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional><tei:seg source="urn:x-opensiddur:text:prayer:amidah/vattitten_lanu_hashem">בְּאַהֲבָה</tei:seg> <j:endConditional target="#musaf_vattitten_lanu_segment_5"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/vattitten_lanu_hashem"> מִקְרָא קֹדֶשׁ זֵכֶר לִיצִיאַת מִצְרָיִם:</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
