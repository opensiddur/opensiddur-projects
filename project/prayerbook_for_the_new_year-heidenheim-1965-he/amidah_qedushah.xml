        <tei:note type="description" xml:lang="he">קדושה לש״ץ בחזרת התפלה.</tei:note>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/neqaddesh"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> נְקַדֵּשׁ אֶת שִׁמְךָ בָּעוֹלָם כְּשֵׁם שֶׁמַּקְדִּישִׁים אוֹתוֹ בִּשְׁמֵי מָרוֹם כַּכָּתוּב עַל־יַד נְבִיאֶךָ וְקָרָא זֶה אֶל־זֶה וְאָמַר. <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/qadosh"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>קו״ח</tei:abbr><tei:expan>קהל וחזן</tei:expan></tei:choice></tei:note> קָדוֹשׁ קָדוֹשׁ קָדוֹשׁ <j:divineName>יְיָ</j:divineName> צְבָאוֹת מְלֹא כָל־הָאָרֶץ כְּבוֹדוֹ: <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/leummatam"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> לְעֻמָּתָם בָּרוּךְ יֹאמֵרוּ. <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/barukh_kevod"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>קו״ח</tei:abbr><tei:expan>קהל וחזן</tei:expan></tei:choice></tei:note> בָּרוּךְ כְּבוֹד־<j:divineName>יְיָ</j:divineName> מִמְּקוֹמוֹ: <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/uvedivrei"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> וּבְדִבְרֵי קָדְשְׁךָ כָּתוּב לֵאמֹר. <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/yimlokh"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>קו״ח</tei:abbr><tei:expan>קהל וחזן</tei:expan></tei:choice></tei:note> יִמְלֹךְ <j:divineName>יְיָ</j:divineName> לְעוֹלָם אֱלֹהַיִךְ צִיּוֹן לְדֹר וָדֹר הַלְלוּיָהּ: <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/ledor_vador"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> לְדוֹר וָדוֹר נַגִּיד גָּדְלֶךָ וּלְנֵצַח נְצָחִים קְדֻשָּׁתְךָ נַקְדִּישׁ וְשִׁבְחֲךָ אֱלֹהֵינוּ מִפִּינוּ לֹא יָמוּשׁ לְעוֹלָם וָעֶד כִּי אֵל מֶלֶךְ גָּדוֹל וְקָדוֹשׁ אָתָּה. <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/hael_haqadosh"/>בָּרוּךְ אַתָּה <j:divineName>יְיָ</j:divineName> הָאֵל הַקָּדוֹשׁ: <tei:milestone unit="prayer-part"/></tei:p>
        <j:endConditional target="#amidah_qedushah_condition"/>
