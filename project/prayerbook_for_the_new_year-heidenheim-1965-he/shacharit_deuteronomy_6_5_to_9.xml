      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n109.jpg">
        <tei:p><tei:milestone unit="chapter" n="6" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6/chapter"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6/chapter/5" n="5"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/6/5">וְאָ֣הַבְתָּ֔ אֵ֖ת <j:divineName>יְהוָ֣ה</j:divineName> אֱלֹהֶ֑יךָ בְּכָל־לְבָבְךָ֥ וּבְכָל־נַפְשְׁךָ֖ וּבְכָל־מְאֹדֶֽךָ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6/chapter/6" n="6"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/6/6">וְהָי֞וּ הַדְּבָרִ֣ים הָאֵ֗לֶּה אֲשֶׁ֨ר אָנֹכִ֧י מְצַוְּךָ֛ הַיּ֖וֹם עַל־לְבָבֶֽךָ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6/chapter/7" n="7"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/6/7">וְשִׁנַּנְתָּ֣ם לְבָנֶ֔יךָ וְדִבַּרְתָּ֖ בָּ֑ם בְּשִׁבְתְּךָ֤ בְּבֵיתֶ֙ךָ֙ וּבְלֶכְתְּךָ֣ בַדֶּ֔רֶךְ וּֽבְשָׁכְבְּךָ֖ וּבְקוּמֶֽךָ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6/chapter/8" n="8"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/6/8">וּקְשַׁרְתָּ֥ם לְא֖וֹת עַל־יָדֶ֑ךָ וְהָי֥וּ לְטֹטָפֹ֖ת בֵּ֥ין עֵינֶֽיךָ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6/chapter/9" n="9"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/6/9">וּכְתַבְתָּ֛ם עַל־מְזֻז֥וֹת בֵּיתֶ֖ךָ וּבִשְׁעָרֶֽיךָ:</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
