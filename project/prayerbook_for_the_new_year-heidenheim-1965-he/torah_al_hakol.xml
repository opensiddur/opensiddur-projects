    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:al_hakol" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n163.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n163.jpg" n="71"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:al_hakol/opening"/>עַל הַכֹּל יִתְגַּדַּל וְיִתְקַדַּשׁ וְיִשְׁתַּבַּח וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְנַשֵּׂא: שְׁמוֹ שֶׁל־מֶלֶךְ מַלְכֵי הַמְּלָכִים הַקָּדוֹשׁ בָּרוּךְ הוּא: בָּעוֹלָמוֹת שֶׁבָּרָא הָעוֹלָם הַזֶּה וְהָעוֹלָם הַבָּא: כִּרְצוֹנוֹ וְכִרְצוֹן יְרֵאָיו וְכִרְצוֹן כָּל־בֵּית יִשְׂרָאֵל: צוּר <tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n165.jpg" n="72"/>הָעוֹלָמִים אֲדוֹן כָּל־הַבְּרִיּוֹת אֱלוֹהַּ כָּל־הַנְּפָשׁוֹת: הַיּוֹשֵׁב בְּמֶרְחֲבֵי מָרוֹם הַשּׁוֹכֵן בִּשְׁמֵי שְׁמֵי קֶדֶם: קְדֻשָּׁתוֹ עַל הַחַיּוֹת וּקְדֻשָּׁתוֹ עַל כִּסֵּא הַכָּבוֹד: וּבְכֵן יִתְקַדַּשׁ שִׁמְךָ בָּנוּ <j:divineName>יְיָ</j:divineName> אֱלֹהֵינוּ לְעֵינֵי כָּל־חָי: וְנֹאמַר לְפָנָיו שִׁיר חָדָשׁ כַּכָּתוּב:  <tei:milestone unit="chapter" n="68" corresp="urn:x-opensiddur:text:prayer:al_hakol/quotations/shiru"/><tei:milestone unit="verse" n="5" corresp="urn:x-opensiddur:text:prayer:al_hakol/quotations/shiru/5"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/68/5">שִׁירוּ לֵאלֹהִים זַמְּרוּ שְׁמוֹ סֹלּוּ לָרֹכֵב בָּעֲרָבוֹת בְּיָהּ שְׁמוֹ וְעִלְזוּ לְפָנָיו:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  וְנִרְאֵהוּ עַיִן בְּעַיִן בְּשׁוּבוֹ אֶל נָוֵהוּ כַּכָּתוּב:  <tei:milestone unit="chapter" n="52" corresp="urn:x-opensiddur:text:prayer:al_hakol/quotations/ayin"/><tei:milestone unit="verse" n="8" corresp="urn:x-opensiddur:text:prayer:al_hakol/quotations/ayin/8"/><tei:milestone unit="half-verse" n="b" corresp="urn:x-opensiddur:text:prayer:al_hakol/quotations/ayin/8/b"/><tei:seg source="urn:x-opensiddur:text:bible:isaiah/52/8/b">כִּי עַיִן בְּעַיִן יִרְאוּ בְּשׁוּב <j:divineName>יְיָ</j:divineName> צִיּוֹן:</tei:seg><tei:milestone unit="half-verse"/><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  וְנֶאֱמַר  <tei:milestone unit="chapter" n="40" corresp="urn:x-opensiddur:text:prayer:al_hakol/quotations/veniglah"/><tei:milestone unit="verse" n="5" corresp="urn:x-opensiddur:text:prayer:al_hakol/quotations/veniglah/5"/><tei:seg source="urn:x-opensiddur:text:bible:isaiah/40/5">וְנִגְלָה כְבוֹד <j:divineName>יְיָ</j:divineName> וְרָאוּ כָל־בָּשָׂר יַחְדָּו כִּי פִּי <j:divineName>יְיָ</j:divineName> דִּבֵּר:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
