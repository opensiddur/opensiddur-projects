    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:melekh_elyon" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n231.jpg">
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:melekh_elyon/1"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he">חזן.</tei:note> מֶלֶךְ עֶלְיוֹן. אֵל דָּר בַּמָּרוֹם. אַדִּיר בַּמָּרוֹם. אֹמֶץ יָדוֹ תָּרוּם.  <tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> לַעֲדֵי עַד יִמְלוֹךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:melekh_elyon/2"/>מֶלֶךְ עֶלְיוֹן. גִּבּוֹר לְהָקִים. גּוֹזֵר וּמֵקִים. גּוֹלֶה עֲמוּקִים.  <tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> לַעֲדֵי עַד יִמְלוֹךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:melekh_elyon/3"/>מֶלֶךְ עֶלְיוֹן. הַמְדַבֵּר בִּצְדָקָה. הַלּוֹבֵשׁ צְדָקָה. הַמַּאֲזִין צְעָקָה.  <tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> לַעֲדֵי עַד יִמְלוֹךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:melekh_elyon/4"/>מֶלֶךְ עֶלְיוֹן. זוֹכֵר צוּרִים. זַכּוֹת יְצוּרִים. זוֹעֵם צָרִים.  <tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> לַעֲדֵי עַד יִמְלוֹךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:melekh_elyon/5"/>מֶלֶךְ עֶלְיוֹן. טוֹב שׁוֹכֵן עַד. טוּבוֹ לָעַד. טִפַּח שְׁמֵי עַד.  <tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> לַעֲדֵי עַד יִמְלוֹךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:melekh_elyon/6"/>מֶלֶךְ עֶלְיוֹן. כַּשַּׂלְמָה עוֹטֶה אוֹר. כָּל מְאוֹרֵי אוֹר. כַּבִּיר וְנָאוֹר.  <tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> לַעֲדֵי עַד יִמְלוֹךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:melekh_elyon/7"/>מֶלֶךְ עֶלְיוֹן. מֶלֶךְ עוֹלָמִים. מְפַעֲנֵחַ נֶעֱלָמִים. מֵשִׂיחַ אִלְּמִים.  <tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> לַעֲדֵי עַד יִמְלוֹךְ: </tei:p>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n233.jpg" n="107"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:melekh_elyon/8"/>מֶלֶךְ עֶלְיוֹן. סוֹבֵל הַכֹּל. סָב וּמְבַלֶּה כֹּל. סוֹקֵר הַכֹּל.  <tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> לַעֲדֵי עַד יִמְלוֹךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:melekh_elyon/9"/>מֶלֶךְ עֶלְיוֹן. פְּאֵרוֹ עֹז. פֹּעַל יְמִינוֹ הָעֹז. פּוֹדֶה וּמָעוֹז.  <tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> לַעֲדֵי עַד יִמְלוֹךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:melekh_elyon/10"/>מֶלֶךְ עֶלְיוֹן. קְדוֹשָׁיו לַהַב. קוֹרֵא מֵי רַהַב. קָרוֹב לְקוֹרְאָיו בָּאֹהַב.  <tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> לַעֲדֵי עַד יִמְלוֹךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:melekh_elyon/11"/>מֶלֶךְ עֶלְיוֹן. שֵׁנָה אֵין לְפָנָיו. שֶׁקֶט בִּפְנִינָיו. שֶׁבַח טוֹב בְּמַצְפּוּנָיו.  <tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> לַעֲדֵי עַד יִמְלוֹךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:melekh_elyon/12"/>מֶלֶךְ עֶלְיוֹן.  <tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>קו״ח</tei:abbr><tei:expan>קהל וחזן</tei:expan></tei:choice></tei:note> תָּקְפּוֹ לָעַד. תִּפְאַרְתּוֹ עֲדֵי עַד. תְּהִלָּתוֹ עוֹמֶדֶת לָעַד.  לַעֲדֵי עַד יִמְלוֹךְ: <tei:milestone unit="stanza"/></tei:p>
      </tei:div>
    </tei:body>
