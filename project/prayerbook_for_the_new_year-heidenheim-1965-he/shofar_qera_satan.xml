    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n185.jpg">
        <tei:note type="instruction" xml:lang="he"><tei:choice><tei:abbr>ואח״כ</tei:abbr><tei:expan>ואחר כך</tei:expan></tei:choice> יאמר, ויכוין <tei:choice><tei:abbr>בר״ת</tei:abbr><tei:expan>בראשי תיבות</tei:expan></tei:choice> קרע שטן.</tei:note>
        <tei:p><tei:milestone unit="chapter" n="3" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan/lamentations_3"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan/lamentations_3/56" n="56"/><tei:seg source="urn:x-opensiddur:text:bible:lamentations/3/56">קוֹלִי שָׁמָעְתָּ אַל־תַּעְלֵם אָזְנְךָ לְרַוְחָתִי לְשַׁוְעָתִי:</tei:seg> </tei:p>
        <tei:p><tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="chapter" n="119" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan/psalms_119"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan/psalms_119/160" n="160"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/119/160">רֹאשׁ דְּבָרְךָ אֱמֶת וּלְעוֹלָם כָּל־מִשְׁפַּט צִדְקֶךָ:</tei:seg> </tei:p>
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan/psalms_119/122" n="122"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/119/122">עֲרֹב עַבְדְּךָ לְטוֹב אַל־יַעַשְׁקֻנִי זֵדִים:</tei:seg> </tei:p>
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan/psalms_119/162" n="162"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/119/162">שָׂשׂ אָנֹכִי עַל־אִמְרָתֶךָ כְּמוֹצֵא שָׁלָל רָב:</tei:seg> </tei:p>
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan/psalms_119/66" n="66"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/119/66">טוּב טַעַם וָדַעַת לַמְּדֵנִי כִּי בְמִצְוֹתֶיךָ הֶאֱמָנְתִּי:</tei:seg> </tei:p>
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan/psalms_119/108" n="108"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/119/108">נִדְבוֹת פִּי רְצֵה־נָא <j:divineName>יְיָ</j:divineName> וּמִשְׁפָּטֶיךָ לַמְּדֵנִי:</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
