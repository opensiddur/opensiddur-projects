      <tei:div facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n8.jpg">
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/qadosh"/><tei:milestone unit="chapter" n="6" corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/qadosh/quotations/isaiah_6"/><tei:milestone unit="verse" n="3" corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/qadosh/quotations/isaiah_6/3"/><tei:milestone unit="verse-part" n="qadosh" corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/qadosh/quotations/isaiah_6/3/qadosh"/><tei:seg source="urn:x-opensiddur:text:bible:isaiah/6/3">קָדוֹשׁ קָדוֹשׁ קָדוֹשׁ <j:divineName>יְיָ</j:divineName> צְבָאוֹת מְלֹא <tei:choice><j:option corresp="urn:x-opensiddur:condition:prayer:amidah/qedushah/qadosh/haaretz_without_meteg" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n8.jpg">כָל־הָאָרֶץ</j:option><j:option corresp="urn:x-opensiddur:condition:prayer:amidah/qedushah/qadosh/haaretz_with_meteg" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n237.jpg">כָל־הָאָֽרֶץ</j:option></tei:choice> כְּבוֹדוֹ:</tei:seg><tei:milestone unit="verse-part"/><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> </tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/barukh_kevod"/><tei:milestone unit="chapter" n="3" corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/barukh_kevod/quotations/ezekiel_3"/><tei:milestone unit="verse" n="12" corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/barukh_kevod/quotations/ezekiel_3/12"/><tei:milestone unit="half-verse" n="b" corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/barukh_kevod/quotations/ezekiel_3/12/b"/><tei:seg source="urn:x-opensiddur:text:bible:ezekiel/3/12">בָּרוּךְ <tei:choice><j:option corresp="urn:x-opensiddur:condition:prayer:amidah/qedushah/barukh_kevod/kevod_name_with_maqaf" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n8.jpg">כְּבוֹד־<j:divineName>יְיָ</j:divineName></j:option><j:option corresp="urn:x-opensiddur:condition:prayer:amidah/qedushah/barukh_kevod/kevod_name_without_maqaf" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n239.jpg">כְּבוֹד <j:divineName>יְיָ</j:divineName></j:option></tei:choice> מִמְּקוֹמוֹ:</tei:seg><tei:milestone unit="half-verse"/><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> </tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/uvedivrei"/>וּבְדִבְרֵי קָדְשְׁךָ כָּתוּב לֵאמֹר. </tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/ledor_vador"/><tei:choice><j:option corresp="urn:x-opensiddur:condition:prayer:amidah/qedushah/ledor_vador/dor_plene" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n8.jpg">לְדוֹר וָדוֹר</j:option><j:option corresp="urn:x-opensiddur:condition:prayer:amidah/qedushah/ledor_vador/dor_defective" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n245.jpg">לְדֹר וָדֹר</j:option></tei:choice> נַגִּיד גָּדְלֶךָ וּלְנֵצַח נְצָחִים קְדֻשָּׁתְךָ נַקְדִּישׁ וְשִׁבְחֲךָ אֱלֹהֵינוּ מִפִּינוּ לֹא יָמוּשׁ לְעוֹלָם וָעֶד כִּי אֵל מֶלֶךְ גָּדוֹל וְקָדוֹשׁ אָתָּה. <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
