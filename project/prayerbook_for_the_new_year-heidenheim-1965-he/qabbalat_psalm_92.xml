  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n16.jpg">
        <tei:p><tei:milestone unit="chapter" n="92"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/1" n="1"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/92/1">מִזְמוֹר שִׁיר לְיוֹם הַשַּׁבָּת:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/2" n="2"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/92/2">טוֹב לְהֹדוֹת לַ<j:divineName>יהֹוָה</j:divineName> וּלְזַמֵּר לְשִׁמְךָ עֶלְיוֹן:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/3" n="3"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/92/3">לְהַגִּיד בַּבֹּקֶר חַסְדֶּךָ וֶאֱמוּנָתְךָ בַּלֵּילוֹת:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/4" n="4"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/92/4">עֲלֵי־עָשׂוֹר וַעֲלֵי־נָבֶל עֲלֵי הִגָּיוֹן בְּכִנּוֹר:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/5" n="5"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/92/5">כִּי שִׂמַּחְתַּנִי <j:divineName>יְהֹוָה</j:divineName> בְּפָעֳלֶךָ בְּמַעֲשֵׂי יָדֶיךָ אֲרַנֵּן:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/6" n="6"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/92/6">מַה־גָּדְלוּ מַעֲשֶׂיךָ <j:divineName>יְהֹוָה</j:divineName> מְאֹד עָמְקוּ מַחְשְׁבֹתֶיךָ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/7" n="7"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/92/7">אִישׁ בַּעַר לֹא יֵדָע וּכְסִיל לֹא־יָבִין אֶת־זֹאת:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/8" n="8"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/92/8">בִּפְרֹחַ רְשָׁעִים כְּמוֹ עֵשֶׂב וַיָּצִיצוּ כָּל־פֹּעֲלֵי אָוֶן לְהִשָּׁמְדָם עֲדֵי־עַד:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/9" n="9"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/92/9">וְאַתָּה מָרוֹם לְעֹלָם <j:divineName>יְהֹוָה</j:divineName>:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/10" n="10"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/92/10">כִּי הִנֵּה אֹיְבֶיךָ <j:divineName>יְהֹוָה</j:divineName> כִּי־הִנֵּה אֹיְבֶיךָ יֹאבֵדוּ יִתְפָּרְדוּ כָּל־פֹּעֲלֵי אָוֶן:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/11" n="11"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/92/11">וַתָּרֶם כִּרְאֵים קַרְנִי בַּלֹּתִי בְּשֶׁמֶן רַעֲנָן:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/12" n="12"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/92/12">וַתַּבֵּט עֵינִי בְּשׁוּרָי בַּקָּמִים עָלַי מְרֵעִים תִּשְׁמַעְנָה אָזְנָי:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/13" n="13"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/92/13">צַדִּיק כַּתָּמָר יִפְרָח כְּאֶרֶז בַּלְּבָנוֹן יִשְׂגֶּה:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/14" n="14"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/92/14">שְׁתוּלִים בְּבֵית <j:divineName>יְהֹוָה</j:divineName> בְּחַצְרוֹת אֱלֹהֵינוּ יַפְרִיחוּ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/15" n="15"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/92/15">עוֹד יְנוּבוּן בְּשֵׂיבָה דְּשֵׁנִים וְרַעֲנַנִּים יִהְיוּ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/16" n="16"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/92/16">לְהַגִּיד כִּי־יָשָׁר <j:divineName>יְהֹוָה</j:divineName> צוּרִי וְלֹא־עַוְלָתָה בּוֹ:</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
