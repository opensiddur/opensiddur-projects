  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/text/yehi_ratzon_temple" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n31.jpg">
        <tei:p>יְהִי רָצוֹן לְפָנֶיךָ <j:divineName>יְיָ</j:divineName> אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ שֶׁיִּבָּנֶה בֵּית הַמִּקְדָּשׁ בִּמְהֵרָה בְיָמֵינוּ וְתֵן חֶלְקֵנוּ בְּתוֹרָתֶךָ: וְשָׁם נַעֲבָדְךָ בְּיִרְאָה כִּימֵי עוֹלָם וּכְשָׁנִים קַדְמֹנִיּוֹת: <tei:milestone unit="chapter" n="3"/><tei:milestone unit="verse" n="4" corresp="urn:x-opensiddur:text:bible:malachi/3/4"/><tei:seg source="urn:x-opensiddur:text:bible:malachi/3/4">וְעָרְבָה לַ<j:divineName>ייָ</j:divineName> מִנְחַת יְהוּדָה וִירוּשָׁלָםִ כִּימֵי עוֹלָם וּכְשָׁנִים קַדְמֹנִיּוֹת:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> </tei:p>
      </tei:div>
    </tei:body>
