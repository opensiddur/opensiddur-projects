      <tei:div corresp="urn:x-opensiddur:text:prayer:yotzer_or/el_barukh" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n103.jpg">
        <j:conditional xml:id="yotzer_el_barukh_condition">
          <j:all>
            <tei:fs type="opensiddur:holiday-aggregate">
              <tei:f name="shabbat">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:all>
        </j:conditional>
        <tei:p>אֵל בָּרוּךְ גְּדוֹל דֵּעָה. הֵכִין וּפָעַל זָהֳרֵי חַמָּה. טוֹב יָצַר כָּבוֹד לִשְׁמוֹ. מְאוֹרוֹת נָתַן סְבִיבוֹת עֻזּוֹ. פִּנּוֹת צְבָאָיו קְדוֹשִׁים רוֹמְמֵי שַׁדָּי. תָּמִיד מְסַפְּרִים כְּבוֹד־אֵל וּקְדֻשָּׁתוֹ: תִּתְבָּרַךְ <j:divineName>יְיָ</j:divineName> אֱלֹהֵינוּ עַל־שֶׁבַח מַעֲשֵׂה יָדֶיךָ. וְעַל־מְאוֹרֵי־אוֹר שֶׁעָשִׂיתָ יְפָאֲרוּךָ סֶּלָה: </tei:p>
        <j:endConditional target="#yotzer_el_barukh_condition"/>
