      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/yehi_ratzon_temple" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n123.jpg">
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/yehi_ratzon_temple/text"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/yehi_ratzon">יְהִי רָצוֹן לְפָנֶיךָ <j:divineName>יְיָ</j:divineName> אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ שֶׁיִּבָּנֶה בֵּית הַמִּקְדָּשׁ בִּמְהֵרָה בְיָמֵינוּ וְתֵן חֶלְקֵנוּ בְּתוֹרָתֶךָ: וְשָׁם נַעֲבָדְךָ בְּיִרְאָה כִּימֵי עוֹלָם וּכְשָׁנִים קַדְמוֹנִיּוֹת:</tei:seg> <tei:milestone unit="chapter" n="3" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/yehi_ratzon_temple/quotations/quoted_malachi_3_4"/><tei:milestone unit="verse" n="4" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/yehi_ratzon_temple/quotations/quoted_malachi_3_4/4"/><tei:seg source="urn:x-opensiddur:text:bible:malachi/3/4">וְעָרְבָה לַ<j:divineName>יְיָ</j:divineName> מִנְחַת יְהוּדָה וִירוּשָׁלַם כִּימֵי עוֹלָם וּכְשָׁנִים קַדְמוֹנִיּוֹת:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
