  <tei:text>
    <tei:body>
      <tei:div facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n73.jpg">
        <tei:p><tei:milestone unit="chapter" n="33" corresp="urn:x-opensiddur:text:bible:psalms/33"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/1" n="1"/>רַנֲנוּ צַדִּיקִים בַּ<j:divineName>יהֹוָה</j:divineName> לַיְשָׁרִים נָאוָה תְהִלָּה: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/2" n="2"/>הוֹדוּ לַ<j:divineName>יהֹוָה</j:divineName> בְּכִנּוֹר בְּנֵבֶל עָשׂוֹר זַמְּרוּ־לוֹ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/3" n="3"/>שִֽׁירוּ לוֹ שִׁיר חָדָשׁ הֵיטִֽיבוּ נַגֵּן בִּתְרוּעָה: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/4" n="4"/>כִּי־יָשָׁר דְּבַר־<j:divineName>יְהֹוָה</j:divineName> וְכָל־מַעֲשֵֽׂהוּ בֶּאֱמוּנָה: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/5" n="5"/>אֹהֵב צְדָקָה וּמִשְׁפָּט חֶסֶד <j:divineName>יְהֹוָה</j:divineName> מָלְאָה הָאָרֶץ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/6" n="6"/>בִּדְבַר <j:divineName>יְהֹוָה</j:divineName> שָׁמַיִם נַעֲשׂוּ וּבְרוּחַ פִּיו כָּל־צְבָאָם: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/7" n="7"/>כֹּנֵס כַּנֵּד מֵי הַיָּם נֹתֵן בְּאוֹצָרוֹת תְּהוֹמוֹת: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/8" n="8"/>יִירְאוּ מֵ<j:divineName>יְהֹוָה</j:divineName> כָּל־הָאָרֶץ מִמֶּנּוּ יָגוּרוּ כָּל־יֹשְׁבֵי תֵבֵל: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/9" n="9"/>כִּי הוּא אָמַר וַיֶּֽהִי הוּא צִוָּה וַיַּעֲמֹד: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/10" n="10"/><j:divineName>יְהֹוָה</j:divineName> הֵפִיר עֲצַת גּוֹיִם הֵנִיא מַחְשְׁבוֹת עַמִּים: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/11" n="11"/>עֲצַת <j:divineName>יְהֹוָה</j:divineName> לְעוֹלָם תַּעֲמֹד מַחְשְׁבוֹת לִבּוֹ לְדֹר וָדֹר: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/12" n="12"/>אַשְׁרֵי הַגּוֹי אֲשֶׁר־<j:divineName>יְהֹוָה</j:divineName> אֱלֹהָיו הָעָם בָּחַר לְנַחֲלָה לוֹ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/13" n="13"/>מִשָּׁמַיִם הִבִּיט <j:divineName>יְהֹוָה</j:divineName> רָאָה אֶת־כָּל־בְּנֵי הָאָדָם: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/14" n="14"/>מִמְּכוֹן שִׁבְתּוֹ הִשְׁגִּיחַ אֶל כָּל־יֹשְׁבֵי הָאָרֶץ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/15" n="15"/>הַיֹּצֵר יַחַד לִבָּם הַמֵּבִין אֶל־כָּל־מַעֲשֵׂיהֶם: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/16" n="16"/>אֵין הַמֶּלֶךְ נוֹשָׁע בְּרָב־חָיִל גִּבּוֹר לֹא־יִנָּצֵל בְּרָב־כֹּחַ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/17" n="17"/>שֶׁקֶר הַסּוּס לִתְשׁוּעָה וּבְרֹב <tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n75.jpg" n="23"/>חֵילוֹ לֹא יְמַלֵּט: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/18" n="18"/>הִנֵּה עֵין <j:divineName>יְהֹוָה</j:divineName> אֶל־יְרֵאָיו לַמְיַחֲלִים לְחַסְדּוֹ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/19" n="19"/>לְהַצִּיל מִמָּוֶת נַפְשָׁם וּלְחַיּוֹתָם בָּרָעָב: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/20" n="20"/>נַפְשֵׁנוּ חִכְּתָה לַ<j:divineName>יהֹוָה</j:divineName> עֶזְרֵנוּ וּמָגִנֵּנוּ הוּא: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/21" n="21"/>כִּי־בוֹ יִשְׂמַח לִבֵּנוּ כִּי בְשֵׁם קָדְשׁוֹ בָטָחְנוּ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/22" n="22"/>יְהִי־חַסְדְּךָ <j:divineName>יְהֹוָה</j:divineName> עָלֵינוּ כַּאֲשֶׁר יִחַלְנוּ לָךְ: <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
