    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:adon_olam" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n43.jpg">
        <tei:lg>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam/adon_olam"/>אֲדוֹן עוֹלָם אֲשֶׁר מָלַךְ. בְּטֶרֶם כָּל־יְצִיר נִבְרָא: </tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam/leet_naasah"/>לְעֵת נַעֲשָׂה בְחֶפְצוֹ כֹּל. אֲזַי מֶלֶךְ שְׁמוֹ נִקְרָא: </tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam/veacharei"/>וְאַחֲרֵי כִּכְלוֹת הַכֹּל. לְבַדּוֹ יִמְלוֹךְ נוֹרָא: </tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam/vehu_hayah"/>וְהוּא הָיָה וְהוּא הֹוֶה. וְהוּא יִהְיֶה בְּתִפְאָרָה: </tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam/vehu_echad"/>וְהוּא אֶחָד וְאֵין שֵׁנִי לְהַמְשִׁיל לוֹ לְהַחְבִּירָה: </tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam/beli_reshit"/>בְּלִי רֵאשִׁית בְּלִי תַכְלִית. וְלוֹ הָעֹז וְהַמִּשְׂרָה: </tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam/vehu_eli"/>וְהוּא אֵלִי וְחַי גֹּאֲלִי. וְצוּר חֶבְלִי בְּעֵת צָרָה: </tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam/vehu_nissi"/>וְהוּא נִסִּי וּמָנוֹס לִי. מְנָת כּוֹסִי בְּיוֹם אֶקְרָא: </tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam/beyado"/>בְּיָדוֹ אַפְקִיד רוּחִי. בְּעֵת אִישַׁן וְאָעִירָה: </tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam/veim_ruchi"/>וְעִם־רוּחִי גְּוִיָּתִי. <j:divineName>יְיָ</j:divineName> לִי וְלֹא אִירָא: <tei:milestone unit="stanza"/></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
