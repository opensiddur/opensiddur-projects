    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:qol_ohalah_haviv">
        <tei:head>קוֹל אָהֳלָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qol_ohalah_haviv/1"/>
        <tei:lg>
          <tei:l>קוֹל אָהֳלָה תִּתְיַפֵּֽחַ קוֹל מִשְּׁבִי מַר צוֹרֵֽחַ</tei:l>
          <tei:l>קוֹל אָהֳלִיבָה מִשִּׁבְיָהּ קָרַע לְבָבִי קוֹל בִּכְיָהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qol_ohalah_haviv/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חֶ</tei:seg>לְקַת יְקָר אֵין לִרְאוּבֵן</tei:l>
          <tei:l>שִׁמְעוֹן בְּמַרְגֵּמַת אֶֽבֶן</tei:l>
          <tei:l>אָמְרוּ לְיִשָּׂשכָר הַבֵּן</tei:l>
          <tei:l>אֵין פֶּה זְבוּלוּן פּוֹתֵֽחַ</tei:l>
          <tei:l>מֵהַר לְגִבְעָה בּוֹרֵֽחַ׃</tei:l>
          <tei:l>קוֹל...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qol_ohalah_haviv/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בַּ</tei:seg>טִּיט יְהוּדָה אֵיךְ נִטְמָן</tei:l>
          <tei:l>לֵוִי וּבִנְיָמִין אַלְמָן</tei:l>
          <tei:l>וּבְבֵית דְּבִיר הוּשַׂם חַמָּן</tei:l>
          <tei:l>חַטֹּאת נְעוּרַי זֶה פִּרְיָהּ</tei:l>
          <tei:l>עַד שַׁלְּמָהּ נַפְשִׁי נִשְׁיָהּ׃</tei:l>
          <tei:l>קוֹל...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qol_ohalah_haviv/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">י</tei:seg>וֹסֵף וְגָד אֵיךְ גֹּרָֽשׁוּ</tei:l>
          <tei:l>אָשֵׁר וְנַפְתָּלִי מָֽשׁוּ</tei:l>
          <tei:l>אֵיךְ מַחֲנוֹת דָּן נוֹקָֽשׁוּ</tei:l>
          <tei:l>אֵין אָהֳלֵיהֶם מוֹתֵֽחַ</tei:l>
          <tei:l>וּזְמַן לְאֵידָם שָׂמֵֽחַ׃</tei:l>
          <tei:l>קוֹל...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qol_ohalah_haviv/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בַּ</tei:seg>ת נָעֲמָה מִכׇּל־בָּנוֹת</tei:l>
          <tei:l>תֶּאֱסֹף וְתִשְׁלַח־לָהּ מָנוֹת</tei:l>
          <tei:l>אָמְרוּ נְבוּאוֹת נֶאֱמָנוֹת</tei:l>
          <tei:l>הַרְאֵה לְכׇל־עַמִּים יׇפְיָהּ</tei:l>
          <tei:l>כִּֽי־יַעֲקֹ֗ב בָּחַ֣ר ל֣וֹ יָ֑הּ׃ <tei:bibl>(תהלים קלה:ד)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
