    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:shlosh_esreh_britot_mayer">
        <tei:head>שְׁלֹשׁ עֶשְׂרֵה בְּרִיתוֹת</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shlosh_esreh_britot_mayer/1"/>
        <tei:lg>
          <tei:l>שְׁלֹשׁ עֶשְׂרֵה בְּרִיתוֹת <tei:seg type="acrostic">אָ</tei:seg>ב הָמוֹן קִבֵּל עַל־בָּנִים</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>רִית מִילָה גִּיל תּוֹרָה וּשְׂשׂוֹן חֲתָנִים</tei:l>
          <tei:l>בְּיוֹם בַּר מִצְוָתוֹ <tei:seg type="acrostic">גּ</tei:seg>וֹנֵן שׁוֹמְרֵי אֱמוּנִים</tei:l>
          <tei:l><tei:seg type="acrostic">דּ</tei:seg>וֹר שָׁמוּר יִגְדַּל תַּֽחַת מָגִנִּים׃</tei:l>
          <tei:l>בא״י מָגֵן אַבְרָהָם׃</tei:l>
          <tei:l>אַתָּה גִּבּוֹר...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shlosh_esreh_britot_mayer/2"/>
        <tei:lg>
          <tei:l>שְׁלֹשׁ עֶשְׂרֵה מִדּוֹת <tei:seg type="acrostic">הָ</tei:seg>רַחֲמִים הוֹרֵֽיתָ לְמָשׁוּי מִמַּֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>נִשְׁבַּֽעְתָּ שֶׁטַּל חֶֽסֶד תּוֹרִיד מִשָּׁמַֽיִם</tei:l>
          <tei:l>בְּיוֹם בַּר מִצְוָתוֹ <tei:seg type="acrostic">זְ</tei:seg>כֹר זָכָר זֶה כִּמְנַשֶּׁה וְאֶפְרַֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">חַ</tei:seg>זְּקֵֽהוּ בְּטַלְלֵי אוֹר הַשָּׁמַֽיִם׃</tei:l>
          <tei:l>בא״י מְחַיֵּה הַמֵּתִים׃</tei:l>
          <tei:l><tei:note type="instruction">אשכנז</tei:note> נַעֲרִיצְךָ/ <tei:note type="instruction">ספרד</tei:note> כֶּֽתֶר...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shlosh_esreh_britot_mayer/3"/>
        <tei:lg>
          <tei:l>שְׁלשָׁה עָשָׂר עִקָּרִים <tei:seg type="acrostic">טְ</tei:seg>בוּעִים בְּדַת יִשְׂרָאֵל</tei:l>
          <tei:l><tei:seg type="acrostic">יִ</tei:seg>גְדַּל אֱלֹהִים חַי וְיִשְׁתַּבַּח הַגּוֹאֵל</tei:l>
          <tei:l>בְּיוֹם בַּר מִצְוָתוֹ <tei:seg type="acrostic">כּ</tei:seg>וֹנְנֵֽהוּ לְמַלֵּא עֲשָׂרָה בַּאֲרִיאֵל</tei:l>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>הוֹסִיף לִשְׁלֹֽשֶׁת קְדֻשּׁוֹת יִשְׂרָאֵל׃</tei:l>
          <tei:l>בא״י הָאֵל (<tei:note type="instruction">שבת שובה –</tei:note> הַמֶּֽלֶךְ) הַקָּדוֹשׁ׃</tei:l>
          <tei:l>תִּכַּֽנְתָּ...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shlosh_esreh_britot_mayer/4"/>
        <tei:lg>
          <tei:l>שְׁלֹשׁ עֶשְׂרֵה מִדּוֹת <tei:seg type="acrostic">מִ</tei:seg>לֵּל גְּדוֹל הַתַּנָּאִים</tei:l>
          <tei:l><tei:seg type="acrostic">נִ</tei:seg>דְרֶֽשֶׁת הַתּוֹרָה בָּהֵן גַּם כִּתְבֵי מִקְרָאִים</tei:l>
          <tei:l>בְּיוֹם בַּר מִצְוָתוֹ <tei:seg type="acrostic">ס</tei:seg>וֹמֵךְ עָלֶֽיךָ הוּא וְכׇל־בָּאִים</tei:l>
          <tei:l><tei:seg type="acrostic">עַ</tei:seg>ם שׁוֹמְרֵי שַׁבָּת וְעׇנְגָּהּ קוֹרְאִים׃</tei:l>
          <tei:l>בא״י מְקַדֵּשׁ הַשַּׁבָּת׃</tei:l>
          <tei:l>רְצֵה...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shlosh_esreh_britot_mayer/5"/>
        <tei:lg>
          <tei:l>שְׁלשָׁה עָשָׂר שְׁעָרִים <tei:seg type="acrostic">פִּ</tei:seg>תְחֵי הָעֲזָרָה</tei:l>
          <tei:l><tei:seg type="acrostic">צַ</tei:seg>דִּיקִים הִשְׁתַּחֲווּ שָׁם בִּגְבוּרָה</tei:l>
          <tei:l>בְּיוֹם בַּר מִצְוָתוֹ <tei:seg type="acrostic">קִ</tei:seg>בֵּל עוֹל וְאוֹר הַתּוֹרָה</tei:l>
          <tei:l><tei:seg type="acrostic">רְ</tei:seg>צֵה בְּתִפְלָתֵֽנוּ נַעֲבׇדְךָ בְּיִרְאָה׃</tei:l>
          <tei:l>בא״י הַמַּחֲזִיר שְׁכִינָתוֹ לְצִיּוֹן׃</tei:l>
          <tei:l>מוֹדִים...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shlosh_esreh_britot_mayer/6"/>
        <tei:lg>
          <tei:l>שְׁלֹשָׁה עָשָׂר שׁוֹפָרוֹת <tei:seg type="acrostic">שֻׁ</tei:seg>לְחָנוֹת וְהִשְׁתַּחֲוָיוֹת כָּנֶגְדָם</tei:l>
          <tei:l><tei:seg type="acrostic">שֶׁ</tei:seg>כֵּן נִמְסְרָה לָנוּ מָסוֹרָתֵֽנוּ עַל־יָדָם</tei:l>
          <tei:l>בְּיוֹם בַּר מִצְוָתוֹ <tei:seg type="acrostic">תּ</tei:seg>וֹלֶה בְּךָ כׇּל־אָדָם</tei:l>
          <tei:l><tei:seg type="acrostic">תּ</tei:seg>וֹדוֹת נוֹדֶה וּלְךָ נִסְגֹּד צוּרָם וִיסוֹדָם׃</tei:l>
          <tei:l>בא״י הַטּוֹב שִׁמְךָ וּלְךָ נָאֶה לְהוֹדוֹת׃</tei:l>
          <tei:l>שִׂים...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shlosh_esreh_britot_mayer/7"/>
        <tei:lg>
          <tei:l>שְׁלֹשָׁה עָשָׂר שָׁנִים יְׄלִידֵי צִׄיּוֹן מַגִּיעִים לַבַּגְרוּת</tei:l>
          <tei:l>חֲׄכָמִים קְׄבָעֽוּהוּ עַל־לוּחוֹת חָרוּת</tei:l>
          <tei:l>בְּיוֹם בַּר מִצְוָתוֹ מְׄנָת אֵׄל כְּאַבְרָהָם וְרוּת</tei:l>
          <tei:l>יְׄקַבֵּל רֵׄעֲךָ הַזֶּה שָׁלוֹם וְשַׁלְוָה וְחֵרוּת׃</tei:l>
          <tei:l>בא״י הַמְבָרֵךְ אֶת־עַמּוֹ יִשְׂרָאֵל בַּשָּׁלוֹם׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
