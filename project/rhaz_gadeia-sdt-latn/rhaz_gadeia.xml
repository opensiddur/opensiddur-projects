  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:rhaz_gadeia">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:rhaz_gadeia/1"/>
        <tei:lg>
          <tei:l>Un cabri, un cabri</tei:l>
          <tei:l>qu’avé ‘tchéta moun païre un escu, dous escu.</tei:l>
          <tei:l>Qu’avé ‘tchéta moun païre un escu, dous escu...</tei:l>
          <tei:l>rhaz gadeïa, rhaz gadeïa!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:rhaz_gadeia/2"/>
        <tei:lg>
          <tei:l>Es vengu lou ca</tei:l>
          <tei:l>qu’avé mandja lou cabri</tei:l>
          <tei:l>qu’avé ‘tchéta moun païre un escu, dous escu.</tei:l>
          <tei:l>Qu’avé ‘tchéta moun païre un escu, dous escu...</tei:l>
          <tei:l>rhaz gadeïa, rhaz gadeïa!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:rhaz_gadeia/3"/>
        <tei:lg>
          <tei:l>Es vengu lou tchin</tei:l>
          <tei:l>qu’avé mourdu lou ca</tei:l>
          <tei:l>qu’avé mandja lou cabri</tei:l>
          <tei:l>qu’avé ‘tchéta moun païre un escu, dous escu.</tei:l>
          <tei:l>Qu’avé ‘tchéta moun païre un escu, dous escu...</tei:l>
          <tei:l>rhaz gadeïa, rhaz gadeïa!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:rhaz_gadeia/4"/>
        <tei:lg>
          <tei:l>Es vengu la vergue</tei:l>
          <tei:l>qu’avé pica lou tchin</tei:l>
          <tei:l>qu’avé mourdu lou ca</tei:l>
          <tei:l>qu’avé mandja lou cabri</tei:l>
          <tei:l>qu’avé ‘tchéta moun païre un escu, dous escu.</tei:l>
          <tei:l>Qu’avé ‘tchéta moun païre un escu, dous escu...</tei:l>
          <tei:l>rhaz gadeïa, rhaz gadeïa!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:rhaz_gadeia/5"/>
        <tei:lg>
          <tei:l>Es vengu lou fiou</tei:l>
          <tei:l>qu’avé brula la vergue</tei:l>
          <tei:l>qu’avé pica lou tchin</tei:l>
          <tei:l>qu’avé mourdu lou ca</tei:l>
          <tei:l>qu’avé mandja lou cabri</tei:l>
          <tei:l>qu’avé ‘tchéta moun païre un escu, dous escu.</tei:l>
          <tei:l>Qu’avé ‘tchéta moun païre un escu, dous escu...</tei:l>
          <tei:l>rhaz gadeïa, rhaz gadeïa!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:rhaz_gadeia/6"/>
        <tei:lg>
          <tei:l>Es vengu toute l’aïgue</tei:l>
          <tei:l>qu’ave moussa lou fiou</tei:l>
          <tei:l>qu’avé brula la vergue</tei:l>
          <tei:l>qu’avé pica lou tchin</tei:l>
          <tei:l>qu’avé mourdu lou ca</tei:l>
          <tei:l>qu’avé mandja lou cabri</tei:l>
          <tei:l>qu’avé ‘tchéta moun païre un escu, dous escu.</tei:l>
          <tei:l>Qu’avé ‘tchéta moun païre un escu, dous escu...</tei:l>
          <tei:l>rhaz gadeïa, rhaz gadeïa!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:rhaz_gadeia/7"/>
        <tei:lg>
          <tei:l>Es vengu lou biou</tei:l>
          <tei:l>qu’avé bégu toute l’aïgue</tei:l>
          <tei:l>qu’ave moussa lou fiou</tei:l>
          <tei:l>qu’avé brula la vergue</tei:l>
          <tei:l>qu’avé pica lou tchin</tei:l>
          <tei:l>qu’avé mourdu lou ca</tei:l>
          <tei:l>qu’avé mandja lou cabri</tei:l>
          <tei:l>qu’avé ‘tchéta moun païre un escu, dous escu.</tei:l>
          <tei:l>Qu’avé ‘tchéta moun païre un escu, dous escu...</tei:l>
          <tei:l>rhaz gadeïa, rhaz gadeïa!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:rhaz_gadeia/8"/>
        <tei:lg>
          <tei:l>Es vengu lou sorhet</tei:l>
          <tei:l>qu’avé sorhéta lou biou</tei:l>
          <tei:l>qu’avé bégu toute l’aïgue</tei:l>
          <tei:l>qu’ave moussa lou fiou</tei:l>
          <tei:l>qu’avé brula la vergue</tei:l>
          <tei:l>qu’avé pica lou tchin</tei:l>
          <tei:l>qu’avé mourdu lou ca</tei:l>
          <tei:l>qu’avé mandja lou cabri</tei:l>
          <tei:l>qu’avé ‘tchéta moun païre un escu, dous escu.</tei:l>
          <tei:l>Qu’avé ‘tchéta moun païre un escu, dous escu...</tei:l>
          <tei:l>rhaz gadeïa, rhaz gadeïa!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:rhaz_gadeia/9"/>
        <tei:lg>
          <tei:l>Es vengu lou malarhama</tei:l>
          <tei:l>qu’avé sorhéta lou sorhet</tei:l>
          <tei:l>qu’avé sorhéta lou biou</tei:l>
          <tei:l>qu’avé bégu toute l’aïgue</tei:l>
          <tei:l>qu’ave moussa lou fiou</tei:l>
          <tei:l>qu’avé brula la vergue</tei:l>
          <tei:l>qu’avé pica lou tchin</tei:l>
          <tei:l>qu’avé mourdu lou ca</tei:l>
          <tei:l>qu’avé mandja lou cabri</tei:l>
          <tei:l>qu’avé ‘tchéta moun païre un escu, dous escu.</tei:l>
          <tei:l>Qu’avé ‘tchéta moun païre un escu, dous escu...</tei:l>
          <tei:l>rhaz gadeïa, rhaz gadeïa!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:rhaz_gadeia/10"/>
        <tei:lg>
          <tei:l>Es vengu lou cados barourhou</tei:l>
          <tei:l>qu’avé sorhéta lou malarhama</tei:l>
          <tei:l>qu’avé sorhéta lou sorhet</tei:l>
          <tei:l>qu’avé sorhéta lou biou</tei:l>
          <tei:l>qu’avé bégu toute l’aïgue</tei:l>
          <tei:l>qu’ave moussa lou fiou</tei:l>
          <tei:l>qu’avé brula la vergue</tei:l>
          <tei:l>qu’avé pica lou tchin</tei:l>
          <tei:l>qu’avé mourdu lou ca</tei:l>
          <tei:l>qu’avé mandja lou cabri</tei:l>
          <tei:l>qu’avé ‘tchéta moun païre un escu, dous escu.</tei:l>
          <tei:l>Qu’avé ‘tchéta moun païre un escu, dous escu...</tei:l>
          <tei:l>rhaz gadeïa, rhaz gadeïa!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
