      <tei:div corresp="urn:x-opensiddur:text:poem:a_prayer_for_reading_the_news_berger">
        <tei:head>A Prayer for Reading the News — by Zackary Sholem Berger</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_prayer_for_reading_the_news_berger/1"/>
        <tei:lg>
          <tei:l>Like a dove</tei:l>
          <tei:l>Let me fly to a new world</tei:l>
          <tei:l>Where I will read the news</tei:l>
          <tei:l>Tear open my heart</tei:l>
          <tei:l>And be alone.</tei:l>
          <tei:l>Tomorrow’s world you have renewed.</tei:l>
          <tei:l>I will be renewed.</tei:l>
          <tei:l>We are the old and new</tei:l>
          <tei:l>In a word we have not yet read</tei:l>
          <tei:l>In a world soaring to another peak.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
