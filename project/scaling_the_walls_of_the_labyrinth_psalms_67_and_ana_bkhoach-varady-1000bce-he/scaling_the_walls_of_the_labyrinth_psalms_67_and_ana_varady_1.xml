  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:scaling_the_walls_of_the_labyrinth_psalms_67_and_ana_varady/1">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:scaling_the_walls_of_the_labyrinth_psalms_67_and_ana_varady/1/1"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">א</tei:hi> לַמְנַצֵּ֥ח בִּנְגִינֹ֗ת מִזְמ֥וֹר שִֽׁיר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:scaling_the_walls_of_the_labyrinth_psalms_67_and_ana_varady/1/2"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ב</tei:hi> אֱלֹהִ֗ים יְחָנֵּ֥נוּ וִֽיבָרְכֵ֑נוּ</tei:l>
          <tei:l>יָ֤אֵ֥ר פָּנָ֖יו אִתָּ֣נוּ סֶֽלָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:scaling_the_walls_of_the_labyrinth_psalms_67_and_ana_varady/1/3"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ג</tei:hi> לָדַ֣עַת בָּאָ֣רֶץ דַּרְכֶּ֑ךָ</tei:l>
          <tei:l>בְּכָל־גּ֝וֹיִ֗ם יְשׁוּעָתֶֽךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:scaling_the_walls_of_the_labyrinth_psalms_67_and_ana_varady/1/4"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ד</tei:hi> יוֹד֖וּךָ עַמִּ֥ים׀ אֱלֹהִ֑ים</tei:l>
          <tei:l>י֝וֹד֗וּךָ עַמִּ֥ים כֻּלָּֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:scaling_the_walls_of_the_labyrinth_psalms_67_and_ana_varady/1/5"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ה</tei:hi> יִֽשְׂמְח֥וּ וִֽירַנְּנ֗וּ לְאֻ֫מִּ֥ים</tei:l>
          <tei:l>כִּֽי־תִשְׁפֹּ֣ט עַמִּ֣ים מִישׁ֑וֹר</tei:l>
          <tei:l>וּלְאֻמִּ֓ים׀ בָּאָ֖רֶץ תַּנְחֵ֣ם סֶֽלָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:scaling_the_walls_of_the_labyrinth_psalms_67_and_ana_varady/1/6"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ו</tei:hi> יוֹד֖וּךָ עַמִּ֥ים׀ אֱלֹהִ֑ים</tei:l>
          <tei:l>י֝וֹד֗וּךָ עַמִּ֥ים כֻּלָּֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:scaling_the_walls_of_the_labyrinth_psalms_67_and_ana_varady/1/7"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ז</tei:hi> אֶ֭רֶץ נָתְנָ֣ה יְבוּלָ֑הּ</tei:l>
          <tei:l>יְ֝בָרְכֵ֗נוּ אֱלֹהִ֥ים אֱלֹהֵֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:scaling_the_walls_of_the_labyrinth_psalms_67_and_ana_varady/1/8"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ח</tei:hi> יְבָרְכֵ֥נוּ אֱלֹהִ֑ים</tei:l>
          <tei:l>וְיִֽירְא֥וּ אֹ֝ת֗וֹ כָּל־אַפְסֵי־אָֽרֶץ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
