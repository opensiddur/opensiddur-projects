  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:scaling_the_walls_of_the_labyrinth_psalms_67_and_ana_varady/2">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:scaling_the_walls_of_the_labyrinth_psalms_67_and_ana_varady/2/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אָ</tei:seg>נָּא בְּכֹחַ</tei:l>
          <tei:l>גְּדֻלַּת יְמִינְךָ</tei:l>
          <tei:l>תַּתִּיר צְרוּרָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:scaling_the_walls_of_the_labyrinth_psalms_67_and_ana_varady/2/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קַ</tei:seg>בֵּל רִנַּת</tei:l>
          <tei:l>עַמְּךָ שַׂגְּבֵנוּ</tei:l>
          <tei:l>טַהֲרֵנוּ נוֹרָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:scaling_the_walls_of_the_labyrinth_psalms_67_and_ana_varady/2/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נָ</tei:seg>א גִבּוֹר,</tei:l>
          <tei:l>דּוֹרְשֵׁי יִחוּדְךָ,</tei:l>
          <tei:l>כְּבָבַת שָׁמְרֵם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:scaling_the_walls_of_the_labyrinth_psalms_67_and_ana_varady/2/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בָּ</tei:seg>רְכֵם טַהֲרֵם,</tei:l>
          <tei:l>רַחֲמֵי צִדְקָתְךָ,</tei:l>
          <tei:l>תָּמִיד גָּמְלֵם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:scaling_the_walls_of_the_labyrinth_psalms_67_and_ana_varady/2/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חָ</tei:seg>סִין קָדוֹשׁ,</tei:l>
          <tei:l>בְּרֹב טוּבְךָ,</tei:l>
          <tei:l>נַהֵל עֲדָתֶךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:scaling_the_walls_of_the_labyrinth_psalms_67_and_ana_varady/2/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>חִיד גֵּאֶה,</tei:l>
          <tei:l>לְעַמְּךָ פְּנֵה,</tei:l>
          <tei:l>זוֹכְרֵי קְדֻשָּׁתֶךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:scaling_the_walls_of_the_labyrinth_psalms_67_and_ana_varady/2/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שַׁ</tei:seg>וְעָתֵנוּ קַבֵּל,</tei:l>
          <tei:l>וּשְׁמַע צַעֲקָתֵנוּ,</tei:l>
          <tei:l>יוֹדֵעַ תַּעֲלוּמוֹת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:scaling_the_walls_of_the_labyrinth_psalms_67_and_ana_varady/2/8"/>
        <tei:lg>
          <tei:l>בָּרוּךְ שֵׁם</tei:l>
          <tei:l>כְּבוֹד מַלְכוּתוֹ</tei:l>
          <tei:l>לְעוֹלָם וָעֶד:‏</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
