    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:asher_yatzar">
        <tei:head>אֲשֶׁר יָצַר</tei:head>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם,</tei:l>
          <tei:l>אֲשֶׁר יָצַר אֶת הָאָדָם בְּחָכְמָה,</tei:l>
          <tei:l>וּבָרָא בוֹ נְקָבִים נְקָבִים, חֲלוּלִים חֲלוּלִים</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>גָּלוּי וְיָדֽוּעַ לִפְנֵי כִסֵּא כְבוֹדֶֽךָ,</tei:l>
          <tei:l>שֶׁאִם יִסׇּתֵם אֶחָד מֵהֶם,</tei:l>
          <tei:l>אוֹ אִם יִפָּתֵֽחַ אֶחָד מֵהֶם,</tei:l>
          <tei:l>אִי אֶפְשַׁר לְהִתְקַיֵּם אֲפִילוּ שָׁעָה אֶחָת.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>רוֹפֵא כׇל בָּשָׂר וּמַפְלִיא לַעֲשֹוֹת׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
