  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_letter_of_passover_instruction">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_letter_of_passover_instruction/1"/>
        <tei:lg>
          <tei:l>אֶל אַחִי יְדַנְיָּה וּכְנָוָתֵהּ חֵילָא יְהוּדַיָּא — אַחוּכֵּם חֲנַנִיָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_letter_of_passover_instruction/2"/>
        <tei:lg>
          <tei:l>שְׁלָם אַחִי אֱלָהַיָּא יִשְׁאָלוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_letter_of_passover_instruction/3"/>
        <tei:lg>
          <tei:l>וּכְעֶת שְׁנָתָא דָּא שְׁנַת חַמֵשׁ דָרְיָוֶהוּשׁ מַלְכָּא מִן מַלְכָּא שְׁלִיחַ עַל אַרְשָׁם לֵאמֹר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_letter_of_passover_instruction/4"/>
        <tei:lg>
          <tei:l>בִּירַח נִיסַן יֶהֱוֵי פֶּסַח לְחֵילָא יְהוּדַיָּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_letter_of_passover_instruction/5"/>
        <tei:lg>
          <tei:l>כְּעֶת אַנְתֵּם כֵּן מְנוּ אַרְבְּעַת עֲשַׂר יוֹמִן לִירַח נִיסַן וּפִסְחָא עִבִדוּ מִן־יוֹם חַמְשָׁא עַשְׂרָא עַד־יוֹם עֶשְׂרִין וְחַד לְנִיסָן שִׁבְעַת יוֹמִן זִי פַּטִּירִן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_letter_of_passover_instruction/6"/>
        <tei:lg>
          <tei:l>אַנְתֵּם דַּכְיָן הֲווּ וְאִזְדָּהֲרוּ עִבִידָה אַל־תַעְבְּדוּ בְּיוֹם חַמְשָׁא עַשְׂרָא וּבְיוֹם עֶשְׂרִין וְחַד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_letter_of_passover_instruction/7"/>
        <tei:lg>
          <tei:l>אַף שֵׁכָר אַל תִשְׁתּוּ וְכָל מִנְדַּעַם זִי חֲמִיר אִיתֵי בַהּ אַל־תֵאכְלוּ מִן יוֹם אַרְבְּעָא עַשְׂרָא לְנִיסָן בְמַעֲרַב שִׁמְשָׁא עַד יוֹם עֶשְׂרִין וְחַד לְנִיסָן שִׁבְעַת יוֹמִן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_letter_of_passover_instruction/8"/>
        <tei:lg>
          <tei:l>אַל יִתְּחֲזֵי בָּכֵם אַל תְהַנְעָלוּ בְּתַוְנֵיכֶם וּחְתִּמוּ בֵּין יוֹמַיָּא אֵלֶּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_letter_of_passover_instruction/9"/>
        <tei:lg>
          <tei:l>כֵּן יִתְעֲבֵד כְּזֵי אֲמַר דָרְיָוֶהוּשׁ מַלְכָּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_letter_of_passover_instruction/10"/>
        <tei:lg>
          <tei:l>אֶל אַחִי יְדַנְיָּה וּכְנָוָתֵהּ חֵילָא יְהוּדַיָּא — אַחוּכֵּם חֲנַנִיָּה׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
