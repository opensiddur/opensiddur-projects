  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/112">
        <tei:head>תהלים קי״ב</tei:head>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>הַ֥לְלוּ יָ֨הּ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אַ</tei:seg>שְׁרֵי־אִ֭ישׁ יָרֵ֣א אֶת־יְהוָ֑ה</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ֝</tei:seg>מִצְוֺתָ֗יו חָפֵ֥ץ מְאֹֽד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/112/2/a"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">גִּ</tei:seg>בּ֣וֹר בָּ֭אָרֶץ יִהְיֶ֣ה זַרְע֑וֹ</tei:l>
          <tei:l><tei:seg type="acrostic">דּ֭</tei:seg>וֹר יְשָׁרִ֣ים יְבֹרָֽךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ה</tei:seg>וֹן־וָעֹ֥שֶׁר בְּבֵית֑וֹ</tei:l>
          <tei:l><tei:seg type="acrostic">וְ֝</tei:seg>צִדְקָת֗וֹ עֹמֶ֥דֶת לָעַֽד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/112/4/a"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זָ֘</tei:seg>רַ֤ח בַּחֹ֣שֶׁךְ א֭וֹר לַיְשָׁרִ֑ים</tei:l>
          <tei:l><tei:seg type="acrostic">חַ</tei:seg>נּ֖וּן וְרַח֣וּם וְצַדִּֽיק׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/112/5/a"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">טֽ</tei:seg>וֹב־אִ֭ישׁ חוֹנֵ֣ן וּמַלְוֶ֑ה</tei:l>
          <tei:l><tei:seg type="acrostic">יְ</tei:seg>כַלְכֵּ֖ל דְּבָרָ֣יו בְּמִשְׁפָּֽט׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/112/6/a"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כִּֽ</tei:seg>י־לְעוֹלָ֥ם לֹא־יִמּ֑וֹט</tei:l>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>זֵ֥כֶר ע֝וֹלָ֗ם</tei:l>
          <tei:l>יִהְיֶ֥ה צַדִּֽיק׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/112/7/a"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>שְּׁמוּעָ֣ה רָ֭עָה לֹ֣א יִירָ֑א</tei:l>
          <tei:l><tei:seg type="acrostic">נָ</tei:seg>כ֥וֹן לִ֝בּ֗וֹ בָּטֻ֥חַ בַּיהוָֽה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/112/8/a"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">סָ</tei:seg>מ֣וּךְ לִ֭בּוֹ לֹ֣א יִירָ֑א</tei:l>
          <tei:l><tei:seg type="acrostic">עַ֖</tei:seg>ד אֲשֶׁר־יִרְאֶ֣ה בְצָרָֽיו׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/112/9/a"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פִּ</tei:seg>זַּ֤ר ׀</tei:l>
          <tei:l>נָ֘תַ֤ן לָאֶבְיוֹנִ֗ים</tei:l>
          <tei:l><tei:seg type="acrostic">צִ֭</tei:seg>דְקָתוֹ עֹמֶ֣דֶת לָעַ֑ד</tei:l>
          <tei:l><tei:seg type="acrostic">קַ֝</tei:seg>רְנ֗וֹ תָּר֥וּם בְּכָבֽוֹד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/112/10/a"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רָ֘</tei:seg>שָׁ֤ע יִרְאֶ֨ה ׀ וְכָעָ֗ס</tei:l>
          <tei:l><tei:seg type="acrostic">שִׁ</tei:seg>נָּ֣יו יַחֲרֹ֣ק וְנָמָ֑ס</tei:l>
          <tei:l><tei:seg type="acrostic">תַּ</tei:seg>אֲוַ֖ת רְשָׁעִ֣ים תֹּאבֵֽד׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
