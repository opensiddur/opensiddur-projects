  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:die_festgebrauche_sind_vollbracht">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:die_festgebrauche_sind_vollbracht/1"/>
        <tei:lg>
          <tei:l>Die Festgebräuche sind vollbracht.</tei:l>
          <tei:l>Laß Himmel nun in dieser Nacht</tei:l>
          <tei:l>Den Wunsch bis zu Dir dringen:</tei:l>
          <tei:l>Beglück’ des frommen Jakobs Stamm!</tei:l>
          <tei:l>Laß ihn das Pesach Opferlamm</tei:l>
          <tei:l>In Zion bald Dir bringen.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:die_festgebrauche_sind_vollbracht/2"/>
        <tei:lg>
          <tei:l>Du Reiner in des Himmelshöh’n!</tei:l>
          <tei:l>Nicht länger laß erniedrigt seh’n</tei:l>
          <tei:l>Das Volk, das Du erkoren.</tei:l>
          <tei:l>Du hast den Stamm für Dich geweiht,</tei:l>
          <tei:l>O! öffne nun zu Sang und Freud’</tei:l>
          <tei:l>Den Sprossen Zions Toren.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
