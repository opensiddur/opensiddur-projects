    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:open_for_us_a_gate_at_the_closing_of_a_gate_marx">
        <tei:head>פתח לנו שער בעת נעילת שער</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:open_for_us_a_gate_at_the_closing_of_a_gate_marx/1"/>
        <tei:lg>
          <tei:l>אֱלֹהֵי הָרוּחוֹת לְכָל בָּשָׂר</tei:l>
          <tei:l>תֵּן בָּנוּ אֹמֶץ</tei:l>
          <tei:l>לְהַמְשִׁיךְ וּלְתַקֵּן</tei:l>
          <tei:l>אֶת עַוְלוֹת הֶעָבָר</tei:l>
          <tei:l>גַּם בִּמְחִיר כְּאֵב</tei:l>
          <tei:l>לְמַעַן תְּהֵא אַרְצֵנוּ בְּרָכָה</tei:l>
          <tei:l>לְכָל יוֹשְׁבֶיהָ וּשְׁכֵנֶיהָ</tei:l>
          <tei:l>וּלְכָל בָּאֵי עוֹלָם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:open_for_us_a_gate_at_the_closing_of_a_gate_marx/2"/>
        <tei:lg>
          <tei:l>שְׁכִינָה, מְקוֹר הָרַחֲמִים,</tei:l>
          <tei:l>בְּעֵת רֵאשִׁית עֲשִׂיַּת צֶדֶק –</tei:l>
          <tei:l>הָגֵנִי עַל מְדִינַת יִשְׂרָאֵל</tei:l>
          <tei:l>רֵאשִׁית צְמִיחַת גְּאֻלָּתֵנוּ,</tei:l>
          <tei:l>רִקְמַת חַיִּים</tei:l>
          <tei:l>בַּת אֶלֶף גָּוֶן וָצֶבַע,</tei:l>
          <tei:l>לְבַל תִּפָּרֵם</tei:l>
          <tei:l>לְבַל תִּקָּרַע.</tei:l>
          <tei:l>שִׁמְרִי</tei:l>
          <tei:l>לְבַל יָקוּם מִי מֵאִתָּנוּ</tei:l>
          <tei:l>וּבְצַעֲרוֹ</tei:l>
          <tei:l>יִפְצַע בָּהּ פֶּצַע.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:open_for_us_a_gate_at_the_closing_of_a_gate_marx/3"/>
        <tei:lg>
          <tei:l>אָבִינוּ מַלְכֵּנוּ</tei:l>
          <tei:l>תֵּן בָּנוּ כֹחַ</tei:l>
          <tei:l>בִּשְׁעַת הִתְנַתְּקוּת</tei:l>
          <tei:l>לְאַחוֹת קְרָעִים</tei:l>
          <tei:l>בִּשְׁעַת הִפָּרְדוּת –</tei:l>
          <tei:l>לֹא לְקַצֵּץ בִּנְטִיעוֹת</tei:l>
          <tei:l>בְּעֵת גְּאוֹת הַכַּעַס –</tei:l>
          <tei:l>לַחֲבֹק</tei:l>
          <tei:l>בְּעֵת הִתְרוֹקְנוּת –</tei:l>
          <tei:l>לְהָכִיל וּלְהִכָּלֵל.</tei:l>
          <tei:l>בְּאוֹרְךָ נִרְאֶה אוֹר</tei:l>
          <tei:l>גַּם בְּהִתְקַדֵּר שָׁמָיִם.</tei:l>
          <tei:l>עֲנֵנוּ בְיוֹם קָרְאֵנוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:open_for_us_a_gate_at_the_closing_of_a_gate_marx/4"/>
        <tei:lg>
          <tei:l>פְּתַח לָנוּ שַׁעַר בְּעֵת נְעִילַת שַׁעַר <tei:bibl>(תפילות הימים הנוראים)</tei:bibl></tei:l>
          <tei:l>לֵב טָהוֹר בְּרָא לָנוּ אֱלֹהִים</tei:l>
          <tei:l>וְרוּחַ נָכוֹן חַדֵּשׁ בְּקִרְבֵּנוּ <tei:bibl>(על פי תהלים נא:יב)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
