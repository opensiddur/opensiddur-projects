  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:an_ungendered_birkat_yeladim_gaber">
        <tei:head>An ungendered Birkat Yeladim, by Yonah Bromberg Gaber</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:an_ungendered_birkat_yeladim_gaber/1"/>
        <tei:lg>
          <tei:l>May <j:divineName>God</j:divineName> make you like Ephraim and like Menashe. <tei:bibl>(Genesis 48:20)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:an_ungendered_birkat_yeladim_gaber/2"/>
        <tei:lg>
          <tei:l>May <j:divineName>God</j:divineName> reward your deeds with complete reckoning. <tei:bibl>(Ruth 2:12)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:an_ungendered_birkat_yeladim_gaber/3"/>
        <tei:lg>
          <tei:l>May <j:divineName>God</j:divineName> bless and protect you.</tei:l>
          <tei:l>May <j:divineName>God</j:divineName> deal kindly and graciously with you.</tei:l>
          <tei:l>May <j:divineName>God</j:divineName> bestow favor upon you and grant you peace. <tei:bibl>(Numbers 6:24-26)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
