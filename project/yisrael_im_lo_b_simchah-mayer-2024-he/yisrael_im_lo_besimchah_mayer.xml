      <tei:div corresp="urn:x-opensiddur:text:poem:yisrael_im_lo_besimchah_mayer">
        <tei:head>יִשְׂרָאֵל אִם־לֹא בְּשִׂמְחָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yisrael_im_lo_besimchah_mayer/1"/>
        <tei:lg>
          <tei:l>...וּלְיַחֶדְךָ בְּאַהֲבָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yisrael_im_lo_besimchah_mayer/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יִ</tei:seg>שְׂרָאֵל אִם־לֹא בְּשִׂמְחָה אָכַֽלְתָּ לֶֽחֶם עֹֽנִי</tei:l>
          <tei:l>לֹא־עָשָׂה אֶת־הָרִאשׁוֹן יַעֲשֶׂה אֶת־הַשֵּׁנִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yisrael_im_lo_besimchah_mayer/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">צַ</tei:seg>דִּיק נִטְמַן בָּאָרֶץ עַד־עוֹלָם נִקְבַּע הַיּוֹם</tei:l>
          <tei:l><tei:seg type="acrostic">ח</tei:seg>וֹזֵר לִטְהֹרָה יָכוֹל לַחְגֹּג עַכְשָׁו פִּדְיוֹם</tei:l>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>דוֹשׁ אוֹדֶה לְךָ כִּי רַק יָדְךָ מְטַהֲרֵֽנִי</tei:l>
          <tei:l>לֹא־עָשָׂה אֶת־הָרִאשׁוֹן יַעֲשֶׂה אֶת־הַשֵּׁנִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yisrael_im_lo_besimchah_mayer/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>דֶֽרֶךְ רְחוֹקָה וּבְטֻמְאָה לֹא יִכָּרֵֽתוּ</tei:l>
          <tei:l><tei:seg type="acrostic">נֶ</tei:seg>אֱנַס וְשָׁגַג חַיָּב כָּרֵת וְהֵם גַּם יְצַיֵּֽתוּ</tei:l>
          <tei:l><tei:seg type="acrostic">אֵֽ</tei:seg>יזוֹ רְחוֹקָה הִיא מֵהָאִסְקֻפָּה וִסֵּֽתוּ</tei:l>
          <tei:l><tei:seg type="acrostic">בֵּ</tei:seg>גִין כֵּן אוֹת הַהֵ״א נָקוּד כַּמְּדַקְדְּקִים יְאַיֵּֽתוּ</tei:l>
          <tei:l><tei:seg type="acrostic">רִ</tei:seg>אשׁוֹן שׁוֹנֶה מִשֵּׁנִי בִּעוּר חָמֵץ וְהַלֵּל בַּאֲכִילָה לֹא יֻנְחַֽתוּ</tei:l>
          <tei:l><tei:seg type="acrostic">הַ</tei:seg>לֵּל בַּעֲשִׂיָּה טָעוּן לִשְׁנֵיהֶם וְשַׁבָּת נִדְחָה אִם בְּיוֹם אֶחָד יַנְחִֽיתוּ</tei:l>
          <tei:l><tei:seg type="acrostic">מַ</tei:seg>צּוֹת וּמְרוֹרִים מְלַוִּים לוֹ צָלוּי כְּצִוִּיתָֽנִי</tei:l>
          <tei:l>לֹא־עָשָׂה אֶת־הָרִאשׁוֹן יַעֲשֶׂה אֶת־הַשֵּׁנִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yisrael_im_lo_besimchah_mayer/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הַ</tei:seg>מִּצְוָה נָתוּנָה בְּיָדֵֽינוּ בְּאַהֲבַת וָתִיק יָמִים</tei:l>
          <tei:l><tei:seg type="acrostic">כִּ</tei:seg>י הוּא יוֹדֵֽעַ אֶת יִצְרֵֽנוּ שֶׁלֹּא מֻשְׁלָמִים</tei:l>
          <tei:l><tei:seg type="acrostic">הָ</tei:seg>אֵל הָאָב הָרַחֲמָן אֲדוֹן הָרַחֲמִים</tei:l>
          <tei:l><tei:seg type="acrostic">נָ</tei:seg>א תַּחֲזִירֶֽנּוּ לַחְגֹּג שֵׁנִי בְּבֵית הָעוֹלָמִים</tei:l>
          <tei:l><tei:seg type="acrostic">חִזְק</tei:seg>וּ יְדִידִים כִּי כְּבָר שִׁלֵּם אֶת־פִּדְיוֹנִי</tei:l>
          <tei:l>לֹא־עָשָׂה אֶת־הָרִאשׁוֹן יַעֲשֶׂה אֶת־הַשֵּׁנִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yisrael_im_lo_besimchah_mayer/6"/>
        <tei:lg>
          <tei:l>בָּאַ״יְ הַבּוֹחֵר...</tei:l>
          <tei:l>
            <tei:note type="instruction">עד קריאת שמע</tei:note>
          </tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
