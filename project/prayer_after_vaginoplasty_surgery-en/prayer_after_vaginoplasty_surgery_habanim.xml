  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_after_vaginoplasty_surgery_habanim">
        <tei:head>Prayer After Vaginoplasty Surgery, by the Em haBanim</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_after_vaginoplasty_surgery_habanim/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">When you awaken from surgery, wash your hands and say this immediately:</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_after_vaginoplasty_surgery_habanim/2"/>
        <tei:lg>
          <tei:l>Behold I accept upon myself</tei:l>
          <tei:l>the positive commandment</tei:l>
          <tei:l>to be whole with <j:divineName>Hashem</j:divineName> <j:divineName>my G-d</j:divineName>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_after_vaginoplasty_surgery_habanim/3"/>
        <tei:lg>
          <tei:l>Blessed are You,</tei:l>
          <tei:l><j:divineName>Hashem</j:divineName>, <j:divineName>our G-d</j:divineName>,</tei:l>
          <tei:l><j:divineName>Ruler of the Universe</j:divineName>,</tei:l>
          <tei:l><j:divineName>the Good One</j:divineName> Who does good.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_after_vaginoplasty_surgery_habanim/4"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">And when you have enough energy, read Psalms 30 and pray all of Hallel without a blessing.</tei:note>
          </tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
