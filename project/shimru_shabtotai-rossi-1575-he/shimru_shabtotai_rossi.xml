    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:shimru_shabtotai_rossi">
        <tei:head>שִׁמְרוּ שַׁבְּתוֹתַי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shimru_shabtotai_rossi/1"/>
        <tei:lg>
          <tei:l>שִׁמְרוּ שַׁבְּתוֹתַי,</tei:l>
          <tei:l>לְמַֽעַן תִּינְקוּ וּשְׂבַעְתֶּם,</tei:l>
          <tei:l>מִזִּיו בִּרְכוֹתַי,</tei:l>
          <tei:l>אֶל הַמְּנוּחָה כִּי בָאתֶם,</tei:l>
          <tei:l>וּלְווּ עָלַי בָּנַי,</tei:l>
          <tei:l>וְעִדְנוּ מַעֲדָנַי,</tei:l>
          <tei:l>שַׁבָּת הַיּוֹם לַייָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shimru_shabtotai_rossi/2"/>
        <tei:lg>
          <tei:l>לְעָמֵל קִרְאוּ דְרוֹר,</tei:l>
          <tei:l>וְנָתַתִּי אֶת בִּרְכָתִי,</tei:l>
          <tei:l>אִשָּׁה אֶל אֲחוֹתָהּ לִצְרוֹר,</tei:l>
          <tei:l>לְגַלּוֹת עַל יוֹם שִׂמְחָתִי,</tei:l>
          <tei:l>בִּגְדֵי שֵׁשׁ עִם שָׁנַי,</tei:l>
          <tei:l>וְהִתְבּוֹנְנוּ מִזְּקֵנַי,</tei:l>
          <tei:l>שַׁבָּת הַיּוֹם לַייָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shimru_shabtotai_rossi/3"/>
        <tei:lg>
          <tei:l>מַהֲרוּ אֶת הַמָּנֶה,</tei:l>
          <tei:l>לַעֲשׂוֹת אֶת דְבַר אֶסְתֵּר,</tei:l>
          <tei:l>וְחִשְׁבוּ עִם הַקּוֹנֶה,</tei:l>
          <tei:l>לְשַׁלֵּם אָכוֹל וְהוֹתֵר,</tei:l>
          <tei:l>בִּטְחוּ בִי אֱמוּנַי,</tei:l>
          <tei:l>וּשְׁתוּ יֵין מִשְׁמַנַּי,</tei:l>
          <tei:l>שַׁבָּת הַיּוֹם לַייָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shimru_shabtotai_rossi/4"/>
        <tei:lg>
          <tei:l>הִנֵּה יוֹם גְּאֻלָּה,</tei:l>
          <tei:l>יוֹם שַׁבָּת אִם תִּשְׁמֹֽרוּ,</tei:l>
          <tei:l>וִהְיִֽיתֶם לִי סְגֻלָּה,</tei:l>
          <tei:l>לִֽינוּ וְאַחַר תַּעֲבֹֽרוּ,</tei:l>
          <tei:l>וְאָז תִּחְיוּ לְפָנַי,</tei:l>
          <tei:l>וּתְמַלְאוּ צְפוּנַי,</tei:l>
          <tei:l>שַׁבָּת הַיּוֹם לַייָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shimru_shabtotai_rossi/5"/>
        <tei:lg>
          <tei:l>חַזֵּק קִרְיָתִי,</tei:l>
          <tei:l>אֵל אֱלֹהִים עֶלְיוֹן,</tei:l>
          <tei:l>וְהָשֵׁב אֶת נְוָתִי,</tei:l>
          <tei:l>בְּשִׂמְחָה וּבְהִגָּיוֹן,</tei:l>
          <tei:l>יְשׁוֹרְרוּ שָׁם רְנָנַי,</tei:l>
          <tei:l>לְוִיַיּ וְכֹהֲנַי,</tei:l>
          <tei:l>וְאָז תִּתְעַנַּג עַל יְיָ,</tei:l>
          <tei:l>שַׁבָּת הַיּוֹם לַייָ.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
