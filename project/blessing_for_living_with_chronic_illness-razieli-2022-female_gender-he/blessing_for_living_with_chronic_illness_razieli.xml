  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:blessing_for_living_with_chronic_illness_razieli">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_for_living_with_chronic_illness_razieli/1"/>
        <tei:lg>
          <tei:l>יְבָרֶכְךָ יְיָ לִהְיוֹת שְׁלֹמֹה כְפִי שֶׁאַתְ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_for_living_with_chronic_illness_razieli/2"/>
        <tei:lg>
          <tei:l>יְבָרֶכְךָ יְיָ עִם רְפוּאָה שְׁלֵמָה</tei:l>
          <tei:l>שֶׁמְאַפְשֶׁרֶת לְךָ לִהְיוֹת שְׁלֹמֹה עִם מְצִיאוֹתֶיךָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_for_living_with_chronic_illness_razieli/3"/>
        <tei:lg>
          <tei:l>שֶׁתִהְיֶה לְךָ שְׁלֵמוּת בְרִגְשׁוֹתֶיךָ בַיָמִים הַקָשִׁים</tei:l>
          <tei:l>וְאֶת הַיְכֹלֶת לְהַרְגִישׁ גִילָה וְשָׂשׂוֹן בַיָמִים הַטּוֹבִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_for_living_with_chronic_illness_razieli/4"/>
        <tei:lg>
          <tei:l>שֶׁתִהְיִי מְבֹרֶכֶת לְקַבֵל אֶת הַיֹפִי וּפִלְאִי הָעוֹלָם</tei:l>
          <tei:l>תּוֹךְ הִסְתַפְקוּת וְנַחַת.</tei:l>
        </tei:lg>
      </tei:div>
