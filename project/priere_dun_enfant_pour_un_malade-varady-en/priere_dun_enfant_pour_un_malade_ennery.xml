  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:priere_dun_enfant_pour_un_malade_ennery">
        <tei:head>Prière d’un enfant pour un malade</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:priere_dun_enfant_pour_un_malade_ennery/1"/>
        <tei:lg>
          <tei:l>A child’s prayer for a sick person.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:priere_dun_enfant_pour_un_malade_ennery/2"/>
        <tei:lg>
          <tei:l>Heavenly Father, you who kindly hear the prayer of your children, be kind to the poor sick person <tei:note type="instruction">(their name)</tei:note>, have mercy on their pain and heal their sickness. Grant them your grace, for the love of your holy name and for the love of our holy patriarchs, Abraham, Isaac and Jacob. <tei:hi rend="italic">Amen selah</tei:hi>.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
