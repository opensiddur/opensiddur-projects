    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd_27880">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd_27880/1"/>
        <tei:lg>
          <tei:l>הַלֵּל הַלֵּל יְבָרְכוּהוּ</tei:l>
          <tei:l>אֱמֶת כָּל מַעֲשָׂיו׃</tei:l>
          <tei:l>אֲדֹנֵי הָאֲדֹנִים</tei:l>
          <tei:l>אֱלֹהֵי הַגְּבוּרוֹת</tei:l>
          <tei:l>מֶלֶךְ הַתִּשְׁבָּחוֹת</tei:l>
          <tei:l>מַלְכֵּנוּ שַׁבְּחוּהוּ׃</tei:l>
          <tei:l>רִאשׁוֹן יהוה</tei:l>
          <tei:l>אַתָּה לְעוֹלָם</tei:l>
          <tei:l>וְאַחֲרוֹן יהוה</tei:l>
          <tei:l>אַתָּה לְעוֹלָם</tei:l>
          <tei:l>כָּל הַנִּבְרָא יְשַׁבְּחוּךָ</tei:l>
          <tei:l>וְכָל הַמְּעַשִּׂים שֶׁיְּרוֹמְמוּךָ</tei:l>
          <tei:l>יִשְׂמַח יהוה בְּמַעֲשָׂיו׃</tei:l>
          <tei:l>יהוה יהוה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd_27880/2"/>
        <tei:lg>
          <tei:l>הַלֵּל הַלֵּל יְבָרְכוּהוּ</tei:l>
          <tei:l>שְׁמֵי הַשָּׁמַיִם׃</tei:l>
          <tei:l>אֲדֹנֵי הָאֲדֹנִים</tei:l>
          <tei:l>אֱלֹהֵי הַגְּבוּרוֹת</tei:l>
          <tei:l>מֶלֶךְ הַתִּשְׁבָּחוֹת</tei:l>
          <tei:l>מַלְכֵּנוּ שַׁבְּחוּהוּ׃</tei:l>
          <tei:l>שִׁבְעַת הַשָּׁמַיִם</tei:l>
          <tei:l>כְּרוּבֵי כִּסְּאוֹ</tei:l>
          <tei:l>רְקִיעַ מְעוֹנוֹ</tei:l>
          <tei:l>מַלְכוּתוֹ לְעוֹלָם׃</tei:l>
          <tei:l>יהוה יהוה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd_27880/3"/>
        <tei:lg>
          <tei:l>הַלֵּל הַלֵּל יְבָרְכוּהוּ</tei:l>
          <tei:l>כָּל הַמַּלְאָכִים׃</tei:l>
          <tei:l>אֲדֹנֵי הָאֲדֹנִים</tei:l>
          <tei:l>אֱלֹהֵי הַגְּבוּרוֹת</tei:l>
          <tei:l>מֶלֶךְ הַתִּשְׁבָּחוֹת</tei:l>
          <tei:l>מַלְכֵּנוּ שַׁבְּחוּהוּ׃</tei:l>
          <tei:l>תִּשְׁעִים וָתֵשַׁע הַגְּדוֹלִים</tei:l>
          <tei:l>זֶה אֶל זֶה הַמַּלְאָכִים</tei:l>
          <tei:l>וּמְשָׁרְתֵיהֶם אַלְפֵי אֲלָפִים׃</tei:l>
          <tei:l>יהוה יהוה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd_27880/4"/>
        <tei:lg>
          <tei:l>הַלֵּל הַלֵּל יְבָרְכוּהוּ</tei:l>
          <tei:l>כָּל הַמַּיִם אֲשֶׁר מֵעַל הַשָּׁמָיִם׃</tei:l>
          <tei:l>אֲדֹנֵי הָאֲדֹנִים</tei:l>
          <tei:l>אֱלֹהֵי הַגְּבוּרוֹת</tei:l>
          <tei:l>מֶלֶךְ הַתִּשְׁבָּחוֹת</tei:l>
          <tei:l>מַלְכֵּנוּ שַׁבְּחוּהוּ׃</tei:l>
          <tei:l>מִי שֶׁמָּדַד מַיִם בְּשֶׁעָלוּ</tei:l>
          <tei:l>מִי שֶׁשָּׁקַל הָרִים בִּמְשֻׁקָּל</tei:l>
          <tei:l>מִי שֶׁמָּדַד אֶרֶץ בַּשְּׁלִישׁ</tei:l>
          <tei:l>מִי שֶׁאָחַז בְּכָל הָעוֹלָם׃</tei:l>
          <tei:l>יהוה יהוה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd_27880/5"/>
        <tei:lg>
          <tei:l>הַלֵּל הַלֵּל יְבָרְכוּהוּ</tei:l>
          <tei:l>כָּל הַגְּבוּרוֹת׃</tei:l>
          <tei:l>אֲדֹנֵי הָאֲדֹנִים</tei:l>
          <tei:l>אֱלֹהֵי הַגְּבוּרוֹת</tei:l>
          <tei:l>מֶלֶךְ הַתִּשְׁבָּחוֹת</tei:l>
          <tei:l>מַלְכֵּנוּ שַׁבְּחוּהוּ׃</tei:l>
          <tei:l>מַחֲלִישׁ קֶשֶׁת לַגִּבּוֹרִים</tei:l>
          <tei:l>וְנוֹתֵן גְבוּרָה לַנֶּחֱשָׁלִים׃</tei:l>
          <tei:l>יהוה יהוה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd_27880/6"/>
        <tei:lg>
          <tei:l>הַלֵּל הַלֵּל יְבָרְכוּהוּ</tei:l>
          <tei:l>שֶׁמֶשׁ וְיָרֵחַ׃</tei:l>
          <tei:l>אֲדֹנֵי הָאֲדֹנִים</tei:l>
          <tei:l>אֱלֹהֵי הַגְּבוּרוֹת</tei:l>
          <tei:l>מֶלֶךְ הַתִּשְׁבָּחוֹת</tei:l>
          <tei:l>מַלְכֵּנוּ שַׁבְּחוּהוּ׃</tei:l>
          <tei:l>בָּרָאתָ‎ם אֶת הַשֶּׁמֶשׁ וְאֶת הַיָּרֵחַ</tei:l>
          <tei:l>בְּקוֹל אַחֵד וּבְמַעֲשֶׂה אֶחָד</tei:l>
          <tei:l>שֶׁמֶשׁ וְיָרֵחַ</tei:l>
          <tei:l>לֹא יִהְיוּ טְהוֹרִים לְפָנֶיךָ׃</tei:l>
          <tei:l>יהוה יהוה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd_27880/7"/>
        <tei:lg>
          <tei:l>הַלֵּל הַלֵּל יְבָרְכוּהוּ</tei:l>
          <tei:l>כָּל כּוֹכְבֵי שָׁמָיִם׃</tei:l>
          <tei:l>אֲדֹנֵי הָאֲדֹנִים</tei:l>
          <tei:l>אֱלֹהֵי הַגְּבוּרוֹת</tei:l>
          <tei:l>מֶלֶךְ הַתִּשְׁבָּחוֹת</tei:l>
          <tei:l>מַלְכֵּנוּ שַׁבְּחוּהוּ׃</tei:l>
          <tei:l>יְשַׁבְּחוּךָ כּוֹכְבֵי הַשָּׁמַיִם</tei:l>
          <tei:l>בְּמַחְשְׁבוֹתֵיהֶם וְיֹאמְרוּ</tei:l>
          <tei:l>קָד֛וֹשׁ קָד֖וֹשׁ</tei:l>
          <tei:l>יְהֹוָה צְבָאוֹת׃</tei:l>
          <tei:l>יהוה יהוה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd_27880/8"/>
        <tei:lg>
          <tei:l>הַלֵּל הַלֵּל יְבָרְכוּהוּ</tei:l>
          <tei:l>טַל וָגֶשֶׁם׃</tei:l>
          <tei:l>אֲדֹנֵי הָאֲדֹנִים</tei:l>
          <tei:l>אֱלֹהֵי הַגְּבוּרוֹת</tei:l>
          <tei:l>מֶלֶךְ הַתִּשְׁבָּחוֹת</tei:l>
          <tei:l>מַלְכֵּנוּ שַׁבְּחוּהוּ׃</tei:l>
          <tei:l>מִטַּל הַשָּׂמִים</tei:l>
          <tei:l>וּמִטַּל הָאָרֶץ</tei:l>
          <tei:l>אָבִינוּ בָּרְכֵנוּ וּסְלַח לָנוּ׃</tei:l>
          <tei:l>יהוה יהוה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd_27880/9"/>
        <tei:lg>
          <tei:l>הַלֵּל הַלֵּל יְבָרְכוּהוּ</tei:l>
          <tei:l>כָּל הַנְּשָׁמָה׃</tei:l>
          <tei:l>אֲדֹנֵי הָאֲדֹנִים</tei:l>
          <tei:l>אֱלֹהֵי הַגְּבוּרוֹת</tei:l>
          <tei:l>מֶלֶךְ הַתִּשְׁבָּחוֹת</tei:l>
          <tei:l>מַלְכֵּנוּ שַׁבְּחוּהוּ׃</tei:l>
          <tei:l>וְרוּחַ מַעַל פָּנָיו</tei:l>
          <tei:l>נִשְׁמַת חַיִּים</tei:l>
          <tei:l>מֵבִיא דָּבָר׃</tei:l>
          <tei:l>יהוה יהוה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd_27880/10"/>
        <tei:lg>
          <tei:l>הַלֵּל הַלֵּל יְבָרְכוּהוּ</tei:l>
          <tei:l>אֵשׁ וְלַהַב׃</tei:l>
          <tei:l>אֲדֹנֵי הָאֲדֹנִים</tei:l>
          <tei:l>אֱלֹהֵי הַגְּבוּרוֹת</tei:l>
          <tei:l>מֶלֶךְ הַתִּשְׁבָּחוֹת</tei:l>
          <tei:l>מַלְכֵּנוּ שַׁבְּחוּהוּ׃</tei:l>
          <tei:l>אֵשׁ גְּדוֹלָה יָקוּם לְפָנָיו</tei:l>
          <tei:l>וְיִמְחֹל שִׁלְטוֹן קוֹלוֹ</tei:l>
          <tei:l>נִפְלָא יהוה׃</tei:l>
          <tei:l>יהוה יהוה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd_27880/11"/>
        <tei:lg>
          <tei:l>הַלֵּל הַלֵּל יְבָרְכוּהוּ</tei:l>
          <tei:l>לַיְלָה וָיוֹם׃</tei:l>
          <tei:l>אֲדֹנֵי הָאֲדֹנִים</tei:l>
          <tei:l>אֱלֹהֵי הַגְּבוּרוֹת</tei:l>
          <tei:l>מֶלֶךְ הַתִּשְׁבָּחוֹת</tei:l>
          <tei:l>מַלְכֵּנוּ שַׁבְּחוּהוּ׃</tei:l>
          <tei:l>שֶׁהֵקַמְתָּנוּ מִפָּחָד לַיְלָה</tei:l>
          <tei:l>וְשֶׁהִגִּיעָנוּ עַד אוֹר הַיּוֹם</tei:l>
          <tei:l>יוֹמָם וָלַיְלָה</tei:l>
          <tei:l>נְשַׁבֵּחַ וּנְזַמֵּר יַחַד בְּקוֹל</tei:l>
          <tei:l>וּנְקַדֵּשׁ לַיהוה׃</tei:l>
          <tei:l>יהוה יהוה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd_27880/12"/>
        <tei:lg>
          <tei:l>הַלֵּל הַלֵּל יְבָרְכוּהוּ</tei:l>
          <tei:l>קַר וָשֶׁלֶג׃</tei:l>
          <tei:l>אֲדֹנֵי הָאֲדֹנִים</tei:l>
          <tei:l>אֱלֹהֵי הַגְּבוּרוֹת</tei:l>
          <tei:l>מֶלֶךְ הַתִּשְׁבָּחוֹת׃</tei:l>
          <tei:l>מַלְכֵּנוּ שַׁבְּחוּהוּ</tei:l>
          <tei:l>חַם כְּמוֹ שֶׁמֶשׁ</tei:l>
          <tei:l>וְקַר כְּמוֹ בָרָד׃</tei:l>
          <tei:l>יהוה יהוה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd_27880/13"/>
        <tei:lg>
          <tei:l>הַלֵּל הַלֵּל יְבָרְכוּהוּ</tei:l>
          <tei:l>טַל וַגֶשֶׁם׃</tei:l>
          <tei:l>אֲדֹנֵי הָאֲדֹנִים</tei:l>
          <tei:l>אֱלֹהֵי הַגְּבוּרוֹת</tei:l>
          <tei:l>מֶלֶךְ הַתִּשְׁבָּחוֹת</tei:l>
          <tei:l>מַלְכֵּנוּ שַׁבְּחוּהוּ׃</tei:l>
          <tei:l>כְּטַל־חֶרְמ֗וֹן</tei:l>
          <tei:l>שֶׁיֹּרֵד֮ עַל־הַרְרֵ֢י צִ֫יּ֥וֹן׃</tei:l>
          <tei:l>יהוה יהוה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd_27880/14"/>
        <tei:lg>
          <tei:l>הַלֵּל הַלֵּל יְבָרְכוּהוּ</tei:l>
          <tei:l>אוֹר וַחוֹשֵׂךְ׃</tei:l>
          <tei:l>אֲדֹנֵי הָאֲדֹנִים</tei:l>
          <tei:l>לְאֵל הֶחָזָק</tei:l>
          <tei:l>לְמֶלֶךְ תִּשְׁבָּחוֹת</tei:l>
          <tei:l>מַלְכֵּנוּ שַׁבְּחוּהוּ׃</tei:l>
          <tei:l>הַמְּכַסֶּה אוֹרוֹת שֶׁהִתְקִין</tei:l>
          <tei:l>וְהוֹלִידָם הַיּוֹדֵעַ</tei:l>
          <tei:l>וְשֶׁהוֹצִיאָם בַּעֲלוֹת הַשַּׁחַר</tei:l>
          <tei:l>וְהִזְרִיחַ אֶת הָאוֹרוֹת׃</tei:l>
          <tei:l>יהוה יהוה</tei:l>
        </tei:lg>
      </tei:div>
