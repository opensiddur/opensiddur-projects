  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/114">
        <tei:head>תהלים קי״ד</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/114/1/a"/>
        <tei:lg>
          <tei:l>בְּצֵאת יִשְׂרָאֵל מִמִּצְרָיִם</tei:l>
          <tei:l>בֵּית יַעֲקֹב מֵעַם לֹעֵז׃</tei:l>
          <tei:l>הָיְתָה יְהוּדָה לְקׇדְשׁוֹ</tei:l>
          <tei:l>יִשְׂרָאֵל מַמְשְׁלוֹתָיו׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/114/3/a"/>
        <tei:lg>
          <tei:l>הַיָּם רָאָה וַיָּנֹס הַיַּרְדֵּן יִסֹּב לְאָחוֹר׃</tei:l>
          <tei:l>הֶהָרִים רָקְדוּ כְאֵילִים</tei:l>
          <tei:l>גְּבָעוֹת כִּבְנֵי־צֹאן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/114/5/a"/>
        <tei:lg>
          <tei:l>מַה־לְּךָ הַיָּם כִּי תָנוּס</tei:l>
          <tei:l>הַיַּרְדֵּן תִּסֹּב לְאָחוֹר׃</tei:l>
          <tei:l>הֶהָרִים תִּרְקְדוּ כְאֵילִים</tei:l>
          <tei:l>גְּבָעוֹת כִּבְנֵי־צֹאן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/114/7/a"/>
        <tei:lg>
          <tei:l>מִלִּפְנֵי אָדוֹן חוּלִי אָרֶץ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>מִלִּפְנֵי אֱלוֹהַּ יַעֲקֹב׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/114/8"/>
        <tei:lg>
          <tei:l>הַהֹפְכִי הַצּוּר אֲגַם־מָיִם חַלָּמִישׁ לְמַעְיְנוֹ־מָיִם׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
