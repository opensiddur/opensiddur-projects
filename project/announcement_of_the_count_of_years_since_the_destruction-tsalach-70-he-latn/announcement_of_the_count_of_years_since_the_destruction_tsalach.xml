  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:announcement_of_the_count_of_years_since_the_destruction_tsalach">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:announcement_of_the_count_of_years_since_the_destruction_tsalach/1"/>
        <tei:lg>
          <tei:l>Ki bæ-ȝæ̆wønøthénu u-væ-ȝæ̆wønøth ‘æ̆vøthénu</tei:l>
          <tei:l>ónu mønim lo-ḥorbon beth ‘Æ̆løhénu</tei:l>
          <tei:l>ul-fizzur ȝæm ‘Æ̆dhønoy ‘éllæ me-ȝæl ‘ædhmæth godhshénu</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:announcement_of_the_count_of_years_since_the_destruction_tsalach/2"/>
        <tei:lg>
          <tei:l>hæy-yøm lo-ḥorbon bǽyith sheni</tei:l>
          <tei:l>‘æ̆shær bono ȝæzro’ ‘æ̆dhønénu</tei:l>
          <tei:l>‘ǽlæf wǝ-tishȝo me’øth wæ-ḥæ̆misshim wæ-‘sholøsh</tei:l>
          <tei:l>shǝney yǝghønøthénu</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:announcement_of_the_count_of_years_since_the_destruction_tsalach/3"/>
        <tei:lg>
          <tei:l>ul-ḥorbon bǽyith rishøn</tei:l>
          <tei:l>ul-fizzur ‘ænshey joluthénu</tei:l>
          <tei:l>‘æ̆nǽḥnu haj-jølim pø bæ-‘æ̆roṣøth mønénu</tei:l>
          <tei:l>hæy-yøm ‘ælpǽyim wᴂ-ærbæȝ me’øth wᴂ-ærbæȝim wᴂ-ærbæȝ</tei:l>
          <tei:l>shonim ȝæl røv ȝæ̆wønøthénu</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:announcement_of_the_count_of_years_since_the_destruction_tsalach/4"/>
        <tei:lg>
          <tei:l>Ȝæl zøth nishkvo bǝ-voshténu uth-khæssénu kǝlimmothénu</tei:l>
          <tei:l>wǝ-lø’ nishkæḥ migdosh tifǝ’ærténu ‘im tishkæḥ yǝminénu</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:announcement_of_the_count_of_years_since_the_destruction_tsalach/5"/>
        <tei:lg>
          <tei:l>lǝ-zøth nivko un-gønen kol yǝme shǝnøthénu</tei:l>
          <tei:l>wǝ-lø’ niggoḥ næḥomo ȝædh yibonæ beth zǝvulénu</tei:l>
          <tei:l>wǝ-‘æl jǝvul ‘ærṣénu yæḥæ̆zirǽnnu</tei:l>
          <tei:l>shuvó ‘Æ̆dhønoy ‘æth shǝvithénu!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
