  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:chanina_ben_dosa_burstein">
        <tei:head>חֲנִינָא בֶּן דּוֹסָא</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:chanina_ben_dosa_burstein/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">חרוז א</tei:note>
          </tei:l>
          <tei:l>אִישׁ חָסִיד הָיָה בִּֽימֵי קֶדֶם</tei:l>
          <tei:l>מֵאַנְשֵׁי מַעֲשֶׂה וּשְׁמוֹ חֲנִינָא</tei:l>
          <tei:l>הִצְטַמְצֵם יְהוּדָה לְגֶּֽזַע וָגֶֽדֶם</tei:l>
          <tei:l>וַיִּבֹּֽלוּ מֵעָלָיו תֹּֽמֶר וּתְאֵנָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:chanina_ben_dosa_burstein/2"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">פזמון</tei:note>
          </tei:l>
          <tei:l>חֲנִינָא בֶּן דּוֹסָא, הִתְפַּלֵּל עַל יִשְׂרָאֵל</tei:l>
          <tei:l>תְּעֹרֵר רֽוּחַ תֵּבֵל, יִנָּתְקוּ כַבְלֵי בַרְזֶל</tei:l>
          <tei:l>מִזִקֵּי הַיֵּאוּשׁ נִגָּאֵל!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:chanina_ben_dosa_burstein/3"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">חרוז ב</tei:note>
          </tei:l>
          <tei:l>עָנָיו וְשַׁתְקָן, מִבְּנֵי הַמַּלְאָכִים</tei:l>
          <tei:l>עֶֽבֶד לִפְנֵי מֶֽלֶךְ מַלְכֵי הַמְּלָכִים</tei:l>
          <tei:l>דַּיּוֹ כָּל־הַשָּׁבֽוּעַ בְּקַב חָרוּבִים</tei:l>
          <tei:l>גַּם אִשְׁתּוֹ הָיְתָה מְלֻמֶּֽדֶת בְּנִּסִּים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:chanina_ben_dosa_burstein/4"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">פזמון</tei:note>
          </tei:l>
          <tei:l>חֲנִינָא בֶּן דּוֹסָא, הִתְפַּלֵּל עַל יִשְׂרָאֵל</tei:l>
          <tei:l>תְּעֹרֵר רֽוּחַ תֵּבֵל, יִנָּתְקוּ כַבְלֵי בַרְזֶל</tei:l>
          <tei:l>מִזִקֵּי הַיֵּאוּשׁ נִגָּאֵל!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:chanina_ben_dosa_burstein/5"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">חרוז ג</tei:note>
          </tei:l>
          <tei:l>אֶל פָּמוֹט הַשַּׁבָּת נִשְׁפַּךְ חֹֽמֶץ מַר</tei:l>
          <tei:l>וַיָּבֹא אִישׁ טָהוֹר שֶׁחִיֵּךְ וְגָּזַר</tei:l>
          <tei:l>מִי שֶׁאָמַר לַשֶּֽׁמֶן וְיִדְלֹק</tei:l>
          <tei:l>יְצַוֶּה אֶת־הַחֹֽמֶץ לְהָאִיר אוֹר מָתוֹק</tei:l>
          <tei:l>וְכֵן הָיָה...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:chanina_ben_dosa_burstein/6"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">פזמון</tei:note>
          </tei:l>
          <tei:l>חֲנִינָא בֶּן דּוֹסָא, הִתְפַּלֵּל עַל יִשְׂרָאֵל</tei:l>
          <tei:l>תְּעֹרֵר רֽוּחַ תֵּבֵל, יִנָּתְקוּ כַבְלֵי בַרְזֶל</tei:l>
          <tei:l>מִזִקֵּי הַיֵּאוּשׁ נִגָּאֵל!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:chanina_ben_dosa_burstein/7"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">גשר א</tei:note>
          </tei:l>
          <tei:l>הֱיֵה לָֽנוּ סַנֵּיגוֹר יָעִיל</tei:l>
          <tei:l>יוֹם חָדָשׁ סוֹף־סוֹף מַתְחִיל</tei:l>
          <tei:l>יְרַחֵם אֱלֹקִים, אֶת־דּוֹרְשָׁיו יַצִּיל</tei:l>
          <tei:l>לְמַֽעַן צִדְקוֹ תּוֹרָה יַגְדִּיל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:chanina_ben_dosa_burstein/8"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">חרוז ד</tei:note>
          </tei:l>
          <tei:l>לָֽנוּ דְּרוּשָׁה עֲתִירַת חָכָם</tei:l>
          <tei:l>אִישׁ אֱמֶת הַמַּכִּיר לֵב הָעָם</tei:l>
          <tei:l>אָב סָמוּךְ, מָקוֹר בָּרוּךְ</tei:l>
          <tei:l>בִּשְׁבִילוֹ נִזּוֹן כָּל־הָעוֹלָם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:chanina_ben_dosa_burstein/9"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">פזמון</tei:note>
          </tei:l>
          <tei:l>חֲנִינָא בֶּן דּוֹסָא, הִתְפַּלֵּל עַל יִשְׂרָאֵל</tei:l>
          <tei:l>תְּעֹרֵר רֽוּחַ תֵּבֵל, יִנָּתְקוּ כַבְלֵי בַרְזֶל</tei:l>
          <tei:l>מִזִקֵּי הַיֵּאוּשׁ נִגָּאֵל!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:chanina_ben_dosa_burstein/10"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">גשר ב</tei:note>
          </tei:l>
          <tei:l>הָאֹֽזֶן תִּשְׁמַע וְתַקְשִׁיב הַנְּשָׁמָה</tei:l>
          <tei:l>בְּצֵאת קוֹל עָרֵב מֵעוֹלָם הַבָּא</tei:l>
          <tei:l>תְּפִלָּה זַכָּה וּתְמִימָה</tei:l>
          <tei:l>בְּפִי תַּנָּא רַבָּא שְׁגוּרָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:chanina_ben_dosa_burstein/11"/>
        <tei:lg>
          <tei:l>שִׁמְעוּ הָרִים וְדֹּֽמוּ מֹֽסְדֵי אָֽרֶץ</tei:l>
          <tei:l>פֹּעֵל יְשׁוּעוֹת יִגְדֹר כָּל־פָּֽרֶץ</tei:l>
          <tei:l>גִּילִי צִיּוֹן בְּאִמְרֵי אֹהֲבֵךְ</tei:l>
          <tei:l>מוֹרֶה לִצְדָקָה מִתְחַנֵּן לִמְקַבְּצֵךְ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:chanina_ben_dosa_burstein/12"/>
        <tei:lg>
          <tei:l>מִכָּל צָרָה יוֹשִׁיעֵֽנוּ קָהּ</tei:l>
          <tei:l>בֵּית דָּוִד יָקוּם מִשּׁוֹאָה</tei:l>
          <tei:l>חֲדָשׁוֹת נוֹרָאוֹת עַֽיִן לֹא־רָאֲתָה</tei:l>
          <tei:l>תִּפְרַֽחְנָה כָּרִמּוֹן וְתִמָּלֵא אֶֽרֶץ תְּנוּבָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:chanina_ben_dosa_burstein/13"/>
        <tei:lg>
          <tei:l>יִבָּנֶה הַמִּקְדָשׁ וְתוּשַׁב הָעֲבוֹדָה</tei:l>
          <tei:l>וְעָלוּ יְרוּשָׁלַֽיְמָה נֹֽשְׂאֵי אֲלֻמָּה</tei:l>
          <tei:l>יִנָּבְאוּ יְלָדִים וִילָדוֹת תַחֲלֹֽמְנָה</tei:l>
          <tei:l>וִישֻׂשׂוּם בַּמָּרוֹם בְּנֵי פַּמַּלְיָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:chanina_ben_dosa_burstein/14"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כלי נגינה</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:chanina_ben_dosa_burstein/15"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">חרוז ה</tei:note>
          </tei:l>
          <tei:l>תַּעֲבֵיד דְּבֵיתְהוּ כְּלִילָא דִּילֵיהּ</tei:l>
          <tei:l>תְּכֵלְתָּא לְצַדִּיקֵי לְעָלְמָא דְּאָתֵי</tei:l>
          <tei:l>יְקַר אוֹרַיְתָא הֲוָה כְּתִיב עַל־לִבֵּיהּ</tei:l>
          <tei:l>לְעָלַם יְהֵא רְחִים שְׁמֵיהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:chanina_ben_dosa_burstein/16"/>
        <tei:lg>
          <tei:l>רִֽיבָה רִיבֵֽנוּ, הַשְׁלֵם בֵּינֵֽינוּ</tei:l>
          <tei:l>לְצֶֽדֶק הֲבִיאֵֽנוּ, מוּכָנִים לִפְדוּתֵֽנוּ</tei:l>
          <tei:l>הִנֵּה זֶה בָּא מֵאֲחוֹרֵי אֵלִיָּה</tei:l>
          <tei:l>רַבִּי חֲנִינָא בֶּן דּוֹסָא!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:chanina_ben_dosa_burstein/17"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">פזמון (ארבע פעמים)</tei:note>
          </tei:l>
          <tei:l>חֲנִינָא בֶּן דּוֹסָא, הִתְפַּלֵּל עַל יִשְׂרָאֵל</tei:l>
          <tei:l>תְּעֹרֵר רֽוּחַ תֵּבֵל, יִנָּתְקוּ כַבְלֵי בַרְזֶל</tei:l>
          <tei:l>מִזִקֵּי הַיֵּאוּשׁ נִגָּאֵל!</tei:l>
          <tei:l>(נְשׂוּא פָנִים!)</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
