    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_petitionary_prayer_for_hormone_replacement_therapy_mayer">
        <tei:head>תְּחִנָּה לְטִפּוּל הוֹרְמוֹנָלִי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_petitionary_prayer_for_hormone_replacement_therapy_mayer/1"/>
        <tei:lg>
          <tei:l>לְשֵׁם יִחוּד</tei:l>
          <tei:l>קוּדְשָׁא בְּרִיךְ הוּא</tei:l>
          <tei:l>וּשְׁכִינְתֵּיהּ,</tei:l>
          <tei:l>בִּדְחִילוּ וּרְחִימוּ,</tei:l>
          <tei:l>וּרְחִימוּ וּדְחִילוּ,</tei:l>
          <tei:l>לְיַחֲדָא שֵׁם יוֹ״ד הֵ״י בְּוָא״ו הֵ״י</tei:l>
          <tei:l>בְּיִחוּדָא שְׁלִים</tei:l>
          <tei:l>בְּשֵׁם כׇּל יִשְׂרָאֵל,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_petitionary_prayer_for_hormone_replacement_therapy_mayer/2"/>
        <tei:lg>
          <tei:l>הִנְנִי מוּכָן וּמְזֻמָּן</tei:l>
          <tei:l>לְהִשְׁתַּתֵּף בְּמַעֲשֵׂי בְּרֵאשִׁית</tei:l>
          <tei:l>בְּצֶלֶם מְקוֹר הַבְּרִיאָה הַבּוֹרֵא כׇּל בּוֹרְאִים.</tei:l>
          <tei:l>הַיּוֹצֵר שִׁבֳּלִים</tei:l>
          <tei:l>כְּדֵי שֶׁנִּזְכֶּה לֶאֱפוֹת גְּלֻסְקָאוֹת</tei:l>
          <tei:l>הוּא יְסַמְּכֵנִי</tei:l>
          <tei:l>וְיַעַזְרֵנִי בְּתַהֲלִיךְ זֶה</tei:l>
          <tei:l>אֲשֶׁר לִשְׁמוֹ נִבְרֵאתִי,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_petitionary_prayer_for_hormone_replacement_therapy_mayer/3"/>
        <tei:lg>
          <tei:l>כָּאָמוּר:</tei:l>
          <tei:l>וַיִּבְרָ֨א אֱלֹהִ֤ים ׀ אֶת־הָֽאָדָם֙ בְּצַלְמ֔וֹ</tei:l>
          <tei:l>בְּצֶ֥לֶם אֱלֹהִ֖ים בָּרָ֣א אֹת֑וֹ</tei:l>
          <tei:l>זָכָ֥ר וּנְקֵבָ֖ה בָּרָ֥א אֹתָֽם׃ <tei:bibl>(בראשית א:כז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_petitionary_prayer_for_hormone_replacement_therapy_mayer/4"/>
        <tei:lg>
          <tei:l>וִיהִ֤י ׀ נֹ֤עַם אֲדֹנָ֥י אֱלֹהֵ֗ינוּ עָ֫לֵ֥ינוּ</tei:l>
          <tei:l>וּמַעֲשֵׂ֣ה יָ֭דֵינוּ כּוֹנְנָ֥ה עָלֵ֑ינוּ</tei:l>
          <tei:l>וּֽמַעֲשֵׂ֥ה יָ֝דֵ֗ינוּ כּוֹנְנֵֽהוּ׃ <tei:bibl>(תהלים צ:יז)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
