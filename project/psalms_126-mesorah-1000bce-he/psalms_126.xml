  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/126">
        <tei:head>תהלים קכ״ו</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/126/1"/>
        <tei:lg>
          <tei:l>שִׁ֗יר הַֽמַּ֫עֲל֥וֹת</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בְּשׁ֣וּב יְ֭הֹוָה אֶת־שִׁיבַ֣ת צִיּ֑וֹן</tei:l>
          <tei:l>הָ֝יִ֗ינוּ כְּחֹלְמִֽים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/126/2"/>
        <tei:lg>
          <tei:l>אָ֤ז יִמָּלֵ֪א שְׂח֡וֹק פִּינוּ֮</tei:l>
          <tei:l>וּלְשׁוֹנֵ֢נוּ רִ֫נָּ֥ה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>אָ֭ז יֹאמְר֣וּ בַגּוֹיִ֑ם</tei:l>
          <tei:l>הִגְדִּ֥יל יְ֝הֹוָ֗ה לַעֲשׂ֥וֹת עִם־אֵֽלֶּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/126/3"/>
        <tei:lg>
          <tei:l>הִגְדִּ֣יל יְ֭הֹוָה לַעֲשׂ֥וֹת עִמָּ֗נוּ</tei:l>
          <tei:l>הָיִ֥ינוּ שְׂמֵחִֽים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/126/4"/>
        <tei:lg>
          <tei:l>שׁוּבָ֣ה יְ֭הֹוָה אֶת־[שְׁבִיתֵ֑נוּ] (שבותנו)</tei:l>
          <tei:l>כַּאֲפִיקִ֥ים בַּנֶּֽגֶב׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/126/5"/>
        <tei:lg>
          <tei:l>הַזֹּרְעִ֥ים בְּדִמְעָ֗ה</tei:l>
          <tei:l>בְּרִנָּ֥ה יִקְצֹֽרוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/126/6"/>
        <tei:lg>
          <tei:l>הָ֘ל֤וֹךְ יֵלֵ֨ךְ ׀ וּבָכֹה֮</tei:l>
          <tei:l>נֹשֵׂ֢א מֶשֶׁךְ־הַ֫זָּ֥רַע</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>בֹּא־יָבֹ֥א בְרִנָּ֑ה</tei:l>
          <tei:l>נֹ֝שֵׂ֗א אֲלֻמֹּתָֽיו׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
