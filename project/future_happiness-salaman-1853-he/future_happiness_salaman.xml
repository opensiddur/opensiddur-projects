  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:future_happiness_salaman">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:future_happiness_salaman/2"/>
        <tei:lg>
          <tei:l>וְאָמְרוּ הָאָרֶץ הַלֵּזוּ הַנְּשַׁמָּה הָיְתָה כְּגַן־עֵדֶן</tei:l>
          <tei:l>וְהֶעָרִים הֶחֳרֵבוֹת וְהַנְשַׁמּוֹת וְהַנֶּהֱרָסוֹת בְּצוּרוֹת יָשָׁבוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:future_happiness_salaman/3"/>
        <tei:lg>
          <tei:l>כִּי אִם בְּתוֹרַת יְהֹוָה חֶפְצוֹ</tei:l>
          <tei:l>וּבְתוֹרָתוֹ יֶהְגֶּה יוֹמָם וָלָיְלָה׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
