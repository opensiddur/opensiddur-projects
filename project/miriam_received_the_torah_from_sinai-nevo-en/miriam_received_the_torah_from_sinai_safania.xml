    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:miriam_received_the_torah_from_sinai_safania">
        <tei:head>Miriam received the Torah from Sinai, by Rabbah Rinat Safania</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:miriam_received_the_torah_from_sinai_safania/1"/>
        <tei:lg>
          <tei:l>Miriam received the Torah from Sinai</tei:l>
          <tei:l>and transmitted it to the Daughters of Zelopheḥad,</tei:l>
          <tei:l>and the Daughters of Zelopheḥad to Deborah,</tei:l>
          <tei:l>and Deborah to Ruth,</tei:l>
          <tei:l>and Ruth transmitted it to Beruriah.</tei:l>
          <tei:l>They said three things:</tei:l>
          <tei:l>Make your voice heard,</tei:l>
          <tei:l>raise up many disciples</tei:l>
          <tei:l>and interpret the Torah.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
