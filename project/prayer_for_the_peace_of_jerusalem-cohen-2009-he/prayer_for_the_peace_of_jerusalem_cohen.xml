    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_the_peace_of_jerusalem_cohen">
        <tei:head>תפילה לשלום ירושלים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_peace_of_jerusalem_cohen/1"/>
        <tei:lg>
          <tei:l>אָבִינוּ שֶׁבַּשָּׁמַֽיִם</tei:l>
          <tei:l>הַבּוֹחֵר בְּצִיּוֹן וִירוּשָׁלַֽיִם</tei:l>
          <tei:l>אֲשֶׁר אִוִּֽיתָ לְמוֹשַׁב לְךָ</tei:l>
          <tei:l>אֶת עִיר הַקֹּֽדֶשׁ,</tei:l>
          <tei:l>בָּרֵךְ כׇּל בּוֹנֶֽיהָ, בָּנֶֽיהָ</tei:l>
          <tei:l>וְדוֹרְשֵׁי שְׁלוֹמָהּ,</tei:l>
          <tei:l>וּשְׁלַח בְּרָכָה וְהַצְלָחָה בְּכׇל מַעֲשֵׂי יְדֵיהֶם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_peace_of_jerusalem_cohen/2"/>
        <tei:lg>
          <tei:l>וּפְרֹשׂ עָלֶֽיהָ סֻכַּת שְׁלוֹמֶֽךָ,</tei:l>
          <tei:l>וְקַֽיֶּם־בָּהּ מִקְרָא שֶׁכָּתוּב:</tei:l>
          <tei:l>לְמַעַן צִיּוֹן לֹא אֶחֱשֶׁה</tei:l>
          <tei:l>וּלְמַעַן יְרוּשָׁלִַם לֹא אֶשְׁקוֹט</tei:l>
          <tei:l>עַד־יֵצֵא כַנֹּגַהּ צִדְקָהּ</tei:l>
          <tei:l>וִישׁוּעָתָהּ כְּלַפִּיד יִבְעָר׃ <tei:bibl>(ישעיהו סב:א)</tei:bibl></tei:l>
          <tei:l>וּבְנֵה אוֹתָהּ בִּמְהֵרָה בְּיָמֵֽינוּ בִּנְיָן עוֹלָם,</tei:l>
          <tei:l>וְכִסֵּא דָּוִד עַבְדְּךָ בִּמְהֵרָה לְתוֹכָהּ תָּכִין.</tei:l>
          <tei:l>בָּרוּךְ מְנַחֵם צִיּוֹן</tei:l>
          <tei:l>וּבוֹנֵה יְרוּשָׁלַֽיִם</tei:l>
          <tei:l>מֵעַתָּה וְעַד עוֹלָם,</tei:l>
          <tei:l>אָמֵן. כֵּן יְהִי רָצוֹן.</tei:l>
        </tei:lg>
      </tei:div>
