      <tei:div type="colophon" subtype="introduction">
        <tei:p>Guest Chaplain: Rabbi Mordecai L. Brill, Temple Beth Israel, Philadelphia, Pennsylvania</tei:p>
        <tei:p>Sponsor: n/a</tei:p>
        <tei:p>Date of Prayer: 28 May 1957</tei:p>
      </tei:div>
      <j:endConditional target="#osp_55938_introduction"/>
