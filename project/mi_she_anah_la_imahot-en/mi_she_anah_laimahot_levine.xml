  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:mi_she_anah_laimahot_levine">
        <tei:head>Mi she-Anah la-Imahot (He who answered the foremothers), by Dr. Yael Levine (2017)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_she_anah_laimahot_levine/1"/>
        <tei:lg>
          <tei:l>He who answered</tei:l>
          <tei:l>Sarah our foremother at the entrance of the tent,</tei:l>
          <tei:l>may He answer us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_she_anah_laimahot_levine/2"/>
        <tei:lg>
          <tei:l>He who answered</tei:l>
          <tei:l>Hagar in the desert of Be’er Sheva,</tei:l>
          <tei:l>may He answer us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_she_anah_laimahot_levine/3"/>
        <tei:lg>
          <tei:l>He who answered</tei:l>
          <tei:l>Rebecca our foremother in her plea,</tei:l>
          <tei:l>may He answer us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_she_anah_laimahot_levine/4"/>
        <tei:lg>
          <tei:l>He who answered</tei:l>
          <tei:l>Rachel our foremother in her prayers,</tei:l>
          <tei:l>may He answer us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_she_anah_laimahot_levine/5"/>
        <tei:lg>
          <tei:l>He who answered</tei:l>
          <tei:l>Leah our foremother in her weeping,</tei:l>
          <tei:l>may He answer us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_she_anah_laimahot_levine/6"/>
        <tei:lg>
          <tei:l>He who answered</tei:l>
          <tei:l>Tamar when she was brought out to be burned,</tei:l>
          <tei:l>may He answer us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_she_anah_laimahot_levine/7"/>
        <tei:lg>
          <tei:l>He who answered</tei:l>
          <tei:l>the Hebrew midwives in Egypt,</tei:l>
          <tei:l>may He answer us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_she_anah_laimahot_levine/8"/>
        <tei:lg>
          <tei:l>He who answered</tei:l>
          <tei:l>Miriam on the bank of the Nile,</tei:l>
          <tei:l>may He answer us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_she_anah_laimahot_levine/9"/>
        <tei:lg>
          <tei:l>He who answered</tei:l>
          <tei:l>Rachel, granddaughter of Shuthelah, in her outcry,</tei:l>
          <tei:l>may He answer us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_she_anah_laimahot_levine/10"/>
        <tei:lg>
          <tei:l>He who answered</tei:l>
          <tei:l>the wife of On, son of Peleth, at the gate of her home,</tei:l>
          <tei:l>may He answer us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_she_anah_laimahot_levine/11"/>
        <tei:lg>
          <tei:l>He who answered</tei:l>
          <tei:l>the daughters of Zelophehad at the Tent of Meeting,</tei:l>
          <tei:l>may He answer us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_she_anah_laimahot_levine/12"/>
        <tei:lg>
          <tei:l>He who answered</tei:l>
          <tei:l>Rahav in Jericho,</tei:l>
          <tei:l>may He answer us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_she_anah_laimahot_levine/13"/>
        <tei:lg>
          <tei:l>He who answered</tei:l>
          <tei:l>Devorah the prophetess in the war,</tei:l>
          <tei:l>may He answer us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_she_anah_laimahot_levine/14"/>
        <tei:lg>
          <tei:l>He who answered</tei:l>
          <tei:l>Yael, wife of Hever the Kenite in the tent,</tei:l>
          <tei:l>may He answer us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_she_anah_laimahot_levine/15"/>
        <tei:lg>
          <tei:l>He who answered</tei:l>
          <tei:l>Hazlelponi, mother of Samson, in the field,</tei:l>
          <tei:l>may He answer us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_she_anah_laimahot_levine/16"/>
        <tei:lg>
          <tei:l>He who answered</tei:l>
          <tei:l>Hannah in Shiloh,</tei:l>
          <tei:l>may He answer us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_she_anah_laimahot_levine/17"/>
        <tei:lg>
          <tei:l>He who answered</tei:l>
          <tei:l>the wife of one of the sons of the prophets, and saved her from the creditor,</tei:l>
          <tei:l>may He answer us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_she_anah_laimahot_levine/18"/>
        <tei:lg>
          <tei:l>He who answered</tei:l>
          <tei:l>the woman of Shunem, and revived her son,</tei:l>
          <tei:l>may He answer us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_she_anah_laimahot_levine/19"/>
        <tei:lg>
          <tei:l>He who answered</tei:l>
          <tei:l>Queen Esther in Shushan the capital,</tei:l>
          <tei:l>may He answer us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_she_anah_laimahot_levine/20"/>
        <tei:lg>
          <tei:l>He who answered</tei:l>
          <tei:l>all the righteous,</tei:l>
          <tei:l>pious,</tei:l>
          <tei:l>wholesome,</tei:l>
          <tei:l>and upright,</tei:l>
          <tei:l>may He answer us.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
