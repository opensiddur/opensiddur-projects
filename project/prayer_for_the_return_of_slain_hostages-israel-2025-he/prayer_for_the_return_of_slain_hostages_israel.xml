      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_the_return_of_slain_hostages_israel">
        <tei:head>תפילה עם שובם של חללי המלחמה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_return_of_slain_hostages_israel/1"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>ה׳ אֲלהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם</tei:l>
          <tei:l>דַּיַּן הָאֱמֶת.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_return_of_slain_hostages_israel/2"/>
        <tei:lg>
          <tei:l>אָבִינוּ מַלְכֵּנוּ,</tei:l>
          <tei:l>שְׁמַע קוֹלֵנוּ</tei:l>
          <tei:l>חוּס וְרַחֵם עָלֵינוּ,</tei:l>
          <tei:l>וְקַבֵּל בְּרַחֲמִים וּבְרָצוֹן אֶת תְּפִלָּתֵנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_return_of_slain_hostages_israel/3"/>
        <tei:lg>
          <tei:l>אָבִינוּ מַלְכֵּנוּ,</tei:l>
          <tei:l>עֲשֵׂה לְמַעַן</tei:l>
          <tei:l>הֲרוּגִים עַל שֵׁם קָדְשֶׁךָ</tei:l>
          <tei:l>וּלְמַעַן</tei:l>
          <tei:l>טְבוּחִים עַל יִחוּדֶךָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_return_of_slain_hostages_israel/4"/>
        <tei:lg>
          <tei:l>אָבִינוּ מַלְכֵּנוּ,</tei:l>
          <tei:l>אַל נָא תְּשִׁיבָנוּ רֵיקָם מִלְּפָנֶיךָ,</tei:l>
          <tei:l>וַחֲמֹל עָלֵינוּ</tei:l>
          <tei:l>וְעַל עוֹלָלֵינוּ וְטָפֵּנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_return_of_slain_hostages_israel/5"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן מִלְפָנֶיךָ</tei:l>
          <tei:l>ה׳ אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ וְאִמּוֹתֵינוּ,</tei:l>
          <tei:l>שֶׁתִּשְׁמֹר,</tei:l>
          <tei:l>וְתִנְצֹר,</tei:l>
          <tei:l>וּתְחַזֵּק,</tei:l>
          <tei:l>וְתַעֲטֹף וּתְנַחֵם</tei:l>
          <tei:l>אֶת מִשְׁפְּחוֹתֵיהֶם שֶׁל חַלְלִי הַמִּלְחָמָה</tei:l>
          <tei:l>אֲשֶׁר נֶחְטְפוּ וְנִרְצְחוּ בִּידֵי בְּנֵי עַוְלָה</tei:l>
          <tei:l>וְהוּשְׁבוּ הַיּוֹם לִמְנוּחַת עוֹלָמִים בְּאֶרֶץ קָדְשֶׁךָ</tei:l>
          <tei:l>לְאַחַר 503 לֵילוֹת וְיָמִיִם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_return_of_slain_hostages_israel/6"/>
        <tei:lg>
          <tei:l>הָרֹפֵא לִשְׁבוּרֵי לֵב</tei:l>
          <tei:l>וּמְחַבֵּשׁ לְעַצְבוֹתָם,</tei:l>
          <tei:l>חַבֵּק בְּאֶבְרַת חַסְדְּךָ אֶת אוֹהֲבֵיהֶם,</tei:l>
          <tei:l>חֲבֹשׁ אֶת יִסּוּרֵיהֶם,</tei:l>
          <tei:l>רְפָא אֶת פִּצְעֵיהֶם</tei:l>
          <tei:l>וְתֵן לָהֶם וְלָנוּ נֶחָמָה וּרְפוּאָה</tei:l>
          <tei:l>לַגּוּף הַדּוֹאֵב</tei:l>
          <tei:l>וּלַנֶּפֶשׁ הַבּוֹכִיָּה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_return_of_slain_hostages_israel/7"/>
        <tei:lg>
          <tei:l>וְאֵין לְפָנֶיךָ וּלְפָנֵינוּ מִצְוָה גְּדוֹלָה יוֹתֵר</tei:l>
          <tei:l>מִפִּדְיוֹן שְׁבוּיוֹת וּשְׁבוּיִים. <tei:bibl>(שולחן ערוך, יורה דעה רנ״ב:א׳)</tei:bibl></tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>אָנָּא, בַּעַל הָרַחֲמִים,</tei:l>
          <tei:l>עֲשֵׂה לְמַעַן</tei:l>
          <tei:l>יָשׁוּבוּ בִּמְהֵרָה</tei:l>
          <tei:l>מִי בְּשִׂמְחָה – לְחַיִּים וּלְשִׁקּוּם,</tei:l>
          <tei:l>וּמִי בְּצַעַר – לִמְנוּחַת עוֹלָמִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_return_of_slain_hostages_israel/8"/>
        <tei:lg>
          <tei:l>וְיִתְקַיֵּם בָּנוּ</tei:l>
          <tei:l>”וְשָׁבוּ בָנִים וּבָנוֹת לִגְבוּלָם“ <tei:bibl>(אחר ירמיה לא:יז)</tei:bibl></tei:l>
          <tei:l>וְנֹאמַר אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
