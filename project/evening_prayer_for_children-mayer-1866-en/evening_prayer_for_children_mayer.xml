  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:evening_prayer_for_children_mayer">
        <tei:head>Evening Prayer for Children, by Rabbi Moritz Mayer (1866)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:evening_prayer_for_children_mayer/1"/>
        <tei:lg>
          <tei:l>Now to bed I do retire,</tei:l>
          <tei:l>Rest to find and sweet repose;</tei:l>
          <tei:l>Lord! my weary eyes aspire</tei:l>
          <tei:l>Unto Thee before they close.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:evening_prayer_for_children_mayer/2"/>
        <tei:lg>
          <tei:l>Thou, O Father, ever good,</tei:l>
          <tei:l>Take my thanks for all Thy love,</tei:l>
          <tei:l>For Thy care, for drink and food,</tei:l>
          <tei:l>Which Thou gav’st me from above</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:evening_prayer_for_children_mayer/3"/>
        <tei:lg>
          <tei:l>Pardon ev’ry sinful deed,</tei:l>
          <tei:l>Ev’ry evil I have done;</tei:l>
          <tei:l>Let my tender age now plead</tei:l>
          <tei:l>To Thy mercy, Holy One!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:evening_prayer_for_children_mayer/4"/>
        <tei:lg>
          <tei:l>Let my childhood’s innocence</tei:l>
          <tei:l>Last through life, unbroken, pure;</tei:l>
          <tei:l>That, when’er thou call’s! me hence,</tei:l>
          <tei:l>My salvation shall be sure.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
