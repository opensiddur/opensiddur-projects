  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ain_gaitein_a_gothic_translation_of_had_gadya">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ain_gaitein_a_gothic_translation_of_had_gadya/1"/>
        <tei:lg>
          <tei:l>ען גּעטיִן‫,‬ ען גּעטיִן‫,</tei:l>
          <tei:l>תֿאַטיִ בּאָחטאַ אַטטאַ מִינס</tei:l>
          <tei:l>אוּנדּ טועם סקאַטטאַם</tei:l>
          <tei:l>ען גּעטיִן‫,‬ ען גּעטיִן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ain_gaitein_a_gothic_translation_of_had_gadya/2"/>
        <tei:lg>
          <tei:l>תֿאַן קואַם קאַטטוּס</tei:l>
          <tei:l>יּאַח אײֵט גּעטיִן</tei:l>
          <tei:l>תֿאַטיִ בּאָחטאַ אַטטאַ מִינס</tei:l>
          <tei:l>אוּנדּ טועם סקאַטטאַם</tei:l>
          <tei:l>ען גּעטיִן‫,‬ ען גּעטיִן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ain_gaitein_a_gothic_translation_of_had_gadya/3"/>
        <tei:lg>
          <tei:l>תֿאַן קואַם הוּנדּס</tei:l>
          <tei:l>יּאַח בּעט קאַטטוּ</tei:l>
          <tei:l>סאַיִ אײֵט גּעטיִן</tei:l>
          <tei:l>תֿאַטיִ בּאָחטאַ אַטטאַ מִינס</tei:l>
          <tei:l>אוּנדּ טועם סקאַטטאַם</tei:l>
          <tei:l>ען גּעטיִן, ען גּעטיִן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ain_gaitein_a_gothic_translation_of_had_gadya/4"/>
        <tei:lg>
          <tei:l>תֿאַן קואַם חרוּנׄגּאַ</tei:l>
          <tei:l>יּאַח בּלאַנׄגּו הוּנדּ</tei:l>
          <tei:l>סאַיִ בּעט קאַטטוּ</tei:l>
          <tei:l>סאַיִ אײֵט גּעטיִן</tei:l>
          <tei:l>תֿאַטיִ בּאָחטאַ אַטטאַ מִינס</tei:l>
          <tei:l>אוּנדּ טועם סקאַטטאַם</tei:l>
          <tei:l>ען גּעטיִן, ען גּעטיִן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ain_gaitein_a_gothic_translation_of_had_gadya/5"/>
        <tei:lg>
          <tei:l>תֿאַן קואַם פֿוֹן</tei:l>
          <tei:l>יּאַח גּאַטאַנדּידֿאַ חרוּנׄגּאַ</tei:l>
          <tei:l>סוֹיִ בּלאַנׄגּו הוּנדּ</tei:l>
          <tei:l>סאַיִ בּעט קאַטטוּ</tei:l>
          <tei:l>סאַיִ אײֵט גּעטיִן</tei:l>
          <tei:l>תֿאַטיִ בּאָחטאַ אַטטאַ מִינס</tei:l>
          <tei:l>אוּנדּ טועם סקאַטטאַם</tei:l>
          <tei:l>ען גּעטיִן, ען גּעטיִן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ain_gaitein_a_gothic_translation_of_had_gadya/6"/>
        <tei:lg>
          <tei:l>תֿאַן קואַם ואַטוֹ</tei:l>
          <tei:l>יּאַח אַפֿחואַפּידֿאַ פֿוֹן</tei:l>
          <tei:l>תֿאַטיִ גּאַטאַנדּידֿאַ חרוּנׄגּאַ</tei:l>
          <tei:l>סוֹיִ בּלאַנׄגּו הוּנדּ</tei:l>
          <tei:l>סאַיִ בּעט קאַטטוּ</tei:l>
          <tei:l>סאַיִ אײֵט גּעטיִן</tei:l>
          <tei:l>תֿאַטיִ בּאָחטאַ אַטטאַ מִינס</tei:l>
          <tei:l>אוּנדּ טועם סקאַטטאַם</tei:l>
          <tei:l>ען גּעטיִן, ען גּעטיִן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ain_gaitein_a_gothic_translation_of_had_gadya/7"/>
        <tei:lg>
          <tei:l>תֿאַן קואַם אָחסאַ</tei:l>
          <tei:l>יּאַח דּראַנׄק ואַטוֹ</tei:l>
          <tei:l>תֿאַטיִ אַפֿחואַפּידֿאַ פֿוֹן</tei:l>
          <tei:l>תֿאַטיִ גּאַטאַנדּידֿאַ חרוּנׄגּאַ</tei:l>
          <tei:l>סוֹיִ בּלאַנׄגּו הוּנדּ</tei:l>
          <tei:l>סאַיִ בּעט קאַטטוּ</tei:l>
          <tei:l>סאַיִ אײֵט גּעטיִן</tei:l>
          <tei:l>תֿאַטיִ בּאָחטאַ אַטטאַ מִינס</tei:l>
          <tei:l>אוּנדּ טועם סקאַטטאַם</tei:l>
          <tei:l>ען גּעטיִן, ען גּעטיִן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ain_gaitein_a_gothic_translation_of_had_gadya/8"/>
        <tei:lg>
          <tei:l>תֿאַן קואַם סקיליּאַ</tei:l>
          <tei:l>יּאַח אוּפסנעתֿ אָחסאָ</tei:l>
          <tei:l>סאַיִ דּראַנׄק ואַטוֹ</tei:l>
          <tei:l>תֿאַטיִ אַפֿחואַפּידֿאַ פֿוֹן</tei:l>
          <tei:l>תֿאַטיִ גּאַטאַנדּידֿאַ חרוּנׄגּאַ</tei:l>
          <tei:l>סוֹיִ בּלאַנׄגּו הוּנדּ</tei:l>
          <tei:l>סאַיִ בּעט קאַטטוּ</tei:l>
          <tei:l>סאַיִ אײֵט גּעטיִן</tei:l>
          <tei:l>תֿאַטיִ בּאָחטאַ אַטטאַ מִינס</tei:l>
          <tei:l>אוּנדּ טועם סקאַטטאַם</tei:l>
          <tei:l>ען גּעטיִן, ען גּעטיִן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ain_gaitein_a_gothic_translation_of_had_gadya/9"/>
        <tei:lg>
          <tei:l>תֿאַן קואַם אַנׄגּילוּס דּאָתֿאָס</tei:l>
          <tei:l>יּאַח אוּפסנעתֿ סקיליּאַן</tei:l>
          <tei:l>סאַיִ אוּפסנעתֿ אָחסאָ</tei:l>
          <tei:l>סאַיִ דּראַנׄק ואַטוֹ</tei:l>
          <tei:l>תֿאַטיִ אַפֿחואַפּידֿאַ פֿוֹן</tei:l>
          <tei:l>תֿאַטיִ גּאַטאַנדּידֿאַ חרוּנׄגּאַ</tei:l>
          <tei:l>סוֹיִ בּלאַנׄגּו הוּנדּ</tei:l>
          <tei:l>סאַיִ בּעט קאַטטוּ</tei:l>
          <tei:l>סאַיִ אײֵט גּעטיִן</tei:l>
          <tei:l>תֿאַטיִ בּאָחטאַ אַטטאַ מִינס</tei:l>
          <tei:l>אוּנדּ טועם סקאַטטאַם</tei:l>
          <tei:l>ען גּעטיִן, ען גּעטיִן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ain_gaitein_a_gothic_translation_of_had_gadya/10"/>
        <tei:lg>
          <tei:l>תֿאַן קואַם ויִחס אָדֿאַחאַפֿטס ג״ת</tei:l>
          <tei:l>יּאַח אוּפסנעתֿ אַנׄגּילוּ דּאָתֿאָס</tei:l>
          <tei:l>סאַיִ אוּפסנעתֿ סקיליּאַן</tei:l>
          <tei:l>סאַיִ אוּפסנעתֿ אָחסאָ</tei:l>
          <tei:l>סאַיִ דּראַנׄק ואַטוֹ</tei:l>
          <tei:l>תֿאַטיִ אַפֿחואַפּידֿאַ פֿוֹן</tei:l>
          <tei:l>תֿאַטיִ גּאַטאַנדּידֿאַ חרוּנׄגּאַ</tei:l>
          <tei:l>סוֹיִ בּלאַנׄגּו הוּנדּ</tei:l>
          <tei:l>סאַיִ בּעט קאַטטוּ</tei:l>
          <tei:l>סאַיִ אײֵט גּעטיִן</tei:l>
          <tei:l>תֿאַטיִ בּאָחטאַ אַטטאַ מִינס</tei:l>
          <tei:l>אוּנדּ טועם סקאַטטאַם</tei:l>
          <tei:l>ען גּעטיִן, ען גּעטיִן</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
