  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha">
        <tei:head>וְיֶאֱתָֽיוּ כֹּל לְעָבְדֶּֽךָ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/1"/>
        <tei:lg>
          <tei:l>וְיֶ<tei:seg type="acrostic">אֱ</tei:seg>תָֽיוּ כֹּל לְעָבְדֶּֽךָ</tei:l>
          <tei:l>וִי<tei:seg type="acrostic">בָ</tei:seg>רְכוּ שֵׁם כְּבוֹדֶֽךָ</tei:l>
          <tei:l>וְיַ<tei:seg type="acrostic">גִּֽ</tei:seg>ידוּ</tei:l>
          <tei:l>בָאִיִּים צִדְקֶךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/2"/>
        <tei:lg>
          <tei:l>וְיִ<tei:seg type="acrostic">דְ</tei:seg>רְשֽׁוּךָ עַמִּים לֹא יְדָעֽוּךָ</tei:l>
          <tei:l>וִי<tei:seg type="acrostic">הַ</tei:seg>לְלֽוּךָ כׇּל אַפְסֵי אָֽרֶץ</tei:l>
          <tei:l>וְי<tei:seg type="acrostic">וֹ</tei:seg>אמְרוּ תָמִיד</tei:l>
          <tei:l>יִגְדַּל יְיָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/3"/>
        <tei:lg>
          <tei:l>וְיִ<tei:seg type="acrostic">זְ</tei:seg>בְּחוּ לְךָ אֶת זִבְחֵיהֶם</tei:l>
          <tei:l>וְיִ<tei:seg type="acrostic">זְ</tei:seg>נְחוּ אֶת עֲצַבֵּיהֶם</tei:l>
          <tei:l>וְיַ<tei:seg type="acrostic">חְ</tei:seg>פְּרוּ עִם פְּסִילֵיהֶם׃</tei:l>
          <tei:l>וְיַ<tei:seg type="acrostic">טּ</tei:seg>וּ שְׁכֶם אֶחָד לְעָבְדֶֽךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/4"/>
        <tei:lg>
          <tei:l>וְיִ<tei:seg type="acrostic">י</tei:seg>רָאֽוּךָ עִם שֶֽׁמֶשׁ מְבַקְשֵׁי פָנֶֽיךָ</tei:l>
          <tei:l>וְיַ<tei:seg type="acrostic">כִּֽ</tei:seg>ירוּ כֹּֽחַ מַלְכוּתֶֽךָ</tei:l>
          <tei:l>וְיִ<tei:seg type="acrostic">לְ</tei:seg>מְדוּ</tei:l>
          <tei:l>תוֹעִים בִּינָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/5"/>
        <tei:lg>
          <tei:l>וִי<tei:seg type="acrostic">מַ</tei:seg>לְּלוּ</tei:l>
          <tei:l>אֶת גְּבוּרָתֶֽךָ</tei:l>
          <tei:l>וִי<tei:seg type="acrostic">נַ</tei:seg>שְּׂאֽוּךָ</tei:l>
          <tei:l>מִתְנַשֵּׂא לְכֹל לְרֹאשׁ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/6"/>
        <tei:lg>
          <tei:l>וִי<tei:seg type="acrostic">סַ</tei:seg>לְּדוּ</tei:l>
          <tei:l>בְחִילָה פָּנֶֽיךָ</tei:l>
          <tei:l>וִי<tei:seg type="acrostic">עַ</tei:seg>טְּרֽוּךָ</tei:l>
          <tei:l>נֶֽזֶר תִּפְאָרָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/7"/>
        <tei:lg>
          <tei:l>וְיִ<tei:seg type="acrostic">פְ</tei:seg>צְחוּ הָרִים רִנָּה</tei:l>
          <tei:l>וְיִ<tei:seg type="acrostic">צְ</tei:seg>הֲלוּ אִיִּים בְּמָלְכֶֽךָ</tei:l>
          <tei:l>וִי<tei:seg type="acrostic">קַ</tei:seg>בְּלוּ עֹל מַלְכוּתְךָ עֲלֵיהֶם</tei:l>
          <tei:l>וִי<tei:seg type="acrostic">ר</tei:seg>וֹמֲמֽוּךָ בִּקְהַל עָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/8"/>
        <tei:lg>
          <tei:l>וְיִ<tei:seg type="acrostic">שְׁ</tei:seg>מְעוּ</tei:l>
          <tei:l>רְחוֹקִים וְיָבֽוֹאוּ</tei:l>
          <tei:l>וְיִ<tei:seg type="acrostic">תְּ</tei:seg>נוּ לְךָ</tei:l>
          <tei:l>כֶּֽתֶר מְלוּכָה׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
