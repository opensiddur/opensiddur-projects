  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_on_behalf_of_one_celebrating_a_birthday_kaplan">
        <tei:head>Mi sheBerakh on behalf of one celebrating a birthday, by Rabbi Dr. Mordecai Kaplan (1945)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_on_behalf_of_one_celebrating_a_birthday_kaplan/1"/>
        <tei:lg>
          <tei:l>May the One who blessed our fathers,</tei:l>
          <tei:l>Avraham, Yitsḥaq, and Ya’aqov,</tei:l>
          <tei:l>bless (<tei:note type="instruction">...</tei:note>)</tei:l>
          <tei:l>on the (<tei:note type="instruction">...</tei:note>) anniversary of their birthday.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_on_behalf_of_one_celebrating_a_birthday_kaplan/2"/>
        <tei:lg>
          <tei:l>May Elohim who enabled them</tei:l>
          <tei:l>to live to this day</tei:l>
          <tei:l>continue their mercies</tei:l>
          <tei:l>and grant them many more years</tei:l>
          <tei:l>of health and happiness.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_on_behalf_of_one_celebrating_a_birthday_kaplan/3"/>
        <tei:lg>
          <tei:l>May [Elohim] keep them free</tei:l>
          <tei:l>from all anxieties</tei:l>
          <tei:l>and bodily ills.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_on_behalf_of_one_celebrating_a_birthday_kaplan/4"/>
        <tei:lg>
          <tei:l>May [Elohim] cause them to rejoice</tei:l>
          <tei:l>in the happiness</tei:l>
          <tei:l>of all who are dear to them.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_on_behalf_of_one_celebrating_a_birthday_kaplan/5"/>
        <tei:lg>
          <tei:l>May [Elohim] enable them</tei:l>
          <tei:l>to behold the fulfilment</tei:l>
          <tei:l>of all their worthy hopes</tei:l>
          <tei:l>and prayers.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_on_behalf_of_one_celebrating_a_birthday_kaplan/6"/>
        <tei:lg>
          <tei:l><tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_on_behalf_of_one_celebrating_a_birthday_kaplan/7"/>
        <tei:lg>
          <tei:l>Blessed be you</tei:l>
          <tei:l>YHVH our <tei:hi rend="italic">elo’ah</tei:hi></tei:l>
          <tei:l>King of the universe</tei:l>
          <tei:l>who has kept us in life,</tei:l>
          <tei:l>sustained us</tei:l>
          <tei:l>and brought us</tei:l>
          <tei:l>to this happy occasion.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
