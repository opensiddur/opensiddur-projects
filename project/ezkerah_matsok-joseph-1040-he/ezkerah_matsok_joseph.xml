    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:ezkerah_matsok_joseph">
        <tei:head>אֶזְכְּרָה מָצוֹק</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ezkerah_matsok_joseph/1"/>
        <tei:lg>
          <tei:l>אֱלֹהֵינוּ וֵאֹלהֵי אָבוֹתֵינוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ezkerah_matsok_joseph/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אֶ</tei:seg>זְכְּרָה מָצוֹק אֲשֶׁר קְרָאַנִּי.</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>שָׁלֹשׁ מַכּוֹת בַּחֹדֶשׁ־זֶה הִכַּנּי.</tei:l>
          <tei:l><tei:seg type="acrostic">גִּ</tei:seg>דְּעַנִּי הִנְיאַנִּי הִכְאַנִּי.</tei:l>
          <tei:l>אַךְ־עַתָּ֥ה הֶלְאָ֑נִי׃ <tei:bibl>(איוב טז:ז חלק)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ezkerah_matsok_joseph/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">דִּ</tei:seg>עֲכַנִּי בִּשְׁמוֹנָה בּוֹ שְׂמׇאלִית וִימָנִית.</tei:l>
          <tei:l><tei:seg type="acrostic">הֲ</tei:seg>לֹא שְׁלָשְׁתָּן קָבַעְתִּי תַעֲנִית.</tei:l>
          <tei:l><tei:seg type="acrostic">וּ</tei:seg>מֶלֶךְ יָוָן אִנְּסַנִּי לִכְתּוֹב דַּת יְוָנִית.</tei:l>
          <tei:l>עַל־גַּ֭בִּי חָרְשׁ֣וּ חֹרְשִׁ֑ים הֶ֝אֱרִ֗יכוּ לְמַעֲנִית׃ <tei:bibl>(תהלים קלט:ג חלק)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ezkerah_matsok_joseph/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ז</tei:seg>וֹעַמְתִּי בְּתִשְׁעָה־בּוֹ בְּכְלִמָּה וְהֵפֶר.</tei:l>
          <tei:l><tei:seg type="acrostic">חָ</tei:seg>שַׂךְ מֵעָלַי מֵעִיל הוֹד וָצֶפֶר.</tei:l>
          <tei:l><tei:seg type="acrostic">טָ</tei:seg>רֹף טֹרַף בּוֹ הַנֹּתֵ֖ן אִמְרֵי־שָֽׁפֶר׃ <tei:bibl>(בראשית מט:כא)</tei:bibl></tei:l>
          <tei:l>הוּא עֶזְרָא הַסּוֹפֵר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ezkerah_matsok_joseph/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">י</tei:seg>וֹם עֲשִׂירִי צֻוָּה בֶּן־בּוּזִי הַחוֹזֶה.</tei:l>
          <tei:l><tei:seg type="acrostic">כְּ</tei:seg>תׇב־לְךָ בַּסֵּפֶר הַמַּחֲזֶה.</tei:l>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>זִכָּרוֹן לְעַם נָמֵס וְנִבְזֶה.</tei:l>
          <tei:l>אֶת־עֶ֖צֶם הַיּ֣וֹם הַזֶּ֑ה׃ <tei:bibl>(יחזקאל כד:ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ezkerah_matsok_joseph/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>נְיַן סֵדֶר חֲדָשִׁים בַּעֲשָׂרָה בּוֹ הֵעִיר.</tei:l>
          <tei:l><tei:seg type="acrostic">נְ</tei:seg>הִי וְיֵילִיל בְּמוֹפִי אַפְעִיר.</tei:l>
          <tei:l><tei:seg type="acrostic">סֵ</tei:seg>דֶר פּוּרְעָנִיּוֹת בְּתוֹךְ לְבָבִי יַבְעִיר.</tei:l>
          <tei:l>בְּבוֹא־אֵלַ֨י הַפָּלִ֧יט... לֵאמֹ֖ר הֻכְּתָ֥ה הָעִֽיר׃ <tei:bibl>(יחזקאל לג:כא חלק)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ezkerah_matsok_joseph/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">עַ</tei:seg>ל אֵלֶּה עַל פָּנַי אָבָק זֵרִיתי.</tei:l>
          <tei:l><tei:seg type="acrostic">פַּ</tei:seg>צְתִּי עַל אַרְבַּעְתָּן לוּ חַץ בְּלִבִּי יָרִיתִי.</tei:l>
          <tei:l><tei:seg type="acrostic">צָ</tei:seg>רוֹת עַל אֵלֶּה קֶבֶר לִי כָּריתִי.</tei:l>
          <tei:l>צַדִּ֥יק ה֛וּא יְהֹוָ֖ה כִּ֣י פִ֣יהוּ מָרִ֑יתִי׃ <tei:bibl>(איכה א:יח חלק)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ezkerah_matsok_joseph/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>רָאתִי שִׁמְךָ מִתְנַחֵם עַל רָעָתִי.</tei:l>
          <tei:l><tei:seg type="acrostic">רְ</tei:seg>אֵה עׇנְיִי וּשְׁמַע קוֹל פְּגִיעָתִי.</tei:l>
          <tei:l><tei:seg type="acrostic">שְׁ</tei:seg>מַע תְּחִנָּתִי הִישׁ־נָא יְשׁוּעָתִי.</tei:l>
          <tei:l>אַל־<tei:seg type="acrostic">תַּ</tei:seg>עְלֵ֧ם אׇזְנְךָ֛ לְרַוְחָתִ֖י לְשַׁוְעָתִֽי׃ <tei:bibl>(איכה ג:נו חלק)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ezkerah_matsok_joseph/9"/>
        <tei:lg>
          <tei:l>יֶרַח טֵבֵת מְאוֹד לֻקִּיתִי בוֹ.</tei:l>
          <tei:l>וְנִשְׁתַּנוּ עָלַי סִדְרֵי נְתִיבוֹ.</tei:l>
          <tei:l>סָרַרְתִּי פְּשַׁעְתִּי גַּלֵּה־לִי טוּבוֹ.</tei:l>
          <tei:l>הָאוֹמֵר לַיָּם עַד־פֹּ֣ה תָ֭בוֹא׃ <tei:bibl>(איוב לח:יא)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
