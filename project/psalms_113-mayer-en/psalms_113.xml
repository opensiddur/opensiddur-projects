  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/113">
        <tei:head>Psalms 113, translated and cantillated for Hallel by Isaac Gantwerk Mayer</tei:head>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>Praise the Source!</tei:l>
          <tei:l>Praise, servants of the Cause;</tei:l>
          <tei:l>praise the name of the Cause.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/113/2/a"/>
        <tei:lg>
          <tei:l>May the name of the Cause be blessed</tei:l>
          <tei:l>from now until eternity.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>From the sun’s rise until its set,</tei:l>
          <tei:l>praised is the name of the Cause.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>High over all nations is the Cause,</tei:l>
          <tei:l>over the heaven the Divine Glory.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/113/5/a"/>
        <tei:lg>
          <tei:l>Who is like the Cause our God,</tei:l>
          <tei:l>in the heights sitting?</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/113/6/a"/>
        <tei:lg>
          <tei:l>From above looking down</tei:l>
          <tei:l>upon heaven and earth.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/113/7/a"/>
        <tei:lg>
          <tei:l>Raising from the dust the poor,</tei:l>
          <tei:l>from the dung-heaps lifting the needy,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>Setting them with princes,</tei:l>
          <tei:l>with the princes of their people.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/113/9"/>
        <tei:lg>
          <tei:l>Setting the barren in a good home,</tei:l>
          <tei:l>the mother of children rejoices,</tei:l>
          <tei:l>praise the Source!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
