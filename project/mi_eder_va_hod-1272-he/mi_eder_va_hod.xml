    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:mi_eder_va_hod">
        <tei:head>מִי אֵֽדֶר וָהוֹד</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_eder_va_hod/1"/>
        <tei:lg>
          <tei:l>...כׇּ֥ל עַצְמוֹתַ֨י ׀ תֹּאמַ֮רְנָה֮ יְהֹוָ֗ה מִ֥י־כָ֫מ֥וֹךָ</tei:l>
          <tei:l>מַצִּ֣יל עָ֭נִי מֵחָזָ֣ק מִמֶּ֑נּוּ וְעָנִ֥י וְ֝אֶבְי֗וֹן מִגֹּֽזְלֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_eder_va_hod/2"/>
        <tei:lg>
          <tei:l>מִי <tei:seg type="acrostic">אֵֽ</tei:seg>דֶר וָהוֹד עָלָיו הׇעֳלַם</tei:l>
          <tei:l>כָּמֽוֹךָ בְּיוֹם <tei:seg type="acrostic">בְּ</tei:seg>רֵאשִׁית בְּרִיַּת עוֹלָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_eder_va_hod/3"/>
        <tei:lg>
          <tei:l>מִי <tei:seg type="acrostic">גֵּ</tei:seg>אוּת לָבֵשׁ וְהֻכְלַל בְּכַרְבּוּל</tei:l>
          <tei:l>כָּמֽוֹךָ בְּיוֹם <tei:seg type="acrostic">דִּ</tei:seg>ין דּוֹר הַמַּבּוּל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_eder_va_hod/4"/>
        <tei:lg>
          <tei:l>מִי <tei:seg type="acrostic">הִ</tei:seg>תְאַזַּר עֹז</tei:l>
          <tei:l>כָּמֽוֹךָ בְּיוֹם <tei:seg type="acrostic">וַֽ</tei:seg>עַד מַתַּן עֹז׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_eder_va_hod/5"/>
        <tei:lg>
          <tei:l>מִי <tei:seg type="acrostic">זַ</tei:seg>ךְ כַּשֶּֽׁלֶג לְבוּשׁוֹ</tei:l>
          <tei:l>כָּמֽוֹךָ בְּיוֹם <tei:seg type="acrostic">חַ</tei:seg>ת בֵּל לְהוֹבִישׁוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_eder_va_hod/6"/>
        <tei:lg>
          <tei:l>מִי <tei:seg type="acrostic">טֻ</tei:seg>כְסַס בְּתִלְבֹּֽשֶׁת נְקָמָה</tei:l>
          <tei:l>כָּמֽוֹךָ בְּיוֹם <tei:seg type="acrostic">מִ</tei:seg>מַּדַּי נִפְרַֽעְתָּ בְּקִנְאָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_eder_va_hod/7"/>
        <tei:lg>
          <tei:l>מִי <tei:seg type="acrostic">כַּ</tei:seg>מְּעִיל טַלִּית נִתְנָאָה</tei:l>
          <tei:l>כָּמֽוֹךָ בְּיוֹם <tei:seg type="acrostic">לְ</tei:seg>שַׂר יָוָן עוֹרַֽרְתָּ קִנְאָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_eder_va_hod/8"/>
        <tei:lg>
          <tei:l>מִי <tei:seg type="acrostic">מַ</tei:seg>דּוֹ כַּשִּׁרְיָן צְדָקָה</tei:l>
          <tei:l>כָּמֽוֹךָ בְּיוֹם <tei:seg type="acrostic">נִ</tei:seg>כְשָׁלִים חַֽיִל לְחַזְּקָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_eder_va_hod/9"/>
        <tei:lg>
          <tei:l>מִי <tei:seg type="acrostic">ס</tei:seg>וּדָרוֹ כּוֹבַע יְשׁוּעָה</tei:l>
          <tei:l>כָּמֽוֹךָ בְּיוֹם <tei:seg type="acrostic">עֻ</tei:seg>טַּר בְּכׇל־שָׁעָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_eder_va_hod/10"/>
        <tei:lg>
          <tei:l>מִי <tei:seg type="acrostic">פּ</tei:seg>וֹרֵֽעַ בִּלְבוּשׁוֹ אָדוֹם</tei:l>
          <tei:l>כָּמֽוֹךָ בְּיוֹם <tei:seg type="acrostic">צֹ</tei:seg>עֶה בְּכֹֽחַ מֵאֱדוֹם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_eder_va_hod/11"/>
        <tei:lg>
          <tei:l>מִי <tei:seg type="acrostic">קָ</tei:seg>שׁוּט פּוֹרְפֵּרוֹן הָדוּר</tei:l>
          <tei:l>כָּמֽוֹךָ בְּיוֹם <tei:seg type="acrostic">רִ</tei:seg>בְבָן שְׁבָחוֹ סָדוּר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_eder_va_hod/12"/>
        <tei:lg>
          <tei:l>מִי <tei:seg type="acrostic">שֻׁ</tei:seg>פַּר בְּגִלּוּמִים חֲבוּשִׁים</tei:l>
          <tei:l>כָּמֽוֹךָ בְּיוֹם <tei:seg type="acrostic">תִּ</tei:seg>פְאֶֽרֶת עֲשָׂרָה לְבוּשִׁים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_eder_va_hod/13"/>
        <tei:lg>
          <tei:l>מִי יִדְמֶה לָּךְ וּמִי יִשְׁוֶה לָּךְ וּמִי יַעֲרׇךְ לָךְ...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>