    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:tamu_chalomotenu_mayer">
        <tei:head>תַּֽמּוּ חֲלוֹמוֹתֵֽינוּ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tamu_chalomotenu_mayer/1"/>
        <tei:lg>
          <tei:l>תַּֽמּוּ חֲלוֹמוֹתֵֽינוּ בִּשְׁפִיכַת דָּם</tei:l>
          <tei:l>בְּצוֹם רָצֽוּחַ מְפַקֵּד יִשְׂרָאֵל</tei:l>
          <tei:l>שׁוֹמְרֵי שָׁוְא וָהֶֽבֶל עָזְבוּ חַסְדָּם</tei:l>
          <tei:l>בְּיוֹם רֶֽצַח בְּכִכַּר מַלְכֵי יִשְׂרָאֵל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tamu_chalomotenu_mayer/2"/>
        <tei:lg>
          <tei:l>רָאוּ הַזְּקֵנִים וַיִּירָֽאוּ</tei:l>
          <tei:l>בְּצוֹם רָצֽוּחַ מְפַקֵּד יִשְׂרָאֵל</tei:l>
          <tei:l>קִרְאוּ צוֹם קָרָֽאתִי וְלֹא־קָרָֽאוּ</tei:l>
          <tei:l>בְּיוֹם רֶֽצַח בְּכִכַּר מַלְכֵי יִשְׂרָאֵל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tamu_chalomotenu_mayer/3"/>
        <tei:lg>
          <tei:l>צַדִּיקִים נֶהֶרְגוּ עַד־אֵין מִסְפָּר</tei:l>
          <tei:l>בְּצוֹם רָצֽוּחַ מְפַקֵּד יִשְׂרָאֵל</tei:l>
          <tei:l>פְּרָאִים שָׂמְחוּ בְּקוֹל שׁוֹפָר</tei:l>
          <tei:l>בְּיוֹם רֶֽצַח בְּכִכַּר מַלְכֵי יִשְׂרָאֵל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tamu_chalomotenu_mayer/4"/>
        <tei:lg>
          <tei:l>עַל־כָּךְ נָצוּם בְּמׇחֳרַת הַזִּכָּרוֹן</tei:l>
          <tei:l>בְּצוֹם רָצֽוּחַ מְפַקֵּד יִשְׂרָאֵל</tei:l>
          <tei:l>סְלַח לְעַם קְשֵׁה עֹֽרֶף מִדִּין אַף וְחָרוֹן</tei:l>
          <tei:l>בְּיוֹם רֶֽצַח בְּכִכַּר מַלְכֵי יִשְׂרָאֵל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tamu_chalomotenu_mayer/5"/>
        <tei:lg>
          <tei:l>נְבָלִים עָמְדוּ בְּתוֹךְ הַקְּדוֹשִׁים</tei:l>
          <tei:l>בְּצוֹם רָצֽוּחַ מְפַקֵּד יִשְׂרָאֵל</tei:l>
          <tei:l>מֵעֵת וְעַד־עֵת יֵשׁ כָּאֵֽלּוּ אֲנָשִׁים</tei:l>
          <tei:l>בְּיוֹם רֶֽצַח בְּכִכַּר מַלְכֵי יִשְׂרָאֵל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tamu_chalomotenu_mayer/6"/>
        <tei:lg>
          <tei:l>לִמְּדוּ‎־נָא כְּסִילִים לְאָן מַדְרִיךְ הַשִּׂנְאָה</tei:l>
          <tei:l>בְּצוֹם רָצֽוּחַ מְפַקֵּד יִשְׂרָאֵל</tei:l>
          <tei:l>כִּלְיוֹן וְכִבּוּי שֶׁאֵין־עַֽיִן רָאָה</tei:l>
          <tei:l>בְּיוֹם רֶֽצַח בְּכִכַּר מַלְכֵי יִשְׂרָאֵל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tamu_chalomotenu_mayer/7"/>
        <tei:lg>
          <tei:l>יְהוּדָה הִתְיָאֲשָׁה מֵחֲזֵקַת אֲחֻזָּתָהּ</tei:l>
          <tei:l>בְּצוֹם רָצֽוּחַ מְפַקֵּד יִשְׂרָאֵל</tei:l>
          <tei:l>טֵרוֹר וָפַֽחַד כָּבְשׁוּ מֶמְשַׁלְתָּהּ</tei:l>
          <tei:l>בְּיוֹם רֶֽצַח בְּכִכַּר מַלְכֵי יִשְׂרָאֵל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tamu_chalomotenu_mayer/8"/>
        <tei:lg>
          <tei:l>חֲמוּרִים עֲווֹנוֹת מִפְלֶֽגֶת בֶּן־נְתַנְיָֽהוּ</tei:l>
          <tei:l>בְּצוֹם רָצֽוּחַ מְפַקֵּד יִשְׂרָאֵל</tei:l>
          <tei:l>זִכְרוּ־נָא יִצְחָק כְּזִכְרוֹן גְּדַלְיָֽהוּ</tei:l>
          <tei:l>בְּיוֹם רֶֽצַח בְּכִכַּר מַלְכֵי יִשְׂרָאֵל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tamu_chalomotenu_mayer/9"/>
        <tei:lg>
          <tei:l>וְהַדָּת שֶׁעִוָּה יִשְׁמָעֵאל הָרוֹצֵֽחַ</tei:l>
          <tei:l>בְּצוֹם רָצֽוּחַ מְפַקֵּד יִשְׂרָאֵל</tei:l>
          <tei:l>הֻמְעֲטָה הִיא וְאֵין־יוֹחָנָן בֶּן־קָרֵֽחַ</tei:l>
          <tei:l>בְּיוֹם רֶֽצַח בְּכִכַּר מַלְכֵי יִשְׂרָאֵל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tamu_chalomotenu_mayer/10"/>
        <tei:lg>
          <tei:l>דַּיָּן יְתוֹמִים הִסְתַּכַּֽלְתָּ בַּטֶּֽבַח</tei:l>
          <tei:l>בְּצוֹם רָצֽוּחַ מְפַקֵּד יִשְׂרָאֵל</tei:l>
          <tei:l>גַּם עַתָּה תִּסְתַּכֵּל מֵאֵת־רוֹצְחִים מְנַע שֶֽׁבַח</tei:l>
          <tei:l>בְּיוֹם רֶֽצַח בְּכִכַּר מַלְכֵי יִשְׂרָאֵל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tamu_chalomotenu_mayer/11"/>
        <tei:lg>
          <tei:l>בָּרוּךְ הַנּוֹקֵם נִקְמַת דָּם עֲבָדֶֽיךָ</tei:l>
          <tei:l>בְּיוֹם הִבְדַּלְתָּנוּ מִמּוֹרְדֵי יִשְׂרָאֵל</tei:l>
          <tei:l>אֲבַקְשָׁה שָׁלוֹם בִּזְכוּת רַבִּינֶֽךָ</tei:l>
          <tei:l>בְּיוֹם זִכְרוֹן שַׂר שָׁלוֹם יִשְׂרָאֵל</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
