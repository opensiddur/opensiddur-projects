  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_prayer_on_voting_nelson">
        <tei:head>תפילה להצבעה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_on_voting_nelson/1"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן מִלְּפָנֶיךָ,</tei:l>
          <tei:l>בָּעֵת הַזֹּאת זְמַן בְּחִירוֹתֵינוּ,</tei:l>
          <tei:l>שֶׁתָּדְרִיכֵנוּ לְשָׁלוֹם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_on_voting_nelson/2"/>
        <tei:lg>
          <tei:l>בְּהַצְבָּעָתֵנוּ,</tei:l>
          <tei:l>אָנוּ מִתְחַיְּבִים לֶהֱיוֹתֵנוּ בְּנֵי הָאֲגוּדָּה,</tei:l>
          <tei:l>לְקַבָּלַת עוֹל אַחֲרָיוּתֵנוּ</tei:l>
          <tei:l>לְטוֹבַת הַצִּיבּוּר.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_on_voting_nelson/3"/>
        <tei:lg>
          <tei:l>שׁוֹפְטִים וְשׁוֹטְרִים נִתֵן לָנוּ בְּכָל שְׁעָרֵינוּ...</tei:l>
          <tei:l>וְשָׁפְטוּ אֶת הָעָם מִשְׁפָּט צֵדֶק, <tei:bibl>(דברים טז:יח)</tei:bibl></tei:l>
          <tei:l>וְנִזְכֶּה לְהִמָּנוֹת בְּתוֹךְ</tei:l>
          <tei:l>“כָּל מֵי שֶׁעוֹסְקִים בְּצָרְכֵי צִיבּוּר בֶּאֱמוּנָה.”</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_on_voting_nelson/4"/>
        <tei:lg>
          <tei:l>פְּקַח עֵינֵינוּ לִרְאוֹת</tei:l>
          <tei:l>כָּל מָעֳמָד וְמָעֳמָד וְכָל שַׂר וְיוֹעֶצֶת כִּי הֵם נִבְרְאוּ</tei:l>
          <tei:l>בְּצֶלֶם אֱלֹהִים,</tei:l>
          <tei:l>וּפְקַח עֵינֵיהֶם שֶׁיַּרְאוּ שֶׁכָּל יוֹשְׁבַי תֵּבֵל נִבְרְאוּ</tei:l>
          <tei:l>גַּם הֵם בַּצֶּלֶם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_on_voting_nelson/5"/>
        <tei:lg>
          <tei:l>אָמֵץ אֶת לְבָבֵינוּ</tei:l>
          <tei:l>לִשְׁמוֹר מִצְוַת “וְאָהַבְתָּ לְרֵעֲךָ כָּמוֹךָ”, <tei:bibl>(ויקרא יט:יח)</tei:bibl></tei:l>
          <tei:l>וְתֵן בּלִבֵּינוּ לְהָבִין</tei:l>
          <tei:l>אֶת אֵלּוּ הַחוֹלְקִים עָלִינוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_on_voting_nelson/6"/>
        <tei:lg>
          <tei:l>כַּכָּתוּב בִּתְפִילַּת יוֹם הַזִּכָּרוֹן,</tei:l>
          <tei:l>“וְיַעֲשׂוּ כּוּלָּם אֲגוּדָּה אַחַת</tei:l>
          <tei:l>לַעֲשׂוֹת רְצוֹנְךָ בְּלֵבָב שָׁלֵם,”</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_on_voting_nelson/7"/>
        <tei:lg>
          <tei:l>וְכָּכָּתוב עַל יְדֵי דָּוִד עַבְדְּךָ,</tei:l>
          <tei:l>“יְהִי שָׁלוֹם בְּחֵילֵךְ,</tei:l>
          <tei:l>שַׁלְוָה בְּאַרְמְנוֹתָיִךְ.</tei:l>
          <tei:l>לְמַעַן אַחַי וְרֵעָי</tei:l>
          <tei:l>אֲדַבְּרָה נָּא שָׁלוֹם בָּךְ.” <tei:bibl>(תהלים קכב:ז-ח)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
