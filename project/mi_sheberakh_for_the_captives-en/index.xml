      <tei:div type="colophon" subtype="introduction">
        <tei:p>This is a prayer for captives, written in November 1938 in Hamburg, following Kristallnacht (my translation following the Hebrew). “May each and every one of them return to their family...who are worrying about them.”</tei:p>
      </tei:div>
      <j:endConditional target="#osp_53174_introduction"/>
      <j:conditional xml:id="osp_53174_notes">
