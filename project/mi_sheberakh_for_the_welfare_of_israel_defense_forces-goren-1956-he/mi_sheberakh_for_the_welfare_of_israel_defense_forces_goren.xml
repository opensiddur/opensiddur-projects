    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_for_the_welfare_of_israel_defense_forces_goren">
        <tei:head>מי שברך לחיילי צה״ל</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_for_the_welfare_of_israel_defense_forces_goren/1"/>
        <tei:lg>
          <tei:l>מִי שֶׁבֵּרַךְ אֲבוֹתֵינוּ אַבְרָהָם יִצְחָק וְיַעֲקֹב</tei:l>
          <tei:l>הוּא יְבָרֵךְ אֶת חַיָּלֵי צְבָא הֲגַנָּה לְיִשְׂרָאֵל,</tei:l>
          <tei:l>הָעוֹמְדִים עַל מִשְׁמַר אַרְצֵנוּ וְעָרֵי אֱלהֵינוּ</tei:l>
          <tei:l>מִגְּבוּל הַלְּבָנוֹן וְעַד מִדְבַּר מִצְרַיִם</tei:l>
          <tei:l>וּמִן הַיָּם הַגָּדוֹל עַד לְבוֹא הָעֲרָבָה</tei:l>
          <tei:l>בַּיַּבָּשָׁה בָּאֲוִיר וּבַיָּם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_for_the_welfare_of_israel_defense_forces_goren/2"/>
        <tei:lg>
          <tei:l>יִתֵּן ה׳ אֶת אוֹיְבֵינוּ הַקָּמִים עָלֵינוּ</tei:l>
          <tei:l>נִגָּפִים לִפְנֵיהֶם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_for_the_welfare_of_israel_defense_forces_goren/3"/>
        <tei:lg>
          <tei:l>הַקָּדוֹשׁ בָּרוּךְ הוּא יִשְׁמֹר וְיַצִּיל אֶת חַיָלֵינוּ</tei:l>
          <tei:l>מִכָּל צָרָה וְצוּקָה וּמִכָּל נֶגַע וּמַחְלָה</tei:l>
          <tei:l>וְיִשְׁלַח בְּרָכָה וְהַצְלָחָה בְּכָל מַעֲשֵׂה יְדֵיהֶם.‏</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_for_the_welfare_of_israel_defense_forces_goren/4"/>
        <tei:lg>
          <tei:l><j:conditional xml:id="cond_1" type="marked"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:mi_sheberakh_for_the_welfare_of_israel_defense_forces_goren/amended"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>יִתֵּן ה׳ לְחַיָלֵינוּ חָכְמָה, בִּינָה וְדַעַת,<j:endConditional target="#cond_1"/></tei:l>
          <tei:l><j:conditional xml:id="cond_2" type="marked"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:mi_sheberakh_for_the_welfare_of_israel_defense_forces_goren/amended"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>שְׁלֹא יִסְפּוּ צָדִיק עִם רָשָׁע,<j:endConditional target="#cond_2"/></tei:l>
          <tei:l><j:conditional xml:id="cond_3" type="marked"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:mi_sheberakh_for_the_welfare_of_israel_defense_forces_goren/amended"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>כְּמוֹ שְׁכָתוּב בְּתוֹרָתֶךָ,<j:endConditional target="#cond_3"/></tei:l>
          <tei:l><j:conditional xml:id="cond_4" type="marked"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:mi_sheberakh_for_the_welfare_of_israel_defense_forces_goren/amended"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>”חָלִלָה לְּךָ מֵעֲשֹׂת כַּדָּבָר הַזֶּה,<j:endConditional target="#cond_4"/></tei:l>
          <tei:l><j:conditional xml:id="cond_5" type="marked"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:mi_sheberakh_for_the_welfare_of_israel_defense_forces_goren/amended"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>לְהָמִית צַדִּיק עִם־רָשָׁע, וְהָיָה כַצַּדִּיק כָּרָשָׁע;<j:endConditional target="#cond_5"/></tei:l>
          <tei:l><j:conditional xml:id="cond_6" type="marked"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:mi_sheberakh_for_the_welfare_of_israel_defense_forces_goren/amended"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>חָלִלָה לָּךְ — הֲשֹׁפֵט כָּל־הָאָרֶץ לֹא יַעֲשֶׂה מִשְׁפָּט.“‏ <tei:bibl>(בראשית יח:כה)</tei:bibl><j:endConditional target="#cond_6"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_for_the_welfare_of_israel_defense_forces_goren/5"/>
        <tei:lg>
          <tei:l>יַדְבֵּר שׂוֹנְאֵינוּ תַּחְתֵּיהֶם</tei:l>
          <tei:l>וִיעַטְרֵם בְּכֶתֶר יְשׁוּעָה וּבְעֲטֶרֶת נִצָּחוֹן.</tei:l>
          <tei:l>וִיקֻיַּם בָּהֶם הַכָּתוּב:</tei:l>
          <tei:l>כִּי ה׳ אֱלֹהֵיכֶם</tei:l>
          <tei:l>הַהֹלֵךְ עִמָּכֶם לְהִלָּחֵם לָכֶם עִם אֹיבֵיכֶם</tei:l>
          <tei:l>לְהוֹשִׁיעַ אֶתְכֶם: <tei:bibl>(דברים כ:ד)</tei:bibl></tei:l>
          <tei:l>וְנֹאמַר אָמֵן:‏</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
