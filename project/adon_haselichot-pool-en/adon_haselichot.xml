  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:adon_haselichot">
        <tei:head>Adon haSeliḥot, a pizmon for Seliḥot and Yom Kippur with an alphabetic acrostic translation by Rabbi David de Sola Pool (1937)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:adon_haselichot/1"/>
        <tei:lg>
          <tei:l>Merciful and Gracious One,</tei:l>
          <tei:l>we have sinned before you,</tei:l>
          <tei:l>have mercy upon us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:adon_haselichot/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">A</tei:seg>wesome God,</tei:l>
          <tei:l><tei:seg type="acrostic">B</tei:seg>eneficent and good to all your creatures,</tei:l>
          <tei:l><tei:seg type="acrostic">C</tei:seg>lothed in right,</tei:l>
          <tei:l><tei:seg type="acrostic">D</tei:seg>eclaring truth,</tei:l>
          <tei:l>God we have sinned before you;</tei:l>
          <tei:l>have mercy on us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:adon_haselichot/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">E</tei:seg>ver constant in comforts,</tei:l>
          <tei:l><tei:seg type="acrostic">F</tei:seg>oreseeing,</tei:l>
          <tei:l><tei:seg type="acrostic">G</tei:seg>lorious in wonders,</tei:l>
          <tei:l><tei:seg type="acrostic">H</tei:seg>earkening to prayers,</tei:l>
          <tei:l>God we have sinned before you;</tei:l>
          <tei:l>have mercy on us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:adon_haselichot/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">I</tei:seg>nvoking the generations,</tei:l>
          <tei:l><tei:seg type="acrostic">J</tei:seg>udging in knowledge,</tei:l>
          <tei:l><tei:seg type="acrostic">K</tei:seg>nowing all that is hidden,</tei:l>
          <tei:l><tei:seg type="acrostic">L</tei:seg>ord of forgiveness.</tei:l>
          <tei:l><tei:seg type="acrostic">M</tei:seg>oving o’er the skies,</tei:l>
          <tei:l>God we have sinned before you;</tei:l>
          <tei:l>have mercy on us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:adon_haselichot/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">N</tei:seg>igh in trouble, <tei:seg type="acrostic">o</tei:seg>verflowing in virtue,</tei:l>
          <tei:l><tei:seg type="acrostic">P</tei:seg>ardoning sins,</tei:l>
          <tei:l><tei:seg type="acrostic">Q</tei:seg>uelling sinfulness,</tei:l>
          <tei:l><tei:seg type="acrostic">R</tei:seg>emembering the covenant with the fathers,</tei:l>
          <tei:l>God we have sinned before you;</tei:l>
          <tei:l>have mercy on us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:adon_haselichot/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">S</tei:seg>earcher of inmost feelings,</tei:l>
          <tei:l><tei:seg type="acrostic">T</tei:seg>ester of hearts,</tei:l>
          <tei:l><tei:seg type="acrostic">U</tei:seg>ncovering the depths,</tei:l>
          <tei:l><tei:seg type="acrostic">V</tei:seg>enerated in praises,</tei:l>
          <tei:l><tei:seg type="acrostic">W</tei:seg>orking salvation,</tei:l>
          <tei:l>God we have sinned before you;</tei:l>
          <tei:l>have mercy on us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:adon_haselichot/7"/>
        <tei:lg>
          <tei:l>Merciful El!</tei:l>
          <tei:l>Gracious El!</tei:l>
          <tei:l>El long-suffering!</tei:l>
          <tei:l>Abounding in mercy! These are your name,</tei:l>
          <tei:l>and we are called by your name.</tei:l>
          <tei:l>Have mercy, then, YHVH in justice to your name.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
