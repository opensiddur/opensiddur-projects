    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:adventures_in_ancient_jewish_liturgy_the_birkat_kohanim_varady">
        <tei:head>Adventures in Ancient Jewish Liturgy: the Birkat Kohanim</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:adventures_in_ancient_jewish_liturgy_the_birkat_kohanim_varady/1"/>
        <tei:lg>
          <tei:l>6 <tei:hi rend="superscript">22</tei:hi> Speak to Aharon and his sons:</tei:l>
          <tei:l><tei:hi rend="superscript">23</tei:hi> Thus shall you bless the people of Israel. Say to them:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:adventures_in_ancient_jewish_liturgy_the_birkat_kohanim_varady/2"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">24</tei:hi> May YHVH bless you and protect you!</tei:l>
          <tei:l><tei:hi rend="superscript">25</tei:hi> May YHVH shine his face upon you <tei:hi rend="italic">and be gracious towards you</tei:hi>!</tei:l>
          <tei:l><tei:hi rend="superscript">26</tei:hi> May YHVH lift his face up to you, and give you peace!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:adventures_in_ancient_jewish_liturgy_the_birkat_kohanim_varady/3"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">27</tei:hi> Thus they shall link My name with the people of Israel, and I will bless them.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
