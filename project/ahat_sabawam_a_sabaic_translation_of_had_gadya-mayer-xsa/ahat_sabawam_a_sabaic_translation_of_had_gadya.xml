  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ahat_sabawam_a_sabaic_translation_of_had_gadya">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahat_sabawam_a_sabaic_translation_of_had_gadya/1"/>
        <tei:lg>
          <tei:l>ʾḥt sbw-m ʾḥt sbw-m</tei:l>
          <tei:l>ḏt-šʾm ʾb-y b-nṣf-n</tei:l>
          <tei:l>ʾḥt sbw-m ʾḥt sbw-m</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahat_sabawam_a_sabaic_translation_of_had_gadya/2"/>
        <tei:lg>
          <tei:l>w-wṣḥ *dmm-m<tei:anchor xml:id="note_1"/></tei:l>
          <tei:l>w-ʾkl sbw-n</tei:l>
          <tei:l>ḏt-šʾm ʾb-y b-nṣf-n</tei:l>
          <tei:l>ʾḥt sbw-m ʾḥt sbw-m</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahat_sabawam_a_sabaic_translation_of_had_gadya/3"/>
        <tei:lg>
          <tei:l>w-wṣḥ klb-m</tei:l>
          <tei:l>w-nṯk *dmm-n</tei:l>
          <tei:l>ḏ-ʾkl sbw-n</tei:l>
          <tei:l>ḏt-šʾm ʾb-y b-nṣf-n</tei:l>
          <tei:l>ʾḥt sbw-m ʾḥt sbw-m</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahat_sabawam_a_sabaic_translation_of_had_gadya/4"/>
        <tei:lg>
          <tei:l>w-wṣḥ qḍb-m</tei:l>
          <tei:l>w-ḍrb klb-n</tei:l>
          <tei:l>ḏ-nṯk *dmm-n-n</tei:l>
          <tei:l>ḏ-ʾkl sbw-n</tei:l>
          <tei:l>ḏt-šʾm ʾb-y b-nṣf-n</tei:l>
          <tei:l>ʾḥt sbw-m ʾḥt sbw-m</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahat_sabawam_a_sabaic_translation_of_had_gadya/5"/>
        <tei:lg>
          <tei:l>w-wṣḥ ḫmṭn-m</tei:l>
          <tei:l>w-hnr qḍb-n</tei:l>
          <tei:l>ḏ-ḍrb klb-n</tei:l>
          <tei:l>ḏ-nṯk *dmm-n</tei:l>
          <tei:l>ḏ-ʾkl sbw-n</tei:l>
          <tei:l>ḏt-šʾm ʾb-y b-nṣf-n</tei:l>
          <tei:l>ʾḥt sbw-m ʾḥt sbw-m</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahat_sabawam_a_sabaic_translation_of_had_gadya/6"/>
        <tei:lg>
          <tei:l>w-wṣḥ mw-m</tei:l>
          <tei:l>w-fsṭ ḫmṭn-n</tei:l>
          <tei:l>ḏ-hnr qḍb-n</tei:l>
          <tei:l>ḏ-ḍrb klb-n</tei:l>
          <tei:l>ḏ-nṯk *dmm-n</tei:l>
          <tei:l>ḏ-ʾkl sbw-n</tei:l>
          <tei:l>ḏt-šʾm ʾb-y b-nṣf-n</tei:l>
          <tei:l>ʾḥt sbw-m ʾḥt sbw-m</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahat_sabawam_a_sabaic_translation_of_had_gadya/7"/>
        <tei:lg>
          <tei:l>w-wṣḥ ṯwr-m</tei:l>
          <tei:l>w-sqy mw-n</tei:l>
          <tei:l>ḏ-fsṭ ḫmṭn-n-n</tei:l>
          <tei:l>ḏ-hnr qḍb-n</tei:l>
          <tei:l>ḏ-ḍrb klb-n</tei:l>
          <tei:l>ḏ-nṯk *dmm-n</tei:l>
          <tei:l>ḏ-ʾkl sbw-n</tei:l>
          <tei:l>ḏt-šʾm ʾb-y b-nṣf-n</tei:l>
          <tei:l>ʾḥt sbw-m ʾḥt sbw-m</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahat_sabawam_a_sabaic_translation_of_had_gadya/8"/>
        <tei:lg>
          <tei:l>w-wṣḥ ḏbḥ-m</tei:l>
          <tei:l>w-ḏbḥ ṯwr-n</tei:l>
          <tei:l>ḏ-sqy mw-n</tei:l>
          <tei:l>ḏ-fsṭ ḫmṭn-n</tei:l>
          <tei:l>ḏ-hnr qḍb-n</tei:l>
          <tei:l>ḏ-ḍrb klb-n</tei:l>
          <tei:l>ḏ-nṯk *dmm-n</tei:l>
          <tei:l>ḏ-ʾkl sbw-n</tei:l>
          <tei:l>ḏt-šʾm ʾb-y b-nṣf-n</tei:l>
          <tei:l>ʾḥt sbw-m ʾḥt sbw-m</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahat_sabawam_a_sabaic_translation_of_had_gadya/9"/>
        <tei:lg>
          <tei:l>w-wṣḥ mlʾk mwt-n</tei:l>
          <tei:l>w-ḏbḥ ḏbḥ-n</tei:l>
          <tei:l>ḏ-ḏbḥ ṯwr-n</tei:l>
          <tei:l>ḏ-sqy mw-n</tei:l>
          <tei:l>ḏ-fsṭ ḫmṭn-n</tei:l>
          <tei:l>ḏ-hnr qḍb-n</tei:l>
          <tei:l>ḏ-ḍrb klb-n</tei:l>
          <tei:l>ḏ-nṯk *dmm-n</tei:l>
          <tei:l>ḏ-ʾkl sbw-n</tei:l>
          <tei:l>ḏt-šʾm ʾb-y b-nṣf-n</tei:l>
          <tei:l>ʾḥt sbw-m ʾḥt sbw-m</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahat_sabawam_a_sabaic_translation_of_had_gadya/10"/>
        <tei:lg>
          <tei:l>w-wṣḥ rḥmn-n brk w-tbrk sm-hw</tei:l>
          <tei:l>w-ḏbḥ mlʾk mwt-n</tei:l>
          <tei:l>ḏ-ḏbḥ ḏbḥ-n</tei:l>
          <tei:l>ḏ-ḏbḥ ṯwr-n</tei:l>
          <tei:l>ḏ-sqy mw-n</tei:l>
          <tei:l>ḏ-fsṭ ḫmṭn-n</tei:l>
          <tei:l>ḏ-hnr qḍb-n</tei:l>
          <tei:l>ḏ-ḍrb klb-n</tei:l>
          <tei:l>ḏ-nṯk *dmm-n</tei:l>
          <tei:l>ḏ-ʾkl sbw-n</tei:l>
          <tei:l>ḏt-šʾm ʾb-y b-nṣf-n</tei:l>
          <tei:l>ʾḥt sbw-m ʾḥt sbw-m</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" n="1" target="#note_1">
      <tei:p>This word, *dmm-, is marked with an asterisk because it’s the only word in the text not attested in Sabaic texts. It is reconstructed based on the Semitic root *dimm-, also found in Ge’ez and Amharic ድመት dəmmät and Yemenite Arabic دِمّ dimm. This root is thought to be a Lockwort, i.e. a term used originally to attract an animal. For an English example of a Lockwort see “pussycat,” from “pspsps.”</tei:p>
    </tei:note>
  </tei:standOff>
