    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:hamavdil_bein_kippur_lefurim_davidson">
        <tei:head>הַמַּבְדִּיל בֵּין־כִּפּוּר לְפוּרִים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hamavdil_bein_kippur_lefurim_davidson/1"/>
        <tei:lg>
          <tei:l>הַמַּבְדִּיל בֵּין־כִּפּוּר לְפוּרִים</tei:l>
          <tei:l>שֶׁשּׂוֹנֵא אֶת־הַנְּזִירִים</tei:l>
          <tei:l>וְאוֹהֵב אֶת־הַשִּׁכּוֹרִים</tei:l>
          <tei:l>הַצּוֹעֲקִים בַּלָּֽיְלָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hamavdil_bein_kippur_lefurim_davidson/2"/>
        <tei:lg>
          <tei:l>יַֽׄיִן אָדֹם אָהַֽבְתִּי</tei:l>
          <tei:l>וְגַם עִם־לָבָן גַּֽרְתִּי</tei:l>
          <tei:l>וְשׁוֹתֶה מַֽיִם שָׂנֵֽאתִי</tei:l>
          <tei:l>כָּאֲפֵלָה וּכְאִשּׁוֹן לָֽיְלָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hamavdil_bein_kippur_lefurim_davidson/3"/>
        <tei:lg>
          <tei:l>צְׄעָקָה וּדְמָעוֹת אוֹרִֽידָה<tei:anchor xml:id="note_3"/></tei:l>
          <tei:l>בִּרְאוֹתִי מַֽיִם בִּסְעוּדָה</tei:l>
          <tei:l>הָבִֽיאוּ לִי עֶשְׂרִים מִדָּה</tei:l>
          <tei:l>אוּלַי יַסְפִּיקוּן לִי הַלָּֽיְלָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hamavdil_bein_kippur_lefurim_davidson/4"/>
        <tei:lg>
          <tei:l>חֵׄן וָחֶֽסֶד יֻתַּן לָרָעִים<tei:anchor xml:id="note_4"/></tei:l>
          <tei:l>אִם־תּוֹסִֽיפוּ יַֽיִן בַּגְּבִיעִים</tei:l>
          <tei:l>עִם־כּוֹסוֹת שֵׁכָר מְלֵאִים</tei:l>
          <tei:l>אוּלַי נִשְׁכְּרָה זֶה הַלָּֽיְלָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hamavdil_bein_kippur_lefurim_davidson/5"/>
        <tei:lg>
          <tei:l>קְׄדֻשָּׁה אֲלַמֶּדְכֶם</tei:l>
          <tei:l>חֲכָמִים הַטּוּ אׇזְנְכֶם</tei:l>
          <tei:l>בַּעֲרוּ מַֽיִם מִבָּתֵּיכֶם</tei:l>
          <tei:l>כִּי הֵם חֲשׁוּבִים כַּלָּֽיְלָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hamavdil_bein_kippur_lefurim_davidson/6"/>
        <tei:lg>
          <tei:l>חִׄזְׄקׄוּ נְבוֹנִים וַחֲכָמִים</tei:l>
          <tei:l>בִּזְכוּת נֹחַ אִישׁ תָּמִים</tei:l>
          <tei:l>אֲשֶׁר נָטַע כְּרָמִים</tei:l>
          <tei:l>לְשִׁכְרוּת בַּיּוֹם וּבַלָּיְלָה׃׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
