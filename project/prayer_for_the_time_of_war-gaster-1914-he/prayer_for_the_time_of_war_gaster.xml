    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_the_time_of_war_gaster">
        <tei:head>תפלה על מלחמה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_time_of_war_gaster/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">[תפלה ”לעת מצוה“‏ <tei:bibl>(תהלים ו:לב)</tei:bibl>]</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_time_of_war_gaster/2"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">אשר יאמר אתה החזן בליל כפור.</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_time_of_war_gaster/3"/>
        <tei:lg>
          <tei:l>אֱלֹהֵֽינוּ וֵאֱלֹהֵי אֲבוֹתֵינוּ׃</tei:l>
          <tei:l>הַשְׁקִיפָה מִמְּעוֹן קָדְשֶׁךָ</tei:l>
          <tei:l>וּרְאֵה כִּי בְּצָרָה גְדוֹלָה אֲנַחְנוּ׃</tei:l>
          <tei:l>קוֹל שָׁאוֹן מֵעִיר</tei:l>
          <tei:l>קוֹל תְּרוּעַת מִלְחָמָה</tei:l>
          <tei:l>שׁוֹד וָשֶֽׁבֶר וְאֶנְקַת חָלָל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_time_of_war_gaster/4"/>
        <tei:lg>
          <tei:l>שְׁמַע קוֹלֵֽינוּ</tei:l>
          <tei:l>חוּם וְרַחֵם עָלֵֽינוּ׃</tei:l>
          <tei:l>כִּי לֹא עַל צִדְקֹתֵֽינוּ אֲנַחְנוּ מַפִּילִים תַּֽחַנוּנֵֽנוּ לְפָנֶֽךָ</tei:l>
          <tei:l>כִּי עַל רַחֲמֶֽיךָ הָרַבִּים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_time_of_war_gaster/5"/>
        <tei:lg>
          <tei:l>הַקְשִׁיבָה וַעֲשֵׂה</tei:l>
          <tei:l>אַל תְּאַחַר׃</tei:l>
          <tei:l>רִיבָה רִיבֵֽנוּ</tei:l>
          <tei:l>לְחַם אֶת לוֹחֲמֵֽינוּ׃</tei:l>
          <tei:l>אַבֵּד כׇּל הַקָּמִים עָלֵֽינוּ לְרָעָה׃</tei:l>
          <tei:l>הָפֵר עֲצָתָם</tei:l>
          <tei:l>וְקַֽלְקֵל מַחְשְׁבוֹתָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_time_of_war_gaster/6"/>
        <tei:lg>
          <tei:l>וּכְגוֹדֶל חַסְדְךָ הוֹתֵר</tei:l>
          <tei:l>בְּנֵי תְמוּתָה׃</tei:l>
          <tei:l>צַו יְשׁוּעָתֵֽינוּ בְּמַפְגִיעַ</tei:l>
          <tei:l>וְתַשְׁקִיט הָאָרֶץ מִן הַמִלְחָמָה׃</tei:l>
          <tei:l>שְׁלַח רְפוּאָה לְחוֹלִים</tei:l>
          <tei:l>וְנִיחוּם לָאֲבֵלִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_time_of_war_gaster/7"/>
        <tei:lg>
          <tei:l>תֵּן לָנוּ מִבִּרְכוֹתֶֽךָ׃</tei:l>
          <tei:l>הַצְמַח לָנוּ יְשׁוּעָה בְקָרוֹב׃</tei:l>
          <tei:l>תֵּן בְּלִבֵּנוּ אַהֲבָה וְאַחְוָה</tei:l>
          <tei:l>וְשָׁלוֹם וְרֵיעוּת׃</tei:l>
          <tei:l>יַחֵד לְבָבֵֽנוּ לְאַהֲבָה</tei:l>
          <tei:l>וּלְיִרְאָה אוֹתְךָ׃</tei:l>
          <tei:l>וְכֵן יְהִי רָצוֹן</tei:l>
          <tei:l>וְנֹאמַר אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_time_of_war_gaster/8"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ואחר כן יאמר השכבה על הנופלים במלחמה׃</tei:note>
          </tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
