  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:blessings_at_your_dawn_of_wakefulness_berakhot_sheasani/1">
        <tei:head>Blessings at your Dawn of Wakefulness: Berakhot she'Asani (blessings that made me) — translated by Rabbi Zalman Schachter-Shalomi</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessings_at_your_dawn_of_wakefulness_berakhot_sheasani/1/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">Blessings She’asani (that made me)</tei:note>
            <tei:anchor xml:id="note_1"/>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessings_at_your_dawn_of_wakefulness_berakhot_sheasani/1/2"/>
        <tei:lg>
          <tei:l>Barukh attah Yah</tei:l>
          <tei:l>I offer You thanks,</tei:l>
          <tei:l>Cosmic Majesty</tei:l>
          <tei:l>And worship You,</tei:l>
          <tei:l>For shaping my life</tei:l>
          <tei:l>in Your image.<tei:anchor xml:id="note_2"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessings_at_your_dawn_of_wakefulness_berakhot_sheasani/1/3"/>
        <tei:lg>
          <tei:l>Barukh attah Yah</tei:l>
          <tei:l>I offer You thanks,</tei:l>
          <tei:l>Cosmic Majesty</tei:l>
          <tei:l>And worship You,</tei:l>
          <tei:l>For giving me options.<tei:anchor xml:id="note_3"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessings_at_your_dawn_of_wakefulness_berakhot_sheasani/1/4"/>
        <tei:lg>
          <tei:l>Barukh attah Yah</tei:l>
          <tei:l>I offer You thanks,</tei:l>
          <tei:l>Cosmic Majesty</tei:l>
          <tei:l>And worship You,</tei:l>
          <tei:l>For giving me the privilege</tei:l>
          <tei:l>To worship You, as a Jew.<tei:anchor xml:id="note_4"/></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" n="1" target="#note_1">
      <tei:p>Cf. Rebbe Yehudah’s statement in Tosefta Berakhot 6.23 and Rebbe Meir’s statement in Menachot.43b.17</tei:p>
    </tei:note>
    <tei:note type="commentary" n="2" target="#note_2">
      <tei:p>Sabbath and festival prayer book, United Synagogue of America 1946, Cf. Genesis 1:27</tei:p>
    </tei:note>
    <tei:note type="commentary" n="3" target="#note_3">
      <tei:p>Rabbi Yaakov ben Asher, Arba Turim, circa early 14th century. Abu Dirham notes this formulation was new in his time.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="4" target="#note_4">
      <tei:p>Sabbath and festival prayer book, United Synagogue of America 1946, Cf. Genesis 32:29</tei:p>
    </tei:note>
  </tei:standOff>
