    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yishtabbach_shimkha">
        <tei:head>יִשְׁתַּבַּח שִׁמְךָ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yishtabbach_shimkha/1"/>
        <tei:lg>
          <tei:l>יִשְׁתַּבַּח שִׁמְךָ</tei:l>
          <tei:l>לָעַד מַלְכֵּנוּ.</tei:l>
          <tei:l>הָאֵל הַמֶּלֶךְ הַגָּדוֹל</tei:l>
          <tei:l>וְהַקָּדוֹשׁ בַּשָּׁמַיִם וּבָאָרֶץ.</tei:l>
          <tei:l>כִּי לְךָ</tei:l>
          <tei:l>נָאֶה יְהֹוָה</tei:l>
          <tei:l>אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yishtabbach_shimkha/2"/>
        <tei:lg>
          <tei:l>שִׁיר וּשְׁבָחָה.</tei:l>
          <tei:l>הַלֵּל וְזִמְרָה.</tei:l>
          <tei:l>עוֹז וּמֶמְשָׁלָה.</tei:l>
          <tei:l>נֶצַח גְּדֻלָּה וּגְבוּרָה.</tei:l>
          <tei:l>תְּהִלָּה וְתִפְאֶרֶת.</tei:l>
          <tei:l>קְדֻשָּׁה וּמַלְכוּת:</tei:l>
          <tei:l>בְּרָכוֹת</tei:l>
          <tei:l>וְהוֹדָאוֹת</tei:l>
          <tei:l>לְשִׁמְךָ הַגָּדוֹל וְהַקָּדוֹשׁ.</tei:l>
          <tei:l>וּמֵעוֹלָם וְעַד עוֹלָם אַתָּה אֵל:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yishtabbach_shimkha/3"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה.</tei:l>
          <tei:l>אֵל מֶלֶךְ גָּדוֹל</tei:l>
          <tei:l>וּמְהֻלָּל</tei:l>
          <tei:l>בַּתִּשְׁבָּחוֹת.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yishtabbach_shimkha/4"/>
        <tei:lg>
          <tei:l>אֵל הַהוֹדָאוֹת.</tei:l>
          <tei:l>אֲדוֹן הַנִּפְלָאוֹת.</tei:l>
          <tei:l>בּוֹרֵא כָּל הַנְּשָׁמוֹת.</tei:l>
          <tei:l>רִבּוֹן כָּל הַמַּעֲשִׂים.</tei:l>
          <tei:l>הַבּוֹחֵר בְּשִׁירֵי זִמְרָה.</tei:l>
          <tei:l>מֶלֶךְ יָחִיד</tei:l>
          <tei:l>אֵל חֵי</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>הָעוֹלָמִים:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yishtabbach_shimkha/5"/>
        <tei:lg>
          <tei:l>אָמֵן</tei:l>
        </tei:lg>
      </tei:div>
