  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:public_repetition_of_the_shacharit_amidah_on_confirmation_landsberg">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:public_repetition_of_the_shacharit_amidah_on_confirmation_landsberg/4"/>
        <tei:lg>
          <tei:l>קָדוֹשׁ קָדוֹשׁ קָדוֹשׁ יְהֹוָה צְבָאוֹת</tei:l>
          <tei:l>מְלֹא כׇל־הָאָרֶץ כְּבוֹדוֹ׃ <tei:bibl>(ישעיה ו:ג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:public_repetition_of_the_shacharit_amidah_on_confirmation_landsberg/5"/>
        <tei:lg>
          <tei:l>בָּרוּךְ כְּבוֹד־יְהֹוָה</tei:l>
          <tei:l>מִמְּקוֹמוֹ׃ <tei:bibl>(יחזקאל ג:יב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:public_repetition_of_the_shacharit_amidah_on_confirmation_landsberg/6"/>
        <tei:lg>
          <tei:l>יִמְלֹךְ יְהֹוָה לְעוֹלָם אֱלֹהַיִךְ צִיּוֹן</tei:l>
          <tei:l>לְדֹר וָדֹר</tei:l>
          <tei:l>הַלְלוּ־יָהּ׃ <tei:bibl>(תהלים קמו:י)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:public_repetition_of_the_shacharit_amidah_on_confirmation_landsberg/15"/>
        <tei:lg>
          <tei:l>יְבָרֶכְךָ יְיָ וְישְמְרֶֽךָ׃ <tei:bibl>(במדבר ו:כד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:public_repetition_of_the_shacharit_amidah_on_confirmation_landsberg/16"/>
        <tei:lg>
          <tei:l>יָאֵר יְיָ פָּנָיו אֵלֶיךָ</tei:l>
          <tei:l>וִיחֻנֶֽךָּ׃ <tei:bibl>(במדבר ו:כה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:public_repetition_of_the_shacharit_amidah_on_confirmation_landsberg/17"/>
        <tei:lg>
          <tei:l>יִשָׂא יְיָ פָּנָיו אֵלֶֽיךָ</tei:l>
          <tei:l>וְיָשֵׂם לְךָ שָׁלוֹם׃ <tei:bibl>(במדבר ו:כו)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
