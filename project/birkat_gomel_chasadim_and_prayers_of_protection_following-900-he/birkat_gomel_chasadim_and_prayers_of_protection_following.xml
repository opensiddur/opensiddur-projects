    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:birkat_gomel_chasadim_and_prayers_of_protection_following">
        <tei:head>בִּרְכַּת גּוֹמֵל חֲסָדִים טוֹבִים לְעַמּוֹ יִשְׂרָאֵל</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_gomel_chasadim_and_prayers_of_protection_following/1"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵנוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם</tei:l>
          <tei:l>הַמַּעֲבִיר חֶבְלֵי שֵׁנָה מֵעֵינָי</tei:l>
          <tei:l>וּתְנוּמָה מֵעַפְעַפָּי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_gomel_chasadim_and_prayers_of_protection_following/2"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן מִלְּפָנֶיךָ</tei:l>
          <tei:l>יְיָ אֱלֹהַי וֵאלֹהֵי אֲבוֹתַי</tei:l>
          <tei:l>שֶׁתַּרְגִּילֵנִי לִדְבַר מִצְוָה</tei:l>
          <tei:l>וְאַל תַּרְגִּילֵנִי לִדְבַר עֲבֵרָה וְעָוֺן</tei:l>
          <tei:l>וְהַשְׁלֵט בִּי יֵצֶר טוֹב</tei:l>
          <tei:l>וְאַל תַּשְׁלֵט בִּי יֵצֶר רָע</tei:l>
          <tei:l>וְחַזְּקֵנִי בְּמִצְוֺתֶיךָ</tei:l>
          <tei:l>וְתֵן חֶלְקִי בְּתוֹרָתֶךָ</tei:l>
          <tei:l>וְאַל תְּבִיאֵנִי לִידֵי חֵטְא</tei:l>
          <tei:l>וְלֹא לִידֵי נִסָּיוֹן</tei:l>
          <tei:l>וְלֹא לִידֵי בִזָּיֹן</tei:l>
          <tei:l>וְכוֹף אֶת יִצְרִי לְהִשְׁתַּעְבֵּד לָךְ</tei:l>
          <tei:l>וְהַכְנַע עָרְפִּי לָשׁוּב אֵלֶיךָ</tei:l>
          <tei:l>וְחַדֵּשׁ כִּלְיוֹתַי לִשְׁמוֹר פִּקּוּדֶיךָ</tei:l>
          <tei:l>וּמוֹל אֶת לְבָבִי וְאֶת לְבַב זַרְעִי</tei:l>
          <tei:l>לְאַהֲבָה וּלְיִרְאָה אֶת שְׁמֶךָ</tei:l>
          <tei:l>וְלַעֲשׂוֹת הַטּוֹב וְהַיָּשָׁר בְּעֵינֶיךָ</tei:l>
          <tei:l>וְקָֽרְבֵנִי לְכׇל מַה שֶּׁאָהַבְתָּ</tei:l>
          <tei:l>וְרַחֲקֵנִי מִכׇּל מַה שֶּׁשָּׂנֵאתָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_gomel_chasadim_and_prayers_of_protection_following/3"/>
        <tei:lg>
          <tei:l>וְקַיֵם עָלַי</tei:l>
          <tei:l>וְעַל זַרְעִי וְעַל זֶרע זַרְעִי</tei:l>
          <tei:l>מִקְרָא שְֶכָּתוּב</tei:l>
          <tei:l>וּמָל יְיָ אֶלֹהֶיךָ אֶת לְבָֽבְךָ</tei:l>
          <tei:l>וְאֶת לְבַב זַרְעֶךָ</tei:l>
          <tei:l>לְאַהֲבָה אֶת יְיָ אֱלֹהֶיךָ</tei:l>
          <tei:l>בְּכׇל לְבָֽבְךָ</tei:l>
          <tei:l>וּבְכׇל נַפְשְׁךָ</tei:l>
          <tei:l>לְמַעַן חַיֶּיךָ׃ <tei:bibl>(דברים ל:ו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_gomel_chasadim_and_prayers_of_protection_following/4"/>
        <tei:lg>
          <tei:l>וַאֲנִי זֹאת בְּרִיתִי אוֹתָם</tei:l>
          <tei:l>אָמַר יְיָ רוּחִי אֲשֶׁר עָלֶיךָ וּדְבָרַי</tei:l>
          <tei:l>אֲשֶׁר שַׂמְתִּי בְּפִיךָ</tei:l>
          <tei:l>לֹא יָמוּשׁוּ מִפִּיךָ</tei:l>
          <tei:l>וּמִפִּי זַרְעֲךָ</tei:l>
          <tei:l>וּמִפִּי זֶרַע זַרְעֲךָ</tei:l>
          <tei:l>אָמַר יְיָ מֵעַתָּה וְעַד עוֹלָם: <tei:bibl>(ישעיה נט:כא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_gomel_chasadim_and_prayers_of_protection_following/5"/>
        <tei:lg>
          <tei:l>וְנוֹדַע בַּגּוֹיִם זַרְעָם</tei:l>
          <tei:l>וְצֶאֱצָאֵיהֶם בְּתוֹךְ הָעַמִּים</tei:l>
          <tei:l>כׇּל רֹאֵיהֶם יַכִּירוּם</tei:l>
          <tei:l>כִּי הֵם זֶרַע</tei:l>
          <tei:l>בֵּרַךְ יְיָ׃ <tei:bibl>(ישעיה סא:ט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_gomel_chasadim_and_prayers_of_protection_following/6"/>
        <tei:lg>
          <tei:l>לֹא יִגְעוּ לָרִיק</tei:l>
          <tei:l>וְלֹא יֵלְדוּ לַבֶּהָלָה</tei:l>
          <tei:l>כִּי זֶרַע בְּרוּכֵי יְיָ הֵמָּה</tei:l>
          <tei:l>וְצֶאֱצָאֵיהֶם אִתָּם׃</tei:l>
          <tei:l>וְהָיָה טֶרֶם יִקְרָאוּ וַאֲנִי אֶעֱנֶה</tei:l>
          <tei:l>עוֹד הֵם מְדַבְּרִים</tei:l>
          <tei:l>וַאֲנִי אֶשְׁמָע׃ <tei:bibl>(ישעיה סה:כג-כד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_gomel_chasadim_and_prayers_of_protection_following/7"/>
        <tei:lg>
          <tei:l>כִּי אֶצָּק־מַיִם עַל צָמֵא</tei:l>
          <tei:l>וְנוֹזְלִים עַל יַבָּשָׁה</tei:l>
          <tei:l>אֶצֹּק רוּחִי עַל זַרְעֶךָ</tei:l>
          <tei:l>וּבִרְכָתִי עַל צֶאֱצָאֶיךָ׃</tei:l>
          <tei:l>וְצָֽמְחוּ בְּבֵין חָצִיר</tei:l>
          <tei:l>כַּעֲרִבִים עַל יִבְלֵי מָיִם׃</tei:l>
          <tei:l>זֶה יֹאמַר לַיְיָ אָנִי</tei:l>
          <tei:l>וְזֶה יִקְרָא בְשֵׁם יַעֲקֹב</tei:l>
          <tei:l>וְזֶה יִכְתֹּב יָדוֹ לַיְיָ</tei:l>
          <tei:l>וּבְשֵׁם יִשְׂרָאֵל יְכַנֶּה׃ <tei:bibl>(ישעיה מד:ג-ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_gomel_chasadim_and_prayers_of_protection_following/8"/>
        <tei:lg>
          <tei:l>וַיְהִי כַחוֹל זַרְעֶךָ</tei:l>
          <tei:l>וְצֶאֱצָאֵי מֵאֶיךָ</tei:l>
          <tei:l>כִּמְעוֹתָיו</tei:l>
          <tei:l>לֹא יִכָּרֵת</tei:l>
          <tei:l>וְלֹא יִשָּׁמֵד</tei:l>
          <tei:l>שְׁמוֹ מִלְפָנָי׃ <tei:bibl>(ישעיה מח:יט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_gomel_chasadim_and_prayers_of_protection_following/9"/>
        <tei:lg>
          <tei:l>וְתִהְיֶה לִי לְמִשְׂגָּב וּמִבְטָח וּמִגְדַּל עוֹז</tei:l>
          <tei:l>וּבֵית מְצוּדוֹת לְהוֹשִׁיעֵנִי וּלְהַצִּיל נַפְשִׁי מִשַּׁחַת</tei:l>
          <tei:l>וּמִכׇּל צָרָה</tei:l>
          <tei:l>וּתְנֵנִי הַיוֹם וּבְכׇל יוֹם</tei:l>
          <tei:l>לְחֵן וּלְחֶסֶד וּלְרַחֲמִים בְּעֵינֶיךָ</tei:l>
          <tei:l>וּבְעֵינֵי כׇּל רוֹאַי</tei:l>
          <tei:l>וְגָמְלֵנִי חַסָדִים טוֹבִים׃</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>גּוֹמֵל חֲסָדִים טוֹבִים</tei:l>
          <tei:l>לְעַמּוֹ יִשְׂרָאֵל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_gomel_chasadim_and_prayers_of_protection_following/10"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן מִלְּפָנֶיךָ</tei:l>
          <tei:l>יְיָ אֱלֹהַי אֲבוֹתַי</tei:l>
          <tei:l>שֶׁתַּצִּילֵנִי הַיּוֹם וּבְכׇל יוֹם</tei:l>
          <tei:l>מֵעַזֵּי פָנִים וּמֵעַזּוּת פָּנִים</tei:l>
          <tei:l>וּמִיֵּצֶר הָרָע</tei:l>
          <tei:l>וּמֵאָדָם רָע</tei:l>
          <tei:l>וּמִשָּׁכֵן רָע</tei:l>
          <tei:l>וּמִלָּשׁוֹן הָרָע</tei:l>
          <tei:l>וּמִשָּׂטָן הַמַּשְׁחִית</tei:l>
          <tei:l>וּמִדִּין קָשֶׁה</tei:l>
          <tei:l>וּמִבַּעַל דִּין קָשֶׁה</tei:l>
          <tei:l>בֵּין שֶׁהוּא בֶן בְּרִית</tei:l>
          <tei:l>וּבֵין שֶׁאֵינוֹ בֶן בְּרִית</tei:l>
          <tei:l>וּמִדִּינָהּ שֶׁל גֵיהִנָּם׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
