  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_of_the_ten_plagues">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_of_the_ten_plagues/1"/>
        <tei:lg>
          <tei:l>סַאנְגְוֵי</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>לְ אַקְוַה סִי קוֹנְוֵירְטֵי אִין סַאנְגְוֵי</tei:l>
          <tei:l>טוּטוֹ מִצְרָיִם סוֹסְפִּירַה אֵי לַאנְגְוֵי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_of_the_ten_plagues/2"/>
        <tei:lg>
          <tei:l>רַאנוֹקְיֵי</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>פֵּיר לַה גְרַאן קְוַאנְטִיטַה דֵי רַאנֵי</tei:l>
          <tei:l>נוֹן סִי דוֹרְמֵי נֵי אִינְפַּסְטַה נֵי קוֹצֶי אִיל פַּנֵי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_of_the_ten_plagues/3"/>
        <tei:lg>
          <tei:l>פֵּידוֹקְיִי</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>גְרַאנְדֵי אֶירַה לַה קְוַנְטִיטַה דֵי פֶּידוֹקְיִי</tei:l>
          <tei:l>גְרוֹסִי קוֹמֵי גְרָאנִי דֵי פִּינוֹקְיִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_of_the_ten_plagues/4"/>
        <tei:lg>
          <tei:l>מֵיסְקוּלְייוֹ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>לוּפִּי אוֹרְסִי טִיגְרִי אֵי לֵיאוֹנִי</tei:l>
          <tei:l>אֵירַאנוֹ אִין מִצְרַיִם אִין טוּטִי אִי קַאנְטוֹנִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_of_the_ten_plagues/5"/>
        <tei:lg>
          <tei:l>פֵּיסְטֵי</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בֵּיסְטִיאַמִי דֵי אוֹנְיִי סוֹרְטֵי</tei:l>
          <tei:l>פּוֹקִי סְקַאמְפַּאנוֹ דַה לַה מוֹרְטֶי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_of_the_ten_plagues/6"/>
        <tei:lg>
          <tei:l>פִֿיסְטוֹלַה</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>מֹשֶׁה סְפַּארְסֵי קַאלִיגִינֵי דִינַאנְצִי פַארַאוֹנֵי</tei:l>
          <tei:l>קַאסְקוֹ סוֹפְּרַה מִצְרִיִּים אֵי פֵיצֵי בּוֹנְיוֹנִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_of_the_ten_plagues/7"/>
        <tei:lg>
          <tei:l>טֵימְפֵּיסְטַה</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>טֵימְפֵּיסְטַה אַקוֹמְפַּאנְיַאטַה קוֹן פוֹקוֹ</tei:l>
          <tei:l>קוּנְסוּמַאוַה מִצְרִיִּים אִוֹן אוֹנְיִי לוֹקוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_of_the_ten_plagues/8"/>
        <tei:lg>
          <tei:l>גְרִילוֹ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>אוּנַה גְרַאן קְוַאנְטִיטַה דֵי קַאוַאלֵיטֵי</tei:l>
          <tei:l>קֵי דֵיווֹרַאוַה לַה וֵירדוּרַה דֵי לֵי אַרְבּוֹרִי אֵי לֶי אֵירְבֶּיטֶי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_of_the_ten_plagues/9"/>
        <tei:lg>
          <tei:l>סְקוּרִיטוֹ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>טְרֵי גְייוֹרְנִי דֵי טֵינֵיבְּרַה אֵי סְקוּרוֹרֵי</tei:l>
          <tei:l>אַוֵיאַנוֹ לִי מִצְרִיִּים אֵי יִשְׂרָאלֵ סְפְּלֶינְדוֹרֵי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_of_the_ten_plagues/10"/>
        <tei:lg>
          <tei:l>פֵּירְקוֹסַה דֵי פְּרִימִי גֵיינִיטִי׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>פִּיאַנְטִי סֹסְפִּירִי אֵי גֶיימִיטִי</tei:l>
          <tei:l>סִי סִינְטיוַה פֶּיר לַה מוֹרְטֶי דֶי פְּרִימִי גֵיינִיטִי׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
