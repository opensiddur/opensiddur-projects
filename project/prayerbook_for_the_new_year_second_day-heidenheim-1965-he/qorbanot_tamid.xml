  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:qorbanot/tamid" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n39.jpg">
        <tei:pb ed="1965" n="9" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n39.jpg"/>
        <tei:p><tei:milestone unit="chapter" n="28"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/28/1" n="1"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n39.jpg" n="9"/>וַיְדַבֵּ֥ר <j:divineName>יְהֹוָ֖ה</j:divineName> אֶל־מֹשֶׁ֥ה לֵּאמֹֽר: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/28/2" n="2"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n39.jpg" n="9"/>צַ֚ו אֶת־בְּנֵ֣י יִשְׂרָאֵ֔ל וְאָמַרְתָּ֖ אֲלֵהֶ֑ם אֶת־קָרְבָּנִ֨י לַחְמִ֜י לְאִשַּׁ֗י רֵ֚יחַ נִֽיחֹחִ֔י תִּשְׁמְר֕וּ לְהַקְרִ֥יב לִ֖י בְּמוֹעֲדֽוֹ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/28/3" n="3"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n39.jpg" n="9"/>וְאָמַרְתָּ֣ לָהֶ֔ם זֶ֚ה הָֽאִשֶּׁ֔ה אֲשֶׁ֥ר תַּקְרִ֖יבוּ לַֽ<j:divineName>יהֹוָ֑ה</j:divineName> כְּבָשִׂ֨ים בְּנֵֽי־שָׁנָ֧ה תְמִימִ֛ם שְׁנַ֥יִם לַיּ֖וֹם עֹלָ֥ה תָמִֽיד: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/28/4" n="4"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n39.jpg" n="9"/>אֶת־הַכֶּ֥בֶשׂ אֶחָ֖ד <tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n40.jpg" n="10"/>תַּֽעֲשֶׂ֣ה בַבֹּ֑קֶר וְאֵת֙ הַכֶּ֣בֶשׂ הַשֵּׁנִ֔י תַּֽעֲשֶׂ֖ה בֵּ֥ין הָֽעַרְבָּֽיִם: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/28/5" n="5"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n40.jpg" n="10"/>וַֽעֲשִׂירִ֧ית הָֽאֵיפָ֛ה סֹ֖לֶת לְמִנְחָ֑ה בְּלוּלָ֛ה בְּשֶׁ֥מֶן כָּתִ֖ית רְבִיעִ֥ת הַהִֽין: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/28/6" n="6"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n40.jpg" n="10"/>עֹלַ֖ת תָּמִ֑יד הָֽעֲשֻׂיָה֙ בְּהַ֣ר סִינַ֔י לְרֵ֣יחַ נִיחֹ֔חַ אִשֶּׁ֖ה לַֽ<j:divineName>יהוָֽה</j:divineName>: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/28/7" n="7"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n40.jpg" n="10"/>וְנִסְכּוֹ֙ רְבִיעִ֣ת הַהִ֔ין לַכֶּ֖בֶשׂ הָֽאֶחָ֑ד בַּקֹּ֗דֶשׁ הַסֵּ֛ךְ נֶ֥סֶךְ שֵׁכָ֖ר לַֽ<j:divineName>יהוָֽה</j:divineName>: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/28/8" n="8"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n40.jpg" n="10"/>וְאֵת֙ הַכֶּ֣בֶשׂ הַשֵּׁנִ֔י תַּֽעֲשֶׂ֖ה בֵּ֣ין הָֽעַרְבָּ֑יִם כְּמִנְחַ֨ת הַבֹּ֤קֶר וּכְנִסְכּוֹ֙ תַּעֲשֶׂ֔ה אִשֵּׁ֛ה רֵ֥יחַ נִיחֹ֖חַ לַֽ<j:divineName>יהוָֽה</j:divineName>: <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
