  <tei:text>
    <tei:body>
      <tei:div facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n53.jpg">
        <tei:pb ed="1965" n="19" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n53.jpg"/>
        <tei:p><tei:milestone unit="chapter" n="91" corresp="urn:x-opensiddur:text:bible:psalms/91"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/1" n="1"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n53.jpg" n="19"/>יֹשֵׁב בְּסֵֽתֶר עֶלְיוֹן בְּצֵל שַׁדַּי יִתְלוֹנָן: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/2" n="2"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n53.jpg" n="19"/>אֹמַר לַ<j:divineName>יהֹוָה</j:divineName> <tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n55.jpg" n="20"/>מַחְסִּי וּמְצוּדָתִי אֱלֹהַי אֶבְטַח־בּוֹ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/3" n="3"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n55.jpg" n="20"/>כִּי הוּא יַצִּילְךָ מִפַּח יָקוּשׁ מִדֶּֽבֶר הַוּוֹת: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/4" n="4"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n55.jpg" n="20"/>בְּאֶבְרָתוֹ יָֽסֶךְ לָךְ וְתַֽחַת כְּנָפָיו תֶּחְסֶּה צִנָּה וְסֹחֵרָה אֲמִתּוֹ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/5" n="5"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n55.jpg" n="20"/>לֹא־תִירָא מִפַּֽחַד לָֽיְלָה מֵחֵץ יָעוּף יוֹמָם: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/6" n="6"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n55.jpg" n="20"/>מִדֶּֽבֶר בָּאֹֽפֶל יַהֲלֹךְ מִקֶּֽטֶב יָשׁוּד צָהֳרָֽיִם: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/7" n="7"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n55.jpg" n="20"/>יִפֹּל מִצִּדְּךָ אֶֽלֶף וּרְבָבָה מִימִינֶֽךָ אֵלֶֽיךָ לֹא יִגָּשׁ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/8" n="8"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n55.jpg" n="20"/>רַק בְּעֵינֶֽיךָ תַבִּיט וְשִׁלֻּמַת רְשָׁעִים תִּרְאֶה: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/9" n="9"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n55.jpg" n="20"/>כִּי־אַתָּה <j:divineName>יְהֹוָה</j:divineName> מַחְסִּי עֶלְיוֹן שַֽׂמְתָּ מְעוֹנֶֽךָ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/10" n="10"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n55.jpg" n="20"/>לֹא־תְאֻנֶּה אֵלֶֽיךָ רָעָה וְנֶֽגַע לֹא־יִקְרַב בְּאָהֳלֶֽךָ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/11" n="11"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n55.jpg" n="20"/>כִּי מַלְאָכָיו יְצַוֶּה־לָּךְ לִשְׁמָרְךָ בְּכָל־דְּרָכֶֽיךָ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/12" n="12"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n55.jpg" n="20"/>עַל־כַּפַּֽיִם יִשָּׂאֽוּנְךָ פֶּן־תִּגֹּף בָּאֶֽבֶן רַגְלֶֽךָ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/13" n="13"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n55.jpg" n="20"/>עַל־שַֽׁחַל וָפֶֽתֶן תִּדְרֹךְ תִּרְמֹס כְּפִיר וְתַנִּין: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/14" n="14"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n55.jpg" n="20"/>כִּי בִי חָשַׁק וַאֲפַלְּטֵֽהוּ אֲשַׂגְּבֵֽהוּ כִּי־יָדַע שְׁמִי: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/15" n="15"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n55.jpg" n="20"/>יִקְרָאֵֽנִי וְאֶעֱנֵֽהוּ עִמּוֹ אָנֹכִי בְצָרָה אֲחַלְּצֵֽהוּ וַאֲכַבְּדֵֽהוּ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/16" n="16"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n55.jpg" n="20"/>אֹֽרֶךְ יָמִים אַשְׂבִּיעֵֽהוּ וְאַרְאֵֽהוּ בִּישׁוּעָתִי: <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
