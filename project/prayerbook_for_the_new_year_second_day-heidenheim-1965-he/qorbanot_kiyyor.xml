  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:qorbanot/kiyyor" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n39.jpg">
        <tei:pb ed="1965" n="9" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n39.jpg"/>
        <tei:p><tei:milestone unit="chapter" n="30"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/30/17" n="17"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n39.jpg" n="9"/>וַיְדַבֵּר <j:divineName>יְהֹוָה</j:divineName> אֶל־מֹשֶׁה לֵּאמֹר: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/30/18" n="18"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n39.jpg" n="9"/>וְעָשִׂיתָ כִּיּוֹר נְחֹֽשֶׁת וְכַנּוֹ נְחֹֽשֶׁת לְרָחְצָה וְנָתַתָּ אֹתוֹ בֵּין־אֹֽהֶל מוֹעֵד וּבֵין הַמִּזְבֵּֽחַ וְנָתַתָּ שָֽׁמָּה מָיִם: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/30/19" n="19"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n39.jpg" n="9"/>וְרָחֲצוּ אַהֲרֹן וּבָנָיו מִמֶּֽנּוּ אֶת־יְדֵיהֶם וְאֶת־רַגְלֵיהֶם: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/30/20" n="20"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n39.jpg" n="9"/>בְּבֹאָם אֶל־אֹֽהֶל מוֹעֵד יִרְחֲצוּ־מַיִם וְלֹא יָמֻֽתוּ אוֹ בְגִשְׁתָּם אֶל־הַמִּזְבֵּֽחַ לְשָׁרֵת לְהַקְטִיר אִשֶּׁה לַ<j:divineName>יהֹוָה</j:divineName>: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/30/21" n="21"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n39.jpg" n="9"/>וְרָחֲצוּ יְדֵיהֶם וְרַגְלֵיהֶם וְלֹא יָמֻֽתוּ וְהָיְתָה לָהֶם חָק־עוֹלָם לוֹ וּלְזַרְעוֹ לְדֹרֹתָם: <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
