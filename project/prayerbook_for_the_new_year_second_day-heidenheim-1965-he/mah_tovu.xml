        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:mah_tovu/mah_tovu"/><tei:milestone unit="chapter" n="24"/><tei:milestone unit="verse" n="5" corresp="urn:x-opensiddur:text:bible:numbers/24/5"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/24/5"><tei:choice><j:option corresp="urn:x-opensiddur:condition:prayer:mah_tovu/second_day_night_printing"><tei:pb ed="1965" n="1" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n4_medium.jpg"/>
        מַה־טֹּֽבוּ אֹהָלֶֽיךָ יַעֲקֹב מִשְׁכְּנֹתֶֽיךָ יִשְׂרָאֵל:</j:option><j:option corresp="urn:x-opensiddur:condition:prayer:mah_tovu/second_day_morning_printing"><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n25.jpg" n="2"/>מַה־טֹּֽבוּ אֹהָלֶֽיךָ יַעֲקֹב מִשְׁכְּנֹתֶֽיךָ יִשְׂרָאֵל:</j:option></tei:choice></tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:mah_tovu/varani"/><tei:milestone unit="chapter" n="5" corresp="urn:x-opensiddur:text:prayer:mah_tovu/varani/quotation/psalms/5" source="urn:x-opensiddur:text:bible:psalms/5/8"/><tei:milestone unit="verse" n="8" corresp="urn:x-opensiddur:text:prayer:mah_tovu/varani/quotation/psalms/5/8" source="urn:x-opensiddur:text:bible:psalms/5/8"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/5/8"><tei:choice><j:option corresp="urn:x-opensiddur:condition:prayer:mah_tovu/second_day_night_printing"><tei:pb ed="1965" n="1" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n4_medium.jpg"/>
        וַאֲנִי בְּרֹב חַסְדְּךָ אָבֹא בֵיתֶךָ אֶשְׁתַּחֲוֶה אֶל־הֵיכַל קָדְשְׁךָ בְּיִרְאָתֶֽךָ:</j:option><j:option corresp="urn:x-opensiddur:condition:prayer:mah_tovu/second_day_morning_printing"><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n25.jpg" n="2"/>וַאֲנִי בְּרֹב חַסְדְּךָ אָבֹא בֵיתֶֽךָ אֶשְׁתַּחֲוֶה אֶל־הֵיכַל קָדְשְׁךָ בְּיִרְאָתֶֽךָ:</j:option></tei:choice></tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="chapter" n="26"/><tei:milestone unit="verse" n="8" corresp="urn:x-opensiddur:text:bible:psalms/26/8"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/26/8"><tei:choice><j:option corresp="urn:x-opensiddur:condition:prayer:mah_tovu/second_day_night_printing"><tei:pb ed="1965" n="1" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n4_medium.jpg"/>
        <j:divineName>יְיָ</j:divineName> אָהַֽבְתִּי מְעוֹן בֵּיתֶךָ וּמְקוֹם מִשְׁכַּן כְּבוֹדֶךָ:</j:option><j:option corresp="urn:x-opensiddur:condition:prayer:mah_tovu/second_day_morning_printing"><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n25.jpg" n="2"/><j:divineName>יְיָ</j:divineName> אָהַֽבְתִּי מְעוֹן בֵּיתֶֽךָ וּמְקוֹם מִשְׁכַּן כְּבוֹדֶֽךָ:</j:option></tei:choice></tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="chapter" n="95" corresp="urn:x-opensiddur:text:prayer:mah_tovu/varani/quotation/psalms/95" source="urn:x-opensiddur:text:bible:psalms/95/6"/><tei:milestone unit="verse" n="6" corresp="urn:x-opensiddur:text:prayer:mah_tovu/varani/quotation/psalms/95/6" source="urn:x-opensiddur:text:bible:psalms/95/6"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/95/6" type="adaptation"><tei:choice><j:option corresp="urn:x-opensiddur:condition:prayer:mah_tovu/second_day_night_printing"><tei:pb ed="1965" n="1" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n4_medium.jpg"/>
        וַאֲנִי אֶשְׁתַּחֲוֶה וְאֶכְרָֽעָה אֶבְרְכָה לִפְנֵי <j:divineName>יְיָ</j:divineName> עֹשִׂי:</j:option><j:option corresp="urn:x-opensiddur:condition:prayer:mah_tovu/second_day_morning_printing"><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n25.jpg" n="2"/>וַאֲנִי אֶשְׁתַּחֲוֶה וְאֶכְרָֽעָה אֶבְרְכָה לִפְנֵי־<j:divineName>יְיָ</j:divineName> עֹשִׂי:</j:option></tei:choice></tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="chapter" n="69"/><tei:milestone unit="verse" n="14" corresp="urn:x-opensiddur:text:bible:psalms/69/14"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/69/14"><tei:choice><j:option corresp="urn:x-opensiddur:condition:prayer:mah_tovu/second_day_night_printing"><tei:pb ed="1965" n="1" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n4_medium.jpg"/>
        וַאֲנִי תְפִלָּתִי לְךָ <j:divineName>יְיָ</j:divineName> עֵת רָצוֹן אֱלֹהִים בְּרָב־חַסְדֶּךָ עֲנֵנִי בֶּאֱמֶת יִשְׁעֶךָ:</j:option><j:option corresp="urn:x-opensiddur:condition:prayer:mah_tovu/second_day_morning_printing"><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n25.jpg" n="2"/>וַאֲנִי תְפִלָּתִי־לְךָ <j:divineName>יְיָ</j:divineName> עֵת רָצוֹן אֱלֹהִים בְּרָב־חַסְדֶּֽךָ עֲנֵֽנִי בֶּאֱמֶת יִשְׁעֶֽךָ:</j:option></tei:choice></tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
