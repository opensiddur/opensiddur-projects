  <tei:text>
    <tei:body>
      <tei:div facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n61.jpg">
        <tei:pb ed="1965" n="23" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n61.jpg"/>
        <tei:p><tei:milestone unit="chapter" n="92" corresp="urn:x-opensiddur:text:bible:psalms/92"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/1" n="1"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n61.jpg" n="23"/>מִזְמוֹר שִׁיר לְיוֹם הַשַּׁבָּת: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/2" n="2"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n61.jpg" n="23"/>טוֹב לְהֹדוֹת לַ<j:divineName>יהֹוָה</j:divineName> וּלְזַמֵּר לְשִׁמְךָ עֶלְיוֹן: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/3" n="3"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n61.jpg" n="23"/>לְהַגִּיד בַּבֹּֽקֶר חַסְדֶּֽךָ וֶאֱמוּנָתְךָ בַּלֵּילוֹת: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/4" n="4"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n61.jpg" n="23"/>עֲלֵי עָשׂוֹר וַעֲלֵי־נָֽבֶל עֲלֵי הִגָּיוֹן בְּכִנּוֹר: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/5" n="5"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n61.jpg" n="23"/>כִּי שִׂמַּחְתַּֽנִי <j:divineName>יְהֹוָה</j:divineName> בְּפָעֳלֶֽךָ בְּמַעֲשֵׂי יָדֶֽיךָ אֲרַנֵּן: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/6" n="6"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n61.jpg" n="23"/>מַה־גָּדְלוּ מַעֲשֶֽׂיךָ <j:divineName>יְהֹוָה</j:divineName> מְאֹד עָמְקוּ מַחְשְׁבֹתֶֽיךָ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/7" n="7"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n61.jpg" n="23"/>אִישׁ בַּֽעַר לֹא יֵדָע וּכְסִיל לֹא־יָבִין אֶת־זֹאת: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/8" n="8"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n61.jpg" n="23"/>בִּפְֽרֹחַ רְשָׁעִים כְּמוֹ־עֵֽשֶׂב וַיָּצִֽיצוּ כָּל־פֹּֽעֲלֵי אָֽוֶן לְהִשָּׁמְדָם עֲדֵי־עַד: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/9" n="9"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n61.jpg" n="23"/>וְאַתָּה מָרוֹם לְעֹלָם <j:divineName>יְהֹוָה</j:divineName>: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/10" n="10"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n61.jpg" n="23"/>כִּי הִנֵּה אֹיְבֶֽיךָ <j:divineName>יְהֹוָה</j:divineName> כִּי־הִנֵּה אֹיְבֶֽיךָ יֹאבֵֽדוּ יִתְפָּרְדוּ כָּל־פֹּֽעֲלֵי אָֽוֶן: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/11" n="11"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n61.jpg" n="23"/>וַתָּֽרֶם כִּרְאֵים קַרְנִי בַּלֹּתִי בְּשֶֽׁמֶן רַעֲנָן: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/12" n="12"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n61.jpg" n="23"/>וַתַּבֵּט עֵינִי בְּשׁוּרָי בַּקָּמִים עָלַי מְרֵעִים תִּשְׁמַֽעְנָה אָזְנָי: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/13" n="13"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n61.jpg" n="23"/>צַדִּיק כַּתָּמָר יִפְרָח כְּאֶֽרֶז בַּלְּבָנוֹן יִשְׂגֶּה: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/14" n="14"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n61.jpg" n="23"/>שְׁתוּלִים בְּבֵית <j:divineName>יְהֹוָה</j:divineName> בְּחַצְרוֹת אֱלֹהֵֽינוּ יַפְרִֽיחוּ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/15" n="15"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n61.jpg" n="23"/>עוֹד יְנוּבוּן בְּשֵׂיבָה דְּשֵׁנִים וְרַעֲנַנִּים יִהְיוּ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/16" n="16"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n61.jpg" n="23"/>לְהַגִּיד כִּי־יָשָׁר <j:divineName>יְהֹוָה</j:divineName> צוּרִי וְלֹא־עַוְלָֽתָה בּוֹ: <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
