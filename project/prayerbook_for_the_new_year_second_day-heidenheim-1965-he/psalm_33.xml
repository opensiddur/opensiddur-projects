  <tei:text>
    <tei:body>
      <tei:div facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n59.jpg">
        <tei:pb ed="1965" n="22" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n59.jpg"/>
        <tei:p><tei:milestone unit="chapter" n="33" corresp="urn:x-opensiddur:text:bible:psalms/33"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/1" n="1"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n59.jpg" n="22"/>רַנֲנוּ צַדִּיקִים בַּ<j:divineName>יהֹוָה</j:divineName> לַיְשָׁרִים נָאוָה תְהִלָּה: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/2" n="2"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n59.jpg" n="22"/>הוֹדוּ לַ<j:divineName>יהֹוָה</j:divineName> בְּכִנּוֹר בְּנֵֽבֶל עָשׂוֹר זַמְּרוּ־לוֹ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/3" n="3"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n59.jpg" n="22"/>שִֽׁירוּ לוֹ שִׁיר חָדָשׁ הֵיטִֽיבוּ נַגֵּן בִּתְרוּעָה: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/4" n="4"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n59.jpg" n="22"/>כִּי־יָשָׁר דְּבַר־<j:divineName>יְהֹוָה</j:divineName> וְכָל־מַעֲשֵֽׂהוּ בֶּאֱמוּנָה: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/5" n="5"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n59.jpg" n="22"/>אֹהֵב צְדָקָה וּמִשְׁפָּט חֶֽסֶד <j:divineName>יְהֹוָה</j:divineName> מָלְאָה הָאָֽרֶץ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/6" n="6"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n59.jpg" n="22"/>בִּדְבַר <j:divineName>יְהֹוָה</j:divineName> שָׁמַֽיִם נַעֲשׂוּ וּבְֽרוּחַ פִּיו כָּל־צְבָאָם: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/7" n="7"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n59.jpg" n="22"/>כֹּנֵס כַּנֵּד מֵי הַיָּם נֹתֵן בְּאוֹצָרוֹת תְּהוֹמוֹת: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/8" n="8"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n59.jpg" n="22"/>יִירְאוּ מֵ<j:divineName>יְהֹוָה</j:divineName> כָּל־הָאָֽרֶץ מִמֶּֽנּוּ יָֽגוּרוּ כָּל־יֹשְׁבֵי תֵבֵל: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/9" n="9"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n59.jpg" n="22"/>כִּי הוּא אָמַר וַיֶּֽהִי הוּא צִוָּה וַיַּעֲמֹד: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/10" n="10"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n59.jpg" n="22"/><j:divineName>יְהֹוָה</j:divineName> הֵפִיר עֲצַת גּוֹיִם הֵנִיא מַחְשְׁבוֹת עַמִּים: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/11" n="11"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n59.jpg" n="22"/>עֲצַת <j:divineName>יְהֹוָה</j:divineName> לְעוֹלָם תַּעֲמֹד מַחְשְׁבוֹת לִבּוֹ לְדֹר וָדֹר: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/12" n="12"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n59.jpg" n="22"/>אַשְׁרֵי הַגּוֹי אֲשֶׁר־<j:divineName>יְהֹוָה</j:divineName> אֱלֹהָיו הָעָם בָּחַר לְנַחֲלָה לוֹ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/13" n="13"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n59.jpg" n="22"/>מִשָּׁמַֽיִם הִבִּיט <j:divineName>יְהֹוָה</j:divineName> רָאָה אֶת־כָּל־בְּנֵי הָאָדָם: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/14" n="14"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n59.jpg" n="22"/>מִמְּכוֹן־שִׁבְתּוֹ הִשְׁגִּֽיחַ אֶל כָּל־יֹשְׁבֵי הָאָֽרֶץ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/15" n="15"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n59.jpg" n="22"/>הַיֹּצֵר יַֽחַד לִבָּם הַמֵּבִין אֶל־כָּל־מַעֲשֵׂיהֶם: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/16" n="16"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n59.jpg" n="22"/>אֵין הַמֶּֽלֶךְ נוֹשָׁע בְּרָב־חָֽיִל גִּבּוֹר לֹא־יִנָּצֵל בְּרָב־כֹּֽחַ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/17" n="17"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n59.jpg" n="22"/>שֶֽׁקֶר הַסּוּס לִתְשׁוּעָה וּבְרֹב <tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n61.jpg" n="23"/>חֵילוֹ לֹא יְמַלֵּט: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/18" n="18"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n61.jpg" n="23"/>הִנֵּה עֵין <j:divineName>יְהֹוָה</j:divineName> אֶל־יְרֵאָיו לַמְיַחֲלִים לְחַסְדּוֹ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/19" n="19"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n61.jpg" n="23"/>לְהַצִּיל מִמָּֽוֶת נַפְשָׁם וּלְחַיּוֹתָם בָּרָעָב: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/20" n="20"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n61.jpg" n="23"/>נַפְשֵֽׁנוּ חִכְּתָה לַ<j:divineName>יהֹוָה</j:divineName> עֶזְרֵֽנוּ וּמָגִנֵּֽנוּ הוּא: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/21" n="21"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n61.jpg" n="23"/>כִּי־בוֹ יִשְׂמַח לִבֵּֽנוּ כִּי בְשֵׁם קָדְשׁוֹ בָטָֽחְנוּ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/22" n="22"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n61.jpg" n="23"/>יְהִי־חַסְדְּךָ <j:divineName>יְהֹוָה</j:divineName> עָלֵֽינוּ כַּאֲשֶׁר יִחַֽלְנוּ לָךְ: <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
