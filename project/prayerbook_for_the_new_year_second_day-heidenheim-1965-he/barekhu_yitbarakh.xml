    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:barekhu/yitbarakh">
        <tei:pb ed="1965" n="2" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n5_medium.jpg"/>
        <tei:p>יִתְבָּרַךְ וְיִשְׁתַּבַּח וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְנַשֵּׂא שְׁמוֹ שֶׁל מֶלֶךְ מַלְכֵי הַמְּלָכִים הַקָּדוֹשׁ בָּרוּךְ הוּא שֶׁהוּא רִאשׁוֹן וְהוּא אַחֲרוֹן וּמִבַּלְעָדָיו אֵין אֱלֹהִים סֹלּוּ לָרֹכֵב בָּעֲרָבוֹת בְּיָהּ שְׁמוֹ וְעִלְזוּ לְפָנָיו. וּשְׁמוֹ מְרוֹמָם עַל־כָּל־בְּרָכָה וּתְהִלָּה:</tei:p>
        <tei:p>בָּרוּךְ שֵׁם כְּבוֹד מַלְכוּתוֹ לְעוֹלָם וָעֶד:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
