    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:tallith/mah_yaqar" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n24.jpg">
        <tei:pb ed="1965" n="1" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n24.jpg"/>
        <tei:lg>
          <tei:l><tei:milestone unit="chapter" n="36"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/36/8" n="8"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n24.jpg" n="1"/>מַה־יָּקָר חַסְדְּךָ אֱלֹהִים וּבְנֵי אָדָם בְּצֵל כְּנָפֶֽיךָ יֶחֱסָיוּן: </tei:l>
          <tei:l><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/36/9" n="9"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n24.jpg" n="1"/>יִרְוְיֻן מִדֶּֽשֶׁן בֵּיתֶֽךָ וְנַחַל עֲדָנֶֽיךָ תַשְׁקֵם: </tei:l>
          <tei:l><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/36/10" n="10"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n24.jpg" n="1"/>כִּי עִמְּךָ מְקוֹר חַיִּים, בְּאוֹרְךָ נִרְאֶה־אוֹר: </tei:l>
          <tei:l><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/36/11" n="11"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n24.jpg" n="1"/>מְשֹׁךְ חַסְדְּךָ לְיֹדְעֶֽיךָ וְצִדְקָתְךָ לְיִשְׁרֵי־לֵב: <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
