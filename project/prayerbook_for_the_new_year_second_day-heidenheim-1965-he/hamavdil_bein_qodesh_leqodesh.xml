    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hamavdil_bein_qodesh_leqodesh">
        <tei:pb ed="1965" n="10" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n21_medium.jpg"/>
        <tei:p>בָּרוּךְ אַתָּה <j:divineName>יְיָ</j:divineName> אֱלֹהֵֽינוּ מֶֽלֶךְ הָעוֹלָם הַמַּבְדִּיל בֵּין קֹֽדֶשׁ לְחוֹל בֵּין אוֹר לְחֹֽשֶׁךְ בֵּין יִשְׂרָאֵל לָעַמִּים בֵּין יוֹם הַשְּׁבִיעִי לְשֵֽׁשֶׁת יְמֵי הַמַּעֲשֶׂה. בֵּין קְדֻשַּׁת שַׁבָּת לִקְדֻשַּׁת יוֹם טוֹב הִבְדַּֽלְתָּ וְאֶת־יוֹם הַשְּׁבִיעִי מִשֵּֽׁשֶׁת יְמֵי הַמַּעֲשֶׂה קִדַּֽשְׁתָּ. הִבְדַּֽלְתָּ וְקִדַּֽשְׁתָּ אֶת־עַמְּךָ יִשְׂרָאֵל בִּקְדֻשָּׁתֶֽךָ. בָּרוּךְ אַתָּה <j:divineName>יְיָ</j:divineName> הַמַּבְדִּיל בֵּין קֹֽדֶשׁ לְקֹֽדֶשׁ:</tei:p>
      </tei:div>
    </tei:body>
