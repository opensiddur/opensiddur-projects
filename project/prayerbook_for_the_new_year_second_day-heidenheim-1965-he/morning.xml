          <j:transclude type="external" target="urn:x-opensiddur:text:siddur:rosh_hashanah/day_two/morning_occurrences/morning_entrance_verses@prayerbook_for_the_new_year_second_day-heidenheim-1965-he"/>
          <j:transclude type="external" target="urn:x-opensiddur:text:siddur:rosh_hashanah/day_two/morning_occurrences/morning_mah_tovu@prayerbook_for_the_new_year_second_day-heidenheim-1965-he"/>
