  <tei:text>
    <tei:body>
      <tei:div>
        <tei:pb ed="1965" n="3" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n7_medium.jpg"/>
        <tei:p><tei:milestone unit="chapter" n="15"/><tei:milestone unit="verse" n="37" corresp="urn:x-opensiddur:text:bible:numbers/15/37"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/15/37" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n7_medium.jpg">וַיֹּ֥אמֶר <j:divineName>יְהֹוָ֖ה</j:divineName> אֶל־מֹשֶׁ֥ה לֵּאמֹֽר:</tei:seg> <tei:milestone unit="verse" n="38" corresp="urn:x-opensiddur:text:bible:numbers/15/38"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/15/38" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n7_medium.jpg">דַּבֵּ֞ר אֶל־בְּנֵ֤י יִשְׂרָאֵל֙ וְאָֽמַרְתָּ֣ אֲלֵהֶ֔ם וְעָשׂ֨וּ לָהֶ֥ם צִיצִ֛ת עַל־כַּנְפֵ֥י בִגְדֵיהֶ֖ם לְדֹֽרֹתָ֑ם וְנָֽתְנ֛וּ עַל־צִיצִ֥ת הַכָּנָ֖ף פְּתִ֥יל תְּכֵֽלֶת:</tei:seg> <tei:milestone unit="verse" n="39" corresp="urn:x-opensiddur:text:bible:numbers/15/39"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/15/39" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n7_medium.jpg">וְהָיָ֣ה לָכֶם֮ לְצִיצִת֒ וּרְאִיתֶ֣ם אֹת֗וֹ וּזְכַרְתֶּם֙ אֶת־כָּל־מִצְוֹ֣ת <j:divineName>יְהֹוָ֔ה</j:divineName> וַעֲשִׂיתֶ֖ם אֹתָ֑ם<tei:pb ed="1965" n="4" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n9_medium.jpg"/> וְלֹא תָת֜וּרוּ אַֽחֲרֵ֤י לְבַבְכֶם֙ וְאַֽחֲרֵ֣י עֵֽינֵיכֶ֔ם אֲשֶׁר־אַתֶּ֥ם זֹנִ֖ים אַֽחֲרֵיהֶֽם:</tei:seg> <tei:milestone unit="verse" n="40" corresp="urn:x-opensiddur:text:bible:numbers/15/40"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/15/40" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n9_medium.jpg">לְמַ֣עַן תִּזְכְּר֔וּ וַֽעֲשִׂיתֶ֖ם אֶת־כָּל־מִצְוֹתָ֑י וִֽהְיִיתֶ֥ם קְדֹשִׁ֖ים לֵאלֹהֵיכֶֽם:</tei:seg> <tei:milestone unit="verse" n="41" corresp="urn:x-opensiddur:text:bible:numbers/15/41"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/15/41" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n9_medium.jpg">אֲנִ֞י <j:divineName>יְהֹוָ֣ה</j:divineName> אֱלֹהֵיכֶ֗ם אֲשֶׁ֨ר הוֹצֵ֤אתִי אֶתְכֶם֙ מֵאֶ֣רֶץ מִצְרַ֔יִם לִהְי֥וֹת לָכֶ֖ם לֵֽאלֹהִ֑ים אֲנִ֖י <j:divineName>יְהֹוָ֥ה</j:divineName> אֱלֹהֵיכֶֽם:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
