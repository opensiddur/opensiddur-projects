      <tei:div corresp="urn:x-opensiddur:text:prayer:maariv_aravim">
        <tei:pb ed="1965" n="2" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n5_medium.jpg"/>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:maariv_aravim/opening"/>בָּרוּךְ אַתָּה <j:divineName>יְיָ</j:divineName> אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם אֲשֶׁר בִּדְבָרוֹ מַעֲרִיב עֲרָבִים בְּחָכְמָה פּוֹתֵחַ שְׁעָרִים וּבִתְבוּנָה מְשַׁנֶּה עִתִּים וּמַחֲלִיף אֶת־הַזְּמַנִּים וּמְסַדֵּר אֶת־הַכּוֹכָבִים בְּמִשְׁמְרוֹתֵיהֶם בָּרָקִיעַ כִּרְצוֹנוֹ בּוֹרֵא יוֹם וָלָיְלָה גּוֹלֵל אוֹר מִפְּנֵי־חֹשֶׁךְ וְחֹשֶׁךְ מִפְּנֵי־אוֹר. וּמַעֲבִיר יוֹם וּמֵבִיא לָיְלָה וּמַבְדִּיל בֵּין יוֹם וּבֵין לָיְלָה <j:divineName>יְיָ</j:divineName> צְבָאוֹת שְׁמוֹ. אֵל חַי וְקַיָּם תָּמִיד יִמְלוֹךְ עָלֵינוּ לְעוֹלָם וָעֶד. <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:maariv_aravim/seal"/>בָּרוּךְ אַתָּה <j:divineName>יְיָ</j:divineName> הַמַּעֲרִיב עֲרָבִים:<tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
