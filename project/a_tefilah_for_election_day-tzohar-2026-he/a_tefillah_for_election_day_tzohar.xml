    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_tefillah_for_election_day_tzohar">
        <tei:head>תְּפִלָּה לְיוֹם הַבְּחִירוּת</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_tefillah_for_election_day_tzohar/1"/>
        <tei:lg>
          <tei:l>מוֹדֶה אַנִי לְפָנֶיךָ</tei:l>
          <tei:l>צוּר יִשְׂרָאֵל וְגוֹאֲלוֹ,</tei:l>
          <tei:l>עַל הַחֶסֶד שֶׁעָשִׂיתָ עִמָּדִי</tei:l>
          <tei:l>שֶׁאֲנִי חַי בְּדוֹד</tei:l>
          <tei:l>שֶׁל תְּקוּמַת יִשְׂרָאֵל בְּאַרְצוֹ,</tei:l>
          <tei:l>וְעַל הַזְּכוּת וְהַחוֹבָה</tei:l>
          <tei:l>שֶׁנָּפְלוּ בְּחֶלְקִי</tei:l>
          <tei:l>לִבְחֹר לִכְנֶסֶת יִשְׂרָאֵל.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_tefillah_for_election_day_tzohar/2"/>
        <tei:lg>
          <tei:l>הֲרֵינִי מַצְבִּיעַ מִתוֹךְ תְּחוּשַׁת שֻׁתָּפוּת,</tei:l>
          <tei:l>אַחְרָיוּת,</tei:l>
          <tei:l>דְּאָגָה</tei:l>
          <tei:l>וְשַׁיָּכוּת לַחֶבְרָה הַיִּשְׂרְאֵלִית,</tei:l>
          <tei:l>וּמִתּוֹךְ אֵמוּן בַּמְּדִינָה</tei:l>
          <tei:l>וְרָצוֹן בְּטוֹבָתָהּ</tei:l>
          <tei:l>וּבְטוֹבַת אֶזְרָחֶיהָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_tefillah_for_election_day_tzohar/3"/>
        <tei:lg>
          <tei:l>מִתְחַיֵּב אֲנִי לְקַבֵּל אֶת הַכְרָעַת הָעָם,</tei:l>
          <tei:l>וּמִתְפַּלֵּל שֶׁנֵּדַע כֻּלָּנוּ</tei:l>
          <tei:l>לְכַבֵּד וּלְהַעֲרִיךְ</tei:l>
          <tei:l>גַּם אֶת מִי שֶׁחוֹשֵׁב וּמַצְבִּיעַ אַחֶרֶת.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_tefillah_for_election_day_tzohar/4"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן מִלְּפָנֶיךָ</tei:l>
          <tei:l>ה׳ אֱלֹהַי וֵאלֹהֵי אֲבוֹתַי,</tei:l>
          <tei:l>שֶׁתִּתֵּן בְּלֵב הַנִּבְחָרִים כֻּלָּם אֶת הַנְּחִישׁוּת</tei:l>
          <tei:l>לִפְעֹל לְמַעַן</tei:l>
          <tei:l>בִּטְחוֹנָהּ וְשִׁגְשׂוּגָהּ</tei:l>
          <tei:l>שֶׁל מְדִינַת יִשְׂרָאֵל,</tei:l>
          <tei:l>וְאֶת הַכֹּחַ וְהַתְּבוּנָה</tei:l>
          <tei:l>לַחֲלֹק זֶה עַל זֶה בְּכָבוֹד</tei:l>
          <tei:l>וְלִשְׁמֹר עַל הָאַחְדוּת בֵּינֵינוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_tefillah_for_election_day_tzohar/5"/>
        <tei:lg>
          <tei:l>חַזֵּק אֶת נִבְחֲרֵי הַצִּבּוּר</tei:l>
          <tei:l>וְאֶת כׇּל הָעוֹסְקִים בְּצָרְכֵי צִבּוּר</tei:l>
          <tei:l>לִפְעֹל</tei:l>
          <tei:l>בְּעִנְיָנִיּוּת,</tei:l>
          <tei:l>בִּנְקִיּוּת</tei:l>
          <tei:l>וּבִשְׁקִיפוּת.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_tefillah_for_election_day_tzohar/6"/>
        <tei:lg>
          <tei:l>שְׁלַח בְּרָכָה וְהַצְלָחָה בְּכׇל מַעֲשֵׂה יְדֵיהֶם,</tei:l>
          <tei:l>וְיִתְקַיֵּם בָּנוּ מִקְרָא שֶׁכָּתוּב:</tei:l>
          <tei:l>”וִישַׁבְתֶּם לָבֶטַח בְּאַרְצְכֶם.</tei:l>
          <tei:l>וְנָתַתִּי שָׁלוֹם בָּאָרֶץ</tei:l>
          <tei:l>וּשְׁכַבְתֶּם ואֵין מַחֲרִיד“ <tei:bibl>(ויקרא כו:ה-ו)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
