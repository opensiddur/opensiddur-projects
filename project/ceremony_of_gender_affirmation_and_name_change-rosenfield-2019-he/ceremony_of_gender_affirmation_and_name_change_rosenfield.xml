  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:ceremony_of_gender_affirmation_and_name_change_rosenfield">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ceremony_of_gender_affirmation_and_name_change_rosenfield/1"/>
        <tei:lg>
          <tei:l>פתיחה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ceremony_of_gender_affirmation_and_name_change_rosenfield/6"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>ה׳ אֱ-לֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם</tei:l>
          <tei:l>הַמַּעֲבִיר לְעֹבְרִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ceremony_of_gender_affirmation_and_name_change_rosenfield/12"/>
        <tei:lg>
          <tei:l>בְּרוּכַה אַתְּ</tei:l>
          <tei:l>יָהּ הַשְּׁכִינָה</tei:l>
          <tei:l>רוּחַ הָעוֹלָם,</tei:l>
          <tei:l>שֶׁעָשַֽׂנִי כִּרְצוֹנָהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ceremony_of_gender_affirmation_and_name_change_rosenfield/18"/>
        <tei:lg>
          <tei:l>בְּרוּכַה אַתְּ</tei:l>
          <tei:l>יָהּ הַשְּׁכִינָה</tei:l>
          <tei:l>רוּחַ הָעוֹלָם,</tei:l>
          <tei:l>שֶׁעָשַֽׂנִי בְּצָלְמָהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ceremony_of_gender_affirmation_and_name_change_rosenfield/20"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>ה׳ אֱ-לֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם</tei:l>
          <tei:l>בּוֹרֵא פְּרִי הַגֶּפֶן (הַגָּפֶן)׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ceremony_of_gender_affirmation_and_name_change_rosenfield/26"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>ה׳ אֱ-לֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם</tei:l>
          <tei:l>שֶׁהֶחֱיָנוּ</tei:l>
          <tei:l>וְקִיְמָנוּ</tei:l>
          <tei:l>וְהִגִּיעָנוּ לַזְּמַן הַזֶּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ceremony_of_gender_affirmation_and_name_change_rosenfield/28"/>
        <tei:lg>
          <tei:l>יְשִׂימֵךְ אֱלֹהִים כְּשָׂרָה רִבְקָה רָחֵל וְלֵאָה</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>יְבָרְכֵךְ ה׳ וְיִשְׁמְרֵךְ.</tei:l>
          <tei:l>יָאֵר ה׳ פָּנָיו אֵלַיִךְ וְיִחָנֵּךְ.</tei:l>
          <tei:l>יִשָּׂא ה׳ פָּנָיו אֵלַיִךְ וְיָשֵׂם לָךְ שָׁלוֹם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ceremony_of_gender_affirmation_and_name_change_rosenfield/29"/>
        <tei:lg>
          <tei:l>יְשִׂימְךָ אֱלֹהִים כְּאֶפְרַיִם וְכִמְנַשֶּׁה</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>יְבָרֶכְךָ ה׳ וְיִשְׁמְרֶךָ.</tei:l>
          <tei:l>יָאֵר ה׳ פָּנָיו אֵלֶיךָ וִיחֻנֶּךָּ.</tei:l>
          <tei:l>יִשָּׂא ה׳ פָּנָיו אֵלֶיךָ וְיָשֵׂם לְךָ שָׁלוֹם׃ <tei:bibl>(דברים ו:כד-כו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ceremony_of_gender_affirmation_and_name_change_rosenfield/30"/>
        <tei:lg>
          <tei:l>יְשִׂימְךֶ אֱלֹהִים כְּאָדַם וְשָׂרַי וְיוֹסֵף</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>יְבָרֶכְךֶ וְיִשְׁמְרֶךֶ</tei:l>
          <tei:l>יָאֵר ה׳ פָּנָיו אֵלֶיךֶ וִיחֻנֶּךֶּ</tei:l>
          <tei:l>יִשָּׂא ה׳ פָּנָיו אֵלֶיךֶ וְיָשֵׂם לְךֶ שָׁלוֹם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ceremony_of_gender_affirmation_and_name_change_rosenfield/31"/>
        <tei:lg>
          <tei:l>מַזָּל טוֹב!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ceremony_of_gender_affirmation_and_name_change_rosenfield/32"/>
        <tei:lg>
          <tei:l>סִימָן טוֹב וּמַזָּל טוֹב.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
