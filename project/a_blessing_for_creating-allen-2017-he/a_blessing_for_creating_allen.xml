  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_blessing_for_creating_allen">
        <tei:head>ברכת יוצר יצירים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_blessing_for_creating_allen/1"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>ה׳ מָקוֹר הַחַיִּים</tei:l>
          <tei:l>שֶׁבָּרָא אוֹתָנוּ בְּצַלְמוֹ,</tei:l>
          <tei:l>וּמַּזְמִין אוֹתָנוּ לְחַדֵּשׁ בְּכָל יוֹם תָּמִיד</tei:l>
          <tei:l>מַעֲשֵׂה בְּרֵאשִׁית.</tei:l>
          <tei:l>בָּרוּךְ אַתָּה ה׳</tei:l>
          <tei:l>יוֹצֵר יְצִירִים׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
