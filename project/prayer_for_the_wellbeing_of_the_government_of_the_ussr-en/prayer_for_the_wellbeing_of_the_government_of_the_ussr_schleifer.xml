    </tei:note>
    <tei:note type="commentary" n="2" target="#note_2">
      <tei:p>i.e., the Sea of Reeds.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="3" target="#note_3">
      <tei:p>i.e., the Jordan River.</tei:p>
    </tei:note>
  </tei:standOff>
