  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:addir_lo_yanum">
        <tei:head>Adir Lo Yanum — a Sefaradi piyyuṭ for weddings and Torah-reading days</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/1"/>
        <tei:lg>
          <tei:l>The time of love!</tei:l>
          <tei:l>Bride, come to the gardens;</tei:l>
          <tei:l>the vines have bloomed,</tei:l>
          <tei:l>the pomegranates have flowered.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/2"/>
        <tei:lg>
          <tei:l>The <tei:seg type="acrostic">A</tei:seg>wesome One sleeps not,</tei:l>
          <tei:l>the <tei:seg type="acrostic">B</tei:seg>lessed One slumbers not.</tei:l>
          <tei:l>Behold, Israel’s guardian neither slumbers nor sleeps! <tei:bibl>(Psalms 121:4)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/3"/>
        <tei:lg>
          <tei:l>The <tei:seg type="acrostic">G</tei:seg>reat One sleeps not,</tei:l>
          <tei:l>the <tei:seg type="acrostic">D</tei:seg>istinguished One slumbers not.</tei:l>
          <tei:l>Behold, Israel’s guardian neither slumbers nor sleeps! <tei:bibl>(Psalms 121:4)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/4"/>
        <tei:lg>
          <tei:l>The <tei:seg type="acrostic">E</tei:seg>legant One sleeps not,</tei:l>
          <tei:l>the <tei:seg type="acrostic">V</tei:seg>eteran One slumbers not.</tei:l>
          <tei:l>Behold, Israel’s guardian neither slumbers nor sleeps! <tei:bibl>(Psalms 121:4)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/5"/>
        <tei:lg>
          <tei:l>The <tei:seg type="acrostic">Z</tei:seg>ealous One sleeps not,</tei:l>
          <tei:l>the <tei:seg type="acrostic">H</tei:seg>umane One slumbers not.</tei:l>
          <tei:l>Behold, Israel’s guardian neither slumbers nor sleeps! <tei:bibl>(Psalms 121:4)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/6"/>
        <tei:lg>
          <tei:l>The time of love!</tei:l>
          <tei:l>Bride, come to the gardens;</tei:l>
          <tei:l>the vines have bloomed,</tei:l>
          <tei:l>the pomegranates have flowered.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/7"/>
        <tei:lg>
          <tei:l>The <tei:seg type="acrostic">T</tei:seg>rue One sleeps not,</tei:l>
          <tei:l>the <tei:seg type="acrostic">J</tei:seg>ust One slumbers not.</tei:l>
          <tei:l>Behold, Israel’s guardian neither slumbers nor sleeps! <tei:bibl>(Psalms 121:4)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/8"/>
        <tei:lg>
          <tei:l>The <tei:seg type="acrostic">C</tei:seg>olossal One sleeps not,</tei:l>
          <tei:l>the <tei:seg type="acrostic">L</tei:seg>egitimacy-clod One slumbers not.</tei:l>
          <tei:l>Behold, Israel’s guardian neither slumbers nor sleeps! <tei:bibl>(Psalms 121:4)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/9"/>
        <tei:lg>
          <tei:l>The <tei:seg type="acrostic">M</tei:seg>ighty One sleeps not,</tei:l>
          <tei:l>the <tei:seg type="acrostic">N</tei:seg>oble One slumbers not.</tei:l>
          <tei:l>Behold, Israel’s guardian neither slumbers nor sleeps! <tei:bibl>(Psalms 121:4)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/10"/>
        <tei:lg>
          <tei:l>The <tei:seg type="acrostic">S</tei:seg>upporting One sleeps not,</tei:l>
          <tei:l>the <tei:seg type="acrostic">O</tei:seg>bliging One slumbers not.</tei:l>
          <tei:l>Behold, Israel’s guardian neither slumbers nor sleeps! <tei:bibl>(Psalms 121:4)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/11"/>
        <tei:lg>
          <tei:l>The time of love!</tei:l>
          <tei:l>Bride, come to the gardens;</tei:l>
          <tei:l>the vines have bloomed,</tei:l>
          <tei:l>the pomegranates have flowered.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/12"/>
        <tei:lg>
          <tei:l>The <tei:seg type="acrostic">F</tei:seg>reeing One sleeps not,</tei:l>
          <tei:l>the <tei:seg type="acrostic">Ch</tei:seg>aritable One slumbers not.</tei:l>
          <tei:l>Behold, Israel’s guardian neither slumbers nor sleeps! <tei:bibl>(Psalms 121:4)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/13"/>
        <tei:lg>
          <tei:l>The <tei:seg type="acrostic">Q</tei:seg>uintessential One sleeps not,</tei:l>
          <tei:l>the <tei:seg type="acrostic">R</tei:seg>elenting One slumbers not.</tei:l>
          <tei:l>Behold, Israel’s guardian neither slumbers nor sleeps! <tei:bibl>(Psalms 121:4)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/14"/>
        <tei:lg>
          <tei:l>The <tei:seg type="acrostic">S</tei:seg>urefire One sleeps not,</tei:l>
          <tei:l>the <tei:seg type="acrostic">Th</tei:seg>orough One slumbers not.</tei:l>
          <tei:l>Behold, Israel’s guardian neither slumbers nor sleeps! <tei:bibl>(Psalms 121:4)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/15"/>
        <tei:lg>
          <tei:l>My Master sleeps not,</tei:l>
          <tei:l>The Sovereign slumbers not.</tei:l>
          <tei:l>Behold, Israel’s guardian neither slumbers nor sleeps! <tei:bibl>(Psalms 121:4)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_lo_yanum/16"/>
        <tei:lg>
          <tei:l>The time of love!</tei:l>
          <tei:l>Bride, come to the gardens;</tei:l>
          <tei:l>the vines have bloomed,</tei:l>
          <tei:l>the pomegranates have flowered.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
