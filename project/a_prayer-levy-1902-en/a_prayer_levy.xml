  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_prayer_levy">
        <tei:head>A Prayer, by Rabbi J. Leonard Levy (1902)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_levy/1"/>
        <tei:lg>
          <tei:l>Father to Thy dear name</tei:l>
          <tei:l>I lift my voice in praise</tei:l>
          <tei:l>For Thou hast been my Guide</tei:l>
          <tei:l>Through all my days.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_levy/2"/>
        <tei:lg>
          <tei:l>Whate’er on earth is mine</tei:l>
          <tei:l>Came from Thy loving hand,</tei:l>
          <tei:l>To rightly use and share</tei:l>
          <tei:l>At Thy command.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_levy/3"/>
        <tei:lg>
          <tei:l>As I may journey on</tei:l>
          <tei:l>Life’s highway smooth or rough</tei:l>
          <tei:l>If Thou wilt be my Help</tei:l>
          <tei:l>I have enough.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_levy/4"/>
        <tei:lg>
          <tei:l>Though time may take from me</tei:l>
          <tei:l>Much that I now hold dear,</tei:l>
          <tei:l>Let it not take the hope</tei:l>
          <tei:l>That Thou art near.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
