  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:jb_w">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:jb_w/1"/>
        <tei:lg>
          <tei:l>Ib wa <tei:note type="instruction">(2×)</tei:note></tei:l>
          <tei:l>neti in-en</tei:l>
          <tei:l>iti-i em debenwi,</tei:l>
          <tei:l>ib wa <tei:note type="instruction">(2×)</tei:note></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:jb_w/2"/>
        <tei:lg>
          <tei:l>Aha-n ii miu,</tei:l>
          <tei:l>kher wenem ib,</tei:l>
          <tei:l>neti in-en</tei:l>
          <tei:l>iti-i em debenwi,</tei:l>
          <tei:l>ib wa <tei:note type="instruction">(2×)</tei:note>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:jb_w/3"/>
        <tei:lg>
          <tei:l>Aha-n ii tjezem,</tei:l>
          <tei:l>kher pezeh miu,</tei:l>
          <tei:l>neti wenem-en ib,</tei:l>
          <tei:l>neti in-en</tei:l>
          <tei:l>iti-i em debenwi,</tei:l>
          <tei:l>ib wa <tei:note type="instruction">(2×)</tei:note>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:jb_w/4"/>
        <tei:lg>
          <tei:l>Aha-n ii khet,</tei:l>
          <tei:l>kher sekh tjezem,</tei:l>
          <tei:l>neti pezeh-en miu,</tei:l>
          <tei:l>neti wenem-en ib,</tei:l>
          <tei:l>neti in-en</tei:l>
          <tei:l>iti-i em debenwi,</tei:l>
          <tei:l>ib wa <tei:note type="instruction">(2×)</tei:note>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:jb_w/5"/>
        <tei:lg>
          <tei:l>Aha-n ii sedjet,</tei:l>
          <tei:l>kher am khet,</tei:l>
          <tei:l>neti sekh tjezem,</tei:l>
          <tei:l>neti pezeh-en miu,</tei:l>
          <tei:l>neti wenem-en ib,</tei:l>
          <tei:l>neti in-en</tei:l>
          <tei:l>iti-i em debenwi,</tei:l>
          <tei:l>ib wa <tei:note type="instruction">(2×)</tei:note>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:jb_w/6"/>
        <tei:lg>
          <tei:l>Aha-n ii mu,</tei:l>
          <tei:l>kher ihem sedjet,</tei:l>
          <tei:l>netet am-en khet,</tei:l>
          <tei:l>neti sekh tjezem,</tei:l>
          <tei:l>neti pezeh-en miu,</tei:l>
          <tei:l>neti wenem-en ib,</tei:l>
          <tei:l>neti in-en</tei:l>
          <tei:l>iti-i em debenwi,</tei:l>
          <tei:l>ib wa <tei:note type="instruction">(2×)</tei:note>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:jb_w/7"/>
        <tei:lg>
          <tei:l>Aha-n ii ih,</tei:l>
          <tei:l>kher zur mu,</tei:l>
          <tei:l>neti ihem-en sedjet,</tei:l>
          <tei:l>netet am-en khet,</tei:l>
          <tei:l>neti sekh tjezem,</tei:l>
          <tei:l>neti pezeh-en miu,</tei:l>
          <tei:l>neti wenem-en ib,</tei:l>
          <tei:l>neti in-en</tei:l>
          <tei:l>iti-i em debenwi,</tei:l>
          <tei:l>ib wa <tei:note type="instruction">(2×)</tei:note>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:jb_w/8"/>
        <tei:lg>
          <tei:l>Aha-n ii mehunu,</tei:l>
          <tei:l>kher rekhes ih,</tei:l>
          <tei:l>neti zur-en mu,</tei:l>
          <tei:l>neti ihem-en sedjet,</tei:l>
          <tei:l>netet am-en khet,</tei:l>
          <tei:l>neti sekh tjezem,</tei:l>
          <tei:l>neti pezeh-en miu,</tei:l>
          <tei:l>neti wenem-en ib,</tei:l>
          <tei:l>neti in-en</tei:l>
          <tei:l>iti-i em debenwi,</tei:l>
          <tei:l>ib wa <tei:note type="instruction">(2×)</tei:note>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:jb_w/9"/>
        <tei:lg>
          <tei:l>Aha-n ii akh ni mut,</tei:l>
          <tei:l>kher den mehunu,</tei:l>
          <tei:l>neti rekhes-en ih,</tei:l>
          <tei:l>neti zur-en mu,</tei:l>
          <tei:l>neti ihem-en sedjet,</tei:l>
          <tei:l>netet am-en khet,</tei:l>
          <tei:l>neti sekh tjezem,</tei:l>
          <tei:l>neti pezeh-en miu,</tei:l>
          <tei:l>neti wenem-en ib,</tei:l>
          <tei:l>neti in-en</tei:l>
          <tei:l>iti-i em debenwi,</tei:l>
          <tei:l>ib wa <tei:note type="instruction">(2×)</tei:note>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:jb_w/10"/>
        <tei:lg>
          <tei:l>Aha-n ii djeser netjer aa,</tei:l>
          <tei:l>kher khedeb akh ni mut,</tei:l>
          <tei:l>neti den-en mehunu,</tei:l>
          <tei:l>neti rekhes-en ih,</tei:l>
          <tei:l>neti zur-en mu,</tei:l>
          <tei:l>neti ihem-en sedjet,</tei:l>
          <tei:l>netet am-en khet,</tei:l>
          <tei:l>neti sekh tjezem,</tei:l>
          <tei:l>neti pezeh-en miu,</tei:l>
          <tei:l>neti wenem-en ib,</tei:l>
          <tei:l>neti in-en</tei:l>
          <tei:l>iti-i em debenwi,</tei:l>
          <tei:l>ib wa <tei:note type="instruction">(2×)</tei:note>.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
