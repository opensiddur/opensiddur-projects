    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:earth_pledge_for_the_20th_anniversary_of_earth_day">
        <tei:head>Earth Pledge for the 20th Anniversary of Earth Day at Stanford University (22 April 1990)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:earth_pledge_for_the_20th_anniversary_of_earth_day/1"/>
        <tei:lg>
          <tei:l>I pledge to protect the earth,</tei:l>
          <tei:l>And to respect the web of life upon it,</tei:l>
          <tei:l>And to honor the dignity</tei:l>
          <tei:l>Of every member</tei:l>
          <tei:l>Of our global family.</tei:l>
          <tei:l>One planet, one people, one world,</tei:l>
          <tei:l>in harmony.</tei:l>
          <tei:l>With peace, justice and freedom for all.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
