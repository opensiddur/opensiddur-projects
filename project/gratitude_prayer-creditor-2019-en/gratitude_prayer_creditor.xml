  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:gratitude_prayer_creditor">
        <tei:head>Gratitude Prayer, by Rabbi Menachem Creditor on the first anniversary of the Pittsburgh Tree of Life massacre (2019)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gratitude_prayer_creditor/1"/>
        <tei:lg>
          <tei:l>Gratitude Prayer</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gratitude_prayer_creditor/2"/>
        <tei:lg>
          <tei:l>
            <tei:hi rend="italic">in memory and in solidarity with 11 beautiful souls from Pittsburgh who lived and whose gifts live on</tei:hi>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gratitude_prayer_creditor/3"/>
        <tei:lg>
          <tei:l>Dear One,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gratitude_prayer_creditor/4"/>
        <tei:lg>
          <tei:l>I know there’s enough here</tei:l>
          <tei:l>to do things worth doing</tei:l>
          <tei:l>with other doers.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gratitude_prayer_creditor/5"/>
        <tei:lg>
          <tei:l>Sometimes,</tei:l>
          <tei:l>because of what we’ve lost,</tei:l>
          <tei:l>because of what we’re afraid of losing,</tei:l>
          <tei:l>it can be hard to remember what we have.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gratitude_prayer_creditor/6"/>
        <tei:lg>
          <tei:l>So please remind us</tei:l>
          <tei:l>to be mindful of what we have</tei:l>
          <tei:l>so that we don’t lose it</tei:l>
          <tei:l>while we still have it.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gratitude_prayer_creditor/7"/>
        <tei:lg>
          <tei:l>Amen.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
