  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/29">
        <tei:head>תהלים כ״ט</tei:head>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">מִזְמוֹר לְדָוִד</tei:note>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>הָבוּ לַיהֹוָה בְּנֵי אֵלִים</tei:l>
          <tei:l>הָבוּ לַיהֹוָה כָּבוֹד וָעֹז׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/29/2/a"/>
        <tei:lg>
          <tei:l>הָבוּ לַיהֹוָה</tei:l>
          <tei:l>כְּבוֹד שְׁמוֹ</tei:l>
          <tei:l>הִשְׁתַּחֲווּ לַיהֹוָה</tei:l>
          <tei:l>בְּהַדְרַת־קֹדֶשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>קוֹל יְהֹוָה עַל־הַמָּיִם</tei:l>
          <tei:l>אֵל־הַכָּבוֹד הִרְעִים יְהֹוָה עַל־מַיִם רַבִּים׃</tei:l>
          <tei:l>קוֹל־יְהֹוָה בַּכֹּחַ</tei:l>
          <tei:l>קוֹל יְהֹוָה בֶּהָדָר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/29/5/a"/>
        <tei:lg>
          <tei:l>קוֹל יְהֹוָה שֹׁבֵר אֲרָזִים</tei:l>
          <tei:l>וַיְשַׁבֵּר יְהֹוָה אֶת־אַרְזֵי הַלְּבָנוֹן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/29/6/a"/>
        <tei:lg>
          <tei:l>וַיַּרְקִידֵם כְּמוֹ־עֵגֶל</tei:l>
          <tei:l>לְבָנוֹן וְשִׂרְיֹן</tei:l>
          <tei:l>כְּמוֹ בֶן־רְאֵמִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>קוֹל־יְהֹוָה חֹצֵב לַהֲבוֹת אֵשׁ׃</tei:l>
          <tei:l>קוֹל יְהֹוָה יָחִיל מִדְבָּר</tei:l>
          <tei:l>יָחִיל יְהֹוָה מִדְבַּר קָדֵשׁ׃</tei:l>
          <tei:l>קוֹל יְהֹוָה יְחוֹלֵל אַיָּלוֹת</tei:l>
          <tei:l>וַיֶּחֱשֹׂף יְעָרוֹת</tei:l>
          <tei:l>וּבְהֵיכָלוֹ</tei:l>
          <tei:l>כֻּלּוֹ אֹמֵר כָּבוֹד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/29/10/a"/>
        <tei:lg>
          <tei:l>יְהֹוָה לַמַּבּוּל יָשָׁב</tei:l>
          <tei:l>וַיֵּשֶׁב יְהֹוָה מֶלֶךְ לְעוֹלָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/29/11/a"/>
        <tei:lg>
          <tei:l>יְהֹוָה</tei:l>
          <tei:l>עֹז לְעַמּוֹ יִתֵּן</tei:l>
          <tei:l>יְהֹוָה</tei:l>
          <tei:l>יְבָרֵךְ אֶת־עַמּוֹ בַשָּׁלוֹם׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
