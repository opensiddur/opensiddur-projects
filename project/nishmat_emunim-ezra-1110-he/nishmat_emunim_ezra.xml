    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:nishmat_emunim_ezra">
        <tei:head>נִשְׁמַת אֱמוּנִים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nishmat_emunim_ezra/1"/>
        <tei:lg>
          <tei:l>נִשְׁמַת <tei:seg type="acrostic">אֱ</tei:seg>מוּנִים רָגְזוּ וְחָלוּ בְּיוֹם זַֽעַם</tei:l>
          <tei:l>בְּמַר יִבְכָּיוּן מִדֵּי שָׁנָה בְשָׁנָה הוֹגִים בְּרַֽעַם</tei:l>
          <tei:l>אֵיכָ֣ה ׀ יָשְׁבָ֣ה בָדָ֗ד הָעִיר֙ רַבָּ֣תִי עָ֔ם׃ <tei:bibl>(איכה א:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nishmat_emunim_ezra/2"/>
        <tei:lg>
          <tei:l>נִשְׁמַת <tei:seg type="acrostic">בָּ</tei:seg>נִים זָעֲקוּ מִכֹּֽבֶד מַעֲמָס</tei:l>
          <tei:l>בְּמַר יִבְכָּיוּן בּוֹכִים יוֹם נִגְלָה עֲוֺנָם הַנִּמְאָס</tei:l>
          <tei:l>שָׂרָ֙תִי֙ בַּמְּדִינ֔וֹת הָיְתָ֖ה לָמַֽס׃ <tei:bibl>(איכה א:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nishmat_emunim_ezra/3"/>
        <tei:lg>
          <tei:l>נִשְׁמַת <tei:seg type="acrostic">רְ</tei:seg>ווּיִים לַֽעַן וּמַמְּרוֹר בְּאַפְסֵי נְשִׁיָּה</tei:l>
          <tei:l>בְּמַר יִבְכָּיוּן סוּרָה וְגוֹלָה וְהוֹמִיָּה</tei:l>
          <tei:l>בָּכ֨וֹ תִבְכֶּ֜ה בַּלַּ֗יְלָה וְדִמְעָתָהּ֙ עַ֣ל לֶֽחֱיָ֔הּ׃ <tei:bibl>(איכה א:ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nishmat_emunim_ezra/4"/>
        <tei:lg>
          <tei:l>נִשְׁמַת <tei:seg type="acrostic">הֲ</tei:seg>לוּמִים מֵחֲרוֹן אֵל עֶלְיוֹן</tei:l>
          <tei:l>בְּמַר יִבְכָּיוּן נְהִי וָהִי הֶגְיוֹן</tei:l>
          <tei:l>אֵיכָה֩ יָעִ֨יב בְּאַפּ֤וֹ ׀ אֲדֹנָי֙ אֶת־בַּת־צִיּ֔וֹן׃ <tei:bibl>(איכה ב:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nishmat_emunim_ezra/5"/>
        <tei:lg>
          <tei:l>נִשְׁמַת נְתוּקִים בַּחוּצוֹת בְּכׇל־עֵֽבֶר וּפִנָּה</tei:l>
          <tei:l>בְּמַר יִבְכָּיוּן יוֹם רַבָּֽתִי־עָם הָיְתָה כְּאַלְמָנָה</tei:l>
          <tei:l>אֵיכָה֙ הָיְתָ֣ה לְזוֹנָ֔ה קִרְיָ֖ה נֶאֱמָנָ֑ה׃ <tei:bibl>(ישעיה א:כא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nishmat_emunim_ezra/6"/>
        <tei:lg>
          <tei:l>נִשְׁמַת חֲרֵדִים עֲצֵבִים בְּאֶֽרֶץ שִׁבְיָם</tei:l>
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>תְחַנְּנִים לָאֵל הֵם וּבְנֵיהֶם גִּזְעָם וּפִרְיָם</tei:l>
          <tei:l>אוֹמְרִים וְאִֽלּוּ פִֽינוּ מָלֵא שִׁירָה כַּיָּם׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
