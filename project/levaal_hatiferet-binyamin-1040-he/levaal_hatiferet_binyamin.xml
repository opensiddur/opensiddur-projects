    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:levaal_hatiferet_binyamin">
        <tei:head>לְבַֽעַל הַתִּפְאֶֽרֶת</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:levaal_hatiferet_binyamin/1"/>
        <tei:lg>
          <tei:l>לְ<tei:seg type="acrostic">בַֽ</tei:seg>עַל הַתִּפְאֶֽרֶת | מְתַכֵּן רוֹם בַּזֶּֽרֶת</tei:l>
          <tei:l>מַעֲצִימִים אַדֶּֽרֶת | מַלְאֲכֵי הַשָּׁרֵת</tei:l>
          <tei:l>נוֹחִים לוֹ לְתִשְׁחֹֽרֶת | כַּהֲלָכָה וּמַסֹּֽרֶת</tei:l>
          <tei:l>וַאֲנִי שְׁחַרְחֹֽרֶת | תְּהִלָּה בְּפִי סוֹדָֽרֶת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:levaal_hatiferet_binyamin/2"/>
        <tei:lg>
          <tei:l>לְ<tei:seg type="acrostic">נִ</tei:seg>קְרָא רִאשׁוֹן וְאַחֲרוֹן | מֶֽלֶךְ אַדִּירִירוֹן</tei:l>
          <tei:l>מַבִּיעִים סֶֽלֶד וָרֹן | בְּיֹֽשֶׁר וּבְכִשְׁרוֹן</tei:l>
          <tei:l>וְאִתָּם מִטַּטְרוֹן | פִּסְקוֹן אִטְמוֹן וְסִגְרוֹן</tei:l>
          <tei:l>וַאֲנִי חֲבַצֶּֽלֶת הַשָּׁרוֹן | מִשְׁתַּחֲוֶה פְּנֵי אָרוֹן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:levaal_hatiferet_binyamin/3"/>
        <tei:lg>
          <tei:l>לְ<tei:seg type="acrostic">יָ</tei:seg>הּ חוֹצֵב לֶהָבָה | נַ֭עֲרָץ בְּסוֹד־קְדֹשִׁ֣ים רַבָּ֑ה <tei:bibl>(תהלים פט:ח)</tei:bibl></tei:l>
          <tei:l>וְעִירֵי מֶרְכָּבָה | וְקַדִּישֵׁי שַׁלְהֵבָה</tei:l>
          <tei:l>מִתְגַּבְּרִים לְהַקְשִׁיבָה | קְדֻשָּׁה כְּאַחַת חֲטִיבָה</tei:l>
          <tei:l>וַאֲנִי חוֹלַת אַהֲבָה | בַּקָּשָׁה כְּשַׁי עֲרֵבָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:levaal_hatiferet_binyamin/4"/>
        <tei:lg>
          <tei:l>לְ<tei:seg type="acrostic">מַ</tei:seg>פְלִיא פְלָאוֹת | אֲדוֹן כׇּל־הַנִּפְלָאוֹת</tei:l>
          <tei:l>כִּתִּים וַחֲיָלוֹת | בְּחַדְרֵי הֵיכָלוֹת</tei:l>
          <tei:l>רוֹעֲשִׁים בְּקוֹלוֹת | נוֹעָדִים בְּמַקְהֵלוֹת</tei:l>
          <tei:l>וַאֲנִי חוֹמָה וְשָׁדַי כַּמִּגְדָּלוֹת | תִּשְׁבָּחוֹת וּתְהִלּוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:levaal_hatiferet_binyamin/5"/>
        <tei:lg>
          <tei:l>לְ<tei:seg type="acrostic">נֶ</tei:seg>אֱמָן בִּבְרִיתוֹ | וְקַיָּם בִּשְׁבוּעָתוֹ</tei:l>
          <tei:l>חַשְׁמַלֵּי שֵׁרוּתוֹ | מִתְבַּהֲלִים מִשְּׂאֵתוֹ</tei:l>
          <tei:l>מִתְנַטְּלִים מֵאֵימָתוֹ | וּמַגִּידִים אֱלָהוּתוֹ</tei:l>
          <tei:l>וַאֲנִי לְדוֹדִי וְעָלַי תְּשׁוּקָתוֹ |</tei:l>
          <tei:l>בָּרוּךְ שֵׁם כְּבוֹד מַלְכוּתוֹ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
