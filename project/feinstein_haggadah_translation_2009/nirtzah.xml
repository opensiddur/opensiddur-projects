  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:haggadah:nirtzah">
        <tei:head>Concluding Songs</tei:head>
        <j:conditional xml:id="cond_nirtzah_first_night">
          <tei:fs type="opensiddur:holiday">
            <tei:f name="pesah">
              <tei:numeric value="1"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
        <tei:note type="instruction">On the first night recite the following:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:haggadah:nirtzah/it_happened_at_midnight"/>
        <j:endConditional target="#cond_nirtzah_first_night"/>
        <j:conditional xml:id="cond_nirtzah_second_night">
          <tei:fs type="opensiddur:holiday">
            <tei:f name="pesah">
              <tei:numeric value="2"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
        <tei:note type="instruction">On the second night recite the following:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:haggadah:nirtzah/you_shall_say_pesach"/>
        <j:endConditional target="#cond_nirtzah_second_night"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:haggadah:nirtzah/ki_lo_na_eh"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:haggadah:nirtzah/lshana_haba_ah"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:haggadah:nirtzah/hagafen_fourth_cup"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:haggadah:nirtzah/al_hagefen"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:haggadah:nirtzah/chasal_siddur_pesach"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:haggadah:nirtzah/adir_hu"/>
        <j:conditional xml:id="cond_nirtzah_sefirat_haomer">
          <tei:fs type="opensiddur:holiday">
            <tei:f name="pesah">
              <tei:numeric value="2"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
        <tei:note type="instruction">On the second night of Passover, the first night of the Omer is counted:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:haggadah:nirtzah/sefirat_haomer"/>
        <j:endConditional target="#cond_nirtzah_sefirat_haomer"/>
