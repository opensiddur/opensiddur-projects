  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_our_enemies_cronbach">
        <tei:head>Prayer for Our Enemies, by Rabbi Abraham Cronbach (1932)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_our_enemies_cronbach/1"/>
        <tei:lg>
          <tei:l>Grant, <j:divineName>Lord</j:divineName>,</tei:l>
          <tei:l>that we might overcome our enemies</tei:l>
          <tei:l>by transforming them into friends.</tei:l>
          <tei:l>Make them</tei:l>
          <tei:l>and make us</tei:l>
          <tei:l>conscious of those deep inward reaches</tei:l>
          <tei:l>whereby every heart is rooted</tei:l>
          <tei:l>in the world’s deep common life.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_our_enemies_cronbach/2"/>
        <tei:lg>
          <tei:l>Cause us</tei:l>
          <tei:l>to cease looking into directions</tei:l>
          <tei:l>that oppose.</tei:l>
          <tei:l>Cause us, O thou <j:divineName>our Utmost Good</j:divineName>,</tei:l>
          <tei:l>to look into the one direction</tei:l>
          <tei:l>of a united look unto Thee.</tei:l>
          <tei:l><tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
