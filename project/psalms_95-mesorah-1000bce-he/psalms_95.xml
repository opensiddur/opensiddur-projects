    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/95">
        <tei:head>תהלים צ״ה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/95/1/a"/>
        <tei:lg>
          <tei:l>לְ֭כוּ נְרַנְּנָ֣ה לַיהוָ֑ה</tei:l>
          <tei:l>נָ֝רִ֗יעָה לְצ֣וּר יִשְׁעֵֽנוּ׃</tei:l>
          <tei:l>נְקַדְּמָ֣ה פָנָ֣יו בְּתוֹדָ֑ה</tei:l>
          <tei:l>בִּ֝זְמִר֗וֹת נָרִ֥יעַֽ לֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/95/3/a"/>
        <tei:lg>
          <tei:l>כִּי אֵל גָּדוֹל יהוה,</tei:l>
          <tei:l>וּמֶלֶךְ גָּדוֹל עַל־כָּל־אֱלֹהִים׃</tei:l>
          <tei:l>אֲשֶׁר בְּיָדוֹ מֶחְקְרֵי־אָרֶץ,</tei:l>
          <tei:l>וְתוֹעֲפוֹת הָרִים לוֹ׃</tei:l>
          <tei:l>אֲשֶׁר־לוֹ הַיָּם וְהוּא עָשָׂהוּ,</tei:l>
          <tei:l>וְיַבֶּשֶׁת יָדָיו יָצָרוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/95/6/a"/>
        <tei:lg>
          <tei:l>בֹּאוּ נִשְׁתַּחֲוֶה וְנִכְרָעָה,</tei:l>
          <tei:l>נִבְרְכָה לִפְנֵי־יהוה עֹשֵׂנוּ׃</tei:l>
          <tei:l>כִּי הוּא אֱלֹהֵינוּ,</tei:l>
          <tei:l>וַאֲנַחְנוּ עַם מַרְעִיתוֹ וְצֹאן יָדוֹ,</tei:l>
          <tei:l>הַיּוֹם אִם־בְּקֹלוֹ תִשְׁמָעוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/95/6/b"/>
        <tei:lg>
          <tei:l>אַל תַּקְשׁוּ לְבַבְכֶם כִּמְרִיבָה,</tei:l>
          <tei:l>כְּיוֹם מַסָּה בַּמִּדְבָּר׃</tei:l>
          <tei:l>אֲשֶׁר נִסּוּנִי אֲבוֹתֵיכֶם,</tei:l>
          <tei:l>בְּחָנוּנִי גַּם־רָאוּ פָעֳלִי׃</tei:l>
          <tei:l>אַרְבָּעִים שָׁנָה אָקוּט בְּדוֹר,</tei:l>
          <tei:l>וָאֹמַר עַם תֹּעֵי לֵבָב הֵם,</tei:l>
          <tei:l>וְהֵם לֹא יָדְעוּ דְרָכָי׃</tei:l>
          <tei:l>אֲשֶׁר נִשְׁבַּעְתִּי בְאַפִּי,</tei:l>
          <tei:l>אִם־יְבֹאוּן אֶל־מְנוּחָתִי׃</tei:l>
        </tei:lg>
      </tei:div>
