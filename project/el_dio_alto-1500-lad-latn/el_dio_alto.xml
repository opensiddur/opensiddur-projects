  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:el_dio_alto">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_dio_alto/1"/>
        <tei:lg>
          <tei:l>El Dio alto kon su grasia</tei:l>
          <tei:l>mos mande muncha ganansia</tei:l>
          <tei:l>non veyamos mal ni ansia</tei:l>
          <tei:l>a nos i a todo Yisrael.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_dio_alto/2"/>
        <tei:lg>
          <tei:l>Bendicho el abastado</tei:l>
          <tei:l>ke mos dio dia onrado</tei:l>
          <tei:l>kada Shabat mejorado</tei:l>
          <tei:l>a nos i a todo Yisrael.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_dio_alto/3"/>
        <tei:lg>
          <tei:l>Rogo al Dio de kontino</tei:l>
          <tei:l>ke este en nuestro tino,</tei:l>
          <tei:l>non mos manke pan ni vino</tei:l>
          <tei:l>a nos i a todo Yisrael.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_dio_alto/4"/>
        <tei:lg>
          <tei:l>Vos ke sosh Padre Rahman</tei:l>
          <tei:l>mandamos al pastor neeman</tei:l>
          <tei:l>ke mos sia un buen siman</tei:l>
          <tei:l>a nos i a todo Yisrael.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_dio_alto/5"/>
        <tei:lg>
          <tei:l>Venid todos adjuntemos</tei:l>
          <tei:l>a su nombre bendiziremos</tei:l>
          <tei:l>i de el demandaremos</tei:l>
          <tei:l>la bendisyon de Yisrael.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_dio_alto/6"/>
        <tei:lg>
          <tei:l>Rogemos noche i dia</tei:l>
          <tei:l>Ke mos de gozo i alegria</tei:l>
          <tei:l>A toda la kompaniya</tei:l>
          <tei:l>a nos i a todo Yisrael.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_dio_alto/7"/>
        <tei:lg>
          <tei:l>Ah, Dio, avre tu sillero</tei:l>
          <tei:l>i damos muncho dinero</tei:l>
          <tei:l>ke siempre de ti espero</tei:l>
          <tei:l>ke eres santo i fiel.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_dio_alto/8"/>
        <tei:lg>
          <tei:l>Damos, Senyor, tu bendisyon</tei:l>
          <tei:l>kon la buena kondisyon</tei:l>
          <tei:l>mostranos tu salvasyon</tei:l>
          <tei:l>del Mikdash Ariel.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_dio_alto/9"/>
        <tei:lg>
          <tei:l>Ya es bien abastado</tei:l>
          <tei:l>lo ke avimos pasado</tei:l>
          <tei:l>mandamos a el untado</tei:l>
          <tei:l>mashiah de Yisrael.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_dio_alto/10"/>
        <tei:lg>
          <tei:l>Mihael sar Yisrael</tei:l>
          <tei:l>Eliyahu i Gavriel</tei:l>
          <tei:l>nos venga djunto kon el goel</tei:l>
          <tei:l>a salavar a Yisrael.</tei:l>
        </tei:lg>
      </tei:div>
