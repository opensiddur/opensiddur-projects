      <tei:div corresp="urn:x-opensiddur:text:poem:mere_hobritsos_a_judeo_valyrian_translation_of_had_gadya">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mere_hobritsos_a_judeo_valyrian_translation_of_had_gadya/1"/>
        <tei:lg>
          <tei:l>מֵײרֶע הוֹבְּרִיטְסוֹס, מֵײרֶע הוֹבְּרִיטְסוֹס,</tei:l>
          <tei:l>לוּאַה גֵּײלִאַפֻּסּוֹ לַנְטוֹסִּי סִנְדִּטֶעס ניוּהַה כֶּעפַּה,</tei:l>
          <tei:l>מֵײרֶע הוֹבְּרִיטְסוֹס, מֵײרֶע הוֹבְּרִיטְסוֹס׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mere_hobritsos_a_judeo_valyrian_translation_of_had_gadya/2"/>
        <tei:lg>
          <tei:l>פַּאר מַסְטַס כֵּײלִי</tei:l>
          <tei:l>סֶע הוֹבְּרִיטְסוֹס אִפְּרַטַּס,</tei:l>
          <tei:l>לוּאַה גֵּײלִאַפֻּסּוֹ לַנְטוֹסִּי סִנְדִּטֶעס ניוּהַה כֶּעפַּה,</tei:l>
          <tei:l>מֵײרֶע הוֹבְּרִיטְסוֹס, מֵײרֶע הוֹבְּרִיטְסוֹס׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mere_hobritsos_a_judeo_valyrian_translation_of_had_gadya/3"/>
        <tei:lg>
          <tei:l>פַּאר מַסְטַס יַאֹס</tei:l>
          <tei:l>סֶע כֵּײלִי אַנגּוֹטַס,</tei:l>
          <tei:l>לוּאַה הוֹבְּרִיטְסוֹס אִפְּרַטֶּעס,</tei:l>
          <tei:l>לוּאַה גֵּײלִאַפֻּסּוֹ לַנְטוֹסִּי סִנְדִּטֶעס ניוּהַה כֶּעפַּה,</tei:l>
          <tei:l>מֵײרֶע הוֹבְּרִיטְסוֹס, מֵײרֶע הוֹבְּרִיטְסוֹס׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mere_hobritsos_a_judeo_valyrian_translation_of_had_gadya/4"/>
        <tei:lg>
          <tei:l>פַּאר מַסְטַס טַאעֶמִיטְסוֹס</tei:l>
          <tei:l>סֶע יַאֹס הִילְטַס,</tei:l>
          <tei:l>לוּאַה כֵּײלִי אַנגּוֹטֶעס,</tei:l>
