  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:mine_mamo_ista_a_judeo_quenya_translation_of_echad_mi_yodea">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mine_mamo_ista_a_judeo_quenya_translation_of_echad_mi_yodea/1"/>
        <tei:lg xml:lang="qya">
          <tei:l>Minë mamo ista?</tei:l>
          <tei:l>Minë istanye tana!</tei:l>
          <tei:l>Minë ná Eru ye or menel cemenyë.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mine_mamo_ista_a_judeo_quenya_translation_of_echad_mi_yodea/2"/>
        <tei:lg xml:lang="qya">
          <tei:l>Atta mamo ista?</tei:l>
          <tei:l>Atta istanye tana!</tei:l>
          <tei:l>Palmat atta.</tei:l>
          <tei:l>Minë ná Eru ye or menel cemenyë.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mine_mamo_ista_a_judeo_quenya_translation_of_echad_mi_yodea/3"/>
        <tei:lg xml:lang="qya">
          <tei:l>Neldë mamo ista?</tei:l>
          <tei:l>Neldë istanye tana!</tei:l>
          <tei:l>Atari neldë.</tei:l>
          <tei:l>Palmat atta.</tei:l>
          <tei:l>Minë ná Eru ye or menel cemenyë.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mine_mamo_ista_a_judeo_quenya_translation_of_echad_mi_yodea/4"/>
        <tei:lg xml:lang="qya">
          <tei:l>Canta mamo ista?</tei:l>
          <tei:l>Canta istanye tana!</tei:l>
          <tei:l>Amilli canta.</tei:l>
          <tei:l>Atari neldë.</tei:l>
          <tei:l>Palmat atta.</tei:l>
          <tei:l>Minë ná Eru ye or menel cemenyë.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mine_mamo_ista_a_judeo_quenya_translation_of_echad_mi_yodea/5"/>
        <tei:lg xml:lang="qya">
          <tei:l>Lempë mamo ista?</tei:l>
          <tei:l>Lempë i stanye tana!</tei:l>
          <tei:l>Parmar axanion lempë.</tei:l>
          <tei:l>Amilli canta.</tei:l>
          <tei:l>Atari neldë.</tei:l>
          <tei:l>Palmat atta.</tei:l>
          <tei:l>Minë ná Eru ye or menel cemenyë.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mine_mamo_ista_a_judeo_quenya_translation_of_echad_mi_yodea/6"/>
        <tei:lg xml:lang="qya">
          <tei:l>Enquë mamo ista?</tei:l>
          <tei:l>Enquë istanye tana!</tei:l>
          <tei:l>Hereni ataquetiéno enquë.</tei:l>
          <tei:l>Parmar axanion lempë.</tei:l>
          <tei:l>Amilli canta.</tei:l>
          <tei:l>Atari neldë.</tei:l>
          <tei:l>Palmat atta.</tei:l>
          <tei:l>Minë ná Eru ye or menel cemenyë.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mine_mamo_ista_a_judeo_quenya_translation_of_echad_mi_yodea/7"/>
        <tei:lg xml:lang="qya">
          <tei:l>Otso mamo ista?</tei:l>
          <tei:l>Otso istanye tana!</tei:l>
          <tei:l>Rí sendarenna otso.</tei:l>
          <tei:l>Hereni ataquetiéno enquë.</tei:l>
          <tei:l>Parmar axanion lempë.</tei:l>
          <tei:l>Amilli canta.</tei:l>
          <tei:l>Atari neldë.</tei:l>
          <tei:l>Palmat atta.</tei:l>
          <tei:l>Minë ná Eru ye or menel cemenyë.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mine_mamo_ista_a_judeo_quenya_translation_of_echad_mi_yodea/8"/>
        <tei:lg xml:lang="qya">
          <tei:l>Toldo mamo ista?</tei:l>
          <tei:l>Toldo istanye tana!</tei:l>
          <tei:l>Rí oscirion toldo.</tei:l>
          <tei:l>Rí sendarenna otso.</tei:l>
          <tei:l>Hereni ataquetiéno enquë.</tei:l>
          <tei:l>Parmar axanion lempë.</tei:l>
          <tei:l>Amilli canta.</tei:l>
          <tei:l>Atari neldë.</tei:l>
          <tei:l>Palmat atta.</tei:l>
          <tei:l>Minë ná Eru ye or menel cemenyë.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mine_mamo_ista_a_judeo_quenya_translation_of_echad_mi_yodea/9"/>
        <tei:lg xml:lang="qya">
          <tei:l>Nertë mamo ista?</tei:l>
          <tei:l>Nertë istanye tana!</tei:l>
          <tei:l>Astar nosto nertë.</tei:l>
          <tei:l>Rí oscirion toldo.</tei:l>
          <tei:l>Rí sendarenna otso.</tei:l>
          <tei:l>Hereni ataquetiéno enquë.</tei:l>
          <tei:l>Parmar axanion lempë.</tei:l>
          <tei:l>Amilli canta.</tei:l>
          <tei:l>Atari neldë.</tei:l>
          <tei:l>Palmat atta.</tei:l>
          <tei:l>Minë ná Eru ye or menel cemenyë.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mine_mamo_ista_a_judeo_quenya_translation_of_echad_mi_yodea/10"/>
        <tei:lg xml:lang="qya">
          <tei:l>Quean mamo ista?</tei:l>
          <tei:l>Quean istanye tana!</tei:l>
          <tei:l>Axani palmatsë quean.</tei:l>
          <tei:l>Astar nosto nertë.</tei:l>
          <tei:l>Rí oscirion toldo.</tei:l>
          <tei:l>Rí sendarenna otso.</tei:l>
          <tei:l>Hereni ataquetiéno enquë.</tei:l>
          <tei:l>Parmar axanion lempë.</tei:l>
          <tei:l>Amilli canta.</tei:l>
          <tei:l>Atari neldë.</tei:l>
          <tei:l>Palmat atta.</tei:l>
          <tei:l>Minë ná Eru ye or menel cemenyë.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mine_mamo_ista_a_judeo_quenya_translation_of_echad_mi_yodea/11"/>
        <tei:lg xml:lang="qya">
          <tei:l>Minquë mamo ista?</tei:l>
          <tei:l>Minquë istanye tana!</tei:l>
          <tei:l>Eleni oloresse minquë.</tei:l>
          <tei:l>Axani palmatsë quean.</tei:l>
          <tei:l>Astar nosto nertë.</tei:l>
          <tei:l>Rí oscirion toldo.</tei:l>
          <tei:l>Rí sendarenna otso.</tei:l>
          <tei:l>Hereni ataquetiéno enquë.</tei:l>
          <tei:l>Parmar axanion lempë.</tei:l>
          <tei:l>Amilli canta.</tei:l>
          <tei:l>Atari neldë.</tei:l>
          <tei:l>Palmat atta.</tei:l>
          <tei:l>Minë ná Eru ye or menel cemenyë.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mine_mamo_ista_a_judeo_quenya_translation_of_echad_mi_yodea/12"/>
        <tei:lg xml:lang="qya">
          <tei:l>Yunquë mamo ista?</tei:l>
          <tei:l>Yunquë istanye tana!</tei:l>
          <tei:l>Nossi Irrahelo yunquë.</tei:l>
          <tei:l>Eleni oloresse minquë.</tei:l>
          <tei:l>Axani palmatsë quean.</tei:l>
          <tei:l>Astar nosto nertë.</tei:l>
          <tei:l>Rí oscirion toldo.</tei:l>
          <tei:l>Rí sendarenna otso.</tei:l>
          <tei:l>Hereni ataquetiéno enquë.</tei:l>
          <tei:l>Parmar axanion lempë.</tei:l>
          <tei:l>Amilli canta.</tei:l>
          <tei:l>Atari neldë.</tei:l>
          <tei:l>Palmat atta.</tei:l>
          <tei:l>Minë ná Eru ye or menel cemenyë.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mine_mamo_ista_a_judeo_quenya_translation_of_echad_mi_yodea/13"/>
        <tei:lg xml:lang="qya">
          <tei:l>Nelquë mamo ista?</tei:l>
          <tei:l>Nelquë istanye tana!</tei:l>
          <tei:l>Quettar Eruva lissëo nelquë.</tei:l>
          <tei:l>Nossi Irrahelo yunquë.</tei:l>
          <tei:l>Eleni oloresse minquë.</tei:l>
          <tei:l>Axani palmatsë quean.</tei:l>
          <tei:l>Astar nosto nertë.</tei:l>
          <tei:l>Rí oscirion toldo.</tei:l>
          <tei:l>Rí sendarenna otso.</tei:l>
          <tei:l>Hereni ataquetiéno enquë.</tei:l>
          <tei:l>Parmar axanion lempë.</tei:l>
          <tei:l>Amilli canta.</tei:l>
          <tei:l>Atari neldë.</tei:l>
          <tei:l>Palmat atta.</tei:l>
          <tei:l>Minë ná Eru ye or menel cemenyë.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
