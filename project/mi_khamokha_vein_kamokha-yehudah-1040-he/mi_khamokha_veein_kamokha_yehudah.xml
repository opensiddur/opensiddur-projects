    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:mi_khamokha_veein_kamokha_yehudah">
        <tei:head>מִי כָמֽוֹךָ וְאֵין כָּמֽוֹךָ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_khamokha_veein_kamokha_yehudah/1"/>
        <tei:lg>
          <tei:l>מִי כָמֽוֹךָ</tei:l>
          <tei:l>וְאֵין כָּמֽוֹךָ</tei:l>
          <tei:l>מִי דוֹמֶה לָּךְ</tei:l>
          <tei:l>וְאֵין דּוֹמֶה לָּךְ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_khamokha_veein_kamokha_yehudah/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אָ</tei:seg>דוֹן חַסְדְּךָ בַּל יֶחְדָּל</tei:l>
          <tei:l>אֲמִתְּךָ מִבְצָר עֹז וּמִגְדָּל</tei:l>
          <tei:l>כִּי־הָיִ֨יתָ מָע֥וֹז לַדָּ֛ל</tei:l>
          <tei:l>מָע֥וֹז לָאֶבְי֖וֹן בַּצַּר־ל֑וֹ <tei:bibl>(ישעיהו כה:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_khamokha_veein_kamokha_yehudah/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בִּ</tei:seg>ימֵי חׇרְפִּי מִקַּדְמוֹנָי</tei:l>
          <tei:l>בִּי דִּבֵּר רֽוּחַ יהוה</tei:l>
          <tei:l>וְהַיּוֹם אִם גֵּרְשֽׁוּנִי עֲוֹנָי</tei:l>
          <tei:l>דּוֹדִ֥י לִי֙ וַאֲנִ֣י ל֔וֹ <tei:bibl>(שיר השירים ב:ז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_khamokha_veein_kamokha_yehudah/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">גְּ</tei:seg>מָלַֽנִי מֵאָז טוֹבוֹת</tei:l>
          <tei:l>גְּלוּיוֹת יְדוּעוֹת לַלְּבָבוֹת</tei:l>
          <tei:l>גַּם אִם יִהְיוּ הַצָּרוֹת קְרוֹבוֹת</tei:l>
          <tei:l>אַשְׁרֵ֖י כׇּל־ח֥וֹכֵי לֽוֹ <tei:bibl>(ישעיהו ל:יח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_khamokha_veein_kamokha_yehudah/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">דְּ</tei:seg>מֵי מִתְקוֹמְמַי אַזֶּה</tei:l>
          <tei:l>דִּגְלִי אָרִים כִּדְבַר כׇּל־חוֹזֶה</tei:l>
          <tei:l>הִנֵּ֨ה אֱלֹהֵ֥ינוּ זֶ֛ה</tei:l>
          <tei:l>קִוִּ֥ינוּ ל֖וֹ <tei:bibl>(ישעיהו כה:ט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_khamokha_veein_kamokha_yehudah/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הַ</tei:seg>יּוֹם אַבִּֽיעָה חִידוֹת</tei:l>
          <tei:l>הָיוּ מִנִּי קֶֽדֶם עֲתִידוֹת</tei:l>
          <tei:l>נִפְלָא בָם הַמֵּבִין צְפוּנֵי סוֹדוֹת</tei:l>
          <tei:l>יֽוֹצְרִ֤י מִבֶּ֙טֶן֙ לְעֶ֣בֶד ל֔וֹ <tei:bibl>(ישעיהו מט:ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_khamokha_veein_kamokha_yehudah/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וַ</tei:seg>יְהִ֖י בִּימֵ֣י אֲחַשְׁוֵר֑וֹשׁ <tei:bibl>(אסתר א:א)</tei:bibl></tei:l>
          <tei:l>מֶֽלֶךְ הֻקָם עָל כִּבְרוֹשׁ</tei:l>
          <tei:l>נִשָּׂא וָרָם עַל כׇּל־קָצִין וָרֹאשׁ</tei:l>
          <tei:l>וַיהֹוָ֛ה הֵנִיחַֽ־ל֥וֹ <tei:bibl>(שמואל ב׳ ז:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_khamokha_veein_kamokha_yehudah/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זִ</tei:seg>מֵּן בִּשְׁנַת שָׁלֹשׁ לְמַלְכוּתוֹ</tei:l>
          <tei:l>לְהַרְאוֹת לְכׇל־עֲבָדָיו תְּכוּנָתוֹ</tei:l>
          <tei:l>וְאַבְנֵי נֶֽזֶר מִתְנוֹסְסוֹת עַל אַדְמָתוֹ</tei:l>
          <tei:l>וְעַפְרֹ֖ת זָהָ֣ב לֽוֹ <tei:bibl>(איוב כח:ו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_khamokha_veein_kamokha_yehudah/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חֵֽ</tei:seg>לֶק לְכׇל־בְּנֵי שׁוּשָׁן נָתַן</tei:l>
          <tei:l>וְהִקְדִּישׁ קְרוּאָיו כְּחָתָן</tei:l>
          <tei:l>בַּחֲצַ֕ר גִּנַּ֥ת בִּיתַ֖ן <tei:bibl>(אסתר א:ה)</tei:bibl></tei:l>
          <tei:l>אִ֝וָּ֗הּ לְמוֹשָׁ֥ב לֽוֹ <tei:bibl>(תהלים קלב:יג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_khamokha_veein_kamokha_yehudah/10"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">טָֽ</tei:seg>עַם עֲשׂוֹת רְצוֹן כׇּל־אִישׁ וְיִצְרוֹ</tei:l>
          <tei:l>וְאֵין אֹנֵס לְאִישׁ יַֽיִן עֲבָרוֹ</tei:l>
          <tei:l>וְלָתֵת לְכׇל־שׁוֹאֵל דֵּ֚י מַחְסֹר֔וֹ</tei:l>
          <tei:l>אֲשֶׁ֥ר יֶחְסַ֖ר לֽוֹ <tei:bibl>(דברים טו:ח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_khamokha_veein_kamokha_yehudah/11"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יַֽ</tei:seg>חַד אֻסְּפוּ כׇּל־הַנִּדְרָשִׁים</tei:l>
          <tei:l>גַּ֚ם וַשְׁתִּ֣י הַמַּלְכָּ֔ה עָשְׂתָ֖ה מִשְׁתֵּ֣ה נָשִׁ֑ים <tei:bibl>(אסתר א:ט)</tei:bibl></tei:l>
          <tei:l>וּמִשְׁתֵּה הַנָּשִׁים כָּאֲנָשִׁים</tei:l>
          <tei:l>שִׁבְעַ֥ת יָמִ֖ים יִסְפְּרוּ־לֽוֹ׃ <tei:bibl>(יחזקאל מד:כו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_khamokha_veein_kamokha_yehudah/12"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כְּ</tei:seg>ט֥וֹב לֵב־הַמֶּ֖לֶךְ בַּיָּ֑יִן <tei:bibl>(אסתר א:י)</tei:bibl></tei:l>
          <tei:l>אָמַר לְהָבִיא לְפָנָיו אֶת־יְפַת הָעָֽיִן</tei:l>
          <tei:l>וַתְּמָאֵן בִּדְבָרוֹ לֵאמֹר אָֽיִן</tei:l>
          <tei:l>הֵעֵ֥זָה פָ֝נֶ֗יהָ וַתֹּ֣אמַר לֽוֹ <tei:bibl>(משלי ז:יג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_khamokha_veein_kamokha_yehudah/13"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">לַ</tei:seg>קְּרוֹבִים אֵלָיו הַיּוֹשְׁבִים עֲלֵי כָן</tei:l>
          <tei:l>שָׁאַל וַיִּעָצֵֽהוּ מְמוּכָן</tei:l>
          <tei:l>הוּא הָמָן לְפֻרְעָנוּת מוּכָן</tei:l>
          <tei:l>לִבּ֗וֹ יִקְבׇּץ־אָ֥וֶן ל֑וֹ <tei:bibl>(תהלים מא:ז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_khamokha_veein_kamokha_yehudah/14"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מֹ</tei:seg>עֲצוֹתָיו כַּדָּת נְתוּנוֹת</tei:l>
          <tei:l>הָיוּ לְעַמִּי רְפוּאוֹת צְפוּנוֹת</tei:l>
          <tei:l>כִּי לוּלֵא אִגְּרוֹת רִאשׁוֹנוֹת</tei:l>
          <tei:l>וְגַם־פְּלֵיטָ֖ה לֹא־הָ֥יְתָה לּֽוֹ <tei:bibl>(יואל ב:ג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_khamokha_veein_kamokha_yehudah/15"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נ</tei:seg>וֹעַץ לִקְרֹא לְכׇל־הֲמוֹנָיו</tei:l>
          <tei:l>לְהָבִיא כׇל־יְפַת תֹּאַר לְפָנָיו</tei:l>
          <tei:l>וְהַֽנַּעֲרָ֗ה אֲשֶׁ֤ר תִּיטַב֙ <tei:bibl>(אסתר ב:ד)</tei:bibl> בְּעֵינָיו</tei:l>
          <tei:l>מָהֹ֛ר יִמְהָרֶ֥נָּה לּ֖וֹ <tei:bibl>(שמות כב:טו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_khamokha_veein_kamokha_yehudah/16"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">סַ</tei:seg>נְסַן לְיָאִיר הֵאִיר וְזָֽרַח</tei:l>
          <tei:l>יָשִׂ֥ישׂ כְּ֝גִבּ֗וֹר לָר֥וּץ אֹֽרַח <tei:bibl>(תהלים יט:ו)</tei:bibl></tei:l>
          <tei:l>טֶֽרֶם מַכָּה צִיץ רְפוּאָה פָֽרָח</tei:l>
          <tei:l>כִּֽי־הִפְלָ֣ה יְ֭הֹוָה חָסִ֣יד ל֑וֹ <tei:bibl>(תהלים ד:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_khamokha_veein_kamokha_yehudah/17"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">עִ</tei:seg>מּוֹ נֶאֶמְנָה הֲדַסָּה תַמָּה</tei:l>
          <tei:l>הִ֤יא אֶסְתֵּר֙ בַּת־דֹּד֔וֹ <tei:bibl>(אסתר ב:ז)</tei:bibl></tei:l>
          <tei:l>בָּרָה֙ כַּֽחַמָּ֔ה <tei:bibl>(שיר השירים ו:י)</tei:bibl></tei:l>
          <tei:l>וּבְמ֤וֹת אָבִ֙יהָ֙ וְאִמָּ֔הּ</tei:l>
          <tei:l>לְקָחָ֧הּ מׇרְדֳּכַ֛י ל֖וֹ <tei:bibl>(אסתר ב:ז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_khamokha_veein_kamokha_yehudah/18"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פָּ</tei:seg>גְעָה חֵן וַתֵּֽלֶךְ וַהֲלוֹם</tei:l>
          <tei:l>וַתִּלָּקַח אֶסְתֵּר אֶל־בֵּית הַמֶּֽלֶךְ גִּזְרַת יַהֲלוֹם</tei:l>
          <tei:l>וּמׇרְדְכַי צִוָּה־לָהּ לְכִי לְשָׁלוֹם</tei:l>
          <tei:l>כִּי־ה֥וּא אֲ֝דֹנַ֗יִךְ וְהִשְׁתַּֽחֲוִי־לֽוֹ <tei:bibl>(תהלים מה:יב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_khamokha_veein_kamokha_yehudah/19"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">צֶֽ</tei:seg>דֶק לָבְשָׁה בְּמַמְלַכְתָּהּ</tei:l>
          <tei:l>לֹא הִגִּידָה אֶסְתֵּר עַמָּהּ וּמוֹלַדְתָּהּ</tei:l>
          <tei:l>וְהַמֶּֽלֶךְ אֲהֵבָהּ וַיֶּֽרֶב תִּפְאַרְתָּהּ</tei:l>
          <tei:l>כִּ֥י מֵיְהֹוָ֖ה הָ֥יְתָה לּֽוֹ׃ <tei:bibl>(מלכים א׳ ב:טו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_khamokha_veein_kamokha_yehudah/20"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קֶ</tei:seg>שֶֽׁב רַב קָשַׁב צְר֨וֹר הַמֹּ֤ר <tei:bibl>(שיר השירים א:יג)</tei:bibl></tei:l>
          <tei:l>מִסָּרִיסֵי הַמֶּֽלֶךְ הַקְּבוּעִים לִשְׁמֹר</tei:l>
          <tei:l>וְהִנָּם חוֹשְׁבִים עַל הַמֶּֽלֶךְ לֵאמֹר</tei:l>
          <tei:l>הָ֥בָה נִֽתְחַכְּמָ֖ה ל֑וֹ <tei:bibl>(שמות א:י)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mi_khamokha_veein_kamokha_yehudah/21"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רָ</tei:seg>חֲשָׁה אֶסְתֵּר לַמֶּֽלֶךְ בְּאִמְרֵי שֶֽׁפֶר</tei:l>
          <tei:l>בְּשֵׁם מׇרְדְּכַי וְנִכְתַּב בַּסֵּֽפֶר</tei:l>
          <tei:l>בֻּקַּשׁ וְנִמְצָא לִפְנֵי צְבִי עֹפֶר</tei:l>
