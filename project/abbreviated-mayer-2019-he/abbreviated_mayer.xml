  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:abbreviated_mayer">
        <tei:head>קדיש יתום בלי מנין או אם לבד (אשכנז)‏</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:abbreviated_mayer/1"/>
        <tei:lg>
          <tei:l>בְּרִיךְ שְׁמֵיהּ דְּקוּדְשָׁא בְּרִיךְ הוּא</tei:l>
          <tei:l>(<tei:note type="instruction">על ימים נוראים:</tei:note> לְעֵילָא,) לְעֵילָא מִן־כָּל‪‬ בִּרְכָתָא שִׁירָתָא</tei:l>
          <tei:l>תֻּשְׁבְּחָתָא וְנֶחָמָתָא דַּאֲמִירָן בְּעָלְמָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:abbreviated_mayer/2"/>
        <tei:lg>
          <tei:l>תִּתְקַבַּל צְלוֹתִי וּבָעוּתִי</tei:l>
          <tei:l>עִם צְלוֹתְהוֹן וּבָעוּתְהוֹן דְּכָל־בֵּית יִשְׂרָאֵל</tei:l>
          <tei:l>קֳדָם אַבָּא דְּבִשְׁמַיָּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:abbreviated_mayer/3"/>
        <tei:lg>
          <tei:l>יְהֶא שְׁלָמָא רַבָּא מִן שְׁמַיָּא</tei:l>
          <tei:l>וְחַיִּים עָלַי‎ וְעַל כָּל־יִשְׂרָאֵל׃</tei:l>
          <tei:l>עֹשֶׂ֥ה שָׁ֝ל֗וֹם בִּמְרוֹמָֽיו</tei:l>
          <tei:l>הוּא יַעֲשֶׂה שָׁלוֹם עָלַי‎</tei:l>
          <tei:l>וְעַל כָּל־יִשְׂרָאֵל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:abbreviated_mayer/4"/>
        <tei:lg>
          <tei:l>אָמֵן וְאָמֵן</tei:l>
          <tei:l>כֵּן יְהִי רָצוֹן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
