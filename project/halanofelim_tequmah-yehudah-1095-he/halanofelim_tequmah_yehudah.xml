      <tei:div corresp="urn:x-opensiddur:text:poem:halanofelim_tequmah_yehudah">
        <tei:head>הֲלַנֹּפְלִים תְּקוּמָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:halanofelim_tequmah_yehudah/1"/>
        <tei:lg>
          <tei:l>הֲלַנֹּפְלִים תְּקוּמָה מִבּוֹר עֳנִי הׇטְבָּֽעוּ בּוֹ</tei:l>
          <tei:l>וְאִם יֵשׁ תְּרוּמָה לַיֹּרְדֵי בוֹר וְדוּמָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:halanofelim_tequmah_yehudah/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">י</tei:seg>וֹם חָרַב דְּבִירִי אַל תָּבוֹא בוֹ רְנָנָה</tei:l>
          <tei:l>כִּי נֶהְפַּךְ הֲדָרִי קָלוֹן וְשִׁירִי לְקִינָה</tei:l>
          <tei:l>וַיֶחֱשַׁךְ מְאוֹרִי וְתִשְׁכֹּן עָלָיו עֲנָנָה</tei:l>
          <tei:l>גַּם סַֽהַר וְחַמָּה בִּקְצֵה זְבוּל נִשְׁקָֽעוּ</tei:l>
          <tei:l>וְכוֹכְבֵי עָשׁ וְכִימָה יָרְדוּ לְתַחְתִּית אֲדָמָה׃</tei:l>
          <tei:l>הֲלַנֹּפְלִים...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:halanofelim_tequmah_yehudah/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הֲ</tei:seg>יֵשׁ אַחֲרִית וְתִכְלָה לָשׁוּב שְׁבוּת גָּלוּתִי</tei:l>
          <tei:l>וְאִם־תִּהְיֶה תְעָלָה לִי מִכְּאֵב מַחֲלָתִי</tei:l>
          <tei:l>בְּנֵי סְבָא וַחֲוִילָה יָרְשׁוּ גְּבוּל נַחֲלָתִי</tei:l>
          <tei:l>וּמָנַחַת וְתֵימָא תּוֹךְ אָהֳלִי יִרְגָּֽעוּ</tei:l>
          <tei:l>וָאֱהִי לְשַׁמָּה בִּידֵי נְבָיוֹת וְשַׁמָּה׃</tei:l>
          <tei:l>הֲלַנֹּפְלִים...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:halanofelim_tequmah_yehudah/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>עַד אָנָה אֱלֹהִים לִי תֶחֱרַשׁ וְתֶחֱשֶׁה</tei:l>
          <tei:l>וּבָנֶֽיךָ תְּמֵהִים נָפְלוּ כְצִפּוֹר בְּמוֹקְשֵׁי</tei:l>
          <tei:l>צָר תֹּהִים וְרֹהִים בִּידֵי אֲדֹנִים קָשֶׁה</tei:l>
          <tei:l>קוּם וַעֲשֵׂה נְקָמָה בָּהֶם וְהֵם יִכְנָֽעוּ</tei:l>
          <tei:l>וּלְמִגְדָּל וְחוֹמָה תִּהְיֶה לְלֹא רֻחָמָה׃</tei:l>
          <tei:l>הֲלַנֹּפְלִים...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:halanofelim_tequmah_yehudah/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">דְּ</tei:seg>לֵה מִבּוֹר יְגוֹנָם עַם קֶצְפְּךָ נָשָֽׂאוּ</tei:l>
          <tei:l>כִּי לִבָּם וְעֵינָם מוּל כִּסְאֲךָ נָשָֽׂאוּ</tei:l>
          <tei:l>וְהוֹצֵא אֶת־הֲמוֹנָם מִבֵּית כֶּֽלֶא הׇחְבָּאוּ</tei:l>
          <tei:l>כְּמֵאָז וּבְיָד רָמָה אֶל־בֵּיתְךָ יִסָּֽעוּ</tei:l>
          <tei:l>מִתֵּימָן וְקֵדְמָה מִבֵּין חֲדַד וְתֵימָא׃</tei:l>
          <tei:l>הֲלַנֹּפְלִים...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:halanofelim_tequmah_yehudah/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ה</tei:seg>וֹסֵף יָד יְדוּעָה לִקְנוֹת שְׁאֵרִית יוֹסֵף</tei:l>
          <tei:l>וְצוֹלֵעָה וְתוֹעָה לִצְבִי אֲרָצוֹת תְּאַסֵּף</tei:l>
          <tei:l>וְכׇל־נֶֽפֶשׁ בְּדֵעָה לְעׇבְדֶֽךָ תִּכָּסֵף</tei:l>
          <tei:l>וּבְפַֽחַד וְאֵימָה יוֹם יוֹם לְךָ יִכְרָֽעוּ</tei:l>
          <tei:l>כׇּל־בֶּֽרֶךְ וְקוֹמָה וּתְהַלֵּל כׇּל־נְשָׁמָה׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
