      <tei:div corresp="urn:x-opensiddur:text:poem:sim_shalom_for_the_tal_musaf_amidah_of_pesach">
        <tei:head>שים שלום למוסף טל</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:sim_shalom_for_the_tal_musaf_amidah_of_pesach/1"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">בארץ ישראל:</tei:note> כֹּהַנִים!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:sim_shalom_for_the_tal_musaf_amidah_of_pesach/2"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כהנים אומרים</tei:note>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְהֹוָה אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>אֲשֶׁר קִדְּשָֽׁנוּ בִּקְדֻשָּׁתוֹ שֶׁלְּאַהֲרֹן</tei:l>
          <tei:l>וְצִוָּֽנוּ לְבָרֵךְ אֶת־עַמּוֹ יִשְׂרָאֵל בְּאַהֲבָה׃</tei:l>
          <tei:l><tei:note type="instruction">קהל עונה:</tei:note> אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:sim_shalom_for_the_tal_musaf_amidah_of_pesach/3"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">כהנים אומרים: </tei:note> יְבָרֶכְךָ֥ יְהֹוָ֖ה וְיִשְׁמְרֶֽךָ׃ <tei:bibl>(במדבר ו:כד)</tei:bibl></tei:l>
          <tei:l><tei:note type="instruction">קהל עונה:</tei:note> אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:sim_shalom_for_the_tal_musaf_amidah_of_pesach/4"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">כהנים אומרים: </tei:note> יָאֵ֨ר יְהֹוָ֧ה ׀ פָּנָ֛יו אֵלֶ֖יךָ וִֽיחֻנֶּֽךָּ׃ <tei:bibl>(במדבר ו:כה)</tei:bibl></tei:l>
          <tei:l><tei:note type="instruction">קהל עונה:</tei:note> אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:sim_shalom_for_the_tal_musaf_amidah_of_pesach/5"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">כהנים אומרים: </tei:note> יִשָּׂ֨א יְהֹוָ֤ה ׀ פָּנָיו֙ אֵלֶ֔יךָ וְיָשֵׂ֥ם לְךָ֖ שָׁלֽוֹם׃ <tei:bibl>(במדבר ו:כו)</tei:bibl></tei:l>
          <tei:l><tei:note type="instruction">קהל עונה:</tei:note> אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:sim_shalom_for_the_tal_musaf_amidah_of_pesach/7"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">ש״ץ:</tei:note> אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ בָּרְכֵנוּ בַבְּרָכָה הַמְּשֻׁלֶּשֶׁת בַּתּוֹרָה הַכְּתוּבָה עַל־יְדֵי משֶׁה עַבְדֶּךָ הָאֲמוּרָה מִפִּי־אַהֲרֹן וּבָנָיו כֹּהֲנִים עַם קְדוֹשֶׁךָ כָּאָמוּר׃ יְבָרֶכְךָ֥ יְהֹוָ֖ה וְיִשְׁמְרֶֽךָ׃ <tei:bibl>(במדבר ו:כד)</tei:bibl></tei:l>
          <tei:l><tei:note type="instruction">קהל:</tei:note> כֵּן יְהִי רָצוֹן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:sim_shalom_for_the_tal_musaf_amidah_of_pesach/8"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">ש״ץ:</tei:note> יָאֵ֨ר יְהֹוָ֧ה ׀ פָּנָ֛יו אֵלֶ֖יךָ וִֽיחֻנֶּֽךָּ׃ <tei:bibl>(במדבר ו:כה)</tei:bibl></tei:l>
          <tei:l><tei:note type="instruction">קהל:</tei:note> כֵּן יְהִי רָצוֹן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:sim_shalom_for_the_tal_musaf_amidah_of_pesach/9"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">ש״ץ:</tei:note> יִשָּׂ֨א יְהֹוָ֤ה ׀ פָּנָיו֙ אֵלֶ֔יךָ וְיָשֵׂ֥ם לְךָ֖ שָׁלֽוֹם׃ <tei:bibl>(במדבר ו:כו)</tei:bibl></tei:l>
          <tei:l><tei:note type="instruction">קהל:</tei:note> כֵּן יְהִי רָצוֹן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:sim_shalom_for_the_tal_musaf_amidah_of_pesach/10"/>
        <tei:lg>
          <tei:l>שִׂים שָׁלוֹם טוֹבָה וּבְרָכָה חֵן וָחֶסֶד וְרַחֲמִים עָלֵינוּ וְעַל־כׇּל־יִשְׂרָאֵל עַמֶּךָ׃ בָּרְכֵנוּ אָבִינוּ כֻּלָּנוּ כְּאֶחָד בְּאוֹר פָּנֶיךָ כִּי בְאוֹר פָּנֶיךָ נָתַתָּ לָּֽנוּ יהוה אֱלֹהֵינוּ תּוֹרַת חַיִּים וְאַהֲבַת חֶסֶד וּצְדָקָה וּבְרָכָה וְרַחֲמִים וְחַיִּים וְשָׁלוֹם׃ וְטוֹב בְּעֵינֶיךָ לְבָרֵךְ אֶת עַמְּךָ יִשְׂרָאֵל בְּכׇל־עֵת וּבְכׇל־שָׁעָה בִּשְׁלוֹמֶךָ:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:sim_shalom_for_the_tal_musaf_amidah_of_pesach/11"/>
        <tei:lg>
          <tei:l>וְכָתוּב —</tei:l>
          <tei:l>אֶשְׁמְעָ֗ה מַה־יְדַבֵּר֮ הָאֵ֢ל ׀ יְ֫הֹוָ֥ה</tei:l>
          <tei:l>כִּ֤י ׀ יְדַבֵּ֬ר שָׁל֗וֹם</tei:l>
          <tei:l>אֶל־עַמּ֥וֹ וְאֶל־חֲסִידָ֑יו</tei:l>
          <tei:l>וְאַל־יָשׁ֥וּבוּ לְכִסְלָֽה׃ <tei:bibl>(תהלים פה:ט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:sim_shalom_for_the_tal_musaf_amidah_of_pesach/12"/>
        <tei:lg>
          <tei:l>וְכָתוּב —</tei:l>
          <tei:l>כִּי־בִ֭י יִרְבּ֣וּ יָמֶ֑יךָ</tei:l>
          <tei:l>וְיוֹסִ֥יפוּ לְּ֝ךָ֗ שְׁנ֣וֹת חַיִּֽים׃</tei:l>
          <tei:l>לְחַיִּים טוֹבִים תִּכְתְּבֵֽנוּ</tei:l>
          <tei:l>לִבְרָכָה תוֹתִירֵֽנוּ</tei:l>
          <tei:l>לִפְלֵטָה תַשְׁאִירֵֽנוּ</tei:l>
          <tei:l>וְנִהְיֶה כֻלָּֽנוּ חַיִּים דְּבֵקֵי בֵּאלֹהִים חַיִּים <tei:bibl>(משלי ט:יא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:sim_shalom_for_the_tal_musaf_amidah_of_pesach/13"/>
        <tei:lg>
          <tei:l>כַּכָּתוּב —</tei:l>
          <tei:l>וְאַתֶּם֙ הַדְּבֵקִ֔ים בַּיהֹוָ֖ה אֱלֹהֵיכֶ֑ם</tei:l>
          <tei:l>חַיִּ֥ים כֻּלְּכֶ֖ם הַיּֽוֹם׃ <tei:bibl>(דברים ד:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:sim_shalom_for_the_tal_musaf_amidah_of_pesach/14"/>
        <tei:lg>
          <tei:l>הַיּֽוֹם תְּאַמְּצֵֽנוּ׃ <tei:note type="instruction">הקהל:</tei:note> אָמֵן׃</tei:l>
          <tei:l>הַיּֽוֹם תְּבָרְכֵֽנוּ׃ <tei:note type="instruction">הקהל:</tei:note> אָמֵן׃</tei:l>
          <tei:l>הַיּֽוֹם תְּגַדְּלֵֽנוּ׃ <tei:note type="instruction">הקהל:</tei:note> אָמֵן׃</tei:l>
          <tei:l>הַיּֽוֹם תִּדְרְשֵֽׁנוּ לְטוֹבָה׃ <tei:note type="instruction">הקהל:</tei:note> אָמֵן׃</tei:l>
          <tei:l>הַיּֽוֹם תְּהַדְּרֵֽנוּ׃ <tei:note type="instruction">הקהל:</tei:note> אָמֵן׃</tei:l>
          <tei:l>הַיּֽוֹם תְּוַועֲדֵֽנוּ׃ <tei:note type="instruction">הקהל:</tei:note> אָמֵן׃</tei:l>
          <tei:l>הַיּֽוֹם תְּזַכֵּֽנוּ׃ <tei:note type="instruction">הקהל:</tei:note> אָמֵן׃</tei:l>
          <tei:l>הַיּֽוֹם תְּחׇנֵּֽנוּ׃ <tei:note type="instruction">הקהל:</tei:note> אָמֵן׃</tei:l>
          <tei:l>הַיּֽוֹם תְּטַהֲרֵֽנוּ מִכׇּל־טֻמְאוֹתֵֽינוּ׃ <tei:note type="instruction">הקהל:</tei:note> אָמֵן׃</tei:l>
          <tei:l>הַיּֽוֹם תִּשְׁמַע שַׁוְעָתֵֽנוּ׃ <tei:note type="instruction">הקהל:</tei:note> אָמֵן׃</tei:l>
          <tei:l>הַיּֽוֹם תְּקַבֵּל בְּרַחֲמִים וּבְרָצוֹן אֶת־תְּפִלָּתֵֽנוּ׃ <tei:note type="instruction">הקהל:</tei:note> אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:sim_shalom_for_the_tal_musaf_amidah_of_pesach/15"/>
        <tei:lg>
          <tei:l>הַיּֽוֹם תְּבִיאֵֽנוּ לְבֵיתֶֽךָ שָׂשִׂים וּשְׂמֵחִים</tei:l>
          <tei:l>כַּכָּתוּב —</tei:l>
          <tei:l>וַהֲבִיאוֹתִ֞ים אֶל־הַ֣ר קׇדְשִׁ֗י</tei:l>
          <tei:l>וְשִׂמַּחְתִּים֙ בְּבֵ֣ית תְּפִלָּתִ֔י</tei:l>
          <tei:l>עוֹלֹתֵיהֶ֧ם וְזִבְחֵיהֶ֛ם</tei:l>
          <tei:l>לְרָצ֖וֹן עַֽל־מִזְבְּחִ֑י כִּ֣י בֵיתִ֔י</tei:l>
          <tei:l>בֵּית־תְּפִלָּ֥ה יִקָּרֵ֖א לְכׇל־הָעַמִּֽים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:sim_shalom_for_the_tal_musaf_amidah_of_pesach/16"/>
        <tei:lg>
          <tei:l>וְשָׁנָה טוֹבָה <tei:note type="instruction">הקהל:</tei:note> אָמֵן׃</tei:l>
          <tei:l>שָׁנָה טְלוּלָה <tei:note type="instruction">הקהל:</tei:note> אָמֵן׃</tei:l>
          <tei:l>שָׁנָה דְשׁוּנָה <tei:note type="instruction">הקהל:</tei:note> אָמֵן׃</tei:l>
          <tei:l>שָׁנָה שְׁחוּנָה <tei:note type="instruction">הקהל:</tei:note> אָמֵן׃</tei:l>
          <tei:l>שָׁנָה אֲסוּמָה <tei:note type="instruction">הקהל:</tei:note> אָמֵן׃</tei:l>
          <tei:l>שְׁנַת זוֹל <tei:note type="instruction">הקהל:</tei:note> אָמֵן׃</tei:l>
          <tei:l>שְׁנַת שֹֽׂבַע <tei:note type="instruction">הקהל:</tei:note> אָמֵן׃</tei:l>
          <tei:l>שְׁנַת חַיִּים <tei:note type="instruction">הקהל:</tei:note> אָמֵן׃</tei:l>
          <tei:l>שְׁנַת שָׁלוֹם <tei:note type="instruction">הקהל:</tei:note> אָמֵן׃</tei:l>
          <tei:l>שְׁנַת הַשְׁקֵט <tei:note type="instruction">הקהל:</tei:note> אָמֵן׃</tei:l>
          <tei:l>שְׁנַת רֶוַח וְהַצָּלָה <tei:note type="instruction">הקהל:</tei:note> אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:sim_shalom_for_the_tal_musaf_amidah_of_pesach/17"/>
        <tei:lg>
          <tei:l>שְׁנַת יְשׁוּעָה וּפְדוּת וּפֻרְקָן</tei:l>
          <tei:l>תִּהְיֶה לְכֻלָּנוּ</tei:l>
          <tei:l>וּלְכׇל־עַמְּךָ בֵּית יִשְׂרָאֵל</tei:l>
          <tei:l>בְּרֹב עֹז וְשָׁלוֹם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:sim_shalom_for_the_tal_musaf_amidah_of_pesach/18"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה עוֹשֶׂה הַשָׁלוֹם׃</tei:l>
          <tei:l><tei:note type="instruction">הקהל:</tei:note> אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
