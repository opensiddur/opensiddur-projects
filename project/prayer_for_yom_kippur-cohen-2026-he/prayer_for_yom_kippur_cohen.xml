    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_yom_kippur_cohen">
        <tei:head>תפילה ליום הכיפורים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_yom_kippur_cohen/1"/>
        <tei:lg>
          <tei:l>‏אֵל מְלֵאַת רַחֲמִים, שׁוֹכֶנֶת בַּמְּרוֹמִים</tei:l>
          <tei:l>אֲשֶׁר בָּרָאת עוֹלָם וּמְלוֹאוֹ יֵשׁ מֵאַיִן</tei:l>
          <tei:l>הַמְצִיאִי בְּנוֹ</tei:l>
          <tei:l>רַחֲמִים מֵעֵבֶר לַכְּאֵב</tei:l>
          <tei:l>‏אֶמְפַּתְיָה מֵעֵבֶר לַפַּחַד</tei:l>
          <tei:l>‏הַכָּרָה מֵעֵבֶר לַאֲטִימוּת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_yom_kippur_cohen/2"/>
        <tei:lg>
          <tei:l>הַפַּח נִשְׁבָּר וַאֲנַחְנוּ נִמְלָטְנוּ</tei:l>
          <tei:l>הַהֲזָיָה נִשְׁבְּרָה וְהַפַּח הוּא אֲנַחְנוּ</tei:l>
          <tei:l>יָדֵינוּ דָּמִים מָלְאוּ וְלֹא דָמֵינוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_yom_kippur_cohen/3"/>
        <tei:lg>
          <tei:l>אֵם הָרַחֲמִים וְהַסְּלִיחוֹת הַתְּהִילּוֹת וְהַקִּינוֹת</tei:l>
          <tei:l>בְּלִי רְשׁוּת בָּאנוּ לְפָנַיִךְ בְּחִיל וּרְעָדָה</tei:l>
          <tei:l>שִׁלְחִי אֶת עֲווֹנֵנוּ עַל גַּב הַשָּׂעִיר</tei:l>
          <tei:l>בִּמְקוֹמֵנוּ יָמוּת וַאֲנַחְנוּ נִתְאַבֵּל</tei:l>
          <tei:l>כִּי חֲטָאֵינוּ כַּשָּׁנִים, הִלְבִּינָם כַּשֶּׁלֶג</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_yom_kippur_cohen/4"/>
        <tei:lg>
          <tei:l>אָנָּא ה׳ הַשְׁכִּינִי בְּתוֹכֵנוּ</tei:l>
          <tei:l>כֹּחַ לְהִתְאַבֵּל עַל הָאַחֵר</tei:l>
          <tei:l>כֹּשֶׁר לְהִסְתַּכֵּל עַל הַהֶרֶס</tei:l>
          <tei:l>אֹמֶץ לִבְכּוֹת אֶת הָאָדָם בַּאֲשֶׁר הוּא/הִיא אָדָם</tei:l>
        </tei:lg>
      </tei:div>
