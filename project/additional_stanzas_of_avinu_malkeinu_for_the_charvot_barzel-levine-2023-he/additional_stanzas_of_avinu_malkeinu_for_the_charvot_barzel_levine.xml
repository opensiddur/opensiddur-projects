    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:additional_stanzas_of_avinu_malkeinu_for_the_charvot_barzel_levine">
        <tei:head>בָּתֵּי תּוֹסֶפֶת לְ”אָבִינוּ מַלְכֵּנוּ“ לְמִלְחֶמֶת ”חַרְבוֹת בַּרְזֶל“‏</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:additional_stanzas_of_avinu_malkeinu_for_the_charvot_barzel_levine/1"/>
        <tei:lg>
          <tei:l>אָבִינוּ מַלְכֵּנוּ,</tei:l>
          <tei:l>בָּרֵךְ אֶת חַיָּלֵי צְבָא הַהֲגָנָה לְיִשְׂרָאֵל,</tei:l>
          <tei:l>כּוֹחוֹת הַבִּטָּחוֹן וְשׁוֹטְרֵי מִשְׁטֶרֶת יִשְׂרָאֵל,</tei:l>
          <tei:l>הָעוֹמְדִים עַל מִשְׁמַר אַרְצֵנוּ וְעָרֵי אֱלֹהֵינוּ</tei:l>
          <tei:l>וְלוֹחֲמִים אֶת מִלְחַמְתֵּנוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:additional_stanzas_of_avinu_malkeinu_for_the_charvot_barzel_levine/2"/>
        <tei:lg>
          <tei:l>אָבִינוּ מַלְכֵּנוּ,</tei:l>
          <tei:l>הִנְחִילָנוּ נִצָּחוֹן שָׁלֵם, גָּמוּר וּמֻחְלָט</tei:l>
          <tei:l>עַל אוֹיְבֵינוּ וּמְבַקְּשֵׁי רָעָתֵנוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:additional_stanzas_of_avinu_malkeinu_for_the_charvot_barzel_levine/3"/>
        <tei:lg>
          <tei:l>אָבִינוּ מַלְכֵּנוּ,</tei:l>
          <tei:l>הָשֵׁב אֶת כְּלַל הַחֲטוּפִים וְהַשְּׁבוּיִים</tei:l>
          <tei:l>לְחֵיק מְדִינַת יִשְׂרָאֵל.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:additional_stanzas_of_avinu_malkeinu_for_the_charvot_barzel_levine/4"/>
        <tei:lg>
          <tei:l>אָבִינוּ מַלְכֵּנוּ,</tei:l>
          <tei:l>עֲשֵׂה שֶׁכָּל הָאֶזְרָחִים וְהַחַיָּלִים הַנֶּעְדָּרִים</tei:l>
          <tei:l>יִמָּצְאוּ וִיאֻתְּרוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:additional_stanzas_of_avinu_malkeinu_for_the_charvot_barzel_levine/5"/>
        <tei:lg>
          <tei:l>אָבִינוּ מַלְכֵּנוּ,</tei:l>
          <tei:l>הַמְשֵׁךְ רְפוּאָה שְׁלֵמָה לְכָל הַפְּצוּעִים,</tei:l>
          <tei:l>רְפוּאַת הַגּוּף וּרְפוּאַת הַנֶּפֶשׁ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:additional_stanzas_of_avinu_malkeinu_for_the_charvot_barzel_levine/6"/>
        <tei:lg>
          <tei:l>אָבִינוּ מַלְכֵּנוּ,</tei:l>
          <tei:l>שְׁלַח עֶזְרְךָ מִקֹּדֶשׁ</tei:l>
          <tei:l>לְכָל הָרוֹפְאִים וְהַצְּוָתִים הָרְפוּאִיִּים</tei:l>
          <tei:l>הָעוֹסְקִים בְּרִפּוּי הַנִּפְגָּעִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:additional_stanzas_of_avinu_malkeinu_for_the_charvot_barzel_levine/7"/>
        <tei:lg>
          <tei:l>אָבִינוּ מַלְכֵּנוּ,</tei:l>
          <tei:l>הַצְלַח אֶת דַּרְכָּם שֶׁל כְּלַל הַמִּתְנַדְּבִים בָּעָם,<tei:anchor xml:id="note_1"/></tei:l>
          <tei:l>הַמְּסַיְּעִים בָּעֵת הַזֹּאת לַמַּאֲמָץ הַמִּלְחַמְתִּי,</tei:l>
          <tei:l>בֵּין בַּחֲזִית בֵּין בָּעֹרֶף.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:additional_stanzas_of_avinu_malkeinu_for_the_charvot_barzel_levine/8"/>
        <tei:lg>
          <tei:l>אָבִינוּ מַלְכֵּנוּ,</tei:l>
          <tei:l>חַזֵּק אֶת יְדֵי מִשְׁפְּחוֹת הַשְּׁכוֹל,</tei:l>
          <tei:l>וּמִשְׁפְּחוֹת הַחֲטוּפִים,</tei:l>
          <tei:l>הַנֶּעֱדָרִים</tei:l>
          <tei:l>וְהַפְּצוּעִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:additional_stanzas_of_avinu_malkeinu_for_the_charvot_barzel_levine/9"/>
        <tei:lg>
          <tei:l>אָבִינוּ מַלְכֵּנוּ,</tei:l>
          <tei:l>אַמֵּץ אֶת הָעָם הַיּוֹשֵׁב בְּצִיּוֹן</tei:l>
          <tei:l>וְאֶת יְהוּדֵי הַתְּפוּצוֹת.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:additional_stanzas_of_avinu_malkeinu_for_the_charvot_barzel_levine/10"/>
        <tei:lg>
          <tei:l>אָבִינוּ מַלְכֵּנוּ,</tei:l>
          <tei:l>פְּקֹד כַּנָּה אֲשֶׁר נָטְעָה יְמִינֶךָ</tei:l>
          <tei:l>לְטוֹבָה וְלִבְרָכָה,</tei:l>
          <tei:l>וְחַדֵּשׁ יָמֵינוּ כְּקֶדֶם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:additional_stanzas_of_avinu_malkeinu_for_the_charvot_barzel_levine/11"/>
        <tei:lg>
          <tei:l>אָבִינוּ מַלְכֵּנוּ,</tei:l>
          <tei:l>שִׂים שָׁלוֹם וְאַחְדוּת</tei:l>
          <tei:l>בֵּין עַמְּךָ יִשְׂרָאֵל</tei:l>
          <tei:l>מֵעַתָּה וְעַד עוֹלָם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:additional_stanzas_of_avinu_malkeinu_for_the_charvot_barzel_levine/12"/>
        <tei:lg>
          <tei:l>אָבִינוּ מַלְכֵּנוּ,</tei:l>
          <tei:l>קוּם וְרַחֵם צִיּוֹן</tei:l>
          <tei:l>כִּי עֵת לְחֶנְנָהּ</tei:l>
          <tei:l>כִּי בָא מוֹעֵד.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
