  <tei:standOff type="notes">
    <tei:note type="commentary" n="1" target="#note_1">
      <tei:p>Isaiah 2:4, Micah 4:3</tei:p>
    </tei:note>
    <tei:note type="commentary" n="2" target="#note_2">
      <tei:p>Lines from the “Star Spangled Banner” by Francis Scott Key (1814).</tei:p>
    </tei:note>
  </tei:standOff>
