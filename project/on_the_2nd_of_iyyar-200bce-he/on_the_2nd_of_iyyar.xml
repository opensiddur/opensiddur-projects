      <tei:div corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar">
        <tei:head>בְּחֹדֶשׁ אִיָּר בִּשְׁנַיִם</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/1"/>
        <tei:lg>
          <tei:l>בְּחֹדֶ֗שׁ אִיָּר֮ בִּשְׁנַ֪יִם בַּ֫חֹדֶ֥שׁ</tei:l>
          <tei:l>רָאִ֣יתִי בַּ֭מַּרְאָה וְכׇל־נְבוּאָ֑יו</tei:l>
          <tei:l>וְהִתְפַּלַּ֗לְתִּי לִפְנֵ֥י יְ֝הֹוָ֗ה וְאָמַרְתִּֽי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/2"/>
        <tei:lg>
          <tei:l>יְהִ֨י רַחֲמֶ֬יךָ<tei:anchor xml:id="note_1"/> יְהֹוָ֗ה אֱלֹהֵ֮ינוּ֮ עַל־צֹא֪ן הַ֫הֲרִיגָ֥ה</tei:l>
          <tei:l>אֲשֶׁ֣ר הֲרָג֣וּהָ רוֹעִ֑ים וְלֹא־חָמְל֥וּ עֲלֵיהֶֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/3"/>
        <tei:lg>
          <tei:l>חֲבֹ֣שׁ בְּ֭רַחֲמֶֽיךָ<tei:anchor xml:id="note_2"/> עֲצָמ֣וֹת דַּכּ֑וֹת</tei:l>
          <tei:l>וּרְפָ֥א בְּאַהֲבָ֖ה אֶת־שִׁבְרֵ֣י נַחֲלָתֶֽךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/4"/>
        <tei:lg>
          <tei:l>כִּ֤י לְט֣וֹב הָ֭עוֹלָם הֶעֱמַדְתַּ֣נִי לְפָנֶי֑ךָ</tei:l>
          <tei:l>וּלְא֥וֹר הַ֝גּוֹיִ֗ם נְתַתָּ֥נִי בְּעֻזֶּֽךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/5"/>
        <tei:lg>
          <tei:l>כׇּל־הָאֻמִּ֣ים יְסַפְּר֣וּ כְבוֹדֶ֑ךָ</tei:l>
          <tei:l>כִּ֤י יִרְא֣וּ צִ֝דְקָתְךָ֗ עַל־יַ֥ד נֶאֱמָנֶֽךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/6"/>
        <tei:lg>
          <tei:l>יִקְבְּצ֣וּ סְ֭גָנִים<tei:anchor xml:id="note_3"/> וְכׇל־מַ֣לְכֵי אָ֑רֶץ</tei:l>
          <tei:l>רוֹזְנֵ֥י תֵּבֵ֖ל וּמוֹשְׁלֵ֣י אָדָֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/7"/>
        <tei:lg>
          <tei:l>לִרְא֣וֹת אַתְּ־גְּבוּר֣וֹת יְמִינֶ֑ךָ</tei:l>
          <tei:l>וּלְהָבִ֤ין אֶת־ס֣וֹף דִּבְרֵ֣י קׇדְשֶֽׁךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/8"/>
        <tei:lg>
          <tei:l>וְיָדְע֣וּ כֻּלָּ֣ם אֶת־גְּבוּרָתֶ֑ךָ</tei:l>
          <tei:l>כִּ֤י יָדְךָ֣ יְ֝הֹוָ֗ה עֹשֶׂ֥ה כׇל־אֵֽלֶּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/9"/>
        <tei:lg>
          <tei:l>יִשְׂמַ֣ח צַ֭דִּיק כִּ֣י יִ֣רְאֶה זֹ֑את וְיָגִ֥יל לְ֝פָנֶ֗יךָ</tei:l>
          <tei:l>בְּשִׁיר֣וֹת וְהוֹדָאֽוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/10"/>
        <tei:lg>
          <tei:l>יִלְמְד֣וּ מִ֭מֶּֽנִּי כׇּל־יוֹשְׁבֵ֣י תֵּבֵ֑ל</tei:l>
          <tei:l>וְיָשׁ֥וּבוּ אֶל־דַּ֝רְכְּךָ֗ וְיַעַבְד֥וּךְ בֶּאֱמוּנָֽה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/11"/>
        <tei:lg>
          <tei:l>וִיקַדְּמ֣וּ פָּנֶ֣יךָ בְּתוֹדָ֣ה</tei:l>
          <tei:l>בִּ֝זְמִיר֗וֹת וּבְשִׁיר֥וֹת וְהוֹדָאֽוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/12"/>
        <tei:lg>
          <tei:l>יִגְדְּל֣וּ כְּ֭בוֹדְךָ בְּת֣וֹךְ מַחֲנוֹתָ֑ם</tei:l>
          <tei:l>וְיָדְע֗וּ כִּי־אַתָּ֣ה יְ֝הֹוָ֗ה בְּרָאתָֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/13"/>
        <tei:lg>
          <tei:l>וְיֵב֣וֹשׁוּ כׇּל־ע֣וֹבְדֵי סֵ֑מֶל</tei:l>
          <tei:l>כִּ֖י יְחַכְּמ֣וּ בִּפְסִילֵֽיהֶם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/14"/>
        <tei:lg>
          <tei:l>לֹא־יַעַבְד֣וּ ע֭וֹד אֶת־אֱלִילִ֑ים</tei:l>
          <tei:l>וְלֹ֤א יִשְׁתַּחֲו֣וּ לָ֝עַ֗ד לְמַעֲשֵׂ֥ה יְדֵיהֶֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/15"/>
        <tei:lg>
          <tei:l>וְהָאֱלִילִ֣ים כָּלִ֣יל יַחֲלֹ֑פוּ</tei:l>
          <tei:l>מַ֝חְמַדֵּיהֶ֗ם יֹאבְד֥וּ לָנֶֽצַח׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/16"/>
        <tei:lg>
          <tei:l>וְתִתְגַּדֵּ֬ל וְתִתְקַדֵּ֗שׁ מִפִּ֖י כׇּל־מַעֲשֶׂ֑יךָ<tei:anchor xml:id="note_5"/></tei:l>
          <tei:l>מֵעַתָּ֥ה וְעַד־עוֹלָֽם:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/17"/>
        <tei:lg>
          <tei:l>כִּ֣י עַ֭בְדְּךָ יְסַפֵּ֣ר מִנִּפְלְאוֹתֶ֑ךָ</tei:l>
          <tei:l>כַּאֲשֶׁ֥ר כּ֝וֹח֗וֹ וְר֥וּחַ דְּבָרָֽיו׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/18"/>
        <tei:lg>
          <tei:l>כִּ֗י אֵין־לִ֭י שִׂמְחַ֣ת כׇּל־דָּבָ֑ר</tei:l>
          <tei:l>כִּי־אִ֣ם דְּ֝בָרֶ֗יךָ וּמַרְאֵ֣ה כְּבוֹדֶֽךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/19"/>
        <tei:lg>
          <tei:l>אַל־תַּסְתִּ֣יר מִ֭מֶּֽנִּי בְּרַחֲמֶ֣יךָ<tei:anchor xml:id="note_6"/> הָרַבִּ֑ים</tei:l>
          <tei:l>וְאַל־תְּ֝מִיתֵ֗נִי בַּעֲב֥וּר אַהֲבָתָֽם:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/20"/>
        <tei:lg>
          <tei:l>כִּ֣י אָ֭הַֽבְתִּי מָע֣וֹן<tei:anchor xml:id="note_7"/> בֵּיתֶ֑ךָ</tei:l>
          <tei:l>מִכֹּ֖ל הֵיכְלֵ֣י מְלָכִיֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/21"/>
        <tei:lg>
          <tei:l>טֽוֹב־לִ֥י תוֹרַת־פִּ֑יךָ</tei:l>
          <tei:l>מֵאֶ֥לֶף אֲ֝לָפִ֗ים כִּכְּרֵ֥י זָהָֽב׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/22"/>
        <tei:lg>
          <tei:l>טֽוֹב־לִ֥י קִדּוּשׁ־דְּבָרֶ֑ךָ</tei:l>
          <tei:l>מִכֹּ֖ל כְּלִ֣י חֶמְדָּֽה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/23"/>
        <tei:lg>
          <tei:l>טֽוֹב־לִי֮ מִצְוֺ֪ת רְ֫צוֹנֶ֥ךָ</tei:l>
          <tei:l>מִכׇּל־אֲבָנִ֣ים ט֭וֹבוֹת וּמַרְגָּלִיּ֑וֹת חֶפְצֵ֥י מְלָכִֽים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/24"/>
        <tei:lg>
          <tei:l>אַשְׁרֵ֗י שֶׁיִּמְצָ֣א כָּ֭בוֹד בְּחֶפְצֵ֣י רְצוֹנֶ֑ךָ</tei:l>
          <tei:l>וּבַעֲבוּרְךָ֥ אֲ֝נִ֗י כֵּן־אֶשְׁאַ֥ל מִפָּנֶֽיךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/25"/>
        <tei:lg>
          <tei:l>וְזֶ֣ה חֶ֭פְצִי עַל־כׇּל־בַּקָּשׁוֹתַ֑י</tei:l>
          <tei:l>כִּי־אֶחְיֶ֥ה לְ֝פָנֶ֗יךָ תָּמִֽיד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/26"/>
        <tei:lg>
          <tei:l>וַאֲהַלֵּ֬ךְ בְּצִדְקָתְךָ֗ בְּלֹ֘א־עָוֺ֥ן וְאֶרְדֹּ֣ף<tei:anchor xml:id="note_9"/></tei:l>
          <tei:l>בַּאֲמִתְּךָ֣ כׇּל־י֑וֹם כַּ֝אֲשֶׁ֗ר יֻשַּׁ֥ר בְּעֵינֶֽיךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/27"/>
        <tei:lg>
          <tei:l>אַל־תִּמְנַ֣ע מִ֭מֶּֽנִּי אֶת־שְׁאֵלָתִ֑י</tei:l>
          <tei:l>וַעֲשֵׂ֥ה בַּקָּשָׁתִ֖י כְּחֶפְצֵ֣י רְצוֹנֶֽךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/28"/>
        <tei:lg>
          <tei:l>אֶעֱמֹ֣ד בָּהֶ֣ם עַד־עוֹלָ֑ם</tei:l>
          <tei:l>לְ֝דַעַ֗ת כׇּל־נְתִיבֵ֥י צִדְקֶֽךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/29"/>
        <tei:lg>
          <tei:l>בָּר֣וּךְ אֵ֭ל עֹ֣שֶׂה זֹ֑את</tei:l>
          <tei:l>בָּ֝ר֗וּךְ פּוֹעֵ֥ל אֶת־כׇּל־אֵֽלֶּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/30"/>
        <tei:lg>
          <tei:l>בָּר֗וּךְ אֲשֶׁ֣ר בָּחַ֣ר בְּעַבְדּ֑וֹ</tei:l>
          <tei:l>וַיְמַלֵּ֣א אוֹתִ֖י כׇּל־מִשְׁאֲל֣וֹת לִבִּֽי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/31"/>
        <tei:lg>
          <tei:l>בָּ֭רוּךְ שֵׁ֣ם כְּב֣וֹד מַלְכוּת֑וֹ לְ֝עוֹלָ֗ם וָעֶֽד׃</tei:l>
          <tei:l>בָּ֭רוּךְ שֵׁ֣ם כְּבוֹד֑וֹ לְ֝עוֹלָ֗ם וְעַֽד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_2nd_of_iyyar/32"/>
        <tei:lg>
          <tei:l>בָּ֤רֽוּךְ־יְהֹוָ֨ה אֱלֹהֵ֪י יִשְׂרָאֵ֡ל מִן־הָ֤עוֹלָ֨ם ׀ וְעַ֬ד הָעוֹלָ֗ם</tei:l>
          <tei:l>וְאָמַ֖ר כׇּל־הָעָ֥ם אָמֵֽן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
