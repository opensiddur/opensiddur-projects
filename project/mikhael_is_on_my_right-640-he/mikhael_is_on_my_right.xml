  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:mikhael_is_on_my_right">
        <tei:head>מִימִינִי מִיכָאֵל</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mikhael_is_on_my_right/1"/>
        <tei:lg>
          <tei:l>בְּשֵׁם יְיָ אֱלֹהֵי יִשְׂרָאֵל</tei:l>
          <tei:l>מִימִינִי מִיכָאֵל</tei:l>
          <tei:l>וּמִשְּׂמֹֽאלִי גַּבְרִיאֵל</tei:l>
          <tei:l>וּמִלְּפָנַי אֽוּרִיאֵל</tei:l>
          <tei:l>וּמֵאָחוֹרַי רְפָאֵל</tei:l>
          <tei:l>וְעַל רֹאשִׁי שְׁכִֽינַת אֵל׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
