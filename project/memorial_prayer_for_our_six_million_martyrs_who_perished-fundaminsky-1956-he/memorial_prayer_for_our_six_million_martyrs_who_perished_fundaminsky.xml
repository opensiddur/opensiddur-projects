    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:memorial_prayer_for_our_six_million_martyrs_who_perished_fundaminsky">
        <tei:head>תְּפִלַּת הַזְכָּרָה לַנְּשָׁמוֹת שֵׁשׁ מֵאוֹת רִבּוֹא קִדּוּשֵׁנוּ שׁוֹאַת תרצ״ט-תש״ה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:memorial_prayer_for_our_six_million_martyrs_who_perished_fundaminsky/2"/>
        <tei:lg>
          <tei:l>אֱׄלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ,</tei:l>
          <tei:l>בּׄוֹרְׄאֵֽנוּ וְצוּר יְשׁוּעָתֵֽנוּ,</tei:l>
          <tei:l>הַׄבִּֽיטָה מִׄמְּרוֹמֶֽיךָ וּרְאֵה בְעָנְיֵֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:memorial_prayer_for_our_six_million_martyrs_who_perished_fundaminsky/3"/>
        <tei:lg>
          <tei:l>אָתָֽאנוּ לְפָנֶֽיךָ בְּשִׁבְרוֹן לִבֵּֽנוּ,</tei:l>
          <tei:l>דְָּפַֽקְנוּ דְלָתֶֽיךָ בְּדִכְאוֹן רוּחֵנוּ,</tei:l>
          <tei:l>הַאֲזִֽינָה לְקוֹל תַּחֲנוּנֵֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:memorial_prayer_for_our_six_million_martyrs_who_perished_fundaminsky/4"/>
        <tei:lg>
          <tei:l>לִבֵּֽנוּ נִשְׁבַּר בְּקִרְבֵּֽנוּ,</tei:l>
          <tei:l>כַּחֲלִילִים יֶחֱמוּ מֵעֵֽינוּ,</tei:l>
          <tei:l>בְּזָכְרֵֽנוּ שֵׁשׁ מֵאוֹת רִבּוֹא חֲלָלֵֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:memorial_prayer_for_our_six_million_martyrs_who_perished_fundaminsky/5"/>
        <tei:lg>
          <tei:l>לִזְאֵבֵי־אָדָם נִמְכְּרוּ אַחֵֽינוּ,</tei:l>
          <tei:l>לִפְרִיצֵי־חַיּוֹת נִמְסְרוּ אַחְיוֹתֵֽנוּ,</tei:l>
          <tei:l>טֶֽרֶף לְחֶלְאַת־הָאָדָם הָיוּ עוֹלָלֵֽינוּ וְטַפֵּֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:memorial_prayer_for_our_six_million_martyrs_who_perished_fundaminsky/6"/>
        <tei:lg>
          <tei:l>מָֽוֶת שְׁכֹל וְאַלְמוֹן עָלוּ בְּחַלּוֹנֵֽינוּ,</tei:l>
          <tei:l>הוֹרִים וְטִפּוּחֵיהֶם נִשְׂרְפוּ לְעֵינֵֽינוּ,</tei:l>
          <tei:l>וּבְחַדְרֵי־גָז גָּוְעוּ בְּאֶחָד אֱלֹהֵֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:memorial_prayer_for_our_six_million_martyrs_who_perished_fundaminsky/7"/>
        <tei:lg>
          <tei:l>מְאוֹרוֹת יִשְׂרָאֵל כָּבוּ בִּמְעוֹנוֹתֵֽינוּ,</tei:l>
          <tei:l>אַרְזֵי הַלְּבָנוֹן שֹׁרְשוּ מִקִּרְבֵּֽנוּ,</tei:l>
          <tei:l>בַּאֲנִי מַאֲמִין נִגְדְּעוּ בְּמִקְדָּשֵֽׁינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:memorial_prayer_for_our_six_million_martyrs_who_perished_fundaminsky/8"/>
        <tei:lg>
          <tei:l>לְשׁוֹנֵֽנוּ דָבְקָה לְחִכֵּֽנוּ,</tei:l>
          <tei:l>מְקוֹר דִּמְעָה הָיוּ עֵינֵֽינוּ,</tei:l>
          <tei:l>וְכוֹס הַיְגוֹנִים רִוְּתָה נַפְשֵֽׁנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:memorial_prayer_for_our_six_million_martyrs_who_perished_fundaminsky/9"/>
        <tei:lg>
          <tei:l>לָֽמָּה עֲזַבְתָּֽנוּ אֱלֹהֵֽינוּ,</tei:l>
          <tei:l>לָמָּה עָמַֽדְתָּ מֵרָחוֹק בְּעֵת צָרָתֵֽנוּ,</tei:l>
          <tei:l>לָֽמָּה הֶחֱרַֽשְׁתָּ עֵת שָׁפְכוּ הֶעָרִיצִים כַּמַּֽיִם דָּמֵֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:memorial_prayer_for_our_six_million_martyrs_who_perished_fundaminsky/10"/>
        <tei:lg>
          <tei:l>אֵיפֹה נִמְצָא מָזוֹר לִפְצָעֵֽינוּ,</tei:l>
          <tei:l>מֵאַֽיִן יָבֹֽאוּ נִחוּמִים לְאֶבְלֵֽנוּ,</tei:l>
          <tei:l>אֵיכָֽכָה נִשְׁכַּח אֶת מַחְמַדֵּֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:memorial_prayer_for_our_six_million_martyrs_who_perished_fundaminsky/11"/>
        <tei:lg>
          <tei:l>אֲבֵלִים נוֹתַֽרְנוּ בְּשִׁמְמָתֵֽנוּ,</tei:l>
          <tei:l>בּוֹדְדִים נִשְׁאַֽרְנוּ בִּיגוֹנֵֽנוּ,</tei:l>
          <tei:l>אוֹיָה כִּי גָדוֹל כַּיָּם שִׁבְרֵֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:memorial_prayer_for_our_six_million_martyrs_who_perished_fundaminsky/12"/>
        <tei:lg>
          <tei:l>רְאֵה יְיָ חֶרְפָּתֵֽנוּ,</tei:l>
          <tei:l>הַבִּֽיטָה עַל שִׁפְלוּתֵֽנוּ,</tei:l>
          <tei:l>שׁוּר כִּי עַד שְׁאוֹל הוּרַד כְּבוֹדֵֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:memorial_prayer_for_our_six_million_martyrs_who_perished_fundaminsky/13"/>
        <tei:lg>
          <tei:l>רַחֶם־נָא עַל שְׁרִידֵֽינוּ,</tei:l>
          <tei:l>שִׂים בְּנֹאדְךָ דִמְעוֹתֵֽינוּ,</tei:l>
          <tei:l>נְצֹר בְּאוֹצָרְךָ שֶֽׁפֶךְ־דָּמֵֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:memorial_prayer_for_our_six_million_martyrs_who_perished_fundaminsky/14"/>
        <tei:lg>
          <tei:l>חַיֵּי־נֵֽצַח הַנְחֵל לִקְדוֹשֵֽׁינוּ,</tei:l>
          <tei:l>בִּצְרוֹר הַחַיִּים צְרֹר נִשְׁמוֹת טְהוֹרֵֽינוּ,</tei:l>
          <tei:l>כִּי דָמָם נִשְׁפַּךְ עַל מִזְבַּחֲךָ אֱלֹהֵֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:memorial_prayer_for_our_six_million_martyrs_who_perished_fundaminsky/15"/>
        <tei:lg>
          <tei:l>חֲמָל־נָא עַל אֲבֵלֵֽנוּ,</tei:l>
          <tei:l>הַצְמַח נִחוּמִים לְאַחֵֽינוּ וּלְאַחְיוֹתֵֽינוּ,</tei:l>
          <tei:l>זְכֹר כִּי הֵם שְׁאֵרִית פְּלֵטָתֵֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:memorial_prayer_for_our_six_million_martyrs_who_perished_fundaminsky/16"/>
        <tei:lg>
          <tei:l>מְחֵה בְּרַחֲמֶֽיךָ דִמְעוֹת אֻמְלָלֵֽינוּ,</tei:l>
          <tei:l>הֲפָךְ בְּטוּבְךָ לְשָׂשׂוֹן אֶבְלֵֽנוּ,</tei:l>
          <tei:l>אֱצֹל בְּחַסְדְּךָ מֵהוֹדְךָ עָלֵינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:memorial_prayer_for_our_six_million_martyrs_who_perished_fundaminsky/17"/>
        <tei:lg>
          <tei:l>מָזוֹר וָתֶֽרֶף הַמְצֵא לִפְצָעֵֽינוּ,</tei:l>
          <tei:l>הַעֲלֵה אֲרוּכָה לְכׇל מַכּוֹתֵֽינוּ,</tei:l>
          <tei:l>וְהָרֵם בִּישׁוּעָתְךָ מֵעָפָר קָרְנֵֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:memorial_prayer_for_our_six_million_martyrs_who_perished_fundaminsky/18"/>
        <tei:lg>
          <tei:l>יְיָ יְיָ ׀ אֵל רַחוּם וְחַנּוּן שְׁמַע קוֹלֵֽנוּ,</tei:l>
          <tei:l>חוּס וְרַחֵם עֲלֵֽינוּ,</tei:l>
          <tei:l>וְהָשֵׁב שְׁכִינָתְךָ לְצִיּוֹן עִיר קָדְשֵֽׁנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:memorial_prayer_for_our_six_million_martyrs_who_perished_fundaminsky/19"/>
        <tei:lg>
          <tei:l>יַעֲלֶה לְפָנֶֽיךָ זִכְרוֹן קָרְבְּנוֹתֵֽינוּ,</tei:l>
          <tei:l>יַגִּֽיעַ לְפָנֶֽיךָ קוֹל בְּכִיּוֹת אִמּוֹתֵֽינוּ,</tei:l>
          <tei:l>יִשָּׁמַע בְּאָזְנֶֽיךָ קוֹל דְּמָי תִינוֹקוֹתֵֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:memorial_prayer_for_our_six_million_martyrs_who_perished_fundaminsky/20"/>
        <tei:lg>
          <tei:l>מִבְחַר בִּרְכוֹתֶֽיךָ שְׁלַח בְּאַרְצֵֽנוּ,</tei:l>
          <tei:l>מִכׇּל רָע נְצֹר יִשְׂרָאֵל מְדִינָתֵֽנוּ,</tei:l>
          <tei:l>וְהָיְתָה לְגָאוֹן וּלְתִפְאֶֽרֶת כְּמוֹ שֶׁׄהִבְטַֽחְתָּ לַׄאֲבוֹתֵֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:memorial_prayer_for_our_six_million_martyrs_who_perished_fundaminsky/21"/>
        <tei:lg>
          <tei:l>מְׄהֵׄרָה יָבוֹא מְשִׁיחֵנוּ,</tei:l>
          <tei:l>לְעֵינֵי כׇל חַי יוֹפִֽיעַ בְּתוֹכֵֽנוּ,</tei:l>
          <tei:l>וְיָצִיץ וְיִפְרַח עַם יִשְׂרָאֵל בְּיָמֵֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:memorial_prayer_for_our_six_million_martyrs_who_perished_fundaminsky/22"/>
        <tei:lg>
          <tei:l>אָמֵן!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
