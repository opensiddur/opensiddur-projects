  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:service_for_the_blessing_of_a_baby_montagu">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:service_for_the_blessing_of_a_baby_montagu/1"/>
        <tei:lg>
          <tei:l>אָהַבְתִּי כִּי־יִשְׁמַע יְהֹוָה אֶת־קוֹלִי תַּחֲנוּנָי׃</tei:l>
          <tei:l>כִּי־הִטָּה אׇזְנוֹ לִי</tei:l>
          <tei:l>וּבְיָמַי אֶקְרָא׃</tei:l>
          <tei:l>אֲפָפוּנִי חֶבְלֵי־מָוֶת</tei:l>
          <tei:l>וּמְצָרֵי שְׁאוֹל מְצָאוּנִי</tei:l>
          <tei:l>צָרָה וְיָגוֹן אֶמְצָא׃</tei:l>
          <tei:l>וּבְשֵׁם־יְהֹוָה אֶקְרָא</tei:l>
          <tei:l>אָנָּה יְהֹוָה מַלְּטָה נַפְשִׁי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:service_for_the_blessing_of_a_baby_montagu/2"/>
        <tei:lg>
          <tei:l>חַנּוּן יְהֹוָה וְצַדִּיק</tei:l>
          <tei:l>וֵאלֹהֵינוּ מְרַחֵם׃</tei:l>
          <tei:l>שֹׁמֵר פְּתָאיִם יְהֹוָה</tei:l>
          <tei:l>דַּלֹּתִי וְלִי יְהוֹשִׁיעַ׃</tei:l>
          <tei:l>שׁוּבִי נַפְשִׁי לִמְנוּחָיְכִי</tei:l>
          <tei:l>כִּי־יְהֹוָה גָּמַל עָלָיְכִי׃</tei:l>
          <tei:l>כִּי חִלַּצְתָּ נַפְשִׁי מִמָּוֶת</tei:l>
          <tei:l>אֶת־עֵינִי מִן־דִּמְעָה</tei:l>
          <tei:l>אֶת־רַגְלִי מִדֶּחִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:service_for_the_blessing_of_a_baby_montagu/3"/>
        <tei:lg>
          <tei:l>אֶתְהַלֵּךְ לִפְנֵי יְהֹוָה בְּאַרְצוֹת הַחַיִּים׃</tei:l>
          <tei:l>מָה־אָשִׁיב לַיהֹוָה כׇּל־תַּגְמוּלוֹהִי עָלָי׃</tei:l>
          <tei:l>לְךָ־אֶזְבַּח זֶבַח תּוֹדָה</tei:l>
          <tei:l>וּבְשֵׁם יְהֹוָה אֶקְרָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:service_for_the_blessing_of_a_baby_montagu/5"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְהֹוָה אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הַעוֹלָם</tei:l>
          <tei:l>שֶׁהֶחֱיָנוּ</tei:l>
          <tei:l>וְקִיְּמָנוּ וְהִגִּיעָנוּ</tei:l>
          <tei:l>לַזְּמַן הַזֶּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:service_for_the_blessing_of_a_baby_montagu/6"/>
        <tei:lg>
          <tei:l>הִנֵּה נַחֲלַת יְהֹוָה בָּנִים</tei:l>
          <tei:l>שָׂכָר פְּרִי הַבָּטֶן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:service_for_the_blessing_of_a_baby_montagu/7"/>
        <tei:lg>
          <tei:l>אֵין־קָדוֹשׁ כַּיהֹוָה</tei:l>
          <tei:l>כִּי אֵין בִּלְתֶּךָ</tei:l>
          <tei:l>וְאֵין צוּר כֵּאלֹהֵינוּ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
