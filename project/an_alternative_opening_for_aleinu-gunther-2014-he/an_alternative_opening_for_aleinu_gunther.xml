    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:an_alternative_opening_for_aleinu_gunther">
        <tei:head>עלינו</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:an_alternative_opening_for_aleinu_gunther/1"/>
        <tei:lg>
          <tei:l>עָלֵינוּ לְשַׁבֵּחַ לַאֳדוֹן הַכֹּל</tei:l>
          <tei:l>לָתֵת גְדוּלָה לְיוֹצֵר בְּרֵאשִׁית</tei:l>
          <tei:l>שֶׁהוּא עָשָׂנוּ עִם כׇּל הַגוֹיִם</tei:l>
          <tei:l>עִם יֵצֶר הַרָע וְעִם יֵצֶר הַטוֹב</tei:l>
          <tei:l>שֶׁהוּא נָתָן לָנוּ יְכוֹלֶת לִבְחוֹר</tei:l>
          <tei:l>בֵּין רוֹעָ וְחֶסֶד, בֵּין חֹשֶׁך וְאוֹר</tei:l>
          <tei:l>וַאַנָחְנוּ כּוֹרְעִים...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
