  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:agadelkha_ezra_37740">
        <tei:head>אֲגַדֶלְךָ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:agadelkha_ezra_37740/1"/>
        <tei:lg>
          <tei:l>אֲגַדֶּלְךָ אֱלֹהֵי כָּל נְשָׁמָה</tei:l>
          <tei:l>וְאוֹדְךָ בְּרֺב פַּחַד וְאֵימָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:agadelkha_ezra_37740/2"/>
        <tei:lg>
          <tei:l>בְּעָמְדִי תּוֹךְ קְהָלְךָ צוּר לְרוֹמֵם</tei:l>
          <tei:l>לְךָ אֶכְרַע וְאֶכּוֹף ראֺשׁ וְקוֹמָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:agadelkha_ezra_37740/3"/>
        <tei:lg>
          <tei:l>רְקִיעֵי רוֹם הֲלֹא נָטָה בְמִבְטָא</tei:l>
          <tei:l>וְהָאָרֶץ יְסָדָהּ עַל בְּלִימָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:agadelkha_ezra_37740/4"/>
        <tei:lg>
          <tei:l>הֲיוּכַל אִישׁ חֲקוֹר אֶת סוֹד יוֹצְרוֹ</tei:l>
          <tei:l>וּמִי הוּא זֶה בְּכָל קֵדְמָה וְיָמָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:agadelkha_ezra_37740/5"/>
        <tei:lg>
          <tei:l>מְרוֹמָם הוּא עֲלֵי כָל פֶּה וְלָשׁוֹן</tei:l>
          <tei:l>אֲשֶׁר הִפְלִיא וְעָשָׂה כֹּל בְּחָכְמָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:agadelkha_ezra_37740/6"/>
        <tei:lg>
          <tei:l>וְיִתְגַּדַּל בְּגוֹי קָדוֹשׁ וְעֶלְיוֹן</tei:l>
          <tei:l>וְיִתְקַדַּשׁ שְׁמֵיהּ רַבָּא בְּעָלְמָא</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
