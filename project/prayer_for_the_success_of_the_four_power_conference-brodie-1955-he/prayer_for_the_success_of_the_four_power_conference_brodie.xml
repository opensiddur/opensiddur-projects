  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_the_success_of_the_four_power_conference_brodie">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_success_of_the_four_power_conference_brodie/1"/>
        <tei:lg>
          <tei:l>רִבּוֹן הָעוֹלָמִים אֲדוֹן הַשָּׁלוֹם.</tei:l>
          <tei:l>יֹצֵר הָאָרֶץ וְעֹשָׂהּ לֹא־תֹהוּ</tei:l>
          <tei:l>בְרָאָהּ לָשֶׁבֶת יְצָרָהּ.</tei:l>
          <tei:l>בָּאנוּ לְחַלּוֹת פָּנֶיךָ בִּימֵי בוֹחַן</tei:l>
          <tei:l>אֵלֶּה לְכׇל יוֹשְׁבֵי אָרֶץ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_success_of_the_four_power_conference_brodie/2"/>
        <tei:lg>
          <tei:l>בְּנֵי־אָדָם בְּאֵימָה וָפַחַד מִתְהַלְּכִים</tei:l>
          <tei:l>לֵאמֹר מַּה יֵּלֶד יוֹם׃</tei:l>
          <tei:l>כָּסֹף נִכְסָפִים לְשָׁלוֹם וָאֱמֶת בָּעוֹלָם׃</tei:l>
          <tei:l>תְּפִלָתָם עָדֶיךָ שֶׁלֹא יָשׁוּבוּ</tei:l>
          <tei:l>לְכִסְלָה וּלְשִׂנְאַת חִנָּם שֶׁל יָמִים עָבָרוּ</tei:l>
          <tei:l>מְלֵאֵי שׁוֹד וָשֶׁבֶר וְדִמְעָה׃</tei:l>
          <tei:l>וְעַתָּה עֵינֵי כֹל תְּלוּיוֹת</tei:l>
          <tei:l>לְרָאֹשֵי עַמִּים אַדִּירִים</tei:l>
          <tei:l>הַמִּתְאַסְּפִים עוֹד הַפַּעַם לָעוּץ עֵצָה</tei:l>
          <tei:l>וְסוֹף־סוֹף לְחַפֵּשׂ דֶרֶךְ תְּבוּנָה</tei:l>
          <tei:l>וּלְדַבֵּר בְּשָׂפָה בְרוּרָה שֶׁל בִּטָּחוֹן וְאֵמוּן׃</tei:l>
          <tei:l>הַיֹּצֵר יַחַד לְבַב אֱנוֹשׁ</tei:l>
          <tei:l>וּמֵבִין אֶל כׇּל מַעֲשֵׂיהֶם.</tei:l>
          <tei:l>הַט לִבּוֹת רָאשֵׁי הָעַמִּים אֶל־נְכוֹנָה</tei:l>
          <tei:l>בְּשָעָה מַכְרִיעָה זוּ.</tei:l>
          <tei:l>תֵּן בְּלִבָּם רוּחַ אַהֲוָה וְאַחֲוָה.</tei:l>
          <tei:l>הָסֵר מֵהֶם רוּחַ עִוְעִים וְגֵאוּת</tei:l>
          <tei:l>וְנָחָה עֲלֵיהֶם רוּחַ עֵצָה וּגְבוּרָה:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_success_of_the_four_power_conference_brodie/3"/>
        <tei:lg>
          <tei:l>יַשְׂכִּילוּ וְיָבִינוּ כׇּל־בְּנֵי אָדָם</tei:l>
          <tei:l>כִּי צְדָקָה תְרוֹמֵם גּוֹי</tei:l>
          <tei:l>וְלֹא ‎בְכֹחַ יִגְבַּר אִישׁ׃</tei:l>
          <tei:l>קָרֵב הַיָּמִים</tei:l>
          <tei:l>אֲשֶׁר יִוָּדַע בַּגּוֹיִם</tei:l>
          <tei:l>כִּי אָב אֶחָד לְכֻלָּנוּ</tei:l>
          <tei:l>וּבוֹרֵא אֶחָד בְּרָאָנוּ.</tei:l>
          <tei:l>אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
