  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd/1"/>
        <tei:lg>
          <tei:l>Mänabərätä betä Dawitə, täzäyanäwu däḫənaha läʾIyärusalemə.</tei:l>
          <tei:l>ʾIyärusaleməsä ḥənəṣətə kämä hägärə, ʾəlä kämaha ḫəburä məsəlehu.<tei:anchor xml:id="note_4"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd/2"/>
        <tei:lg xml:lang="ahg">
          <tei:l>Ǧiŋä ǧiŋä,</tei:l>
          <tei:l>ʾIyärusalemə,</tei:l>
          <tei:l>ǧiŋä ǧiŋä wasi.</tei:l>
          <tei:l>Ǧiŋä ǧiŋä,</tei:l>
          <tei:l>Betä Mäḳədäsə,</tei:l>
          <tei:l>ǧiŋä ǧiŋä wasi.<tei:anchor xml:id="note_5"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd/3"/>
        <tei:lg>
          <tei:l>Wäbäʾənətä</tei:l>
          <tei:l>betä Dawitə, täzäyanäwu däḫənaha läʾIyärusalemə.</tei:l>
          <tei:l>wäbäʾənətä betä ʾƎgəziʾäbəḥerə ʾäməlakiyä, ḫäśäśəku śänayətäki.<tei:anchor xml:id="note_8"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd/4"/>
        <tei:lg xml:lang="ahg">
          <tei:l>Ǧäbäräkwə ʾəmənenə ǧäbäräkwə.</tei:l>
          <tei:l>Ǧäbäräkwə ʾəmənenə ǧäbäräkwə.<tei:anchor xml:id="note_9"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd/5"/>
        <tei:lg>
          <tei:l>ʾƎlä yətəḳänäyu bäwəsəṭə betəyä, wäyəwärəsu mäzagəbətəyä.</tei:l>
          <tei:l>ʾƎlä yətägəhu bäwəsəṭə betəyä, wäyəwärəsu mäzagəbətəyä.</tei:l>
          <tei:l>ʾÄnəbäru nädayə wäməsəkinə, ʾäḫədäru wəsəṭə betəkəmu.</tei:l>
          <tei:l>ʾÄnəbäru nädayə wägəyurə, ʾäḫədäru wəsəṭə betəkəmu.<tei:anchor xml:id="note_10"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd/6"/>
        <tei:lg xml:lang="ahg">
          <tei:l>Ängeni kinedēy geni</tei:l>
          <tei:l>Kindësi kiligeliu geni<tei:anchor xml:id="note_11"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd/7"/>
        <tei:lg>
          <tei:l>ʽOfəni räkäbätə lati betä.</tei:l>
          <tei:l>Yəḳedəsu səməyä betä Yaʽəḳobə.</tei:l>
          <tei:l>Yəḳedəsu səməyä betä ʾƎsəraʾelə.</tei:l>
          <tei:l>Mäkwanənətä betä Yaʽəḳobə.</tei:l>
          <tei:l>Mäkwanənətä betä ʾƎsəraʾelə.</tei:l>
          <tei:l>Wäyəʾəzeni, betä Yaʽəḳobə,</tei:l>
          <tei:l>Səməʽuni, betä ʾƎsəraʾelə!</tei:l>
          <tei:l>ʾÄrəḫəwə ḫoḫatä mäkwanənətə, wäyətəräḫäwa ʾəlä ʾəməfəṭərätə.<tei:anchor xml:id="note_15"/></tei:l>
        </tei:lg>
      </tei:div>
