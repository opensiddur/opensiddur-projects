      <tei:div corresp="urn:x-opensiddur:text:prayer:when_the_chiefs_of_the_people_meet_yehudah">
        <tei:head>רָאשֵׁי עָם עֵת הִתְאַסֵּף</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:when_the_chiefs_of_the_people_meet_yehudah/1"/>
        <tei:lg>
          <tei:l>רָאשֵׁי עָם עֵת הִתְאַסֵּף</tei:l>
          <tei:l>וּמְלָכִים בְּסוֹדָם</tei:l>
          <tei:l>כֻּלָּהַם הוֹדוּ לְיוֹסֵף</tei:l>
          <tei:l>כִּי הוּא עֵין כְּבוֹדָם</tei:l>
          <tei:l>לִמְשֹׁל בְּיַד אֱלוֹהַּ כֹּסֵף</tei:l>
          <tei:l>וְכֵן משֵׁל בְּאָדָם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:when_the_chiefs_of_the_people_meet_yehudah/2"/>
        <tei:lg>
          <tei:l>חֶמְדַּת אִישׁ אֲשֶׁר כֹּל יַגִּיד</tei:l>
          <tei:l>אַחַת הִיא וּבָרָה</tei:l>
          <tei:l>מִשְׂרָה מוּכָנָה לְנָגִיד</tei:l>
          <tei:l>הִיא לִצְבִי עֲטָרָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:when_the_chiefs_of_the_people_meet_yehudah/3"/>
        <tei:lg>
          <tei:l>כָּל חֶמְדַּת אֱנוֹשׁ אִם יָקְרָה</tei:l>
          <tei:l>תֵּבֵל עִם מְלוֹאָהּ</tei:l>
          <tei:l>אָמַרְתִּי הֲכִי הִיא אָמְרָה</tei:l>
          <tei:l>עִנְיָנָהּ נְשִׂיאָהּ</tei:l>
          <tei:l>יוֹסֵף צוּר לְשִׁבְתּוֹ יְצָרָהּ</tei:l>
          <tei:l>לֹא תֹהוּ בְרָאָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:when_the_chiefs_of_the_people_meet_yehudah/4"/>
        <tei:lg>
          <tei:l>בּוֹ נָקֵל עַבְטִיט מַכְבִּיד</tei:l>
          <tei:l>כִּי גָבַר וְשָׂרָה</tei:l>
          <tei:l>וּבְמִגְדַּל הָעֹז הֶעֱמִיד</tei:l>
          <tei:l>עִם נוּסוֹ עֲשָׂרָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:when_the_chiefs_of_the_people_meet_yehudah/5"/>
        <tei:lg>
          <tei:l>בֵּן פֹּרָת בְּאֵיתָן קַשְׁתָּךְ</tei:l>
          <tei:l>מַעֲשֶׂיךָ בְּכִשְׁרוֹן</tei:l>
          <tei:l>טוּב יָמִים הֲלֹא מֵאִתָּךְ</tei:l>
          <tei:l>וּלְךָ חִדְּשׁוּ רֹן</tei:l>
          <tei:l>אַתְּ שֶׁמֶשׁ וּמָטָר נִתָּךְ</tei:l>
          <tei:l>אַךְ מֵהֶם בְּיִתְרוֹן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:when_the_chiefs_of_the_people_meet_yehudah/6"/>
        <tei:lg>
          <tei:l>זָרְחוּ בָךְ מְאוֹרֵי תָמִיד</tei:l>
          <tei:l>וַתּוֹפַע נְהָרָה</tei:l>
          <tei:l>עַל אָרֶץ וְגַם הִיא תָעִיד</tei:l>
          <tei:l>כִּי בָךְ נֶעֱזָרָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:when_the_chiefs_of_the_people_meet_yehudah/7"/>
        <tei:lg>
          <tei:l>מַה זֶּה שָׁם הֲמוֹן עָם נִקְלֶה</tei:l>
          <tei:l>עַל הַזְּמָן חֲמָסָיו</tei:l>
          <tei:l>עַד הוּסַר סִלּוֹן עוֹלֶה</tei:l>
          <tei:l>נִשְׂרָף בְּאֵשׁ הֲמָסָיו</tei:l>
          <tei:l>לִפְנֵי בּוֹא יְקָר אֵל מָלֵא</tei:l>
          <tei:l>עֹמֵד בֵּין הֲדַסָּיו</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:when_the_chiefs_of_the_people_meet_yehudah/8"/>
        <tei:lg>
          <tei:l>כִּי שָׁאֳגוֹ שָׂרִים הֶחְרִיד</tei:l>
          <tei:l>וְקָלַע בַּשְּׂעָרָה</tei:l>
          <tei:l>שָׂמָהוּ אֱלֹהָיו יָחִיד</tei:l>
          <tei:l>מִבְצַר עֹז בְּצָרָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:when_the_chiefs_of_the_people_meet_yehudah/9"/>
        <tei:lg>
          <tei:l>שָׁטְפוּ נַחֲלֵי הַשֶּׁמֶן</tei:l>
          <tei:l>נַחַל הָאֲבָנִים</tei:l>
          <tei:l>בִּבְשׂרוֹת גְּבִיר הָאֹמֵן</tei:l>
          <tei:l>עַם אֵל בַּעֲדָנִים</tei:l>
          <tei:l>יְחִי הַשָּׂר אִמְרוּ אָמֵן</tei:l>
          <tei:l>וַיִּשְׂאוּ רְנָנִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:when_the_chiefs_of_the_people_meet_yehudah/10"/>
        <tei:lg>
          <tei:l>דש כנד מוסדילה בניד</tei:l>
          <tei:l>תן בונה אלבשארה</tei:l>
          <tei:l>כם ראיה דשול אשיד</tei:l>
          <tei:l>אן ואד אלחגארה.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
