    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:shnem_asar_banim_mayer">
        <tei:head>שְׁנֵים עָשָׂר בָּנִים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shnem_asar_banim_mayer/1"/>
        <tei:lg>
          <tei:l>שְׁנֵים עָשָׂר בָּנִים <tei:seg type="acrostic">אַ</tei:seg>חַת הִיא הַיּוֹנָה</tei:l>
          <tei:l><tei:seg type="acrostic">בָּ</tei:seg>נוֹת רָאֽוּהָ וַיְאַשְּׁרֽוּהָ בְּרִנָּה</tei:l>
          <tei:l>בְּיוֹם בַּת מִצְוָתָהּ <tei:seg type="acrostic">גִּ</tei:seg>דְּלָה כִּי בָאָה עוֹנָה</tei:l>
          <tei:l>וַתֹּ֖אמֶר <tei:seg type="acrostic">דָּ</tei:seg>תִי וְדִינֵי אֲקַבֵּל כְּאִמּוֹת הַשּׁוֹשַׁנָּה׃</tei:l>
          <tei:l>בא״י מָגֵן אַבְרָהָם׃</tei:l>
          <tei:l>אַתָּה גִּבּוֹר...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shnem_asar_banim_mayer/2"/>
        <tei:lg>
          <tei:l>שְׁנֵים עָשָׂר שְׁבָטִים <tei:seg type="acrostic">הֶ</tei:seg>עֱבַֽרְתָּ בַּיָּם</tei:l>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>אָז תָּשִׁיר עִם־אַחֶֽיהָ מִרְיָם</tei:l>
          <tei:l>בְּיוֹם בַּת מִצְוָתָהּ <tei:seg type="acrostic">זְ</tei:seg>כוּיוֹת הַמִּצְוֺת בְּמִלּוּיָם</tei:l>
          <tei:l>אֵלֶ֑יהָ <tei:seg type="acrostic">חַ</tei:seg>יִּים מֵימֵי אֵל חַי וְקַיָּם׃</tei:l>
          <tei:l>בא״י מְחַיֵּה הַמֵּתִים׃</tei:l>
          <tei:l><tei:note type="instruction">אשכנז</tei:note> נַעֲרִיצְךָ/ <tei:note type="instruction">ספרד</tei:note> כֶּֽתֶר...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shnem_asar_banim_mayer/3"/>
        <tei:lg>
          <tei:l>שְׁנֵים עָשָׂר מַזָּלוֹת <tei:seg type="acrostic">טַ</tei:seg>בַּעְתָּם בִּרְקִיעָם</tei:l>
          <tei:l><tei:seg type="acrostic">יִ</tei:seg>שְׂרָאֵל שׁוֹמֵֽעַ קוֹל אֵל (<tei:note type="instruction">שבת שובה –</tei:note> מֶּֽלֶךְ) רָם וְרַֽעַם</tei:l>
          <tei:l>בְּיוֹם בַּת מִצְוָתָהּ <tei:seg type="acrostic">כִּ</tei:seg>תְרֵי תּוֹרַת קׇדְשְׁךָ תֵּן־לָהּ מִטַּֽעַם</tei:l>
          <tei:l>כֹּ֛ל <tei:seg type="acrostic">לִ</tei:seg>קְחָהּ טוֹב וּדְרָכֶֽיהָ דַּרְכֵי־נֹֽעַם׃</tei:l>
          <tei:l>בא״י הָאֵל (<tei:note type="instruction">שבת שובה –</tei:note> הַמֶּֽלֶךְ) הַקָּדוֹשׁ׃</tei:l>
          <tei:l>תִּכַּֽנְתָּ...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shnem_asar_banim_mayer/4"/>
        <tei:lg>
          <tei:l>שְׁנֵים עָשָׂר חֳדָשִׁים <tei:seg type="acrostic">מִ</tei:seg>נִּיסָן עַד־אֲדָר</tei:l>
          <tei:l><tei:seg type="acrostic">נִ</tei:seg>תַּן רֹאשָׁם לְנָשִׁים בְּהוֹד וְהָדָר</tei:l>
          <tei:l>בְּיוֹם בַּת מִצְוָתָהּ <tei:seg type="acrostic">שַׂ</tei:seg>מְּחָהּ בַּיּוֹם הַמֻּגְדָּר</tei:l>
          <tei:l>אֲשֶׁר־<tei:seg type="acrostic">עֳ</tei:seg>נָגָיו יוֹצְאִים מִשֶּׁבַּקֹּדֶשׁ נֶאְדָּר</tei:l>
          <tei:l>בא״י מְקַדֵּשׁ הַשַּׁבָּת׃</tei:l>
          <tei:l>רְצֵה...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shnem_asar_banim_mayer/5"/>
        <tei:lg>
          <tei:l>שְׁתֵּים עֶשְׂרֵה מַצֵּבוֹת <tei:seg type="acrostic">פּ</tei:seg>וֹנוֹת הַר הַתִּפְאֶֽרֶת</tei:l>
          <tei:l><tei:seg type="acrostic">צ</tei:seg>וֹפְפוּ בְּיַד צוֹפֶה לְשַׁמֵּשׁ כְּתִזְכֹּֽרֶת</tei:l>
          <tei:l>בְּיוֹם בַּת מִצְוָתָהּ <tei:seg type="acrostic">ק</tei:seg>וֹרֵא אָבִֽיהָ וְאִמָּהּ אוֹמֶֽרֶת</tei:l>
          <tei:l>תֹּאמְרִ֥י <tei:seg type="acrostic">רְ</tei:seg>צוֹנִי לִשְׁמֹר מִשְׁמֶֽרֶת׃</tei:l>
          <tei:l>בא״י הַמַּחֲזִיר שְׁכִינָתוֹ לְצִיּוֹן׃</tei:l>
          <tei:l>מוֹדִים...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shnem_asar_banim_mayer/6"/>
        <tei:lg>
          <tei:l>שְׁתֵּים עֶשְׂרֵה אַבְנֵי <tei:seg type="acrostic">שֹֽׁ</tei:seg>הַם אַבְנֵי מִלּוּאִים</tei:l>
          <tei:l><tei:seg type="acrostic">שְׁ</tei:seg>מוֹת הַשְּׁבָטִים וְנִדְבוֹת הַנְּשִׂיאִים</tei:l>
          <tei:l>בְּיוֹם בַּת מִצְוָתָהּ <tei:seg type="acrostic">תּ</tei:seg>וֹדוֹת תּוֹדֶה לְעֹשֵׂה פְּלָאִים</tei:l>
          <tei:l>אֵלַ֖י <tei:seg type="acrostic">תָּ</tei:seg>רַֽמְתָּ אָז טוּבְךָ אָֽנוּ קוֹרְאִים׃</tei:l>
          <tei:l>בא״י הַטּוֹב שִׁמְךָ וּלְךָ נָאֶה לְהוֹדוֹת׃</tei:l>
          <tei:l>שִׂים...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shnem_asar_banim_mayer/7"/>
        <tei:lg>
          <tei:l>שְׁתֵּים עֶשְׂרֵה שָׁנִים יַׄלְדַּת צִׄיּוֹן חׄוֹגֶֽגֶת קִׄדּוּמָהּ</tei:l>
          <tei:l>הִׄיא רְׄאוּיַת אֵׄל לָׄהּ נָתָן הַגְשָׁמָה</tei:l>
          <tei:l>בְּיוֹם בַּת מִצְוָתָהּ חִׄזְׄקִׄי אִׄמְׄצִׄי וְקִרְאִי לִפְנֵי הָאֻמָּה</tei:l>
          <tei:l>אֶׄעֱשֶֽׂה מִׄצְוֺת נׄוֹרָא כִּי אֶהְיֶה לְעַלְמָה׃</tei:l>
          <tei:l>בא״י הַמְבָרֵךְ אֶת־עַמּוֹ יִשְׂרָאֵל בַּשָּׁלוֹם׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
