      <tei:div corresp="urn:x-opensiddur:text:poem:attah_hu_and_a_condensed_az_yashir">
        <tei:head>אַתָּה־הוּא וְאָז יָשִׁיר (מקוצר)‏</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_and_a_condensed_az_yashir/1"/>
        <tei:lg>
          <tei:l>אַתָּה־ה֣וּא יְהוָה֮</tei:l>
          <tei:l>לְבַדֶּךָ֒ את [אַתָּ֣ה] עָשִׂ֡יתָ אֶֽת־הַשָּׁמַיִם֩</tei:l>
          <tei:l>שְׁמֵ֨י הַשָּׁמַ֜יִם</tei:l>
          <tei:l>וְכָל־צְבָאָ֗ם <tei:bibl>(נחמיה ט:ו חלק)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_and_a_condensed_az_yashir/2"/>
        <tei:lg>
          <tei:l>הָאָ֜רֶץ וְכָל־אֲשֶׁ֤ר עָלֶ֙יהָ֙</tei:l>
          <tei:l>הַיַּמִּים֙</tei:l>
          <tei:l>וְכָל־אֲשֶׁ֣ר בָּהֶ֔ם</tei:l>
          <tei:l>וְאַתָּ֖ה מְחַיֶּ֣ה אֶת־כֻּלָּ֑ם</tei:l>
          <tei:l>וּצְבָ֥א הַשָּׁמַ֖יִם לְךָ֥ מִשְׁתַּחֲוִֽים׃ <tei:bibl>(נחמיה ט:ו חלק)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_and_a_condensed_az_yashir/4"/>
        <tei:lg>
          <tei:l>אַתָּה־הוּא֙ יְהוָ֣ה הָאֱלֹהִ֔ים</tei:l>
          <tei:l>אֲשֶׁ֤ר בָּחַ֙רְתָּ֙ בְּאַבְרָ֔ם</tei:l>
          <tei:l>וְהוֹצֵאת֖וֹ מֵא֣וּר</tei:l>
          <tei:l>כַּשְׂדִּ֑ים</tei:l>
          <tei:l>וְשַׂ֥מְתָּ שְּׁמ֖וֹ אַבְרָהָֽם׃</tei:l>
          <tei:l>וּמָצָ֣אתָ אֶת־לְבָבוֹ֮</tei:l>
          <tei:l>נֶאֱמָ֣ן לְפָנֶיךָ֒</tei:l>
          <tei:l>וְכָר֨וֹת עִמּ֜וֹ הַבְּרִ֗ית</tei:l>
          <tei:l>לָתֵ֡ת אֶת־אֶרֶץ֩ הַכְּנַעֲנִ֨י הַחִתִּ֜י הָאֱמֹרִ֧י</tei:l>
          <tei:l>וְהַפְּרִזִּ֛י וְהַיְבוּסִ֥י וְהַגִּרְגָּשִׁ֖י</tei:l>
          <tei:l>לָתֵ֣ת לְזַרְע֑וֹ</tei:l>
          <tei:l>וַתָּ֙קֶם֙ אֶת־דְּבָרֶ֔יךָ</tei:l>
          <tei:l>כִּ֥י צַדִּ֖יק אָֽתָּה׃ <tei:bibl>(נחמיה ט:ז-ח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_and_a_condensed_az_yashir/5"/>
        <tei:lg>
          <tei:l>כְּהַיּ֥וֹם הַזֶּֽה׃ <tei:bibl>(נחמיה ט:י חלק)</tei:bibl></tei:l>
          <tei:l>וַיַּ֨רְא יִשְׂרָאֵ֜ל</tei:l>
          <tei:l>אֶת־הַיָּ֣ד הַגְּדֹלָ֗ה</tei:l>
          <tei:l>אֲשֶׁ֨ר עָשָׂ֤ה</tei:l>
          <tei:l>יְהוָה֙ בְּמִצְרַ֔יִם <tei:bibl>(שמות יד:לא חלק)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_and_a_condensed_az_yashir/6"/>
        <tei:lg>
          <tei:l>וַיִּֽירְא֥וּ הָעָ֖ם אֶת־יְהוָ֑ה</tei:l>
          <tei:l>וַיַּֽאֲמִ֙ינוּ֙ בַּֽיהוָ֔ה</tei:l>
          <tei:l>וּבְמֹשֶׁ֖ה עַבְדּֽוֹ׃ <tei:bibl>(שמות יד:לא חלק)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_and_a_condensed_az_yashir/7"/>
        <tei:lg>
          <tei:l>אָ֣ז יָשִֽׁיר־מֹשֶׁה֩ וּבְנֵ֨י יִשְׂרָאֵ֜ל אֶת־הַשִּׁירָ֤ה הַזֹּאת֙ <tei:bibl>(שמות טו:א חלק)</tei:bibl></tei:l>
          <tei:l>וַיַּֽאֲמִ֙ינוּ֙ בַּֽיהוָ֔ה <tei:bibl>(שמות יד:לא חלק)</tei:bibl></tei:l>
          <tei:l>תְּבִאֵ֗מוֹ וְתִטָּעֵ֙מוֹ֙</tei:l>
          <tei:l>בְּהַ֣ר נַחֲלָֽתְךָ֔</tei:l>
          <tei:l>מָכ֧וֹן לְשִׁבְתְּךָ֛</tei:l>
          <tei:l>פָּעַ֖לְתָּ יְהוָ֑ה מִקְּדָ֕שׁ אֲדֹנָ֖י</tei:l>
          <tei:l>כּוֹנְנ֥וּ יָדֶֽיךָ׃ <tei:bibl>(שמות טו:יז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_and_a_condensed_az_yashir/8"/>
        <tei:lg>
          <tei:l>יְהוָ֥ה ׀ יִמְלֹ֖ךְ לְעֹלָ֥ם וָעֶֽד׃ <tei:bibl>(שמות טו:יח)</tei:bibl></tei:l>
          <tei:l>יְהוָ֥ה ׀ יִמְלֹ֖ךְ לְעֹלָ֥ם וָעֶֽד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_and_a_condensed_az_yashir/9"/>
        <tei:lg>
          <tei:l>בַּיּ֣וֹם הַה֗וּא יִהְיֶ֧ה יְהוָ֛ה אֶחָ֖ד</tei:l>
          <tei:l>וּשְׁמ֥וֹ אֶחָֽד׃ <tei:bibl>(זכריה יד:ט)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
