  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_that_the_lands_of_our_freedom_never_resemble_jacobs">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_that_the_lands_of_our_freedom_never_resemble_jacobs/1"/>
        <tei:lg>
          <tei:l>ריבונו של עולם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_that_the_lands_of_our_freedom_never_resemble_jacobs/2"/>
        <tei:lg>
          <tei:l>הרחמן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_that_the_lands_of_our_freedom_never_resemble_jacobs/4"/>
        <tei:lg>
          <tei:l>אֲנִי יְהוָה אֱלֹהֵיכֶם</tei:l>
          <tei:l>אֲשֶׁר הוֹצֵאתִי אֶתְכֶם מֵאֶרֶץ מִצְרַיִם</tei:l>
          <tei:l>לִהְיוֹת לָכֶם לֵאלֹהִים</tei:l>
          <tei:l>אֲנִי יְהוָה אֱלֹהֵיכֶם׃ <tei:bibl>(במדבר יג:מא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_that_the_lands_of_our_freedom_never_resemble_jacobs/5"/>
        <tei:lg>
          <tei:l>אשר הוצאתי אתכם. עַל מְנָת כֵּן פָּדִיתִי אֶתְכֶם</tei:l>
          <tei:l>שֶׁתְּקַבְּלוּ עֲלֵיכֶם גְּזֵרוֹתַי: <tei:bibl>(רש”י על במדבר ט״ו:מא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_that_the_lands_of_our_freedom_never_resemble_jacobs/10"/>
        <tei:lg>
          <tei:l>עֹשֶׂה מִשְׁפָּט לָעֲשׁוּקִים</tei:l>
          <tei:l>נֹתֵן לֶחֶם לָרְעֵבִים</tei:l>
          <tei:l>יְהוָה מַתִּיר אֲסוּרִים׃ <tei:bibl>(תהלים קמו:ז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_that_the_lands_of_our_freedom_never_resemble_jacobs/11"/>
        <tei:lg>
          <tei:l>וְהָלַכְתָּ בִּדְרָכָיו׃ <tei:bibl>(דברים כח:ט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_that_the_lands_of_our_freedom_never_resemble_jacobs/13"/>
        <tei:lg>
          <tei:l>ברוך אתה ה׳ מלך אוהב צדקה ומשפט׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
