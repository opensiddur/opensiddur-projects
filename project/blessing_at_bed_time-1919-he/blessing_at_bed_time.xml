  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:blessing_at_bed_time">
        <tei:head>בִּרְכָּת הַמַּפִּיל</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_at_bed_time/2"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>הַמַּפִּיל חֶבְלֵי שֵׁנָה עַל עֵינָי וּתְנוּמָה עַל עַפְעַפָּי׃</tei:l>
          <tei:l>וִיהִי רָצוֹן מִלְּפָנֶֽיךָ יְיָ אֱלֹהַי וֵאלֹהֵי אֲבוֹתַי שֶׁתַּשְׁכִּיבֵֽנִי לְשָׁלוֹם</tei:l>
          <tei:l>וְתַעֲמִידֵֽנִי לְשָׁלוֹם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_at_bed_time/3"/>
        <tei:lg>
          <tei:l>שְׁמַע יִשְׂרָאֵל יְיָ אֱלֹהֵֽינוּ יְיָ ׀ אֶחָֽד׃ <tei:bibl>(דברים ו:ד)</tei:bibl></tei:l>
          <tei:l>בָּרוּךְ שֵׁם כְּבוֹד מַלְכוּתוֹ לְעוֹלָם וָעֶד׃ <tei:bibl>(משנה יומא ג:ח, פסחים נו א, מדרש תנחומא – בובר קדושים ו׳, ועוד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_at_bed_time/5"/>
        <tei:lg>
          <tei:l>בָּרוּךְ יְיָ בַּיּוֹם׃</tei:l>
          <tei:l>בָּרוּךְ יְיָ בַּלַּֽיְלָה׃</tei:l>
          <tei:l>בָּרוּךְ יְיָ בְּשָׁכְבֵּֽנוּ׃</tei:l>
          <tei:l>בָּרוּךְ יְיָ בְּקוּמֵֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_at_bed_time/6"/>
        <tei:lg>
          <tei:l>הִנֵּה לֹא־יָנוּם וְלֹא יִישָׁן</tei:l>
          <tei:l>שׁוֹמֵר יִשְׂרָאֵל׃ <tei:bibl>(תהלים קכא:ד)</tei:bibl></tei:l>
          <tei:l>בְּיָדְךָ אַפְקִיד רוּחִי</tei:l>
          <tei:l>פָּדִֽיתָה אוֹתִי</tei:l>
          <tei:l>יְיָ אֵל אֱמֶת׃ <tei:bibl>(תהלים כא:ו)</tei:bibl></tei:l>
          <tei:l>לִישׁוּעָתְךָ קִוִּֽיתִי יְיָ׃ <tei:bibl>(בראשית מט:יח)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
