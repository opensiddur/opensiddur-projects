  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_blessing_over_water_for_peace_schachter_shalomi">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_blessing_over_water_for_peace_schachter_shalomi/2"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֶלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם,</tei:l>
          <tei:l>אֲשֶׁר קִדְּשָׁנוּ בְּמִצְוֺתָיו,</tei:l>
          <tei:l>וְצִוָנוּ עַל טְבִלַת כֶּלִי:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_blessing_over_water_for_peace_schachter_shalomi/4"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>שֶׁהַכֹּל נִהְיָה בִּדְבָרוֹ:‏</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_blessing_over_water_for_peace_schachter_shalomi/6"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>בּוֹרֵא נְפָשׁוֹת רַבּוֹת</tei:l>
          <tei:l>וְחֶסְרוֹנָן עַל כָּל מַה שֵּׁבָּרָאתָ</tei:l>
          <tei:l>לְהַחֲיוֹת בָּהֶם נֶֽפֶשׁ כָּל חָי:</tei:l>
          <tei:l>בָּרוּךְ חַי הָעוֹלָמִים:</tei:l>
        </tei:lg>
