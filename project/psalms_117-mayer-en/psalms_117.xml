  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/117">
        <tei:head>Psalms 117, translated and cantillated for Hallel by Isaac Gantwerk Mayer</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/117/1/a"/>
        <tei:lg>
          <tei:l>Praise the Cause, all nations,</tei:l>
          <tei:l>exalt the One, all countries!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/117/2"/>
        <tei:lg>
          <tei:l>For great upon us is Divine mercy,</tei:l>
          <tei:l>and the truth of the Cause is forever!</tei:l>
          <tei:l>Praise the Source!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
