      <tei:div corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer">
        <tei:head>סדר ספירת הנסך</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/1"/>
        <tei:lg>
          <tei:l>סדר ספירת הנסך</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/2"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">(ביקום מקביל, שבו כל יהדות מתנהלת על פי הנורמות הרבניות ביקום שלנו, חוץ משני דברים — חגי מנחת היין ומנחת העצים כמו שמתוארים במגילת המקדש שבקומראן נכללו כחלק מהמקרא, ונשמר מנהג כתיבת השם הקודש בכתב עברי עתיק)</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/3"/>
        <tei:lg>
          <tei:l>הִנְנִי מוּכָן וּמְזוּמָן לְקַיֵּם מִצְוַת עֲשֵׂה</tei:l>
          <tei:l>כְּמוֹ שֶׁכָּתוּב בִּמְגִלַּת הַמִּקְדָּשׁ —</tei:l>
          <tei:l>וּסְפַרְתֶּ֣ם לָכֶ֗ם מִיּוֹם֙ הֲבִ֣יאֲכֶ֔ם אֶת־הַמִּנְחָ֥ה הַחֲדָשָׁ֖ה לַיהוה</tei:l>
          <tei:l>אֶת־לֶ֙חֶם֙ הַבִּכּוּרִ֔ים</tei:l>
          <tei:l>שִׁבְעָ֧ה שָׁבוּע֛וֹת שֶׁ֥בַע שַׁבָּת֖וֹת תְּמִימֹ֥ת תִּהְיֶֽינָה׃</tei:l>
          <tei:l>עַ֣ד מִֽמׇּחֳרַ֤ת הַשַּׁבָּת֙ הַשְּׁבִיעִ֔ת</tei:l>
          <tei:l>תִּסְפְּר֖וּ חֲמִשִּׁ֣ים י֑וֹם</tei:l>
          <tei:l>וְהִקְרַבְתֶּ֞ם יַ֤יִן חָדָשׁ֙ לַנֶּ֔סֶךְ</tei:l>
          <tei:l>אַרְבָּעָ֥ה הִינִ֖ים מִכׇּל־מַטּ֥וֹת יִשְׂרָאֵֽל׃</tei:l>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יהוה אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>אֲשֶׁר קִדְּשָֽׁנוּ בְּמִצְוֹתָיו</tei:l>
          <tei:l>וְצִוָּֽנוּ עַל סְפִירַת הַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/4"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ז בסיון</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם יוֹם אֶחַד לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/5"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ח בסיון</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁנֵי יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/6"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ט בסיון</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁלֹשָׁה יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/7"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">י בסיון</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם אַרְבָּעָה יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/8"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">יא בסיון</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם חֲמִשָּׁה יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/9"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">יב בסיון</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שִׁשָּׁה יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/10"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">יג בסיון (יום התחנון)</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שִׁבְעָה יָמִים שֶׁהֵם שָׁבֽוּעַ אֶחָד לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/11"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">יד בסיון</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁמוֹנָה יָמִים שֶׁהֵם שָׁבֽוּעַ אֶחָד וְיוֹם אֶחָד לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/12"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">טו בסיון</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם תִּשְׁעָה יָמִים שֶׁהֵם שָׁבֽוּעַ אֶחָד וּשְׁנֵי יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/13"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">טז בסיון</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם עֲשָׂרָה יָמִים שֶׁהֵם שָׁבֽוּעַ אֶחָד וּשְׁלֹשָׁה יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/14"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">יז בסיון</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם אַחַד עָשָׂר יוֹם שֶׁהֵם שָׁבֽוּעַ אֶחָד וְאַרְבָּעָה יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/15"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">יח בסיון</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁנֵים עָשָׂר יוֹם שֶׁהֵם שָׁבֽוּעַ אֶחָד וַחֲמִשָׁה יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/16"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">יט בסיון</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁלֹשָׁה עָשָׂר יוֹם שֶׁהֵם שָׁבֽוּעַ אֶחָד וְשִׁשָׁה יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/17"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כ בסיון (תענית עשרה בסיון)</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם אַרְבָּעָה עָשָׂר יוֹם שֶׁהֵם שְׁנֵי שָׁבוּעוֹת לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/18"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כא בסיון</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם חֲמִשָּׁה עָשָׂר יוֹם שֶׁהֵם שְׁנֵי שָׁבוּעוֹת וְיוֹם אֶחָד לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/19"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כב בסיון</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שִׁשָּׁה עָשָׂר יוֹם שֶׁהֵם שְׁנֵי שָׁבוּעוֹת וּשְׁנֵי יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/20"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כג בסיון</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שִׁבְעָה עָשָׂר יוֹם שֶׁהֵם שְׁנֵי שָׁבוּעוֹת וּשְׁלֹשָׁה יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/21"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כד בסיון</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁמוֹנָה עָשָׂר יוֹם שֶׁהֵם שְׁנֵי שָׁבוּעוֹת וְאַרְבָּעָה יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/22"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כה בסיון</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם תִּשְׁעָה עָשָׂר יוֹם שֶׁהֵם שְׁנֵי שָׁבוּעוֹת וַחֲמִשָּׁה יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/23"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כו בסיון</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם עֶשְׂרִים יוֹם שֶׁהֵם שְׁנֵי שָׁבוּעוֹת וְשִׁשָּׁה יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/24"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כז בסיון</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם אֶחָד וְעֶשְׂרִים יוֹם שֶׁהֵם שְׁלֹשָׁה שָׁבוּעוֹת לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/25"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כח בסיון</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁנַֽיִם וְעֶשְׂרִים יוֹם שֶׁהֵם שְׁלֹשָׁה שָׁבוּעוֹת וְיוֹם אֶחָד לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/26"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כט בסיון</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁלֹשָׁה וְעֶשְׂרִים יוֹם שֶׁהֵם שְׁלֹשָׁה שָׁבוּעוֹת וּשְׁנֵי יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/27"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ל בסיון</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם אַרְבָּעָה וְעֶשְׂרִים יוֹם שֶׁהֵם שְׁלֹשָׁה שָׁבוּעוֹת וּשְׁלֹשָׁה יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/28"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">א בתמוז (ראש חודש תמוז)</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם חֲמִשָּׁה וְעֶשְׂרִים יוֹם שֶׁהֵם שְׁלֹשָׁה שָׁבוּעוֹת וְאַרְבָּעָה יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/29"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ב בתמוז</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שִׁשָּׁה וְעֶשְׂרִים יוֹם שֶׁהֵם שְׁלֹשָׁה שָׁבוּעוֹת וַחֲמִשָּׁה יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/30"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ג בתמוז</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שִׁבְעָה וְעֶשְׂרִים יוֹם שֶׁהֵם שְׁלֹשָׁה שָׁבוּעוֹת וְשִׁשָּׁה יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/31"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ד בתמוז</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁמוֹנָה וְעֶשְׂרִים יוֹם שֶׁהֵם אַרְבָּעָה שָׁבוּעוֹת לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/32"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ה בתמוז</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם תִּשְׁעָה וְעֶשְׂרִים יוֹם שֶׁהֵם אַרְבָּעָה שָׁבוּעוֹת וְיוֹם אֶחָד לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/33"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ו בתמוז</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁלֹשִׁים יוֹם שֶׁהֵם אַרְבָּעָה שָׁבוּעוֹת וּשְׁנֵי יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/34"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ז בתמוז</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם אֶחָד וּשְׁלֹשִׁים יוֹם שֶׁהֵם אַרְבָּעָה שָׁבוּעוֹת וּשְׁלֹשָׁה יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/35"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ח בתמוז</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁנַֽיִם וּשְׁלֹשִׁים יוֹם שֶׁהֵם אַרְבָּעָה שָׁבוּעוֹת וְאַרְבָּעָה יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/36"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ט בתמוז</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁלֹשָׁה וּשְׁלֹשִׁים יוֹם שֶׁהֵם אַרְבָּעָה שָׁבוּעוֹת וַחֲמִשָּׁה יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/37"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">י בתמוז</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם אַרְבָּעָה וּשְׁלֹשִׁים יוֹם שֶׁהֵם אַרְבָּעָה שָׁבוּעוֹת וְשִׁשָּׁה יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/38"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">יא בתמוז</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם חֲמִשָּׁה וּשְׁלֹשִׁים יוֹם שֶׁהֵם חֲמִשָּׁה שָׁבוּעוֹת לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/39"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">יב בתמוז (ל״ו בנסך)</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שִׁשָּׁה וּשְׁלֹשִׁים יוֹם שֶׁהֵם חֲמִשָּׁה שָׁבוּעוֹת וְיוֹם אֶחָד לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/40"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">יג בתמוז</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שִׁבְעָה וּשְׁלֹשִׁים יוֹם שֶׁהֵם חֲמִשָּׁה שָׁבוּעוֹת וּשְׁנֵי יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/41"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">יד בתמוז</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁמוֹנָה וּשְׁלֹשִׁים יוֹם שֶׁהֵם חֲמִשָּׁה שָׁבוּעוֹת וּשְׁלֹשָׁה יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/42"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">טו בתמוז</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם תִּשְׁעָה וּשְׁלֹשִׁים יוֹם שֶׁהֵם חֲמִשָּׁה שָׁבוּעוֹת וְאַרְבָּעָה יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/43"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">טז בתמוז</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם אַרְבָּעִים יוֹם שֶׁהֵם חֲמִשָּׁה שָׁבוּעוֹת וַחֲמִשָּׁה יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/44"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">יז בתמוז (תענית שבעה עשר בתמוז)</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם אֶחָד וְאַרְבָּעִים יוֹם שֶׁהֵם חֲמִשָּׁה שָׁבוּעוֹת וְשִׁשָּׁה יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/45"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">יח בתמוז</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁנַֽיִם וְאַרְבָּעִים יוֹם שֶׁהֵם שִׁשָּׁה שָׁבוּעוֹת לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/46"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">יט בתמוז</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁלֹשָׁה וְאַרְבָּעִים יוֹם שֶׁהֵם שִׁשָּׁה שָׁבוּעוֹת וְיוֹם אֶחָד לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/47"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כ בתמוז</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם אַרְבָּעָה וְאַרְבָּעִים יוֹם שֶׁהֵם שִׁשָּׁה שָׁבוּעוֹת וּשְׁנֵי יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/48"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כא בתמוז</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם חֲמִשָּׁה וְאַרְבָּעִים יוֹם שֶׁהֵם שִׁשָּׁה שָׁבוּעוֹת וּשְׁלֹשָׁה יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/49"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כב בתמוז</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שִׁשָּׁה וְאַרְבָּעִים יוֹם שֶׁהֵם שִׁשָּׁה שָׁבוּעוֹת וְאַרְבָּעָה יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/50"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כג בתמוז</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שִׁבְעָה וְאַרְבָּעִים יוֹם שֶׁהֵם שִׁשָּׁה שָׁבוּעוֹת וַחֲמִשָּׁה יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/51"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כד בתמוז</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁמוֹנָה וְאַרְבָּעִים יוֹם שֶׁהֵם שִׁשָּׁה שָׁבוּעוֹת וְשִׁשָּׁה יָמִים לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/52"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כה בתמוז (ערב חג היין)</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם תִּשְׁעָה וְאַרְבָּעִים יוֹם שֶׁהֵם שִׁבְעָה שָׁבוּעוֹת לַנֶּֽסֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/53"/>
        <tei:lg>
          <tei:l>הָרַחֲמָן הוּא יַחֲזִיר לָֽנוּ</tei:l>
          <tei:l>קׇרְבְּנוֹת בֵּית הַמִּקְדָּשׁ וְנִסְכֵּיהֶם</tei:l>
          <tei:l>לִמְקוֹמוֹתָן בִּמְהֵרָה בְיָמֵֽינוּ</tei:l>
          <tei:l>אָמֵן סֶֽלָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/54"/>
        <tei:lg>
          <tei:l>
            <tei:bibl>תהלים ד׳</tei:bibl>
          </tei:l>
          <tei:l>לַמְנַצֵּ֥חַ</tei:l>
          <tei:l>בִּנְגִינ֗וֹת</tei:l>
          <tei:l>מִזְמ֥וֹר</tei:l>
          <tei:l>לְדָוִֽד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/55"/>
        <tei:lg>
          <tei:l>בְּקׇרְאִ֡י עֲנֵ֤נִי ׀</tei:l>
          <tei:l>אֱלֹ֘הֵ֤י צִדְקִ֗י</tei:l>
          <tei:l>בַּ֭צָּר הִרְחַ֣בְתָּ לִּ֑י</tei:l>
          <tei:l>חׇ֝נֵּ֗נִי וּשְׁמַ֥ע תְּפִלָּתִֽי׃</tei:l>
          <tei:l>בְּנֵ֥י אִ֡ישׁ</tei:l>
          <tei:l>עַד־מֶ֬ה כְבוֹדִ֣י לִ֭כְלִמָּה</tei:l>
          <tei:l>תֶּאֱהָב֣וּן רִ֑יק</tei:l>
          <tei:l>תְּבַקְשׁ֖וּ כָזָ֣ב סֶֽלָה׃</tei:l>
          <tei:l>וּדְע֗וּ כִּֽי־הִפְלָ֣ה יהוה</tei:l>
          <tei:l>חָסִ֣יד ל֑וֹ</tei:l>
          <tei:l>יהוה יִ֝שְׁמַ֗ע</tei:l>
          <tei:l>בְּקׇרְאִ֥י אֵלָֽיו׃</tei:l>
          <tei:l>רִגְז֗וּ וְֽאַל־תֶּ֫חֱטָ֥אוּ</tei:l>
          <tei:l>אִמְר֣וּ בִ֭לְבַבְכֶם</tei:l>
          <tei:l>עַֽל־מִשְׁכַּבְכֶ֗ם</tei:l>
          <tei:l>וְדֹ֣מּוּ סֶֽלָה׃</tei:l>
          <tei:l>זִבְח֥וּ זִבְחֵי־צֶ֑דֶק</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/56"/>
        <tei:lg>
          <tei:l>וּ֝בִטְח֗וּ אֶל־יהוה׃</tei:l>
          <tei:l>רַבִּ֥ים אֹמְרִים֮</tei:l>
          <tei:l>מִֽי־יַרְאֵ֢נ֫וּ־ט֥וֹב</tei:l>
          <tei:l>נְֽסָה־עָ֭לֵינוּ א֨וֹר פָּנֶ֬יךָ</tei:l>
          <tei:l>יהוה׃</tei:l>
          <tei:l>נָתַ֣תָּה שִׂמְחָ֣ה בְלִבִּ֑י</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_nesekh_mayer/57"/>
        <tei:lg>
          <tei:l>מֵעֵ֬ת דְּגָנָ֖ם וְתִירוֹשָׁ֣ם רָֽבּוּ׃</tei:l>
          <tei:l>בְּשָׁל֣וֹם יַחְדָּו֮</tei:l>
          <tei:l>אֶשְׁכְּבָ֢ה וְאִ֫ישָׁ֥ן</tei:l>
          <tei:l>כִּֽי־אַתָּ֣ה יהוה לְבָדָ֑ד</tei:l>
          <tei:l>לָ֝בֶ֗טַח תּֽוֹשִׁיבֵֽנִי׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
