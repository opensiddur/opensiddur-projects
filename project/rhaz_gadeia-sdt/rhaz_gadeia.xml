      <tei:div corresp="urn:x-opensiddur:text:poem:rhaz_gadeia">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:rhaz_gadeia/1"/>
        <tei:lg>
          <tei:l>אוּן קַאבְּרִי, אוּן קַאבְּרִי,</tei:l>
          <tei:l>קַאזֵי יֵטָה מוּן פַּיירֵי אוּן אֶשְׁקוּ, דּוּשׁ אֶשְׁקוּ,</tei:l>
          <tei:l>קַאזֵי יֵטָה מוּן פַּיירֵי אוּן אֶשְׁקוּ, דּוּשׁ אֶשְׁקוּ,</tei:l>
          <tei:l>חַדֿ גַּדְיָא, חַדֿ גַּדְיָא!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:rhaz_gadeia/2"/>
        <tei:lg>
          <tei:l>אֶשׁ זֶנְגוּ לוּקַה</tei:l>
          <tei:l>קַאזֵי מַאנְגָֿה לוּקַאבְּרִי,</tei:l>
          <tei:l>קַאזֵי יֵטָה מוּן פַּיירֵי אוּן אֶשְׁקוּ, דּוּשׁ אֶשְׁקוּ,</tei:l>
          <tei:l>קַאזֵי יֵטָה מוּן פַּיירֵי אוּן אֶשְׁקוּ, דּוּשׁ אֶשְׁקוּ,</tei:l>
          <tei:l>חַדֿ גַּדְיָא, חַדֿ גַּדְיָא!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:rhaz_gadeia/3"/>
        <tei:lg>
          <tei:l>אֶשׁ זֶנְגוּ לוּיִין</tei:l>
          <tei:l>קַאזֵי מוּרְדּוּ לוּקָה</tei:l>
          <tei:l>קַאזֵי מַאנְגָֿה לוּקַאבְּרִי,</tei:l>
          <tei:l>קַאזֵי יֵטָה מוּן פַּיירֵי אוּן אֶשְׁקוּ, דּוּשׁ אֶשְׁקוּ,</tei:l>
          <tei:l>קַאזֵי יֵטָה מוּן פַּיירֵי אוּן אֶשְׁקוּ, דּוּשׁ אֶשְׁקוּ,</tei:l>
          <tei:l>חַדֿ גַּדְיָא, חַדֿ גַּדְיָא!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:rhaz_gadeia/4"/>
