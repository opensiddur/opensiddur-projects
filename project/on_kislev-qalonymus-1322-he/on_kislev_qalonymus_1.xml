    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:on_kislev_qalonymus/1">
        <tei:head>בְּכִסְלֵו - מאבן בֹחן</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_kislev_qalonymus/1/1"/>
        <tei:lg>
          <tei:l>וּבַחֹדֶשׁ הַתְּשִׁיעִי בְּכִסְלֵו ·</tei:l>
          <tei:l>קוֹל הֲמוֹן שָׁלֵו ·</tei:l>
          <tei:l>לִכְבוֹד מַתִּתְיָה בֶן יוֹחָנָן לֹא לִגְנֵאי ·</tei:l>
          <tei:l>וְלִכְבוֹד בֶּן חַשְׁמוֹנַאי ·</tei:l>
          <tei:l>יֵאָסְפוּ הַנָּשִׁים הַחֲשׁוּבוֹת ·</tei:l>
          <tei:l>בְּקִיאוֹת לַעֲשׂוֹת הַבִּרְיָה וּלְלַבֵּב הַלְּבִיבוֹת ·</tei:l>
          <tei:l>עֲגָלוֹת גְדוֹלוֹת כְּהֶקֵּף הַמַּרְחֶשֶׁת ·</tei:l>
          <tei:l>וּמַרְאֵיהֶן טוֹבְיָנִי וְאַרְגְּמָנִי</tei:l>
          <tei:l>כְּמַרְאֵה הַקֶּשֶׁת ·</tei:l>
          <tei:l>יֹאפוּ אֶת הַבָּצֵק מִינִים יַעֲשׂוּ מַטְעַמִים מֵהָעִסָּה ·</tei:l>
          <tei:l>חֲבִיץ קְדֵרָה וּבֶן דַּיְסָא ·</tei:l>
          <tei:l>וְעַל הַכֹּל יִקְחוּ סֹלֶת חִטִּין ·</tei:l>
          <tei:l>וְיַעֲשׂוּ מִמֶּנוּ הַסֻּפְגָּנִין וְהָאִסְקְרִיטִין ·</tei:l>
          <tei:l>וְהַשְּׁתִיָה כַדָּת בִּשְׂמָחוֹת</tei:l>
          <tei:l>וָגִיל עַל כוֹס וָכוֹס ·</tei:l>
          <tei:l>לְהַעֲבִיר רָעַת נִיקָנוֹר וּבַגְרִיס וְצָרַת אַנְטִיוֹכוּס׃</tei:l>
        </tei:lg>
      </tei:div>
