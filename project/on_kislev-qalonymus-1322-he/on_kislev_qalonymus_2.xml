    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:on_kislev_qalonymus/2">
        <tei:head>בְּכִסְלֵו - מאבן בֹחן</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_kislev_qalonymus/2/1"/>
        <tei:lg>
          <tei:l>וְגָ֤ר זְאֵב֙ עִם־כֶּ֔בֶשׂ</tei:l>
          <tei:l>וְנָמֵ֖ר עִם־גְּדִ֣י יִרְבָּ֑ץ</tei:l>
          <tei:l>וְעֵ֨גֶל וּכְפִ֤יר וּמְרִיא֙ יַחְדָּ֔ו</tei:l>
          <tei:l>וְנַ֥עַר קָטֹ֖ן נֹהֵ֥ג בָּֽם׃</tei:l>
          <tei:l>וּפָרָ֤ה וָדֹב֙ תִּרְעֶ֔ינָה יַחְדָּ֖ו</tei:l>
          <tei:l>יִרְבְּצ֣וּ יַלְדֵיהֶ֑ן</tei:l>
          <tei:l>וְאַרְיֵ֖ה כַּבָּקָ֥ר יֹֽאכַל־תֶּֽבֶן׃</tei:l>
          <tei:l>וְשִֽׁעֲשַׁ֥ע יוֹנֵ֖ק עַל־חֻ֣ר פָּ֑תֶן</tei:l>
          <tei:l>וְעַל֙ מְאוּרַ֣ת צִפְעוֹנִ֔י גָּמ֖וּל יָד֥וֹ הָדָֽה׃</tei:l>
          <tei:l>לֹֽא־יָרֵ֥עוּ וְלֹֽא־יַשְׁחִ֖יתוּ בְּכָל־הַ֣ר קָדְשִׁ֑י</tei:l>
          <tei:l>כִּֽי־מָלְאָ֣ה הָאָ֗רֶץ דֵּעָה֙ אֶת־יְהוָ֔ה</tei:l>
          <tei:l>כַּמַּ֖יִם לַיָּ֥ם מְכַסִּֽים׃</tei:l>
        </tei:lg>
      </tei:div>
