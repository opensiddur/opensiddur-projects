  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:uri_uri_project">
        <tei:head>עוּרִי עוּרִי – שִׁירַת מִרְיָם וּדְבוֹרָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:uri_uri_project/1"/>
        <tei:lg>
          <tei:l>עוּרִי עוּרִי יוֹרֶדֶת יָם</tei:l>
          <tei:l>שְׂאִי בַת צִיּוֹן יְקָרָה</tei:l>
          <tei:l>קוֹל כִּשְׂאֵת נְהָרוֹת דָּכְיָם</tei:l>
          <tei:l>בְּשִׁירַת מִרְיָם וּדְבוֹרָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:uri_uri_project/2"/>
        <tei:lg>
          <tei:l>יוֹם חֵיל פַּרְעֹה יָרֹה יָרָה</tei:l>
          <tei:l>אֵל נֶאֱמָן בִּמְצוּלוֹת יָם</tei:l>
          <tei:l>בְּתֻפִּים שִׁירוּ לוֹ שִׁירָה</tei:l>
          <tei:l>וַתַּעַן מִרְיָם</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>עוּרִי...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:uri_uri_project/3"/>
        <tei:lg>
          <tei:l>צִדְקוֹת מֶלֶךְ חַי וְקַיָּם</tei:l>
          <tei:l>אָשִׁירָה גַּם אֲזַמֵּרָה</tei:l>
          <tei:l>לְצָרֵינוּ אָמַר דַּיָּם</tei:l>
          <tei:l>וַתָּשַׁר דְּבוֹרָה</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>עוּרִי...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:uri_uri_project/4"/>
        <tei:lg>
          <tei:l>הֶעֱבִיר עַמּוֹ בִגְבוּרָה</tei:l>
          <tei:l>בַּיַּבָּשָׁה בְתוֹךְ הַיָּם</tei:l>
          <tei:l>לָכֵן הוֹדוּ לוֹ בְזִמְרָה</tei:l>
          <tei:l>וַתַּעַן מִרְיָם</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>עוּרִי...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:uri_uri_project/5"/>
        <tei:lg>
          <tei:l>אֵל נוֹטֵר לִילָדָיו פִּרְיָם</tei:l>
          <tei:l>מִכָּל פְּרָעוֹת וְצָרָה</tei:l>
          <tei:l>מְהֵרָה יָשִׁיב אֶת שִׁבְיָם</tei:l>
          <tei:l>וַתָּשַׁר דְּבוֹרָה</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>עוּרִי...</tei:l>
        </tei:lg>
      </tei:div>
