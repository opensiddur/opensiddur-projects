  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ochil_yom_yom_david">
        <tei:head>אוֹחִיל יוֹם יוֹם</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ochil_yom_yom_david/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">א</tei:seg>וֹחִיל יוֹם יוֹם אֶשְׁתָּאֶה תָּמִיד עֵינִי צוֹפִיָּה</tei:l>
          <tei:l>אֶעְבְּרָה־נָא וְאֶרְאֶה אַדְמַת קֹֽדֶשׁ טִבֶּרְיָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ochil_yom_yom_david/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נָ</tei:seg>עֲמָה<tei:anchor xml:id="note_2"/> יְשִׁיבָתָהּ גַּם טוֹבָה רְאִיָּתָהּ</tei:l>
          <tei:l>יָם כִּנֶּֽרֶת חוֹמָתָהּ שָֽׁמָּה הָעִיר בְּנוּיָה׃</tei:l>
          <tei:l>אֶעְבְּרָה־נָא...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ochil_yom_yom_david/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יְ</tei:seg>שָׁרִים בְּלִבּוֹתָם נָֽחוּ עַל־מִשְׁכְּבוֹתָם</tei:l>
          <tei:l>בְּתוֹכָהּ קְבוּרָתָם כֻּלָּם בְּנֵי עֲלִיָּה׃</tei:l>
          <tei:l>אֶעְבְּרָה־נָא...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ochil_yom_yom_david/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">דֶּֽ</tei:seg>רֶךְ הָהָר יִתְבּוֹנָן קֶֽבֶר רַבָּן יוֹחָנָן</tei:l>
          <tei:l>בֵּן־זַכַּאי שָׁם יִתְלוֹנָן יָחִיד בְּדוֹרוֹ הָיָה׃</tei:l>
          <tei:l>אֶעְבְּרָה־נָא...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ochil_yom_yom_david/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וַ</tei:seg>חֲמִשָּׁה תַּלְמִידִים צַדִּיקִים וַחֲסִידִים</tei:l>
          <tei:l>מִזָּהָב נֶחֱמָדִים<tei:anchor xml:id="note_3"/> מוֹנֶה שְׁבָחָן הָיָה׃</tei:l>
          <tei:l>אֶעְבְּרָה־נָא...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ochil_yom_yom_david/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">דִּ</tei:seg>מָּה אֶחָד לְבוֹר סִיד טִפָּה אַחַת לֹא יַפְסִיד</tei:l>
          <tei:l>וְלַחֲבֵרוֹ קָרָא חָסִיד וְחַד דְּחִיל חוֹבַֽיָּא׃</tei:l>
          <tei:l>אֶעְבְּרָה־נָא...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ochil_yom_yom_david/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בָּ</tei:seg>ם חָכָם בְּעֹז גִּבֵּר כַּמַּעְיָן הַמִּתְגַּבֵּר</tei:l>
          <tei:l>אַשְׁרֵי יָלְדָה עַל־מַשְׁבֵּר אֶת־בְּנוֹ שֶׁל־חֲנַנְיָה׃</tei:l>
          <tei:l>אֶעְבְּרָה־נָא...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ochil_yom_yom_david/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רֹ</tei:seg>אשׁ הָהָר שָׁם מַצֵּבָה קֶֽבֶר רַבִּי עֲקִיבָא</tei:l>
          <tei:l>עִמּוֹ עֶשְׂרִים וְאַרְבָּעָה אֶֽלֶף תַּלְמִידַֽיָּא<tei:anchor xml:id="note_11"/>׃</tei:l>
          <tei:l>אֶעְבְּרָה־נָא...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ochil_yom_yom_david/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אַ</tei:seg>שְׁרֵי הַשָּׂם רַעְיוֹנָיו לִרְאוֹת שָׁם נֶֽגֶד פָּנָיו<tei:anchor xml:id="note_12"/></tei:l>
          <tei:l>רַבִּי חִֽיָּא וּבָנָיו יְהוּדָה וְחִזְקִיָּה׃</tei:l>
          <tei:l>אֶעְבְּרָה־נָא...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ochil_yom_yom_david/10"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הַ</tei:seg>ר גָּבֽוֹהַּ וְרָם עַל הוּקַם עָלָיו מִמַּעַל</tei:l>
          <tei:l>רַבִּי מֵאִיר הוּא בַּֽעַל אָתַֽיָּא וְתִמְהַֽיָּא׃</tei:l>
          <tei:l>אֶעְבְּרָה־נָא...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ochil_yom_yom_david/11"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רַ</tei:seg>בִּי יוֹחָנָן חָנָה שָׁם יַֽחַד עִם־רַב הוּנָא</tei:l>
          <tei:l>וְעִמָּהֶם רַב כָּהֲנָא וְגַם רַבִּי יִרְמִיָּה׃</tei:l>
          <tei:l>אֶעְבְּרָה־נָא...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ochil_yom_yom_david/12"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נִ</tei:seg>קְבַּר בְּתוֹכָהּ טָמוּן רַבִּי מֹשֶׁה בַּר־מַיְמוֹן</tei:l>
          <tei:l>הוּא מְפָרֵשׁ דַּת אָמוֹן וְרַב עַל כׇּל־חַכִּימַֽיָּא׃</tei:l>
          <tei:l>אֶעְבְּרָה־נָא...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ochil_yom_yom_david/13"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>רָם זָכוּר לְטוֹבָה הָרַב<tei:anchor xml:id="note_15"/> נֵֽיהוּ רַֽבָּא</tei:l>
          <tei:l>עֵץ חַיִּים שַׂר הַצָּבָא מִמִּשְׁפַּֽחַת אַבּוּלְעַפְיָא׃<tei:anchor xml:id="note_16"/></tei:l>
          <tei:l>אֶעְבְּרָה־נָא...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ochil_yom_yom_david/14"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נֵֽ</tei:seg>זֶר קֹֽדֶשׁ<tei:anchor xml:id="note_18"/> עַל־רֹאשׁוֹ אֵלָיו גּוֹיִים<tei:anchor xml:id="note_19"/> יִדְרֽוֹשׁוּ</tei:l>
          <tei:l>מִפִּיו תּוֹרָה<tei:anchor xml:id="note_20"/> יְבַקְּשׁוּ מִצַּֽפְרָא וְעַד־פַּֽנְיָא׃</tei:l>
          <tei:l>אֶעְבְּרָה־נָא...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ochil_yom_yom_david/15"/>
        <tei:lg>
          <tei:l>חֲסִין יָהּ אֵין כָּמֽוֹהוּ אִישׁ אֱלֹהִים קָדוֹשׁ הוּא</tei:l>
          <tei:l>בְּהֶֽבֶל רֽוּחַ<tei:anchor xml:id="note_22"/> פִּֽיהוּ רִשְׁפֵּי אֵשׁ שַׁלְהֶבֶתְיָה׃<tei:anchor xml:id="note_23"/></tei:l>
          <tei:l>אֶעְבְּרָה־נָא...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ochil_yom_yom_david/16"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חִ</tei:seg>דֵּשׁ הָעִיר שִׁכְלְלָהּ חוֹמָתָהּ וְגַם חֵילָהּ</tei:l>
          <tei:l>בֵּית מִדְרָשׁוֹ כִּלְכְּלָהּ כׇּל־יָמָיו אֲשֶׁר<tei:anchor xml:id="note_25"/> הָיָה׃</tei:l>
          <tei:l>אֶעְבְּרָה־נָא...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ochil_yom_yom_david/17"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זַ</tei:seg>רְעוֹ לְעוֹלָם יִחְיֶה בְּקִנְיַן<tei:anchor xml:id="note_26"/> הַגּוּף יִהְיֶה</tei:l>
          <tei:l>בִּרְכַּת הֶדְיוֹט אַל־תִּהְיֶה קַלָּה וְגַם־בְּזוּיָה׃</tei:l>
          <tei:l>אֶעְבְּרָה־נָא...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ochil_yom_yom_david/18"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ק</tei:seg>וֹל זִמְרַת רְנָנַי אִמְרֵי פִי וְהֶגְיוֹנַי</tei:l>
          <tei:l>יִהְיוּ לִפְנֵי יְהֹוָה כְּמוֹ סֹֽלֶת נְקִיָּה׃</tei:l>
          <tei:l>אֶעְבְּרָה־נָא...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" n="2" target="#note_2">
      <tei:p>נ״א נְעִימָה</tei:p>
    </tei:note>
    <tei:note type="commentary" n="3" target="#note_3">
      <tei:p>יש שהופכים את הפסוקיות המתחילות בצַדִּיקִים ובמִזָּהָב</tei:p>
    </tei:note>
    <tei:note type="commentary" n="11" target="#note_11">
      <tei:p>נ״א תַּלְמִידָא</tei:p>
    </tei:note>
    <tei:note type="commentary" n="12" target="#note_12">
      <tei:p>נ״א יָשִׁית שָׁם לְנֶֽגֶד עֵינָיו</tei:p>
    </tei:note>
    <tei:note type="commentary" n="15" target="#note_15">
      <tei:p>יש מוסיפין מַר</tei:p>
    </tei:note>
    <tei:note type="commentary" n="16" target="#note_16">
      <tei:p>יש מחלקין את השם לאַבּוּ אֶל־עַפְיָא</tei:p>
    </tei:note>
    <tei:note type="commentary" n="18" target="#note_18">
      <tei:p>נ״א הָאֵל</tei:p>
    </tei:note>
    <tei:note type="commentary" n="19" target="#note_19">
      <tei:p>נ״א הָעָם</tei:p>
    </tei:note>
    <tei:note type="commentary" n="20" target="#note_20">
      <tei:p>יש הופכים את התיבות לתּוֹרָה מִפִּיו</tei:p>
    </tei:note>
    <tei:note type="commentary" n="22" target="#note_22">
      <tei:p>נ״א אִמְרֵי</tei:p>
    </tei:note>
    <tei:note type="commentary" n="23" target="#note_23">
      <tei:p>לרוב נכתב שַׁלְהֶבֶת יָהּ, אבל בפסוק המקורי משיר השירים נכתב בתיבה אחת.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="25" target="#note_25">
      <tei:p>יש מדלגין על אֲשֶׁר</tei:p>
    </tei:note>
    <tei:note type="commentary" n="26" target="#note_26">
      <tei:p>נ״א כְּקִנְיַן</tei:p>
    </tei:note>
  </tei:standOff>
</tei:TEI>