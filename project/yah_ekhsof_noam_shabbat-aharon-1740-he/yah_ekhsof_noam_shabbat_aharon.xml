    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yah_ekhsof_noam_shabbat_aharon">
        <tei:head>יָהּ אֶכְסוֹף נוֹעַם שַׁבָּת</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yah_ekhsof_noam_shabbat_aharon/1"/>
        <tei:lg>
          <tei:l>יָהּ אֶכְסוֹף</tei:l>
          <tei:l>נוֹעַם שַׁבָּת</tei:l>
          <tei:l>הֵמֵתְאֶמֶת וּמִתְאַחֶדֶת</tei:l>
          <tei:l>בְסְגֻלָתֶךָ,</tei:l>
          <tei:l>מְשֹׁךְ נֹעַם</tei:l>
          <tei:l>יִרְאָתֶךָ</tei:l>
          <tei:l>לְעַם מְבַקְשֵׁי</tei:l>
          <tei:l>רְצוֹנֶךָ.</tei:l>
          <tei:l>קַדְשֵׁם בִּקְדֻשַּׁת הַשַּׁבָּת</tei:l>
          <tei:l>הַמִּתְאַחֶדֶת בְּתוֹרָתֶךָ.</tei:l>
          <tei:l>פְּתַח לָהֶם נֹעַם</tei:l>
          <tei:l>וְרָצוֹן לִפְתּוֹחַ שַׁעֲרֵי רְצוֹנֶךָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yah_ekhsof_noam_shabbat_aharon/2"/>
        <tei:lg>
          <tei:l>הָיָה הֹוֶה</tei:l>
          <tei:l>שְׁמוֹר שׁוֹמְרֵי וּמְצַפִּים</tei:l>
          <tei:l>שַׁבַּת קָדְשֶׁךָ.</tei:l>
          <tei:l>כְּמוֹ אַיָּל תַעֲרֹג</tei:l>
          <tei:l>עַל אֲפִיקֵי מָיִם, כֵּן נַפְשָׁם תַּעֲרֹג לְקַבֵּל נֹעַם</tei:l>
          <tei:l>קְדוּשָׁת שַׁבָּת הַמִּתְאַחֶדֶת</tei:l>
          <tei:l>בְּשֵׁם קָדְשֶׁךָ.</tei:l>
          <tei:l>הַצֵּל מְאַחֲרֵי לִפְרשׁ מִן הַשַּׁבָּת,</tei:l>
          <tei:l>לְבִלְתִּי תִּהְיֶה סָגוּר מֵהֶם.</tei:l>
          <tei:l>שִׁשָּׁה יָמִים הַמְקַבְּלִים קְדֻשָּׁה מִשַּׁבַּת קָדְשֶׁךָ,</tei:l>
          <tei:l>וְטַהֵר לִבָּם בֶּאֱמֶת וּבֶאֱמוּנָה לְעָבְדֶּךָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yah_ekhsof_noam_shabbat_aharon/3"/>
        <tei:lg>
          <tei:l>וְיִהְיוּ רַחֲמֶיךָ</tei:l>
          <tei:l>מִתְגּוֹלְלִים</tei:l>
          <tei:l>עַל עַם קָדְשֶׁךָ,</tei:l>
          <tei:l>לְהַשְׁקוֹת צְמֵאֵי חַסְדֶּךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yah_ekhsof_noam_shabbat_aharon/4"/>
        <tei:lg>
          <tei:l>מִנָּהָר</tei:l>
          <tei:l>הַיּוֹצֵא מֵעֵדֶן.</tei:l>
          <tei:l>לְעַטֵר אֶת יִשְׂרָאֵל</tei:l>
          <tei:l>בְּתִפְאֶרֶת הַמְפָאֲרִים</tei:l>
          <tei:l>אוֹתְךָ (בְּיוֹם שַׁבָּת) עַל יְדֵי שַׁבַּת קָדְשֶׁךָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yah_ekhsof_noam_shabbat_aharon/5"/>
        <tei:lg>
          <tei:l>כָּל שִׁשָּׁה יָמִים</tei:l>
          <tei:l>לְהַנְחִילָם</tei:l>
          <tei:l>נַחֲלַת יַעֲקֹב</tei:l>
          <tei:l>בְּחִירֶךָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yah_ekhsof_noam_shabbat_aharon/6"/>
        <tei:lg>
          <tei:l>הַשַּׁבָּת נוֹעַם</tei:l>
          <tei:l>הַנְּשָׁמוֹת,</tei:l>
          <tei:l>וְהַשְּׁבִיעִי עֹנֶג הָרוּחוֹת וְעֵדֶן הַנְּפָשׁוֹת,</tei:l>
          <tei:l>לְהִתְעַדֵּן בְּאַהֲבָתֶךָ וּבְיִרְאָתֶךָ,</tei:l>
          <tei:l>שַׁבָּת קֹדֶשׁ נַפְשִׁי</tei:l>
          <tei:l>חוֹלַת אַהֲבָתֶךָ,</tei:l>
          <tei:l>שַׁבָּת קוֹדֶשׁ</tei:l>
          <tei:l>נַפְשׁוֹת יִשְׂרָאֵל</tei:l>
          <tei:l>בְּצֵל כְּנָפֶיךָ</tei:l>
          <tei:l>יֶחֱסָיוּן,</tei:l>
          <tei:l>יִרְוְיֻן מִדֶּשֶׁן</tei:l>
          <tei:l>בֵּיתֶךָ.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
