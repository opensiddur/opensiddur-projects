  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yishtabbach_shimkha_36435">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yishtabbach_shimkha_36435/1"/>
        <tei:lg>
          <tei:l>Celebretur nomen tuum in æternum Rex noster,</tei:l>
          <tei:l>Deus tortis, Rex magne &amp; sancte</tei:l>
          <tei:l>in cœlis &amp; in terra,</tei:l>
          <tei:l>quoniam te decet, Domine,</tei:l>
          <tei:l>Deus noster, &amp; Deus patrum</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yishtabbach_shimkha_36435/2"/>
        <tei:lg>
          <tei:l>nostrorum canticum &amp; celebratio,</tei:l>
          <tei:l>laus &amp; psalmus,</tei:l>
          <tei:l>robur &amp; imperium,</tei:l>
          <tei:l>triumphus, magnificentia &amp; fortitudo,</tei:l>
          <tei:l>laus &amp; pulchritudo,</tei:l>
          <tei:l>sanctitas &amp; regnum,</tei:l>
          <tei:l>benedictiones &amp; confessiones</tei:l>
          <tei:l>ex nunc &amp; usque in seculum:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yishtabbach_shimkha_36435/3"/>
        <tei:lg>
          <tei:l>Benedictis sis tu, Domine,</tei:l>
          <tei:l>Deus fortis, Rex magne celebrationibus,</tei:l>
          <tei:l>Deus confessionum,</tei:l>
          <tei:l>Domine mirabilium,</tei:l>
          <tei:l>eligens in canticis celebrationum;</tei:l>
          <tei:l>Rex, Deus vivens in secula.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
