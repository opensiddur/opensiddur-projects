  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:princess_sabbath_al_qabets">
        <tei:head>לְכָה דוֹדִי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:princess_sabbath_al_qabets/2"/>
        <tei:lg>
          <tei:l>לְכָה דוֹדִי לִקְרַאת כַּלָּה</tei:l>
          <tei:l>פְּנֵי שַׁבָּת נְקַבְּלָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:princess_sabbath_al_qabets/3"/>
        <tei:lg>
          <tei:l>לִקְרַאת שַׁבָּת לְכוּ וְנֵלְכָה</tei:l>
          <tei:l>כִּי הִיא מְקוֹר הַבְּרָכָה</tei:l>
          <tei:l>מֵרֹאשׁ מִקֶּדֶם נְסוּכָה</tei:l>
          <tei:l>סוֹף מַעֲשֶׂה בְּמַחֲשָׁבָה תְּחִלָּה.</tei:l>
          <tei:l>לְכָה דוֹדִי לִקְרַאת כַּלָּה</tei:l>
          <tei:l>פְּנֵי שַׁבָּת נְקַבְּלָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:princess_sabbath_al_qabets/4"/>
        <tei:lg>
          <tei:l>הִתְנַעֲרִי מֵעָפָר קוּמִי</tei:l>
          <tei:l>לִבְשִׁי בִּגְדֵי תִפְאַרְתֵּךְ עַמִּי</tei:l>
          <tei:l>עַל יַד בֶּן יִשַׁי בֵּית הַלַּחְמִי</tei:l>
          <tei:l>קָרְבָה אֶל נַפְשִׁי גְאָלָהּ.</tei:l>
          <tei:l>לְכָה דוֹדִי לִקְרַאת כַּלָּה</tei:l>
          <tei:l>פְּנֵי שַׁבָּת נְקַבְּלָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:princess_sabbath_al_qabets/5"/>
        <tei:lg>
          <tei:l>בּוֹאִי בְּשָׁלוֹם עֲטֶרֶת בַּעֲלָהּ</tei:l>
          <tei:l>וְגַם בְּשִׁמְחָה וּבְצָהֳלָה</tei:l>
          <tei:l>תּוֹךְ אֱמוּנֵי עַם סְגוּלָה</tei:l>
          <tei:l>בּוֹאִי כַּלָּה בּוֹאִי כַּלָּה.</tei:l>
          <tei:l>לְכָה דוֹדִי לִקְרַאת כַּלָּה</tei:l>
          <tei:l>פְּנֵי שַׁבָּת נְקַבְּלָה.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
