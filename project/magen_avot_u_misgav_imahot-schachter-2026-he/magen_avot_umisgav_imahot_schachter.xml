      <tei:div corresp="urn:x-opensiddur:text:prayer:magen_avot_umisgav_imahot_schachter">
        <tei:head>מָגֵן אָבוֹת וּמִשְׂגָּב אִמָּהוֹת</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:magen_avot_umisgav_imahot_schachter/1"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְהֹוָה אֱלֹהֵֽינוּ</tei:l>
          <tei:l>וֵאלֹהֵי אֲבוֹתֵֽינוּ</tei:l>
          <tei:l>אֱלֹהֵי אַבְרָהָם וְשָׂרָה</tei:l>
          <tei:l>אֱלֹהֵי יִצְחָק וְרִבְקָה</tei:l>
          <tei:l>וֵאלֹהֵי יַעֲקֹב וְרָחֵל וּבִּלְהָה וְלֵאָה וְזִלְפָּה׃</tei:l>
          <tei:l>הָאֵל</tei:l>
          <tei:l>הַגָּדוֹל הַגִּבּוֹר וְהַנּוֹרָא</tei:l>
          <tei:l>אֵל עֶלְיוֹן</tei:l>
          <tei:l>גּוֹמֵל חֲסָדִים טוֹבִים</tei:l>
          <tei:l>וְקוֹנֵה הַכֹּל</tei:l>
          <tei:l>וְזוֹכֵר חַסְדֵי אָבוֹת וְאִמָּהוֹת</tei:l>
          <tei:l>וּמֵבִיא גוֹאֵל</tei:l>
          <tei:l>לִבְנֵי בְנֵיהֶם</tei:l>
          <tei:l>לְמַֽעַן שְׁמוֹ בְּאַהֲבָה׃</tei:l>
          <tei:l>מֶֽלֶךְ</tei:l>
          <tei:l>עוֹזֵר</tei:l>
          <tei:l>וּמוֹשִֽׁיעַ</tei:l>
          <tei:l>וּמָגֵן׃</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה</tei:l>
          <tei:l>מָגֵן אַבְרָהָם וּמִשְׂגָּב שָׂרָה׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
