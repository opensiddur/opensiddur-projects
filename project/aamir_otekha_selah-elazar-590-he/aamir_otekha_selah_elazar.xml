    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:aamir_otekha_selah_elazar">
        <tei:head>אַאֲמִיר אוֹתְךָ סֶֽלָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_otekha_selah_elazar/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אַ</tei:seg>אֲמִיר אוֹתְךָ סֶֽלָה</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>הוֹד וְהָדָר וּתְהִלָּה</tei:l>
          <tei:l><tei:seg type="acrostic">גּ</tei:seg>וֹאֵל הַצְמַח גְּאֻלָּה</tei:l>
          <tei:l><tei:seg type="acrostic">דְּ</tei:seg>רוֹשׁ אֲיֻמָּתְךָ לְשֵׁם וְלִתְהִלָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_otekha_selah_elazar/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הַ</tei:seg>צָּגִים בְּשִׂמְחָה</tei:l>
          <tei:l><tei:seg type="acrostic">וּ</tei:seg>בְלוּלָבֵיהֶם אוֹתְךָ לְשַׂמְּחָה</tei:l>
          <tei:l><tei:seg type="acrostic">ז</tei:seg>וֹעֲקִים לְפָנֶֽיךָ שִׂיחָה</tei:l>
          <tei:l><tei:seg type="acrostic">חֲ</tei:seg>מֹל עֲלֵיהֶם הוֹשִֽׁיעָה וְהַצְלִֽיחָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_otekha_selah_elazar/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ט</tei:seg>וֹב בְּרַחֲמֶֽיךָ הָרַבִּים</tei:l>
          <tei:l><tei:seg type="acrostic">יַ</tei:seg>קֵּר עֲדַת אֲהוּבִים</tei:l>
          <tei:l><tei:seg type="acrostic">כּ</tei:seg>וֹרְעִים וּמִשְׁתַּחֲוִים וּמוֹדִים בָּאֳהָבִים</tei:l>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>שַֽׁעַר בַּת רַבִּים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_otekha_selah_elazar/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מַ</tei:seg>חֲמַדָּם תֵּן לָהֶם</tei:l>
          <tei:l><tei:seg type="acrostic">נָ</tei:seg>א שְׂמַח עִמָּהֶם</tei:l>
          <tei:l><tei:seg type="acrostic">שָׂ</tei:seg>א נָא חַטֹּאתֵיהֶם</tei:l>
          <tei:l><tei:seg type="acrostic">עֲ</tei:seg>בֹור עַל פִּשְׁעֵיהֶם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_otekha_selah_elazar/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פּ</tei:seg>וֹצְחִים הַלֵּל וְתוֹדוֹת</tei:l>
          <tei:l><tei:seg type="acrostic">צ</tei:seg>וּר הַיּוֹדֵֽעַ עֲתִידוֹת</tei:l>
          <tei:l><tei:seg type="acrostic">ק</tei:seg>וֹל לְהַשְׁמִֽיעַ אוֹתָם לַחֲדוֹת</tei:l>
          <tei:l><tei:seg type="acrostic">רַ</tei:seg>חֲמֵם בְּנָשְׂאָם אֲגֻדּוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_otekha_selah_elazar/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שׁ</tei:seg>וֹקְדִים וְאוֹתְךָ מַקְדִּישִׁים</tei:l>
          <tei:l><tei:seg type="acrostic">שִׁ</tei:seg>בְחֲךָ בְּפִיהֶם רוֹחֲשִׁים</tei:l>
          <tei:l><tei:seg type="acrostic">תּ</tei:seg>וֹקְפִים בָּרוּךְ וְלוֹחֲשִׁים</tei:l>
          <tei:l><tei:seg type="acrostic">תּ</tei:seg>וֹמְכִים כְּאֵילֵי תַרְשִׁישִׁים׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
