    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/147">
        <tei:head>תהלים קמ״ז</tei:head>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>הַ֥לְלוּ יָ֨הּ ׀</tei:l>
          <tei:l>כִּי־ט֭וֹב זַמְּרָ֣ה אֱלֹהֵ֑ינוּ</tei:l>
          <tei:l>כִּֽי־נָ֝עִים</tei:l>
          <tei:l>נָאוָ֥ה תְהִלָּֽה׃</tei:l>
          <tei:l>בּוֹנֵ֣ה יְרוּשָׁלִַ֣ם יְהוָ֑ה</tei:l>
          <tei:l>נִדְחֵ֖י</tei:l>
          <tei:l>יִשְׂרָאֵ֣ל יְכַנֵּֽס׃</tei:l>
          <tei:l>הָ֭רֹפֵא לִשְׁב֣וּרֵי לֵ֑ב</tei:l>
          <tei:l>וּ֝מְחַבֵּ֗שׁ</tei:l>
          <tei:l>לְעַצְּבוֹתָֽם׃</tei:l>
          <tei:l>מוֹנֶ֣ה מִ֭סְפָּר לַכּוֹכָבִ֑ים</tei:l>
          <tei:l>לְ֝כֻלָּ֗ם שֵׁמ֥וֹת</tei:l>
          <tei:l>יִקְרָֽא׃</tei:l>
          <tei:l>גָּד֣וֹל אֲדוֹנֵ֣ינוּ</tei:l>
          <tei:l>וְרַב־כֹּ֑חַ</tei:l>
          <tei:l>לִ֝תְבוּנָת֗וֹ</tei:l>
          <tei:l>אֵ֣ין מִסְפָּֽר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/147/6/a"/>
        <tei:lg>
          <tei:l>מְעוֹדֵ֣ד עֲנָוִ֣ים יְהוָ֑ה</tei:l>
          <tei:l>מַשְׁפִּ֖יל רְשָׁעִ֣ים עֲדֵי־אָֽרֶץ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/147/7/a"/>
        <tei:lg>
          <tei:l>עֱנ֣וּ לַיהוָ֣ה בְּתוֹדָ֑ה</tei:l>
          <tei:l>זַמְּר֖וּ</tei:l>
          <tei:l>לֵאלֹהֵ֣ינוּ</tei:l>
          <tei:l>בְכִנּֽוֹר׃</tei:l>
          <tei:l>הַֽמְכַסֶּ֬ה שָׁמַ֨יִם ׀</tei:l>
          <tei:l>בְּעָבִ֗ים</tei:l>
          <tei:l>הַמֵּכִ֣ין לָאָ֣רֶץ מָטָ֑ר</tei:l>
          <tei:l>הַמַּצְמִ֖יחַ הָרִ֣ים חָצִֽיר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/147/9/a"/>
        <tei:lg>
          <tei:l>נוֹתֵ֣ן לִבְהֵמָ֣ה</tei:l>
          <tei:l>לַחְמָ֑הּ</tei:l>
          <tei:l>לִבְנֵ֥י עֹ֝רֵ֗ב</tei:l>
          <tei:l>אֲשֶׁ֣ר יִקְרָֽאוּ׃</tei:l>
          <tei:l>לֹ֤א בִגְבוּרַ֣ת</tei:l>
          <tei:l>הַסּ֣וּס יֶחְפָּ֑ץ</tei:l>
          <tei:l>לֹֽא־בְשׁוֹקֵ֖י</tei:l>
          <tei:l>הָאִ֣ישׁ יִרְצֶֽה׃</tei:l>
          <tei:l>רוֹצֶ֣ה יְ֭הוָה</tei:l>
          <tei:l>אֶת־יְרֵאָ֑יו</tei:l>
          <tei:l>אֶת־הַֽמְיַחֲלִ֥ים לְחַסְדּֽוֹ׃</tei:l>
          <tei:l>שַׁבְּחִ֣י יְ֭רוּשָׁלִַם</tei:l>
          <tei:l>אֶת־יְהוָ֑ה הַֽלְלִ֖י</tei:l>
          <tei:l>אֱלֹהַ֣יִךְ צִיּֽוֹן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/147/13/a"/>
        <tei:lg>
          <tei:l>כִּֽי־חִ֭זַּק</tei:l>
          <tei:l>בְּרִיחֵ֣י שְׁעָרָ֑יִךְ</tei:l>
          <tei:l>בֵּרַ֖ךְ בָּנַ֣יִךְ</tei:l>
          <tei:l>בְּקִרְבֵּֽךְ׃</tei:l>
          <tei:l>הַשָּׂם־גְּבוּלֵ֥ךְ שָׁל֑וֹם</tei:l>
          <tei:l>חֵ֥לֶב חִ֝טִּ֗ים</tei:l>
          <tei:l>יַשְׂבִּיעֵֽךְ׃</tei:l>
          <tei:l>הַשֹּׁלֵ֣חַ אִמְרָת֣וֹ</tei:l>
          <tei:l>אָ֑רֶץ</tei:l>
          <tei:l>עַד־מְ֝הֵרָ֗ה יָר֥וּץ דְּבָרֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/147/16/a"/>
        <tei:lg>
          <tei:l>הַנֹּתֵ֣ן שֶׁ֣לֶג כַּצָּ֑מֶר</tei:l>
          <tei:l>כְּ֝פ֗וֹר</tei:l>
          <tei:l>כָּאֵ֥פֶר יְפַזֵּֽר׃</tei:l>
          <tei:l>מַשְׁלִ֣יךְ קַֽרְח֣וֹ כְפִתִּ֑ים</tei:l>
          <tei:l>לִפְנֵ֥י קָ֝רָת֗וֹ</tei:l>
          <tei:l>מִ֣י יַעֲמֹֽד׃</tei:l>
          <tei:l>יִשְׁלַ֣ח דְּבָר֣וֹ וְיַמְסֵ֑ם</tei:l>
          <tei:l>יַשֵּׁ֥ב ר֝וּח֗וֹ</tei:l>
          <tei:l>יִזְּלוּ־מָֽיִם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/147/16/b"/>
        <tei:lg>
          <tei:l>מַגִּ֣יד דברו [דְּבָרָ֣יו] לְיַעֲקֹ֑ב</tei:l>
          <tei:l>חֻקָּ֥יו וּ֝מִשְׁפָּטָ֗יו</tei:l>
          <tei:l>לְיִשְׂרָאֵֽל׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>לֹ֘א עָ֤שָׂה כֵ֨ן ׀</tei:l>
          <tei:l>לְכָל־גּ֗וֹי וּמִשְׁפָּטִ֥ים</tei:l>
          <tei:l>בַּל־יְדָע֗וּם</tei:l>
          <tei:l>הַֽלְלוּ־יָֽהּ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
