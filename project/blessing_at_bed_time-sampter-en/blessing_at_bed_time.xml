  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:blessing_at_bed_time">
        <tei:head>Blessing at Bed Time (for children), a rhyming translation by Jessie Ethel Sampter (1919)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_at_bed_time/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">(Before saying the Sh’ma)</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_at_bed_time/2"/>
        <tei:lg>
          <tei:l>O blessed God, our Lord and King,</tei:l>
          <tei:l>Sleep to my tired eyes you bring;</tei:l>
          <tei:l>In peace I hope to shut my eyes.</tei:l>
          <tei:l>In peace again I hope to rise.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_at_bed_time/4"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">(After saying the Sh’ma)</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_at_bed_time/5"/>
        <tei:lg>
          <tei:l>Blessed is God in the daylight,</tei:l>
          <tei:l>Blessed is God in the dark night,</tei:l>
          <tei:l>Blessed is God who shuts my eyes,</tei:l>
          <tei:l>Blessed is God when I arise.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_at_bed_time/6"/>
        <tei:lg>
          <tei:l>And He that Israel does keep</tei:l>
          <tei:l>Shall never slumber, never sleep. <tei:bibl>(Psalms 121:4)</tei:bibl></tei:l>
          <tei:l>He holds me safe within His hand</tei:l>
          <tei:l>The while I rest in slumberland.</tei:l>
          <tei:l>O Lord and God of truth is He <tei:bibl>(Psalms 31:6)</tei:bibl></tei:l>
          <tei:l>Who watches over mine and me.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
