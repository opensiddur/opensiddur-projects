  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:gavriel_is_on_the_right_levene">
        <tei:head>"Gavriel is on the right," an apotropaic invocation of angelic protection in the amulet bowl SD12 (ca. mid-first millennium C.E.)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gavriel_is_on_the_right_levene/1"/>
        <tei:lg>
          <tei:l>May Gavriel be on the right</tei:l>
          <tei:l>of Dudita bat Dudai, and her sons and her daughters,<tei:anchor xml:id="note_1"/></tei:l>
          <tei:l>and Mikhael be on her left,</tei:l>
          <tei:l>and before her, Susiel,</tei:l>
          <tei:l>and behind her, Menuḥa,</tei:l>
          <tei:l>and above her, Shekhinat-El.</tei:l>
          <tei:l>“YHVH Tsevaot is his Name” <tei:bibl>(Isaiah 51:15)</tei:bibl>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gavriel_is_on_the_right_levene/2"/>
        <tei:lg>
          <tei:l>Remove from her,</tei:l>
          <tei:l>from Dudita bat Dudai, and from her sons and from her daughters, <tei:anchor xml:id="note_2"/></tei:l>
          <tei:l>every evil affliction</tei:l>
          <tei:l>and every evil <tei:hi rend="italic">satan</tei:hi><tei:anchor xml:id="note_3"/></tei:l>
          <tei:l>and every evil <tei:hi rend="italic">ḥayah</tei:hi><tei:anchor xml:id="note_4"/></tei:l>
          <tei:l>and every evil decree<tei:anchor xml:id="note_5"/></tei:l>
          <tei:l>and every evil utterance</tei:l>
          <tei:l>and all the Succubi<tei:anchor xml:id="note_6"/> in the world.</tei:l>
          <tei:l>Ehyeh Asher Ehyeh<tei:anchor xml:id="note_7"/> <tei:bibl>(Exodus 3:14)</tei:bibl>.</tei:l>
          <tei:l><tei:hi rend="italic">Amen, Amen, Selah</tei:hi>.</tei:l>
          <tei:l>Hallelu-Yah!</tei:l>
          <tei:l>and [it is] binding and valid.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gavriel_is_on_the_right_levene/3"/>
        <tei:lg>
          <tei:l>This seal is forever.</tei:l>
          <tei:l><tei:hi rend="italic">Amen</tei:hi> and <tei:hi rend="italic">Amen</tei:hi>.</tei:l>
          <tei:l>And [it is] valid.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" n="1" target="#note_1">
      <tei:p>The name of the woman for whom this amulet bowl is being put to use, and her progeny.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="2" target="#note_2">
      <tei:p>See note above.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="3" target="#note_3">
      <tei:p>lit. accuser.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="4" target="#note_4">
      <tei:p>lit. living creature, i.e., a dangerous wild animal in contradistinction to a <tei:hi rend="italic">behemah</tei:hi>, a tame or domesticated animal.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="5" target="#note_5">
      <tei:p>lit. word.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="6" target="#note_6">
      <tei:p>lit. spirits of intercourse.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="7" target="#note_7">
      <tei:p>the divine name, which literally translates to “I am that I am.”</tei:p>
    </tei:note>
  </tei:standOff>
</tei:TEI>