  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:illu_pume_nima_meir">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:illu_pume_nima_meir/1"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">אִ</tei:seg>ילּוּ פּוּמֵּי נִימֵי</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>נֵי נָשָׁא רָשְׁמֵי</tei:l>
          <tei:l><tei:seg type="acrostic">גְּ</tei:seg>וִילֵי שְׁמַיָּא וּשְׁמֵי</tei:l>
          <tei:l><tei:seg type="acrostic">דְּ</tei:seg>יוֹתָא כָל־יַמֵּי</tei:l>
          <tei:l><tei:seg type="acrostic">הֲ</tei:seg>דַר מָרֵא עָלְמֵי</tei:l>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>שַׁלִּיט בְּכָל־תְּחוּמֵי</tei:l>
          <tei:l><tei:seg type="acrostic">זְ</tei:seg>עֵיר סָפְקֵי סָכְמֵי</tei:l>
          <tei:l><tei:seg type="acrostic">חֲ</tei:seg>דָא לְרִבְבָן קַמֵּי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:illu_pume_nima_meir/2"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">טְ</tei:seg>פֵי טָבְוָן וְרַחֲמֵי</tei:l>
          <tei:l><tei:seg type="acrostic">יִ</tei:seg>תּוּר חַסְדִין דְּאֶחֱמֵי</tei:l>
          <tei:l><tei:seg type="acrostic">כְּ</tei:seg>דִי פְרַק מֵעֲנָמֵי</tei:l>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>עַם חַבִּיב כְּנַמֵּי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:illu_pume_nima_meir/3"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">מַ</tei:seg>טּוּל אֱסָר וְאַיְמֵי</tei:l>
          <tei:l><tei:seg type="acrostic">נְ</tei:seg>הַר לְאֵיתָן קְיָמֵי</tei:l>
          <tei:l><tei:seg type="acrostic">סְ</tei:seg>עַר לַוָּה לִשְׁלָמֵי</tei:l>
          <tei:l><tei:seg type="acrostic">עֲ</tei:seg>דַי בְּנוֹי לְשַׁלּוֹמֵי</tei:l>
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>רַע לְהוֹן בְּאַלָּמֵי</tei:l>
          <tei:l><tei:seg type="acrostic">צְ</tei:seg>לַב שַׁבָּיֵי רָמֵי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:illu_pume_nima_meir/4"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>טַר שַׁלַּח לְאַשְׁלוֹמֵי</tei:l>
          <tei:l><tei:seg type="acrostic">צְ</tei:seg>בִי פֶּרְנִין שַׁלִּי־מֵי</tei:l>
          <tei:l><tei:seg type="acrostic">קְ</tei:seg>בֵיל וַי כַּד־חֲמֵי</tei:l>
          <tei:l><tei:seg type="acrostic">רִ</tei:seg>בְוַתְהוֹן עַל־יַמֵּי</tei:l>
          <tei:l><tei:seg type="acrostic">שְׁ</tei:seg>פַר טַכְסִיס קוּמֵּי</tei:l>
          <tei:l><tei:seg type="acrostic">תְּ</tei:seg>חִימִין בְּכָל־דּוּגְמֵי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:illu_pume_nima_meir/5"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">מְ</tei:seg>תַל מִילְּתָא דָּמֵי</tei:l>
          <tei:l><tei:seg type="acrostic">אָ</tei:seg>חָד עַטְלָא דְּאִיתְרְמֵי</tei:l>
          <tei:l><tei:seg type="acrostic">יְ</tei:seg>רוּתָּא קֶרֶת יַמֵּי</tei:l>
          <tei:l><tei:seg type="acrostic">רַ</tei:seg>טְשָׁא בְּצִבְחַד דְּמֵי</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>דִי זַבְנָא בְּטִימֵי</tei:l>
          <tei:l><tei:seg type="acrostic">רְ</tei:seg>פֵיק וְאַשְׁכַּח סֵימֵי</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>הֵת מְזַבֵּן כִּסְמֵי</tei:l>
          <tei:l><tei:seg type="acrostic">יְ</tei:seg>הֵא חֲנִיק וְעָמֵי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:illu_pume_nima_meir/6"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">יְ</tei:seg>קוּם רַעֲוָה מִשְּׁמֵי</tei:l>
          <tei:l><tei:seg type="acrostic">צָ</tei:seg>דוּ עֲנָם וּשְׁמָמֵי</tei:l>
          <tei:l><tei:seg type="acrostic">חֲ</tei:seg>שִּׁיכָא קֶרֶת רוֹמֵי</tei:l>
          <tei:l><tei:seg type="acrostic">קְ</tei:seg>בֵיל הָכֵין יִתְרְמֵי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:illu_pume_nima_meir/7"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">חֲ</tei:seg>בַל לְעַבְרָא מִדַּמֵי</tei:l>
          <tei:l><tei:seg type="acrostic">זְ</tei:seg>בַן נוּנָא דָּמֵי</tei:l>
          <tei:l><tei:seg type="acrostic">קְ</tei:seg>נִיטָא לֵיה בְּלוּגְמֵי</tei:l>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>תוּ לְקָה בְּגַמְגּוֹמֵי</tei:l>
          <tei:l><tei:seg type="acrostic">אֲ</tei:seg>רַא לֵיהּ בְּאַלּוּמֵי</tei:l>
          <tei:l><tei:seg type="acrostic">מְ</tei:seg>שַׁלֵּם לֵיהּ בְּלוּמֵי</tei:l>
          <tei:l><tei:seg type="acrostic">צְ</tei:seg>נַע הַפְרַע וְשִׁיעֲמֵּיהּ</tei:l>
          <tei:l>צְבִי וְשַׁלַּח לְעַמֵּיהּ</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
