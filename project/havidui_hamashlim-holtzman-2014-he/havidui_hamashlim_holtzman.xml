  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:havidui_hamashlim_holtzman">
        <tei:head>הַוִּדּוּי הַמַּשְׁלִים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:havidui_hamashlim_holtzman/1"/>
        <tei:lg>
          <tei:l>...עַל כֵּן, כְּשֵׁם שֶׁיֵּשׁ תּוֹעֶלֶת גְּדוֹלָה</tei:l>
          <tei:l>לְתִקּוּן הַנֶּפֶשׁ בְּוִדּוּי הָעֲווֹנוֹת...</tei:l>
          <tei:l>גַּם כֵּן בְּוִדּוּי הַמִּצְווֹת,</tei:l>
          <tei:l>לְמַעַן יִשְׂמַח בָּהֶם בִּלְבָבוֹ,</tei:l>
          <tei:l>וִיחַזֵּק אָרְחוֹת חַיָּיו בְּדֶרֶךְ ה׳.</tei:l>
          <tei:l>
            <tei:bibl>(הרב קוק, עין אי״ה, מסכת מעשר שני ז:י‏)</tei:bibl>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:havidui_hamashlim_holtzman/2"/>
        <tei:lg>
          <tei:l>הַוִּדּוּי הַמַּשְׁלִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:havidui_hamashlim_holtzman/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אָ</tei:seg>הַבְנוּ,</tei:l>
          <tei:l><tei:seg type="acrostic">בָּ</tei:seg>כִינוּ,</tei:l>
          <tei:l><tei:seg type="acrostic">גָּ</tei:seg>מַלְנוּ,</tei:l>
          <tei:l><tei:seg type="acrostic">דִּ</tei:seg>בַּרְנוּ יֹפִי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:havidui_hamashlim_holtzman/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הֶ</tei:seg>אֱמַנּוּ,</tei:l>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>הִשְׁתַּדַּלְנוּ,</tei:l>
          <tei:l><tei:seg type="acrostic">זָ</tei:seg>כַרְנוּ,</tei:l>
          <tei:l><tei:seg type="acrostic">חִ</tei:seg>בַּקְנוּ,</tei:l>
          <tei:l><tei:seg type="acrostic">טָ</tei:seg>עַמְנוּ סֵפֶר.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:havidui_hamashlim_holtzman/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>צַרְנוּ,</tei:l>
          <tei:l><tei:seg type="acrostic">כָּ</tei:seg>מַהֲנוּ,</tei:l>
          <tei:l><tei:seg type="acrostic">לָ</tei:seg>חַמְנוּ עֲבוּר הַצֶּדֶק,</tei:l>
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>צִּינוּ אֶת הַטּוֺב.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:havidui_hamashlim_holtzman/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נִ</tei:seg>סִּינוּ,</tei:l>
          <tei:l><tei:seg type="acrostic">סַ</tei:seg>רְנוּ לִרְאוֹת,</tei:l>
          <tei:l><tei:seg type="acrostic">עָ</tei:seg>שִׂינוּ אֲשֶׁר צִוִּיתָנוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:havidui_hamashlim_holtzman/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פֵּ</tei:seg>רַשְׁנוּ,</tei:l>
          <tei:l><tei:seg type="acrostic">צָ</tei:seg>דַקְנוּ לִפְעָמִים,</tei:l>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>רָאנוּ בְּשִׁמְךָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:havidui_hamashlim_holtzman/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רָ</tei:seg>צִינוּ,</tei:l>
          <tei:l><tei:seg type="acrostic">שָׂ</tei:seg>מַחְנוּ,</tei:l>
          <tei:l><tei:seg type="acrostic">תָּ</tei:seg>מַכְנוּ.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
