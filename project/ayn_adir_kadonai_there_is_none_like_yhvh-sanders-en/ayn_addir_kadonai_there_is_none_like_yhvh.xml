  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai_there_is_none_like_yhvh">
        <tei:head>Ayn Adir kAdonai (Mipi El) :: There is none like YHVH</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai_there_is_none_like_yhvh/1"/>
        <tei:lg>
          <tei:l>From the mouth of אל</tei:l>
          <tei:l>Yisra’el will be blessed.</tei:l>
          <tei:l>Yisra’el will be blessed</tei:l>
          <tei:l>from the mouth of אל.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai_there_is_none_like_yhvh/2"/>
        <tei:lg>
          <tei:l>There is none as powerful as יהוה</tei:l>
          <tei:l>There is none as blessed as the son of Amram</tei:l>
          <tei:l>There is nothing as great as the Torah</tei:l>
          <tei:l>And none who interpret it like Yisra’el</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai_there_is_none_like_yhvh/3"/>
        <tei:lg>
          <tei:l>There is none as adorned as יהוה</tei:l>
          <tei:l>There is none as trustworthy as the son of Amram</tei:l>
          <tei:l>There is no reward like the Torah</tei:l>
          <tei:l>And none who are its wise ones like Yisra’el</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai_there_is_none_like_yhvh/4"/>
        <tei:lg>
          <tei:l>There is none as pure as יהוה</tei:l>
          <tei:l>There is none as righteous as the son of Amram</tei:l>
          <tei:l>There is no honor like the Torah</tei:l>
          <tei:l>And none who learn it like Yisra’el</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai_there_is_none_like_yhvh/5"/>
        <tei:lg>
          <tei:l>There is no king like יהוה</tei:l>
          <tei:l>There is prophet like the son of Amram</tei:l>
          <tei:l>There is no treasured posession like the Torah</tei:l>
          <tei:l>And none who are devoted to it like Yisra’el</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai_there_is_none_like_yhvh/6"/>
        <tei:lg>
          <tei:l>There is none who save like יהוה</tei:l>
          <tei:l>There is none as just as the son of Amram</tei:l>
          <tei:l>There is no holiness like the Torah</tei:l>
          <tei:l>And none who elevate it like Yisra’el</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai_there_is_none_like_yhvh/7"/>
        <tei:lg>
          <tei:l>There in none as holy as יהוה</tei:l>
          <tei:l>There is none as merciful as the son of Amram</tei:l>
          <tei:l>There is no observance like the Torah</tei:l>
          <tei:l>And none who support it like Yisra’el.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
