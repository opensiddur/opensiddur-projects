  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:havidui_hamashlim_holtzman">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:havidui_hamashlim_holtzman/1"/>
        <tei:lg xml:lang="en">
          <tei:l>Al ken, k’shem she’yesh to’elet g’dolah</tei:l>
          <tei:l>l’tiqun hanefesh b’vidui ha’avonot</tei:l>
          <tei:l>gam ken b’vidui hamitsvot</tei:l>
          <tei:l>l’ma’an yismaḥ bahem bilvavo</tei:l>
          <tei:l>viḥazeq arḥot ḥayyav b’derekh hashem.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:havidui_hamashlim_holtzman/2"/>
        <tei:lg xml:lang="en">
          <tei:l>HaVidui haMashlim</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:havidui_hamashlim_holtzman/3"/>
        <tei:lg xml:lang="en">
          <tei:l>Ahavnu</tei:l>
          <tei:l>Bakhinu</tei:l>
          <tei:l>Gamalnu</tei:l>
          <tei:l>Dibarnu yofi</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:havidui_hamashlim_holtzman/4"/>
        <tei:lg xml:lang="en">
          <tei:l>He’emanu</tei:l>
          <tei:l>v’Hish’tadalnu</tei:l>
          <tei:l>Zakharnu</tei:l>
          <tei:l>Ḥibaqnu</tei:l>
          <tei:l>Ta’amnu Sefer</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:havidui_hamashlim_holtzman/5"/>
        <tei:lg xml:lang="en">
          <tei:l>Yatsarnu</tei:l>
          <tei:l>Kamahanu</tei:l>
          <tei:l>Laḥamnu avur haTsedeq</tei:l>
          <tei:l>Mitsinu et haTov</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:havidui_hamashlim_holtzman/6"/>
        <tei:lg xml:lang="en">
          <tei:l>Nisinu</tei:l>
          <tei:l>Sarnu lir’ōt</tei:l>
          <tei:l>Asinu asher tsivitanu</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:havidui_hamashlim_holtzman/7"/>
        <tei:lg xml:lang="en">
          <tei:l>Perashnu</tei:l>
          <tei:l>Tsadaqnu lifamim</tei:l>
          <tei:l>Ḳaranu b’shimkha</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:havidui_hamashlim_holtzman/8"/>
        <tei:lg xml:lang="en">
          <tei:l>Ratsinu</tei:l>
          <tei:l>Samaḥnu</tei:l>
          <tei:l>Tamakhnu</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>