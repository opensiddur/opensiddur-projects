  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_for_mental_health_wellness_foundation">
        <tei:head>מִי שֶׁבֵּרַךְ לְבָּרְוָחָה הַנַּפְשִׁית</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_for_mental_health_wellness_foundation/1"/>
        <tei:lg>
          <tei:l>מִי שֶׁבֵּרַךְ אֲבוֹתֵינוּ</tei:l>
          <tei:l>אֲשֶׁר קָרָא לָנוּ יִשְׂרָאֵל</tei:l>
          <tei:l>שֶׁנֶּאֱמַר שָׂרִיתָ עִם אֱלֹהִים, <tei:bibl>(בראשית לב:כט)</tei:bibl></tei:l>
          <tei:l>הוּא יְבָרֵךְ וִירַפֵּא אֶת אֵלּוּ מִבֵּינֵינוּ</tei:l>
          <tei:l>הַנֶּאֱבָקִים בָּרְוָחָה הַנַּפְשִׁית.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_for_mental_health_wellness_foundation/2"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן</tei:l>
          <tei:l>שֶׁיַּכִּירוּ בְּכוֹחָם</tei:l>
          <tei:l>וּבְחָסְנָם,</tei:l>
          <tei:l>וְיִתְיַחֲסוּ לְעַצְמָם</tei:l>
          <tei:l>בִּסְלִיחָה</tei:l>
          <tei:l>וּבְסַבְלָנוּת,</tei:l>
          <tei:l>וְיִמְצְאוּ עֶזְרָה,</tei:l>
          <tei:l>חֶמְלָה</tei:l>
          <tei:l>וּמַשְׁאַבִּים</tei:l>
          <tei:l>בְּעֵת צָרָתָם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_for_mental_health_wellness_foundation/3"/>
        <tei:lg>
          <tei:l>הַקָּדוֹשׁ בָּרוּךְ הוּא יַעֲנִיק לָאֵלּוּ מֵאִתָּנוּ</tei:l>
          <tei:l>שֶׁאֵינָם חוֹוִים קְשִׁיִּם נַפְשִׁיּם</tei:l>
          <tei:l>אֶת הַכֹּחַ,</tei:l>
          <tei:l>הַחֹסֶן</tei:l>
          <tei:l>וְהַיְּכֹלֶת</tei:l>
          <tei:l>לְהַקְשִׁיב לְלֹא שִׁפּוּט</tei:l>
          <tei:l>וּמִתּוֹךְ כַּוָּנָה,</tei:l>
          <tei:l>וְאֶת הַיְּכֹלֶת לְהַבְחִין</tei:l>
          <tei:l>כַּאֲשֶׁר אֲחֵרִים נֶאֱבָקִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_for_mental_health_wellness_foundation/4"/>
        <tei:lg>
          <tei:l>יְהִי רְצוֹנְךָ</tei:l>
          <tei:l>שֶׁנִּצּוֹר קְהִלּוֹת</tei:l>
          <tei:l>שֶׁמְּקַבְּלוֹת,</tei:l>
          <tei:l>מֵרוֹמְמוֹת</tei:l>
          <tei:l>וְתוֹמְכוֹת</tei:l>
          <tei:l>בְּאֵלֶּה שֶׁבֵּינֵינוּ הַנֶּאֱבָקִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_for_mental_health_wellness_foundation/5"/>
        <tei:lg>
          <tei:l>הַשְׁתָּא בַּעֲגָלָא</tei:l>
          <tei:l>וּבִזְמַן קָרִיב.</tei:l>
          <tei:l>וְנֹאמַר אָמֵן.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
