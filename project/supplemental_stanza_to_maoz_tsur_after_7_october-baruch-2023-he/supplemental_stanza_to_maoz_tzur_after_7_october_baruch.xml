  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:supplemental_stanza_to_maoz_tzur_after_7_october_baruch">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:supplemental_stanza_to_maoz_tzur_after_7_october_baruch/2"/>
        <tei:lg>
          <tei:l>וְאַרְצָה מְעוֹן צִיּוֹנֵנוּ הוֹצֵיא כְאוֹר מִשְׁפָּטֵנוּ</tei:l>
          <tei:l>שַׁחְרֵר מֵחָמָס מִשְׁפַּחְתֵּנוּ וּתְנֵנוּ שְׁלוֹמֵנוּ</tei:l>
          <tei:l>כִּי שׂוֹנֵאנוּ אָחִינוּ וּמִשְׁתַּלֵּחַ לְהַחְרִיבֵנוּ</tei:l>
          <tei:l>לָעֶרֶב אוֹר לַבּוֹקֶר דְּרוֹר כְּטַל חֶרמוֹן בְּאַרְצֵנוּ</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
