  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_military_personnel_on_active_service_hertz">
        <tei:head>Prayer for Military Personnel on Active Service (Office of the Chief Rabbi of the United Hebrew Congregations 1940)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_military_personnel_on_active_service_hertz/1"/>
        <tei:lg>
          <tei:l><j:divineName>God of the spirits of all flesh</j:divineName>!</tei:l>
          <tei:l>Thou art our refuge and strength,</tei:l>
          <tei:l>our very present help in war as in peace.</tei:l>
          <tei:l>Our lives are in thy hands,</tei:l>
          <tei:l>and thou art the master of our destinies.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_military_personnel_on_active_service_hertz/2"/>
        <tei:lg>
          <tei:l>O endow us with courage and steadfastness</tei:l>
          <tei:l>loyally to do our duty as true Israelites to King and Country,</tei:l>
          <tei:l>and to take our full share in this War for Freedom and Righteousness.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_military_personnel_on_active_service_hertz/3"/>
        <tei:lg>
          <tei:l>O keep us far from what thou hatest;</tei:l>
          <tei:l>and bring us near to what thou lovest.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_military_personnel_on_active_service_hertz/4"/>
        <tei:lg>
          <tei:l>Shield us from sorrow and hurt,</tei:l>
          <tei:l>and deal mercifully with us for thy <j:divineName>Name</j:divineName>’s sake, O <j:divineName>God</j:divineName>,</tei:l>
          <tei:l>who alone art <j:divineName>our Guardian</j:divineName> and <j:divineName>Deliverer</j:divineName> forever.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_military_personnel_on_active_service_hertz/5"/>
        <tei:lg>
          <tei:l><tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
      </tei:div>
