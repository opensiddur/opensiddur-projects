  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:blessing_for_torah_study/1">
        <tei:head>ברכות התורה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_for_torah_study/1/1"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם,</tei:l>
          <tei:l>אֲשֶׁר קִדְּשָׁנוּ בְּמִצְוֹתָיו,</tei:l>
          <tei:l>וְצִוָּנוּ</tei:l>
          <tei:l>עַל דִבְרֵי תוֹרָה:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_for_torah_study/1/2"/>
        <tei:lg>
          <tei:l>וְהַעֲרֶב נָא יְיָ אֱלֹהֵינוּ</tei:l>
          <tei:l>אֶת דִּבְרֵי תוֹרָתְךָ בְּפִינוּ,</tei:l>
          <tei:l>וּבְפִי כָל עַמְּךָ בֵּית יִשְׂרָאֵל.</tei:l>
          <tei:l>וְנִהְיֶה אֲנַחְנוּ</tei:l>
          <tei:l>וְצֶאֱצָאֵינוּ,</tei:l>
          <tei:l>וְצֶאֱצָאֵי כָל עַמְּךָ בֵּית יִשְׂרָאֵל,</tei:l>
          <tei:l>כֻּלָּנוּ יוֹדְעֵי שְׁמֶךָ</tei:l>
          <tei:l>וְלוֹמְדֵי תוֹרָתֶךָ לִשְׁמָהּ.</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>הַמְלַמֵּד תּוֹרָה</tei:l>
          <tei:l>לְעַמּוֹ יִשְׂרָאֵל:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_for_torah_study/1/3"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם,</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>אֲשֶׁר בָּחַר בָּנוּ</tei:l>
          <tei:l>מִכָּל הָעַמִּים,</tei:l>
          <tei:l>וְנָתַן לָנוּ</tei:l>
          <tei:l>אֶת תּוֹרָתוֹ.</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>נוֹתֵן</tei:l>
          <tei:l>הַתּוֹרָה:</tei:l>
        </tei:lg>
      </tei:div>
