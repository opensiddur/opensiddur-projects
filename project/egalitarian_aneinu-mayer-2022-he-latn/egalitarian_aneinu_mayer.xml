  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:egalitarian_aneinu_mayer">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:egalitarian_aneinu_mayer/1"/>
        <tei:lg>
          <tei:l>Aneinu,</tei:l>
          <tei:l>Elohei avoténu!</tei:l>
          <tei:l>Aneinu!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:egalitarian_aneinu_mayer/2"/>
        <tei:lg>
          <tei:l>Aneinu,</tei:l>
          <tei:l>Elohei Avraham!</tei:l>
          <tei:l>Aneinu!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:egalitarian_aneinu_mayer/3"/>
        <tei:lg>
          <tei:l>Aneinu,</tei:l>
          <tei:l>Páḥad Yitzḥak!</tei:l>
          <tei:l>Aneinu!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:egalitarian_aneinu_mayer/4"/>
        <tei:lg>
          <tei:l>Aneinu,</tei:l>
          <tei:l>Avir Ya’akov!</tei:l>
          <tei:l>Aneinu!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:egalitarian_aneinu_mayer/5"/>
        <tei:lg>
          <tei:l>Aneinu,</tei:l>
          <tei:l>Misgav imahot!</tei:l>
          <tei:l>Aneinu!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:egalitarian_aneinu_mayer/6"/>
        <tei:lg>
          <tei:l>Aneinu,</tei:l>
          <tei:l>Poked Sarah!</tei:l>
          <tei:l>Aneinu!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:egalitarian_aneinu_mayer/7"/>
        <tei:lg>
          <tei:l>Aneinu,</tei:l>
          <tei:l>Ne’etar l-Rivkah!</tei:l>
          <tei:l>Aneinu!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:egalitarian_aneinu_mayer/8"/>
        <tei:lg>
          <tei:l>Aneinu,</tei:l>
          <tei:l>M’naḥem Raḥel!</tei:l>
          <tei:l>Aneinu!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:egalitarian_aneinu_mayer/9"/>
        <tei:lg>
          <tei:l>Aneinu,</tei:l>
          <tei:l>Shoméa el Leah!</tei:l>
          <tei:l>Aneinu!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:egalitarian_aneinu_mayer/10"/>
        <tei:lg>
          <tei:l>Aneinu,</tei:l>
          <tei:l>Ha-oneh b-et ratzon!</tei:l>
          <tei:l>Aneinu!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:egalitarian_aneinu_mayer/11"/>
        <tei:lg>
          <tei:l>Aneinu,</tei:l>
          <tei:l>Ha-oneh b-et tzarah!</tei:l>
          <tei:l>Aneinu!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:egalitarian_aneinu_mayer/12"/>
        <tei:lg>
          <tei:l>Aneinu,</tei:l>
          <tei:l>Ha-oneh b-et raḥamim!</tei:l>
          <tei:l>Aneinu!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:egalitarian_aneinu_mayer/13"/>
        <tei:lg>
          <tei:l>Aneinu,</tei:l>
          <tei:l>Magen David!</tei:l>
          <tei:l>Aneinu!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:egalitarian_aneinu_mayer/14"/>
        <tei:lg>
          <tei:l>Aneinu,</tei:l>
          <tei:l>M’kom Esther!</tei:l>
          <tei:l>Aneinu!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:egalitarian_aneinu_mayer/15"/>
        <tei:lg>
          <tei:l>Aneinu,</tei:l>
          <tei:l>Eláha d-Meir!</tei:l>
          <tei:l>Aneinu!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:egalitarian_aneinu_mayer/16"/>
        <tei:lg>
          <tei:l>Aneinu,</tei:l>
          <tei:l>Malfana di-Vrurya!</tei:l>
          <tei:l>Aneinu!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:egalitarian_aneinu_mayer/17"/>
        <tei:lg>
          <tei:l>Aneinu,</tei:l>
          <tei:l>Bi-zkhuteih d-var Yoḥai!</tei:l>
          <tei:l>Aneinu!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:egalitarian_aneinu_mayer/18"/>
        <tei:lg>
          <tei:l>Aneinu,</tei:l>
          <tei:l>Bi-ykareih d-Yalta!</tei:l>
          <tei:l>Aneinu!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:egalitarian_aneinu_mayer/19"/>
        <tei:lg>
          <tei:l>Aneinu,</tei:l>
          <tei:l>Elohei ha-merkavah!</tei:l>
          <tei:l>Aneinu!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:egalitarian_aneinu_mayer/20"/>
        <tei:lg>
          <tei:l>Aneinu,</tei:l>
          <tei:l>Ezrat ha-sh’vatim!</tei:l>
          <tei:l>Aneinu!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:egalitarian_aneinu_mayer/21"/>
        <tei:lg>
          <tei:l>Aneinu,</tei:l>
          <tei:l>Raḥum v-ḥanun!</tei:l>
          <tei:l>Aneinu!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
