  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ashirah_keshirat_mosheh">
        <tei:head>Ashira k-Shirat Moshe (Let me sing like the song of Moses)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashirah_keshirat_mosheh/1"/>
        <tei:lg>
          <tei:l>Let me sing like the song of Moses,</tei:l>
          <tei:l>a song never to be forgotten:</tei:l>
          <tei:l>thus Moses would sing</tei:l>
          <tei:l>the words of the song.<tei:anchor xml:id="note_1"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashirah_keshirat_mosheh/2"/>
        <tei:lg>
          <tei:l>Let me sing like the song of Miriam,</tei:l>
          <tei:l>by the shores of the sea:</tei:l>
          <tei:l>and Miriam sang</tei:l>
          <tei:l>the words of the song.<tei:anchor xml:id="note_2"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashirah_keshirat_mosheh/3"/>
        <tei:lg>
          <tei:l>Let me sing like the song of Joshua,</tei:l>
          <tei:l>on Mount Gilboa:<tei:anchor xml:id="note_3"/></tei:l>
          <tei:l>thus Joshua would sing</tei:l>
          <tei:l>the words of the song.<tei:anchor xml:id="note_4"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashirah_keshirat_mosheh/4"/>
        <tei:lg>
          <tei:l>Let me sing like the song of Deborah,</tei:l>
          <tei:l>towards Mount Tabor:</tei:l>
          <tei:l>and Deborah sang</tei:l>
          <tei:l>the words of this song.<tei:anchor xml:id="note_5"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashirah_keshirat_mosheh/5"/>
        <tei:lg>
          <tei:l>Let me sing like the song of Hannah</tei:l>
          <tei:l>with her husband Elkanah:</tei:l>
          <tei:l>and Hannah sang</tei:l>
          <tei:l>the words of this song.<tei:anchor xml:id="note_6"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashirah_keshirat_mosheh/6"/>
        <tei:lg>
          <tei:l>Let me sing like the song of David,</tei:l>
          <tei:l>he who would hitch together psalms:</tei:l>
          <tei:l>and David spoke</tei:l>
          <tei:l>the words of this song.<tei:anchor xml:id="note_7"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashirah_keshirat_mosheh/7"/>
        <tei:lg>
          <tei:l>Let me sing like the song of Solomon,</tei:l>
          <tei:l>in the crown with which his mother crowned him:<tei:anchor xml:id="note_8"/></tei:l>
          <tei:l>the song of songs</tei:l>
          <tei:l>which is Solomon’s.<tei:anchor xml:id="note_9"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashirah_keshirat_mosheh/8"/>
        <tei:lg>
          <tei:l>Let me sing like the song of Israel</tei:l>
          <tei:l>at the coming of the redeemer:</tei:l>
          <tei:l>thus Israel will sing</tei:l>
          <tei:l>the words of this song.<tei:anchor xml:id="note_10"/></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
