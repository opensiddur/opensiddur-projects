  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:lo_yashiru_mayer">
        <tei:head>לֹֽא־יַשְׁאִ֤ירוּ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lo_yashiru_mayer/1"/>
        <tei:lg>
          <tei:l>מְלֹ֥א כׇל־הָאָ֖רֶץ כְּבוֹדֽוֹ׃ <tei:bibl>(ישעיה ו:ג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lo_yashiru_mayer/2"/>
        <tei:lg>
          <tei:l>לֹֽא־יַשְׁאִ֤ירוּ מִמֶּ֙נּוּ֙ <tei:bibl>(במדבר ט:יב)</tei:bibl></tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>רָכוֹת לֶאֱלֹהֵֽינוּ</tei:l>
          <tei:l><tei:seg type="acrostic">נִ</tei:seg>גּוּנִים עַל־פִּסְחֵֽנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lo_yashiru_mayer/3"/>
        <tei:lg>
          <tei:l>כְּכׇל־חֻקַּ֥ת הַפֶּ֖סַח <tei:bibl>(במדבר ט:יב)</tei:bibl></tei:l>
          <tei:l><tei:seg type="acrostic">אֹ</tei:seg>פַן אֶת־שִׁירוֹ שָׁח</tei:l>
          <tei:l><tei:seg type="acrostic">בָּ</tei:seg>רוּךְ הוּא עַד־נֵֽצַח</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lo_yashiru_mayer/4"/>
        <tei:lg>
          <tei:l>וְהָאִישׁ֩ אֲשֶׁר־ה֨וּא טָה֜וֹר <tei:bibl>(במדבר ט:יג)</tei:bibl></tei:l>
          <tei:l><tei:seg type="acrostic">ר</tei:seg>וֹאֶה אֶת־זְהֹר</tei:l>
          <tei:l><tei:seg type="acrostic">הַ</tei:seg>כֹּהֵן עַל־הַר הֹר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lo_yashiru_mayer/5"/>
        <tei:lg>
          <tei:l>כִּ֣י ׀ קׇרְבַּ֣ן יְהֹוָ֗ה <tei:bibl>(במדבר ט:יג)</tei:bibl></tei:l>
          <tei:l><tei:seg type="acrostic">מַ</tei:seg>לְאֲכֵי הֲמוֹנַי</tei:l>
          <tei:l><tei:seg type="acrostic">הֵ</tei:seg>ם יַשְׁלִֽיחוּ מִפָּנַי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lo_yashiru_mayer/6"/>
        <tei:lg>
          <tei:l>וְכִֽי־יָג֨וּר אִתְּכֶ֜ם גֵּ֗ר <tei:bibl>(במדבר ט:יד)</tei:bibl></tei:l>
          <tei:l><tei:seg type="acrostic">כְּ</tei:seg>אֶזְרָח אַל־תְּאַתְגֵּר</tei:l>
          <tei:l><tei:seg type="acrostic">הָ</tei:seg>ס שׂוֹנֵא וְתִסָּגֵר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lo_yashiru_mayer/7"/>
        <tei:lg>
          <tei:l>חֻקָּ֤ה אַחַת֙ <tei:bibl>(במדבר ט:יד)</tei:bibl></tei:l>
          <tei:l><tei:seg type="acrostic">נְ</tei:seg>טֹהַר טְהוֹרָה מֻבְטַחַת</tei:l>
          <tei:l><tei:seg type="acrostic">חָזָק</tei:seg> וְרַב אַל־נִפְחַת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lo_yashiru_mayer/8"/>
        <tei:lg>
          <tei:l>וְהַחַיּוֹת יְשׁוֹרֵֽרוּ וּכְרוּבִים יְפָאֵֽרוּ</tei:l>
          <tei:l>וּשְׂרָפִים יָרֹֽנּוּ וְאֶרְאֶלִּים יְבָרֵֽכוּ</tei:l>
          <tei:l>פְּנֵי כׇּל־חַיָּה וְאוֹפַן וּכְרוּב לְעֻמַּת שְׂרָפִים</tei:l>
          <tei:l>לְעֻמָּתָם מְשַׁבְּחִים וְאוֹמְרִים:</tei:l>
          <tei:l>בָּר֥וּךְ כְּבוֹד־יְהֹוָ֖ה מִמְּקוֹמֽוֹ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
