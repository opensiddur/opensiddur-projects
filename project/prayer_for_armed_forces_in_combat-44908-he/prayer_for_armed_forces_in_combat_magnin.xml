  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_armed_forces_in_combat_magnin">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_armed_forces_in_combat_magnin/1"/>
        <tei:lg>
          <tei:l>אֱלֹהַי,</tei:l>
          <tei:l>אָמְנָם מְרֻחָק אֲנִי מֵאֲהוּבַי,</tei:l>
          <tei:l>אַךְ לֹא אֵשֵׁב בָּדָד;</tei:l>
          <tei:l>מֶרְחָק רַב מַפְרִיד בֵּינִי וּבֵין רֵעַי,</tei:l>
          <tei:l>אַךְ יֵשׁ לִי רֵעַ וְקָרוֹב בָּךְ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_armed_forces_in_combat_magnin/2"/>
        <tei:lg>
          <tei:l>לִבִּי מָלֵא אֹומֶץ,</tei:l>
          <tei:l>וְתִקְוָתִי חֲזָקָה,</tei:l>
          <tei:l>כִּי אַתָּה עִמָּדִי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_armed_forces_in_combat_magnin/3"/>
        <tei:lg>
          <tei:l>אַתָּה הוּא הָאוֹר</tei:l>
          <tei:l>הַמֵּאִיר אֶת נַפְשִׁי</tei:l>
          <tei:l>בְּנֹגַהּ</tei:l>
          <tei:l>וּבְשִׂמְחָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_armed_forces_in_combat_magnin/4"/>
        <tei:lg>
          <tei:l>עָלֶיךָ אֶשָּׁעֵן</tei:l>
          <tei:l>וְלֹא אֶמּוֹט.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_armed_forces_in_combat_magnin/5"/>
        <tei:lg>
          <tei:l>אַשְׁלִים אֶת מְשִׁימוֹתַי</tei:l>
          <tei:l>אֲשֶׁר נָטַלְתִּי עַל עַצְמִי,</tei:l>
          <tei:l>אַשְׁלִים וְלֹא אֶכָּשֵׁל;</tei:l>
          <tei:l>כִּי בְּעֶזְרָתְךָ אֵין כִּשָּׁלוֹן.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_armed_forces_in_combat_magnin/6"/>
        <tei:lg>
          <tei:l>אָהַבְתִּיךָ, ה׳ אֱלֹהַי,</tei:l>
          <tei:l>בְּכָל לְבָבִי</tei:l>
          <tei:l>וּבְכָל נַפְשִׁי</tei:l>
          <tei:l>וּבְכָל מְאֹודִי,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_armed_forces_in_combat_magnin/7"/>
        <tei:lg>
          <tei:l>וְיוֹדֵעַ אֲנִי כִּי אַהֲבָה רַבָּה אֲהַבְתָּנִי,</tei:l>
          <tei:l>וְתַשְׁגִּיחַ עָלַי בְּרַחֲמִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_armed_forces_in_combat_magnin/8"/>
        <tei:lg>
          <tei:l>אָמֵן.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
