  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:kol_beru_ei_gabirol_41951">
        <tei:head>כָּל־בְּרוּאֵי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kol_beru_ei_gabirol_41951/1"/>
        <tei:lg>
          <tei:l>כָּל־בְּרוּאֵי מַעְלָה וּמַטָּה</tei:l>
          <tei:l>יְעִידוּן יַגִּידוּן כֻּלָּם כְּאֶחָד</tei:l>
          <tei:l>ה׳ אֶחָד וּשְׁמוֹ אֶחָד</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kol_beru_ei_gabirol_41951/2"/>
        <tei:lg>
          <tei:l>שְׁלוֹשִׁים וּשְׁתַּיִם נְתִיבוֹת שְׁבִילָךְ</tei:l>
          <tei:l>לְכָל־מֵבִין סוֹדָם יְסַפְּרוּ גָדְלָךְ</tei:l>
          <tei:l>מֵהֶם יַכִּירוּן כִּי הַכֹּל שֶׁלָּךְ</tei:l>
          <tei:l>וְאַתָּה הָאֵל הַמֶּלֶךְ הַֽמְּיֻחָד</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kol_beru_ei_gabirol_41951/3"/>
        <tei:lg>
          <tei:l>לְבָבוֹת בְּחָשְׁבָם עוֹלָם בָּנוּי</tei:l>
          <tei:l>יִמְצְאוּ כָל־יֵשׁ בִּלְתְּךָ שָׁנוּי</tei:l>
          <tei:l>בְּמִסְפָּר בְּמִשְׁקָל הַכֹּל מָנוּי</tei:l>
          <tei:l>כֻּלָּם נִתְּנוּ מֵרוֹעֶה אֶחָד</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kol_beru_ei_gabirol_41951/4"/>
        <tei:lg>
          <tei:l>מֵרֹאשׁ וְעַד סוֹף יֵשׁ לְךָ סִמָּן</tei:l>
          <tei:l>צָפוֹן וָיָם וְקֶֽדֶם וְתֵימָן</tei:l>
          <tei:l>שַֽׁחַק וְתֵֽבֵל לְךָ עֵד נֶֽאֱמָן</tei:l>
          <tei:l>מִזֶּה אֶחָד וּמִזֶּה אֶחָד</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kol_beru_ei_gabirol_41951/5"/>
        <tei:lg>
          <tei:l>הַכֹּל מִמְּךָ נִזְבַּד זָבוֹד</tei:l>
          <tei:l>אַתָּה תַֽעֲמֹד וְהֵם יֹאבְדוּ אָבוֹד</tei:l>
          <tei:l>לָכֵן כָּל־יְצוּר לְךָ יִתֵּן כָּבוֹד</tei:l>
          <tei:l>כִּי מֵרֹאשׁ וְעַד־סוֹף הֲלֹא אָב אֶחָד׃</tei:l>
        </tei:lg>
      </tei:div>
