        <tei:lg>
          <tei:l><tei:seg type="acrostic">נְ</tei:seg>שָׂאָם בְּכַנְפֵי נְשָׁרִים</tei:l>
          <tei:l>שׁוֹכֵן בְּרוּם אֲוֵירִים</tei:l>
          <tei:l>וּמִתַּֽחַת זְרוֹעוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_first_night_of_shavuot_joseph/24"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ס</tei:seg>וֹרְרִים בְּעֵת שָׁמְעָם</tei:l>
          <tei:l>צְבִי תִּפְאֶֽרֶת עָם</tei:l>
          <tei:l>יִרְגְּזוּן יְרִיעוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_first_night_of_shavuot_joseph/25"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">עֲ</tei:seg>לוּבִים חָֽפוּ רֹאשָׁם</tei:l>
          <tei:l>וְלַהֲרֵגָה צוּר הִקְדִּישָׁם</tei:l>
          <tei:l>בִּפְרֹֽעַ פְּרָעוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_first_night_of_shavuot_joseph/26"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>רִישַׂת הוֹד שַׂלְמָה</tei:l>
          <tei:l>וּרְקוּעַת גֹֽבַהּ אֲדָמָה</tei:l>
          <tei:l>שְׁתֵּיהֶן נוֹגְעוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_first_night_of_shavuot_joseph/27"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">צַ</tei:seg>דִּיק הַר כָּפָה</tei:l>
          <tei:l>עֲלֵי נָאוָה וְיָפָה</tei:l>
          <tei:l>כְּגִיגִית וְכִירִיעוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_first_night_of_shavuot_joseph/28"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>שְׁבוּ עַם בְּחִירִים</tei:l>
          <tei:l>חֻקִּים וּמִשְׁפָּטִים יְשָׁרִים</tei:l>
          <tei:l>לְאֹֽזֶן הַשְּמָעוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_first_night_of_shavuot_joseph/29"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רָ</tei:seg>ם בְּחַסְדּוֹ שְׁמָרָם</tei:l>
          <tei:l>מִכַּף כׇּל־צוֹרְרָם</tei:l>
