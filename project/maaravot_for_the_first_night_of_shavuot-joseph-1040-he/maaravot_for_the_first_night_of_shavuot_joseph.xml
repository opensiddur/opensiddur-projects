          <tei:l>בְּבִרְכַּת כּוֹס יְשׁוּעוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_first_night_of_shavuot_joseph/32"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יְ</tei:seg>שׁוּעוֹת רַבּוֹת הֶרְאָם פּוֹדֶה וְגוֹאֵל</tei:l>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>עִטְּרָם וְהִנְוָם בְּדַת יְקוּתִיאֵל</tei:l>
          <tei:l><tei:seg type="acrostic">ס</tei:seg>וֹחֲחִים רֶֽנֶן וְהוֹדָיָה לָאֵל</tei:l>
          <tei:l><tei:seg type="acrostic">פֵּ</tei:seg>אֲרוּ וְשִׁבְּחוּ מֹשֶׁה וּבְנֵי יִשְׂרָאֵל:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_first_night_of_shavuot_joseph/33"/>
        <tei:lg>
          <tei:l>בְּגִילָה בְּרִנָּה בְּשִׂמְחָה רַבָּה וְאָמְרוּ כֻלָּם׃</tei:l>
          <tei:l>מִֽי־כָמֹ֤כָה בָּֽאֵלִם֙ יְהֹוָ֔ה</tei:l>
          <tei:l>מִ֥י כָּמֹ֖כָה נֶאְדָּ֣ר בַּקֹּ֑דֶשׁ נוֹרָ֥א תְהִלֹּ֖ת עֹ֥שֵׂה פֶֽלֶא׃ <tei:bibl>(שמות טו:יא)</tei:bibl></tei:l>
          <tei:l>מַלְכוּתְךָ רָאוּ בָנֶֽיךָ בּוֹקֵֽעַ יָם לִפְנֵי מֹשֶׁה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_first_night_of_shavuot_joseph/34"/>
        <tei:lg>
          <tei:l>כַּבֵּ֥ד <tei:seg type="acrostic">ה</tei:seg>וֹרֶֽיךָ בְּדִבּוּר חֲמִישִׁי הִשְׁמִיעָם</tei:l>
          <tei:l>לֹ֥֖א תִּֿרְצָ֖͏ֽח <tei:seg type="acrostic">קְ</tei:seg>רוּצֵי חֹֽמֶר לְהַכְרִית בְּזַֽעַם</tei:l>
          <tei:l>לֹ֣֖א תִּֿנְאָ֑͏ֽף <tei:seg type="acrostic">ט</tei:seg>וֹבַת חֵן וְסָרַת טַֽעַם</tei:l>
          <tei:l><tei:seg type="acrostic">נֶֽ</tei:seg>צַח צוּר יִשְׁעֲךָ הַמְלִיכֵֽהוּ בְּרׇב עָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_first_night_of_shavuot_joseph/35"/>
        <tei:lg>
          <tei:l>זֶה צוּר יִשְׁעֵֽנוּ</tei:l>
