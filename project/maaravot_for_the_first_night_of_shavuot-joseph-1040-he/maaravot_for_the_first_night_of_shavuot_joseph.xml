          <tei:l>יְהֹוָ֥ה ׀ יִמְלֹ֖ךְ לְעֹלָ֥ם וָעֶֽד׃ <tei:bibl>(שמות טו:יח)</tei:bibl></tei:l>
          <tei:l>וְנֶאֱמַר כִּֽי־פָדָ֥ה יְהֹוָ֖ה אֶֽת־יַעֲקֹ֑ב וּגְאָל֕וֹ מִיַּ֖ד חָזָ֥ק מִמֶּֽנּוּ׃ <tei:bibl>(ירמיהו לא:י)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_first_night_of_shavuot_joseph/36"/>
        <tei:lg>
          <tei:l>לֹ֣֖א תִּֿגְנֹֽ֔ב <tei:seg type="acrostic">בְּ</tei:seg>מִסְתָּרִים לֵישֵׁב בְּמַאֲרַב חֲצֵרִים</tei:l>
          <tei:l>לֹֽא־תַעֲנֶ֥ה <tei:seg type="acrostic">רֵֽ</tei:seg>עַ חָמָס הֱיוֹת עֵד שְׁקָרִים</tei:l>
          <tei:l>לֹ֥א תַחְמֹ֖ד <tei:seg type="acrostic">שִׁ</tei:seg>פְעַת רֵֽעַ וַחֲפָצִים יְקָרִים</tei:l>
          <tei:l><tei:seg type="acrostic">מֶֽ</tei:seg>לֶךְ יִשְׂרָאֵל וְגוֹאֲלוֹ קַיָּם לְדוֹר דּוֹרִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_first_night_of_shavuot_joseph/37"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה מֶֽלֶךְ צוּר יִשְׂרָאֵל וְגוֹאֲלוֹ׃<tei:anchor xml:id="note_8"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_first_night_of_shavuot_joseph/38"/>
        <tei:lg>
          <tei:l>הַשְׁכִּיבֵֽנוּ יְהֹוָה אֱלֹהֵֽינוּ לְשָׁלוֹם</tei:l>
          <tei:l>וְהַעֲמִידֵֽנוּ מַלְכֵּֽנוּ לְחַיִּים</tei:l>
          <tei:l>וּפְרוֹשׂ עָלֵֽינוּ סֻכַּת שְׁלוֹמֶֽךָ</tei:l>
          <tei:l>וְתַקְּנֵֽנוּ בְּעֵצָה טוֹבָה מִלְּפָנֶֽיךָ</tei:l>
          <tei:l>וְהוֹשִׁיעֵֽנוּ לְמַֽעַן שְׁמֶֽךָ.</tei:l>
          <tei:l>וְהָגֵן בַּעֲדֵֽנוּ</tei:l>
          <tei:l>וְהָסֵר מֵעָלֵֽינוּ</tei:l>
          <tei:l>אוֹיֵב</tei:l>
          <tei:l>דֶּֽבֶר</tei:l>
          <tei:l>וְחֶֽרֶב</tei:l>
          <tei:l>וְרָעָב</tei:l>
          <tei:l>וְיָגוֹן</tei:l>
          <tei:l>וְהָסֵר שָׂטָן מִלְּפָנֵֽינוּ וּמֵאַחֲרֵֽינוּ</tei:l>
          <tei:l>וּבְצֵל כְּנָפֶֽיךָ תַּסְתִּירֵֽנוּ</tei:l>
          <tei:l>כִּי אֵל שׁוֹמְרֵֽנוּ וּמַצִּילֵֽנוּ אָֽתָּה</tei:l>
          <tei:l>כִּי אֵל מֶֽלֶךְ חַנּוּן וְרַחוּם אָֽתָּה.</tei:l>
          <tei:l>וּשְׁמוֹר צֵאתֵֽנוּ וּבוֹאֵֽנוּ</tei:l>
          <tei:l>לְחַיִּים וּלְשָׁלוֹם מֵעַתָּה וְעַד־עוֹלָם׃</tei:l>
          <tei:l>וּפְרוֹשׂ עָלֵֽינוּ סֻכַּת שְׁלוֹמֶֽךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_first_night_of_shavuot_joseph/39"/>
        <tei:lg>
          <tei:l>וְכׇל־הָעָם֩ רֹאִ֨ים <tei:seg type="acrostic">וְ</tei:seg>שׁוֹמְעִים אֶת הַקּוֹלוֹת</tei:l>
          <tei:l><tei:seg type="acrostic">אֲ</tei:seg>גוּדִים יַָחַד לְקַבֵּל חֲמוּרוֹת וְקַלּוֹת</tei:l>
          <tei:l><tei:seg type="acrostic">לָ</tei:seg>בֶֽטַח הוֹשִׁיבֵם עוֹשֶׂה גְדוֹלוֹת</tei:l>
          <tei:l>כֵּן יִפְרֹשׂ שְׁלוֹמוֹ עַל כׇּל־מַקְהֵלוֹת:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_first_night_of_shavuot_joseph/40"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">מוסיפי פיוט ”ביכור“ קוראים אותו כאן</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_first_night_of_shavuot_joseph/41"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה, הַפּוֹרֵשׂ סֻכַּת שָׁלוֹם עָלֵֽינוּ וְעַל כׇּל־עַמּוֹ יִשְׂרָאֵל וְעַל יְרוּשָׁלָֽיִם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaravot_for_the_first_night_of_shavuot_joseph/42"/>
        <tei:lg>
          <tei:l>וַיְדַבֵּ֣ר מֹשֶׁ֔ה אֶֽת־מֹעֲדֵ֖י יְהֹוָ֑ה אֶל־בְּנֵ֖י יִשְׂרָאֵֽל׃ <tei:bibl>(ויקרא כג:מד)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" n="2" target="#note_2">
      <tei:p>איוב ט:י</tei:p>
    </tei:note>
    <tei:note type="commentary" n="3" target="#note_3">
      <tei:p>תהלים סו:י</tei:p>
    </tei:note>
    <tei:note type="commentary" n="8" target="#note_8">
      <tei:p>יש אומרים גָּאַל יִשְׂרָאֵל כרגיל</tei:p>
    </tei:note>
  </tei:standOff>
