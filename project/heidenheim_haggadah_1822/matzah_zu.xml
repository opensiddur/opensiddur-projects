    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:haggadah:magid/matzah_zu">
        <tei:pb n="23r" ed="1822" facs="https://www.hebrewbooks.org/pdfpager.aspx?req=4909&amp;pgnum=45"/>
        <tei:milestone unit="paragraph" n="1" corresp="urn:x-opensiddur:text:haggadah:magid/matzah_zu/1"/>
        <tei:p>מַצָּה זוּ שֶׁאָנוּ אוֹכְלִים עַל שׁוּם מָה. עַל שׁוּם שֶׁלֹּא הִסְפִּיק בְּצֵקָם שֶׁל אֲבוֹתֵינוּ לְהַחֲמִיץ עַד שֶׁנִּגְלָה עֲלֵיהֶם מֶלֶךְ מַלְכֵי הַמְּלָכִים הַקָּדוֹשׁ בָּרוּךְ הוּא וּגְאָלָם. שֶׁנֶּאֱמַר וַיֹּאפ֨וּ אֶת־הַבָּצֵ֜ק אֲשֶׁ֨ר הוֹצִ֧יאוּ מִמִּצְרַ֛יִם עֻגֹ֥ת מַצּ֖וֹת כִּ֣י לֹ֣א חָמֵ֑ץ כִּֽי־גֹרְשׁ֣וּ מִמִּצְרַ֗יִם וְלֹ֤א יָֽכְלוּ֙ לְהִתְמַהְמֵ֔הַּ וְגַם־צֵדָ֖ה לֹא־עָשׂ֥וּ לָהֶֽם</tei:p>
      </tei:div>
    </tei:body>
