      <tei:div corresp="urn:x-opensiddur:text:haggadah:nirtzah/sefirat_haomer">
        <tei:head>ספירת העומר</tei:head>
        <tei:milestone unit="paragraph" n="1" corresp="urn:x-opensiddur:text:haggadah:nirtzah/sefirat_haomer/1"/>
        <tei:p>בָּרוּךְ אַתָּה יְיָ אֱלֹהֵֽינוּ מֶֽלֶךְ הָעוֹלָם אֲשֶׁר קִדְּשָֽׁנוּ בְּמִצְוֺתָיו וְצִוָּֽנוּ עַל סְפִירַת הָעֹֽמֶר׃ הַיּוֹם יוֹם אֶחַד לָעֽוֹמֶר׃ יְהִי רָצוֹן מִלְּפָנֶיךָ יְיָ אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ שֶׁיִּבָּנֶה בֵּית הַמִּקְדָּשׁ בִּמְהֵרָה בְיָמֵינוּ וְתֵן חֶלְקֵנוּ בְּתוֹרָתֶךָ׃</tei:p>
      </tei:div>
    </tei:body>
