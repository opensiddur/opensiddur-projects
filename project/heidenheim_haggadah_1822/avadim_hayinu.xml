      <tei:div corresp="urn:x-opensiddur:text:haggadah:magid/avadim_hayinu">
        <tei:milestone unit="paragraph" n="1" corresp="urn:x-opensiddur:text:haggadah:magid/avadim_hayinu/1"/>
        <tei:p>עֲבָדִים הָיִינוּ לְפַרְעֹה בְּמִצְרָיִם. וַיּוֹצִיאֵנוּ יְיָ אֱלֹהֵינוּ מִשָּׁם בְּיָד חֲזָקָה וּבִזְרוֹעַ נְטוּיָה. וְאִלּוּ <tei:pb n="6v" ed="1822" facs="https://www.hebrewbooks.org/pdfpager.aspx?req=4909&amp;pgnum=12"/>לֹא הוֹצִיא הַקָּדוֹשׁ בָּרוּךְ הוּא אֶת אֲבוֹתֵינוּ מִמִּצְרָיִם הֲרֵי אָנוּ וּבָנֵינוּ וּבְנֵי בָנֵינוּ מְשֻׁעְבָּדִים הָיִינוּ <j:conditional xml:id="cond_avadim_hayinu_lfaro"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:haggadah:magid/avadim_hayinu/lfaro"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>לְפַרְעֹה<j:endConditional target="#cond_avadim_hayinu_lfaro"/> בְּמִצְרָיִם. וַאֲפִילוּ כֻּלָּנוּ חֲכָמִים. כֻּלָּנוּ נְבוֹנִים. כֻּלָּנוּ זְקֵנִים. כְּלָּנוּ יוֹדְעִים אֶת הַתּוֹרָה. מִצְוָה עָלֵינוּ לְסַפֵּר בִּיצִיאַת מִצְרָיִם. וְכָׇל־הַמַּרְבֶּה לְסַפֵּר בִּיצִיאַת מִצְרָיִם הֲרֵי זֶה מְשֻׁבָּח׃</tei:p>
