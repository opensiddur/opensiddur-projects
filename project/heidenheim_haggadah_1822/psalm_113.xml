      <tei:div corresp="urn:x-opensiddur:text:haggadah:magid/psalm_113">
        <tei:milestone unit="chapter" n="113" corresp="urn:x-opensiddur:text:bible:psalms/113"/>
        <tei:milestone unit="verse" n="1" corresp="urn:x-opensiddur:text:bible:psalms/113/1"/>
        <tei:p>הַלְלוּיָהּ ׀ הַלְלוּ עַבְדֵי <j:divineName>יְיָ</j:divineName> הַלְלוּ אֶת־שֵׁם <j:divineName>יְיָ</j:divineName>׃ <tei:milestone unit="verse" n="2" corresp="urn:x-opensiddur:text:bible:psalms/113/2"/>יְהִי שֵׁם <j:divineName>יְיָ</j:divineName> מְבֹרָךְ מֵעַתָּה וְעַד־עוֹלָם׃ <tei:milestone unit="verse" n="3" corresp="urn:x-opensiddur:text:bible:psalms/113/3"/>מִמִּזְרַח־שֶׁמֶשׁ עַד־מְבוֹאוֹ מְהֻלָּל שֵׁם <j:divineName>יְיָ</j:divineName>׃ <tei:milestone unit="verse" n="4" corresp="urn:x-opensiddur:text:bible:psalms/113/4"/>רָם עַל־כָּל־<tei:pb n="25r" ed="1822" facs="https://www.hebrewbooks.org/pdfpager.aspx?req=4909&amp;pgnum=49"/>גּוֹיִם ׀ <j:divineName>יְיָ</j:divineName> עַל־הַשָּׁמַיִם כְּבוֹדוֹ׃ <tei:milestone unit="verse" n="5" corresp="urn:x-opensiddur:text:bible:psalms/113/5"/>מִי כַּ<j:divineName>יְיָ</j:divineName> אֱלֹהֵינוּ הַמַּגְבִּיהִי לָשָׁבֶת׃ <tei:milestone unit="verse" n="6" corresp="urn:x-opensiddur:text:bible:psalms/113/6"/>הַמַּשְׁפִּילִי לִרְאוֹת בַּשָּׁמַיִם וּבָאָרֶץ׃ <tei:milestone unit="verse" n="7" corresp="urn:x-opensiddur:text:bible:psalms/113/7"/>מְקִימִי מֵעָפָר דָּל מֵאַשְׁפֹּת יָרִים אֶבְיוֹן׃ <tei:milestone unit="verse" n="8" corresp="urn:x-opensiddur:text:bible:psalms/113/8"/>לְהוֹשִׁיבִי עִם־נְדִיבִים עִם נְדִיבֵי עַמּוֹ׃ <tei:milestone unit="verse" n="9" corresp="urn:x-opensiddur:text:bible:psalms/113/9"/>מוֹשִׁיבִי עֲקֶרֶת הַבַּיִת אֵם־הַבָּנִים שְׂמֵחָה הַלְלוּיָהּ׃</tei:p>
