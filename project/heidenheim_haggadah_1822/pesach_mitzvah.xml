      <tei:div corresp="urn:x-opensiddur:text:haggadah:magid/pesach_mitzvah">
        <tei:milestone unit="paragraph" n="1" corresp="urn:x-opensiddur:text:haggadah:magid/pesach_mitzvah/1"/>
        <tei:p>פֶּסַח שֶׁהָיוּ אֲבוֹתֵינוּ אוֹכְלִים בַּזְּמַן שֶׁבֵּית הַמִּקְדָּשׁ קַיָּם. עַל שׁוּם מָה. עַל שׁוּם שֶׁפָּסַח הַקָּדוֹשׁ בָּרוּךְ הוּא עַל בַּתֵּי אֲבוֹתֵינוּ בְּמִצְרַיִם. שֶׁנֶּאֱמַר וַאֲמַרְתֶּ֡ם זֶֽבַח־פֶּ֨סַח ה֜וּא לַֽיהוָ֗ה אֲשֶׁ֣ר פָּ֠סַח עַל־בָּתֵּ֤י בְנֵֽי־יִשְׂרָאֵל֙ בְּמִצְרַ֔יִם בְּנׇגְפּ֥וֹ אֶת־מִצְרַ֖יִם וְאֶת־בָּתֵּ֣ינוּ הִצִּ֑יל וַיִּקֹּ֥ד הָעָ֖ם וַיִּֽשְׁתַּחֲוּֽוּ</tei:p>
