      <tei:div corresp="urn:x-opensiddur:text:haggadah:magid/lefikach">
        <tei:milestone unit="paragraph" n="1" corresp="urn:x-opensiddur:text:haggadah:magid/lefikach/1"/>
        <tei:p>לְפִיכָךְ אֲנַחְנוּ חַיָּבִים לְהוֹדוֹת לְהַלֵּל לְשַׁבֵּחַ לְפָאֵר לְרוֹמֵם לְהַדֵּר לְבָרֵךְ לְעַלֵּה וּלְקַלֵּס. לְמִי שֶׁעָשָׂה לַאֲבוֹתֵינוּ וְלָנוּ אֶת כָׇּל הַנִּסִּים הָאֵלֶּה הוֹצִיאָנוּ מֵעַבְדוּת לְחֵרוּת. מִיָּגוֹן לְשִׂמְחָה. מֵאֵבֶל לְיוֹם טוֹב. וּמֵאֲפֵלָה לְאוֹר גָּדוֹל. <tei:pb n="24v" ed="1822" facs="https://www.hebrewbooks.org/pdfpager.aspx?req=4909&amp;pgnum=48"/>וּמִשִּׁעְבּוּד לִגְּאֻלָּה. וְנֹּאמַר לְפָנָיו <j:conditional xml:id="cond_lefikach_shira_chadasha"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:haggadah:magid/lefikach/shira_chadasha"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>שִׁירָה חֲדָשָׁה<j:endConditional target="#cond_lefikach_shira_chadasha"/> הַלֲלוּיָהּ</tei:p>
