    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:haggadah:magid/rashaa">
        <tei:pb n="9r" ed="1822" facs="https://www.hebrewbooks.org/pdfpager.aspx?req=4909&amp;pgnum=17"/>
        <tei:milestone unit="paragraph" n="1" corresp="urn:x-opensiddur:text:haggadah:magid/rashaa/1"/>
        <tei:p>רָשָׁע מַה הוּא אוֹמֵר מָ֛ה הָעֲבֹדָ֥ה הַזֹּ֖את לָכֶֽם לָכֶם וְלֹא לוֹ. וּלְפִי שֶׁהוֹצִיא אֶת עַצְמוֹ מִן הַכְּלָל כָּפַר בָּעִקָּר. וְאַף אַתָּה הַקְהֵה אֶת שִׁנָּיו וְאֱמׇר־לוֹ בַּעֲב֣וּר זֶ֗ה עָשָׂ֤ה יְהוָה֙ לִ֔י בְּצֵאתִ֖י מִמִּצְרָֽיִם לִי וְלֹא לוֹ. אִלּוּ הָיָה שָׁם. לֹא הָיָה נִגְאָל׃</tei:p>
      </tei:div>
    </tei:body>
