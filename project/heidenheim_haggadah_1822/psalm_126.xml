  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:haggadah:barech/psalm_126">
        <tei:milestone unit="chapter" n="126" corresp="urn:x-opensiddur:text:bible:psalms/126"/>
        <tei:milestone unit="verse" n="1" corresp="urn:x-opensiddur:text:bible:psalms/126/1"/>
        <tei:p>שִׁיר הַמַּעֲלוֹת: בְּשׁוּב יהוה אֶת־שִׁיבַת צִיּוֹן הָיִ֫ינוּ כְּחֹלְמִים. <tei:milestone unit="verse" n="2" corresp="urn:x-opensiddur:text:bible:psalms/126/2"/>אָז יִמָּלֵא שְׂחוֹק פִּ֫ינוּ וּלְשׁוֹנֵ֫נוּ רִנָּה; אָז יֹאמְרוּ בַגּוֹיִם הִגְדִּיל יהוה לַעֲשׂוֹת עִם־אֵ֫לֶּה. <tei:milestone unit="verse" n="3" corresp="urn:x-opensiddur:text:bible:psalms/126/3"/>הִגְדִּיל יהוה לַעֲשׂוֹת עִמָּ֫נוּ הָיִ֫ינוּ שְׂמֵחִים. <tei:milestone unit="verse" n="4" corresp="urn:x-opensiddur:text:bible:psalms/126/4"/>שׁוּבָ֫ה יהוה אֶת־שְׁבִיתֵ֫נוּ כַּאֲפִיקִים בַּנֶּ֫גֶב. <tei:milestone unit="verse" n="5" corresp="urn:x-opensiddur:text:bible:psalms/126/5"/>הַזֹּרְעִים בְּדִמְעָה בְּרִנָּה יִקְצֹ֫רוּ. <tei:milestone unit="verse" n="6" corresp="urn:x-opensiddur:text:bible:psalms/126/6"/>הָלוֹךְ יֵלֵךְ וּבָכֹה נֹשֵׂא מֶשֶׁךְ־הַזָּ֫רַע; בֹּא־יָבֹא בְרִנָּה נֹשֵׂא אֲלֻמֹּתָיו׃</tei:p>
