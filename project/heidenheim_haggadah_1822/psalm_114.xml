    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:haggadah:magid/psalm_114">
        <tei:pb n="25v" ed="1822" facs="https://www.hebrewbooks.org/pdfpager.aspx?req=4909&amp;pgnum=50"/>
        <tei:milestone unit="chapter" n="114" corresp="urn:x-opensiddur:text:bible:psalms/114"/>
        <tei:milestone unit="verse" n="1" corresp="urn:x-opensiddur:text:bible:psalms/114/1"/>
        <tei:p>בְּצֵאת יִשְׂרָאֵל מִמִּצְרָיִם בֵּית יַעֲקֹב מֵעַם לֹעֵז׃ <tei:milestone unit="verse" n="2" corresp="urn:x-opensiddur:text:bible:psalms/114/2"/>הָיְתָה יְהוּדָה לְקָדְשׁוֹ יִשְׂרָאֵל מַמְשְׁלוֹתָיו׃ <tei:milestone unit="verse" n="3" corresp="urn:x-opensiddur:text:bible:psalms/114/3"/>הַיָּם רָאָה וַיָּנֹס הַיַּרְדֵּן יִסֹּב לְאָחוֹר׃ <tei:milestone unit="verse" n="4" corresp="urn:x-opensiddur:text:bible:psalms/114/4"/>הֶהָרִים רָקְדוּ כְאֵילִים גְּבָעוֹת כִּבְנֵי־צֹאן׃ <tei:milestone unit="verse" n="5" corresp="urn:x-opensiddur:text:bible:psalms/114/5"/>מַה־לְּךָ הַיָּם כִּי תָנוּס הַיַּרְדֵּן תִּסֹּב לְאָחוֹר׃ <tei:milestone unit="verse" n="6" corresp="urn:x-opensiddur:text:bible:psalms/114/6"/>הֶהָרִים תִּרְקְדוּ כְאֵילִים גְּבָעוֹת כִּבְנֵי־צֹאן׃ <tei:milestone unit="verse" n="7" corresp="urn:x-opensiddur:text:bible:psalms/114/7"/>מִלִּפְנֵי אָדוֹן חוּלִי אָרֶץ מִלִּפְנֵי אֱלוֹהַּ יַעֲקֹב׃ <tei:milestone unit="verse" n="8" corresp="urn:x-opensiddur:text:bible:psalms/114/8"/>הַהֹפְכִי הַצּוּר אֲגַם־מָיִם חַלָּמִישׁ לְמַעְיְנוֹ־מָיִם׃</tei:p>
