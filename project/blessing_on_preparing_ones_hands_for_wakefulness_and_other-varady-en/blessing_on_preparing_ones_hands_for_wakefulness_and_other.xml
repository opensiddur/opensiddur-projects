  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:blessing_on_preparing_ones_hands_for_wakefulness_and_other">
        <tei:head>Blessing on preparing one's hands for wakefulness and other holy activities (translation by Aharon Varady)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_on_preparing_ones_hands_for_wakefulness_and_other/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">Take a clean and unbroken vessel</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">and fill it with enough water to pour over one’s hands.</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">Alternate each hand as you pour the water over them,</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">right and left, right and left, right and left.</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">Then dry one’s hands and hold them slightly elevated,</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">while saying the following blessing:</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_on_preparing_ones_hands_for_wakefulness_and_other/2"/>
        <tei:lg>
          <tei:l>Blessed are you</tei:l>
          <tei:l><j:divineName>YHVH</j:divineName> <j:divineName>our elo’ah</j:divineName></tei:l>
          <tei:l>cosmic majesty</tei:l>
          <tei:l>who sanctified us with their mitsvot</tei:l>
          <tei:l>and commanded us to elevate our hands.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
