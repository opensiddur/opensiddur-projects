  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:god_bless_america_berlin">
        <tei:head>God Bless America, for Armistice Day by Irving Berlin (1918/1938) with Yiddish translation</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:god_bless_america_berlin/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">While the storm clouds gather far across the sea</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">Let us swear allegiance to a land that’s free</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">let us all be grateful for a land so fair</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">let us raise our voices in a solemn prayer:</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:god_bless_america_berlin/2"/>
        <tei:lg>
          <tei:l><j:divineName>God</j:divineName> bless America,</tei:l>
          <tei:l>land that I love.</tei:l>
          <tei:l>Stand beside her</tei:l>
          <tei:l>and guide her,</tei:l>
          <tei:l>through the night with a light from above.</tei:l>
          <tei:l>From the mountains</tei:l>
          <tei:l>to the prairies</tei:l>
          <tei:l>to the oceans white with foam,<tei:anchor xml:id="note_1"/></tei:l>
          <tei:l><j:divineName>God</j:divineName> bless America,</tei:l>
          <tei:l>my home sweet home,</tei:l>
          <tei:l><j:divineName>God</j:divineName> bless America,</tei:l>
          <tei:l>my home sweet home.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" n="1" target="#note_1">
      <tei:p>originally, “From the green fields of Virginia to the gold fields out in Nome” as can be heard sung by Kate Smith in her 1938 rendition.</tei:p>
    </tei:note>
  </tei:standOff>
