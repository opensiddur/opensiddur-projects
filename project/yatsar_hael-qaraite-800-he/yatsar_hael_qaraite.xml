  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yatsar_hael_qaraite">
        <tei:head>יָצַר הָאֵל</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yatsar_hael_qaraite/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>צַר הָאֵל אֶת הָעוֹלָם׃</tei:l>
          <tei:l>שֵׁשֶׁת יָמִים כִּלָּה כֻלָּם׃</tei:l>
          <tei:l>יוֹם שְׁבִיעִי מִכְּלָלָם׃</tei:l>
          <tei:l>קִדֵּשׁ אוֹתוֹ גַּם בֵּרְכָהוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yatsar_hael_qaraite/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">עַ</tei:seg>ל כֵּן צִוָּה לִבְנֵי עַמּוֹ׃</tei:l>
          <tei:l>לִשְׁבּוֹת בַּיּוֹם הַהוּא לִשְׁמוֹ׃</tei:l>
          <tei:l>וּלְהִשְׁתַּחֲווֹת אֶל הֲדוֹמוֹ׃</tei:l>
          <tei:l>עִם שְׁבָחוֹת שַׁבְּחוּהוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yatsar_hael_qaraite/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קִ</tei:seg>רְאוּ שִׁירִים בַּנְּעִימִים׃</tei:l>
          <tei:l>וּשְׁתוּ יֵינוֹת עִם מַטְעִימִים׃</tei:l>
          <tei:l>יַעַן זֶה יוֹם יוֹם תַּעֲצוּמִים׃</tei:l>
          <tei:l>כִּי קָדוֹשׁ הוּא קַדְּשׁוּהוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yatsar_hael_qaraite/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בֵּ</tei:seg>רַךְ הָאֵל אֶת הַשַּׁבָּת׃</tei:l>
          <tei:l>יַעַן כִּי בוֹ בְּיוֹם שָׁבַת׃</tei:l>
          <tei:l>מוֹרֶה אֶל קַדְמוּתוֹ שַׁבָּת׃</tei:l>
          <tei:l>כִּי אֶחָד הוּא יַחֲדוּהוּ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
