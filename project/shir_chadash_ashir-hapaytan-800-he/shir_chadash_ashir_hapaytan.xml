  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:shir_chadash_ashir_hapaytan">
        <tei:head>שיר חדש אשיר</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shir_chadash_ashir_hapaytan/1"/>
        <tei:lg>
          <tei:l>שִׁ֯יר חָדָשׁ אָשִׁיר וְשֵׁם אֵל</tei:l>
          <tei:l>אַקְדִּישׁ בַּעֲדַת אֲרִיאֵל</tei:l>
          <tei:l>אָ֣ז יָשִֽׁיר־מֹשֶׁה֩ וּבְנֵ֨י יִשְׂרָאֵ֜ל</tei:l>
          <tei:l>אֶת־הַשִּׁירָ֤ה הַזֹּאת֙ לַֽיהֹוָ֔ה <tei:bibl>(שמות טו:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shir_chadash_ashir_hapaytan/2"/>
        <tei:lg>
          <tei:l>מַ֯ה נִכְסְפָה כָּלְתָה נַפְשִׁי</tei:l>
          <tei:l>לִשְׁכּוֹן בְּחַצְרוֹת בֵּית קׇדְשִׁי</tei:l>
          <tei:l>לְהַקְרִיב לוֹ לֶֽחֶם אִשִּׁי</tei:l>
          <tei:l>רֵֽיחַ־נִיח֖וֹחַ לַֽיהֹוָֽה׃ <tei:bibl>(כגון ויקרא א:ט ואחרים)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shir_chadash_ashir_hapaytan/3"/>
        <tei:lg>
          <tei:l>וַ֯אֲרַנֵּן לוֹ בְּרוֹב גִּילָה</tei:l>
          <tei:l>וּבְרוֹב חֶדְוָה וְצׇהֳלָה</tei:l>
          <tei:l>שֶֽׁבַח וּתְהִלָּה הַ֥לְלוּ־יָ֨הּ ׀</tei:l>
          <tei:l>הַ֭לְלוּ עַבְדֵ֣י יְהֹוָ֑ה <tei:bibl>(תהלים קיג:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shir_chadash_ashir_hapaytan/4"/>
        <tei:lg>
          <tei:l>אֲ֯נִי לֶאֱלֹהִים אֶקְרָא</tei:l>
          <tei:l>תַצִּילֵֽנוּ מִכׇּל־צָרָה</tei:l>
          <tei:l>וְהוּא יִהְיֶה לָֽנוּ עֶזְרָה</tei:l>
          <tei:l>נִדְב֣וֹת פִּ֭י רְצֵה־נָ֣א יְהֹוָ֑ה <tei:bibl>(תהלים קיט:קח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shir_chadash_ashir_hapaytan/5"/>
        <tei:lg>
          <tei:l>לָֽ֯נוּ יִשְׁלַח מְשִׁיחֵֽנוּ</tei:l>
          <tei:l>בִּמְהֵרָה יָבֹא אֵלֵֽינוּ</tei:l>
          <tei:l>וְיַעֲלֵֽנוּ לְאַרְצֵֽנוּ</tei:l>
          <tei:l>לַחֲז֥וֹת בְּנֹעַם־יְ֝הֹוָ֗ה <tei:bibl>(תהלים כז:ד)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
