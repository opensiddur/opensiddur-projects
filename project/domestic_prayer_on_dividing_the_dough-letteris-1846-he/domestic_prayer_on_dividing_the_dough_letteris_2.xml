    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:domestic_prayer_on_dividing_the_dough_letteris/2">
        <tei:head>Gebet beim Abscheiden des Teiges (חלה)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:domestic_prayer_on_dividing_the_dough_letteris/2/1"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵֽינוּ מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>אֲשֶׁר קִדְּשָֽׁנוּ בְּמִצְוֺתָיו וְצִוָּֽנוּ</tei:l>
          <tei:l>לְהַפְרִישׁ חַלָּה׃</tei:l>
          <tei:l>Gelobet seiest du,</tei:l>
          <tei:l>o Ewiger!</tei:l>
          <tei:l>der du uns geboten hast,</tei:l>
          <tei:l>den Erstlingsteig dir</tei:l>
          <tei:l>als Hebe zu weihen.</tei:l>
          <tei:l>Blessed art Thou,</tei:l>
          <tei:l>Eternal our God!</tei:l>
          <tei:l>who hast commanded us</tei:l>
          <tei:l>to dedicate the firstlings of the dough,</tei:l>
          <tei:l>as a peace offering unto Thee.</tei:l>
          <tei:l><tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
