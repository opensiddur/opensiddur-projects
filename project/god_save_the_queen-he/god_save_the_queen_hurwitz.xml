  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:god_save_the_queen_hurwitz">
        <tei:head>אֵל שְׁמֹר הַמַּלְכָּה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:god_save_the_queen_hurwitz/1"/>
        <tei:lg>
          <tei:l>אֵל שְׁמֹר מַלְכָּתֵנוּ,</tei:l>
          <tei:l>לְעוֹלָם תְּחִי מַלְכָּתֵנוּ,</tei:l>
          <tei:l>אֵל שְׁמֹר הַמַּלְכָּה׃</tei:l>
          <tei:l>שְׁלַח שָׁלוֹם בִּנְוֶהָ,</tei:l>
          <tei:l>בְּעֹז וְהָדָר עַטְּרֵֶהָ,</tei:l>
          <tei:l>לָעַד הַמְשִׁילֶהָ,</tei:l>
          <tei:l>אֵל שְׁמֹר הַמַּלְכָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:god_save_the_queen_hurwitz/2"/>
        <tei:lg>
          <tei:l>אָנָּא אֱלֹהִים קוּמָה,</tei:l>
          <tei:l>בְּאוֹיְבֵיהָ תְּנָה מְהוּמָה,</tei:l>
          <tei:l>וְהַפִּילֵימוֹ׃</tei:l>
          <tei:l>הָפֵר תַּחְכֻּלֹתָם,</tei:l>
          <tei:l>סַכֶּל־נָא עֲצָתָם,</tei:l>
          <tei:l>לְעַמָהּ תֵּן מִשְׁאֲלֹתָם,</tei:l>
          <tei:l>וְהוֹשִׁיעֵמוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:god_save_the_queen_hurwitz/3"/>
        <tei:lg>
          <tei:l>מִבְחַר בִּרְכָתְךָ אֵל!</tei:l>
          <tei:l>לְהָרִיק עָלֶיהָ הוֹאֵל,</tei:l>
          <tei:l>לָעַד תִּמְלוֹךְ!<tei:anchor xml:id="note_2"/></tei:l>
          <tei:l>תָּגֵן בְּעַד חֻקֵּינוּ,</tei:l>
          <tei:l>אָז יִשְׂמַח לִבֵּנוּ,</tei:l>
          <tei:l>וְנָשִׁיר בְּכׇל מְאֹדֵנוּ,</tei:l>
          <tei:l>אֵל שְׁמֹר הַמַּלְכָּה!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" n="2" target="#note_2">
      <tei:p>”תְּהִי הַמַּלְכָּה” in the 1887 Jubilee rendition.</tei:p>
    </tei:note>
  </tei:standOff>
