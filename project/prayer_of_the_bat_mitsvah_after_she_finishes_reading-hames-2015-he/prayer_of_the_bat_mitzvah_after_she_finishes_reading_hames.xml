    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_of_the_bat_mitzvah_after_she_finishes_reading_hames">
        <tei:head>תפילת בת המצווה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_of_the_bat_mitzvah_after_she_finishes_reading_hames/1"/>
        <tei:lg>
          <tei:l>הִנְנִי עוֹמֶדֶת בְּמָקוֹם זֶה הַיּוֹם</tei:l>
          <tei:l>כְּדֵי לְהָעִיד וְלוֹמַר בְּקוֹל צָלוּל וּבָרוּר</tei:l>
          <tei:l>שֶׁאֲנִי בַּת יִשְׂרָאֵל.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_of_the_bat_mitzvah_after_she_finishes_reading_hames/2"/>
        <tei:lg>
          <tei:l>עָלִיתִי לַתּוֹרָה</tei:l>
          <tei:l>כְּדֵי לְהִתְחַבֵּר לְדוֹרוֹת שֶׁל בָּנוֹת וּבָנִים,</tei:l>
          <tei:l>אִמָּהוֹת וְאָבוֹת,</tei:l>
          <tei:l>סַבְתוֹת וְסָבִים,</tei:l>
          <tei:l>אֲשֶׁר קָרְאוּ בְּסֵפֶר זֶה,</tei:l>
          <tei:l>פֵּרְשׁוּ אֶת מִלּוֹתָיו</tei:l>
          <tei:l>וְרָאוּ בּוֹ עַמּוּד אֵשׁ</tei:l>
          <tei:l>הַמֵּאִיר אֶת דַּרְכָּם מֵהֶעָבָר אַל הַהֹוֶה</tei:l>
          <tei:l>וּמֵהַהֹוֶה לְעָתִיד.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_of_the_bat_mitzvah_after_she_finishes_reading_hames/3"/>
        <tei:lg>
          <tei:l>קְרִיאָתִי בְּסֵפֶר</tei:l>
          <tei:l>מְחַזֶּקֶת אֶת הַקֶּשֶׁר</tei:l>
          <tei:l>בֵּינִי לְבֵין מִשְׁפַּחְתִּי,</tei:l>
          <tei:l>בֵּינִי לְבֵין חֲבֵרִי וַחֲבֵרוֹתַי,</tei:l>
          <tei:l>בֵּינִי לְבֵין עַמִּי וְאַרְצִי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_of_the_bat_mitzvah_after_she_finishes_reading_hames/4"/>
        <tei:lg>
          <tei:l>מְקַבֶּלֶת אֲנִי בְּאַהֲבָה</tei:l>
          <tei:l>אֶת הִשְׁתַּיְכוּתִי לְמָסֹרֶת שֶׁל תּוֹרָה עַתִּיקַת יוֹמִין בָּהּ</tei:l>
          <tei:l>יֵשׁ לַהֲגוֹת יוֹמָם וָלַיְלָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_of_the_bat_mitzvah_after_she_finishes_reading_hames/5"/>
        <tei:lg>
          <tei:l>אֲנִי תְּקַוֶּה שֶׁאוּכַל לַהֲפֹךְ בָּהּ וְלַהֲפֹךְ בָּהּ,</tei:l>
          <tei:l>לְהַתְווֹת לְעַצְמִי דַּרְכֵי חַיִּים בְּאֶמְצָעוּתָהּ,</tei:l>
          <tei:l>לְחַפֵּשׂ בָּהּ נְתִיבוֹת לְחָכְמָה וּלְאַהֲבָה</tei:l>
          <tei:l>וּלְהִשְׁתַּמֵּשׁ בָּהּ לְטוֹבַת הַכְּלָל.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_of_the_bat_mitzvah_after_she_finishes_reading_hames/6"/>
        <tei:lg>
          <tei:l>מִי יִתֵּן וּשְׂפָתָהּ שֶׁל הַתּוֹרָה</tei:l>
          <tei:l>שֶׁמְּחַבֶּרֶת בֵּין עָבַר לֶעָתִיד,</tei:l>
          <tei:l>וְאוֹתִיּוֹתֶיהָ</tei:l>
          <tei:l>שֶׁחֲרוּתוֹת בְּדִמְיוֹנִי פְּנִימָה וּבְפִי הַחוּצָה,</tei:l>
          <tei:l>תְּשַׁמֵּשְׁנָה אוֹתִי בְּשָׁכְבִי וּבְקוּמִי,</tei:l>
          <tei:l>בְּבֵיתִי וּבְלֶכְתִי,</tei:l>
          <tei:l>בִּצְעִירוּתִי וּבְזִקְנָתִי.</tei:l>
          <tei:l>כִּי דְּרָכֶיהָ דְּרָכַי נֹעַם וּנְתִיבוֹתֶיהָ שָׁלוֹם.</tei:l>
          <tei:l>אמן.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
