  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:short_amidah_for_leil_shabbat_mazor">
        <tei:head>עמידה קצרה לליל שבת</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:short_amidah_for_leil_shabbat_mazor/1"/>
        <tei:lg>
          <tei:l>שַׁבָּת הִיא מִלִּזְעֹק הַיּוֹם,</tei:l>
          <tei:l>לִבִּי רוֹצֶה לָשִׁיר תּוֹדָה,</tei:l>
          <tei:l>וּבְכָל מַהֲמוֹרוֹת חַיַּי</tei:l>
          <tei:l>לִרְאוֹת בְּרָכָה, גַּם אִם חִידָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:short_amidah_for_leil_shabbat_mazor/2"/>
        <tei:lg>
          <tei:l>כִּי רְפוּאָה קְרוֹבָה לָבוֹא,</tei:l>
          <tei:l>וְהַיְּשׁוּעָה כְּהֶרֶף עַיִן,</tei:l>
          <tei:l>וְלֹא אֶחְדַּל מִלְּקַוּוֹת</tei:l>
          <tei:l>גַּם עֵת אֶמְזֹג אֶת כּוֹס הַיַּיִן.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:short_amidah_for_leil_shabbat_mazor/3"/>
        <tei:lg>
          <tei:l>שַׁבָּת הַיּוֹם. לֹא אֲבַקֵּשׁ.</tei:l>
          <tei:l>הַיּוֹם אוֹדֶה עַל מַה שֶּׁיֵּשׁ.</tei:l>
          <tei:l>אַךְ גַּם הַיּוֹם שִׁמְעָה, אֵלִי,</tei:l>
          <tei:l>הֵד רַחַשׁ חֹל שֶׁבְּקוֹלִי.</tei:l>
        </tei:lg>
      </tei:div>
