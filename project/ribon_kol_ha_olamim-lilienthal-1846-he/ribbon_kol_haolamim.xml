  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:ribbon_kol_haolamim">
        <tei:head>רִבּוֹן כׇּל הָעוֹלָמִים</tei:head>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>רִבּוֹן כׇּל הָעוֹלָמִים. אֲדוֹן כׇּל הַמַּעֲשִׂים.</tei:l>
          <tei:l>הַנּוֹטֵה כְּנָהָר שָׁלוֹם</tei:l>
          <tei:l>וּכְנַחַל שֹׁטֵף ‎כְּבוֹד גּוֹיִם.</tei:l>
          <tei:l>הַשְׁקִֽיפָה מִמְּעוֹן קָדְשֶֽׁךָ</tei:l>
          <tei:l>וּבָרֵךְ אֶת הָאָרֶץ הַזֹּאת</tei:l>
          <tei:l>the United States of America</tei:l>
          <tei:l>אֲשֶׁר אֲנַֽחְנוּ יוֹשְׁבִים עָלֶֽיהָ.</tei:l>
          <tei:l>לֹא יִשְׁמַע חָמָס בְּאַרְצָם.</tei:l>
          <tei:l>שֹׁד וָשֶֽׁבֶר בִּגְבוּלָם</tei:l>
          <tei:l>וְקָרָאתְ יְשׁוּעָה חוֹמוֹתֶֽיהָ</tei:l>
          <tei:l>וּשְׁעָרֶיהָ תְּהִלָּה</tei:l>
          <tei:l>וְנָתַתָּ גִּשְׁמֵיהֶם בְּעִתָּם</tei:l>
          <tei:l>וְנָֽתְנָה הָאָֽרֶץ יְבוּלָהּ</tei:l>
          <tei:l>וְעֵץ הַשָּׂדֶה יִתֵּן פִּרְיוֹ</tei:l>
          <tei:l>וְשַׂמְתָּ שָּׁלוֹם טוֹבָה וּבְרָכָה</tei:l>
          <tei:l>עַל כׇּל יוֹשְׁבֵי הָאָֽרֶץ</tei:l>
          <tei:l>וְשָֽׁכְבוּ וְאֵין מַחֲרִיד</tei:l>
          <tei:l>וְנוֹדַע בַּגּוֹיִם זַרְעָם</tei:l>
          <tei:l>וְצֶּאֶצָאֵיהֶם בְּתוֹךְ הָעַמִּים</tei:l>
          <tei:l>וְכׇל רוֹאֵיהֶם יַכִּרוּם</tei:l>
          <tei:l>כִּי אַתָּה בֵרַכְתָּם.</tei:l>
          <tei:l>אָמֵן׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>הָרֵק שִׁפְעַת טוּבְךָ עַל</tei:l>
          <tei:l>The President</tei:l>
          <tei:l>and the Vice President of the United States</tei:l>
          <tei:l>יְהִי כְנָהָר שְׁלוֹמָם</tei:l>
          <tei:l>וְצִדְקָתָם כְּגַלֵּי הַיָּם.</tei:l>
          <tei:l>בְּיָמֵיהֶם חֶֽסֶד וֶאֱמֶת יִפְגָּשׁוּ</tei:l>
          <tei:l>וְצֶֽדֶק וְשָׁלוֹם יִשָּׁקוּ</tei:l>
          <tei:l>גָּדוֹל יִהְיֶה כְּבוֹדָם</tei:l>
          <tei:l>בִּישׁוּעָתֶךָ וּבְעָזְךָ</tei:l>
          <tei:l>יָגִילוּ מְאֹד.</tei:l>
          <tei:l>אָמֵן׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>צַו בִּרְכוֹתֶֽיךָ גַם אֶל</tei:l>
          <tei:l>the Governor and the lieutentant Governor of the state</tei:l>
          <tei:l>and the Mayor and the Common Council of this City.</tei:l>
          <tei:l>אַתָּה תוֹרֵם אֶת הַדֶּֽרֶךְ הַטּוֹבָה אֲשֶׁר יֵֽלְכוּ בָהּ</tei:l>
          <tei:l>לָדִין אֶת כׇּל הָעָם בְּצֶֽדֶק</tei:l>
          <tei:l>וְכׇל הַגּוֹי בְּמְשְׁפָּט</tei:l>
          <tei:l>וְיִרְאוּ כֻּלָּם וְיִתְעַנְגוּ</tei:l>
          <tei:l>מֵרֹב שָׁלוֹם.</tei:l>
          <tei:l>אָמֵן׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>שְׁלַח יִשְׁעֶֽךָ גַּם אֶל</tei:l>
          <tei:l>the City of New York</tei:l>
          <tei:l>וְאֶל כׇּל יוֹשׁבֶֽיהָ.</tei:l>
          <tei:l>פְּרוֹשׂ עֲלֵיהֶם סֻכַּת שְׁלוֹמֶֽךָ</tei:l>
          <tei:l>וְהָסֵר מֵהֶם כׇּל מַחֲלָה וְכׇל פֶּֽגַע.</tei:l>
          <tei:l>שָׂשׂוֹן וְשִׂמְחָה יַשִּֽׂיגוּ</tei:l>
          <tei:l>וְנָסוּ יָגוֹן וַאֲנָחָה.</tei:l>
          <tei:l>אָמֵן׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>אָבִֽינוּ הַטּוֹב</tei:l>
          <tei:l>וְגַם אוֹתָֽנוּ עַמְּךָ בֵּית יִשְׂרָאֵל תַּעֲנֶה</tei:l>
          <tei:l>בְּעֵת רָצוֹן</tei:l>
          <tei:l>וְתַעֲזוֹר</tei:l>
          <tei:l>בְּכׇל יוֹם וָיוֹם.</tei:l>
          <tei:l>בְטוּבְּךָ הַגָּדוֹל תַּנְחֵֽינוּ תָּמִיד</tei:l>
          <tei:l>וְתַשְׂבִּֽיעַ בְּצַחְצָחוֹת נַפְשֵֽׁנוּ.</tei:l>
          <tei:l>וְהָיִיֽנוּ כְּגַן רָוֶה</tei:l>
          <tei:l>וּכְמוֹצָא מַֽיִם אֲשֶׁר לֹא יְכַזְּבוּ מֵימָיו</tei:l>
          <tei:l>וְנֵֽלְכָה מֵחַֽיִל אֶל חַֽיִל</tei:l>
          <tei:l>עַד כִּי יָבוֹא לְצִיּוֹן גּוֹאֵל.</tei:l>
          <tei:l>וְכֵן יְהִי רָצוֹן</tei:l>
          <tei:l>וְנֹאמַר אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
