    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:elohim_bealunu_yosef">
        <tei:head>אֱלֹהִים בְּעָלֽוּנוּ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohim_bealunu_yosef/1"/>
        <tei:lg>
          <tei:l>עַל־גְּזֵרַת אֶבְּרוֹךְ בִּשְׁנַת התַּתְקְנָא</tei:l>
          <tei:l>רַבִּי יוֹסֵף מִקַּרְטְרֶשׂ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohim_bealunu_yosef/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אֱ</tei:seg>לֹהִים בְּעָלֽוּנוּ זוּלָתְךָ אֲדֹנִים <tei:bibl>(ישעיהו כו:יג)</tei:bibl></tei:l>
          <tei:l>כִּמְעַט כִּלּֽוּנוּ מַֽיִם זֵידוֹנִים</tei:l>
          <tei:l>בִּהְיוֹתְךָ כְּמַחֲרִישׁ וּכְמַסְתֵּר פָּנִים <tei:bibl>(ישעיהו נג:ג)</tei:bibl></tei:l>
          <tei:l>בָּא שׁוֹבֵר וְהִכָּה אֵם עַל־בָּנִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohim_bealunu_yosef/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בַּ</tei:seg>ת־עַמִּי גָּזִּי הַשְׁלִיכִי נִזְרֵךְ <tei:bibl>(ירמיהו ז:כט)</tei:bibl></tei:l>
          <tei:l>כִּי הִלֵּל רָשָׁע וּבֹצֵֽעַ בֵּרֵךְ <tei:bibl>(תהילים י:ג)</tei:bibl></tei:l>
          <tei:l>חֶֽרֶב הָאֹיֵב הֵאָסְפִי לְתַעְרֵךְ <tei:bibl>(ירמיהו מז:ו)</tei:bibl></tei:l>
          <tei:l>אֲנוּשָׁה מַכָּתֵךְ <tei:bibl>(מיכה א:ט)</tei:bibl> בְּאֵין תְּעָלָה וְאֶֽרֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohim_bealunu_yosef/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">גֵּ</tei:seg>וִי נָתַֽתִּי וּלְחָיַי לְמֹרְטִים <tei:bibl>(ישעיהו נ:ו)</tei:bibl></tei:l>
          <tei:l>וּלְשִׁמְךָ עַמְּךָ לַחֶֽרֶב מָטִים</tei:l>
          <tei:l>עֲבָדֶֽיךָ אָיֹם עָמְדוּ לַמִּשְׁפָּטִים</tei:l>
          <tei:l>אָבוֹת עַל־בָּנִים לִהְיוֹת נִשְׁחָטִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohim_bealunu_yosef/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">דִּ</tei:seg>ין יוֹצְרָם קִבְּלוּ וְלֹא פָרְקוּ עֻלּוֹ</tei:l>
          <tei:l>הִצְדִּיקוּ צַדִּיק צוּר תָּמִים פָּעֳלוֹ <tei:bibl>(דברים לב:ד)</tei:bibl></tei:l>
          <tei:l>וּבְהֵיכָלוֹ כָּבוֹד אוֹמֵר כֻּלּוֹ <tei:bibl>(תהילים כט:ט)</tei:bibl></tei:l>
          <tei:l>נִפְּלָה בְּיַד יְהֹוָה וּבְיַד אָדָם לֹא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohim_bealunu_yosef/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הָ</tei:seg>אֹמֵר לְאָבִיו וּלְאִמּוֹ לֹא רְאִיתִיו <tei:bibl>(דברים לג:ט)</tei:bibl></tei:l>
          <tei:l>וְלִבְנוֹ יְחִידוֹ אֹמֵר לֹא יְלָדְתִיו</tei:l>
          <tei:l>נֶהְפַּֽכְתִּי לְאַכְזָר וּכְמוֹ זָר חֲשַׁבְתִּיו <tei:bibl>(הושע ח:יב)</tei:bibl></tei:l>
          <tei:l>הַעַל־כֵּן אֲהַבְתִּיו אֵלַי וְהִקְרַבְתִּיו׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohim_bealunu_yosef/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וַ</tei:seg>יְהִי אוֹי וָהִי בְּרַכַּת תַּעֲנוּגִים</tei:l>
          <tei:l>אֶֽרֶץ רָעֲשָׁה וְיוֹשְׁבֶֽיהָ נְמוֹגִים</tei:l>
          <tei:l>בְּתוּלוֹתַי נוּגוֹת וּבַחוּרַי <tei:bibl>(איכה א:ד; ב:כא)</tei:bibl> נוּגִים</tei:l>
          <tei:l>אוֹי לִי כִּי עָיְפָה נַפְשִׁי לְהֹרְגִים׃ <tei:bibl>(ירמיהו ד:לא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohim_bealunu_yosef/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זָ</tei:seg>כְרוּ אֶת־בּוֹרְאָם וּבְרִית לֹא תוּפַר</tei:l>
          <tei:l>יוּטַב לְךָ דָּמָם מִשֶּׂה וּמִשּׁוֹר פָּר</tei:l>
          <tei:l>אֶֽרֶץ אַל־תְּכַסִּי דָמָם <tei:bibl>(איוב טז:יח)</tei:bibl> בֶּעָפָר</tei:l>
          <tei:l>כִּי־אִם בְּדַם שֹׁפְכו עַד־כֵּס לֹא יְכֻפָּר׃ <tei:bibl>(במדבר לה:לג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohim_bealunu_yosef/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חֲ</tei:seg>מָסִי עָלֶיךָ מֶֽלֶךְ הָאִיִּים</tei:l>
          <tei:l>בִּכְנָפָיו נִמְצְאוּ דַּם נַפְשׁוֹת נְקִיִּים <tei:bibl>(ירמיהו ב:לד)</tei:bibl></tei:l>
          <tei:l>יִפְקֹד אֱלֹהִים עַל־כִּתֵּי כְתִּיִּים</tei:l>
          <tei:l>חַלֲלֵי בַת־עַמִּי <tei:bibl>(ירמיהו ח:כג)</tei:bibl> חֶלְקָם בַּחַיִּים׃ <tei:bibl>(תהילים יז:יד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohim_bealunu_yosef/10"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">טַ</tei:seg>ל אַל ואַל־מָטָר <tei:bibl>(שמואל ב׳ א:כא)</tei:bibl> עַל־אֶֽרֶץ הָאִי</tei:l>
          <tei:l>מִיּוֹם נִתְעַטַּר מַלְכֵּךְ לָךְ אֶֽרֶץ אִי</tei:l>
          <tei:l>בַּת־עַמִּי קוּמִי מִתּוֹכָהּ וּצְאִי</tei:l>
          <tei:l>הֲגַם הֲלֹם רָאִיתִי זֹאת אַחֲרֵי רֹאִי׃ <tei:bibl>(בראשית טז:יג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohim_bealunu_yosef/11"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יְ</tei:seg>הֹוָה מִבָּשָׁן אָמַר וּמִמְּצֻלוֹת</tei:l>
          <tei:l>וּמִיָּם אָשִׁיב <tei:bibl>(תהילים סח:כג)</tei:bibl> בַּחוּרִים וּבְתוּלוֹת</tei:l>
          <tei:l>אֹיְבַי מִגֶּֽפֶן בִּטְּלוּ אַשְׁכּוֹלוֹת</tei:l>
          <tei:l>לַחִים וִיבֵשִׁים <tei:bibl>(במדבר ו:ג)</tei:bibl> וְנִשְׁאֲרוּ עוֹלֵלוֹת׃ <tei:bibl>(עובדיה א:ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohim_bealunu_yosef/12"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כְּ</tei:seg>בוֹאָם בַּקָמָה מְלִילוֹת לֹא קָטְפוּ <tei:bibl>(דברים כג:כו)</tei:bibl></tei:l>
          <tei:l>מְאַלְּמִים אֲלֻמִּים <tei:bibl>(בראשית לז:ז)</tei:bibl> חֶרְמֵשׁ הֵנִיפוּ</tei:l>
          <tei:l>כִּתְּרוּ בִּנְיָמִין וּבְיָמִין הִרְדִּיפוּ <tei:bibl>(שופטים כ:מג)</tei:bibl></tei:l>
          <tei:l>מוֹנִים לֹא אֲדֹנִים לָאֵֽלֶּה <tei:bibl>(מלכים א׳ כב:יז)</tei:bibl> חֵרְפוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohim_bealunu_yosef/13"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ל</tei:seg>וֹא אֲלֵיכֶם כׇּל־עֹבְרֵי דֶֽרֶךְ הַבִּיטוּ</tei:l>
          <tei:l>וּרְאוּ אִם־יֵשׁ מַכְאוֹב כְּמַכְאוֹבִי <tei:bibl>(איכה א:יב)</tei:bibl> בִּי חָבָטוּ</tei:l>
          <tei:l>אֹיְבַי רָעָה יִמְצְאוּ מֵעֵץ רוֹעִים נִלְקָטוּ</tei:l>
          <tei:l>אֲלָפִים בְּנֵי שָׁנָה לְעֵינַי נִשְׁחָטוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohim_bealunu_yosef/14"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>י יִתֵּן עֵינַי כִּנְטוּלֵי כִימָה <tei:bibl>(תלמוד בבלי, ברכות נט)</tei:bibl></tei:l>
          <tei:l>אֶבְכֶּה בַּת־עַמִּי יָמִים יְמִימָה</tei:l>
          <tei:l>עָלְתָה הַחֵמָה כְּמִנְיַן הַחַמָּה</tei:l>
          <tei:l>אַנְהִימָה לָמָה יְהֹוָה שָׁמָהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohim_bealunu_yosef/15"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נֶ</tei:seg>אֶסְפוּ לְמִשְׁמָר וְאָשֵׁר עִמָּנוּ</tei:l>
          <tei:l>אַךְ הַשָּׂר הֵצֵר וְהַצָּר לִימִנוֹ</tei:l>
          <tei:l>וַנֹּאמַר בְּיָדוֹ קִימָנוּ</tei:l>
          <tei:l>וַיֹּאמְרוּ לֹא כִּי עַל־יוֹם טוֹב בָּאנוּ׃ <tei:bibl>(שמואל א׳ כה:ח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohim_bealunu_yosef/16"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">סִ</tei:seg>ין וְעוֹקֵר הָרִים לְמִישׁוֹר שָׁם עָקֹב</tei:l>
          <tei:l>עַל־פֶּה וּסְפָרִים בְּמוֹקְשִׁים לֹא יִנְקֹב <tei:bibl>(איוב מ:כד)</tei:bibl></tei:l>
          <tei:l>יִשְׁכֹּן לָבֶֽטַח בְּשָׂרוֹ <tei:bibl>(תהילים טז:ט)</tei:bibl> לֹא־יִרְקֹב</tei:l>
          <tei:l>מַה־טֹּבוּ אֹהָלֶֽיךָ יַעֲקֹב׃ <tei:bibl>(במדבר כד:ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohim_bealunu_yosef/17"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">עֵ</tei:seg>דָה הַקְּדוֹשָׁה כֻּלָהּ מַתְאֶֽמֶת</tei:l>
          <tei:l>לִפְנֵי גוֹזְזֶֽיהָ כְּרָחֵל נֶאֱלֶֽמֶת <tei:bibl>(ישעיהו נג:ז)</tei:bibl></tei:l>
          <tei:l>בַּת קוֹל מֵחֹרֵב כְּיוֹנָה מנַהֶֽמֶת</tei:l>
          <tei:l>אוֹי לִי אוֹי לִי מֹשֶׁה עַבְדִּי מֵת! <tei:bibl>(יהשוע א:ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohim_bealunu_yosef/18"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פָּ</tei:seg>רְצוּ פֶּֽרֶץ רָב בְּנֵי שֻׁעָלִים</tei:l>
          <tei:l>נֹדַע כִּי שַׁעֲרֵי תְפִלָּה נִנְעָלִים</tei:l>
          <tei:l>בְּהֵאָסֵף יוֹסֵף אִישׁ־חַי רַב־פְּעָלִים <tei:bibl>(שמואל ב׳ כג:כ)</tei:bibl></tei:l>
          <tei:l>כׇּל־יְחֵפֵי רָֽגֶל הִדְרִיךְ בַּנְּעָלִים׃ <tei:bibl>(ישעיהו יא:טו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohim_bealunu_yosef/19"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">צָ</tei:seg>דִּיקִים אַחֲרֵי אֱלֹהִים נָֽהוּ</tei:l>
          <tei:l>כׇּל־שׁוֹמְעֵי שִׁמְעָם כִּי כֵן תָּמָהוּ</tei:l>
          <tei:l>אֵלִיָּה קָרָא מַלְאָךְ וְצִוָּֽהוּ</tei:l>
          <tei:l>אֱמֹר לַאֲדֹנֶֽיךָ הִנֵּה אֵלִיָּֽהוּ׃ <tei:bibl>(מלכים א׳ יח:ח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohim_bealunu_yosef/20"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ק</tei:seg>וֹל שַׁוְעַת עַמִּי בְּאֶֽרֶץ מַרְחַקִּים <tei:bibl>(ירמיהו ח:יט)</tei:bibl></tei:l>
          <tei:l>כִּי הָרְגוּ רֵיקִים אֲנָשִׁים צַדִּיקִים</tei:l>
          <tei:l>לַחַיִּים וְלַמָּוֶת בַּיהֹוָה דְּבֵקִים</tei:l>
          <tei:l>לֹא עָבְרוּ תוֹרוֹת וְלֹא חָלְפוּ חֻקִּים׃ <tei:bibl>(ישעיהו כד:ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohim_bealunu_yosef/21"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רִ</tei:seg>אשׁוֹנָה בְּפוֹשְׁרִים וּשְׁנִיָּה בְּרוֹתְחִים</tei:l>
          <tei:l>בִּהְיוֹת כָּאֲלָפִים הָאַלּוּפִים זְבוּחִים</tei:l>
          <tei:l>שְׁעָרַי שׁוֹמֵמִים כֹּהֲנַי נֶאֱנָחִים <tei:bibl>(איכה א:ד)</tei:bibl></tei:l>
          <tei:l>כִּי הִגְעִיל שָׂרֵי בַת־עַמִּי בְּרוֹתְחִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohim_bealunu_yosef/22"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שָֽׁ</tei:seg>מָּה קִדְּשֽׁוּךָ שׁוֹמְרֵי מִשְׁמָרוֹת</tei:l>
          <tei:l>לָשֵׂאת אֵימֶֽךָ לְרֹאשׁ אַשְׁמֻרוֹת <tei:bibl>(איכה ב:יט)</tei:bibl></tei:l>
          <tei:l>מְתֵי שֵׁם שָׂרֵי חֲמִשִּׁים וַעֲשָׂרוֹת <tei:bibl>(שמות יח:כא-כה; דברים א:טו)</tei:bibl></tei:l>
          <tei:l>וּבַעֲיָרוֹת אֲחֵרוֹת לֹא אֵדַע סְפוֹרוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohim_bealunu_yosef/23"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">תַּֽ</tei:seg>חַת מִקְנֵיהֶם הִקְרִיבוּ בְנֵיהֶם</tei:l>
          <tei:l>וְרֵאשִׁית אוֹנֵיהֶם שָׁחֲטוּ לְעֵינֵיהֶם</tei:l>
          <tei:l>קְדוֹשִׁים לֹא־חָשְׂכוּ מִמְּךָ יְחִידֵיהֶם</tei:l>
          <tei:l>כִּי אָחֲזוּ מַעֲשֶׂה אֲבוֹתֵיהֶם בִּידֵיהֶם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohim_bealunu_yosef/24"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יֹ</tei:seg>שְׁבֵי אֹהָלִים נְטוּעִים כַּאֲהָלִים</tei:l>
          <tei:l>שׁוֹקְלֵי מִשְׁקָלִים בְּאַוִּיר מִגְדַּלִים</tei:l>
          <tei:l>בְּהֵאָסֵף חֲכָמַי וּסְפָרַי נִגְלָלִים</tei:l>
          <tei:l>אוֹתִיּוֹת פּוֹרְחוֹת וְנִשְׂרְפוּ גְוִילִים׃ <tei:bibl>(תלמוד בבלי, עבודה זרה יח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohim_bealunu_yosef/25"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וּ</tei:seg>מַה־יָּקְרוּ רֵעִים וּמֶה־עָצמוּ רָאשִׁים</tei:l>
          <tei:l>וְלֹא נִכְּרוּ שׁוֹעִים שָֽׁמָּה מֵרָשִׁים</tei:l>
          <tei:l>חַכְמֵי חֲרָשִׁים וּנְבוֹנֵי לְחָשִׁים</tei:l>
          <tei:l>נֶֽצַח יִשְׂרָאֵל רֶֽכֶב וּפָרָשׁים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohim_bealunu_yosef/26"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שִׂ</tei:seg>יחָתָם טְהוֹרָה מְזֻקֶּֽקֶת בַּעֲלִיל</tei:l>
          <tei:l>אֲרֻכָּה וּקְצָרָה מִיהוּדָה וְגָלִיל</tei:l>
          <tei:l>פֶּה קָדוֹש הוֹרָה כׇּל־עֻבָּר וּשְׁלִיל</tei:l>
          <tei:l>יָשִֽׂימוּ קְטֹרָה בְאַפֶּֽךָ וְכָלִיל׃ <tei:bibl>(דברים לג:י)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohim_bealunu_yosef/27"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>קָדֽוּךָ בַּצַּר מוּסָרְךָ לָֽמוֹ <tei:bibl>(ישעיהו כו:טז)</tei:bibl></tei:l>
          <tei:l>אִישׁ הוֹצִיא רוּחוֹ וְהִמְצִיא דָמוֹ</tei:l>
          <tei:l>יֶעֱרַב לְמֶֽלֶךְ רַב כְּקׇרְבְּנוֹתָיו מֵאוּלַמּוֹ</tei:l>
          <tei:l>אַף יְכַפֵּר אַדְמָתוֹ עַמּוֹ׃ <tei:bibl>(דברים לב:מג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohim_bealunu_yosef/28"/>
        <tei:lg>
          <tei:l>רָפוּ יָדַֽיִּם לִשְׁמֹֽעַ צַעֲקָתָם</tei:l>
          <tei:l>נוֹדַע כִּי פֶֽלַח רִמּוֹן רַקָּתָם <tei:bibl>(שיר השירים ד:ג)</tei:bibl></tei:l>
          <tei:l>תָּנֽוּחַ בִּצְרוֹר חַיִּים אַבְקָתָם</tei:l>
          <tei:l>זֹאת נַחֲלַת עַבְדֵי יְהֹוָה וְצִדְקָתָם׃ <tei:bibl>(ישעיהו נד:יז)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
