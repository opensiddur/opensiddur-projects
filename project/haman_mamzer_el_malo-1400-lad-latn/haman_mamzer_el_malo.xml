  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:haman_mamzer_el_malo">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haman_mamzer_el_malo/1"/>
        <tei:lg>
          <tei:l>Haman mamzer el malo</tei:l>
          <tei:l>trató de anikilar</tei:l>
          <tei:l>a Yisrael el bueno</tei:l>
          <tei:l>el catorse de Adar.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haman_mamzer_el_malo/2"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">Pizmon:</tei:note>
          </tei:l>
          <tei:l>Comamos, bevamos</tei:l>
          <tei:l>Y tambien mos emborrachemos.</tei:l>
          <tei:l>Y alegres estemos,</tei:l>
          <tei:l>Del bueno d’Israel!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haman_mamzer_el_malo/3"/>
        <tei:lg>
          <tei:l>Ahashverosh peotente</tei:l>
          <tei:l>Se metió en una fuente</tei:l>
          <tei:l>Y vino la sirpiente</tei:l>
          <tei:l>Y se comió su diente</tei:l>
          <tei:l>Comamos, bevamos...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haman_mamzer_el_malo/4"/>
        <tei:lg>
          <tei:l>Ordenaron desayunos</tei:l>
          <tei:l>Ke debemos haser</tei:l>
          <tei:l>Grandes, chicos y vayados</tei:l>
          <tei:l>Todo ‘l puevlo d’Israel.</tei:l>
          <tei:l>Comamos, bevamos...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
