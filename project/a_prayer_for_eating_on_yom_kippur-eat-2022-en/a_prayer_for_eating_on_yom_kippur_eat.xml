  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_prayer_for_eating_on_yom_kippur_eat">
        <tei:head>A Prayer for Eating on Yom Kippur, by A Mitzvah to Eat (2022)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_eating_on_yom_kippur_eat/1"/>
        <tei:lg>
          <tei:l>Dear God,</tei:l>
          <tei:l>As I prepare to eat on Yom Kippur,</tei:l>
          <tei:l>please help me find meaning.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_eating_on_yom_kippur_eat/2"/>
        <tei:lg>
          <tei:l>As I nourish my body, heart, mind, and soul,</tei:l>
          <tei:l>may comfort envelop me.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_eating_on_yom_kippur_eat/3"/>
        <tei:lg>
          <tei:l>May I find <tei:hi rend="italic">teshuvah</tei:hi></tei:l>
          <tei:l>by returning to my inner light.</tei:l>
          <tei:l>By returning to my true self.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_eating_on_yom_kippur_eat/4"/>
        <tei:lg>
          <tei:l>May I find a community</tei:l>
          <tei:l>who will hold me where I am.</tei:l>
          <tei:l>For who I am.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_eating_on_yom_kippur_eat/5"/>
        <tei:lg>
          <tei:l>May the words of my heart</tei:l>
          <tei:l>reach Your loving and compassionate presence.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_eating_on_yom_kippur_eat/6"/>
        <tei:lg>
          <tei:l>May I find peace and holiness</tei:l>
          <tei:l>through eating,</tei:l>
          <tei:l>through connecting,</tei:l>
          <tei:l>through You.</tei:l>
        </tei:lg>
      </tei:div>
