  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:birkat_habayit">
        <tei:head>בִּרְכָּת הָבָּיִת</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_habayit/1"/>
        <tei:lg>
          <tei:l>בְּזֶה הַשַּׁעַר לֹא יָבוֹא צַעַר.</tei:l>
          <tei:l>בְּזֹאת הַדִּירָה לֹא תָבוֹא צָרָה.</tei:l>
          <tei:l>בְּזֹאת הַדֶּלֶת לֺא תָבוֹא בֶּהָלָה.</tei:l>
          <tei:l>בְּזֹאת הַמַּחְלָקָה לֺא תָבוֹא מַחְלוֹקֶת.</tei:l>
          <tei:l>בְּזֶה הַמָּקוֹם תְּהִי בְרָכָה וְשָׁלוֹם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_habayit/2"/>
        <tei:lg>
          <tei:l>וְעָ֥שׂוּ לִ֖י מִקְדָּ֑שׁ</tei:l>
          <tei:l>וְשָׁכַנְתִּ֖י בְּתוֹכָֽם׃ <tei:bibl>(שמות כה:ח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_habayit/3"/>
        <tei:lg>
          <tei:l>בְּ֭חָכְמָה יִבָּ֣נֶה בָּ֑יִת</tei:l>
          <tei:l>וּ֝בִתְבוּנָ֗ה יִתְכּוֹנָֽן׃</tei:l>
          <tei:l>וּ֭בְדַעַת חֲדָרִ֣ים יִמָּלְא֑וּ</tei:l>
          <tei:l>כָּל־ה֖וֹן יָקָ֣ר וְנָעִֽים׃ <tei:bibl>(משלי כד:ג-ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_habayit/4"/>
        <tei:lg>
          <tei:l>מַה טֹּבוּ אֹהָלֶיךָ יַעֲקֹב</tei:l>
          <tei:l>מִשְׁכְּנֹתֶיךָ יִשְׂרָאֵל. <tei:bibl>(במדבר כד:ה)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
