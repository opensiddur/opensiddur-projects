    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:azai_bevagdi">
        <tei:head>אֲזַי בְּבׇגְדִי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azai_bevagdi/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אֲ</tei:seg>זַי בְּבׇגְדִי אִמְרֵי דָּר מְעוֹנִי</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>הִשְׂתָּרֵג עֲוֺנִי הִכְבִּיד עֻלִּי מוֹנִי</tei:l>
          <tei:l><tei:seg type="acrostic">גָּ</tei:seg>בַר עָלַי צָר בְּמַהֲלֹם לְהׇלְמֵֽנִי</tei:l>
          <tei:l>אַפּ֤וֹ טָרַ֨ף ׀ וַֽיִּשְׂטְמֵ֗נִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azai_bevagdi/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">דְּ</tei:seg>רָכָיו זָנַֽחְתִּי אֲשֶׁר לִי הוֹרָה</tei:l>
          <tei:l><tei:seg type="acrostic">הֵ</tei:seg>ן עַל־כֵּן הֵעִיר בִּי אַף וְזַֽעַם וְעֶבְרָה</tei:l>
          <tei:l><tei:seg type="acrostic">זַ</tei:seg>עְמוֹ בִּי הֵרִיק וְחִצָּיו בִּי יָרָה</tei:l>
          <tei:l>וַיְקִימֵ֥נִי ל֗֝וֹ לְמַטָּרָֽה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azai_bevagdi/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חָ</tei:seg>לְפוּ עָלַי בְּיוֹם זֶה חָמֵשׁ תְּלָאוֹת</tei:l>
          <tei:l><tei:seg type="acrostic">טָ</tei:seg>רְפוּ חַיָּתִי וַיְשִׂימֽוּנִי לְמַשּׁוּאוֹת</tei:l>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>גְעָה נַפְשִׁי יָגֹֽעַ וְהַלְאוֹת</tei:l>
          <tei:l>נַעֲוֵ֣יתִי מִשְּׁמֹ֔עַ נִבְהַ֖לְתִּי מֵרְאֽוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azai_bevagdi/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כׇּ</tei:seg>ל־אֵֽלֶּה בְּזׇכְרִי יְעוֹרְרֽוּנִי אֲנָחוֹת</tei:l>
          <tei:l><tei:seg type="acrostic">לֶ</tei:seg>הָבָה הֱשִׂיקַֽתְנִי מְלַהֶֽטֶת כֶּֽסֶל וְטוּחוֹת</tei:l>
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>סְפֵּד מַר אַגְדִּיל וְאַרְחִיק שְׂמָחוֹת</tei:l>
          <tei:l>כִּי בְיוֹם זֶה נִשְׁתַּבְּרוּ הַלּוּחוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azai_bevagdi/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נ</tei:seg>וֹעַד עָלַי צָר וַהֲמוֹנָיו הִצְמִיד</tei:l>
          <tei:l><tei:seg type="acrostic">סַ</tei:seg>בּֽוּנִי כַמַּֽיִם וְטָבַֽעְתִּי וְאֵין מַעֲמִיד</tei:l>
          <tei:l><tei:seg type="acrostic">עַ</tei:seg>ל כֵּן אֲיֵלִיל בְּמוֹ־פִי וְנֶֽהִי אַתְמִיד</tei:l>
          <tei:l>כִּי בְיוֹם זֶה בֻּטַּל הַתָּמִיד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azai_bevagdi/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פּ</tei:seg>וֹשְׁחַי הָֽמוּ כַּהֲמוֹת זֶֽרֶם מִיכַל</tei:l>
          <tei:l><tei:seg type="acrostic">צָ</tei:seg>מְתוּ בַבּוֹר חַיַּי וַיִּתְּנֽוּנִי לְמַאֲכָל</tei:l>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>רָא עָלַי מוֹעֵד וַהֲמוֹנַי שָׁכֹל שִׁכַּל</tei:l>
          <tei:l>כִּי בְיוֹם זֶה הׇעֳמָד צֶֽלֶם בַּהֵיכָל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azai_bevagdi/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רַ</tei:seg>בָּֽתִי עָם צַר הֵצַר וּפְתָחֶֽיהָ פֶּֽתַח הֶעֱרָה</tei:l>
          <tei:l><tei:seg type="acrostic">שָׁ</tei:seg>ת גַּפְנִי לְשַׁמָּה בְּיוֹם זַֽעַם וְעֶבְרָה</tei:l>
          <tei:l><tei:seg type="acrostic">תַּ</tei:seg>אֲוָתוֹ רָאָה צָר וְיָדוֹ בְּעֹז גָּבְרָה</tei:l>
          <tei:l>כִּי בְיוֹם זֶה שָׂרַף אַפּוֹסְטְמוֹס אֶת־הַתּוֹרָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azai_bevagdi/8"/>
        <tei:lg>
          <tei:l>חָרְקוּ שֵׁן רְשָׁעִים בְּיוֹם אַף יְהֹוָה בִּי הֵעִיר</tei:l>
          <tei:l>לֹא־חָמַל צַר וְאוֹיֵב עַל־יָשִׁישׁ וְצָעִיר</tei:l>
          <tei:l>אַפּוֹ בִּי חָרָה וּרְשָׁפָיו בִּי הִבְעִיר</tei:l>
          <tei:l>כִּי בְיוֹם זֶה הׇבְקְעָה הָעִיר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azai_bevagdi/9"/>
        <tei:lg>
          <tei:l>רַחֵם יְהֹוָה וְדַבֵּר עַל־לֵב עֲגוּמִים</tei:l>
          <tei:l>בְּשִׁבְעָה עָשָׂר לַחֹֽדֶשׁ יוֹשְׁבִים מִשְׁתּוֹמְמִים</tei:l>
          <tei:l>יָהּ גַּלְגֵּל עֲלֵיהֶם הֲמוֹן רַחֲמֶֽיךָ מִמְּרוֹמִים</tei:l>
          <tei:l>אֵל מֶֽלֶךְ יוֹשֵׁב עַל כִּסֵּא רַחֲמִים׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
