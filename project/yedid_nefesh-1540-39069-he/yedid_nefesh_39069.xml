    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yedid_nefesh_39069">
        <tei:head>יְדִיד נֶפֶשׁ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yedid_nefesh_39069/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יְ</tei:seg>דִיד נֶֽפֶשׁ אָב הָרַחֲמָן,</tei:l>
          <tei:l>מְשׁוֹךְ עַבְדְּךָ אֶל־רְצוֹנֶֽךָ,</tei:l>
          <tei:l>יָרוּץ עַבְדְּךָ כְּמוֹ אַיָּל,</tei:l>
          <tei:l>יִשְׁתַּחֲוֶה אֶל מוּל הֲדָרֶֽךָ,</tei:l>
          <tei:l>יֶעֱרַב לוֹ יְדִידוֹתֶֽיךָ,</tei:l>
          <tei:l>מִנּוֹפֶת צוּף וְכׇל־טָֽעַם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yedid_nefesh_39069/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הָ</tei:seg>דוּר נָאֶה זִיו הָעוֹלָם,</tei:l>
          <tei:l>נַפְשִׁי חוֹלַת אַהֲבָתֶֽךָ,</tei:l>
          <tei:l>אָנָּא אֵל נָא רְפָא נָא לָהּ,</tei:l>
          <tei:l>בְּהַרְאוֹת לָהּ נוֹֽעַם זִיוֶֽךָ,</tei:l>
          <tei:l>אָז תִּתְחַזֵּק וְתִתְרַפֵּא,</tei:l>
          <tei:l>וְהָיְתָה לָּהּ שִׂמְחַת עוֹלָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yedid_nefesh_39069/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וָ</tei:seg>תִיק יֶהֱמוּ נָא רַחֲמֶֽיךָ,</tei:l>
          <tei:l>וְחוּסָה נָא עַל בֵּן אֲהוּבֶֽךָ,</tei:l>
          <tei:l>כִּי־זֶה כַּמָּה נִכְסוֹף נִכְסַפְתִּי,</tei:l>
          <tei:l>לִרְאוֹת בְּתִפְאֶֽרֶת עֻזֶּֽךָ,</tei:l>
          <tei:l>אָנָּא אֵלִי חֶמְדָּת לִבִּי,</tei:l>
          <tei:l>חוּסָה נָא וְאַל תִּתְעַלָּם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yedid_nefesh_39069/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הִ</tei:seg>גָּלֶה נָא וּפְרוֹס חָבִיבִי</tei:l>
          <tei:l>עָלַי אֶת סֻכַּת שְׁלוֹמָךְ</tei:l>
          <tei:l>תָּאִיר אֶֽרֶץ מִכְּבוֹדֶֽךָ,</tei:l>
          <tei:l>נָגִֽילָה וְנִשְׂמְחָה בָּךְ,</tei:l>
          <tei:l>מַהֵר אָהוּב כִּי בָא מוֹעֵד,</tei:l>
          <tei:l>וְחָנֵּֽנוּ כִּימֵי עוֹלָם׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
