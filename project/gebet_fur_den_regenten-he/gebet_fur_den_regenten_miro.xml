    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:gebet_fur_den_regenten_miro">
        <tei:head>הַנּוֹתֵן תְּשׁוּעָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gebet_fur_den_regenten_miro/2"/>
        <tei:lg>
          <tei:l>הַנּוֹתֵן תְּשׁוּעָה לַמְּלָכִים</tei:l>
          <tei:l>וּמֶמְשָׁלָה לַנְּסִיכִים</tei:l>
          <tei:l>וּמַלְכוּתוֹ מַלְכוּת כׇּל־עוֹלָמִים</tei:l>
          <tei:l>הַפּוֹצֶה אֶת דָּוִד עַבְדּוֹ מֵחֶֽרֶב רָעָה׃</tei:l>
          <tei:l>הַנּוֹתֵן בַּיָּם דֶּֽרֶךְ</tei:l>
          <tei:l>וּבְמַֽיִם עַזִּים נְתִיבָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gebet_fur_den_regenten_miro/3"/>
        <tei:lg>
          <tei:l>הוּא יְבָרֵךְ וְיִשְׁמוֹר וְיִנְצוֹר וְיַעֲזוֹר</tei:l>
          <tei:l>וִירוֹמֵם וִיגַדֵּל וִינַשֵּׂא לְמַעְלָה לְמַעְלָה</tei:l>
          <tei:l>לַאֲדוֹנֵנוּ הַמֶּלֶךְ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>יָרוּם הוֹדוֹ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gebet_fur_den_regenten_miro/4"/>
        <tei:lg>
          <tei:l>מֶֽלֶךְ מַלְכֵי הַמְּלָכִים</tei:l>
          <tei:l>בְּרַחֲמָיו יְחַיֵֽהוּ</tei:l>
          <tei:l>וְיִשְׁמְרֵֽהוּ וּמִכׇּל צָרָה וְיָגוֹן וָנֶֽזֶק יַצִּילֵה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gebet_fur_den_regenten_miro/5"/>
        <tei:lg>
          <tei:l>וַיְדַבֵּר עַמִּים תַּחַת רַגְלָיו</tei:l>
          <tei:l>וְיַפִּיל שׂוֹנְאָיו לְפָנָיו</tei:l>
          <tei:l>וּבְכׇל אֲשֶׁר יִפְנֶה יַצְלִיחַ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gebet_fur_den_regenten_miro/6"/>
        <tei:lg>
          <tei:l>מֶֽלֶךְ מַלְכֵי הַמְּלָכִים</tei:l>
          <tei:l>בְּרַחֲמָיו יִתֵּן בְּלִבּוֹ</tei:l>
          <tei:l>וּבְלֵב כׇּל יוֹעֲצָיו וְשָׂרָיו</tei:l>
          <tei:l>רַחֲמָנוֹת לַעֲשׂוֹת טוֹבָה עִמָּֽנוּ</tei:l>
          <tei:l>וְעִם כׇּל יִשְׂרָאֵל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gebet_fur_den_regenten_miro/7"/>
        <tei:lg>
          <tei:l>בְּיָמָיו וּבְיָמֵֽינוּ</tei:l>
          <tei:l>תִּוָּשַׁע יְהוּדָה</tei:l>
          <tei:l>וְיִשְׂרָאֵל יִשְׁכּוֹן לָבֶטַח</tei:l>
          <tei:l>וּבָא לְצִיּוֹן גּוֹאֵל</tei:l>
          <tei:l>וְכֵן יְהִי רָצוֹן</tei:l>
          <tei:l>וָנֺאמַר אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
