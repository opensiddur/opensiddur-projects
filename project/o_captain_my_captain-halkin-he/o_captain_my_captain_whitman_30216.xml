      <tei:div corresp="urn:x-opensiddur:text:prayer:o_captain_my_captain_whitman_30216">
        <tei:head>הוֹ קְבַרְנִיט! קְבַרְנִיטִי!‏</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:o_captain_my_captain_whitman_30216/1"/>
        <tei:lg>
          <tei:l>הוֹ, קְבַרְנִיט! קְבַרְנִיטִי! מַסַּע־אֵימֵינוּ תַּם,</tei:l>
          <tei:l>נִצְּחָה כׇּל נֶגֶף הַסְּפִינָה, הַפְרָס שָׁרִיר, קַיָּם:</tei:l>
          <tei:l>קָרוֹב הַחוֹף, פַּעֲמוֹנִים, הָעָם כֻּלּוֹ עָלֵץ,</tei:l>
          <tei:l>עֵינַיִם מְלַוּוֹת אוֺן קֹעַר, עֹז סְפִינָה חוֹתֶרֶת;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:o_captain_my_captain_whitman_30216/2"/>
        <tei:lg>
          <tei:l>אַךְ הוֹ, לִבִּי! לִבִּי! לִבִּי!</tei:l>
          <tei:l>הוֹ, נִטְפֵי שָׁנִי שׁוֹתֵת,</tei:l>
          <tei:l>שָׁם קְבַרְנִיטִי עַל הַסִּפּוּן</tei:l>
          <tei:l>קַר נוֹפֵל וָמֵת.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:o_captain_my_captain_whitman_30216/3"/>
        <tei:lg>
          <tei:l>הוֹ, קְבַרְנִיט! קְבַרְנִיטִי! קוּם, שְׁמַע פַּעֲמוֹנִים;</tei:l>
          <tei:l>לְךָ פֹּרַשׂ הַנֵּם, תָּרִיעַ קֶרֶן שְׂשׂוֹנִים,</tei:l>
          <tei:l>לְךָ צְרוֹרֵי־פְּרָחִים, זֵרֵי־סְרָטִים, חוֹפִים צְפוּפִים,</tei:l>
          <tei:l>לְךָ יָרֹנּוּ בֶּהָמוֹן, פְּנֵיהֶם עֵרִים יָסֵבּוּ;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:o_captain_my_captain_whitman_30216/4"/>
        <tei:lg>
          <tei:l>קְבַרְנִיט! אָב יָקָר לִי!</tei:l>
          <tei:l>זְרוֹעִי רֹאשְׁךָ תְּרַפֵּד!</tei:l>
          <tei:l>חֲלוֹם הוּא זֶה עַל הַסִּפּוּן —</tei:l>
          <tei:l>נָפַלְתָּ קַר וָמֵת.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:o_captain_my_captain_whitman_30216/5"/>
        <tei:lg>
          <tei:l>לֹא יַעַן קְבַרְנִיטִי, חִוְרוֹת דְּמוּמוֹת שְׂפָתָיו,</tei:l>
          <tei:l>לֹא בִּזְרוֹעִי יָחוּשׁ אָבִי, לֹא דֹּפֶק בּוֹ וָצָו;</tei:l>
          <tei:l>עֻגְּנָה לָבֶטַח הַסְּפִינָה, מַסַּע־אֵימֶיהָ תַּם,</tei:l>
          <tei:l>מִדֶּרֶךְ נִצְחוֹנָהּ תָּבוֹא וְכׇל חֶפְצָהּ הָשְׁלַם;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:o_captain_my_captain_whitman_30216/6"/>
        <tei:lg>
          <tei:l>עִלְצוּ, חוֹפִים, פַּעֲמוֹנִים!</tei:l>
          <tei:l>אֲנִי אָבֵל צוֹעֵד</tei:l>
          <tei:l>עַל פְּנֵי סִפּוּן, שָׁם קְבַרְנִיטִי</tei:l>
          <tei:l>קַר נוֹפֵל וָמֵת.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
