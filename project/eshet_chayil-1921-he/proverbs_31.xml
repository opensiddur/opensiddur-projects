      <tei:div corresp="urn:x-opensiddur:text:bible:proverbs/31">
        <tei:head>אֵשֶׁת חַיִל</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/10/a"/>
        <tei:lg>
          <tei:l>אֵֽשֶׁת־חַ֭יִל מִ֣י יִמְצָ֑א</tei:l>
          <tei:l>וְרָחֹ֖ק מִפְּנִינִ֣ים מִכְרָֽהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/11/a"/>
        <tei:lg>
          <tei:l>בָּ֣טַח בָּ֭הּ לֵ֣ב בַּעְלָ֑הּ</tei:l>
          <tei:l>וְ֝שָׁלָ֗ל לֹ֣א יֶחְסָֽר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/12/a"/>
        <tei:lg>
          <tei:l>גְּמָלַ֣תְהוּ ט֣וֹב וְלֹא־רָ֑ע</tei:l>
          <tei:l>כֹּ֝֗ל יְמֵ֣י חַיֶּֽיהָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/13/a"/>
        <tei:lg>
          <tei:l>דָּ֭רְשָׁה צֶ֣מֶר וּפִשְׁתִּ֑ים</tei:l>
          <tei:l>וַ֝תַּ֗עַשׂ בְּחֵ֣פֶץ כַּפֶּֽיהָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/14/a"/>
        <tei:lg>
          <tei:l>הָ֭יְתָה כׇּאֳנִיּ֣וֹת סוֹחֵ֑ר</tei:l>
          <tei:l>מִ֝מֶּרְחָ֗ק תָּבִ֥יא לַחְמָֽהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/15/a"/>
        <tei:lg>
          <tei:l>וַתָּ֤קׇם ׀ בְּע֬וֹד לַ֗יְלָה וַתִּתֵּ֣ן טֶ֣רֶף לְבֵיתָ֑הּ</tei:l>
          <tei:l>וְ֝חֹ֗ק לְנַעֲרֹתֶֽיהָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/16/a"/>
        <tei:lg>
          <tei:l>זָֽמְמָ֣ה שָׂ֭דֶה וַתִּקָּחֵ֑הוּ</tei:l>
          <tei:l>מִפְּרִ֥י כַ֝פֶּ֗יהָ (נטע) [נָ֣טְעָה] כָּֽרֶם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>חָֽגְרָ֣ה בְע֣וֹז מׇתְנֶ֑יהָ</tei:l>
          <tei:l>וַ֝תְּאַמֵּ֗ץ זְרוֹעֹתֶֽיהָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/18/a"/>
        <tei:lg>
          <tei:l>טָ֭עֲמָה כִּי־ט֣וֹב סַחְרָ֑הּ</tei:l>
          <tei:l>לֹא־יִכְבֶּ֖ה (בליל) [בַלַּ֣יְלָה] נֵרָֽהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/19/a"/>
        <tei:lg>
          <tei:l>יָ֭דֶיהָ שִׁלְּחָ֣ה בַכִּישׁ֑וֹר</tei:l>
          <tei:l>וְ֝כַפֶּ֗יהָ תָּ֣מְכוּ פָֽלֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/20/a"/>
        <tei:lg>
          <tei:l>כַּ֭פָּהּ פָּֽרְשָׂ֣ה לֶעָנִ֑י</tei:l>
          <tei:l>וְ֝יָדֶ֗יהָ שִׁלְּחָ֥ה לָאֶבְיֽוֹן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/21/a"/>
        <tei:lg>
          <tei:l>לֹא־תִירָ֣א לְבֵיתָ֣הּ מִשָּׁ֑לֶג</tei:l>
          <tei:l>כִּ֥י כׇל־בֵּ֝יתָ֗הּ לָבֻ֥שׁ שָׁנִֽים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/22/a"/>
        <tei:lg>
          <tei:l>מַרְבַדִּ֥ים עָֽשְׂתָה־לָּ֑הּ</tei:l>
          <tei:l>שֵׁ֖שׁ וְאַרְגָּמָ֣ן לְבוּשָֽׁהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>נוֹדָ֣ע בַּשְּׁעָרִ֣ים בַּעְלָ֑הּ</tei:l>
          <tei:l>בְּ֝שִׁבְתּ֗וֹ עִם־זִקְנֵי־אָֽרֶץ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/24/a"/>
        <tei:lg>
          <tei:l>סָדִ֣ין עָ֭שְׂתָה וַתִּמְכֹּ֑ר</tei:l>
          <tei:l>וַ֝חֲג֗וֹר נָתְנָ֥ה לַֽכְּנַעֲנִֽי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/25/a"/>
        <tei:lg>
          <tei:l>עֹז־וְהָדָ֥ר לְבוּשָׁ֑הּ</tei:l>
          <tei:l>וַ֝תִּשְׂחַ֗ק לְי֣וֹם אַחֲרֽוֹן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/26/a"/>
        <tei:lg>
          <tei:l>פִּ֭יהָ פָּתְחָ֣ה בְחׇכְמָ֑ה</tei:l>
          <tei:l>וְת֥וֹרַת חֶ֝֗סֶד עַל־לְשׁוֹנָֽהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/27/a"/>
        <tei:lg>
          <tei:l>צ֭וֹפִיָּה (הילכת) [הֲלִיכ֣וֹת] בֵּיתָ֑הּ</tei:l>
          <tei:l>וְלֶ֥חֶם עַ֝צְל֗וּת לֹ֣א תֹאכֵֽל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>קָ֣מוּ בָ֭נֶיהָ וַֽיְאַשְּׁר֑וּהָ</tei:l>
          <tei:l>בַּ֝עְלָ֗הּ וַֽיְהַלְלָֽהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/29/a"/>
        <tei:lg>
          <tei:l>רַבּ֣וֹת בָּ֭נוֹת עָ֣שׂוּ חָ֑יִל</tei:l>
          <tei:l>וְ֝אַ֗תְּ עָלִ֥ית עַל־כֻּלָּֽנָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/30/a"/>
        <tei:lg>
          <tei:l>שֶׁ֣קֶר הַ֭חֵן וְהֶ֣בֶל הַיֹּ֑פִי</tei:l>
          <tei:l>אִשָּׁ֥ה יִרְאַת־יְ֝הֹוָ֗ה הִ֣יא תִתְהַלָּֽל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/31/a"/>
        <tei:lg>
          <tei:l>תְּנוּ־לָ֭הּ מִפְּרִ֣י יָדֶ֑יהָ</tei:l>
          <tei:l>וִיהַלְל֖וּהָ בַשְּׁעָרִ֣ים מַֽעֲשֶֽׂיהָ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
