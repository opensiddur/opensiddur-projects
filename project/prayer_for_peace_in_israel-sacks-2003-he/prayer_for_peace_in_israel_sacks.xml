  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_peace_in_israel_sacks">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_peace_in_israel_sacks/1"/>
        <tei:lg>
          <tei:l>רִבּוֹן הָעוֹלָמִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_peace_in_israel_sacks/2"/>
        <tei:lg>
          <tei:l>מֶלֶךְ שֶׁהַשָּׁלוֹם שֶׁלּוֹ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_peace_in_israel_sacks/4"/>
        <tei:lg>
          <tei:l>עוֹשֶׂה שָׁלוֹם בִּמְרוֹמָיו</tei:l>
          <tei:l>הוּא יַעֲשֶׂה שָׁלוֹם עָלֵינוּ וְעַל כׇּל יִשְׂרָאֵל וְעַל כׇּל יוֺשְׁבֵי תֵבֶל</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
