  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:blessing_over_the_lulav">
        <tei:head>Blessing Over the Lulav, a rhyming translation by Jessie Ethel Sampter (1919)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_over_the_lulav/1"/>
        <tei:lg>
          <tei:l>(Citron and willow branch and palm.</tei:l>
          <tei:l>And myrtle leaves for fragrant balm</tei:l>
          <tei:l>We wave and sway with praise and psalm.)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_over_the_lulav/2"/>
        <tei:lg>
          <tei:l>Blessed art thou, O God, our King,</tei:l>
          <tei:l>Lord of the world, who bade us bring</tei:l>
          <tei:l>The lulab’s harvest offering.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
