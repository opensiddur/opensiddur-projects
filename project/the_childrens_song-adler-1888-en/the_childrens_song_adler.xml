  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:the_childrens_song_adler">
        <tei:head>The Children's Song, a hymn by Felix Adler (1888)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_childrens_song_adler/1"/>
        <tei:lg>
          <tei:l>The Children’s Song</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_childrens_song_adler/2"/>
        <tei:lg>
          <tei:l>We hold our lives like lily flow’rs.</tei:l>
          <tei:l>May we be pure as they and white,</tei:l>
          <tei:l>May sunlight shine up on our hours,</tei:l>
          <tei:l>And we be sweet in all men’s sight;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_childrens_song_adler/3"/>
        <tei:lg>
          <tei:l>And when at last our winter nighs,</tei:l>
          <tei:l>Oh may on earth our seeds we strew,</tei:l>
          <tei:l>Which from the dust shall re-arise</tei:l>
          <tei:l>To bloom in other flow’rs anew.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
