    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_going_on_a_starship_voyage_mayer">
        <tei:head>תְּפִלַּת הַדֶּרֶךְ בָּאֳנִיַּת הַכּוֹכָבִים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_going_on_a_starship_voyage_mayer/1"/>
        <tei:lg>
          <tei:l>אָבִינוּ שֶׁבַּשָּׁמַֽיִם, רִבּוֹן כׇּל הָעוֹלָמִים,</tei:l>
          <tei:l>מוֹנֶ֣ה מִ֭סְפָּר לַכּוֹכָבִ֑ים לְ֝כֻלָּ֗ם שֵׁמ֥וֹת יִקְרָֽא,</tei:l>
          <tei:l>הִנְנִי מוּכָן לַעֲלוֹת בְּאֳנִיַּת הַכּוֹכָבִים.</tei:l>
          <tei:l>גָּלֽוּי וְיָדֽוּעַ לְפָנֶֽיךָ,</tei:l>
          <tei:l>נוֹטֶ֣ה שָׁמַיִם֮ וְיֹסֵ֣ד אָרֶץ֒,</tei:l>
          <tei:l>שֶׁאֵין אֲנַֽחְנוּ מַפְסִיקִים לִנְסֹֽעַ וְלָנֽוּעַ בְּחָלָל הָאַֽיִן</tei:l>
          <tei:l>אִֽלּוּ שָׁם נָסַֽעְנוּ בִּלְעָדֶֽיךָ,</tei:l>
          <tei:l>כִּי עַל בָּמוֹתֵֽיךָ מַדְרִיכֵֽנוּ אָֽתָּה,</tei:l>
          <tei:l>כִּי אֵל שׁוֹמֵר אֶת נֶֽפֶשׁ־כׇּל־חָי אָֽתָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_going_on_a_starship_voyage_mayer/2"/>
        <tei:lg>
          <tei:l>וּבְכֵן,</tei:l>
          <tei:l>יְהִי רָצוֹן מִלְפָנֶֽיךָ,</tei:l>
          <tei:l>יהוה אֱלֹהֵֽינוּ וֵאלֹהֵֽי אֲבוֹתֵֽינוּ,</tei:l>
          <tei:l>שֶׁתַּעֲלֵֽינוּ בְּשָׁלוֹם וְתִּמְשְׁכֵֽינוּ בְּשָׁלוֹם</tei:l>
          <tei:l>וְתַגִּיעֵֽנוּ לִמְקוֹם נְחִיתָתֵֽנוּ</tei:l>
          <tei:l>בְחַיִּים וּבְשִׂמְחָה וּבְשָׁלוֹם,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_going_on_a_starship_voyage_mayer/3"/>
        <tei:lg>
          <tei:l>וְתַצִּילֵֽנוּ מִכׇּל־צָרָה וְסַכָּנָה,</tei:l>
          <tei:l>מֵחוּצָנִים רָעִים וּמִיֵּשֻׁיּוֹת רָעוֹת,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_going_on_a_starship_voyage_mayer/4"/>
        <tei:lg>
          <tei:l>וְתִשְׁלַח בְּרָכָה וְהַצְלָחָה</tei:l>
          <tei:l>בְּכׇל־מַעֲשֵׂה יָדֵֽינוּ,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_going_on_a_starship_voyage_mayer/5"/>
        <tei:lg>
          <tei:l>וְתִתְּנֵֽנוּ לְחֵן וּלְחֶֽסֶד וּלְרַחֲמִים</tei:l>
          <tei:l>בְּעֵינֶֽיךָ וּבְעֵינֵי כׇל־רֹאֵֽינוּ,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_going_on_a_starship_voyage_mayer/6"/>
        <tei:lg>
          <tei:l>וְתִשְׁמַע קוֹל תַּחֲנוּנֵֽינוּ.</tei:l>
          <tei:l>כִּי אל שׁוֹמֵֽעַ תְּפִלָּה וְתַחֲנוּן אָֽתָּה.</tei:l>
          <tei:l>בָּרוּךְ אַתָּה שׁוֹמֵעַ תְּפִלָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_going_on_a_starship_voyage_mayer/7"/>
        <tei:lg>
          <tei:l>יוֹמָ֗ם הַשֶּׁ֥מֶשׁ לֹֽא־יַכֶּ֗כָּה</tei:l>
          <tei:l>וְיָרֵ֥חַ בַּלָּֽיְלָה׃</tei:l>
          <tei:l>
            <tei:note type="instruction">(ג׳ פעמים)</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_going_on_a_starship_voyage_mayer/8"/>
        <tei:lg>
          <tei:l>יְֽהוָ֗ה יִשְׁמָרְךָ֥ מִכׇּל־רָ֑ע</tei:l>
          <tei:l>יִ֝שְׁמֹ֗ר אֶת־נַפְשֶֽׁךָ׃</tei:l>
          <tei:l>
            <tei:note type="instruction">(ג׳ פעמים)</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_going_on_a_starship_voyage_mayer/9"/>
        <tei:lg>
          <tei:l>יְֽהוָ֗ה יִשְׁמׇר־צֵאתְךָ֥ וּבוֹאֶ֑ךָ</tei:l>
          <tei:l>מֵֽ֝עַתָּ֗ה וְעַד־עוֹלָֽם׃ <tei:bibl>(תהלים קכא:ו-ח)</tei:bibl></tei:l>
          <tei:l>
            <tei:note type="instruction">(ג׳ פעמים)</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_going_on_a_starship_voyage_mayer/10"/>
        <tei:lg>
          <tei:l>וַיֵּצֵ֥א יַעֲקֹ֖ב מִבְּאֵ֣ר שָׁ֑בַע וַיֵּ֖לֶךְ חָרָֽנָה׃ וַיִּפְגַּ֨ע בַּמָּק֜וֹם וַיָּ֤לֶן שָׁם֙ כִּי־בָ֣א הַשֶּׁ֔מֶשׁ וַיִּקַּח֙ מֵאַבְנֵ֣י הַמָּק֔וֹם וַיָּ֖שֶׂם מְרַֽאֲשֹׁתָ֑יו וַיִּשְׁכַּ֖ב בַּמָּק֥וֹם הַהֽוּא׃ וַֽיַּחֲלֹ֗ם וְהִנֵּ֤ה סֻלָּם֙ מֻצָּ֣ב אַ֔רְצָה וְרֹאשׁ֖וֹ מַגִּ֣יעַ הַשָּׁמָ֑יְמָה וְהִנֵּה֙ מַלְאֲכֵ֣י אֱלֹהִ֔ים עֹלִ֥ים וְיֹרְדִ֖ים בּֽוֹ׃ וְהִנֵּ֨ה יְהוָ֜ה נִצָּ֣ב עָלָיו֮ וַיֹּאמַר֒ אֲנִ֣י יְהוָ֗ה אֱלֹהֵי֙ אַבְרָהָ֣ם אָבִ֔יךָ וֵאלֹהֵ֖י יִצְחָ֑ק הָאָ֗רֶץ אֲשֶׁ֤ר אַתָּה֙ שֹׁכֵ֣ב עָלֶ֔יהָ לְךָ֥ אֶתְּנֶ֖נָּה וּלְזַרְעֶֽךָ׃ וְהָיָ֤ה זַרְעֲךָ֙ כַּעֲפַ֣ר הָאָ֔רֶץ וּפָרַצְתָּ֛ יָ֥מָּה וָקֵ֖דְמָה וְצָפֹ֣נָה וָנֶ֑גְבָּה וְנִבְרֲכ֥וּ בְךָ֛ כָּל־מִשְׁפְּחֹ֥ת הָאֲדָמָ֖ה וּבְזַרְעֶֽךָ׃ וְהִנֵּ֨ה אָנֹכִ֜י עִמָּ֗ךְ וּשְׁמַרְתִּ֙יךָ֙ בְּכֹ֣ל אֲשֶׁר־תֵּלֵ֔ךְ וַהֲשִׁ֣בֹתִ֔יךָ אֶל־הָאֲדָמָ֖ה הַזֹּ֑את כִּ֚י לֹ֣א אֶֽעֱזָבְךָ֔ עַ֚ד אֲשֶׁ֣ר אִם־עָשִׂ֔יתִי אֵ֥ת אֲשֶׁר־דִּבַּ֖רְתִּי לָֽךְ׃ וַיִּיקַ֣ץ יַעֲקֹב֮ מִשְּׁנָתוֹ֒ וַיֹּ֕אמֶר אָכֵן֙ יֵ֣שׁ יְהוָ֔ה בַּמָּק֖וֹם הַזֶּ֑ה וְאָנֹכִ֖י לֹ֥א יָדָֽעְתִּי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_going_on_a_starship_voyage_mayer/11"/>
        <tei:lg>
          <tei:l>וַיִּירָא֙ וַיֹּאמַ֔ר</tei:l>
          <tei:l>מַה־נּוֹרָ֖א הַמָּק֣וֹם הַזֶּ֑ה</tei:l>
          <tei:l>אֵ֣ין זֶ֗ה כִּ֚י אִם־בֵּ֣ית אֱלֹהִ֔ים</tei:l>
          <tei:l>וְזֶ֖ה שַׁ֥עַר הַשָּׁמָֽיִם׃ <tei:bibl>(בראשית כח:יז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_going_on_a_starship_voyage_mayer/12"/>
        <tei:lg>
          <tei:l>לֵ֣ית דֵּ֗ין</tei:l>
          <tei:l>אֲתַר֙ הֶדְי֣וֹט אֶלָהֵ֔ין</tei:l>
          <tei:l>אֲתַר֙ דְּרַעֲוָא־בֵ֣הּ מִן־קֳדָם־יְ֔יָ</tei:l>
          <tei:l>וְדֵ֖ין תְּרַ֥ע קֳבֵל־שְׁמַיָּֽא׃ <tei:bibl>(תרגום בראשית כח:יז)</tei:bibl></tei:l>
          <tei:l>
            <tei:note type="instruction">(ג׳ פעמים)</tei:note>
          </tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
