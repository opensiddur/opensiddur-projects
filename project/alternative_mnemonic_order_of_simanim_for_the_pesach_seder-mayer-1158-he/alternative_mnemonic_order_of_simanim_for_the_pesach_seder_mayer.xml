  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:alternative_mnemonic_order_of_simanim_for_the_pesach_seder_mayer">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:alternative_mnemonic_order_of_simanim_for_the_pesach_seder_mayer/1"/>
        <tei:lg>
          <tei:l>קְדֻשָּׁה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:alternative_mnemonic_order_of_simanim_for_the_pesach_seder_mayer/2"/>
        <tei:lg>
          <tei:l>נְטִילָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:alternative_mnemonic_order_of_simanim_for_the_pesach_seder_mayer/3"/>
        <tei:lg>
          <tei:l>יְרוֹקִים לַאֲכִילָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:alternative_mnemonic_order_of_simanim_for_the_pesach_seder_mayer/4"/>
        <tei:lg>
          <tei:l>נִמְזָג כּוֹס</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:alternative_mnemonic_order_of_simanim_for_the_pesach_seder_mayer/5"/>
        <tei:lg>
          <tei:l>נִשְׁתַּנָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:alternative_mnemonic_order_of_simanim_for_the_pesach_seder_mayer/6"/>
        <tei:lg>
          <tei:l>מֵהַגְּנוּת בִּתְחִלָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:alternative_mnemonic_order_of_simanim_for_the_pesach_seder_mayer/7"/>
        <tei:lg>
          <tei:l>מְסַיְּמִים בִּגְדֻלָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:alternative_mnemonic_order_of_simanim_for_the_pesach_seder_mayer/8"/>
        <tei:lg>
          <tei:l>שְׁנֵי מִזְמוֹרֵי תְּהִלָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:alternative_mnemonic_order_of_simanim_for_the_pesach_seder_mayer/9"/>
        <tei:lg>
          <tei:l>כּוֹס שֵׁנִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:alternative_mnemonic_order_of_simanim_for_the_pesach_seder_mayer/10"/>
        <tei:lg>
          <tei:l>גְּאֻלָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:alternative_mnemonic_order_of_simanim_for_the_pesach_seder_mayer/11"/>
        <tei:lg>
          <tei:l>עוֹד פַּֽעַם נְטִילָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:alternative_mnemonic_order_of_simanim_for_the_pesach_seder_mayer/12"/>
        <tei:lg>
          <tei:l>מַצָּה נִשְׁבְּרָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:alternative_mnemonic_order_of_simanim_for_the_pesach_seder_mayer/13"/>
        <tei:lg>
          <tei:l>כִּכָּר וָחֵֽצִי הַבְּרָכָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:alternative_mnemonic_order_of_simanim_for_the_pesach_seder_mayer/14"/>
        <tei:lg>
          <tei:l>מָרוֹר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:alternative_mnemonic_order_of_simanim_for_the_pesach_seder_mayer/15"/>
        <tei:lg>
          <tei:l>כְּרִיכָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:alternative_mnemonic_order_of_simanim_for_the_pesach_seder_mayer/16"/>
        <tei:lg>
          <tei:l>וְעַד כֵּן הַסְּעוּדָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:alternative_mnemonic_order_of_simanim_for_the_pesach_seder_mayer/17"/>
        <tei:lg>
          <tei:l>מַצָּה אַחֲרוֹנָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:alternative_mnemonic_order_of_simanim_for_the_pesach_seder_mayer/18"/>
        <tei:lg>
          <tei:l>כּוֹס שְׁלִישִׁי לִבְרָכָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:alternative_mnemonic_order_of_simanim_for_the_pesach_seder_mayer/19"/>
        <tei:lg>
          <tei:l>הַלֵּל הַלְלוּ־יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:alternative_mnemonic_order_of_simanim_for_the_pesach_seder_mayer/20"/>
        <tei:lg>
          <tei:l>בִּרְכַּת הַשִּׁיר נִבְרְכָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:alternative_mnemonic_order_of_simanim_for_the_pesach_seder_mayer/21"/>
        <tei:lg>
          <tei:l>רְבִיעִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:alternative_mnemonic_order_of_simanim_for_the_pesach_seder_mayer/22"/>
        <tei:lg>
          <tei:l>הוֹדָיָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:alternative_mnemonic_order_of_simanim_for_the_pesach_seder_mayer/23"/>
        <tei:lg>
          <tei:l>עַד סִיּוּם הַסִּדְרָה׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
