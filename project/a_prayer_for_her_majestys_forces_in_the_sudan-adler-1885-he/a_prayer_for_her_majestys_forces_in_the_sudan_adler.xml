    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_prayer_for_her_majestys_forces_in_the_sudan_adler">
        <tei:head>תְּפִלָּה לְהַצְלָחַת חַיִל הַמַּלְכָּה בְּאֶרֶץ כּוּשׁ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_her_majestys_forces_in_the_sudan_adler/1"/>
        <tei:lg>
          <tei:l>יְיָ אֱלֹהֵי הַצְּבָאוֹת</tei:l>
          <tei:l>עָדֶיךָ נָבֹאָה הַיּוֹם</tei:l>
          <tei:l>לְהִתְחַנֵּן עַל הָאֲנָשִׁים אַנְשֵׁי חַיִל</tei:l>
          <tei:l>הָעוֹבְרִים אָרְחוֹת יַמִּים וּמִדְבָּרוֹת</tei:l>
          <tei:l>חֲלוּצֵי צָבָא לַמִּלְחָמָה בְּאֶרֶץ מֶרְחָק</tei:l>
          <tei:l>נֶאֱמָנִים בִּמְלַאכְתָּם לַעֲשׂוֹת אֶת מִצְוַת הַמַּלְכָּה</tei:l>
          <tei:l>וְשָׂרֶיהָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_her_majestys_forces_in_the_sudan_adler/2"/>
        <tei:lg>
          <tei:l>אָנָּא שְׁמוֹר</tei:l>
          <tei:l>צֵאתָם וּבוֹאָם</tei:l>
          <tei:l>הַצִּילֵם מִכׇּל רָע</tei:l>
          <tei:l>הָסֵר מִהֶם כׇּל נֶגַע וְכׇל מַחֲלָה</tei:l>
          <tei:l>יוֹמָם הַשֶּׁמֶשׁ אַל יַכֵּם</tei:l>
          <tei:l>וְקֶרַח בַּלַּיְלָה</tei:l>
          <tei:l>סֹךְ לְרֹאשָׁם בְּיוֹם נֶשֶׁק</tei:l>
          <tei:l>הַלְבִּישֵׁם תְּשׁוּעָה</tei:l>
          <tei:l>וַתִּיקַר נַפְשָׁם בְּעֵינֶיךָ׃</tei:l>
          <tei:l>הוֹרֵה אֶת שָׂרֵי הַצָּבָא</tei:l>
          <tei:l>אֶת הַדֶּרֶךְ יֵלְכוּ בָהּ</tei:l>
          <tei:l>וְאֶת הַמַּעֲשֶׂה אֲשֶׁר יַעֲשׂוּן</tei:l>
          <tei:l>לְמַעַן תִּשְׁקוֹט הָאָרֶץ מִמִּלְחָמָה</tei:l>
          <tei:l>וְלֹא יִשָּׁמַע בָּה עוֹד חָמָם</tei:l>
          <tei:l>וְלֹא יִהְיֶה עוֹד שֹׁד וָשֶׁבֶר בִּגְבוּלֶיהָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_her_majestys_forces_in_the_sudan_adler/3"/>
        <tei:lg>
          <tei:l>רָם עַל רָמִים</tei:l>
          <tei:l>בָּרֵךְ אֶת הַמַּלְכָּה אֵם אַרְצֵנוּ</tei:l>
          <tei:l>חֹן אֶת יוֹעֲצֶיהָ מֵאִתְּךָ רוּחַ חָכְמָה וּבִינָה</tei:l>
          <tei:l>רוּחַ עֵצָה וּגְבוּרָה</tei:l>
          <tei:l>וּבְהִתְאַסֵּף יַחַד שָׂרֵי הַמְּדִינָה</tei:l>
          <tei:l>וּבְחִירֶיהָ</tei:l>
          <tei:l>יְהִי נוֹעַמְךָ עֲלֵיהֶם</tei:l>
          <tei:l>וּמַעֲשֵׂה יְדֵיהֶם כּוֹנֲנֵהוּ׃</tei:l>
          <tei:l>שְׁפוֹת שַׁלְוָה וָשׂוֹבַע לְכׇל מַמְלֶכֶת בְּרִיטַנְיַא</tei:l>
          <tei:l>אֵין פֶּרֶץ וְאֵין יוֹצֵאת</tei:l>
          <tei:l>וְאֵין צְוָחָה בִּרְחוֹבוֹת קִרְיוֹתֶיהָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_her_majestys_forces_in_the_sudan_adler/4"/>
        <tei:lg>
          <tei:l>קָרֵב הַָיָּמִים</tei:l>
          <tei:l>אֲשֶׁר יִפְרַח רֹב שָלוֹם בָּהֶם</tei:l>
          <tei:l>עַל פְּנֵי תֵבֵל</tei:l>
          <tei:l>וּמָלְאָה הָאָרֶץ</tei:l>
          <tei:l>אַהֲבָה וְאַחֲוָה</tei:l>
          <tei:l>וְדַעַת אוֹתְךָ חֵי הָעוֹלָמִים</tei:l>
          <tei:l>אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
