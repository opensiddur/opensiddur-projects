  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:al_hanissim_on_yom_haatsmaut_amir">
        <tei:head>על הניסים ביום העצמאות</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:al_hanissim_on_yom_haatsmaut_amir/1"/>
        <tei:lg>
          <tei:l>עַל נֵס תְּחִיָּתֵנוּ</tei:l>
          <tei:l>וּבִנְיַן חַיֵּינוּ</tei:l>
          <tei:l>הַמְחֻדָּשׁ בְּמוֹלַדְתֵּנוּ,</tei:l>
          <tei:l>בֵּית חַיֵּינוּ,</tei:l>
          <tei:l>אַחֲרֵי אַלְפֵי שְׁנוֹת גָּלוּת;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:al_hanissim_on_yom_haatsmaut_amir/2"/>
        <tei:lg>
          <tei:l>עַל תַּעֲצוּמוֹת נֶפֶשׁ</tei:l>
          <tei:l>שֶׁל עַם שֶׁקָּם</tei:l>
          <tei:l>מִתְּהוֹמוֹת וְהֶעְפִּיל</tei:l>
          <tei:l>אֶל תְּקוּמָה וְעַצְמָאוּת,</tei:l>
          <tei:l>הֲגָנָה וּבִנְיָן;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:al_hanissim_on_yom_haatsmaut_amir/3"/>
        <tei:lg>
          <tei:l>עַל גְּבוּרַת לוֹחֲמִים</tei:l>
          <tei:l>שֶׁחֵרְפוּ נַפְשָׁם</tei:l>
          <tei:l>וְצִוּוּ חַיִּים,</tei:l>
          <tei:l>פְּרִיחָה וִיצִירָה;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:al_hanissim_on_yom_haatsmaut_amir/4"/>
        <tei:lg>
          <tei:l>עַל קִבּוּץ גָּלוּיוֹת</tei:l>
          <tei:l>מֵאַרְבַּע כַּנְפוֹת הָאָרֶץ</tei:l>
          <tei:l>וְעַל עֹשֶׁר הָעֵדוֹת וְהַשְּׁבָטִים,</tei:l>
          <tei:l>הָאֱמוּנוֹת וְהַדֵּעוֹת,</tei:l>
          <tei:l>הַמָּסוֹרוֹת וְהַתְּפִלּוֹת;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:al_hanissim_on_yom_haatsmaut_amir/5"/>
        <tei:lg>
          <tei:l>עַל עֹז הָרוּחַ</tei:l>
          <tei:l>לְהַצְהִיר בִּפְנֵי עַם וְעוֹלָם</tei:l>
          <tei:l>שֶׁנַּשְׁתִּית חַיֵּינוּ</tei:l>
          <tei:l>עַל יְסוֹדוֹת הַחֵרוּת</tei:l>
          <tei:l>הַצֶּדֶק וְהַשָּׁלוֹם,</tei:l>
          <tei:l>לְאוֹר חֲזוֹנָם</tei:l>
          <tei:l>שֶׁל נְבִיאֵי יִשְׂרָאֵל;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:al_hanissim_on_yom_haatsmaut_amir/6"/>
        <tei:lg>
          <tei:l>עַל הָאֱמוּנָה וְהַתִּקְוָה,</tei:l>
          <tei:l>עַל הַשְּׁאִיפָה לְשָׁלוֹם</tei:l>
          <tei:l>בֵּין בְּנֵי שָׂרָה לִבְנֵי הָגָר,</tei:l>
          <tei:l>וְעַל כִּסּוּפֵי הַגְּאֻלָּה הַמְּפַעֲמִים בָּנוּ</tei:l>
          <tei:l>וּמְכוֹנְנִים מִצְעָדֵנוּ.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
