  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:mah_tovu">
        <tei:head>מַה־טֹּבוּ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mah_tovu/mah_tovu-varani"/>
        <tei:lg>
          <tei:l>מַה־טֹּבֽוּ אֹהָלֶֽיךָ יַעֲקֹב,</tei:l>
          <tei:l>מִשְׁכְּנֹתֶֽיךָ, יִשְׂרָאֵל׃ <tei:bibl>(במדבר כד:ה)</tei:bibl></tei:l>
          <tei:l>וַֽאֲנִי, בְּרֹב חַסְדְּךָ, אָבֹא בֵיתֶֽךָ,</tei:l>
          <tei:l>אֶשְׁתַּֽחֲוֶה אֶל־הֵיכַל קָדְשְׁךָ, בְּיִרְאָתֶֽךָ׃ <tei:bibl>(תהלים ה:ח)</tei:bibl></tei:l>
          <tei:l>יְהֹוָה, אָהַבְתִּי מְעוֹן בֵּיתֶֽךָ, וּמְקוֹם, מִשְׁכַּן</tei:l>
          <tei:l>כְּבוֹדֶֽךָ׃ <tei:bibl>(תהלים כו:ח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וַֽאֲנִי אֶשְׁתַּחֲוֶה וְאֶכְרָֽעָה,</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>אֶבְרְכָה לִפְנֵי־יְהֹוָה</tei:l>
          <tei:l>עֹשִׂי׃ <tei:bibl>(תהלים צה:ו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וַֽאֲנִי תְפִילָתִי־לְךָ ׀ יְהֹוָה עֵת רָצוֹן.</tei:l>
          <tei:l>אֱלֹהִים, בְּרָב־חַסְדֶּךָ,</tei:l>
          <tei:l>עֲנֵֽנִי בֶּאֱמֶת</tei:l>
          <tei:l>יִשְׁעֶֽךָ׃ <tei:bibl>(תהלים סט:יד)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
