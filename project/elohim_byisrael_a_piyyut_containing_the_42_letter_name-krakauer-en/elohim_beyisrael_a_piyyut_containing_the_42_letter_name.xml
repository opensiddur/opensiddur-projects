    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:elohim_beyisrael_a_piyyut_containing_the_42_letter_name">
        <tei:head>Elohim b'Yisrael :: A piyyuṭ containing the 42 Letter Name, recorded in Sefer haPeliah</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_beyisrael_a_piyyut_containing_the_42_letter_name/1"/>
        <tei:lg>
          <tei:l>Elohim in Yisrael,</tei:l>
          <tei:l>Great is your unity —</tei:l>
          <tei:l>May your righteousness uplift us!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_beyisrael_a_piyyut_containing_the_42_letter_name/2"/>
        <tei:lg>
          <tei:l>Holy One</tei:l>
          <tei:l>Perceive the conspiracies of our adversaries;</tei:l>
          <tei:l>Purify your heritage!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_beyisrael_a_piyyut_containing_the_42_letter_name/3"/>
        <tei:lg>
          <tei:l>Exalted one, redeem those who seek you,</tei:l>
          <tei:l>Sustain the power of your Names!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_beyisrael_a_piyyut_containing_the_42_letter_name/4"/>
        <tei:lg>
          <tei:l>In your Name’s sake our spirits celebrate;</tei:l>
          <tei:l>Bring the Branch of our redemption!<tei:anchor xml:id="note_1"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_beyisrael_a_piyyut_containing_the_42_letter_name/5"/>
        <tei:lg>
          <tei:l>Holy Pious One,</tei:l>
          <tei:l>With all your beneficence</tei:l>
          <tei:l>Adorn your modesty.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_beyisrael_a_piyyut_containing_the_42_letter_name/6"/>
        <tei:lg>
          <tei:l>May we exclaim (your) greatness from our hearts —</tei:l>
          <tei:l>Redeem us! Recollect your sanctification.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_beyisrael_a_piyyut_containing_the_42_letter_name/7"/>
        <tei:lg>
          <tei:l>Attend to the call of our confession,</tei:l>
          <tei:l>Justify those who know your praises.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
