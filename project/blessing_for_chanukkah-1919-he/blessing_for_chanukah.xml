  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:blessing_for_chanukah">
        <tei:head>לְהַדְלִיק נֵר שֶׁל חֲנֻכָּה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hadlakat_ner_chanukah/blessing"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם</tei:l>
          <tei:l>אֲשֶׁר קִדְּשָׁנוּ בְּמִצְוֺתָיו</tei:l>
          <tei:l>וְצִוָּנוּ</tei:l>
          <tei:l>לְהַדְלִיק נֵר שֶׁל חֲנֻכָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:sheasah_nissim"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם</tei:l>
          <tei:l>שֶׁעָשָׂה נִסִּים לַאֲבוֹתֵינוּ</tei:l>
          <tei:l>בַּיָּמִים הָהֵם בַּזְּמַן הַזֶּה׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
