    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yedid_nefesh">
        <tei:head>יְדִיד נֶפֶשׁ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yedid_nefesh/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יְ</tei:seg>דִיד נֶֽפֶשׁ</tei:l>
          <tei:l>אָב הָרַחֲמָן,</tei:l>
          <tei:l>מְשׁוֹךְ עַבְדְּךְ אֶל־רְצוֹנֶֽךָ,</tei:l>
          <tei:l>יָרוּץ עַבְדְּךָ כְּמוֹ אַיָּל,</tei:l>
          <tei:l>יִשְׁתַּחֲוֶה</tei:l>
          <tei:l>אֶל מוּל הֲדָרֶֽךָ,</tei:l>
          <tei:l>יֶעֱרַב לוֹ</tei:l>
          <tei:l>יְדִידוּתֶֽיךָ,</tei:l>
          <tei:l>מִנֹּֽפֶת צוּף</tei:l>
          <tei:l>וְכׇל־טָֽעַם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yedid_nefesh/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הָ</tei:seg>דוּר נָאֶה זִיו</tei:l>
          <tei:l>הָעוֹלָם,</tei:l>
          <tei:l>נַפְשִׁי חוֹלַת</tei:l>
          <tei:l>אַהֲבָתֶֽךָ,</tei:l>
          <tei:l>אָנָּא אֵל־נָא רְפָא נָא לָהּ,</tei:l>
          <tei:l>בְּהַרְאוֹת לָהּ</tei:l>
          <tei:l>נֹֽעַם זִיוֶֽךָ,</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>אָז תִּתְחַזֵּק</tei:l>
          <tei:l>וְתִתְרַפֵּא,</tei:l>
          <tei:l>וְהָֽיְתָה לָּהּ</tei:l>
          <tei:l>שִׂמְחַת עוֹלָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yedid_nefesh/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וָ</tei:seg>תִיק יֶהֱמוּ</tei:l>
          <tei:l>רַחֲמֶֽיךָ,</tei:l>
          <tei:l>וְחוּסָה נָּא</tei:l>
          <tei:l>עַל בֵּן אֲהוּבֶֽךָ,</tei:l>
          <tei:l>כִּי־זֶה כַּמָּה</tei:l>
          <tei:l>נִכְסוֹף נִכְסַֽפְתִּי,</tei:l>
          <tei:l>לִרְאוֹת בְּתִפְאֶֽרֶת</tei:l>
          <tei:l>עֻזֶּֽךָ,</tei:l>
          <tei:l>אֵֽלֶּה חָמְדָה</tei:l>
          <tei:l>לִבִּי,</tei:l>
          <tei:l>וְחֽוּסָה נָּא</tei:l>
          <tei:l>וְאַל תִּתְעַלָּם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yedid_nefesh/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הִ</tei:seg>גָּלֶה נָא וּפְרוֹס חָבִיבִי עָלַי</tei:l>
          <tei:l>אֶת־סֻכַּת שְׁלוֹמֶֽךָ,</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>תָּאִיר אֶֽרֶץ מִכְּבוֹדֶֽךָ,</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>נָגִֽילָה וְנִשְׂמְחָה בָּךְ,</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>מַהֵר</tei:l>
          <tei:l>אָהוּב כִּי בָא מוֹעֵד,</tei:l>
          <tei:l>וְחָנֵּֽנוּ</tei:l>
          <tei:l>כִּימֵי עוֹלָם׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
