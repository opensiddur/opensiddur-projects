      <tei:div corresp="urn:x-opensiddur:text:poem:el_qol_demama_mayer">
        <tei:head>אֵל קוֹל דְּמָמָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_qol_demama_mayer/1"/>
        <tei:lg>
          <tei:l>אֵל קוֹל דְּמָמָה</tei:l>
          <tei:l>אֵל קוֹל דְּמָמָה</tei:l>
          <tei:l>הַמְצִיא לָֽנוּ נֶחָמָה</tei:l>
          <tei:l>בִּנְעִילַת יוֹם שַׁמָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_qol_demama_mayer/2"/>
        <tei:lg>
          <tei:l>יְׄלָלוֹת יִלַּֽלְנוּ</tei:l>
          <tei:l>בְּיָגוֹן אֻמְלַֽלְנוּ</tei:l>
          <tei:l>צׄוֹם הַקְּהִלָּה צָמָה</tei:l>
          <tei:l>בִּנְעִילַת יוֹם שַׁמָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_qol_demama_mayer/3"/>
        <tei:lg>
          <tei:l>חָׄרְפֽוּנוּ אוֹיְבֵי שָׁלוֹם</tei:l>
          <tei:l>מִיּוֹם אֵידֵֽנוּ עַד־הֲלֹם</tei:l>
          <tei:l>קָׄרֵב־נָא עֵת נְקָמָה</tei:l>
          <tei:l>בִּנְעִילַת יוֹם שַׁמָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_qol_demama_mayer/4"/>
        <tei:lg>
          <tei:l>הֲׄלֹא אַתָּה אֱלוֹהַּ</tei:l>
          <tei:l>מַצִּיל מִשּׁוֹאָה וּמְשׁוֹאָה</tei:l>
          <tei:l>רַׄחֵם עַל־כׇּל־נְשָׁמָה</tei:l>
          <tei:l>בִּנְעִילַת יוֹם שַׁמָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_qol_demama_mayer/5"/>
        <tei:lg>
          <tei:l>אֶׄת־שְׁבוּעָתְךָ תְּקַיֵּם</tei:l>
          <tei:l>כֹּה גָּלוּתֵֽנוּ תִּסְתַּיֵּם</tei:l>
          <tei:l>לְׄקַבְּצֵֽנוּ עַל־הָאֲדָמָה</tei:l>
          <tei:l>בִּנְעִילַת יוֹם שַׁמָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_qol_demama_mayer/6"/>
        <tei:lg>
          <tei:l>חַׄדֵּשׁ מִדְבָּר כְּעֵֽדֶן</tei:l>
          <tei:l>וְנַעֲבֹר בַּיַּרְדֵּן</tei:l>
          <tei:l>זַׄכֵּֽנוּ לִרְאוֹת שָֽׁמָּה</tei:l>
          <tei:l>בִּנְעִילַת יוֹם שַׁמָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_qol_demama_mayer/7"/>
        <tei:lg>
          <tei:l>קֵׄץ יְמֵי עׇנְיֵֽנוּ</tei:l>
          <tei:l>יָבוֹא מִמֶּֽךָ עָלֵֽינוּ</tei:l>
          <tei:l>אׄוֹחִיל לְךָ כׇּל־יְמָמָה</tei:l>
          <tei:l>בִּנְעִילַת יוֹם שַׁמָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_qol_demama_mayer/8"/>
        <tei:lg>
          <tei:l>מִׄן־הַמֵּצַר תַּעֲלֵנוּ</tei:l>
          <tei:l>תַּהֲפֹךְ לְשִׂמְחָה צוֹמֵנוּ</tei:l>
          <tei:l>נֶׄהֱוֵי בָּתְרָא כְּקַמָּא</tei:l>
          <tei:l>בִּנְעִילַת יוֹם שַׁמָּה׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
