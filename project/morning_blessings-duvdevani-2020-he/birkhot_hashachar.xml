  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:birkhot_hashachar">
        <tei:head>ברכות השחר</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkhot_hashachar/gomel_chasadim-zoqef_kefufim"/>
        <tei:lg>
          <tei:l>בְּרוּכָה אַתְּ יָהּ מְקוֹר הַחַיִּים,</tei:l>
          <tei:l>בּוֹרֵאת אוֹר וּמַרְחֶקֶת חֹשֶׁךְ,</tei:l>
          <tei:l>הַפּוֹרֶשֶׂת אֲרָצוֹת וּפוֹתַחַת דְּרָכִים.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בְּרוּכָה אַתְּ יָהּ מְקוֹר הַחַיִּים,</tei:l>
          <tei:l>יוֹצֶרֶת הָאָדָם בִּתְבוּנָה,</tei:l>
          <tei:l>נוֹתֶנֶת בּוֹ נְקָבִים נְקָבִים חֲלוּלִים חֲלוּלִים</tei:l>
          <tei:l>וְנוֹפַחַת רוּחַ אֱלֹהִים לְנַגֵּן בָּם.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בְּרוּכָה אַתְּ יָהּ מְקוֹר הַחַיִּים,</tei:l>
          <tei:l>שֶׁעֲשִׂיתִינִי בְּצַלְמֵךְ,</tei:l>
          <tei:l>שֶׁעֲשִׂיתִינִי בַּת־חוֹרִין,</tei:l>
          <tei:l>שֶׁעֲשִׂיתִינִי אֲנִי.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בְּרוּכָה אַתְּ יָהּ, אִמִּי,</tei:l>
          <tei:l>אֵם כָּל חַי הַפּוֹרֶשֶׂת עָלַי כְּנָפֵךְ –</tei:l>
          <tei:l>הֲיִי לִי מַחֲסֶה וְאֹהֶל,</tei:l>
          <tei:l>תְּנִי לַיָּעֵף כֹּחַ.</tei:l>
        </tei:lg>
