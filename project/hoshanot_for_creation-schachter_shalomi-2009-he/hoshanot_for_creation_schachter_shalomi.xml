  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hoshanot_for_creation_schachter_shalomi">
        <tei:head>הושׁענות</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshanot_for_creation_schachter_shalomi/1"/>
        <tei:lg>
          <tei:l>הוֹשַׁעְנָא לְמַעַנְךָ אֶלֹהֵינוּ</tei:l>
          <tei:l>הוֹשַעְנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshanot_for_creation_schachter_shalomi/2"/>
        <tei:lg>
          <tei:l>הוֹשַׁעְנָא לְמַעַנְךָ בּוֹרֵאנוּ</tei:l>
          <tei:l>הוֹשַעְנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshanot_for_creation_schachter_shalomi/3"/>
        <tei:lg>
          <tei:l>הוֹשַׁעְנָא לְמַעַנְךָ גוֹאֲלֵנוּ</tei:l>
          <tei:l>הוֹשַעְנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshanot_for_creation_schachter_shalomi/4"/>
        <tei:lg>
          <tei:l>הוֹשַׁעְנָא לְמַעַנְךָ דוֹרְשֵׁנוּ</tei:l>
          <tei:l>הוֹשַעְנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshanot_for_creation_schachter_shalomi/5"/>
        <tei:lg>
          <tei:l>כִּי <tei:seg type="acrostic">אִ</tei:seg>יבַּדְנוּ אַדְמָתְךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshanot_for_creation_schachter_shalomi/6"/>
        <tei:lg>
          <tei:l>כִּי <tei:seg type="acrostic">בָּ</tei:seg>זִינוּ בְּרִיאָתְךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshanot_for_creation_schachter_shalomi/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">גִ</tei:seg>יעַלְנוּ גִדוּלֶיךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshanot_for_creation_schachter_shalomi/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">דָ</tei:seg>רַכְנוּ עַל דִשְׁאֲךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshanot_for_creation_schachter_shalomi/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הָ</tei:seg>רַסְנוּ אֶת הַהֲוָיָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshanot_for_creation_schachter_shalomi/10"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>קִלְקַלְנוּ וְשִׁחַתְנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshanot_for_creation_schachter_shalomi/11"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זָ</tei:seg>רַמְנוּ זִיז שְׂדוֹתֵינוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshanot_for_creation_schachter_shalomi/12"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חָ</tei:seg>מַסְנוּ חַיוֹת רַבּוֹת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshanot_for_creation_schachter_shalomi/13"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">טָ</tei:seg>רַפְנוּ טִנִאֲךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshanot_for_creation_schachter_shalomi/14"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>קַדְנוּ יְעָרוֹת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshanot_for_creation_schachter_shalomi/15"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כִּ</tei:seg>רְסַמְנוּ כְּרָמִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshanot_for_creation_schachter_shalomi/16"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">לָ</tei:seg>כַדְנוּ לְבָנוֹן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshanot_for_creation_schachter_shalomi/17"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מָ</tei:seg>אַסְנוּ מַעֲשֶׂיךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshanot_for_creation_schachter_shalomi/18"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נִ</tei:seg>אַצְנוּ נְטִיעָתְךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshanot_for_creation_schachter_shalomi/19"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">סָ</tei:seg>לַלְנוּ כְּבִישׁים סְבִיבֵי בָּתֵינוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshanot_for_creation_schachter_shalomi/20"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">עִ</tei:seg>ינִינוּ עוֹפוֹת עִם רַעַל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshanot_for_creation_schachter_shalomi/21"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פִּ</tei:seg>גַלְנוּ פֵּירוֹתֵינוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshanot_for_creation_schachter_shalomi/22"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">צָ</tei:seg>דִינוּ צָבִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshanot_for_creation_schachter_shalomi/23"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>צַרְנוּ קְמוּשׁוֹת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshanot_for_creation_schachter_shalomi/24"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ר</tei:seg>וּחֵנוּ רָזוֹן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshanot_for_creation_schachter_shalomi/25"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שִׁ</tei:seg>מַמְנוּ שִׁטוֹת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshanot_for_creation_schachter_shalomi/26"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">תִ</tei:seg>יעַבְנוּ תָלַמִים</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
