    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_prayer_before_seeking_healing_in_a_psychedelic_journey_kamenetz">
        <tei:head>תְּפִלָּה לִפְנֵי מַסַּע רִפּוּי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_before_seeking_healing_in_a_psychedelic_journey_kamenetz/1"/>
        <tei:lg>
          <tei:l>לְשֵׁם יִחוּד קוּדְשָׁא בְּרִיךְ הוּא וּשְׁכִינְתֵּיהּ</tei:l>
          <tei:l>עַל יְדֵי הַהוּא טָמִיר וְנֶעְלָם</tei:l>
          <tei:l>בְּשֵׁם כָּל יִשְֹרָאֵל:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_before_seeking_healing_in_a_psychedelic_journey_kamenetz/2"/>
        <tei:lg>
          <tei:l>וִיהִי רָצוֹן מִלְּפָנֶיךָ ה׳ אֱלֹהַי</tei:l>
          <tei:l>שֶׁיְּהֵא עֵסֶק זֶה לִי לִרְפוּאָה כְּמָה שֶׁנֶּאֱמַר:</tei:l>
          <tei:l>אִם שָׁמוֹעַ תִּשְׁמַע לְקוֹל ה׳ אֱלֹהֶיךָ</tei:l>
          <tei:l>וְהַיָּשָׁר בְּעֵינָיו תַּעֲשֶׂה</tei:l>
          <tei:l>וְהַאֲזַנְתָּ לְמִצְוֹתָיו</tei:l>
          <tei:l>וְשָׁמַרְתָּ כָּל חֻקָּיו</tei:l>
          <tei:l>כָּל הַמַּחֲלָה אֲשֶׁר שַׂמְתִּי בְמִצְרַיִם</tei:l>
          <tei:l>לֹא אָשִׂים עָלֶיךָ</tei:l>
          <tei:l>כִּי אֲנִי ה׳ רֹפְאֶךָ: <tei:bibl>(שמות טו:כו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_before_seeking_healing_in_a_psychedelic_journey_kamenetz/3"/>
        <tei:lg>
          <tei:l>רְפָאֵנוּ ה׳ וְנֵרָפֵא,</tei:l>
          <tei:l>הוֹשִׁיעֵנוּ וְנִוָּשֵׁעָה,</tei:l>
          <tei:l>כִּי תְהִלָּתֵנוּ אָתָּה,</tei:l>
          <tei:l>וְהַעֲלֵה אֲרוּכָה וּמַרְפֵּא</tei:l>
          <tei:l>לְכָל־תַּחֲלוּאֵינוּ</tei:l>
          <tei:l>וּלְכָל־מַכְאוֹבֵינוּ</tei:l>
          <tei:l>וּלְכָל־מַכּוֹתֵינוּ.</tei:l>
          <tei:l>כִּי אֵל רוֹפֵא רַחֲמָן וְנֶאֱמָן אָתָּה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_before_seeking_healing_in_a_psychedelic_journey_kamenetz/4"/>
        <tei:lg>
          <tei:l>וּבְכֵן מוֹדֶה/מוֹדָה אֲנִי לְפָנֶיךָ רוֹפֵא חַי וְקַיָּם</tei:l>
          <tei:l>שֶׁלֹּא חִסַּר בְּעוֹלָמוֹ כְּלוּם</tei:l>
          <tei:l>וּבָרָא בוֹ בְּרִיּוֹת טוֹבוֹת וְאִילָנוֹת טוֹבוֹת</tei:l>
          <tei:l>לֵהָנוֹת בָּהֶם בְּנֵי אָדָם כְּמָה שֶׁנֶּאֱמַר:</tei:l>
          <tei:l>וְעַל הַנַּחַל יַעֲלֶה עַל שְׂפָתוֹ מִזֶּה וּמִזֶּה כָּל עֵץ מַאֲכָל</tei:l>
          <tei:l>לֹא יִבּוֹל עָלֵהוּ וְלֹא יִתֹּם</tei:l>
          <tei:l>פִּרְיוֹ לָחֳדָשָׁיו יְבַכֵּר</tei:l>
          <tei:l>כִּי מֵימָיו מִן הַמִּקְדָּשׁ הֵמָּה יוֹצְאִים</tei:l>
          <tei:l>וְהָיוּ פִרְיוֹ לְמַאֲכָל</tei:l>
          <tei:l>וְעָלֵהוּ לִתְרוּפָה. <tei:bibl>(יחזקאל מז:יב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_before_seeking_healing_in_a_psychedelic_journey_kamenetz/5"/>
        <tei:lg>
          <tei:l>וַאֲנִי</tei:l>
          <tei:l>אֲקַדֵּשׁ שְׁמֵךְ הַגָּדוֹל וְהַגִּבּוֹר וְהַנּוֹרָא</tei:l>
          <tei:l>הֶהָדוּר הָאַדִּיר וְהַמֻּפְלָא וְהַנִּכְבָּד</tei:l>
          <tei:l>הַדִרְיָרוֹם אַדִרְיָרוֹם</tei:l>
          <tei:l>יַצִּיב גָּדוֹל טָהוֹר מְפֹרָשׁ שְׁמֵךְ</tei:l>
          <tei:l>חוֹצֵב בְּשַׁלְהָבִיוֹת שֶׁל אֵשׁ</tei:l>
          <tei:l>חַי יה יהו יהו קָדוֹשׁ וְנוֹרָא</tei:l>
          <tei:l>בָּרָאתָ עֶלְיוֹנִים וְתַחְתּוֹנִים</tei:l>
          <tei:l>בְּמַאֲמָרְךָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_before_seeking_healing_in_a_psychedelic_journey_kamenetz/6"/>
        <tei:lg>
          <tei:l>בָּרוּךְ רוֹפֵא כָל בָּשָׂר</tei:l>
          <tei:l>וּמַפְלִיא לַעֲשׂוֹת:</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
