  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:mi_sheanah_hu_yaanenu_a_star_trek_selichah_mayer">
        <tei:head>Mi she'Anah...Hu Ya'anenu :: A Star Trek Seliḥah, by Isaac Gantwerk Mayer</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheanah_hu_yaanenu_a_star_trek_selichah_mayer/1"/>
        <tei:lg>
          <tei:l>May the One who answered Captain Kirk</tei:l>
          <tei:l>in the stadium when the Gorn grappled him<tei:anchor xml:id="note_1"/></tei:l>
          <tei:l>answer us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheanah_hu_yaanenu_a_star_trek_selichah_mayer/2"/>
        <tei:lg>
          <tei:l>May the One who answered Spocḳ</tei:l>
          <tei:l>in his nakedness of the seven-year cycle<tei:anchor xml:id="note_2"/></tei:l>
          <tei:l>answer us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheanah_hu_yaanenu_a_star_trek_selichah_mayer/3"/>
        <tei:lg>
          <tei:l>May the One who answered Doctor McCoy</tei:l>
          <tei:l>on the land of Capella IV<tei:anchor xml:id="note_3"/></tei:l>
          <tei:l>answer us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheanah_hu_yaanenu_a_star_trek_selichah_mayer/4"/>
        <tei:lg>
          <tei:l>May the One who answered Captain Picard,</tei:l>
          <tei:l>in his forced conversion by the Borg<tei:anchor xml:id="note_4"/></tei:l>
          <tei:l>answer us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheanah_hu_yaanenu_a_star_trek_selichah_mayer/5"/>
        <tei:lg>
          <tei:l>May the One who answered Riker, Number One,</tei:l>
          <tei:l>at the battle of Wolf 359<tei:anchor xml:id="note_5"/></tei:l>
          <tei:l>answer us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheanah_hu_yaanenu_a_star_trek_selichah_mayer/6"/>
        <tei:lg>
          <tei:l>May the One who answered Data</tei:l>
          <tei:l>when his brother supplanted him<tei:anchor xml:id="note_6"/></tei:l>
          <tei:l>answer us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheanah_hu_yaanenu_a_star_trek_selichah_mayer/7"/>
        <tei:lg>
          <tei:l>May the One who answered Sisko</tei:l>
          <tei:l>in his visions from the Prophets<tei:anchor xml:id="note_7"/></tei:l>
          <tei:l>answer us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheanah_hu_yaanenu_a_star_trek_selichah_mayer/8"/>
        <tei:lg>
          <tei:l>May the One who answered Kira</tei:l>
          <tei:l>when Cardassia oppressed the Bajorans fifty years<tei:anchor xml:id="note_8"/></tei:l>
          <tei:l>answer us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheanah_hu_yaanenu_a_star_trek_selichah_mayer/9"/>
        <tei:lg>
          <tei:l>May the One who answered Odo</tei:l>
          <tei:l>in the Great Link<tei:anchor xml:id="note_9"/></tei:l>
          <tei:l>answer us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheanah_hu_yaanenu_a_star_trek_selichah_mayer/10"/>
        <tei:lg>
          <tei:l>May the One who answered all those aboard the starship Voyager</tei:l>
          <tei:l>in the Delta Quadrant<tei:anchor xml:id="note_10"/></tei:l>
          <tei:l>answer us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheanah_hu_yaanenu_a_star_trek_selichah_mayer/11"/>
        <tei:lg>
          <tei:l>May the one who answered all Your sentient members</tei:l>
          <tei:l>in Starfleet</tei:l>
          <tei:l>answer us.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheanah_hu_yaanenu_a_star_trek_selichah_mayer/12"/>
        <tei:lg>
          <tei:l>May the One who answered all the righteous and pious and pure and upright,</tei:l>
          <tei:l>on Earth and in all the planets of the universe,</tei:l>
          <tei:l>answer us.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
