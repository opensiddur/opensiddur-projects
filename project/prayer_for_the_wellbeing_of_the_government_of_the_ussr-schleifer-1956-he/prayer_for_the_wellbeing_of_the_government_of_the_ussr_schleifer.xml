  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_the_wellbeing_of_the_government_of_the_ussr_schleifer">
        <tei:head>תְּפִלָּה לִשְׁלוֹם הַמֶּמְשָׁלָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_wellbeing_of_the_government_of_the_ussr_schleifer/1"/>
        <tei:lg>
          <tei:l>תְּפִלָּה בְּעַד הַשָּׁלוֹם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_wellbeing_of_the_government_of_the_ussr_schleifer/2"/>
        <tei:lg>
          <tei:l>אָבִינוּ שֶׁבַּשָּׁמַיִם!</tei:l>
          <tei:l>בָּרֵךְ מֶמְשֶׁלֶת סססר</tei:l>
          <tei:l>מָגֵן הַשָּׁלוֹם בְּכׇל הָעוֹלָם</tei:l>
          <tei:l>וְנֹאמַר אָמֵן!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_wellbeing_of_the_government_of_the_ussr_schleifer/3"/>
        <tei:lg>
          <tei:l>אָבִינוּ מַלְכֵּנוּ!</tei:l>
          <tei:l>חַזֵּק מְגִינֵי הַשָּׁלוֹם בְּכׇל הָעוֹלָם,</tei:l>
          <tei:l>בִּזְכוּתָא דְּאַהֲרֹן כַּהֲנָא קַדִּישָׁא</tei:l>
          <tei:l>אוֹהֵב שָׁלוֹם וְרוֹדֵף שָׁלוֹם</tei:l>
          <tei:l>וְנָתַתָּ שָׁלוֹם בָּאָרֶץ.</tei:l>
          <tei:l>וְנֹאמַר אָמֵן!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_wellbeing_of_the_government_of_the_ussr_schleifer/4"/>
        <tei:lg>
          <tei:l>אַדִּיר בַּמָּרוֹם, שׁוֹכֵן בִּגְבוּרָה</tei:l>
          <tei:l>אַתָּה שָׁלוֹם וְשִׁמְךָ שָׁלוֹם!</tei:l>
          <tei:l>יְהִי רָצוֹן שֶׁתָּשִׂים עָלֵינוּ</tei:l>
          <tei:l>וְעַל כׇּל הָעוֹלָם כֻּלּוֹ</tei:l>
          <tei:l>חַיִּים וּבְרָכָה לְמִשְׁמֶרֶת שָׁלוֹם!</tei:l>
          <tei:l>וְנֹאמַר אָמֵן!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_wellbeing_of_the_government_of_the_ussr_schleifer/5"/>
        <tei:lg>
          <tei:l>תְּפִלָּה לִשְׁלוֹם הַמֶּמְשָׁלָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_wellbeing_of_the_government_of_the_ussr_schleifer/6"/>
        <tei:lg>
          <tei:l>מִי שֶׁבֵּרַךְ אֲבוֹתֵינוּ</tei:l>
          <tei:l>אַבְרָהָם יִצְחָק וְיַעֲקֹב,</tei:l>
          <tei:l>הַנּוֹתֵן בַּיָּם דֶּרֶךְ</tei:l>
          <tei:l>וּבְמַיִם עַזִּים נְתִיבָה,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_wellbeing_of_the_government_of_the_ussr_schleifer/7"/>
        <tei:lg>
          <tei:l>הוּא יְבָרֵךְ וְיִשְׁמוֹר וְיִנְצוֹר וְיַעֲזוֹר</tei:l>
          <tei:l>וִירוֹמֵם וִיגַדֵּל וִינַשֵּׂא לְמַעֲלָה</tei:l>
          <tei:l>אֶת מֶמְשֶׁלֶת סססר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_wellbeing_of_the_government_of_the_ussr_schleifer/8"/>
        <tei:lg>
          <tei:l>הַקָּדוֹשׁ בָּרוּךְ הוּא</tei:l>
          <tei:l>יְחַיֶּהָ וִיִשְׁמֹרֶהָ</tei:l>
          <tei:l>וּמִכׇּל צָרָה וְצוּקָה</tei:l>
          <tei:l>וְיָגוֹן וְנֵזֶק יַצִילֶהָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_wellbeing_of_the_government_of_the_ussr_schleifer/9"/>
        <tei:lg>
          <tei:l>וְיַפִּיל שׂוֹנְאֶיהָ לְפָנֶיהָ</tei:l>
          <tei:l>וּבְכֹל אֲשֶׁר תִּפְנֶה תַצְלִיחַ.</tei:l>
          <tei:l>וְנֹאמַר אָמֵן!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
