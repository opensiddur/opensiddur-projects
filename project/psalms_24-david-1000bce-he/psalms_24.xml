    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/24">
        <tei:head>תהלים כ״ד</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/24/1-10"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">א</tei:hi> לְדָוִ֗ד מִ֫זְמ֥וֹר</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>לַֽ֭יהוָה</tei:l>
          <tei:l>הָאָ֣רֶץ וּמְלוֹאָ֑הּ</tei:l>
          <tei:l>תֵּ֝בֵ֗ל וְיֹ֣שְׁבֵי בָֽהּ׃</tei:l>
          <tei:l><tei:hi rend="superscript">ב</tei:hi> כִּי־ה֭וּא עַל־יַמִּ֣ים</tei:l>
          <tei:l>יְסָדָ֑הּ</tei:l>
          <tei:l>וְעַל־נְ֝הָר֗וֹת</tei:l>
          <tei:l>יְכוֹנְנֶֽהָ׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ג</tei:hi> מִֽי־יַעֲלֶ֥ה</tei:l>
          <tei:l>בְהַר־יְהוָ֑ה</tei:l>
          <tei:l>וּמִי־יָ֝קוּם</tei:l>
          <tei:l>בִּמְק֥וֹם קָדְשֽׁוֹ׃</tei:l>
          <tei:l><tei:hi rend="superscript">ד</tei:hi> נְקִ֥י</tei:l>
          <tei:l>כַפַּ֗יִם</tei:l>
          <tei:l>וּֽבַר־לֵ֫בָ֥ב</tei:l>
          <tei:l>אֲשֶׁ֤ר ׀ לֹא־נָשָׂ֣א</tei:l>
          <tei:l>לַשָּׁ֣וְא נַפְשִׁ֑י</tei:l>
          <tei:l>וְלֹ֖א נִשְׁבַּ֣ע לְמִרְמָֽה׃</tei:l>
          <tei:l><tei:hi rend="superscript">ה</tei:hi> יִשָּׂ֣א</tei:l>
          <tei:l>בְ֭רָכָה</tei:l>
          <tei:l>מֵאֵ֣ת יְהוָ֑ה</tei:l>
          <tei:l>וּ֝צְדָקָ֗ה</tei:l>
          <tei:l>מֵאֱלֹהֵ֥י יִשְׁעֽוֹ׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ו</tei:hi> זֶ֭ה דּ֣וֹר דרשו [דֹּרְשָׁ֑יו]</tei:l>
          <tei:l>מְבַקְשֵׁ֨י</tei:l>
          <tei:l>פָנֶ֖יךָ יַעֲקֹ֣ב</tei:l>
          <tei:l>סֶֽלָה׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ז</tei:hi> שְׂא֤וּ שְׁעָרִ֨ים ׀ רָֽאשֵׁיכֶ֗ם</tei:l>
          <tei:l>וְֽ֭הִנָּשְׂאוּ</tei:l>
          <tei:l>פִּתְחֵ֣י עוֹלָ֑ם</tei:l>
          <tei:l>וְ֝יָב֗וֹא</tei:l>
          <tei:l>מֶ֣לֶךְ הַכָּבֽוֹד׃</tei:l>
          <tei:l><tei:hi rend="superscript">ח</tei:hi> מִ֥י זֶה֮</tei:l>
          <tei:l>מֶ֤לֶךְ הַכָּ֫ב֥וֹד</tei:l>
          <tei:l>יְ֭הוָה עִזּ֣וּז וְגִבּ֑וֹר</tei:l>
          <tei:l>יְ֝הוָ֗ה</tei:l>
          <tei:l>גִּבּ֥וֹר</tei:l>
          <tei:l>מִלְחָמָֽה׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ט</tei:hi> שְׂא֤וּ שְׁעָרִ֨ים ׀ רָֽאשֵׁיכֶ֗ם</tei:l>
          <tei:l>וּ֭שְׂאוּ</tei:l>
          <tei:l>פִּתְחֵ֣י עוֹלָ֑ם</tei:l>
          <tei:l>וְ֝יָבֹא</tei:l>
          <tei:l>מֶ֣לֶךְ הַכָּבֽוֹד׃</tei:l>
          <tei:l><tei:hi rend="superscript">י</tei:hi> מִ֤י ה֣וּא זֶה֮ מֶ֤לֶךְ הַכָּ֫ב֥וֹד</tei:l>
          <tei:l>יְהוָ֥ה צְבָא֑וֹת</tei:l>
          <tei:l>ה֤וּא מֶ֖לֶךְ הַכָּב֣וֹד</tei:l>
          <tei:l>סֶֽלָה׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
