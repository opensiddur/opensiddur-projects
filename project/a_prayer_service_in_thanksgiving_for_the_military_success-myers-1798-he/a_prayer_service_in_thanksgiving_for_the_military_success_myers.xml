  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/1"/>
        <tei:lg>
          <tei:l>סדר תפלה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/2"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">אחר תפלת המנחה יאמרו החזן והקהל פסוקים אלו:</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/3"/>
        <tei:lg>
          <tei:l>ה׳ אהבתי מעון ביתך</tei:l>
          <tei:l>ומקום משכן כבודך׃ <tei:bibl>(תהלים כו:ח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/4"/>
        <tei:lg>
          <tei:l>באו נשתחוה ונכרעה</tei:l>
          <tei:l>נברכה לפני ה׳ עושנו׃ <tei:bibl>(תהלים צה:ו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/5"/>
        <tei:lg>
          <tei:l>הודו לה׳ קראו בשמו</tei:l>
          <tei:l>הודיעו בעמים עלילותיו׃ <tei:bibl>(תהלים קה:א, דברי הימים א׳ טז:ח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/6"/>
        <tei:lg>
          <tei:l>שירו לו זמרו לו</tei:l>
          <tei:l>שיחו בכל נפלאתיו׃ <tei:bibl>(תהלים קה:ב, דברי הימים א׳ טז:ט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/7"/>
        <tei:lg>
          <tei:l>התהללו בשם קדשו</tei:l>
          <tei:l>ישמח לב מבקשי ה׳׃ <tei:bibl>(תהלים קה:ג, דברי הימים א׳ טז:י)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/8"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ואח״כ יומרו החזן והקהל י״ז מזמורי תהלים אחת לאחת כמספר טוב להודות לה׳</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/9"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">מזמור</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/10"/>
        <tei:lg>
          <tei:l>תהלים כ״א</tei:l>
          <tei:l>ה׳ בעזך ישמח מלך וכו״</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/11"/>
        <tei:lg>
          <tei:l>תהלים כ״ג</tei:l>
          <tei:l>ה׳ רעי לא אחסר וכו׳</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/12"/>
        <tei:lg>
          <tei:l>תהלים ל״ג</tei:l>
          <tei:l>רננו צדיקים בה׳ וכו׳</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/13"/>
        <tei:lg>
          <tei:l>תהלים מ״ה</tei:l>
          <tei:l>רהש לבי דבר טוב וכו׳</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/14"/>
        <tei:lg>
          <tei:l>תהלים ס״ו</tei:l>
          <tei:l>הריעו לאלהים כל הארץ וכו׳</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/15"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">אח״כ יאמר דחזן הוראה זו בקול רם והקהל עמו בלחש</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/16"/>
        <tei:lg>
          <tei:l>היושב במרחכי מרום</tei:l>
          <tei:l>השוכן בשמי שמי קרם</tei:l>
          <tei:l>לך שמים</tei:l>
          <tei:l>אף לך ארץ</tei:l>
          <tei:l>תבל וישבי בה</tei:l>
          <tei:l>ואתה שיפט תבל בצדק</tei:l>
          <tei:l>ועמים במישרים</tei:l>
          <tei:l>עתה באנו אל היכל קדשך ביראתך</tei:l>
          <tei:l>שפתי רננות יהלל פינו</tei:l>
          <tei:l>ולשוננו</tei:l>
          <tei:l>תרנן צדקתך</tei:l>
          <tei:l>גם כל יושבי הארץ</tei:l>
          <tei:l>יזמרו לך</tei:l>
          <tei:l>ויודו לשמך</tei:l>
          <tei:l>על חסדך</tei:l>
          <tei:l>ועל אמתך</tei:l>
          <tei:l>אשר הגדלת לעשות עמנו</tei:l>
          <tei:l>ועל כל הטוב</tei:l>
          <tei:l>אשר נמלתנו׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/17"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">פסוקים</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/18"/>
        <tei:lg>
          <tei:l>לה׳ הישועה</tei:l>
          <tei:l>על עמך ברכתך סלה׃ <tei:bibl>(תהלים ג:ט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/19"/>
        <tei:lg>
          <tei:l>ה׳ צבאות עמנו</tei:l>
          <tei:l>משגב לנו אלהי יעקב סלה׃ <tei:bibl>(תהלים מו:ח, תהלים מו:יב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/20"/>
        <tei:lg>
          <tei:l>ה׳ צבאות</tei:l>
          <tei:l>אשרי אדם בוטח בך׃ <tei:bibl>(תהלים פד:יג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/21"/>
        <tei:lg>
          <tei:l>ברוך הגבר אשר יבטח בה׳</tei:l>
          <tei:l>והיה ה׳ מבטחו׃ <tei:bibl>(ירמיה יז:ז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/22"/>
        <tei:lg>
          <tei:l>יראי ה׳ בטחו בה׳</tei:l>
          <tei:l>עזרם ומגינם הוא׃ <tei:bibl>(תהלים קטו:יא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/23"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">מזמור</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/24"/>
        <tei:lg>
          <tei:l>תהלים ע״ב</tei:l>
          <tei:l>לשלמה אלהים משפטיך למלך תן</tei:l>
          <tei:l>וצדקתך לבן מלך וכו׳׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/25"/>
        <tei:lg>
          <tei:l>תהלים ע״ה</tei:l>
          <tei:l>למנצה אל תשחת</tei:l>
          <tei:l>מזמור לאסף שיר וכו׳׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/26"/>
        <tei:lg>
          <tei:l>תהלים צ״א</tei:l>
          <tei:l>יושב בסתר עליון</tei:l>
          <tei:l>בצל שדי יתלונן וכו׳׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/27"/>
        <tei:lg>
          <tei:l>תהלים צ״ה</tei:l>
          <tei:l>לכו נרננה לה׳</tei:l>
          <tei:l>נריעה לצור ישענו וכו׳׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/28"/>
        <tei:lg>
          <tei:l>תהלים צ״ח</tei:l>
          <tei:l>שירו לה׳ שיר חדש</tei:l>
          <tei:l>כי נפלאות עשה וכו׳׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/29"/>
        <tei:lg>
          <tei:l>הודאה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/30"/>
        <tei:lg>
          <tei:l>ה׳ אלהי</tei:l>
          <tei:l>גדלת מאוד</tei:l>
          <tei:l>אין כמוך</tei:l>
          <tei:l>ואין אלהים זולתך</tei:l>
          <tei:l>בשבחות ובזמירות נקדמך</tei:l>
          <tei:l>לברך את שמך</tei:l>
          <tei:l>על כל האותות והמופתים</tei:l>
          <tei:l>אשר עשית</tei:l>
          <tei:l>לדרי אי בריטניא</tei:l>
          <tei:l>אשר אנחנו בקרבם</tei:l>
          <tei:l>וחוסים בצילם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/31"/>
        <tei:lg>
          <tei:l>כי הראיתני צרות רבות ורעות</tei:l>
          <tei:l>חרב ורעב שבי</tei:l>
          <tei:l>ובוזזי שלל</tei:l>
          <tei:l>שעברו על הרבה מדינות וערים</tei:l>
          <tei:l>הקרובים והרחוקים</tei:l>
          <tei:l>אשר סביבותינו</tei:l>
          <tei:l>מחמת המציק</tei:l>
          <tei:l>אשר בונן להשחית</tei:l>
          <tei:l>וכמעט אמר אויב</tei:l>
          <tei:l>אררף</tei:l>
          <tei:l>אשיג</tei:l>
          <tei:l>אחלק שלל</tei:l>
          <tei:l>ואין מידי מציל</tei:l>
          <tei:l>ומי בכל מלכי הארץ</tei:l>
          <tei:l>אשר הצילו את ארצם מידי אמנם עלינו</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/32"/>
        <tei:lg>
          <tei:l>נברו חסדיך ורהמיך</tei:l>
          <tei:l>להושיענו</tei:l>
          <tei:l>להגין עלינו משונאינו</tei:l>
          <tei:l>ולהצילנו</tei:l>
          <tei:l>מכל צער ונזק</tei:l>
          <tei:l>שלא יבא בגבולינו</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/33"/>
        <tei:lg>
          <tei:l>נתת ברכה על פני האדמה</tei:l>
          <tei:l>והשבעתנו מטובך</tei:l>
          <tei:l>חלב חטים</tei:l>
          <tei:l>וכל מיני תבואתינו</tei:l>
          <tei:l>ושפע ימים</tei:l>
          <tei:l>ינקתנו</tei:l>
          <tei:l>למען נתענג על רוב שלום</tei:l>
          <tei:l>השקט</tei:l>
          <tei:l>ובטח במדינתינו</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/34"/>
        <tei:lg>
          <tei:l>והאנשים כפויי טובה</tei:l>
          <tei:l>אשר דרך שלום לא ידעו</tei:l>
          <tei:l>ולא הכירו את יפיו וטובו</tei:l>
          <tei:l>וחשבו מהשבות ערומים</tei:l>
          <tei:l>למנוע הטוב והשלוה מארצינו</tei:l>
          <tei:l>וישימו דמי מלחמה בשלום</tei:l>
          <tei:l>ונתנו כחף סוררת</tei:l>
          <tei:l>להמרות עיני כבוד אדוננו המלך</tei:l>
          <tei:l>אשר מטובו חיינו</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/35"/>
        <tei:lg>
          <tei:l>ואתה ה׳</tei:l>
          <tei:l>מגן בעדינו</tei:l>
          <tei:l>הפרת עצת אויבינו</tei:l>
          <tei:l>וקלקלת מחשבתם הרעה</tei:l>
          <tei:l>אשר יזמו לעשות לנו</tei:l>
          <tei:l>והשבת עליהם את אונם</tei:l>
          <tei:l>ואדוננו המלך</tei:l>
          <tei:l>וממלכתו</tei:l>
          <tei:l>נקיים מדם</tei:l>
          <tei:l>אשר שופך בארצינו</tei:l>
          <tei:l>כי ידיהם לא שפכו את הדם</tei:l>
          <tei:l>ולמלך ולממלכתו</tei:l>
          <tei:l>יהיה שלום עד עולם</tei:l>
          <tei:l>אמן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/36"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">פסוקים</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/37"/>
        <tei:lg>
          <tei:l>מי ימלל גבורות ה׳</tei:l>
          <tei:l>ישמיע כל תהלתו׃ <tei:bibl>(תהלים קו:ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/38"/>
        <tei:lg>
          <tei:l>מה גדלו מעשיך ה׳</tei:l>
          <tei:l>מאד עמקו מחשבתיך׃ <tei:bibl>(תהלים צב:ו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/39"/>
        <tei:lg>
          <tei:l>הודיע ה׳ ישועתו</tei:l>
          <tei:l>לעיני הגוים</tei:l>
          <tei:l>גלה צדקתו׃ <tei:bibl>(תהלים צח:ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/40"/>
        <tei:lg>
          <tei:l>חי ה׳ וברוך צורי</tei:l>
          <tei:l>וירום אלהי ישעי׃ <tei:bibl>(תהלים יח:מז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/41"/>
        <tei:lg>
          <tei:l>אורה ה׳ מאד בפי</tei:l>
          <tei:l>ובתוך רבים אהללנו׃ <tei:bibl>(תהלים קט:ל)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/42"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">תהלים</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/43"/>
        <tei:lg>
          <tei:l>תהלים ק׳</tei:l>
          <tei:l>מזמור לתודה וכו׳׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/44"/>
        <tei:lg>
          <tei:l>תהלים ק״ז</tei:l>
          <tei:l>הודו לה׳ כי טוב וכו׳׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/45"/>
        <tei:lg>
          <tei:l>תהלים קי״ז</tei:l>
          <tei:l>הללו את ה׳ כל גוים וכו׳׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/46"/>
        <tei:lg>
          <tei:l>תהלים קכ״ח</tei:l>
          <tei:l>אשרי כל ירא ה׳ וכו׳׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/47"/>
        <tei:lg>
          <tei:l>תהלים קל״ח</tei:l>
          <tei:l>אודך בכל לבי וכו׳׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/48"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">הודאה</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/49"/>
        <tei:lg>
          <tei:l>פתחו לי שערי צדק</tei:l>
          <tei:l>אבא בם</tei:l>
          <tei:l>אודה יה</tei:l>
          <tei:l>תודה וקול</tei:l>
          <tei:l>וקול זמרה</tei:l>
          <tei:l>רון ועוז ותפארה</tei:l>
          <tei:l>אשירה לדר בנהורא</tei:l>
          <tei:l>המאזרני חיל למלחמה</tei:l>
          <tei:l>ומכריע קמינו תחתינו</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/50"/>
        <tei:lg>
          <tei:l>ואף גם זאת</tei:l>
          <tei:l>בהיות שר רב החובל נעלסין</tei:l>
          <tei:l>וצבא מחנהו תופסי משוט מלחים והובלים</tei:l>
          <tei:l>מאוניות אדוננו המלך</tei:l>
          <tei:l>בארץ נכריה</tei:l>
          <tei:l>ובדרך רחוקה</tei:l>
          <tei:l>ממצרים ועד הנה</tei:l>
          <tei:l>גם שם ראו מעשיה ונפלאותיו במצולה</tei:l>
          <tei:l>ובארץ רהב</tei:l>
          <tei:l>עוררת נצהך כבימי קדם</tei:l>
          <tei:l>אשר תחתיו שחהו</tei:l>
          <tei:l>עזרי רהב</tei:l>
          <tei:l>וכאז כן עתה</tei:l>
          <tei:l>דכאת כחלל רהב</tei:l>
          <tei:l>ובזרוע עזך</tei:l>
          <tei:l>פזרת אויבינו</tei:l>
          <tei:l>לכן קראתי לזאת רהב</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/51"/>
        <tei:lg>
          <tei:l>הם שבת ועל נהר נילוס</tei:l>
          <tei:l>כנף רננים נעלסה</tei:l>
          <tei:l>ועלה למעלה גדולה</tei:l>
          <tei:l>לנצח מבצרי אוניות שונאינו</tei:l>
          <tei:l>ומאתה היתה זאת</tei:l>
          <tei:l>להפריד בין הדבקים</tei:l>
          <tei:l>שהיו ספינות אויבינו</tei:l>
          <tei:l>קרובים זו לזו לעזרה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/52"/>
        <tei:lg>
          <tei:l>ואתה ה׳ נחת בים דרך</tei:l>
          <tei:l>ובמים עזים נתיבה</tei:l>
          <tei:l>לאוניות מלכנו</tei:l>
          <tei:l>לבא בין צי אדיר של שונאינו</tei:l>
          <tei:l>ושלטו בהם כרצונם</tei:l>
          <tei:l>לנתוץ ולהאביד</tei:l>
          <tei:l>והרבה מהם נמסרו בידינו</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/53"/>
        <tei:lg>
          <tei:l>וראו כל אפסי ארץ</tei:l>
          <tei:l>את ישועת אלהינו</tei:l>
          <tei:l>אז אמרו בגוים</tei:l>
          <tei:l>הגדיל ה׳ לעשות עם אלה</tei:l>
          <tei:l>הגדיל ה׳ לעשות עמנו</tei:l>
          <tei:l>היינו שמהים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/54"/>
        <tei:lg>
          <tei:l>הנה כי כן עלינו</tei:l>
          <tei:l>להודות</tei:l>
          <tei:l>להלל</tei:l>
          <tei:l>לרומם</tei:l>
          <tei:l>ולברך אה שמך</tei:l>
          <tei:l>ה׳ אלהינו</tei:l>
          <tei:l>על כל הטובה אשר עשית עמנו</tei:l>
          <tei:l>כי בעזך ישמח מלך</tei:l>
          <tei:l>ובישועתך יגיל עמו׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/55"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">פסוקים</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/56"/>
        <tei:lg>
          <tei:l>שומע תפלה</tei:l>
          <tei:l>עדיך כל בשר יבאו׃ <tei:bibl>(תהלים סה:ג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/57"/>
        <tei:lg>
          <tei:l>קוה קויתי ה׳</tei:l>
          <tei:l>ויט אלי וישמע שועתי׃ <tei:bibl>(תהלים מ:ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/58"/>
        <tei:lg>
          <tei:l>יחל ישראל אל ה׳</tei:l>
          <tei:l>מעתה ועד עולם׃ <tei:bibl>(תהלים קלא:ג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/59"/>
        <tei:lg>
          <tei:l>רוצה ה׳ את יראיו</tei:l>
          <tei:l>את המיחלים לחסדו׃ <tei:bibl>(תהלים קמז:יא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/60"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">מזמור</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/61"/>
        <tei:lg>
          <tei:l>תהלים קמ״ד</tei:l>
          <tei:l>לדוד ברוך ה׳ צורי וכו׳׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/62"/>
        <tei:lg>
          <tei:l>תהלים ק״נ</tei:l>
          <tei:l>הללו אל בקדשו וכו׳׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/63"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">הזן וקהל תפלה זו</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/64"/>
        <tei:lg>
          <tei:l>ה׳ אלהי הצבאות</tei:l>
          <tei:l>באנו לחלות פניך</tei:l>
          <tei:l>כאשר החלות</tei:l>
          <tei:l>להראות לנו את טובך</tei:l>
          <tei:l>ותגדל חסדך</tei:l>
          <tei:l>למסור אויבנו בידינו</tei:l>
          <tei:l>כן תוסיף להפליא חסדך ורחמיך עלינו</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/65"/>
        <tei:lg>
          <tei:l>תעוז ידי אנשי מלהמתינו יתרום ימינם</tei:l>
          <tei:l>עושה חיל למלחמה</tei:l>
          <tei:l>ולא יתיצב איש בפניהם</tei:l>
          <tei:l>למען יכירו וידעו</tei:l>
          <tei:l>כל עמי הארץ</tei:l>
          <tei:l>כי ה׳ נלחם להם בצריהם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/66"/>
        <tei:lg>
          <tei:l>אכן טוב מזה</tei:l>
          <tei:l>אם שמוע תשמע בקול תחנוננו</tei:l>
          <tei:l>שלום תשפות לנו</tei:l>
          <tei:l>ולא ישא גוי אל גוי חרב</tei:l>
          <tei:l>ולא ילמדו עוד מלחמה</tei:l>
          <tei:l>ויקוים בנו מקרא שכתוב</tei:l>
          <tei:l>ונתתי שלום בארץ</tei:l>
          <tei:l>וחרב לא תעבר בארצכם <tei:bibl>(ויקרא כו:ו)</tei:bibl></tei:l>
          <tei:l>ובשלום יחדיו</tei:l>
          <tei:l>אשכבה ואישן</tei:l>
          <tei:l>כי אתה ה׳ לבדד לבטח תושיבני׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/67"/>
        <tei:lg>
          <tei:l>אבינו שבשמים</tei:l>
          <tei:l>תן חיים ושלום ואריכת ימים טובים</tei:l>
          <tei:l>לאדוננו המלך</tei:l>
          <tei:l>ולזרעו</tei:l>
          <tei:l>ולביתו</tei:l>
          <tei:l>ולכסאו</tei:l>
          <tei:l>ולכל יועציו ולמנהיגיו</tei:l>
          <tei:l>וכל שרי צבאותיו וחיילותיו</tei:l>
          <tei:l>בין בים ובין ביבשה</tei:l>
          <tei:l>יגיעו אל מחוז חפצם בשלום.</tei:l>
          <tei:l>וישובו איש לביתו בשלום</tei:l>
          <tei:l>ובימיהם ובימינו</tei:l>
          <tei:l>ישמע קול מבשר על ההרים</tei:l>
          <tei:l>משמיע שלום</tei:l>
          <tei:l>מבשר טוב משמיע ישועה</tei:l>
          <tei:l>אומר לציון מלך אלהיך</tei:l>
          <tei:l>ה׳ עוז לעמו יתן</tei:l>
          <tei:l>ה׳ יברך את עמו בשלום</tei:l>
          <tei:l>אמן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/69"/>
        <tei:lg>
          <tei:l>הנותן תשועה למלכים</tei:l>
          <tei:l>וממשלה לנסיכים</tei:l>
          <tei:l>מלכותו מלכות כל עולמים</tei:l>
          <tei:l>הפוצה את דור עבדו מחרב רעה</tei:l>
          <tei:l>הנותן בים דרך ובמים עזים נתיבה</tei:l>
          <tei:l>הוא יברך וישמור וינצור</tei:l>
          <tei:l>ויעזור וירומם ויגדל וינשא למעלה</tei:l>
          <tei:l>את אדונני המלך</tei:l>
          <tei:l>GEORGE the Third</tei:l>
          <tei:l>ירום הודו</tei:l>
          <tei:l>Our most gracious Queen CHARLOTTE,</tei:l>
          <tei:l>His Royal Highness GEORGE Prince of Wales,</tei:l>
          <tei:l>and the Princess of Wales,</tei:l>
          <tei:l>וכל זרע המליכה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/70"/>
        <tei:lg>
          <tei:l>מלך מלכי המלכים</tei:l>
          <tei:l>ברחמיו יחייהו וישמרהו</tei:l>
          <tei:l>ומכל צרה ויגון ונזק יצילהו</tei:l>
          <tei:l>וידבר עמים תחת רנליו</tei:l>
          <tei:l>ופיל שונאיו ימניו</tei:l>
          <tei:l>ובכל אשר יפנה יצליח</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/71"/>
        <tei:lg>
          <tei:l>מלך מלכי המלכיס</tei:l>
          <tei:l>ברחמיו יתן בלבו</tei:l>
          <tei:l>ובלב כל יועציו ושריו</tei:l>
          <tei:l>רחמנות לעשות טובות עמנו</tei:l>
          <tei:l>וגם כל ישראל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_service_in_thanksgiving_for_the_military_success_myers/72"/>
        <tei:lg>
          <tei:l>בימיו ובימינו תושע יהודה</tei:l>
          <tei:l>וישראל ישכון לבטח</tei:l>
          <tei:l>ובא לציון גואל</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וכן יהי רצון</tei:l>
          <tei:l>ונאמר אמן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>