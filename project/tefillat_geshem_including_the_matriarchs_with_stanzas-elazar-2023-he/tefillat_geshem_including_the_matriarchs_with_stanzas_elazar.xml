      <tei:div corresp="urn:x-opensiddur:text:poem:tefillat_geshem_including_the_matriarchs_with_stanzas_elazar">
        <tei:head>תפילת גשם כולל אמהות</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tefillat_geshem_including_the_matriarchs_with_stanzas_elazar/1"/>
        <tei:lg>
          <tei:l>זְכוֹר</tei:l>
          <tei:l><tei:seg type="acrostic">אָ</tei:seg>ב נִמְשַׁךְ אַחֲרֶֽיךָ כַּמַּֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">בֵּ</tei:seg>רַכְתּוֹ כְּעֵץ֮ שָׁת֢וּל עַֽל־פַּלְגֵ֫י מָ֥יִם</tei:l>
          <tei:l><tei:seg type="acrostic">גְּ</tei:seg>נַּנְתּוֹ הִצַּלְתּוֹ מֵאֵשׁ וּמִמַּֽיִּם</tei:l>
          <tei:l><tei:seg type="acrostic">דְּ</tei:seg>רַשְׁתּוֹ בְּזְָרעוֹ עַל כָּל מַֽיִם</tei:l>
          <tei:l>בַּעֲבוּרוֹ אַל תִּמְנַע מַֽיִם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tefillat_geshem_including_the_matriarchs_with_stanzas_elazar/2"/>
        <tei:lg>
          <tei:l>זְכוֹר</tei:l>
          <tei:l><tei:seg type="acrostic">תְּ</tei:seg>חוֹלְלֶֽנּוּ<tei:anchor xml:id="note_1"/> שֶׁהִרְבָּה נֶֽפֶשׁ<tei:anchor xml:id="note_2"/> כַּמַּֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">שָׁ</tei:seg>דֶֽיהָ נִפְתְּחוּ כְּמַעֲיָּנוֺת מַֽיִם<tei:anchor xml:id="note_3"/></tei:l>
          <tei:l><tei:seg type="acrostic">ר</tei:seg>וֹנְנָה בְּקִרְבָּהּ וְצָחֲקָה<tei:anchor xml:id="note_4"/> כַּמַּֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">קִ</tei:seg>יֵּם אֺרְחֶֽיהָ כַּנָּשִׁים<tei:anchor xml:id="note_5"/> כַּמַּֽיִם</tei:l>
          <tei:l>בַּעֲבוּרָהּ אַל תִּמְנַע מַֽיִם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tefillat_geshem_including_the_matriarchs_with_stanzas_elazar/3"/>
        <tei:lg>
          <tei:l>זְכוֹר</tei:l>
          <tei:l><tei:seg type="acrostic">הַ</tei:seg>נּוֹלַד בִּבְשׂוֹרַת יֻקַּחֽ־נָ֣א מְעַט־ מַ֔יִם</tei:l>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>שַׂחְתָּ לְהוֹרוֹ לְשָׁחֳטוֹ לִשְׁפֹּךְ דָּמוֹ כַּמַּֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">זִ</tei:seg>הֵר גַּם הוּא לִשְׁפֹּךְ לֵב כַּמַּֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">חָ</tei:seg>פַר וּמָצָא בְּאֵרוֹת מַֽיִם</tei:l>
          <tei:l>בְּצִדְקוֹ חֹן חַשְׁרַת מַֽיִם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tefillat_geshem_including_the_matriarchs_with_stanzas_elazar/4"/>
        <tei:lg>
          <tei:l>זְכוֹר</tei:l>
          <tei:l><tei:seg type="acrostic">צֵ</tei:seg>אתָהּ<tei:anchor xml:id="note_6"/> לְעֵת עֶֽרֶב<tei:anchor xml:id="note_7"/> אֶל עֵין הַמַּֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">פָּ</tei:seg>רְשׂוּ יָדֶֽיהָ בְּחֶֽסֶד לִשְׁאֹב<tei:anchor xml:id="note_8"/> מַֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">עִ</tei:seg>ם כַּדָּהּ הִגְמִיאָה<tei:anchor xml:id="note_9"/> לָעֶֽבֶד מַֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">סָ</tei:seg>בְבָה עַד כִּלּוּ הַגְּמָלִים לִשְׁתֺּת מַֽיִם<tei:anchor xml:id="note_10"/></tei:l>
          <tei:l>בְּצִדְקָהּ חֹן חַשְׁרַת מַֽיִם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tefillat_geshem_including_the_matriarchs_with_stanzas_elazar/5"/>
        <tei:lg>
          <tei:l>זְכוֹר</tei:l>
          <tei:l><tei:seg type="acrostic">טָ</tei:seg>עַן מַקְלוֹ וְעָבַר יְַרדֵּן מַֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">יַ</tei:seg>חֵד לֵב וְגָל אֶֽבֶן מִפִּי בְאֵר מַֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">כְּ</tei:seg>נֶאֱבַק לוֹ שַׂר בָּלוּל מֵאֵשׁ וּמִמַּֽיִּם</tei:l>
          <tei:l><tei:seg type="acrostic">לָ</tei:seg>כֵן הִבְטַחְתּוֹ הֱיוֹת עִמּוֹ בָּאֵשׁ וּבַמָּֽיִם</tei:l>
          <tei:l>בַּעֲבוּרוֹ אַל תִּמְנַע מַֽיִם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tefillat_geshem_including_the_matriarchs_with_stanzas_elazar/6"/>
        <tei:lg>
          <tei:l>זְכוֹר</tei:l>
          <tei:l><tei:seg type="acrostic">נִ</tei:seg>שְּׁקָה<tei:anchor xml:id="note_11"/> הָרֹעָה הַבָּֽאָה לִבְאֵר מַֽיִם<tei:anchor xml:id="note_12"/></tei:l>
          <tei:l><tei:seg type="acrostic">מְ</tei:seg>נַע קוֹלָהּ מִבֶּֽכִי וְעֵינֶֽיהָ מִדִּמְעַת<tei:anchor xml:id="note_13"/> מַֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>בֶָנֶֽיהָ מְבַכָּה<tei:anchor xml:id="note_14"/> גָּלֹתָם עַל נַהֲרוֹת<tei:anchor xml:id="note_15"/> מַֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">כֵּ</tei:seg>ן שָֽׁבוּ בָנֶֽיהָ לִגְבוּלָם<tei:anchor xml:id="note_16"/> כַּאֲפִיקֵי<tei:anchor xml:id="note_17"/> מַֽיִם</tei:l>
          <tei:l>בַּעֲבוּרָהּ אַל תִּמְנַע מַֽיִם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tefillat_geshem_including_the_matriarchs_with_stanzas_elazar/7"/>
        <tei:lg>
          <tei:l>זְכוֹר</tei:l>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>צְאָה מִמֶּֽנָּה שִׁשָּׁה<tei:anchor xml:id="note_18"/> כְּשֶֽׁפַע מַֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">ט</tei:seg>וֺב עֵינֶֽיהָ, רַכּוֹת<tei:anchor xml:id="note_19"/> מִבְּכִי<tei:anchor xml:id="note_20"/> מַֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">חָ</tei:seg>פְצָה אַהֲבַת אִישָׁהּ<tei:anchor xml:id="note_21"/> וּבוֹכָה מַֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">זָ</tei:seg>בַדְתָּהּ בָּנִים<tei:anchor xml:id="note_22"/> שֺׁכְנֵי כָּל חוֺף<tei:anchor xml:id="note_23"/> מַֽיִם</tei:l>
          <tei:l>בְּצִדְקָהּ חֹן חַשְׁרַת מַֽיִם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tefillat_geshem_including_the_matriarchs_with_stanzas_elazar/8"/>
        <tei:lg>
          <tei:l>זְכוֹר</tei:l>
          <tei:l><tei:seg type="acrostic">מָ</tei:seg>שֽׁוּי בְּתֵבַת גֹּֽמֶא מִן הַמַּֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">נָ</tei:seg>מוּ דָּלֹה דָלָה וְהִשְׁקָה צאֹן מַֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">סְ</tei:seg>גוּלֶֽיךָ עֵת צָמְאוּ לְמַֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">עַ</tei:seg>ל הַסֶּֽלַע הָךְ וַיֵּצְאוּ מַֽיִם</tei:l>
          <tei:l>בְּצִדְקוֹ חֹן חַשְׁרַת מַֽיִם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tefillat_geshem_including_the_matriarchs_with_stanzas_elazar/9"/>
        <tei:lg>
          <tei:l>זְכוֹר</tei:l>
          <tei:l><tei:seg type="acrostic">וַ</tei:seg>תָּ֥שֶׂם בַּסּ֖וּף עַל־שְׂפַ֥ת<tei:anchor xml:id="note_24"/> הַמַּֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">הַ</tei:seg>שַּׁפִּרָה<tei:anchor xml:id="note_25"/> לְהַצְפִנוֺ<tei:anchor xml:id="note_26"/> מִגְּזֵרַת מַֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">דָּ</tei:seg>ם הַיְּלָדִים הֶחְיְתָה מִן הַמַּֽיִם<tei:anchor xml:id="note_27"/></tei:l>
          <tei:l><tei:seg type="acrostic">גָּ</tei:seg>ם מַסְפִּיקָה לָהֶם מָזוֺן<tei:anchor xml:id="note_28"/> וּמַֽיִם</tei:l>
          <tei:l>בַּעֲבוּרָהּ אַל תִּמְנַע מַֽיִם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tefillat_geshem_including_the_matriarchs_with_stanzas_elazar/10"/>
        <tei:lg>
          <tei:l>זְכוֹר</tei:l>
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>קִיד שָׁתוֹת טוֹבֵל חָמֵשׁ טְבִילוֹת בַּמַּֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">צ</tei:seg>וֹעֶה וּמְַרחִיץ כַּפָּיו בְּקִדּוּשׁ מַֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">ק</tei:seg>וֹרֵא וּמַזֶּה טָהֳרַת מַֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">רֻ</tei:seg>חַק מֵעַם פַּֽחַז כַּמַּֽיִם</tei:l>
          <tei:l>בַּעֲבוּרוֹ אַל תִּמְנַע מַֽיִם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tefillat_geshem_including_the_matriarchs_with_stanzas_elazar/11"/>
        <tei:lg>
          <tei:l>זְכוֹר</tei:l>
          <tei:l><tei:seg type="acrostic">בָּ</tei:seg>אָה וְהִתְיַצְּבָה מֵרָחֺק<tei:anchor xml:id="note_29"/> לַמַּֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>תֹף וּמָחוֹל<tei:anchor xml:id="note_30"/> עָנְתָה<tei:anchor xml:id="note_31"/> בְּתוֹךְ הַמַּֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">אָ</tei:seg>חוֹת וּנְבִיאָה<tei:anchor xml:id="note_32"/> שֶׁשָּׁאֲבָה בְּשָׂשׂוֹן מַֽיִם<tei:anchor xml:id="note_33"/></tei:l>
          <tei:l><tei:seg type="acrostic">אֵֽ</tei:seg>צֶל בְּאֵרָהּ הַמִּטַּלְטֵל<tei:anchor xml:id="note_34"/> שָׁתִֽינוּ מַֽיִם</tei:l>
          <tei:l>בְּצִדְקָהּ חֹן חַשְׁרַת מַֽיִם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tefillat_geshem_including_the_matriarchs_with_stanzas_elazar/12"/>
        <tei:lg>
          <tei:l>זְכוֹר</tei:l>
          <tei:l><tei:seg type="acrostic">שְׁ</tei:seg>נֵים עָשָׂר שְׁבָטִים שֶׁהֶעֱבְַרתָּ בְּגִזְרַת מַֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">שֶׁ</tei:seg>הִמְתַּקְתָּ לָֽמוֹ מְרִירוּת מַֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">תֹּ</tei:seg>לְדוֹתָם נִשְׁפַּךְ דָּמָם עָלֶֽיךָ כַּמַּֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">תֵּֽ</tei:seg>פֶן כִּי נָפְשֵֽׁנוּ אָפְפוּ מַֽיִם</tei:l>
          <tei:l>בְּצִדְקָם חֹן חַשְׁרַת מַֽיִם</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" n="1" target="#note_1">
      <tei:p>Isaiah 51:2</tei:p>
    </tei:note>
    <tei:note type="commentary" n="2" target="#note_2">
      <tei:p>Bereshit Rabbah 39:14, on Genesis 12:5. Sarah participated in converting women to monotheism.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="3" target="#note_3">
      <tei:p>Bava Metzia 87a.12-13. Sarah’s breasts miraculously opened up in her old age, that she was able to feed even others’ children.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="4" target="#note_4">
      <tei:p>Genesis 18:12</tei:p>
    </tei:note>
    <tei:note type="commentary" n="5" target="#note_5">
      <tei:p>Genesis 18:11</tei:p>
    </tei:note>
    <tei:note type="commentary" n="6" target="#note_6">
      <tei:p>Genesis 24:15</tei:p>
    </tei:note>
