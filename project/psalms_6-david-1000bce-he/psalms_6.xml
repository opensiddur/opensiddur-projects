  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/6">
        <tei:head>תהלים ו׳</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/6/1"/>
        <tei:lg>
          <tei:l>לַמְנַצֵּ֣חַ בִּ֭נְגִינוֹת עַֽל־הַשְּׁמִינִ֗ית</tei:l>
          <tei:l>מִזְמ֥וֹר לְדָוִֽד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/6/2/a"/>
        <tei:lg>
          <tei:l>יְֽהוָ֗ה אַל־בְּאַפְּךָ֥ תוֹכִיחֵ֑נִי</tei:l>
          <tei:l>וְֽאַל־בַּחֲמָתְךָ֥ תְיַסְּרֵֽנִי׃</tei:l>
          <tei:l>חָנֵּ֥נִי יְהוָה֮</tei:l>
          <tei:l>כִּ֤י אֻמְלַ֫ל אָ֥נִי</tei:l>
          <tei:l>רְפָאֵ֥נִי יְהוָ֑ה כִּ֖י נִבְהֲל֣וּ עֲצָמָֽי׃</tei:l>
          <tei:l>וְ֭נַפְשִׁי נִבְהֲלָ֣ה מְאֹ֑ד</tei:l>
          <tei:l>ואת [וְאַתָּ֥ה] יְ֝הוָ֗ה</tei:l>
          <tei:l>עַד־מָתָֽי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/6/5/a"/>
        <tei:lg>
          <tei:l>שׁוּבָ֣ה יְ֭הוָה</tei:l>
          <tei:l>חַלְּצָ֣ה נַפְשִׁ֑י</tei:l>
          <tei:l>ה֝וֹשִׁיעֵ֗נִי לְמַ֣עַן חַסְדֶּֽךָ׃</tei:l>
          <tei:l>כִּ֤י אֵ֣ין בַּמָּ֣וֶת זִכְרֶ֑ךָ</tei:l>
          <tei:l>בִּ֝שְׁא֗וֹל</tei:l>
          <tei:l>מִ֣י יֽוֹדֶה־לָּֽךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>יָגַ֤עְתִּי ׀ בְּֽאַנְחָתִ֗י אַשְׂחֶ֣ה</tei:l>
          <tei:l>בְכָל־לַ֭יְלָה מִטָּתִ֑י</tei:l>
          <tei:l>בְּ֝דִמְעָתִ֗י עַרְשִׂ֥י אַמְסֶֽה׃</tei:l>
          <tei:l>עָֽשְׁשָׁ֣ה</tei:l>
          <tei:l>מִכַּ֣עַס עֵינִ֑י</tei:l>
          <tei:l>עָֽ֝תְקָ֗ה</tei:l>
          <tei:l>בְּכָל־צוֹרְרָֽי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/6/9/a"/>
        <tei:lg>
          <tei:l>ס֣וּרוּ מִ֭מֶּנִּי</tei:l>
          <tei:l>כָּל־פֹּ֣עֲלֵי אָ֑וֶן</tei:l>
          <tei:l>כִּֽי־שָׁמַ֥ע יְ֝הוָ֗ה ק֣וֹל בִּכְיִֽי׃</tei:l>
          <tei:l>שָׁמַ֣ע יְ֭הוָה תְּחִנָּתִ֑י</tei:l>
          <tei:l>יְ֝הוָ֗ה תְּֽפִלָּתִ֥י יִקָּֽח׃</tei:l>
          <tei:l>יֵבֹ֤שׁוּ ׀ וְיִבָּהֲל֣וּ מְ֭אֹד</tei:l>
          <tei:l>כָּל־אֹיְבָ֑י</tei:l>
          <tei:l>יָ֝שֻׁ֗בוּ</tei:l>
          <tei:l>יֵבֹ֥שׁוּ</tei:l>
          <tei:l>רָֽגַע׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
