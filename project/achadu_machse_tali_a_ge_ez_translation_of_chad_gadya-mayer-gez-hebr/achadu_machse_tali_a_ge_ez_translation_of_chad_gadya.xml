    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:achadu_machse_tali_a_ge_ez_translation_of_chad_gadya">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:achadu_machse_tali_a_ge_ez_translation_of_chad_gadya/1"/>
        <tei:lg>
          <tei:l>אַחַדוּ מַחְסֶא טַלִי,</tei:l>
          <tei:l>אַחַדוּ מַחְסֶא טַלִי,</tei:l>
          <tei:l>זוּ־תַשָׂיַטַה אַבָא</tei:l>
          <tei:l>בַכֶּלְאֵתּוּ בֶרֻרָת,</tei:l>
          <tei:l>אַחַדוּ מַחְסֶא טַלִי,</tei:l>
          <tei:l>אַחַדוּ מַחְסֶא טַלִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:achadu_machse_tali_a_ge_ez_translation_of_chad_gadya/2"/>
        <tei:lg>
          <tei:l>וַבוֹאַה דֶמַּת</tei:l>
          <tei:l>וַבַלְעָא מַחְסֶאַה טַלִי,</tei:l>
          <tei:l>זוּ־תַשָׂיַטַה אַבָא</tei:l>
          <tei:l>בַכֶּלְאֵתּוּ בֶרֻרָת,</tei:l>
          <tei:l>אַחַדוּ מַחְסֶא טַלִי,</tei:l>
          <tei:l>אַחַדוּ מַחְסֶא טַלִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:achadu_machse_tali_a_ge_ez_translation_of_chad_gadya/3"/>
        <tei:lg>
          <tei:l>וַבוֹאַה כַּלְב,</tei:l>
          <tei:l>וַחֵכַּה לַדֶמַּתַה,</tei:l>
          <tei:l>זוּ־בַלְעָא מַחְסֶאַה טַלִי,</tei:l>
          <tei:l>זוּ־תַשָׂיַטַה אַבָא</tei:l>
          <tei:l>בַכֶּלְאֵתּוּ בֶרֻרָת,</tei:l>
          <tei:l>אַחַדוּ מַחְסֶא טַלִי,</tei:l>
          <tei:l>אַחַדוּ מַחְסֶא טַלִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:achadu_machse_tali_a_ge_ez_translation_of_chad_gadya/4"/>
        <tei:lg>
          <tei:l>וַבוֹאַה בַתְר,</tei:l>
          <tei:l>וַזַבַטָא לַכַּלְבַה,</tei:l>
          <tei:l>זוּ־חֵכַּה לַדֶמַּתַה,</tei:l>
          <tei:l>זוּ־בַלְעָא מַחְסֶאַה טַלִי,</tei:l>
          <tei:l>זוּ־תַשָׂיַטַה אַבָא</tei:l>
          <tei:l>בַכֶּלְאֵתּוּ בֶרֻרָת,</tei:l>
          <tei:l>אַחַדוּ מַחְסֶא טַלִי,</tei:l>
          <tei:l>אַחַדוּ מַחְסֶא טַלִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:achadu_machse_tali_a_ge_ez_translation_of_chad_gadya/5"/>
        <tei:lg>
          <tei:l>וַבוֹאַת אֶסַת,</tei:l>
          <tei:l>וַאַוְעַיַת בַתְרַה,</tei:l>
          <tei:l>זוּ־זַבַטָא לַכַּלְבַה,</tei:l>
          <tei:l>זוּ־חֵכַּה לַדֶמַּתַה,</tei:l>
          <tei:l>זוּ־בַלְעָא מַחְסֶאַה טַלִי,</tei:l>
          <tei:l>זוּ־תַשָׂיַטַה אַבָא</tei:l>
          <tei:l>בַכֶּלְאֵתּוּ בֶרֻרָת,</tei:l>
          <tei:l>אַחַדוּ מַחְסֶא טַלִי,</tei:l>
          <tei:l>אַחַדוּ מַחְסֶא טַלִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:achadu_machse_tali_a_ge_ez_translation_of_chad_gadya/6"/>
        <tei:lg>
          <tei:l>וַבוֹאַה מָי,</tei:l>
          <tei:l>וַאַטְפֶֿאַה אֶסַתַה,</tei:l>
          <tei:l>זוּ־אַוְעַיַת בַתְרַה,</tei:l>
          <tei:l>זוּ־זַבַטָא לַכַּלְבַה,</tei:l>
          <tei:l>זוּ־חֵכַּה לַדֶמַּתַה,</tei:l>
          <tei:l>זוּ־בַלְעָא מַחְסֶאַה טַלִי,</tei:l>
          <tei:l>זוּ־תַשָׂיַטַה אַבָא</tei:l>
          <tei:l>בַכֶּלְאֵתּוּ בֶרֻרָת,</tei:l>
          <tei:l>אַחַדוּ מַחְסֶא טַלִי,</tei:l>
          <tei:l>אַחַדוּ מַחְסֶא טַלִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:achadu_machse_tali_a_ge_ez_translation_of_chad_gadya/7"/>
        <tei:lg>
          <tei:l>וַבוֹאַה לָהְם,</tei:l>
          <tei:l>וַסַתְיַה מָיַה,</tei:l>
          <tei:l>זוּ־אַטְפֶֿאַה אֶסַתַה,</tei:l>
          <tei:l>זוּ־אַוְעַיַת בַתְרַה,</tei:l>
          <tei:l>זוּ־זַבַטָא לַכַּלְבַה,</tei:l>
          <tei:l>זוּ־חֵכַּה לַדֶמַּתַה,</tei:l>
          <tei:l>זוּ־בַלְעָא מַחְסֶאַה טַלִי,</tei:l>
          <tei:l>זוּ־תַשָׂיַטַה אַבָא</tei:l>
          <tei:l>בַכֶּלְאֵתּוּ בֶרֻרָת,</tei:l>
          <tei:l>אַחַדוּ מַחְסֶא טַלִי,</tei:l>
          <tei:l>אַחַדוּ מַחְסֶא טַלִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:achadu_machse_tali_a_ge_ez_translation_of_chad_gadya/8"/>
        <tei:lg>
          <tei:l>וַבוֹאַה מַרָקֶח,</tei:l>
          <tei:l>וַטַבְחַה לָהְמַה,</tei:l>
          <tei:l>זוּ־סַתְיַה מָיַה,</tei:l>
          <tei:l>זוּ־אַטְפֶֿאַה אֶסַתַה,</tei:l>
          <tei:l>זוּ־אַוְעַיַת בַתְרַה,</tei:l>
          <tei:l>זוּ־זַבַטָא לַכַּלְבַה,</tei:l>
          <tei:l>זוּ־חֵכַּה לַדֶמַּתַה,</tei:l>
          <tei:l>זוּ־בַלְעָא מַחְסֶאַה טַלִי,</tei:l>
          <tei:l>זוּ־תַשָׂיַטַה אַבָא</tei:l>
          <tei:l>בַכֶּלְאֵתּוּ בֶרֻרָת,</tei:l>
          <tei:l>אַחַדוּ מַחְסֶא טַלִי,</tei:l>
          <tei:l>אַחַדוּ מַחְסֶא טַלִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:achadu_machse_tali_a_ge_ez_translation_of_chad_gadya/9"/>
        <tei:lg>
          <tei:l>וַבוֹאַה מַלְאָכַּה מוֹת,</tei:l>
          <tei:l>וַטַבְחַה מַרָקֶחַה,</tei:l>
          <tei:l>זוּ־טַבְחַה לָהְמַה,</tei:l>
          <tei:l>זוּ־סַתְיַה מָיַה,</tei:l>
          <tei:l>זוּ־אַטְפֶֿאַה אֶסַתַה,</tei:l>
          <tei:l>זוּ־אַוְעַיַת בַתְרַה,</tei:l>
          <tei:l>זוּ־זַבַטָא לַכַּלְבַה,</tei:l>
          <tei:l>זוּ־חֵכַּה לַדֶמַּתַה,</tei:l>
          <tei:l>זוּ־בַלְעָא מַחְסֶאַה טַלִי,</tei:l>
          <tei:l>זוּ־תַשָׂיַטַה אַבָא</tei:l>
          <tei:l>בַכֶּלְאֵתּוּ בֶרֻרָת,</tei:l>
          <tei:l>אַחַדוּ מַחְסֶא טַלִי,</tei:l>
          <tei:l>אַחַדוּ מַחְסֶא טַלִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:achadu_machse_tali_a_ge_ez_translation_of_chad_gadya/10"/>
        <tei:lg>
          <tei:l>וַבוֹאַה אֶגְזִאַבְחֵר בֻּרֻךְּ וֶאֶתוּ,</tei:l>
          <tei:l>וַטַבְחַה מַלְאָכַּה מוֹת,</tei:l>
          <tei:l>זוּ־טַבְחַה מַרָקֶחַה,</tei:l>
          <tei:l>זוּ־טַבְחַה לָהְמַה,</tei:l>
          <tei:l>זוּ־סַתְיַה מָיַה,</tei:l>
          <tei:l>זוּ־אַטְפֶֿאַה אֶסַתַה,</tei:l>
          <tei:l>זוּ־אַוְעַיַת בַתְרַה,</tei:l>
          <tei:l>זוּ־זַבַטָא לַכַּלְבַה,</tei:l>
          <tei:l>זוּ־חֵכַּה לַדֶמַּתַה,</tei:l>
          <tei:l>זוּ־בַלְעָא מַחְסֶאַה טַלִי,</tei:l>
          <tei:l>זוּ־תַשָׂיַטַה אַבָא</tei:l>
          <tei:l>בַכֶּלְאֵתּוּ בֶרֻרָת,</tei:l>
          <tei:l>אַחַדוּ מַחְסֶא טַלִי,</tei:l>
          <tei:l>אַחַדוּ מַחְסֶא טַלִי׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
