  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:uvemaqhalot_36446">
        <tei:head>וּבְמַקְהֲלוֹת</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:uvemaqhalot_36446/1"/>
        <tei:lg>
          <tei:l>וּבְמַקְהֲלוֹת רִבְבוֹת עַמְּךָ בֵּית יִשְׂרָאֵל</tei:l>
          <tei:l>בְּרִנָּה יִתְפָּאֵר שִׁמְךָ,</tei:l>
          <tei:l>מַלְכֵּנוּ, בְּכָל דּוֹר וָדוֹר,</tei:l>
          <tei:l>שֶׁכֵּן חוֹבַת כָּל הַיְצוּרִים לְפָנֶיךָ,</tei:l>
          <tei:l>יְיָ אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ,</tei:l>
          <tei:l>לְהוֹדוֹת לְהַלֵּל לְשַׁבֵּחַ,</tei:l>
          <tei:l>לְפָאֵר לְרוֹמֵם לְהַדֵּר,</tei:l>
          <tei:l>לְבָרֵךְ, לְעַלֵּה וּלְקַלֵּס</tei:l>
          <tei:l>עַל כָּל דִּבְרֵי שִׁירוֹת וְתִשְׁבְּחוֹת</tei:l>
          <tei:l>דָּוִד בֶּן יִשַׁי עַבְדְּךָ, מְשִׁיחֶךָ.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
