    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:travelers_prayer_of_a_fighter_pilot_goren">
        <tei:head>תְּפִלַּת הַדֶּרֶךְ לְטַיָּס</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:travelers_prayer_of_a_fighter_pilot_goren/1"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן מִלְּפָנֶיךָ</tei:l>
          <tei:l>יְיָ אֱלֹהֵינוּ וֶאֱלֹהֵי אֲבוֹתֵינוּ</tei:l>
          <tei:l>הַשָּׂם עָבִים רְכוּבוֹ</tei:l>
          <tei:l>הַמְּהַלֵּךְ עַל־כַּנְפֵי־רוּחַ <tei:bibl>(תהלים קד:ג)</tei:bibl></tei:l>
          <tei:l>שֶׁתִּשָּׂאֵנוּ לְשָׁלוֹם</tei:l>
          <tei:l>וְתוֹלִיכֵנוּ לְשָׁלוֹם</tei:l>
          <tei:l>וְתַגִּיעֵנוּ לִמְחוֹז חֶפְצֵנוּ</tei:l>
          <tei:l>לְחַיִּים לְשִׂמְחָה וּלְשָׁלוֹם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:travelers_prayer_of_a_fighter_pilot_goren/2"/>
        <tei:lg>
          <tei:l>וְתַצִּילֵנוּ מִכַּף כׇּל אוֹיֵב</tei:l>
          <tei:l>וְאוֹרֵב בַּשָּׁמַיִם וּבָאָרֶץ,</tei:l>
          <tei:l>וּמֵרוּחוֹת שֶׁאֵינָן מְצוּיוֹת</tei:l>
          <tei:l>וּמִכׇּל מִינֵי תַּקָּלוֹת</tei:l>
          <tei:l>בַּהַמְרָאָה בָּאֲוִיר וּבַנְּחִיתָה</tei:l>
          <tei:l>וּמִמִּינֵי פֻרְעָנוּיוֹת הַמִּתְרַגְּשׁוֹת לָבֹא.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:travelers_prayer_of_a_fighter_pilot_goren/3"/>
        <tei:lg>
          <tei:l>הֱיֵה נָא מַצְלִיחַ דַּרְכֵּנוּ,</tei:l>
          <tei:l>חַזְּקֵנוּ וְאַמְּצֵנוּ</tei:l>
          <tei:l>לְהָגֵן בְּאֶבְרַת קָדְשֶׁךָ</tei:l>
          <tei:l>עַל שְׁמֵי יִשְׂרָאֵל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:travelers_prayer_of_a_fighter_pilot_goren/4"/>
        <tei:lg>
          <tei:l>וּתְעַטְּרֵנוּ בְּמָגֵן יְשׁוּעָה</tei:l>
          <tei:l>וּבַעֲטֶרֶת נִצָּחוֹן,</tei:l>
          <tei:l>כִּי אַתָּה תִשְׁמַע מִן הַשָּׁמַיִם</tei:l>
          <tei:l>תְּפִלַּת עַמְּךָ יִשְׂרָאֵל בְּרַחֲמִים,</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְיָ שׁוֹמֵעַ תְּפִלָּה.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
