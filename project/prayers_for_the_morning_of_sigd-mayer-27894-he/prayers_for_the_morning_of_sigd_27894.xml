  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd_27894">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd_27894/1"/>
        <tei:lg>
          <tei:l>וְעָלוּ‎ הָהָרָה בְּכׇל־שָׁנָה,</tei:l>
          <tei:l>וְעָלוּ‎ הָהָרָה בְּכׇל־שָׁנִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd_27894/2"/>
        <tei:lg>
          <tei:l>וְעָלוּ‎ הָהָרָה בְּכׇל־שָׁנִים,</tei:l>
          <tei:l>לְמַעַן יִסְגְּדוּ לַיהוה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd_27894/3"/>
        <tei:lg>
          <tei:l>וְעָלוּ‎ הָהָרָה בְּכׇל־שָׁנִים,</tei:l>
          <tei:l>וְקָרְאוּ‎ לִפְנֵי יהוה אֱלֹהֵיהֶם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd_27894/4"/>
        <tei:lg>
          <tei:l>לְוִיִּים‎ בִּמְקוֹמוֹתֵיהֶם,</tei:l>
          <tei:l>לְוִיִּים‎ בְּמַעַמְדֵיהֶם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd_27894/5"/>
        <tei:lg>
          <tei:l>קַדְמִיאֵל סַטְרִיאֵל אַרְאָיָה,</tei:l>
          <tei:l>וְקָרְאוּ‎ לִפְנֵי יהוה אֱלֹהֵיהֶם׃</tei:l>
        </tei:lg>
      </tei:div>
