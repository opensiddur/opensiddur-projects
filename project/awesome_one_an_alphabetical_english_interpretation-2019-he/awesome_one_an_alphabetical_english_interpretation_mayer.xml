      <tei:div corresp="urn:x-opensiddur:text:poem:awesome_one_an_alphabetical_english_interpretation_mayer">
        <tei:head>אַדִּיר הוּא</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:awesome_one_an_alphabetical_english_interpretation_mayer/1"/>
        <tei:lg>
          <tei:l>אַדִּיר הוּא, אַדִּיר הוּא</tei:l>
          <tei:l>יִבְנֶה בֵּיתוֹ בְּקָרוֹב.</tei:l>
          <tei:l>בִּמְהֵרָה, בִּמְהֵרָה, בְּיָמֵינוּ בְּקָרוֹב.</tei:l>
          <tei:l>אֵל בְּנֵה, אֵל בְּנֵה,</tei:l>
          <tei:l>בְּנֵה בֵּיתְךָ בְּקָרוֹב.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
