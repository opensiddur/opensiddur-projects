  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:gates_of_light_gates_of_blessing_obadyah">
        <tei:head>שַׁעֲרֵי אוֹרָה שַׁעֲרֵי בְּרָכָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gates_of_light_gates_of_blessing_obadyah/1"/>
        <tei:lg>
          <tei:l>אָבִ֫ינוּ שֶׁבַּשָּׁמַ֫יִם,</tei:l>
          <tei:l>קַבֵּל בְּרַחֲמִים צַעֲקַתֵ֫ינוּ,</tei:l>
          <tei:l>שְׁמַע בְּרָצוֹן תְּפִלָּתֵ֫נוּ,</tei:l>
          <tei:l>עֲנֵה קוֹל עֲתִרָתֵּ֫ינוּ,</tei:l>
          <tei:l>וּפְתַח לָ֫נוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gates_of_light_gates_of_blessing_obadyah/2"/>
        <tei:lg>
          <tei:l>שַׁעֲרֵי <tei:seg type="acrostic">א</tei:seg>וֹרָה</tei:l>
          <tei:l>שַׁעֲרֵי <tei:seg type="acrostic">בְּ</tei:seg>רָכָה,</tei:l>
          <tei:l>שְׂעָרִי <tei:seg type="acrostic">גִּ</tei:seg>לָּה,</tei:l>
          <tei:l>שַׁעֲרֵי <tei:seg type="acrostic">דִּ</tei:seg>יצָה,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gates_of_light_gates_of_blessing_obadyah/3"/>
        <tei:lg>
          <tei:l>שַׁעֲרֵי <tei:seg type="acrostic">הַ</tei:seg>צְלָחָה,</tei:l>
          <tei:l>שְׂעָרִי <tei:seg type="acrostic">וַ֫</tei:seg>עַד טוֹב,</tei:l>
          <tei:l>שַׁעֲרֵי <tei:seg type="acrostic">זְ</tei:seg>כִיּוֹת,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gates_of_light_gates_of_blessing_obadyah/4"/>
        <tei:lg>
          <tei:l>שַׁעֲרֵי <tei:seg type="acrostic">חֶ</tei:seg>מְלָה,</tei:l>
          <tei:l>שַׁעֲרֵי <tei:seg type="acrostic">ט</tei:seg>וֹבָה,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gates_of_light_gates_of_blessing_obadyah/5"/>
        <tei:lg>
          <tei:l>שַׁעֲרֵי <tei:seg type="acrostic">יְ</tei:seg>שׁוּעָה,</tei:l>
          <tei:l>שַׁעֲרֵי <tei:seg type="acrostic">כַּ</tei:seg>פָּרָה,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gates_of_light_gates_of_blessing_obadyah/6"/>
        <tei:lg>
          <tei:l>שַׁעֲרֵי <tei:seg type="acrostic">לִ</tei:seg>מּוּד,</tei:l>
          <tei:l>שַׁעֲרֵי <tei:seg type="acrostic">מְ</tei:seg>חִילָה,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gates_of_light_gates_of_blessing_obadyah/7"/>
        <tei:lg>
          <tei:l>שַׁעֲרֵי <tei:seg type="acrostic">נֶ</tei:seg>חָמָה,</tei:l>
          <tei:l>שַׁעֲרֵי <tei:seg type="acrostic">סְ</tei:seg>לִיחָה,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gates_of_light_gates_of_blessing_obadyah/8"/>
        <tei:lg>
          <tei:l>שַׁעֲרֵי <tei:seg type="acrostic">עֶ</tei:seg>זְרָה,</tei:l>
          <tei:l>שַׁעֲרֵי <tei:seg type="acrostic">פְּ</tei:seg>דוּת,</tei:l>
          <tei:l>שַׁעֲרֵי <tei:seg type="acrostic">צְ</tei:seg>דָקָה,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gates_of_light_gates_of_blessing_obadyah/9"/>
        <tei:lg>
          <tei:l>שַׁעֲרֵי <tei:seg type="acrostic">קְ</tei:seg>דוּשָׁה,</tei:l>
          <tei:l>שַׁעֲרֵי <tei:seg type="acrostic">רְ</tei:seg>פוּאָה שְׁלֵמָה,</tei:l>
          <tei:l>שַׁעֲרֵי <tei:seg type="acrostic">שָׁ</tei:seg>לוֹם,</tei:l>
          <tei:l>שַׁעֲרֵי <tei:seg type="acrostic">תּ</tei:seg>וֹרָה,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gates_of_light_gates_of_blessing_obadyah/10"/>
        <tei:lg>
          <tei:l>וְיִכְתְּבֵ֫נוּ בְּסֵ֫פֶר חַיִּים טוֹבִים.</tei:l>
          <tei:l>וְכֵן יְהִי רָצוֹן</tei:l>
          <tei:l>וְנֹאמַר אָמֵן.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>