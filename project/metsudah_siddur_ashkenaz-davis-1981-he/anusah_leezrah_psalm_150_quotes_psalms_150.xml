      <tei:div corresp="urn:x-opensiddur:text:poem:anusah_leezrah/psalm_150/quotes/psalms_150">
        <tei:p><j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:poem:anusah_leezrah/psalm_150/quotes/psalms_150/chol_arvit_birkat_halevanah"><tei:binary value="true"/></tei:f></tei:fs></j:conditional><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anusah_leezrah/psalm_150/quotes/psalms_150/2"/>הַלְ֒לוּיָהּ הַלְ֒לוּ־אֵל בְּקָדְשׁוֹ הַלְ֒לֽוּהוּ בִּרְקִֽיעַ עֻזּוֹ: הַלְ֒לֽוּהוּ בִגְבוּרֹתָיו הַלְ֒לֽוּהוּ כְּרֹב גֻּדְלוֹ: הַלְ֒לֽוּהוּ בְּתֵֽקַע שׁוֹפָר הַלְ֒לֽוּהוּ בְּנֵֽבֶל וְכִנּוֹר: הַלְ֒לֽוּהוּ בְּתֹף וּמָחוֹל הַלְ֒לֽוּהוּ בְּמִנִּים וְעֻגָב: הַלְ֒לֽוּהוּ בְצִלְצְלֵי־שָֽׁמַע הַלְ֒לֽוּהוּ בְּצִלְצְלֵי תְרוּעָה: כֹּל הַנְּשָׁמָה תְּהַלֵּל יָהּ הַלְ֒לוּיָהּ:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/150/1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:poem:anusah_leezrah/psalm_150/quotes/psalms_150/chol_arvit_birkat_halevanah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anusah_leezrah/psalm_150/quotes/psalms_150/1"/>הַלְ֒לוּיָהּ הַֽלְ֒לוּ־אֵל בְּקָדְשׁוֹ הַלְ֒לֽוּהוּ בִּרְקִֽיעַ עֻזּוֹ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/150/2"/>הַלְ֒לֽוּהוּ בִּגְבוּרֹתָיו הַלְ֒לֽוּהוּ כְּרֹב גֻּדְלוֹ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/150/3"/>הַלְ֒לֽוּהוּ בְּתֵֽקַע שׁוֹפָר הַלְ֒לֽוּהוּ בְּנֵֽבֶל וְכִנּוֹר: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/150/4"/>הַלְ֒לֽוּהוּ בְּתֹף וּמָחוֹל הַלְ֒לֽוּהוּ בְּמִנִּים וְעֻגָב: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/150/5"/>הַלְ֒לֽוּהוּ בְצִלְצְלֵי־שָֽׁמַע הַלְ֒לֽוּהוּ בְּצִלְצְלֵי תְרוּעָה: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/150/6"/>כֹּל הַנְּ֒שָׁמָה תְּהַלֵּל יָהּ הַלְ֒לוּיָהּ: <tei:milestone unit="verse"/>כֹּל הַנְּ֒שָׁמָה תְּהַלֵּל יָהּ הַלְ֒לוּיָהּ:
