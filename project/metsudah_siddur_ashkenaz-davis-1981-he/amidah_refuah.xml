      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/refuah">
        <tei:p><j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/refuah/chol_arvit_shemoneh_esreh_refuah"><tei:binary value="true"/></tei:f></tei:fs></j:conditional><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/26"/>רְפָאֵֽנוּ יְהֹוָה וְנֵרָפֵא הוֹשִׁיעֵֽנוּ וְנִוָּשֵֽׁעָה כִּי תְהִלָּתֵֽנוּ אָֽתָּה וְהַעֲלֵה רְפוּאָה שְׁלֵמָה לְכָל מַכּוֹתֵֽינוּ כִּי אֵל מֶֽלֶךְ רוֹפֵא נֶאֱמָן וְרַחֲמָן אָֽתָּה: בָּרוּךְ אַתָּה יְהֹוָה רוֹפֵא חוֹלֵי עַמּוֹ יִשְׂרָאֵל:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/refuah/chol_arvit_shemoneh_esreh_refuah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/23"/>רְפָאֵֽנוּ יְהֹוָה וְנֵרָפֵא הוֹשִׁיעֵֽנוּ וְנִוָּשֵֽׁעָה כִּי תְהִלָּתֵֽנוּ אָֽתָּה וְהַעֲלֵה רְפוּאָה שְׁלֵמָה לְכָל מַכּוֹתֵֽינוּ
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<tei:note type="instruction" xml:lang="he">מי שרוצה להתפלל על החולה יאמר כאן תחנה זו:</tei:note>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/refuah/chol_arvit_shemoneh_esreh_refuah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/24"/><tei:hi rend="small">יְהִי רָצוֹן מִלְּ֒פָנֶֽיךָ יְהֹוָה אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ שֶׁתִּשְׁלַח מְהֵרָה רְפוּאָה שְׁלֵמָה מִן הַשָּׁמַֽיִם, רְפוּאַת הַנֶּֽפֶשׁ וּרְפוּאַת הַגּוּף, לַחוֹלֶה (פלוני/פלונית) בֶּן/בַּת (פלונית) בְּתוֹךְ שְׁאָר חוֹלֵי יִשְׂרָאֵל:</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/refuah/chol_arvit_shemoneh_esreh_refuah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/25"/>כִּי אֵל מֶֽלֶךְ רוֹפֵא נֶאֱמָן וְרַחֲמָן אָֽתָּה: בָּרוּךְ אַתָּה יְהֹוָה רוֹפֵא חוֹלֵי עַמּוֹ יִשְׂרָאֵל:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/></tei:p>
