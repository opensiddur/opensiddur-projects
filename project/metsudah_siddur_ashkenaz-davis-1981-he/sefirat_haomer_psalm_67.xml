      <tei:div corresp="urn:x-opensiddur:text:prayer:sefirat_haomer/psalm_67">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/67/1"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/psalm_67/20"/>לַמְנַצֵּֽחַ בִּנְגִינוֹת מִזְמוֹר שִׁיר: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/67/2"/>אֱלֹהִים יְחָנֵּֽנוּ וִיבָרְ֒כֵֽנוּ יָאֵר פָּנָיו אִתָּֽנוּ סֶֽלָה: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/67/3"/>לָדַֽעַת בָּאָֽרֶץ דַּרְכֶּֽךָ בְּכָל גּוֹיִם יְשׁוּעָתֶֽךָ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/67/4"/>יוֹדֽוּךָ עַמִּים אֱלֹהִים יוֹדֽוּךָ עַמִּים כֻּלָּם: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/67/5"/>יִשְׂמְ֒חוּ וִירַנְּ֒נוּ לְאֻמִּים כִּי תִשְׁפּוֹט עַמִּים מִישׁוֹר וּלְאֻמִּים בָּאָֽרֶץ תַּנְחֵם סֶֽלָה: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/67/6"/>יוֹדֽוּךָ עַמִּים אֱלֹהִים יוֹדֽוּךָ עַמִּים כֻּלָּם: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/67/7"/>אֶֽרֶץ נָתְ֒נָה יְבוּלָהּ יְבָרְ֒כֵֽנוּ אֱלֹהִים אֱלֹהֵֽינוּ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/67/8"/>יְבָרְ֒כֵֽנוּ אֱלֹהִים וְיִירְ֒אוּ אוֹתוֹ כָּל אַפְסֵי אָֽרֶץ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
