      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/keriat_hatorah/reading/hagbahah">
        <tei:head xml:lang="he">הגבהה</tei:head>
        <tei:note type="instruction" xml:lang="he">בעת הגבהת ס"ת לאחר הקריאה היה האר"י ז"ל מסתכל באותיות היטב עד שהיה מכירם לקרות והיה אומר שנמשך אור גדול על האדם ע"י הסתכלות התורה מקרוב עד שיוכל לקרות האותיות היטב. לכן המגביה הס"ת גולל הס"ת על ג' דפין ומגביה ומראה כתיבתה לעם. ובעת ראייתם יש לכרוע ולומר וזאת התורה. ואין לומר וזאת התורה רק נגד הכתב של הס"ת:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:vezot_hatorah"/>
