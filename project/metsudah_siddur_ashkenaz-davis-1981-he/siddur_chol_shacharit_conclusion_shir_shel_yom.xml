  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/conclusion/shir_shel_yom">
        <tei:head xml:lang="he">שיר של יום</tei:head>
        <tei:note type="description" xml:lang="he">נהגו לומר בכל ימי השבוע השיר שהיו הלוים אומרים במקדש. ומקורו במס' סופרים (מס' סופרים י"ח, א) לפיכך נהגו העם לומר מזמורים בעונתן. דתנינן תמן (תמיד פ"ז מ"ד) השיר שהיו הלוים אומרים בביהמ"ק וכו'. שכל המזכיר פסוק בעונתו מעלה עליו כאילו בונה מזבח חדש ומקריב עליו קרבן. ע"כ. (עץ יוסף)</tei:note>
        <j:conditional xml:id="when_1">
          <tei:note type="instruction" xml:lang="he">בראשון בשבת:</tei:note>
          <tei:fs type="opensiddur:day-of-week">
            <tei:f name="hebrew-day">
              <tei:numeric value="1"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:hayom_yom_rishon"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/24"/>
        <j:endConditional target="#when_1"/>
        <j:conditional xml:id="when_2">
          <tei:note type="instruction" xml:lang="he">בשני בשבת:</tei:note>
          <tei:fs type="opensiddur:day-of-week">
            <tei:f name="hebrew-day">
              <tei:numeric value="2"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:hayom_yom_sheni"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/48"/>
        <j:endConditional target="#when_2"/>
        <j:conditional xml:id="when_3">
          <tei:note type="instruction" xml:lang="he">בשלישי בשבת:</tei:note>
          <tei:fs type="opensiddur:day-of-week">
            <tei:f name="hebrew-day">
              <tei:numeric value="3"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:hayom_yom_shelishi"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/82"/>
        <j:endConditional target="#when_3"/>
        <j:conditional xml:id="when_4">
          <tei:note type="instruction" xml:lang="he">ברביעי בשבת:</tei:note>
          <tei:fs type="opensiddur:day-of-week">
            <tei:f name="hebrew-day">
              <tei:numeric value="4"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:hayom_yom_revii"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/94"/>
        <j:endConditional target="#when_4"/>
        <j:conditional xml:id="when_5">
          <tei:note type="instruction" xml:lang="he">בחמישי בשבת:</tei:note>
          <tei:fs type="opensiddur:day-of-week">
            <tei:f name="hebrew-day">
              <tei:numeric value="5"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:hayom_yom_chamishi"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/81"/>
        <j:endConditional target="#when_5"/>
        <j:conditional xml:id="when_6">
          <tei:note type="instruction" xml:lang="he">בשישי בשבת:</tei:note>
          <tei:fs type="opensiddur:day-of-week">
            <tei:f name="hebrew-day">
              <tei:numeric value="6"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:hayom_yom_shishi"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/93"/>
        <j:endConditional target="#when_6"/>
      </tei:div>
