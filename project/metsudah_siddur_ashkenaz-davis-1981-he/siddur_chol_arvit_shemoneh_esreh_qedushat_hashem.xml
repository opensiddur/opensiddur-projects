      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/arvit/shemoneh_esreh/qedushat_hashem">
        <tei:head xml:lang="he">קדושת השם</tei:head>
        <tei:note type="instruction" xml:lang="he">בחזרת הש"ץ אומרים כאן קדושה:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/qedushat_hashem"/>
        <tei:note type="instruction" xml:lang="he">אם טעה וסיים האל הקדוש אם נזכר בתוך כדי דיבור ואמר המלך הקדוש יצא ואם לאו צריך לחזור לראש התפלה וה"ה אם מסופק אם אמר צריך לחזור לראש. ובימות השנה אם אמר המלך הקדוש אינו חוזר.</tei:note>
      </tei:div>
    </tei:body>
