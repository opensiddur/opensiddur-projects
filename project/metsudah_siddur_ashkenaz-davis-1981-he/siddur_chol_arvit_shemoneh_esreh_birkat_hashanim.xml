      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/arvit/shemoneh_esreh/birkat_hashanim">
        <tei:head xml:lang="he">ברכת השנים</tei:head>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/shanim/barekh_aleinu"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/shanim/veten_berakhah"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/shanim/veten_tal_umatar"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/shanim/al_penei_haadamah"/>
        <tei:note type="instruction" xml:lang="he">אם שכח לומר טַל וּמָטָר ונזכר קודם שהתחיל תְּקַע אומרו במקום שנזכר. התחיל לומר תְּקַע יאמרנה בשׁוֹמֵֽעַ תְּפִלָּה. ואם לא נזכר בש"ת יאמרנה בין ש"ת לרְצֵה. שכח גם שם אם נזכר קודם שעקר רגליו חוזר לברכת השנים ויתחיל בָּרֵךְ עָלֵֽינוּ ויתפלל כסדר. ואם עקר רגליו חוזר לראש התפלה.</tei:note>
      </tei:div>
    </tei:body>
  </tei:text>
