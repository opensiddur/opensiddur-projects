      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/keriat_hatorah/reading/birkat_hagomel">
        <tei:head xml:lang="he">ברכת הגומל</tei:head>
        <tei:note type="instruction" xml:lang="he">ארבעה צריכים להודות יורדי הים כשעלו ממנה והולכי מדברות כשיגיעו ליישוב ומי שהיה חולה ונתרפא ומי שהיה חבוש בבית האסורים ויצא. ואומרה על הס"ת לאחר ברכה אחרונה. אם איחר יש לו תשלומין לברך כל זמן שירצה ונכון שלא לאחר שלשה ימים (שו"ע או"ח ריט).</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkat_hagomel/blessing"/>
        <tei:note type="instruction" xml:lang="he">והקהל עונים:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkat_hagomel/response"/>
      </tei:div>
    </tei:body>
  </tei:text>
