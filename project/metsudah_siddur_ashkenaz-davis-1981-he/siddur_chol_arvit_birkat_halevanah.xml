      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/arvit/birkat_halevanah">
        <tei:head xml:lang="he">ברכת הלבנה</tei:head>
        <tei:note type="instruction" xml:lang="he">אין לקדש החדש אלא בלילה בעת שהלבנה זורחת ונהנין מאורה (אגור). צריך שלא יהיה מסך מבדיל בינו לבין הלבנה. והוא הדין אם נתכסה בעבים. אבל אם נתכסה בעב דק וקלוש מברך. ואם התחיל לברך ונתכסה גומר הברכה.</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/148/1-6"/>
