      <tei:div corresp="urn:x-opensiddur:text:prayer:birkat_hagomel/response">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hagomel/response/4"/>מִי שֶׁגְּ֒מָלְ֒ךָ טוֹב הוּא יִגְמָלְ֒ךָ כָּל־טוֹב סֶֽלָה:
<tei:milestone unit="phrase"/>
<j:conditional xml:id="when_1"><tei:note type="instruction" xml:lang="he">מי שהגיע בנו לבן י"ג שנה ויום אחד יברך האב בשעה שבנו עולה לתורה פעם ראשונה ברכה זו בלא שם ומלכות:</tei:note><tei:fs type="opensiddur:person"><tei:f name="bar-mitzvah-father"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hagomel/response/5"/>בָּרוּךְ שֶׁפְּ֒טָרַֽנִי מֵעָנְשׁוֹ שֶׁל זֶה:
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_1"/></tei:p>
