      <tei:div corresp="urn:x-opensiddur:text:prayer:birkat_hamazon/harachaman/yezakkenu">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/harachaman/yezakkenu/1"/>הָרַחֲמָן הוּא יְזַכֵּֽנוּ לִימוֹת הַמָּשִֽׁיחַ וּלְחַיֵּי הָעוֹלָם הַבָּא, <j:conditional xml:id="inline_2"><j:none><j:any><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="yom-tov"><tei:binary value="true"/></tei:f></tei:fs></j:any></j:none></j:conditional><tei:note type="editorial" xml:lang="en">Psalm 18:51.</tei:note>מַגְדִּיל יְשׁוּעוֹת מַלְכּוֹ<j:endConditional target="#inline_2"/> <j:conditional xml:id="inline_1" type="marked"><tei:note type="instruction" xml:lang="he">בשבת וביו"ט אומר</tei:note><j:any><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="yom-tov"><tei:binary value="true"/></tei:f></tei:fs></j:any></j:conditional><tei:note type="editorial" xml:lang="en">II Samuel 22:51.</tei:note>מִגְדּוֹל יְשׁוּעוֹת מַלְכּוֹ<j:endConditional target="#inline_1"/>, וְעֹֽשֶׂה חֶֽסֶד לִמְשִׁיחוֹ לְדָוִד וּלְזַרְעוֹ עַד עוֹלָם: עֹשֶׂה שָׁלוֹם בִּמְרוֹמָיו, הוּא יַעֲשֶׂה שָׁלוֹם עָלֵֽינוּ וְעַל כָּל־יִשְׂרָאֵל, וְאִמְרוּ אָמֵן:</tei:p>
