      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/pesuqei_dezimrah/mizmor_shir">
        <tei:head xml:lang="he">מזמור שיר</tei:head>
        <tei:note type="instruction" xml:lang="he">מזמור זה אמרו שלמה בשעה שהכניס הארון לבית קודש הקודשים, ולא נענה עד שהזכיר זכות דוד. ולפי שכל פסוקי דזמרה הם פסוקי דוד המלך, לפיכך הקדימו מקודם מזמור זה שבו נגלה צדקתו (ערוה"ש נ, ד)</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:mizmor_shir_chanukat_habayit"/>
      </tei:div>
    </tei:body>
