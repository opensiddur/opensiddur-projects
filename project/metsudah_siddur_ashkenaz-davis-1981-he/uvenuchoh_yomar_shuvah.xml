  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:uvenuchoh_yomar_shuvah">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/10/36"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvenuchoh_yomar_shuvah/41"/>וּבְ֒נֻחֹה יֹאמַר שׁוּבָה יְהֹוָה רִבְ֒בוֹת אַלְפֵי יִשְׂרָאֵל: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/132/8"/>קוּמָה יְהֹוָה לִמְ֒נוּחָתֶֽךָ אַתָּה וַאֲרוֹן עֻזֶּֽךָ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/132/9"/>כֹּהֲנֶֽיךָ יִלְבְּ֒שׁוּ צֶֽדֶק וַחֲסִידֶֽיךָ יְרַנֵּֽנוּ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/132/10"/>בַּעֲבוּר דָּוִד עַבְדֶּֽךָ אַל תָּשֵׁב פְּנֵי מְשִׁיחֶֽךָ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/4/2"/>כִּי לֶֽקַח טוֹב נָתַֽתִּי לָכֶם תּוֹרָתִי אַל תַּעֲזֹֽבוּ: <tei:milestone unit="verse"/>עֵץ חַיִּים הִיא לַמַּחֲזִיקִים בָּהּ וְתוֹמְ֒כֶֽיהָ מְאֻשָּׁר: דְּרָכֶֽיהָ דַּרְכֵי נֹֽעַם וְכָל נְתִיבוֹתֶֽיהָ שָׁלוֹם: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:lamentations/5/21"/>הֲשִׁיבֵֽנוּ יְהֹוָה אֵלֶֽיךָ וְנָשׁוּבָה חַדֵּשׁ יָמֵֽינוּ כְּקֶֽדֶם:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
