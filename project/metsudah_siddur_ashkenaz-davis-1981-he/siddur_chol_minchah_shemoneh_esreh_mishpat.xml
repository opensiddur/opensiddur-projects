        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/mishpat/melekh_ohev_tzedaqah"/>
        <j:endDeclare target="#variants_1"/>
        <tei:note type="instruction" xml:lang="he">בכל השנה אם אמר המלך המשפט יצא וא"צ לחזור. ובעשי"ת אם טעה ואמר מלך אוהב צדקה ומשפט אם נזכר תוך כדי דבור אומר המלך המשפט. ואם לאחר כ"ד לא יאמר ואין מחזירין אותו.</tei:note>
