  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hallel/psalm_113">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/113/1"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_113/21"/>הַלְלוּיָהּ הַלְלוּ עַבְדֵי יְהֹוָה הַלְלוּ אֶת שֵׁם יְהֹוָה: <tei:milestone unit="verse"/>יְהִי שֵׁם יְהֹוָה מְבֹרָךְ מֵעַתָּה וְעַד־עוֹלָם: מִמִּזְרַח־שֶֽׁמֶשׁ עַד־מְבוֹאוֹ מְהֻלָּל שֵׁם יְהֹוָה: רָם עַל־כָּל־גּוֹיִם יְהֹוָה עַל הַשָּׁמַֽיִם כְּבוֹדוֹ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/113/5"/>מִי כַּיהֹוָה אֱלֹהֵֽינוּ הַמַּגְבִּיהִי לָשָֽׁבֶת: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/113/6"/>הַמַּשְׁפִּילִי לִרְאוֹת בַּשָּׁמַֽיִם וּבָאָֽרֶץ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/113/7"/>מְקִימִי מֵעָפָר דָּל מֵאַשְׁפֹּת יָרִים אֶבְיוֹן: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/113/8"/>לְהוֹשִׁיבִי עִם־נְדִיבִים עִם נְדִיבֵי עַמּוֹ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/113/9"/>מוֹשִׁיבִי עֲקֶֽרֶת הַבַּֽיִת אֵם־הַבָּנִים שְׂמֵחָה הַלְלוּיָהּ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
