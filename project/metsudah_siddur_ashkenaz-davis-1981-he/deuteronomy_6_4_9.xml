  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:deuteronomy/6/4-9">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:deuteronomy/6/4"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deuteronomy/6/4_9/1"/>שְׁמַ<tei:hi rend="large">ע</tei:hi> יִשְׂרָאֵל יְהֹוָה אֱלֹהֵֽינוּ יְהֹוָה אֶחָ<tei:hi rend="large">ד</tei:hi>:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:note type="instruction" xml:lang="he">ויאמר בלחש:</tei:note>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deuteronomy/6/4_9/2"/>בָּרוּךְ שֵׁם כְּבוֹד מַלְכוּתוֹ לְעוֹלָם וָעֶד:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:deuteronomy/6/5"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deuteronomy/6/4_9/3"/>וְאָהַבְתָּ אֵת יְהֹוָה אֱלֹהֶֽיךָ בְּכָל֯־לְ֯בָבְ֒ךָ וּבְכָל־נַפְשְׁ֒ךָ וּבְכָל־מְאֹדֶֽךָ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:deuteronomy/6/6"/>וְהָיוּ הַדְּ֒בָרִים הָאֵֽלֶּה אֲשֶׁר֯ אָ֯נֹכִי מְצַוְּ֒ךָ הַיּוֹם עַל֯־לְ֯בָבֶֽךָ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:deuteronomy/6/7"/>וְשִׁנַּנְתָּם לְבָנֶֽיךָ וְדִבַּרְתָּ בָּם בְּשִׁבְתְּ֒ךָ בְּבֵיתֶֽךָ וּבְלֶכְתְּ֒ךָ בַדֶּֽרֶךְ וּבְשָׁכְבְּ֒ךָ וּבְקוּמֶֽךָ: <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:deuteronomy/6/8"/>וּקְשַׁרְתָּם לְאוֹת עַל֯־יָ֯דֶֽךָ וְהָיוּ לְטֹטָפֹת בֵּין עֵינֶֽיךָ: <tei:milestone unit="verse"/>וּכְתַבְתָּם עַל־מְזֻזוֹת בֵּיתֶֽךָ וּבִשְׁעָרֶֽיךָ:</tei:p>
      </tei:div>
