      <tei:div corresp="urn:x-opensiddur:text:siddur:shabbat/arvit/ledavid">
        <tei:head xml:lang="he">לדוד</tei:head>
        <j:conditional xml:id="when_1">
          <tei:note type="instruction" xml:lang="he">מנהג טוב לומר אחר כל תפלה מזמור לדוד ה׳‬ אורי וישעי. ובפרט מר״ח אלול עד הושענא רבא (מורה באצבע סי' לז).</tei:note>
          <j:any>
            <tei:fs type="opensiddur:hebrew-date">
              <tei:f name="month">
                <tei:numeric value="5"/>
              </tei:f>
              <tei:f name="day">
                <tei:numeric value="30"/>
              </tei:f>
            </tei:fs>
            <tei:fs type="opensiddur:hebrew-date">
              <tei:f name="month">
                <tei:numeric value="6"/>
              </tei:f>
            </tei:fs>
            <tei:fs type="opensiddur:hebrew-date">
              <tei:f name="month">
                <tei:numeric value="7"/>
              </tei:f>
              <tei:f name="day">
                <tei:numeric value="1" max="22"/>
              </tei:f>
            </tei:fs>
          </j:any>
        </j:conditional>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/27"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/yatom"/>
        <j:endConditional target="#when_1"/>
      </tei:div>
