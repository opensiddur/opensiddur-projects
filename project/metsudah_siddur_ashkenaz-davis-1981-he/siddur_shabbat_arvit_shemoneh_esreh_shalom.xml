  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:shabbat/arvit/shemoneh_esreh/shalom">
        <tei:head xml:lang="he">שלום רב</tei:head>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/shalom_rav_al"/>
        <j:conditional xml:id="when_1">
          <tei:note type="instruction" xml:lang="he">בעשי"ת:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="aseret-ymei-tshuva">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
        <j:declare xml:id="variants_1">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/shalom/besefer_chayyim_hamevarekh/chol_arvit_shemoneh_esreh_shalom">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/shalom/besefer_chayyim_hamevarekh/shabbat_arvit_shemoneh_esreh_shalom">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/shalom/besefer_chayyim_hamevarekh"/>
        <j:endDeclare target="#variants_1"/>
        <j:endConditional target="#when_1"/>
        <j:conditional xml:id="when_2">
          <j:none>
            <j:all>
              <tei:fs type="opensiddur:practice">
                <tei:f name="oseh-hashalom-aseret-ymei-tshuva">
                  <tei:binary value="true"/>
                </tei:f>
              </tei:fs>
              <tei:fs type="opensiddur:holiday-aggregate">
                <tei:f name="aseret-ymei-tshuva">
                  <tei:binary value="true"/>
                </tei:f>
              </tei:fs>
            </j:all>
          </j:none>
        </j:conditional>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/shalom/hamevarekh"/>
        <j:endConditional target="#when_2"/>
      </tei:div>
