    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:proverbs/31/10-31">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/10"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10_31/52"/>אֵֽשֶׁת־חַֽיִל מִי יִמְצָא וְרָחֹק מִפְּ֒נִינִים מִכְרָהּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/11"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10_31/53"/>בָּֽטַח בָּהּ לֵב בַּעְלָהּ וְשָׁלָל לֹא יֶחְסָר:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/12"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10_31/5"/>גְּמָלַֽתְהוּ טוֹב וְלֹא־רָע כֹּל יְמֵי חַיֶּֽיהָ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/13"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10_31/54"/>דָּרְ֒שָׁה צֶֽמֶר וּפִשְׁתִּים וַתַּֽעַשׂ בְּחֵֽפֶץ כַּפֶּֽיהָ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/14"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10_31/55"/>הָיְ֒תָה כָּאֳנִיּוֹת סוֹחֵר מִמֶּרְחָק תָּבִיא לַחְמָהּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/15"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10_31/56"/>וַתָּֽקָם בְּעוֹד לַֽיְלָה וַתִּתֵּן טֶֽרֶף לְבֵיתָהּ וְחֹק לְנַעֲרֹתֶֽיהָ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/16"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10_31/57"/>זָמְ֒מָה שָׂדֶה וַתִּקָּחֵֽהוּ מִפְּ֒רִי כַפֶּֽיהָ נָֽטְ֒עָה כָּֽרֶם:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/17"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10_31/58"/>חָגְ֒רָה בְּעוֹז מָתְנֶֽיהָ וַתְּ֒אַמֵּץ זְרוֹעֹתֶֽיהָ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/18"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10_31/59"/>טָעֲמָה כִּי־טוֹב סַחְרָהּ לֹא־יִכְבֶּה בַּלַּֽיְלָה נֵרָהּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/19"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10_31/60"/>יָדֶֽיהָ שִׁלְּ֒חָה בַכִּישׁוֹר וְכַפֶּֽיהָ תָּֽמְ֒כוּ פָֽלֶךְ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/20"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10_31/61"/>כַּפָּהּ פָּרְ֒שָׂה לֶעָנִי וְיָדֶֽיהָ שִׁלְּ֒חָה לָאֶבְיוֹן:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/21"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10_31/62"/>לֹא־תִירָא לְבֵיתָהּ מִשָּֽׁלֶג כִּי כָל־בֵּיתָהּ לָבֻשׁ שָׁנִים:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/22"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10_31/63"/>מַרְבַדִּים עָֽשְׂ֒תָה־לָּהּ שֵׁשׁ וְאַרְגָּמָן לְבוּשָׁהּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/23"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10_31/64"/>נוֹדָע בַּשְּׁ֒עָרִים בַּעְלָהּ בְּשִׁבְתּוֹ עִם־זִקְנֵי־אָֽרֶץ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/24"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10_31/65"/>סָדִין עָשְׂ֒תָה וַתִּמְכֹּר וַחֲגוֹר נָתְ֒נָה לַכְּנַעֲנִי:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/25"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10_31/66"/>עוֹז־וְהָדָר לְבוּשָׁהּ וַתִּשְׂחַק לְיוֹם אַחֲרוֹן:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/26"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10_31/67"/>פִּֽיהָ פָּתְ֒חָה בְחָכְמָה וְתוֹרַת־חֶֽסֶד עַל־לְשׁוֹנָהּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/27"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10_31/68"/>צוֹפִיָּה הֲלִיכוֹת בֵּיתָהּ וְלֶֽחֶם עַצְלוּת לֹא תֹאכֵל:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/28"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10_31/69"/>קָֽמוּ בָנֶֽיהָ וַיְאַשְּׁ֒רֽוּהָ בַּעְלָהּ וַיְהַלְ֒לָהּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/29"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10_31/70"/>רַבּוֹת בָּנוֹת עָֽשׂוּ חָֽיִל וְאַתְּ עָלִית עַל־כֻּלָּֽנָה:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/30"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10_31/71"/>שֶֽׁקֶר הַחֵן וְהֶֽבֶל הַיֹּֽפִי אִשָּׁה יִרְאַת־יְהֹוָה הִיא תִתְהַלָּל:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/31"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10_31/72"/>תְּנוּ־לָהּ מִפְּ֒רִי יָדֶֽיהָ וִיהַלְ֒לֽוּהָ בַשְּׁ֒עָרִים מַעֲשֶֽׂיהָ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>