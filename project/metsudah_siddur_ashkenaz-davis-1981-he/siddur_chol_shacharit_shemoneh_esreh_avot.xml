      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/shemoneh_esreh/avot">
        <tei:head xml:lang="he">אבות</tei:head>
        <tei:note type="description" xml:lang="he">המתפלל צריך שיכוין בליבו פירוש המילות שהוא מוציא בשפתיו. ואם אינו יכול לכוין פירוש המילות לכל הפחות צריך שיחשוב בשעת התפילה בדברים המכניעים את הלב ומכוונים את לבו לאביו שבשמים. יכוין רגליו זה אצל זה כאילו אינן אלא אחת. ויזהר להתפלל בלחש. ולא ירמוז בעיניו ולא יקרוץ בשפתיו ולא יראה באצבעותיו ואינו פוסק אפילו לקדיש וקדושה וברכו (קיצשו"ע יח)</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/51/17"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/avot"/>
      </tei:div>
    </tei:body>
  </tei:text>
