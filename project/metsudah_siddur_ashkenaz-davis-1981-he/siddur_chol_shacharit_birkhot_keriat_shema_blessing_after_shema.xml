      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/birkhot_keriat_shema/blessing_after_shema">
        <tei:head xml:lang="he">גאל ישראל</tei:head>
        <tei:note type="description" xml:lang="he">כל שלא אמר אמת ויציב שחרית ואמת ואמונה ערבית לא יצא ידי חובתו שנאמר (תהלים צב ג) להגיד בבקר חסדך ואמונתך בלילות (ברכות יא:) ופירש"י שברכת אמת ויציב כלה על חסד שעשה עם אבותינו שהוציאם ממצרים ובקע להם הים והעבירם.</tei:note>
