  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:serach_bat_asher_mayer">
        <tei:head>סֶֽרַח בַּת־אָשֵׁר</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:serach_bat_asher_mayer/1"/>
        <tei:lg>
          <tei:l>בַּת־אָשֵׁר הִיא, סֶֽרַח שְׁמָהּ.</tei:l>
          <tei:l>בַּת־אָשֵׁר שֶׁרָאֲתָה.</tei:l>
          <tei:l>בַּת אָשֵׁר, הַבַּת אֲשֶׁר</tei:l>
          <tei:l>הִצִּילָה עִיר בְּחׇכְמָתָהּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:serach_bat_asher_mayer/2"/>
        <tei:lg>
          <tei:l>הִיא נִחֲמָה אֶת־אָבִֽינוּ,</tei:l>
          <tei:l>וְתִנָּחֵם אוֹתָֽנוּ,</tei:l>
          <tei:l>בְּפֵרוּשֶֽׁיהָ בַּתּוֹרָה,</tei:l>
          <tei:l>וּבְשִׁירָתָהּ הַחֲדָשָׁה.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
