  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:the_mapmaker_steier">
        <tei:head>The Mapmaker, a poem by Eli Steier</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_mapmaker_steier/1"/>
        <tei:lg>
          <tei:l>Cold facts.</tei:l>
          <tei:l>Colder realities.</tei:l>
          <tei:l>The preacher who lost his way</tei:l>
          <tei:l>The librarian who empties the shelves</tei:l>
          <tei:l>The cook without a spoon</tei:l>
          <tei:l>The child masking as a king</tei:l>
          <tei:l>The king masking as a child.</tei:l>
          <tei:l>The mapmaker studies them all</tei:l>
          <tei:l>Furrowing his brow tightly</tei:l>
          <tei:l>Crafting lines delicately.</tei:l>
          <tei:l>Charges</tei:l>
          <tei:l>Nothing</tei:l>
          <tei:l>And</tei:l>
          <tei:l>Changes</tei:l>
          <tei:l>Everything</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
