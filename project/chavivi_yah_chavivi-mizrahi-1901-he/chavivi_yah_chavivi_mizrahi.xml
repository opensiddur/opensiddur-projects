    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:chavivi_yah_chavivi_mizrahi">
        <tei:head>חֲבִיבִי יָהּ חֲבִיבִי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:chavivi_yah_chavivi_mizrahi/1"/>
        <tei:lg>
          <tei:l>חֲבִיבִי יָהּ חֲבִיבִי</tei:l>
          <tei:l>הָאֵל הַמֶּלֶך אַב הָרַחֲמָן</tei:l>
          <tei:l>יִשְׁלַח מְשִׁיחוֹ הַנֶּאֱמָן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:chavivi_yah_chavivi_mizrahi/2"/>
        <tei:lg>
          <tei:l>אַב הָרַחֲמָן שְׁמַע קוֹלֵינוּ</tei:l>
          <tei:l>שְׁלַח בֶּן דָּוִד וְיִגְאֲלֵנוּ</tei:l>
          <tei:l>נָשוּב לְצִיּוֹן עִיר קָדְשֵׁינוּ</tei:l>
          <tei:l>וְנִשְׁלוֹט בָהּ בְיָד רָמָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:chavivi_yah_chavivi_mizrahi/3"/>
        <tei:lg>
          <tei:l>שָׁמָּה נִתְאַסֵּף בְּעִיר הַבִּירָה</tei:l>
          <tei:l>וּמֵחָדָשׁ יִשָּׁמַע קוֹל שִׁירָה</tei:l>
          <tei:l>וְאָז נַדְלִיק אֶת הַמְּנוֹרָה</tei:l>
          <tei:l>בְּבֵית שׁוֹכֵן מְעוֹנָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:chavivi_yah_chavivi_mizrahi/4"/>
        <tei:lg>
          <tei:l>רְאֵה בָּעֳנִי יִשְׂרָאֵל עַמֶּךָ</tei:l>
          <tei:l>וְהָשִׁיבֵם נָא לִגְבוּלָךָ</tei:l>
          <tei:l>וְאָז יֵרָאֶה כָּל זְכוּרֶךָ</tei:l>
          <tei:l>שָׁלֹשׁ פְּעָמִים בַּשָּׁנָה</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
