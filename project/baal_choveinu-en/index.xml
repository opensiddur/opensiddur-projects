        <tei:fs type="opensiddur:paratext">
          <tei:f name="include">
            <tei:binary value="true"/>
          </tei:f>
        </tei:fs>
      </j:conditional>
      <tei:div type="colophon" subtype="notes">
        <tei:p>This piyut for Seliḥot on the advent of the Shitah year, “Ba’al Ḥoveinu,” was composed by Rabbi David Seidenberg and shared on the Open Siddur Project discussion group on Facebook. It can be accessed at neohasid.org.</tei:p>
        <tei:p>Recordings</tei:p>
