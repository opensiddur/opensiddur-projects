  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:baal_choveinu_seidenberg">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:baal_choveinu_seidenberg/1"/>
        <tei:lg>
          <tei:l>Ba’al ḥoveinu, sh’mot ḥovoteinu!</tei:l>
          <tei:l>Ḳoneh kol arets, rapei sh’dudeinu!</tei:l>
          <tei:l>Matir asurim,</tei:l>
          <tei:l>b’heimah va’adam, hamakhni’a ḥamas,</tei:l>
          <tei:l>miyadeinu shaḥreram!</tei:l>
          <tei:l>V’raq az t’tuqan tsidqoteinu!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
