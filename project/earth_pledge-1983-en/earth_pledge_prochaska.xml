  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:earth_pledge_prochaska">
        <tei:head>Earth Pledge, included in a Catholic textbook for the Cleveland Diocese by Sister Louise Marie Prochaska (1983), illustrated by Sister Miriam MacGillis for Global Education Associates (1984)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:earth_pledge_prochaska/1"/>
        <tei:lg>
          <tei:l>I pledge allegiance to the earth</tei:l>
          <tei:l>and all its sacred parts,</tei:l>
          <tei:l>its water, land, and living things,</tei:l>
          <tei:l>and all its human hearts.</tei:l>
          <tei:l>I pledge allegiance to all life</tei:l>
          <tei:l>and promise I shall care</tei:l>
          <tei:l>to live and cherish all its gifts</tei:l>
          <tei:l>with people everywhere.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
