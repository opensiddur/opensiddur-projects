      <tei:div corresp="urn:x-opensiddur:text:prayer:modeh_ani">
        <tei:head>Modeh Ani by Moshe ibn Makhir (interpretive translation by Rabbi Zalman Schachter-Shalomi)</tei:head>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>Thank You, Living God</tei:l>
          <tei:l>And Master,</tei:l>
          <tei:l>For giving me</tei:l>
          <tei:l>Another day of awareness.</tei:l>
          <tei:l>I thank You</tei:l>
          <tei:l>For this sacred trust.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">Proceed to hand washing</tei:note>
          </tei:l>
        </tei:lg>
      </tei:div>
