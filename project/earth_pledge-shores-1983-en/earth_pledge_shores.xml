  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:earth_pledge_shores">
        <tei:head>Earth Pledge by Maryann Shores for a colloquium in honor of Pierre Teilhard de Chardin (26 September 1983)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:earth_pledge_shores/1"/>
        <tei:lg>
          <tei:l>I pledge allegiance to the Earth,</tei:l>
          <tei:l>one planet indivisible,</tei:l>
          <tei:l>and to the universe in which she lives,</tei:l>
          <tei:l>one system under <j:divineName>God</j:divineName></tei:l>
          <tei:l>with freedom and fulfillment</tei:l>
          <tei:l>for the highest life</tei:l>
          <tei:l>and consciousness of all.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
