    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yom_yom_eftah_pi_a_piyyut_before_nishmat_of_shabbat_hanukkah_by_yaaqov_ibn_tsur">
        <tei:head>יוֹם יוֹם אֶפְתַּח פִּי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_yom_eftah_pi_a_piyyut_before_nishmat_of_shabbat_hanukkah_by_yaaqov_ibn_tsur/1"/>
        <tei:lg>
          <tei:l>יוֹם יוֹם אֶפְתַּח פִּי וּלשׁוֹנִי</tei:l>
          <tei:l>אֲרוֹמִמְךָ֣ בְּמִלּוּלִי</tei:l>
          <tei:l>יְ֭הֹוָה כִּ֣י דִלִּיתָ֑נִי</tei:l>
          <tei:l>וְלֹֽא־שִׂמַּ֖חְתָּ אֹיְבַ֣י לִֽי׃ <tei:bibl>(תהלים ל:ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_yom_eftah_pi_a_piyyut_before_nishmat_of_shabbat_hanukkah_by_yaaqov_ibn_tsur/2"/>
        <tei:lg>
          <tei:l>עֵת עָמְדוּ עָלַי יְוָנִים</tei:l>
          <tei:l>בְּקוֹל הֲמֻלָּה גְּדוֹלָה</tei:l>
          <tei:l>רָצוּ לְבַטֵּל בִּזְדוֹנִים</tei:l>
          <tei:l>שַׁבָּת רֹאשׁ־חֹֽדֶשׁ וּמִילָה</tei:l>
          <tei:l>הִגְבַּֽרְתָּ בְּנֵי חַשְׁמוֹנִים</tei:l>
          <tei:l>וַיַּעֲשׂוּ בָּהֶם כָּלָה.</tei:l>
          <tei:l>עָמְדוּ אָז חַכְמֵי הַדּוֹרוֹת</tei:l>
          <tei:l>קָבְעוּ לָֽנוּ רֻבֵּי תּוֹרוֹת</tei:l>
          <tei:l>לְכַבֶּדְךָ בְּרֹב נֵרוֹת</tei:l>
          <tei:l>וּלְהַלֶּלְךָ מְחוֹלְלִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_yom_eftah_pi_a_piyyut_before_nishmat_of_shabbat_hanukkah_by_yaaqov_ibn_tsur/3"/>
        <tei:lg>
          <tei:l>קְבוּעִים בַּפְּתָחִים הֵם</tei:l>
          <tei:l>לְצַד שְׂמֹאל מְסֻיָּמִים</tei:l>
          <tei:l>גַּם נֵר שַׁבָּת לְנִכְחֵיהֶם</tei:l>
          <tei:l>יוֹם מְכֻבַּד חֶמְדַּת יָמִים</tei:l>
          <tei:l>כׇּל־רָגִיל וְזָרִיז בָּהֶם</tei:l>
          <tei:l>יִהְיוּ לוֹ בָּנִים חֲכָמִים.</tei:l>
          <tei:l>כִּי נֵר מִצְוָה וְאוֹר תּוֹרָה</tei:l>
          <tei:l>יִהְיוּ תּוֹאֲמִים בְּחֶבְרָה</tei:l>
          <tei:l>יָאִֽירוּ בְּרֹב תִּפְאָרָה</tei:l>
          <tei:l>בְּעֹז יָד־אֵל שִׂמְחַת גִּילִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_yom_eftah_pi_a_piyyut_before_nishmat_of_shabbat_hanukkah_by_yaaqov_ibn_tsur/4"/>
        <tei:lg>
          <tei:l>בְּחַסְדְּךָ צוּר עֻזֵּנוּ</tei:l>
          <tei:l>אֵל אַדִּיר מוֹשִׁיעַ חוֹסִים</tei:l>
          <tei:l>כְּמֵאָז עֲשֵׂה עִמָּנוּ</tei:l>
          <tei:l>רֹב נִפְלָאוֹת וְגַם נִסִּים</tei:l>
          <tei:l>בְּשִׁמְךָ נָבוּס צָרֵינוּ</tei:l>
          <tei:l>וּבָךְ נִהְיֶה מִתְעַלְּסִים.</tei:l>
          <tei:l>וּבְנֵה מִקְדָּשְׁךָ הַשָּׁמֵם</tei:l>
          <tei:l>וּדְבִיר זְבוּלְךָ תְּקוֹמֵם</tei:l>
          <tei:l>נִשְׁמַת כׇּל־חַי אָז תְּרוֹמֵם</tei:l>
          <tei:l>שִׁמְךָ צוּרִי וְגוֹאֲלִי׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
