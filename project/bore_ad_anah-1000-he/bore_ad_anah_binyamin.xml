    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:bore_ad_anah_binyamin">
        <tei:head>בּוֹרֵא עַד אָנָּה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bore_ad_anah_binyamin/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בּ</tei:seg>וֹרֵא עַד אָנָּה יוֹנָתְךָ בִּמְצוּדָה</tei:l>
          <tei:l>תּוֹךְ פַּח הַמּוֹקֵשׁ עֲנִיָּה וּמְרוּדָה</tei:l>
          <tei:l>וּבְלִי בָנֶֽיהָ יוֹשֶֽׁבֶת גַּלְמוּדָה</tei:l>
          <tei:l>צוֹעֶֽקֶת אָבִי׃ אָבִי! אָבִי! אָבִי!</tei:l>
          <tei:l>יוֹשֶֽׁבֶת גַּלְמוּדָה צוֹעֶֽקֶת אָבִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bore_ad_anah_binyamin/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נָ</tei:seg>עָה גַּם נָדָה מִקִּנָּהּ הַיּוֹנָה</tei:l>
          <tei:l>וּלְקֶֽרַח וְחֹֽרֶב יוֹם וָלַֽיְלָה חוֹנָה</tei:l>
          <tei:l>הִיא מִתְחַרֶֽדֶת מֵחֶֽרֶב הַיּוֹנָה</tei:l>
          <tei:l>מִשִּׁנֵּי לָבִיא׃</tei:l>
          <tei:l>אָבִי! אָבִי! אָבִי! יוֹשֶֽׁבֶת גַּלְמוּדָה צוֹעֶֽקֶת אָבִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bore_ad_anah_binyamin/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>הּ עֵת עָזַבְתָּ אוֹתָהּ בְיַד טוֹרֵף</tei:l>
          <tei:l>אָכַל הַצַּוָּאר וּמָלַק הָעֹֽרֶף</tei:l>
          <tei:l>עָבְרוּ הַשָּׁנִים גַּם־קַֽיִץ גַּם־חֹֽרֶף</tei:l>
          <tei:l>אֶשָּׂא עֹל אוֹיְבִי׃</tei:l>
          <tei:l>אָבִי! אָבִי! אָבִי! יוֹשֶֽׁבֶת גַּלְמוּדָה צוֹעֶֽקֶת אָבִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bore_ad_anah_binyamin/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>י יִתֵּן אֵלֶֽיהָ אֵֽבֶר כַּנְּשָׁרִים</tei:l>
          <tei:l>לָעוּף בִּגְבָעוֹת וּלְדַלֵּג בֶּהָרִים</tei:l>
          <tei:l>לָבוֹא עִם־דּוֹדָהּ אֶל־תּוֹךְ הַחֲדָרִים</tei:l>
          <tei:l>אָז אֶשְׁכַּח עָצְבִּי׃</tei:l>
          <tei:l>אָבִי! אָבִי! אָבִי! יוֹשֶֽׁבֶת גַּלְמוּדָה צוֹעֶֽקֶת אָבִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bore_ad_anah_binyamin/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">י</tei:seg>וֹעֲצִים עָלֶֽיהָ עֵצוֹת הִיא אֲנוּשָׁה</tei:l>
          <tei:l>זָרִים אַכְזָרִים שָׂמֽוּהָ חֲלוּשָׁה</tei:l>
          <tei:l>בְּעֹל כָּבֵד בְּחֶרְפָּה וּבוּשָׁה</tei:l>
          <tei:l>גָּדוֹל מַכְאוֹבִי׃</tei:l>
          <tei:l>אָבִי! אָבִי! אָבִי! יוֹשֶֽׁבֶת גַּלְמוּדָה צוֹעֶֽקֶת אָבִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bore_ad_anah_binyamin/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נַ</tei:seg>חֵם עַל־לִבָּהּ אֵל שׁוֹכֵן בִּמְרוֹמִים</tei:l>
          <tei:l>דַּבֵּר נֶחָמָה עַל לֵב הָעֲגוּמִים</tei:l>
          <tei:l>קַבֵּץ נִדָּחִים פְּזוּרִים בָּעַמִּים</tei:l>
          <tei:l>וְגוֹאֵל תָּבִיא׃ וְגוֹאֵל תָּבִיא׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
