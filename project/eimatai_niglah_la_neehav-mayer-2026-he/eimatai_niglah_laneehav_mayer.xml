      <tei:div corresp="urn:x-opensiddur:text:poem:eimatai_niglah_laneehav_mayer">
        <tei:head>אֵימָתַי נִגְלָה לַנֶּאֱהָב</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eimatai_niglah_laneehav_mayer/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אֵ</tei:seg>ימָתַי נִגְלָה לַנֶּאֱהָב</tei:l>
          <tei:l><tei:seg type="acrostic">בֵּ</tei:seg>ן יָחִיד יַקִּיר כְּזָהָב</tei:l>
          <tei:l><tei:seg type="acrostic">גָּ</tei:seg>מוּל בְּמִשְׁתֶּה אַֽהַב</tei:l>
          <tei:l><tei:seg type="acrostic">דַּ</tei:seg>רְכְּךָ לַעֲלוֹת בַּלַּהַב׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eimatai_niglah_laneehav_mayer/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הֲ</tei:seg>יָדַֽעְתָּ בְּאֶֽרֶץ פְּלֶֽשֶׁת</tei:l>
          <tei:l><tei:seg type="acrostic">וַ</tei:seg>יַּשְׁכֵּם בַּשֶּֽׁמֶשׁ הַמְּחֻדֶּֽשֶׁת</tei:l>
          <tei:l><tei:seg type="acrostic">זְ</tei:seg>קֵנְךָ הָרִאשׁוֹן מִשְּׁלֹֽשֶׁת</tei:l>
          <tei:l><tei:seg type="acrostic">חָ</tei:seg>לַם חֲלוֹם לַעֲשׂוֹת מִצְוַת בֹּֽשֶׁת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eimatai_niglah_laneehav_mayer/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">טִ</tei:seg>יַּֽלְתָּ אִתּוֹ שְׁלֹֽשֶׁת יָמִים</tei:l>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>דַֽעְתָּ אֵין־שֶׂה לַפֶּחָמִים</tei:l>
          <tei:l><tei:seg type="acrostic">כִּ</tei:seg>י שָׁאַלְתָּ אַיֵּה שֶׂה בְּלִי־מוּמִים</tei:l>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>הָבִין אִם־יַעַדְךָ שְׁפִיכַת דָּמִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eimatai_niglah_laneehav_mayer/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מָ</tei:seg>תַי הֵבַֽנְתָּ אֶת־תְּשׁוּבָתוֹ</tei:l>
          <tei:l><tei:seg type="acrostic">נָ</tei:seg>א־הָבֵן הַבֵּן הַשֶּׂה אוֹתוֹ</tei:l>
          <tei:l><tei:seg type="acrostic">סִ</tei:seg>דֵּר עֲצֵי לֶהָבָתוֹ</tei:l>
          <tei:l><tei:seg type="acrostic">עֵ</tei:seg>ת בָּאָה אֵין־סָפֵק שֶׁיְּדַעְתּוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eimatai_niglah_laneehav_mayer/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פֵּ</tei:seg>רְשׁוּ הַחֲכָמִים כִּי קִבַּֽלְתָּ</tei:l>
          <tei:l><tei:seg type="acrostic">צַ</tei:seg>ו לָצָו קַו לָקָו לֹא בָּהַֽלְתָּ</tei:l>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>רָֽאתָ לְמִמֶּֽנּוּ גֻּדַּֽלְתָּ</tei:l>
          <tei:l><tei:seg type="acrostic">רַ</tei:seg>ק זְכוּתִי שֶׁאוֹתִי כָּבַֽלְתָּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eimatai_niglah_laneehav_mayer/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שְׁ</tei:seg>מֹר לִשְׁחֹטִי כַּהֲלָכָה</tei:l>
          <tei:l><tei:seg type="acrostic">תָּ</tei:seg>בִיא לְאִמִּי יִסְכָּה</tei:l>
          <tei:l>אֶת־עֲפָרַי הָרְאוּיִים לַלִּשְׁכָּה</tei:l>
          <tei:l>נָא אַל־תִּתְמַהְמֵֽהַּ לֶךְ־לְךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eimatai_niglah_laneehav_mayer/7"/>
        <tei:lg>
          <tei:l>יָדַעְתָּ לְפִי הַמִּדְרָשִׁים</tei:l>
          <tei:l>יַׄעַדְךָ לְהַעֲלוֹת בְּאִשִּׁים</tei:l>
          <tei:l>צָׄרִיךְ אֲנִי לְחַדֵּשׁ חִדּוּשִׁים</tei:l>
          <tei:l>חׇׄכְמָה הִיא אֵינָהּ בִּכְתַב הַחֻמָּשִׁים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eimatai_niglah_laneehav_mayer/8"/>
        <tei:lg>
          <tei:l>קׇׄרְבָּן אַף־עַל־פִּי שֶׁלֹּא־נִפְטַֽרְתָּ</tei:l>
          <tei:l>הָׄיִֽיתָ כְּׄאִֽלּוּ הֻבְעַֽרְתָּ</tei:l>
          <tei:l>הֲׄלֹא נֶׄאֱמַר שֶׁאֵלָיו לֹא־דִּבַּֽרְתָּ</tei:l>
          <tei:l>בֵּׄיןׄ אַׄבְׄרָׄהָׄםׄ וּבֵינְךָ הִתְפַּזַּֽרְתָּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eimatai_niglah_laneehav_mayer/9"/>
        <tei:lg>
          <tei:l>חֹׄק הוּא לְזַרְעֲךָ הַנּוֹשֵׂא</tei:l>
          <tei:l>זִׄכְרוֹן הַשּׁוֹחֵט וְהַשֶּׂה</tei:l>
          <tei:l>קָׄרֵב שִׁירֵֽינוּ כֶּעָשָׁן הַמִּתְנַשֵּׂא</tei:l>
          <tei:l>לָאֵל מֶֽלֶךְ יוֹשֵׁב עַל־כִּסֵּא׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
