  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/117">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/117/1/a"/>
        <tei:lg>
          <tei:l>Ihr Völker alle, kommt unsern Gott zu loben</tei:l>
          <tei:l>Und preiset ihn und huldigt seiner Macht!</tei:l>
          <tei:l>Denn seine Güte waltet über uns</tei:l>
          <tei:l>Und nicht in Ewigkeit wankt seine Treue.</tei:l>
        </tei:lg>
      </tei:div>
