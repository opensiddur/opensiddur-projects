    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:el_asher_chasdo_project">
        <tei:head>אֵל אֲשֶׁר חַסְדּוֹ - פיוט על תפילת חנה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_asher_chasdo_project/1"/>
        <tei:lg>
          <tei:l>אֵל אֲשֶׁר חַסְדּוֹ לֹא מָנַע</tei:l>
          <tei:l>תּוֹךְ עַמּוֹ מִשְׁכָּנוֹ חָנָה</tei:l>
          <tei:l>נִקְדַּשׁ בְּפִי עֲדַת עַם נָע</tei:l>
          <tei:l>לַמֵּד פִּי פַלֵּל כְּחַנָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_asher_chasdo_project/2"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">{שכרות}</tei:note>
          </tei:l>
          <tei:l>רַחוּם נַחֵם נֶֽפֶשׁ מָרָה</tei:l>
          <tei:l>בְּלֶב־טוֹב לְעָבְדְּךָ נָּא</tei:l>
          <tei:l>כִּי לֹא מִיַּֽיִן שְׁכוּרָה</tei:l>
          <tei:l>נַפְשִׁי בוֹכִיָּה כְּחַנָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_asher_chasdo_project/3"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">{ארבע אמות}</tei:note>
          </tei:l>
          <tei:l>בְּגַפִּי כִּי אֶתְיַצְּבָה</tei:l>
          <tei:l>אֲבַקֵּשׁ נָּא הַצְלִיחָה נָּא</tei:l>
          <tei:l>צָֽמְאָה נַפְשִׁי תָּאֲבָה</tei:l>
          <tei:l>חַלּוֹת פָּנֶֽיךָ כְּחַנָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_asher_chasdo_project/4"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">{לחש}</tei:note>
          </tei:l>
          <tei:l>לֹא בְקוֹל־גָּדוֹל וּצְעָקָה</tei:l>
          <tei:l>אֶזְעַק הַטֵּה אָזְנְךָ נָּא</tei:l>
          <tei:l>כִּי אֶת נֶֽפֶשׁ נֶאֱנָקָה</tei:l>
          <tei:l>תִּשְׁמַע כְּרַֽחַשׁ־לֶב־חַנָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_asher_chasdo_project/5"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">{חיתוך הדיבור}</tei:note>
          </tei:l>
          <tei:l>נִדְבוֹת פִּי שָׂפָה בְרוּרָה</tei:l>
          <tei:l>אֵלֶֽיךָ קָרֵב קְחָה נָּא</tei:l>
          <tei:l>כְּקוֹל לְוִיִּים בְּשִׁירָה</tei:l>
          <tei:l>וּכְנִֽיעַ שִׂפְתוֹתֵי חַנָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_asher_chasdo_project/6"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">{כוונה}</tei:note>
          </tei:l>
          <tei:l>פְּרוֹשׂ עָלֵֽינוּ מְהֵרָה</tei:l>
          <tei:l>סֻכַּת שְׁלוֹמִים מוּכָנָה</tei:l>
          <tei:l>אֲקַוֶּה וַֽאֲדַבְּרָה</tei:l>
          <tei:l>כְּדַבֵּר עַל לִבָּהּ חַנָּה</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
