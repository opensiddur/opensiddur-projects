    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ana_atqenit">
        <tei:head>אֲנָא אַתְקֵינִית</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ana_atqenit/1"/>
        <tei:lg>
          <tei:l>אֲנָא <tei:seg type="acrostic">אַ</tei:seg>תְקֵינִית עַלְמָא בִּתְבוּנָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ana_atqenit/2"/>
        <tei:lg>
          <tei:l>אֲנָא <tei:seg type="acrostic">בְּ</tei:seg>רָאִית שִׁמְשָׁא וְסִיְהַרָא בְּדִבְּרָא תִּנְיַנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ana_atqenit/3"/>
        <tei:lg>
          <tei:l>אֲנָא <tei:seg type="acrostic">גְּ</tei:seg>זַרִית וּמְחֵיתִי דַּרָא דְּטוֹפָנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ana_atqenit/4"/>
        <tei:lg>
          <tei:l>אֲנָא <tei:seg type="acrostic">דְּ</tei:seg>בַלְבֵּנִית שְׂפַת דָּרַא דְעַבָרוּ מַגְדְּלָא וְאָקִימוּ עֲלָהּ צִלמָנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ana_atqenit/5"/>
        <tei:lg>
          <tei:l>אֲנָא <tei:seg type="acrostic">הַ</tei:seg>מְמַלֵילִית עִם אַבְרָהָם אָבוּכוֹן אִיזֶל מֵהָכָא לְאַרְעָא דִּכְנַעַנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ana_atqenit/6"/>
        <tei:lg>
          <tei:l>אֲנָא <tei:seg type="acrostic">וְ</tei:seg>שֵׁיזִבְתֵּיהּ מִגּוֹ נוּרָא דְּאַתּוּנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ana_atqenit/7"/>
        <tei:lg>
          <tei:l>אֲנָא <tei:seg type="acrostic">זְ</tei:seg>קַפְתֵּיהּ וּאוֹתִיבְתֵּיהּ מֵעַל לְכוּרְסֵיהּ אוּמַיָא וְלִישָׁנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ana_atqenit/8"/>
        <tei:lg>
          <tei:l>אֲנָא <tei:seg type="acrostic">חֲ</tei:seg>נַנְתֵּיהּ וְלַד לִמְאָה שְׁנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ana_atqenit/9"/>
        <tei:lg>
          <tei:l>אֲנָא <tei:seg type="acrostic">טְ</tei:seg>בָחִית אַרְבַּע מַלְכִין כַּד רְדַף בַּתְרֵיהוֹן וְאָתֵיב שִׁבְיָנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ana_atqenit/10"/>
        <tei:lg>
          <tei:l>אֲנָא <tei:seg type="acrostic">יִ</tei:seg>דַּעְתֵּיהּ וּבָתַרְכֵן יִפְּקוּן בְּרַבַּא קִנְיָנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ana_atqenit/11"/>
        <tei:lg>
          <tei:l>אֲנָא <tei:seg type="acrostic">כַּ</tei:seg>ד אֲמָרִית סַב בְּרַךְ יְחִידַךְ דְּרָחִימְנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ana_atqenit/12"/>
        <tei:lg>
          <tei:l>אֲנָא <tei:seg type="acrostic">לְ</tei:seg>קַלָא קַרֵיתִי מִמְעוֹנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ana_atqenit/13"/>
        <tei:lg>
          <tei:l>אֲנָא <tei:seg type="acrostic">מַ</tei:seg>לֵּילִית לָא תוֹשִׁיט יְדָךְ לִסַכִּינָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ana_atqenit/14"/>
        <tei:lg>
          <tei:l>אֲנָא <tei:seg type="acrostic">נְ</tei:seg>טָרִית קְיָמִי עִם יִצְחַק בְּרֵיהּ בֶּאֱמוּ נָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ana_atqenit/15"/>
        <tei:lg>
          <tei:l>אֲנָא <tei:seg type="acrostic">סְ</tei:seg>מָכִית וְכַלְכֵּלִית יַעֲקֹב כַּד אָזַל לְפַדַּנָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ana_atqenit/16"/>
        <tei:lg>
          <tei:l>אֲנָא <tei:seg type="acrostic">עַ</tei:seg>ל סוּלָּמַא אִיתְעַתָּרִית וּפְרַקְתֵּיהּ מִן מַלְאָכַיָא אֲנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ana_atqenit/17"/>
        <tei:lg>
          <tei:l>אֲנָא <tei:seg type="acrostic">פַּ</tei:seg>קִידְתֵּיהּ תוּב לְאַרְעַךְ וְעִימַךְ אוֹטִיבְנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ana_atqenit/18"/>
        <tei:lg>
          <tei:l>אֲנָא <tei:seg type="acrostic">צְ</tei:seg>וַחִית לְלָבָן כׇּל דִּיקְרַב בֵּיהּ כְּיַנְזֶק בְּבָבַת עֵינָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ana_atqenit/19"/>
        <tei:lg>
          <tei:l>אֲנָא <tei:seg type="acrostic">קְ</tei:seg>רִיתֵּיהּ יִשְׂרָאֵל תְּרֵי זִמְנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ana_atqenit/20"/>
        <tei:lg>
          <tei:l>אֲנָא <tei:seg type="acrostic">רַ</tei:seg>בִּיתֵּיהּ וְאַסְגִּיתּיה לְאַלְפִין רִיבְבָנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ana_atqenit/21"/>
        <tei:lg>
          <tei:l>אֲנָא <tei:seg type="acrostic">שֵׁ</tei:seg>יזֵיבִית בְּנוֹהִי מִגוֹ פּוּלְחָנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ana_atqenit/22"/>
        <tei:lg>
          <tei:l>אֲנָא <tei:seg type="acrostic">תְּ</tei:seg>בַרִית זְרוֹעַ דְּבַעֲלֵי דְּבַבַנָא</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
