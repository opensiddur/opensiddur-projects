        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_nakba_day_rosen/1"/>
        <tei:lg>
          <tei:l>לָאֵל שֶׁחָפֵץ תְּשׁוּבָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_nakba_day_rosen/7"/>
        <tei:lg>
          <tei:l>וְנֹאמַר</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>אָמֵן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_nakba_day_rosen/8"/>
        <tei:lg>
          <tei:l>לָאֵל שֶׁחָפֵץ תְּשׁוּבָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_nakba_day_rosen/10"/>
        <tei:lg>
          <tei:l>לָאֵל מָלֵא רַחֲמִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_nakba_day_rosen/11"/>
        <tei:lg>
          <tei:l>עוֹשֶׂה הַשָּׁלוֹם</tei:l>
