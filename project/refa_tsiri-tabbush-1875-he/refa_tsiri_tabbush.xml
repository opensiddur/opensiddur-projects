  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:refa_tsiri_tabbush">
        <tei:head>רְפָא צִירִי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:refa_tsiri_tabbush/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רְ</tei:seg>פָא צִירִי אֵל נֶאֱמָן</tei:l>
          <tei:l>כִּי אַתָּה רוֹפֵא אֻמָּן</tei:l>
          <tei:l>אַתְּ רֺאשִׁי שׁוּר חַלְשִׁי</tei:l>
          <tei:l>וְתֵן כֹּחַ לְנַפְשִׁי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:refa_tsiri_tabbush/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>תַח שַׁעַר הָרַחֲמִים</tei:l>
          <tei:l>רָם שׁוֹכֵן בַּמְּרוֹמִים</tei:l>
          <tei:l>עַל עַבְדָּךְ שִׂים חַסְדָּךְ</tei:l>
          <tei:l>אֵין מְרַחֵם בִּלְעָדָךְ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:refa_tsiri_tabbush/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אֵל</tei:seg> חַי רְצֵה תְּפִלָּתִי</tei:l>
          <tei:l>וְחוּשָׁה לְעֶזְרָתִי</tei:l>
          <tei:l>בִּמְהֵרָה דְּרוֹר</tei:l>
          <tei:l>קְרָא לְעַם בֶּן הַגְּבִירָה</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
