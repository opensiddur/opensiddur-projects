  <tei:standOff type="notes">
    <tei:note type="commentary" n="1" target="#note_1">
      <tei:p>From the closing prayer of the Amidah, “Elohai netsor”</tei:p>
    </tei:note>
    <tei:note type="commentary" n="2" target="#note_2">
      <tei:p>From George Washington’s “Letter to the Jews of Newport,” August 17th, 1790.</tei:p>
    </tei:note>
