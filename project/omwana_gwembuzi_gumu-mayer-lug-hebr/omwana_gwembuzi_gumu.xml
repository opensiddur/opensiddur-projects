      <tei:div corresp="urn:x-opensiddur:text:poem:omwana_gwembuzi_gumu">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:omwana_gwembuzi_gumu/1"/>
        <tei:lg>
          <tei:l>אוֹמְוַנַה גְּוֵימְבֻּזִי גֻּמוּ,</tei:l>
          <tei:l>אוֹמְוַנַה גְּוֵימְבֻּזִי גֻּמוּ,</tei:l>
          <tei:l>קִטַנְגֶּי גְּוֵייַגֻּלַה סִרִנְגִּי בִּ֘רִי,</tei:l>
          <tei:l>אוֹמְוַנַה גְּוֵימְבֻּזִי גֻּמוּ,</tei:l>
          <tei:l>אוֹמְוַנַה גְּוֵימְבֻּזִי גֻּמוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:omwana_gwembuzi_gumu/2"/>
        <tei:lg>
          <tei:l>אֶרַה קַ֘פַּה יַזֶ֘י</tei:l>
          <tei:l>נֶלְיָה אוֹמְוַנַה גְּוֵימְבֻּזִי,</tei:l>
          <tei:l>קִטַנְגֶּי גְּוֵייַגֻּלַה סִרִנְגִּי בִּ֘רִי,</tei:l>
          <tei:l>אוֹמְוַנַה גְּוֵימְבֻּזִי גֻּמוּ,</tei:l>
          <tei:l>אוֹמְוַנַה גְּוֵימְבֻּזִי גֻּמוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:omwana_gwembuzi_gumu/3"/>
        <tei:lg>
          <tei:l>אֶרַה אֵימְבְּוָה יַזֶ֘י,</tei:l>
          <tei:l>נֶלֻמַה קַ֘פַּה</tei:l>
          <tei:l>אֶיַלְיָה אוֹמְוַנַה גְּוֵימְבֻּזִי,</tei:l>
          <tei:l>קִטַנְגֶּי גְּוֵייַגֻּלַה סִרִנְגִּי בִּ֘רִי,</tei:l>
          <tei:l>אוֹמְוַנַה גְּוֵימְבֻּזִי גֻּמוּ,</tei:l>
          <tei:l>אוֹמְוַנַה גְּוֵימְבֻּזִי גֻּמוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:omwana_gwembuzi_gumu/4"/>
        <tei:lg>
          <tei:l>אֶרַה אֹמֻגּ֘וּ גְּוָאזֶ֘י,</tei:l>
          <tei:l>נֶגֻּקֻבַּה אֵימְבְּוָה</tei:l>
          <tei:l>אֶיַלֻמַה קַ֘פַּה</tei:l>
          <tei:l>אֶיַלְיָה אוֹמְוַנַה גְּוֵימְבֻּזִי,</tei:l>
          <tei:l>קִטַנְגֶּי גְּוֵייַגֻּלַה סִרִנְגִּי בִּ֘רִי,</tei:l>
          <tei:l>אוֹמְוַנַה גְּוֵימְבֻּזִי גֻּמוּ,</tei:l>
          <tei:l>אוֹמְוַנַה גְּוֵימְבֻּזִי גֻּמוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:omwana_gwembuzi_gumu/5"/>
        <tei:lg>
          <tei:l>אֶרַה אֹמֻלִרוֹ גְּוָאזֶ֘י,</tei:l>
          <tei:l>נֶי גְּווֹקְיָה אֹמֻגּ֘וּ</tei:l>
          <tei:l>אֹגְּוָאקֻבַּה אֵימְבְּוָה</tei:l>
          <tei:l>אֶיַלֻמַה קַ֘פַּה</tei:l>
          <tei:l>אֶיַלְיָה אוֹמְוַנַה גְּוֵימְבֻּזִי,</tei:l>
          <tei:l>קִטַנְגֶּי גְּוֵייַגֻּלַה סִרִנְגִּי בִּ֘רִי,</tei:l>
          <tei:l>אוֹמְוַנַה גְּוֵימְבֻּזִי גֻּמוּ,</tei:l>
          <tei:l>אוֹמְוַנַה גְּוֵימְבֻּזִי גֻּמוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:omwana_gwembuzi_gumu/6"/>
        <tei:lg>
          <tei:l>אֶרַה אַמַזִ֘י גַּזֶ֘י</tei:l>
          <tei:l>נֶי גַּזִקִזַה אֹמֻלִרוֹ,</tei:l>
          <tei:l>אֹגְּוָאיֹקְיָה אֹמֻגּ֘וּ</tei:l>
          <tei:l>אֹגְּוָאקֻבַּה אֵימְבְּוָה</tei:l>
          <tei:l>אֶיַלֻמַה קַ֘פַּה</tei:l>
          <tei:l>אֶיַלְיָה אוֹמְוַנַה גְּוֵימְבֻּזִי,</tei:l>
          <tei:l>קִטַנְגֶּי גְּוֵייַגֻּלַה סִרִנְגִּי בִּ֘רִי,</tei:l>
          <tei:l>אוֹמְוַנַה גְּוֵימְבֻּזִי גֻּמוּ,</tei:l>
          <tei:l>אוֹמְוַנַה גְּוֵימְבֻּזִי גֻּמוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:omwana_gwembuzi_gumu/7"/>
        <tei:lg>
          <tei:l>אֶרַה אֶנְטֵי יַזֶ֘י</tei:l>
          <tei:l>נֶיוָה אַמַזִ֘י</tei:l>
          <tei:l>אַגַזִקִזַה אֹמֻלִרוֹ,</tei:l>
          <tei:l>אֹגְּוָאיֹקְיָה אֹמֻגּ֘וּ</tei:l>
          <tei:l>אֹגְּוָאקֻבַּה אֵימְבְּוָה</tei:l>
          <tei:l>אֶיַלֻמַה קַ֘פַּה</tei:l>
          <tei:l>אֶיַלְיָה אוֹמְוַנַה גְּוֵימְבֻּזִי,</tei:l>
          <tei:l>קִטַנְגֶּי גְּוֵייַגֻּלַה סִרִנְגִּי בִּ֘רִי,</tei:l>
          <tei:l>אוֹמְוַנַה גְּוֵימְבֻּזִי גֻּמוּ,</tei:l>
          <tei:l>אוֹמְוַנַה גְּוֵימְבֻּזִי גֻּמוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:omwana_gwembuzi_gumu/8"/>
        <tei:lg>
          <tei:l>אֶרַה אֹמֻבָּאזִי יַזֶ֘ה</tei:l>
          <tei:l>נַסַלַה אֶנְטֵי</tei:l>
          <tei:l>אֶיַנְׄוָה אַמַזִ֘י</tei:l>
          <tei:l>אַגַזִקִזַה אֹמֻלִרוֹ,</tei:l>
          <tei:l>אֹגְּוָאיֹקְיָה אֹמֻגּ֘וּ</tei:l>
          <tei:l>אֹגְּוָאקֻבַּה אֵימְבְּוָה</tei:l>
          <tei:l>אֶיַלֻמַה קַ֘פַּה</tei:l>
          <tei:l>אֶיַלְיָה אוֹמְוַנַה גְּוֵימְבֻּזִי,</tei:l>
          <tei:l>קִטַנְגֶּי גְּוֵייַגֻּלַה סִרִנְגִּי בִּ֘רִי,</tei:l>
          <tei:l>אוֹמְוַנַה גְּוֵימְבֻּזִי גֻּמוּ,</tei:l>
          <tei:l>אוֹמְוַנַה גְּוֵימְבֻּזִי גֻּמוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:omwana_gwembuzi_gumu/9"/>
        <tei:lg>
          <tei:l>אֶרַה מַלַיִקַה ווֹקֻפַה יַזֶ֘ה</tei:l>
          <tei:l>נַטַ֘ה אֹמֻבָּאזִי</tei:l>
          <tei:l>אֶיַסַלַח אֶנְטֵי</tei:l>
          <tei:l>אֶיַנְׄוָה אַמַזִ֘י</tei:l>
          <tei:l>אַגַזִקִזַה אֹמֻלִרוֹ,</tei:l>
          <tei:l>אֹגְּוָאיֹקְיָה אֹמֻגּ֘וּ</tei:l>
          <tei:l>אֹגְּוָאקֻבַּה אֵימְבְּוָה</tei:l>
          <tei:l>אֶיַלֻמַה קַ֘פַּה</tei:l>
          <tei:l>אֶיַלְיָה אוֹמְוַנַה גְּוֵימְבֻּזִי,</tei:l>
          <tei:l>קִטַנְגֶּי גְּוֵייַגֻּלַה סִרִנְגִּי בִּ֘רִי,</tei:l>
          <tei:l>אוֹמְוַנַה גְּוֵימְבֻּזִי גֻּמוּ,</tei:l>
          <tei:l>אוֹמְוַנַה גְּוֵימְבֻּזִי גֻּמוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:omwana_gwembuzi_gumu/10"/>
        <tei:lg>
          <tei:l>אֶרַה קַטֹנְדָה אֹמֻטֻקֻבֿ יַזֶּי</tei:l>
          <tei:l>נַטַ֘ה מַלַיִקַה ווֹקֻפַה</tei:l>
          <tei:l>אֶיַטַ֘ה אֹמֻבָּאזִי</tei:l>
          <tei:l>אֶיַסַלַח אֶנְטֵי</tei:l>
          <tei:l>אֶיַנְׄוָה אַמַזִ֘י</tei:l>
          <tei:l>אַגַזִקִזַה אֹמֻלִרוֹ,</tei:l>
          <tei:l>אֹגְּוָאיֹקְיָה אֹמֻגּ֘וּ</tei:l>
          <tei:l>אֹגְּוָאקֻבַּה אֵימְבְּוָה</tei:l>
          <tei:l>אֶיַלֻמַה קַ֘פַּה</tei:l>
          <tei:l>אֶיַלְיָה אוֹמְוַנַה גְּוֵימְבֻּזִי,</tei:l>
          <tei:l>קִטַנְגֶּי גְּוֵייַגֻּלַה סִרִנְגִּי בִּ֘רִי,</tei:l>
          <tei:l>אוֹמְוַנַה גְּוֵימְבֻּזִי גֻּמוּ,</tei:l>
          <tei:l>אוֹמְוַנַה גְּוֵימְבֻּזִי גֻּמוּ.</tei:l>
        </tei:lg>
      </tei:div>
