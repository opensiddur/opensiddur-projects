      <tei:div corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar">
        <tei:head>בִּשְׁלֹשָׁה בְּחֹדֶשׁ אִיָּר</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/1"/>
        <tei:lg>
          <tei:l>בִּשְׁלֹשָׁה בְּחֹדֶשׁ אִיָּ֗ר</tei:l>
          <tei:l>רָאִ֣יתִי בְ֭מַרְאֶֽה וְכׇל־נְבוּאָ֑יו</tei:l>
          <tei:l>וְהִתְפַּלַּ֗לְתִּי לִפְנֵ֥י יְ֝הֹוָ֗ה וְאָמַֽרְתִּי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/2"/>
        <tei:lg>
          <tei:l>בָּ֭רוּךְ מוֹרִ֣ישׁ וּמַעֲשִׁ֑יר</tei:l>
          <tei:l>וּמְבֹרָךְ מַשְׁפִּיל וּמֵרִֽים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/3"/>
        <tei:lg>
          <tei:l>כִּ֣י הֵ֭קִים מֵעָפָ֣ר דַּ֑ל</tei:l>
          <tei:l>וּ֝מֵאַשְׁפּ֗וֹת הֵרִ֥ים אֶבְיֽוֹן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/4"/>
        <tei:lg>
          <tei:l>וַיִּגְדַּ֣ל כִּ֭סְאוֹ מֵעַ֣ל כׇּל־הַשָּׂרִ֑ים</tei:l>
          <tei:l>וַיַּגְבִּ֣יר כֹּח֖וֹ עַ֣ל כׇּל־מוֹשְׁלִֽים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/5"/>
        <tei:lg>
          <tei:l>וַיִּתֵּן־ל֭וֹ כׇּל־חֶמְדַּ֣ת מְלָכִ֑ים</tei:l>
          <tei:l>וְחֵ֥יל גּ֝וֹיִ֗ם וְאוֹצְר֥וֹת מְלָכִֽים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/6"/>
        <tei:lg>
          <tei:l>בְּנ֣וֹת מְלָכִ֣ים לִכְבוֹד֑וֹ</tei:l>
          <tei:l>וּבְנ֥וֹת יְ֝רוּשָׁלַ֗םִ לְתִפְאֶ֣רֶת מַלְכוּתֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/7"/>
        <tei:lg>
          <tei:l>אַשְׁרָ֨יו ׀ יֹ֭אמְרוּ כׇּל־הָעוֹלָמִ֑ים</tei:l>
          <tei:l>וּלְפָנָ֥יו יִ֝שְׁתַּחֲו֗וּ כׇּל־תְּקוּמֵ֥י הָאָֽרֶץ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/8"/>
        <tei:lg>
          <tei:l>וְיִבְטְח֬וּ בַּיהֹוָ֗ה כִּ֣י הִגְדִּ֣יל לַעֲשׂ֑וֹת</tei:l>
          <tei:l>וְ֝לֹא־יִטְעוּ־ע֗וֹד בְּהֶ֣בֶל וּמִשְׁגֶּֽה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/9"/>
        <tei:lg>
          <tei:l>כִּי־כֻלָּ֣ם יֵדְע֣וּ אֶת־יְהֹוָ֖ה</tei:l>
          <tei:l>מִגְּדוֹלֵ֥י אָדָ֖ם וְעַד־קְטַנֵּ֣י אֱנֽוֹשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/10"/>
        <tei:lg>
          <tei:l>כִּ֤י ׀ יְהֹוָ֣ה שׁוֹפֵ֣ט בְּכׇל־הָעוֹלָ֑ם</tei:l>
          <tei:l>אֶחָ֣ד מַשְׁפִּ֖יל וְאֶחָ֣ד מֵרִֽים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/11"/>
        <tei:lg>
          <tei:l>לַאֲשֶׁ֣ר יִ֭רְצֶה יִתֵּ֑ן</tei:l>
          <tei:l>וּלְאֶבְיוֹנֵ֥י אָ֝דָ֗ם יוֹרִ֥ישׁ<tei:anchor xml:id="note_2"/> נַחֲלָֽה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/12"/>
        <tei:lg>
          <tei:l>כִּ֣י בְּ֭יָדוֹ נֶ֣פֶשׁ כׇּל־חָ֑י</tei:l>
          <tei:l>וְר֥וּחַ כׇּ֝ל־בָּשָׂ֗ר אֵלָ֥יו יִשְׁתַּחֲוֽוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/13"/>
        <tei:lg>
          <tei:l>שִֽׁירוּ־ל֭וֹ זַמְּרוּ־ל֑וֹ</tei:l>
          <tei:l>שִׂ֝֗יחוּ כׇּל־נִפְלְאוֹתָֽיו׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/14"/>
        <tei:lg>
          <tei:l>שִׁ֣ירוּ לִשְׁמ֣וֹ בְּכׇל־עֵ֑ת</tei:l>
          <tei:l>כִּ֤י ל֥וֹ נָ֝אֶ֗ה תִּפְאֶ֥רֶת וָעֹֽז׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/15"/>
        <tei:lg>
          <tei:l>אֲשֶׁ֬ר הִצִּ֗יל מִצָּרָה֮ אֶת־נֶ֪פֶשׁ א֫וֹהֲבָ֥ו</tei:l>
          <tei:l>וּמִיָּ֣ד כׇּל־מְרֵעִ֑ים ר֣וּחַ חֲסִידָֽו׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/16"/>
        <tei:lg>
          <tei:l>כִּ֗י בָּטַ֣ח בִּ֭שְׁמוֹ וּבִכְב֣וֹד מַרְאֶ֑ה</tei:l>
          <tei:l>וּבְדִבְרֵ֥י קׇ֝דְשׁ֗וֹ וּבְכׇל־דַּרְכֵ֣י חַיִּֽים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/17"/>
        <tei:lg>
          <tei:l>לָעַ֣ד נַעֲבֹ֣ד אֶת־שְׁמ֑וֹ</tei:l>
          <tei:l>וּלְנֶ֣צַח נְ֝צָחִ֗ים נַגִּ֥יד גְּבוּרָתֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/18"/>
        <tei:lg>
          <tei:l>כִּ֨י ה֣וּא ר֭וֹפֵא לְנִ֣שְׁבְּרֵי־לֵ֑ב</tei:l>
          <tei:l>וְחוֹבֵ֖שׁ אֶת־עֶ֣צֶם דַּכִּֽים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/19"/>
        <tei:lg>
          <tei:l>וְה֗וּא הָפַ֣ךְ דְּ֭וִיָּה לְשִׂמְחָ֑ה</tei:l>
          <tei:l>וְזִ֥יעַ וְ֝רָתִ֗ית לְמִבְטְח֥וֹת גְּדֹלֽוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/20"/>
        <tei:lg>
          <tei:l>כִּי־ל֭וֹ אֶ֣רֶץ וּמְלֹאָ֑הּ</tei:l>
          <tei:l>תֵּ֝בֵ֗ל וְכׇל־י֥וֹשְׁבֵי בָּֽהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/21"/>
        <tei:lg>
          <tei:l>כִּ֣י מִ֭לְּפָנָיו צִוָּ֣ה עַל־עַבְדּ֑וֹ</tei:l>
          <tei:l>ה֥וֹד וְהָדָ֖ר וּכְב֣וֹד מַלְכוּתֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/22"/>
        <tei:lg>
          <tei:l>אֲשֶׁ֣ר חָ֭פֵץ בְּט֣וּב עַמּ֑וֹ</tei:l>
          <tei:l>וְשָׁלַ֥ח הָ֝רוֹפֵ֗א וְרָפָ֥א בְּשָׂרָֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/23"/>
        <tei:lg>
          <tei:l>וְהִכְבִּ֣יד תּ֭וֹרָתוֹ עַל־פִּ֣י עַבְדּ֑וֹ</tei:l>
          <tei:l>וּמִצְוַ֥ת דְּ֝בָר֗וֹ עַל־יְדֵ֥י נֶאֱמָנֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/24"/>
        <tei:lg>
          <tei:l>הִרְבָּ֣ה בְּ֭לִבּוֹ חׇכְמָ֣ה וּבִינָ֑ה</tei:l>
          <tei:l>וְרַ֥ב קְ֝דֻשָּׁת֗וֹ עַד־בְּלִי־מִסְפָּֽר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/25"/>
        <tei:lg>
          <tei:l>מִי־דּֽוֹמֶה־ל֭וֹ וּמִ֣י כְּמוֹת֑וֹ</tei:l>
          <tei:l>אֲשֶׁ֤ר לֹ֣א שָׁ֝כַ֗ח צַעֲקַ֥ת אֶבְיֽוֹן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/26"/>
        <tei:lg>
          <tei:l>וְזָכַר בְּרַחֲמָיו֮ עָנִ֪י וָ֫דַ֥ל וְגַ֣ם אָ֭נֹכִי כִּי־זָכַ֣רְתִּי</tei:l>
          <tei:l>גְּבוּר֑וֹת וְעֹ֥ז מֶ֝מְשַׁלְתּ֗וֹ וְתִפְאֶ֥רֶת עֻזּֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/27"/>
        <tei:lg>
          <tei:l>לַ֣יְלָה וָ֭יוֹם אֶעֱמֹ֣ד לְפָנָ֑יו</tei:l>
          <tei:l>וַאֲבָרֵ֥ךְ אֶ֝ת־זִכְר֗וֹ עַ֥ל כׇּל־מַעֲשָֽׂיו׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/28"/>
        <tei:lg>
          <tei:l>תִּתְבָּרֵ֣ךְ וְ֭תִתְרוֹמֵם אֲד֣וֹן כׇּל־הַדּוֹר֑וֹת</tei:l>
          <tei:l>תִּתְקַדֵּ֥שׁ וְ֝תִתְפָּאֵ֗ר מוֹשֵׁ֥ל בְּכׇל־מַעֲשָֽׂיו׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/29"/>
        <tei:lg>
          <tei:l>תִּתְיַחֵ֣ד מַ֭לְכִּי מִפִּ֣י כׇּל־מְשָׁרְתֶ֑ךָ</tei:l>
          <tei:l>שׁוֹפֵ֥ט צֶ֖דֶק וְדַיָּ֣ן אֱמֶֽת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/30"/>
        <tei:lg>
          <tei:l>בָּר֬וּךְ אַתָּ֗ה יְ֘הֹוָ֥ה אֵ֣ל נָ֭א זוֹכֵ֣ר בְּרַחֲמָ֑יו</tei:l>
          <tei:l>אֶת־בְּרִ֥ית עַ֝בְדּ֗וֹ לָנֶֽצַח׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/31"/>
        <tei:lg>
          <tei:l>בָּ֭רוּךְ שֵׁ֣ם כְּב֣וֹד מַלְכוּת֑וֹ לְ֝עוֹלָ֗ם וָעֶֽד׃</tei:l>
          <tei:l>בָּ֭רוּךְ שֵׁ֣ם כְּבוֹד֑וֹ לְ֝עוֹלָ֗ם וְעַֽד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_3rd_of_iyyar/32"/>
        <tei:lg>
          <tei:l>בָּ֤רֽוּךְ־יְהֹוָ֨ה אֱלֹהֵ֪י יִשְׂרָאֵ֡ל מִן־הָ֤עוֹלָ֨ם ׀ וְעַ֬ד הָעוֹלָ֗ם</tei:l>
          <tei:l>וְאָמַ֖ר כׇּל־הָעָ֥ם אָמֵֽן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
