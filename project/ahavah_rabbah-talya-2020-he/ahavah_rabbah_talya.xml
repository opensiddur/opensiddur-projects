    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:ahavah_rabbah_talya">
        <tei:head>בִּרְכָּת אַהֲבַה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ahavah_rabbah_talya/1"/>
        <tei:lg>
          <tei:l>אַהֲבָה רַבָּה אֲהַבְתָּנוּ יהוה אֱלֹהֵינוּ.</tei:l>
          <tei:l>בְּאַהֲבָה נִבְרֵאנוּ וּבָאנוּ אֶל עוֹלָמְךָ,</tei:l>
          <tei:l>וַתִּתֵּן לָנוּ חַיִּים וּבָהֶם יֹפִי,</tei:l>
          <tei:l>חֶסֶד וֶאֱמֶת.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ahavah_rabbah_talya/2"/>
        <tei:lg>
          <tei:l>וְהָאֵר עֵינֵנוּ לִרְאוֹת, וְלָשׁוּב וְלִרְאוֹת אֶת אֵלֶּה בְּעוֹלָמְךָ,</tei:l>
          <tei:l>וְדַבֵּק לִבֵּנוּ בִּקְדֻשָּׁתָם שֶׁל חַיֵּינוּ</tei:l>
          <tei:l>וְשֶׁל חַיֵּי כָּל הַבְּרוּאִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ahavah_rabbah_talya/3"/>
        <tei:lg>
          <tei:l>וְלֹא תִּקְהֶה בְּקִרְבֵּנוּ הַפְּלִיאָה</tei:l>
          <tei:l>מִפֶּלֶא הַבְּרִיאָה</tei:l>
          <tei:l>וְלֹא תֵּעָלֵם מִלִּבֵּנוּ הַיִּרְאָה לְנֹכַח קְדֻשָּׁתָהּ,</tei:l>
          <tei:l>וְלֹא תִּרְפֶּה רוּחֵנוּ לַעֲמֹל וּלְכוֹנֵן</tei:l>
          <tei:l>צֶדֶק, שָׁלוֹם וּרְפוּאָה</tei:l>
          <tei:l>בְּכָל אֲשֶׁר נֵלֵךְ,</tei:l>
          <tei:l>בְּשָׁכְבֵנוּ</tei:l>
          <tei:l>וּבְקוּמֵנוּ</tei:l>
          <tei:l>וּבְהוֹלְכֵנוּ בַּדֶּרֶךְ.</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יהוה</tei:l>
          <tei:l>הַנּוֹתֵן חַיִּים בְּאַהֲבָה.</tei:l>
        </tei:lg>
      </tei:div>
