        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/56"/>
        <tei:lg xml:lang="he">
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>וַיִּנָּ֖חֶם יְהֹוָ֑ה עַל־הָ֣רָעָ֔ה</tei:l>
          <tei:l>אֲשֶׁ֥ר דִּבֶּ֖ר לַעֲשׂ֥וֹת לְעַמּֽוֹ׃ <tei:bibl>(שמות לב:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/57"/>
        <tei:lg xml:lang="he">
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>כִּֽי־יָדִ֤ין יְהֹוָה֙ עַמּ֔וֹ</tei:l>
          <tei:l>וְעַל־עֲבָדָ֖יו יִתְנֶחָ֑ם</tei:l>
          <tei:l>כִּ֤י יִרְאֶה֙ כִּֽי־אָ֣זְלַת יָ֔ד</tei:l>
          <tei:l>וְאֶ֖פֶס עָצ֥וּר וְעָזֽוּב׃ <tei:bibl>(דברים לב:לו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/58"/>
        <tei:lg xml:lang="he">
          <tei:l>וּבְשִׁירֵי מַלְכְּךָ עַבְדְּךָ מְשִׁיחֶֽךָ כָּתוּב לֵאמֹר —</tei:l>
          <tei:l>גַּ֤ם כִּֽי־אֵלֵ֨ךְ בְּגֵ֪יא צַלְמָ֡וֶת</tei:l>
          <tei:l>לֹא־אִ֘ירָ֤א רָ֗ע</tei:l>
          <tei:l>כִּי־אַתָּ֥ה עִמָּדִ֑י</tei:l>
          <tei:l>שִׁבְטְךָ֥ וּ֝מִשְׁעַנְתֶּ֗ךָ</tei:l>
          <tei:l>הֵ֣מָּה יְנַֽחֲמֻֽנִי׃ <tei:bibl>(תהלים כג:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/59"/>
        <tei:lg xml:lang="he">
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>תֶּ֤רֶב ׀ גְּֽדֻלָּתִ֗י</tei:l>
          <tei:l>וְתִסֹּ֥ב</tei:l>
          <tei:l>תְּֽנַחֲמֵֽנִי׃ <tei:bibl>(תהלים עא:כא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/60"/>
        <tei:lg xml:lang="he">
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>עֲשֵֽׂה־עִמִּ֥י א֗וֹת לְט֫וֹבָ֥ה</tei:l>
          <tei:l>וְיִרְא֣וּ שֹׂנְאַ֣י</tei:l>
          <tei:l>וְיֵבֹ֑שׁוּ</tei:l>
          <tei:l>כִּֽי־אַתָּ֥ה יְ֝הֹוָ֗ה עֲזַרְתַּ֥נִי</tei:l>
          <tei:l>וְנִחַמְתָּֽנִי׃ <tei:bibl>(תהלים פו:ז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/61"/>
        <tei:lg xml:lang="he">
          <tei:l>וּבְדִבְרֵי נְבִיא תַּנְחוּמֶֽיךָ כָּתוּב לֵאמֹר —</tei:l>
          <tei:l>וְאָֽמַרְתָּ֙ בַּיּ֣וֹם הַה֔וּא</tei:l>
          <tei:l>אוֹדְךָ֣ יְהֹוָ֔ה</tei:l>
          <tei:l>כִּ֥י אָנַ֖פְתָּ בִּ֑י</tei:l>
          <tei:l>יָשֹׁ֥ב אַפְּךָ֖</tei:l>
          <tei:l>וּֽתְנַחֲמֵֽנִי׃ <tei:bibl>(ישעיה יב:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/62"/>
        <tei:lg xml:lang="he">
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>כִּי־נִחַ֨ם יְהֹוָ֜ה צִיּ֗וֹן</tei:l>
          <tei:l>נִחַם֙ כׇּל־חׇרְבֹתֶ֔יהָ</tei:l>
          <tei:l>וַיָּ֤שֶׂם מִדְבָּרָהּ֙ כְּעֵ֔דֶן</tei:l>
          <tei:l>וְעַרְבָתָ֖הּ כְּגַן־יְהֹוָ֑ה</tei:l>
          <tei:l>שָׂשׂ֤וֹן וְשִׂמְחָה֙ יִמָּ֣צֵא בָ֔הּ</tei:l>
          <tei:l>תּוֹדָ֖ה וְק֥וֹל זִמְרָֽה׃ <tei:bibl>(ישעיה נא:ג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/63"/>
        <tei:lg xml:lang="he">
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>כְּאִ֕ישׁ אֲשֶׁ֥ר אִמּ֖וֹ תְּנַחֲמֶ֑נּוּ</tei:l>
          <tei:l>כֵּ֤ן אָֽנֹכִי֙ אֲנַ֣חֶמְכֶ֔ם</tei:l>
          <tei:l>וּבִירוּשָׁלַ֖͏ִם תְּנֻחָֽמוּ׃ <tei:bibl>(ישעיה סו:יג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/64"/>
        <tei:lg xml:lang="he">
          <tei:l>וְכׇל־אֵֽלֶּה אֲמָרָם כְּדֵי לְקַיֵּם אֶת־מָה שֶׁנֶּאֱמַר —</tei:l>
          <tei:l>נַחֲמ֥וּ נַחֲמ֖וּ עַמִּ֑י</tei:l>
          <tei:l>יֹאמַ֖ר אֱלֹהֵיכֶֽם׃ <tei:bibl>(ישעיה מ:א)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>