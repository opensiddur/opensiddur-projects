  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/1"/>
        <tei:lg xml:lang="he">
          <tei:l>הִנְנִי מוּכָן וּמְזֻמָּן</tei:l>
          <tei:l>לִסְפֹּר אֶת־סְפִירַת הַנֶּחָמָה׃</tei:l>
          <tei:l>בַּיָּמִים הַבָּאִים וּבַשָּׁבוּעוֹת הַבָּאוֹת</tei:l>
          <tei:l>בְּעֶזְרַת הַשֵּׁם יִתְבָּרַךְ</tei:l>
          <tei:l>נַעֲלֶה וְנִגְדַּל</tei:l>
          <tei:l>וְנִגְבַּהּ וְנַרְקִֽיעַ</tei:l>
          <tei:l>וְנִתַּמֵּר וְנַעְפִּיל וְנִתְרוֹמֵם</tei:l>
          <tei:l>מִסֵּֽבֶל לִסְלִיחָה</tei:l>
          <tei:l>מִ<tei:seg type="acrostic">כְּ</tei:seg>לִמָּה לְ<tei:seg type="acrostic">כַ</tei:seg>פָּרָה</tei:l>
          <tei:l>מִ<tei:seg type="acrostic">תּ</tei:seg>וּגָה לִ<tei:seg type="acrostic">תְ</tei:seg>שׁוּבָה</tei:l>
          <tei:l>מִ<tei:seg type="acrostic">יָּ</tei:seg>גוֹן לְ<tei:seg type="acrostic">יֹֽ</tei:seg>שֶׁר׃</tei:l>
          <tei:l>מִ<tei:seg type="acrostic">בּ</tei:seg>וּשָׁה לִ<tei:seg type="acrostic">בְ</tei:seg>רָכָה</tei:l>
          <tei:l>מִ<tei:seg type="acrostic">שְּׁ</tei:seg>מָמָה לְ<tei:seg type="acrostic">שָׁ</tei:seg>נָה טוֹבָה</tei:l>
          <tei:l>מִ<tei:seg type="acrostic">מַּ</tei:seg>כְאוֹב לִ<tei:seg type="acrostic">מְ</tei:seg>חִילָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/2"/>
        <tei:lg xml:lang="he">
          <tei:l>יָׄהּ</tei:l>
          <tei:l>צַׄדְּקֵֽנוּ חׇׄנֵּֽנוּ קַֽׄדְּשֵׁנוּ הׄוֹרֵֽנוּ</tei:l>
          <tei:l>רַׄחֲמֵֽנוּ אַׄמְּצֵֽנוּ לַׄמְּדֵֽנוּ</tei:l>
          <tei:l><tei:seg type="acrostic">אֵ</tei:seg>ל <tei:seg type="acrostic">מֶֽ</tei:seg>לֶךְ <tei:seg type="acrostic">נַ</tei:seg>חֲמֵֽנוּ —</tei:l>
          <tei:l>כִּ֤י אַתָּה֙ אֵֽל־חַנּ֣וּן וְרַח֔וּם</tei:l>
          <tei:l>אֶ֤רֶךְ אַפַּ֙יִם֙ וְרַב־חֶ֔סֶד</tei:l>
          <tei:l>וְנִחָ֖ם עַל־הָרָעָֽה׃ <tei:bibl>(יונה ד:ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/3"/>
        <tei:lg xml:lang="he">
          <tei:l>וִיהִ֤י ׀ נֹ֤עַם אֲדֹנָ֥י אֱלֹהֵ֗ינוּ עָ֫לֵ֥ינוּ</tei:l>
          <tei:l>וּמַעֲשֵׂ֣ה יָ֭דֵינוּ כּוֹנְנָ֥ה עָלֵ֑ינוּ</tei:l>
          <tei:l>וּֽמַעֲשֵׂ֥ה יָ֝דֵ֗ינוּ כּוֹנְנֵֽהוּ׃ <tei:bibl>(תהלים צ:יז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/5"/>
        <tei:lg>
          <tei:l>יוֹמָא דֵין יוֹמָא חַד לְמִנְיָנָא דִּנְחֶמְתָּא׃</tei:l>
          <tei:l>תַּנְחוּמִין דִּבְתַּנְחוּמִין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/6"/>
        <tei:lg>
          <tei:l>יוֹמָא דֵין תְּרֵי יוֹמֵי לְמִנְיָנָא דִּנְחֶמְתָּא׃</tei:l>
          <tei:l>צִיּוֹן דִּבְתַּנְחוּמִין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/7"/>
        <tei:lg>
          <tei:l>יוֹמָא דֵין תְּלָתָא יוֹמֵי לְמִנְיָנָא דִּנְחֶמְתָּא׃</tei:l>
          <tei:l>חֲשִׁיכָתָא דִּבְתַּנְחוּמִין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/8"/>
        <tei:lg>
          <tei:l>יוֹמָא דֵין אַרְבְּעָה יוֹמֵי לְמִנְיָנָא דִּנְחֶמְתָּא׃</tei:l>
          <tei:l>אֲנָא־אֲנָא דִּבְתַּנְחוּמִין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/9"/>
        <tei:lg>
          <tei:l>יוֹמָא דֵין חַמְשָׁא יוֹמֵי לְמִנְיָנָא דִּנְחֶמְתָּא׃</tei:l>
          <tei:l>עֲקָרָה דִּבְתַּנְחוּמִין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/10"/>
        <tei:lg>
          <tei:l>יוֹמָא דֵין שִׁיתָּא יוֹמֵי לְמִנְיָנָא דִּנְחֶמְתָּא׃</tei:l>
          <tei:l>אַנְהָרִי דִּבְתַּנְחוּמִין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/11"/>
        <tei:lg>
          <tei:l>יוֹמָא דֵין שִׁבְעָא יוֹמֵי דִּשְׁבוּעַתָּא חַדָא אִנּוּן לְמִנְיָנָא דִּנְחֶמְתָּא׃</tei:l>
          <tei:l>מֶחְדָא דִּבְתַּנְחוּמִין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/12"/>
        <tei:lg>
          <tei:l>יוֹמָא דֵין תְּמָנְיָא יוֹמֵי דִּשְׁבוּעַתָּא חַדָא וְיוֹמָא חַד אִנּוּן לְמִנְיָנָא דִּנְחֶמְתָּא׃</tei:l>
          <tei:l>תַּנְחוּמִין דִּבְצִיּוֹן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/13"/>
        <tei:lg>
          <tei:l>יוֹמָא דֵין תִשְׁעָה יוֹמֵי דִּשְׁבוּעַתָּא חַדָא וּתְרֵי יוֹמֵי אִנּוּן לְמִנְיָנָא דִּנְחֶמְתָּא׃</tei:l>
          <tei:l>צִיּוֹן דִּבְצִיּוֹן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/14"/>
        <tei:lg>
          <tei:l>יוֹמָא דֵין עַסְרָא יוֹמֵי דִּשְׁבוּעַתָּא חַדָא וּתְלָתָא יוֹמֵי אִנּוּן לְמִנְיָנָא דִּנְחֶמְתָּא׃</tei:l>
          <tei:l>חֲשִׁיכָתָא דִּבְצִיּוֹן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/15"/>
        <tei:lg>
          <tei:l>יוֹמָא דֵין חַדְסַר יוֹמֵי דִּשְׁבוּעַתָּא חַדָא וְאַרְבְּעָה יוֹמֵי אִנּוּן לְמִנְיָנָא דִּנְחֶמְתָּא׃</tei:l>
          <tei:l>אֲנָא־אֲנָא דִּבְצִיּוֹן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/16"/>
        <tei:lg>
          <tei:l>יוֹמָא דֵין תְּרֵיסַר יוֹמֵי דִּשְׁבוּעַתָּא חַדָא וְחַמְשָׁא יוֹמֵי אִנּוּן לְמִנְיָנָא דִּנְחֶמְתָּא׃</tei:l>
          <tei:l>עֲקָרָה דִּבְצִיּוֹן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/17"/>
        <tei:lg>
          <tei:l>יוֹמָא דֵין תְּלֵיסַר יוֹמֵי דִּשְׁבוּעַתָּא חַדָא וְשִׁיתָּא יוֹמֵי אִנּוּן לְמִנְיָנָא דִּנְחֶמְתָּא׃</tei:l>
          <tei:l>אַנְהָרִי דִּבְצִיּוֹן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/18"/>
        <tei:lg>
          <tei:l>יוֹמָא דֵין אַרְבֵּיסַר יוֹמֵי דְּתַרְתֵין שָׁבוּעָן אִנּוּן לְמִנְיָנָא דִּנְחֶמְתָּא׃</tei:l>
          <tei:l>מֶחְדָא דִּבְצִיּוֹן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/19"/>
        <tei:lg>
          <tei:l>יוֹמָא דֵין חֲמֵיסַר יוֹמֵי דְּתַרְתֵין שָׁבוּעָן וְיוֹמָא חַד אִנּוּן לְמִנְיָנָא דִּנְחֶמְתָּא׃</tei:l>
          <tei:l>תַּנְחוּמִין דְּבַחֲשִׁיכָתָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/20"/>
        <tei:lg>
          <tei:l>יוֹמָא דֵין שֵׁיתְסַר יוֹמֵי דְּתַרְתֵין שָׁבוּעָן וּתְרֵי יוֹמֵי אִנּוּן לְמִנְיָנָא דִּנְחֶמְתָּא׃</tei:l>
          <tei:l>צִיּוֹן דְּבַחֲשִׁיכָתָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/21"/>
        <tei:lg>
          <tei:l>יוֹמָא דֵין שַׁבְסַר יוֹמֵי דְּתַרְתֵין שָׁבוּעָן וּתְלָתָא יוֹמֵי אִנּוּן לְמִנְיָנָא דִּנְחֶמְתָּא׃</tei:l>
          <tei:l>חֲשִׁיכָתָא דְּבַחֲשִׁיכָתָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/22"/>
        <tei:lg>
          <tei:l>יוֹמָא דֵין תְּמָנֵיסַר יוֹמֵי דְּתַרְתֵין שָׁבוּעָן וְאַרְבְּעָה יוֹמֵי אִנּוּן לְמִנְיָנָא דִּנְחֶמְתָּא׃</tei:l>
          <tei:l>אֲנָא־אֲנָא דְּבַחֲשִׁיכָתָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/23"/>
        <tei:lg>
          <tei:l>יוֹמָא דֵין תְּשַׁסַר יוֹמֵי דְּתַרְתֵין שָׁבוּעָן וְחַמְשָׁא יוֹמֵי אִנּוּן לְמִנְיָנָא דִּנְחֶמְתָּא׃</tei:l>
          <tei:l>עֲקָרָה דְּבַחֲשִׁיכָתָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/24"/>
        <tei:lg>
          <tei:l>יוֹמָא דֵין עֶסְרִין יוֹמֵי דְּתַרְתֵין שָׁבוּעָן וְשִׁיתָּא יוֹמֵי אִנּוּן לְמִנְיָנָא דִּנְחֶמְתָּא׃</tei:l>
          <tei:l>אַנְהָרִי דְּבַחֲשִׁיכָתָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/25"/>
        <tei:lg>
          <tei:l>יוֹמָא דֵין עֶסְרִין וְחַד יוֹמֵי דִּתְלָת שָׁבוּעָן אִנּוּן לְמִנְיָנָא דִּנְחֶמְתָּא׃</tei:l>
          <tei:l>מֶחְדָא דְּבַחֲשִׁיכָתָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/26"/>
        <tei:lg>
          <tei:l>יוֹמָא דֵין עֶסְרִין וּתְרֵי יוֹמֵי דִּתְלָת שָׁבוּעָן וְיוֹמָא חַד אִנּוּן לְמִנְיָנָא דִּנְחֶמְתָּא׃</tei:l>
          <tei:l>תַּנְחוּמִין דְּבַאֲנָא־אֲנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_hanechamah_mayer/27"/>
        <tei:lg>
          <tei:l>יוֹמָא דֵין עֶסְרִין וּתְלָתָא יוֹמֵי דִּתְלָת שָׁבוּעָן וּתְרֵי יוֹמֵי אִנּוּן לְמִנְיָנָא דִּנְחֶמְתָּא׃</tei:l>
