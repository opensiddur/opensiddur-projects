  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/95/1-3">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/95/1"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/1_3/1"/>Come let us sing to Adonoy;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/1_3/2"/>let us shout for joy
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/1_3/3"/>to the Rock of our Deliverance.<tei:anchor xml:id="note_1"/>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/95/2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/1_3/4"/>Let us greet Him with thanksgiving;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/1_3/5"/>with song let us shout for joy to Him.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/95/3"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/1_3/6"/>for a great Almighty is Adonoy;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/1_3/7"/>a great King over all godlike beings.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
