  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:qorbanot/attah_hu">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/attah_hu/1"/>You are Adonoy, our God,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/attah_hu/2"/>before Whom our fathers burned
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/attah_hu/3"/>the incense of spices
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/attah_hu/4"/>when the Holy Temple was standing,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/attah_hu/5"/>as You commanded them
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/attah_hu/6"/>by the hand of Moses Your prophet,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/attah_hu/7"/>as it is written in Your Torah:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
