    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:birshut_el_ayom/1">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birshut_el_ayom/1/1"/>With permission of the Almighty
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birshut_el_ayom/1/2"/>Who is fearful and awesome
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birshut_el_ayom/1/3"/>(our) refuge in times of trouble;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birshut_el_ayom/1/4"/>Almighty girded with strength
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birshut_el_ayom/1/5"/>mighty on high is Adonoy.</tei:p>
      </tei:div>
