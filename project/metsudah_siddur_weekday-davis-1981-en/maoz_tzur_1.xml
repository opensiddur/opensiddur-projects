  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:maoz_tzur/1">
        <tei:head xml:lang="en">
          <tei:hi rend="large">Maoz Tzur</tei:hi>
        </tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/1/1"/>Stronghold, Rock of my deliverance,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/1/2"/>it is fitting to offer praise to You.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/1/3"/>You will establish the House of my prayer<tei:anchor xml:id="note_1"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/1/4"/>and there we will offer thanksgiving offerings.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/1/5"/>When You prepare total destruction
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/1/6"/>against the raging foe,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/1/7"/>I will then complete, with song and psalm,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/1/8"/>the dedication of the Altar.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" target="#note_1" xml:lang="en">
      <tei:p>The Holy Temple.</tei:p>
    </tei:note>
