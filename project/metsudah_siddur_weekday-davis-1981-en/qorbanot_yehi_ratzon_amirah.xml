    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:qorbanot/yehi_ratzon_amirah">
        <tei:p><tei:note type="instruction" xml:lang="en">Some do not say the following prayer on Sabbath and Yom Tov.</tei:note><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/1"/>May it be Your will,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/2"/>Adonoy, our God and God of our fathers,
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/yehi_ratzon_amirah/chol_shacharit_qetoret"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/11"/>if I have committed a sin which requires,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/12"/>the bringing of a sin-offering,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/yehi_ratzon_amirah/chol_shacharit_qetoret_373"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/15"/>if I have committed a sin which requires
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/16"/>the bringing of a guilt-offering
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/3"/>that this recitation be
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/yehi_ratzon_amirah/chol_shacharit_qetoret"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/13"/>be acceptable before you
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/14"/>as if I had brought a sin-offering.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/yehi_ratzon_amirah/chol_shacharit_qetoret_373"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/17"/>be acceptable before You
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/18"/>as if I had brought a guilt-offering.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/yehi_ratzon_amirah/chol_shacharit_qetoret"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/yehi_ratzon_amirah/chol_shacharit_qetoret_373"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/4"/>important, acceptable
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_5"/>
<j:conditional xml:id="variant_6"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/yehi_ratzon_amirah/chol_shacharit_qetoret"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/yehi_ratzon_amirah/chol_shacharit_qetoret_373"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/5"/>and desirable before You,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_6"/>
<j:conditional xml:id="variant_7"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/yehi_ratzon_amirah/chol_shacharit_qetoret"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/yehi_ratzon_amirah/chol_shacharit_qetoret_373"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/6"/>as if we sacrificed
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_7"/>
<j:conditional xml:id="variant_8"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/yehi_ratzon_amirah/chol_shacharit_qetoret"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/yehi_ratzon_amirah/chol_shacharit_qetoret_373"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/7"/>the daily burnt-offering
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_8"/>
<j:conditional xml:id="variant_9"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/yehi_ratzon_amirah/chol_shacharit_qetoret"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/yehi_ratzon_amirah/chol_shacharit_qetoret_373"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/8"/>at its proper time,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_9"/>
<j:conditional xml:id="variant_10"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/yehi_ratzon_amirah/chol_shacharit_qetoret"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/yehi_ratzon_amirah/chol_shacharit_qetoret_373"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/9"/>in its proper place
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_10"/>
<j:conditional xml:id="variant_11"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/yehi_ratzon_amirah/chol_shacharit_qetoret"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/yehi_ratzon_amirah/chol_shacharit_qetoret_373"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/10"/>and according to its laws.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_11"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
