  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:birkhot_hatorah/asher_natan">
        <tei:p><tei:note type="instruction" xml:lang="en"><tei:hi rend="italic">After the Torah is read, the Kohein says:</tei:hi></tei:note><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hatorah/asher_natan/1"/>Blessed are You, Adonoy
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hatorah/asher_natan/2"/>our God, King of the Universe
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hatorah/asher_natan/3"/>Who gave us the Torah of truth,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hatorah/asher_natan/4"/>and implanted eternal life within us.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hatorah/asher_natan/5"/>Blessed are You, Adonoy,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hatorah/asher_natan/6"/>Giver of the Torah.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
