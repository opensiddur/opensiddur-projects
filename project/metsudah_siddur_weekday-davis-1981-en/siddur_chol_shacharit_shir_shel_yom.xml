  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/shir_shel_yom">
        <tei:head xml:lang="en">Psalm of the Day</tei:head>
        <j:conditional xml:id="when_1">
          <tei:note type="instruction" xml:lang="en">On days in which Tachanun is not said, "A prayer of David," is omitted, and we begin "House of Jacob". On days in which "Almighty who is slow to anger," is not said, continue with the Psalm for the appropriate day.</tei:note>
          <j:none>
            <j:any>
              <j:any>
                <tei:fs type="opensiddur:holiday">
                  <tei:f name="rosh-hodesh">
                    <tei:binary value="true"/>
                  </tei:f>
                </tei:fs>
                <tei:fs type="opensiddur:holiday">
                  <tei:f name="hanukkah">
                    <tei:binary value="true"/>
                  </tei:f>
                </tei:fs>
                <tei:fs type="opensiddur:hebrew-date">
                  <tei:f name="month">
                    <tei:numeric value="12"/>
                  </tei:f>
                  <tei:f name="day">
                    <tei:numeric value="14" max="15"/>
                  </tei:f>
                </tei:fs>
                <tei:fs type="opensiddur:hebrew-date">
                  <tei:f name="month">
                    <tei:numeric value="13"/>
                  </tei:f>
                  <tei:f name="day">
                    <tei:numeric value="14" max="15"/>
                  </tei:f>
                </tei:fs>
                <tei:fs type="opensiddur:hebrew-date">
                  <tei:f name="month">
                    <tei:numeric value="1"/>
                  </tei:f>
                </tei:fs>
                <tei:fs type="opensiddur:hebrew-date">
                  <tei:f name="month">
                    <tei:numeric value="2"/>
                  </tei:f>
                  <tei:f name="day">
                    <tei:numeric value="14"/>
                  </tei:f>
                </tei:fs>
                <tei:fs type="opensiddur:holiday">
                  <tei:f name="lag-baomer">
                    <tei:binary value="true"/>
                  </tei:f>
                </tei:fs>
                <tei:fs type="opensiddur:hebrew-date">
                  <tei:f name="month">
                    <tei:numeric value="3"/>
                  </tei:f>
                  <tei:f name="day">
                    <tei:numeric value="1" max="8"/>
                  </tei:f>
                </tei:fs>
                <tei:fs type="opensiddur:holiday">
                  <tei:f name="tisha-bav">
                    <tei:binary value="true"/>
                  </tei:f>
                </tei:fs>
                <tei:fs type="opensiddur:hebrew-date">
                  <tei:f name="month">
                    <tei:numeric value="5"/>
                  </tei:f>
                  <tei:f name="day">
                    <tei:numeric value="15"/>
                  </tei:f>
                </tei:fs>
                <tei:fs type="opensiddur:hebrew-date">
                  <tei:f name="month">
                    <tei:numeric value="6"/>
                  </tei:f>
                  <tei:f name="day">
                    <tei:numeric value="29"/>
                  </tei:f>
                </tei:fs>
                <tei:fs type="opensiddur:hebrew-date">
                  <tei:f name="month">
                    <tei:numeric value="7"/>
                  </tei:f>
                  <tei:f name="day">
                    <tei:numeric value="9" max="23"/>
                  </tei:f>
                </tei:fs>
                <j:all>
                  <tei:fs type="opensiddur:hebrew-date">
                    <tei:f name="month">
                      <tei:numeric value="7"/>
                    </tei:f>
                    <tei:f name="day">
                      <tei:numeric value="24"/>
                    </tei:f>
                  </tei:fs>
                  <j:none>
                    <tei:fs type="opensiddur:israel">
                      <tei:f name="is-israel">
                        <tei:binary value="true"/>
                      </tei:f>
                    </tei:fs>
                  </j:none>
                </j:all>
                <tei:fs type="opensiddur:hebrew-date">
                  <tei:f name="month">
                    <tei:numeric value="11"/>
                  </tei:f>
                  <tei:f name="day">
                    <tei:numeric value="15"/>
                  </tei:f>
                </tei:fs>
              </j:any>
              <tei:fs type="opensiddur:override">
                <tei:f name="omit-tahanun">
                  <tei:binary value="true"/>
                </tei:f>
              </tei:fs>
              <tei:fs type="opensiddur:override">
                <tei:f name="house-of-mourning">
                  <tei:binary value="true"/>
                </tei:f>
              </tei:fs>
              <tei:fs type="opensiddur:override">
                <tei:f name="brit-milah">
                  <tei:binary value="true"/>
                </tei:f>
              </tei:fs>
              <tei:fs type="opensiddur:override">
                <tei:f name="wedding">
                  <tei:binary value="true"/>
                </tei:f>
              </tei:fs>
              <tei:fs type="opensiddur:override">
                <tei:f name="sheva-brachot">
                  <tei:binary value="true"/>
                </tei:f>
              </tei:fs>
            </j:any>
            <j:all>
              <tei:fs type="opensiddur:service-time">
                <tei:f name="minha">
                  <tei:binary value="true"/>
                </tei:f>
              </tei:fs>
              <j:any>
                <tei:fs type="opensiddur:day-of-week">
                  <tei:f name="hebrew-day">
                    <tei:numeric value="6" max="7"/>
                  </tei:f>
                </tei:fs>
                <tei:fs type="opensiddur:hebrew-date">
                  <tei:f name="day">
                    <tei:numeric value="29"/>
                  </tei:f>
                </tei:fs>
                <tei:fs type="opensiddur:hebrew-date">
                  <tei:f name="month">
                    <tei:numeric value="2"/>
                  </tei:f>
                  <tei:f name="day">
                    <tei:numeric value="13" max="14"/>
                  </tei:f>
                </tei:fs>
                <tei:fs type="opensiddur:hebrew-date">
                  <tei:f name="month">
                    <tei:numeric value="2"/>
                  </tei:f>
                  <tei:f name="day">
                    <tei:numeric value="17" max="18"/>
                  </tei:f>
                </tei:fs>
                <tei:fs type="opensiddur:hebrew-date">
                  <tei:f name="month">
                    <tei:numeric value="5"/>
                  </tei:f>
                  <tei:f name="day">
                    <tei:numeric value="8" max="9"/>
                  </tei:f>
                </tei:fs>
                <tei:fs type="opensiddur:hebrew-date">
                  <tei:f name="month">
                    <tei:numeric value="5"/>
                  </tei:f>
                  <tei:f name="day">
                    <tei:numeric value="14" max="15"/>
                  </tei:f>
                </tei:fs>
                <tei:fs type="opensiddur:hebrew-date">
                  <tei:f name="month">
                    <tei:numeric value="9"/>
                  </tei:f>
                  <tei:f name="day">
                    <tei:numeric value="24" max="30"/>
                  </tei:f>
                </tei:fs>
                <tei:fs type="opensiddur:hebrew-date">
                  <tei:f name="month">
                    <tei:numeric value="11"/>
                  </tei:f>
                  <tei:f name="day">
                    <tei:numeric value="14" max="15"/>
                  </tei:f>
                </tei:fs>
                <tei:fs type="opensiddur:hebrew-date">
                  <tei:f name="month">
                    <tei:numeric value="12"/>
                  </tei:f>
                  <tei:f name="day">
                    <tei:numeric value="13" max="15"/>
                  </tei:f>
                </tei:fs>
                <tei:fs type="opensiddur:hebrew-date">
                  <tei:f name="month">
                    <tei:numeric value="13"/>
                  </tei:f>
                  <tei:f name="day">
                    <tei:numeric value="13" max="15"/>
                  </tei:f>
                </tei:fs>
              </j:any>
            </j:all>
          </j:none>
        </j:conditional>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/86"/>
        <j:endConditional target="#when_1"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:beit_yaaqov_lekhu"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/124"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:hayom_yom_rishon"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/24"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:hayom_yom_sheni"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/48"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:hayom_yom_shelishi"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/82"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:hayom_yom_revii"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/94"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/95/1-3"/>
        <tei:note type="instruction" xml:lang="en">(Deliver us...; Mourner's Kaddish.)</tei:note>
        <j:conditional xml:id="when_2">
          <tei:note type="instruction" xml:lang="en">
            <tei:hi rend="italic">On Thursday:</tei:hi>
          </tei:note>
          <tei:fs type="opensiddur:day-of-week">
            <tei:f name="hebrew-day">
              <tei:numeric value="5"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:hayom_yom_chamishi"/>
        <j:endConditional target="#when_2"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/81"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:hayom_yom_shishi"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/93"/>
        <j:declare xml:id="variants_1">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:hoshienu_adonai_eloheinu/chol_shacharit_shir_shel_yom">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:hoshienu_adonai_eloheinu"/>
        <j:endDeclare target="#variants_1"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:haleluyah_barukh_adonai"/>
