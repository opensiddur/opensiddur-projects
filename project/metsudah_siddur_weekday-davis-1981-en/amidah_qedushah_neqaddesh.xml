  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/neqaddesh">
        <tei:head xml:lang="en">Kedushah</tei:head>
        <tei:p><tei:note type="instruction" xml:lang="en"><tei:hi rend="italic">The Congregation says and the Chazzan repeats:</tei:hi></tei:note><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/neqaddesh/1"/>We will hallow and revere You
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/neqaddesh/2"/>as [with] the sweet words
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/neqaddesh/3"/>of the company of the holy Seraphim<tei:anchor xml:id="note_1"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/neqaddesh/4"/>who thrice repeat "holy" unto You,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/neqaddesh/5"/>as is written by the hand of Your prophet,<tei:anchor xml:id="note_2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/neqaddesh/6"/>And they called one to another, and said:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" target="#note_1" xml:lang="en">
