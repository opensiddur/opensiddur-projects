  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/shanim">
        <tei:head xml:lang="en">PRAYER FOR PROSPERITY</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/1"/>Bless for us, Adonoy our God,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/2"/>this year
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/3"/>and all the varieties of its produce
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/4"/>for good;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/5"/>and bestow
<tei:milestone unit="phrase"/>
<j:conditional xml:id="when_1"><tei:note type="instruction" xml:lang="en">From the first say of Pesach until the evening service [<tei:hi rend="italic">Maariv</tei:hi>] on December 4, or, on a civil leap year, December 5, we say the following line.</tei:note><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="tal-umatar"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/6"/>blessing
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_1"/>
<j:conditional xml:id="when_2"><tei:note type="instruction" xml:lang="en">From the evening service [<tei:hi rend="italic">Maariv</tei:hi>] on December 4, or, on a civil leap year, December 5, until the First day of Pesach, we say the following line.</tei:note><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="tal-umatar"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/7"/>dew and rain for a blessing*
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/8"/>upon the face of the earth;
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/shanim/chol_minchah_shemoneh_esreh"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/15"/>satisfy us from its bounty
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/16"/>and bless our year
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/17"/>as other good years, for blessing,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/shanim/chol_arvit_shemoneh_esreh"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/18"/>satisfy us from its bounty
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/19"/>and bless our year
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/20"/>as other good years, for blessing,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/shanim/chol_minchah_shemoneh_esreh"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/shanim/chol_arvit_shemoneh_esreh"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/9"/>satisfy us from Your bounty<tei:anchor xml:id="note_1"/>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_5"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/10"/>for you are generous Almighty
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/11"/>who bestows goodness
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/12"/>and blesses the years.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/13"/>Blessed are You, Adonoy,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/14"/>Blesser of the years.
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_2"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" target="#note_1" xml:lang="en">
      <tei:p>According to the Gaon of Vilna, the petition here reads מטובה, “Satisfy us from <tei:hi rend="italic">its</tei:hi> bounty”, referring to the bounty of Eretz Yisroel.</tei:p>
    </tei:note>
  </tei:standOff>
</tei:TEI>