            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:yehi_khevod"/>
        <j:endDeclare target="#variants_2"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/chatzi"/>
