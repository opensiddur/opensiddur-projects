      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/arvit/blessings_after_shema">
        <tei:head xml:lang="en">Berachos Following Shema</tei:head>
        <tei:note type="instruction" xml:lang="en">This is the first of the two berachos that follow the Shema.</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:emet_veemunah/opening"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:emet_veemunah/mosheh"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:emet_veemunah/mi_khamokhah"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:emet_veemunah/malkhutekha"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:emet_veemunah/yimlokh"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:emet_veemunah/seal"/>
        <j:declare xml:id="variants_1">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:hashkivenu/chol_keriat_shema_al_hamittah">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:hashkivenu"/>
        <j:endDeclare target="#variants_1"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:barukh_adonai_leolam"/>
        <j:declare xml:id="variants_2">
          <tei:fs type="opensiddur:variant">
