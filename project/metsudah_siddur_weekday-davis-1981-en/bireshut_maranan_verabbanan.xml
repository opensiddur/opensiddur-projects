  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:bireshut_maranan_verabbanan">
        <tei:p><tei:note type="instruction" xml:lang="en"><tei:hi rend="italic">The leader continues: (the words "our God" are substituted for "Him" and "He" if ten males are in the group):</tei:hi></tei:note><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bireshut_maranan_verabbanan/1"/>"With your permission
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bireshut_maranan_verabbanan/2"/>our masters and teachers,
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:bireshut_maranan_verabbanan/lifecycle_sheva_berakhot_birkat_hamazon"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bireshut_maranan_verabbanan/8"/>let us bless our God,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bireshut_maranan_verabbanan/9"/>in Whose abode is joy<tei:anchor xml:id="note_1"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bireshut_maranan_verabbanan/10"/>for we have eaten of His bounty.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:bireshut_maranan_verabbanan/lifecycle_sheva_berakhot_birkat_hamazon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bireshut_maranan_verabbanan/3"/>Let us bless (our God,) Him,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:bireshut_maranan_verabbanan/lifecycle_sheva_berakhot_birkat_hamazon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bireshut_maranan_verabbanan/4"/>for we have eaten of His bounty."
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<tei:note type="instruction" xml:lang="en"><tei:hi rend="italic">The others respond accordingly:</tei:hi></tei:note>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:bireshut_maranan_verabbanan/lifecycle_sheva_berakhot_birkat_hamazon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bireshut_maranan_verabbanan/5"/>Blessed is (our God) He
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:bireshut_maranan_verabbanan/lifecycle_sheva_berakhot_birkat_hamazon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bireshut_maranan_verabbanan/6"/>for we have eaten of His bounty
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_5"/>
<j:conditional xml:id="variant_6"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:bireshut_maranan_verabbanan/lifecycle_sheva_berakhot_birkat_hamazon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bireshut_maranan_verabbanan/7"/>and through His goodness we live.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_6"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" target="#note_1" xml:lang="en">
      <tei:p>The phrase “in Whose abode is joy” is recited only when the meal is conducted with the decorum of sanctity, without the commingling of men and women. For there is no joy in God’s abode when commingling takes place.</tei:p>
    </tei:note>
  </tei:standOff>
</tei:TEI>