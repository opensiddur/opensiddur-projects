  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:addir_bamarom_shokhen">
        <tei:p><tei:note type="instruction" xml:lang="en"><tei:hi rend="italic">After Birkas Kohanim the congregation says:</tei:hi></tei:note><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:addir_bamarom_shokhen/1"/>Mighty One on high who dwells in might,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:addir_bamarom_shokhen/2"/>You are peace and Your Name is peace.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:addir_bamarom_shokhen/3"/>May it be Your will that You grant us
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:addir_bamarom_shokhen/4"/>and all of Your people, the House of Israel
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:addir_bamarom_shokhen/5"/>life and blessing
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:addir_bamarom_shokhen/6"/>for a safeguard to peace.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
