      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/minchah/aleinu">
        <tei:head xml:lang="en">Aleinu</tei:head>
        <j:declare xml:id="variants_1">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:aleinu/chol_arvit_aleinu">
