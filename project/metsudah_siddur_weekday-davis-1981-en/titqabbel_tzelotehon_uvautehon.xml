  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:titqabbel_tzelotehon_uvautehon">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:titqabbel_tzelotehon_uvautehon/1"/>May there be acceptance
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:titqabbel_tzelotehon_uvautehon/2"/>of the prayers and supplications
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:titqabbel_tzelotehon_uvautehon/3"/>of the entire House of Israel
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:titqabbel_tzelotehon_uvautehon/4"/>before their Father in heaven.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:titqabbel_tzelotehon_uvautehon/5"/>And say, Amein.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:titqabbel_tzelotehon_uvautehon/6"/>May there be abundant peace from heaven
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:titqabbel_tzelotehon_uvautehon/7"/>and good life
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:titqabbel_tzelotehon_uvautehon/8"/>for us and for all Israel,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:titqabbel_tzelotehon_uvautehon/9"/>—and say Amein.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:titqabbel_tzelotehon_uvautehon/10"/>He Who makes peace in His high heavens
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:titqabbel_tzelotehon_uvautehon/11"/>may He, make peace
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:titqabbel_tzelotehon_uvautehon/12"/>for us and for all Israel,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:titqabbel_tzelotehon_uvautehon/13"/>—and say Amein.</tei:p>
      </tei:div>
