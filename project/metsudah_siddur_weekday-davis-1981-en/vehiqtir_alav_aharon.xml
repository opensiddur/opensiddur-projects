  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:vehiqtir_alav_aharon">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/30/7"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehiqtir_alav_aharon/1"/>And Aaron shall burn upon it [the Altar]
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehiqtir_alav_aharon/2"/>incense of spices every morning;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehiqtir_alav_aharon/3"/>when he cleans the lamps
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehiqtir_alav_aharon/4"/>he will burn it.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/30/8"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehiqtir_alav_aharon/5"/>And when Aaron lights the lamps
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehiqtir_alav_aharon/6"/>in the afternoon,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehiqtir_alav_aharon/7"/>he will burn it;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehiqtir_alav_aharon/8"/>a constant incense-offering before Adonoy
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehiqtir_alav_aharon/9"/>throughout your generations.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
