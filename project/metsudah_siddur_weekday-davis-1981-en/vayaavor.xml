  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:vayaavor">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/34/6"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/1"/>And Adonoy passed before him [Moses]
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/2"/>and proclaimed:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/3"/>Adonoy, Adonoy,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/4"/>Almighty, Merciful, Gracious,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/5"/>Slow to Anger,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/6"/>and Abundant in Kindness and Truth.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/34/7"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/7"/>Keeper of kindness
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/8"/>for thousands of generations,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/9"/>Endurer of iniquity and transgression,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/10"/>and sin,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/11"/>and Acquitter of those who repent.<tei:anchor xml:id="note_1"/>
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/12"/>And pardon our iniquity and our sin,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/13"/>and take us for Your inheritance.<tei:anchor xml:id="note_2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/14"/>Pardon us,our Father, for we have sinned,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/15"/>forgive us, our King, for we have transgressed.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/86/5"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/16"/>For You, my Master,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/17"/>are good and forgiving,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/18"/>and abounding in kindness
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/19"/>to all who call upon You.<tei:anchor xml:id="note_3"/>
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
