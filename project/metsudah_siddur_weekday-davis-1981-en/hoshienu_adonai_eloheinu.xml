  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hoshienu_adonai_eloheinu">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/106/47"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshienu_adonai_eloheinu/1"/>Deliver us Adonoy, our God,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshienu_adonai_eloheinu/2"/>and gather us from among the nations,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshienu_adonai_eloheinu/3"/>to give thanks to Your holy Name—
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshienu_adonai_eloheinu/4"/>to be extolled in Your praise.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/106/48"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshienu_adonai_eloheinu/5"/>Blessed is Adonoy, God of Israel
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshienu_adonai_eloheinu/6"/>from the world till the next world
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:hoshienu_adonai_eloheinu/chol_shacharit_shir_shel_yom"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshienu_adonai_eloheinu/10"/>and all the people said: "Amen"
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:hoshienu_adonai_eloheinu/chol_shacharit_shir_shel_yom"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshienu_adonai_eloheinu/7"/>and all the people said: "Amen, Praise God."
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<tei:milestone unit="verse"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:hoshienu_adonai_eloheinu/chol_shacharit_shir_shel_yom"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshienu_adonai_eloheinu/8"/>Let every soul praise God.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:hoshienu_adonai_eloheinu/chol_shacharit_shir_shel_yom"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshienu_adonai_eloheinu/9"/>Praise God.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/></tei:p>
      </tei:div>
