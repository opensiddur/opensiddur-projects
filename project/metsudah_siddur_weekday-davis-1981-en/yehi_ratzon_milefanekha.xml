  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:yehi_ratzon_milefanekha">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_ratzon_milefanekha/1"/>May it be Your will
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_ratzon_milefanekha/2"/>Adonoy, our God, and God of our fathers,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_ratzon_milefanekha/3"/>if I have committed a sin which requires,
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:yehi_ratzon_milefanekha/chol_shacharit_qetoret"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_ratzon_milefanekha/8"/>the bringing of a guilt-offering
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:yehi_ratzon_milefanekha/chol_shacharit_qetoret"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_ratzon_milefanekha/4"/>the bringing of a sin-offering,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_ratzon_milefanekha/5"/>that this recitation
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_ratzon_milefanekha/6"/>be acceptable before you
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:yehi_ratzon_milefanekha/chol_shacharit_qetoret"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_ratzon_milefanekha/9"/>as if I had brought a guilt-offering.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:yehi_ratzon_milefanekha/chol_shacharit_qetoret"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_ratzon_milefanekha/7"/>as if I had brought a sin-offering.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/></tei:p>
