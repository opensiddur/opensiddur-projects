  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:harachaman_berit_milah/2">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/2/1"/>May the Merciful One bless
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/2/2"/>the sandak at the circumcision covenant,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/2/3"/>who happily performed
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/2/4"/>this righteous deed in joy.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/2/5"/>May he be rewarded for his deed
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/2/6"/>with doubled recompense,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/2/7"/>and exalt him higher and higher.
<tei:milestone unit="phrase"/>
<tei:note type="instruction" xml:lang="en"><tei:hi rend="italic">All respond:</tei:hi></tei:note>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/2/8"/>Amen</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
