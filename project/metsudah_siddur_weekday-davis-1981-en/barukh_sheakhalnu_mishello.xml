  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:barukh_sheakhalnu_mishello">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_sheakhalnu_mishello/1"/>"Blessed is (our God) He
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_sheakhalnu_mishello/2"/>for we have eaten of His bounty
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_sheakhalnu_mishello/3"/>and through His goodness we live."
<tei:milestone unit="phrase"/>
<tei:note type="instruction" xml:lang="en"><tei:hi rend="italic">If there are at least 10 men, add:</tei:hi></tei:note>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:barukh_sheakhalnu_mishello/lifecycle_berit_milah_birkat_hamazon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_sheakhalnu_mishello/4"/>Blessed is He and blessed is His Name.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/></tei:p>
