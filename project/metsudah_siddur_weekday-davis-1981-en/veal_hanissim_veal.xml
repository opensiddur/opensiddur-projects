  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:veal_hanissim_veal">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hanissim_veal/1"/>[We thank You] for the miracles
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hanissim_veal/2"/>for the redemption, for the mighty deeds,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hanissim_veal/3"/>for the deliverances, for the wonders
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hanissim_veal/4"/>for the consolations and for the wars
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hanissim_veal/5"/>that You performed for our fathers
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hanissim_veal/6"/>in those days at this season.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
