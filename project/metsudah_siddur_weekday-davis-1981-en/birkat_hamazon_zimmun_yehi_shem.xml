  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:birkat_hamazon/zimmun/yehi_shem">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/zimmun/yehi_shem/1"/>"The Name of Adonoy will be blessed
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/zimmun/yehi_shem/2"/>from now forever."
<tei:milestone unit="phrase"/>
<tei:note type="instruction" xml:lang="en"><tei:hi rend="italic">The leader continues: (the words "our God" are substituted for "Him" and "He" if ten males are in the group):</tei:hi></tei:note>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/zimmun/yehi_shem/3"/>"With your permission
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/zimmun/yehi_shem/4"/>our masters and teachers,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/zimmun/yehi_shem/5"/>Let us bless (our God,) Him,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/zimmun/yehi_shem/6"/>for we have eaten of His bounty."
<tei:milestone unit="phrase"/>
<tei:note type="instruction" xml:lang="en"><tei:hi rend="italic">The others respond accordingly:</tei:hi></tei:note>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/zimmun/yehi_shem/7"/>Blessed is (our God) He
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/zimmun/yehi_shem/8"/>for we have eaten of His bounty
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/zimmun/yehi_shem/9"/>and through His goodness we live.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
