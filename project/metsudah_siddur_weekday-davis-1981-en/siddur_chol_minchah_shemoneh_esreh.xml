      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/minchah/shemoneh_esreh">
        <tei:head xml:lang="en">Shemoneh Esrei</tei:head>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:ki_shem_adonai"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/avot/barukh_attah"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/avot/zokhrenu"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/avot/magen_avraham"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/gevurot/attah_gibbor"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/gevurot/mekhalkel_chayyim"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/gevurot/mechayyeh_hametim"/>
        <tei:note type="instruction" xml:lang="en">(When the Chazzan repeats the Shemoneh Esrei, the Kedushah is said here)</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:naqdishakh_venaaritzakh_kenoam"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:yotzer_or/qadosh"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:leummatam_meshabbechim_veomerim_barukh"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/qedushat_hashem"/>
        <tei:note type="instruction" xml:lang="en">If you mistakenly said, “the Almighty” instead of “the King,” or if you are in doubt, see page 000.</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/binah/opening"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/teshuvah"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/selichah"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/geullah/reeh_na"/>
        <tei:note type="instruction" xml:lang="en">(On Fast Days, the Chazzan says “Answer us” and concludes, “Blessed are . . . Who responds at times of trouble.”)</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/refuah"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:ki_el_melekh"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/shanim/barekh_aleinu"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/qibbutz_galuyot"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/mishpat"/>
        <tei:note type="instruction" xml:lang="en">If you mistakenly said, “King, Lover of righteousness and justice,” instead of “the King of Justice,” see page 000.</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:velammalshinim_al_tehi"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/tzaddiqim"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/yerushalayim"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/nachem_hashem_eloheinu"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/david"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:av_harachaman_shema_qolenu"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/avodah/retzeh"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:yaaleh_veyavo/eloheinu_velohei"/>
        <tei:note type="instruction" xml:lang="en"><tei:hi rend="italic">At the words, </tei:hi>We are thankful, <tei:hi rend="italic">bend forward; at </tei:hi>Adonoy <tei:hi rend="italic">return to an upright position.</tei:hi></tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/hodaah/modim"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/hodaah/modim_derabbanan"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:veal_hanissim_veal"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:al_hanissim/chanukah/bimei"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:al_hanissim/purim/bimei"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/hodaah/veal_kullam"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/hodaah/ukhetov"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/hodaah/hatov_shimkha"/>
        <tei:note type="instruction" xml:lang="en">Birkas Kohanim is said by the Chazzan on public fast-days:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/birkat_kohanim"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/shalom"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/elohai_netzor/text"/>
        <tei:note type="instruction" xml:lang="en">On days when <tei:hi rend="italic">Tachanun</tei:hi> is omitted (see below) the chazzan continues with Kaddish. (14 and 15 Adar Rishon in a leap year); the entire month of Nissan; Pesach Sheini (14 Iyar); Lag BaOmer; 1-8 Sivan; 9 and 15 Av; and 29 Elul. When <tei:hi rend="italic">Tachanun</tei:hi> is omitted on these days, it is also omitted at the preceding Mincha (afternoon service).</tei:note>
      </tei:div>
