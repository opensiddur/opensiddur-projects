  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/minchah/shemoneh_esreh">
        <tei:head xml:lang="en">Shemoneh Esrei</tei:head>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:deuteronomy/32/3"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/adonai_sefatai"/>
        <j:declare xml:id="variants_1">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/avot/rosh_chodesh_musaf">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/avot/chol_hamoed_musaf">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/avot"/>
        <j:endDeclare target="#variants_1"/>
        <j:declare xml:id="variants_2">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/gevurot/rosh_chodesh_musaf">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/gevurot/chol_hamoed_musaf">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/gevurot"/>
        <j:endDeclare target="#variants_2"/>
        <j:conditional xml:id="when_1">
          <tei:note type="instruction" xml:lang="en">(When the Chazzan repeats the Shemoneh Esrei, the Kedushah is said here)</tei:note>
          <j:all>
            <tei:fs type="opensiddur:recitation">
              <tei:f name="repetition">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
            <tei:fs type="opensiddur:quorum">
              <tei:f name="minyan">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:all>
        </j:conditional>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/qedushah/neqaddesh"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/qedushah/qadosh"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/qedushah/leummatam"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/qedushah/barukh_kevod"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/qedushah/uvedivrei"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/qedushah/yimlokh"/>
        <j:endConditional target="#when_1"/>
        <j:declare xml:id="variants_3">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/qedushat_hashem/rosh_chodesh_musaf">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/qedushat_hashem/chol_hamoed_musaf">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/qedushat_hashem"/>
        <j:endDeclare target="#variants_3"/>
        <tei:note type="instruction" xml:lang="en">If you mistakenly said, “the Almighty” instead of “the King,” or if you are in doubt, see page 000.</tei:note>
        <j:declare xml:id="variants_4">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/binah/chol_arvit_shemoneh_esreh">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/binah"/>
        <j:endDeclare target="#variants_4"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/teshuvah"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/selichah"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/geullah"/>
        <tei:note type="instruction" xml:lang="en">(On Fast Days, the Chazzan says “Answer us” and concludes, “Blessed are . . . Who responds at times of trouble.”)</tei:note>
        <j:declare xml:id="variants_5">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/refuah/chol_minchah_shemoneh_esreh">
              <tei:binary value="true"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/refuah/chol_arvit_shemoneh_esreh">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/refuah"/>
        <j:endDeclare target="#variants_5"/>
        <j:declare xml:id="variants_6">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/shanim/chol_minchah_shemoneh_esreh">
              <tei:binary value="true"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/shanim/chol_arvit_shemoneh_esreh">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/shanim"/>
        <j:endDeclare target="#variants_6"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/qibbutz_galuyot"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/mishpat"/>
        <tei:note type="instruction" xml:lang="en">If you mistakenly said, “King, Lover of righteousness and justice,” instead of “the King of Justice,” see page 000.</tei:note>
        <j:declare xml:id="variants_7">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/minim/chol_minchah_shemoneh_esreh">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/minim"/>
        <j:endDeclare target="#variants_7"/>
        <j:declare xml:id="variants_8">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/tzaddiqim/chol_minchah_shemoneh_esreh">
              <tei:binary value="true"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/tzaddiqim/chol_arvit_shemoneh_esreh">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/tzaddiqim"/>
        <j:endDeclare target="#variants_8"/>
        <j:declare xml:id="variants_9">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/yerushalayim/chol_minchah_shemoneh_esreh">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/yerushalayim"/>
        <j:endDeclare target="#variants_9"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/david"/>
        <j:declare xml:id="variants_10">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/tefillah/opening/chol_minchah_shemoneh_esreh">
              <tei:binary value="true"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/tefillah/opening/chol_arvit_shemoneh_esreh">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/tefillah/opening"/>
        <j:endDeclare target="#variants_10"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/aneinu/opening"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/avodah/retzeh"/>
        <j:declare xml:id="variants_11">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:yaaleh_veyavo/berakhot_birkat_hamazon">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:yaaleh_veyavo"/>
        <j:endDeclare target="#variants_11"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/avodah/vetechezeinah"/>
        <tei:note type="instruction" xml:lang="en"><tei:hi rend="italic">At the words, </tei:hi>We are thankful, <tei:hi rend="italic">bend forward; at </tei:hi>Adonoy <tei:hi rend="italic">return to an upright position.</tei:hi></tei:note>
        <j:declare xml:id="variants_12">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/hodaah/modim/chol_minchah_shemoneh_esreh">
              <tei:binary value="true"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/hodaah/modim/chol_arvit_shemoneh_esreh">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/hodaah/modim"/>
        <j:endDeclare target="#variants_12"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/hodaah/modim_derabbanan"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:al_hanissim"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:al_hanissim/chanukah/bimei"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:al_hanissim/purim/bimei"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/hodaah/veal_kullam"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/hodaah/ukhetov"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/hodaah/hatov_shimkha"/>
        <j:conditional xml:id="when_2">
          <tei:note type="instruction" xml:lang="en">Birkas Kohanim is said by the Chazzan on public fast-days:</tei:note>
          <j:any>
            <tei:fs type="opensiddur:holiday-aggregate">
              <tei:f name="minor-fast">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
            <tei:fs type="opensiddur:holiday">
              <tei:f name="tisha-bav">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:any>
        </j:conditional>
        <j:declare xml:id="variants_13">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/birkat_kohanim/rosh_chodesh_musaf">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/birkat_kohanim/chol_hamoed_musaf">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/birkat_kohanim"/>
        <j:endDeclare target="#variants_13"/>
        <j:endConditional target="#when_2"/>
        <j:declare xml:id="variants_14">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/shalom/chol_arvit_shemoneh_esreh">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/shalom/rosh_chodesh_musaf">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/shalom/chol_hamoed_musaf">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/shalom"/>
        <j:endDeclare target="#variants_14"/>
        <j:declare xml:id="variants_15">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/elohai_netzor/chol_minchah_shemoneh_esreh">
              <tei:binary value="true"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/elohai_netzor/chol_arvit_shemoneh_esreh">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/elohai_netzor/rosh_chodesh_musaf">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/elohai_netzor/chol_hamoed_musaf">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/elohai_netzor"/>
        <j:endDeclare target="#variants_15"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/yehi_ratzon"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:malachi/3/4"/>
        <tei:note type="instruction" xml:lang="en">On days when <tei:hi rend="italic">Tachanun</tei:hi> is omitted (see below) the chazzan continues with Kaddish. (14 and 15 Adar Rishon in a leap year); the entire month of Nissan; Pesach Sheini (14 Iyar); Lag BaOmer; 1-8 Sivan; 9 and 15 Av; and 29 Elul. When <tei:hi rend="italic">Tachanun</tei:hi> is omitted on these days, it is also omitted at the preceding Mincha (afternoon service).</tei:note>
      </tei:div>
    </tei:body>
  </tei:text>
