  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:raq_hishamer_lekha">
        <tei:head xml:lang="en">
          <tei:hi rend="italic">The Revelation at Mount Sinai</tei:hi>
        </tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:raq_hishamer_lekha/1"/>Only beware,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:raq_hishamer_lekha/2"/>and guard you soul diligently,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:raq_hishamer_lekha/3"/>lest you forget the things
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:raq_hishamer_lekha/4"/>which your eyes have seen;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:raq_hishamer_lekha/5"/>lest they be removed from your heart
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:raq_hishamer_lekha/6"/>all the days of your life;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:raq_hishamer_lekha/7"/>and make them known to your children
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:raq_hishamer_lekha/8"/>and to your children's children.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:raq_hishamer_lekha/9"/>[That what you witnessed] the day you stood
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:raq_hishamer_lekha/10"/>before Adonoy your God at Chorev.<tei:anchor xml:id="note_1"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" target="#note_1" xml:lang="en">
      <tei:p>Deuteronomy 4:9-10.</tei:p>
    </tei:note>
  </tei:standOff>
