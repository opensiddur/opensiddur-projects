  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:sefirat_haomer/psalm_67">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/67/1"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/psalm_67/1"/>To the Chief Musician:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/psalm_67/2"/>a Psalm with instrumental music, a song.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/67/2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/psalm_67/3"/>[May] God favor us and bless us,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/psalm_67/4"/>[may He] cause His countenance to shine
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/psalm_67/5"/>among us <tei:hi rend="italic">Selah</tei:hi>;
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/67/3"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/psalm_67/6"/>[So] that Your way become known on earth,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/psalm_67/7"/>[and] Your deliverance among all nations.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/67/4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/psalm_67/8"/>Peoples will thank You, God,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/psalm_67/9"/>all the peoples will thank You.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/67/5"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/psalm_67/10"/>Nations will rejoice and sing
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/psalm_67/11"/>when You judge the peoples justly,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/psalm_67/12"/>and lead the nations upon the earth <tei:hi rend="italic">Selah</tei:hi>.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/67/6"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/psalm_67/13"/>Peoples will thank You, God,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/psalm_67/14"/>all the peoples will thank You.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/67/7"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/psalm_67/15"/>The earth will have yielded its produce;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/psalm_67/16"/>God, our God, will have blessed us.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/67/8"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/psalm_67/17"/>God will bless us,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/psalm_67/18"/>and they will fear Him—
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/psalm_67/19"/>all [men even from] the ends of the earth.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
