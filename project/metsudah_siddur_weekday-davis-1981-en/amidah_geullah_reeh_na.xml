  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/geullah/reeh_na">
        <tei:head xml:lang="en">PRAYER FOR REDEMPTION</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/geullah/reeh_na/1"/>Look, please, upon our affliction,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/geullah/reeh_na/2"/>and defend our cause:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/geullah/reeh_na/3"/>and redeem us
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/geullah/reeh_na/4"/>speedily<tei:anchor xml:id="note_1"/> with complete redemption
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/geullah/reeh_na/5"/>for the sake of Your Name;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/geullah/reeh_na/6"/>because You are a Mighty Redeemer.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/geullah/reeh_na/7"/>Blessed are You, Adonoy,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/geullah/reeh_na/8"/>Redeemer of Israel.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" target="#note_1" xml:lang="en">
      <tei:p>As an outgrowth of our penitence and our forgiveness we pray that we may be deemed worthy of Divine redemption.—<tei:hi rend="italic">Kuzari</tei:hi></tei:p>
    </tei:note>
  </tei:standOff>
