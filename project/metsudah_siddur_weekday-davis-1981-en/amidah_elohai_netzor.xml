<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/39"/>He Who makes peace
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/40"/>in His high heavens
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
