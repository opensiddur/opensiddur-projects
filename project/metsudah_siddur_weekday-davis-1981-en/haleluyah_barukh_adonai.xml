  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:haleluyah_barukh_adonai">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haleluyah_barukh_adonai/1"/>Praise God.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haleluyah_barukh_adonai/2"/>Blessed is Adonoy from Zion,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haleluyah_barukh_adonai/3"/>Who dwells in Jerusalem.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haleluyah_barukh_adonai/4"/>Praise God.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haleluyah_barukh_adonai/5"/>Blessed is Adonoy, God,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haleluyah_barukh_adonai/6"/>God of Israel
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haleluyah_barukh_adonai/7"/>Who alone performs wonders.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haleluyah_barukh_adonai/8"/>And blessed is the Name of His glory forever,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haleluyah_barukh_adonai/9"/>and may His glory fill the whole earth.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haleluyah_barukh_adonai/10"/>Amen and Amen!</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
