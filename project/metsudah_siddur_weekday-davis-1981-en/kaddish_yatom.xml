  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:kaddish/yatom">
        <tei:head xml:lang="en">Mourner's Kaddish</tei:head>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/chatzi"/>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/yatom/22"/>May there be abundant peace from heaven
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/yatom/chol_minchah_aleinu"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/yatom/32"/>and good life
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/yatom/chol_minchah_aleinu"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/yatom/23"/>and life
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/yatom/24"/>for us and for all Israel,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/yatom/25"/>—and say Amein.
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/yatom/chol_arvit_aleinu"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/yatom/33"/>He Who makes peace in His high heavens
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/yatom/chol_arvit_aleinu"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/yatom/26"/>He Who makes peace
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/yatom/chol_arvit_aleinu"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/yatom/27"/>(<tei:hi rend="italic">Ten Days of Penitence:</tei:hi> the peace)
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_5"/>
<j:conditional xml:id="variant_6"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/yatom/chol_arvit_aleinu"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/yatom/28"/>in His high heavens
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_6"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/yatom/29"/>may He, make peace
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/yatom/30"/>for us and for all Israel,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/yatom/31"/>and say, Amen.</tei:p>
      </tei:div>
