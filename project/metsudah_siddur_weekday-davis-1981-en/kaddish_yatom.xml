  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:kaddish/yatom">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/yatom/1"/>May there be abundant peace from heaven
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/yatom/2"/>and life
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/yatom/3"/>for us and for all Israel,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/yatom/4"/>—and say Amein.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/yatom/5"/>He Who makes peace in His high heavens
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/yatom/6"/>may He, make peace
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/yatom/7"/>for us and for all Israel,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/yatom/8"/>—and say Amein.</tei:p>
      </tei:div>
    </tei:body>
