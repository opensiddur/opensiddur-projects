      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/mizmor_shir">
        <tei:head xml:lang="en">Mizmor Shir</tei:head>
        <tei:note type="instruction" xml:lang="en">Psalm 30, once used to inaugurate the Holy Temple, is used today to inaugurate our daily prayers, for the synagogue is a "Holy Temple in miniature" and our prayers take the place of the sacrifices. It is both a prayer for success and a declaration of thanksgiving.</tei:note>
