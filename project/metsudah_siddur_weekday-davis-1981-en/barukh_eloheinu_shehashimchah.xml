  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:barukh_eloheinu_shehashimchah">
        <tei:p><tei:note type="instruction" xml:lang="en"><tei:hi rend="italic">The others respond:</tei:hi></tei:note><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_shehashimchah/1"/>Blessed is our God
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_shehashimchah/2"/>in Whose abode is joy
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_shehashimchah/3"/>for we have eaten of His bounty
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_shehashimchah/4"/>and through His goodness we live.
<tei:milestone unit="phrase"/>
<tei:note type="instruction" xml:lang="en"><tei:hi rend="italic">The leader repeats:</tei:hi></tei:note>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_shehashimchah/5"/>Blessed is our God,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_shehashimchah/6"/>in Whose abode is joy
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_shehashimchah/7"/>[and] we have eaten of His bounty
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_shehashimchah/8"/>and through His goodness we live.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
