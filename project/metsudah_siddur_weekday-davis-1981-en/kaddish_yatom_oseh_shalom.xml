<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/yatom/oseh_shalom/chol_arvit_aleinu"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/yatom/oseh_shalom/chol_arvit_aleinu_136"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
