  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:tallith/mah_yaqar">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/36/8"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/mah_yaqar/1"/>How precious is Your kindness, God;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/mah_yaqar/2"/>the children of men
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/mah_yaqar/3"/>take refuge in the shadow of Your wings.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/36/9"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/mah_yaqar/4"/>They will be filled
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/mah_yaqar/5"/>from the abundance of Your House,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/mah_yaqar/6"/>and from the stream of Your delights
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/mah_yaqar/7"/>You will give them to drink.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/36/10"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/mah_yaqar/8"/>For with You is the source of life,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/mah_yaqar/9"/>in Your light shall we see light.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/36/11"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/mah_yaqar/10"/>Extend Your kindness
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/mah_yaqar/11"/>to those who know You,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/mah_yaqar/12"/>and Your righteousness
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/mah_yaqar/13"/>to the upright in heart.<tei:anchor xml:id="note_1"/>
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
