  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/chaddesh_aleinu">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/chaddesh_aleinu/1"/>Our G-d and G-d of our fathers
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/chaddesh_aleinu/2"/>renew for us this month
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/chaddesh_aleinu/3"/>for goodness and for blessing,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/chaddesh_aleinu/4"/>for delight and for rejoicing,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/chaddesh_aleinu/5"/>for deliverance and for consolation,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/chaddesh_aleinu/6"/>for maintenance and for sustenance,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/chaddesh_aleinu/7"/>for life and for peace,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/chaddesh_aleinu/8"/>for the forgiving of sin<tei:anchor xml:id="note_1"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/chaddesh_aleinu/9"/>and for the pardoning of iniquity<tei:anchor xml:id="note_2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/chaddesh_aleinu/10"/><tei:hi rend="italic">(In a leap year add:</tei:hi>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/chaddesh_aleinu/11"/>and for atonement of transgression)<tei:anchor xml:id="note_3"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/chaddesh_aleinu/12"/>For You have chosen Your People, Israel,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/chaddesh_aleinu/13"/>from all the peoples,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/chaddesh_aleinu/14"/>and statutes of Rosh Chodesh
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/chaddesh_aleinu/15"/>have You instituted for them.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/chaddesh_aleinu/16"/>Blessed are You, Adonoy,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/chaddesh_aleinu/17"/>Sanctifier of Israel
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/chaddesh_aleinu/18"/>and the Rosh Chodesh days.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" target="#note_1" xml:lang="en">
      <tei:p>Committed unknowingly.</tei:p>
    </tei:note>
    <tei:note type="commentary" target="#note_2" xml:lang="en">
      <tei:p>Committed knowingly.</tei:p>
    </tei:note>
    <tei:note type="commentary" target="#note_3" xml:lang="en">
      <tei:p>Committed maliciously.</tei:p>
    </tei:note>
  </tei:standOff>
