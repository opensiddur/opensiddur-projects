  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:birkat_kohanim">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/6/24"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_kohanim/1"/>May Adonoy bless you and guard you.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/6/25"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_kohanim/2"/>May Adonoy shine
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_kohanim/3"/>His countenance upon you
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_kohanim/4"/>and be gracious unto you.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/6/26"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_kohanim/5"/>May Adonoy turn
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_kohanim/6"/>His countenance toward you
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_kohanim/7"/>and grant you peace.<tei:anchor xml:id="note_1"/>
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
