  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:velammalshinim_al_tehi">
        <tei:head xml:lang="en">PRAYER FOR DIVINE RETRIBUTION</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:velammalshinim_al_tehi/1"/>For informers let there be no hope
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:velammalshinim_al_tehi/2"/>and may all wickedness instantly perish
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:velammalshinim_al_tehi/3"/>may all Your enemies be swiftly cut off,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:velammalshinim_al_tehi/4"/>and the insolent may You quickly uproot,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:velammalshinim_al_tehi/5"/>crush, rout, disgrace, humble
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:velammalshinim_al_tehi/6"/>and subdue speedily in our days.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:velammalshinim_al_tehi/7"/>Blessed are You, Adonoy,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:velammalshinim_al_tehi/8"/>Crusher of enemies
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:velammalshinim_al_tehi/9"/>and Subduer of the insolent.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
