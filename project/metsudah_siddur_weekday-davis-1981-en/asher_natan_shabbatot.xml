  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:asher_natan_shabbatot">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_natan_shabbatot/1"/>Blessed are You, Adonoy
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_natan_shabbatot/2"/>our God, King of the Universe,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_natan_shabbatot/3"/>Who gave Shabbosos for rest
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_natan_shabbatot/4"/>to His people Israel with love
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_natan_shabbatot/5"/>for a sign and a covenant.
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:asher_natan_shabbatot/berakhot_birkat_hamazon"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_natan_shabbatot/8"/>and Yomim Tovim for happiness and joy,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_natan_shabbatot/9"/>this day of (name the Yom Tov.)
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:asher_natan_shabbatot/berakhot_birkat_hamazon_453"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_natan_shabbatot/11"/>and Yomim Tovim to Israel,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_natan_shabbatot/12"/>for remembrance.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_natan_shabbatot/6"/>Blessed are You Adonoy,
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:asher_natan_shabbatot/berakhot_birkat_hamazon"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_natan_shabbatot/10"/>Sanctifier of Shabbos, Israel,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:asher_natan_shabbatot/berakhot_birkat_hamazon_453"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_natan_shabbatot/13"/>Sanctifier of Shabbos, Israel,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:asher_natan_shabbatot/berakhot_birkat_hamazon"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:asher_natan_shabbatot/berakhot_birkat_hamazon_453"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_natan_shabbatot/7"/>Sanctifier of Shabbos.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_5"/></tei:p>
