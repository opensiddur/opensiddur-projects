    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:oro_se_do_bheatha_abhaile_pearse">
        <tei:head>הוֹי בָּרוּך הַבָּא הַבַּֽיתָה (Hoy! Barukh ha-Ba ha-Baitah) — adapted by Pádraig Pearse (1916; Hebrew translation by Isaac Gantwerk Mayer)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:oro_se_do_bheatha_abhaile_pearse/1"/>
        <tei:lg>
          <tei:l>הוֹי בָּרוּך הַבָּא הַבַּֽיתָה</tei:l>
          <tei:l>הוֹי בָּרוּך הַבָּא הַבַּֽיתָה</tei:l>
          <tei:l>הוֹי בָּרוּך הַבָּא הַבַּֽיתָה</tei:l>
          <tei:l>כִּי הַקַּֽיִּץ בָּא עָלֵֽינוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:oro_se_do_bheatha_abhaile_pearse/2"/>
        <tei:lg>
          <tei:l>עֲנִיָּה סֹעֲרָה בּֽוֹאִי אֵלֵֽינוּ</tei:l>
          <tei:l>שִׁעְבּוּדֵךְ חׇרְבָּן עָלֵֽינוּ</tei:l>
          <tei:l>בְּיַד גַּנָּבִים טוּב אַרְצֵֽנוּ</tei:l>
          <tei:l>וְאַתְּ נִמְכַּרְתְּ לַגּוֹיִם׃</tei:l>
          <tei:l>הוֹי בָּרוּך...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:oro_se_do_bheatha_abhaile_pearse/3"/>
        <tei:lg>
          <tei:l>אֶת־צֶֽמַח יָבוֹא אַֽרְצָה</tei:l>
          <tei:l>שִׁשִּׁים גִּבּוֹרִים סָבִיב לוֹ חֽוּצָה</tei:l>
          <tei:l>חָבֵרִים, לֹא זָרִים בַּקְּבוּצָה</tei:l>
          <tei:l>לִנְצֹֽחַ עַל הַגּוֹיִם׃</tei:l>
          <tei:l>הוֹי בָּרוּך...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:oro_se_do_bheatha_abhaile_pearse/4"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן לִפְנֵי עֹֽשֶׂה פֶֽלֶא</tei:l>
          <tei:l>שֶׁתֶּחֱזֶֽנָּה עֵינֵֽינוּ אֶת־אֵֽלֶּה</tei:l>
          <tei:l>בִּיאַת הַגּוֹאֵל לִגְאֹל מִכֶּלֶֽא</tei:l>
          <tei:l>וּלְפַזֵּר אֶת־הַגּוֹיִם׃</tei:l>
          <tei:l>הוֹי בָּרוּך...</tei:l>
        </tei:lg>
      </tei:div>
