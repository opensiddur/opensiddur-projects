  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:yedidi_sim_severa_qaraite">
        <tei:head>יְדִידִי שִׂים סְבָרָא</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yedidi_sim_severa_qaraite/1"/>
        <tei:lg>
          <tei:l>יְדִידִי שִׂים סְבָרָא</tei:l>
          <tei:l>וְכַוָּנָה כְשֵׁרָה</tei:l>
          <tei:l>קְרַב לִקְרֹא בְּתוֹרָה</tei:l>
          <tei:l>בְּרֵאשִׁית בָּרָא</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>קְרַב לִקְרֹא בְּתוֹרָה</tei:l>
          <tei:l>בְּרֵאשִׁית בָּרָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yedidi_sim_severa_qaraite/2"/>
        <tei:lg>
          <tei:l>צְבִי חֵן תּוֹךְ חֲבֵרִים</tei:l>
          <tei:l>וּמִגֶּזַע יְשָׁרִים</tei:l>
          <tei:l>וְשֹׁרֶשׁ הַבְּרוּרִים</tei:l>
          <tei:l>בְּרֵאשִׁית בָּרָא</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>קְרַב לִקְרֹא בְּתוֹרָה</tei:l>
          <tei:l>בְּרֵאשִׁית בָּרָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yedidi_sim_severa_qaraite/3"/>
        <tei:lg>
          <tei:l>חֲזַק וֶאֱמָץ וְתָשִׁית</tei:l>
          <tei:l>לְבָב חָתָן בְּרֵאשִׁית</tei:l>
          <tei:l>בְּעִיּוּנִית וּמַעֲשִׂית</tei:l>
          <tei:l>בְּרֵאשִׁית בָּרָא</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>קְרַב לִקְרֹא בְּתוֹרָה</tei:l>
          <tei:l>בְּרֵאשִׁית בָּרָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yedidi_sim_severa_qaraite/4"/>
        <tei:lg>
          <tei:l>קְרֹא קִרְאוּ בְשִׁירִים</tei:l>
          <tei:l>וּמִזְמוֹרִים יְקָרִים</tei:l>
          <tei:l>לְאַשֵּׁר בֶּן גְּבִירִים</tei:l>
          <tei:l>בְּרֵאשִׁית בָּרָא</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>קְרַב לִקְרֹא בְּתוֹרָה</tei:l>
          <tei:l>בְּרֵאשִׁית בָּרָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yedidi_sim_severa_qaraite/5"/>
        <tei:lg>
          <tei:l>חֲסָדָיו צוּר יְצַוֶּה</tei:l>
          <tei:l>בְּעָתִיד גַּם בְּהֹוֶה</tei:l>
          <tei:l>בְּטוּבוֹ לָךְ יְרַוֶּה</tei:l>
          <tei:l>בְּרֵאשִׁית בָּרָא</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>קְרַב לִקְרֹא בְּתוֹרָה</tei:l>
          <tei:l>בְּרֵאשִׁית בָּרָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yedidi_sim_severa_qaraite/6"/>
        <tei:lg>
          <tei:l>זְכוּת אָבוֹת תְּדִירָה</tei:l>
          <tei:l>לְךָ מָגֵן וְסִתְרָה</tei:l>
          <tei:l>לְהַצִּילְךָ מִצָּרָה</tei:l>
          <tei:l>בְּרֵאשִׁית בָּרָא</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>קְרַב לִקְרֹא בְּתוֹרָה</tei:l>
          <tei:l>בְּרֵאשִׁית בָּרָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yedidi_sim_severa_qaraite/7"/>
        <tei:lg>
          <tei:l>קְדֹשִׁי הַמְזַכֶּה</tei:l>
          <tei:l>לְהַתְחִיל כֵּן יְזַכֶּה</tei:l>
          <tei:l>לְהַשְׁלִימָהּ</tei:l>
          <tei:l>לְחוֹכֵי</tei:l>
          <tei:l>בְּרֵאשִׁית בָּרָא</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>קְרַב לִקְרֹא בְּתוֹרָה</tei:l>
          <tei:l>בְּרֵאשִׁית בָּרָא</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
