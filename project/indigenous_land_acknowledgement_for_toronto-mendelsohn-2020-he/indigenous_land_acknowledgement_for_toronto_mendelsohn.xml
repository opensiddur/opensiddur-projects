    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:indigenous_land_acknowledgement_for_toronto_mendelsohn">
        <tei:head>הַכָּרָת רִבּוֹנוּת הָאָרֶץ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:indigenous_land_acknowledgement_for_toronto_mendelsohn/1"/>
        <tei:lg>
          <tei:l>כוונה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:indigenous_land_acknowledgement_for_toronto_mendelsohn/2"/>
        <tei:lg>
          <tei:l>הִנְנִי מוּכָן וּמְזוּמָּן \ מוּכָנָה וּמְזַמֶּנֶת</tei:l>
          <tei:l>לְקַיֵּם מִצְוַת הַכָּרָת רִבּוֹנוּת הָאָרֶץ</tei:l>
          <tei:l>לְשֵׁם יִחוּד.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:indigenous_land_acknowledgement_for_toronto_mendelsohn/3"/>
        <tei:lg>
          <tei:l>כָּכַּתוּב:</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וּנְטַעְתִּים עַל־אַדְמָתָם</tei:l>
          <tei:l>וְלֹא יִנָּתְשׁוּ עוֹד מֵעַל אַדְמָתָם</tei:l>
          <tei:l>אֲשֶׁר נָתַתִּי לָהֶם</tei:l>
          <tei:l>אָמַר יְהוָה אֱלֹהֶיךָ׃ <tei:bibl>(עמוס ט:טו)</tei:bibl>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:indigenous_land_acknowledgement_for_toronto_mendelsohn/4"/>
        <tei:lg>
          <tei:l>וְהָאָרֶץ לֹא תִמָּכֵר לִצְמִתֻת</tei:l>
          <tei:l>כִּי־לִי הָאָרֶץ</tei:l>
          <tei:l>כִּי־גֵרִים וְתוֹשָׁבִים אַתֶּם</tei:l>
          <tei:l>עִמָּדִי׃ <tei:bibl>(ויקרא כה:כג)</tei:bibl>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:indigenous_land_acknowledgement_for_toronto_mendelsohn/5"/>
        <tei:lg>
          <tei:l>הַכָּרָת רִבּוֹנוּת הָאָרֶץ</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
