    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:mah_zeh_ayachel_hapaytan">
        <tei:head>מַה זֶּה אֲיַחֵל</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mah_zeh_ayachel_hapaytan/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שִׁ</tei:seg>מְעוּ וְהַאֲזִֽינוּ וַאֲדַבְּרָה אָֽנִי</tei:l>
          <tei:l>אוֹמְרָ֤ה ׀ לְאֵ֥ל סַלְעִי֮ לָמָ֢ה שְׁכַ֫חְתָּ֥נִי <tei:bibl>(תהלים מב:י)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mah_zeh_ayachel_hapaytan/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מַ</tei:seg>ה זֶּה אֲיַחֵל עוֹד אַחַר אֲשֶׁר מוֹנַי</tei:l>
          <tei:l>גָּבְרוּ עָלַי וְנֶאֶסְפוּ וְהִכּֽוּנִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mah_zeh_ayachel_hapaytan/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וּ</tei:seg>בְנֵי מוֹאָב וַעֲרָב שׁוּחָה לְלׇכְדֵֽנִי</tei:l>
          <tei:l>כָּֽרוּ וְכָאֵֽלֶּה רַבּוֹת מְצָאֽוּנִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mah_zeh_ayachel_hapaytan/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אִ</tei:seg>ם בַּשְּׂמֹאל אֶתְמוֹל דָּחֹה דְּחִיתַֽנִי</tei:l>
          <tei:l>אָנָּא יְמִין עֻזָּךְ הַיּוֹם תְּקׇרְבֵֽנִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mah_zeh_ayachel_hapaytan/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">לִ</tei:seg>דְבַר שְׂפָתִי אֵל תַּקְשִׁיב וְתֹאמַר</tei:l>
          <tei:l>עַל־בָּנַ֛י וְעַל־פֹּ֥עַל יָדַ֖י תְּצַוֻּֽנִי <tei:bibl>(ישעיה מה:יא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mah_zeh_ayachel_hapaytan/6"/>
        <tei:lg>
          <tei:l>נַפְשָׁם לְעִיר קׇדְשִׁי אַקְרִיב לְהוֹדוֹת לִי</tei:l>
          <tei:l>יוֹם הַנְּפָשׁוֹת יַעַמְדוּ לְשָׁרְתֵֽנִי׃</tei:l>
        </tei:lg>
      </tei:div>
