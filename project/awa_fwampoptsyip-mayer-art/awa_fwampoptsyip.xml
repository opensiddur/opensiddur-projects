  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:awa_fwampoptsyip">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:awa_fwampoptsyip/1"/>
        <tei:lg>
          <tei:l>‘Awa fwampoptsyìp, ‘awa fwampoptsyìp,</tei:l>
          <tei:l>a kolanom oeyä sempulìl metolaryoa;</tei:l>
          <tei:l>‘awa fwampoptsyìp, ‘awa fwampoptsyìp.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:awa_fwampoptsyip/2"/>
        <tei:lg>
          <tei:l>Tsakrr za’u riti</tei:l>
          <tei:l>ulte yom fwampoptsyìpit</tei:l>
          <tei:l>a kolanom oeyä sempulìl metolaryoa;</tei:l>
          <tei:l>‘awa fwampoptsyìp, ‘awa fwampoptsyìp.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:awa_fwampoptsyip/3"/>
        <tei:lg>
          <tei:l>Tsakrr za’u nantang</tei:l>
          <tei:l>ulte frìp ritit</tei:l>
          <tei:l>a yom fwampoptsyìpit</tei:l>
          <tei:l>a kolanom oeyä sempulìl metolaryoa;</tei:l>
          <tei:l>‘awa fwampoptsyìp, ‘awa fwampoptsyìp.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:awa_fwampoptsyip/4"/>
        <tei:lg>
          <tei:l>Tsakrr za’u vultsyìp</tei:l>
          <tei:l>ulte takuk nantangit</tei:l>
          <tei:l>a frìp ritit</tei:l>
          <tei:l>a yom fwampoptsyìpit</tei:l>
          <tei:l>a kolanom oeyä sempulìl metolaryoa;</tei:l>
          <tei:l>‘awa fwampoptsyìp, ‘awa fwampoptsyìp.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:awa_fwampoptsyip/5"/>
        <tei:lg>
          <tei:l>Tsakrr za’u txep</tei:l>
          <tei:l>ulte nekx vultsyìpit</tei:l>
          <tei:l>a takuk nantangit</tei:l>
          <tei:l>a frìp ritit</tei:l>
          <tei:l>a yom fwampoptsyìpit</tei:l>
          <tei:l>a kolanom oeyä sempulìl metolaryoa;</tei:l>
          <tei:l>‘awa fwampoptsyìp, ‘awa fwampoptsyìp.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:awa_fwampoptsyip/6"/>
        <tei:lg>
          <tei:l>Tsakrr za’u pay</tei:l>
          <tei:l>ulte tong txepit</tei:l>
          <tei:l>a nekx vultsyìpit</tei:l>
          <tei:l>a takuk nantangit</tei:l>
          <tei:l>a frìp ritit</tei:l>
          <tei:l>a yom fwampoptsyìpit</tei:l>
          <tei:l>a kolanom oeyä sempulìl metolaryoa;</tei:l>
          <tei:l>‘awa fwampoptsyìp, ‘awa fwampoptsyìp.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:awa_fwampoptsyip/7"/>
        <tei:lg>
          <tei:l>Tsakrr za’u talioang</tei:l>
          <tei:l>ulte näk payit</tei:l>
          <tei:l>a tong txepit</tei:l>
          <tei:l>a nekx vultsyìpit</tei:l>
          <tei:l>a takuk nantangit</tei:l>
          <tei:l>a frìp ritit</tei:l>
          <tei:l>a yom fwampoptsyìpit</tei:l>
          <tei:l>a kolanom oeyä sempulìl metolaryoa;</tei:l>
          <tei:l>‘awa fwampoptsyìp, ‘awa fwampoptsyìp.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:awa_fwampoptsyip/8"/>
        <tei:lg>
          <tei:l>Tsakrr za’u taronyu</tei:l>
          <tei:l>ulte tspang talioangit</tei:l>
          <tei:l>a näk payit</tei:l>
          <tei:l>a tong txepit</tei:l>
          <tei:l>a nekx vultsyìpit</tei:l>
          <tei:l>a takuk nantangit</tei:l>
          <tei:l>a frìp ritit</tei:l>
          <tei:l>a yom fwampoptsyìpit</tei:l>
          <tei:l>a kolanom oeyä sempulìl metolaryoa;</tei:l>
          <tei:l>‘awa fwampoptsyìp, ‘awa fwampoptsyìp.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:awa_fwampoptsyip/9"/>
        <tei:lg>
          <tei:l>Tsakrr za’u tirea tìterkupä</tei:l>
          <tei:l>ulte tspang taronyut</tei:l>
          <tei:l>a tspang talioangit</tei:l>
          <tei:l>a näk payit</tei:l>
          <tei:l>a tong txepit</tei:l>
          <tei:l>a nekx vultsyìpit</tei:l>
          <tei:l>a takuk nantangit</tei:l>
          <tei:l>a frìp ritit</tei:l>
          <tei:l>a yom fwampoptsyìpit</tei:l>
          <tei:l>a kolanom oeyä sempulìl metolaryoa;</tei:l>
          <tei:l>‘awa fwampoptsyìp, ‘awa fwampoptsyìp.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:awa_fwampoptsyip/10"/>
        <tei:lg>
          <tei:l>Tsakrr za’u Nawma Sa’nok</tei:l>
          <tei:l>ulte tspang tireat tìterkupä</tei:l>
          <tei:l>a tspang taronyut</tei:l>
          <tei:l>a tspang talioangit</tei:l>
          <tei:l>a näk payit</tei:l>
          <tei:l>a tong txepit</tei:l>
          <tei:l>a nekx vultsyìpit</tei:l>
          <tei:l>a takuk nantangit</tei:l>
          <tei:l>a frìp ritit</tei:l>
          <tei:l>a yom fwampoptsyìpit</tei:l>
          <tei:l>a kolanom oeyä sempulìl metolaryoa;</tei:l>
          <tei:l>‘awa fwampoptsyìp, ‘awa fwampoptsyìp.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
