    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:the_prayer_for_the_safety_of_kings_menasseh/1">
        <tei:head>הַנּוֹתֵן תְּשׁוּעָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_prayer_for_the_safety_of_kings_menasseh/1/2"/>
        <tei:lg>
          <tei:l>הַנּוֹתֵן תְּשׁוּעָה לַמְּלָכִים</tei:l>
          <tei:l>וּמֶמְשָּׁלָה לַנְּסִיכִים</tei:l>
          <tei:l>הַפּוֹצֶה אֶת דָּוִד עַבְדּוֹ</tei:l>
          <tei:l>מֵחֶרֶב רָעָה</tei:l>
          <tei:l>הַנּוֹתֵן בַּיַם דֶרֶךְ</tei:l>
          <tei:l>וּבְמַיִם עַזִּים נְתִיבָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_prayer_for_the_safety_of_kings_menasseh/1/3"/>
        <tei:lg>
          <tei:l>הוּא יְבָרֵךְ וְיִשְׁמוֹר</tei:l>
          <tei:l>וְיִנְצוֹר וְיַעֲזוֹר</tei:l>
          <tei:l>וִירוֹמֵם וִיגַדֵּל</tei:l>
          <tei:l>וִינַשֵּׂא לְמַֽעְלָה לְמַֽעְלָה לַאֲדוֹנֵנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_prayer_for_the_safety_of_kings_menasseh/1/4"/>
        <tei:lg>
          <tei:l>הַמֶּלֶךְ מַלְכֵי הַמְלָכִים בְּרַחֲמָיו יִשְׁמְרֶהוּ</tei:l>
          <tei:l>וִיחַיֵיהוּ</tei:l>
          <tei:l>וּמִכָּל צָרָה וָנֶזֶק יַצִילֵהוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_prayer_for_the_safety_of_kings_menasseh/1/5"/>
        <tei:lg>
          <tei:l>מֶֽלֶךְ מַלְכֵי הַמְלָכִים בְּרַחֲמָיו</tei:l>
          <tei:l>יָרִוּם וְיַגְבִּיהַ כּוֹכַב מַעֲרַכְתָּוֹ</tei:l>
          <tei:l>וְיַאֲרִיךְ יָמִים עַל מַמְלָכְתּוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_prayer_for_the_safety_of_kings_menasseh/1/6"/>
        <tei:lg>
          <tei:l>מֶלֶךְ מַלְכֵי הַמְלָכִים בְּרַחֲמָיו</tei:l>
          <tei:l>יִתֵּן בְּלבּוֹ</tei:l>
          <tei:l>וּבְּלֵב כָּל יוֹעֲצַיו וְשָׂרָיו</tei:l>
          <tei:l>רַחֲמָנוּת לַעֲשׂוֹת טוֹבָה עִמָּנוּ</tei:l>
          <tei:l>וְעִם כָּל יִשְּׂרָאֵל אַחֵינוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_prayer_for_the_safety_of_kings_menasseh/1/7"/>
        <tei:lg>
          <tei:l>בְּיָמָיו וּבְיָמֵינוּ</tei:l>
          <tei:l>תִּוָּשַּׁע יְהוּדָה</tei:l>
          <tei:l>וְיִשְׂרָאֵל יִשְׁכּוֹן לָבֶטַח.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_prayer_for_the_safety_of_kings_menasseh/1/8"/>
        <tei:lg>
          <tei:l>וּבָא לְצִיּוֹן גּוֹאֵל</tei:l>
          <tei:l>וְכֵן יְהִי רָצוֹן</tei:l>
          <tei:l>וָנֺאמַר אָמֵן:</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
