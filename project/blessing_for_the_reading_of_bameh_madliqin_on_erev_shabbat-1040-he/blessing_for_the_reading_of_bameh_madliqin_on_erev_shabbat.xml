  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:blessing_for_the_reading_of_bameh_madliqin_on_erev_shabbat">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_for_the_reading_of_bameh_madliqin_on_erev_shabbat/1"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְהֹוָה אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>אֲשֶׁר בָּחַר בַּחֲכָמִים וְתַלְמִידֵיהֶם</tei:l>
          <tei:l>וְנָתַן לָהֶם תּוֹרָה מֵהַר סִינַי</tei:l>
          <tei:l>עַל יְדֵי מֹשֶׁה רַבֵּֽנוּ</tei:l>
          <tei:l>וְצִוָּה אֹתָם לִקְרֹא בַּתּוֹרָה</tei:l>
          <tei:l>בַּמִּשְׁנָה בַּתַּלְמוּד בַּהֲלָכָה</tei:l>
          <tei:l>לִקְנוֹת חַיֵּי שְׁנֵי הָעוֹלָמִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_for_the_reading_of_bameh_madliqin_on_erev_shabbat/2"/>
        <tei:lg>
          <tei:l>וּבָחַר בְּמֹשֶׁה רַבֵּֽנוּ מִכׇּל־הַנְּבִיאִים</tei:l>
          <tei:l>וְדִבֵּר עִמּוֹ פָּנִים בְּפָנִים</tei:l>
          <tei:l>שֶׁנֶּאֱמַר פֶּ֣ה אֶל־פֶּ֞ה אֲדַבֶּר־בּ֗וֹ</tei:l>
          <tei:l>וּמַרְאֶה֙ וְלֹ֣א בְחִידֹ֔ת</tei:l>
          <tei:l>וּתְמֻנַ֥ת יְהֹוָ֖ה יַבִּ֑יט <tei:bibl>(במדבר יב:ח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_for_the_reading_of_bameh_madliqin_on_erev_shabbat/3"/>
        <tei:lg>
          <tei:l>וְאַחֲרָיו בָּחַר בִּיהוֹשֻֽׁעַ תַּלְמִידוֹ</tei:l>
          <tei:l>וְשִׁבְעִים זְקֵנִים וַחֲכָמִים וְתַלְמִידֵיהֶם</tei:l>
          <tei:l>וְצִוָּה אוֹתָם בִּשְׁמִירוֹת שַׁבָּת</tei:l>
          <tei:l>וּבְהַדְלָקַת הַנֵּר שֶׁלְּשַׁבָּת׃</tei:l>
        </tei:lg>
      </tei:div>
