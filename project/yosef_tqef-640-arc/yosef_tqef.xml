  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yosef_tqef">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yosef_tqef/1"/>
        <tei:lg xml:lang="he">
          <tei:l>יוֹסֵף תְּקֵיף יִצְרֵיהּ כַּד תְּבַעְתֵּיהּ מָרְתֵּיהּ</tei:l>
          <tei:l>וְסָרַב לְמִישְׁכַּב לְוָתַהּ לְמֶהֱוֵי עִמַּהּ לְעַלְמָא דְּאָתֵי</tei:l>
          <tei:l>אַכְנֵישַׁת כׇּל־שֵׁבַבְתָּהַא</tei:l>
          <tei:l>וְהַכְּדֵין אֲמַרַת לְהוֹן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yosef_tqef/2"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">אִ</tei:seg>ית לִי חַד טַלְיָא זְעֵיר וּמְיַנּוֹק הוּא</tei:l>
          <tei:l>זִיוֵיהּ דְּעִבְרָאֵי וּזְבַנְתֵּיהּ מִן־עֲרָבָאֵי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yosef_tqef/3"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">בָּ</tei:seg>עְיָא אֲנָא לְמִידְרֵיהּ בְּגִינְּתִי וְהוּא לָא צָבֵי</tei:l>
          <tei:l>וַאֲמַר לֵית אֲנָא רָדֵי בְּתוֹרְתָא וְאָתוּנָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yosef_tqef/4"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">גֶּ</tei:seg>נֵימוֹס דִּידֵיהּ כְּסָב בַּר שִׁבְעִין שְׁנִין</tei:l>
          <tei:l>וּמִן־שַׁבְסַר שְׁנִין כַּד זְבַנְתֵּיהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yosef_tqef/5"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">דְּ</tei:seg>מוּתֵיהּ דְּמַלְכָּא וּמְמַלְּלוּתֵיהּ דְּחַכִּים</tei:l>
          <tei:l>דֶּלִיס לֵית בֵּיהּ אֱלָּא כְּבַר מַלְכִּין הוּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yosef_tqef/6"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">הָ</tei:seg>א כְמָה זִימְנִין דִּצְחִית לְמִשְׁתֵּי</tei:l>
          <tei:l>וְהוּא לָא בָּעֵי לְאַשְׁקוֹיֵי יָתִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yosef_tqef/7"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">וַ</tei:seg>אֲמַר לְגַרְמֵיהּ גַּנָּבָא</tei:l>
          <tei:l>לְמָה אַתְּ בָּעֵי לְמִישְׁתֵּי מַיָּא גְנוּבַיָּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yosef_tqef/8"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">זְ</tei:seg>עֵיר וּמִינּוֹק הוּא יוֹסֵף דְּנָסֵיב הוֹנִי בִּגְלַל שׁוּפְרֵיהּ</tei:l>
          <tei:l>וְהוּא עֲתִיד דִּמְשַׁבַּח לְעַתִּיק יוֹמִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yosef_tqef/9"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">חִ</tei:seg>ינָּא וְחִסְדָּא מְלַוִּין יָתֵיהּ</tei:l>
          <tei:l>חַד מִיַּמִּינֵיהּ וְחַד מִשְּׂמָאלֵיהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yosef_tqef/10"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">טָ</tei:seg>רְדָא אֲנָא לָךְ מִגּוֹ פַּלָּטִין דִּידִי</tei:l>
          <tei:l>דְּאַתְּ מַנִּית יָתִי הֵיךְ זַנְיְתָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yosef_tqef/11"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">י</tei:seg>וֹמָם וְלֵילֵי נוּרָא בְּלִבִּי יָקְדָא</tei:l>
          <tei:l>הֵיךְ דִּיקּוּד שַׁלְהוֹבִית נוּרָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yosef_tqef/12"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">כּ</tei:seg>וּלֵיהּ עַרְסִין דְּרִיבּוֹנָךְ פְּרִיסִין</tei:l>
          <tei:l>וּלְמַאן דְּאַהֲנֵי לָךְ קוּם דְּמוֹךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yosef_tqef/13"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">לָ</tei:seg>א בְּגִין חַד לֵילְיָא דְּאִידְמוֹךְ יָאוּת</tei:l>
          <tei:l>אֲנָא מְטַלְטֵל פְּרִיסִין מִגִּינְּתָא דְּעֵדֶן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yosef_tqef/14"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">מְ</tei:seg>פַיְּיסָא אֲנָא לְכוֹן כׇּל־חֲבֵרוֹתַיי</tei:l>
          <tei:l>דְּתִסְּקוּן עִמִּי בְּגוֹ פַּלָּטִין דִּידִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yosef_tqef/15"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">נֵ</tei:seg>יכוֹל כַּחֲדָא וְנִישְׁתֵּי כַּחֲדָא</tei:l>
          <tei:l>וְנֵימַר מִילּוֹי וְתֵימְרוּן קוּשְׁטָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yosef_tqef/16"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">סְ</tei:seg>לַקַת הִיא קַמַּיְיתָּא וְאַסֵּיקַת יַתְהוֹן</tei:l>
          <tei:l>וְאוֹתֵיבַת יַתְהוֹן עַל־סַגְמוֹטִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yosef_tqef/17"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">עַ</tei:seg>בְדָּא קְרַת יָתֵיהּ גְּבִירְתֵּיהּ דְּיוֹסֵף</tei:l>
          <tei:l>קוּם קְטוֹר חַרְצָךְ וְשַׁמֵּשׁ כְּעַבְדָּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yosef_tqef/18"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>יוֹלִין סַב בִּידֵיהּ וְקָם וּמְזַג לְהוֹן</tei:l>
          <tei:l>הֲווּ טָעֲנָן כָּסָא וְלָא טָעֲמָן לֵיהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yosef_tqef/19"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">צָ</tei:seg>פְיָין הֲוַיִּין לֵיהּ וְאַפֵּיהוֹן מְכַרְכְּמִין</tei:l>
          <tei:l>אַפֵּיהּ לְמָרָתֵיהּ וְלִיבֵּיהּ לְאֲבוּהִי דְּבִשְׁמַיָּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yosef_tqef/20"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>מוּ כוּלְּהוֹן וּנְשַׁקוּ יָתֵיהּ עַל־רֵישֵׁיהּ</tei:l>
          <tei:l>וְאָמְרִין לֵיהּ יָאֵי לָךְ יָנוּק מַלְכוּתָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yosef_tqef/21"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">רַ</tei:seg>חֲמִין וְחִינָּא וְחִיסְדָּא</tei:l>
          <tei:l>אִתְנְגִיד לֵיהּ מִן־שְׁמַיָּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yosef_tqef/22"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">שַׁ</tei:seg>דַּי יַהְבֵיהּ לִיקָר וְלִרְבוּ</tei:l>
          <tei:l>בְּדִיל יִצְרֵיהּ דִּיכְבַשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yosef_tqef/23"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">תְּ</tei:seg>הָכוּן בְּאׇרְחָתֵיהּ כׇּל־יִשְׂרָאֵל</tei:l>
          <tei:l>וְלָא־תִּרְדְּפוּן בָּתַר גַּיּוֹפַיָּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yosef_tqef/24"/>
        <tei:lg xml:lang="he">
          <tei:l>אֲרֵי אֲנָא סָהֵיד</tei:l>
          <tei:l>בַּחֲרָשַׁיָּא וּבְגַיּוֹפַיָּא׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
