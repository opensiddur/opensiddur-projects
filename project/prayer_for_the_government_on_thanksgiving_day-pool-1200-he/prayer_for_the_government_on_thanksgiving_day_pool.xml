  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_the_government_on_thanksgiving_day_pool">
        <tei:head>הַנּוֹתֵן תְּשׁוּעָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_government_on_thanksgiving_day_pool/1"/>
        <tei:lg>
          <tei:l>הַנּוֹתֵן תְּשׁוּעָה לַמְּלָכִים.</tei:l>
          <tei:l>וּמֶמְשָׁלָה לַנְּסִיכִים.</tei:l>
          <tei:l>וּמַלְכוּתוֹ מַלְכוּת כׇּל־עֽוֹלָמִים.</tei:l>
          <tei:l>הַפּוֹצֶה אֶת־דָּוִד עַדְדּוֹ מֵחֶֽרֶב רָעָה.</tei:l>
          <tei:l>הַנּוֹתֵן בַּיָּם דָּרֶךְ.</tei:l>
          <tei:l>וּבְמַֽיִם עַזִּים נְתִיבָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_government_on_thanksgiving_day_pool/2"/>
        <tei:lg>
          <tei:l>הוּא יְבָרֵךְ. וְיִשְׁמֹר. וְיִנְצֹר. וְיַֽעֲזֹר.</tei:l>
          <tei:l>אֶת־כׇּל־שָׂרֵי הַמְּדִינוֹת הָאֵלּוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_government_on_thanksgiving_day_pool/3"/>
        <tei:lg>
          <tei:l>מֶֽלֶךְ מַלְכֵי הַמְּלָכִים.</tei:l>
          <tei:l>בְּרַֽחֲמָיו יִשְׁמְרֵם וִֽיחַיֵּים.</tei:l>
          <tei:l>וּמִכׇּל־צָרָה וָנֶֽזֶק יַצִּילֵם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_government_on_thanksgiving_day_pool/4"/>
        <tei:lg>
          <tei:l>מֶֽלֶךְ מַלְכֵי הַמְּלָכִים.</tei:l>
          <tei:l>בְּרַֽחֲמָיו יִתֵּן בְּלִבָּם</tei:l>
          <tei:l>וּבְלֵב כׇּל־יֽוֹעֲצֵיהֶם רַֽחֲמָנוּת.</tei:l>
          <tei:l>לַֽעֲשׂוֹת טוֹבָה עִמָּֽנוּ.</tei:l>
          <tei:l>וְעִם־כׇּל־יִשְׂרָאֵל אַחֵֽינוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_government_on_thanksgiving_day_pool/5"/>
        <tei:lg>
          <tei:l>בִּֽימֵיהֶם וּבְיָמֵֽינוּ</tei:l>
          <tei:l>תִּוָּשַׁע יְהוּדָה.</tei:l>
          <tei:l>וְיִשְׂרָאֵל יִשְׁכֹּן לָבֶֽטַח.</tei:l>
          <tei:l>וּבָא לְצִיּוֹן גוֹאֵל.</tei:l>
          <tei:l>וְכֵן יְהִי רָצוֹן</tei:l>
          <tei:l>וְנֹאמַר אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
