  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:baugesang_an_alphabetical_yiddish_adaptation_of_the_piyyut">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_an_alphabetical_yiddish_adaptation_of_the_piyyut/1"/>
        <tei:lg xml:lang="de">
          <tei:l>Allmächtiger Gott,</tei:l>
          <tei:l>Nun bau dein’ Tempel schiere,</tei:l>
          <tei:l>Also schier und also bald,</tei:l>
          <tei:l>In unseren Tagen schiere,</tei:l>
          <tei:l>Ja schiere;</tei:l>
          <tei:l>Nun bau, nun bau,</tei:l>
          <tei:l>Nun bau dein’ Tempel schiere.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_an_alphabetical_yiddish_adaptation_of_the_piyyut/2"/>
        <tei:lg xml:lang="de">
          <tei:l>Barmherziger Gott,</tei:l>
          <tei:l>Nun bau...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_an_alphabetical_yiddish_adaptation_of_the_piyyut/3"/>
        <tei:lg xml:lang="de">
          <tei:l>Großer Gott,</tei:l>
          <tei:l>Demütiger Gott,</tei:l>
          <tei:l>Nun bau...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_an_alphabetical_yiddish_adaptation_of_the_piyyut/4"/>
        <tei:lg xml:lang="de">
          <tei:l>Hoher Gott,</tei:l>
          <tei:l>Würdiger Gott,</tei:l>
          <tei:l>Süßer Gott,</tei:l>
          <tei:l>„Chen“-ter Gott,</tei:l>
          <tei:l>Nun bau...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_an_alphabetical_yiddish_adaptation_of_the_piyyut/5"/>
        <tei:lg xml:lang="de">
          <tei:l>Tugendlicher Gott,</tei:l>
          <tei:l>Jüdischer Gott,</tei:l>
          <tei:l>Nun bau...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_an_alphabetical_yiddish_adaptation_of_the_piyyut/6"/>
        <tei:lg xml:lang="de">
          <tei:l>Kräftiger Gott,</tei:l>
          <tei:l>Lebendiger Gott,</tei:l>
          <tei:l>Mächtiger Gott,</tei:l>
          <tei:l>Namhafter Gott,</tei:l>
          <tei:l>Sänftiger Gott,</tei:l>
          <tei:l>Ewiger Gott,</tei:l>
          <tei:l>Nun bau...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_an_alphabetical_yiddish_adaptation_of_the_piyyut/7"/>
        <tei:lg xml:lang="de">
          <tei:l>Furchtsamer Gott,</tei:l>
          <tei:l>Ziemlicher Gott,</tei:l>
          <tei:l>Königlicher Gott,</tei:l>
          <tei:l>Reicher Gott,</tei:l>
          <tei:l>Nun bau...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_an_alphabetical_yiddish_adaptation_of_the_piyyut/8"/>
        <tei:lg xml:lang="de">
          <tei:l>Schöner Gott,</tei:l>
          <tei:l>Trauter Gott,</tei:l>
          <tei:l>Nun bau...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_an_alphabetical_yiddish_adaptation_of_the_piyyut/9"/>
        <tei:lg xml:lang="de">
          <tei:l>Du bist Gott</tei:l>
          <tei:l>und Keiner mehr,</tei:l>
          <tei:l>Nun bau...</tei:l>
        </tei:lg>
