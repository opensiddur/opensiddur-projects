    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:et_kos_yeshuot_qaraite">
        <tei:head>אֶת כּוֹס יְשׁוּעוֹת</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:et_kos_yeshuot_qaraite/1"/>
        <tei:lg>
          <tei:l>אֶ֒ת כּוֹס יְשׁוּעוֹת: אֶשָּׂא בְּזִמְרָה:</tei:l>
          <tei:l>וּבְשֵׁם יְהֹוָה: אוֹדֶה וְאֶקְרָא:</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>*את כוס ישועות...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:et_kos_yeshuot_qaraite/2"/>
        <tei:lg>
          <tei:l>לַ֒יְלָה וְיוֹמָם: עֻזּוֹ אֲמַלֵּל:</tei:l>
          <tei:l>וּלְשֵׁם כְּבוֹדוֹ: תָּמִיד אֲהַלֵּל:</tei:l>
          <tei:l>כִּי הוּא לְבַדּוֹ: יוֹצֵר מְחוֹלֵל:</tei:l>
          <tei:l>מַעְלָה וּמַטָּה: יָצַר וּבָרָא:</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>*את כוס ישועות...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:et_kos_yeshuot_qaraite/3"/>
        <tei:lg>
          <tei:l>יָ֒רוּם וְיִגְדַּל: עַל כָּל יְצוּרִים:</tei:l>
          <tei:l>זִכְרוֹ מְבוֹרָךְ: נֶצַח לְדוֹרִים:</tei:l>
          <tei:l>מוֹרִישׁ וּמַעְשִׁיר: מַשְׁפִּיל וּמֵרִים:</tei:l>
          <tei:l>לוֹ הַגְּדֻלָּה: לוֹ הַגְּבוּרָה:</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>*את כוס ישועות...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:et_kos_yeshuot_qaraite/4"/>
        <tei:lg>
          <tei:l>קָ֒רוֹב יְהֹוָה: תָּמִיד לְקוֹרְאָיו:</tei:l>
          <tei:l>רַבּוּ וְעָצְמוּ: נִסֵּי פְלָאָיו:</tei:l>
          <tei:l>טוּבוֹ וְרַחֲמָיו: עַל כָּל בְּרוּאָיו:</tei:l>
          <tei:l>לָכֵן בְּצָרוֹת: נִמְצָא לְעֶזְרָה:</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>*את כוס ישועות...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:et_kos_yeshuot_qaraite/5"/>
        <tei:lg>
          <tei:l>יָֽ֒קְרוּ דְרָכָיו: עַל כָּל דְרָכִים:</tei:l>
          <tei:l>מַנְהִיג וּמוֹשֵׁל: עַל כָּל פְּלָכִים:</tei:l>
          <tei:l>נוֹרָא וְעֶלְיוֹן: מֶלֶךְ מְלָכִים:</tei:l>
          <tei:l>אַדִּיר וְגָדוֹל: גִּבּוֹר וְנוֹרָא:</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>*את כוס ישועות...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:et_kos_yeshuot_qaraite/6"/>
        <tei:lg>
          <tei:l>מָ֒עוֹז וּמַחְסֶה: אֶל דַּל וְאֶבְיוֹן:</tei:l>
          <tei:l>יִשְׁלַח לְעַמּוֹ: יֶשַׁע וּפִדְיוֹן:</tei:l>
          <tei:l>מֶלֶךְ וְכֹהֵן: יָבִיא לְצִיּוֹן:</tei:l>
          <tei:l>יִבְנֶה מְהֵרָה: בֵּית הַבְּחִירָה:</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>*את כוס ישועות...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
