  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:havdalah_sampter">
        <tei:head>Haḇdalah, a paraliturgical prayer by Jessie Ethel Sampter (1919)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:havdalah_sampter/1"/>
        <tei:lg>
          <tei:l>Blessed be <j:divineName>He</j:divineName> that gave us days</tei:l>
          <tei:l>For work and rest, to serve and praise</tei:l>
          <tei:l>In orderly and seemly ways.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:havdalah_sampter/2"/>
        <tei:lg>
          <tei:l>That set the bounds of day and night</tei:l>
          <tei:l>With fine distinctions in <j:divineName>His</j:divineName> sight.</tei:l>
          <tei:l>And bade us honor them with light</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:havdalah_sampter/3"/>
        <tei:lg>
          <tei:l>Blessed be <j:divineName>He</j:divineName> whose Sabbath rest</tei:l>
          <tei:l>With song and wine and light expressed.</tei:l>
          <tei:l>Shall make the days of labor blest.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
