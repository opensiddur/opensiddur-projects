  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:min_yacince_a_judeo_quenya_translation_of_had_gadya">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:min_yacince_a_judeo_quenya_translation_of_had_gadya/1"/>
        <tei:lg>
          <tei:l>מִן יַקִנְקֶי, מִן יַקִנְקֶי,</tei:l>
          <tei:l>אִי־אַטְיַה הוֹמַנְקַנֶי קַסְטַנְטֶן,</tei:l>
          <tei:l>מִן יַקִנְקֶי, מִן יַקִנְקֶי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:min_yacince_a_judeo_quenya_translation_of_had_gadya/2"/>
        <tei:lg>
          <tei:l>סַן טוּלֶי אִימִיֻאֶי</tei:l>
          <tei:l>אַרְמַנְטֶס אִייַקִנְקֶי</tei:l>
          <tei:l>אִי־אַטְיַה הוֹמַנְקַנֶי קַסְטַנְטֶן,</tei:l>
          <tei:l>מִן יַקִנְקֶי, מִן יַקִנְקֶי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:min_yacince_a_judeo_quenya_translation_of_had_gadya/3"/>
        <tei:lg>
          <tei:l>סַן טוּלֶי אִירוֹאַה</tei:l>
          <tei:l>אַרְנַנְקֶס אִימִיֻאֶי,</tei:l>
          <tei:l>אִי־מַנְטֶי יַקִנְקֶי,</tei:l>
          <tei:l>אִי־אַטְיַה הוֹמַנְקַנֶי קַסְטַנְטֶן,</tei:l>
          <tei:l>מִן יַקִנְקֶי, מִן יַקִנְקֶי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:min_yacince_a_judeo_quenya_translation_of_had_gadya/4"/>
        <tei:lg>
          <tei:l>סַן טוּלֶי אִיאוֹלְבַּה</tei:l>
          <tei:l>אַרְפַּלַמְפֶּס אִירוֹאַה</tei:l>
          <tei:l>אִי־נַנְקֶי מִיֻאֶי,</tei:l>
          <tei:l>אִי־מַנְטֶי יַקִנְקֶי,</tei:l>
          <tei:l>אִי־אַטְיַה הוֹמַנְקַנֶי קַסְטַנְטֶן,</tei:l>
          <tei:l>מִן יַקִנְקֶי, מִן יַקִנְקֶי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:min_yacince_a_judeo_quenya_translation_of_had_gadya/5"/>
        <tei:lg>
          <tei:l>סַן טוּלֶי אִירֻאִנֶי</tei:l>
          <tei:l>אַרְאֻרְטַנֶס אִיאוֹלְבַּה</tei:l>
          <tei:l>אִי־פַּלַמְפֶּי רוֹאַה,</tei:l>
          <tei:l>אִי־נַנְקֶי מִיֻאֶי,</tei:l>
          <tei:l>אִי־מַנְטֶי יַקִנְקֶי,</tei:l>
          <tei:l>אִי־אַטְיַה הוֹמַנְקַנֶי קַסְטַנְטֶן,</tei:l>
          <tei:l>מִן יַקִנְקֶי, מִן יַקִנְקֶי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:min_yacince_a_judeo_quenya_translation_of_had_gadya/6"/>
        <tei:lg>
          <tei:l>סַן טוּלֶי אִינֵין</tei:l>
          <tei:l>אַרְלֻיֻנְטֶס אִירֻאִנֶי,</tei:l>
          <tei:l>אִי־אֻרְטַנֶי אוֹלְבַּה,</tei:l>
          <tei:l>אִי־פַּלַמְפֶּי רוֹאַה,</tei:l>
          <tei:l>אִי־נַנְקֶי מִיֻאֶי,</tei:l>
          <tei:l>אִי־מַנְטֶי יַקִנְקֶי,</tei:l>
          <tei:l>אִי־אַטְיַה הוֹמַנְקַנֶי קַסְטַנְטֶן,</tei:l>
          <tei:l>מִן יַקִנְקֶי, מִן יַקִנְקֶי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:min_yacince_a_judeo_quenya_translation_of_had_gadya/7"/>
        <tei:lg>
          <tei:l>סַן טוּלֶי אִימֻנְדוֹ,</tei:l>
          <tei:l>אַרְיוּלֶס אִינֵין,</tei:l>
          <tei:l>אִי־לֻיֻנְטֶי רֻאִנֶי,</tei:l>
          <tei:l>אִי־אֻרְטַנֶי אוֹלְבַּה,</tei:l>
          <tei:l>אִי־פַּלַמְפֶּי רוֹאַה,</tei:l>
          <tei:l>אִי־נַנְקֶי מִיֻאֶי,</tei:l>
          <tei:l>אִי־מַנְטֶי יַקִנְקֶי,</tei:l>
          <tei:l>אִי־אַטְיַה הוֹמַנְקַנֶי קַסְטַנְטֶן,</tei:l>
          <tei:l>מִן יַקִנְקֶי, מִן יַקִנְקֶי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:min_yacince_a_judeo_quenya_translation_of_had_gadya/8"/>
        <tei:lg>
          <tei:l>סַן טוּלֶי אִיקֻאִמַקִר,</tei:l>
          <tei:l>אַרְנַקַנְטֶס אִימֻנְדוֹ,</tei:l>
          <tei:l>אִי־יוּלֶי נֵין,</tei:l>
          <tei:l>אִי־לֻיֻנְטֶי רֻאִנֶי,</tei:l>
          <tei:l>אִי־אֻרְטַנֶי אוֹלְבַּה,</tei:l>
          <tei:l>אִי־פַּלַמְפֶּי רוֹאַה,</tei:l>
          <tei:l>אִי־נַנְקֶי מִיֻאֶי,</tei:l>
          <tei:l>אִי־מַנְטֶי יַקִנְקֶי,</tei:l>
          <tei:l>אִי־אַטְיַה הוֹמַנְקַנֶי קַסְטַנְטֶן,</tei:l>
          <tei:l>מִן יַקִנְקֶי, מִן יַקִנְקֶי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:min_yacince_a_judeo_quenya_translation_of_had_gadya/9"/>
        <tei:lg>
          <tei:l>סַן טוּלֶי אִי מַיַה פִֿרְיֵינוּ</tei:l>
          <tei:l>אַרְנַקַנְטֶס אִיקֻאִמַקִר,</tei:l>
          <tei:l>אִי־נַקַנְטֶי מֻנְדוֹ,</tei:l>
          <tei:l>אִי־יוּלֶי נֵין,</tei:l>
          <tei:l>אִי־לֻיֻנְטֶי רֻאִנֶי,</tei:l>
          <tei:l>אִי־אֻרְטַנֶי אוֹלְבַּה,</tei:l>
          <tei:l>אִי־פַּלַמְפֶּי רוֹאַה,</tei:l>
          <tei:l>אִי־נַנְקֶי מִיֻאֶי,</tei:l>
          <tei:l>אִי־מַנְטֶי יַקִנְקֶי,</tei:l>
          <tei:l>אִי־אַטְיַה הוֹמַנְקַנֶי קַסְטַנְטֶן,</tei:l>
          <tei:l>מִן יַקִנְקֶי, מִן יַקִנְקֶי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:min_yacince_a_judeo_quenya_translation_of_had_gadya/10"/>
        <tei:lg>
          <tei:l>סַן טוּלֶי אֶרֻא אִלוּבַֿטַר,</tei:l>
          <tei:l>אַרְנַקַנְטֶס אִימַייַה פִֿרְיֵינוּ</tei:l>
          <tei:l>אִי־נַקַנְטֶי קֻאִמַקִר,</tei:l>
          <tei:l>אִי־נַקַנְטֶי מֻנְדוֹ,</tei:l>
          <tei:l>אִי־יוּלֶי נֵין,</tei:l>
          <tei:l>אִי־לֻיֻנְטֶי רֻאִנֶי,</tei:l>
          <tei:l>אִי־אֻרְטַנֶי אוֹלְבַּה,</tei:l>
          <tei:l>אִי־פַּלַמְפֶּי רוֹאַה,</tei:l>
          <tei:l>אִי־נַנְקֶי מִיֻאֶי,</tei:l>
          <tei:l>אִי־מַנְטֶי יַקִנְקֶי,</tei:l>
          <tei:l>אִי־אַטְיַה הוֹמַנְקַנֶי קַסְטַנְטֶן,</tei:l>
          <tei:l>מִן יַקִנְקֶי, מִן יַקִנְקֶי׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
