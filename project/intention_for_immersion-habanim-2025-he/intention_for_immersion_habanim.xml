  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:intention_for_immersion_habanim">
        <tei:head>כוונה לפני הטבילה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:intention_for_immersion_habanim/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">לפני ערב הניתוח יש לטבול במקוה של מיים חיים בלי ברכה.</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:intention_for_immersion_habanim/2"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כיוונה האם הבנים בכוונה זו בעת טבילתה.</tei:note>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>תְּהוֹם־אֶל־תְּהוֹם קוֹרֵא לְקוֹל צִנּוֹרֶיךָ</tei:l>
          <tei:l>כָּל־מִשְׁבָּרֶיךָ וְגַלֶּיךָ עָלַי עָבָרוּ: <tei:bibl>(תהלים מב:ח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:intention_for_immersion_habanim/3"/>
        <tei:lg>
          <tei:l>שאאמין שא-ה-י-ה אשר א-ה-י-ה.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
