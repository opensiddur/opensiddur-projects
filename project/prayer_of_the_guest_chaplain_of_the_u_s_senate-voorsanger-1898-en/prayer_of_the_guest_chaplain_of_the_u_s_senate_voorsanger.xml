      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_of_the_guest_chaplain_of_the_u_s_senate_voorsanger">
        <tei:head>Prayer of the Guest Chaplain of the U.S. Senate: Rabbi Jacob Voorsanger on 30 June 1898 (fragment)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_of_the_guest_chaplain_of_the_u_s_senate_voorsanger/1"/>
        <tei:lg>
          <tei:l>[...]</tei:l>
          <tei:l>all elements which may come</tei:l>
          <tei:l>from these sacred walls</tei:l>
          <tei:l>be extended</tei:l>
          <tei:l>in the form of <j:divineName>God</j:divineName>’s blessing</tei:l>
          <tei:l>to all humanity,</tei:l>
          <tei:l>and that the flag under which we live,</tei:l>
          <tei:l>that for which our fathers fought,</tei:l>
          <tei:l>be forever the sacred emblem of liberty</tei:l>
          <tei:l>until time shall be no more.</tei:l>
          <tei:l>[...]</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
