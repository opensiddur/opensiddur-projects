  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:eikh_eshal_seidenberg">
        <tei:head>אֵיךְ אֶשְׁאָל</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eikh_eshal_seidenberg/1"/>
        <tei:lg>
          <tei:l>אֵיךְ אֶשְׁאָל לְגַלֵּל הָחֶרְפָּה מֵעָלַי</tei:l>
          <tei:l>וְעֵדוּתֶיךָ לֹא נָצָרְתִי</tei:l>
          <tei:l>הֲסַּכִּין בְּיָדִי בְּעַדִי עֲדַיִין</tei:l>
          <tei:l>וְאֶדְרֹשׁ מְחִילָה מֵאֵת פִּיךָ לִי</tei:l>
          <tei:l>לְהַכּוֹת אֶגְרוֹף הַמְחָאָה בַּחֲזֶה,</tei:l>
          <tei:l>לְבַקֵּשׁ מֵעֵדִי בּוּז תָּסִיר מֵעָלַי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eikh_eshal_seidenberg/2"/>
        <tei:lg>
          <tei:l>עַמְּךָ לְאַכְזָר כַּיְעֵנִים בַּמִּדְבָּר,</tei:l>
          <tei:l>מִגּוֹדֶל נֶזֶק הַמְּחָבְּלִים עָלַי</tei:l>
          <tei:l>כְּפוּל כְּפָלִים נָמְטִיר עֲלֵיהֶם</tei:l>
          <tei:l>כִּי קָטְלוּ הָאֵם שַׁד בְּפִי יְּנִיקָה</tei:l>
          <tei:l>אָז אָמַרְנוּ כְּמוֹ שֶׁעָשׂוּ לִי אָסוֹן,</tei:l>
          <tei:l>אֶעֱשֶׂה כֵּן גַּם אֲנֹכִי לָהֶם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eikh_eshal_seidenberg/3"/>
        <tei:lg>
          <tei:l>וְהֶרֶס הֵהָרֵס בֵּית וּבִנְיָן לְאָבָק,</tei:l>
          <tei:l>מַחְלָקָה וְרוֹפֵא, בְּאֹהָל פְּלִיטֵי פְּצָצָה</tei:l>
          <tei:l>כְּאִלוּ לִשְׁמֹעַ אוֹיְבַי כִּלָּם מִגְּרוֹנָם</tei:l>
          <tei:l>וְקוֹל צַעֲקָה שֶׁהֵרִים מִפִּיהֶם</tei:l>
          <tei:l>קוֹלֵינוּ קוֹל עֵשָׂו נֶעֶשָׂה לֵאמֹר</tei:l>
          <tei:l>מֵחֶטְאָם הָאָשָׁם עֲלוֹת, הוּא לֹא לָנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eikh_eshal_seidenberg/4"/>
        <tei:lg>
          <tei:l>וְהֵיכִי לְשִׁמְךָ תֵּן כְּבוֹד חָסְדֶךָ</tei:l>
          <tei:l>וְכִי יְדֵי יַעֲקֹב חַרְבֵי בָּרְזֶל הֵעָשׂוּ</tei:l>
          <tei:l>הִגָלֶה וְרָפֵּא פְּצוּעֵי לִבָבֵנוּ</tei:l>
          <tei:l>שֶׁנְתָּקֵן עָמִים אֶת אָרְצָךְ עִם עוֹלְמֵנוּ</tei:l>
          <tei:l>אָז נִדְרֹש אֲסִירֶיהָ וּנְּבָקֵשׁ הַשָּׁלוֹם</tei:l>
          <tei:l>וְיַעֲלֶה בִּזְכוּת סְלִיחָתֵנוּ</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
