    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:eikhah_yashvah_badad_hirschfeld_skupinsky">
        <tei:head>אֵיכָה יָשְׁבָה בָּדָד</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eikhah_yashvah_badad_hirschfeld_skupinsky/1"/>
        <tei:lg>
          <tei:l>אֵיכָה יָשְׁבָה בָּדָד</tei:l>
          <tei:l>נִיר עֹז רַבָּתִי דָּם.</tei:l>
          <tei:l>שְׂדֵרוֹת הָיְתָה כְּאַלְמָנָה,</tei:l>
          <tei:l>קִרְיָה הֲלוּמָה, וּמִי נֶאֱמָנָהּ?</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eikhah_yashvah_badad_hirschfeld_skupinsky/2"/>
        <tei:lg>
          <tei:l>אֵיכָה יָשְׁבָה בָּדָד</tei:l>
          <tei:l>בַּמָּמָ”ד</tei:l>
          <tei:l>מִשְׁפָּחָה, וְעוֹד אַחַת,</tei:l>
          <tei:l>וְעוֹד, וְעוֹד אַחַת.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eikhah_yashvah_badad_hirschfeld_skupinsky/3"/>
        <tei:lg>
          <tei:l>אֵיכָה יָשְׁבוּ בָּדָד</tei:l>
          <tei:l>תַּצְפִּיתָנִיּוֹת רַבָּתִי עַיִן,</tei:l>
          <tei:l>וְלֹא הָיְתָה הַקְשָׁבָה,</tei:l>
          <tei:l>וִישׁוּעָה – אָיִן.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eikhah_yashvah_badad_hirschfeld_skupinsky/4"/>
        <tei:lg>
          <tei:l>אֵיכָה יָשְׁבוּ בָּדָד</tei:l>
          <tei:l>צְעִירוֹת וּצְעִירִים</tei:l>
          <tei:l>בְּמִסְתּוֹרֵי שׁוֹּחוֹת וְשִׂיחִים.</tei:l>
          <tei:l>פָּסְקוּ רִקּוּדֵיהֶם,</tei:l>
          <tei:l>וּמִי יְחַלְּצֵם?</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eikhah_yashvah_badad_hirschfeld_skupinsky/5"/>
        <tei:lg>
          <tei:l>אֵיכָה יָשְׁבוּ בָּדָד</tei:l>
          <tei:l>חֲטוּפוֹת וַחֲטוּפִים,</tei:l>
          <tei:l>וַעֲדַיִן יוֹשְׁבִים:</tei:l>
          <tei:l>120 גְּבָרִים, נָשִׁים, קְשִׁישִׁים וִילָדִים.</tei:l>
          <tei:l>בָּכוֹ בּוֹכִים בַּלַּיְלָה,</tei:l>
          <tei:l>דְּמָעוֹת עַל לְחָיֵיהֶם,</tei:l>
          <tei:l>וְאֵין מְנַחֵם.</tei:l>
        </tei:lg>
      </tei:div>
