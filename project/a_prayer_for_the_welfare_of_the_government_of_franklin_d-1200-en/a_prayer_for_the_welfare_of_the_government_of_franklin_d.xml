      <tei:div corresp="urn:x-opensiddur:text:prayer:a_prayer_for_the_welfare_of_the_government_of_franklin_d">
        <tei:head>A Prayer for the Welfare of the Government of Franklin D. Roosevelt during WWII (from A Naye Shas Tkhine Rav Pninim, ca. 1942)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_the_welfare_of_the_government_of_franklin_d/4"/>
        <tei:lg>
          <tei:l>May he bless, watch over, and help</tei:l>
          <tei:l>President Franklin Delano Roosevelt,</tei:l>
          <tei:l>and the Vice President, and their advisers.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_the_welfare_of_the_government_of_franklin_d/7"/>
        <tei:lg>
          <tei:l>These devastating wars should come to an end,</tei:l>
          <tei:l>Our children should return home healthy, with victory, in peace.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
