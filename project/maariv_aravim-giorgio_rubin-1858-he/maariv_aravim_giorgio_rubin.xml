  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:maariv_aravim_giorgio_rubin">
        <tei:head>מַעֲרִיב עֲרָבִים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:maariv_aravim_giorgio_rubin/1"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יהוה אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם,</tei:l>
          <tei:l>אֲשֶׁר בִּדְבָרוֹ מַעֲרִיב עֲרָבִים,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:maariv_aravim_giorgio_rubin/2"/>
        <tei:lg>
          <tei:l>בְּחָכְמָה פּוֹתֵחַ שְׁעָרִים,</tei:l>
          <tei:l>וּבִתְבוּנָה מְשַׁנֶּה עִתִּים</tei:l>
          <tei:l>וּמַחֲלִיף אֶת הַזְּמַנִּים,</tei:l>
          <tei:l>וּמְסַדֵּר אֶת הַכּוֹכָבִים</tei:l>
          <tei:l>בְּמִשְׁמְרוֹתֵיהֶם בָּרָקִיעַ כִּרְצוֹנוֹ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:maariv_aravim_giorgio_rubin/3"/>
        <tei:lg>
          <tei:l>בּוֹרֵא יוֹם וָלָיְלָה,</tei:l>
          <tei:l>גּוֹלֵל אוֹר מִפְּנֵי חֹשֶׁךְ</tei:l>
          <tei:l>וְחֹשֶׁךְ מִפְּנֵי אוֹר,</tei:l>
          <tei:l>וּמַעֲבִיר יוֹם וּמֵבִיא לָיְלָה, וּמַבְדִּיל בֵּין יוֹם וּבֵין לָיְלָה,</tei:l>
          <tei:l>יהוה צְבָאוֹת שְׁמוֹ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:maariv_aravim_giorgio_rubin/4"/>
        <tei:lg>
          <tei:l>אֵל חַי וְקַיָּם תָּמִיד</tei:l>
          <tei:l>יִמְלוֹךְ עָלֵינוּ</tei:l>
          <tei:l>לְעוֹלָם וָעֶד.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:maariv_aravim_giorgio_rubin/5"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יהוה,</tei:l>
          <tei:l>הַמַּעֲרִיב עֲרָבִים׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
