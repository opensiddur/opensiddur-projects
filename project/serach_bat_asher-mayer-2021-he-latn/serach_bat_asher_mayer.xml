  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:serach_bat_asher_mayer">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:serach_bat_asher_mayer/1"/>
        <tei:lg>
          <tei:l>Bat Asher hi, Séraḥ sh’m-ah</tei:l>
          <tei:l>Bat Asher she-ra’ata</tei:l>
          <tei:l>Bat Asher, ha-bat asher</tei:l>
          <tei:l>hitssila ȝir b-ḥokhmat-ah.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:serach_bat_asher_mayer/2"/>
        <tei:lg>
          <tei:l>Hi niḥama et avínu</tei:l>
          <tei:l>v-tinnaḥem otánu</tei:l>
          <tei:l>b-ferush-éha ba-Tora</tei:l>
          <tei:l>Uv-shirat-ah ha-ḥadasha.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
