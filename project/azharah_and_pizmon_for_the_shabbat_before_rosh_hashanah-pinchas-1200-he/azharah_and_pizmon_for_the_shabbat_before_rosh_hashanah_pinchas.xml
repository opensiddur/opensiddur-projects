    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas">
        <tei:head>אזהרות לשבת לפני ראש השנה לחכם ר׳ פנחס הלוי זלה״ה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/1"/>
        <tei:lg>
          <tei:l>אזהרה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אֱ</tei:seg>לֹהִים נִצָּב בַּעֲדַת־אֵל נוֹרָא עַל־כׇּל־אֱלֹהִים וּמׇשְׁלוֹ עַל־עָפָר</tei:l>
          <tei:l><tei:seg type="acrostic">אֶ</tei:seg>ת־כׇּל־מַעֲשֶׂה יָבִיא בְּמִשְׁפָּט כׇּל־דַּרְכֵי אִישׁ וְכׇל־צְעָדָיו בְּמִסְפָּר</tei:l>
          <tei:l><tei:seg type="acrostic">אֶ</tei:seg>ת־עַם מִבְחָרָיו צִוָּה לְהִזָּכֵר בִּכְתוֹב עַמִּים וַעֲוֺנָם יְכֻפַּר</tei:l>
          <tei:l>בַּיּ֣וֹם הַה֗וּא יִתָּקַע֮ בְּשׁוֹפָ֣ר׃ <tei:bibl>(ישעיה כז:יג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>כׇל־הַשּׁוֹפָרוֹת אָדָם יוֹצֵא יְדֵי חוֹבָתוֹ גַּם שֶׁל־יְעֵלִים יִכְשְׁרוּ</tei:l>
          <tei:l><tei:seg type="acrostic">בִּ</tei:seg>כְפוּפִים מִצְוָה מִדִּבְרֵי סוֹפְרִים וְגַם מֵהֶם בְּשֶׁל־אַֽיִל בָּחֲרוּ</tei:l>
          <tei:l><tei:seg type="acrostic">בִּ</tei:seg>לְבַד בְּשֶׁל־פָּרָה וְשֶׁאֵין גִּלְדּוֹ כְּשֶׁל־צְבִי מִתּוֹרַת שׁוֹפָר נִגְזְרוּ</tei:l>
          <tei:l>אֵ֤לֶּה הַקְּרָנוֹת֙ אֲשֶׁ֣ר זֵר֣וּ׃ <tei:bibl>(זכריה ב:ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">גֵּ</tei:seg>רְדוֹ עַל־גִּלְדּוֹ מִבִּפְנִים אוֹ־מִבַּחוּץ כָּשֵׁר אוֹ שֶׁקְּדָחוֹ וּמִין בְּמִינוֹ בּוֹ מְחֻבָּרִים</tei:l>
          <tei:l><tei:seg type="acrostic">גְּ</tei:seg>בוּל הֶכְשֵׁר שׁוֹפָר קָטָן עַד־טֶֽפַח וְאוּלָם מִצְוָה לְהִתְנָאוֹת בּוֹ הַמְּהַדְּרִים</tei:l>
          <tei:l><tei:seg type="acrostic">גַּ</tei:seg>ם־כְּשֶׁיּוֹשְׁבִין גַּם־כְּשֶׁעוֹמְדִין תּוֹקְעִין כְּדֵי שֶׁיִּתְעַרְבֵּב שָׂטָן וְיָשִֽׁיתוּ אֶל־לִבָּם בּוֹעֲרִים</tei:l>
          <tei:l>מֶ֠ה ק֣וֹל הַתְּרוּעָ֧ה הַגְּדוֹלָ֛ה הַזֹּ֖את בְּמַחֲנֵ֣ה הָעִבְרִ֑ים׃ <tei:bibl>(שמואל א׳ ד:ו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">דִּ</tei:seg>בֵּק שִׁבְרֵי שׁוֹפָרוֹת פָּסוּל וַאֲפִֽלּוּ הוֹסִיף עָלָיו כׇּל־שֶׁהוּא וְחִבַּר</tei:l>
          <tei:l><tei:seg type="acrostic">דַּ</tei:seg>ק צָרוּר אוֹ־עָבֶה כָּשֵׁר וַאֲפִֽלּוּ נִקַּב וְנִשְׁתַּנָּה מִכְּמוֹת שֶׁהָיָה כְּבָר</tei:l>
          <tei:l><tei:seg type="acrostic">דָּ</tei:seg>ת וָדִין שֶׁלֹּא־לְצַפּוֹתוֹ זָהָב מִבִּפְנִים וְכֵן מְקוֹם הַנָּחַת־פֶּה לֹא־יַפְרִיד כׇּל־דָּבָר</tei:l>
          <tei:l>אֶל־חִכְּךָ֣ שֹׁפָ֔ר׃ <tei:bibl>(הושע ח:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הַ</tei:seg>נִּסְדָּק לְרׇחְבּוֹ נִדּוֹן כִּשְׁנֵי שׁוֹפָרוֹת וְאִם־נִסְדַּק מֵעַל־לְשִׁעוּרוֹ הֻתַּר מִכְּלָלוֹ</tei:l>
          <tei:l><tei:seg type="acrostic">הַ</tei:seg>נּוֹתֵן שׁוֹפָר בְּתוֹךְ שׁוֹפָר כָּשֵׁר וַאֲפִֽלּוּ נִשְׁתַּנָּה קוֹל הַפְּנִימִי בִּגְלָלוֹ</tei:l>
          <tei:l><tei:seg type="acrostic">הַ</tei:seg>תּוֹקֵֽעַ בֵּין־הַדְּבָקִים לֹא־יָצָא אוֹ שֶׁחִיצוֹן אָרֹךְ וְתָקַע בַּפְּנִימִי לְבֵית חֲלָלוֹ</tei:l>
          <tei:l>וְעֶלְי֖וֹן יִתֵּ֥ן קוֹלֽוֹ׃ <tei:bibl>(שמואל ב׳ כב:יד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>שׁוֹפָר שֶׁהוּא רָאוּי וְעוֹמֵד לִשְׂרֵפָה רוֹאִין אוֹתוֹ כְּאִֽלּוּ הִתְפֹּרָר</tei:l>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>הַכֹּל חַיָּבִין בִּתְקִיעַת שׁוֹפָר כֹּהֲנִים לְוִיִּים וְיִשְׂרָאֵל וְגֵר וְעֶֽבֶד מְשֻׁחְרָר</tei:l>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>הַמִּתְעַסֵּק וְשׁוֹמְעוֹ לֹא־יָצָא וְלֹא־יִצְלַח גֶּֽבֶר עַל־חֲטָאָיו לֹא־יִתְעֹרָר</tei:l>
          <tei:l>אֶת־ק֤וֹל הַשּׁוֹפָר֙ שָׁמַע וְלֹ֣א נִזְהָ֔ר׃ <tei:bibl>(כמו יחזקאל לג:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זֹ</tei:seg>את תּוֹרַת הַשּׁוֹפָר אֵין לְהׇפְכוֹ לְהַחֲלִיף קְצוֹתָיו אַף־כִּי לְהׇפְכוֹ בְּעַצְמוֹ</tei:l>
          <tei:l><tei:seg type="acrostic">ז</tei:seg>וּלָתִי שֶׁהָיָה אָרֹךְ וְקִצְרוֹ כָּשֵׁר וְאַף־עַל־פִּי שֶׁנָּטַל רֹב גׇּלְמוֹ</tei:l>
          <tei:l><tei:seg type="acrostic">זָ</tei:seg>הָב אִם־צִפָּֽהוּ וְכׇל־שֶׁלֹּא בְּמִינוֹ מִבַּחוּץ כָּשֵׁר אֲבָל נִפְסָל בְּמוּמוֹ</tei:l>
          <tei:l>בְּשַׁנּוֹת֣וֹ אֶת־טַ֭עְמוֹ׃ <tei:bibl>(תהלים לד:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חִ</tei:seg>בֵּר שׁוֹפָר שֶׁנִּסְדַּק עַל־פְּנֵי אׇרְכּוֹ פָּסוּל חִבְּרוֹ אוֹ שֶׁלֹּא־חִבְּרוֹ אַחַת דָּתָם</tei:l>
          <tei:l><tei:seg type="acrostic">חִ</tei:seg>בְּרוֹ שֶׁלֹּא־בְּמִינוֹ אוֹ־שֶׁחִבְּרוֹ בְּמִינוֹ אוֹ־אֲפִֽלּוּ יְדַבֵּק חֲלָקָיו יַֽחַד גִּזְרָתָם</tei:l>
          <tei:l><tei:seg type="acrostic">חֵ</tei:seg>רֵשׁ שׁוֹטֶה וְקָטָן אֵין מוֹצִיאִין מְחֻיָּב בַּדָּבָר הֵם וְכֹל שֶׁכְּמוֹתָם</tei:l>
          <tei:l>אֲשֶׁ֧ר לֹ֦א צִוָּ֖ה אֹתָֽם׃ <tei:bibl>(ויקרא י:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/10"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">טֶֽ</tei:seg>רֶם הָנֵץ הַחַמָּה אֵין תּוֹקְעִין לְכַתְּחִלָּה וְאַחֲרֵי־כֵן הַזָּרִיז מְאֻשָּׁר</tei:l>
          <tei:l><tei:seg type="acrostic">ט</tei:seg>וֹרֵד לָצֵאת אֶת־הָעִיר שֶׁהִשְׁכִּים וְהַשַּֽׁחַר עָלָה לִתְקֹֽעַ־לוֹ לְכַתְּחִלָּה אָז יָשָׁר</tei:l>
          <tei:l><tei:seg type="acrostic">ט</tei:seg>וֹב לִתְקֹֽעַ לְתוֹךְ הַבּוֹר וְהַדּוּת וְגַם־לְהַקְשִׁיב מִחוּץ לַבּוֹר יִכְשָׁר</tei:l>
          <tei:l>כְּשׇׁמְעֲכֶם֙ אֶת־ק֣וֹל הַשּׁוֹפָ֔ר׃ <tei:bibl>(יהושוע ו:ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/11"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">י</tei:seg>וֹצְאִין בְּשׁוֹפָר נִקַּב וּסְתָמוֹ בְּשֶׁלֹּא־מְעַכֵּב הַתְּקִיעָה וְשֶׁבְּמִינוֹ סְתָמוֹ</tei:l>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>חִיד תּוֹקֵֽעַ לַחֲבֵרוֹ וּמְבָרֵךְ בְּמַטְבֵּֽעַ קָצָר אַחַר שֶׁתָּקַע לְעַצְמוֹ</tei:l>
          <tei:l><tei:seg type="acrostic">יֶֽ</tei:seg>לֶד שֶׁהִגִּֽיעַ לְחִנּוּךְ לְנַסּוֹתוֹ לָלֶֽכֶת בְּתוֹרָתוֹ וּלְחַכְּמוֹ</tei:l>
          <tei:l>הִֽתְעַשְּׂק֖וּ עִמּֽוֹ׃ <tei:bibl>(בראשית כו:כ)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/12"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כׇּ</tei:seg>ל־הַתְּקִיעוֹת מְעַכְּבוֹת זוֹ־אֶת־זוֹ בְּשֶׁלֹּא־יָדַע לְתׇקְעָן וְכֵן שֶׁשִּׁנָּה סִדְרָן בְּשׁוֹכֵֽחַ</tei:l>
          <tei:l><tei:seg type="acrostic">כְּ</tei:seg>מִנְהַג אָבוֹת לְסֵֽדֶר בְּרָכוֹת שֶׁעַל־הַתְּקִיעוֹת שְׁלִֽיחַ צִבּוּר בְּמוּסָפִין מְנַצֵּֽחַ</tei:l>
          <tei:l><tei:seg type="acrostic">כַּ</tei:seg>מָּה תֶּחֱרַשׁ אֱלֹהַי לְעַם יוֹדְעֵי תְּרוּעָה מְפָרֵשׂ כַּפָּיו וּמִתְיַפֵּֽחַ</tei:l>
          <tei:l>וְשֹׂנֵ֖א תֹקְעִ֣ים בּוֹטֵֽחַ׃ <tei:bibl>(משלי יא:טו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/13"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>חֹק מִשְׁפָּט שְׁלֹשָׁה סִדְרֵי תְּרוּעוֹת כׇּל־אַחַת בֵּין־שְׁנֵי פְּשׁוּטוֹת קְבוּעָה</tei:l>
          <tei:l><tei:seg type="acrostic">לִ</tei:seg>תְרוּעָה אֵין פּוֹחֲתִין מִשְּׁלֹשָׁה שְׁבָרִים שָׁלֹשׁ יְבָבוֹת בִּמְהִירוּת תְּנוּעָה</tei:l>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>בַד־זֶה תּוֹקְעִין סִדְרֵי שְׁבָרִים וְסִדְרֵי יְבָבוֹת כִּי־לֹא פֹּרַשׁ מִפִּי הַשְּׁמוּעָה</tei:l>
          <tei:l>מֶ֠ה ק֣וֹל הַתְּרוּעָ֧ה׃ <tei:bibl>(שמואל א׳ ד:ו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/14"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מַ</tei:seg>עֲרָכוֹת אֵֽלּוּ הַתְּרוּעוֹת אֵין לָחוֹשׁ אֵֽיזוֹ תּוֹקְעִין בַּסּוֹף וְאֵֽיזוֹ רִאשׁוֹנִית</tei:l>
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>דַּת שִׁעוּר פְּשׁוּטָה שֶׁבְּכׇל־סֵֽדֶר וָסֵֽדֶר כְּשִׁעוּר אוֹתָהּ תְּרוּעָה הַתִּיכוֹנִית</tei:l>
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>בֵּין כׇּל־שְׁתֵּי תְּרוּעוֹת שׁוֹנוֹת אֵין פְּשׁוּטָה מְחֻיֶּֽבֶת לְבַד אַחַת אַחֲרֹנִית</tei:l>
          <tei:l>וּתְקַעְתֶּ֤ם תְּרוּעָה֙ שֵׁנִ֔ית׃ <tei:bibl>(במדבר י:ו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/15"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נָ</tei:seg>דַר הֲנָאָה מִשּׁוֹפָר מֻתָּר לִתְקֹֽעַ כְּמִשְׁפָּטוֹ וְהַמַּדִּיר חֲבֵרוֹ אֵלָיו</tei:l>
          <tei:l><tei:seg type="acrostic">נ</tei:seg>וֹתֵן אָדָם מַֽיִם אוֹ־יַֽיִן לְתוֹךְ־שׁוֹפָר לְצַחְצְחוֹ אֲבָל אֵין דּוֹחִין יוֹם־טוֹב בִּגְלָלָיו</tei:l>
          <tei:l><tei:seg type="acrostic">נֶ</tei:seg>אֱסַר לְחׇתְכוֹ אֲפִֽלּוּ בְּדָבָר שֶׁהוּא מִשּׁוּם שְׁבוּת וַאֲפִֽלּוּ אֶת־תְּחוּם שְׁבִילָיו</tei:l>
          <tei:l>לֹא־יַעֲבֹ֥ר עָלָ֖יו׃ <tei:bibl>(כמו דברים כד:ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/16"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">סֵֽ</tei:seg>דֶר תְּקִיעוֹת שֶׁשָּׁמַע מֵרַבִּים יַֽחַד יָצָא אִם־אַחַת לְאַחַת נִשְׁמָֽעוּ</tei:l>
          <tei:l><tei:seg type="acrostic">סֵ</tei:seg>רוּגִין יָצָא לְבַד שְׁבָרִים וִיבָבוֹת שֶׁצְּרִיכִין תְּכִיפָה בַּאֲשֶׁר לִתְרוּעָה אַחַת הֻקְבָּֽעוּ</tei:l>
          <tei:l><tei:seg type="acrostic">סְ</tei:seg>פַר שְׁבָרִים שֶׁבָּא לְהוֹסִיף מוֹסִיף וְכֵן בִּמְשֹׁךְ הַתְּרוּעָה לֹא־יִפְשָֽׁעוּ</tei:l>
          <tei:l>אִם־בְּאַחַ֖ת יִתְקָ֑עוּ׃ <tei:bibl>(כמו במדבר י:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/17"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">עָ</tei:seg>מַד וְהֵרִֽיעַ מִתּוֹךְ פְּשׁוּטָה יָצָא וְכֵן בִּשְׁתֵּי פְּשׁוּטוֹת בְּשֶׁהִפְרִישָׁן בְּקוֹל אֵין לְהַאֲשִׁים</tei:l>
          <tei:l><tei:seg type="acrostic">ע</tei:seg>וֹרֵר עַל־דַּֽעַת אַחַת הַתְּקִיעוֹת וְנִמְלַךְ לְשַׁנּוֹת לֹא־יָצָא בְּכׇל־שֶׁהֵן קוֹלוֹת מֻפְרָשִׁים</tei:l>
          <tei:l><tei:seg type="acrostic">עַ</tei:seg>ל־תְּקִיעַת סִדְרֵי תְּרוּעוֹת שׁוֹנוֹת אֵין לָחוּשׁ בְּקוֹם יַֽחַד כְּאַחַת אֲנָשִׁים</tei:l>
          <tei:l>וַֽ֠יִּתְקְע֠וּ שְׁלֹ֨שֶׁת הָרָאשִׁ֥ים׃ <tei:bibl>(שופטים ז:כ)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/18"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>שׁוּטָה שֶׁשָּׁמַע שִׁעוּר בִּקְצָתָהּ וְשֶׁתָּקַע קְצָתָהּ שֶׁלֹּא כָּרָאוּי לֹא יֵרָצוּ</tei:l>
          <tei:l><tei:seg type="acrostic">פּ</tei:seg>וֹשְׁעִים שֶׁתָּקְעוּ בְּשׁוֹפָר גָּזוּל וְשֶׁאֵין־רָאוּי לְהִשְׁתַּמֵּשׁ־בּוֹ יָצְאוּ אֶֽפֶס כִּי־נִאֲצוּ</tei:l>
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>רָזוֹת בְּאַחַת מְבָרְכִין וּבְאַחַת תּוֹקְעִין אַף בְּסָפֵק אֲשֶׁר כֵּן נוֹעֲצוּ</tei:l>
          <tei:l>בִּמְק֗וֹם אֲשֶׁ֤ר תִּשְׁמְעוּ֙ אֶת־ק֣וֹל הַשּׁוֹפָ֔ר שָׁ֖מָּה תִּקָּבְצ֣וּ׃ <tei:bibl>(נחמיה ד:יד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/19"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">צֶֽ</tei:seg>דֶק מִשְׁפָּט שֶׁאִם־שָׁמַע כְּשִׁעוּר בְּמִקְצָת תְּרוּעָה יָצָא לְפִי־שֶׁהֵן קוֹלוֹת מְחֻבָּרוֹת</tei:l>
          <tei:l><tei:seg type="acrostic">צָ</tei:seg>רִיךְ לְהִזָּהֵר מֵהִתְקַלְקֵל הַתְּקִיעוֹת שֶׁלֹּא־לְהַפְסִיק בֵּין־תְּרוּעָה וּפְשׁוּטוֹת הַמְּסֻדָּרוֹת</tei:l>
          <tei:l><tei:seg type="acrostic">צִ</tei:seg>וּוּ יוֹדְעֵי־דָּת שֶׁלֹּא־לִתְקֽוֹעַ בְּיוֹם־טוֹב שֶׁחָל לִהְיוֹת בְּשַׁבָּת אוּלַי יֵלְכוּ אֵֽצֶל בָּקִי לְהוֹרוֹת</tei:l>
          <tei:l>וּ֨בְיַד־יְמִינָ֔ם הַשּׁוֹפָר֖וֹת׃ <tei:bibl>(שופטים ז:כ)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/20"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קִ</tei:seg>דֵּם וּבֵרַךְ תּוֹקֵֽעַ אַחֲרֵי־כֵן וּמִצְוָה עַל־סֵֽדֶר בְּרָכוֹת בְּחֶֽבֶר־עִיר אֲבָל לֹא־בִּיחִידִים</tei:l>
          <tei:l><tei:seg type="acrostic">קֹֽ</tei:seg>דֶם שֶׁיִּטְעֹם אָדָם כְּלוּם רָאוּי לִתְקֽוֹעַ וְאִם־הִתְחִֽילוּ מַפְסִיקִין וְעוֹמְדִים</tei:l>
          <tei:l><tei:seg type="acrostic">קְ</tei:seg>רֵבִים לִתְקֽוֹעַ גַּם־כְּשֶׁיֵּשׁ שְׁהוּת בַּיּוֹם וְכֵן בְּיוֹם־טוֹב שֵׁנִי וְגַם כִּי־שְׁנֵיהֶם נוֹעָדִים</tei:l>
          <tei:l>כְּיָמִ֣ים אֲחָדִ֔ים׃ <tei:bibl>(בראשית כט:כ)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/21"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רֵ</tei:seg>אשִׁית דָּבָר כׇּל־שֶׁאֵינוֹ מִן־הַמּוּכָן וְכׇל־סָפֵק מוּכָן בְּיוֹם רִאשׁוֹן גַּם לְיוֹם שֵׁנִי דְּחוּיִים</tei:l>
          <tei:l><tei:seg type="acrostic">רַ</tei:seg>ק לְרֽוּחַ אַחַת מְעָרְבִין לְיוֹם רִאשׁוֹן וְשֵׁנִי וּמִתְּחִלַּת יוֹם רִאשׁוֹן תְּחוּמִין לְיוֹם שֵׁנִי קְנוּיִים</tei:l>
          <tei:l><tei:seg type="acrostic">רִ</tei:seg>אשׁוֹן וְשֵׁנִי תּוֹרָה אַחַת לָהֶם לְכׇל־הַמַּעֲשִׂים אֲשֶׁר לַעֲשׂוֹתָם בְּיוֹם־טוֹב אֵינָם רְאוּיִים</tei:l>
          <tei:l>כׇּל־הַכָּת֥וּב לַחַיִּ֖ים׃ <tei:bibl>(ישעיה ד:ג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/22"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שָׁ</tei:seg>לוֹשׁ שָׁעוֹת רִאשׁוֹנוֹת לֹא־יִתְפַּלֵּל יָחִיד מוּסָפִין אִם לֹא־יַֽחַד בִּקְהִלָּה</tei:l>
          <tei:l><tei:seg type="acrostic">שֶׁ</tei:seg>אֵינוֹ בָּקִי בְּצִבּוּר וְשֶׁבַּשָּׂדוֹת שְׁלִֽיחַ־צִבּוּר פּוֹטֵר בְּכׇל־בְּרָכָה וּתְהִלָּהּ</tei:l>
          <tei:l><tei:seg type="acrostic">שָׁ</tei:seg>לֹשׁ בְּרָכוֹת שֶׁל־תְּקִיעוֹת אַף־הַבָּקִי מוֹצִיא בָּהֶם וְשֶׁבָּעִיר שֶׁעָמַד מִתְּחִלָּה</tei:l>
          <tei:l>לִשְׁמֹ֙עַ֙ אֶל־הַתְּפִלָּ֔ה׃ <tei:bibl>(מלכים א׳ ח:כט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/23"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">תְּ</tei:seg>מִים דֵּעִים הַבֵּט וּפְקוֹד עַם נִדַּח הָיָה לָבַז וּבְרִית לֹא־הֵפַר</tei:l>
          <tei:l><tei:seg type="acrostic">תּ</tei:seg>וֹחַלְתּוֹ לְךָ הִיא כִּ֤י יִרְאֶה֙ כִּֽי־אָ֣זְלַת יָ֔ד וְיִבְטַח כִּי־לֹא יֶחְפָּר</tei:l>
          <tei:l><tei:seg type="acrostic">תָּ</tei:seg>מִיד מְיַחֵל לִקְרֹא דְּרוֹר לֶאֱסֹף אֶת־שְׂרִידָיו אֶל־נַחֲלַת תִּשְׁפָּר</tei:l>
          <tei:l>עַד־מָתַ֖י אֶרְאֶה־נֵּ֑ס אֶשְׁמְעָ֖ה ק֥וֹל שׁוֹפָֽר׃ <tei:bibl>(ירמיה ד:כא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/24"/>
        <tei:lg>
          <tei:l>פזמון</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/25"/>
        <tei:lg>
          <tei:l>אֲסִיר תִּקְוָה לְקֵץ יָמִין</tei:l>
          <tei:l>לֹא יַאֲמִין כִּי יְסֻפַּר</tei:l>
          <tei:l>וְאִם־חָזוֹן לֹא־יֹאבַד</tei:l>
          <tei:l>הַמְּחַכֶּה לֹא־יֶחְפָּר</tei:l>
          <tei:l>פְּדוּת שָׁמוּר לַמּוֹעֵד</tei:l>
          <tei:l>וְיֶאֱתָיוּ שְׁנוֹת מִסְפָּר׃</tei:l>
          <tei:l>כִּנְשֹׂא־נֵ֤ס הָרִים֙ תִּרְא֔וּ וְכִתְקֹ֥עַ שׁוֹפָ֖ר׃ <tei:bibl>(ישעיה יט:ג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/26"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פְּׄ</tei:seg>דוּת שָׁמוּר וְיֵשׁ תִּקְוָה</tei:l>
          <tei:l>יֵשׁ תִּקְוָה וְתוֹחֶֽלֶת</tei:l>
          <tei:l>וְלָֽמָּה תִּשְׁאַל מָה אוֹת</tei:l>
          <tei:l>אִם־נִשְׁאֲרָה גַּחֶֽלֶת</tei:l>
          <tei:l>סְנֶה בּוֹעֵר וְלֹא־אֻכַּל</tei:l>
          <tei:l>פְּלֵיטָה בְּאֵין מֶמְשֶֽׁלֶת</tei:l>
          <tei:l>אֵין נִמְכַּר לְעֶֽבֶד</tei:l>
          <tei:l>וְאֵין נִרְצָע בַּדֶּֽלֶת</tei:l>
          <tei:l>וְאֵיךְ לֹא־אָבְדָה שְׁאֵרִית</tei:l>
          <tei:l>בָּעַמִּים מִתְבּוֹלֶֽלֶת</tei:l>
          <tei:l>אוֹ תַּחֲזִיק בְּרִית וְתוֹרָה</tei:l>
          <tei:l>בְּדָמִים מִתְגּוֹלֶֽלֶת</tei:l>
          <tei:l>אֲבָל עוֹד זְמַן וְנִגְאֶֽלֶת</tei:l>
          <tei:l>בִּתְרוּעָה וְקוֹל שׁוֹפָר׃</tei:l>
          <tei:l>כִּנְשֹׂא־נֵ֤ס הָרִים֙ תִּרְא֔וּ וְכִתְקֹ֥עַ שׁוֹפָ֖ר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/27"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יַׄ</tei:seg>שִּׂיג מַגִּיד לְסַפֵּר</tei:l>
          <tei:l>אִם יָכִֽילוּ מְגִלּוֹת</tei:l>
          <tei:l>כׇּל־אֲשֶׁר דִּמּוּ לְנַפְשִׁי</tei:l>
          <tei:l>אוֹיְבִים בְּיָדָם לְמַלֹּאת</tei:l>
          <tei:l>יוֹם יוֹם חָמְסוּ תּוֹרָה</tei:l>
          <tei:l>וְדוֹר דּוֹר עָמְדוּ לְכַלּוֹת</tei:l>
          <tei:l>וְאֶשְׁתּוֹמֵם וְאֵין־סוֹמֵךְ</tei:l>
          <tei:l>וְחָדַל כּוֹפֵר סְגֻלּוֹת</tei:l>
          <tei:l>וְכׇל־יִשְׁעִי בְּאֶֽפֶס יָד</tei:l>
          <tei:l>מְנוּסִי צוֹם וּתְפִלּוֹת</tei:l>
          <tei:l>וְאֵיךְ לֹא־גְּאֻלָּה יְקַוֶּה</tei:l>
          <tei:l>רוֹאֶה יוֹם יוֹם גְּאֻלּוֹת</tei:l>
          <tei:l>בְּאׇזְנַי נוֹרָא תְּהִלּוֹת</tei:l>
          <tei:l>תּוֹקֵֽעַ בְּשׁוֹפָר׃</tei:l>
          <tei:l>כִּנְשֹׂא־נֵ֤ס הָרִים֙ תִּרְא֔וּ וְכִתְקֹ֥עַ שׁוֹפָ֖ר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/28"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נַׄחֲׄ</tei:seg>לַת צְבִי לִי לְעֵדוּת</tei:l>
          <tei:l>תְּשׁוּעָה וְאִם־מְאַחֶֽרֶת</tei:l>
          <tei:l>לֹא אֶל־אוֹיְבִים יְרֻשָּׁה</tei:l>
          <tei:l>לֹא אֲבָל כּוֹס מְשַׁכֶּֽרֶת</tei:l>
          <tei:l>לָעוֹשְׂקִים תִּהְיֶה נְדָבָה</tei:l>
          <tei:l>לַמַּחֲזִיקִים לְמִמְכֶּֽרֶת</tei:l>
          <tei:l>אִם־יוֹם יֹאחֲזוּ־בָּהּ</tei:l>
          <tei:l>וְלֹא־מָחָר מְנַעֶֽרֶת</tei:l>
          <tei:l>וְאֵיךְ וְעַפְרוֹת מְקוֹם מִקְדָּשׁ</tei:l>
          <tei:l>עוֹד הַיּוֹם לְתִפְאֶֽרֶת</tei:l>
          <tei:l>וְאֵיךְ לֹא־לְאַרְמוֹן זָרִים</tei:l>
          <tei:l>אִם לֹא־לְאוֹת לְמִשְׁמֶֽרֶת</tei:l>
          <tei:l>עֵדוּת לִמְבַשֶּֽׂרֶת</tei:l>
          <tei:l>עַל־הָהָר וְקֹל שֹׁפָר׃</tei:l>
          <tei:l>כִּנְשֹׂא־נֵ֤ס הָרִים֙ תִּרְא֔וּ וְכִתְקֹ֥עַ שׁוֹפָ֖ר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/29"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">סָׄ</tei:seg>פְדוּ עַל־מַה מְנָאֲצִים</tei:l>
          <tei:l>מִדָּמִים לְעַם קְדוֹשִׁים</tei:l>
          <tei:l>אוּלַי חָזוֹן בְּקִרְבָּם</tei:l>
          <tei:l>אִם־לֹא לִקְרַאת נְחָשִׁים</tei:l>
          <tei:l>מִי לָכֶם בְּסוֹד אֱלֹהִים</tei:l>
          <tei:l>לַחֲזוֹת בְּיֶֽשַׁע נְפָשִׁים</tei:l>
          <tei:l>גַּם־נְבִיאִים גַּם־אוּרִים</tei:l>
          <tei:l>אֶל־כׇּל־חֵֽפֶץ דְּרוּשִׁים</tei:l>
          <tei:l>אַיֵּה מוֹפְתַי תָּמִיד</tei:l>
          <tei:l>מוֹרָאִים מְחֻדָּשִׁים</tei:l>
          <tei:l>וְאַיֵּה אֶצְבַּע אֱלֹהִים</tei:l>
          <tei:l>לֹא־בְּרֶֽכֶב וּפָרָשִׁים</tei:l>
          <tei:l>אָז יַחְפְּרוּ כֶּחָשִׁים</tei:l>
          <tei:l>אִם־יִתָּקַע שׁוֹפָר׃</tei:l>
          <tei:l>כִּנְשֹׂא־נֵ֤ס הָרִים֙ תִּרְא֔וּ וְכִתְקֹ֥עַ שׁוֹפָ֖ר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/30"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הֵׄ</tei:seg>ן <tei:seg type="acrostic">לׄוּׄ יִׄ</tei:seg>מְלְאוּ יָמִים</tei:l>
          <tei:l>וְיֵאָמֵן קֵץ פְּלָאוֹת</tei:l>
          <tei:l>לֹא תֹּאבוּ לִי מְשַׂנְּאִים</tei:l>
          <tei:l>אִם־לֹא יִפְרְצוּ נְבוּאוֹת</tei:l>
          <tei:l>לֹא לֶאֱמוּנָה גָּבְרוּ</tei:l>
          <tei:l>כׇּל־אֲשֶׁר יָשְׁבוּ לְכִסְאוֹת</tei:l>
          <tei:l>הָעָם יוֹדְעֵי אֱלֹהָיו</tei:l>
          <tei:l>יוֹדְעֵי סְתוּמוֹת וּבָאוֹת</tei:l>
          <tei:l>מְעַתְּדִים גְּמוּל אַחֲרֵי מוֹת</tei:l>
          <tei:l>כָּעֵת תְּנוּ לָכֶם אוֹת</tei:l>
          <tei:l>הָעֵדוּת לְיִשְׂרָאֵל</tei:l>
          <tei:l>מַחֲזֵה שָׁדַי וּמַרְאוֹת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/31"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חִׄזְׄקׄ</tei:seg>וּ מְיַחֲלִים לִרְאוֹת</tei:l>
          <tei:l>הַקְשִֽׁיבוּ לְקוֹל שׁוֹפָר׃</tei:l>
          <tei:l>כִּנְשֹׂא־נֵ֤ס הָרִים֙ תִּרְא֔וּ וְכִתְקֹ֥עַ שׁוֹפָ֖ר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/32"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בְּׄ</tei:seg>רִית לְקֵץ וְלֹא־יְכַזֵּב</tei:l>
          <tei:l>לֹא־אֶדְאַג מֵחַטָּאִים</tei:l>
          <tei:l><tei:seg type="acrostic">רַֽׄ</tei:seg>הַב וּבָבֶל אֶזְכֹּר</tei:l>
          <tei:l>נֶעֱזַֽרְתִּי בְּתוֹךְ לְבָאִים</tei:l>
          <tei:l><tei:seg type="acrostic">יׄוֹׄסֵׄףׄ</tei:seg> לְבָבִי תִּקְוָה</tei:l>
          <tei:l>כְּהָצֵר לוֹ בְּבֵית כְּלָאִים</tei:l>
          <tei:l>בְּהֵאָמֵן דְּבַר נְבוּאוֹת</tei:l>
          <tei:l>אוֹת לְהֵאָמֵן פְּלָאִים</tei:l>
          <tei:l>לְקֵץ מִסְפַּר שְׁנוֹת רָצוֹן</tei:l>
          <tei:l>לְהַחֲיוֹת לֵב נִדְכָּאִים</tei:l>
          <tei:l>לָשׂוּם שְׁפָלִים לַמָּרוֹם</tei:l>
          <tei:l>בְּמוֹפְתִים וּבְמוֹרָאִים</tei:l>
          <tei:l>בְּמוֹפְתִים וּבַמּוֹרָאִים</tei:l>
          <tei:l>בַּחֲצוֹצְרוֹת וְקוֹל שׁוֹפָר׃</tei:l>
          <tei:l>כִּנְשֹׂא־נֵ֤ס הָרִים֙ תִּרְא֔וּ וְכִתְקֹ֥עַ שׁוֹפָ֖ר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/33"/>
        <tei:lg>
          <tei:l>כַּכָּתוּב —</tei:l>
          <tei:l>ק֥וֹל צֹפַ֛יִךְ נָ֥שְׂאוּ ק֖וֹל</tei:l>
          <tei:l>יַחְדָּ֣ו יְרַנֵּ֑נוּ</tei:l>
          <tei:l>כִּ֣י עַ֤יִן בְּעַ֙יִן֙ יִרְא֔וּ</tei:l>
          <tei:l>בְּשׁ֥וּב יְהֹוָ֖ה צִיּֽוֹן׃ <tei:bibl>(ישעיה נב:ח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/34"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>וְאַף־גַּם־זֹ֠את בִּֽהְיוֹתָ֞ם בְּאֶ֣רֶץ אֹֽיְבֵיהֶ֗ם</tei:l>
          <tei:l>לֹֽא־מְאַסְתִּ֤ים וְלֹֽא־גְעַלְתִּים֙ לְכַלֹּתָ֔ם</tei:l>
          <tei:l>לְהָפֵ֥ר בְּרִיתִ֖י אִתָּ֑ם</tei:l>
          <tei:l>כִּ֛י אֲנִ֥י יְהֹוָ֖ה אֱלֹהֵיהֶֽם׃ <tei:bibl>(ויקרא כו:מד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/35"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>כִּֽי־לִ֤י בְנֵֽי־יִשְׂרָאֵל֙ עֲבָדִ֔ים</tei:l>
          <tei:l>עֲבָדַ֣י הֵ֔ם</tei:l>
          <tei:l>אֲשֶׁר־הוֹצֵ֥אתִי אוֹתָ֖ם מֵאֶ֣רֶץ מִצְרָ֑יִם</tei:l>
          <tei:l>אֲנִ֖י יְהֹוָ֥ה אֱלֹהֵיכֶֽם׃ <tei:bibl>(ויקרא כה:נה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/36"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>כִּֽי־עֲבָדַ֣י הֵ֔ם</tei:l>
          <tei:l>אֲשֶׁר־הוֹצֵ֥אתִי אֹתָ֖ם מֵאֶ֣רֶץ מִצְרָ֑יִם</tei:l>
          <tei:l>לֹ֥א יִמָּכְר֖וּ מִמְכֶּ֥רֶת עָֽבֶד׃ <tei:bibl>(ויקרא כה:מב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/37"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>וַיֹּ֙אמֶר֙</tei:l>
          <tei:l>אַךְ־עַמִּ֣י הֵ֔מָּה בָּנִ֖ים</tei:l>
          <tei:l>לֹ֣א יְשַׁקֵּ֑רוּ</tei:l>
          <tei:l>וַיְהִ֥י לָהֶ֖ם לְמוֹשִֽׁיעַ׃ <tei:bibl>(ישעיה סג:ח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/38"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>וַהֲשִׁמֹּתִ֥י אֲנִ֖י אֶת־הָאָ֑רֶץ</tei:l>
          <tei:l>וְשָֽׁמְמ֤וּ עָלֶ֙יהָ֙ אֹֽיְבֵיכֶ֔ם הַיֹּשְׁבִ֖ים בָּֽהּ׃ <tei:bibl>(ויקרא כו:לב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/39"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>וַיֹּ֨אמֶר יְהֹוָ֜ה אֵלָ֗יו</tei:l>
          <tei:l>שָׁ֠מַ֠עְתִּי אֶת־תְּפִלָּתְךָ֣ וְאֶת־תְּחִנָּתְךָ֮</tei:l>
          <tei:l>אֲשֶׁ֣ר הִתְחַנַּ֣נְתָּה לְפָנַי֒</tei:l>
          <tei:l>הִקְדַּ֗שְׁתִּי אֶת־הַבַּ֤יִת הַזֶּה֙</tei:l>
          <tei:l>אֲשֶׁ֣ר בָּנִ֔תָה לָשׂוּם־שְׁמִ֥י שָׁ֖ם עַד־עוֹלָ֑ם</tei:l>
          <tei:l>וְהָי֨וּ עֵינַ֧י וְלִבִּ֛י שָׁ֖ם כׇּל־הַיָּמִֽים׃ <tei:bibl>(מלכים א׳ ט:ג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/40"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>מַגִּ֣יד דְּבָרָ֣ו לְיַעֲקֹ֑ב</tei:l>
          <tei:l>חֻקָּ֥יו וּ֝מִשְׁפָּטָ֗יו לְיִשְׂרָאֵֽל׃ <tei:bibl>(תהלים קמז:יט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/41"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>לֹ֘א־עָ֤שָׂה כֵ֨ן ׀ לְכׇל־גּ֗וֹי</tei:l>
          <tei:l>וּמִשְׁפָּטִ֥ים בַּל־יְדָע֗וּם</tei:l>
          <tei:l>הַֽלְﬞלוּ־יָֽהּ׃ <tei:bibl>(תהלים קמז:כ)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/42"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>וְיָדְע֗וּ</tei:l>
          <tei:l>כִּ֣י אֲנִ֤י יְהֹוָה֙ אֱלֹ֣הֵיהֶ֔ם</tei:l>
          <tei:l>בְּהַגְלוֹתִ֤י אֹתָם֙ אֶל־הַגּוֹיִ֔ם</tei:l>
          <tei:l>וְכִנַּסְתִּ֖ים עַל־אַדְמָתָ֑ם</tei:l>
          <tei:l>וְלֹא־אוֹתִ֥יר ע֛וֹד מֵהֶ֖ם שָֽׁם׃ <tei:bibl>(יחזקאל לט:כח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/43"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>וְלֹא־אַסְתִּ֥יר ע֛וֹד פָּנַ֖י מֵהֶ֑ם</tei:l>
          <tei:l>אֲשֶׁ֨ר שָׁפַ֤כְתִּי אֶת־רוּחִי֙ עַל־בֵּ֣ית יִשְׂרָאֵ֔ל</tei:l>
          <tei:l>נְאֻ֖ם אֲדֹנָ֥י יֱהֹוִֽה׃ <tei:bibl>(יחזקאל לט:כט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/44"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>וָאֶשְׁמַ֞ע אֶת־הָאִ֣ישׁ ׀ לְב֣וּשׁ הַבַּדִּ֗ים</tei:l>
          <tei:l>אֲשֶׁ֣ר מִמַּ֘עַל֮ לְמֵימֵ֣י הַיְאֹר֒</tei:l>
          <tei:l>וַיָּ֨רֶם יְמִינ֤וֹ וּשְׂמֹאלוֹ֙ אֶל־הַשָּׁמַ֔יִם</tei:l>
          <tei:l>וַיִּשָּׁבַ֖ע בְּחֵ֣י הָעוֹלָ֑ם</tei:l>
          <tei:l>כִּי֩ לְמוֹעֵ֨ד מֽוֹעֲדִ֜ים וָחֵ֗צִי</tei:l>
          <tei:l>וּכְכַלּ֛וֹת</tei:l>
          <tei:l>נַפֵּ֥ץ יַד־עַם־קֹ֖דֶשׁ</tei:l>
          <tei:l>תִּכְלֶ֥ינָה כׇל־אֵֽלֶּה׃ <tei:bibl>(דניאל יב:ז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azharah_and_pizmon_for_the_shabbat_before_rosh_hashanah_pinchas/45"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>וְהָיָ֣ה ׀ בַּיּ֣וֹם הַה֗וּא</tei:l>
          <tei:l>יִתָּקַע֮ בְּשׁוֹפָ֣ר גָּדוֹל֒</tei:l>
          <tei:l>וּבָ֗אוּ הָאֹֽבְדִים֙ בְּאֶ֣רֶץ אַשּׁ֔וּר</tei:l>
          <tei:l>וְהַנִּדָּחִ֖ים בְּאֶ֣רֶץ מִצְרָ֑יִם</tei:l>
          <tei:l>וְהִשְׁתַּחֲו֧וּ לַיהֹוָ֛ה</tei:l>
          <tei:l>בְּהַ֥ר הַקֹּ֖דֶשׁ בִּירוּשָׁלָֽ͏ִם׃ <tei:bibl>(ישעיה כז:יג)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
