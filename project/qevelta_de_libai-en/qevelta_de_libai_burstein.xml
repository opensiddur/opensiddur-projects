  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:qevelta_de_libai_burstein">
        <tei:head>Qevelta de-Liba'i (My Heart's Lament), by Asher Hillel Burstein</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qevelta_de_libai_burstein/1"/>
        <tei:lg>
          <tei:l>Tell me, boy, tell me</tei:l>
          <tei:l>Tell me, boy.</tei:l>
          <tei:l>Have you seen my face today?</tei:l>
          <tei:l>Have you seen my face?</tei:l>
          <tei:l>It has become very sad</tei:l>
          <tei:l>Because you have chosen another.</tei:l>
          <tei:l>And me, and me</tei:l>
          <tei:l>You have driven from your heart.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qevelta_de_libai_burstein/2"/>
        <tei:lg>
          <tei:l>Tell me, boy, tell me</tei:l>
          <tei:l>Tell me, boy.</tei:l>
          <tei:l>You have left me alone in the world</tei:l>
          <tei:l>You have left me alone.</tei:l>
          <tei:l>And my song has become a lament</tei:l>
          <tei:l>My eye sheds tears.</tei:l>
          <tei:l>But tomorrow a light will rise for me</tei:l>
          <tei:l>And the sun will yet shine.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
