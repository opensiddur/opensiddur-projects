  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:baugesang_an_alphabetical_yiddish_adaptation_of_the_piyyut">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_an_alphabetical_yiddish_adaptation_of_the_piyyut/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אַ</tei:seg>למעכטיגר גאָט,</tei:l>
          <tei:l>נוּן בּױא דײַן טעמפּל שירה</tei:l>
          <tei:l>אַלזוֹ שיר אוּנ אַלזוֹ באַלד</tei:l>
          <tei:l>אין אוּנדזערן טאַגן שירה</tei:l>
          <tei:l>יאַ שירה</tei:l>
          <tei:l>נוּן בּױא, נוּן בּױא,</tei:l>
          <tei:l>נוּן בּױא דײַן טעמפּל שירה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_an_alphabetical_yiddish_adaptation_of_the_piyyut/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ב</tei:seg>אַרמהערציגר גאָט,</tei:l>
          <tei:l>נוּן בּױא...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_an_alphabetical_yiddish_adaptation_of_the_piyyut/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ג</tei:seg>ראָסר גאָט,</tei:l>
          <tei:l><tei:seg type="acrostic">ד</tei:seg>עמוּטיגר גאָט,</tei:l>
          <tei:l>נוּן בּױא...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_an_alphabetical_yiddish_adaptation_of_the_piyyut/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ה</tei:seg>וֹכער גאָט,</tei:l>
          <tei:l><tei:seg type="acrostic">װ</tei:seg>ירדיגר גאָט,</tei:l>
          <tei:l><tei:seg type="acrostic">ז</tei:seg>יסר גאָט,</tei:l>
          <tei:l><tei:seg type="acrostic">ח</tei:seg>ינ׳טר גאָט,</tei:l>
          <tei:l>נוּן בּױא...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_an_alphabetical_yiddish_adaptation_of_the_piyyut/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ט</tei:seg>וּגענדליכר גאָט,</tei:l>
          <tei:l><tei:seg type="acrostic">י</tei:seg>וּדישר גאָט,</tei:l>
          <tei:l>נוּן בּױא...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_an_alphabetical_yiddish_adaptation_of_the_piyyut/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כּ</tei:seg>רעפֿטיגר גאָט,</tei:l>
          <tei:l><tei:seg type="acrostic">ל</tei:seg>עבענדיגר גאָט,</tei:l>
          <tei:l><tei:seg type="acrostic">מ</tei:seg>עכטיגר גאָט,</tei:l>
          <tei:l><tei:seg type="acrostic">נ</tei:seg>אַמהאַפֿטיגר גאָט,</tei:l>
          <tei:l><tei:seg type="acrostic">ס</tei:seg>ענפטיגר גאָט,</tei:l>
          <tei:l><tei:seg type="acrostic">ע</tei:seg>יבֿיגר גאָט,</tei:l>
          <tei:l>נוּן בּױא...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_an_alphabetical_yiddish_adaptation_of_the_piyyut/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פֿ</tei:seg>ורכטצוּמר גאָט,</tei:l>
          <tei:l><tei:seg type="acrostic">צ</tei:seg>ימליכר גאָט,</tei:l>
          <tei:l><tei:seg type="acrostic">ק</tei:seg>עניגליכר גאָט,</tei:l>
          <tei:l><tei:seg type="acrostic">ר</tei:seg>ײכר גאָט,</tei:l>
          <tei:l>נוּן בּױא...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_an_alphabetical_yiddish_adaptation_of_the_piyyut/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ש</tei:seg>ײנר גאָט</tei:l>
          <tei:l><tei:seg type="acrostic">תּ</tei:seg>רױטר גאָט</tei:l>
          <tei:l>נוּן בּױא...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_an_alphabetical_yiddish_adaptation_of_the_piyyut/9"/>
        <tei:lg>
          <tei:l>דוּא בישט גאָט</tei:l>
          <tei:l>אוּנ׳ קײנר מער</tei:l>
          <tei:l>נוּן בּױא...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
