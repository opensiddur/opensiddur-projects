    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu">
        <tei:head>הַיּוֹם תְּאַמְּצֵנוּ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/1"/>
        <tei:lg>
          <tei:l>הַיּוֹם תְּ<tei:seg type="acrostic">אַ</tei:seg>מְּצֵנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/2"/>
        <tei:lg>
          <tei:l>הַיּוֹם תְּ<tei:seg type="acrostic">בָ</tei:seg>רְכֵנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/3"/>
        <tei:lg>
          <tei:l>הַיּוֹם תְּ<tei:seg type="acrostic">גַ</tei:seg>דְּלֵנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/4"/>
        <tei:lg>
          <tei:l>הַיּוֹם תִּ<tei:seg type="acrostic">דְ</tei:seg>רְשֵׁנוּ לְטוֹבָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/5"/>
        <tei:lg>
          <tei:l>הַיּוֹם תְּ<tei:seg type="acrostic">הַ</tei:seg>דְּרֵנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/6"/>
        <tei:lg>
          <tei:l>הַיּוֹם תְּ<tei:seg type="acrostic">וַ</tei:seg>עֲדֵנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/7"/>
        <tei:lg>
          <tei:l>הַיּוֹם תִּ<tei:seg type="acrostic">זְ</tei:seg>כְּרֵנוּ בְּרַחֲמֶיךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/8"/>
        <tei:lg>
          <tei:l>הַיּוֹם תְּ<tei:seg type="acrostic">חַ</tei:seg>סְּנֵנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/9"/>
        <tei:lg>
          <tei:l>הַיּוֹם תְּ<tei:seg type="acrostic">טַ</tei:seg>הֲרֵנוּ מִכׇּל־חֵטְא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/10"/>
        <tei:lg>
          <tei:l>הַיּוֹם תְּ<tei:seg type="acrostic">יַ</tei:seg>שְּׁרֵנוּ לְפָנֶיךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/11"/>
        <tei:lg>
          <tei:l>הַיּוֹם תְּ<tei:seg type="acrostic">כַ</tei:seg>בְּדֵנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/12"/>
        <tei:lg>
          <tei:l>הַיּוֹם תְּ<tei:seg type="acrostic">לַ</tei:seg>בֲבֵנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/13"/>
        <tei:lg>
          <tei:l>הַיּוֹם תְּ<tei:seg type="acrostic">מַ</tei:seg>לְּטֵנוּ מִכׇּל־רָע</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/14"/>
        <tei:lg>
          <tei:l>הַיּוֹם תִּ<tei:seg type="acrostic">נַ</tei:seg>קֵנוּ מֵעָוֺן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/15"/>
        <tei:lg>
          <tei:l>הַיּוֹם תִּ<tei:seg type="acrostic">סְ</tei:seg>מְכֵנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/16"/>
        <tei:lg>
          <tei:l>הַיּוֹם תַּ<tei:seg type="acrostic">עֲ</tei:seg>נֵנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/17"/>
        <tei:lg>
          <tei:l>הַיּוֹם תִּ<tei:seg type="acrostic">פְ</tei:seg>קְדֵנוּ לְחַיִּים וְלִבְרָכָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/18"/>
        <tei:lg>
          <tei:l>הַיּוֹם תְּ<tei:seg type="acrostic">צַ</tei:seg>דְּקֵנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/19"/>
        <tei:lg>
          <tei:l>הַיּוֹם תְּ<tei:seg type="acrostic">ק</tei:seg>וֹמֲמֵנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/20"/>
        <tei:lg>
          <tei:l>הַיּוֹם תְּ<tei:seg type="acrostic">רַ</tei:seg>חֲמֵנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/21"/>
        <tei:lg>
          <tei:l>הַיּוֹם תִּ<tei:seg type="acrostic">שְׁ</tei:seg>מַע שַׁוְעָתֵנוּ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:note type="instruction">על השמיטה:</tei:note> הַיוֹם תִּ<tei:seg type="acrostic">שְׁ</tei:seg>מְטֵנוּ לִגְאוּלָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/22"/>
        <tei:lg>
          <tei:l>הַיּוֹם תִּ<tei:seg type="acrostic">תְ</tei:seg>מְכֵנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/23"/>
        <tei:lg>
          <tei:l>כְּהַיּוֹם הַזֶּה</tei:l>
          <tei:l>תְּבִיאֵנוּ שָׂשִׂים וּשְׂמֵחִים בְּבִנְיַן שָׁלֵם׃</tei:l>
          <tei:l>כַּכָּתוּב עַל יַד נְבִיאָךְ</tei:l>
          <tei:l>”וַהֲבִיאוֹתִים אֶל־הַר קָדְשִׁי</tei:l>
          <tei:l>וְשִׂמַּחְתִּים בְּבֵית תְּפִלָּתִי עוֹלֹתֵיהֶם</tei:l>
          <tei:l>וְזִבְחֵיהֶם לְרָצוֹן עַל־מִזְבְּחִי</tei:l>
          <tei:l>כִּי בֵיתִי בֵּית־תְּפִלָּה יִקָּרֵא לְכָל־הָעַמִּים׃“ <tei:bibl>(ישעיהו נו:ז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/24"/>
        <tei:lg>
          <tei:l>וְכָתוּב</tei:l>
          <tei:l>וַיְצַוֵּנוּ יְהוָה לַעֲשׂוֹת אֶת־כָּל־הַחֻקִּים הָאֵלֶּה</tei:l>
          <tei:l>לְיִרְאָה אֶת־יְהוָה אֱלֹהֵינוּ</tei:l>
          <tei:l>לְטוֹב לָנוּ כָּל־הַיָּמִים</tei:l>
          <tei:l>לְחַיֹּתֵנוּ כְּהַיּוֹם הַזֶּה׃ <tei:bibl>(דברים ו:כד)</tei:bibl></tei:l>
          <tei:l>וּצְדָקָה וּבְרָכָה</tei:l>
          <tei:l>וְרַחֲמִים וְחַיִּים וְשָׁלוֹם</tei:l>
          <tei:l>יִהְיֶה לָנוּ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
