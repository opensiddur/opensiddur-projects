    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:shir_hamaalot_for_a_woman_giving_birth_on_purim_mohr">
        <tei:head>שִׁיר הַמַּעֲלוֹת לַיּוֹלֶדֶת בַּפּוּרִים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:shir_hamaalot_for_a_woman_giving_birth_on_purim_mohr/1"/>
        <tei:lg>
          <tei:l>שִׁ֗יר לַֽמַּ֫עֲל֥וֹת</tei:l>
          <tei:l>אֶשָּׂ֣א עֵ֭ינַי אֶל־הֶעָרִ֑ים מֵ֝אַ֗יִן יָבֹ֥א יֵינִֽי׃</tei:l>
          <tei:l>יֵ֭ינִי מֵעִ֣ם אוּנְגַ֑ארְן גּ֖וֹי אֶחָ֣ד בָּאָֽרֶץ׃</tei:l>
          <tei:l>אַל־יִתֵּ֣ן לַעֲמ֣וֹד רַגְלֶ֑ךָ אַל־יָ֝נִ֗יף לְשׁוֹנֶֽךָ׃</tei:l>
          <tei:l>הִנֵּ֣ה לֹֽא־יָ֭נוּם וְלֹ֣א יִישָׁ֑ן שׁ֝וֹתֵ֗ה יִשְׂרָאֵֽל׃</tei:l>
          <tei:l>יַ֥יִן שֹׁמְרֶ֑ךָ יַ֥יִן צִ֝לְּךָ֗ עַל־יַ֥ד יְמִינֶֽךָ׃</tei:l>
          <tei:l>יוֹמָ֗ם הַיַּ֥יִן לֹֽא־יַעֲזְבֶ֗ךָּ וְהַדְּבַ֥שׁ בַּלָּֽיְלָה׃</tei:l>
          <tei:l>הַיַּ֗יִן יִשְׁמׇרְךָ֥ מִכׇּל־צָמָ֑א יִ֝סגֹ֗ר אֶת־עֵינֶ֑יךָ׃</tei:l>
          <tei:l>הַיַּ֗יִן יְמַלֵּא־פִ֥יךָ וּגְרוֹנֶ֑ךָ</tei:l>
          <tei:l>מֵ֝עַתָּ֗ה וְעַד־עוֹלָֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:shir_hamaalot_for_a_woman_giving_birth_on_purim_mohr/2"/>
        <tei:lg>
          <tei:l>טָאקֵֽייעֶר וְנֶֽעסְמִילֶר וְשַׁאמְפַּֽאנְיֶיר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:shir_hamaalot_for_a_woman_giving_birth_on_purim_mohr/3"/>
        <tei:lg>
          <tei:l>מַ֖יִם לֹ֥א תִשְׁתֶּֽה</tei:l>
          <tei:l>תִשְׁתֶּֽה לֹ֥א מַ֖יִם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:shir_hamaalot_for_a_woman_giving_birth_on_purim_mohr/4"/>
        <tei:lg>
          <tei:l>לֹ֥א מַ֖יִם תִשְׁתֶּֽה</tei:l>
          <tei:l>לֹ֥א תִשְׁתֶּֽה מַ֖יִם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:shir_hamaalot_for_a_woman_giving_birth_on_purim_mohr/5"/>
        <tei:lg>
          <tei:l>תִשְׁתֶּֽה מַ֖יִם לֹ֥א</tei:l>
          <tei:l>מַ֖יִם תִשְׁתֶּֽה לֹ֥א</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:shir_hamaalot_for_a_woman_giving_birth_on_purim_mohr/6"/>
        <tei:lg>
          <tei:l>תֶּרַח וַאֲמַּתְלַאי</tei:l>
          <tei:l>לוֹט וְעוֹרְבְתָּא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:shir_hamaalot_for_a_woman_giving_birth_on_purim_mohr/7"/>
        <tei:lg>
          <tei:l>נָבָל וַאֲבִיגַיִל</tei:l>
          <tei:l>בֵּלְשַׁצַּר וְשֵׁגָל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:shir_hamaalot_for_a_woman_giving_birth_on_purim_mohr/8"/>
        <tei:lg>
          <tei:l>וְזֶֽרֶשׁ וְכׇל־כַּת דִּילָהּ חוּץ!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
