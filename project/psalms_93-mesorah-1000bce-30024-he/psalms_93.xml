  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/93">
        <tei:head>תהלים צ״ג</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/93/1"/>
        <tei:lg>
          <tei:l>יהוה מָלָךְ</tei:l>
          <tei:l>גֵּאוּת לָבֵשׁ,</tei:l>
          <tei:l>לָבֵשׁ יהוה</tei:l>
          <tei:l>עֹז הִתְאַזָּר,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>אַף־תִּכּוֹן תֵּבֵל בַּל תִּמּוֹט׃</tei:l>
          <tei:l>נָכוֹן כִּסְאֲךָ מֵאָז,</tei:l>
          <tei:l>מֵעוֹלָם אָתָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/93/3/a"/>
        <tei:lg>
          <tei:l>נָשְׂאוּ נְהָרוֹת יהוה,</tei:l>
          <tei:l>נָשְׂאוּ נְהָרוֹת קוֹלָם,</tei:l>
          <tei:l>יִשְׂאוּ נְהָרוֹת דָּכְיָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/93/4/a"/>
        <tei:lg>
          <tei:l>מִקֹּלוֹת מַיִם רַבִּים,</tei:l>
          <tei:l>אַדִּירִים מִשְׁבְּרֵי־יָם,</tei:l>
          <tei:l>אַדִּיר בַּמָּרוֹם יהוה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/93/5/a"/>
        <tei:lg>
          <tei:l>עֵדֹתֶיךָ נֶאֶמְנוּ מְאֹד,</tei:l>
          <tei:l>לְבֵיתְךָ נָאֲוָה־קֹדֶשׁ,</tei:l>
          <tei:l>יהוה לְאֹרֶךְ יָמִים׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
