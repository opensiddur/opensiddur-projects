  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:azkira_yamim_im_yamim_hapayetan">
        <tei:head>אַזְכִּֽירָה יָמִים עִם יָמִים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkira_yamim_im_yamim_hapayetan/1"/>
        <tei:lg>
          <tei:l>אַזְכִּֽירָה יָמִים עִם יָמִים —</tei:l>
          <tei:l>יְמֵי יִרְמְיָֽהוּ עִם יְמֵי מֹשֶׁה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkira_yamim_im_yamim_hapayetan/2"/>
        <tei:lg>
          <tei:l>בִּימֵי מֹשֶׁה</tei:l>
          <tei:l><tei:seg type="acrostic">אָ</tei:seg>ז כְּנַֽעַר נֶאֱהָֽבוּ</tei:l>
          <tei:l>וּבִימֵי יִרְמְיָֽהוּ</tei:l>
          <tei:l>נִתְחַיְּיבוּ וְנֶאֱיָֽיבוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkira_yamim_im_yamim_hapayetan/3"/>
        <tei:lg>
          <tei:l>בִּימֵי מֹשֶׁה</tei:l>
          <tei:l><tei:seg type="acrostic">בָּ</tei:seg>טְלָה עַבְדוּת פָּֽרֶךְ</tei:l>
          <tei:l>וּבִימֵי יִרְמְיָֽהוּ</tei:l>
          <tei:l>בָּטְלָה עֲבוֹדַת עֵֽרֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkira_yamim_im_yamim_hapayetan/4"/>
        <tei:lg>
          <tei:l>בִּימֵי מֹשֶׁה</tei:l>
          <tei:l><tei:seg type="acrostic">גְּ</tei:seg>אוּלִים נִגְאָֽלוּ</tei:l>
          <tei:l>וּבִימֵי יִרְמְיָֽהוּ</tei:l>
          <tei:l>גְּעוּלִים גָּֽלוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkira_yamim_im_yamim_hapayetan/5"/>
        <tei:lg>
          <tei:l>בִּימֵי מֹשֶׁה</tei:l>
          <tei:l><tei:seg type="acrostic">דְּ</tei:seg>רוֹר חֵרוּת יָצָֽאוּ</tei:l>
          <tei:l>וּבִימֵי יִרְמְיָֽהוּ</tei:l>
          <tei:l>כַּעֲבָדִים כְּבוּלִים יָצָֽאוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkira_yamim_im_yamim_hapayetan/6"/>
        <tei:lg>
          <tei:l>בִּימֵי מֹשֶׁה</tei:l>
          <tei:l><tei:seg type="acrostic">הׇ</tei:seg>בְקְעוּ מֵי תְּהוֹמוֹת</tei:l>
          <tei:l>וּבִימֵי יִרְמְיָֽהוּ</tei:l>
          <tei:l>הׇבְקְעָה עִיר חוֹמוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkira_yamim_im_yamim_hapayetan/7"/>
        <tei:lg>
          <tei:l>בִּימֵי מֹשֶׁה</tei:l>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>עַל הַיָּם נָֽמוּ אָז יָשִׁיר</tei:l>
          <tei:l>וּבִימֵי יִרְמְיָֽהוּ</tei:l>
          <tei:l>וְעַל נְהָרוֹת נָֽמוּ אֵיךְ נָשִׁיר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkira_yamim_im_yamim_hapayetan/8"/>
        <tei:lg>
          <tei:l>בִּימֵי מֹשֶׁה</tei:l>
          <tei:l><tei:seg type="acrostic">זָֽ</tei:seg>בוּ מַֽיִם עַם עֵת צָמָא</tei:l>
          <tei:l>וּבִימֵי יִרְמְיָֽהוּ</tei:l>
          <tei:l>יָבֵשׁ חִכָּם בַּצָּמָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkira_yamim_im_yamim_hapayetan/9"/>
        <tei:lg>
          <tei:l>בִּימֵי מֹשֶׁה</tei:l>
          <tei:l><tei:seg type="acrostic">חַ</tei:seg>שְׁרַת מָן וּבָשָׂר אָכָֽלוּ</tei:l>
          <tei:l>וּבִימֵי יִרְמְיָֽהוּ</tei:l>
          <tei:l>מִבְּשַׂר בְּנֵיהֶם אָכָֽלוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkira_yamim_im_yamim_hapayetan/10"/>
        <tei:lg>
          <tei:l>בִּימֵי מֹשֶׁה</tei:l>
          <tei:l><tei:seg type="acrostic">טַֽ</tei:seg>עַם כֹּל רָווּ וְשָׂבֵֽעוּ</tei:l>
          <tei:l>וּבִימֵי יִרְמְיָֽהוּ</tei:l>
          <tei:l>לַעֲנָה רָווּ וּמְרוֹרִים שָׂבֵֽעוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkira_yamim_im_yamim_hapayetan/11"/>
        <tei:lg>
          <tei:l>בִּימֵי מֹשֶׁה</tei:l>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>ד הַגְּדוֹלָה רָאוּ</tei:l>
          <tei:l>וּבִימֵי יִרְמְיָֽהוּ</tei:l>
          <tei:l>יָדוֹ פָּרַשׂ צַר וַיִּירָאוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkira_yamim_im_yamim_hapayetan/12"/>
        <tei:lg>
          <tei:l>בִּימֵי מֹשֶׁה</tei:l>
          <tei:l><tei:seg type="acrostic">כְּ</tei:seg>כַלָּה כְּבוּדָה הָיוּ</tei:l>
          <tei:l>וּבִימֵי יִרְמְיָֽהוּ</tei:l>
          <tei:l>כְּאִשָּׁה גְּרוּשָׁה הָיוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkira_yamim_im_yamim_hapayetan/13"/>
        <tei:lg>
          <tei:l>בִּימֵי מֹשֶׁה</tei:l>
          <tei:l><tei:seg type="acrostic">לִ</tei:seg>פְנֵיהֶם הִלַּֽכְתָּ</tei:l>
          <tei:l>וּבִימֵי יִרְמְיָֽהוּ</tei:l>
          <tei:l>מִפְּנֵיהֶם הָלָֽכְתָּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkira_yamim_im_yamim_hapayetan/14"/>
        <tei:lg>
          <tei:l>בִּימֵי מֹשֶׁה</tei:l>
          <tei:l><tei:seg type="acrostic">מָ</tei:seg>ה יָּפוּ וּמָה נָּעֵֽמוּ</tei:l>
          <tei:l>וּבִימֵי יִרְמְיָֽהוּ</tei:l>
          <tei:l>מָה עֻזְּבוּ וּמָה הֻכְאָֽרוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkira_yamim_im_yamim_hapayetan/15"/>
        <tei:lg>
          <tei:l>בִּימֵי מֹשֶׁה</tei:l>
          <tei:l><tei:seg type="acrostic">נָֽ</tei:seg>מוּ נַעֲשֶׂה וְנִשְׁמַע</tei:l>
          <tei:l>וּבִימֵי יִרְמְיָֽהוּ</tei:l>
          <tei:l>נַעֲשׂוּ כְּחֵרֵשׁ לֹא שׁוֹמֵֽעַ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkira_yamim_im_yamim_hapayetan/16"/>
        <tei:lg>
          <tei:l>בִּימֵי מֹשֶׁה</tei:l>
          <tei:l><tei:seg type="acrostic">סֻ</tei:seg>בְּלוּ עַל עֲנָנִים</tei:l>
          <tei:l>וּבִימֵי יִרְמְיָֽהוּ</tei:l>
          <tei:l>שֹׂנְאֵיהֶם עָלוּ כַּעֲנָנִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkira_yamim_im_yamim_hapayetan/17"/>
        <tei:lg>
          <tei:l>בִּימֵי מֹשֶׁה</tei:l>
          <tei:l><tei:seg type="acrostic">עָ</tei:seg>לוּ עַל נְשָׁרִים</tei:l>
          <tei:l>וּבִימֵי יִרְמְיָֽהוּ</tei:l>
          <tei:l>רֹדְפֵיהֶם קַלּוּ מִנְּשָׁרִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkira_yamim_im_yamim_hapayetan/18"/>
        <tei:lg>
          <tei:l>בִּימֵי מֹשֶׁה</tei:l>
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>דִיתָם וּקְנִיתָם</tei:l>
          <tei:l>וּבִימֵי יִרְמְיָֽהוּ</tei:l>
          <tei:l>אָנַֽפְתָּ וְהִקְנֵאתָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkira_yamim_im_yamim_hapayetan/19"/>
        <tei:lg>
          <tei:l>בִּימֵי מֹשֶׁה</tei:l>
          <tei:l><tei:seg type="acrostic">צְ</tei:seg>נִיפֵֽימוֹ לֹא בָֽלוּ</tei:l>
          <tei:l>וּבִימֵי יִרְמְיָֽהוּ</tei:l>
          <tei:l>צָפְדוּ וְנִתְכַּֽלּוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkira_yamim_im_yamim_hapayetan/20"/>
        <tei:lg>
          <tei:l>בִּימֵי מֹשֶׁה</tei:l>
          <tei:l><tei:seg type="acrostic">קְ</tei:seg>רָאתָם בָּנִים וְאַתָּה לָֽמוֹ אָב</tei:l>
          <tei:l>וּבִימֵי יִרְמְיָֽהוּ</tei:l>
          <tei:l>יְתוֹמִים הָיִֽינוּ אֵין אָב׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkira_yamim_im_yamim_hapayetan/21"/>
        <tei:lg>
          <tei:l>בִּימֵי מֹשֶׁה</tei:l>
          <tei:l><tei:seg type="acrostic">רְ</tei:seg>עִיתָם בְּבִטְחָה כְּצֹאן</tei:l>
          <tei:l>וּבִימֵי יִרְמְיָֽהוּ</tei:l>
          <tei:l>נְתַתָּם לְטִבְחָה כְּמוֹ צֹאן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkira_yamim_im_yamim_hapayetan/22"/>
        <tei:lg>
          <tei:l>בִּימֵי מֹשֶׁה</tei:l>
          <tei:l><tei:seg type="acrostic">שֻׁ</tei:seg>כְּנוּ בִּצְבִי אָֽרֶץ</tei:l>
          <tei:l>וּבִימֵי יִרְמְיָֽהוּ</tei:l>
          <tei:l>נִגְזַר עֲלֵיהֶם שֶׁלֹּא יִכָּנְסוּ לָאָֽרֶץ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkira_yamim_im_yamim_hapayetan/23"/>
        <tei:lg>
          <tei:l>בִּימֵי מֹשֶׁה</tei:l>
          <tei:l><tei:seg type="acrostic">תׇּ</tei:seg>קְפוּ מִכׇּל גּוֹי</tei:l>
          <tei:l>וּבִימֵי יִרְמְיָֽהוּ</tei:l>
          <tei:l>תֻּעְתְּעוּ בְּכׇל גּוֹי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkira_yamim_im_yamim_hapayetan/24"/>
        <tei:lg>
          <tei:l>נָשִׁינוּ טוֹבָה</tei:l>
          <tei:l>מֵרֹב רָעָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkira_yamim_im_yamim_hapayetan/25"/>
        <tei:lg>
          <tei:l>שָׁמַעְנוּ רָעוֹת</tei:l>
          <tei:l>הַשְׁמִיעֵנוּ טוֹבוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkira_yamim_im_yamim_hapayetan/26"/>
        <tei:lg>
          <tei:l>בָּאוּ רִאשׁוֹנוֹת</tei:l>
          <tei:l>יִצְמְחוּ חֲדָשׁוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkira_yamim_im_yamim_hapayetan/27"/>
        <tei:lg>
          <tei:l>רִאשׁוֹן וְאַחֲרוֹן</tei:l>
          <tei:l>תַּשְׁמִיעֵ[נוּ בְּזִכָּרוֹן]׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkira_yamim_im_yamim_hapayetan/28"/>
        <tei:lg>
          <tei:l>אֲנִי לָרִאשׁוֹנִים</tei:l>
          <tei:l>וַאֲנִי לָאַחֲרוֹנִים</tei:l>
          <tei:l>לִהְי֥וֹת לָכֶ֖ם לֵאלֹהִ֑ים...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>