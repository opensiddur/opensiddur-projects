    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:tigdal_mazor">
        <tei:head>תִּגְדַּל</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tigdal_mazor/1"/>
        <tei:lg>
          <tei:l>תִּגְדַּל שְׁכִינַת עוֹלָם וּנְשַׁבְּחָהּ,</tei:l>
          <tei:l>בַּכֹּל וְאֵין מָקוֹם פָּנוּי מִשְּׁכִינָתָהּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tigdal_mazor/2"/>
        <tei:lg>
          <tei:l>אַחַת וְכָל יָחִיד כָּלוּל בְּיִחוּדָהּ,</tei:l>
          <tei:l>נֶעְלָמָה וְאֵין קָצֶה לְאַחְדוּתָהּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tigdal_mazor/3"/>
        <tei:lg>
          <tei:l>לֹא גּוּף וְלֹא פָּנִים לְדַמּוֹתָהּ,</tei:l>
          <tei:l>וְעֵרֵֶך מֵעַל כֹּל לִקְדֻשָּׁתָהּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tigdal_mazor/4"/>
        <tei:lg>
          <tei:l>קְדוּמָה לְכָל אֲשֶׁר בִּיצִירָתָהּ,</tei:l>
          <tei:l>רֵאשִׁית וְאֵין תְּחִלָּה לְרֵאשִׁיתָהּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tigdal_mazor/5"/>
        <tei:lg>
          <tei:l>עוֹלָם וַאֲשֶׁר בּוֹ בָּבַת עֵינָהּ,</tei:l>
          <tei:l>אוֹרָהּ מֵאִיר גְּדֻלָּתָהּ וּמַלְכוּתָהּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tigdal_mazor/6"/>
        <tei:lg>
          <tei:l>שְׁפִיעַת נְבוּאָתָהּ הֶעֱנִיקָה,</tei:l>
          <tei:l>לְכָל אֲשֶׁר הֵם סְגֻלָּתָהּ וְתִפְאַרְתָּהּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tigdal_mazor/7"/>
        <tei:lg>
          <tei:l>רוֹעֶה אֲשֶׁר סִבְלוֹת אֶחָיו רָאָה,</tei:l>
          <tei:l>הִבִּיט בְּאַסְפַּקְלְַריָה מְאִירָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tigdal_mazor/8"/>
        <tei:lg>
          <tei:l>תּוֹרַת אֱמֶת נָתְנָה לְיִשְׂרָאֵל עַמָּהּ,</tei:l>
          <tei:l>נוֹבַעַת הִיא לְכָל אֲשֶׁר בְּעוֹלָמָהּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tigdal_mazor/9"/>
        <tei:lg>
          <tei:l>לֹא נַחְלִיפָהּ וְלֹא נָמִיר דַּרְכָּהּ,</tei:l>
          <tei:l>וּנְבַקֵּשׁ פָּנֶיהָ וְקִרְבָתָהּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tigdal_mazor/10"/>
        <tei:lg>
          <tei:l>צוֹפָה וּמְבִינָה כָּל סֵתֶר וּסְתִירָה,</tei:l>
          <tei:l>וּמְלַוָּה מִקֶּדֶם בְּאַהֲבָתָהּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tigdal_mazor/11"/>
        <tei:lg>
          <tei:l>לְכָל אִשָּׁה וָאִישׁ גּוֹמֶלֶת בְּחַסְדָּהּ,</tei:l>
          <tei:l>וּבְטוּבָהּ צִוְּתָה לָנוּ ”וּבָחַרְתָּ.“</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tigdal_mazor/12"/>
        <tei:lg>
          <tei:l>עוֹד לֹא אָבְדָה תִּקְוָה לַגְּאֻלָּה,</tei:l>
          <tei:l>לִפְדוּת כָּל הַמְּחַכִּים לִישׁוּעָתָהּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tigdal_mazor/13"/>
        <tei:lg>
          <tei:l>נִשְׁמַת כָּל חַי בְּחֶסֶד בִּרְכָתָהּ,</tei:l>
          <tei:l>וּנְבָרֵךְ עֲדֵי עַד שְׁמָהּ וּתְהִלָּתָהּ.</tei:l>
        </tei:lg>
      </tei:div>
