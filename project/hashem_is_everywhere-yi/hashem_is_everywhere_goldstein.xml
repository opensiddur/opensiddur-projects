  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:hashem_is_everywhere_goldstein">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hashem_is_everywhere_goldstein/2"/>
        <tei:lg>
          <tei:l>ה׳ איז דא</tei:l>
          <tei:l>ה׳ איז דארט</tei:l>
          <tei:l>ה׳ איז באמת אומעטום</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hashem_is_everywhere_goldstein/3"/>
        <tei:lg>
          <tei:l>אױבּן אױבּן</tei:l>
          <tei:l>אונטן אונטן</tei:l>
          <tei:l>רעכט לינקס</tei:l>
          <tei:l>און אין אַלע ערטער</tei:l>
          <tei:l>דאָ, דאָרט און אומעטום</tei:l>
          <tei:l>ס׳איז װוּ מ׳קען ה׳ געפינען.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
