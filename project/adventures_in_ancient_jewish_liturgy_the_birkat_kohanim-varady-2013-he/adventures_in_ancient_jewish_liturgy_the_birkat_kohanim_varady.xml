  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:adventures_in_ancient_jewish_liturgy_the_birkat_kohanim_varady">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:adventures_in_ancient_jewish_liturgy_the_birkat_kohanim_varady/1"/>
        <tei:lg>
          <tei:l>6 <tei:hi rend="superscript">כב</tei:hi> וַיְדַבֵּר יְהוָה אֶל מֹשֶׁה לֵּאמֹר׃</tei:l>
          <tei:l><tei:hi rend="superscript">כג</tei:hi> דַּבֵּר אֶל אַהֲרֹן וְאֶל בָּנָיו לֵאמֹר כֹּה תְבָרֲכוּ אֶת בְּנֵי יִשְׂרָאֵל אָמוֹר לָהֶם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:adventures_in_ancient_jewish_liturgy_the_birkat_kohanim_varady/2"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">כד</tei:hi> יְבָרֶכְךָ יְהוָה וְיִשְׁמְרֶךָ׃</tei:l>
          <tei:l><tei:hi rend="superscript">כה</tei:hi> יָאֵר יְהוָה פָּנָיו אֵלֶיךָ וִיחֻנֶּךָּ׃</tei:l>
          <tei:l><tei:hi rend="superscript">כו</tei:hi> יִשָּׂא יְהוָה פָּנָיו אֵלֶיךָ וְיָשֵׂם לְךָ שָׁלוֹם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:adventures_in_ancient_jewish_liturgy_the_birkat_kohanim_varady/3"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">כז</tei:hi> וְשָׂמוּ אֶת שְׁמִי עַל בְּנֵי יִשְׂרָאֵל וַאֲנִי אֲבָרֲכֵם׃</tei:l>
        </tei:lg>
      </tei:div>
