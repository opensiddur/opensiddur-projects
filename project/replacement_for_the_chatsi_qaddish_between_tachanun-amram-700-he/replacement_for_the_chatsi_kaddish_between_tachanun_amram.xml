    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:replacement_for_the_chatsi_kaddish_between_tachanun_amram">
        <tei:head>תשלום לחצי קדיש בין תחנון לאשרי ליחיד (סדר רב עמרם)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:replacement_for_the_chatsi_kaddish_between_tachanun_amram/1"/>
        <tei:lg>
          <tei:l>מַאי דִּכְתִיב</tei:l>
          <tei:l>בְּרׇב־עָ֥ם הַדְרַת־מֶ֑לֶךְ <tei:bibl>(משלי יד:כח)</tei:bibl>?</tei:l>
          <tei:l>אָמַר רַבִּי חָמָא בַּר־חֲנִינָא בּוֹא וּרְאֵה</tei:l>
          <tei:l>שִׁבְחוֹ שֶׁלַּקָּדוֹשׁ בָּרוּךְ הוּא</tei:l>
          <tei:l>שֶׁהוּא מְחַבֵּב אֶת־יִשְׂרָאֵל</tei:l>
          <tei:l>יוֹתֵר מֵאַלְפֵי אֲלָפִים וְרִבֵי רְבָבוֹת</tei:l>
          <tei:l>שֶׁלְּמַלְאֲכֵי הַשָּׁרֵת שֶׁמְּשָׁרְתִין אוֹתוֹ</tei:l>
          <tei:l>וּמְשַׁבְּחִין לְפָנָיו</tei:l>
          <tei:l>וְאֵינוֹ רוֹצֶה בִּשְׁבָחָן</tei:l>
          <tei:l>עַד־שֶׁיִּשְׁמַע בִּשְׁבָחָן שֶׁלְּיִשְׂרָאֵל</tei:l>
          <tei:l>שֶׁנֶּאֱמַר בְּרׇב־עָ֥ם הַדְרַת־מֶ֑לֶךְ</tei:l>
          <tei:l>וְאֵין עַם אֶֽלָּא יִשְׂרָאֵל</tei:l>
          <tei:l>שֶׁנֶּאֱמַר עַם־זוּ֙ יָצַ֣רְתִּי לִ֔י</tei:l>
          <tei:l>תְּהִלָּתִ֖י יְסַפֵּֽרוּ׃ <tei:bibl>(ישעיה מג:כא)</tei:bibl></tei:l>
          <tei:l>לָמָּה עַם־זוּ֙ יָצַ֣רְתִּי לִ֔י?</tei:l>
          <tei:l>שֶׁיְּסַפֵּרוּ תְּהִלָּתִי בַּעוֹלָם</tei:l>
          <tei:l>שֶׁנֶּאֱמַר תְּהִלָּתִ֖י יְסַפֵּֽרוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:replacement_for_the_chatsi_kaddish_between_tachanun_amram/2"/>
        <tei:lg>
          <tei:l>וְכֵן הוּא אוֹמֵר</tei:l>
          <tei:l>נְדִ֘יבֵ֤י עַמִּ֨ים ׀ נֶאֱסָ֗פוּ</tei:l>
          <tei:l>עַם֮ אֱלֹהֵ֢י אַבְרָ֫הָ֥ם</tei:l>
          <tei:l>כִּ֣י לֵ֭אלֹהִים מָֽגִנֵּי־אֶ֗רֶץ מְאֹ֣ד נַעֲלָֽה׃ <tei:bibl>(תהלים מז:י)</tei:bibl></tei:l>
          <tei:l>אָמַר רַבִּי סִימוֹן,</tei:l>
          <tei:l>אֵימָתַי הַקָּדוֹשׁ בָּרוּךְ הוּא מִתְעַלֶּה בְּעוֹלָמוֹ?</tei:l>
          <tei:l>בַּשָּׁעָה שֶׁיִּשְׂרָאֵל נִכְנָסִין בְּבָתֵּי מִדְרָשׁוֹת וּבְבָתֵּי כְּנֵסִיּוֹת</tei:l>
          <tei:l>וְנוֹתְנִין שֶֽׁבַח לִפְנֵי בּוֹרְאָם!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:replacement_for_the_chatsi_kaddish_between_tachanun_amram/3"/>
        <tei:lg>
          <tei:l>רַבִּי יִשְׁמָעֵאל אוֹמֵר</tei:l>
          <tei:l>בְּשָׁעָה שֶׁהֵן נֶאֱסָפִין לְבָתֵּי כְּנֵסִיּוֹת וּלְבָתֵּי מִדְרָשׁוֹת</tei:l>
          <tei:l>וְשׁוֹמְעִין הַגָּדָה מִפִּי תַּלְמִיד נָעִים</tei:l>
          <tei:l>וְאַחַר כָּךְ עוֹנִין</tei:l>
          <tei:l>אָמֵן יְהֵא שְׁמֵהּ רַבָּא מְבָרַךְ לְעָלַם</tei:l>
          <tei:l>וּלְעַלְמֵי עָלְמַיָּא, יִתְבָּרַךְ</tei:l>
          <tei:l>בְּאוֹתָהּ שָׁעָה הַקָּדוֹשׁ בָּרוּךְ הוּא מְשַׂמֵּֽחַ</tei:l>
          <tei:l>וּמִתְעַלֶּה בְּעוֹלָמוֹ</tei:l>
          <tei:l>וְאוֹמֵר לְמַלְאֲכֵי הַשָּׁרֵת,</tei:l>
          <tei:l>בֹּאוּ וּרְאוּ עַם־זוּ שֶׁיָּצַרְתִּי בְּעוֹלָמִי</tei:l>
          <tei:l>כַּמָּה הֵן מְשַׁבְּחִין אוֹתִי!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:replacement_for_the_chatsi_kaddish_between_tachanun_amram/4"/>
        <tei:lg>
          <tei:l>בְּאוֹתָהּ שָׁעָה מִתְקַבְּצִין מַלְאֲכֵי הַשָּׁרֵת</tei:l>
          <tei:l>וּמַלְבִּישִׁין לַקָּדוֹשׁ בָּרוּךְ הוּא הוֹד וְהָדָר</tei:l>
          <tei:l>שֶׁנֶּאֱמַר בְּרׇב־עָ֥ם הַדְרַת־מֶ֑לֶךְ׃</tei:l>
          <tei:l>וְכֵן הוּא אוֹמֵר</tei:l>
          <tei:l>בָּרְכִ֥י נַפְשִׁ֗י אֶת־יְ֫הֹוָ֥ה</tei:l>
          <tei:l>יְהֹוָ֣ה אֱ֭לֹהַי גָּדַ֣לְתָּ מְּאֹ֑ד</tei:l>
          <tei:l>ה֖וֹד וְהָדָ֣ר לָבָֽשְׁתָּ׃</tei:l>
          <tei:l>וּכְתִיב ה֤וֹד וְהָדָר֙ לְפָנָ֔יו</tei:l>
          <tei:l>עֹ֥ז וְחֶדְוָ֖ה בִּמְקֹמֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:replacement_for_the_chatsi_kaddish_between_tachanun_amram/5"/>
        <tei:lg>
          <tei:l>וְאוֹמֵר עֵ֣קֶב עֲ֭נָוָה</tei:l>
          <tei:l>יִרְאַ֣ת יְהֹוָ֑ה</tei:l>
          <tei:l>עֹ֖שֶׁר וְכָב֣וֹד וְחַיִּֽים׃ <tei:bibl>(משלי כב:ד)</tei:bibl></tei:l>
          <tei:l>וְאָמַר רַב חָנִן</tei:l>
          <tei:l>אִם אָדָם זוֹכֶה לִקְנוֹת עֲנָוָה וְיִרְאַת יְהֹוָה</tei:l>
          <tei:l>זוֹכֶה לִקְנוֹת כָּבוֹד וְחַיִּים</tei:l>
          <tei:l>שֶׁנֶּאֱמַר ”עֵ֣קֶב עֲ֭נָוָה“ וכו׳ <tei:bibl>(מדרש משלי כב:ב)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
