      <tei:div corresp="urn:x-opensiddur:text:prayer:earth_pledge_wolfman_dawn">
        <tei:head>Earth Pledge, by Carol T. Gaddy and Marianne Wolfman-Dawn (25 April 1981)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:earth_pledge_wolfman_dawn/1"/>
        <tei:lg>
          <tei:l>We pledge allegiance to the Earth</tei:l>
          <tei:l>And to the life which she provides</tei:l>
          <tei:l>One planet</tei:l>
          <tei:l>Interconnected</tei:l>
          <tei:l>With beauty and peace for all.</tei:l>
        </tei:lg>
      </tei:div>
