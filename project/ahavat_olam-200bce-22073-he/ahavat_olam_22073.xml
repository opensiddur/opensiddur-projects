  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:ahavat_olam_22073">
        <tei:head>בִּרְכָּת אַהֲבַה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ahavat_olam_22073/1"/>
        <tei:lg>
          <tei:l>אַהֲבַת עוֹלָם בֵּית יִשְׂרָאֵל</tei:l>
          <tei:l>עַמְּךָ אָהַבְתָּ,</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>תּוֹרָה וּמִצְוֺת חֻקִּים וּמִשְׁפָּטִים</tei:l>
          <tei:l>אוֹתָנוּ לִמַּדְתָּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ahavat_olam_22073/2"/>
        <tei:lg>
          <tei:l>עַל כֵּן יְהֹוָה אֱלֹהֵינוּ,</tei:l>
          <tei:l>בְּשָׁכְבֵנוּ</tei:l>
          <tei:l>וּבְקוּמֵנוּ</tei:l>
          <tei:l>נָשִׂיחַ בְּחֻקֶּיךָ,</tei:l>
          <tei:l>וְנִשְׂמַח</tei:l>
          <tei:l>בְּדִבְרֵי</tei:l>
          <tei:l>תַלְמוּד תּוֹרָתֶךָ,</tei:l>
          <tei:l>וּבְמִצְוֺתֶיךָ לְעוֹלָם וָעֶד,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ahavat_olam_22073/3"/>
        <tei:lg>
          <tei:l>כִּי הֵם חַיֵּינוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ahavat_olam_22073/4"/>
        <tei:lg>
          <tei:l>וְאֹרֶךְ יָמֵינוּ,</tei:l>
          <tei:l>וּבָהֶם נֶהְגֶּה יוֹמָם וָלָיְלָה.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְאַהֲבָתְךָ אַל תָסוּר מִמֶּנּוּ לְעוֹלָמִים,</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה,</tei:l>
          <tei:l>אוֹהֵב עַמּוֹ יִשְׂרָאֵל:</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
