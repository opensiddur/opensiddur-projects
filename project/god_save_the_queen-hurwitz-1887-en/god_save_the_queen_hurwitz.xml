  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:god_save_the_queen_hurwitz">
        <tei:head>God Save the Queen, an adaptation of Hyman Hurwitz's Hebrew translation of "God Save the King" for Queen Victoria's Jubilee Celebration (1887)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:god_save_the_queen_hurwitz/1"/>
        <tei:lg>
          <tei:l>God save our gracious Queen,</tei:l>
          <tei:l>Long live our noble Queen,</tei:l>
          <tei:l>God save the Queen!</tei:l>
          <tei:l>Send her victorious,</tei:l>
          <tei:l>Happy and glorious,</tei:l>
          <tei:l>Long to reign over us,</tei:l>
          <tei:l>God save the Queen!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:god_save_the_queen_hurwitz/2"/>
        <tei:lg>
          <tei:l>O Lord our God, arise,</tei:l>
          <tei:l>Scatter her enemies,<tei:anchor xml:id="note_1"/></tei:l>
          <tei:l>And make them fall</tei:l>
          <tei:l>Confound their politics,</tei:l>
          <tei:l>Frustrate their knavish tricks,</tei:l>
          <tei:l>On her our hearts are fixed,</tei:l>
          <tei:l>O save us all.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:god_save_the_queen_hurwitz/3"/>
        <tei:lg>
          <tei:l>Thy choicest gifts in store</tei:l>
          <tei:l>On her be pleased to pour,</tei:l>
          <tei:l>Long may she reign!</tei:l>
          <tei:l>May she defend our laws,</tei:l>
          <tei:l>And ever give us cause</tei:l>
          <tei:l>To sing with heart and voice,</tei:l>
          <tei:l>God save the Queen!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
