  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/117">
        <tei:head>תהלים קי״ז</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/117/1/a"/>
        <tei:lg>
          <tei:l>הַֽלְל֣וּ אֶת־יְ֭הוָה כָּל־גּוֹיִ֑ם</tei:l>
          <tei:l>שַׁ֝בְּח֗וּהוּ כָּל־הָאֻמִּֽים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/117/2"/>
        <tei:lg>
          <tei:l>כִּ֥י גָ֘בַ֤ר עָלֵ֨ינוּ ׀ חַסְדּ֗וֹ</tei:l>
          <tei:l>וֶֽאֱמֶת־יְהוָ֥ה לְעוֹלָ֗ם</tei:l>
          <tei:l>הַֽלְלוּ־יָֽהּ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
