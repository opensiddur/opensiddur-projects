  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:azalat_bekhita">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azalat_bekhita/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אֲ</tei:seg>זַלַת בְּכִיתָא בְּכׇל־מְדִינְתָּא</tei:l>
          <tei:l>בְּשַׁעֲתָא דְּאִתְפַּטַר מֹשֶׁה נְבִיָּיא</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>כָא יָתֵיהּ נִילוּס נַהֲרָא</tei:l>
          <tei:l>גַּבְרָא דְּרַבִּיתִי מִן־טַלְיוּתָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azalat_bekhita/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">גָּ</tei:seg>עַן וּבָכַן כׇּל־שִׁבְטַיָּא דְּיִשְׂרָאֵל</tei:l>
          <tei:l>כְּעָנָא בְּמַדְבְּרָא דְּלֵית לְהוֹן רַעֲיָא</tei:l>
          <tei:l><tei:seg type="acrostic">דִּ</tei:seg>מְעָא שָׁפְכִין בֵּית יִשְׂרָאֵל וְאָמְרִין</tei:l>
          <tei:l>מָאן יְהַב לַנָא גַּבְרָא כְּוָותֵיהּ דְּמֹשֶׁה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azalat_bekhita/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הַ</tei:seg>ר טוּרָא דְּתָבוֹר וכַרְמֶל שָׁפְכִין בְּבִכְיָיא</tei:l>
          <tei:l>וְסִינַי מַסְפֵּד בֵּין־תַּרְוֵיהוֹן</tei:l>
          <tei:l><tei:seg type="acrostic">וַ</tei:seg>וי עֲלַי אֲמַרַת אוֹרַייתָא</tei:l>
          <tei:l>רַעֲיָא טָבָא דְּאִתְפְּרִיק מִינִּי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azalat_bekhita/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זַ</tei:seg>ע וְאִתְבְּהַל יְהוֹשֻׁעַ בִּן־נוּן</tei:l>
          <tei:l>כְּיוֹנֵק דְּמִתְגְּמִיל מִדַּדֵי אִימֵּיהּ</tei:l>
          <tei:l><tei:seg type="acrostic">חֲ</tei:seg>בַל עֲלַי אֲמַרַת אוֹרַייתָא</tei:l>
          <tei:l>וּמֹשֶׁה יְהַב לִי חַיִּים לְעָלַם</tei:l>
        </tei:lg>
      </tei:div>
