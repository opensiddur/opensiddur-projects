    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ki_eshmerah_shabbat_ezra">
        <tei:head>כִּי אֶשְׁמְרָה שַׁבָּת</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ki_eshmerah_shabbat_ezra/1"/>
        <tei:lg>
          <tei:l>כִּי אֶשְׁמְרָה שַׁבָּת</tei:l>
          <tei:l>אֵל יִשְׁמְרֵֽנִי,</tei:l>
          <tei:l>אוֹת הִיא לְעֽוֹלְמֵי עַד</tei:l>
          <tei:l>בֵּינוֹ וּבֵינִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ki_eshmerah_shabbat_ezra/2"/>
        <tei:lg>
          <tei:l>אָסוּר מְצֹא חֵֽפֶץ מֵֽעֲשׂוֹת דְּרָכִים,</tei:l>
          <tei:l>גַּם מִלְּדַבֶּר בּוֹ דִּבְרֵי צְרָכִים,</tei:l>
          <tei:l>דִּבְרֵי סְחוֹרָה אַף דִּבְרֵי מְלָכִים,</tei:l>
          <tei:l>אֶהְגֶּה בְּתֽוֹרַת אֵל וּתְחַכְּמֵֽנִי׃</tei:l>
          <tei:l>כִּי אֶשְׁמְרָה שַׁבָּת וכו׳</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ki_eshmerah_shabbat_ezra/3"/>
        <tei:lg>
          <tei:l>בּוֹ אֶמְצָא תָמִיד נֹֽפֶשׁ לְנַפְשִׁי,</tei:l>
          <tei:l>הִנֵּה לְדוֹר רִאשׁוֹן נָתַן קְדוֹשִׁי</tei:l>
          <tei:l>מוֹפֵת בְּתֵת לֶֽחֶם מִשְׁנֶה בַּשִּׁשִּׁי,</tei:l>
          <tei:l>כָּֽכָה בְּכָל שִׁשִּׁי יַכְפִּיל מְזוֹנִי׃</tei:l>
          <tei:l>כִּי אֶשְׁמְרָה שַׁבָּת וכו׳</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ki_eshmerah_shabbat_ezra/4"/>
        <tei:lg>
          <tei:l>רָשַׁם בְּדַת הָאֵל חֹק אֶל־סְגָנָיו</tei:l>
          <tei:l>בּוֹ לַעֲרֹךְ לֶֽחֶם פָּנִים בְּפָנָיו,</tei:l>
          <tei:l>גַּם בּוֹ לְהִתְעַנּוֹת בּוֹ עַל פִּי נְבוֹנָיו</tei:l>
          <tei:l>אָסוּר לְבַד מִיּוֹם כִּפּוּר עֲוֹנִי׃</tei:l>
          <tei:l>כִּי אֶשְׁמְרָה שַׁבָּת וכו׳</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ki_eshmerah_shabbat_ezra/5"/>
        <tei:lg>
          <tei:l>הוּא יוֹם מְכֻבָּד הוּא יוֹם תַּעֲנוּגִים,</tei:l>
          <tei:l>לֶֽחֶם וְיַֽיִן טוֹב בָּשָׂר וְדָגִים</tei:l>
          <tei:l>מִתְאַבְּלִים בּוֹ אָחוֹר נְסוּגִים,</tei:l>
          <tei:l>כִּי יוֹם שְׂמָחוֹת הוּא וַיְשַׂמְּחֵֽנִי׃</tei:l>
          <tei:l>כִּי אֶשְׁמְרָה שַׁבָּת וכו׳</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ki_eshmerah_shabbat_ezra/6"/>
        <tei:lg>
          <tei:l>מֵחֵל מְלָאכָה בּוֹ סוֹפוֹ לְהַכְרִית,</tei:l>
          <tei:l>עַל כֵּן אֲכַבֶּס בּוֹ לִבִּי כְּבֹרִית,</tei:l>
          <tei:l>אֶתְפַּלְּלָה אֶל־אֵל עַרְבִית וְשַׁחֲרִית,</tei:l>
          <tei:l>מוּסַף וְגַם מִנְחָה הוּא יַעֲנֵֽנִי׃</tei:l>
          <tei:l>כִּי אֶשְׁמְרָה שַׁבָּת וכו׳</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
