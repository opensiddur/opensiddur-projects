  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_mini_selichot_creditor">
        <tei:head>A Mini-Seliḥot, by Rabbi Menachem Creditor</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_mini_selichot_creditor/1"/>
        <tei:lg>
          <tei:l>God,</tei:l>
          <tei:l>forgive us,</tei:l>
          <tei:l>but please help us surpass the pre-written stuff.</tei:l>
          <tei:l>Remind us to believe in our own living hearts and mouths and souls.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_mini_selichot_creditor/2"/>
        <tei:lg>
          <tei:l>Hear us when we speak.</tei:l>
          <tei:l>Comfort us when we cry.</tei:l>
          <tei:l>Guide us when we stray.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_mini_selichot_creditor/3"/>
        <tei:lg>
          <tei:l>God, please forgive us</tei:l>
          <tei:l>for the things we did wrong</tei:l>
          <tei:l>and were brave enough to name,</tei:l>
          <tei:l>strong enough to own,</tei:l>
          <tei:l>and hopeful enough to see past.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_mini_selichot_creditor/4"/>
        <tei:lg>
          <tei:l>May the coming year find us ready</tei:l>
          <tei:l>to be our full size,</tei:l>
          <tei:l>strong and brave and hopeful,</tei:l>
          <tei:l>alive and healthy and safe.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_mini_selichot_creditor/5"/>
        <tei:lg>
          <tei:l>May the coming year be a good one.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_mini_selichot_creditor/6"/>
        <tei:lg>
          <tei:l>For everyone, Dear God, for everyone.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_mini_selichot_creditor/7"/>
        <tei:lg>
          <tei:l><tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
      </tei:div>
