    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/93">
        <tei:head>תהלים צ״ג</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/93/1-5"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">א</tei:hi> יְהוָ֣ה מָלָךְ֮ גֵּא֪וּת לָ֫בֵ֥שׁ</tei:l>
          <tei:l>לָבֵ֣שׁ יְ֭הוָה</tei:l>
          <tei:l>עֹ֣ז הִתְאַזָּ֑ר</tei:l>
          <tei:l>אַף־תִּכּ֥וֹן תֵּ֝בֵ֗ל</tei:l>
          <tei:l>בַּל־תִּמּֽוֹט׃</tei:l>
          <tei:l><tei:hi rend="superscript">ב</tei:hi> נָכ֣וֹן</tei:l>
          <tei:l>כִּסְאֲךָ֣</tei:l>
          <tei:l>מֵאָ֑ז</tei:l>
          <tei:l>מֵֽעוֹלָ֣ם אָֽתָּה׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ג</tei:hi> נָשְׂא֤וּ נְהָר֨וֹת ׀ יְֽהוָ֗ה</tei:l>
          <tei:l>נָשְׂא֣וּ נְהָר֣וֹת קוֹלָ֑ם</tei:l>
          <tei:l>יִשְׂא֖וּ נְהָר֣וֹת דָּכְיָֽם׃</tei:l>
          <tei:l><tei:hi rend="superscript">ד</tei:hi> מִקֹּל֨וֹת ׀ מַ֤יִם רַבִּ֗ים אַדִּירִ֣ים מִשְׁבְּרֵי־יָ֑ם</tei:l>
          <tei:l>אַדִּ֖יר בַּמָּר֣וֹם יְהוָֽה׃</tei:l>
          <tei:l><tei:hi rend="superscript">ה</tei:hi> עֵֽדֹתֶ֨יךָ ׀</tei:l>
          <tei:l>נֶאֶמְנ֬וּ מְאֹ֗ד</tei:l>
          <tei:l>לְבֵיתְךָ֥ נַאֲוָה־קֹ֑דֶשׁ יְ֝הוָ֗ה</tei:l>
          <tei:l>לְאֹ֣רֶךְ יָמִֽים׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
