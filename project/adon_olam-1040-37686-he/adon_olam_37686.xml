    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:adon_olam_37686">
        <tei:head>אֲדוֹן עוֹלָם (מנהג הספרדים במזרח)‏</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam_37686/1"/>
        <tei:lg>
          <tei:l>אֲדוֹן עוֹלָם אֲשֶׁר מָלַךְ</tei:l>
          <tei:l>בְּטֶרֶם כָּל יְצִיר נִבְרָא</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>לְעֵת נַעֲשָׂה בְחֶפְצוֹ</tei:l>
          <tei:l>כֹּל אֲזַי מֶלֶךְ שְׁמוֹ נִקְרָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam_37686/2"/>
        <tei:lg>
          <tei:l>וְאַחֲרֵי כִּכְלוֹת הַכֹּל</tei:l>
          <tei:l>לְבַדּוֹ יִמְלֹךְ נוֹרָא</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְהוּא הָיָה וְהוּא הֹוֶה</tei:l>
          <tei:l>וְהוּא יִהְיֶה בְּתִפְאָרָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam_37686/3"/>
        <tei:lg>
          <tei:l>וְהוּא אֶחָד וְאֵין שֵׁנִי</tei:l>
          <tei:l>לְהַמְשִׁיל לוֹ לְהַחְבִּירָה</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בְּלִי רֵאשִׁית בְּלִי תַכְלִית</tei:l>
          <tei:l>וְלוֹ הָעֺז וְהַמִּשְׂרָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam_37686/4"/>
        <tei:lg>
          <tei:l>בְּלִי עֵרֶךְ בְּלִי דִמְיוֹן</tei:l>
          <tei:l>בְּלִי שִׁנּוּי וּתְמוּרָה</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בְּלִי חִבּוּר בְּלִי פֵרוּד</tei:l>
          <tei:l>גְּדָל כֹּחַ וּגְבוּרָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam_37686/5"/>
        <tei:lg>
          <tei:l>וְהוּא אֵלִי וְחַי גּוֹאֲלִי</tei:l>
          <tei:l>וְצוּר חֶבְלִי בְּעֵת צָרָה</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְהוּא נִסִּי וּמָנוֹס לִי</tei:l>
          <tei:l>מְנָת כּוֹסִי בְּיוֹם אֶקְרָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam_37686/6"/>
        <tei:lg>
          <tei:l>וְהוּא רוֹפֵא וְהוּא מַרְפֵּא</tei:l>
          <tei:l>וְהוּא צוֹפֶה וְהוּא עֶזְרָה</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בְּיָדוֹ אַפְקִיד רוּחִי</tei:l>
          <tei:l>בְּעֵת אִישַׁן וְאָעִירָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam_37686/7"/>
        <tei:lg>
          <tei:l>וְעִם רוּחִי גְּוִיָּתִי</tei:l>
          <tei:l>אֲדנָֺי לִי וְלֹא אִירָא</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בְּמִקְדָשׁוֹ תָּגֵל נַפְשִׁי</tei:l>
          <tei:l>מְשִׁיחֵנוּ יִשְׁלַח מְהֵרָה</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְאָז נָשִׁיר בְּבֵית קָדְשִׁי</tei:l>
          <tei:l>אָמֵן אָמֵן שֵׁם הַנּוֹרָא</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
