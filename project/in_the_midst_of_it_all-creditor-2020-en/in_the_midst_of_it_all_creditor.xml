      <tei:div corresp="urn:x-opensiddur:text:prayer:in_the_midst_of_it_all_creditor">
        <tei:head>in the midst of it all, a short prayer by Rabbi Menachem Creditor (2020)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_midst_of_it_all_creditor/1"/>
        <tei:lg>
          <tei:l>in the midst of it all</tei:l>
          <tei:l>despite it all</tei:l>
          <tei:l>because of it all</tei:l>
          <tei:l>because there is an all</tei:l>
          <tei:l>Thank You, Holy One.</tei:l>
          <tei:l>(Master of All)</tei:l>
        </tei:lg>
      </tei:div>
