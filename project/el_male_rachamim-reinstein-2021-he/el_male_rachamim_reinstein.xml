  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:el_male_rachamim_reinstein">
        <tei:head>אֵל מָלֵא רַחֲמִים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:el_male_rachamim_reinstein/1"/>
        <tei:lg>
          <tei:l>אֵל מָלֵא רַחֲמִים שׁוֹכֵן בַּמְּרוֹמִים.</tei:l>
          <tei:l>הַמְצֵא מְנוּחָה נְכוֹנָה עַל כַּנְפֵי הַשְּׁכִינָה.</tei:l>
          <tei:l>בְּמַעֲלוֹת קְדוֹשִׁים וּטְהוֹרִים כְּזֹהַר הָרָקִיעַ מַזְהִירִים</tei:l>
          <tei:l>לְנִשְׁמוֹת כֹּל אֵלֶה שֶהִזְכַרְנוּ הַיוֹם</tei:l>
          <tei:l>לִבְרָכָה שֶׁהָלְּכוּ לְעוֹלָמָם, בְּגַן עֵדֶן תְּהִי מְנוּחָתָם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:el_male_rachamim_reinstein/3"/>
        <tei:lg>
          <tei:l>אָנָא בַּעַל הָרַחֲמִים הַסְתִּירֵם בְּסֵתֶר כְּנָפֶיךָ לְעוֹלָמִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:el_male_rachamim_reinstein/4"/>
        <tei:lg>
          <tei:l>וּצְרוֹר בִּצְרוֹר הַחַיִּים אֶת נִשְׁמוֹתֵיהֶם.</tei:l>
          <tei:l>יְיָ הוּא נַחֲלָתָם.</tei:l>
          <tei:l>וְיָנוּחוּ בְשָׁלוֹם עַל מִשְׁכְּבוֹתֵיהֶם.</tei:l>
          <tei:l>וְנֹאמַר אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
