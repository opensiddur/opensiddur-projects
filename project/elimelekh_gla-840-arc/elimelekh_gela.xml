  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:elimelekh_gela">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elimelekh_gela/1"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">אֵ</tei:seg>לִימֶֽלֶךְ גְּלָה וּפְנָה</tei:l>
          <tei:l>מִן־קֳדָם כַּפְנָה</tei:l>
          <tei:l>וְעִמֵּיהּ חִסְדָא וְחַנָּה</tei:l>
          <tei:l>וּתְרֵין גוֹזְלוֹי בְּקָנָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elimelekh_gela/2"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>גִין דְּלָא יִתְמַסְכֵּן</tei:l>
          <tei:l>גְּלָה וַעֲבַד־כֵּן</tei:l>
          <tei:l>וְרָאשֵׁיהּ בְּמוֹאָב אַרְכֵן</tei:l>
          <tei:l>בְּרִיךְ הוּא דַעֲבַד כֵּן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elimelekh_gela/3"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">גּ</tei:seg>וֹזְלוֹי נָשִׁין נְסִבוּן</tei:l>
          <tei:l>וְתַמָּן יִתְבוּן</tei:l>
          <tei:l>וּלְקֵץ יוֹמִין שְׁכִבוּן</tei:l>
          <tei:l>וְלָא אִתְעַכַּבוּן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elimelekh_gela/4"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">דִּ</tei:seg>מְעַת נָעֳמִי בְּעֵינֵהָ</tei:l>
          <tei:l>בְּזַעַת מָאנֵיהָ</tei:l>
          <tei:l>עַל בַּעְלָהּ וְעַל בָּנֵיהָ</tei:l>
          <tei:l>דְּאִשְׁתְּנוּן עִדַּנֵיהָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elimelekh_gela/5"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">הַ</tei:seg>א מִן מוֹאַב נְפַקַת</tei:l>
          <tei:l>וּלְבֵית לֶחֶם אַסְקַת</tei:l>
          <tei:l>עׇרְפָּה מִנָּהּ רְחַקַת</tei:l>
          <tei:l>וְרוּת בַּהּ דַבְקַת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elimelekh_gela/6"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">וַ</tei:seg>אֲמַרַת רוּת לְנָעֳמִי</tei:l>
          <tei:l>עַמָּךְ הוּא עַמִּי</tei:l>
          <tei:l>לַחְמָךְ הוּא לַחְמִי</tei:l>
          <tei:l>עַד דְּנֵיזִיל לְבֵית עָלְמִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elimelekh_gela/7"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">זְ</tei:seg>מַנָהּ דַּאֲתוּן לְבֵית לֶחֶם יְהוּדָה</tei:l>
          <tei:l>הֲוָה שֵׁירוּי חֲצָדַהּ</tei:l>
          <tei:l>נָעֳמִי בְּפוּמָהּ מַסְפְּדָה</tei:l>
          <tei:l>וְרוּת עֲטִיפָה חִסְדָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elimelekh_gela/8"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">חַ</tei:seg>מִין נָשִׁין יָתָהּ</tei:l>
          <tei:l>וּרְהַטִין לְקַדְמוּתָהּ</tei:l>
          <tei:l>אֲתַת נָעֳמִי לְבֵיתָהּ</tei:l>
          <tei:l>וְעִמָהּ כַּלְתָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elimelekh_gela/9"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">טִ</tei:seg>לְיָיתָא לָא תִּקְרוּן לִי נָעֳמִי</tei:l>
          <tei:l>מְרִירָה הוּא שְׁמִי</tei:l>
          <tei:l>דְּאִתְחַלָל כַּרְמִי</tei:l>
          <tei:l>לְבַר מִתְחוּמִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elimelekh_gela/10"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">יְ</tei:seg>תִיבָה הֲוָות בְּשַׁלְוָוה</tei:l>
          <tei:l>רְחִימָה וַחֲבִיבָה</tei:l>
          <tei:l>וּכְדוֹן אֲנָּה יְתִיבָה</tei:l>
          <tei:l>צַדְיָיה וַעֲלִיבָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elimelekh_gela/11"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">כַּ</tei:seg>לְתָהּ נְפַקַת וּלְקַטַת</tei:l>
          <tei:l>וְשִׁבֳּלִים לְקַטַת</tei:l>
          <tei:l>יָמִין וּסְמָאל לָא נְטַת</tei:l>
          <tei:l>דְּתֶהוֺן חְבַטַת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elimelekh_gela/12"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">לַ</tei:seg>הּ חַמָּהּ בּוֹעַז קַיְּמָה</tei:l>
          <tei:l>כְּיָוָן תְּמִימָה</tei:l>
          <tei:l>וּשְׁאַל לְעוּלֵימָה</tei:l>
          <tei:l>מַן־הִיא דָּא דְּקַיְמָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elimelekh_gela/13"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">מ</tei:seg>וֹאַבִיָּה הִיא דָא</tei:l>
          <tei:l>אֲמַר לֵיהּ חֲצוֹדָה</tei:l>
          <tei:l>דַּאֲתַת מִתְוַעֲדָה</tei:l>
          <tei:l>עִם אֻמָּה יְחִידָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elimelekh_gela/14"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">נְ</tei:seg>טַה בּוֹעָז לְמַהֲלְכָה</tei:l>
          <tei:l>וְקַם יָתָהּ מְבַרְכָהּ</tei:l>
          <tei:l>תֶּהְוִוין בְּרִיכָה</tei:l>
          <tei:l>וּמִינָּךְ יְקוּם שְׂלֹמֹה מַלְכָּא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elimelekh_gela/15"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">סַ</tei:seg>גַדַת קֳדָמוֹי לְאַרְעָא</tei:l>
          <tei:l>וְתַנֵית לַחֲמַתָּהּ בְּדֵיעָה</tei:l>
          <tei:l>חֲמַתָּהּ לַהּ מוֹדָעָא</tei:l>
          <tei:l>דְּהוּא תּבוּעָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elimelekh_gela/16"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">עֲ</tei:seg>טוּפִי לְבוּשִׁי הַדְרָה</tei:l>
          <tei:l>וּפוּקִי גַּבֵּיהּ לְאִדְּרָא</tei:l>
          <tei:l>טוּסִי עֲלוֹי כְּצִפָּרָה</tei:l>
          <tei:l>וּדְמוּכִי גַּבֵּיהּ עַד־צַפְרָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elimelekh_gela/17"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">פַ</tei:seg>רַת וּנְפַקַת</tei:l>
          <tei:l>וּבְצָדִּיקָה דְבַקַת</tei:l>
          <tei:l>וּבְמַשְׁכּוֹכִיתֵיהּ חֲבַקַת</tei:l>
          <tei:l>וּמִנַּהּ לָא רְחַקַת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elimelekh_gela/18"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">צָ</tei:seg>דִּיקָה מָאנוֹי לְבַשׁ</tei:l>
          <tei:l>וְיִצְרֵהּ בִּישָׁה מִנֵיהּ כְּבַשׁ</tei:l>
          <tei:l>וְיָתָהּ עַד־צַפְרָה חֲבַשׁ</tei:l>
          <tei:l>וְאִתְעַסַּק בְּאוֹרַיתָא דְּחַלְיָא מִן־דְבַשׁ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elimelekh_gela/19"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">קְ</tei:seg>רָא בּוֹעַז בְּצַפְרָה</tei:l>
          <tei:l>לְגוּבְרִין עֲסָרָה</tei:l>
          <tei:l>וְּאִיתֵיב יָתְהוֹן חֲבוּרָה</tei:l>
          <tei:l>וּקְדַשׁ יָתָהּ כַּהֲלָכָה וּכְתוֹרָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elimelekh_gela/20"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">רַ</tei:seg>בְרְבָנֵי חׇכְמְתָא</tei:l>
          <tei:l>בְּרֵכוּן לְרַבֵּיתָה</tei:l>
          <tei:l>תִּתְבַּרְכִין כַּלָה בְּרִיכְתָּה</tei:l>
          <tei:l>וּמִינָךְ תַקוּם מַלְכוּתָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elimelekh_gela/21"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">שֵׁ</tei:seg>ירוּי עַבַדַת</tei:l>
          <tei:l>וְעִם צַדִּיקָיָּה חֲדַת</tei:l>
          <tei:l>וְזָמְרִין בִּדַּת</tei:l>
          <tei:l>וְעַבְּרַת וִילֵדַת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elimelekh_gela/22"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">תַּ</tei:seg>קִּיפָה יְהַב לַהּ בַּר</tei:l>
          <tei:l>וּקְרַת שְׁמֵיהּ עוֹבֵד</tei:l>
          <tei:l>וְעֹבֵד֙ הוֹלִ֣יד אֶת־יִשָׁ֔י</tei:l>
          <tei:l>וְיִשַׁ֖י הוֹלִ֥יד אֶת־דָּוִֽד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elimelekh_gela/23"/>
        <tei:lg xml:lang="he">
          <tei:l>כַּכָּתוּב —</tei:l>
          <tei:l>וְאֵ֙לֶּה֙ תּוֹלְד֣וֹת פָּ֔רֶץ פֶּ֖רֶץ הוֹלִ֥יד אֶת־חֶצְרֽוֹן׃</tei:l>
          <tei:l>וְחֶצְרוֹן֙ הוֹלִ֣יד אֶת־רָ֔ם וְרָ֖ם הוֹלִ֥יד אֶת־עַמִּֽינָדָֽב׃</tei:l>
          <tei:l>וְעַמִּֽינָדָב֙ הוֹלִ֣יד אֶת־נַחְשׁ֔וֹן וְנַחְשׁ֖וֹן הוֹלִ֥יד אֶת־שַׂלְמָֽה׃</tei:l>
          <tei:l>וְשַׂלְמוֹן֙ הוֹלִ֣יד אֶת־בֹּ֔עַז וּבֹ֖עַז הוֹלִ֥יד אֶת־עוֹבֵֽד׃</tei:l>
          <tei:l>וְעֹבֵד֙ הוֹלִ֣יד אֶת־יִשָׁ֔י וְיִשַׁ֖י הוֹלִ֥יד אֶת־דָּוִֽד׃ <tei:bibl>(רות ד:יח-כב)</tei:bibl></tei:l>
          <tei:l>
            <tei:bibl>הוֹד֣וּ לַיהֹוָ֣ה כִּי־ט֑וֹב כִּ֖י לְעוֹלָ֣ם חַסְדּֽוֹ׃ <tei:bibl>(תהלים קלו:א)</tei:bibl></tei:bibl>
          </tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
