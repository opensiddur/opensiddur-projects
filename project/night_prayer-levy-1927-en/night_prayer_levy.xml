  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:night_prayer_levy">
        <tei:head>Night Prayer (for Older Children) by Rabbi Clifton Harby Levy (1927)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:night_prayer_levy/1"/>
        <tei:lg>
          <tei:l>I thank You, dear God,</tei:l>
          <tei:l>for all the fine day of play and lessons.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:night_prayer_levy/2"/>
        <tei:lg>
          <tei:l>I thank You, too,</tei:l>
          <tei:l>for all the love that has come to me</tei:l>
          <tei:l>from my parents,</tei:l>
          <tei:l>my brothers and sisters</tei:l>
          <tei:l>and friends.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:night_prayer_levy/3"/>
        <tei:lg>
          <tei:l>Let me sleep in peace,</tei:l>
          <tei:l>so that when I wake</tei:l>
          <tei:l>I shall be ready</tei:l>
          <tei:l>for all I want to do,</tei:l>
          <tei:l>all I want to learn.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:night_prayer_levy/4"/>
        <tei:lg>
          <tei:l>Bless all whom I love</tei:l>
          <tei:l>and who love me,</tei:l>
          <tei:l>with health and happiness.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
