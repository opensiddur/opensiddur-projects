    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:aamir_mistater_abitur">
        <tei:head>אַאֲמִיר מִסְתַּתֵּר</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_mistater_abitur/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אַ</tei:seg>אֲמִיר מִסְתַּתֵּר בִּמְעוֹן חֶבְיוֹן</tei:l>
          <tei:l><tei:seg type="acrostic">אֶ</tei:seg>עֶרְכָה פִלְאוֹתָיו זוֹ לְזוֹ בְּהִגָּיוֹן</tei:l>
          <tei:l><tei:seg type="acrostic">אֲ</tei:seg>זַמְּרָ֗ה שֵֽׁם־יְהֹוָ֥ה עֶלְיֽוֹן׃ <tei:bibl>(תהלים ז:יח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_mistater_abitur/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בִּ</tei:seg>אוּר פְּלָאָיו אַטִּיף בְּמַֽעַן</tei:l>
          <tei:l><tei:seg type="acrostic">בַּ</tei:seg>עֲשׂוֹתוֹ נוֹרָאוֹת לְרִוּוּי לַֽעַן</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>אֶ֖רֶץ מִצְרַ֣יִם שְׂדֵה־צֹֽעַן׃ <tei:bibl>(תהלים עח:יב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_mistater_abitur/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">גֵּ</tei:seg>אֶה הֶרְאָה נוֹרְאוֹתָיו</tei:l>
          <tei:l>וְלֶעָתִיד כֵּן יַרְאֶה מִפְעֲלוֹתָיו</tei:l>
          <tei:l>זֵ֣כֶר עָ֭שָׂה לְנִפְלְאוֹתָ֑יו׃ <tei:bibl>(תהלים קיא:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_mistater_abitur/4"/>
        <tei:lg>
          <tei:l>יָׄזַם וְהֶרְאָה גְּבוּרוֹת מָעֻזּוֹ</tei:l>
          <tei:l>סִׄדֵּר פְּׄלָאָיו זוֹ לְעֻמַּת זוֹ</tei:l>
          <tei:l>בִּׄימִינוֹ וּבִזְרוֹעַ עֻזּוֹ׃</tei:l>
          <tei:l>קָדוֹשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_mistater_abitur/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">דִּ</tei:seg>לָּה בָּרִאשׁוֹן זְרֽוֹעַ מַחֲצֶֽבֶת</tei:l>
          <tei:l>נְטוֹת יְרִיעוֹתָיו כְּעָלָה בְּמַחֲשֶֽׁבֶת</tei:l>
          <tei:l>וַיִּמְתָּחֵ֥ם כָּאֹ֖הֶל לָשָֽׁבֶת׃ <tei:bibl>(ישעיה מ:כב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_mistater_abitur/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הֲ</tei:seg>דוּרִים בְּצֵאתָם מֵעַם מְסֻכְסָךְ</tei:l>
          <tei:l>מַחֲסֶה מֵעֲלֵיהֶם לֹא נֶחְשַׂךְ</tei:l>
          <tei:l>פָּרַ֣שׂ עָנָ֣ן לְמָסָ֑ךְ׃ <tei:bibl>(תהלים קה:לט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_mistater_abitur/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>לֶעָתִיד בְּהִשָּׁמַע קוֹל הַתּוֹר</tei:l>
          <tei:l>קְנוֹת פְּזוּרָיו מִפְּלֶֽשֶׁת וְכַפְתּוֹר</tei:l>
          <tei:l>בְּסֻכָּה יְסֹכְכֶם לְמַחֲסֶה וּלְמִסְתּוֹר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_mistater_abitur/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זָ</tei:seg>ךְ בַּשֵּׁנִי חָצָה מְצוּלוֹתָיו</tei:l>
          <tei:l>חֶצְיָם בִּתְהוֹם וְחֶצְיָם בְּמַעֲלוֹתָיו</tei:l>
          <tei:l>הַ֥מקָרֶ֥ה בַמַּ֗יִם עֲֽלִיּ֫וֹתָ֥יו׃ <tei:bibl>(תהלים קד:ג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_mistater_abitur/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חֲ</tei:seg>מֻשִׁים בַּעֲלוֹתָם בְּיוֹם קְרָב</tei:l>
          <tei:l>בָּקַע יָם וַיַּעֲבִירֵם בְּעֻזּוֹ חָרָב</tei:l>
          <tei:l>וַיִּגְעַ֣ר בְּיַם־ס֭וּף וַֽיֶּחֱרָ֑ב׃ <tei:bibl>(תהלים קו:ט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_mistater_abitur/10"/>
        <tei:lg>
          <tei:l>וְלֶעָתִיד <tei:seg type="acrostic">טְ</tei:seg>רוּפִים בִּהְיוֹתָם פְּדוּיִים</tei:l>
          <tei:l>בֶּאֱסוֹף נִדָּחֵֽימוֹ מִכׇּל־אִיִּים</tei:l>
          <tei:l>בַּיּ֣וֹם הַה֗וּא יֵצְא֤וּ מַֽיִם־חַיִּים֙׃ <tei:bibl>(זכריה יד:ח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_mistater_abitur/11"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>הּ בַּשְּׁלִישִׁי הִטְרִֽיחַ בְּרִי</tei:l>
          <tei:l>הִדְשִׁיא דְשָׁאִים וְהִפְרִיא</tei:l>
          <tei:l>עֵ֣ץ פְּרִ֞י עֹ֤שֶׂה פְּרִי֙׃ <tei:bibl>(בראשית א:יא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_mistater_abitur/12"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כְּ</tei:seg>מֵהִים בְּבוֹא עִתָּם עֵת דּוֹדִים</tei:l>
          <tei:l>הֵצִיץ לְבוֹנָה וּפְרִי מְגָדִ֑ים</tei:l>
          <tei:l>כְּפָרִ֖ים עִם־נְרָדִֽים׃ <tei:bibl>(שיר השירים ד:יג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_mistater_abitur/13"/>
        <tei:lg>
          <tei:l>וְלֶעָתִיד <tei:seg type="acrostic">לְ</tei:seg>הִגָּאֵל כֹּל יוּכָל</tei:l>
          <tei:l>בְּצֵאת נַֽחַל מִמִּפְתַּן הֵיכָל</tei:l>
          <tei:l>יַעֲלֶ֣ה עַל־שְׂפָת֣וֹ מִזֶּ֣ה ׀ וּמִזֶּ֣ה ׀ כׇּל־עֵֽץ־מַ֠אֲכָ֠ל׃ <tei:bibl>(יחזקאל מז:יב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_mistater_abitur/14"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מָ</tei:seg>רוֹם בָּרְבִיעִי הִזְרִֽיחַ מוֹשְׁלִים</tei:l>
          <tei:l>לְאוֹר יוֹם וָלַֽיְלָה בְּרוּם זְבוּלִים</tei:l>
          <tei:l>אֶת־שְׁנֵ֥י הַמְּאֹרֹ֖ת הַגְּדֹלִ֑ים׃ <tei:bibl>(בראשית א:טז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_mistater_abitur/15"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נָ</tei:seg>אוֹר דְּמוּתָם לְעַם זוּ הִתְאִיר</tei:l>
          <tei:l>וַיַּנְחֵם יוֹמָם בֶּעָנָן מַבְעִיר</tei:l>
          <tei:l>וְלַ֛יְלָה בְּעַמּ֥וּד אֵ֖שׁ לְהָאִ֣יר׃ <tei:bibl>(שמות יג:כא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_mistater_abitur/16"/>
        <tei:lg>
          <tei:l>וְלֶעָתִיד <tei:seg type="acrostic">סְ</tei:seg>גֻלִּים בְּהִגָּאֵל כִּימֵי עוֹלָם</tei:l>
          <tei:l>קֽוּמִי אוֹרִי יַשְׁמִיעֵם גֹּאֲלָם</tei:l>
          <tei:l>וְהָֽיָה־לָ֤ךְ יְהֹוָה֙ לְא֣וֹר עוֹלָ֔ם׃ <tei:bibl>(ישעיה ס:יט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_mistater_abitur/17"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">עֶ</tei:seg>לְיוֹן בַּחֲמִישִׁי הִשְׁרִיץ בְּמֶֽרֶץ</tei:l>
          <tei:l>דְּגַת הַיָּם מַשְׁרִיצֵי שֶֽׁרֶץ</tei:l>
          <tei:l>וְעוֹף֙ יְעוֹפֵ֣ף עַל־הָאָ֔רֶץ׃ <tei:bibl>(בראשית א:כ)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_mistater_abitur/18"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>דוּיִים עֵת הִתְאַֽוּוּ בְּמַאֲוַיָּם</tei:l>
          <tei:l>וַיִּתֵּן שֶׁאֱלָתָם אֵל חַי וְקַיָּם</tei:l>
          <tei:l>וַיָּ֣גׇז שַׂלְוִים֮ מִן־הַיָּם֒׃ <tei:bibl>(במדבר יא:לא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_mistater_abitur/19"/>
        <tei:lg>
          <tei:l>וְלֶעָתִיד <tei:seg type="acrostic">צֵ</tei:seg>את הַנַּֽחַל יִפְרֹץ</tei:l>
          <tei:l>בִּדְגַת הַיָּם יִפְרֹץ בְּמֵרוֹץ</tei:l>
          <tei:l>וְהָיָ֣ה כׇל־נֶ֣פֶשׁ חַיָּ֣ה ׀ אֲֽשֶׁר־יִשְׁרֹ֡ץ׃ <tei:bibl>(יחזקאל מז:ט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_mistater_abitur/20"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>דוֹשׁ בַּשִּׁשִּׁי הִשְׁלִים בְּתֶֽרֶץ</tei:l>
          <tei:l>וַיֹּ֣אמֶר אֱלֹהִ֗ים תּוֹצֵ֨א הָאָ֜רֶץ</tei:l>
          <tei:l>בְּהֵמָ֥ה וָרֶ֛מֶשׂ וְחַֽיְתוֹ־אֶ֖רֶץ׃ <tei:bibl>(בראשית א:כד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_mistater_abitur/21"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רֻ</tei:seg>קַּם יְצִיר בְּעֹז נׇאֳמוֹ</tei:l>
          <tei:l>וְהִבְדִּילוֹ מִכׇּל־בְּרוּאֵי עוֹלָמוֹ</tei:l>
          <tei:l>וַיִּבְרָ֨א אֱלֹהִ֤ים ׀ אֶת־הָֽאָדָם֙ בְּצַלְמ֔וֹ׃ <tei:bibl>(בראשית א:כז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_mistater_abitur/22"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שַׁ</tei:seg>דַּי כֵּן מִשִּׁבְעִים עֲמָמִים</tei:l>
          <tei:l>חָשַׁק וְהִבְדִּיל מְעַטֵּי עַמִּים</tei:l>
          <tei:l>כְּנָם — וָאַבְדִּ֥ל אֶתְכֶ֛ם מִן־הָֽעַמִּ֖ים׃ <tei:bibl>(ויקרא כ:כו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_mistater_abitur/23"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">תַּ</tei:seg>קִּיף כְּחָש תְּנוּפַת יְמָנִית</tei:l>
          <tei:l>קְנוֹת פְּזוּרָיו מִמַּאֲרִיכֵי מַעֲנִית</tei:l>
          <tei:l>כֵּן יוֹסִיף אֲדֹנָי יָדוֹ שֵׁנִית׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_mistater_abitur/24"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">תְּ</tei:seg>מִימֵי לֵב הַמְיַחֲלִים לְגׇדְלוֹ</tei:l>
          <tei:l>בְּרִנָּה יְנַהֲלֵם לִמְעוֹן הֵיכָלוֹ</tei:l>
          <tei:l>שָׁם יַעַבְדוּהוּ כׇּל־בֵּית יִשְׂרָאֵל כֻּלֹּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_mistater_abitur/25"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">תָּ</tei:seg>רוּם יָד מֻפְלָאָה</tei:l>
          <tei:l>לְשַׂמֵּֽחַ אֹם נַהֲלָאָה</tei:l>
          <tei:l>בִּירוּשָׁלַֽיִם לַשָּׁנָה הַבָּאָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aamir_mistater_abitur/26"/>
        <tei:lg>
          <tei:l>קוּמָה יְהֹוָה וְחַדֵּשׁ גְּבוּרוֹת מִפְעָלֶֽיהָ</tei:l>
          <tei:l>הַמַּזְרַֽחַת נְגוֹהוֹת וְרַֽבּוּ תְעָלֶֽיהָ</tei:l>
          <tei:l>הַמֵּאִיר לָאָֽרֶץ וְלַדָּרִים עָלֶֽיהָ׃</tei:l>
          <tei:l>קָדוֹשׁ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
