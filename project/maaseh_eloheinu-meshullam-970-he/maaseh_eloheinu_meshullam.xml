    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:maaseh_eloheinu_meshullam">
        <tei:head>מַעֲשֵׂי אֱלֹהֵינוּ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaseh_eloheinu_meshullam/1"/>
        <tei:lg>
          <tei:l>וּבְכֵן גְּדוֹלִים מַעֲשֵׂי אֱלֹהֵינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaseh_eloheinu_meshullam/2"/>
        <tei:lg>
          <tei:l>מַעֲשֵׂי אֱלֹהֵינוּ</tei:l>
          <tei:l><tei:seg type="acrostic">אֵ</tei:seg>ין מִי בַשַּֽׁחַק יַעֲרָךְ לוֹ</tei:l>
          <tei:l><tei:seg type="acrostic">בִּ</tei:seg>בְנֵי אֵלִים יִדְמֶה לּוֹ</tei:l>
          <tei:l><tei:seg type="acrostic">גְּ</tei:seg>בוֹהִים עִלָּה לְמוֹשָׁב לוֹ</tei:l>
          <tei:l><tei:seg type="acrostic">דָּ</tei:seg>רֵי גֵיא כַּחֲגָבִים לְמוּלוֹ</tei:l>
          <tei:l>לָכֵן יִתְגָּאֶה הַצּוּר תָּמִים פָּעֳלוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaseh_eloheinu_meshullam/3"/>
        <tei:lg>
          <tei:l>מַעֲשֵׂי אֱלֹהֵינוּ</tei:l>
          <tei:l><tei:seg type="acrostic">הַ</tei:seg>מְשֵׁל וָפַֽחַד עִמּוֹ</tei:l>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>הַרְבֵּה פְדוּת עִמּוֹ</tei:l>
          <tei:l><tei:seg type="acrostic">זַ</tei:seg>עַֽק וְלַֽחַשׁ עַמּוֹ</tei:l>
          <tei:l><tei:seg type="acrostic">חָ</tei:seg>שׁ וּמַאֲזִין מִמְּרוֹמוֹ</tei:l>
          <tei:l>לָכֵן יִתְגָּאֶה יְיָ צְבָאוֹת שְׁמוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaseh_eloheinu_meshullam/4"/>
        <tei:lg>
          <tei:l>מַעֲשֵׂי אֱלֹהֵינוּ</tei:l>
          <tei:l><tei:seg type="acrostic">טֶֽ</tei:seg>רֶף נָתַן לִירֵאָיו</tei:l>
          <tei:l><tei:seg type="acrostic">י</tei:seg>וֹבִֽילוּ שַׁי לְמוֹרָאָיו</tei:l>
          <tei:l><tei:seg type="acrostic">כִּ</tei:seg>תֵּי גְדוּדֵי צְבָאָיו</tei:l>
          <tei:l><tei:seg type="acrostic">לֹ</tei:seg>א יָשֽׁוּרוּ כְּבוֹד מַרְאָיו</tei:l>
          <tei:l>לָכֵן יִתְגָּאֶה הִנֵּה עֵין יְיָ אֶל יְרֵאָיו׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaseh_eloheinu_meshullam/5"/>
        <tei:lg>
          <tei:l>מַעֲשֵׂי אֱלֹהֵינוּ</tei:l>
          <tei:l><tei:seg type="acrostic">מַ</tei:seg>לְאָכָיו עֹשֶׂה רוּחוֹת</tei:l>
          <tei:l><tei:seg type="acrostic">נִ</tei:seg>קְדָּשׁ בְּשִׁירוֹת וְתִשְׁבָּחוֹת</tei:l>
          <tei:l><tei:seg type="acrostic">ס</tei:seg>וֹכֵת שְׁפִיכַת שִׂיחוֹת</tei:l>
          <tei:l><tei:seg type="acrostic">ע</tei:seg>וֹנֶה וּמַעֲמִיד רְוָחוֹת</tei:l>
          <tei:l>לָכֵן יִתְגָּאֶה אֱלֹהֵי הָרוּחוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaseh_eloheinu_meshullam/6"/>
        <tei:lg>
          <tei:l>מַעֲשֵׂי אֱלֹהֵינוּ</tei:l>
          <tei:l><tei:seg type="acrostic">פּ</tei:seg>וֹדֶה מִשַּֽׁחַת עֲמוּסָיו</tei:l>
          <tei:l><tei:seg type="acrostic">צ</tei:seg>וּר יוֹדֵֽעַ חוֹסָיו</tei:l>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>דוֹשׁ מַפְלִיא נִסָּיו</tei:l>
          <tei:l><tei:seg type="acrostic">רַ</tei:seg>חוּם לִמְרַצָּיו וּמַכְעִיסָיו</tei:l>
          <tei:l>לָכֵן יִתְגָּאֶה וְרַחֲמָיו עַל כׇּל מַעֲשָׂיו׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaseh_eloheinu_meshullam/7"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">בלחש:</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaseh_eloheinu_meshullam/8"/>
        <tei:lg>
          <tei:l>מַעֲשֵׂי אֱנוֹשׁ</tei:l>
          <tei:l><tei:seg type="acrostic">תַּ</tei:seg>חְבֻּלוֹתָיו מְזִמָּה</tei:l>
          <tei:l><tei:seg type="acrostic">שִׁ</tei:seg>בְתּוֹ בְּתוֹךְ מִרְמָה</tei:l>
          <tei:l><tei:seg type="acrostic">רְ</tei:seg>פִידָתוֹ רִמָּה</tei:l>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>בוּר בִּסְעִיף אֲדָמָה</tei:l>
          <tei:l>וְאֵיךְ יִתְגָּאֶה אָדָֽם לַהֶֽבֶל דָּמָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maaseh_eloheinu_meshullam/9"/>
        <tei:lg>
          <tei:l>אֲבָל מַעֲשֵׂה אֱלֹהֵֽינוּ</tei:l>
          <tei:l>שׁוֹמֵֽעַ שְׁוָעוֹת</tei:l>
          <tei:l>שׁוֹעֶה עֵֽרֶךְ שׁוּעוֹת</tei:l>
          <tei:l>תּוֹרוֹתָיו מְשַׁעְשְׁעוֹת</tei:l>
          <tei:l>תַּכְסִיסוֹ כּֽוֹבַע יְשׁוּעוֹת</tei:l>
          <tei:l>לָכֵן יִתְגָּאֶה הָאֵל לָֽנוּ אֵל לְמוֹשְָׁוֹת׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
