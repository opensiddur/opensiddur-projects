  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:wa_targhhome_a_tlhingan_hol_adaptation_of_had_gadya_2022">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wa_targhhome_a_tlhingan_hol_adaptation_of_had_gadya_2022/1"/>
        <tei:lg xml:lang="tlh-Hebr">
          <tei:l>וַא תַרְגְחָמְאֶא, וַא תַרְגְחָמְאֶא,</tei:l>
          <tei:l>טַא דַרְשֶקְמֵיבַֿד זֶאתַאבָג בַֿבֿוִא,</tei:l>
          <tei:l>וַא תַרְגְחָמְאֶא, וַא תַרְגְחָמְאֶא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wa_targhhome_a_tlhingan_hol_adaptation_of_had_gadya_2022/2"/>
        <tei:lg xml:lang="tlh-Hebr">
          <tei:l>עֻג טָלְפֻא גִשְנַר</tei:l>
          <tei:l>אֶז תַרְגְחָמְאֶא שָפֻּא</tei:l>
          <tei:l>טַא דַרְשֶקְמֵיבַֿד זֶאתַאבָג בַֿבֿוִא,</tei:l>
          <tei:l>וַא תַרְגְחָמְאֶא, וַא תַרְגְחָמְאֶא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wa_targhhome_a_tlhingan_hol_adaptation_of_had_gadya_2022/3"/>
        <tei:lg xml:lang="tlh-Hebr">
          <tei:l>עֻג טָלְפֻא כָג</tei:l>
          <tei:l>אֶז גִשְנַר טָפֻּא</tei:l>
          <tei:l>תַרְגְחָמְאֶא שָפֻּאבָג</tei:l>
          <tei:l>טַא דַרְשֶקְמֵיבַֿד זֶאתַאבָג בַֿבֿוִא,</tei:l>
          <tei:l>וַא תַרְגְחָמְאֶא, וַא תַרְגְחָמְאֶא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wa_targhhome_a_tlhingan_hol_adaptation_of_had_gadya_2022/4"/>
        <tei:lg xml:lang="tlh-Hebr">
          <tei:l>עֻג טָלְפֻא גַנְזַק</tei:l>
          <tei:l>אֶז כָג מֻפֻּא</tei:l>
          <tei:l>גִשְנַר טָפֻּאבָג</tei:l>
          <tei:l>תַרְגְחָמְאֶא שָפֻּאבָג</tei:l>
          <tei:l>טַא דַרְשֶקְמֵיבַֿד זֶאתַאבָג בַֿבֿוִא,</tei:l>
          <tei:l>וַא תַרְגְחָמְאֶא, וַא תַרְגְחָמְאֶא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wa_targhhome_a_tlhingan_hol_adaptation_of_had_gadya_2022/5"/>
        <tei:lg xml:lang="tlh-Hebr">
          <tei:l>עֻג טָלְפֻא קֻל</tei:l>
          <tei:l>אֶז גַנְזַק מֶכְפֻא</tei:l>
          <tei:l>כָג מֻפֻּאבָג</tei:l>
          <tei:l>גִשְנַר טָפֻּאבָג</tei:l>
          <tei:l>תַרְגְחָמְאֶא שָפֻּאבָג</tei:l>
          <tei:l>טַא דַרְשֶקְמֵיבַֿד זֶאתַאבָג בַֿבֿוִא,</tei:l>
          <tei:l>וַא תַרְגְחָמְאֶא, וַא תַרְגְחָמְאֶא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wa_targhhome_a_tlhingan_hol_adaptation_of_had_gadya_2022/6"/>
        <tei:lg xml:lang="tlh-Hebr">
          <tei:l>עֻג טָלְפֻא בִך</tei:l>
          <tei:l>אֶז קֻל בַקפֻא</tei:l>
          <tei:l>גַנְזַק מֶכְפֻאבָג</tei:l>
          <tei:l>כָג מֻפֻּאבָג</tei:l>
          <tei:l>גִשְנַר טָפֻּאבָג</tei:l>
          <tei:l>תַרְגְחָמְאֶא שָפֻּאבָג</tei:l>
          <tei:l>טַא דַרְשֶקְמֵיבַֿד זֶאתַאבָג בַֿבֿוִא,</tei:l>
          <tei:l>וַא תַרְגְחָמְאֶא, וַא תַרְגְחָמְאֶא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wa_targhhome_a_tlhingan_hol_adaptation_of_had_gadya_2022/7"/>
        <tei:lg xml:lang="tlh-Hebr">
          <tei:l>עֻג טָלְפֻא תַעְקַא</tei:l>
          <tei:l>אֶז בִך צֻצְפֻא</tei:l>
          <tei:l>קֻל בַקפֻאבָג</tei:l>
          <tei:l>גַנְזַק מֶכְפֻאבָג</tei:l>
          <tei:l>כָג מֻפֻּאבָג</tei:l>
          <tei:l>גִשְנַר טָפֻּאבָג</tei:l>
          <tei:l>תַרְגְחָמְאֶא שָפֻּאבָג</tei:l>
          <tei:l>טַא דַרְשֶקְמֵיבַֿד זֶאתַאבָג בַֿבֿוִא,</tei:l>
          <tei:l>וַא תַרְגְחָמְאֶא, וַא תַרְגְחָמְאֶא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wa_targhhome_a_tlhingan_hol_adaptation_of_had_gadya_2022/8"/>
        <tei:lg xml:lang="tlh-Hebr">
          <tei:l>עֻג טָלְפֻא בֻֿתְוִיא</tei:l>
          <tei:l>אֶז תַעְקַא חָחְפֻא</tei:l>
          <tei:l>בִך צֻצְפֻאבָג</tei:l>
          <tei:l>קֻל בַקפֻאבָג</tei:l>
          <tei:l>גַנְזַק מֶכְפֻאבָג</tei:l>
          <tei:l>כָג מֻפֻּאבָג</tei:l>
          <tei:l>גִשְנַר טָפֻּאבָג</tei:l>
          <tei:l>תַרְגְחָמְאֶא שָפֻּאבָג</tei:l>
          <tei:l>טַא דַרְשֶקְמֵיבַֿד זֶאתַאבָג בַֿבֿוִא,</tei:l>
          <tei:l>וַא תַרְגְחָמְאֶא, וַא תַרְגְחָמְאֶא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wa_targhhome_a_tlhingan_hol_adaptation_of_had_gadya_2022/9"/>
        <tei:lg xml:lang="tlh-Hebr">
          <tei:l>עֻג טָלְפֻא קָרְתַר</tei:l>
          <tei:l>אֶז בֻֿתְוִיא חָחְפֻא</tei:l>
          <tei:l>תַעְקַא חָחְפֻאבָג</tei:l>
          <tei:l>בִך צֻצְפֻאבָג</tei:l>
          <tei:l>קֻל בַקפֻאבָג</tei:l>
          <tei:l>גַנְזַק מֶכְפֻאבָג</tei:l>
          <tei:l>כָג מֻפֻּאבָג</tei:l>
          <tei:l>גִשְנַר טָפֻּאבָג</tei:l>
          <tei:l>תַרְגְחָמְאֶא שָפֻּאבָג</tei:l>
          <tei:l>טַא דַרְשֶקְמֵיבַֿד זֶאתַאבָג בַֿבֿוִא,</tei:l>
          <tei:l>וַא תַרְגְחָמְאֶא, וַא תַרְגְחָמְאֶא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wa_targhhome_a_tlhingan_hol_adaptation_of_had_gadya_2022/10"/>
        <tei:lg xml:lang="tlh-Hebr">
          <tei:l>עֻג טָלְפֻא הַקָּדוֹשׁ־בָרוּךְ־הוּא</tei:l>
          <tei:l>אֶז קָרְתַר חָחְפֻא</tei:l>
          <tei:l>בֻֿתְוִיא חָחְפֻאבָג</tei:l>
          <tei:l>תַעְקַא חָחְפֻאבָג</tei:l>
          <tei:l>בִך צֻצְפֻאבָג</tei:l>
          <tei:l>קֻל בַקְפֻאבָג</tei:l>
          <tei:l>גַנְזַק מֶכְפֻאבָג</tei:l>
          <tei:l>כָג מֻפֻּאבָג</tei:l>
          <tei:l>גִשְנַר טָפֻּאבָג</tei:l>
          <tei:l>תַרְגְחָמְאֶא שָפֻּאבָג</tei:l>
          <tei:l>טַא דַרְשֶקְמֵיבַֿד זֶאתַאבָג בַֿבֿוִא,</tei:l>
          <tei:l>וַא תַרְגְחָמְאֶא, וַא תַרְגְחָמְאֶא׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
