    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:liturgical_additions_for_yachats">
        <tei:head>יחץ (מנהג גרבא)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:liturgical_additions_for_yachats/2"/>
        <tei:lg>
          <tei:l>אָז קָרַע יהוה אֶת־הַיָּם לִשְׁנֵים עָשָׂר שְׁבִילִים</tei:l>
          <tei:l>בִּיצִיאַת אֲבוֹתֵֽינוּ בְּנֵי יִשְׂרָאֵל מִמִּצְרַֽיִם</tei:l>
          <tei:l>עַל יַד אֲדוֹנֵֽנוּ וּנְבִיאֵֽנוּ וַאֲצִילֵֽנוּ</tei:l>
          <tei:l>מֹשֶׁה בֶּן־עַמְרָם עָלָיו הַשָּׁלוֹם</tei:l>
          <tei:l>וְרָצָה בִּפְדוּתָם מֵהוּא הַשִּׁעְבּוּד׃</tei:l>
          <tei:l>כָּךְ יִפְדֶֽנּוּ מִזֹּאת הַגָּלוּת</tei:l>
          <tei:l>לְמַֽעַן שְׁמוֹ הַגָּדוֹל וְהַנּוֹרָא</tei:l>
          <tei:l>וְשָֽׁבוּ בָּנִים לִגְבוּלָם</tei:l>
          <tei:l>אָמֵן כֵּן יְהִי רָצוֹן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:liturgical_additions_for_yachats/4"/>
        <tei:lg>
          <tei:l>זֵֽכֶר לַאֲבוֹתֵֽינוּ שֶׁיָצְאוּ מִמִּצְרַֽיִם</tei:l>
          <tei:l>וּמִשְׁאֲרוֹתָם צְרוּרוֹת בְּשִׂמְלוֹתָם עַל־שִׁכְמָם.</tei:l>
        </tei:lg>
