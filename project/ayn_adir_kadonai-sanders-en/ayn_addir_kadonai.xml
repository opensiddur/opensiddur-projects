  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai">
        <tei:head>Ayn Adir kAdonai</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai/1"/>
        <tei:lg>
          <tei:l>From the mouth of <j:divineName>El</j:divineName></tei:l>
          <tei:l>Yisra’el will be blessed.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai/2"/>
        <tei:lg>
          <tei:l>There is none as powerful as <j:divineName>YHVH</j:divineName></tei:l>
          <tei:l>There is none as blessed as the son of Amram</tei:l>
          <tei:l>There is nothing as great as the Torah</tei:l>
          <tei:l>And none who interpret it like Yisra’el</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai/3"/>
        <tei:lg>
          <tei:l>There is none as adorned as <j:divineName>YHVH</j:divineName></tei:l>
          <tei:l>There is none as trustworthy as the son of Amram</tei:l>
          <tei:l>There is no reward like the Torah</tei:l>
          <tei:l>And none who delight in it like Yisra’el</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai/4"/>
        <tei:lg>
          <tei:l>There is none as pure as <j:divineName>YHVH</j:divineName></tei:l>
          <tei:l>There is none as righteous as the son of Amram</tei:l>
          <tei:l>There is no honor like the Torah</tei:l>
          <tei:l>And none who learn it like Yisra’el</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai/5"/>
        <tei:lg>
          <tei:l>There is no king like <j:divineName>YHVH</j:divineName></tei:l>
          <tei:l>There is none as faithful as the son of Amram</tei:l>
          <tei:l>There is no support like the Torah</tei:l>
          <tei:l>And none who arrange it like Yisra’el</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai/6"/>
        <tei:lg>
          <tei:l>There is none who save like <j:divineName>YHVH</j:divineName></tei:l>
          <tei:l>There is none as just as the son of Amram</tei:l>
          <tei:l>There is no holiness like the Torah</tei:l>
          <tei:l>And none who admire it as Yisra’el</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai/7"/>
        <tei:lg>
          <tei:l>There is none who make whole like <j:divineName>YHVH</j:divineName></tei:l>
          <tei:l>There is none as full as the son of Amram</tei:l>
          <tei:l>There is nothing as upright as the Torah</tei:l>
          <tei:l>And none who support it like Yisra’el.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
