  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:bnei_heikhala_luria">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bnei_heikhala_luria/1"/>
        <tei:lg xml:lang="he">
          <tei:l>בְּנֵי הֵיכָלָא</tei:l>
          <tei:l>דִּכְסִיפִין</tei:l>
          <tei:l>לְמֶחֱזֵי זִיו דִּזְעֵיר אַנְפִּין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bnei_heikhala_luria/2"/>
        <tei:lg xml:lang="he">
          <tei:l>יְ֒הוֹן הָכָא</tei:l>
          <tei:l>בְּהַאי תַּכָּא</tei:l>
          <tei:l>דְּבֵיהּ מַלְכָּא בְּגִלּוּפִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bnei_heikhala_luria/3"/>
        <tei:lg xml:lang="he">
          <tei:l>צְ֒בוּ לַחֲדָא</tei:l>
          <tei:l>בְּהַאי וַעֲדָא</tei:l>
          <tei:l>בְּגוֹ עִירִין וְכׇל גַּדְּפִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bnei_heikhala_luria/4"/>
        <tei:lg xml:lang="he">
          <tei:l>חֲ֒דוּ הַשְׁתָּא</tei:l>
          <tei:l>בְּהַאי שַׁעְתָּא</tei:l>
          <tei:l>דְּבֵיהּ רַעֲוָא וְלֵית זַעְפִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bnei_heikhala_luria/5"/>
        <tei:lg xml:lang="he">
          <tei:l>קְ֒רִיבוּ לִי</tei:l>
          <tei:l>חֲזוּ חֵילִי</tei:l>
          <tei:l>דְּלֵית דִּינִין דִּתְקִיפִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bnei_heikhala_luria/6"/>
        <tei:lg xml:lang="he">
          <tei:l>לְ֒בַר נַטְּלִין</tei:l>
          <tei:l>וְלָא עָאלִין</tei:l>
          <tei:l>הֲנֵּי כַּלְבִּין דַּחֲצִיפִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bnei_heikhala_luria/7"/>
        <tei:lg xml:lang="he">
          <tei:l>וְ֒הָא אַזְמִין</tei:l>
          <tei:l>עֲתִּיק יוֹמִין</tei:l>
          <tei:l>לְמִצְחָא‏ (<tei:note type="instruction">נ״א:</tei:note> לְמִנְחָה עַד), עֲדֵי יְהוֹן חַלְפִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bnei_heikhala_luria/8"/>
        <tei:lg xml:lang="he">
          <tei:l>רְ֒עוּ דִּילֵיהּ</tei:l>
          <tei:l>דְּגַלֵּי לֵיהּ</tei:l>
          <tei:l>לְבַטָּלָא בְּכׇל קְלִיפִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bnei_heikhala_luria/9"/>
        <tei:lg xml:lang="he">
          <tei:l>יְ֒שַׁוֵּי לוֹן</tei:l>
          <tei:l>בְּנוֹקְבֵיהוֹן</tei:l>
          <tei:l>וְיִטַמְּרוּן בְּגוֹ כֵיפִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bnei_heikhala_luria/10"/>
        <tei:lg xml:lang="he">
          <tei:l>אֲ֒רֵי הַשְׁתָּא</tei:l>
          <tei:l>בְּמִנְחָתָא</tei:l>
          <tei:l>בְּחֶדָוָתָא דִזְעֵיר אַנְפִּין׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
