  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_the_people_of_ukraine_mirvis">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_people_of_ukraine_mirvis/1"/>
        <tei:lg>
          <tei:l>רִבּוֹן הָעוֹלָמִים</tei:l>
          <tei:l>שׁוֹמֵעַ תְּפִלַּת כָּל־פֶּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_people_of_ukraine_mirvis/6"/>
        <tei:lg>
          <tei:l>עוֹשֶׂה שָׁלוֹם בִּמְרוֹמָיו</tei:l>
          <tei:l>הוּא יַעֲשֶׂה שָׁלוֹם עַל כָּל יוֺשְׁבֵי תֵבֶל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_people_of_ukraine_mirvis/7"/>
        <tei:lg>
          <tei:l>וְכֵן יְהִי רָצוֹן</tei:l>
          <tei:l>וָנֺאמַר אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
