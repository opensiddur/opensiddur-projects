            <tei:note type="instruction" xml:lang="en">Say <tei:foreign xml:lang="he">אֵל מֶלֶךְ</tei:foreign> and <tei:foreign xml:lang="he">וַיַּעֲבוֹר</tei:foreign> </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_third_day_pair_after_enosh_printed"/>
          <j:conditional xml:id="penitential_third_day_pair_after_enosh_expanded">
            <tei:fs type="asher:expansions">
