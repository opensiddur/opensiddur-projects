        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_third_day/qoli_shamata">
          <tei:pb n="120" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n241_medium.jpg"/>
          <tei:lg><tei:l>קוֹלִי שָׁמַעְתָּ אַל־תַּעְלֵם אָזְנְךָ לְרַוְחָתִי לְשַׁוְעָתִי׃</tei:l> <tei:l>אַל־תִּנְאַץ לְמַעַן שְׁמֶךָ אַל־תְּנַבֵּל כִּסֵּא כְבוֹדֶךָ זְכֹר אַל־תָּפֵר בְּרִיתְךָ אִתָּנוּ׃</tei:l> <tei:l>אַל־תִּשְׁטְפֵנִי שִׁבֹּלֶת מַיִם וְאַל־תִּבְלָעֵנִי מְצוּלָה וְאַל־תֶּאְטַר עָלֵינוּ בְאֵר־פִּיהָ׃</tei:l> </tei:lg>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_third_day/verses_after_qoli">
          <j:conditional xml:id="penitential_third_day_verses_after_qoli_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
