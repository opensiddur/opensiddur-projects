        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_third_day/adonai_boqer">
          <tei:pb n="121" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n243_medium.jpg"/>
          <tei:lg><tei:l>יְיָ בֹּקֶר תִּשְׁמַע קוֹלֵנוּ בֹּקֶר נַעֲרָךְ־לְךָ וּנְצַפֶּה׃</tei:l> <tei:l>אַל־תִּנְאַץ לְמַעַן שְׁמֶךָ אַל־תְּנַבֵּל כִּסֵּא כְבוֹדֶךָ זְכֹר אַל־תָּפֵר בְּרִיתְךָ אִתָּנוּ׃</tei:l> <tei:l>וַאֲנִי תְפִלָּתִי לְךָ יְיָ עֵת־רָצוֹן אֱלֹהִים בְּרָב־חַסְדֶּךָ עֲנֵנִי בֶּאֱמֶת יִשְׁעֶךָ׃</tei:l> </tei:lg>
