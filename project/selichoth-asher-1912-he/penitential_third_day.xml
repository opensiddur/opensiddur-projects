          <tei:div>
            <tei:milestone unit="prayer" corresp="urn:x-opensiddur:text:siddur:selichot/penitential_third_day/verses_after_haenosh/expanded"/>
            <tei:p><j:transclude target="urn:x-opensiddur:text:prayer:selichot/rachamekha_rabbim" type="inline"/> <j:transclude target="urn:x-opensiddur:text:prayer:keraham_av" type="inline"/> <j:transclude target="urn:x-opensiddur:text:prayer:selichot/ki_lo_al_tsidqotenu" type="inline"/> </tei:p>
            <tei:milestone unit="prayer"/>
          </tei:div>
          <j:endConditional target="#penitential_third_day_verses_after_haenosh_expanded"/>
        </tei:div>
        <j:transclude target="urn:x-opensiddur:text:poem:enosh_bameh_yitsdaq_beyom_din"/>
