          </j:conditional>
          <j:transclude target="urn:x-opensiddur:text:prayer:el_melekh_yoshev"/>
          <j:transclude target="urn:x-opensiddur:text:prayer:vayaavor"/>
          <j:endConditional target="#penitential_third_day_pair_after_enosh_expanded"/>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_third_day/haenosh_meeloah">
          <tei:pb n="119" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n239_medium.jpg"/>
          <tei:lg><tei:l>הַאֱנוֹשׁ מֵאֱלוֹהַ יִצְדָּק אִם מֵעֹשֵׂהוּ יִטְהַר־גָּבֶר׃</tei:l> <tei:l>דִּרְשׁוּ יְיָ בְּהִמָּצְאוֹ קְרָאֻהוּ בִּהְיוֹתוֹ קָרוֹב׃</tei:l> <tei:l>שׁוּבָה יִשְׂרָאֵל עַד־יְיָ־אֱלֹהֶיךָ כִּי כָשַׁלְתָּ בַּעֲוֹנֶךָ׃</tei:l> <tei:l>שׁוּבוּ שׁוּבוּ אָמַרְתָּ לָנוּ וְעַל־הַתְּשׁוּבָה מֵרֹאשׁ הִבְטַחְתָּנוּ׃</tei:l> </tei:lg>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_third_day/verses_after_haenosh">
