                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_third_day/verses_after_haenosh/printed">
            <tei:pb n="119" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n239_medium.jpg"/>
            <tei:note type="instruction" xml:lang="he">רחמיך רבים · אל תבא · כרחם אב · ליי הישועה · יי צבאות עמנו · יי צבאות אשרי · יי הושיעה · כי לא על · יי שמעה </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_third_day_verses_after_haenosh_printed"/>
          <j:conditional xml:id="penitential_third_day_verses_after_haenosh_expanded">
            <tei:fs type="asher:expansions">
