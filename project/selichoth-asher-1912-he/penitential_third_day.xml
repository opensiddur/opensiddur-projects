            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_third_day/verses_after_qoli/printed">
            <tei:pb n="120" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n241_medium.jpg"/>
            <tei:note type="instruction" xml:lang="he">רחמיך רבים · אל תבא · כרחם אב · ליי הישועה · יי צבאות עמנו · יי צבאות אשרי · יי הושיעה · כי לא על · יי שמעה </tei:note>
