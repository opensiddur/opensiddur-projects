      <tei:div corresp="urn:x-opensiddur:text:poem:atah_elohai_malki_miqqedem">
        <tei:pb n="129" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n259_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אַתָּה אֱלֹהַי מַלְכִּי מִקֶּדֶם ·</tei:l> <tei:l>אָכֵן בְּתוֹדָה פָּנֶיךָ אֲקַדֵּם ·</tei:l> <tei:l>בִּתְנוּמוֹת מִשְׁכָּב לֹא אֵרָדֵם ·</tei:l> <tei:l>בְּעֵינַי שֵׁנָה מֵרְאוֹת אַרְדֵּם׃</tei:l> <tei:l>גָּבְרוּ מִנִּי דִּבְרֵי־עֲוֹנוֹת ·</tei:l> <tei:l>גַּם־כֹּחִי הִכְשִׁילוּ לַעֲנוֹת ·</tei:l> <tei:l>דְּבַב אֵין מָצָא תַחֲנוּת ·</tei:l> <tei:l>דִּי שְׁלוּם פָּרִים לְקָרְבָּנוֹת׃</tei:l> <tei:l>הֵן בְּמַלְאָכֶיךָ תָּשִׂים תָּהֳלָה ·</tei:l> <tei:l>הֲיִזְכּוּ בְעֵינֶיךָ מְשָׁרְתֶיךָ נַחֲלָה ·</tei:l> <tei:l>וְאִם־כֵּן בִּקְדוֹשֵׁי־מַעְלָה ·</tei:l> <tei:l>וְאַף שׁוֹתֶה כַּמַּיִם עַוְלָה׃</tei:l> <tei:l>זָחַלְתִּי וָאִירָא מֵרוֹב עֲוֹנִי ·</tei:l> <tei:l>זָכַרְתִּי בַלַּיְלָה שִׁמְךָ יְיָ ·</tei:l> <tei:l>חַסְדְּךָ וַאֲמִתְּךָ יְקַדְּמוּ פָנַי ·</tei:l> <tei:l>חֲטָאַי הַעֲבֵר וּמְחֵה וְחָנֵּנִי׃</tei:l> <tei:l>טוֹב וּמֵטִיב לַטּוֹבִים וְלָרָעִים ·</tei:l> <tei:l>טְמוּנוֹת צְפוּנוֹת לְפָנֶיךָ יְדוּעִים ·</tei:l> <tei:l>יוֹשֶׁר אִם־עִקַּלְנוּ בְּתַעְתּוּעִים ·</tei:l> <tei:l>יַעַמְדוּ־לָנוּ שְׁלֹשֶׁת הָרוֹעִים׃</tei:l> <tei:l>כְּשִׁרְיוֹן צְרוּף צְדָקָה לִלְבּוֹשׁ ·</tei:l> <tei:l>כוֹבֶד־עָוֹן נְצוּל לִכְבּוֹשׁ ·</tei:l> <tei:l>לְמָזוֹר צֳרִי וּתְעָלָה תַּחֲבוֹשׁ ·</tei:l> <tei:l>לָכֵן תֵּרָא אוֹיַבְתִּי וְתֵבוֹשׁ׃</tei:l> <tei:pb n="130" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n261_medium.jpg"/><tei:l>מֵאָז קֹדֶשׁ חֹדֶשׁ וּמוֹעֵד ·</tei:l> <tei:l>מִדִּינְךָ פָּחַדְתִּי וָאֶתְחַלְחַל לְהִרָעֵד ·</tei:l> <tei:l>נָאוֹר אַתָּה הַיּוֹדֵעַ וָעֵד ·</tei:l> <tei:l>נֹשֵׂא וְעֹשֶׂה תּוֹמֵךְ וְסוֹעֵד׃</tei:l> <tei:l>שָׂא־נָא לְפֶשַׁע עֲבָדֶיךָ ·</tei:l> <tei:l>שָׂרִיגִים שְׁלֹשֶׁת־בְּנֵי יְדִידֶיךָ ·</tei:l> <tei:l>עֵדֶיךָ הֵם מְטַהֲרֶיךָ מְיַחֲדֶיךָ ·</tei:l> <tei:l>עַמְּךָ וְנַחֲלָתְךָ וְצֹאן יָדֶיךָ׃</tei:l> <tei:l>פְּנֵה אֶל־תְּפִלַּת הָעַרְעָר ·</tei:l> <tei:l>פַּלֵּט מְרַנְּנֶיךָ מִסּוּפָה וּמִסַּעַר ·</tei:l> <tei:l>צָרֶיךָ חוֹמָתָם הַגְּבוֹהָה הִתְעַרְעֵר ·</tei:l> <tei:l>צַמְּתֵם בְּקִצְפְּךָ וַחֲמָתְךָ כְמוֹ אֵשׁ תִּבְעַר ·</tei:l> <tei:l>קִדַּמְנוּךָ טֶרֶם שׁוֹפַר תְּרוּעָה ·</tei:l> <tei:l>קְרָאנוּךָ לְכָה־נָא לָנוּ לִישׁוּעָה ·</tei:l> <tei:l>רַחוּם זְכוֹר בְּרִית שְׁבוּעָה ·</tei:l> <tei:l>רוֹגֶז הַעֲבֵר רַחֵם וְנִוָּשֵׁעָה׃</tei:l> <tei:l>שַׁבְנוּ עָדֶיךָ רוֹצֶה תְשׁוּבָה ·</tei:l> <tei:l>שׁוּבֵנוּ יְיָ אֵלֶיךָ וְנָשׁוּבָה ·</tei:l> <tei:l>תְּכַפֵּר וְהִסְלַחְתָּ עֲוֹן שׁוֹבָבָה ·</tei:l> <tei:l>תֹּאמַר סָלַחְתִּי אֶרְפָּא מְשׁוּבָה׃</tei:l> <tei:l>יוֹם־יוֹם חָקַרְנוּ דְרָכִים ·</tei:l> <tei:l>בְּרוּחַ פִּינוּ תַחַן עוֹרְכִים ·</tei:l> <tei:l>יְקַדְּמוּנוּ רַחֲמֶיךָ כִּנְדָבָה מַעֲרִיכִים ·</tei:l> <tei:l>יוֹשֵׁב עַל־כִּסֵּא מֶלֶךְ מְלָכִים׃</tei:l> </tei:lg>
      </tei:div>
