      <tei:div corresp="urn:x-opensiddur:text:poem:oznekha_hatteh_vehaqshev_leheqer_ranen">
        <tei:pb n="143" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n287_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אָזְנְךָ הַטֵּה וְהַקְשֵׁב לְחֵקֶר רַנֵּן ·</tei:l> <tei:l>בְּרִית רְעִיתֶךָ תִּזְכּוֹר הִתְרַצֵּה וְהִתְפַּיֵּס לָהּ בְּתַחֲנוּן ·</tei:l> <tei:l>גְּמוֹר בְּנָוִיהָ לְרַחֵמָהּ וּלְחַנְנָהּ כַּאֲשֶׁר הֶרְאָת בְשִׁנּוּן ·</tei:l> <tei:l>יְיָ יְיָ אֵל רַחוּם וְחַנּוּן׃</tei:l> <tei:l>דּוֹדִי־לִי וַאֲנִי־לוֹ מִתֻּאֶמֶת הֵתִיר גּוֹיִם כִּי כַפֵּיהֶם שְׁטוּחוֹת לְמוֹת ·</tei:l> <tei:l>וְאֶת־חַסְדּוֹ וֶאֱמוּנָתוֹ בָּנוּ לָעַד קַיֶּמֶת ·</tei:l> <tei:l>אֶרֶךְ־אַפַּיִם וְרַב־חֶסֶד וֶאֱמֶת׃</tei:l> <tei:l>זְכֹר עֲשֵׂה לִירֵאָיו הָעֲלוּבִים וּכְפוּפִים ·</tei:l> <tei:l>חָנֵּם לְבִלְתִּי הֱיוֹת נִשְׁכָּחִים וְנִדְחָפִים ·</tei:l> <tei:l>טֶרֶם יִקְרָאוּ יַעֲנֶה כְּהוֹרַת צוֹפִים ·</tei:l> <tei:l>נֹצֵר חֶסֶד לָאֲלָפִים׃</tei:l> <tei:l>יָדוֹ פְּשׁוּטָה לִתְשׁוּבַת צוֹלֵעָה וְנִחְלָאָה ·</tei:l> <tei:l>כַּעַס לְהַעֲבִיר וּלְשַׂגְּבָהּ מֵעִנּוּי וּתְלָאָה׃</tei:l> <tei:l>לְכַלֵּה עָוֹן וּלְהָתֵם חַטָּאָה ·</tei:l> <tei:l>נֹשֵׂא עָוֹן וָפֶשַׁע וְחַטָּאָה׃</tei:l> <tei:l>מֵאַשְׁפּוֹת יָרִים רָשׁ וָאִישׁ תְּכָכִים וּמְעֻקָּר ·</tei:l> <tei:l>נוֹפְלִים סוֹמֵךְ וְזוֹקֵף כָּפוּף מְיֻסָּר וְנִלְקֶה ·</tei:l> <tei:l>סְגוּפִים רְעוּנִים מִפְּרִי מַעֲשָׂיו מַשְׂבִּיעַ וּמַשְׁקֶה ·</tei:l> <tei:l>וְנַקֵּה לֹא־יְנַקֶּה׃</tei:l> <tei:l>עוֹרְכֵי מִשְׁפָּטָיו יְשָׁרִים נְכוֹחִים <tei:pb n="144" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n289_medium.jpg"/>וּנְכוֹנִים ·</tei:l> <tei:l>פַּעֲמַיִם שָׁלֹשׁ מוֹרֶה מְלַמֵּד וּמַסְבִּיר פָּנִים ·</tei:l> <tei:l>צִדְקָתוֹ לָעַד וּכְרֶגַע בְּאַפּוֹ נְתוּנִים ·</tei:l> <tei:l>פֹּקֵד עֲוֹן אָבוֹת עַל־בָּנִים׃</tei:l> <tei:l>קֶדֶם מֵאָז תּוֹרָה וּתְשׁוּבָה הָנְעִים ·</tei:l> <tei:l>רְפֻאוֹת וּתְעָלָה וְחַיֵּי־עוֹלָם לְשָׁבֵי פְשָׁעִים ·</tei:l> <tei:l>שַׁלִּים שׂוֹנְאָיו לְמִצְעָר וְלִבְנֵיהֶם רַק לְבַד לְהָרֵעִים ·</tei:l> <tei:l>עַל־שִׁלֵּשִׁים וְעַל־רִבֵּעִים׃</tei:l> <tei:l>תּוֹחַלְתֵּנוּ תִּקְוָתֵנוּ סִבְרֵנוּ וַחֲסוּי נַפְשֵׁנוּ ·</tei:l> <tei:l>יֵאָמְנוּ צִדְקוֹתֶיךָ אֲשֶׁר־בָּם מִבְטָחֵנוּ ·</tei:l> <tei:l>חַסְדֵי קַדְמוֹנִים זְכֹר וּמִלְּפָנֶיךָ רֵיקָם אַל־תְּשִׁיבֵנוּ ·</tei:l> <tei:l>וּסְלַחְתָּ לַעֲוֹנֵנוּ וּלְחַטָּאתֵנוּ׃</tei:l> <tei:l>שִׁבְטְךָ וּמִשְׁעַנְתְּךָ דָּר מְרוֹמִים ·</tei:l> <tei:l>יֵדְעוּ וְיִנָּחֲמוּ מְעוּטֵי־עַמִּים ·</tei:l> <tei:l>וְתַעֲלֶה תַּחֲנָתֵנוּ מִמְּרוֹמִים ·</tei:l> <tei:l>אֵל מֶלֶךְ יוֹשֵׁב עַל־כִּסֵּא רַחֲמִים׃</tei:l> </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
