      <tei:div corresp="urn:x-opensiddur:text:poem:eshet_neurim_haahuvah">
        <tei:pb n="128" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n257_medium.jpg"/>
        <tei:lg><tei:l>אֵשֶׁת נְעוּרִים הָאֲהוּבָה ·</tei:l> <tei:l>אֲשֶׁר אֵרַסְתָּ בְּרוֹב מוֹהַר וּבְרוֹב טוֹבָה ·</tei:l> <tei:l>וְאֵיךְ עַתָּה יוֹשֶׁבֶת עֲלוּבָה ·</tei:l> <tei:l>גְּעוּלָה מְאוּסָה וַעֲזוּבָה ·</tei:l> <tei:l>לְבוּשָׁה בַּעֲדִי עֲדָיִם ·</tei:l> <tei:l>אֲשֶׁר הִתְנִיתָה בִבְרִית וּבִתְנָאִים וְאֵיךְ עַתָּה סוֹבֶבֶת דְּלָתַיִם ·</tei:l> <tei:l>וְשׁוֹכֶבֶת בֵּין שְׁפַתָּיִם׃</tei:l> <tei:l>חֲבוּשָׁה בְּשֵׁשׁ וּמֶשִׁי כְּלוּלָה ·</tei:l> <tei:l>הִיא הָיְתָה בְּכָל־הָאָרֶץ מְהֻלָּלָה ·</tei:l> <tei:l>וְאֵיךְ עַתָּה נֶחֱשֶׁבֶת מְחֻלָּלָה ·</tei:l> <tei:l>לְלַעַג וּלְבֹשֶׁת וְלִקְלָלָה׃</tei:l> <tei:l>נוֹת פְּעָמִים בִּנְעָלֶיהָ ·</tei:l> <tei:l>אֲשֶׁר כְּנָפֶיךָ פְּרוּסִים עָלֶיהָ ·</tei:l> <tei:l>וְאֵיךְ עַתָּה נִגְּפוּ רַגְלֶיהָ ·</tei:l> <tei:l>עַל הֶהָרִים אַחֲרֵי עוֹלָלֶיהָ׃</tei:l> <tei:l>נָא יֹשֵׁב הַכְּרוּבִים ·</tei:l> <tei:l>תֵּרָא בְּכָל־זֹאת לֹא פָנְתָה אֶל־רְהָבִים ·</tei:l> <tei:l>וְלֹא עַל־פָּרָשִׁים וְרוֹכְבִים ·</tei:l> <tei:l>כִּי עַל־רַחֲמֶיךָ הָרַבִּים׃</tei:l> </tei:lg>
