      <tei:div corresp="urn:x-opensiddur:text:poem:im_amri_eshkeha_mar_sihi">
        <tei:pb n="39" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n79_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אִם אָמְרִי אַשְׁכְּחָה מָרֵי שִׂיחִי ·</tei:l> <tei:l>הוּגוֹת דַּאֲגַת הוֹגִיוֹן־נַפְשִׁי לְהַשִּׂיחִי ·</tei:l> <tei:l>בְּלִי נוּחַ עֶצֶב לְמוֹתֵר מַטְרִיחִי ·</tei:l> <tei:l>שַׁחוֹתִי עַד־מְאֹד וַתִּקְצַר רוּחִי׃</tei:l> <tei:l>גִּישׁוֹת צָרוֹת כְּרוֹג שְׁתַּיִם שְׁתַּיִם ·</tei:l> <tei:l>רֶוַח אֵין בֵּינְתַיִם מְעִיקוֹת כִּנְחֻשְׁתַּיִם ·</tei:l> <tei:l>דּוֹבְקוֹת דּוֹלְקוֹת בְּלִי־עֲצַלְתַּיִם ·</tei:l> <tei:l>קָץ הַמֵּצַר כּוֹר שָׁחוּק וּמְצִלְתַּיִם׃</tei:l> <tei:l>הִרְכַּבְתָּ אֱנוֹשׁ לְרֹאשׁ עַמְּךָ חוֹרֵשׁ עַל־גַּבָּם ·</tei:l> <tei:l>צֵאת לִרְוָיָה צוֹעֲקִים אֵלֶיךָ מִשְׂגַּבָּם ·</tei:l> <tei:l>וְתַרְבֶּינָה שַׂרְעַפּוֹתָיו כָּל־הַיּוֹם בְּקִרְבָּם ·</tei:l> <tei:l>פָּארָתָיו תֶּאֱרַכְנָה וְיָשֻׁב וְיַהֲפוֹךְ בָּם׃</tei:l> <tei:l>זָעוּ דַּלּוּ נָעוּ מֵאֱנוֹשׁ מוֹשִׁיעִים ·</tei:l> <tei:l>עָתְקוּ גַּם גָּבְרוּ חֵיל־רְשָׁעִים ·</tei:l> <tei:l>חָדְלוּ פְרָזוֹן וְלֹא נִכָּרִים שׁוֹעִים ·</tei:l> <tei:l>סֵפֶר תַּנְחוּמֶיךָ לְמָרַת־נֶפֶשׁ שַׁעֲשׁוּעִים׃</tei:l> <tei:l>טוֹפְלִים שֶׁקֶר תַּרְמִית־לִבָּם לְהַסְבִּיר ·</tei:l> <tei:l>נוֹשְׂאִים הֶבֶל פְּיִצַת־פִּימוֹ לְהַגְבִּיר ·</tei:l> <tei:l>יוֹצְרֵי עָמָל עֲלֵי־חֹק לְהַכְבִּיר ·</tei:l> <tei:l>מְצִיקִים צוֹרְרִים עַמְּךָ מִמְּךָ לְהַעֲבִיר׃</tei:l> <tei:l>כּוֹנְנוּ לְהַשְׁחִית בָּנִים לַאֲבִיהֶם ·</tei:l> <tei:l>לֹא־תֶחֱשֶׁה לְעַנּוֹתָם וּלְכַלּוֹתָם בְּאֶרֶץ־אוֹיְבֵיהֶם ·</tei:l> <tei:l>שְׁלַמָה הָיוֹת קְוֶיךָ מִרוּדֵי נְוֵיהֶם ·</tei:l> <tei:l>יְעוֹרְרוּ גְאוּלִים הָאוֹת לְקִרְיַת־מוֹעֲדֵיהֶם׃</tei:l> <tei:l>אַדְמַת קֹדֶשׁ מָקוֹם <tei:pb n="40" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n81_medium.jpg"/>דְּבִירְךָ נַחֲלֵנוּ ·</tei:l> <tei:l>בְּקוֹל־תּוֹדָה וְרִנָּה הָמוֹן חוֹגְגֵנוּ ·</tei:l> <tei:l>זִבְחֵי־צֶדֶק נַקְרִיב לְךָ מִגַּנֵּנוּ ·</tei:l> <tei:l>אֲמָרֵנוּ הַאֲזִינָה יְיָ בִּינָה הֲגִיגֵנוּ׃</tei:l> </tei:lg>
      </tei:div>
