      <tei:div corresp="urn:x-opensiddur:text:poem:ein_kemidat_basar_midotekha">
        <tei:pb n="38" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n77_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אֵין כְּמִדַּת בָּשָׂר מִדּוֹתֶךָ ·</tei:l> <tei:l>אַיֵּה קִנְאָתְךָ וַעֲצַת עֲמִידָתֶךָ ·</tei:l> <tei:l>בַּת בֵּרַרְתָּ לְבֵית חֶמְדָּתֶךָ ·</tei:l> <tei:l>בְּעָלֶיהָ אֲדוֹנִים וְאֵין לְצְמִיתָתֶךָ ·</tei:l> <tei:l>גּוֹעָה לְדוֹדִי אֲנִי מְאוֹרֶסֶת ·</tei:l> <tei:l>גּוֹעֵל רוֹדִי אֵיךְ נִדְרֶסֶת ·</tei:l> <tei:l>דִּין הֶרֶג לְעַצְמָהּ מְקַנֶּסֶת ·</tei:l> <tei:l>דְּחוּיָה וְגַם כִּי־נֶאֱנֶסֶת׃</tei:l> <tei:l>הָאֵם בְּלִי סֵפֶר לְשִׁלּוּחַ ·</tei:l> <tei:l>הַבֵּן כְּיָתוֹם אוֹבֵד שָׁלוֹחַ ·</tei:l> <tei:l>וְגַן־נָעוּל הֶפְקֵר כַּמְלוֹחַ ·</tei:l> <tei:l>וּמַעְיַן חָתוּם נִרְפַּס דָּלוּחַ׃</tei:l> <tei:l>זַעַם כְּרֶגַע וְעַתָּה לַהֲפוֹךְ ·</tei:l> <tei:l>זְרִי־קֹדֶשׁ חוּצָה לִשְׁפּוֹךְ ·</tei:l> <tei:l>חִבַּת־רֵעַ כְּקֶרֶץ־הָפוּךְ ·</tei:l> <tei:l>חֲשׁוּבָה עֲזוּבָה כְּקוֹרַעַת כְּפוּךְ׃</tei:l> <tei:l>טוֹב הַתּוֹאַר קְדוֹרָנִית מֻפְרָךְ ·</tei:l> <tei:l>טְרִיָּה מַכָּה מִבְּלִי־אֹרֶךְ ·</tei:l> <tei:l>יוֹם נָקָם נִסְתַּם דַּרְךְ ·</tei:l> <tei:l>יוֹם שָׁלוֹם נֶחְתַּם חָרְךְ׃</tei:l> <tei:l>כֹּחַ הַסַּבָּל הִכְשִׁיל נָטַל ·</tei:l> <tei:l>כָּסוּל וְשָׁכוּל הַנִּשְׁאָר מִקֶּטֶל ·</tei:l> <tei:l>לֹא לְמַרְגּוֹעַ נָד וּמִטַּלְטֵל ·</tei:l> <tei:l>לְעָמָל וִיגַע וְאַחַר נוֹטֵל׃</tei:l> <tei:l>מַטַּע קֶרֶן שֶׁמֶן הֻמְרְשָׁן ·</tei:l> <tei:l>מִרְמַס מַדּוּעַ כְּחָרוּלֵי־כִבְשָׁן ·</tei:l> <tei:l>נוֹצֵר לְמַעְלָה לֹא יִישָׁן ·</tei:l> <tei:l>נִטְעוּ לְמָשְׁלָה פָרוֹת הַבָּשָׁן׃</tei:l> <tei:l>שׂוֹרֵקָה מַה־בֶּצַע וְנִקְטֶפֶת ·</tei:l> <tei:l>סוֹרַחַת מַה־יִתְרוֹן וְנֶחְטֶפֶת ·</tei:l> <tei:l>עֲלֵי־יָד חֲקוּקָה וּמְטוּטֶפֶת עַל־מָה אַהֲבָתָהּ נִשְׁמֶטֶת׃</tei:l> <tei:l>פְּעֻלַּת הָרוּכִים בְּמִעוּט־מְלֶאכֶת ·</tei:l> <tei:l>פְּרִיעַת שָׂכָר רַבָּה וְהוֹלֶכֶת ·</tei:l> <tei:l>צוֹפָה הַפָּנוֹת וְעַתָּה נִמְשֶׁכֶת ·</tei:l> <tei:l>צָרָה פְקוּדָה וְאַחֶרֶת נִסְמֶכֶת׃</tei:l> <tei:l>קֹדֶשׁ רֵאשִׁית עֲרֵמַת־שְׁעֹרִים ·</tei:l> <tei:l>קְצָוֵי אֶרֶץ זְרוּיִם כִּשְׂעוֹרִים ·</tei:l> <tei:l>רוּחַ מְנַשֶּׁבֶת בַּעֲלֵי־יְעָרִים ·</tei:l> <tei:l>רָדוּף נִשְׁמַטַת נְכָסִים וּנְסָעֲרִים׃</tei:l> <tei:l>שְׁמֹנֶה וְתִשְׁעִים הָאָלוֹת הָאֵלֶּה ·</tei:l> <tei:l>שִׁלְּמוּ אֵלֶּה מֵאֵלֶּה <tei:pb n="39" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n79_medium.jpg"/>וְכָאֵלֶּה ·</tei:l> <tei:l>תְּרַחֵם תְּקַבְּצֵנוּ מִקַּרְנוֹת אֵלֶּה ·</tei:l> <tei:l>אָז יֹאמְרוּ בַגּוֹיִם הִגְדִּיל יְיָ לַעֲשׂוֹת עִם־אֵלֶּה׃</tei:l> </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
