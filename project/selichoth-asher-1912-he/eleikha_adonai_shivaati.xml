      <tei:div corresp="urn:x-opensiddur:text:poem:eleikha_adonai_shivaati">
        <tei:pb n="132" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n265_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אֵלֶיךָ יְיָ שִׁוַּעְתִּי ·</tei:l> <tei:l>בְּתַחַן פָּנֶיךָ קִדַּמְתִּי ·</tei:l> <tei:l>גּוֹדֶל רַחֲמֶיךָ נִסְמַכְתִּי ·</tei:l> <tei:l>אֱלֹהַי בְּךָ בָּטַחְתִּי׃</tei:l> <tei:l>דְּרָכֶיךָ יְיָ הוֹדִיעֵנִי ·</tei:l> <tei:l>הַדְרִיכֵנִי בַאֲמִתֶּךָ וְלַמְּדֵנִי ·</tei:l> <tei:l>וּנְתִיב מִצְוֹתֶיךָ יַדְּעֵנִי ·</tei:l> <tei:l>אֱלֹהַי אַל תִּרְחַק מִמֶּנִּי׃</tei:l> <tei:l>זְכֹר רַחֲמֶיךָ וַחֲסָדֶיךָ יְיָ ·</tei:l> <tei:l>חַנּוּן לְךָ נָשָׂאתִי עֵינִי ·</tei:l> <tei:l>טוֹבָה קִוִּיתִי יְיָ ·</tei:l> <tei:l>הַאֲזִינָה יְיָ קוֹל־תַּחֲנוּנָי׃</tei:l> <tei:l>יָהּ שִׂיחִי לְפָנֶיךָ יֶעֱרַב ·</tei:l> <tei:l>כְּכָלִיל אֲשֶׁר בְּמִזְבַּחֲךָ נִקְרַב ·</tei:l> <tei:l>לְפָנֶיךָ תַּחֲנוּנַי תִּקְרַב ·</tei:l> <tei:l>וְסָלַחְתָּ לַעֲוֹנִי כִּי־רָב׃</tei:l> <tei:l>מַה־נֹּאמַר לְפָנֶיךָ אֲדוֹן נִשְׁמָתֵנוּ ·</tei:l> <tei:l>נִכְלַמְנוּ מְאֹד בַּעֲוֹנֵנוּ ·</tei:l> <tei:l>סְלַח־נָא לְכָל־אַשְׁמָתֵינוּ ·</tei:l> <tei:l>תַשְׁלִיךְ בִּמְצוּלוֹת יָם כָּל־חַטֹּאתֵינוּ׃</tei:l> <tei:l>עֲצוֹר חֲמָתְךָ וְאַל־נָא תֶחֱרֶה ·</tei:l> <tei:l>פּוֹעֵל־הַכֹּל יוֹצֵר וּבוֹרֵא ·</tei:l> <tei:l>צֶדֶק דֶּרֶךְ־תְּשׁוּבָה לָנוּ הוֹרֵה ·</tei:l> <tei:l>כִּי עִמְּךָ הַסְּלִיחָה לְמַעַן תִּוָּרֵא׃</tei:l> <tei:l>קוֹלֵנוּ תִשְׁמַע יוֹשֵׁב כְּרוּבִים ·</tei:l> <tei:l>רַחֲמָן גְּמוֹל־טוֹבָה לְחַיָּבִים ·</tei:l> <tei:l>שֶׁלֹּא עַל־צִדְקוֹתֵינוּ תַחַן מַרְבִּים ·</tei:l> <tei:l>כִּי עַל רַחֲמֶיךָ הָרַבִּים׃</tei:l> <tei:l>תַּעֲבִיר חֵטְא וְתִמְחֶה פְשָׁעִים ·</tei:l> <tei:l>זְדוֹנוֹת וּשְׁגָגוֹת סְתָרִים וִידוּעִים ·</tei:l> <tei:l>בַּטֵּל מִמֶּנּוּ מַחְשְׁבוֹת שׂוֹנְאֵינוּ וָחֳלָיִם רָעִים ·</tei:l> <tei:l>מַרְבֶּה מְחִילָה לְחַטָּאִים וּסְלִיחָה לְפוֹשְׁעִים׃</tei:l> <tei:l>דַּלֵּנוּ מֵחֵטְא <tei:pb n="133" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n267_medium.jpg"/>נַקֵּנוּ מֵאֲשָׁמִים ·</tei:l> <tei:l>יוֹדֵעַ כָּל־סִתְרֵי־נֶעְלָמִים ·</tei:l> <tei:l>הֲגִיגֵנוּ שְׁעֵה כְּעוֹלוֹת וּשְׁלָמִים ·</tei:l> <tei:l>אֵל מֶלֶךְ יוֹשֵׁב עַל־כִּסֵּא רַחֲמִים׃</tei:l> </tei:lg>
