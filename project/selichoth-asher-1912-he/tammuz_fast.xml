            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div>
            <tei:milestone unit="prayer" corresp="urn:x-opensiddur:text:siddur:selichot/tammuz_fast/verses_after_elohim/expanded"/>
            <tei:p><j:transclude target="urn:x-opensiddur:text:prayer:keraham_av" type="inline"/> <j:transclude target="urn:x-opensiddur:text:prayer:selichot/ki_lo_al_tsidqotenu" type="inline"/> </tei:p>
            <tei:milestone unit="prayer"/>
          </tei:div>
          <j:endConditional target="#penitential_tammuz-fast_day_verses_after_elohim_expanded"/>
        </tei:div>
        <j:transclude target="urn:x-opensiddur:text:poem:amerer_bivekhi_mippenei_yad_shalehah"/>
