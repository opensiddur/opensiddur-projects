          <j:transclude target="urn:x-opensiddur:text:prayer:vayaavor"/>
          <j:endConditional target="#penitential_tammuz-fast_day_pair_after_atanu_expanded"/>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tammuz_fast/elohim_al_domi">
          <tei:pb n="185" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n371_medium.jpg"/>
          <tei:p>אֱלֹהִים אַל־דֳּמִי לָךְ · אַל־תֶּחֱרַשׁ וְאַל תִּשְׁקֹט אֵל׃ כִּי הִנֵּה אוֹיְבֶיךָ יֶהֱמָיוּן וּמְשַׂנְאֶיךָ נָשְׂאוּ רֹאשׁ׃ אֵל נְקָמוֹת יְיָ · אֵל נְקָמוֹת הוֹפִיעַ׃ </tei:p>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tammuz_fast/verses_after_elohim">
          <j:conditional xml:id="penitential_tammuz-fast_day_verses_after_elohim_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tammuz_fast/verses_after_elohim/printed">
            <tei:pb n="185" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n371_medium.jpg"/>
            <tei:note type="instruction" xml:lang="he">כרחם אב · ליי הישועה · יי צבאות עמנו · יי צבאות אשרי · יי הושיעה · כי לא על · יי שמעה׃ </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_tammuz-fast_day_verses_after_elohim_printed"/>
