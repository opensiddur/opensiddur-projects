            <tei:pb n="185" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n371_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say <tei:foreign xml:lang="he">אֵל מֶלֶךְ</tei:foreign> and <tei:foreign xml:lang="he">וַיַּעֲבֹר</tei:foreign> </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_tammuz-fast_day_pair_after_atanu_printed"/>
          <j:conditional xml:id="penitential_tammuz-fast_day_pair_after_atanu_expanded">
