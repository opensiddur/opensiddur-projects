    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:elohim_adonai_heli_yotseri_umeholeli">
        <tei:pb n="133" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n267_medium.jpg"/>
        <tei:lg><tei:l>אֱלֹהִים אֲדֹנָי חֵלִי ·</tei:l> <tei:l>יוֹצְרִי וּמְחוֹלְלִי ·</tei:l> <tei:l>לְךָ אֲנִי וְכָל־אֲשֶׁר־לִי ·</tei:l> <tei:l>בְּסַאֲסְאָה אַל־תָּרִיב ·</tei:l> <tei:l>פֶּן תַּשְׁחִית וְתַחֲרִיב ·</tei:l> <tei:l>נֶפֶשׁ כִּי־תַקְרִיב ·</tei:l> <tei:l>גַּרְדּוֹם לָדוּן ·</tei:l> <tei:l>רֵאשִׁית מָדוֹן ·</tei:l> <tei:l>אֵשׁ הִיא עַד־אֲבַדּוֹן׃</tei:l> <tei:l>דְּרָכַי וְסַכַּנְתָּ ·</tei:l> <tei:l>עֲלֻמַי לָאוֹר שַׁתָּה ·</tei:l> <tei:l>אַל־תַּחֲרִידֵנִי לִמְחִתָּה׃</tei:l> <tei:l>הֲלִיכוֹת לוֹ עוֹלָם ·</tei:l> <tei:l>הֵן עַל־כָּל־נֶעְלָם ·</tei:l> <tei:l>אַל־יָשֹׁב דַּךְ נִכְלָם׃</tei:l> <tei:l>וְכִי רַבּוּ מְשׁוּבוֹתָי ·</tei:l> <tei:l>לֵב הוּתַל בְּמַחְשְׁבוֹתָי ·</tei:l> <tei:l>כִּי לֹא־מַחְשְׁבוֹתָי׃</tei:l> <tei:l>זִמּוֹתַי הַכֹּל הֶבֶל ·</tei:l> <tei:l>כְּכָל־מַעֲשֵׂה תֵבֵל ·</tei:l> <tei:l>נֶפֶשׁ הוּא חוֹבֵל׃</tei:l> <tei:l>חוֹשֵׁב מַאֲוַיֵּי לְסַפֵּק ·</tei:l> <tei:l>קוֹל דּוֹדִי דּוֹפֵק ·</tei:l> <tei:l>זְמָמוֹ אַל־תָּפֵק׃</tei:l> <tei:l>טָהוֹר יְצִירְךָ עָשִׂיתוֹ ·</tei:l> <tei:l>וְרוֹעַ לֵב מְסִיתוֹ ·</tei:l> <tei:l>כִּי תִרְאֶה עָוֹן וְכִפִּיתוֹ׃</tei:l> <tei:l>יְשׁוּעָתְךָ לְנַפְשִׁי אֱמֹר ·</tei:l> <tei:l>הַאִם־תַּמְנוּ לִגְמוֹר ·</tei:l> <tei:l>אִם־עֲוֹנוֹת תִּשְׁמוֹר׃</tei:l> <tei:l>כָּלוּ בַהֶבֶל יָמַי ·</tei:l> <tei:l>וּמִכּוֹבֶד אַשְׁמַי ·</tei:l> <tei:l>נִבְהֲלוּ עֲצָמַי׃</tei:l> <tei:l>לַבֵּן אֲדַמִּים ·</tei:l> <tei:l>הַמְּאָוּתָר וְהַמּוּקָם ·</tei:l> <tei:l>יֵצֶר לֵב הָאָדָם׃</tei:l> <tei:l>מִשַּׁשְׁתָּ אֶת־כָּל־חַדְרֵי לֵב עָקוֹל ·</tei:l> <tei:l>מַה־מָּצָאתָ מִכֹּל׃</tei:l> <tei:l>נוֹעַם הֲפָכְךָ בִּי ·</tei:l> <tei:l>טָמוּן עָוֹן בְּחוּבִּי ·</tei:l> <tei:l>חַם לִבִּי <tei:pb n="134" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n269_medium.jpg"/>בְּקִרְבִּי׃</tei:l> <tei:l>סְמוֹךְ נַפְשִׁי מִפַּחַת ·</tei:l> <tei:l>וּמַה־בֶּצַע לָקַחַת ·</tei:l> <tei:l>בְּרִדְתִּי אֶל־שָׁחַת׃</tei:l> <tei:l>עָלַי בְּרַחֲמִים שׁוּב ·</tei:l> <tei:l>כִּי בַמֶּה חָשׁוּב ·</tei:l> <tei:l>רוּחַ הוֹלֵךְ וְלֹא־יָשׁוּב׃</tei:l> <tei:l>פְּצָעַי לְפִי פְשָׁעַי ·</tei:l> <tei:l>וְשַׂק וָאֵפֶר מַצָּעַי ·</tei:l> <tei:l>עַל־כֵּן הָמוּ מֵעַי׃</tei:l> <tei:l>צוּקוֹת עִם צָרוֹת ·</tei:l> <tei:l>אֲשֶׁר הֵנָּה חוֹבְרוֹת ·</tei:l> <tei:l>לֹא יָדַעְתִּי סְפָרוֹת׃</tei:l> <tei:l>קְשֵׁה רוּחַ אֲנִי ·</tei:l> <tei:l>הֲלֹא תִרְאֶה בְעָנְיִי ·</tei:l> <tei:l>כִּי־תְבַקֵּשׁ לַעֲוֹנִי׃</tei:l> <tei:l>רַחַשׁ לְךָ יֶעֱרַב ·</tei:l> <tei:l>וּלְפָנֶיךָ תִּקְרַב ·</tei:l> <tei:l>וְנִקֵּיתִי מִפֶּשַׁע רָב׃</tei:l> <tei:l>שָׁבֵי פֶשַׁע תְּנַקֶּה ·</tei:l> <tei:l>בְּלֵב נִשְׁבָּר וְנִדְכֶּה ·</tei:l> <tei:l>אִם־יִתְמַהְמָהּ חַכֵּה׃</tei:l> <tei:l>תְּשׁוּבָתוֹ הַצְפֵּה ·</tei:l> <tei:l>וְעַל־חֲטָאָיו תְּחַפֶּה ·</tei:l> <tei:l>לְשָׂטָן בַּסֵּתֶר יִכְפֶּה׃</tei:l> <tei:l>אֵל עָוֹן וָחֵטְא נָשָׂא ·</tei:l> <tei:l>אִם־כְּפִשָּׂה יִפְשֶׂה ·</tei:l> <tei:l>וְעָשִׂיתָ מִכְסֶה׃</tei:l> <tei:l>פְּדֵנוּ מֵעָבוֹר בְּשָׁלַח ·</tei:l> <tei:l>לְפָנֶיךָ תְּפִלָּתִי תִצְלַח ·</tei:l> <tei:l>יְיָ טוֹב וְסַלָּח׃</tei:l> <tei:l>רוֹן תְּפִלָּתִי תִשְׁעֶה ·</tei:l> <tei:l>וּמְחֵה כָעָב פֶּשַׁע ·</tei:l> <tei:l>כִּי לֹא אֵל חָפֵץ רֶשַׁע׃</tei:l> <tei:l>יִגְמְלֵנִי יְיָ כְּצִדְקוֹ ·</tei:l> <tei:l>תָּמִיד יִצְפְּנֵנִי בְסֻכּוֹ ·</tei:l> <tei:l>הָאֵל תָּמִים דַּרְכּוֹ׃</tei:l> <tei:l>מֵעוֹמֶק בּוֹר קְרָאתִיךָ ·</tei:l> <tei:l>מִכְּאֵב־לֵב שִׂחַתִּיךָ ·</tei:l> <tei:l>כִּי־זָכוֹר זְכַרְתִּיךָ׃</tei:l> <tei:l>בְּרַחֲמֶיךָ תִּלְבּוֹשׁ ·</tei:l> <tei:l>וְאֶת־חֲטָאַי תִּכְבּוֹשׁ ·</tei:l> <tei:l>וְאֵדַע כִּי לֹא־אֵבוֹשׁ׃</tei:l> <tei:l>רַבִּים אֹמְרִים לְנַפְשִׁי ·</tei:l> <tei:l>בָּאֵפֶר הִתְפַּלָּשִׁי ·</tei:l> <tei:l>וְלֹא־תֵצְאִי חָפְשִׁי׃</tei:l> <tei:l>יֶהֱמוּ הֲמוֹן מֵעֶיךָ ·</tei:l> <tei:l>זְכוֹר חֶסֶד יוֹדְעֶיךָ ·</tei:l> <tei:l>וְלִי מַה־יָּקְרוּ רֵעֶיךָ׃</tei:l> <tei:l>צֵא עַל אוֹיְבֶיךָ כְגִבּוֹר ·</tei:l> <tei:l>זְרוֹעַ רוֹדְפַי תִשְׁבּוֹר ·</tei:l> <tei:l>כִּי שָׂמוּ אֹתִי בַבּוֹר׃</tei:l> <tei:l>הֲצִיצְךָ פְּרִים תְּכַלֶּה ·</tei:l> <tei:l>אֲסִירֶיךָ מֵהֶם תַּעֲלֶה ·</tei:l> <tei:l>וְיִחְיוּ דְבָרַי אֵלֶּה ·</tei:l> <tei:l>קְרוֹבִים וְעָרֵבִים ·</tei:l> <tei:l>אֲהוּבִים וַחֲבִיבִים ·</tei:l> <tei:l>יְיָ צְבָאוֹת יוֹשֵׁב הַכְּרוּבִים׃</tei:l> </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
