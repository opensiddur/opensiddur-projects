      <tei:div corresp="urn:x-opensiddur:text:poem:elohim_beyisrael_gadol_nodata">
        <tei:pb n="161" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n323_medium.jpg"/>
        <tei:lg><tei:l>אֱלֹהִים בְּיִשְׂרָאֵל גָּדוֹל נוֹדָעַתָּ ·</tei:l> <tei:l>אַתָּה יְיָ עָזְרֵנוּ אַתָּה ·</tei:l> <tei:l>בְּכָל־קָרְאֵנוּ אֵלֶיךָ קָרוֹב ·</tei:l> <tei:l>רָם וְנִשָּׂא אָנָּה <tei:pb n="162" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n325_medium.jpg"/>בְּקִרְבֵּנוּ׃</tei:l> <tei:l>גְּמַלְתָּנוּ הַטּוֹבוֹת בְּחוֹבֵנוּ ·</tei:l> <tei:l>לֹא־בְצִדְקוֹתֵינוּ וּבְיוֹשֶׁר לְבָבֵנוּ׃</tei:l> <tei:l>הוֹרֵנוּ גַּם כִּי־זָנַחְנוּ ·</tei:l> <tei:l>גְּאָלֵנוּ כִּי עֲבָדִים אֲנָחְנוּ׃</tei:l> <tei:l>חָנֵּנוּ בַּעֲוֹנֵינוּ עַד־הָכָא ·</tei:l> <tei:l>וְהַקְצַר נֶפֶשׁ לְךָ מְחַכָּה׃</tei:l> <tei:l>וְאַיֵּה חֲסָדֶיךָ הָרִאשׁוֹנִים עִמָּנוּ ·</tei:l> <tei:l>מֵעוֹלָם עַד־עוֹלָם נֶאֱמָנוּ׃</tei:l> <tei:l>זַעַף נָשָׂא וְהָתֵשׁ כֹּחֵנוּ ·</tei:l> <tei:l>יְיָ אַל־בְּאַפְּךָ תוֹכִיחֵנוּ׃</tei:l> <tei:l>חַלְחָלוֹת רַבּוֹת כָּלוּ בְשָׂרֵנוּ ·</tei:l> <tei:l>נָא אַל בַּחֲמָתְךָ תְיַסְּרֵנוּ׃</tei:l> <tei:l>טֹרַח הַצָּרוֹת אֵין לְהִסָּפֵר ·</tei:l> <tei:l>אַיֵּה שׁוֹקֵל וְאַיֵּה סוֹפֵר ·</tei:l> <tei:l>יָדַעְנוּ רִשְׁעֵנוּ כִּי פָשָׁעְנוּ ·</tei:l> <tei:l>כִּי אֱמֶת עָשִׂיתָ וַאֲנַחְנוּ הִרְשָׁעְנוּ׃</tei:l> <tei:l>כַּעַס וְחָרוֹן מֶנּוּ יֶחְדַּל ·</tei:l> <tei:l>כִּי קָטֹן יַעֲקֹב וָדָל ·</tei:l> <tei:l>לַחַץ יוּסַר וְעוֹל מֶנּוּ יֶחְבַּל ·</tei:l> <tei:l>כִּי כָשַׁל כֹּחַ הַסַּבָּל׃</tei:l> <tei:l>מְנַת מְרֻתֵנוּ לֹא־תִגְבֶּה ·</tei:l> <tei:l>כִּי נִשְׁאַרְנוּ מְעַט מֵהַרְבֵּה ·</tei:l> <tei:l>נָחֵם עַל הָרָעָה לַאֲמָתֶךָ ·</tei:l> <tei:l>מַטֵּה כְּלַפֵּי חֶסֶד אֱמוּנָתֶךָ׃</tei:l> <tei:l>סְלָחָה אִם־עֲוֹנֵינוּ עָנוּ בָנוּ ·</tei:l> <tei:l>עָזְרֵנוּ כִּי־עָלֶיךָ נִשְׁעָנוּ׃</tei:l> <tei:l>עָרְפֵנוּ כוֹף לְךָ לְהִשְׁתַּעְבֵּד ·</tei:l> <tei:l>בְּאַהֲבָה וּבְיִרְאָה אוֹתְךָ לַעֲבוֹד יְלַבֵּב׃</tei:l> <tei:l>פוֹקְדֵיךָ קִדְּשׁוּ צוֹמוֹת לִקְבּוֹעַ ·</tei:l> <tei:l>וְדַעְתָּם קְצָרָה צָרְכָּם לִתְבּוֹעַ ·</tei:l> <tei:l>צָקוּן לַחֲשָׁם אֵלֶיךָ תָּבֹא ·</tei:l> <tei:l>הָתֵל לְאִישׁ אִישׁ נִגְעוֹ וּמַכְאוֹבוֹ׃</tei:l> <tei:l>קוֹל יַעֲקֹב נוֹהֵם מִתְּהוֹמוֹתֶיךָ ·</tei:l> <tei:l>תִּשְׁמַע הַשָּׁמַיִם מְכוֹן שִׁבְתְּךָ ·</tei:l> <tei:l>רוֹדֶה רוֹדֵף בְּאַף תְּכַלֶּה ·</tei:l> <tei:l>שְׁנַת שִׁלּוּמִים לְרִיב צִיּוֹן תְּגַלֶּה׃</tei:l> <tei:l>שַׁת וָרֶדֶת מִנֹּעַר קְנוֹתֵנוּ ·</tei:l> <tei:l>וְאַל־תַּשְׁלִיכֵנוּ לְעֵת זִקְנָתֵנוּ׃</tei:l> <tei:l>תָּעִינוּ לִשְׂמֹאל וִימִינְךָ יְקָרְבֵנוּ ·</tei:l> <tei:l>כִּכְלוֹת כֹּחֵנוּ אַל־תַּעַזְבֵנוּ׃</tei:l> <tei:l>תַּבִּיט וְתָצִיץ וְתַשְׁגִּיחַ לְחוּמֶךָ ·</tei:l> <tei:l>תִּתְאוֹר בַּחֲנִינוֹתֶךָ תִּתְלַבֵּשׁ <tei:pb n="163" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n327_medium.jpg"/>בְּצִדְקוֹתֶיךָ ·</tei:l> <tei:l>תִּתְכַּסֶּה בְּרַחֲמֶיךָ וְתִתְעַטֵּף בַּחֲסִידוּתֶךָ ·</tei:l> <tei:l>וְתָבֹא לְפָנֶיךָ מִדַּת טוּבְךָ וְעַנְוְתָנוּתֶךָ׃</tei:l> </tei:lg>
      </tei:div>
    </tei:body>
