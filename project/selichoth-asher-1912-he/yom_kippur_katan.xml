          </j:conditional>
          <j:transclude target="urn:x-opensiddur:text:prayer:ashrei"/>
          <j:endConditional target="#penitential_yom-kippur-katan_day_ashrei_instruction_expanded"/>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/reader_kaddish">
          <j:conditional xml:id="penitential_yom-kippur-katan_day_reader_kaddish_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
