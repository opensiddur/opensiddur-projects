        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/leeineinu_ashuq">
          <tei:pb n="201" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n403_medium.jpg"/>
          <tei:lg><tei:l>לְעֵינֵינוּ עָשְׁקוּ עֲמָלֵנוּ ·</tei:l> <tei:l>מְמֻשָּׁךְ וּמוֹרָט מִמֶּנּוּ ·</tei:l> <tei:l>נָתְנוּ עֻלָּם עָלֵינוּ ·</tei:l> <tei:l>סָבַלְנוּ עַל־שִׁכְמֵנוּ ·</tei:l> <tei:l>עֲבָדִים מָשְׁלוּ בָנוּ ·</tei:l> <tei:l>פּוֹרֵק אֵין מִיָּדָם ·</tei:l> <tei:l>צָרוֹת רַבּוֹת סְבָבוּנוּ ·</tei:l> <tei:l>קְרָאנוּךָ יְיָ אֱלֹהֵינוּ ·</tei:l> <tei:l>רָחַקְתָּ מִמֶּנּוּ בַּעֲוֹנֵינוּ ·</tei:l> <tei:l>שַׁבְנוּ מֵאַחֲרֶיךָ ·</tei:l> <tei:l>תָּעִינוּ וְאָבַדְנוּ׃</tei:l> <tei:l>וַעֲדַיִן לֹא שַׁבְנוּ מִתְּעֵיתִינוּ ·</tei:l> <tei:l>וְאֵיךְ נָעִיז פָּנֵינוּ וְנַקְשֶׁה עָרְפֵּנוּ ·</tei:l> <tei:l>לוֹמַר לְפָנֶיךָ יְיָ אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ צַדִּיקִים אֲנַחְנוּ וְלֹא חָטָאנוּ ·</tei:l> <tei:l>אֲבָל אֲנַחְנוּ וַאֲבוֹתֵינוּ חָטָאנוּ׃</tei:l> </tei:lg>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/ashamnu_repeat_second">
          <j:conditional xml:id="penitential_yom-kippur-katan_day_ashamnu_repeat_second_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/ashamnu_repeat_second/printed">
            <tei:pb n="201" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n403_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say <tei:foreign xml:lang="he">אָשַׁמְנוּ</tei:foreign> as in the preceding page. </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_yom-kippur-katan_day_ashamnu_repeat_second_printed"/>
