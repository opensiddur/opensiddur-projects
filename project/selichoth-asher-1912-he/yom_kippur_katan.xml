        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/psalm_end_instruction">
          <tei:pb n="202" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n405_medium.jpg"/>
          <tei:note type="instruction" xml:lang="en">If the eve of the New Moon is on Sabbath or Sunday the Psalm in page 190 is said instead of the following— </tei:note>
        </tei:div>
        <j:transclude target="urn:x-opensiddur:text:bible:psalms/8"/>
