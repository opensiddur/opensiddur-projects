          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/ashrei_instruction/printed">
            <tei:pb n="190" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n381_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say <tei:foreign xml:lang="he">אַשְׁרֵי</tei:foreign> </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_yom-kippur-katan_day_ashrei_instruction_printed"/>
