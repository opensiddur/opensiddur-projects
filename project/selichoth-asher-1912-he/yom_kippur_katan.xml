              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/reader_kaddish/printed">
            <tei:pb n="190" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n381_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">The Reader says Kaddish. </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_yom-kippur-katan_day_reader_kaddish_printed"/>
          <j:conditional xml:id="penitential_yom-kippur-katan_day_reader_kaddish_expanded">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div>
            <tei:note type="instruction" xml:lang="en">Reader.</tei:note>
          </tei:div>
          <j:declare xml:id="penitential_yom-kippur-katan_reader_kaddish_kaddish">
            <tei:fs type="asher:selichot">
              <tei:f name="first_day">
