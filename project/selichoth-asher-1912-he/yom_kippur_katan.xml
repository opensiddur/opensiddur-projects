                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:declare>
          <j:transclude target="urn:x-opensiddur:text:prayer:kaddish/chatzi"/>
          <j:endDeclare target="#penitential_yom-kippur-katan_reader_kaddish_kaddish"/>
          <j:endConditional target="#penitential_yom-kippur-katan_day_reader_kaddish_expanded"/>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/torah_amidah_instruction">
          <tei:pb n="190" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n381_medium.jpg"/>
          <tei:note type="instruction" xml:lang="en">[The following instructions are only to be observed if there are ten persons present who fast till night; should there not be, the Ameedah is said immediately after Kaddish. The <tei:foreign xml:lang="he">סֵפֶר תּוֹרָה</tei:foreign> is taken from the Ark, and the portion <tei:foreign xml:lang="he">וַיְחַל</tei:foreign> (see end of volume) is read to three persons; the third person called reads <tei:foreign xml:lang="he">הַפְטָרַת דִּרְשׁוּ</tei:foreign> (see end of volume.) After the <tei:foreign xml:lang="he">סֵפֶר תּוֹרָה</tei:foreign> is returned to the Ark, the congregation say the Ameedah, introducing <tei:foreign xml:lang="he">עֲנֵנוּ</tei:foreign> as on other fast days.] After the repetition thereof by the Reader the following is said— </tei:note>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/lekhu_venashuvah">
          <tei:pb n="190" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n381_medium.jpg"/>
          <tei:p>לְכוּ וְנָשׁוּבָה אֶל יְיָ כִּי הוּא טָרָף וְיִרְפָּאֵנוּ יַךְ וְיַחְבְּשֵׁנוּ׃ יְחַיֵּנוּ מִיֹּמָיִם בַּיּוֹם הַשְּׁלִישִׁי יְקִמֵנוּ וְנִחְיֶה לְפָנָיו׃ כִּי <tei:pb n="191" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n383_medium.jpg"/>לֹא עַל־צִדְקֹתֵינוּ אֲנַחְנוּ מַפִּילִים הַתַּחֲנוּנֵינוּ לְפָנֶיךָ כִּי עַל־רַחֲמֶיךָ הָרַבִּים׃ אֲדֹנָי שְׁמָעָה אֲדֹנָי סְלָחָה אֲדֹנָי הַקְשִׁיבָה וַעֲשֵׂה אַל־תְּאַחַר לְמַעַנְךָ אֱלֹהַי כִּי־שִׁמְךָ נִקְרָא עַל־עִירְךָ וְעַל־עַמֶּךָ׃ </tei:p>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/hashivenu_instruction">
          <tei:pb n="191" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n383_medium.jpg"/>
          <tei:note type="instruction" xml:lang="en">The following verse is said three times by the Minister and Congregation— </tei:note>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/hashivenu">
          <tei:pb n="191" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n383_medium.jpg"/>
          <tei:p>הֲשִׁיבֵנוּ יְיָ אֵלֶיךָ וְנָשׁוּבָה · חַדֵּשׁ יָמֵינוּ כְּקֶדֶם׃ </tei:p>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/pair_after_hashivenu">
          <j:conditional xml:id="penitential_yom-kippur-katan_day_pair_after_hashivenu_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/pair_after_hashivenu/printed">
            <tei:pb n="191" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n383_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say <tei:foreign xml:lang="he">אֵל מֶלֶךְ</tei:foreign> and <tei:foreign xml:lang="he">וַיַּעֲבֹר</tei:foreign> </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_yom-kippur-katan_day_pair_after_hashivenu_printed"/>
          <j:conditional xml:id="penitential_yom-kippur-katan_day_pair_after_hashivenu_expanded">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <j:transclude target="urn:x-opensiddur:text:prayer:el_melekh_yoshev"/>
          <j:transclude target="urn:x-opensiddur:text:prayer:vayaavor"/>
          <j:endConditional target="#penitential_yom-kippur-katan_day_pair_after_hashivenu_expanded"/>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/ana_adonai_elohei_hashamayim">
          <tei:pb n="191" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n383_medium.jpg"/>
          <tei:p>אָנָּא יְיָ אֱלֹהֵי הַשָּׁמַיִם תִּכּוֹן תְּפִלָּתֵנוּ קְטֹרֶת לְפָנֶיךָ׃ וְהוֹצִיא כָאוֹר צִדְקֵנוּ וּמִשְׁפָּטֵנוּ כַּצָּהֳרָיִם׃ אֲמָרֵינוּ הַאֲזִינָה יְיָ בִּינָה הֲגִיגֵנוּ׃ בְּקָרְאֵנוּ עֲנֵנוּ אֱלֹהֵי צִדְקֵנוּ׃ כְּרַחֵם אָב עַל־בָּנִים כֵּן תְּרַחֵם יְיָ עָלֵינוּ׃ לַיְיָ אֱלֹהֵינוּ הָרַחֲמִים וְהַסְּלִיחוֹת כִּי מָרַדְנוּ בוֹ׃ וְסָלַחְתָּ לְעַמְּךָ אֲשֶׁר חָטְאוּ לָךְ וּלְכָל פִּשְׁעֵיהֶם אֲשֶׁר פָּשְׁעוּ בָךְ וּנְתַתָּם לְרַחֲמִים לִפְנֵי שֹׁבֵיהֶם וְרִחֲמוּם׃ וְאַתָּה תִשְׁמַע מִמְּכוֹן שִׁבְתְּךָ הַשָּׁמַיִם וְשָׁמַעְתָּ וְסָלָחְתָּ׃ </tei:p>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/selah_na">
          <tei:pb n="191" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n383_medium.jpg"/>
          <tei:p>סְלַח־נָא לַעֲוֹן הָעָם הַזֶּה כְּגֹדֶל חַסְדֶּךָ וְכַאֲשֶׁר נָשָׂאתָה לָעָם הַזֶּה מִמִּצְרַיִם וְעַד־הֵנָּה · וְשָׁם נֶאֱמַר׃ וַיֹּאמֶר יְיָ סָלַחְתִּי כִּדְבָרֶךָ׃ </tei:p>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/hateh_elohai">
          <tei:pb n="191" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n383_medium.jpg"/>
          <tei:p>הַטֵּה אֱלֹהַי אָזְנְךָ וּשְׁמָע פְּקָחָה עֵינֶיךָ וּרְאֵה שֹׁמְמֹתֵינוּ וְהָעִיר אֲשֶׁר נִקְרָא שִׁמְךָ עָלֶיהָ׃ כִּי לֹא עַל־צִדְקֹתֵינוּ אֲנַחְנוּ מַפִּילִים הַתַּחֲנוּנֵינוּ לְפָנֶיךָ כִּי עַל־רַחֲמֶיךָ הָרַבִּים׃ אֲדֹנָי שְׁמָעָה אֲדֹנָי סְלָחָה אֲדֹנָי הַקְשִׁיבָה וַעֲשֵׂה אַל־תְּאַחַר לְמַעַנְךָ אֱלֹהַי כִּי־שִׁמְךָ נִקְרָא עַל־עִירְךָ וְעַל־עַמֶּךָ׃ </tei:p>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/bracket_instruction">
          <tei:pb n="191" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n383_medium.jpg"/>
          <tei:note type="instruction" xml:lang="en">The verses within brackets are repeated by the Reader and the Congregation— </tei:note>
        </tei:div>
        <j:transclude target="urn:x-opensiddur:text:poem:masat_kappai_minhat_erev"/>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/pair_after_masat">
          <j:conditional xml:id="penitential_yom-kippur-katan_day_pair_after_masat_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/pair_after_masat/printed">
            <tei:pb n="193" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n387_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say <tei:foreign xml:lang="he">אֵל מֶלֶךְ</tei:foreign> and <tei:foreign xml:lang="he">וַיַּעֲבֹר</tei:foreign> </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_yom-kippur-katan_day_pair_after_masat_printed"/>
          <j:conditional xml:id="penitential_yom-kippur-katan_day_pair_after_masat_expanded">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <j:transclude target="urn:x-opensiddur:text:prayer:el_melekh_yoshev"/>
          <j:transclude target="urn:x-opensiddur:text:prayer:vayaavor"/>
          <j:endConditional target="#penitential_yom-kippur-katan_day_pair_after_masat_expanded"/>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/uneshalmah_farim">
          <tei:pb n="193" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n387_medium.jpg"/>
          <tei:p>וּנְשַׁלְּמָה פָרִים שְׂפָתֵינוּ תִּכּוֹן תְּפִלָּתֵנוּ קְטֹרֶת לְפָנֶיךָ מַשְׂאַת כַּפֵּינוּ מִנְחַת עָרֶב׃ יִהְיוּ לְרָצוֹן אִמְרֵי פִינוּ וְהֶגְיוֹן לִבֵּנוּ לְפָנֶיךָ יְיָ צוּרֵנוּ וְגוֹאֲלֵנוּ׃ </tei:p>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/yom_kippur_katan/verses_before_samar">
          <j:conditional xml:id="penitential_yom-kippur-katan_day_verses_before_samar_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
