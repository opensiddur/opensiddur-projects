      <tei:div corresp="urn:x-opensiddur:text:poem:elohei_besar_ammekha_samar">
        <tei:pb n="193" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n387_medium.jpg"/>
        <tei:lg><tei:l>אֱלֹהַי בְּשַׂר עַמְּךָ מִפַּחְדְּךָ סָמַר ·</tei:l> <tei:l>וְתָמִיד עוֹמֵד עַל־הַמִּשְׁמָר ·</tei:l> <tei:l>וּמְצַפֶּה לְעֵת מִנְחַת עָרֶב ·</tei:l> <tei:l><tei:seg type="refrain">[כִּי אָמַר אֲכַפְּרָה פָנָיו בַּמִּנְחָה׃]</tei:seg></tei:l> <tei:l>לְהַקְשִׁיב לְמַשְׂטִינֵנוּ מָאֵן תְּמָאֵן ·</tei:l> <tei:l>סְאוֹנוֹ בְּרַעַשׁ אַל־נָא תְהִי סוֹאֵן ·</tei:l> <tei:l>וְאִם עֲוֹנוֹת תִּשְׁמֹר הֲלֹא רַבּוּ ·</tei:l> <tei:l><tei:seg type="refrain">[מֵאֵין עוֹד פְּנוֹת אֶל־הַמִּנְחָה׃]</tei:seg></tei:l> <tei:l>יִשְׂרָאֵל עַמְּךָ אֲשֶׁר בְּךָ מַאֲמִין ·</tei:l> <tei:l>אִם־בִּשְׂמֹאל דְּחִיתוֹ קָרְבֵהוּ בְּיָמִין ·</tei:l> <tei:l>בָּא לְשַׁחֵר פָּנֶיךָ ·</tei:l> <tei:l><tei:seg type="refrain">[וַיִּקַּח מִן הַבָּא בְיָדוֹ מִנְחָה׃]</tei:seg></tei:l> <tei:l>עוֹרְכֵי שׁוּעַ מְשַׁלְּמֵי פָרִים שִׂפְתוֹתָם ·</tei:l> <tei:l>רְצֵה וְהַשְׁלֵךְ בִּמְצוּלוֹת יָם כָּל־חַטֹּאותָם ·</tei:l> <tei:l>יֶעֶרְבוּ לְפָנֶיךָ שִׂיחָם וְרִנָּם ·</tei:l> <tei:l><tei:seg type="refrain">[כַּחַטָּאת וְכָעוֹלָה <tei:pb n="194" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n389_medium.jpg"/>וְכַמִּנְחָה׃]</tei:seg></tei:l> <tei:l>זְכֹר פַּר פְּנִים וּשְׂעִיר פְּנִימִי וְהַחִיצוֹן ·</tei:l> <tei:l>יְהִי־נָא אֲמָרֵינוּ לְפָנֶיךָ לְרָצוֹן ·</tei:l> <tei:l>וְתֶעֱרַב מִנְחָתֵנוּ כְּשֶׂה אֶחָת מִן הַצֹּאן מִן הַמָּאתַיִם ·</tei:l> <tei:l><tei:seg type="refrain">[מִמַּשְׁקֵה יִשְׂרָאֵל לְמִנְחָה׃]</tei:seg></tei:l> <tei:l>רְאֵה כִּי אָזְלַת יָד וְיוֹשְׁבֵי מָרוֹם שָׁחוּ ·</tei:l> <tei:l>פַסּוּ אֱמוּנִים וּבְכֵן לָקְחוּ ·</tei:l> <tei:l>כְבַד־פֶּה וַעֲרֵל שָׂפָה ·</tei:l> <tei:l><tei:seg type="refrain">[וַיִּשְׁלְחוּ בְנֵי יִשְׂרָאֵל בְּיָדוֹ מִנְחָה׃]</tei:seg></tei:l> <tei:l>בָּרֵר נִיב שְׂפָתַי כְּשַׁחַר פָּרוּם ·</tei:l> <tei:l>עֲנֵנִי וּרְפָא מִזְבַּחֲךָ הֶהָרוּס ·</tei:l> <tei:l>חֶלְקַת לְשׁוֹנִי תֶּעֱרַב כַּשָּׁמֶן ·</tei:l> <tei:l><tei:seg type="refrain">[לָרֻם אֶת הַסֹּלֶת וְאֶת־הַמִּנְחָה׃]</tei:seg></tei:l> <tei:l>בֵּית תְּפִלָּתָם מְקוֹם צָקוּן לַחֲשָׁם ·</tei:l> <tei:l>חֲשֹׁב כַּמָּקוֹם אֲשֶׁר יְבַשְּׁלוּ שָׁם הַכֹּהֲנִים אֶת־הַחַטָּאת וְאֶת־הָאָשָׁם ·</tei:l> <tei:l><tei:seg type="refrain">[וַאֲשֶׁר יֹאפוּ אֶת־הַמִּנְחָה׃]</tei:seg></tei:l> <tei:l>יְצַוֶּה יְיָ חַסְדּוֹ קוֹמְמִיּוּת הֲשִׁיבֵנִי לְנָוִי ·</tei:l> <tei:l>לְפָאֵר מְקוֹם מִקְדָּשִׁי לְחַדֵּשׁ הֲדַר זִיוִי ·</tei:l> <tei:l>וְיָשַׁב מְצָרֵף וּמְטַהֵר אֶת־בְּנֵי לֵוִי ·</tei:l> <tei:l><tei:seg type="refrain">[וְהָיוּ לַיְיָ מַגִּישֵׁי מִנְחָה׃]</tei:seg></tei:l> </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
