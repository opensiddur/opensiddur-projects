      <tei:div corresp="urn:x-opensiddur:text:poem:adon_befaqdekha_enosh_labbeqarim">
        <tei:pb n="154" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n309_medium.jpg"/>
        <tei:lg><tei:l>אָדוֹן בְּפָקְדְּךָ אֱנוֹשׁ לַבְּקָרִים ·</tei:l> <tei:l>בְּמִצּוּי הַדִּין אַל־תְּמַתֵּחַ׃</tei:l> <tei:l>גּוּף וּנְשָׁמָה אִם־תָּרִיבֵם ·</tei:l> <tei:l>תֹהוּ וְלֹא־יוּכְלוּ קוּם׃</tei:l> <tei:l>הֲיוּכַל גֶּבֶר לִזְכּוֹת בְּמִשְׁפָּט ·</tei:l> <tei:l>אִם־אֵין בְּיָדוֹ מַעַשׂ לְהִצְטַדֵּק׃</tei:l> <tei:l>זְרוּי יְחֻמּוֹ מִלֵּידָה סְרוּחָה ·</tei:l> <tei:l>חָבוּי אָרְבוּ בְּקִרְבּוֹ מֵעֵת־הֻוָּלְדוֹ׃</tei:l> <tei:l>טָמוּן בְּחֻבּוֹ בְרֶשֶׁת לְרַגְלָיו ·</tei:l> <tei:l>יְסִיתֵהוּ בְּכָל־יוֹם לַשַּׁחַת לְהַפִּילוֹ׃</tei:l> <tei:l>כֹּחַ וּגְבוּרָה בַגּוּף אֵין ·</tei:l> <tei:l>לְפָנָיו לַעֲמוֹד וּלְהִתְיַצֵּב׃</tei:l> <tei:l>מִיּוֹם עָמְדוֹ עַל־דַּעְתּוֹ ·</tei:l> <tei:l>נַפְשׁוֹ יָשִׂים בְּכַפּוֹ לְהָבִיא לַחְמוֹ׃</tei:l> <tei:l>שָׂבֵעַ כָּל־יָמָיו יְגִיעַ כַּעַס וּמַכְאוֹבוֹת׃</tei:l> <tei:pb n="155" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n311_medium.jpg"/><tei:l>עַד־שׁוּבוֹ לֶעָפָר לֹא־יִשְׁקֹט׃</tei:l> <tei:l>פְּנֵה אָדוֹן בְּעִצְּבוֹן־רוּחַ ·</tei:l> <tei:l>צְפֵה בְּשִׁבְרוֹן־לֵב׃</tei:l> <tei:l>קָרוֹב אַתָּה לִרְחוֹקִים ·</tei:l> <tei:l>רוֹצֶה תְּשׁוּבַת־רְשָׁעִים׃</tei:l> <tei:l>שַׁדַּי הִמָּצֵא לְדֹרְשֶׁךָ ·</tei:l> <tei:l>תֹּאמַר הִנְנִי לִמְבַקְשֶׁךָ׃</tei:l> <tei:l>יְבֻשְּׂרוּ סָלַחְתִּי קוֹרְאֵי בִשְׁמֶךָ ·</tei:l> <tei:l>צַדֵּק בְּמִשְׁפָּט עַם־מְיַחֲדֶיךָ׃</tei:l> <tei:l>חֲסוֹם מְנֻוָּל מֵהַרְשִׁיעַ ·</tei:l> <tei:l>קְצוֹף בַּמַּשְׂטִין מֵהַסְטִין׃</tei:l> <tei:l>הָקֵם לָנוּ מֵלִיץ יוֹשֶׁר ·</tei:l> <tei:l>כּוֹפֶר מְצִיאָתִי תַשְׁמִיעַ לַשּׁוֹבָבִים׃</tei:l> <tei:l>הִשְׁלַכְנוּ עָלֶיךָ יְהָבֵנוּ ·</tei:l> <tei:l>נָא אַתָּה תְּכַלְכְּלֵנוּ׃</tei:l> <tei:l>הֵעָזֵר לָנוּ בִתְפִלָּתֵנוּ ·</tei:l> <tei:l>חֶפְצֵנוּ וּבַקָּשָׁתֵנוּ מַלֵּא בְרַחֲמִים׃</tei:l> <tei:l>בְּךָ תָלִינוּ בִטְחוֹנֵנוּ ·</tei:l> <tei:l>רַחֲמֶיךָ מְהֵרָה יְקַדְּמוּנוּ׃</tei:l> <tei:l>חָזָק וְאַמִּיץ שִׁמְךָ לֹא־שָׁכַחְנוּ ·</tei:l> <tei:l>אָנָּא לָנֶצַח אַל־תִּשְׁכָּחֵנוּ׃</tei:l> </tei:lg>
      </tei:div>
