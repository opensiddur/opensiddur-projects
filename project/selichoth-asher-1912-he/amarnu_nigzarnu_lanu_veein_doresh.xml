      <tei:div corresp="urn:x-opensiddur:text:poem:amarnu_nigzarnu_lanu_veein_doresh">
        <tei:pb n="135" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n271_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אָמַרְנוּ נִגְזַרְנוּ־לָנוּ וְאֵין דּוֹרֵשׁ ·</tei:l> <tei:l>אֲבָל אֲשֵׁמִים אֲנַחְנוּ וְקָרוֹב פּוֹרֵשׁ ·</tei:l> <tei:l>בַּעֲוֹן בִּצְעֵנוּ צוּר לְצָר יַחֲרִישׁ ·</tei:l> <tei:l>בּוֹלֵעַ וּמֵמִיק וְרוֹפֵס הַחוֹרֵשׁ׃</tei:l> <tei:l>גַּל אַחַר גַּל וְאֵין חוֹבֵר ·</tei:l> <tei:l>גָּלַל וָצָף עָלַי רֹאשׁ גּוֹבֵר ·</tei:l> <tei:l>דָּבַק שֶׁבֶר עַל שֶׁבֶר חָבֵר ·</tei:l> <tei:l>דֵּאָבוֹן קָשֶׁה הַבָּא יְשַׁכַּח הָעוֹבֵר׃</tei:l> <tei:l>הִמֵּס יִמַּס הַלֵּב מֵרוֹב הַמִּכְשׁוֹל ·</tei:l> <tei:l>הוֹלֵךְ וְסוֹעֵר כִּי מְאֹד הַנַּחְשׁוֹל ·</tei:l> <tei:l>וּמוֹשִׁיעַ וָרַב אֵין עוֹד לִמְשׁוֹל ·</tei:l> <tei:l>וְאָבַד הַמַּנְהִיג וְעָיֵף שׁוֹל וְשׁוֹל׃</tei:l> <tei:l>זָנַחְנוּ טוֹב וְעַל כָּכָה הִגִּיעַ ·</tei:l> <tei:l>זוֹכְרֶיךָ זַעֲמַת בְּיַד עֲוֹנֵינוּ לְהַפְגִּיעַ ·</tei:l> <tei:l>הַיָּם לָרוּץ וְסַכְךָ אַף לְהַרְגִּיעַ ·</tei:l> <tei:l>חוּשָׁה לַעֲזוֹר כִּי אֵין מַפְגִּיעַ׃</tei:l> <tei:l>טוֹרַדְנוּ וַנְּהִי כַטָּמֵא וּכְבֶגֶד עִדִּים ·</tei:l> <tei:l>טוֹרַפְנוּ וַנֶּבֶל וְרוֹדְפִים קַלִּים חַדִּים ·</tei:l> <tei:l>יוֹצְאִים חוּצַת מְלֵאִים גַּעַר כְּמִנָּדִים ·</tei:l> <tei:l>יוֹשְׁבֵי חֹשֶׁךְ צָגִים פְּרוּקִים כַּדִּים׃</tei:l> <tei:l>כְּלִמּוֹת וָרוֹק פָּנֵינוּ מְצַפִּים צָפֹה ·</tei:l> <tei:l>כִּי גָּדַל הַכְּאֵב מִפֹּה וּמִפֹּה ·</tei:l> <tei:l>לְיוֹצֵא בְעָתָה וְלַבָּא אֵין רְפוּא ·</tei:l> <tei:l>לְחוֹן וּלְרַחֵם תִּקְוָה אַיֵּה אֵפוֹא׃</tei:l> <tei:l>מַה־כֹּחִי לְיַחֵל ·</tei:l> <tei:l>וּמְתוֹשֶׁת גְּבֶרְתָּנִית ·</tei:l> <tei:l>מְכוֹיָף מוֹשֵׁךְ קֵץ מַעֲנִית גְּרוֹנִית ·</tei:l> <tei:l>נֵטֶל נַשְׁכָנִית נַגְּחָנִית עֶשֶׂר שָׁלְטָנִית ·</tei:l> <tei:l>נִגּוּעַ יָגֵעַ רָדְחָנִית חִנָּם חֲלָטָנִית׃</tei:l> <tei:l>סַמְּלוּנֵי רֶשַׁע לְקַצֵּץ נָקָם תִּלְבּוֹשׁ ·</tei:l> <tei:l>סַבֵּר <tei:pb n="136" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n273_medium.jpg"/>קוֹוֶיךָ וּסְפוּנִים תַּעֲמִיד מִלְּבוֹשׁ ·</tei:l> <tei:l>עֶגְלַת לְמוּדְךָ מַחַץ וָשֶׁבֶר תַּחֲבוֹשׁ ·</tei:l> <tei:l>עֲבוֹד עֲבוֹדָתְךָ שְׁכֶם אֶחָד תִּכְבּוֹשׁ׃</tei:l> <tei:l>פָּקַרְנוּ בְאָמוֹן כְּבֵן הַפַּךְ וּפַרְכָן ·</tei:l> <tei:l>פִּדְיוֹן לְחֹזֶק יִסּוּרִים חֲלִיפַת קָרְבָּן ·</tei:l> <tei:l>צָרוֹת־רָעוֹת נָחָשׁ וְעַקְרָב וְרַבְרְבָן ·</tei:l> <tei:l>צִמָּאוֹן וְחֹסֶר־כֹּל מִשְׁנֵה הַדָּרְבָּן׃</tei:l> <tei:l>קוֹבְלִים הֶסְתֵּר פָּנֶיךָ עַם טָרְחָן ·</tei:l> <tei:l>קִנְיָן הָרַג וְאָכַל וּמָכוּר מוֹרְחָן ·</tei:l> <tei:l>רָגַלְנוּ כְּעֶבֶד רַב־פֶּשַׁע וְסַרְחֵן ·</tei:l> <tei:l>רַבָּה לְהֵטִיב רַב־חֶסֶד וְסַלְחֵן׃</tei:l> <tei:l>שִׁקַּרְנוּ בָךְ וְסַטִּינוּ מִמְּךָ לָסוּר ·</tei:l> <tei:l>שָׁכַחְנוּ רוֹכֵל כָּל כְּלִי הַסּוֹר ·</tei:l> <tei:l>תָּעִינוּ אַחַר יֵצֶר רַע וְסוּר ·</tei:l> <tei:l>תַּרְנוּ אַחַר הַזּוּג לָעֲבֵרָה סַרְסוּר׃</tei:l> <tei:l>שְׁרִירוּת לֵב יַשֵּׁר וּפְשׁוֹט עַקְמוּמִית ·</tei:l> <tei:l>לֹא יִרְגְּזוּ עוֹד בְּהִרְהוּר שַׁעֲמוּמִית ·</tei:l> <tei:l>מַהֵר מִלְּעַכֵּב תִּמּוּי תְּפִישַׂת שְׁמָמִית ·</tei:l> <tei:l>הֶרֶב כַּבֵּס כְּתָמֵינוּ וּלְבֵּן אַדְמוּמִית׃</tei:l> <tei:l>הֲגוּנִים לְךָ לָעָם אוֹתָנוּ נְוֵה ·</tei:l> <tei:l>קָטֹן וְגָדוֹל דַּעַת דְּרָכֶיךָ שְׁוֵה ·</tei:l> <tei:l>יְשׁוּעַת יִשְׂרָאֵל חֵלֶק יַעֲקֹב צַוֵּה ·</tei:l> <tei:l>הֲלֹא אַתָּה אֱלֹהֵינוּ וּלְךָ נְקַוֶּה׃</tei:l> </tei:lg>
      </tei:div>
