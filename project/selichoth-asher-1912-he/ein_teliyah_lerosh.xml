      <tei:div corresp="urn:x-opensiddur:text:poem:ein_teliyah_lerosh">
        <tei:pb n="45" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n91_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אֵין תְּלִיָּה לְרֹאשׁ אִם לְפִי מַעֲוֶה ·</tei:l> <tei:l>בַּעֲבוּר כִּי כָּל־לֵב חוֹקֵק וְנַעֲוֶה ·</tei:l> <tei:l>גִּשְׁתּוֹ בְּדִין הֵמַס יִמַּס וּכְדוֹנַג מִשְׁתַּעֲוֶה ·</tei:l> <tei:pb n="46" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n93_medium.jpg"/><tei:l>דַּנְתּוֹ שַׂמְתּוֹ גּוֹלָה נִמְשָׁל נִשְׁנַן וְזַעֲוָה׃</tei:l> <tei:l>הוּשַׁל כָּשַׁל נֶחֱשַׁל כָּשַׁל וְהֵזִיד ·</tei:l> <tei:l>וּבְיוֹדְעִים חֹק חָלַף וְתוֹרוֹת עָבַר בְּמֵזִיד ·</tei:l> <tei:l>זְכוּת עוֹקֵד וְנֶעֱקַד וְתוּמַת זָר־נָזִיד ·</tei:l> <tei:l>חֲשׁוֹב הַיּוֹם לִשְׁגוֹגָה וּלְפוֹתֶה וְכִי־יָזִיד׃</tei:l> <tei:l>טְרֵי חֶרֶט וּמָזוֹר־זוֹר וַחֲבוֹשׁ נַחֲלָה ·</tei:l> <tei:l>יוֹנָתְךָ כַּנָּתְךָ מְנָתְךָ רְאֵה כִּי־נוֹחֲלָה׃</tei:l> <tei:l>כְּמַבְכִּירָה בְּכוֹרָה־סוֹרֶרֶת צוֹרַחַת קוֹל כְּחוֹלָה ·</tei:l> <tei:l>לְעֵה כִּלְעָה יְגֵעָה לֹא־הוּנְחָה־לָהּ׃</tei:l> <tei:l>מְרוּצָה בְּקִרְבֵּנוּ נְעוּצָה כְקוֹפִיץ וּמְפַסֶּלֶת דְּיוּסַמַר ·</tei:l> <tei:l>נוּל עוּל מָנוּל פִּיהוּ עָלֵינוּ אָטַר ·</tei:l> <tei:l>שׂוֹנֵא סָחַר וְהַסָּבִיב וְכַצִּנָּה אוֹתָנוּ עָטַר ·</tei:l> <tei:l>עָוֹן הַכְתִּיב וְהַחְתִּים בַּעַל־פֶּה וּבִשְׁטָר׃</tei:l> <tei:l>פְּלֵיטֶיךָ נַהֵל לְרֶגֶל־הַנַּחֲלוֹת וּלְרֶגֶל־הַמְּלָאכָה ·</tei:l> <tei:l>צְפוֹן סוֹךְ חֲבֹא סְתֹר נְכָאָה וְחַלְכָּה ·</tei:l> <tei:l>קְרָאנוּךָ מִמֵּצַר עֲנֵנוּ וְלִישׁוּעָתָה לְכָה ·</tei:l> <tei:l>רַפֵּה מַטֶּה בְּקֶרֶב־שָׁנִים חַיֵּה פָעֳלֶךָ׃</tei:l> <tei:l>שְׁאָר־יַעֲקֹב נָשׁוּבָה אֶל אֵל־גִּבּוֹר ·</tei:l> <tei:l>תָּמִיד דַּרְכּוֹ לִסְלוֹחַ וְעַל־פֶּשַׁע עֲבוֹר ·</tei:l> <tei:l>אֶל־עָנִי מַבִּיט לְהַעֲלוֹתוֹ מִשָּׁאוֹן־בּוֹר ·</tei:l> <tei:l>יְהִיר וְגָאוֹן שׂוֹנֵא מָשְׁלוֹ וּזְרוֹעוֹ לִשְׁבּוֹר׃</tei:l> <tei:l>בְּרַבִּים הָיִיתָ עִמָּנוּ גַּם עַתָּה הִמָּצֵא ·</tei:l> <tei:l>שְׁמַעְיָה מְחַנְּנֶךָ וְלָנוּ הַיּוֹם הֵרָצֵה ·</tei:l> <tei:l>חֹזֶק וְאַמִּיץ תַּשְׁלוּם פַּר שָׂפָה רְצֵה ·</tei:l> <tei:l>לְיֵשַׁע אֶת־מְשִׁיחֶךָ וּלְיֵשַׁע עַמְּךָ צֵא׃</tei:l> </tei:lg>
