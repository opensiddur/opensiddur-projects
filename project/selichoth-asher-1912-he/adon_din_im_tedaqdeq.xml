      <tei:div corresp="urn:x-opensiddur:text:poem:adon_din_im_tedaqdeq">
        <tei:pb n="155" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n311_medium.jpg"/>
        <tei:lg><tei:l>אָדוֹן דִּין אִם־תְּדַקְדֵּק ·</tei:l> <tei:l>בְּחֵקֶר פּוֹעַל אִם־תִּבְדֹּק ·</tei:l> <tei:l>גֶּבֶר לְפָנֶיךָ לֹא־יִצְדַּק׃</tei:l> <tei:l>דּוֹפִי תִּתֵּן בִּצְבָא מַעְלָה ·</tei:l> <tei:l>הֵן בְּמַלְאָכֶיךָ תָּשִׂים תָּהֳלָה ·</tei:l> <tei:l>וְאַף שׁוֹתֶה כַמַּיִם עַוְלָה ·</tei:l> <tei:l>זְכוּת וּצְדָקָה אֵין בָּנוּ ·</tei:l> <tei:l>חֵטְא וָרֶשַׁע כֻּלָּנוּ ·</tei:l> <tei:l>טוֹב אַל־תָּבֹא בְמִשְׁפָּט עִמָּנוּ׃</tei:l> <tei:l>יֶהֱמוּ מֵעֶיךָ עָלֵינוּ ·</tei:l> <tei:l>בְּרוֹב רַחֲמֶיךָ פְּנֵה אֵלֵינוּ ·</tei:l> <tei:l>לְבִלְתִּי כְּרֹעַ מַעֲלָלֵינוּ׃</tei:l> <tei:l>מְשׁוּבֹתֵינוּ רַבּוּ מִלִּמָּנוֹת ·</tei:l> <tei:l>נִחוּמִים אֵין וְקָרְבָּנוֹת ·</tei:l> <tei:l>סְלִיחָה מְצוֹא לַעֲוֹנוֹת׃</tei:l> <tei:l>עַל־צִדְקוֹתֵינוּ אֵין <tei:pb n="156" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n313_medium.jpg"/>אָנוּ סְמוּכִים ·</tei:l> <tei:l>פֶּשַׁע וְעָוֹן מְלֻכְלָכִים ·</tei:l> <tei:l>צְדָקָה מְצֹא לְתַחַן עוֹרְכִים׃</tei:l> <tei:l>קַו אַל־תִּמְתַּח בְּאָרְחוֹתֵינוּ ·</tei:l> <tei:l>רִמָּה וְתוֹלֵעָה אַחֲרִיתֵנוּ ·</tei:l> <tei:l>שָׁוְא וָהֶבֶל שְׁנוֹתֵינוּ׃</tei:l> <tei:l>תָּשׁוּב עַל־הָרָעָה תִּנָּחֵם ·</tei:l> <tei:l>זֶה דַרְכְּךָ חִנָּם מְרַחֵם ·</tei:l> <tei:l>בְּרַחֲמֶיךָ הָרַבִּים עָלֵינוּ רַחֵם׃</tei:l> <tei:l>דְּרָכֶיךָ הוֹדַעְתּוֹ לֶעָנָו לְהוֹרוֹת ·</tei:l> <tei:l>וְהֵעַתּוֹ שְׁלֹשׁ עֶשְׂרֵה סְדוּרוֹת ·</tei:l> <tei:l>הִבְטַחְתּוֹ שֶׁאֵין רֵיקָם חוֹזְרוֹת׃</tei:l> <tei:l>חַנּוּן בָּם סָדַרְנוּ לְפָנֶיךָ ·</tei:l> <tei:l>זַעַק קְשׁוֹב מִמִּתְחַנְּנֶיךָ ·</tei:l> <tei:l>וְאַל תְּשִׁיבֵנוּ רֵיקָם מִלְּפָנֶיךָ׃</tei:l> </tei:lg>
      </tei:div>
