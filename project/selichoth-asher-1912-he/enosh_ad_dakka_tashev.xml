      <tei:div corresp="urn:x-opensiddur:text:poem:enosh_ad_dakka_tashev">
        <tei:pb n="117" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n235_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אֱנוֹשׁ עַד־דַּכָּא תָּשֵׁב ·</tei:l> <tei:l>לִפְנֵי גְבָעוֹת וְתֵבֵל תִּישֵׁב׃</tei:l> <tei:l>בְּרָאֳמָן אֶצְלְךָ שַׁעֲשׁוּעֵי יוֹמִים ·</tei:l> <tei:l>מְרַחֶפֶת עַל־פְּנֵי הַמָּיִם׃</tei:l> <tei:l>גִּיסוֹת כְּתָב מְדִינָה מְשַׁבֶּשֶׁת ·</tei:l> <tei:l>נְתָנָה לְמַרְפֵּא וִיצִרֵי הַנְּכֻשֶׁת׃</tei:l> <tei:l>דַּעַת טַעַם הַיְּחִידָה מְהַשְׁחִית ·</tei:l> <tei:l>שָׂרִיגוֹ בְּרִינוֹ מַחֲצִית הַפְּרוֹת׃</tei:l> <tei:l>הַמַּצִּיעַ־כִּלְכֵּל עֶלְיוֹן תָּבַע ·</tei:l> <tei:l>עִסְקוֹ בְּשַׁקּוֹ וְתַעֲנִיתוֹ קָבַע׃</tei:l> <tei:l>וְאַף כִּי מִבְּכוֹרָה נִגְרַשׁ ·</tei:l> <tei:l>פֵּרֵשׁ מֵאָבִיו וּלְהָשִׁיבוֹ דָרַשׁ׃</tei:l> <tei:l>זָבַד־לוֹ מַשְׂכֹּרֶת יְתֵרָה ·</tei:l> <tei:l>צִפָּה לְהַעֲמִיד בְּאֵר הַתּוֹרָה׃</tei:l> <tei:l>חוֹרַת הַשְּׁבָטִים בְּצִדְקוֹ תְחֻבַּר ·</tei:l> <tei:l>קָלוּט בְּזָהָב מִשּׂוּת הַמִּדְבָּר׃</tei:l> <tei:l>טִכֵּס בְּנוֹ בָּקִי וּמְיֻשָּׁב ·</tei:l> <tei:l>רָאוּי לְהַשִּׂיא עֵצָה וְיֵחָשֵׁב׃</tei:l> <tei:l>יִשְׂרָאֵל קוֹנְךָ יִכְמְרוּ נִיחוּמָיו׃</tei:l> <tei:l>שׁוּבָה עַד שֶׁהוּא בְּמִדַּת רַחֲמָיו ·</tei:l> <tei:l>כָּתוּב לְמַעְלָה לְהַזְהִיר <tei:pb n="118" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n237_medium.jpg"/>חֲבַרְתָּהּ ·</tei:l> <tei:l>תֶּאְשַׁם שׁוֹמְרוֹן כִּי־מָרָתָה׃</tei:l> <tei:l>אֶל־נְתִיבוֹת עוֹלָם אוּלוּ ·</tei:l> <tei:l>לְחָכְמָה וְלַנְּבוּאָה וְלַתּוֹרָה שָׁאֲלוּ׃</tei:l> <tei:l>בְּטוֹב וְיָשָׁר לְמֶלֶךְ־נִהֲרוּ ·</tei:l> <tei:l>מִתּוֹךְ־סוֹדָיו חֲסָדָיו נִכָּרוּ׃</tei:l> <tei:l>גְּדָל־חֶסֶד לוֹ נִיחָל ·</tei:l> <tei:l>נְצוֹת מִבְּרִיוֹתָיו וְעֶלְבּוֹנֵנוּ מוֹחֵל׃</tei:l> <tei:l>דּוֹרוֹנוֹ בִּכְלִי־שָׁבוּר מוּבָל ·</tei:l> <tei:l>סַמֵּי־קְצִיעוֹתָיו בְּגָרוֹנֵנוּ מְקַבֵּל׃</tei:l> <tei:l>הוּא שֶׁהַנָּבִיא־מְקַלֵּס מַהֲלָתוֹ ·</tei:l> <tei:l>עוֹבֵר עַל־פֶּשַׁע שְׁיָרֵי נַחֲלָתוֹ׃</tei:l> <tei:l>וּמִי כָמוֹהוּ מוֹרֶה לַחֲטָאִים ·</tei:l> <tei:l>פָּשַׁר דְּבָרִים וְרִצּוּי מִבְטָאִים׃</tei:l> <tei:l>זְרוֹם תַּל־שְׁלוּחֶיךָ תּוֹסָפוֹת ·</tei:l> <tei:l>צְרִירוֹת רָעוֹת כִּמְעוֹט יָפוֹת׃</tei:l> <tei:l>חוֹטֵא לָשׁוּב אִם יִתְנַפֵּשׁ ·</tei:l> <tei:l>קְרִיאוֹת עֵדוֹתָיו בְּעוֹד־יֵשׁ׃</tei:l> <tei:l>טוֹבָה בִּשְׁבִילוֹ לְעוֹלָם נֶחֱרֶצֶת ·</tei:l> <tei:l>רַבִּים־וְיָחִיד זְכוּת נִמְצֵאת׃</tei:l> <tei:l>יַעַן כִּי נְהִיתָה פַּעֲמִים ·</tei:l> <tei:l>שׁוּבוּ שׁוּבוּ לַאֲבִיכֶם שֶׁבַּשָּׁמַיִם׃</tei:l> <tei:l>כְּבֵן מְלָכִים שֶׁיָּצָא לְתַרְבּוּת ·</tei:l> <tei:l>תּוֹחַלְתּוֹ חוֹזֵר לְאָבִיו בִּקְרִיבוּת׃</tei:l> <tei:l>יִשְׂרָאֵל בְּנֶךָ יְקִירְךָ בְּכוֹרְךָ ·</tei:l> <tei:l>צַעֲצוּעֵי שַׁעֲשׁוּעֶיךָ זְכוֹר בְּרָכְךָ׃</tei:l> <tei:l>חוֹזֵר אֶצְלְךָ וּבִתְשׁוּבָה שָׁב ·</tei:l> <tei:l>קְטֹרֶת תִּכוֹן פְּלִילוֹ יֻקְשָׁב׃</tei:l> <tei:l>הֲמוֹן מֵעֶיךָ יֶהֱמוּ לוֹ ·</tei:l> <tei:l>קָם בְּסִינַי הַשָּׁלֵם לְמוּלוֹ׃</tei:l> <tei:l>טוּבְךָ וְרַחֲמֶיךָ הֻכְפַּל לוֹ ·</tei:l> <tei:l>נוֹעַם־דְּבָרֶיךָ בְּכַלְכְּלוֹ׃</tei:l> <tei:l>עַיִן הַיְּחִידָה כְּמַחַט פְּתַח ·</tei:l> <tei:l>יְהִי־שֶׁלְּךָ כָּאוּלָם הַנִּפְתָּח׃</tei:l> <tei:l>אָוֶן רְאוֹתְךָ בַּל תִּתְבּוֹנֵן ·</tei:l> <tei:l>יְדַע מְתֵי שָׁוְא לְכוֹנֵן׃</tei:l> <tei:l>יֵשׁ בְּנוֹהַג עוֹלָם בְּרֵיעִים ·</tei:l> <tei:l>מְבַזֶּה אֶת־חֲבֵירוֹ בָּרַבִּים׃</tei:l> <tei:l>וְאַחַר־זְמַן רוּחוֹ פְּצָעֲנוֹ ·</tei:l> <tei:l>שִׁחֵר־טוּבוֹ וּמְבַקֵּשׁ רְצוֹנוֹ׃</tei:l> <tei:l>נָתַן חוֹב־הַדִּין כְּבַתְּחִלָּה ·</tei:l> <tei:l>יָשׁוּב יְבַקֵּשׁ מִמֶּנּוּ מְחִילָה׃</tei:l> <tei:l>יִגְדַּל וְיִשְׂגַּב כֹּחַ־הַנּוֹרָא ·</tei:l> <tei:l>בִּתְשׁוּבָה מוֹרֶה בְּהַצְנֵעַ קוֹרֵא׃</tei:l> <tei:l>וְרָאוּי הַשֵּׁם־הַנִּכְבָּד לְקַלְּסוֹ ·</tei:l> <tei:pb n="119" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n239_medium.jpg"/><tei:l>וּבִדְבָרִים מְרוּצִים לְפַיְּסוֹ׃</tei:l> <tei:l>עַד יֵעָרֶה־רוּחוֹ מִמָּרוֹם ·</tei:l> <tei:l>שְׁבוּתֵנוּ־יָשִׁיב מִצָּפוֹן וּמִדָּרוֹם׃</tei:l> <tei:l>טוֹב יֵטִיב מְקוֹם מִקְדָּשֵׁנוּ ·</tei:l> <tei:l>אָז מִזְבְּחוֹ נַעֲלֶה קָדָשֵׁינוּ׃</tei:l> <tei:l>וְאָז מְנוּחָתֵנוּ נְשַׁלְּמָה בְּחֻקִּים ·</tei:l> <tei:l>מִבְטָחָה כָּל־קַצְוֵי אֶרֶץ וְיָם רְחֹקִים׃</tei:l> </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
