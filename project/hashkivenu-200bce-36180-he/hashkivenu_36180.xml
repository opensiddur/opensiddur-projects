  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hashkivenu_36180">
        <tei:head>הַשְׁכִּיבֵנוּ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hashkivenu_36180/1"/>
        <tei:lg>
          <tei:l>הַשְׁכִּיבֵֽנוּ אָבִינוּ לְשָׁלוֹם</tei:l>
          <tei:l>וְהַֽעֲמִידֵֽנוּ מַלְכֵּֽנוּ לְחַיִּים׃</tei:l>
          <tei:l>וּפְרוֹס עָלֵֽינוּ</tei:l>
          <tei:l>סֻכַּת שְׁלוֹמֶֽךָ</tei:l>
          <tei:l>וְתַקְּנֵֽנוּ בְּעֵצָה טוֹבָה מִלְּפָנֶֽיךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hashkivenu_36180/2"/>
        <tei:lg>
          <tei:l>וְהֽוֹשִׁיעֵֽנוּ מְהֵרָה לְמַֽעַן שְׁמֶֽךָ</tei:l>
          <tei:l>וְהָגֵן בַּעֲדֵֽנוּ׃</tei:l>
          <tei:l>וְהָסֵר מֵֽעָלֵֽינוּ</tei:l>
          <tei:l>מַכַּת אוֹיֵב דֶּֽבֶר חֶֽרֶב צָרָה רָעָב וְיָגוֹן וּמַשְׁחִית וּמַגֵּפָה׃</tei:l>
          <tei:l>וּבְצֵל כְּנָפֶֽיךָ תַּסְתִּירֵֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hashkivenu_36180/3"/>
        <tei:lg>
          <tei:l>כִּי אֵל שׁוֹמְרֵֽנוּ וּמַצִּילֵֽנוּ אַתָּה</tei:l>
          <tei:l>כִּי אֵל מֶֽלֶךְ חַנּוּן וְרַחוּם אַתָּה</tei:l>
          <tei:l>וּשְׁמוֹר מִכָּל־דָּבָר רָע וּמִפַּֽחַד לָיְלָה</tei:l>
          <tei:l>צֵאתֵֽנוּ וּבוֹאֵֽנוּ</tei:l>
          <tei:l>לְחַיִּים וּלְשָׁלוֹם מֵעַתָּה וְעַד עוֹלָם׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
