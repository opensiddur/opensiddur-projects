  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:memorial_prayer_for_those_whose_lives_were_lost_on_11_langner">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:memorial_prayer_for_those_whose_lives_were_lost_on_11_langner/1"/>
        <tei:lg>
          <tei:l>אָבִינוּ שֶׁבַּשָּׁמַיִם</tei:l>
          <tei:l>וְרוּחַ כָּל בָּשָׂר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:memorial_prayer_for_those_whose_lives_were_lost_on_11_langner/3"/>
        <tei:lg>
          <tei:l>וּשְׁמֹר צֵאתֵנוּ וּבוֹאֵנוּ לְחַיִּים וּלְשָׁלוֹם</tei:l>
          <tei:l>מֵעַתָּה וְעַד עוֹלָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:memorial_prayer_for_those_whose_lives_were_lost_on_11_langner/4"/>
        <tei:lg>
          <tei:l>אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
