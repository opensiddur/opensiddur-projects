  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:the_dona_nobis_pacem_blues_from_leonard_bernsteins_mass_bernstein">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_dona_nobis_pacem_blues_from_leonard_bernsteins_mass_bernstein/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">פזמון</tei:note>
          </tei:l>
          <tei:l>עוֹשֶׂה שָׁלוֹם / בִּמְרוֹמֶךָ / תַּעֲשֵׂה שָׁ/לוֹם עֲלֵינוּ</tei:l>
          <tei:l>עוֹשֶׂה שָׁלוֹם / בִּמְרוֹמֶךָ / תַּעֲשֵׂה שָׁ/לוֹם עֲלֵינוּ</tei:l>
          <tei:l>עוֹשֶׂה שָׁלוֹם / עוֹשֶׂה שָׁלוֹם...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_dona_nobis_pacem_blues_from_leonard_bernsteins_mass_bernstein/2"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">חרוז א׳</tei:note>
          </tei:l>
          <tei:l>לֹא נִשְׁתַּחֲוֶה אַפַּיִם אַרְצָה</tei:l>
          <tei:l>לֹא נְבַקְּשָׁה־נָא אֶלָּא נִחְרָצָה</tei:l>
          <tei:l>עֲשֵׂה שָׁלוֹם עַתָּה לְהַחְזִיק בּוֹ</tei:l>
          <tei:l>וְתֵן טַעַם כִּי דַּי וּמַסְפִּיק בּוֹ!</tei:l>
          <tei:l>עוֹשֶׂה שָׁלוֹם / עוֹשֶׂה שָׁלוֹם...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_dona_nobis_pacem_blues_from_leonard_bernsteins_mass_bernstein/3"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">חרוז ב׳</tei:note>
          </tei:l>
          <tei:l>מָלֵא לִבִּי רִיב, סָפֵק, וְקֻשְׁיוֹת</tei:l>
          <tei:l>בִּמְקוֹם מִזְמוֹרֵי הֶבֶל, תְּשׁוּבוֹת</tei:l>
          <tei:l>עֲשֵׂה שָׁלוֹם שֶׁכְּלוּם לֹא יָפֵר בּוֹ</tei:l>
          <tei:l>סַבְלָנוּת מִלִּבִּי תִּגָּמֵר בּוֹ!</tei:l>
          <tei:l>עוֹשֶׂה שָׁלוֹם / עוֹשֶׂה שָׁלוֹם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_dona_nobis_pacem_blues_from_leonard_bernsteins_mass_bernstein/4"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">חרוז ג׳</tei:note>
          </tei:l>
          <tei:l>הִנְּךָ נַחְתָּ בְּיוֹם שַׁבַּת קֹדֶשׁ</tei:l>
          <tei:l>אַךְ נִמְחֵהוּ כַּיֶּרַח רֹאשׁ חֹדֶשׁ</tei:l>
          <tei:l>עֲשֵׂה שָׁלוֹם עַתָּה בְּיָמֵינוּ</tei:l>
          <tei:l>זְכֹר, פַּעַם הָיִיתָ בּוֹרְאֵינוּ</tei:l>
          <tei:l>עוֹשֶׂה שָׁלוֹם / עוֹשֶׂה שָׁלוֹם...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_dona_nobis_pacem_blues_from_leonard_bernsteins_mass_bernstein/5"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">חרוז ד׳</tei:note>
          </tei:l>
          <tei:l>מִקּוֹלְךָ הַדְּמָמָה לָנוּ נִמְאַס</tei:l>
          <tei:l>רַק תִּפְעַל כִּי הַכֹּל מָלֵא חָמָס</tei:l>
          <tei:l>אִם־תֹּסֵף לִמְנֹעַ עוֹלַם חֶסֶד</tei:l>
          <tei:l>נִשְׂרְפָה לְעוֹלָם זֶה שֶׁל הֶפְסֵד</tei:l>
          <tei:l>עוֹשֶׂה שָׁלוֹם / עוֹשֶׂה שָׁלוֹם...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
