  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:asher_yatsar_abayye/1">
        <tei:head>אֲשֶׁר יָצַר</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:asher_yatsar_abayye/1/1"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם,</tei:l>
          <tei:l>אֲשֶׁר יָצַר</tei:l>
          <tei:l>אֶת הָאָדָם</tei:l>
          <tei:l>בְּחָכְמָה,</tei:l>
          <tei:l>וּבָרָא בוֹ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>נְקָבִים נְקָבִים,</tei:l>
          <tei:l>חֲלוּלִים חֲלוּלִים,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:asher_yatsar_abayye/1/2"/>
        <tei:lg>
          <tei:l>גָּלוּי וְיָדוּעַ</tei:l>
          <tei:l>לִפְנֵי כִסֵּא כְבוֹדֶךָ,</tei:l>
          <tei:l>שֶׁאִם</tei:l>
          <tei:l>יִסָּתֵם אֶחָד מֵהֶם,</tei:l>
          <tei:l>אוֹ אִם</tei:l>
          <tei:l>יִפָּתֵחַ אֶחָד מֵהֶם,</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>אִי אֶפְשַׁר</tei:l>
          <tei:l>לְהִתְקַיֵּם</tei:l>
          <tei:l>אֲפִילוּ שָׁעָה אֶחָת.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:asher_yatsar_abayye/1/3"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>רוֹפֵא כָל בָּשָׂר</tei:l>
          <tei:l>וּמַפְלִיא לַעֲשֹוֹת:</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
