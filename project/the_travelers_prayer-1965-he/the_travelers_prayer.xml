    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:the_travelers_prayer">
        <tei:head>תפילת הדרך</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_travelers_prayer/1"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן מִלְּפָנֶֽיךָ</tei:l>
          <tei:l>יְיָ אֱלֹהֵֽינוּ וֵֽאלֹהֵי אֲבוֹתֵֽינוּ</tei:l>
          <tei:l>שֶׁתּוֹלִיכֵֽנוּ לְשָׁלוֹם</tei:l>
          <tei:l>וְתַצְעִידֵֽנוּ לְשָׁלוֹם</tei:l>
          <tei:l>וְתִסְמְכֵֽנוּ לְשָׁלוֹם</tei:l>
          <tei:l>וּתְבִיאֵֽנוּ אֶל־מְחוֹז חֶפְצֵֽנוּ לְחַיִּים וּלְשָׁלוֹם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_travelers_prayer/2"/>
        <tei:lg>
          <tei:l>וְתַצִּילֵֽנוּ מִכַּף כָּל־אוֹיֵב וְאוֹרֵב בַּדֶּֽרֶךְ</tei:l>
          <tei:l>וְתִשְׁלַח בְּרָכָה בְּמַעֲשֵׂה יָדֵֽינוּ</tei:l>
          <tei:l>וְתִתְּנֵֽנוּ לְחֵן וּלְחֶֽסֶד וּלְרַחֲמִים בְּעֵינֶֽיךָ</tei:l>
          <tei:l>וּבְעֵינֵי כָל־רוֹאֵֽנוּ</tei:l>
          <tei:l>כִּי אַתָּה שׁוֹמֵֽעַ תְּפִלַּת עַמְּךָ יִשְׂרָאֵל בְּרַחֲמִים:</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְיָ שׁוֹמֵֽעַ תְּפִלָּה:‏</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_travelers_prayer/3"/>
        <tei:lg>
          <tei:l>תפילה נוספת לנוסע באוירון</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_travelers_prayer/4"/>
        <tei:lg>
          <tei:l>אִם אֶסַק שָׁמַיִם שָׁם אָתָּה,</tei:l>
          <tei:l>וְאַצִיעָה שְׁאוֺל הִנְךָ.</tei:l>
          <tei:l>אֶשָׂא כַנְפֵי שָׁחַר,</tei:l>
          <tei:l>אֶשְׁכְּנָה בְאַחֲרִית יָם.</tei:l>
          <tei:l>גַם שָׁם יָדְךָ תַנְחֵנִי,</tei:l>
          <tei:l>וְתֹאחֲזֵנִי יְמִינְךָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_travelers_prayer/5"/>
        <tei:lg>
          <tei:l>וִיהִי רָצוֺן מִלְפָנֶיךָ</tei:l>
          <tei:l>אָבִינוּ שֶׁבַשָׁמַיִם</tei:l>
          <tei:l>שֶׁתִּשְׁמְרֵנוּ מֵרוּחַ סוֺעָה מִסַעַר וּמִצַעַר</tei:l>
          <tei:l>וְתוֺצִיא רוּחַ טוֺב מֵאוֺצרוֺתֶיךָ</tei:l>
          <tei:l>לְהַנְהִיג אֶת סְפִינַת הָאַוִיר</tei:l>
          <tei:l>וְחַזֵק כָּל מַנְהִיגֶהָ וְאָמָנֶיהָ שֶׁיַנְהִגוּ אוֺתָה כָּרָאוּי</tei:l>
          <tei:l>בְּלֹא עַצְלוּת וְתֵשׁוּת כֹּחַ,</tei:l>
          <tei:l>וְתַגִיעֵנוּ אֶל מְחוֺז חֶפְצֵנוּ לְחַיִים וּלְשָׁלוֺם</tei:l>
          <tei:l>בְּלִי שׁוּם צַעַר וָנֵזֶק.</tei:l>
          <tei:l>שָׁמְרָה נַפְשִׁי וְהַצִילֵנִי</tei:l>
          <tei:l>אַל אֵבוֹשׁ</tei:l>
          <tei:l>כִּי חָסִיתִי בָךְ.</tei:l>
          <tei:l>וַאֲנַחְנוּ נְבָרֵךְ יָהּ,</tei:l>
          <tei:l>מֵעַתָּה וְעַד עוֺלָם הַלְלוּיָהּ׃</tei:l>
        </tei:lg>
      </tei:div>
