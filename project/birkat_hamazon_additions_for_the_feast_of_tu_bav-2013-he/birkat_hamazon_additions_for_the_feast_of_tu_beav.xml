    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:birkat_hamazon_additions_for_the_feast_of_tu_beav">
        <tei:head>ברכת המזון לסעודת ט״ו באב</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:birkat_hamazon_additions_for_the_feast_of_tu_beav/1"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יהוה אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>הַזָּן אֶת־הָעוֹלָם כֻּלּוֹ</tei:l>
          <tei:l>בְּטוּבוֹ</tei:l>
          <tei:l>בְּחֵן</tei:l>
          <tei:l>בְּחֶֽסֶד</tei:l>
          <tei:l>וּבְרַחֲמִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:birkat_hamazon_additions_for_the_feast_of_tu_beav/2"/>
        <tei:lg>
          <tei:l>אָגִיל</tei:l>
          <tei:l>גִּ֯ילָה וְאָשִׁיר שִׁירָה</tei:l>
          <tei:l>אַחַר מְזוֹנִי אֲפָאֵר בְּתִפְאָרָה</tei:l>
          <tei:l>בְּזׇכְרִי רִקּוּדֵי בְּנוֹת מַה־נּוֹרָא</tei:l>
          <tei:l>וְדִיצַת בְּנֵי מְקֻדֶּֽשֶׁת מֵעֲשָׂרָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:birkat_hamazon_additions_for_the_feast_of_tu_beav/3"/>
        <tei:lg>
          <tei:l>בַּחֲמִשָּׁה־עָשָׂר בְּאָב</tei:l>
          <tei:l>בָּ֯תֵּי־כְרָמֵֽינוּ שׁוּב נִנְחֹל</tei:l>
          <tei:l>בְּסׇלְחָךְ לָֽנוּ אֲשָׁמֵֽנוּ לִמְחֹל</tei:l>
          <tei:l>שַׂבְּעֵֽנוּ וּפְתִיחַת־יָדְךָ עָלֵֽינוּ תָּחוֹל</tei:l>
          <tei:l>בְּלֶכְתֵּֽנוּ לַכְּרָמִים לָצֵאת בְּמָחוֹל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:birkat_hamazon_additions_for_the_feast_of_tu_beav/4"/>
        <tei:lg>
          <tei:l>כַּכָּתוּב</tei:l>
          <tei:l>אָ֣ז תִּשְׂמַ֤ח בְּתוּלָה֙ בְּמָח֔וֹל</tei:l>
          <tei:l>וּבַחֻרִ֥ים וּזְקֵנִ֖ים יַחְדָּ֑ו</tei:l>
          <tei:l>וְהָפַכְתִּ֨י אֶבְלָ֤ם לְשָׂשׂוֹן֙</tei:l>
          <tei:l>וְנִ֣חַמְתִּ֔ים וְשִׂמַּחְתִּ֖ים מִיגוֹנָֽם׃ <tei:bibl>(ירמיהו לא:יג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:birkat_hamazon_additions_for_the_feast_of_tu_beav/5"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר</tei:l>
          <tei:l>פּוֹתֵ֥חַ אֶת־יָדֶ֑ךָ</tei:l>
          <tei:l>וּמַשְׂבִּ֖יעַ לְכׇל־חַ֣י רָצֽוֹן׃ <tei:bibl>(תהלים קמה:טז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:birkat_hamazon_additions_for_the_feast_of_tu_beav/6"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יהוה</tei:l>
          <tei:l>הַזָּן אֶת־הַכֹּל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:birkat_hamazon_additions_for_the_feast_of_tu_beav/7"/>
        <tei:lg>
          <tei:l>נוֹדֶה לְךָ יהוה אֱלֹהֵֽינוּ</tei:l>
          <tei:l>עַל־שֶׁהִנְחַלְתָּ לַאֲבוֹתֵֽינוּ</tei:l>
          <tei:l>אֶֽרֶץ חֶמְדָּה טוֹבָה וּרְחָבָה</tei:l>
          <tei:l>בְּרִית וְתוֹרָה</tei:l>
          <tei:l>חַיִּים וּמָזוֹן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:birkat_hamazon_additions_for_the_feast_of_tu_beav/8"/>
        <tei:lg>
          <tei:l>אָגִיל</tei:l>
          <tei:l>רִ֯נּוּנִים וְאֶעֱלֹס עִלּוּסִים</tei:l>
          <tei:l>בְּהַזְכִּירִי דִבְרֵי בְנוֹתַי לְבָנַי הַמִּתְנוֹסֲסִים</tei:l>
          <tei:l>בָּחוּר שָׂא־נָא עֵינֶֽיךָ וְעָלֵֽינוּ תָּשִׂים</tei:l>
          <tei:l>בְּנוֹי אַל־תִּסְתַּכֵּל כִּי־אִם בְּמַעֲשִׂים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:birkat_hamazon_additions_for_the_feast_of_tu_beav/9"/>
        <tei:lg>
          <tei:l>בַּחֲמִשָּׁה־עָשָׂר בְּאָב</tei:l>
          <tei:l>יִ֯עוּץ דִּבְרֵיהֶן עוֹד נַסְבִּיר</tei:l>
          <tei:l>כִּי בָאָדָם מַעֲשִׂים יִיצְרוּ גְּבִיר</tei:l>
          <tei:l>אֲבָל בְּאַדְמָתֵֽינוּ נוֹיָהּ לֹא תַעֲבִיר</tei:l>
          <tei:l>יֹֽפִי אַדְמַת דָּת וּבְרִית תַּגְבִּיר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:birkat_hamazon_additions_for_the_feast_of_tu_beav/10"/>
        <tei:lg>
          <tei:l>כַּכָּתוּב</tei:l>
          <tei:l>שֶׁ֣קֶר הַ֭חֵן וְהֶ֣בֶל הַיֹּ֑פִי</tei:l>
          <tei:l>אִשָּׁ֥ה יִרְאַת־י֝הו֗ה הִ֣יא תִתְהַלָּֽל׃ <tei:bibl>(משלי לא:ל)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:birkat_hamazon_additions_for_the_feast_of_tu_beav/11"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר</tei:l>
          <tei:l>וְאָכַלְתָּ֖ וְשָׂבָ֑עְתָּ</tei:l>
          <tei:l>וּבֵֽרַכְתָּ֙ אֶת־יהו֣ה אֱלֹהֶ֔יךָ</tei:l>
          <tei:l>עַל־הָאָ֥רֶץ הַטֹּבָ֖ה אֲשֶׁ֥ר נָֽתַן־לָֽךְ׃ <tei:bibl>(דברים ח:י)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:birkat_hamazon_additions_for_the_feast_of_tu_beav/12"/>
        <tei:lg>
          <tei:l>בָּרוּך אַתָּה יהוה</tei:l>
          <tei:l>עַל־הָאָֽרֶץ וְעַל־הַמָּזוֹן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:birkat_hamazon_additions_for_the_feast_of_tu_beav/13"/>
        <tei:lg>
          <tei:l>רַחֵם יהוה אֱלֹהֵֽינוּ</tei:l>
          <tei:l>עַל־יִשְׂרָאֵל עַמֶּֽךָ</tei:l>
          <tei:l>וְעַל־יְרוּשָׁלַֽיִם עִירֶֽךָ</tei:l>
          <tei:l>וְעַל־צִיּוֹן מִשְׁכַּן כְּבוֹדֶֽךָ</tei:l>
          <tei:l>וְעַל־מַלְכוּת בֵּית־דָּוִד מְשִׁיחֶֽךָ</tei:l>
          <tei:l>וְעַל־הַבַּֽיִת הַגָּדוֹל וְהַקָּדוֹשׁ שֶׁנִּקְרָא שִׁמְךָ עָלָיו</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:birkat_hamazon_additions_for_the_feast_of_tu_beav/14"/>
        <tei:lg>
          <tei:l>אָגִיל</tei:l>
          <tei:l>אֲ֯הָבִים וְאֶעֱרֹג בְּרֹן</tei:l>
          <tei:l>בְּהַעֲלוֹתִי עַל־לִבִּי מְקוֹם הָאָרוֹן</tei:l>
          <tei:l>עֲטֶֽרֶת רֹאשֵֽׁנוּ שֵׁרְתוּ בוֹ בְּנֵי אַהֲרֹן</tei:l>
          <tei:l>כׇּל־עוֹד עָמַד חָגֲגוּ בְנוֹתַי בִּכְלֵי חִוָּרוֹן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:birkat_hamazon_additions_for_the_feast_of_tu_beav/15"/>
        <tei:lg>
          <tei:l>בַּחֲמִשָּׁה־עָשָׂר בְּאָב</tei:l>
          <tei:l>לִֽ֯ינָה עוֹד בֵּין־שָׁדֵֽינוּ</tei:l>
          <tei:l>כְּמוֹ לַֽנּוּ בַּכְּפָרִים וּבְכַרְמֵי מְגָדֵֽינוּ</tei:l>
          <tei:l>חַדֵּשׁ דְּבִירֵֽנוּ וּבֵית כְּבוֹדֵֽינוּ</tei:l>
          <tei:l>עֲטֶֽרֶת הֵיכָלֵֽנוּ בָּנָה מֶֽלֶךְ שְׁלוֹמֵֽנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:birkat_hamazon_additions_for_the_feast_of_tu_beav/16"/>
        <tei:lg>
          <tei:l>כַּכָּתוּב</tei:l>
          <tei:l>צְאֶ֧נָה ׀ וּֽרְאֶ֛ינָה</tei:l>
          <tei:l>בְּנ֥וֹת צִיּ֖וֹן בַּמֶּ֣לֶךְ שְׁלֹמֹ֑ה</tei:l>
          <tei:l>בָּעֲטָרָ֗ה שֶׁעִטְּרָה־לּ֤וֹ אִמּוֹ֙</tei:l>
          <tei:l>בְּי֣וֹם חֲתֻנָּת֔וֹ וּבְי֖וֹם שִׂמְחַ֥ת לִבּֽוֹ׃ <tei:bibl>(שיר השירים ג:יא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:birkat_hamazon_additions_for_the_feast_of_tu_beav/17"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר</tei:l>
          <tei:l>בּוֹנֵ֣ה יְרוּשָׁלַ֣͏ִם יהו֑ה</tei:l>
          <tei:l>נִדְחֵ֖י יִשְׂרָאֵ֣ל יְכַנֵּֽס׃ <tei:bibl>(תהלים קמז:ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:birkat_hamazon_additions_for_the_feast_of_tu_beav/18"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יהוה</tei:l>
          <tei:l>בּוֹנֶה בְּרַחֲמָיו יְרוּשָׁלָֽיִם׃</tei:l>
          <tei:l>אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:birkat_hamazon_additions_for_the_feast_of_tu_beav/19"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יהוה אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>הָאֵל</tei:l>
          <tei:l>אָבִֽינוּ</tei:l>
          <tei:l>מַלְכֵּֽנוּ</tei:l>
          <tei:l>אַדִּירֵֽנוּ</tei:l>
          <tei:l>קְדוֹשֵֽׁנוּ</tei:l>
          <tei:l>קְדוֹשׁ יַעֲקֹב</tei:l>
          <tei:l>הַמֶּֽלֶךְ הַטּוֹב וְהַמֵּטִיב</tei:l>
          <tei:l>אֲשֶׁר בְּכׇל־יוֹם וְיוֹם</tei:l>
          <tei:l>הוּא הֵטִיב</tei:l>
          <tei:l>מֵטִיב</tei:l>
          <tei:l>יֵיטִיב לָֽנוּ</tei:l>
          <tei:l>הוּא גְּמָלָֽנוּ</tei:l>
          <tei:l>גּוֹמְלֵֽנוּ</tei:l>
          <tei:l>יִגְמְלֵֽנוּ לָעַד</tei:l>
          <tei:l>חֵן</tei:l>
          <tei:l>וָחֶֽסֶד</tei:l>
          <tei:l>וְרַחֲמִים</tei:l>
          <tei:l>וְכׇל־טוֹב׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
