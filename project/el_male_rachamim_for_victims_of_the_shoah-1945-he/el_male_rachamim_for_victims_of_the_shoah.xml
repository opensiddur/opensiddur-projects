  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:el_male_rachamim_for_victims_of_the_shoah">
        <tei:head>אֵל מָלֵא רַחֲמִים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:el_male_rachamim_for_victims_of_the_shoah/2"/>
        <tei:lg>
          <tei:l>אֵל מָלֵא רַחֲמִים</tei:l>
          <tei:l>שׁוֹכֵן בַּמְרוֹמִים</tei:l>
          <tei:l>בְּלֵב נִדְכֶּה נָבוֹא אֵלֶיךָ</tei:l>
          <tei:l>וּבְרוּחַ נִשְׁבָּרָה נְקַדֵּם פָּנֶיךָ</tei:l>
          <tei:l>לְהִתְפַּלֵּל בְּעַד נִשְׁמוֹת אֲחֵינוּ וְאַחְיוֹתֵינוּ</tei:l>
          <tei:l>אֲשֶׁר בְּאַרצוֹת גָלוּתָם גָזָעוּ</tei:l>
          <tei:l>בְּצָרָה גְדוֹלָה</tei:l>
          <tei:l>אֲשֶׁר מְצָאָתַם בְּדֶרֶךְ עָנְיָם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:el_male_rachamim_for_victims_of_the_shoah/3"/>
        <tei:lg>
          <tei:l>חֵן בְּעוֹדָם בַּחַיִּים</tei:l>
          <tei:l>מָגוֹר הִכְשִׁיל כֹּחָם</tei:l>
          <tei:l>וְחֵילָם תּוּגָה הִשְׁחִיתָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:el_male_rachamim_for_victims_of_the_shoah/4"/>
        <tei:lg>
          <tei:l>כָּלוּ בְיָגוֹן חַיֵּיהֶם</tei:l>
          <tei:l>וּבַחַרָדָה יָרְדוּ מָוֶת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:el_male_rachamim_for_victims_of_the_shoah/5"/>
        <tei:lg>
          <tei:l>וְעַתָּה אֵלֶיךָ ה׳ נִשָֺא נֶפֶשׁ מָרָה</tei:l>
          <tei:l>וְשִׂיחֵנוּ נִשְׁפֹּךְ לִפְנֵי רָחֲמֶיךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:el_male_rachamim_for_victims_of_the_shoah/6"/>
        <tei:lg>
          <tei:l>אָנָּא זְכוֹר לָאֻמְלָלִים הָאֵלֶה</tei:l>
          <tei:l>אֶת כָּל הָתְלָאָה אֲשֶׁר מְצָאָתַם</tei:l>
          <tei:l>וְאֶת הַמְצוּקוֹת אֲשֶׁר הִשִׂיגוּם</tei:l>
          <tei:l>וְגַם אֲפָפוּם</tei:l>
          <tei:l>עַד חַדְרֵי הַמָוֶת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:el_male_rachamim_for_victims_of_the_shoah/7"/>
        <tei:lg>
          <tei:l>פְּתַח לָהֶם שָׁעֲרֵי רַחֲמִים</tei:l>
          <tei:l>וְתֶחֱמֶינָה נִשְׁמוֹתֵיהֶם</tei:l>
          <tei:l>בְּצֵל כְּנָפֶיךָ</tei:l>
          <tei:l>וְהִתְעַנְּנוּ עַל זִיז שְׁכִינָתְךָ</tei:l>
          <tei:l>לֵאוֹר בְּאוֹר רְצוֹנֶיךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:el_male_rachamim_for_victims_of_the_shoah/8"/>
        <tei:lg>
          <tei:l>וְגוּפָם יָנוּחַ בַּקֵּבֵר בִּמְּנוּחָה נְכוֹנָה</tei:l>
          <tei:l>וְשָׁכְבוּ וְאֵין מַחֲרִיד׃</tei:l>
          <tei:l>עַל מְשְׁכָבָם יְהִי שָׁלוֹם</tei:l>
          <tei:l>וְיִלָּוֶה אֲלֵיהֶם הַשָׁלוֹם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:el_male_rachamim_for_victims_of_the_shoah/9"/>
        <tei:lg>
          <tei:l>וְיָקִיצוּ מִשְׁנָתָם</tei:l>
          <tei:l>בִּתְחִיַת הַמֵתִים</tei:l>
          <tei:l>לְקֵץ הַיָמִין</tei:l>
          <tei:l>וְנֹאמַר אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
