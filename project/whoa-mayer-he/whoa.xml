  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:whoa">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:whoa/1"/>
        <tei:lg>
          <tei:l>מִרְיָם שִׁירִי אַל־תִּבְכִּי עוֹד</tei:l>
          <tei:l>מִרְיָם שִׁירִי אַל־תִּבְכִּי עוֹד</tei:l>
          <tei:l>צְבָא מְצָרִים הֻטְבַּע</tei:l>
          <tei:l>אָז מִרְיָם אַל־תִּבְכִּי עוֹד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:whoa/2"/>
        <tei:lg>
          <tei:l>אִם הָיָה אֶפְשָׁר לָקוּם</tei:l>
          <tei:l>בְּצוּר מֹשֶׁה לִרְאוֹת קִיּוּם</tei:l>
          <tei:l>צְבָא וגו׳</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:whoa/3"/>
        <tei:lg>
          <tei:l>בַּלַּיְלָה הַבָּא בִּזְמַן כַּחֲצוֹת</tei:l>
          <tei:l>בְּכׇל־הָעוֹלָם תִּהְיֶינָה רְעִידוֹת</tei:l>
          <tei:l>צְבָא וגו׳</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:whoa/4"/>
        <tei:lg>
          <tei:l>צִוָּה לְמשֶׁה מָה לַעֲשׂוֹת</tei:l>
          <tei:l>לְכׇל־יִשְׂרָאֵל בָּנִים וּבָנוֹת</tei:l>
          <tei:l>צְבָא וגו׳</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:whoa/5"/>
        <tei:lg>
          <tei:l>עָמַד מֹשֶׁה עַל־שְׂפַת הַיָּם</tei:l>
          <tei:l>הִכָּה אֶת־הַמַּיִם לִפְנֵי כׇל־הָעָם</tei:l>
          <tei:l>צְבָא וגו׳</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:whoa/6"/>
        <tei:lg>
          <tei:l>נָתַן לְנֹחַ אֶת־הַסִּימָן</tei:l>
          <tei:l>שֶׁאֵין עוֹד מַיִם אַךְ אֵשׁ בִּזְמַן</tei:l>
          <tei:l>צְבָא וגו׳</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
