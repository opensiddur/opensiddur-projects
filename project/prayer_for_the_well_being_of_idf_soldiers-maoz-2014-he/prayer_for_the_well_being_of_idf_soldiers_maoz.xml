    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_the_well_being_of_idf_soldiers_maoz">
        <tei:head>ברכה לשלום החיילים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_well_being_of_idf_soldiers_maoz/1"/>
        <tei:lg>
          <tei:l>נְבָרֵךְ אֶת חַיָּלוֹת וְחַיָּלֵי צְבַא הֲגַנָּה לְיִשְֹרָאֵל,</tei:l>
          <tei:l>הַיּוֹצְאִים חָלוּץ לִפְנֵי הַמַּחֲנֶה</tei:l>
          <tei:l>לַהֲגַנָּת הַחֶבְרָה הַיִּשְֹרָאֵלִית וְעֶרְכֵי הַחֵרוּת, הַשִּוְיוֹן וְהַצֶּדֶק.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_well_being_of_idf_soldiers_maoz/2"/>
        <tei:lg>
          <tei:l>יִהְיוּ נָא מַצְלִיחִים בְּכָל מְשִֹימוֹתֵיהֶם,</tei:l>
          <tei:l>בַּיַּבָּשָה בָּאֲוִיר וּבַיָּם,</tei:l>
          <tei:l>בְּתוֹךְ הַמְּדִינָה וּמִחוּץ לִגְבוּלוֹתֶיהָ,</tei:l>
          <tei:l>וְיָבוֹאוּ מִן הַקְּרָב</tei:l>
          <tei:l>עֲטוּרֵי תְּהִילַת־נִצָּחוֹן.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_well_being_of_idf_soldiers_maoz/3"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן שֶיָּשוּבוּ לְבָתֵּי מִשְפְּחוֹתֵיהֶם</tei:l>
          <tei:l>שְלֵמִים בְּגוּפָם וּבְרִיאִים בְּנַפְשָם,</tei:l>
          <tei:l>נְקִיֵּי־כַפַּיִם מִּכָּל הֶרֶג־חִנָּם</tei:l>
          <tei:l>וּבְרֵי־לְבָב מִּכָּל כַּוָנַת־זָדוֹן.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_well_being_of_idf_soldiers_maoz/4"/>
        <tei:lg>
          <tei:l>וִיהִי רָצוֹן שֶיְּקֻיָּם בְּכָל צִבְאוֹת הָעוֹלָם מִקְרָא שֶכָּתוּב:</tei:l>
          <tei:l>וְכִתְּתוּ חַרְבוֹתָם לְאִתִּים</tei:l>
          <tei:l>וַחֲנִיתוֹתֵיהֶם לְמַזְמֵרוֹת,</tei:l>
          <tei:l>לֹא יִשָּׂא גוֹי אֶל גּוֹי חֶרֶב</tei:l>
          <tei:l>וְלֹא יִלְמְדוּ עוֹד מִלְחָמָה. <tei:bibl>(ישעיה ב:ד)</tei:bibl></tei:l>
          <tei:l>וְנָתַתִּי שָׁלוֹם בָּאָרֶץ, <tei:bibl>(ויקרא כו:ו חלק)</tei:bibl></tei:l>
          <tei:l>וְנֹאמַר אָמֵן.</tei:l>
        </tei:lg>
      </tei:div>
