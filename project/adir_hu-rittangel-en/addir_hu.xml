  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:addir_hu">
        <tei:head>Adir Hu, the acrostic piyyuṭ in its Latin translation by Johann Stephan Rittangel (1644)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_hu/1"/>
        <tei:lg>
          <tei:l>Magnificent One,</tei:l>
          <tei:l>Quickly build your home,</tei:l>
          <tei:l>Soon in our lifetime.</tei:l>
          <tei:l>O build, build, build,</tei:l>
          <tei:l>Build your home quickly!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_hu/2"/>
        <tei:lg>
