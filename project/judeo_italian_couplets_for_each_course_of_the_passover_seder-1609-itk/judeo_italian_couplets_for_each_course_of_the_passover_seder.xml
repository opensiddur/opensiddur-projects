  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_course_of_the_passover_seder">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_course_of_the_passover_seder/1"/>
        <tei:lg>
          <tei:l>קַדֵּשׁ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>אֵימְפִּיִי אִיל בִּיקְיֵרוֹ</tei:l>
          <tei:l>בֵּין פְּיֵינוֹ דִי וִינוֹ</tei:l>
          <tei:l>אֵי דִי קִדּוּשׁ לַאוּדֵי</tei:l>
          <tei:l>אַל סִינְיוֹר דִיוִינוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_course_of_the_passover_seder/2"/>
        <tei:lg>
          <tei:l>וּרְחַץ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>לַאוַה לֵי מַאנִי</tei:l>
          <tei:l>קוֹן אוֹנְיִי אוֹנְדֵיצַה</tei:l>
          <tei:l>סֵינְצַה פַֿאר בְּרָכָה</tei:l>
          <tei:l>קוֹן פּוֹלִיטֵיצַה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_course_of_the_passover_seder/3"/>
        <tei:lg>
          <tei:l>כַּרְפַּס</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>נֵיל חֲרוֹסֶת דֵיל אַפְּיוֹ</tei:l>
          <tei:l>אִינְפֿוֹנְדֵירַאִי</tei:l>
          <tei:l>אֵי בּוֹרֵא פְּרִי הָאֲדָמָה</tei:l>
          <tei:l>בֵּינֵידִירַאִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_course_of_the_passover_seder/4"/>
        <tei:lg>
          <tei:l>יַחַץ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>פַּארְטִּי אִיל שִׁמּוּר דִי מֵיזוֹ</tei:l>
          <tei:l>אִי מֵיזזוֹ דֵי אֵיסּוֹ</tei:l>
          <tei:l>סִיאַה פֵּיר אֲפִיקוֹמֶן</tei:l>
          <tei:l>רִיפּוֹסְטוֹ אֵי מֵיסוֹּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_course_of_the_passover_seder/5"/>
        <tei:lg>
          <tei:l>מַגִּיד</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>דִירַאִי לַה הַגָּדָה</tei:l>
          <tei:l>קוֹמֵי אֵי קְוִי סְקְרִיטוֹ</tei:l>
          <tei:l>דַא הָא לַחְמָא סִין</tei:l>
          <tei:l>קֵי אֵיל רֵיסְטוֹ אַבְּיִי דִיטוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_course_of_the_passover_seder/6"/>
        <tei:lg>
          <tei:l>רָחְצָה</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>אוּנַאלְטְרַה ווֹלְטַה</tei:l>
          <tei:l>לַאוַאטֵי לֵי מַאנִי</tei:l>
          <tei:l>קוֹן בְּרָכָה</tei:l>
          <tei:l>סֵינְצַה פֵּינְסְיֵירִי וַאנִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_course_of_the_passover_seder/7"/>
        <tei:lg>
          <tei:l>מוֹצִיא מַצָּה</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>פִּילִיַיה אִיל שִׁמּוּר</tei:l>
          <tei:l>דִי סוֹפְּרַה אֵי צִי פַּארַאִי</tei:l>
          <tei:l>הַמּוֹצִיא לֶחֶם</tei:l>
          <tei:l>אֵי נוֹן נֵי מַאנְיַארַאִי׃</tei:l>
          <tei:l>מַה סְפֵּיצַה קְוֵילַה מֵיזַה</tei:l>
          <tei:l>אֵי דֵיטוֹ פּוֹאִי</tei:l>
          <tei:l>עַל אֲכִילָת מַצָּה</tei:l>
          <tei:l>מַאנְיַיה אַמְבִּי דּוֹאִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_course_of_the_passover_seder/8"/>
        <tei:lg>
          <tei:l>מָרוֹר</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>נֵיל חֲרוֹסֶת לַטוּקַה</tei:l>
          <tei:l>אַוְורַאִי אִינְפֿוּסַה</tei:l>
          <tei:l>קוֹן דִיר עַל אֲכִילָת</tei:l>
          <tei:l>מָרוֹר קֵי סְ אוּסַה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_course_of_the_passover_seder/9"/>
        <tei:lg>
          <tei:l>כּוֹרֵךְ</tei:l>
          <tei:l>דֵיל טֵירְצוֹ שִׁמּוּר</tei:l>
          <tei:l>ווֹלְגִיי אִין אוּנַה פֿוֹלְיַיה</tei:l>
          <tei:l>אֵי דִי זֵכֶר לַמִּקְדָּשׁ</tei:l>
          <tei:l>דִּי מַאלַה ווֹלְיַיה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_course_of_the_passover_seder/10"/>
        <tei:lg>
          <tei:l>שֻׁלְחָן עוֹרֵךְ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>קוֹנְצִיַיה לַה מֵינְסַה</tei:l>
          <tei:l>אֵי אִיל צִיבּוֹ אִין בּוֹקַה קַאצִיַה</tei:l>
          <tei:l>אֵי מַאנְיַיה קְוַאנְטוֹ ווֹאִי</tei:l>
          <tei:l>קֵי פְּרוֹ טִי פַֿאצִיַה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_course_of_the_passover_seder/11"/>
        <tei:lg>
          <tei:l>צָפוּן</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>לְאֲפִיקוֹמֶן קֵי גְיַה</tei:l>
          <tei:l>אַאִי רִיסֵירְבַאטוֹ</tei:l>
          <tei:l>אִין פִֿין קוֹן דֵיווֹצִיוֹן</tei:l>
          <tei:l>סַארַה מַאנְיַאטוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_course_of_the_passover_seder/12"/>
        <tei:lg>
          <tei:l>בָּרֵךְ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>סֵינְצַה מַאנְיַיאר</tei:l>
          <tei:l>נֵי בֵּיר אַלְטְרוֹ פְּרוֹקוּרַה</tei:l>
          <tei:l>דִּיר בְּרָכָה</tei:l>
          <tei:l>אֵי פֵּיר זִמּוּן פּוֹן קוּרָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_course_of_the_passover_seder/13"/>
        <tei:lg>
          <tei:l>הַלֵּל</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>שְׁפוֹךְ קוֹמִינְצִיַיה</tei:l>
          <tei:l>אֵיט אִיל הַלֵּל פִֿינִישִׁי</tei:l>
          <tei:l>אֵי קְוֵיל קֵי טִי</tei:l>
          <tei:l>אַה סַאלְוַטוֹ בֵּינֵידִישִׁי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_course_of_the_passover_seder/14"/>
        <tei:lg>
          <tei:l>נִרְצָה</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>פְּרֵיגַה אִידִיוֹ</tei:l>
          <tei:l>קֵי אִיל בּוֹן ווֹלֵיר אַצֵיטַה</tei:l>
          <tei:l>אֵי קֵי אִין יְרוּשָׁלִַם</tei:l>
          <tei:l>צִי רִימֵטַה׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
