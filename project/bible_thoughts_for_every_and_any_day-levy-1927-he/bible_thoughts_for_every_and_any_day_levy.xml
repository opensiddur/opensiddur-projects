  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/2"/>
        <tei:lg>
          <tei:l>וְאָהַבְתָּ אֵת יְהֹוָה אֱלֹהֶיךָ</tei:l>
          <tei:l>בְּכׇל־לְבָבְךָ וּבְכׇל־נַפְשְׁךָ וּבְכׇל־מְאֹדֶךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/3"/>
        <tei:lg>
          <tei:l>רְאֵה נָתַתִּי לְפָנֶיךָ הַיּוֹם</tei:l>
          <tei:l>אֶת־הַחַיִּים וְאֶת־הַטּוֹב</tei:l>
          <tei:l>וְאֶת־הַמָּוֶת וְאֶת־הָרָע׃</tei:l>
          <tei:l>אֲשֶׁר אָנֹכִי מְצַוְּךָ הַיּוֹם</tei:l>
          <tei:l>לְאַהֲבָה אֶת־יְהֹוָה אֱלֹהֶיךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/4"/>
        <tei:lg>
          <tei:l>בְּחַבְלֵי אָדָם אֶמְשְׁכֵם בַּעֲבֹתוֹת אַהֲבָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/5"/>
        <tei:lg>
          <tei:l>כִּי בִי חָשַׁק וַאֲפַלְּטֵהוּ אֲשַׂגְּבֵהוּ כִּי־יָדַע שְׁמִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/6"/>
        <tei:lg>
          <tei:l>יְהֹוָה עֻזִּי וּמָגִנִּי</tei:l>
          <tei:l>בּוֹ בָטַח לִבִּי וְנֶעֱזָרְתִּי</tei:l>
          <tei:l>וַיַּעֲלֹז לִבִּי וּמִשִּׁירִי אֲהוֹדֶנּוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/7"/>
        <tei:lg>
          <tei:l>יְהֹוָה אוֹרִי וְיִשְׁעִי</tei:l>
          <tei:l>מִמִּי אִירָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/8"/>
        <tei:lg>
          <tei:l>אִמְרוּ לְנִמְהֲרֵי־לֵב</tei:l>
          <tei:l>חִזְקוּ אַל־תִּירָאוּ ...</tei:l>
          <tei:l>וְשִׂמְחָה יַשִּׂיגוּ</tei:l>
          <tei:l>וְנָסוּ יָגוֹן וַאֲנָחָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/9"/>
        <tei:lg>
          <tei:l>אַל־תִּירָא כִּי עִמְּךָ־אָנִי</tei:l>
          <tei:l>אַל־תִּשְׁתָּע כִּי־אֲנִי אֱלֹהֶיךָ</tei:l>
          <tei:l>אִמַּצְתִּיךָ אַף־עֲזַרְתִּיךָ</tei:l>
          <tei:l>אַף־תְּמַכְתִּיךָ בִּימִין צִדְקִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/10"/>
        <tei:lg>
          <tei:l>וְרוּחִי עֹמֶדֶת בְּתוֹכְכֶם</tei:l>
          <tei:l>אַל־תִּירָאוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/11"/>
        <tei:lg>
          <tei:l>אַל־תִּירָאוּ תֶּחֱזַקְנָה יְדֵיכֶם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/12"/>
        <tei:lg>
          <tei:l>וְצַדִּיק בֶּאֱמוּנָתוֹ יִחְיֶה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/13"/>
        <tei:lg>
          <tei:l>אָכֵן רוּחַ־הִיא בֶאֱנוֹשׁ</tei:l>
          <tei:l>וְנִשְׁמַת שַׁדַּי</tei:l>
          <tei:l>תְּבִינֵם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/14"/>
        <tei:lg>
          <tei:l>לֵב טָהוֹר בְּרָא־לִי אֱלֹהִים</tei:l>
          <tei:l>וְרוּחַ נָכוֹן חַדֵּשׁ בְּקִרְבִּי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/15"/>
        <tei:lg>
          <tei:l>רְאוּ עַתָּה כִּי אֲנִי אֲנִי הוּא</tei:l>
          <tei:l>וְאֵין אֱלֹהִים עִמָּדִי</tei:l>
          <tei:l>אֲנִי אָמִית וַאֲחַיֶּה</tei:l>
          <tei:l>מָחַצְתִּי וַאֲנִי אֶרְפָּא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/16"/>
        <tei:lg>
          <tei:l>אֲנִי־אָמַרְתִּי יְהֹוָה חׇנֵּנִי</tei:l>
          <tei:l>רְפָאָה נַפְשִׁי</tei:l>
          <tei:l>כִּי־חָטָאתִי לָךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/17"/>
        <tei:lg>
          <tei:l>צוּף־דְּבַשׁ אִמְרֵי־נֹעַם</tei:l>
          <tei:l>מָתוֹק לַנֶּפֶשׁ וּמַרְפֵּא לָעָצֶם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/18"/>
        <tei:lg>
          <tei:l>בּוֹרֵא (נוב) [נִיב] שְׂפָתָיִם שָׁלוֹם שָׁלוֹם לָרָחוֹק וְלַקָּרוֹב אָמַר יְהֹוָה</tei:l>
          <tei:l>וּרְפָאתִיו׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/19"/>
        <tei:lg>
          <tei:l>יְהֹוָה אֱלֹהָי שִׁוַּעְתִּי אֵלֶיךָ</tei:l>
          <tei:l>וַתִּרְפָּאֵנִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/20"/>
        <tei:lg>
          <tei:l>הַסֹּלֵחַ לְכׇל־עֲוֺנֵכִי</tei:l>
          <tei:l>הָרֹפֵא לְכׇל־תַּחֲלוּאָיְכִי׃</tei:l>
          <tei:l>הַגּוֹאֵל מִשַּׁחַת חַיָּיְכִי</tei:l>
          <tei:l>הַמְעַטְּרֵכִי חֶסֶד וְרַחֲמִים׃</tei:l>
          <tei:l>...תִּתְחַדֵּשׁ כַּנֶּשֶׁר נְעוּרָיְכִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/21"/>
        <tei:lg>
          <tei:l>יְהֹוָה מָעוֹז־חַיַּי</tei:l>
          <tei:l>מִמִּי אֶפְחָד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/22"/>
        <tei:lg>
          <tei:l>כָּלָה שְׁאֵרִי וּלְבָבִי</tei:l>
          <tei:l>צוּר־לְבָבִי</tei:l>
          <tei:l>וְחֶלְקִי אֱלֹהִים לְעוֹלָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/23"/>
        <tei:lg>
          <tei:l>בְּיוֹם קָרָאתִי וַתַּעֲנֵנִי</tei:l>
          <tei:l>תַּרְהִבֵנִי בְנַפְשִׁי עֹז׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/24"/>
        <tei:lg>
          <tei:l>הִנֵּה אֱלֹהִים עֹזֵר לִי</tei:l>
          <tei:l>אֲדֹנָי בְּסֹמְכֵי נַפְשִׁי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/25"/>
        <tei:lg>
          <tei:l>וְשֹׁמֵעַ לִי יִשְׁכׇּן־בֶּטַח וְשַׁאֲנַן מִפַּחַד רָעָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/26"/>
        <tei:lg>
          <tei:l>אִם־תִּשְׁכַּב לֹא־תִפְחָד</tei:l>
          <tei:l>וְשָׁכַבְתָּ וְעָרְבָה שְׁנָתֶךָ׃</tei:l>
          <tei:l>כִּי־יְהֹוָה יִהְיֶה בְכִסְלֶךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/27"/>
        <tei:lg>
          <tei:l>לֵב שָׂמֵחַ יֵיטִב פָּנִים</tei:l>
          <tei:l>וּבְעַצְּבַת־לֵב רוּחַ נְכֵאָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/28"/>
        <tei:lg>
          <tei:l>גַּם כִּי־אֵלֵךְ בְּגֵיא צַלְמָוֶת</tei:l>
          <tei:l>לֹא־אִירָא רָע כִּי־אַתָּה עִמָּדִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/29"/>
        <tei:lg>
          <tei:l>אֶהֱבוּ אֶת־יְהֹוָה כׇּל־חֲסִידָיו</tei:l>
          <tei:l>אֱמוּנִים נֹצֵר יְהֹוָה...</tei:l>
          <tei:l>חִזְקוּ וְיַאֲמֵץ לְבַבְכֶם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/30"/>
        <tei:lg>
          <tei:l>חֶסֶד־וֶאֱמֶת נִפְגָּשׁוּ</tei:l>
          <tei:l>צֶדֶק וְשָׁלוֹם נָשָׁקוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/31"/>
        <tei:lg>
          <tei:l>בִּלַּע הַמָּוֶת לָנֶצַח</tei:l>
          <tei:l>וּמָחָה אֲדֹנָי יֱהֹוִה דִּמְעָה מֵעַל כׇּל־פָּנִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:bible_thoughts_for_every_and_any_day_levy/32"/>
        <tei:lg>
          <tei:l>אַךְ לֵאלֹהִים דּוֹמִּי נַפְשִׁי</tei:l>
          <tei:l>כִּי־מִמֶּנּוּ תִּקְוָתִי׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
