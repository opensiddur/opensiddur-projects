    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:supplemental_stanzas_to_maoz_tsur_with_regard_to_the_present_exile_by_shmuel_ben_david_moshe_halevi_of_mezeritch">
        <tei:head>תוספת בתים למעוז צור</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:supplemental_stanzas_to_maoz_tsur_with_regard_to_the_present_exile_by_shmuel_ben_david_moshe_halevi_of_mezeritch/1"/>
        <tei:lg>
          <tei:l>שִׁׄמְךָ יְבָרֵךְ לְעוֹלָם</tei:l>
          <tei:l>מִׄתּוֹךְ קְהַל אֱמוּנִים</tei:l>
          <tei:l>וְׄכִסְאֲךָ יְהֵא שָׁלֵם</tei:l>
          <tei:l>אִׄם תִּנְקֹם בִּזְדוֹנִים</tei:l>
          <tei:l>לִׄנְפָשׁוֹת נַעֲנִים</tei:l>
          <tei:l>הַׄסְכֵּת מִמְּעוֹנִים</tei:l>
          <tei:l>לְׄהוֹשִֽׁיעַ עַמְּךָ</tei:l>
          <tei:l>וּׄלְהַצִּיל שְׂרִידְךָ</tei:l>
          <tei:l>יְׄדִידְךָ כְּאָז בִּימֵי חַשְׁמַנִּים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:supplemental_stanzas_to_maoz_tsur_with_regard_to_the_present_exile_by_shmuel_ben_david_moshe_halevi_of_mezeritch/2"/>
        <tei:lg>
          <tei:l>חַׄי זְׄקֹף קֶֽׄרֶן יְשׁוּעָה</tei:l>
          <tei:l>וְקָרֵב קֵץ הַגְּאֻלָּה</tei:l>
          <tei:l>וּמַלְכוּת זָדוֹן הָרְשָׁעָה</tei:l>
          <tei:l>יְהִי מֵעִיר<tei:anchor xml:id="note_1"/> מַפָּלָה</tei:l>
          <tei:l>בִּנְפֹל בְּנֵי עַוְלָה</tei:l>
          <tei:l>וּלְעַמְּךָ תַּעֲשֶׂה הַצָּלָה</tei:l>
          <tei:l>בְּצִדְקָתְךָ אֵתָנִים</tei:l>
          <tei:l>גְּאַל בָּנִים</tei:l>
          <tei:l>וְתִבְנֶה הָעִיר עַל־תִּלָּהּ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
