  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:non_e_come_lo_ded_nostro_a_renaissance_judeo_italian">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:non_e_come_lo_ded_nostro_a_renaissance_judeo_italian/1"/>
        <tei:lg>
          <tei:l>None is like our <j:divineName>God</j:divineName>!</tei:l>
          <tei:l>None is like our <j:divineName>Lord</j:divineName>!</tei:l>
          <tei:l>None is like our <j:divineName>Sovereign</j:divineName>!</tei:l>
          <tei:l>None is like our <j:divineName>Savior</j:divineName>!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:non_e_come_lo_ded_nostro_a_renaissance_judeo_italian/2"/>
        <tei:lg>
          <tei:l>Who is like our <j:divineName>God</j:divineName>?</tei:l>
          <tei:l>Who is like our <j:divineName>Lord</j:divineName>?</tei:l>
          <tei:l>Who is like our <j:divineName>Sovereign</j:divineName>?</tei:l>
          <tei:l>Who is like our <j:divineName>Savior</j:divineName>?</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:non_e_come_lo_ded_nostro_a_renaissance_judeo_italian/3"/>
        <tei:lg>
          <tei:l>Let us laud our <j:divineName>God</j:divineName>!</tei:l>
          <tei:l>Let us laud our <j:divineName>Lord</j:divineName>!</tei:l>
          <tei:l>Let us laud our <j:divineName>Sovereign</j:divineName>!</tei:l>
          <tei:l>Let us laud our <j:divineName>Savior</j:divineName>!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:non_e_come_lo_ded_nostro_a_renaissance_judeo_italian/4"/>
        <tei:lg>
          <tei:l>You are our <j:divineName>God</j:divineName>!</tei:l>
          <tei:l>You are our <j:divineName>Lord</j:divineName>!</tei:l>
          <tei:l>You are our <j:divineName>Sovereign</j:divineName>!</tei:l>
          <tei:l>You are our <j:divineName>Savior</j:divineName>!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:non_e_come_lo_ded_nostro_a_renaissance_judeo_italian/5"/>
        <tei:lg>
          <tei:l><j:divineName>The CAUSE</j:divineName> wanted</tei:l>
          <tei:l>for <j:divineName>Their</j:divineName> justice’s sake</tei:l>
          <tei:l>to greaten and strengthen the Torah.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
