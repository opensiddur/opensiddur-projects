      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/116">
        <tei:head>תהלים קט״ז</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/116/1"/>
        <tei:lg>
          <tei:l>אָהַבְתִּי</tei:l>
          <tei:l>כִּי־יִשְׁמַע יְהֹוָה אֶת־קוֹלִי תַּחֲנוּנָי׃</tei:l>
          <tei:l>כִּי־הִטָּה אׇזְנוֹ לִי וּבְיָמַי אֶקְרָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>אֲפָפוּנִי חֶבְלֵי־מָוֶת</tei:l>
          <tei:l>וּמְצָרֵי שְׁאוֹל מְצָאוּנִי</tei:l>
          <tei:l>צָרָה וְיָגוֹן אֶמְצָא׃</tei:l>
          <tei:l>וּבְשֵׁם־יְהֹוָה אֶקְרָא</tei:l>
          <tei:l>אָנָּה יְהֹוָה מַלְּטָה נַפְשִׁי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/116/5/a"/>
        <tei:lg>
          <tei:l>חַנּוּן יְהֹוָה וְצַדִּיק</tei:l>
          <tei:l>וֵאלֹהֵינוּ מְרַחֵם׃</tei:l>
          <tei:l>שֹׁמֵר פְּתָאיִם יְהֹוָה</tei:l>
          <tei:l>דַּלֹּתִי וְלִי יְהוֹשִׁיעַ׃</tei:l>
          <tei:l>שׁוּבִי נַפְשִׁי לִמְנוּחָיְכִי כִּי־יְהֹוָה גָּמַל עָלָיְכִי׃</tei:l>
          <tei:l>כִּי חִלַּצְתָּ נַפְשִׁי מִמָּוֶת</tei:l>
          <tei:l>אֶת־עֵינִי מִן־דִּמְעָה אֶת־רַגְלִי מִדֶּחִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/116/9/a"/>
        <tei:lg>
          <tei:l>אֶתְהַלֵּךְ לִפְנֵי יְהֹוָה</tei:l>
          <tei:l>בְּאַרְצוֹת הַחַיִּים׃</tei:l>
          <tei:l>הֶאֱמַנְתִּי כִּי אֲדַבֵּר אֲנִי עָנִיתִי מְאֹד׃</tei:l>
          <tei:l>אֲנִי אָמַרְתִּי בְחׇפְזִי</tei:l>
          <tei:l>כׇּל־הָאָדָם כֹּזֵב׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/116/12/a"/>
        <tei:lg>
          <tei:l>מָה־אָשִׁיב לַיהֹוָה</tei:l>
          <tei:l>כׇּל־תַּגְמוּלוֹהִי עָלָי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/116/12/b"/>
        <tei:lg>
          <tei:l>כּוֹס־יְשׁוּעוֹת אֶשָּׂא וּבְשֵׁם יְהֹוָה אֶקְרָא׃</tei:l>
          <tei:l>נְדָרַי לַיהֹוָה אֲשַׁלֵּם</tei:l>
          <tei:l>נֶגְדָה־נָּא לְכׇל־עַמּוֹ׃</tei:l>
          <tei:l>יָקָר בְּעֵינֵי יְהֹוָה הַמָּוְתָה לַחֲסִידָיו׃</tei:l>
          <tei:l>אָנָּה יְהֹוָה כִּי־אֲנִי עַבְדֶּךָ אֲנִי־עַבְדְּךָ בֶּן־אֲמָתֶךָ</tei:l>
          <tei:l>פִּתַּחְתָּ לְמוֹסֵרָי׃</tei:l>
          <tei:l>לְךָ־אֶזְבַּח זֶבַח תּוֹדָה וּבְשֵׁם יְהֹוָה אֶקְרָא׃</tei:l>
          <tei:l>נְדָרַי לַיהֹוָה אֲשַׁלֵּם נֶגְדָה־נָּא לְכׇל־עַמּוֹ׃</tei:l>
          <tei:l>בְּחַצְרוֹת בֵּית יְהֹוָה</tei:l>
          <tei:l>בְּתוֹכֵכִי יְרוּשָׁלָ͏ִם הַלְלוּ־יָהּ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
