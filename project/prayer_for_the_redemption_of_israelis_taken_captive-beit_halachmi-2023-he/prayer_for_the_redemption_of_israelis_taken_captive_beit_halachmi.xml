    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_the_redemption_of_israelis_taken_captive_beit_halachmi">
        <tei:head>תְּפִלָּה לְפִדְיוֹן שְׁבוּיִם</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_redemption_of_israelis_taken_captive_beit_halachmi/1"/>
        <tei:lg>
          <tei:l>אֱלֹהֵינוּ</tei:l>
          <tei:l>מַתִּיר הָאֲסוּרִים,</tei:l>
          <tei:l>מִשְׂגָּב לַדָּךְ,</tei:l>
          <tei:l>מִשְׂגָּב לְעִתּוֹת בַּצָּרָה <tei:bibl>(תהלים ט:י)</tei:bibl></tei:l>
          <tei:l>שְׁלַח, הַצָּלָה שְׁלֵמָה וּפִדְיוֹן גָּמוּר</tei:l>
          <tei:l>לַנְּתוּנִים בִּשְׁבִי אוֹיֵב:</tei:l>
          <tei:l><tei:note type="instruction">[...]</tei:note>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_redemption_of_israelis_taken_captive_beit_halachmi/2"/>
        <tei:lg>
          <tei:l>חַזְּקִי רוּחָם, הָבִיאִי לָהֶם אֶת תְּפִלָּתֵנוּ</tei:l>
          <tei:l>לְשָׁמְרָם מֵרַע.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_redemption_of_israelis_taken_captive_beit_halachmi/3"/>
        <tei:lg>
          <tei:l>תְּנִי בִּינָה בְּלֵב אוֹיֵב</tei:l>
          <tei:l>לַהֲשִׁיבָם בִּשְׁלֵמוּת גּוּף וְנֶפֶשׁ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_redemption_of_israelis_taken_captive_beit_halachmi/4"/>
        <tei:lg>
          <tei:l>תְּנִי תְּבוּנָה בְּלוֹחֲמֵי צַהַ״ל</tei:l>
          <tei:l>לְחַלְּצָם בְּלֹא אִבּוּד נְפָשׁוֹת.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_redemption_of_israelis_taken_captive_beit_halachmi/5"/>
        <tei:lg>
          <tei:l>תֵּן לְכָל בְּנֵי וּבְנוֹת אַבְרָהָם, שָׂרָה וְהַגָּר</tei:l>
          <tei:l>אֶת עֹז הָרוּחַ וְאֹמֶץ הַלֵּב</tei:l>
          <tei:l>לְהַתִּיר כִּבְלִי שֶׁבִי</tei:l>
          <tei:l>וְלִחְיוֹת חַיֵּי חֵרוּת.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_redemption_of_israelis_taken_captive_beit_halachmi/6"/>
        <tei:lg>
          <tei:l>יִקְרָאֵנִי</tei:l>
          <tei:l>וְאֶעֱנֵהוּ עִמּוֹ</tei:l>
          <tei:l>אָנֹכִי בְצָרָה</tei:l>
          <tei:l>אֲחַלְּצֵהוּ וַאֲכַבְּדֵהוּ <tei:bibl>(תהלים צא:טו)</tei:bibl></tei:l>
          <tei:l>וְנֹאמַר, אָמֵן.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>