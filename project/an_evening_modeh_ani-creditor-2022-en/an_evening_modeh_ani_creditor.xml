  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:an_evening_modeh_ani_creditor">
        <tei:head>An Evening Modeh Ani, by Rabbi Menachem Creditor</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:an_evening_modeh_ani_creditor/1"/>
        <tei:lg>
          <tei:l><tei:hi rend="italic">Modeh Ani</tei:hi>, Grateful Am I</tei:l>
          <tei:l>Life-force of the Universe</tei:l>
          <tei:l>for the soul You have lent me</tei:l>
          <tei:l>so that I was able today</tei:l>
          <tei:l>to experience the grandeur of Creation.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:an_evening_modeh_ani_creditor/2"/>
        <tei:lg>
          <tei:l>As the sun sets,</tei:l>
          <tei:l>as the day begins to end,</tei:l>
          <tei:l>as we lay our heads to rest,</tei:l>
          <tei:l>we ask You, Creator,</tei:l>
          <tei:l>for something precious:</tei:l>
          <tei:l>tomorrow.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
