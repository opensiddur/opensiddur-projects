  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:mourners_kaddish_for_an_individual_without_a_minyan_yehudah">
        <tei:head>Mourner's Ḳaddish for an Individual Without a Minyan (Sefer Ḥasidim, ca. 12-13th c.)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mourners_kaddish_for_an_individual_without_a_minyan_yehudah/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">A person who lives in a village without a minyan or who arrived late after they had already said “may God’s great Name...” should instead say:</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mourners_kaddish_for_an_individual_without_a_minyan_yehudah/2"/>
        <tei:lg>
          <tei:l>Therefore, I pray, let my Lord’s forbearance be great,</tei:l>
          <tei:l>as you have declared, saying:<tei:anchor xml:id="note_1"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mourners_kaddish_for_an_individual_without_a_minyan_yehudah/3"/>
        <tei:lg>
          <tei:l>Thus will I manifest My greatness and My holiness,</tei:l>
          <tei:l>and make Myself known in the sight of many nations.</tei:l>
          <tei:l>And they shall know that I am YHVH.<tei:anchor xml:id="note_2"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mourners_kaddish_for_an_individual_without_a_minyan_yehudah/4"/>
        <tei:lg>
          <tei:l>Let the name YHVH be blessed now and forever.<tei:anchor xml:id="note_3"/></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
