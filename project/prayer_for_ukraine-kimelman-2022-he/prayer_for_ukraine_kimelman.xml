      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_ukraine_kimelman">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_ukraine_kimelman/4"/>
        <tei:lg>
          <tei:l>וְכָל הָרִשְׁעָה כֻּלָּהּ כְּעָשָׁן תִּכְלֶה</tei:l>
          <tei:l>כִּי תַעֲבִיר מֶמְשֶׁלֶת זָדוֹן מִן הָאָרֶץ</tei:l>
          <tei:l>וְתִמְלוֹךְ אַתָּה ה׳ לְבַדֶּֽךָ עַל כָּל מַעֲשֶֽׂיךָ</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
