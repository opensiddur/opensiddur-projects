  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/1"/>
        <tei:lg>
          <tei:l>אֲדֹנָי שְׂפָתַי תִּפְתָּח</tei:l>
          <tei:l>וּפִי יַגִּיד תְּהִלָּתֶֽךָ׃ <tei:bibl>(תהלים נא:יז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/2"/>
        <tei:lg>
          <tei:l>אָבוֹת וְאִמָּהוֹת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/3"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>מָגֵן אַבְרָהָם</tei:l>
          <tei:l>וְעֶזְרַת שָׂרָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/4"/>
        <tei:lg>
          <tei:l>גְּבוּרוֹת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/5"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>מְחַיֵּה הַמֵּתִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/6"/>
        <tei:lg>
          <tei:l>קָדוֹשׁ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/7"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>הָאֵל הַקָּדוֹשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/8"/>
        <tei:lg>
          <tei:l>חוֹנֵן הַדָּעַת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/9"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>חוֹנֵן הַדָּעַת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/10"/>
        <tei:lg>
          <tei:l>תְּשׁוּבָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/11"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>הָרוֹצֶה בִתְשׁוּבָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/12"/>
        <tei:lg>
          <tei:l>סְלִיחָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/13"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>חַנּוּן הַמַּרְבֶּה לִסְלֹחַ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/14"/>
        <tei:lg>
          <tei:l>גְּאֻלָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/15"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>גּוֹאֵל יִשְׂרָאֵל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/16"/>
        <tei:lg>
          <tei:l>רְפוּעָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/17"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>רוֹפֵא חוֹלֵא עָמוֹ יִשְׂרָאֵל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/18"/>
        <tei:lg>
          <tei:l>מְבָרֵךְ הַשָּׁנִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/19"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>מְבָרֵךְ הַשָּׁנִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/20"/>
        <tei:lg>
          <tei:l>קִבּוּץ גָּלוּיוֹת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/21"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>מְקַבֵּץ נִדְחֵי עַמּוֹ יִשְׂרָאֵל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/22"/>
        <tei:lg>
          <tei:l>צֶדֶק</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/23"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>מֶלֶךְ אוֹהֵב צְדָקָה וּמִשְׁפָּט׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/24"/>
        <tei:lg>
          <tei:l>בִּרְכַּת הַמִּינִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/25"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>שׁוֹבֵר אוֹיְבִים</tei:l>
          <tei:l>וּמַכְנִיעַ זֵדִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/26"/>
        <tei:lg>
          <tei:l>צַדִּיקִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/27"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>מִשְׁעָן וּמִבְטָח לַצַּדִּיקִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/28"/>
        <tei:lg>
          <tei:l>בִּנְיַן יְרוּשָׁלַיִם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/29"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>בּוֹנֵה יְרוּשָׁלָיִם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/30"/>
        <tei:lg>
          <tei:l>מַלְכוּת בֵּית דָּוִד</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/31"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>מַצְמִיחַ קֶרֶן יְשׁוּעָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/32"/>
        <tei:lg>
          <tei:l>קַבָּלַת תְּפִלָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/33"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>שׁוֹמֵעַ תְּפִלָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/34"/>
        <tei:lg>
          <tei:l>שְׁכִינָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/35"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>הַמַּחֲזִיר שְׁכִינָתוֹ לְצִיּוֹן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/36"/>
        <tei:lg>
          <tei:l>מוֹדִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/37"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>הַטּוֹב שִׁמְךָ</tei:l>
          <tei:l>וּלְךָ נָאֶה לְהוֹדוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/38"/>
        <tei:lg>
          <tei:l>שָׁלוֹם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_blessings_and_affirmations_rubin/39"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>הַמְבָרֵךְ אֶת עַמּוֹ יִשְׂרָאֵל בַּשָּׁלוֹם׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>