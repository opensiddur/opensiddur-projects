      <tei:div corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_for_chanukat_bar_mitzvah_mayer">
        <tei:head>מי שברך לחנוכת בר מצווה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_for_chanukat_bar_mitzvah_mayer/1"/>
        <tei:lg>
          <tei:l>מִי שֶׁבֵּרָךְ אֲבוֹתֵֽינוּ</tei:l>
          <tei:l>אַבְרָהָם יִצְחַק וְיַעֲקֹב</tei:l>
          <tei:l>מֹשֶׁה וְאַהֲרֹן</tei:l>
          <tei:l>דָוִד וּשְׁלֹמֹה</tei:l>
          <tei:l>וְאִמּוֹתֵֽינוּ</tei:l>
          <tei:l>שָׂרָה רִבְקָה</tei:l>
          <tei:l>רָחֵל וְלֵאָה</tei:l>
          <tei:l>מִרְיָם רוּת וַאֲבִיגַֽיִל</tei:l>
          <tei:l>הוּא יְבָרֵךְ וְיִשְׁמוֹר וְיִנְצוֹר אֶת־הָאִישׁ</tei:l>
          <tei:l>פב״פ</tei:l>
          <tei:l>שֶׁעָלָה לַתּוֹרָה</tei:l>
          <tei:l>לִכְבוֹד הַתּוֹרָה</tei:l>
          <tei:l>וְלִכְבוֹד הַשַּׁבָּת</tei:l>
          <tei:l>וְלִכְבוֹד חֲנֻכַּת קִבּוּל הַמִּצְוֺת שֶׁלּוֹ</tei:l>
          <tei:l>בְּעֶֽצֶם יוֹם פָּרָשַׁת בַּגְרוּתוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_for_chanukat_bar_mitzvah_mayer/2"/>
        <tei:lg>
          <tei:l>הַמָּקוֹם שֶׁנַתָּן לוֹ חַיִּים אֲרֻכִּים</tei:l>
          <tei:l>עַד־יְמֵי שְׁנוֹתֵֽינוּ וְעוֹד</tei:l>
          <tei:l>הוּא יִתֵּן לוֹ בִּגְבוּרוֹת שָׁנִים נוֹסָפוֹת</tei:l>
          <tei:l>עַד־מֵאָה וְעֶשְׂרִים שָׁנָה</tei:l>
          <tei:l>בִּבְרִיאוּת הַגּוּף</tei:l>
          <tei:l>וּבְשִׂמְחַת הַנֶּֽפֶשׁ</tei:l>
          <tei:l>בְּאַהֲבַת חֶֽסֶד</tei:l>
          <tei:l>וּבְיִרְאַת שָׁמַֽיִם׃</tei:l>
          <tei:l>כְּדִכְתִיב ע֭וֹד יְנוּב֣וּן בְּשֵׂיבָ֑ה</tei:l>
          <tei:l>דְּשֵׁנִ֖ים וְרַֽעֲנַנִּ֑ים יִֽהְיֽוּ׃</tei:l>
          <tei:l>וְכֵן יְהִי רָצוֹן</tei:l>
          <tei:l>וְנֹאמַר אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_for_chanukat_bar_mitzvah_mayer/4"/>
        <tei:lg>
          <tei:l>מִי שֶׁבֵּרָךְ אִמּוֹתֵֽינוּ</tei:l>
          <tei:l>שָׂרָה רִבְקָה</tei:l>
          <tei:l>רָחֵל וְלֵאָה</tei:l>
          <tei:l>מִרְיָם רוּת וַאֲבִיגַֽיִל</tei:l>
          <tei:l>וַאֲבוֹתֵֽינוּ</tei:l>
          <tei:l>אַבְרָהָם יִצְחַק וְיַעֲקֹב</tei:l>
