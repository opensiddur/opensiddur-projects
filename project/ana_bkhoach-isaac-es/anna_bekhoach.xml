  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:anna_bekhoach">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:anna_bekhoach/1-7"/>
        <tei:lg>
          <tei:l>Ruego con fuerça de grandeza de tu derecha,</tei:l>
          <tei:l>suelta angustiada</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>recibe exclamacion de tu pueblo</tei:l>
          <tei:l>En fortece nos munda nos timido</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>ruego fuerte buscantes tu unidad</tei:l>
          <tei:l>como niñeta guarda</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>bendizelos lipialos piadades de tu justedad</tei:l>
          <tei:l>contino les galardona</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>fuerte santo con muchedumbre</tei:l>
          <tei:l>de tu bien guiala tu compaña,</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>unico altivo a tu pueblo atiede</tei:l>
          <tei:l>recordantes tu santidad</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>nostro gemido recibe</tei:l>
          <tei:l>y oye nostra exclamacion</tei:l>
          <tei:l>conocie entrinsecos:</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
