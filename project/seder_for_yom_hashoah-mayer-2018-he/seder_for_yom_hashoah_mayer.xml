    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer">
        <tei:head>סֵדֶר לְיוֹם הַשׁוֹאָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/1"/>
        <tei:lg>
          <tei:l>סֵדֶר לְיוֹם הַשׁוֹאָה</tei:l>
        </tei:lg>
        <tei:div>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/5"/>
          <tei:lg>
            <tei:l>קדש</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/7"/>
          <tei:lg>
            <tei:l>אֵיפֹה אַתָּה,</tei:l>
            <tei:l>ייי אֱלֹהֵינוּ,</tei:l>
            <tei:l>בָּעוֹלָם,</tei:l>
            <tei:l>הַמְסַפֵּק מָרָק קַר וּמֵימִי,</tei:l>
            <tei:l>אוֹ לֹא מְסַפֵּק כְּלוּם,</tei:l>
            <tei:l>לַעֲבָדֶיךָ?</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/8"/>
          <tei:lg>
            <tei:l>כרפס</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/10"/>
          <tei:lg>
            <tei:l>מגיד</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/11"/>
          <tei:lg>
            <tei:l>בְּכָל דּוֹר וָדוֹר</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/18"/>
          <tei:lg>
            <tei:l>אִלּוּ עֲבָדִים לֹא הָיִינוּ לְפַרְעֹה בְּמִצְרַיִם, דַּיֵּנוּ.</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/19"/>
          <tei:lg>
            <tei:l>אִלּוּ הָאֲשׁוּרִים לֹא הָרְסוּ אֶת אֶפְרַיִם, דַּיֵּנוּ.</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/20"/>
          <tei:lg>
            <tei:l>אִלּוּ הַבָּבְלִים לֹא הָרְסוּ אֶת בֵּית הַמִּקְדָּשׁ הָרִאשׁוֹן, דַּיֵּנוּ.</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/21"/>
          <tei:lg>
            <tei:l>אִלּוּ לֹא הָיִינוּ בְּגָלוּת בָּבֶל, דַּיֵּנוּ.</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/22"/>
          <tei:lg>
            <tei:l>אִלּוּ יְוָנִים לֹא דִּכְּאוּ אֹתָנוּ, דַּיֵּנוּ.</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/23"/>
          <tei:lg>
            <tei:l>אִלּוּ רוֹמָאִים לֹא הָרְסוּ אֶת בֵּית הַמִּקְדָּשׁ הַשֵּׁנִי, דַּיֵּנוּ.</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/24"/>
          <tei:lg>
            <tei:l>אִלּוּ לֹא הָיִינוּ בַּגָּלוּת הַגָּדוֹל, דַּיֵּנוּ.</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/25"/>
          <tei:lg>
            <tei:l>אִלּוּ הַנּוֹצְרִיִּים הָעַתִּיקִים לֹא שִׁקְּרוּ עָלֵינוּ, דַּיֵּנוּ.</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/26"/>
          <tei:lg>
            <tei:l>אִלּוּ הֵם לֹא הָרְגוּ אֹתָנוּ, דַּיֵּנוּ.</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/27"/>
          <tei:lg>
            <tei:l>אִלּוּ הַמוּסְלְמִים לֹא שָׁלְחוּ אֹתָנוּ לָחֶרֶב, דַּיֵּנוּ.</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/28"/>
          <tei:lg>
            <tei:l>אִלּוּ הַצַּלְבָנִים לֹא שָׂרְפוּ אֶת בָּתֵי הַכְּנֶסֶת שֶׁלָנוּ, דַּיֵּנוּ.</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/29"/>
          <tei:lg>
            <tei:l>אִלּוּ לֹא הָיוּ פּוֹגְרוֹמִים, דַּיֵּנוּ.</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/30"/>
          <tei:lg>
            <tei:l>אִלּוּ לֹא הָיְתָה הַשׁוֹאָה, דַּיֵּנוּ.</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/31"/>
          <tei:lg>
            <tei:l>אַךְ כֻּלָּם הָיוּ, וְלֹא עָצַרְתָּ אֹתָם.</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/32"/>
          <tei:lg>
            <tei:l>כֻּלָּם דַּיֵּנוּ, אַךְ אַף אֵחָד מֵהֶם דַּיֵּיךָ.</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/33"/>
          <tei:lg>
            <tei:l>אַז מָה דַּיֵּיךָ?</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/34"/>
          <tei:lg>
            <tei:l>מָה כׇּל כָּךְ בּוֹלֵט שֶׁאַתָּה תִּשְׁמַע תַּחֲנוּנֵינוּ, שֶׁאַתָּה תִּפְעַל וְתוֹשִׁיעֵנוּ?</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/35"/>
          <tei:lg>
            <tei:l>מָה דַּיֵּיךָ?</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/39"/>
          <tei:lg>
            <tei:l>אֵיפֹה אַתָּה,</tei:l>
            <tei:l>ייי אֱלֹהֵינוּ,</tei:l>
            <tei:l>בָּעוֹלָם,</tei:l>
            <tei:l>הַמְסַפֵּק מָרָק קַר וּמֵימִי,</tei:l>
            <tei:l>אוֹ לֹא מְסַפֵּק כְּלוּם,</tei:l>
            <tei:l>לַעֲבָדֶיךָ?</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/40"/>
          <tei:lg>
            <tei:l>מוציא</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/42"/>
          <tei:lg>
            <tei:l>אֵיפֹה אַתָּה,</tei:l>
            <tei:l>ייי אֱלֹהֵינוּ,</tei:l>
            <tei:l>בָּעוֹלָם,</tei:l>
            <tei:l>כְּשֶׁכׇּל הַלֶּחֶם שֶׁאַתָּה מְסַפֵּק רַק קְלִפּוֹת תַּפּוּחֵי אֲדָמָה?</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/43"/>
          <tei:lg>
            <tei:l>ברך</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/44"/>
          <tei:lg>
            <tei:l>אֵיפֹה אַתָּה,</tei:l>
            <tei:l>ייי אֱלֹהֵינוּ,</tei:l>
            <tei:l>בָּעוֹלָם,</tei:l>
            <tei:l>הַמְסַפֵּק מָרָק קַר וּמֵימִי,</tei:l>
            <tei:l>אוֹ לֹא מְסַפֵּק כְּלוּם,</tei:l>
            <tei:l>לַעֲבָדֶיךָ?</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/46"/>
          <tei:lg>
            <tei:l>יִתְגַּדַּל וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא: אָמֵן.</tei:l>
            <tei:l>בְּעָלְמָא דִּי בְרָא כִרְעוּתֵהּ וְיַמְלִיךְ מַלְכוּתֵהּ בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן וּבְחַיֵּי דְכָל בֵּית יִשְׂרָאֵל בַּעֲגָלָא וּבִזְמַן קָרִיב,</tei:l>
            <tei:l>וְאִמְרוּ: אָמֵן.</tei:l>
            <tei:l>יְהֵא שְׁמֵהּ רַבָּא מְבָרַךְ לְעָלַם וּלְעָלְמֵי עָלְמַיָּא:</tei:l>
            <tei:l>יִתְבָּרַךְ וְיִשְׁתַּבַּח וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְנַשֵּׂא וְיִתְהַדָּר וְיִתְעַלֶּה וְיִתְהַלָּל שְׁמֵהּ דְּקֻדְשָׁא: בְּרִיךְ הוּא.</tei:l>
            <tei:l>לְעֵלָּא מִן כָּל בִּרְכָתָא וְשִׁירָתָא תֻּשְׁבְּחָתָא וְנֶחֱמָתָא דַּאֲמִירָן בְּעָלְמָא. וְאִמְרוּ: אָמֵן.</tei:l>
            <tei:l>יְהֵא שְׁלָמָא רַבָּא מִן שְׁמַיָּא וְחַיִּים עָלֵינוּ וְעַל כָּל יִשְׂרָאֵל. וְאִמְרוּ: אָמֵן.</tei:l>
            <tei:l>עוֹשֶׂה שָׁלוֹם בִּמְרוֹמָיו הוּא יַעֲשֶׂה שָׁלוֹם עָלֵינוּ וְעַל כָּל יִשְׂרָאֵל וְאִמְרוּ: אָמֵן.</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/47"/>
          <tei:lg>
            <tei:l>הלל</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/49"/>
          <tei:lg>
            <tei:l>הֵם הֶאֱמִינוּ</tei:l>
            <tei:l>בֶּאֱמוּנָה שְׁלֵמָה</tei:l>
            <tei:l>בְּבִיאַת הַמָּשִׁיחַ</tei:l>
            <tei:l>וְאַף עַל פִּי שֶׁהוּא לֹא בָּא בִּימֵיהֶם,</tei:l>
            <tei:l>הֵם עֲדַייִן הֶאֱמִינוּ.</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/50"/>
          <tei:lg xml:lang="yi">
            <tei:l>קיינמאָל מער!</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/51"/>
          <tei:lg xml:lang="yi">
            <tei:l>לְעוֹלָם לֹא עוֹד!</tei:l>
          </tei:lg>
          <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_for_yom_hashoah_mayer/52"/>
          <tei:lg xml:lang="yi">
            <tei:l>נוּנקה וֶיז!</tei:l>
          </tei:lg>
        </tei:div>
      </tei:div>
    </tei:body>
  </tei:text>
