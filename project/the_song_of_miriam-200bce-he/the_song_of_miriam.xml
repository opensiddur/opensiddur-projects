  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:the_song_of_miriam">
        <tei:head>שִׁירַת מִרְיָם</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_song_of_miriam/1"/>
        <tei:lg>
          <tei:l><tei:seg type="supplied" subtype="scholars">כִּ֣י</tei:seg> בָ֗א <tei:seg type="supplied" subtype="scholars">ס֥וּס פַּרְעֹ֛ה בְּרִכְבּ֥וֹ וּבְפָרָשָׁ֖יו בַּיָּ֑ם</tei:seg></tei:l>
          <tei:l><tei:seg type="supplied" subtype="scholars">וַיָּ֧שֶׁב</tei:seg> יְהֹוָ֛ה עֲלֵהֶ֖ם אֶת־מֵ֥י הַיָּֽם׃</tei:l>
          <tei:l>וּבְנֵ֧י <tei:seg type="supplied" subtype="scholars">יִשְׂרָאֵ֛ל הָלְכ֥וּ בַיַּבָּשָׁ֖ה בְּת֥וֹךְ הַיָּ֑ם</tei:seg></tei:l>
          <tei:l><tei:seg type="supplied" subtype="scholars">וְהַמַּ֤</tei:seg>יִם לָהֶ<tei:seg type="supplied" subtype="scholars">ם֙ חוֹמָ֔ה מִֽי</tei:seg>מִינָ֖ם וּמִשְּׂמֹאלָֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_song_of_miriam/2"/>
        <tei:lg>
          <tei:l>וַתִּקַּח֩ <tei:seg type="supplied" subtype="scholars">מִרְיָ֨ם הַנְּבִיאָ֜ה אֲח֧וֹת אַהֲרֹ֛ן אֶת־הַתֹּ֖ף בְּיָדָ֑הּ</tei:seg></tei:l>
          <tei:l>וַתֵּצֶ֤אןָ <tei:seg type="supplied" subtype="scholars">כׇֽ</tei:seg>ל־הַנָּשִׁים֙ אַחֲרֶ֔יהָ <tei:seg type="supplied" subtype="scholars">בְּתֻפִּ֖ים וּבִמְחֹלֹֽת׃</tei:seg></tei:l>
          <tei:l>
            <tei:seg type="supplied" subtype="scholars">וַתַּ֥עַן לָהֶ֖ם מִרְיָ֑ם</tei:seg>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_song_of_miriam/3"/>
        <tei:lg>
          <tei:l>
            <tei:seg type="supplied" subtype="scholars">שִׁ֤ירוּ לַֽיהֹוָה֙</tei:seg>
          </tei:l>
          <tei:l>
            <tei:seg type="supplied" subtype="scholars">כִּֽי־גָאֹ֣ה גָּאָ֔ה</tei:seg>
          </tei:l>
          <tei:l>
            <tei:seg type="supplied" subtype="scholars">ס֥וּס וְרֹכְב֖וֹ</tei:seg>
          </tei:l>
          <tei:l>
            <tei:seg type="supplied" subtype="scholars">רָמָ֥ה בַיָּֽם׃</tei:seg>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_song_of_miriam/4"/>
        <tei:lg>
          <tei:l>
            <tei:seg type="supplied" subtype="author">בִּימִינְךָ֥ הַחֲזָקָ֖ה</tei:seg>
          </tei:l>
          <tei:l>
            <tei:seg type="supplied" subtype="author">הָרַ֣סְתָּ קָמֶ֑יךָ</tei:seg>
          </tei:l>
          <tei:l>
            <tei:seg type="supplied" subtype="author">וּבִזְרוֹעֲךָ֣ הַנְּטוּיָ֔ה</tei:seg>
          </tei:l>
          <tei:l>בָּזִ֖יתָ <tei:seg type="supplied" subtype="scholars">עַל־אוֹיבֶֽיךָ׃</tei:seg></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_song_of_miriam/5"/>
        <tei:lg>
          <tei:l>
            <tei:seg type="supplied" subtype="scholars">אָשִׁ֥ירָה לַֽיהֹוָ֖ה</tei:seg>
          </tei:l>
          <tei:l>כִּֽי־גָאֹ֣ה <tei:seg type="supplied" subtype="scholars">גָּאָ֑</tei:seg>ה</tei:l>
          <tei:l>עׇ<tei:seg type="supplied" subtype="scholars">זִּ֤י וְזִמְרָת֙ יָ֔הּ</tei:seg></tei:l>
          <tei:l>
            <tei:seg type="supplied" subtype="scholars">וַֽיְהִי־לִ֖י לִֽישׁוּעָֽה׃</tei:seg>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_song_of_miriam/6"/>
        <tei:lg>
          <tei:l>
            <tei:seg type="supplied" subtype="author">וּבְרֹ֥ב חַסְדְּךָ֖</tei:seg>
          </tei:l>
          <tei:l>
            <tei:seg type="supplied" subtype="author">עַם־ז֣וּ גָּאָ֑לְתָּ</tei:seg>
          </tei:l>
          <tei:l>גָּד֣וֹל אַתָּ֔ה</tei:l>
          <tei:l>מוֹשִׁ֖יעַ אֶ<tei:seg type="supplied" subtype="scholars">ת־עַמֶּֽךָ׃</tei:seg></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_song_of_miriam/7"/>
        <tei:lg>
          <tei:l>אָבְדָה֙ תִּקְוַ֣ת שׂוֹנֵ֔א</tei:l>
          <tei:l>וְנִשְׁ<tei:seg type="supplied" subtype="scholars">כַּ֖ח זִכְר֑וֹ</tei:seg></tei:l>
          <tei:l>אָבְד֛וּ בְּמַ֥יִם אַדִּירִ֖ים</tei:l>
          <tei:l>שׂ<tei:seg type="supplied" subtype="scholars">וֹנְ</tei:seg>אֶֽיךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_song_of_miriam/8"/>
        <tei:lg>
          <tei:l><tei:seg type="supplied" subtype="scholars">עַמְּךָ֗</tei:seg> יְרוֹמְמ֙וּךָ֙ לַמְּרוֹמָ֔ם</tei:l>
          <tei:l><tei:seg type="supplied" subtype="scholars">כִּֽי־בְּ</tei:seg>רִ֥ית נָתַ֖תָּ <tei:seg type="supplied" subtype="scholars">לַאֲבוֹתֵ֑ינוּ</tei:seg></tei:l>
          <tei:l>
            <tei:seg type="supplied" subtype="author">כִּי־אַתָּה֙ יְהֹוָ֣ה אֱלֹהֵ֔ינוּ</tei:seg>
          </tei:l>
          <tei:l>עוֹשֶׂ֖ה גֵּאֽוּת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_song_of_miriam/9"/>
        <tei:lg>
          <tei:l>וַיַּסַּ֨ע מֹשֶׁ֤ה אֶת־יִשְׂרָאֵל֙...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>