    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hosha_na_for_election_day_mayer">
        <tei:head>Hosha-na for Election Day, by Isaac Gantwerk Mayer</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_election_day_mayer/1"/>
        <tei:lg>
          <tei:l><tei:hi rend="italic">Hoshana</tei:hi> — brotherhood and faith in our land — <tei:hi rend="italic">hoshana</tei:hi></tei:l>
          <tei:l><tei:hi rend="italic">Hoshana</tei:hi> — blessing and trust in our election — <tei:hi rend="italic">hoshana</tei:hi></tei:l>
          <tei:l><tei:hi rend="italic">Hoshana</tei:hi> — courage and merciful acts in our great ones — <tei:hi rend="italic">hoshana</tei:hi></tei:l>
          <tei:l><tei:hi rend="italic">Hoshana</tei:hi> — judgment and good sense in our judges — <tei:hi rend="italic">hoshana</tei:hi></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_election_day_mayer/2"/>
        <tei:lg>
          <tei:l><tei:hi rend="italic">Hoshana</tei:hi> — splendor and beauty in our palaces — <tei:hi rend="italic">hoshana</tei:hi></tei:l>
          <tei:l><tei:hi rend="italic">Hoshana</tei:hi> — certainty and senority in our committees — <tei:hi rend="italic">hoshana</tei:hi></tei:l>
          <tei:l><tei:hi rend="italic">Hoshana</tei:hi> — merit and agility in our elders — <tei:hi rend="italic">hoshana</tei:hi></tei:l>
          <tei:l><tei:hi rend="italic">Hoshana</tei:hi> — grace and kindness in our borders — <tei:hi rend="italic">hoshana</tei:hi></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_election_day_mayer/3"/>
        <tei:lg>
          <tei:l><tei:hi rend="italic">Hoshana</tei:hi> — good sense in our legal cases — <tei:hi rend="italic">hoshana</tei:hi></tei:l>
          <tei:l><tei:hi rend="italic">Hoshana</tei:hi> — integrity and friendship in our foundations — <tei:hi rend="italic">hoshana</tei:hi></tei:l>
          <tei:l><tei:hi rend="italic">Hoshana</tei:hi> — honor and aptitude in our assemblies — <tei:hi rend="italic">hoshana</tei:hi></tei:l>
          <tei:l><tei:hi rend="italic">Hoshana</tei:hi> — learning and receiving in our cabinets — <tei:hi rend="italic">hoshana</tei:hi></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_election_day_mayer/4"/>
        <tei:lg>
          <tei:l><tei:hi rend="italic">Hoshana</tei:hi> — an interceder’s attributes in our government — <tei:hi rend="italic">hoshana</tei:hi></tei:l>
          <tei:l><tei:hi rend="italic">Hoshana</tei:hi> — generosity and representation in our management — <tei:hi rend="italic">hoshana</tei:hi></tei:l>
          <tei:l><tei:hi rend="italic">Hoshana</tei:hi> — aid and patience in our authorities — <tei:hi rend="italic">hoshana</tei:hi></tei:l>
          <tei:l><tei:hi rend="italic">Hoshana</tei:hi> — humility and strength in our congregations — <tei:hi rend="italic">hoshana</tei:hi></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_election_day_mayer/5"/>
        <tei:lg>
          <tei:l><tei:hi rend="italic">Hoshana</tei:hi> — glory and liberation in our officials — <tei:hi rend="italic">hoshana</tei:hi></tei:l>
          <tei:l><tei:hi rend="italic">Hoshana</tei:hi> — righteousness and modesty in our public — <tei:hi rend="italic">hoshana</tei:hi></tei:l>
          <tei:l><tei:hi rend="italic">Hoshana</tei:hi> — progress and fulfillment in our communities — <tei:hi rend="italic">hoshana</tei:hi></tei:l>
          <tei:l><tei:hi rend="italic">Hoshana</tei:hi> — satiation and compassion in our administrations — <tei:hi rend="italic">hoshana</tei:hi></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_election_day_mayer/6"/>
        <tei:lg>
          <tei:l><tei:hi rend="italic">Hoshana</tei:hi> — peace and tranquility in our regime — <tei:hi rend="italic">hoshana</tei:hi></tei:l>
          <tei:l><tei:hi rend="italic">Hoshana</tei:hi> — revival and a chance of hope in our era — <tei:hi rend="italic">hoshana</tei:hi></tei:l>
        </tei:lg>
      </tei:div>
