      <tei:div corresp="urn:x-opensiddur:text:poem:essa_lamerachoq_aharon">
        <tei:head>אֶשָּׂא לְמֵרָחוֹק</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:essa_lamerachoq_aharon/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אֶ</tei:seg>שָּׂא לְמֵרָחוֹק דֵּעִי</tei:l>
          <tei:l>אֲתַנֶּה | צִדְקוֹת אֵלִי וּמוֹשִׁיעִי</tei:l>
          <tei:l>בְּשֵׁשֶׁת יָמִים כִּלָּה כֹּל | מַלְכִּי וְרֹעִי</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:note type="instruction">קהל:</tei:note> וַיְבָרֶךְ אֱלֹהִים | אֶת יוֹם הַשְּׁבִיעִי. <tei:bibl>(בראשית ב:ג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:essa_lamerachoq_aharon/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הִ</tei:seg>פְלִיא כָּל פֹּעַל | וְהוֹדוֹ שָׁמַיִם כִּסָּה</tei:l>
          <tei:l>יִתְעַלֶּה וְיִתְנַשֵּׂא הָרָם וְהַנִּשָּׂא</tei:l>
          <tei:l>הַמְקַדֵּשׁ זֶה הַיּוֹם | מִכֹּל אֲשֶׁר נַעֲשָׂה</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:note type="instruction">קהל:</tei:note> מִכָּל מְלַאכְתּוֹ | אֲשֶׁר עָשָׂה. <tei:bibl>(בראשית ב:ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:essa_lamerachoq_aharon/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רֹ</tei:seg>אש דְּבָרוֹ אֱמֶת | בְּסוֹד נֶעְלָם</tei:l>
          <tei:l>הָעָם בָּחַר לְנַחֲלָה לוֹ מֵעוֹלָם</tei:l>
          <tei:l>צִוָּה לֶחֶם מִשְׁנֶה לְהָכִין בִּשְׁבִילָם</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:note type="instruction">קהל:</tei:note> לַעֲשׂוֹת אֶת הַשַּׁבָּת | לְדֹרֹתָם בְּרִית עוֹלָם. <tei:bibl>(שמות לא:טז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:essa_lamerachoq_aharon/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נִ</tei:seg>חַל עֵדוּת | לִבְנֵי יַעֲקֹב לְהוֹדָם</tei:l>
          <tei:l>יוֹם עֹנֶג יוֹם קֹדֶשׁ | יוֹם מְכֻבָּד לִכְבוֹדָם</tei:l>
          <tei:l>אָכֵן יַגִּידוּ צִדְקָתוֹ | בְּהִוָּעֲדָם</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:note type="instruction">קהל:</tei:note> יוֹדוּ לַיהֹוָה חַסְדּוֹ | וְנִפְלְאוֹתָיו לִבְנֵי אָדָם. <tei:bibl>(תהלים קז:ח)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
