  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:remember_lazarus">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:remember_lazarus/1"/>
        <tei:lg>
          <tei:l>וּזְכֹר֙ אֶת־בּ֣וֹרְאֶ֔יךָ בִּימֵ֖י בְּחוּרֹתֶ֑יךָ</tei:l>
          <tei:l>עַ֣ד אֲשֶׁ֤ר לֹא־יָבֹ֙אוּ֙ יְמֵ֣י הָֽרָעָ֔ה</tei:l>
          <tei:l>וְהִגִּ֣יעוּ שָׁנִ֔ים אֲשֶׁ֣ר תֹּאמַ֔ר</tei:l>
          <tei:l>אֵֽין־לִ֥י בָהֶ֖ם חֵֽפֶץ׃ <tei:bibl>(קהלת יב:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:remember_lazarus/3"/>
        <tei:lg>
          <tei:l>נָא־עַד קַרְנֵי הָדָר וְאוֹר</tei:l>
          <tei:l>סְמוּיִים מֵהַחַמָּה,</tei:l>
          <tei:l>עַד בַּל־תָּשִׂישׂ מִכּוֹכָבִים</tei:l>
          <tei:l>אוֹ פִּרְחֵי אֲדָמָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:remember_lazarus/9"/>
        <tei:lg>
          <tei:l>כׇּל־עוֹד תֹּאהַב אֶת־כׇּל־דָּבָר</tei:l>
          <tei:l>בָּאָרֶץ וּמִשְׁכּוֹ,</tei:l>
          <tei:l>לִפְנֵי תֹּאבַד כׇּל־תִּקְוָתְךָ</tei:l>
          <tei:l>וְגִיל יָגִיל עַד־כֹּה,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:remember_lazarus/10"/>
        <tei:lg>
          <tei:l>וּזְכֹר אוֹתוֹ, אֶחָד, יָחִיד,</tei:l>
          <tei:l>לִפְנֵי קָרֵב הַיּוֹם</tei:l>
          <tei:l>שֶׁהַשִּׂמְחָה תִּזְנָחֲךָ</tei:l>
          <tei:l>וּמוֹתְךָ הַפִּדְיוֹם.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
