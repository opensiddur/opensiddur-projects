  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_memorial_prayer_for_9_11_sokolow">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_memorial_prayer_for_9_11_sokolow/1"/>
        <tei:lg>
          <tei:l>אֲדוֹן עוֹלָם</tei:l>
          <tei:l>אֲשֶר כָּל יְצִיר נִבְרָא</tei:l>
          <tei:l>בִּדְמוּתוֹ וּבְצַלְמוֹ.</tei:l>
          <tei:l>אָבִינוּ שֶבַּשָּׁמַיִּם</tei:l>
          <tei:l>הַפּוֹצֶה אֶת עֲבָדָיו מֵחֶרֶב רָעָה.</tei:l>
          <tei:l>אֵל נְקָמוֹת</tei:l>
          <tei:l>פְּקוֹד־נָא בְּקִנְאָתְךָ</tei:l>
          <tei:l>אֲנָשִים, נָשִים, וָטַף</tei:l>
          <tei:l>אֲשֶר נִסְפּוּ בְּהִתְרַסֵּק הַמַּטּוֹסִים</tei:l>
          <tei:l>הַחֲטוּפִים בִּידֵי בְלִיַּעַל,</tei:l>
          <tei:l>אֲנְשֵי מִרְמָה וְדָמִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_memorial_prayer_for_9_11_sokolow/2"/>
        <tei:lg>
          <tei:l>זְכוֹר־נָא, בְּרַחֲמֶיךָ הָרַבִּים,</tei:l>
          <tei:l>אֶת אֲלְפֵי חֲלְלֵי הַפִּיגוּעִים</tei:l>
          <tei:l>בִּשְנֵי בִנְיָנִים מְגַרְדֵי הַשְחָקִים.</tei:l>
          <tei:l>שֶנֶּהֶרְגוּ, וְנֶחְנְקוּ, וְנִשְׂרְפוּ חַיִּים</tei:l>
          <tei:l>אוֹ הִפִּילוּ עַצְמָם מֵרֹאשׁ צוּקִים</tei:l>
          <tei:l>לִמְצוּלַת תּהוֹם, לְעֵין צוֹפִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_memorial_prayer_for_9_11_sokolow/3"/>
        <tei:lg>
          <tei:l>זְכוֹר־נָא, בְּחֲסָדֶיךָ,</tei:l>
          <tei:l>אֶת גִּבּוֹרֵי הַתְּאוֹמִים</tei:l>
          <tei:l>אֲשֶר שָׂמוּ בְךָ שִׂבְרָם וּמִבְטַחָם.</tei:l>
          <tei:l>וְטִפְּסוּ לִמְרוֹמֵי בִירָה</tei:l>
          <tei:l>לְכַבּוֹת שְׂרֵיפוֹת ומוֹקְדִים,</tei:l>
          <tei:l>לִפְשׁוֹט יַד עֱזְרָה וָסַעַד</tei:l>
          <tei:l>לְנִפְגָּעִים וּפְצוּעִים,</tei:l>
          <tei:l>וּלְחַלְּצָם מִצָּר וְצוּקָה.</tei:l>
          <tei:l>יַעַן חֵרְפוּ לַמָּוֶת נַפְשָׁם</tei:l>
          <tei:l>לְקַיֵּים, וְלוּ לְרֶגַע קַט,</tei:l>
          <tei:l>נְפָשוֹת אֲחָדוֹת</tei:l>
          <tei:l>וְעוֹלָמוֹת מְלֵאִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_memorial_prayer_for_9_11_sokolow/4"/>
        <tei:lg>
          <tei:l>אֲדוֹן הַשָּׁלוֹם</tei:l>
          <tei:l>שֶׁהַשָּׁלוֹם שֶׁלּוֹ, וְשָׁלוֹם שְׁמוֹ,</tei:l>
          <tei:l>פְּרוֹשׂ־נָא עָלֵינוּ –</tei:l>
          <tei:l>עַל בְּנֵי בְרִיתֶךָ</tei:l>
          <tei:l>וְעַל כָּל בְּרִיאוֹתֶיךָ –</tei:l>
          <tei:l>סוּכַּת שָׁלוֹם וְשַׁלְוָה,</tei:l>
          <tei:l>הַשְקֵט וָבֶטַח.</tei:l>
          <tei:l>וּבָא לְצִיּוֹן גּוֹאֵל</tei:l>
          <tei:l>וְנֹאמַר אָמֵן.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
