    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_the_living_earth_allen">
        <tei:head>תפילה לעולם החי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_living_earth_allen/1"/>
        <tei:lg>
          <tei:l>רִבּוֺנוֺ שֶׁל עוֺלָם, עוֺשֶׂה בְּרֵאשִׁית,</tei:l>
          <tei:l>יְהִי רָצוֺן מִלְפָנֶיךָ</tei:l>
          <tei:l>שֶׁתְּבָרֵךְ בְּרַחֲמִים אֶת בְּרִיאַתְךָ.</tei:l>
          <tei:l>אֵל נָא,</tei:l>
          <tei:l>בָּרֵךְ אֶת הַתֵּבֶל הַקָּדוֺשׁ הַזֵֶּה–</tei:l>
          <tei:l>מֵהַנְּמָלִים עַד הַיּוֺנְקִים;</tei:l>
          <tei:l>מֵעֲצֵיי הַסְּקוֹיוֹת הָעֲנָקִיִים</tei:l>
          <tei:l>עַד הַחַיידָקִים,</tei:l>
          <tei:l>מֵהַחוֺל עַל שְׂפַת הַיָּם</tei:l>
          <tei:l>עַד הֶהָרִים, הַנְּהָרוֺת, וְהַנְּחָלִים</tei:l>
          <tei:l>מִבֶּן הָאֶנוֺשׁ</tei:l>
          <tei:l>עַד הָאֶנוֺשׁוּת כּוּלָה–</tei:l>
          <tei:l>כׇּל מַה שֶּׁקָּיֵּם בַּתֵּבֶל הַזֶּה,</tei:l>
          <tei:l>אֲנַחְנוּ מְבַקְשִׁים,</tei:l>
          <tei:l>מֵעוֺמֶק הַלֵּב,</tei:l>
          <tei:l>נָא אֵל, בָּרֵךְ הַכֹּל,</tei:l>
          <tei:l>אֵל נָא, רְפָא נָא לַכֹּל.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_living_earth_allen/2"/>
        <tei:lg>
          <tei:l>צוּר כׇּל הָעוֺלָמִים,</tei:l>
          <tei:l>נָא, תֵּן בְּלִבֵּנוּ</tei:l>
          <tei:l>אֶת הֲבָנַת הָהַשְׁפָּעָה שֶׁל פְּעוּלוֺתֵינוּ</tei:l>
          <tei:l>עַל בְּרִיאַתְךָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_living_earth_allen/3"/>
        <tei:lg>
          <tei:l>אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֺתֵינוּ וְאִמּוֹתֵינוּ,</tei:l>
          <tei:l>אֵל נָא!</tei:l>
          <tei:l>עֲזוֹר לָנוּ!</tei:l>
          <tei:l>חַדֵּשׁ בְּתוֺכֵנוּ אוֺמֶץ וְכֹחַ,</tei:l>
          <tei:l>לַעֲשׂוֺת אֶת רְצוֹנְךָ בְּלֵבָב שָׁלֵם,</tei:l>
          <tei:l>עֲזוֹר לָנוּ,</tei:l>
          <tei:l>לְרַפֵּא בְּחָכְמָה אֶת גַנֶּךָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_living_earth_allen/4"/>
        <tei:lg>
          <tei:l>גוֹאֲלֵנוּ, מַצִּילֵנוּ,</tei:l>
          <tei:l>לַמֵּד אוֺתָנוּ</tei:l>
          <tei:l>לִחְיוֺת אֶחָד עִם הַשֵּׁנִי,</tei:l>
          <tei:l>בְּאַהֲבָה וּבְשָׁלוֺם,</tei:l>
          <tei:l>בְּרַחֲמִים וּבְחֶסֶד.</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יָהּ</tei:l>
          <tei:l>עוֺשֶׂה נִפְלָאוֺת</tei:l>
          <tei:l>וּבוֺרֵא אֶת הַכֹּל.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
