    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:sheva_brakhot_63103">
        <tei:head>שבע ברכות</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:sheva_brakhot_63103/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ברכה ראשונה</tei:note>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>ה׳ אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם,</tei:l>
          <tei:l>שֶׁהַכֹּל בָּרָא לִכְבוֹדוֹ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:sheva_brakhot_63103/2"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ברכה שנייה</tei:note>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>ה׳ אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם,</tei:l>
          <tei:l>יוֹצֵר הָאָדָם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:sheva_brakhot_63103/3"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ברכה שלישית</tei:note>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>ה׳ אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם,</tei:l>
          <tei:l>אֲשֶׁר יָצַר אֶת הָאָדָם בְּצַלְמוֹ</tei:l>
          <tei:l>בְּצֶלֶם דְּמוּת תַּבְנִיתוֹ,</tei:l>
          <tei:l>וְהִתְקִין לוֹ מִמֶּנּוּ בִנְיָן עֲדֵי עַד.</tei:l>
          <tei:l>בָּרוּךְ אַתָּה ה׳</tei:l>
          <tei:l>יוֹצֵר הָאָדָם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:sheva_brakhot_63103/4"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ברכה רביעית</tei:note>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>שׂוֹשׂ תָּשִׂישׂ וְתָגֵל הַעֲקָרָה,</tei:l>
          <tei:l>בְּקִבּוּץ בָּנֶיהָ לְתוֹכָה בְשִׂמְחָה.</tei:l>
          <tei:l>בָּרוּךְ אַתָּה ה׳,</tei:l>
          <tei:l>מְשַׂמֵּחַ צִיּוֹן בְּבָנֶיהָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:sheva_brakhot_63103/5"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ברכה חמישית</tei:note>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>שַׂמֵּחַ תְּשַׂמֵּחַ רֵעִים הָאֲהוּבִים,</tei:l>
          <tei:l>כְּשַׂמֵּחֲךָ יְצִירְךָ</tei:l>
          <tei:l>בְּגַן עֵדֶן מִקֶּדֶם.</tei:l>
          <tei:l>בָּרוּךְ אַתָּה ה׳,</tei:l>
          <tei:l>מְשַׂמֵּחַ חָתָן וְכַלָּה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:sheva_brakhot_63103/6"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ברכה שישית</tei:note>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>ה׳ אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם,</tei:l>
          <tei:l>אֲשֶׁר בָּרָא שָׂשׂוֹן וְשִׂמְחָה, חָתָן וְכַלָּה,</tei:l>
          <tei:l>גִּילָה רִנָּה דִּיצָה וְחֶדְוָה,</tei:l>
          <tei:l>אַהֲבָה וְאַחְוָה וְשָׁלוֹם וְרֵעוּת.</tei:l>
          <tei:l>מְהֵרָה ה׳ אֱלֹהֵינוּ</tei:l>
          <tei:l>יִשָּׁמַע בְּעָרֵי יְהוּדָה</tei:l>
          <tei:l>וּבְחוּצוֹת יְרוּשָׁלַיִם</tei:l>
          <tei:l>קוֹל שָׂשׂוֹן וְקוֹל שִׂמְחָה,</tei:l>
          <tei:l>קוֹל חָתָן וְקוֹל כַּלָּה,</tei:l>
          <tei:l>קוֹל מִצְהֲלוֹת חֲתָנִים מֵחֻפָּתָם</tei:l>
          <tei:l>וּנְעָרִים מִמִּשְׁתֵּה נְגִינָתָם.</tei:l>
          <tei:l>בָּרוּךְ אַתָּה ה׳,</tei:l>
          <tei:l>מְשַׂמֵּחַ חָתָן עִם הַכַּלָּה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:sheva_brakhot_63103/7"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ברכה שביעית</tei:note>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>ה׳ אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם,</tei:l>
          <tei:l>בּוֹרֵא פְּרִי הַגָּפֶן.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
