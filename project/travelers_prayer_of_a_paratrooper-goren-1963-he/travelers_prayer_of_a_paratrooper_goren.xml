      <tei:div corresp="urn:x-opensiddur:text:prayer:travelers_prayer_of_a_paratrooper_goren">
        <tei:head>תְּפִלַּת הַדֶּרֶךְ לְצַנְחָן</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:travelers_prayer_of_a_paratrooper_goren/1"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן מִלְּפָנֶיךָ</tei:l>
          <tei:l>יְיָ אֱלֹהֵינוּ וְאלֹהֵי אֲבוֹתֵינוּ</tei:l>
          <tei:l>שֶׁתַּצְנִיחֵנוּ לְשָׁלוֹם</tei:l>
          <tei:l>וְתַדְרִיכֵנוּ לְשָׁלוֹם</tei:l>
          <tei:l>וְתִסְמְכֵנוּ לְשָׁלוֹם</tei:l>
          <tei:l>וְתַגִּיעֵנוּ לִמְחוֹז חֶפְצֵנוּ לְחַיִּים וּלְשָׁלוֹם</tei:l>
          <tei:l>וּפְרוֹס עָלֵינוּ סֻכַּת שְׁלוֹמֶךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:travelers_prayer_of_a_paratrooper_goren/2"/>
        <tei:lg>
          <tei:l>וְתַצִּילֵנוּ מִכַּף כׇּל אוֹיֵב וְאוֹרֵב</tei:l>
          <tei:l>וּמֵרוּחוֹת מְצוּיוֹת וּשֶׁאֵינָן מְצוּיוֹת</tei:l>
          <tei:l>וּמִכׇּל מִינֵי תַּקָּלוֹת בָּאֲוִיר</tei:l>
          <tei:l>וּבַנְּחִיתָה</tei:l>
          <tei:l>וְתִתְּנֵנוּ לְחֵן וּלְחֶסֶד וּלְרַחֲמִים בְּעֵינֶיךָ</tei:l>
          <tei:l>וּבְעֵינֵי כׇּל רוֹאֵינוּ</tei:l>
          <tei:l>כִּי אֵל שׁוֹמְרֵנוּ וּמַצִילֵנוּ אָתָּה,</tei:l>
          <tei:l>כִּי אֵל מֶלֶךְ חַנּוּן וְרַחוּם אָתָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:travelers_prayer_of_a_paratrooper_goren/3"/>
        <tei:lg>
          <tei:l>וּשְׁמֹר צֵאתֵנוּ וּבוֹאֵנוּ</tei:l>
          <tei:l>לְחַיִּים וּלְשָׁלוֹם מֵעַתָּה וְעַד עוֹלָם</tei:l>
          <tei:l>כִּי אַתָּה שׁוֹמֵעַ תְּפִלַּת עַמְּךָ יִשְׂרָאֵל</tei:l>
          <tei:l>בְּרַחֲמִים,</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְיָ שׁוֹמֵעַ תְּפִלָּה.</tei:l>
        </tei:lg>
      </tei:div>
