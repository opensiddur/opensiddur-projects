    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:nilah_leheilil_mosheh">
        <tei:head>נִלְאָה לְהֵילִיל</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nilah_leheilil_mosheh/1"/>
        <tei:lg>
          <tei:l>נִלְאָה לְהֵילִיל עַל־שִׁבְרֵֽנוּ</tei:l>
          <tei:l>וְאִֽלּוּ יְלָלָה מָלֵא פִֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nilah_leheilil_mosheh/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אִֽ</tei:seg>לּוּ לִדְיוֹ יִהְיוּ יַמִּים</tei:l>
          <tei:l>וְנִמְתְּחוּ גְוִילִים כִּשְׁמֵי מְרוֹמִים</tei:l>
          <tei:l>וּקְנֵי סוֹפֵר כׇּל־עֲצֵי רְתָמִים</tei:l>
          <tei:l>אֵין דַּי לִכְתֹּב קְצָת צָרוֹתֵינוּ</tei:l>
          <tei:l>וְאִֽלּוּ יְלָלָה מָלֵא פִֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nilah_leheilil_mosheh/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נֶ</tei:seg>חֱרַב דְּבִירִי וְסָף מִקְדָּשִׁי</tei:l>
          <tei:l>וְאָבְדוּ חֲכָמַי וּבֵית מִדְרָשִׁי</tei:l>
          <tei:l>וְאָנָה רִכְבִּי וְעֹז פָּרָשִׁי</tei:l>
          <tei:l>עַל־אֵ֖לֶּה חָשְׁכ֥וּ עֵינֵֽינוּ׃ <tei:bibl>(איכה ה:יז)</tei:bibl></tei:l>
          <tei:l>וְאִֽלּוּ יְלָלָה מָלֵא פִֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nilah_leheilil_mosheh/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">י</tei:seg>וֹקֵד לְבָבִי עַל יְקֹד בֵּית־אֵל</tei:l>
          <tei:l>וְאֵין מִזְבֵּֽחַ וְאֵין הַהַרְאֵל</tei:l>
          <tei:l>וְאֵין כֹּהֵן גָּדוֹל בַּעֲבוֹדַת אֵל</tei:l>
          <tei:l>לְכַפֵּר עַל־כׇּל־חַטֹּאתֵֽינוּ</tei:l>
          <tei:l>וְאִֽלּוּ יְלָלָה מָלֵא פִֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nilah_leheilil_mosheh/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מְ</tei:seg>נוֹרָה וְשֻלְחָן וְלֶֽחֶם הַפָּנִים</tei:l>
          <tei:l>כְּרוּבִים וְאָרוֹן לְוִיִּם וְכֹהֲנִים</tei:l>
          <tei:l>וְשִׁירָה אָזְלָה וּבָֽאוּ יְגוֹנִים</tei:l>
          <tei:l>וְנֶהְפַּ֥ךְ לְאֵ֖בֶל שִׁיר מְחֹלֵֽנוּ</tei:l>
          <tei:l>וְאִֽלּוּ יְלָלָה מָלֵא פִֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nilah_leheilil_mosheh/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שָׁ</tei:seg>בַת קְטֹֽרֶת וְקוֹל מַגְרֵפָה</tei:l>
          <tei:l>וּפָרָה אֲדֻמָּה וְעֶגְלָה עֲרוּפָה</tei:l>
          <tei:l>וְנִסְכֵּי מְנָחוֹת לֹג הִין וְאֵיפָה</tei:l>
          <tei:l>וְשָׂעִיר מַלְבִּין אַשְׁמוֹתֵֽינוּ</tei:l>
          <tei:l>וְאִֽלּוּ יְלָלָה מָלֵא פִֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nilah_leheilil_mosheh/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הָ</tei:seg>שֵׁב עֲבוֹדַת מִקְדָּשֵֽׁנוּ</tei:l>
          <tei:l>וְקַבֵּץ נְפוּצוֹת גָּלוּתֵֽנוּ</tei:l>
          <tei:l>וְהָקֵם נְפִילַת חָרְבוֹתֵֽינוּ</tei:l>
          <tei:l>וַהֲשִׁיבֵֽנוּ לְקַדְמוּתֵֽנוּ</tei:l>
          <tei:l>יָהּ וְאָ֤ז יִמָּלֵ֪א שְׂח֡וֹק פִּ֮ינוּ֮׃ <tei:bibl>(תהלים קכו:ב)</tei:bibl> <tei:note type="instruction">(×2)</tei:note></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
