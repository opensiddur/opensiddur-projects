  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_of_intercession_hertz">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_of_intercession_hertz/2"/>
        <tei:lg>
          <tei:l>אֵל נוֹרָא עֲלִילָה.</tei:l>
          <tei:l>עָמְקוּ מַחְשְׁבוֹתֶֽיךָ מְאֹד.</tei:l>
          <tei:l>וּבֶן אָדָם לֹא יַכִּיר הֲלִיכוֹתֶֽיךָ בַּקֹּֽדֶשׁ</tei:l>
          <tei:l>בַּעֲשׂוֹתְךָ נוֹרָאוֹת לֹא נְקַוֶּה׃</tei:l>
          <tei:l>הִנֵּה הָמוּ גוֹיִם מָטוּ מַמְלָכוֹת.</tei:l>
          <tei:l>יוֹם עֶבְרָה וְצָרָה בָּאָֽרֶץ.</tei:l>
          <tei:l>יוֹם שֹׁאָה וּתְרוּעָה.</tei:l>
          <tei:l>יוֹם שַׁמָּה וְשַׁעֲרוּרָה.<tei:anchor xml:id="note_1"/></tei:l>
          <tei:l>וּמִי יֹאמַר לְךָ מַה־תַּעֲשֶׂה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_of_intercession_hertz/3"/>
        <tei:lg>
          <tei:l>אָנָּא שֹׁפֵט תֵּבֵל בְּצֶֽדֶק וּלְאֻמִּים בְּמֵישָׁרִים.</tei:l>
          <tei:l>עֲנֵֽנוּ בְיוֹם קָרְאֵֽנוּ.</tei:l>
          <tei:l>וְצַדְּקֵֽנוּ בַּמִּשְׁפָּט.</tei:l>
          <tei:l>כִּי אָנוּ לְיָהּ וְעֵינֵֽינוּ לְיָהּ׃</tei:l>
          <tei:l>גָּלוּי וְיָדֽוּעַ לִפְנֵי כִסֵּא כְבוֹדֶֽךָ</tei:l>
          <tei:l>כִּי עַל דְּבַר אֱמֶת וָצֶֽדֶק</tei:l>
          <tei:l>יָצָֽאנוּ לַמִּלְחָמָה׃</tei:l>
          <tei:l>אָכֵן לְמַֽעַן שְׁמוֹר בְּרִית</tei:l>
          <tei:l>חֵרְפוּ בְּנֵי בְרִטַנִיָּא נַפְשָׁם לָמוּת.</tei:l>
          <tei:l>וּלְהַצִּיל עַמִּים צַדִּיקִים</tei:l>
          <tei:l>מֵחֲמַת הַמֵּצִיק.</tei:l>
          <tei:l>וּלְהַשְׁבִּית שַׁמּוֹת וְשַׁעֲרוּרוֹת מִן הָאָֽרֶץ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_of_intercession_hertz/4"/>
        <tei:lg>
          <tei:l>אַתָּה הַמּוֹשֵׁל בְּגֵאוּת הַיָּם</tei:l>
          <tei:l>וְעֹשֶֹה מַלְאָכָיו רוּחוֹת.</tei:l>
          <tei:l>יָדַֽעְנוּ גַם יָדַֽעְנוּ</tei:l>
          <tei:l>אִם נִסַּק שָׁמַֽיִם שָׁם אָֽתָּה.</tei:l>
          <tei:l>וְנִשְׁכְּנָה בְּאַחֲרִית יָם</tei:l>
          <tei:l>גַּם שָׁם מְעֹנָה לָֽנוּ אֱלֹהֵי קֶֽדֶם.</tei:l>
          <tei:l>וּמִתַּֽחַת זְרֹעֹת עוֹלָם׃</tei:l>
          <tei:l>בְּיָדְךָ</tei:l>
          <tei:l>נַפְקִיד נַפְשׁוֹת יוֹרְדֵי הַיָּם בָּאֳנִיּוֹת</tei:l>
          <tei:l>וְרוֹכְבֵי רֽוּחַ בְּמִצְוַת הַמֶּֽלֶךְ׃</tei:l>
          <tei:l>לַֽיְלָה וָיוֹם הֵם שׁוֹקְִדִים</tei:l>
          <tei:l>לְהַרְחִיק חֶֽרֶב הַיּוֹנָה מִגְּבוּלֵֽנוּ׃</tei:l>
          <tei:l>פַּלְּטֵם מִכׇּל רָעָה</tei:l>
          <tei:l>חַלֵּץ נַפְשָׁם מִמָּֽוֶת</tei:l>
          <tei:l>וְאֶת עֵינֵֽינוּ מִן דִּמְעָה׃</tei:l>
          <tei:l>אָנָּא יִהְיוּ עֵינֶֽיךָ בְּרַחֲמִים פְּקוּחוֹת עַל חֵילֵֽינוּ</tei:l>
          <tei:l>וְעַל חֵילֵי אַנְשֵׁי בְרִיתֵֽנוּ׃</tei:l>
          <tei:l>אֹֽרֶךְ יָמִים תַּשְׁבִּיעֵם לְהָגֵן בְּעַד אַרְצֵֽנוּ׃</tei:l>
          <tei:l>עוֹד יוֹסִֽיפוּ חַזְּקֵם וְאַמְּצֵם</tei:l>
          <tei:l>וְיוֹסִֽיפוּ לַעֲשׂוֹת עוֹז וְתַעֲצוּמוֹת בְּאֶֽרֶץ הַחַיִּים.</tei:l>
          <tei:l>וּתְהִלָּתָם אִיִּים יַגִּֽידוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_of_intercession_hertz/5"/>
        <tei:lg>
          <tei:l>אָב הָרַחֲמִים.</tei:l>
          <tei:l>עַד־הֵֽנָּה עֲזָֽרוּנוּ רַחֲמֶֽיךָ.</tei:l>
          <tei:l>וְלֹא־עֲזָבֽוּנוּ חֲסָדֶֽיךָ.</tei:l>
          <tei:l>אָנָּא הָגֵן בְּעַד כׇּל יוֹשְׁבֵי בְרִטַנִיָּא.</tei:l>
          <tei:l>וְהַצִּילֵם מֵרַֽעַשׁ וּמִפַּחַד בַּלֵּילוֹת׃</tei:l>
          <tei:l>יְהִי רָצוֹן מִלְּפָנֶֽיךָ</tei:l>
          <tei:l>שֶׁלֹּא יֵעָשׂוּ בָתֵּיהֶם קִבְרֵיהֶם׃</tei:l>
          <tei:l>מַהֵר יִקַדְּמֽוּנוּ רַחֲמֶֽיךָ.</tei:l>
          <tei:l>וְשַׂמֵּֽחַ יֵעָשׂוּ בִּבְשׁוֹרוֹת טוֹבוֹת</tei:l>
          <tei:l>לִבּוֹת הַדּוֹאֲגִים עַל שְׁלוֹם קְרוֹבֵיהֶם׃</tei:l>
          <tei:l>שְׁלַח רְפוּאָה לַחוֹלִים.</tei:l>
          <tei:l>וְתַנְחוּמֶֽיךָ יְשַׁעַשְׁעוּ נַפְשׁוֹת הַבּוֹכִים</tei:l>
          <tei:l>עַל יְדִידֵיהֶם כִּי אֵינָם׃</tei:l>
          <tei:l>אַל נָא לָנֶֽצַח תֹּֽאכַל חָֽרֶב׃</tei:l>
          <tei:l>חַדֵּשׁ לֵב טָהוֹר וְרֽוּחַ נָכוֹן בְּקֶֽרֶב עָם וָעָם.</tei:l>
          <tei:l>וְגַם קִנְאָתָם וְשִׂנְאָתָם תֹּאבַד לָעַד׃</tei:l>
          <tei:l>כַּלֵּה קוֹל רַֽעַשׁ מִלְחָמָה מֵעָלֵֽינוּ׃</tei:l>
          <tei:l>וְהָיָה מַעֲשֵׂה הַשָּׁלוֹם צֶֽדֶק וּמִשְׁפָּט הַשְׁקֵט וּדְרוֹר לְכׇל יוֹשְׁבֵי תֵבֵל.</tei:l>
          <tei:l>אָמֵן וְאָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" n="1" target="#note_1">
      <tei:p>probably אָרוּר is intended here.</tei:p>
    </tei:note>
  </tei:standOff>
