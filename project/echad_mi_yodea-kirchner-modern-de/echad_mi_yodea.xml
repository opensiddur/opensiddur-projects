  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:echad_mi_yodea">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:echad_mi_yodea/1"/>
        <tei:lg>
          <tei:l>Eines weiß ich,</tei:l>
          <tei:l>eines ist unser Gott,</tei:l>
          <tei:l>der da lebt und strebt,</tei:l>
          <tei:l>wie im Himmel also auch auf Erden.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:echad_mi_yodea/2"/>
        <tei:lg>
          <tei:l>Zwei ist aber mehr,</tei:l>
          <tei:l>das weiß ich,</tei:l>
          <tei:l>zwei Tafeln Mose,</tei:l>
          <tei:l>einig ist unser Gott,</tei:l>
          <tei:l>usw.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:echad_mi_yodea/3"/>
        <tei:lg>
          <tei:l>Drei ist aber mehr,</tei:l>
          <tei:l>das weiß ich,</tei:l>
          <tei:l>3 sind die Väter,</tei:l>
          <tei:l>2 Tafeln Mose,</tei:l>
          <tei:l>einig ist unser Gott,</tei:l>
          <tei:l>usw.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:echad_mi_yodea/4"/>
        <tei:lg>
          <tei:l>Vier ist aber mehr,</tei:l>
          <tei:l>das weiß ich,</tei:l>
          <tei:l>4 sind die Mütter nämlich Sara, Rebecca, Rachel und Lea,</tei:l>
          <tei:l>3 sind die Väter Abraham, Isaac und Jacob,</tei:l>
          <tei:l>2 Tafeln Mose,</tei:l>
          <tei:l>einig ist unser Gott,</tei:l>
          <tei:l>usw.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:echad_mi_yodea/5"/>
        <tei:lg>
          <tei:l>Fünf ist aber mehr,</tei:l>
          <tei:l>das weiß ich,</tei:l>
          <tei:l>fünf sind die Bücher,</tei:l>
          <tei:l>4 sind die Mütter,</tei:l>
          <tei:l>3 sind die Väter,</tei:l>
          <tei:l>zwei Tafeln Mose,</tei:l>
          <tei:l>einig ist unser Gott,</tei:l>
          <tei:l>usw.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:echad_mi_yodea/6"/>
        <tei:lg>
          <tei:l>Sechs ist aber mehr,</tei:l>
          <tei:l>das weiß ich,</tei:l>
          <tei:l>6 sind die Lehrer,</tei:l>
          <tei:l>5 sind die Bücher,</tei:l>
          <tei:l>4 sind die Mütter,</tei:l>
          <tei:l>3 sind die Väter,</tei:l>
          <tei:l>2 Tafeln Mose,</tei:l>
          <tei:l>einig ist unser Gott,</tei:l>
          <tei:l>usw.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:echad_mi_yodea/7"/>
        <tei:lg>
          <tei:l>Sieben ist aber mehr,</tei:l>
          <tei:l>das weiß ich,</tei:l>
          <tei:l>7 sind die Feiern,</tei:l>
          <tei:l>6 sind die Lehrer,</tei:l>
          <tei:l>5 sind die Bücher,</tei:l>
          <tei:l>4 sind die Mütter,</tei:l>
          <tei:l>3 sind die Väter,</tei:l>
          <tei:l>2 Tafeln Mose,</tei:l>
          <tei:l>einig ist unser Gott,</tei:l>
          <tei:l>usw.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:echad_mi_yodea/8"/>
        <tei:lg>
          <tei:l>Acht ist aber mehr</tei:l>
          <tei:l>das weiß ich,</tei:l>
          <tei:l>8 sind die Beschneidung,</tei:l>
          <tei:l>7 sind die Feiern,</tei:l>
          <tei:l>6 sind die Lehrer,</tei:l>
          <tei:l>5 sind die Bücher,</tei:l>
          <tei:l>4 sind die Mütter,</tei:l>
          <tei:l>3 sind die Väter,</tei:l>
          <tei:l>2 Tafeln Mose,</tei:l>
          <tei:l>einig ist unser Gott,</tei:l>
          <tei:l>usw.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:echad_mi_yodea/9"/>
        <tei:lg>
          <tei:l>Neun ist aber mehr,</tei:l>
          <tei:l>das weiß ich,</tei:l>
          <tei:l>9 sind die schwangeren Weiber,</tei:l>
          <tei:l>8 acht die Beschneidung,</tei:l>
          <tei:l>7 die Feiern,</tei:l>
          <tei:l>6 die Lehrer,</tei:l>
          <tei:l>5 Bücher Mose,</tei:l>
          <tei:l>4 Mütter,</tei:l>
          <tei:l>3 Väter,</tei:l>
          <tei:l>2 Tafeln Mose,</tei:l>
          <tei:l>einig ist unser Gott,</tei:l>
          <tei:l>usw.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>