  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:asher_bara_yayin_asis">
        <tei:head>אֲשֶׁר בָּרָא יֵין עָסִיס</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:asher_bara_yayin_asis/1"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם</tei:l>
          <tei:l>אֲשֶׁר בָּרָא יֵין עָסִיס</tei:l>
          <tei:l>וְתִירוֹשׁ טוֹב מֵעֲצֵי גְּפָנִים</tei:l>
          <tei:l>וְהוּא עָרֵב לַנֶּפֶשׁ וְטוֹב לָאָדָם</tei:l>
          <tei:l>וּמְשַׂמֵּחַ לֵב וּמַצְהִיל פָּנִים</tei:l>
          <tei:l>וְהוּא תַּנְחוּמִין לַאֲבֵלִים</tei:l>
          <tei:l>וּמָרֵי נֶפֶשׁ יִשְׁכְּחוּ רִישָׁן</tei:l>
          <tei:l>וְהוּא רְפוּאָה לְכׇל שׁוֹתָיו</tei:l>
          <tei:l>לְמִי שֶׁיִּשְׁתֶנּוּ בְּטַעַם וּבְדַעַת</tei:l>
          <tei:l>הוּא שִׂמְחַת לֵבָב שָׂשׂוֹן</tei:l>
          <tei:l>וְרֹב גִּלָּה לַשּׁוֹתִין אוֹתוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:asher_bara_yayin_asis/2"/>
        <tei:lg>
          <tei:l>הוּא אֱלֹהֵינוּ יְצָרוֹ מֵאָז</tei:l>
          <tei:l>לְהִתְעַנֵּג בְּמַעֲשִׂים כּוֹנְנוּ מֵרֹאשׁ</tei:l>
          <tei:l>שֶׁכׇּל שׁוֹתָיו יְבָרְכוּ לָאֵל</tei:l>
          <tei:l>וִישַׁבְּחוּ לְיוֹצֵר בִּינָה</tei:l>
          <tei:l>הַמֵּכִין מַעֲדַנֵּי תֵּבֵל</tei:l>
          <tei:l>וְיָצַר לִמְתוּקֵי אָרֶץ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:asher_bara_yayin_asis/3"/>
        <tei:lg>
          <tei:l>הוּא אֱלֹהֵינוּ</tei:l>
          <tei:l>אֲשֶׁר בָּרָא תִּירוֹשׁ מִן הַגֶּפֶן</tei:l>
          <tei:l>וְהִתְקִין עָסִיס מִן הָעֲנָבִים</tei:l>
          <tei:l>לְהַשְׂבִּיעַ נֶפֶשׁ רְעֵבָה</tei:l>
          <tei:l>וּלְמַלֵּא נֶפֶשׁ שׁוֹקֵקָה</tei:l>
          <tei:l>שׁוֹתָיו יִשְׂמַח לִבּוֹ</tei:l>
          <tei:l>עַל פְּרִי מַעֲשָׂיו יְבָרְכוּ לְבוֹרְאֵהוּ</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>הַמֶּלֶךְ הַמְּרוֹמָם לְבַדּוֹ</tei:l>
          <tei:l>הָאֵל הַקָּדוֹשׁ</tei:l>
          <tei:l>בּוֹרֵא פְּרִי הַגָּפֶן:</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
