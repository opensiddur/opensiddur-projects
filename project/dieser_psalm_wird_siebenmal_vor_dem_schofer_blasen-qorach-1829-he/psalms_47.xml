  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/47">
        <tei:head>תהלים מ״ז</tei:head>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>לַמְנַצֵּחַ לִבְנֵי־קֹרַח מִזְמוֹר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/47/2/a"/>
        <tei:lg>
          <tei:l>כׇּל־הָעַמִּים תִּקְעוּ־כָף</tei:l>
          <tei:l>הָרִיעוּ לֵאלֹהִים בְּקוֹל רִנָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/47/3/a"/>
        <tei:lg>
          <tei:l>כִּי־יְהֹוָה עֶלְיוֹן נוֹרָא</tei:l>
          <tei:l>מֶלֶךְ גָּדוֹל עַל־כׇּל־הָאָרֶץ׃</tei:l>
          <tei:l>יַדְבֵּר עַמִּים תַּחְתֵּינוּ</tei:l>
          <tei:l>וּלְאֻמִּים תַּחַת רַגְלֵינוּ׃</tei:l>
          <tei:l>יִבְחַר־לָנוּ אֶת־נַחֲלָתֵנוּ</tei:l>
          <tei:l>אֶת־גְּאוֹן יַעֲקֹב אֲשֶׁר־אָהֵב סֶלָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/47/6/a"/>
        <tei:lg>
          <tei:l>עָלָה אֱלֹהִים בִּתְרוּעָה</tei:l>
          <tei:l>יְהֹוָה בְּקוֹל שׁוֹפָר׃</tei:l>
          <tei:l>זַמְּרוּ אֱלֹהִים זַמֵּרוּ זַמְּרוּ לְמַלְכֵּנוּ זַמֵּרוּ׃</tei:l>
          <tei:l>כִּי מֶלֶךְ כׇּל־הָאָרֶץ אֱלֹהִים</tei:l>
          <tei:l>זַמְּרוּ מַשְׂכִּיל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/47/9/a"/>
        <tei:lg>
          <tei:l>מָלַךְ אֱלֹהִים עַל־גּוֹיִם</tei:l>
          <tei:l>אֱלֹהִים יָשַׁב עַל־כִּסֵּא קׇדְשׁוֹ׃</tei:l>
          <tei:l>נְדִיבֵי עַמִּים נֶאֱסָפוּ</tei:l>
          <tei:l>עַם אֱלֹהֵי אַבְרָהָם</tei:l>
          <tei:l>כִּי לֵאלֹהִים מָגִנֵּי־אֶרֶץ מְאֹד נַעֲלָה׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
