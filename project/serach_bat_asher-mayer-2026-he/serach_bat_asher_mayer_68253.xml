      <tei:div corresp="urn:x-opensiddur:text:poem:serach_bat_asher_mayer_68253">
        <tei:head>שֶֽׂרַח בַּת־אָשֵׁר</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:serach_bat_asher_mayer_68253/1"/>
        <tei:lg>
          <tei:l>שֶֽׂרַח בַּת־אָשֵׁר, שֶֽׂרַח בַּת־אָשֵׁר, שֶֽׂרַח בַּת־אָשֵׁר</tei:l>
          <tei:l>בִּמְהֵרָה בֵּין אָב לְבֵן, בֵּין אֵם לְבַת הִיא תְּפַשֵּׁר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:serach_bat_asher_mayer_68253/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">תּ</tei:seg>וֹרָה הַקְּדוֹשָׁה מַזְכִּירָתָהּ פַּעֲמַֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">שְׁ</tei:seg>מָהּ נִמְצֵאת בְּסֵֽפֶר בְּרִיאַת אֶֽרֶץ וְשָׁמַֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">רְ</tei:seg>שׁוּמָה בְּמִפְקַד פִּינְחָס כִּי הָלְכָה בְּתוֹךְ הַמַּיִם׃</tei:l>
          <tei:l>שֶֽׂרַח בַּת־אָשֵׁר...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:serach_bat_asher_mayer_68253/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>מָה מִבֶּֽטֶן אֵֽשֶׁת אָבִֽיהָ בָּרוּךְ מִבָּנִים</tei:l>
          <tei:l><tei:seg type="acrostic">צִ</tei:seg>דְקָנִית הָיְתָה וְנוֹדְעוּ־לָהּ כׇּל־טְמוּנִים</tei:l>
          <tei:l><tei:seg type="acrostic">פֵּ</tei:seg>רוּשׁ הַחֲכָמִים חַיֶּֽיהָ אֲרֻכֵּי שָׁנִים׃</tei:l>
          <tei:l>שֶֽׂרַח בַּת־אָשֵׁר...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:serach_bat_asher_mayer_68253/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">עָ</tei:seg>נְתָה לַתָּם בִּלְשׁוֹן תֵּמַהּ כִּי יוֹסֵף בְּמִצְרַֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">שָׂ</tei:seg>מַח בָּהּ כִּי אָמְרָה לֵאמֹר יוּלְדוּ לוֹ עַל־בִּרְכַּֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">נִ</tei:seg>ינֶֽיךָ מְבֹרְכֵי־הָאֵל מְנַשֶּׁה וְאֶפְרַֽיִם׃</tei:l>
          <tei:l>שֶֽׂרַח בַּת־אָשֵׁר...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:serach_bat_asher_mayer_68253/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מ</tei:seg>וֹרִיד שְׁאוֹל וַיָּֽעַל הוֹרִידָהּ לְאַדְמַת חַם</tei:l>
          <tei:l><tei:seg type="acrostic">לִ</tei:seg>רְאוֹת אֵיפֹה בַּיְאֹר קֶֽבֶר הַצַּדִּיק תֻּחַם</tei:l>
          <tei:l><tei:seg type="acrostic">כִּ</tei:seg>לּוּ שְׁנוֹת שִׁעְבּוּד בָּא עֵת הָעָם שֶׁיְּנֻחַם׃</tei:l>
          <tei:l>שֶֽׂרַח בַּת־אָשֵׁר...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:serach_bat_asher_mayer_68253/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>שָׁר לַאֲתַר הִדְרִיכַֽתּוּ הׇעֳלָה מֵהַסּוּף</tei:l>
          <tei:l><tei:seg type="acrostic">טֻ</tei:seg>בְּעוּ צִבְאוֹת פַּרְעֹה וְהִיא עָבְרָה מִתּוֹךְ יַם סוּף</tei:l>
          <tei:l><tei:seg type="acrostic">חָ</tei:seg>זְתָה בְּאֶמְפּוֹמָטָא כְּזֹֽהַר הַפַּרְצוּף׃</tei:l>
          <tei:l>שֶֽׂרַח בַּת־אָשֵׁר...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:serach_bat_asher_mayer_68253/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זָ</tei:seg>כְתָה לַעֲלוֹת לָאָֽרֶץ שֶׁמִּשָּׁם יָרְדָה לְפָנִים</tei:l>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>שָׁם אָבֵֽלָה בֵּית הַמַּעֲכָה פָּנְתָה פָנִים</tei:l>
          <tei:l><tei:seg type="acrostic">הָ</tei:seg>יְתָה חֲכָמָה בְּעִירָהּ מִכׇּל־הַמְּבִינִים׃</tei:l>
          <tei:l>שֶֽׂרַח בַּת־אָשֵׁר...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:serach_bat_asher_mayer_68253/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">דַּ</tei:seg>בֵּר יְדַבְּרוּ רִאשֹׁנָה לֵאמֹר שָׁאוֹל וְכֵן</tei:l>
          <tei:l><tei:seg type="acrostic">גַּ</tei:seg>ם עֵת צָרָה בָּאָה אֵלֶֽיהָ כִּי הָיָה שׁוֹכֵן</tei:l>
          <tei:l><tei:seg type="acrostic">בֶּ</tei:seg>ן־בִּכְרִי שָׂם בָּעִיר וָאֵם אִישׁ צַר וּמְסַכֵּן׃</tei:l>
          <tei:l>שֶֽׂרַח בַּת־אָשֵׁר...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:serach_bat_asher_mayer_68253/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אֶ</tei:seg>ת־יָדוֹ נָשָׂא בַּמֶּֽלֶךְ וְהֵעִיר שָׁם תַּבְהֵלָה</tei:l>
          <tei:l><tei:seg type="acrostic">אָ</tei:seg>מַר בֶּן־צְרוּיָה בְּאַפּוֹ לָצוּר בְּסוֹלְלָה</tei:l>
          <tei:l><tei:seg type="acrostic">אָ</tei:seg>מְרָה־לוֹ לָֽמָּה תְּמִיתֵֽנוּ אָמַר חָלִֽילָה׃</tei:l>
          <tei:l>שֶֽׂרַח בַּת־אָשֵׁר...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:serach_bat_asher_mayer_68253/10"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יְ</tei:seg>שָׁרָה וַחֲכָמָה אַתְּ חָלִֽילָה אִם־אַשְׁחִית</tei:l>
          <tei:l><tei:seg type="acrostic">צָ</tei:seg>עַק יוֹאָב אֵלֶֽיהָ מְבֹרֶֽכֶת וְנִצְחִית</tei:l>
          <tei:l><tei:seg type="acrostic">חִ</tei:seg>זְקִי לְהַשְׁלִיךְ רֹאשׁ הַמּוֹרֵד זֽוֹהִי הֶכְרֵחִית׃</tei:l>
          <tei:l>שֶֽׂרַח בַּת־אָשֵׁר...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:serach_bat_asher_mayer_68253/11"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>מָה וְעָשְׂתָה זֹאת הִצִּילָה עִיר בְּחׇכְמָתָהּ</tei:l>
          <tei:l><tei:seg type="acrostic">בִּ</tei:seg>זְכוּת כׇּל־חׇכְמוֹת פִּֽיהָ עוֹד דָּבָר שֶׁהִיא זָכְתָה</tei:l>
          <tei:l><tei:seg type="acrostic">נְ</tei:seg>וֵה הַגַּן וְהַפַּרְדֵּס בַּחַיִּים רָאֲתָה׃</tei:l>
          <tei:l>שֶֽׂרַח בַּת־אָשֵׁר...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:serach_bat_asher_mayer_68253/12"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>שְׁבוּ הָרַבָּנִים בְּבֵית מִדְרָשׁ לָדַֽעַת מָה</tei:l>
          <tei:l><tei:seg type="acrostic">עָ</tei:seg>מְדוּ מֵימֵי הַיָּם לִפְנֵי יִשְׂרָאֵל כְּחוֹמָה</tei:l>
          <tei:l><tei:seg type="acrostic">לָ</tei:seg>מְדוּ כְּאֶמְפּוֹמָטָא כִּי הִיא הָיְתָה שָֽׁמָּה׃</tei:l>
          <tei:l>שֶֽׂרַח בַּת־אָשֵׁר...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:serach_bat_asher_mayer_68253/13"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חֲ</tei:seg>כָמַת הַחֲכָמוֹת אַתְּ וְתַחְזְרִי בְּשִׁירָה</tei:l>
          <tei:l><tei:seg type="acrostic">זָ</tei:seg>קַנְתְּ אַרְבַּֽעַת אֲלָפִים עַל־יַד אֲשֶׁר־בָּרָא</tei:l>
          <tei:l><tei:seg type="acrostic">קֽ</tei:seg>וּמִי קַבְּצִי עַמֵּךְ בִּירוּשָׁלַֽיִם הַבִּירָה׃</tei:l>
          <tei:l>שֶֽׂרַח בַּת־אָשֵׁר...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
