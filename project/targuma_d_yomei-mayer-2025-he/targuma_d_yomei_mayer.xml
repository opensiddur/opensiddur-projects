    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:targuma_d_yomei_mayer">
        <tei:head>תַּרְגּֽוּמָא דְּיוֹמֵי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:targuma_d_yomei_mayer/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">תַּ</tei:seg>רְגּֽוּמָא דְּיוֹמֵי אֶפְתַּח פִּתְחָא חַד</tei:l>
          <tei:l><tei:seg type="acrostic">תְּ</tei:seg>הֽוֹמָא וְאַֽרְעָא נְפַֽקוּ מִן־חַד</tei:l>
          <tei:l><tei:seg type="acrostic">שְׁ</tei:seg>כִֽינְתָּא דִּמְנַֽשְּׁבָא אַמְרָה מֵֽימְרָא חַד</tei:l>
          <tei:l><tei:seg type="acrostic">שְׁ</tei:seg>רָֽגָא יְהֵא וַהֲוָה נְהֽוֹרָא חַד</tei:l>
          <tei:l><tei:seg type="acrostic">רַ</tei:seg>עֲוָא קֳדָמֽוֹהִי דְּקָרֵֽינָן אֵל חַד</tei:l>
          <tei:l><tei:seg type="acrostic">רִ</tei:seg>יבּוֹן מַר אֲרֵי טָב בִּצְפַר יוֹמָא חַד׃</tei:l>
          <tei:l>וַהֲוָה־רְמַ֥שׁ וַהֲוָה־צְפַ֖ר י֥וֹם חַֽד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:targuma_d_yomei_mayer/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ק</tei:seg>וֹזְמוֹקְרָטוֹר דְּלֵית כְּוָתֵיהּ תִּנְיָן</tei:l>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>ם לְאָקָֽמָא קִיּוּם דְּקַדְמִין בְּתִנְיָן</tei:l>
          <tei:l><tei:seg type="acrostic">צְ</tei:seg>בַת עִילְיָֽתָא שִׁבְעָא וּרְקִֽיעָא הוּא תִּנְיָן</tei:l>
          <tei:l><tei:seg type="acrostic">צַ</tei:seg>לַּח מַֽיָּא רַֽבָּא לְקַדְמַאי וְתִּנְיָן</tei:l>
          <tei:l><tei:seg type="acrostic">פִּ</tei:seg>ילָגוֹס לִמְעַיֵּיל אוּרָנוֹס תְּבַר בְּתִנְיָן</tei:l>
          <tei:l><tei:seg type="acrostic">פַּ</tei:seg>לְגְוָֽאתָא דְּמַלְאָכֵי פְּתַֽחוּ תֻּשְׁבַּחְתְּהוֹן בְּתִנְיָן׃</tei:l>
          <tei:l>וַהֲוָה־רְמַ֥שׁ וַהֲוָה־צְפַ֖ר י֥וֹם תִּנְיָֽן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:targuma_d_yomei_mayer/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">עֲ</tei:seg>בַד תְּחוּמִין דִּימָֽמָא וּדְיַבֶּֽשְׁתָא בִּתְּלִיתָי</tei:l>
          <tei:l><tei:seg type="acrostic">עַ</tei:seg>ד־כְּדוֹן מַֽיִּן סַגִֽיעִין מַר מָר בִּתְּלִיתָי</tei:l>
          <tei:l><tei:seg type="acrostic">סְ</tei:seg>גַרִֽינּוּן כְּדִכְתִיב בְּפִֽיסְקָא תְּלִיתָי</tei:l>
          <tei:l><tei:seg type="acrostic">סְ</tei:seg>פַר אוֹרַֽיְתָא דְּיִתְקַבְּלוּן בִּתְּלִיתָי</tei:l>
          <tei:l><tei:seg type="acrostic">נְ</tei:seg>בִיאֵי בַּתְרָהּ בְּקִֽרְיָא וּכְתוּבֵי אִנּוּן בָּב תְּלִיתָי</tei:l>
          <tei:l><tei:seg type="acrostic">נְ</tei:seg>בַֽטוּ יַרְקִין בְּדִיל מַעְסְרָא עַֽנְיָא בִּשְׁתִיתָי וּתְלִיתָי</tei:l>
          <tei:l>וַהֲוָה־רְמַ֥שׁ וַהֲוָה־צְפַ֖ר י֥וֹם תְּלִיתָֽי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:targuma_d_yomei_mayer/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מַ</tei:seg>זָּלַֽיָּא דְּגִֽלְגְּלָא אִיקְּבַֽעוּ בְּשִׁטְרֵיהוֹן בִּרְבִיעָי</tei:l>
          <tei:l><tei:seg type="acrostic">מַ</tei:seg>פְקָנִין דִּנְהֽוֹרָא אַנְהַֽרוּ בְּקַדְמֵֽיתָא בִּרְבִיעָי</tei:l>
          <tei:l><tei:seg type="acrostic">לֵ</tei:seg>ילָוָן בִּרְשֽׁוּתָא דְּסִֽיהֲרָא דִּבְדִילֵיהּ קָרֵי רְבִיעָי</tei:l>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>אַנְהָֽרָא יְמָֽמָא עֲבַד שִֽׁמְשָׁא דִּבְגִֽלְגְּלָא רְבִיעָי</tei:l>
          <tei:l><tei:seg type="acrostic">כּ</tei:seg>וֹכְבַֽיָּא מַן יִכּוֹל לְמִמְנֵי בַּר־מִין בַּֽעַל אָת רְבִיעָי</tei:l>
          <tei:l><tei:seg type="acrostic">כְּ</tei:seg>מָה טָב שְׁחָקָא דִּבְרָא בִּרְבִיעָי</tei:l>
          <tei:l>וַהֲוָה־רְמַ֥שׁ וַהֲוָה־צְפַ֖ר י֥וֹם רְבִיעָֽי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:targuma_d_yomei_mayer/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יַ</tei:seg>מְמַֽיָּא מְלָא בְּכׇל־מִינֵי נוּנַֽיָּא בַּחֲמִישָׁי</tei:l>
          <tei:l><tei:seg type="acrostic">יִ</tei:seg>נְעוּ מִן־פּוּטִֽיתָא זְעֵֽרְתָּא עד־לִוְיָתָן רַֽבָּא בַּחֲמִישָׁי</tei:l>
          <tei:l><tei:seg type="acrostic">טְ</tei:seg>מִיעִין דִּבְמַֽיָּא וְטַיְיסִין דְּבִשְׁמַֽיָּא בְּרָא בַּחֲמִישָׁי</tei:l>
          <tei:l><tei:seg type="acrostic">טָ</tei:seg>רָפִֽיתָא וְדַֽיְּתָא לִזְנַהּ וְכֹל עֽוֹפָא דְכֵי בְּרָא בַּחֲמִישָׁי</tei:l>
          <tei:l><tei:seg type="acrostic">חֲ</tei:seg>זָא אֲרֵי־טָב וּבָרֵיךְ יָתְהוֹן עַד־עַֽלְמָא חֲמִישָׁי</tei:l>
          <tei:l><tei:seg type="acrostic">חֲ</tei:seg>ווּ וּפֽוּשׁוּ וּסְגוּ וּמְלוּ בִּרְיָֽתָא דַּחֲמִישָׁי</tei:l>
          <tei:l>וַהֲוָה־רְמַ֥שׁ וַהֲוָה־צְפַ֖ר י֥וֹם חֲמִישָֽׁי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:targuma_d_yomei_mayer/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זִ</tei:seg>יוָא דִּידַן בְּצִלְמֵיהּ צְלַם בִּשְׁתִיתָי</tei:l>
          <tei:l><tei:seg type="acrostic">זַ</tei:seg>יְּנַן מֵרֵישׁ בִּיכּוּרֵי אַרְעֵיהּ בִּשְׁתִיתָי</tei:l>
          <tei:l><tei:seg type="acrostic">וּ</tei:seg>בְרָא בְּעִֽירָא דְּאַֽרְעָא לְאַלְוִֽינָּן בִּשְׁתִיתָי</tei:l>
          <tei:l><tei:seg type="acrostic">וּ</tei:seg>בָרְכִֽינָּן בְּתֽוּקְפָא עִילָּוֵי אַֽרְעָא בִּשְׁתִיתָי</tei:l>
          <tei:l><tei:seg type="acrostic">הֲ</tei:seg>דָֽרָא דְּעַֽלְמָא אִשְׁתָּכְלַל בִּשְׁתִיתָי</tei:l>
          <tei:l><tei:seg type="acrostic">ה</tei:seg>וּא שֵׁיצֵי עוֹבָדֽוֹהִי דְּמִלְּקַדְמִין אַפַּֽנְיָא דִּשְׁתִיתָי</tei:l>
          <tei:l>וַהֲוָה־רְמַ֥שׁ וַהֲוָה־צְפַ֖ר י֥וֹם שְׁתִיתָֽי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:targuma_d_yomei_mayer/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">דֵּ</tei:seg>ין יוֹמָא דְּנִיחָא וּשְׁדוּכְיָא יוֹמָא שְׁבִיעָֽאָה</tei:l>
          <tei:l><tei:seg type="acrostic">דְּ</tei:seg>בֵיהּ נָח קֻדְשָׁא בְּרִיךְ הוּא וּבָרֵיךְ וְקַדֵּישׁ שְׁבִיעָֽאָה</tei:l>
          <tei:l><tei:seg type="acrostic">גֵּ</tei:seg>יוְתֵּיהּ גְּבִיהָה מִן־כׇּל־מוֹעֲדֵי יַרְחָא שְׁבִיעָֽאָה</tei:l>
          <tei:l><tei:seg type="acrostic">גִּֽ</tei:seg>נְזָא רַֽבָּא אַחְסִֽינָּן לְעַם מְקַדְּשֵׁי שְׁבִיעָֽאָה</tei:l>
          <tei:l>וְנָח֙ בְּי֣וֹמָא שְׁבִיעָ֔אָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:targuma_d_yomei_mayer/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>רְכָן וְתוֹדָן לְאֵל דִּשְׁבַת בִּשְׁבִיעָֽאָה</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>רִיכִין תֶּהֱווּן מִן־קֳדָמוֹהִי עַד־דִּרְקִיעָא שְׁבִיעָֽאָה</tei:l>
          <tei:l><tei:seg type="acrostic">אֲ</tei:seg>רֵי בְּיוֹם חֶדְוָת אוֹרַֽיתָא יוֹם תְּמִינָאה בָּתַר שְׁבִיעָֽאָה</tei:l>
          <tei:l><tei:seg type="acrostic">אֲ</tei:seg>שַׁלֵם כְּעַן יַת־פִּיּוּטִי בְּתַרְגּֽוּמָא דִּשְׁבִיעָֽאָה</tei:l>
          <tei:l>וּבָרֵ֤יךְ יְהֹוָה֙ יָת־י֣וֹמָא שְׁבִיעָ֔אָה</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
