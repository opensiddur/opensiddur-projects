    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_in_honour_of_the_90th_birthday_of_queen_elizabeth_ii_mirvis">
        <tei:head>הַנּוֹתֵן תְּשׁוּעָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_in_honour_of_the_90th_birthday_of_queen_elizabeth_ii_mirvis/1"/>
        <tei:lg>
          <tei:l>הַנּוֹתֵן תְּשׁוּעָה לַמְּלָכִים</tei:l>
          <tei:l>וּמֶמְשָׁלָה לַנְּסִיכִים</tei:l>
          <tei:l>מַלְכוּתוֹ מַלְכוּת כׇּל־עוֹלָמִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_in_honour_of_the_90th_birthday_of_queen_elizabeth_ii_mirvis/2"/>
        <tei:lg>
          <tei:l>הוּא יְבָרֵֽךְ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_in_honour_of_the_90th_birthday_of_queen_elizabeth_ii_mirvis/3"/>
        <tei:lg>
          <tei:l>מֶֽלֶךְ מַלְכֵי הַמְּלָכִים</tei:l>
          <tei:l>בְּרַחֲמָיו יְחַיֶּֽיהָ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְיִשְׁמְרֶֽהָ</tei:l>
          <tei:l>וּמִכׇּל־צָרָה וְיָגוֹן יַצִּילֶֽהָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_in_honour_of_the_90th_birthday_of_queen_elizabeth_ii_mirvis/4"/>
        <tei:lg>
          <tei:l>וִיבָרֵךְ וְיִשֽׁמֹר</tei:l>
          <tei:l>אֶת צְבָא הַמַּלְכָּה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_in_honour_of_the_90th_birthday_of_queen_elizabeth_ii_mirvis/5"/>
        <tei:lg>
          <tei:l>וְיִתֵּן בְּלִבָּהּ</tei:l>
          <tei:l>וּבְלֵב כׇּל־יוֹעֲצֶיהָ</tei:l>
          <tei:l>רוּחַ חָכְמָה וּבִינָה</tei:l>
          <tei:l>לְהַחֲזִיק שְׁלוֹם הַמַּלְכוּת</tei:l>
          <tei:l>וְשַׁלְוַת עַמָּהּ</tei:l>
          <tei:l>וְלַעֲשׂוֹת חֶֽסֶד וֶאֶמֶת עִם־כׇּל־יִשְׂרָאֵל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_in_honour_of_the_90th_birthday_of_queen_elizabeth_ii_mirvis/7"/>
        <tei:lg>
          <tei:l>בְּיָמֶיהָ וּבְיָמֵֽינוּ</tei:l>
          <tei:l>יִפְרֹשׂ אָבִֽינוּ שֶׁבַּשָׁמַֽיִם</tei:l>
          <tei:l>סֻכַּת שָׁלוֹם</tei:l>
          <tei:l>עַל־כׇּל־יוֹשְׁבֵי תֵבֵל</tei:l>
          <tei:l>וּבָא לְצִיּוֹן גּוֹאֵל</tei:l>
          <tei:l>וְנֺאמַר אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
