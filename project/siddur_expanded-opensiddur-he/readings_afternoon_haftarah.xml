  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:expanded/readings_afternoon_haftarah">
        <j:conditional xml:id="expanded_condition_2487">
          <tei:note type="instruction" xml:lang="en">Fast Day (Afternoon)</tei:note>
          <j:any>
            <tei:fs type="opensiddur:holiday-aggregate">
              <tei:f name="minor-fast">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
            <tei:fs type="opensiddur:holiday">
              <tei:f name="tisha-bav">
                <tei:numeric value="1"/>
              </tei:f>
            </tei:fs>
          </j:any>
        </j:conditional>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:reading/fast_day_(afternoon)/haftarah"/>
        <j:endConditional target="#expanded_condition_2487"/>
        <j:conditional xml:id="expanded_condition_2489">
          <tei:note type="instruction" xml:lang="en">Yom Kippur (Mincha, Traditional)</tei:note>
          <tei:fs type="opensiddur:holiday">
            <tei:f name="yom-kippur">
              <tei:numeric value="1"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:reading/yom_kippur_(mincha,_traditional)/haftarah"/>
        <j:endConditional target="#expanded_condition_2489"/>
      </tei:div>
    </tei:body>
  </tei:text>
