<?xml version='1.0' encoding='UTF-8'?>
<tei:TEI xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2" xml:lang="he">
  <tei:teiHeader>
    <tei:fileDesc>
      <tei:titleStmt>
        <tei:title type="main" xml:lang="he">מועדים ומנהגים</tei:title>
        <tei:title type="alt" xml:lang="en">Occasional rites</tei:title>
        <tei:respStmt>
          <tei:resp key="mrk">Arrangement and markup</tei:resp>
