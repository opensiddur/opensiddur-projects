  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:gates_of_light_gates_of_blessing_obadyah">
        <tei:head>Gates of Light Gates of Blessing, a mesostic piyyuṭ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gates_of_light_gates_of_blessing_obadyah/1"/>
        <tei:lg>
          <tei:l>Our Parent Who is in heaven,</tei:l>
          <tei:l>mercifully accept our outcry,</tei:l>
          <tei:l>willingly heed our prayer,</tei:l>
          <tei:l>answer the sound of our plea,</tei:l>
          <tei:l>and open for us</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gates_of_light_gates_of_blessing_obadyah/2"/>
        <tei:lg>
          <tei:l>gates of light,</tei:l>
          <tei:l>gates of blessing,</tei:l>
          <tei:l>gates of joy,</tei:l>
          <tei:l>gates of elation,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gates_of_light_gates_of_blessing_obadyah/3"/>
        <tei:lg>
          <tei:l>gates of success,</tei:l>
          <tei:l>gates of scholarship,</tei:l>
          <tei:l>gates of merit,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gates_of_light_gates_of_blessing_obadyah/4"/>
        <tei:lg>
          <tei:l>gates of compassion,</tei:l>
          <tei:l>gates of goodness,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gates_of_light_gates_of_blessing_obadyah/5"/>
        <tei:lg>
          <tei:l>gates of salvation,</tei:l>
          <tei:l>gates of atonement,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gates_of_light_gates_of_blessing_obadyah/6"/>
        <tei:lg>
          <tei:l>gates of study,</tei:l>
          <tei:l>gates of forgiveness,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gates_of_light_gates_of_blessing_obadyah/7"/>
        <tei:lg>
          <tei:l>gates of comfort,</tei:l>
          <tei:l>gates of penitence,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gates_of_light_gates_of_blessing_obadyah/8"/>
        <tei:lg>
          <tei:l>gates of help,</tei:l>
          <tei:l>gates of rescue,</tei:l>
          <tei:l>gates of justice,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gates_of_light_gates_of_blessing_obadyah/9"/>
        <tei:lg>
          <tei:l>gates of holiness</tei:l>
          <tei:l>gates of comprehensive healing</tei:l>
          <tei:l>gates of peace,</tei:l>
          <tei:l>gates of Torah,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gates_of_light_gates_of_blessing_obadyah/10"/>
        <tei:lg>
          <tei:l>and inscribe us in Your book of good life.</tei:l>
          <tei:l>May this be the Divine will,</tei:l>
          <tei:l>and let us say, “Amen”.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
