  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_prayer_for_democracies_everywhere_with_the_welfare_seidenberg">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_democracies_everywhere_with_the_welfare_seidenberg/1"/>
        <tei:lg>
          <tei:l>תְעַקֵּר רוֹדָנוּת וְטִירוּנִיָא וָעָרִיצוּת</tei:l>
          <tei:l>וּתְשַׁבֵּר רַמַאִים</tei:l>
          <tei:l>וּתְמַגֵּר עֹשְׁקֵי נִדְכָּאִים</tei:l>
          <tei:l>תַעֲבִיר מֶמְשֶׁלֶת זָדוֹן מִן הָאָרֶץ</tei:l>
          <tei:l>תַּכְשִׁיל פּוֹגְעִים בְּדֵמוֹקרָטִיָה</tei:l>
          <tei:l>וְתָּפֵר תַחְבּוּלוֹתָם</tei:l>
          <tei:l>תְכַלֵּם</tei:l>
          <tei:l>וְתַשְׁפִּילֵם</tei:l>
          <tei:l>וְתַכְנִיעֵם</tei:l>
          <tei:l>בִּמְהֵרָה בְיָמֵינוּ</tei:l>
          <tei:l>כִּי מַכְנִֽיעַ זֵדִים אַתָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_democracies_everywhere_with_the_welfare_seidenberg/2"/>
        <tei:lg>
          <tei:l>וְכֵן תִּתֵּן לְכָל אֻמּוֹת הָעוֹלָם</tei:l>
          <tei:l>הָכֹּחַ וְהַרָצוֹן לִרְדֹף צֶדֶק</tei:l>
          <tei:l>וּלְכוֹנֵן מִשְׁפָּט</tei:l>
          <tei:l>וּלְבַקֵּשׁ שָׁלוֹם כְּאַגֻדָה אַחַת</tei:l>
          <tei:l>לֲעַקֹר חָמָס</tei:l>
          <tei:l>וּלְהַצְמִיחַ רְפוּאָה וְחַיִים טוֹבִים וְשָׁלוֹם</tei:l>
          <tei:l>כִּי אַתָּה הוּא מֶֽלֶךְ אֹהֵב צְדָקָה וּמִשְׁפָּט</tei:l>
          <tei:l>(וְנֹאמַר אָמֵן)</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
