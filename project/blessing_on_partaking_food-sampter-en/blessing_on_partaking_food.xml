  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:blessing_on_partaking_food">
        <tei:head>Blessing on Partaking [all other] Food, a rhyming translation and explanation by Jessie Ethel Sampter (1919)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_on_partaking_food/1"/>
        <tei:lg>
          <tei:l>Blessed art thou, O Lord our God,</tei:l>
          <tei:l>The Lord of life and everything</tei:l>
          <tei:l>Who by his word brought all to be.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_on_partaking_food/2"/>
        <tei:lg>
          <tei:l>(The things we taste and hear and see</tei:l>
          <tei:l>He made, but not with force or might:</tei:l>
          <tei:l>He only spoke and there was light.)</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
