  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ein_keloheinu">
        <tei:head>אֵין כֵּאלֹהֵֽינוּ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ein_keloheinu/ein"/>
        <tei:lg>
          <tei:l>אֵין כֵּאלֹהֵֽינוּ</tei:l>
          <tei:l>אֵין כַּאדוֹנֵֽינוּ</tei:l>
          <tei:l>אֵין כְּמַלְכֵּֽנוּ</tei:l>
          <tei:l>אֵין כְּמוֹשִׁיעֵֽנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ein_keloheinu/mi"/>
        <tei:lg>
          <tei:l>מִי כֵאלֹהֵֽינוּ</tei:l>
          <tei:l>מִי כַאדוֹנֵֽינוּ</tei:l>
          <tei:l>מִי כְמַלְכֵּֽנוּ</tei:l>
          <tei:l>מִי כְמוֹשִׁיעֵֽנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ein_keloheinu/nodeh"/>
        <tei:lg>
          <tei:l>נוֹדֶה לֵאלֹהֵֽינוּ</tei:l>
          <tei:l>נוֹדֶה לַאדוֹנֵֽינוּ</tei:l>
          <tei:l>נוֹדֶה לְמַלְכֵּֽנוּ</tei:l>
          <tei:l>נוֹדֶה לְמוֹשִׁיעֵֽנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ein_keloheinu/barukh"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אֱלֹהֵֽינוּ</tei:l>
          <tei:l>בָּרוּךְ אֲדוֹנֵֽינוּ</tei:l>
          <tei:l>בָּרוּךְ מַלְכֵּֽנוּ</tei:l>
          <tei:l>בָּרוּךְ מוֹשִׁיעֵֽנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ein_keloheinu/attah"/>
        <tei:lg>
          <tei:l>אַתָּה הוּא אֱלֹהֵֽינוּ</tei:l>
          <tei:l>אַתָּה הוּא אֲדוֹנֵֽינוּ</tei:l>
          <tei:l>אַתָּה הוּא מַלְכֵּֽנוּ</tei:l>
          <tei:l>אַתָּה הוּא מוֹשִׁיעֵֽנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ein_keloheinu/incense"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">פסוק חתימה במנהג ספרדי</tei:note>
          </tei:l>
          <tei:l>אַתָּה תוֹשִׁיעֵנוּ!</tei:l>
          <tei:l>אַתָּ֣ה תָ֭קוּם תְּרַחֵ֣ם צִיּ֑וֹן</tei:l>
          <tei:l>כִּי־עֵ֥ת לְ֝חֶֽנְנָ֗הּ</tei:l>
          <tei:l>כִּי־בָ֥א מוֹעֵֽד׃ <tei:bibl>(תהלים קב:יד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">פסוק חתימה במנהג אשכנזי</tei:note>
          </tei:l>
          <tei:l>אַתָּה הוּא שֶׁהִקְטִֽירוּ אֲבוֹתֵֽינוּ</tei:l>
          <tei:l>לְפָנֶֽיךָ אֶת־קְטֹֽרֶת הַסַּמִּים</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
