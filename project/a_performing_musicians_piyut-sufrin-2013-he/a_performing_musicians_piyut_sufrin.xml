    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:a_performing_musicians_piyut_sufrin">
        <tei:head>פיוט למוזיקאי קודם שיופיע</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_performing_musicians_piyut_sufrin/1"/>
        <tei:lg>
          <tei:l>הַחֽוֹנֵן לְדָוִיד מִזְמוֹר,‏</tei:l>
          <tei:l>הַנֽוֹתֵן שִיר לְבֶן־יִשַי בְחַסְדוֹ הוּא יַעֲזֹר,‏</tei:l>
          <tei:l>וּשְכִינָתוֹ יִשְרֶה עָלַי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_performing_musicians_piyut_sufrin/2"/>
        <tei:lg>
          <tei:l>שֶאֲזַמֵר בְקוֹל טָהוֹר,‏</tei:l>
          <tei:l>זְמִירוֹת טוֹבוֹת לֶאלֹהַי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_performing_musicians_piyut_sufrin/3"/>
        <tei:lg>
          <tei:l>שֶבַח נֵבֶל וְעָשׂוֹר,‏</tei:l>
          <tei:l>לְהַלֵל בְשִׂמְחוֹתַי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_performing_musicians_piyut_sufrin/4"/>
        <tei:lg>
          <tei:l>עֲלֵי הִגָיוֹן בְכִנוֹר,‏</tei:l>
          <tei:l>יְהִי בְרָכָה כָל תָו דְרָכַי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_performing_musicians_piyut_sufrin/5"/>
        <tei:lg>
          <tei:l>אָז אָשִיר לוֹ כְמוֹ צִפּוֹר,‏</tei:l>
          <tei:l>לְיַיפּוֹת אֶת בִרְכוֹתַי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_performing_musicians_piyut_sufrin/6"/>
        <tei:lg>
          <tei:l>יְשִישוֹ נָא בְנִי הַדוֹר,‏</tei:l>
          <tei:l>יָגִילוּ הֵם בְמַנְגִינַי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_performing_musicians_piyut_sufrin/7"/>
        <tei:lg>
          <tei:l>לִרְנָנָה הוּא הַמָקוֹר,‏</tei:l>
          <tei:l>וְהוּא רֵאשִית לְכָל שִירַי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_performing_musicians_piyut_sufrin/8"/>
        <tei:lg>
          <tei:l>שִיר שֶלוֹ הוּא שִיר שֶל אוֹר,‏</tei:l>
          <tei:l>יִפְתַח שִפְעוֹ אֶת שְׂפָתַי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_performing_musicians_piyut_sufrin/9"/>
        <tei:lg>
          <tei:l>לִפְנֵי כִסְאוֹ זְכוּת וּמִישוֹר,‏</tei:l>
          <tei:l>קָהָל יָהּ יֵש לְפָנַי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_performing_musicians_piyut_sufrin/10"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן הָאֵל גִבוֹר,‏</tei:l>
          <tei:l>הַשּׁוֹמֵעַ תְפִלוֹתַי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_performing_musicians_piyut_sufrin/11"/>
        <tei:lg>
          <tei:l>שֶכָל הַנְשָמָה תִזְכֹר,‏</tei:l>
          <tei:l>אַל תִשְכַח אֶת שְתֵי אוֹזְנַי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_performing_musicians_piyut_sufrin/12"/>
        <tei:lg>
          <tei:l>שִירָה זֹאת אֹמַר לֵאמֹר,‏</tei:l>
          <tei:l>אָשִיר לָךְ כָל יְמֵי חַיַי</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
