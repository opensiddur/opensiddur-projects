  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:shalom_aleikhem">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shalom_aleikhem/1"/>
        <tei:lg>
          <tei:l>שְׁלָמָא אֵילוֹכוּן</tei:l>
          <tei:l>מַלַאֲכֵי דִ’שְׁמִישְׁתָא,</tei:l>
          <tei:l>מַלַאֲכֵי דְ’אִלַאיָא.</tei:l>
          <tei:l>מִן מַלְכָּא דְ’מַלְכֵּית כּוּלֵי מַלְכֵּי,</tei:l>
          <tei:l>קַדִּישָׁא בְּרִיכָא לֵיהּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shalom_aleikhem/2"/>
        <tei:lg>
          <tei:l>אַתִּיתוּן בִּשְׁלָמָא</tei:l>
          <tei:l>מַלַאֲכֵי דְ’שְׁלָמָא,</tei:l>
          <tei:l>מַלַאֲכֵי דְ’אִלַאיָא.</tei:l>
          <tei:l>מִן מַלְכָּא דְ’מַלְכֵּית כּוּלֵי מַלְכֵּי,</tei:l>
          <tei:l>קַדִּישָׁא בְּרִיכָא לֵיהּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shalom_aleikhem/3"/>
        <tei:lg>
          <tei:l>בַּרְכוּנִי בִּשְׁלָמָא</tei:l>
          <tei:l>מַלַאֲכֵי דְ’שְׁלָמָא,</tei:l>
          <tei:l>מַלַאֲכֵי דְ’אִלַאיָא.</tei:l>
          <tei:l>מִן מַלְכָּא דְ’מַלְכֵּית כּוּלֵי מַלְכֵּי,</tei:l>
          <tei:l>קַדִּישָׁא בְּרִיכָא לֵיהּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shalom_aleikhem/4"/>
        <tei:lg>
          <tei:l>פְּלַטוֹכוֹן בִּשְׁלָמָא</tei:l>
          <tei:l>מַלַאֲכֵי דְ’שְׁלָמָא,</tei:l>
          <tei:l>מַלַאֲכֵי דְ’אִלַאיָא.</tei:l>
          <tei:l>מִן מַלְכָּא דְ’מַלְכֵּית כּוּלֵי מַלְכֵּי,</tei:l>
          <tei:l>קַדִּישָׁא בְּרִיכָא לֵיהּ.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
