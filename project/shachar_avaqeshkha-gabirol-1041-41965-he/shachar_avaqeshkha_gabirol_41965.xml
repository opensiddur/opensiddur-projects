  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:shachar_avaqeshkha_gabirol_41965">
        <tei:head>שַׁחַר אֲבַקֶּשְׁךָ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shachar_avaqeshkha_gabirol_41965/1"/>
        <tei:lg>
          <tei:l>שַׁחַר אֲבַקֶּשְׁךָ צוּרִי וּמִשְׂגַּבִּי</tei:l>
          <tei:l>אֶעְרֺךְ לְפָנֶיךָ שַׁחְרִי וְגַם עַרְבִּי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shachar_avaqeshkha_gabirol_41965/2"/>
        <tei:lg>
          <tei:l>לִפְנֵי גְדֻלָּתְךָ אֶעְמֹד וְאֶבָּהֵל</tei:l>
          <tei:l>כִּי עֵינְךָ תִּרְאֶה כָל מַחְשְׁבוֹת לִבִּי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shachar_avaqeshkha_gabirol_41965/3"/>
        <tei:lg>
          <tei:l>מַה זֶּה אֲשֶׁר יוּכַל הַלֵּב וְהַלָּשׁוֹן</tei:l>
          <tei:l>לַעְשׂוֹת וּמַה כֹּחַ רוּחִי בְּתוֹךְ קִרְבִּי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shachar_avaqeshkha_gabirol_41965/4"/>
        <tei:lg>
          <tei:l>הִנֵּה לְךָ תִּיטַב זִמְרַת אֱנוֹשׁ עַל כֵּן</tei:l>
          <tei:l>אוֹדְךָ בְּעוֹד תִּהְיֶה נִשְׁמַת אֱלֹהַּ בִּי</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
