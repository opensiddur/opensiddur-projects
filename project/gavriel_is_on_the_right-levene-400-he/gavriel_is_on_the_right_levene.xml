  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:gavriel_is_on_the_right_levene">
        <tei:head>גבריאל מימינהון</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gavriel_is_on_the_right_levene/1"/>
        <tei:lg>
          <tei:l>גבריאל מימינהון</tei:l>
          <tei:l>דדודיתא בת דודי ובנה ובנתה</tei:l>
          <tei:l>ומיכאל מישמאלה</tei:l>
          <tei:l>ומילפנה סוסיאל</tei:l>
          <tei:l>ומילאחרה מנוחא</tei:l>
          <tei:l>ומילמעלה שכינתאל</tei:l>
          <tei:l>יהוה צבאות שמו <tei:bibl>(ישעיה נא:טו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gavriel_is_on_the_right_levene/2"/>
        <tei:lg>
          <tei:l>הרחיק מינה</tei:l>
          <tei:l>מן דודיתא בת דודי ומן בנה ומן בנתה</tei:l>
          <tei:l>כל הפגע רע</tei:l>
          <tei:l>וכל שטן רע</tei:l>
          <tei:l>וכל חיה רע</tei:l>
          <tei:l>וכל דבר רע</tei:l>
          <tei:l>וכל מוצא רע</tei:l>
          <tei:l>וכל הרוחות תשמיש בעולם</tei:l>
          <tei:l>אהיה אשר אהיה <tei:bibl>(שמות ג:יד)</tei:bibl></tei:l>
          <tei:l>אמן אמן סלה</tei:l>
          <tei:l>הללויה</tei:l>
          <tei:l>וקים ושריר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gavriel_is_on_the_right_levene/3"/>
        <tei:lg>
          <tei:l>הדין חתמתא לעלם</tei:l>
          <tei:l>אמן ואמן</tei:l>
          <tei:l>ושריר</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
