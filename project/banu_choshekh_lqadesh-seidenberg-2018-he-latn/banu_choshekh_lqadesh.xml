  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:banu_choshekh_lqadesh">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:banu_choshekh_lqadesh/2"/>
        <tei:lg>
          <tei:l>Banu choshech l’kadesh</tei:l>
          <tei:l>Kodem shemesh titchadesh</tei:l>
          <tei:l>B’yadeinu or v’ner</tei:l>
          <tei:l>Leil kasalmah l’fa’er</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:banu_choshekh_lqadesh/3"/>
        <tei:lg>
          <tei:l>Nish’talenu gar’in esh</tei:l>
          <tei:l>Bad hachoshekh m’lapef</tei:l>
          <tei:l>Gar’inim shel esh va-or</tei:l>
          <tei:l>Bohakim mitokh hash’chor</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:banu_choshekh_lqadesh/4"/>
        <tei:lg>
          <tei:l>Gar’inim shel esh va-or</tei:l>
          <tei:l>Bohakim mitokh hashchor</tei:l>
          <tei:l>Kumah choshekh, Aleh sh’chor</tei:l>
          <tei:l>Kumah, likrat ha-or!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:banu_choshekh_lqadesh/6"/>
        <tei:lg>
          <tei:l>Banu choshekh l’kadesh</tei:l>
          <tei:l>B’yadeinu or va’esh</tei:l>
          <tei:l>Kol echad hu or katan</tei:l>
          <tei:l>V’khulanu or eitan</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:banu_choshekh_lqadesh/7"/>
        <tei:lg>
          <tei:l>Kumah choshekh</tei:l>
          <tei:l>Aleh sh’chor</tei:l>
          <tei:l>Kumah, likrat ha-or!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
