  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:agadelkha_ezra">
        <tei:head>אֲגַדֶלְךָ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:agadelkha_ezra/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אֲ</tei:seg>גַדֶלְךָ אֳלֹהֵי כָּל נְשָׁמָה.</tei:l>
          <tei:l>וְאוֹדֶךָ בְּרֹב פַּחַד וְאֵימָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:agadelkha_ezra/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>עֹמְדִי תוֹךְ קְהַלְךָ צוּר לְרוֹמֵם.</tei:l>
          <tei:l>לְךָ אֶכְרַע וְאֶכוֹף רֹאשׁ וְקוֹמָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:agadelkha_ezra/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רְ</tei:seg>קִיעֵי רוּם הַלֹא נַטָה בְּמִבְטָא.</tei:l>
          <tei:l>וְהָאָרֶץ יְסַדָה עַל בְּלִימָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:agadelkha_ezra/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הַ</tei:seg>יוּכַל אִישׁ חֲקוֹר אֶת סוֹד יוֹצְרוֹ.</tei:l>
          <tei:l>וּמִי הוּא זֶה בְּכֹל קֶדְמָה וְיַמָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:agadelkha_ezra/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מְ</tei:seg>רוֹמַם הוּא עֲלֵי כָּל פֶּה וְלָשׁוֹן.</tei:l>
          <tei:l>אֲשֶׁר הִפְלִיא וְעֲשָׂה כָּל בְּחֹכְמָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:agadelkha_ezra/6"/>
        <tei:lg>
          <tei:l>וְיִתְגַדָל בְּגוֹי קָדוֹשׁ וְעֶלְיוֹן.</tei:l>
          <tei:l>וְיִתְקַדָש שְׁמֵיה רַבָּא בְּעַלְמָא.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
