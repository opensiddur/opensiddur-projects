      <tei:div corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_to_support_agunot_and_call_get_refusers_mayer">
        <tei:head>מי שברך לעגונות</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_to_support_agunot_and_call_get_refusers_mayer/1"/>
        <tei:lg>
          <tei:l>מִי שֶׁבֵּרַךְ הַצַּדִּיקוֹת</tei:l>
          <tei:l>רוּת וַאֲבִיגַיִל וְאֶסְתֵּר הַמַּלְכָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_to_support_agunot_and_call_get_refusers_mayer/2"/>
        <tei:lg>
          <tei:l>וּמִי שֶׁאֵרַר הָרְשָׁעִים</tei:l>
          <tei:l>מַחְלוֹן וְכִלְיוֹן וְנָבָל הַכַּרְמְלִי וְהַמֶּלֶךְ אֲחַשְׁוֵרוֹשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_to_support_agunot_and_call_get_refusers_mayer/3"/>
        <tei:lg>
          <tei:l>הוּא יְבָרֵךְ וִישַׁמֵּר וְיַצְדִּיק וְיִגְמֹל</tei:l>
          <tei:l>עַל כׇּל־נְשֵׁי יִשְׂרָאֵל הַתְּפוּסוֹת בְּמַצַּב עֲגוּנָה חַיָּה</tei:l>
          <tei:l>בִּגְלַל אַנְשֵׁי בְּלִיַּעַל שֶׁנִּשְּׂאוּ לָהֶן</tei:l>
          <tei:l>וְעָזְבוּ אוֹתָן וְלֹא שִׁלְּחוּ בִּידֵיהֶן גֵּט סֵפֶר כְּרִיתוּת.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_to_support_agunot_and_call_get_refusers_mayer/4"/>
        <tei:lg>
          <tei:l>כְּמוֹ שֶׁצִּוָּה הַקָּדוֹשׁ בָּרוּךְ הוּא כַּכָּתוּב בְּתוֹרָתוֹ הַקְּדוֹשָׁה —</tei:l>
          <tei:l>וְכָ֨תַב לָ֜הּ סֵ֤פֶר כְּרִיתֻת֙</tei:l>
          <tei:l>וְנָתַ֣ן בְּיָדָ֔הּ</tei:l>
          <tei:l>וְשִׁלְּחָ֖הּ מִבֵּיתֽוֹ׃ <tei:bibl>(דברים כד:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_to_support_agunot_and_call_get_refusers_mayer/5"/>
        <tei:lg>
          <tei:l>וְאָמְרוּ חֲכָמִים זִכְרוֹנָם לִבְרָכָה —</tei:l>
          <tei:l>אָמַר רַב אַשֵּׁי</tei:l>
          <tei:l>הַאי מַאן דְּסַנַאי שׁוֹמְעָנֵיהּ שָׁרֵי לֵיהּ לְבַזּוּיֵיהּ׃ <tei:bibl>(ת״ב מגילה כה ב)</tei:bibl></tei:l>
          <tei:l>וּבִלְשׁוֹן הַקֹּדֶשׁ מֵימְרָה זוֹהִי נֶאֱמֶרֶת כֵּן —</tei:l>
          <tei:l>הֵן מִי שֶׁשָּׂנוּי‎ שְׁמוֹ</tei:l>
          <tei:l>מֻתָּר לְבַזּוֹת לֹוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_to_support_agunot_and_call_get_refusers_mayer/6"/>
        <tei:lg>
          <tei:l>וּבְכֵן</tei:l>
          <tei:l>בִּרְשׁוּת יְשִׁיבָה שֶׁלְּמַעְלָה</tei:l>
          <tei:l>וּבִזְכוּת יְשִׁיבָה שֶׁלְּמַטָּה</tei:l>
          <tei:l>הִנְנִי אֶקְרָא אֶת־שְׁמוֹת בְּנֵי הַבְּלִיַּעַל בְּתוֹכֵנוּ</tei:l>
          <tei:l>שֶׁעָזְבוּ אֶת־נְשׁוֹתֵיהֶם בְּמַצָּב עֲגוּנָה חַיָּה</tei:l>
          <tei:l>
            <tei:note type="instruction">[פלוני, פלוני, פלוני]</tei:note>
          </tei:l>
          <tei:l>וְלֹא יִרְבּוּ כְּמוֹהֶם בְּיִשְׂרָאֵל!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_to_support_agunot_and_call_get_refusers_mayer/7"/>
        <tei:lg>
          <tei:l>אַקְרָאֵיהֶם</tei:l>
          <tei:l>כִּי לַעֲשׂוֹת כְּמוֹהֶם עֲווֹן מְרֻשָּׁע</tei:l>
          <tei:l>וַעֲלִילַת תּוֹעֵבָה</tei:l>
          <tei:l>וּמַעֲשֶׂה עַל חִלּוּל הַשֵּׁם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_to_support_agunot_and_call_get_refusers_mayer/8"/>
        <tei:lg>
          <tei:l>הַקָּדוֹשׁ בָּרוּךְ הוּא</tei:l>
          <tei:l>הַנּוֹתֵן לָרָשָׁע רַע כְּרִשְׁעָתוֹ</tei:l>
          <tei:l>הוּא יְשַׁלֵּם לָהֶם אֶת־גְּמוּלָם שֶׁגָּמְלוּ לִנְשׁוֹת יִשְׂרָאֵל.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_to_support_agunot_and_call_get_refusers_mayer/9"/>
        <tei:lg>
          <tei:l>וְיֵיטִיב טוֹבַת טוּבוֹ לְכׇל־הַנָּשִׁים</tei:l>
          <tei:l>שֶׁבְּצָרָה וּבִצְרוּרָה בִּגְלָלָם</tei:l>
          <tei:l>וִיחַזֵּק אֶת־יְדֵי כׇּל־מִי שֶׁרָבִים אֶת־רִיבָן</tei:l>
          <tei:l>לְכוֹנֵן שֵׁנִית שֵׁם טוֹב בְּיִשְׂרָאֵל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_to_support_agunot_and_call_get_refusers_mayer/10"/>
        <tei:lg>
          <tei:l>וְנֹאמַר אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
