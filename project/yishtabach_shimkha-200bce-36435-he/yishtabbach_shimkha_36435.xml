  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yishtabbach_shimkha_36435">
        <tei:head>יִשְׁתַּבַּח שִׁמְךָ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yishtabbach_shimkha_36435/1"/>
        <tei:lg>
          <tei:l>יִשְׁתַּבַּח שִׁמְךָ לָעַד מַלְכֵּנוּ.</tei:l>
          <tei:l>הָאֵל הַמֶּלֶךְ הַגָּדוֹל וְהַקָּדוֹשׁ</tei:l>
          <tei:l>בַּשָּׁמַיִם וּבָאָרֶץ.</tei:l>
          <tei:l>כִּי לְךָ נָאֶה יְהֹוָה</tei:l>
          <tei:l>אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yishtabbach_shimkha_36435/2"/>
        <tei:lg>
          <tei:l>שִׁיר וּשְׁבָחָה.</tei:l>
          <tei:l>הַלֵּל וְזִמְרָה.</tei:l>
          <tei:l>עוֹז וּמֶמְשָׁלָה.</tei:l>
          <tei:l>נֶצַח גְּדוּלָּה וּגְבוּרָה.</tei:l>
          <tei:l>תְּהִלָּה וְתִפְאֶרֶת.</tei:l>
          <tei:l>קְדֻשָּׁה וּמַלְכוּת׃</tei:l>
          <tei:l>בְּרָכוֹת וְהוֹדָאוֹת</tei:l>
          <tei:l>מֵעַתָּה וְעַד עוֹלָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yishtabbach_shimkha_36435/3"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה.</tei:l>
          <tei:l>אֵל מֶלֶךְ גָּדוֹל בַּתִּשְׁבָּחוֹת.</tei:l>
          <tei:l>אֵל הַהוֹדָאוֹת.</tei:l>
          <tei:l>אֲדוֹן הַנִּפְלָאוֹת.</tei:l>
          <tei:l>הַבּוֹחֵר בְּשִׁירֵי זִמְרָה.</tei:l>
          <tei:l>מֶלֶךְ אֵל חֵי הָעוֹלָמִים׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
