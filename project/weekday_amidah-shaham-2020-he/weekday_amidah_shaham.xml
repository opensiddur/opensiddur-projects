  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:weekday_amidah_shaham">
        <tei:head>תפילת העמידה ביום חול</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_shaham/1"/>
        <tei:lg>
          <tei:l>הֲוָיַת נִשְׁמָתִי פִּתְחִי פִּי הַתִּירִי לְשׁוֹנִי וַאֲהַלֵּלֵךְ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_shaham/2"/>
        <tei:lg>
          <tei:l>אִמִּי</tei:l>
          <tei:l>הַגִּבּוֹרָה</tei:l>
          <tei:l>הַקְּדוֹשָׁה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_shaham/3"/>
        <tei:lg>
          <tei:l>חָנְּנִי שִׂכְלִי בְּדַעַת וּבִינָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_shaham/4"/>
        <tei:lg>
          <tei:l>אַמְּצִינִי אֶל חֵיק תְּשׁוּבָתֵךְ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_shaham/5"/>
        <tei:lg>
          <tei:l>מַלְּאִי לִבִּי סְלִיחָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_shaham/6"/>
        <tei:lg>
          <tei:l>רְאִי בְעָנְיִי, רִיבִי רִיבִי, מִמֵּיצָרִים גַּאֲלִינִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_shaham/7"/>
        <tei:lg>
          <tei:l>רַפְּאִי אֶת נַפְשִׁי אֶת גּוּפִי אֶת אֲהוּבַי אֶת בְּנוֹת וּבְנֵי מִינִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_shaham/8"/>
        <tei:lg>
          <tei:l>בָּרְכִי אֶת אַדְמָתֵךְ וְאֶת פִּרְיָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_shaham/9"/>
        <tei:lg>
          <tei:l>קַבְּצִי אֵלֶיהָ אֶת נִדָּחַיִךְ בְּאַהֲבָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_shaham/10"/>
        <tei:lg>
          <tei:l>הַשְׁלִיטִי מִשְׁפַּט צִדְקֵךְ</tei:l>
          <tei:l>לְהַכְנִיעַ כָּל רֶשַׁע וְזָדוֹן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_shaham/11"/>
        <tei:lg>
          <tei:l>עִטְפִי בְּרַחֲמַיִךְ אֶת הַזַּכּוֹת וְהַצַּדִּיקוֹת</tei:l>
          <tei:l>לְמַּעַן תִּשְׁכֹּנָּה עִמָּךְ בְּבֵיתֵךְ לָבֶטַח</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_shaham/12"/>
        <tei:lg>
          <tei:l>הוֹשִׁיעִי נָא</tei:l>
          <tei:l>שִׁמְעִי נָא</tei:l>
          <tei:l>קַבְּלִי נָא</tei:l>
          <tei:l>וְשׁוּבִי לְצִיּוֹן בְּרַחֲמִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:weekday_amidah_shaham/13"/>
        <tei:lg>
          <tei:l>תּוֹדָה</tei:l>
          <tei:l>שָׁלוֹם</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
