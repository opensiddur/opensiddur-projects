  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:odeh_el_shaddai">
        <tei:head>אוֹדֶה אֵל שַדַּי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:odeh_el_shaddai/1"/>
        <tei:lg>
          <tei:l>אוֹדֶה אֵל שַדַּי הִפְלִיא פְּלִיאָה</tei:l>
          <tei:l>יוֹם אֶל־פַּרְעֹה יָדוֹ הֶרְאָה</tei:l>
          <tei:l>אָשִֽׁירָה לַיְיָ כִּי גָאֹה גָּאָה</tei:l>
          <tei:l>סוּס וְרוֹכְבוֹ רָמָה בַיָּם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:odeh_el_shaddai/2"/>
        <tei:lg>
          <tei:l>מִי גוֹי גָּדוֹל אֲשֶׁר הָלַךְ לִפְנֵיהֶם</tei:l>
          <tei:l>אֱלֹהִים חַיִּים בְּכׇל־דַּרְכֵיהֶם</tei:l>
          <tei:l>עָנָן לַמָּסָךְ מָן בְּאֵר נָתַן לָהֵם</tei:l>
          <tei:l>עַל יַד מֹשֶׁה אַהֲרֹן וּמִרְיָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:odeh_el_shaddai/3"/>
        <tei:lg>
          <tei:l>חֲזַק יְשֻׁרוּן כִּי עֵת לְחֶנְנָהּ</tei:l>
          <tei:l>הָרִים וּגְבָעוֹת יִפְצְחוּ רִנָּה</tei:l>
          <tei:l>אֶֽבֶן יִשְׂרָאֵל תִּהְיֶה לְרֹאשׁ פִּנָּה</tei:l>
          <tei:l>גּוֹיֵי הָאֲרָצוֹת יִתְנַצְּלוּ עֶדְיָם׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
