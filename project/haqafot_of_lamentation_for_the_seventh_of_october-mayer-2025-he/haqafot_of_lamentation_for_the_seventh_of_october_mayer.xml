      <tei:div corresp="urn:x-opensiddur:text:poem:haqafot_of_lamentation_for_the_seventh_of_october_mayer">
        <tei:head>הקפות קינה לשביעי באוקטובר</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haqafot_of_lamentation_for_the_seventh_of_october_mayer/1"/>
        <tei:lg>
          <tei:l>אָנָּא יְהֹוָה</tei:l>
          <tei:l>אַיֵּה הַיְּשׁוּעָה</tei:l>
          <tei:l>אָנָּא יְהֹוָה</tei:l>
          <tei:l>אַיֵּה הַהַצְלָחָה</tei:l>
          <tei:l>אָנָּא יְהֹוָה</tei:l>
          <tei:l>הֲשִׁיבֵֽנוּ וְחַדֵּשׁ יָמֵֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haqafot_of_lamentation_for_the_seventh_of_october_mayer/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אָ</tei:seg>שִׂים עַל־רֹאשִׁי אֵֽפֶר</tei:l>
          <tei:l>אַיֵּה הַיְּשׁוּעָה</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>יוֹם שִׂמְחַת הַסֵּֽפֶר</tei:l>
          <tei:l>אַיֵּה הַהַצְלָחָה</tei:l>
          <tei:l><tei:seg type="acrostic">גְּ</tei:seg>רָר אֶת־בְּרִית אֲבוֹת הֵפֵר</tei:l>
          <tei:l>הֲשִׁיבֵֽנוּ וְחַדֵּשׁ יָמֵֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haqafot_of_lamentation_for_the_seventh_of_october_mayer/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">דָּ</tei:seg>ם נָקִי שָׁפְכוּ</tei:l>
          <tei:l>אַיֵּה הַיְּשׁוּעָה</tei:l>
          <tei:l><tei:seg type="acrostic">הַ</tei:seg>קִּבּוּצִים חָרְכוּ</tei:l>
          <tei:l>אַיֵּה הַהַצְלָחָה</tei:l>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>שׂוֹנְאֵֽנוּ לֹא שָׁכְכוּ</tei:l>
          <tei:l>הֲשִׁיבֵֽנוּ וְחַדֵּשׁ יָמֵֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haqafot_of_lamentation_for_the_seventh_of_october_mayer/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זִ</tei:seg>מְרַת נֽוֹבָה הֻשְׁתְּקָה</tei:l>
          <tei:l>אַיֵּה הַיְּשׁוּעָה</tei:l>
          <tei:l><tei:seg type="acrostic">חָ</tei:seg>מְסוּ וְנֶהֱנוּ בְּקוֹל צְעָקָה</tei:l>
          <tei:l>אַיֵּה הַהַצְלָחָה</tei:l>
          <tei:l><tei:seg type="acrostic">טְ</tei:seg>הוֹרִים הִתְחַבְּקוּ בְּחׇזְקָה</tei:l>
          <tei:l>הֲשִׁיבֵֽנוּ וְחַדֵּשׁ יָמֵֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haqafot_of_lamentation_for_the_seventh_of_october_mayer/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>בֵשׁ וְרֵיק הָיָה בְּאֵרִי</tei:l>
          <tei:l>אַיֵּה הַיְּשׁוּעָה</tei:l>
          <tei:l><tei:seg type="acrostic">כְּ</tei:seg>פַר עַזָּה שְׁבוּעַֽיִם מִכִּפּוּרִי</tei:l>
          <tei:l>אַיֵּה הַהַצְלָחָה</tei:l>
          <tei:l><tei:seg type="acrostic">לֹ</tei:seg>א הָיָה עֻזִּי בְּנַחֲלִי וּבְנִירִי</tei:l>
          <tei:l>הֲשִׁיבֵֽנוּ וְחַדֵּשׁ יָמֵֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haqafot_of_lamentation_for_the_seventh_of_october_mayer/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>בֵּיתָם שְׁבוּיִים חָפְנוּ</tei:l>
          <tei:l>אַיֵּה הַיְּשׁוּעָה</tei:l>
          <tei:l><tei:seg type="acrostic">נָ</tei:seg>שִׁים בְּצִיּוֹן עִנּוּ</tei:l>
          <tei:l>אַיֵּה הַהַצְלָחָה</tei:l>
          <tei:l><tei:seg type="acrostic">סַ</tei:seg>רְנֵי פְּלֶֽשֶׁת לֹא חָנְנוּ</tei:l>
          <tei:l>הֲשִׁיבֵֽנוּ וְחַדֵּשׁ יָמֵֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haqafot_of_lamentation_for_the_seventh_of_october_mayer/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">עַ</tei:seg>זָּה כַּמָּֽוֶת אַהֲבָה</tei:l>
          <tei:l>אַיֵּה הַיְּשׁוּעָה</tei:l>
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>רָחִים אַל־תִּצְמְחוּ בָּהּ</tei:l>
          <tei:l>אַיֵּה הַהַצְלָחָה</tei:l>
          <tei:l><tei:seg type="acrostic">צַ</tei:seg>דִּיקִים נֶעְדָּרִים מֵאׇהֳלִיבָה</tei:l>
          <tei:l>הֲשִׁיבֵֽנוּ וְחַדֵּשׁ יָמֵֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haqafot_of_lamentation_for_the_seventh_of_october_mayer/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קִ</tei:seg>לְּלֽוּנוּ הַנׇּכְרִים</tei:l>
          <tei:l>אַיֵּה הַיְּשׁוּעָה</tei:l>
          <tei:l><tei:seg type="acrostic">רָֽ</tei:seg>צוּ לִבְגֹּד־בָּֽנוּ חֲבֵרִים</tei:l>
          <tei:l>אַיֵּה הַהַצְלָחָה</tei:l>
          <tei:l><tei:seg type="acrostic">שָׁ</tei:seg>וְא לְבָרֵךְ בַּמְּאָרְרִים</tei:l>
          <tei:l>הֲשִׁיבֵֽנוּ וְחַדֵּשׁ יָמֵֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haqafot_of_lamentation_for_the_seventh_of_october_mayer/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">תָּ</tei:seg>שִׁיב לָאָֽרֶץ אֶת־כׇּל־יוֹשְׁבֶֽיהָ</tei:l>
          <tei:l>הוֹשִֽׁיעָה־נָא</tei:l>
          <tei:l><tei:seg type="acrostic">תַּ</tei:seg>חֲזִיר אֶת־בַּת־עַמִּי לְנָוֶֽהָ</tei:l>
          <tei:l>הִצְלִיחָה־נָא</tei:l>
          <tei:l><tei:seg type="acrostic">תִּ</tei:seg>נְקֹם נָקָם בְּכׇל־אוֹיְבֶֽיהָ</tei:l>
          <tei:l>עֲנֵֽנוּ בְּיוֹם צוֹם תַּעֲנִיתֵֽנוּ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
