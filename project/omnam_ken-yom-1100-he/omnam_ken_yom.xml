  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:omnam_ken_yom">
        <tei:head>אָמְנָם כֵּן</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:omnam_ken_yom/1"/>
        <tei:lg>
          <tei:l>יׄוֹׄםׄ יוֹם יִדְרוֹשׁוּן לָךְ׃</tei:l>
          <tei:l>טׄוֹׄבׄ לְמָעוֹז</tei:l>
          <tei:l>יְהִי עֹז מִלּוּלָךְ</tei:l>
          <tei:l>סָלַחְתִּי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:omnam_ken_yom/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אָ</tei:seg>מְנָם כֵּן</tei:l>
          <tei:l>יֶצֶר סוֹכֵן</tei:l>
          <tei:l>בָּנוּ ·</tei:l>
          <tei:l><tei:seg type="acrostic">בָּ</tei:seg>ךְ לְהַצְדֵּק</tei:l>
          <tei:l>רַב צֶדֶק</tei:l>
          <tei:l>וַעֲנֵנוּ</tei:l>
          <tei:l>סָלַחְתִּי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:omnam_ken_yom/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">גְּ</tei:seg>עַל מְרַגֵּל</tei:l>
          <tei:l>וְגַם פַּגֵּל</tei:l>
          <tei:l>סִפְּרוֹ ·</tei:l>
          <tei:l><tei:seg type="acrostic">דּ</tei:seg>וֹד שׁוֹאֵג בְּקוֹל</tei:l>
          <tei:l>יִתֵּן קוֹל</tei:l>
          <tei:l>דְּבָרוֹ</tei:l>
          <tei:l>סָלַחְתִּי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:omnam_ken_yom/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הַ</tei:seg>ס קַטֵּגוֹר</tei:l>
          <tei:l>וְקַח סַנֵּגוֹר</tei:l>
          <tei:l>מְקוֹמוֹ ·</tei:l>
          <tei:l><tei:seg type="acrostic">וִ</tei:seg>יהִי יְיָ לְמִשְׁעָן</tei:l>
          <tei:l>לוֹ לְמַעַן</tei:l>
          <tei:l>נָאֳמוֹ</tei:l>
          <tei:l>סָלַחְתִּי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:omnam_ken_yom/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זְ</tei:seg>כוּת אֶזְרַח</tei:l>
          <tei:l>גַּם יִפְרַח</tei:l>
          <tei:l>לְשׁוֹשַׁנָּה ·</tei:l>
          <tei:l><tei:seg type="acrostic">חֵ</tei:seg>טְא הַעֲבֵר</tei:l>
          <tei:l>וְקוֹל הַגְבֵּר</tei:l>
          <tei:l>מִמְּעוֹנָה</tei:l>
          <tei:l>סָלַחְתִּי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:omnam_ken_yom/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ט</tei:seg>וֹב וְסַלָּח</tei:l>
          <tei:l>מְחַל וּסְלַח</tei:l>
          <tei:l>אֲשֵׁמִים ·</tei:l>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>הּ הַקְשֵׁב</tei:l>
          <tei:l>וְגַם הָשֵׁב</tei:l>
          <tei:l>מִמְּרוֹמִים</tei:l>
          <tei:l>סָלַחְתִּי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:omnam_ken_yom/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כְּ</tei:seg>אֵב תַּחְבּשׁ</tei:l>
          <tei:l>וּבְצוּל תִּכְבּוֹשׁ</tei:l>
          <tei:l>עֲוֹנִי ·</tei:l>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>ךָ תְהִלָּה</tei:l>
          <tei:l>אֱמֹר מִלָּה</tei:l>
          <tei:l>לְמַעֲנִי</tei:l>
          <tei:l>סָלַחְתִּי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:omnam_ken_yom/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מְ</tei:seg>חֵה פֶשַׁע</tei:l>
          <tei:l>וְגַם רֶשַׁע</tei:l>
          <tei:l>בְּנֵי בְרִית ·</tei:l>
          <tei:l><tei:seg type="acrostic">נְ</tei:seg>הַג חַסְדֶּךָ</tei:l>
          <tei:l>כֵּן הוֹדֶךָ</tei:l>
          <tei:l>לִשְׁאֵרִית</tei:l>
          <tei:l>סָלַחְתִּי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:omnam_ken_yom/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">סְ</tei:seg>כוֹת רַחֲשִׁי</tei:l>
          <tei:l>וְגַם לַחֲשִׁי</tei:l>
          <tei:l>תִּרְצֶה ·</tei:l>
          <tei:l><tei:seg type="acrostic">עָ</tei:seg>וֹן נוֹשֵׂא</tei:l>
          <tei:l>לְמַעַנְךָ עֲשֵׂה</tei:l>
          <tei:l>וְתִפְצֶה</tei:l>
          <tei:l>סָלַחְתִּי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:omnam_ken_yom/10"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>נֵה לְעֶלְבּוֹן</tei:l>
          <tei:l>מְקוֹם עָוֹן</tei:l>
          <tei:l>לְהָשִׂים ·</tei:l>
          <tei:l><tei:seg type="acrostic">צַ</tei:seg>חַן הָסֵר</tei:l>
          <tei:l>וְגַם תְּבַשֵּׂר</tei:l>
          <tei:l>לְבָךְ חוֹסִים</tei:l>
          <tei:l>סָלַחְתִּי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:omnam_ken_yom/11"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ק</tei:seg>וֹלִי שְׁמַע</tei:l>
          <tei:l>וּרְאֵה דֶּמַע</tei:l>
          <tei:l>עֵינִי ·</tei:l>
          <tei:l><tei:seg type="acrostic">רִ</tei:seg>יב רִיבִי</tei:l>
          <tei:l>שְׁעֵה נִיבִי</tei:l>
          <tei:l>וַהֲשִׁיבֵנִי</tei:l>
          <tei:l>סָלַחְתִּי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:omnam_ken_yom/12"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שֶׁ</tei:seg>מֶץ טַהֵר</tei:l>
          <tei:l>כְּעָב מַהֵר</tei:l>
          <tei:l>כְּנֶאֱמַר ·</tei:l>
          <tei:l><tei:seg type="acrostic">תִּ</tei:seg>מְחֶה פֶשַׁע</tei:l>
          <tei:l>לְעַם נושַׁע</tei:l>
          <tei:l>וְתֹאמַר</tei:l>
          <tei:l>סָלַחְתִּי׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
