    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:aryeh_shaag">
        <tei:head>אַרְיֵה שָׁאַג</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aryeh_shaag/1"/>
        <tei:lg>
          <tei:l>אַרְיֵה שָׁאַג וְעָלָה בְאַפּוֹ</tei:l>
          <tei:l>וְעָשָׂה רְצוֹנוֹ בְּאַף הֵעִיר קִצְפּוֹ</tei:l>
          <tei:l>וְרָמַס וְטָרַף בְּרַגְלוֹ וְכַפּוֹ</tei:l>
          <tei:l>זְקֵנִים וּנְעָרִים בְּתוֹךְ הֵיכָל וְאוּלָם׃</tei:l>
          <tei:l>בָּרוּךְ שֶׁאָמַר וְהָיָה הָעוֹלָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aryeh_shaag/2"/>
        <tei:lg>
          <tei:l>רֹאשִׁי יָשַׁב בֵּין תַּנּוּר וְכִירַֽיִם</tei:l>
          <tei:l>וְעֵינִי נִתַּךְ דִּמְעָתָהּ כַּמַּֽיִם</tei:l>
          <tei:l>עַל־הֲרוּגִים וּשְׁבוּיִם וְיוֹנְקִי שָׁדַֽיִם</tei:l>
          <tei:l>מְאֹד אֶשְׁתּוֹמֵם מְאֹד אֲנִי נִכְלָם׃</tei:l>
          <tei:l>בָּרוּךְ...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aryeh_shaag/3"/>
        <tei:lg>
          <tei:l>הַצֹּאן נְפוּצִים וְרוֹעֶה אֵין לָהֶם</tei:l>
          <tei:l>וְהָלְכוּ בְּכׇל־פִּנָּה וְנֻתְּצוּ מֵרִבְצֵיהֶן</tei:l>
          <tei:l>וּפָֽגְעוּ־בָם אֲרָיוֹת וְטָרְפוּ עוֹלְלֵיהֶן</tei:l>
          <tei:l>אַיֵּה אֵיפֹה רוֹעִי מִמֶּֽנִּי נֶעְלָם׃</tei:l>
          <tei:l>בָּרוּךְ...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aryeh_shaag/4"/>
        <tei:lg>
          <tei:l>בְּתוּלוֹת עֲגוּנוֹת אַלְמָנוֹת וְתַנּוֹת</tei:l>
          <tei:l>וְאִמּוֹת שְׁכוּלוֹת מִבָּנִים וּבָנוֹת</tei:l>
          <tei:l>וְעָֽשׂוּ אֵֽבֶל וְקִינִים וְקִינוֹת</tei:l>
          <tei:l>וְנָשְׂאוּ לִבָּם וְעֵינָם לְאֵל עוֹלָם׃</tei:l>
          <tei:l>בָּרוּךְ...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:aryeh_shaag/5"/>
        <tei:lg>
          <tei:l>אֶעֱמֹד עַל־מִשְׁמָר כִּי נִלְכְּדָה רַגְלִי</tei:l>
          <tei:l>וְשַׁדַּי לִי הֵמַר וַעֲזָבַֽנִי כֹּחִי</tei:l>
          <tei:l>וּלִּבִּי חֳמַרְמַר וְאָפְסוּ יְמֵי חֶלְדִּי</tei:l>
          <tei:l>בְּעִנְיָן רַע וָמָר אָמְרָה לְאֻמִּי</tei:l>
          <tei:l>כִּי צוּר שְׁכֵחַֽנִי אֱלֹהֵי עוֹלָם׃</tei:l>
          <tei:l>בָּרוּךְ...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
