  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:announcement_of_the_count_of_years_since_the_destruction_tsalach">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:announcement_of_the_count_of_years_since_the_destruction_tsalach/1"/>
        <tei:lg>
          <tei:l>כִּי בַּעֲוֹנֹתֵֽינוּ וּבַעֲווֹנוֹת אֲבוֹתֵֽינוּ</tei:l>
          <tei:l>אָנוּ מוֹנִים לְחׇרְבָּן בֵּית־אֱלֹהֵֽינוּ</tei:l>
          <tei:l>וּלְפִזּוּר עַם־יְהוָה אֵֽלֶּה מֵעַל אַדְמַת קׇדְשֵֽׁנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:announcement_of_the_count_of_years_since_the_destruction_tsalach/2"/>
        <tei:lg>
          <tei:l>הַיּוֹם לְחׇרְבָּן בַּֽיִת שֵׁנִי</tei:l>
          <tei:l>אֲשֶׁר בָּנָה עֶזְרָא אֲדוֹנֵֽנוּ</tei:l>
          <tei:l>אֶֽלֶף וְתִּשְׁעָה מֵאוֹת וַחֲמִשִּׁים וְוְשָׁלוֹשׁ</tei:l>
          <tei:l>שְׁנֵי יְגוֹנוֹתֵֽינוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:announcement_of_the_count_of_years_since_the_destruction_tsalach/3"/>
        <tei:lg>
          <tei:l>וּלְחׇרְבָּן בַּיִת רִאשׁוֹן</tei:l>
          <tei:l>וּלְפִזּוּר אַנְשֵׁי גָּלוּתֵֽנוּ</tei:l>
          <tei:l>אֲנַֽחְנוּ הַגּוֹלִים פֹּה בַּאֲרָצוֹת מוֹנֵֽינוּ</tei:l>
          <tei:l>הַיּוֹם אַלְפַּֽיִם וְאַרְבַּע מֵאוֹת וְאַרְבָּעִים וְאַרְבַּע</tei:l>
          <tei:l>שָׁנִים עַל רֹב עֲוֹנֹתֵֽינוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:announcement_of_the_count_of_years_since_the_destruction_tsalach/4"/>
        <tei:lg>
          <tei:l>עַל זֹאת נִשְׁכְּבָ֣ה בְּבׇשְׁתֵּ֗נוּ וּֽתְכַסֵּ֘נוּ֮ כְּלִמָּתֵ֒נוּ֒</tei:l>
          <tei:l>וְלֹא נִשְׁכַּח מִקְדָּשׁ תִּפְאַרְתֵּֽנוּ אִם־תִּשְׁכַּח יְמִינֵֽנוּ <tei:bibl>(ירמיה ג:כה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:announcement_of_the_count_of_years_since_the_destruction_tsalach/5"/>
        <tei:lg>
          <tei:l>לְזֹאת נִבְכָּה וּנְקוֹנֵן כׇּל־יְמֵי שְׁנוֹתֵֽינוּ</tei:l>
          <tei:l>וְלֹא נִקַּח נֶחָמָה עַד יִבָּנֶה בֵּית זְבוּלֵֽנוּ</tei:l>
          <tei:l>וְאֶל־גְּבוּל אַרְצֵֽנוּ יַחֲזִירֶֽנּוּ</tei:l>
          <tei:l>שׁוּבָ֣ה יְ֭הֹוָה אֶת־שְׁבִיתֵ֑נוּ <tei:bibl>(תהלים קכו:ד)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
