      <tei:div corresp="urn:x-opensiddur:text:poem:attah_adonai_magen_baadi_sawat">
        <tei:head>אַתָּה ה׳, מָגֵן בַּעֲדִי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_adonai_magen_baadi_sawat/1"/>
        <tei:lg>
          <tei:l>אַתָּה ה׳, מָגֵן בַּעֲדִי</tei:l>
          <tei:l>תֹּאחַז יְמִינְךָ לְסַעֲדִי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_adonai_magen_baadi_sawat/2"/>
        <tei:lg>
          <tei:l>אֶשְׁאַל, אֱלֹהַי, מִמְּךָ דְרוֹר</tei:l>
          <tei:l>לָצֵאת לְחׇפְשִׁי מֵעֳנִי וּבוֹר,</tei:l>
          <tei:l>תָּשִׂים לְפָנַי מַחֲשָׁךְ לְאוֹר</tei:l>
          <tei:l>וּבְדַרְכְּךָ, יָהּ, תָּכִין צַעֲדִי,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_adonai_magen_baadi_sawat/3"/>
        <tei:lg>
          <tei:l>נָא חִישׁ וְשַׁנֵּס עֹז קִנְאָתְךָ,</tei:l>
          <tei:l>וּלְבַשׁ כְּשִׁרְיוֹן הוֹד צִדְקָתְךָ</tei:l>
          <tei:l>כּֽוֹבַע יְשׁוּעָה שִׂים בְּרֹאשְׁךָ,</tei:l>
          <tei:l>וּגְאַל עֲדָתִי מִיַּד שׁוֹדְדִי!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_adonai_magen_baadi_sawat/4"/>
        <tei:lg>
          <tei:l>יָהּ, תֵּן מְהֵרָה יָד בְּאוֹיְבִי,</tei:l>
          <tei:l>הוֹצֵא הֲמוֹנַי מִכְּלוּא שְׁבִי!</tei:l>
          <tei:l>יַעְלוּ לְאֶֽרֶץ נַחֲלַת צְבִי,</tei:l>
          <tei:l>אָז יִרְבְּצוּ שָׁם נָמֵר עִם גְּדִי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_adonai_magen_baadi_sawat/5"/>
        <tei:lg>
          <tei:l>פָּנִים בְּפָנִים יִרְאוּ הוֹדְךָ</tei:l>
          <tei:l>חוֹפֵף עֲלֵיהֶם תּוֹךְ מְעוֹנְךָ,</tei:l>
          <tei:l>תַּשְׁקֵם כְּמֵאָז נַֽחַל עֶדְנְךָ,</tei:l>
          <tei:l>יִרְאֶה וְיֵבוֹשׁ צָר וּבוֹגְדִי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_adonai_magen_baadi_sawat/6"/>
        <tei:lg>
          <tei:l>רָצוֹן כְּצִנָּה חִישׁ לְעַטְּרִי,</tei:l>
          <tei:l>שָׁלוֹם יַעֲשֶׂה לִי גַם לְעוֹזְרִי,</tei:l>
          <tei:l>יִפְרַח כְּבוֹדִי יַעֲשֶׂה פְרִי,</tei:l>
          <tei:l>אָז יִהְיֶה צַר רָץ לְכַבְּדִי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_adonai_magen_baadi_sawat/7"/>
        <tei:lg>
          <tei:l>גִּילָה אֲעוֹרֵר יוֹם, לְבֵיתְךָ</tei:l>
          <tei:l>תָּשִׁיב שְׁבוּת אֶת־עַם עֲדָתְךָ</tei:l>
          <tei:l>לַחֲזוֹת בְּנֹֽעַם זִיו כְּבוֹדְךָ,</tei:l>
          <tei:l>שָׁם יְהוֹדְךָ צוּר מְעוֹדְדִי,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_adonai_magen_baadi_sawat/8"/>
        <tei:lg>
          <tei:l>יָחִיד, חֲרוֹנְךָ עַל אֱדֹם שְׁפֹךְ,</tei:l>
          <tei:l>וַעְרָב כְּשַׁבְּלוּל תֶּֽמֶס יַהֲלֹךְ,</tei:l>
          <tei:l>וּלְיוֹדְעֶֽיךָ—חַסְדְּךָ מְשֹׁךְ,</tei:l>
          <tei:l>יֵלְכוּ גְאוּלִים לְבֵית מוֹעֲדִי!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_adonai_magen_baadi_sawat/9"/>
        <tei:lg>
          <tei:l>חָזָק, עֲנֵנִי מִזְּבוּלְךָ</tei:l>
          <tei:l>שִׁירִי תְּמוּר שַׁי קַח בְּחַסְדְּךָ</tei:l>
          <tei:l>חַדֵּשׁ בְּקִרְבִּי רֽוּחַ קׇדְשְׁךָ</tei:l>
          <tei:l>תִּשְׁכֹּן סְבִיבִי, צוּר מְלַמְּדִי!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
