  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:acheinu">
        <tei:head>אַחֵֽינוּ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:acheinu/1"/>
        <tei:lg>
          <tei:l>אַחֵֽינוּ</tei:l>
          <tei:l>כׇּל־בֵּית־יִשְׂרָאֵל</tei:l>
          <tei:l>הַנְּתוּנִים בְּצָּרָה וּבְשִּׁבְיָה</tei:l>
          <tei:l>הָעוֹמְדִים בֵּין בַּיָּם וּבֵין בַּיַּבָּשָׁה</tei:l>
          <tei:l>הַמָּקוֹם יְרַחֵם עֲלֵיהֶם</tei:l>
          <tei:l>וְיוֹצִיאֵם מִצָּרָה לִרְוָחָה</tei:l>
          <tei:l>וּמֵאֲפֵלָה לְאוֹרָה</tei:l>
          <tei:l>וּמִשִּׁעְבּוּד לִגְאֻלָּה</tei:l>
          <tei:l>הָשְׁתָּא בַּעֲגָלָא וּבִזְמַן קָרִיב</tei:l>
          <tei:l><tei:note type="instruction">וְנֹאמַר</tei:note> אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
