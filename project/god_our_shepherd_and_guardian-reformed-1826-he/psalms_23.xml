  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/23">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/23/1/a"/>
        <tei:lg>
          <tei:l>מִזְמ֥וֹר לְדָוִ֑ד</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>יְהֹוָ֥ה רֹ֝עִ֗י לֹ֣א אֶחְסָֽר׃</tei:l>
          <tei:l>בִּנְא֣וֹת דֶּ֭שֶׁא</tei:l>
          <tei:l>יַרְבִּיצֵ֑נִי</tei:l>
          <tei:l>עַל־מֵ֖י מְנֻח֣וֹת יְנַהֲלֵֽנִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/23/3/a"/>
        <tei:lg>
          <tei:l>נַפְשִׁ֥י יְשׁוֹבֵ֑ב</tei:l>
          <tei:l>יַֽנְחֵ֥נִי</tei:l>
          <tei:l>בְמַעְגְּלֵי־צֶ֝֗דֶק</tei:l>
          <tei:l>לְמַ֣עַן שְׁמֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/23/4/a"/>
        <tei:lg>
          <tei:l>גַּ֤ם כִּֽי־אֵלֵ֨ךְ בְּגֵ֪יא צַלְמָ֡וֶת</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>לֹא־אִ֘ירָ֤א רָ֗ע כִּי־אַתָּ֥ה עִמָּדִ֑י</tei:l>
          <tei:l>שִׁבְטְךָ֥ וּ֝מִשְׁעַנְתֶּ֗ךָ הֵ֣מָּה יְנַֽחֲמֻֽנִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/23/5/a"/>
        <tei:lg>
          <tei:l>תַּעֲרֹ֬ךְ לְפָנַ֨י ׀ שֻׁלְחָ֗ן נֶ֥גֶד צֹרְרָ֑י</tei:l>
          <tei:l>דִּשַּׁ֥נְתָּ בַשֶּׁ֥מֶן רֹ֝אשִׁ֗י כּוֹסִ֥י רְוָיָֽה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/23/6/a"/>
        <tei:lg>
          <tei:l>אַ֤ךְ ׀ ט֤וֹב וָחֶ֣סֶד יִ֭רְדְּפוּנִי כׇּל־יְמֵ֣י חַיָּ֑י</tei:l>
          <tei:l>וְשַׁבְתִּ֥י בְּבֵית־יְ֝הֹוָ֗ה לְאֹ֣רֶךְ יָמִֽים׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
