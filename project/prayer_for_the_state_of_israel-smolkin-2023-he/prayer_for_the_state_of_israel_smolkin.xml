      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_the_state_of_israel_smolkin">
        <tei:head>תְּפִלָּה לִמְדִינַת יִשְׂרָאֵל</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_state_of_israel_smolkin/1"/>
        <tei:lg>
          <tei:l>אָבִינוּ שֶׁבַּשָּׁמַיִם,</tei:l>
          <tei:l>צוּר יִשְׂרָאֵל וְגוֹאֲלוֹ.</tei:l>
          <tei:l>הָאָב הָרַחֲמָן,</tei:l>
          <tei:l>יִכָּמְרוּ רַחֲמֶיךָ</tei:l>
          <tei:l>כִּי כְּאֵבֵנוּ נוֹרָא וְאָיֹם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_state_of_israel_smolkin/2"/>
        <tei:lg>
          <tei:l>ה׳</tei:l>
          <tei:l>עוֹז תִּתֵּן לְעַמֶּךָ,</tei:l>
          <tei:l>תְּחַזֵּק אֶת נַפְשֵׁנוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_state_of_israel_smolkin/3"/>
        <tei:lg>
          <tei:l>הַמְנַחֵם,</tei:l>
          <tei:l>תְּנַחֲמֶנּוּ מִן הַשָּׁמַיִם.</tei:l>
          <tei:l>תַּנְחֵם אֶת מְדִינַת יִשְׂרָאֵל.</tei:l>
          <tei:l>תַּנְחֵם אֶת כָּל הַמִּשְׁפָּחוֹת הַשְׁכּוּלוֹת</tei:l>
          <tei:l>בְּתוֹךְ שְׁאָר אֲבֵלֵי צִיּוֹן וִירוּשָׁלַיִם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_state_of_israel_smolkin/4"/>
        <tei:lg>
          <tei:l>אֲנָא ה׳,</tei:l>
          <tei:l>עוֹזְרֵנוּ</tei:l>
          <tei:l>כִּי אָנוּ זְקוּקִים לְעֶזְרֶֽךָ,</tei:l>
          <tei:l>לִקְרֹא לִשְׁבוּיִם דְּרוֹר</tei:l>
          <tei:l>וְלַאֲסוּרִים פְּקַח־קוֹחַ.</tei:l>
          <tei:l>תֵּן חִזּוּק לְמִשְׁפְּחוֹתֵיהֶם.</tei:l>
          <tei:l>תֵּן לָהֶם הַכּוֹחַ לְהִתְגַּבֵּר.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_state_of_israel_smolkin/5"/>
        <tei:lg>
          <tei:l>הָרֹפֵא לִשְׁבוּרֵי לֵב וּמְחַבֵּשׁ לְעַצְּבוֹתָם,</tei:l>
          <tei:l>יִמָּלְאוּ רָחֲמֵיךְ</tei:l>
          <tei:l>לְהַחֲזִיק וּלְרַפֵּא אֶת עַמֵּנוּ.</tei:l>
          <tei:l>שְׁלַח רְפוּאָה שְׁלֵמָה מִן הַשָּׁמַיִם,</tei:l>
          <tei:l>רְפוּאַת הַנֶּפֶשׁ</tei:l>
          <tei:l>וּרְפוּאַת הַגּוּף.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_state_of_israel_smolkin/6"/>
        <tei:lg>
          <tei:l>הַנּוֹתֵן לָאָדָם בִּינָה,</tei:l>
          <tei:l>תֵּן חָכְמָה לְרָאשֵׁי מְדִינַת יִשְׂרָאֵל.</tei:l>
          <tei:l>תֵּן לָהֶם לֵב חָכָם וְנָבוֹן</tei:l>
          <tei:l>לִשְׁמֹר עַל עַמְּךָ יִשְׂרָאֵל.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_state_of_israel_smolkin/7"/>
        <tei:lg>
          <tei:l>מָגֵן אַבְרָהָם,</tei:l>
          <tei:l>הַגָּן עַל כָּל אֵלֶּה שֶׁמְּגִנִּים עַל אַרְצֵנוּ.</tei:l>
          <tei:l>הָגֵן עַל אֵלֶּה שֶׁמְּשָׁרְתִים אֶת מְדִינַת יִשְׂרָאֵל,</tei:l>
          <tei:l>בֵּין בְּתַפְקִידֵי לְחִימָה</tei:l>
          <tei:l>וּבֵין בְּתַפְקִידִים אֲחֵרִים,</tei:l>
          <tei:l>בֵּין אִם בַּאֲוִיר, בַּיַּבָּשָׁה אוֹ בַיָּם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_state_of_israel_smolkin/8"/>
        <tei:lg>
          <tei:l>קוּמָה ה׳</tei:l>
          <tei:l>וְיָפֻצוּ אֹיְבֶיךָ,</tei:l>
          <tei:l>וְיָנוּסוּ מְשַׂנְאֶיךָ מִפָּנֶיךָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_state_of_israel_smolkin/9"/>
        <tei:lg>
          <tei:l>גֹּדֵר פֶּרֶץ,</tei:l>
          <tei:l>תִּבְנֶה חוֹמוֹת יְרוּשָׁלָֽיִם,</tei:l>
          <tei:l>כִּי בְךָ לְבַד בָּטָֽחְנוּ.</tei:l>
          <tei:l>וְאָמְרוּ “הָאָרֶץ הַלֵּזוּ הַנְּשַׁמָּה הָיְתָה כְּגַן־עֵדֶן,</tei:l>
          <tei:l>וְהֶעָרִים הֶחֳרֵבוֹת וְהַנְשַׁמּוֹת וְהַנֶּהֱרָסוֹת בְּצוּרוֹת יָשָׁבוּ.”</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_state_of_israel_smolkin/10"/>
        <tei:lg>
          <tei:l>וּפְרֹס עַל יִשְׂרָאֵל סֻכַּת שְׁלוֹמֶךָ.</tei:l>
          <tei:l>וְתֵן שָׁלוֹם בָּאָרֶץ</tei:l>
          <tei:l>וְשִׂמְחַת עוֹלָם לְיוֹשְׁבֶיהָ.</tei:l>
          <tei:l>וְנֹאמַר: אָמֵן.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
