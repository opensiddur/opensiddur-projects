  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:banu_choshekh_lqadesh">
        <tei:head>בָּאנוּ חׇשֵׁךְ לְקַדֵּשׁ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:banu_choshekh_lqadesh/1"/>
        <tei:lg xml:lang="en">
          <tei:l>Alternative lyrics by Rabbi David Seidenberg (neohasid.org 2018-2021)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:banu_choshekh_lqadesh/2"/>
        <tei:lg>
          <tei:l>בָּאנוּ חׇשֵׁךְ לְקַדֵּשׁ</tei:l>
          <tei:l>קוֹדֶם שֶׁמֶשׁ תִּתְחַדֵּשׁ</tei:l>
          <tei:l>בְּיָדֵינוּ אוֹר וְנֵר</tei:l>
          <tei:l>לֵיל כַּשַּׂלְמָה לְפָאֵר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:banu_choshekh_lqadesh/3"/>
        <tei:lg>
          <tei:l>נִשְׁתֳּלֶנּוּ גַּרְעִין אֵשׁ</tei:l>
          <tei:l>בַּד הַחוֹשֶׁךְ מְלַפֵּף</tei:l>
          <tei:l>גַּרְעִינִים שֶׁל אֵשׁ וָאוֹר</tei:l>
          <tei:l>בּוֹהֲקִים מִתּוֹךְ הַשְׁחוֹר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:banu_choshekh_lqadesh/4"/>
        <tei:lg>
          <tei:l>גַּרְעִינִים שֶׁל אֵשׁ וָאוֹר</tei:l>
          <tei:l>בּוֹהֲקִים מִתּוֹךְ הַשְׁחוֹר</tei:l>
          <tei:l>קוּמָה חוֹשֶׁךְ עֲלֵה שְחוֹר</tei:l>
          <tei:l>קוּמָה לִקְרַאת הָאוֹר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:banu_choshekh_lqadesh/5"/>
        <tei:lg xml:lang="en">
          <tei:l>Alternative lyrics (lightly amended), ver. 1.0, by Rabbi Jill Hammer &amp; David Seidenberg (neohasid.org)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:banu_choshekh_lqadesh/6"/>
        <tei:lg>
          <tei:l>בָּאנוּ חוֹשֶׁךְ לְקַדֵּשׁ</tei:l>
          <tei:l>בְּיָדֵינוּ אוֹר וָאֵשׁ</tei:l>
          <tei:l>כָּל אֶחָד הוּא אוֹר קָטָן</tei:l>
          <tei:l>וְכֻלָנוּ אוֹר אֵיתָן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:banu_choshekh_lqadesh/7"/>
        <tei:lg>
          <tei:l>קוּמָה חוֹשֶׁךְ</tei:l>
          <tei:l>עֲלֵה שְחוֹר</tei:l>
          <tei:l>קוּמָה לִקְרַאת הָאוֹר</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
