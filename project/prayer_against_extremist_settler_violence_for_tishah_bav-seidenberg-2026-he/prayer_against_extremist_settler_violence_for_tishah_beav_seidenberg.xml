  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_against_extremist_settler_violence_for_tishah_beav_seidenberg">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_against_extremist_settler_violence_for_tishah_beav_seidenberg/1"/>
        <tei:lg>
          <tei:l>דַּם עַמֵּי הָאָרֶץ</tei:l>
          <tei:l>נִשְׁפָּךְ עַל הָאֲדָמָה</tei:l>
          <tei:l>שֶׁחַיֵּיהֶם תְּלוּיִים בָּהּ,</tei:l>
          <tei:l>וְגַם תִּקְוָתָם נִרְדֶּפֶת</tei:l>
          <tei:l>וְכִמְעַט מְגֹרֶשֶׁת.</tei:l>
          <tei:l>נִגְנְבוּ צֹאנָם</tei:l>
          <tei:l>וְנִשְׂרְפוּ בָּתֵּיהֶם,</tei:l>
          <tei:l>בְּאוּם אֶל־חַיְיר, בְּמוּכְנָאס,</tei:l>
          <tei:l>בְּמַסָּאפֶר יַאטָה וְכוּלֵּי,</tei:l>
          <tei:l>כְּדֵי שֶׁיְגֹרְשׁוּ תּוֹשָׁבִים לֹא־יְהוּדִי</tei:l>
          <tei:l>מִן הַשֶּׁטַח וּמֵאַדְמָתָם.</tei:l>
          <tei:l>וְכָל הָאָסוֹן הַזֶּה</tei:l>
          <tei:l>נַעֲשָׂה עַל־יְדֵי יִשְׂרְאֵלִים יְהוּדִים</tei:l>
          <tei:l>הַמַּגְבִּיהִים עֹצְמָה וְגַאֲוָה מֵעַל זְכֻיּוֹת הָאָדָם</tei:l>
          <tei:l>וּמְעוֹרְרִים שִׂנְאָה כְּלַפֵּי בְּנֵי אָדָם</tei:l>
          <tei:l>שֶׁאֵינָם יְהוּדִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_against_extremist_settler_violence_for_tishah_beav_seidenberg/2"/>
        <tei:lg>
          <tei:l>וְאִם הָאָרֶץ הִיא אַדְמַת קֹדֶשׁ,</tei:l>
          <tei:l>אוֹי לְמִי שֶׁהוֹפֵךְ אוֹתָהּ לְאֶרֶץ</tei:l>
          <tei:l>זָבַת דְּמֵי הַבְּרִיּוֹת,</tei:l>
          <tei:l>לְהָזְמִין ”שֶׁבֶר גָּדוֹל מֵהַגְּבָעוֹת“ <tei:note type="instruction">(צפניה א:י)</tei:note>,</tei:l>
          <tei:l>כִּי אָמְרָה הַתּוֹרָה לַכֹּל,</tei:l>
          <tei:l>”לֹא תַחֲנִיפוּ אֶת הָאָרֶץ אֲשֶׁר אַתֶּם בָּהּ,</tei:l>
          <tei:l>כִּי הַדָּם הוּא יַחֲנִיף אֶת הָאָרֶץ“ <tei:note type="instruction">(במדבר לה:לג)</tei:note>,</tei:l>
          <tei:l>וְגַם נֶאֱמַר</tei:l>
          <tei:l>”כִּי לֹא לְפָנָיו חָנֵף יָבוֹא“ <tei:note type="instruction">(איוב יג:טז)</tei:note></tei:l>
          <tei:l>וְ”תִּקְוַת חָנֵף תֹּאבֵד“ <tei:note type="instruction">(איוב ח:יג)</tei:note>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_against_extremist_settler_violence_for_tishah_beav_seidenberg/3"/>
        <tei:lg>
          <tei:l>וְאִי אֶפְשָׁר לוֹמַר</tei:l>
          <tei:l>”יָדֵינוּ לֹא שָׁפְכוּ אֶת הַדָּם הַזֶּה,</tei:l>
          <tei:l>וְעֵינֵינוּ לֹא רָאוּ“ <tei:note type="instruction">(דברים כא:ז)</tei:note>,</tei:l>
          <tei:l>כִּי רָאִינוּ כָּל יוֹם וָיוֹם</tei:l>
          <tei:l>בְּכָל מָסָךְ שֶׁהֻנַּח בְּיָדֵינוּ.</tei:l>
          <tei:l>וְכִי אִם לֹא שָׁפְכוּ יָדֵינוּ אֶת הַדָּם הַזֶּה,</tei:l>
          <tei:l>רַגְלֵינוּ עוֹמְדוֹת עָלָיו, נִרְטָבוֹת מִמֶּנּוּ.</tei:l>
          <tei:l>וְאִם לֹא רָאִינוּ,</tei:l>
          <tei:l>הַחֵטְא הוּא שֶׁלָּנוּ</tei:l>
          <tei:l>כִּי הֶעֱלַמְנוּ אֶת עֵינֵינוּ</tei:l>
          <tei:l>וְהִתְעַלַּמְנוּ מִצֶּלֶם אֱלֹהִים שֶׁבָּאָדָם.</tei:l>
          <tei:l>אָכֵן אָמַר הַנָּבִיא,</tei:l>
          <tei:l>אִם ”לֹא דִבַּרְתָּ לְהַזְהִיר רָשָׁע מִדַּרְכּוֹ“,</tei:l>
          <tei:l>אָז ”רָשָׁע בַּעֲוֹנוֹ יָמוּת</tei:l>
          <tei:l>וְדָמוֹ מִיָּדְךָ אֲבַקֵּשׁ“ <tei:note type="instruction">(יחזקאל לג:ח)</tei:note>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_against_extremist_settler_violence_for_tishah_beav_seidenberg/4"/>
        <tei:lg>
          <tei:l>לְנֹכַח כָּל זֹאת,</tei:l>
          <tei:l>אֵיכָה נַעֲמֹד דּוּמָמִים בְּיוֹם אֲבֵלוּתֵינוּ וּבְיוֹם תַּעֲנִיתֵינוּ,</tei:l>
          <tei:l>וְאֵיכָה לֹא נִזְעַק לַעֲצֹר עָווֹן גָּדוֹל כָּזֶה,</tei:l>
          <tei:l>שֶׁנָּפַל גַּם עַל שִׁכְמֵינוּ</tei:l>
          <tei:l>וְגַם עַל הָאָרֶץ שֶׁהִיא קְדוֹשָׁה לָנוּ,</tei:l>
          <tei:l>הָאָרֶץ שֶׁנּוֹעַדְנוּ לָשֶׁבֶת בָּהּ</tei:l>
          <tei:l>יַחַד עִם הַפַּלֶּסְטִינִים</tei:l>
          <tei:l>עַל־פִּי רְצוֹן הַמָּקוֹם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_against_extremist_settler_violence_for_tishah_beav_seidenberg/5"/>
        <tei:lg>
          <tei:l>וְאָנוּ זוֹכְרִים הַיּוֹם בְּפַחַד</tei:l>
          <tei:l>מַה שֶּׁאָמְרָה תּוֹרָה:</tei:l>
          <tei:l>”וְלָאָרֶץ לֹא יְכֻפַּר לַדָּם</tei:l>
          <tei:l>אֲשֶׁר שֻׁפַּךְ בָּהּ,</tei:l>
          <tei:l>כִּי אִם בְּדַם שֹׁפְכוֹ“ <tei:note type="instruction">(במדבר לה:לג)</tei:note>,</tei:l>
          <tei:l>רַחֲמָנָא לִיצְלַן.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_against_extremist_settler_violence_for_tishah_beav_seidenberg/6"/>
        <tei:lg>
          <tei:l>אָז עָלֵינוּ לָשֵׂאת אֶת קוֹלֵנוּ</tei:l>
          <tei:l>לִדְרֹשׁ מִשְׁפָּט לַגֵּר וְלָאֶבְיוֹן,</tei:l>
          <tei:l>כְּדֵי שֶׁ”יִּשְׂאוּ הָרִים שָׁלוֹם לָעָם</tei:l>
          <tei:l>וּגְבָעוֹת בִּצְדָקָה“ <tei:note type="instruction">(תהלים עב:ג)</tei:note>,</tei:l>
          <tei:l>שֶׁנֶּאֱמַר, ”צִיּוֹן בְּמִשְׁפָּט</tei:l>
          <tei:l>תִּפָּדֶה וְשָׁבֶיהָ בִּצְדָקָה“ <tei:note type="instruction">(ישעיה א:כז)</tei:note>.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
