<tei:div corresp="urn:x-opensiddur:text:siddur:brit_milah"><tei:head>BRITH MILAH</tei:head><tei:note type="instruction" xml:lang="en">When the child is brought for circumcision, the guests rise and say:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:siddur:lifecycle/text/milah_welcome"/><tei:note type="instruction" xml:lang="en">The father of the child:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:siddur:lifecycle/text/milah_ready"/><tei:note type="instruction" xml:lang="en">The Mohel, placing the child upon the sandek’s knees:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:siddur:lifecycle/text/milah_elijah"/><j:transclude type="external" target="urn:x-opensiddur:text:siddur:lifecycle/text/milah_verses"/><tei:note type="instruction" xml:lang="en">All:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:siddur:lifecycle/text/milah_all"/><tei:note type="instruction" xml:lang="en">The Mohel, before operating:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:al_hamilah"/><tei:note type="instruction" xml:lang="en">The father, after the circumcision:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:lehachniso_bivrito"/><tei:note type="instruction" xml:lang="en">All:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:siddur:lifecycle/text/milah_response"/><tei:note type="instruction" xml:lang="en">The Mohel:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:borei_pri_hagafen"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:asher_kiddesh_yedid"/><j:transclude type="external" target="urn:x-opensiddur:text:siddur:lifecycle/text/milah_name"/><j:transclude type="external" target="urn:x-opensiddur:text:siddur:brit_milah/grace"/></tei:div>
