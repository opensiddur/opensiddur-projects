  <tei:text>
    <tei:body>
        <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/mishpat">
          <tei:div>
            <tei:p>Restore our judges as at first, and our counselors as at the beginning; remove from us sorrow and sighing; reign thou alone over us, O Lord, in kindness and mercy, and clear us in judgment.</tei:p>
          </tei:div>
        <j:conditional xml:id="cond_mishpat_seal_ordinary">
          <j:none>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="aseret-ymei-tshuva">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
          </j:none>
        </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/mishpat/melekh_ohev_tzedaqah">
            <tei:p>Blessed art thou, O Lord, King, who lovest righteousness and justice.</tei:p>
          </tei:div>
        <j:endConditional target="#cond_mishpat_seal_ordinary"/>
        <j:conditional xml:id="cond_mishpat_seal_aseret">
          <tei:note type="instruction" xml:lang="en">Between Rosh Hashanah and Yom Kippur substitute:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="aseret-ymei-tshuva">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/mishpat/hamelekh_hamishpat">
            <tei:p>(Blessed art thou, O Lord, King of Justice.)</tei:p>
          </tei:div>
        <j:endConditional target="#cond_mishpat_seal_aseret"/>
        </tei:div>
