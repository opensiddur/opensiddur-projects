<tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/shir_shel_yom">
<tei:pb n="140" ed="1949 chol/shacharit/psalms" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n164_medium.jpg"/>
<tei:head xml:lang="en">PSALM OF THE DAY</tei:head>
<tei:note type="instruction" xml:lang="en">The following six psalms are recited on the respective days of the week.</tei:note>
        <j:conditional xml:id="day_sunday">
          <tei:note type="instruction" xml:lang="en">On Sundays:</tei:note>
          <tei:fs type="opensiddur:day-of-week">
            <tei:f name="hebrew-day">
              <tei:numeric value="1"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
<j:transclude type="external" target="urn:x-opensiddur:text:siddur:chol/shacharit/psalms/sunday"/>
        <j:endConditional target="#day_sunday"/>
        <j:conditional xml:id="day_monday">
          <tei:note type="instruction" xml:lang="en">On Mondays:</tei:note>
          <tei:fs type="opensiddur:day-of-week">
            <tei:f name="hebrew-day">
              <tei:numeric value="2"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
<j:transclude type="external" target="urn:x-opensiddur:text:siddur:chol/shacharit/psalms/monday"/>
        <j:endConditional target="#day_monday"/>
        <j:conditional xml:id="day_tuesday">
          <tei:note type="instruction" xml:lang="en">On Tuesdays:</tei:note>
          <tei:fs type="opensiddur:day-of-week">
            <tei:f name="hebrew-day">
              <tei:numeric value="3"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
<j:transclude type="external" target="urn:x-opensiddur:text:siddur:chol/shacharit/psalms/tuesday"/>
        <j:endConditional target="#day_tuesday"/>
        <j:conditional xml:id="day_wednesday">
          <tei:note type="instruction" xml:lang="en">On Wednesdays:</tei:note>
          <tei:fs type="opensiddur:day-of-week">
            <tei:f name="hebrew-day">
              <tei:numeric value="4"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
<j:transclude type="external" target="urn:x-opensiddur:text:siddur:chol/shacharit/psalms/wednesday"/>
        <j:endConditional target="#day_wednesday"/>
        <j:conditional xml:id="day_thursday">
          <tei:note type="instruction" xml:lang="en">On Thursdays:</tei:note>
          <tei:fs type="opensiddur:day-of-week">
            <tei:f name="hebrew-day">
              <tei:numeric value="5"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
<j:transclude type="external" target="urn:x-opensiddur:text:siddur:chol/shacharit/psalms/thursday"/>
        <j:endConditional target="#day_thursday"/>
        <j:conditional xml:id="day_friday">
          <tei:note type="instruction" xml:lang="en">On Fridays:</tei:note>
          <tei:fs type="opensiddur:day-of-week">
            <tei:f name="hebrew-day">
              <tei:numeric value="6"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
<j:transclude type="external" target="urn:x-opensiddur:text:siddur:chol/shacharit/psalms/friday"/>
        <j:endConditional target="#day_friday"/>
