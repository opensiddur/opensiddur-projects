<tei:pb n="256" ed="1949 shabbat/kabbalat_shabbat" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n280_medium.jpg"/><tei:div corresp="urn:x-opensiddur:text:siddur:shabbat/kabbalat_shabbat/study_kaddish"><tei:head xml:lang="en">KADDISH D’RABBANAN</tei:head>        <j:conditional xml:id="kabbalat_study_minyan">
          <tei:note type="instruction" xml:lang="en">When a minyan holds service:</tei:note>
          <tei:fs type="opensiddur:quorum">
            <tei:f name="minyan">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional><tei:note type="instruction" xml:lang="en">Mourners:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/derabbanan/yitgadal"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/derabbanan/yehe_shmeh"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/derabbanan/yitbarakh"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/derabbanan/al_yisrael"/><tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:shabbat/kabbalat_shabbat/study_kaddish/yehe_shlama"/><tei:seg source="urn:x-opensiddur:text:prayer:kaddish/derabbanan/yehe_shlama">May there be abundant peace from heaven, and a happy life, for us and for all Israel; and say, Amen.</tei:seg><tei:milestone unit="prayer-part"/></tei:p><j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/derabbanan/oseh_shalom"/>        <j:endConditional target="#kabbalat_study_minyan"/></tei:div>
