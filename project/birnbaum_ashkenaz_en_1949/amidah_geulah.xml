  <tei:text>
    <tei:body>
        <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/geulah">
          <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/geulah/reeh_na">
            <tei:p>Look upon our affliction and champion our cause; redeem us speedily for thy name’s sake, for thou art a mighty Redeemer. Blessed art thou, O Lord, Redeemer of Israel.</tei:p>
          </tei:div>
        <j:conditional xml:id="cond_geulah_aneinu">
          <tei:note type="instruction" xml:lang="en">On fast days (except Tish‘ah b’Av) the Reader adds:</tei:note>
          <j:all>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="minor-fast">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
          <tei:fs type="opensiddur:recitation">
            <tei:f name="repetition">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
          </j:all>
        </j:conditional>
          <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/aneinu"/>
