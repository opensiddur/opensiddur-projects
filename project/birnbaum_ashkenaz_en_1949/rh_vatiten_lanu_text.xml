<tei:p><tei:pb n="660" ed="1949 rosh hashana and erev yom kippur" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n684_medium.jpg"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/text/vatiten_lanu"/>Thou, Lord our God, hast graciously given us <j:conditional xml:id="festival_rh_vatiten_lanu_shabbat_0">
          <tei:note type="instruction" xml:lang="en">On the Sabbath:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>this Sabbath day and<j:endConditional target="#festival_rh_vatiten_lanu_shabbat_0"/> this Day of Remembrance, a day for the blowing of the Shofar, a holy festival in remembrance of the exodus from Egypt.<tei:milestone unit="prayer-part"/></tei:p>
