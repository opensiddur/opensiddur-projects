<tei:div corresp="urn:x-opensiddur:text:siddur:shabbat/conclusion/kaddish"><tei:head xml:lang="en" resp="urn:x-opensiddur:contributor:opensiddur.org/efraim-feinstein">Full Kaddish</tei:head><tei:pb n="542" ed="1949 shabbat/conclusion" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n566_medium.jpg"/>        <j:conditional xml:id="shabbat_minchah_motzaei_full_kaddish">
          <tei:note type="instruction" xml:lang="en">When a minyan holds service:</tei:note>
          <tei:fs type="opensiddur:quorum">
            <tei:f name="minyan">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional><tei:note type="instruction" xml:lang="en">Reader:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/yitgadal"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/yehe_shmeh"/><tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:shabbat/conclusion/kaddish/yitbarakh"/><tei:seg source="urn:x-opensiddur:text:prayer:kaddish/yitbarakh">Blessed and praised, glorified and exalted, extolled and honored, adored and lauded be the name of the Holy One, blessed be he, beyond all the blessings and hymns, praises and consolations that are ever spoken in the world; and say, Amen.</tei:seg><tei:milestone unit="prayer-part"/></tei:p><tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:shabbat/conclusion/kaddish/titkabal"/><tei:seg source="urn:x-opensiddur:text:prayer:kaddish/titkabal">May the prayers and supplications of the whole household of Israel be accepted by their Father who is in heaven; and say, Amen.</tei:seg><tei:milestone unit="prayer-part"/></tei:p><j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/yatom/yehe_shlama"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/yatom/oseh_shalom"/>        <j:endConditional target="#shabbat_minchah_motzaei_full_kaddish"/></tei:div>
