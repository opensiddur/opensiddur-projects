<tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/psalms/wednesday/psalm_95_opening">
<tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/psalms/wednesday/psalm_95_opening/psalms_95_1" xml:id="ref_1"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/95/1">Come, let us sing to the Lord; let us acclaim our saving Stronghold. </tei:seg><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/psalms/wednesday/psalm_95_opening/psalms_95_2" xml:id="ref_2"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/95/2">Let us approach him with thanksgiving; let us acclaim him <tei:pb n="146" ed="1949 chol/shacharit/psalms" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n170_medium.jpg"/>with songs of praise. </tei:seg><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/psalms/wednesday/psalm_95_opening/psalms_95_3" xml:id="ref_3"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/95/3">For the Lord is a great God, a King supreme above all powers. </tei:seg><tei:milestone unit="verse"/></tei:p>
</tei:div>
