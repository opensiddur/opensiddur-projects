<tei:div corresp="urn:x-opensiddur:text:siddur:shabbat/day_meal/yah_ribbon"><tei:head xml:lang="en" resp="urn:x-opensiddur:contributor:opensiddur.org/efraim-feinstein">Yah Ribbon</tei:head><tei:pb n="434" ed="1949 shabbat/day_meal" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n458_medium.jpg"/><tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:siddur:shabbat/day_meal/yah_ribbon/1"/><tei:seg source="urn:x-opensiddur:text:poem:yah_ribbon/1">Lord, eternal Master of worlds,<tei:lb/>Thou art the Supreme King of kings.<tei:lb/>Thy mighty acts and wondrous deeds<tei:lb/>It is my pleasure to declare.</tei:seg><tei:milestone unit="stanza"/></tei:p><j:transclude type="external" target="urn:x-opensiddur:text:poem:yah_ribbon/refrain/1"/><j:transclude type="external" target="urn:x-opensiddur:text:poem:yah_ribbon/2"/><j:transclude type="external" target="urn:x-opensiddur:text:poem:yah_ribbon/refrain/2"/><j:transclude type="external" target="urn:x-opensiddur:text:poem:yah_ribbon/3"/><j:transclude type="external" target="urn:x-opensiddur:text:poem:yah_ribbon/refrain/3"/><tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:siddur:shabbat/day_meal/yah_ribbon/4"/><tei:seg source="urn:x-opensiddur:text:poem:yah_ribbon/4">O God of glory and greatness,<tei:lb/>Save thy flock from the lion’s jaws;<tei:lb/>Free thy people from captivity,<tei:lb/>Thy people chosen from all nations.</tei:seg><tei:milestone unit="stanza"/></tei:p><j:transclude type="external" target="urn:x-opensiddur:text:poem:yah_ribbon/refrain/4"/><tei:pb n="436" ed="1949 shabbat/day_meal" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n460_medium.jpg"/><j:transclude type="external" target="urn:x-opensiddur:text:poem:yah_ribbon/5"/><j:transclude type="external" target="urn:x-opensiddur:text:poem:yah_ribbon/refrain/5"/></tei:div>
