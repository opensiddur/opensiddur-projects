<tei:p><tei:pb n="600" ed="1949 regalim" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n624_medium.jpg"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:regalim/text/kiddush_close"/>a holy convocation in remembrance of the exodus from Egypt. Thou didst choose and sanctify us above all peoples; in thy gracious love, thou didst grant us thy holy <j:conditional xml:id="festival_kiddush_close_shabbat_0">
          <tei:note type="instruction" xml:lang="en">On the Sabbath:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>Sabbath and<j:endConditional target="#festival_kiddush_close_shabbat_0"/> festivals for gladness and joy. Blessed art thou, O Lord, who hallowest <j:conditional xml:id="festival_kiddush_close_shabbat_1">
          <tei:note type="instruction" xml:lang="en">On the Sabbath:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>the Sabbath,<j:endConditional target="#festival_kiddush_close_shabbat_1"/> Israel and the festivals.<tei:milestone unit="prayer-part"/></tei:p>
