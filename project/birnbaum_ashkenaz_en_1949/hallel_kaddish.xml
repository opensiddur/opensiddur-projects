<tei:div corresp="urn:x-opensiddur:text:siddur:hallel/kaddish"><tei:head xml:lang="en" resp="urn:x-opensiddur:contributor:opensiddur.org/efraim-feinstein">Kaddish after Hallel</tei:head>        <j:conditional xml:id="hallel_minyan">
          <tei:note type="instruction" xml:lang="en">When a minyan holds service:</tei:note>
          <tei:fs type="opensiddur:quorum">
            <tei:f name="minyan">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>        <j:conditional xml:id="hallel_full_kaddish">
          <tei:note type="instruction" xml:lang="en">Full-Kaddish on Rosh Ḥodesh and festivals:</tei:note>
<j:any>          <tei:fs type="opensiddur:holiday">
            <tei:f name="rosh-hodesh">
              <tei:numeric value="1" max="2"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="yom-tov">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="chol-hamoed">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs></j:any>
        </j:conditional><tei:note type="instruction" xml:lang="en">Reader:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/yitgadal"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/yehe_shmeh"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/yitbarakh"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/titkabal"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/yatom/yehe_shlama"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/yatom/oseh_shalom"/>        <j:endConditional target="#hallel_full_kaddish"/>        <j:conditional xml:id="hallel_half_kaddish">
          <tei:note type="instruction" xml:lang="en">Half-Kaddish on Ḥanukkah:</tei:note>
<j:all>          <tei:fs type="opensiddur:holiday">
            <tei:f name="hanukkah">
              <tei:numeric value="1" max="8"/>
            </tei:f>
          </tei:fs><j:none><j:any>          <tei:fs type="opensiddur:holiday">
            <tei:f name="rosh-hodesh">
              <tei:numeric value="1" max="2"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="yom-tov">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="chol-hamoed">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs></j:any></j:none></j:all>
        </j:conditional><tei:note type="instruction" xml:lang="en">Reader:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/yitgadal"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/yehe_shmeh"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/yitbarakh"/>        <j:endConditional target="#hallel_half_kaddish"/>        <j:endConditional target="#hallel_minyan"/></tei:div>
    </tei:body>
  </tei:text>
