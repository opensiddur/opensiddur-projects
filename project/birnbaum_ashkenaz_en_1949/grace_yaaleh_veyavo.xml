<tei:div corresp="urn:x-opensiddur:text:prayer:birkat_hamazon/yaaleh_veyavo"><tei:head xml:lang="en" resp="urn:x-opensiddur:contributor:opensiddur.org/efraim-feinstein">Ya’aleh Veyavo</tei:head><tei:p><tei:pb n="766" ed="1949 concluding_prayers" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n790_medium.jpg"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:concluding_prayers/text/grace_yaaleh_open"/>Our God and God of our fathers, may the remembrance of us, of our fathers, of Messiah the son of David thy servant, of Jerusalem thy holy city, and of all thy people the house of Israel, ascend and come and be accepted before thee for deliverance and happiness, for grace, kindness and mercy, for life and peace, on this day of the<tei:milestone unit="prayer-part"/> <j:conditional xml:id="festival_concluding_yaaleh_rc">
          <tei:note type="instruction" xml:lang="en">Rosh Ḥodesh:</tei:note>
          <tei:fs type="opensiddur:holiday">
            <tei:f name="rosh-hodesh">
              <tei:numeric value="1" max="2"/>
            </tei:f>
          </tei:fs>
        </j:conditional><tei:pb n="766" ed="1949 concluding_prayers" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n790_medium.jpg"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:concluding_prayers/text/grace_yaaleh_rc"/>New Moon.<tei:milestone unit="prayer-part"/><j:endConditional target="#festival_concluding_yaaleh_rc"/> <j:conditional xml:id="festival_concluding_yaaleh_pesach">
          <tei:note type="instruction" xml:lang="en">Pesaḥ:</tei:note>
          <tei:fs type="opensiddur:holiday">
            <tei:f name="pesah">
              <tei:numeric value="1" max="8"/>
            </tei:f>
          </tei:fs>
        </j:conditional><tei:pb n="766" ed="1949 concluding_prayers" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n790_medium.jpg"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:concluding_prayers/text/grace_yaaleh_pesach"/>Feast of Unleavened Bread.<tei:milestone unit="prayer-part"/><j:endConditional target="#festival_concluding_yaaleh_pesach"/> <j:conditional xml:id="festival_concluding_yaaleh_shavuot">
          <tei:note type="instruction" xml:lang="en">Shavuoth:</tei:note>
          <tei:fs type="opensiddur:holiday">
            <tei:f name="shavuot">
              <tei:numeric value="1" max="2"/>
            </tei:f>
          </tei:fs>
        </j:conditional><tei:pb n="766" ed="1949 concluding_prayers" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n790_medium.jpg"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:concluding_prayers/text/grace_yaaleh_shavuot"/>Feast of Weeks.<tei:milestone unit="prayer-part"/><j:endConditional target="#festival_concluding_yaaleh_shavuot"/> <j:conditional xml:id="festival_concluding_yaaleh_rh">
          <tei:note type="instruction" xml:lang="en">Rosh Hashanah:</tei:note>
          <tei:fs type="opensiddur:holiday">
            <tei:f name="rosh-hashana">
              <tei:numeric value="1" max="2"/>
            </tei:f>
          </tei:fs>
        </j:conditional><tei:pb n="766" ed="1949 concluding_prayers" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n790_medium.jpg"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:concluding_prayers/text/grace_yaaleh_rh"/>Remembrance.<tei:milestone unit="prayer-part"/><j:endConditional target="#festival_concluding_yaaleh_rh"/> <j:conditional xml:id="festival_concluding_yaaleh_sukkot">
          <tei:note type="instruction" xml:lang="en">Sukkoth:</tei:note>
          <tei:fs type="opensiddur:holiday">
            <tei:f name="sukkot">
              <tei:numeric value="1" max="7"/>
            </tei:f>
          </tei:fs>
        </j:conditional><tei:pb n="766" ed="1949 concluding_prayers" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n790_medium.jpg"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:concluding_prayers/text/grace_yaaleh_sukkot"/>Feast of Tabernacles.<tei:milestone unit="prayer-part"/><j:endConditional target="#festival_concluding_yaaleh_sukkot"/> <j:conditional xml:id="festival_concluding_yaaleh_shemini">
          <tei:note type="instruction" xml:lang="en">Shemini Atzereth / Simḥath Torah:</tei:note>
<j:any>          <tei:fs type="opensiddur:holiday">
            <tei:f name="shmini-atzeret">
              <tei:numeric value="1" max="2"/>
            </tei:f>
          </tei:fs></j:any>
        </j:conditional><tei:pb n="766" ed="1949 concluding_prayers" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n790_medium.jpg"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:concluding_prayers/text/grace_yaaleh_shemini"/>Eighth Day Feast.<tei:milestone unit="prayer-part"/><j:endConditional target="#festival_concluding_yaaleh_shemini"/> <tei:pb n="766" ed="1949 concluding_prayers" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n790_medium.jpg"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:concluding_prayers/text/grace_yaaleh_end"/>Remember us this day, Lord our God, for happiness; be mindful of us for blessing; save us to enjoy life. With a promise of salvation and mercy spare us and be gracious to us; have pity on us and save us, for we look to thee, for thou art a gracious and merciful God and King.<tei:milestone unit="prayer-part"/></tei:p></tei:div>
    </tei:body>
  </tei:text>
