<j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/yitgadal"/>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/yehe_shmeh"/>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/yitbarakh"/>
        <tei:div corresp="urn:x-opensiddur:text:prayer:kaddish/yatom/yehe_shlama">
          <tei:p><tei:pb n="52" ed="1949 chol/shacharit/pesukei_dezimra" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n76_medium.jpg"/>May there be abundant peace from heaven, and life, for us and for all Israel; and say, Amen.</tei:p>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:prayer:kaddish/yatom/oseh_shalom">
          <tei:p>He who creates peace in his celestial heights, may he create peace for us and for all Israel; and say, Amen.</tei:p>
