<tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/minchah_maariv/amidah"><tei:head>MINḤAH AND MA‘ARIV FOR ROSH HASHANAH</tei:head><tei:pb n="656" ed="1949 rosh hashana and erev yom kippur" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n680_medium.jpg"/><tei:note type="instruction" xml:lang="en">The Amidah is recited in silent devotion while standing, facing east.</tei:note><j:conditional xml:id="festival_rh_ki_shem">
          <tei:note type="instruction" xml:lang="en">At Minḥah:</tei:note>
          <tei:fs type="opensiddur:service-time">
            <tei:f name="minha">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:siddur:rosh_hashanah/text/ki_shem"/><j:endConditional target="#festival_rh_ki_shem"/><j:transclude type="external" target="urn:x-opensiddur:text:siddur:rosh_hashanah/text/adonai_sefatai"/><j:transclude type="external" target="urn:x-opensiddur:text:siddur:rosh_hashanah/minchah_maariv/amidah/avot"/><j:transclude type="external" target="urn:x-opensiddur:text:siddur:rosh_hashanah/minchah_maariv/amidah/gevurot"/><j:transclude type="external" target="urn:x-opensiddur:text:siddur:rosh_hashanah/minchah_maariv/amidah/kedushat_hashem"/><j:transclude type="external" target="urn:x-opensiddur:text:siddur:rosh_hashanah/minchah_maariv/amidah/kedushat_hayom"/><j:transclude type="external" target="urn:x-opensiddur:text:siddur:rosh_hashanah/minchah_maariv/amidah/avodah"/><j:transclude type="external" target="urn:x-opensiddur:text:siddur:rosh_hashanah/minchah_maariv/amidah/hodaah"/><j:transclude type="external" target="urn:x-opensiddur:text:siddur:rosh_hashanah/minchah_maariv/amidah/shalom"/><j:conditional xml:id="festival_rh_meditation">
          <tei:note type="instruction" xml:lang="en">After the Amidah add the following meditation:</tei:note>
          <j:none>
<j:all>          <tei:fs type="opensiddur:service-time">
            <tei:f name="minha">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs><j:all>          <tei:fs type="opensiddur:quorum">
