<tei:div corresp="urn:x-opensiddur:text:siddur:shabbat/conclusion/havdalah"><tei:head xml:lang="en">HAVDALAH</tei:head><tei:pb n="552" ed="1949 shabbat/conclusion" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n576_medium.jpg"/><tei:note type="instruction" xml:lang="en">Recited over a cup of wine and fragrant spices</tei:note>        <j:conditional xml:id="shabbat_minchah_havdalah_private">
          <tei:note type="instruction" xml:lang="en">Outside the synagogue:</tei:note>
          <j:none>
          <tei:fs type="opensiddur:observance">
            <tei:f name="synagogue-havdalah">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
          </j:none>
        </j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:siddur:shabbat/conclusion/havdalah_intro"/>        <j:endConditional target="#shabbat_minchah_havdalah_private"/><tei:note type="instruction" xml:lang="en">In the synagogue, the Reader begins here:</tei:note><tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:shabbat/conclusion/havdalah/wine"/><tei:seg source="urn:x-opensiddur:text:prayer:borei_pri_hagafen">Blessed art thou, Lord our God, King of the universe, who createst the fruit of the vine.</tei:seg><tei:milestone unit="prayer-part"/></tei:p>        <j:conditional xml:id="shabbat_minchah_havdalah_spices">
          <tei:note type="instruction" xml:lang="en">Except when a festival immediately follows the Sabbath:</tei:note>
          <j:none>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="yom-tov">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
          </j:none>
        </j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:prayer:borei_minei_vesamim"/>        <j:endConditional target="#shabbat_minchah_havdalah_spices"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:borei_meorei_haesh"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:hamavdil_bein_kodesh_lechol"/></tei:div>
