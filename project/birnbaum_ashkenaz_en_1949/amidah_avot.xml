  <tei:text>
    <tei:body>
        <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/avot">
          <tei:div>
            <tei:p>Blessed art thou, Lord our God and God of our fathers, God of Abraham, God of Isaac and God of Jacob; great, mighty and revered God, sublime God, who bestowest lovingkindness, and art Master of all things; who rememberest the good deeds of our fathers, and who wilt graciously bring a redeemer to their children’s children for the sake of thy name.</tei:p>
          </tei:div>
        <j:conditional xml:id="cond_avot_aseret">
          <tei:note type="instruction" xml:lang="en">Between Rosh Hashanah and Yom Kippur add:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="aseret-ymei-tshuva">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/avot/zokhrenu">
            <tei:p>(<tei:pb n="84" ed="1949 chol/shacharit/amidah" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n108_medium.jpg"/>Remember us to life, O King who delightest in life; inscribe us in the book of life for thy sake, O living God.)</tei:p>
          </tei:div>
        <j:endConditional target="#cond_avot_aseret"/>
          <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/avot/magen_avraham">
            <tei:p>O King, Supporter, Savior and Shield! Blessed art thou, O Lord, Shield of Abraham.</tei:p>
          </tei:div>
        </tei:div>
    </tei:body>
