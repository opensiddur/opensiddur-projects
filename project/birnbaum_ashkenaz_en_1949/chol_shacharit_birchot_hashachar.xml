          <tei:fs type="opensiddur:service-time">
          <tei:f name="shaharit">
            <tei:binary value="true"/>
          </tei:f>
          <tei:f name="minha">
            <tei:binary value="false"/>
          </tei:f>
          <tei:f name="maariv">
            <tei:binary value="false"/>
          </tei:f>
          <tei:f name="musaf">
            <tei:binary value="false"/>
          </tei:f>
