            <tei:binary value="false"/>
          </tei:f>
          <tei:f name="yom-tov">
            <tei:binary value="false"/>
          </tei:f>
          </tei:fs>
        </j:declare>
        <tei:head xml:lang="en">PRELIMINARY MORNING SERVICE</tei:head>
        <tei:note type="instruction" xml:lang="en">Upon entering the synagogue:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:mah_tovu"/>
        <tei:head xml:lang="en">PUTTING ON THE TALLITH</tei:head>
        <tei:note type="instruction" xml:lang="en">Before putting on the <tei:foreign xml:lang="he-Latn">tallith</tei:foreign>:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:tallith/barkhi_nafshi"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:tallith/hineni_mitatef"/>
        <tei:note type="instruction" xml:lang="en">When putting on the <tei:foreign xml:lang="he-Latn">tallith</tei:foreign>:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:tallith/lehitatef"/>
        <tei:head xml:lang="en">Psalm 36:8-11</tei:head>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:tallith/mah_yakar"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:tallith/yehi_ratzon"/>
        <tei:head xml:lang="en">PUTTING ON THE TEFILLIN</tei:head>
        <tei:note type="instruction" xml:lang="en">Meditation before putting on the tefillin</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:tefillin/hineni_mekhaven"/>
        <tei:note type="instruction" xml:lang="en">When placing the tefillin on the left arm:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:tefillin/lehaniach"/>
        <tei:note type="instruction" xml:lang="en">When placing the tefillin on the forehead:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:tefillin/al_mitzvat"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:tefillin/umechokhmatkha"/>
        <tei:note type="instruction" xml:lang="en">When winding the retsuah three times round the middle finger:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:tefillin/verastikh"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:tefillin/yehi_ratzon"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:tefillin/parashiyot"/>
        <tei:head xml:lang="en">ADON OLAM</tei:head>
        <j:transclude type="external" target="urn:x-opensiddur:text:poem:adon_olam"/>
        <tei:head xml:lang="en">YIGDAL</tei:head>
        <j:transclude type="external" target="urn:x-opensiddur:text:poem:yigdal"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:al_netilat_yadayim"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:asher_yatzar"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hatorah/laasok"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hatorah/vehaarev"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hatorah/asher_bachar"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkat_kohanim"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:elu_devarim"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:elohai_neshamah"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birchot_hashachar/lasekhvi"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birchot_hashachar/shelo_asani_goy"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birchot_hashachar/shelo_asani_aved"/>
        <j:conditional xml:id="cond_blessing_men">
          <tei:note type="instruction" xml:lang="en">Men say:</tei:note>
          <tei:fs type="opensiddur:person">
            <tei:f name="gender">
              <tei:symbol value="male"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birchot_hashachar/shelo_asani_ishah"/>
        <j:endConditional target="#cond_blessing_men"/>
        <j:conditional xml:id="cond_blessing_women">
          <tei:note type="instruction" xml:lang="en">Women say:</tei:note>
          <tei:fs type="opensiddur:person">
            <tei:f name="gender">
              <tei:symbol value="female"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birchot_hashachar/sheasani_kirtzono"/>
        <j:endConditional target="#cond_blessing_women"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birchot_hashachar/pokeach_ivrim"/>
