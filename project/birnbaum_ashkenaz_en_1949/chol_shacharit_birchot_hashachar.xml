        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birchot_hashachar/matir_asurim"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birchot_hashachar/zokef_kefufim"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birchot_hashachar/roka_haaretz"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birchot_hashachar/sheasah_li"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birchot_hashachar/hamekhin"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birchot_hashachar/ozer_yisrael"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birchot_hashachar/oter_yisrael"/>
