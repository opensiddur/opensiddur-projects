<tei:div corresp="urn:x-opensiddur:text:siddur:chol/minchah/amidah">
<tei:head xml:lang="en" resp="urn:x-opensiddur:contributor:opensiddur.org/efraim-feinstein">SHEMONEH ESREH</tei:head>
        <j:declare xml:id="unit_service">
          <tei:fs type="opensiddur:service-time">
          <tei:f name="shaharit">
            <tei:binary value="false"/>
          </tei:f>
          <tei:f name="minha">
            <tei:binary value="true"/>
          </tei:f>
          <tei:f name="maariv">
            <tei:binary value="false"/>
          </tei:f>
          <tei:f name="musaf">
            <tei:binary value="false"/>
          </tei:f>
          <tei:f name="neila">
            <tei:binary value="false"/>
          </tei:f>
          <tei:f name="slihot">
            <tei:binary value="false"/>
          </tei:f>
          </tei:fs>
          <tei:fs type="opensiddur:holiday-aggregate">
          <tei:f name="shabbat">
            <tei:binary value="false"/>
          </tei:f>
          <tei:f name="yom-tov">
            <tei:binary value="false"/>
          </tei:f>
          </tei:fs>
        </j:declare>
<tei:pb n="160" ed="1949 chol/minchah/amidah" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n184_medium.jpg"/>
<tei:note type="instruction" xml:lang="en">The Shemoneh Esreh is recited in silent devotion while standing, facing east.</tei:note>
<tei:note type="instruction" xml:lang="en">The Reader repeats the Shemoneh Esreh aloud when a minyan holds service.</tei:note>
<j:transclude type="external" target="urn:x-opensiddur:text:bible:deuteronomy/32/3"/>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/adonai_sefatai"/>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/avot"/>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/gevurot"/>
<tei:div><tei:head xml:lang="en">KEDUSHAH</tei:head><j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/qedushah"/></tei:div>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/qedushat_hashem"/>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/binah"/>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/teshuvah"/>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/selichah"/>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/geulah/reeh_na"/>
        <j:conditional xml:id="minchah_reader_aneinu">
          <tei:note type="instruction" xml:lang="en">On fast days the Reader adds here:</tei:note>
<j:all>          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="minor-fast">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:recitation">
            <tei:f name="repetition">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:quorum">
            <tei:f name="minyan">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs></j:all>
        </j:conditional>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/aneinu"/>
        <j:endConditional target="#minchah_reader_aneinu"/>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/refuah"/>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/shanim"/>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/qibbutz_galuyot"/>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/mishpat"/>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/minim"/>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/tzadiqim"/>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/yerushalayim/opening"/>
        <j:conditional xml:id="minchah_jerusalem_seal">
          <tei:note type="instruction" xml:lang="en">Except on Tish‘ah b’Av:</tei:note>
          <j:none>
          <tei:fs type="opensiddur:holiday">
            <tei:f name="tisha-bav">
              <tei:numeric value="1" max="1"/>
            </tei:f>
          </tei:fs>
          </j:none>
        </j:conditional>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/yerushalayim/seal"/>
        <j:endConditional target="#minchah_jerusalem_seal"/>
        <j:conditional xml:id="minchah_nachem">
          <tei:note type="instruction" xml:lang="en">On Tish‘ah b’Av say:</tei:note>
          <tei:fs type="opensiddur:holiday">
            <tei:f name="tisha-bav">
              <tei:numeric value="1" max="1"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/nachaym_hashem_elohaynu"/>
        <j:endConditional target="#minchah_nachem"/>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/david"/>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/tefilah/opening"/>
        <j:conditional xml:id="minchah_silent_aneinu">
          <tei:note type="instruction" xml:lang="en">On fast days, the Congregation recites here:</tei:note>
<j:all>          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="minor-fast">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:recitation">
            <tei:f name="repetition">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs></j:all>
        </j:conditional>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/aneinu/opening"/>
        <j:endConditional target="#minchah_silent_aneinu"/>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/tefilah/seal"/>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/avodah"/>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/hodaah"/>
<tei:note type="instruction" xml:lang="en">On fast days, the Reader recites here the priestly blessing (page 94) and instead of the following paragraph, “O grant peace…” is said (page 96).</tei:note>
        <j:conditional xml:id="minchah_priestly_blessing">
          <tei:note type="instruction" xml:lang="en">On fast days, in the Reader’s repetition:</tei:note>
<j:all>          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="minor-fast">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:recitation">
            <tei:f name="repetition">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:quorum">
            <tei:f name="minyan">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs></j:all>
        </j:conditional>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/birkat_kohanim"/>
        <j:endConditional target="#minchah_priestly_blessing"/>
        <j:conditional xml:id="minchah_sim_shalom">
          <tei:note type="instruction" xml:lang="en">On fast days:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="minor-fast">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/shalom/sim_shalom"/>
        <j:endConditional target="#minchah_sim_shalom"/>
        <j:conditional xml:id="minchah_shalom_rav">
          <tei:note type="instruction" xml:lang="en">Except on fast days:</tei:note>
          <j:none>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="minor-fast">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
          </j:none>
        </j:conditional>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/shalom_rav_al"/>
        <j:endConditional target="#minchah_shalom_rav"/>
        <j:conditional xml:id="minchah_peace_seal">
          <tei:note type="instruction" xml:lang="en">Except during the Ten Days of Repentance:</tei:note>
          <j:none>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="aseret-ymei-tshuva">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
          </j:none>
        </j:conditional>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/shalom/hamevarekh"/>
        <j:endConditional target="#minchah_peace_seal"/>
        <j:conditional xml:id="minchah_peace_ten_days">
          <tei:note type="instruction" xml:lang="en">Between Rosh Hashanah and Yom Kippur say:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="aseret-ymei-tshuva">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/shalom/besefer_chayim"/>
        <j:endConditional target="#minchah_peace_ten_days"/>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/elohai_netzor"/>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/yehi_ratzon"/>
<j:endDeclare target="#unit_service"/>
</tei:div>
    </tei:body>
  </tei:text>
