  <tei:text>
    <tei:body>
        <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/avodah">
          <tei:div>
            <tei:p>Be pleased, Lord our God, with thy people Israel and with their prayer; restore the worship to thy most holy sanctuary; accept Israel’s offerings and prayer with gracious love. May the worship of thy people Israel be ever pleasing to thee.</tei:p>
          </tei:div>
        <j:conditional xml:id="cond_avodah_yaaleh">
          <tei:note type="instruction" xml:lang="en">On Rosh Ḥodesh and Ḥol ha-Mo‘ed add:</tei:note>
          <j:any>
          <tei:fs type="opensiddur:holiday">
            <tei:f name="rosh-hodesh">
              <tei:numeric value="1" max="2"/>
            </tei:f>
          </tei:fs>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="chol-hamoed">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
          </j:any>
        </j:conditional>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:yaaleh_veyavo"/>
        <j:endConditional target="#cond_avodah_yaaleh"/>
          <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/avodah/vetechezenah">
            <tei:p>May our eyes behold thy return in mercy to Zion. Blessed art thou, O Lord, who restorest thy divine presence to Zion.</tei:p>
          </tei:div>
        </tei:div>
    </tei:body>
