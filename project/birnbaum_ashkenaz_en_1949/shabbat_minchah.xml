            </tei:f>
          </tei:fs>
        </j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:siddur:shabbat/minchah/torah"/>        <j:endConditional target="#shabbat_minchah_torah_minyan"/><j:transclude type="external" target="urn:x-opensiddur:text:siddur:shabbat/minchah/torah_kaddish"/>        <j:endConditional target="#shabbat_minchah_sabbath_torah"/>        <j:conditional xml:id="shabbat_minchah_sabbath_amidah">
