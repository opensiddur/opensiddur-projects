<tei:div corresp="urn:x-opensiddur:text:prayer:birkhot_haftarah/al_hatorah_festival"><tei:pb n="376" ed="1949 shabbat/shacharit/torah" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n400_medium.jpg"/><tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:birkhot_haftarah/al_hatorah_festival/al"/>We thank thee for the Torah, for the worship, for the Prophets         <j:conditional xml:id="shabbat_torah_haftarah_festival_al_shabbat_day">
          <tei:note type="instruction" xml:lang="en">On the Sabbath:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>for this Sabbath day        <j:endConditional target="#shabbat_torah_haftarah_festival_al_shabbat_day"/> and for this day of         <j:conditional xml:id="shabbat_torah_haftarah_festival_al_pesah">
          <tei:note type="instruction" xml:lang="en">On Passover:</tei:note>
          <tei:fs type="opensiddur:holiday">
            <tei:f name="pesah">
              <tei:numeric value="1" max="8"/>
            </tei:f>
          </tei:fs>
        </j:conditional>the Feast of Unleavened Bread        <j:endConditional target="#shabbat_torah_haftarah_festival_al_pesah"/>         <j:conditional xml:id="shabbat_torah_haftarah_festival_al_shavuot">
          <tei:note type="instruction" xml:lang="en">On Shavuoth:</tei:note>
          <tei:fs type="opensiddur:holiday">
            <tei:f name="shavuot">
              <tei:numeric value="1" max="2"/>
            </tei:f>
          </tei:fs>
        </j:conditional>the Feast of Weeks        <j:endConditional target="#shabbat_torah_haftarah_festival_al_shavuot"/>         <j:conditional xml:id="shabbat_torah_haftarah_festival_al_sukkot">
          <tei:note type="instruction" xml:lang="en">On Sukkoth:</tei:note>
          <tei:fs type="opensiddur:holiday">
            <tei:f name="sukkot">
              <tei:numeric value="1" max="7"/>
            </tei:f>
          </tei:fs>
        </j:conditional>the Feast of Tabernacles        <j:endConditional target="#shabbat_torah_haftarah_festival_al_sukkot"/>         <j:conditional xml:id="shabbat_torah_haftarah_festival_al_shmini-atzeret">
          <tei:note type="instruction" xml:lang="en">On Shemini Atsereth:</tei:note>
          <tei:fs type="opensiddur:holiday">
            <tei:f name="shmini-atzeret">
              <tei:numeric value="1" max="2"/>
            </tei:f>
          </tei:fs>
        </j:conditional>the Eighth-Day Feast        <j:endConditional target="#shabbat_torah_haftarah_festival_al_shmini-atzeret"/>, which thou hast given us, Lord our God,         <j:conditional xml:id="shabbat_torah_haftarah_festival_al_shabbat_rest">
          <tei:note type="instruction" xml:lang="en">On the Sabbath:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>for holiness and rest,        <j:endConditional target="#shabbat_torah_haftarah_festival_al_shabbat_rest"/> for joy and gladness, for glory and beauty. </tei:p><tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:birkhot_haftarah/al_hatorah_festival/seal"/><tei:pb n="378" ed="1949 shabbat/shacharit/torah" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n402_medium.jpg"/>We thank and bless thee, Lord our God, for all things; be thy name ever blessed by every living being. Blessed art thou, O Lord, who hallowest         <j:conditional xml:id="shabbat_torah_haftarah_festival_seal_shabbat_seal">
          <tei:note type="instruction" xml:lang="en">On the Sabbath:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>the Sabbath and        <j:endConditional target="#shabbat_torah_haftarah_festival_seal_shabbat_seal"/> Israel and the festivals. <tei:milestone unit="prayer-part"/></tei:p></tei:div>
