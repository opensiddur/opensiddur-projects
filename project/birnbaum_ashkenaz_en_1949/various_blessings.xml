<tei:div corresp="urn:x-opensiddur:text:siddur:berakhot/various"><tei:head>BLESSINGS</tei:head><tei:note type="instruction" xml:lang="en">Recited on various occasions</tei:note><tei:note type="instruction" xml:lang="en">Over bread:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:hamotzi"/><tei:note type="instruction" xml:lang="en">Over wine:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:borei_pri_hagafen"/><tei:note type="instruction" xml:lang="en">Over cakes and pastry:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:borei_minei_mezonot"/><tei:note type="instruction" xml:lang="en">Over liquids other than wine and food other than plants:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:shehakol_nihyeh_bidvaro"/><tei:note type="instruction" xml:lang="en">Over fruits that grow on trees:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:borei_pri_haetz"/><tei:note type="instruction" xml:lang="en">Over fruits that grow in the soil:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:borei_pri_haadamah"/><tei:note type="instruction" xml:lang="en">Over fragrant spices:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:borei_minei_vesamim"/><tei:note type="instruction" xml:lang="en">On attaching a mezuzah:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:likboa_mezuzah"/><tei:note type="instruction" xml:lang="en">On tasting fruit for the first time in the season:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:shehecheyanu"/><tei:note type="instruction" xml:lang="en">On seeing the wonders of nature:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:oseh_maaseh_vereshit"/><tei:note type="instruction" xml:lang="en">On seeing an electrical storm:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:shekocho_ugevurato"/><tei:note type="instruction" xml:lang="en">On seeing a rainbow:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:zokher_haberit"/><tei:note type="instruction" xml:lang="en">On seeing the ocean:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:sheasah_et_hayam_hagadol"/><tei:note type="instruction" xml:lang="en">On seeing beauties of nature:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:shekakhah_lo_beolamo"/><tei:note type="instruction" xml:lang="en">On seeing trees blossoming:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:shelo_chisar_beolamo"/><tei:note type="instruction" xml:lang="en">On seeing an exalted ruler:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:shenatan_mikevodo"/><tei:note type="instruction" xml:lang="en">On seeing a person of abnormal appearance:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:meshaneh_haberiyot"/><tei:note type="instruction" xml:lang="en">On seeing a person of profound Torah wisdom:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:shechalak_mechokhmato"/><tei:note type="instruction" xml:lang="en">On seeing a person of profound secular learning:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:shenatan_mechokhmato"/><tei:note type="instruction" xml:lang="en">On hearing bad tidings:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:dayan_haemet"/><tei:note type="instruction" xml:lang="en">On hearing good tidings:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:hatov_vehametiv"/></tei:div>
    </tei:body>
  </tei:text>
