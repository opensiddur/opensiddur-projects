          <tei:f name="shabbat">
            <tei:binary value="false"/>
          </tei:f>
          <tei:f name="yom-tov">
            <tei:binary value="false"/>
          </tei:f>
          </tei:fs>
        </j:declare>
        <j:conditional xml:id="torah_reading_day">
          <tei:note type="instruction" xml:lang="en">The Torah is read on Mondays and Thursdays, Rosh Ḥodesh, Ḥol ha-Mo‘ed, Ḥanukkah, Purim, and on fast days.</tei:note>
<j:none>          <tei:fs type="opensiddur:quorum">
            <tei:f name="minyan">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs><j:none><j:any><j:any>          <tei:fs type="opensiddur:day-of-week">
            <tei:f name="hebrew-day">
              <tei:numeric value="2"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:day-of-week">
            <tei:f name="hebrew-day">
              <tei:numeric value="5"/>
            </tei:f>
          </tei:fs></j:any>          <tei:fs type="opensiddur:holiday">
            <tei:f name="rosh-hodesh">
              <tei:numeric value="1" max="2"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="chol-hamoed">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:holiday">
            <tei:f name="hanukkah">
