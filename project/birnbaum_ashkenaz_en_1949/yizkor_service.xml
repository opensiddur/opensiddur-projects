<tei:div corresp="urn:x-opensiddur:text:prayer:yizkor"><tei:head>MEMORIAL SERVICE</tei:head><tei:note type="instruction" xml:lang="en">Conducted on Yom Kippur and Shemini Atsereth, on the last day of Pesaḥ and the second day of Shavuoth</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:siddur:yizkor/opening"/><j:transclude type="external" target="urn:x-opensiddur:text:siddur:yizkor/psalm91"/><j:conditional xml:id="festival_yizkor_father">
          <tei:note type="instruction" xml:lang="en">In memory of a father:</tei:note>
          <tei:fs type="opensiddur:yizkor">
            <tei:f name="father">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:prayer:yizkor/father"/><j:endConditional target="#festival_yizkor_father"/><j:conditional xml:id="festival_yizkor_mother">
          <tei:note type="instruction" xml:lang="en">In memory of a mother:</tei:note>
          <tei:fs type="opensiddur:yizkor">
            <tei:f name="mother">
              <tei:binary value="true"/>
