            <tei:f name="el-male-man">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:prayer:el_male_rachamim/man"/><j:endConditional target="#festival_yizkor_el_male_man"/><j:conditional xml:id="festival_yizkor_el_male_woman">
          <tei:note type="instruction" xml:lang="en">For a woman:</tei:note>
          <tei:fs type="opensiddur:yizkor">
            <tei:f name="el-male-woman">
              <tei:binary value="true"/>
            </tei:f>
