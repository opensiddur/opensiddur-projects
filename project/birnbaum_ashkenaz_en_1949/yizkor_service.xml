        </j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:prayer:yizkor/mother"/><j:endConditional target="#festival_yizkor_mother"/><j:conditional xml:id="festival_yizkor_husband">
          <tei:note type="instruction" xml:lang="en">In memory of a husband:</tei:note>
          <tei:fs type="opensiddur:yizkor">
            <tei:f name="husband">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:prayer:yizkor/husband"/><j:endConditional target="#festival_yizkor_husband"/><j:conditional xml:id="festival_yizkor_wife">
          <tei:note type="instruction" xml:lang="en">In memory of a wife:</tei:note>
          <tei:fs type="opensiddur:yizkor">
            <tei:f name="wife">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:prayer:yizkor/wife"/><j:endConditional target="#festival_yizkor_wife"/><tei:note type="instruction" xml:lang="en">In memory of Jewish martyrs:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:yizkor/martyrs"/><j:conditional xml:id="festival_yizkor_el_male_man">
