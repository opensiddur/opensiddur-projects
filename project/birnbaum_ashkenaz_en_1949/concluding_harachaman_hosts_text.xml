<tei:p><tei:pb n="768" ed="1949 concluding_prayers" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n792_medium.jpg"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon/harachaman/hosts"/>May the Merciful One bless <j:conditional xml:id="festival_concluding_harachaman_hosts_father-is-host">
          <tei:note type="instruction" xml:lang="en">When the host is your father:</tei:note>
          <tei:fs type="opensiddur:meal-context">
            <tei:f name="father-is-host">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>my dear father<j:endConditional target="#festival_concluding_harachaman_hosts_father-is-host"/> the master of this house and <j:conditional xml:id="festival_concluding_harachaman_hosts_mother-is-host">
          <tei:note type="instruction" xml:lang="en">When the hostess is your mother:</tei:note>
          <tei:fs type="opensiddur:meal-context">
            <tei:f name="mother-is-host">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>my dear mother<j:endConditional target="#festival_concluding_harachaman_hosts_mother-is-host"/> the mistress of this house, their entire family and all that is theirs.<tei:milestone unit="prayer-part"/></tei:p>
    </tei:body>
