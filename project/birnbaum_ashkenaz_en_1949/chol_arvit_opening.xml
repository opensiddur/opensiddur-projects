<j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/134"/><j:transclude type="external" target="urn:x-opensiddur:text:siddur:chol/arvit/opening/verses"/>        <j:conditional xml:id="arvit_opening_kaddish">
