            <tei:binary value="false"/>
          </tei:f>
          <tei:f name="maariv">
            <tei:binary value="true"/>
          </tei:f>
          <tei:f name="musaf">
            <tei:binary value="false"/>
          </tei:f>
          <tei:f name="neila">
            <tei:binary value="false"/>
          </tei:f>
          <tei:f name="slihot">
            <tei:binary value="false"/>
          </tei:f>
          </tei:fs>
