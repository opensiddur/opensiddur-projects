            <tei:binary value="false"/>
          </tei:f>
          <tei:f name="yom-tov">
            <tei:binary value="false"/>
          </tei:f>
          </tei:fs>
        <tei:fs type="opensiddur:recitation"><tei:f name="repetition"><tei:binary value="false"/></tei:f><tei:f name="silent"><tei:binary value="true"/></tei:f></tei:fs></j:declare><tei:pb n="190" ed="1949 chol/arvit/opening" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n214_medium.jpg"/><tei:note type="instruction" xml:lang="en">On Saturday night, Ma‘ariv is preceded by Psalms 144 and 67 (page 536).</tei:note>        <j:conditional xml:id="arvit_opening">
          <tei:note type="instruction" xml:lang="en">On weekdays, if Ma‘ariv is not recited immediately after Minḥah, the evening service begins on this page.</tei:note>
<j:none>          <tei:fs type="opensiddur:service-context">
            <tei:f name="immediately-after-minha">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:day-of-week">
