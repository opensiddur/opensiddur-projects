<tei:div corresp="urn:x-opensiddur:text:siddur:chol/arvit/opening"><tei:head xml:lang="en" resp="urn:x-opensiddur:contributor:opensiddur.org/efraim-feinstein">Opening of the evening service</tei:head>        <j:declare xml:id="unit_service">
