    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_the_government_of_the_united_states_of_america_seixas">
        <tei:head>הַנּוֹתֵן תְּשׁוּעָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_government_of_the_united_states_of_america_seixas/1"/>
        <tei:lg>
          <tei:l>הַנּוֺתֵן תְּשׁוּעָה לַמְּלָכִים</tei:l>
          <tei:l>וּמֶמְשָׁלָה לַנְּסִיכִים</tei:l>
          <tei:l>מַלְכוּתְךָ וּמֶמְשֶׁלְתְּךָ כָּל־עוֹלָמִים</tei:l>
          <tei:l>הַפּוֹצֶה אֶת דָּוִד עַבְדּוֹ מֵחֶרֶב רָעָה</tei:l>
          <tei:l>הַנּוֹתֵן בַּיַם דֶרֶךְ</tei:l>
          <tei:l>וּבְמַיִם עַזִּים נְתִיבָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_government_of_the_united_states_of_america_seixas/2"/>
        <tei:lg>
          <tei:l>הוּא יְבָרֵךְ וְיִשְׁמוֺר וְיַעֲזוֺר וִיגַדֵּל</tei:l>
          <tei:l>וִינַשֵּׂא לְמַֽעְלָה לְמַֽעְלָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_government_of_the_united_states_of_america_seixas/3"/>
        <tei:lg>
          <tei:l>הַמֶּלֶךְ מַלְכֵי הַמְלָכִים בְּרַחֲמָיו</tei:l>
          <tei:l>יִשְׁמְרֶהוּ וִיחַיֵיהוּ וּמִכָּל צָרָה וָנֶזֶק יַצִילֵהוּ׃</tei:l>
        </tei:lg>
      </tei:div>
