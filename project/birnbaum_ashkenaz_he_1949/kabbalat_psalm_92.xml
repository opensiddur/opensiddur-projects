<tei:div corresp="urn:x-opensiddur:text:bible:psalms/92"><tei:head xml:lang="he">תהלים צב</tei:head>
<tei:pb n="247" ed="1949 shabbat/kabbalat_shabbat" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n271_medium.jpg"/>
<tei:p>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/1"/>
מִזְמוֹר שִׁיר לְיוֹם הַשַּׁבָּת.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/2"/>
טוֹב לְהֹדוֹת לַייָ, וּלְזַמֵּר לְשִׁמְךָ עֶלְיוֹן.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/3"/>
לְהַגִּיד בַּבֹּקֶר חַסְדֶּךָ, וֶאֱמוּנָתְךָ בַּלֵּילוֹת.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/4"/>
עֲלֵי עָשׂוֹר וַעֲלֵי נָבֶל, עֲלֵי הִגָּיוֹן בְּכִנּוֹר.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/5"/>
כִּי שִׂמַּחְתַּנִי יְיָ בְּפָעֳלֶךָ; בְּמַעֲשֵׂי יָדֶיךָ אֲרַנֵּן.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/6"/>
מַה גָּדְלוּ מַעֲשֶׂיךָ יְיָ; מְאֹד עָמְקוּ מַחְשְׁבֹתֶיךָ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/7"/>
אִישׁ בַּעַר לֹא יֵדָע, וּכְסִיל לֹא יָבִין אֶת זֹאת.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/8"/>
בִּפְרֹחַ רְשָׁעִים כְּמוֹ עֵשֶׂב, וַיָּצִיצוּ כָּל פֹּעֲלֵי אָוֶן, לְהִשָּׁמְדָם עֲדֵי עַד.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/9"/>
וְאַתָּה מָרוֹם לְעֹלָם, יְיָ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/10"/>
כִּי הִנֵּה אֹיְבֶיךָ, יְיָ, כִּי הִנֵּה אֹיְבֶיךָ יֹאבֵדוּ, יִתְפָּרְדוּ כָּל פֹּעֲלֵי אָוֶן.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/11"/>
וַתָּרֶם כִּרְאֵים קַרְנִי; בַּלֹּתִי בְּשֶׁמֶן רַעֲנָן.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/12"/>
וַתַּבֵּט עֵינִי בְּשׁוּרָי, בַּקָּמִים עָלַי מְרֵעִים תִּשְׁמַעְנָה אָזְנָי.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/13"/>
צַדִּיק כַּתָּמָר יִפְרָח, כְּאֶרֶז בַּלְּבָנוֹן יִשְׂגֶּה.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/14"/>
שְׁתוּלִים בְּבֵית יְיָ, בְּחַצְרוֹת אֱלֹהֵינוּ יַפְרִיחוּ.
<tei:milestone unit="verse"/><tei:note type="instruction" xml:lang="en">Reader</tei:note>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/15"/>
עוֹד יְנוּבוּן בְּשֵׂיבָה, דְּשֵׁנִים וְרַעֲנַנִּים יִהְיוּ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/16"/>
לְהַגִּיד כִּי יָשָׁר יְיָ; צוּרִי, וְלֹא עַוְלָתָה בּוֹ.
<tei:milestone unit="verse"/></tei:p></tei:div>
