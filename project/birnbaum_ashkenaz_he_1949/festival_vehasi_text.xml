<tei:div corresp="urn:x-opensiddur:text:prayer:amidah/vehasiaynu_hashem_elohaynu"><tei:pb n="591" ed="1949 regalim" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n615_medium.jpg"/><tei:p>וְהַשִּׂיאֵֽנוּ, יְיָ אֱלֹהֵֽינוּ, אֶת בִּרְכַּת מוֹעֲדֶֽיךָ לְחַיִּים וּלְשָׁלוֹם, לְשִׂמְחָה וּלְשָׂשׂוֹן, כַּאֲשֶׁר רָצִֽיתָ וְאָמַֽרְתָּ לְבָרְכֵֽנוּ. אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ, <j:conditional xml:id="festival_vehasi_shabbat_0">
          <tei:note type="instruction" xml:lang="en">On the Sabbath:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>רְצֵה בִמְנוּחָתֵֽנוּ<j:endConditional target="#festival_vehasi_shabbat_0"/> קַדְּשֵֽׁנוּ בְּמִצְוֹתֶֽיךָ וְתֵן חֶלְקֵֽנוּ <tei:pb n="593" ed="1949 regalim" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n617_medium.jpg"/>בְּתוֹרָתֶֽךָ, שַׂבְּעֵֽנוּ מִטּוּבֶֽךָ וְשַׂמְּחֵֽנוּ בִּישׁוּעָתֶֽךָ, וְטַהֵר לִבֵּֽנוּ לְעָבְדְּךָ בֶּאֱמֶת; וְהַנְחִילֵֽנוּ, יְיָ אֱלֹהֵֽינוּ, <j:conditional xml:id="festival_vehasi_shabbat_1">
          <tei:note type="instruction" xml:lang="en">On the Sabbath:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>בְּאַהֲבָה וּבְרָצוֹן<j:endConditional target="#festival_vehasi_shabbat_1"/> בְּשִׂמְחָה וּבְשָׂשׂוֹן <j:conditional xml:id="festival_vehasi_shabbat_2">
          <tei:note type="instruction" xml:lang="en">On the Sabbath:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>שַׁבָּת וּ<j:endConditional target="#festival_vehasi_shabbat_2"/>מוֹעֲדֵי קָדְשֶֽׁךָ, וְיִשְׂמְחוּ בְךָ יִשְׂרָאֵל מְקַדְּשֵׁי שְׁמֶֽךָ. בָּרוּךְ אַתָּה, יְיָ, מְקַדֵּשׁ <j:conditional xml:id="festival_vehasi_shabbat_3">
          <tei:note type="instruction" xml:lang="en">On the Sabbath:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>הַשַּׁבָּת וְ<j:endConditional target="#festival_vehasi_shabbat_3"/>יִשְׂרָאֵל וְהַזְּמַנִּים.</tei:p></tei:div>
