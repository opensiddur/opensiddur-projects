<tei:div corresp="urn:x-opensiddur:text:bible:psalms/96"><tei:head xml:lang="he">תהלים צו</tei:head>
<tei:pb n="237" ed="1949 shabbat/kabbalat_shabbat" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n261_medium.jpg"/>
<tei:p>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/96/1"/>
שִׁירוּ לַייָ שִׁיר חָדָשׁ, שִׁירוּ לַייָ כָּל הָאָרֶץ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/96/2"/>
שִׁירוּ לַייָ בָּרְכוּ שְׁמוֹ, בַּשְּׂרוּ מִיּוֹם לְיוֹם יְשׁוּעָתוֹ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/96/3"/>
סַפְּרוּ בַגּוֹיִם כְּבוֹדוֹ, בְּכָל הָעַמִּים נִפְלְאוֹתָיו.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/96/4"/>
כִּי גָדוֹל יְיָ וּמְהֻלָּל מְאֹד, נוֹרָא הוּא עַל כָּל אֱלֹהִים.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/96/5"/>
כִּי כָּל אֱלֹהֵי הָעַמִּים אֱלִילִים, וַייָ שָׁמַיִם עָשָׂה.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/96/6"/>
הוֹד <tei:pb n="239" ed="1949 shabbat/kabbalat_shabbat" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n263_medium.jpg"/>וְהָדָר לְפָנָיו, עֹז וְתִפְאֶרֶת בְּמִקְדָּשׁוֹ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/96/7"/>
הָבוּ לַייָ, מִשְׁפְּחוֹת עַמִּים, הָבוּ לַייָ כָּבוֹד וָעֹז.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/96/8"/>
הָבוּ לַייָ כְּבוֹד שְׁמוֹ, שְׂאוּ מִנְחָה וּבֹאוּ לְחַצְרוֹתָיו.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/96/9"/>
הִשְׁתַּחֲווּ לַייָ בְּהַדְרַת קֹדֶשׁ, חִילוּ מִפָּנָיו כָּל הָאָרֶץ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/96/10"/>
אִמְרוּ בַגּוֹיִם יְיָ מָלָךְ, אַף תִּכּוֹן תֵּבֵל בַּל תִּמּוֹט; יָדִין עַמִּים בְּמֵישָׁרִים.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/96/11"/>
יִשְׂמְחוּ הַשָּׁמַיִם וְתָגֵל הָאָרֶץ; יִרְעַם הַיָּם וּמְלֹאוֹ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/96/12"/>
יַעֲלֹז שָׂדַי וְכָל אֲשֶׁר בּוֹ; אָז יְרַנְּנוּ כָּל עֲצֵי יָעַר.
<tei:milestone unit="verse"/><tei:note type="instruction" xml:lang="en">Reader</tei:note>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/96/13"/>
לִפְנֵי יְיָ כִּי בָא, כִּי בָא לִשְׁפֹּט הָאָרֶץ; יִשְׁפֹּט תֵּבֵל בְּצֶדֶק, וְעַמִּים בֶּאֱמוּנָתוֹ.
<tei:milestone unit="verse"/></tei:p></tei:div>
