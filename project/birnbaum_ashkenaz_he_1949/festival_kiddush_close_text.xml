<tei:p><tei:pb n="599" ed="1949 regalim" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n623_medium.jpg"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:regalim/text/kiddush_close"/><j:conditional xml:id="festival_kiddush_close_shabbat_0">
          <tei:note type="instruction" xml:lang="en">On the Sabbath:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>בְּאַהֲבָה<j:endConditional target="#festival_kiddush_close_shabbat_0"/> מִקְרָא קֹֽדֶשׁ, זֵֽכֶר לִיצִיאַת מִצְרָֽיִם. כִּי בָֽנוּ בָחַֽרְתָּ, וְאוֹתָֽנוּ קִדַּֽשְׁתָּ מִכָּל הָעַמִּים, <j:conditional xml:id="festival_kiddush_close_shabbat_1">
          <tei:note type="instruction" xml:lang="en">On the Sabbath:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>וְשַׁבָּת<j:endConditional target="#festival_kiddush_close_shabbat_1"/> וּמוֹעֲדֵי קָדְשְׁךָ <j:conditional xml:id="festival_kiddush_close_shabbat_2">
          <tei:note type="instruction" xml:lang="en">On the Sabbath:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>בְּאַהֲבָה וּבְרָצוֹן<j:endConditional target="#festival_kiddush_close_shabbat_2"/> בְּשִׂמְחָה וּבְשָׂשׂוֹן הִנְחַלְתָּֽנוּ. בָּרוּךְ אַתָּה, יְיָ, מְקַדֵּשׁ <j:conditional xml:id="festival_kiddush_close_shabbat_3">
          <tei:note type="instruction" xml:lang="en">On the Sabbath:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>הַשַּׁבָּת וְ<j:endConditional target="#festival_kiddush_close_shabbat_3"/>יִשְׂרָאֵל וְהַזְּמַנִּים.<tei:milestone unit="prayer-part"/></tei:p>
