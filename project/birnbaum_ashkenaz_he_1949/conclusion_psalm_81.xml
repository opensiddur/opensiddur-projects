<tei:div corresp="urn:x-opensiddur:text:bible:psalms/81">
<tei:head xml:lang="he">תהלים פא</tei:head>
<tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/81/1" xml:id="ref_1"/>לַמְנַצֵּֽחַ עַל הַגִּתִּית לְאָסָף. <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/81/2" xml:id="ref_2"/>הַרְנִֽינוּ לֵאלֹהִים עוּזֵּֽנוּ, הָרִֽיעוּ לֵאלֹהֵי יַעֲקֹב. <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/81/3" xml:id="ref_3"/>שְׂאוּ זִמְרָה וּתְנוּ תֹף, כִּנּוֹר נָעִים עִם נָֽבֶל. <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/81/4" xml:id="ref_4"/>תִּקְעוּ בַחֹֽדֶשׁ שׁוֹפָר, בַּכֵּֽסֶה לְיוֹם חַגֵּֽנוּ. <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/81/5" xml:id="ref_5"/>כִּי חֹק לְיִשְׂרָאֵל הוּא, מִשְׁפָּט לֵאלֹהֵי יַעֲקֹב. <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/81/6" xml:id="ref_6"/>עֵדוּת בִּיהוֹסֵף שָׂמוֹ, בְּצֵאתוֹ עַל אֶֽרֶץ מִצְרָֽיִם; שְׂפַת לֹא יָדַֽעְתִּי אֶשְׁמָע. <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/81/7" xml:id="ref_7"/>הֲסִירֽוֹתִי מִסֵּֽבֶל שִׁכְמוֹ, כַּפָּיו מִדּוּד תַּעֲבֹֽרְנָה. <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/81/8" xml:id="ref_8"/>בַּצָּרָה קָרָֽאתָ וָאֲחַלְּצֶֽךָּ, אֶעֶנְךָ בְּסֵֽתֶר רַֽעַם; אֶבְחָנְךָ עַל מֵי מְרִיבָה, סֶֽלָה. <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/81/9" xml:id="ref_9"/>שְׁמַע עַמִּי, וְאָעִֽידָה בָּךְ, יִשְׂרָאֵל אִם תִּשְׁמַע לִי. <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/81/10" xml:id="ref_10"/>לֹא יִהְיֶה בְךָ אֵל זָר, וְלֹא תִשְׁתַּחֲוֶה לְאֵל נֵכָר. <tei:milestone unit="verse"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/psalms/81/11"/><tei:seg xml:id="ref_11" source="urn:x-opensiddur:text:bible:psalms/81/11">אָנֹכִי יְיָ אֱלֹהֶֽיךָ, הַמַּעַלְךָ מֵאֶֽרֶץ מִצְרָֽיִם; הַרְחֶב־פִּֽיךָ וַאֲמַלְאֵֽהוּ.</tei:seg> <tei:milestone unit="prayer-part"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/81/12" xml:id="ref_12"/>וְלֹא שָׁמַע עַמִּי לְקוֹלִי, וְיִשְׂרָאֵל לֹא אָֽבָה לִי. <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/81/13" xml:id="ref_13"/>וָאֲשַׁלְּחֵֽהוּ בִּשְׁרִירוּת לִבָּם, יֵלְכוּ בְּמוֹעֲצוֹתֵיהֶם. <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/81/14" xml:id="ref_14"/>לוּ עַמִּי שֹׁמֵֽעַ לִי, יִשְׂרָאֵל בִּדְרָכַי יְהַלֵּֽכוּ. <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/81/15" xml:id="ref_15"/>כִּמְעַט אוֹיְבֵיהֶם אַכְנִֽיעַ, וְעַל צָרֵיהֶם אָשִׁיב יָדִי. <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/81/16" xml:id="ref_16"/>מְשַׂנְאֵי יְיָ יְכַחֲשׁוּ לוֹ, וִיהִי עִתָּם לְעוֹלָם. <tei:milestone unit="verse"/><tei:note type="instruction" xml:lang="en">Reader</tei:note><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/81/17" xml:id="ref_17"/>וַיַּאֲכִילֵֽהוּ מֵחֵֽלֶב חִטָּה, וּמִצּוּר דְּבַשׁ אַשְׂבִּיעֶֽךָ. <tei:milestone unit="verse"/></tei:p>
