<tei:p><tei:pb n="671" ed="1949 rosh hashana and erev yom kippur" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n695_medium.jpg"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/text/psalm130"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/text/psalm130/psalms/130/1"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/130/1">שִׁיר הַמַּעֲלוֹת. מִמַּעֲמַקִּים קְרָאתִֽיךָ, יְיָ.</tei:seg><tei:milestone unit="verse"/> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/text/psalm130/psalms/130/2"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/130/2">אֲדֹנָי, שִׁמְעָה בְקוֹלִי, תִּהְיֶֽינָה אָזְנֶֽיךָ קַשֻּׁבוֹת לְקוֹל תַּחֲנוּנָי.</tei:seg><tei:milestone unit="verse"/> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/text/psalm130/psalms/130/3"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/130/3">אִם עֲוֺנוֹת תִּשְׁמָר־יָהּ, אֲדֹנָי מִי יַעֲמֹד.</tei:seg><tei:milestone unit="verse"/> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/text/psalm130/psalms/130/4"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/130/4">כִּי עִמְּךָ הַסְּלִיחָה, לְמַֽעַן תִּוָּרֵא.</tei:seg><tei:milestone unit="verse"/> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/text/psalm130/psalms/130/5"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/130/5">קִוִּֽיתִי יְיָ, קִוְּתָה נַפְשִׁי, וְלִדְבָרוֹ הוֹחָֽלְתִּי.</tei:seg><tei:milestone unit="verse"/> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/text/psalm130/psalms/130/6"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/130/6">נַפְשִׁי לַאדֹנָי מִשֹּׁמְרִים לַבֹּֽקֶר, שֹׁמְרִים לַבֹּֽקֶר.</tei:seg><tei:milestone unit="verse"/> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/text/psalm130/psalms/130/7"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/130/7">יַחֵל יִשְׂרָאֵל אֶל יְיָ, כִּי עִם יְיָ הַחֶֽסֶד, וְהַרְבֵּה עִמּוֹ פְדוּת.</tei:seg><tei:milestone unit="verse"/> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/text/psalm130/psalms/130/8"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/130/8">וְהוּא יִפְדֶּה אֶת יִשְׂרָאֵל מִכֹּל עֲוֺנֹתָיו.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="prayer-part"/></tei:p>
