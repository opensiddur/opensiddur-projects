<tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/uvnucho">
<tei:p>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/10/36"/>וּבְנֻחֹה יֹאמַר: שׁוּבָה, יְיָ, רִבְבוֹת אַלְפֵי יִשְׂרָאֵל.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/132/8"/>קוּמָה יְיָ לִמְנוּחָתֶֽךָ, אַתָּה וַאֲרוֹן עֻזֶּֽךָ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/132/9"/>כֹּהֲנֶֽיךָ יִלְבְּשׁוּ צֶֽדֶק, וַחֲסִידֶֽיךָ יְרַנֵּֽנוּ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/132/10"/>בַּעֲבוּר דָּוִד עַבְדֶּֽךָ אַל תָּשֵׁב פְּנֵי מְשִׁיחֶֽךָ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/4/2"/>כִּי לֶֽקַח טוֹב נָתַֽתִּי לָכֶם, תּוֹרָתִי אַל תַּעֲזֹֽבוּ.
<tei:milestone unit="verse"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/uvnucho/etz"/><tei:seg source="urn:x-opensiddur:text:bible:proverbs/3/18">עֵץ חַיִּים הִיא לַמַּחֲזִיקִים בָּהּ, וְתֹמְכֶֽיהָ מְאֻשָּׁר.</tei:seg>
<tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/uvnucho/derakheha"/><tei:seg source="urn:x-opensiddur:text:bible:proverbs/3/17">דְּרָכֶֽיהָ דַרְכֵי נֹֽעַם, וְכָל נְתִיבוֹתֶֽיהָ שָׁלוֹם.</tei:seg>
<tei:milestone unit="prayer-part"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:lamentations/5/21"/>הֲשִׁיבֵֽנוּ יְיָ אֵלֶֽיךָ וְנָשֽׁוּבָה: חַדֵּשׁ יָמֵֽינוּ כְּקֶֽדֶם.
<tei:milestone unit="verse"/>
</tei:p>
