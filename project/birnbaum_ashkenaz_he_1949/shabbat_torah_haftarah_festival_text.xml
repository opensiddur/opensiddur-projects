<tei:div corresp="urn:x-opensiddur:text:prayer:birkhot_haftarah/al_hatorah_festival"><tei:pb n="375" ed="1949 shabbat/shacharit/torah" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n399_medium.jpg"/><tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:birkhot_haftarah/al_hatorah_festival/al"/>עַל הַתּוֹרָה וְעַל הָעֲבוֹדָה וְעַל הַנְּבִיאִים         <j:conditional xml:id="shabbat_torah_haftarah_festival_al_shabbat_day">
          <tei:note type="instruction" xml:lang="en">On the Sabbath:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>וְעַל יוֹם הַשַּׁבָּת הַזֶּה        <j:endConditional target="#shabbat_torah_haftarah_festival_al_shabbat_day"/> וְעַל יוֹם         <j:conditional xml:id="shabbat_torah_haftarah_festival_al_pesah">
          <tei:note type="instruction" xml:lang="en">On Passover:</tei:note>
          <tei:fs type="opensiddur:holiday">
            <tei:f name="pesah">
              <tei:numeric value="1" max="8"/>
            </tei:f>
          </tei:fs>
        </j:conditional>חַג הַמַּצּוֹת        <j:endConditional target="#shabbat_torah_haftarah_festival_al_pesah"/>         <j:conditional xml:id="shabbat_torah_haftarah_festival_al_shavuot">
          <tei:note type="instruction" xml:lang="en">On Shavuoth:</tei:note>
          <tei:fs type="opensiddur:holiday">
            <tei:f name="shavuot">
              <tei:numeric value="1" max="2"/>
            </tei:f>
          </tei:fs>
        </j:conditional>חַג הַשָּׁבֻעוֹת        <j:endConditional target="#shabbat_torah_haftarah_festival_al_shavuot"/>         <j:conditional xml:id="shabbat_torah_haftarah_festival_al_sukkot">
          <tei:note type="instruction" xml:lang="en">On Sukkoth:</tei:note>
          <tei:fs type="opensiddur:holiday">
            <tei:f name="sukkot">
              <tei:numeric value="1" max="7"/>
            </tei:f>
          </tei:fs>
        </j:conditional>חַג הַסֻּכּוֹת        <j:endConditional target="#shabbat_torah_haftarah_festival_al_sukkot"/>         <j:conditional xml:id="shabbat_torah_haftarah_festival_al_shmini-atzeret">
          <tei:note type="instruction" xml:lang="en">On Shemini Atsereth:</tei:note>
          <tei:fs type="opensiddur:holiday">
            <tei:f name="shmini-atzeret">
              <tei:numeric value="1" max="2"/>
            </tei:f>
          </tei:fs>
        </j:conditional>הַשְּׁמִינִי חַג הָעֲצֶרֶת        <j:endConditional target="#shabbat_torah_haftarah_festival_al_shmini-atzeret"/> הַזֶּה, שֶׁנָּתַתָּ לָנוּ, יְיָ אֱלֹהֵינוּ,         <j:conditional xml:id="shabbat_torah_haftarah_festival_al_shabbat_rest">
          <tei:note type="instruction" xml:lang="en">On the Sabbath:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>לִקְדֻשָּׁה וְלִמְנוּחָה        <j:endConditional target="#shabbat_torah_haftarah_festival_al_shabbat_rest"/> לְשָׂשׂוֹן וּלְשִׂמְחָה לְכָבוֹד וּלְתִפְאָרֶת. </tei:p><tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:birkhot_haftarah/al_hatorah_festival/seal"/><tei:pb n="377" ed="1949 shabbat/shacharit/torah" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n401_medium.jpg"/>עַל הַכֹּל, יְיָ אֱלֹהֵינוּ, אֲנַחְנוּ מוֹדִים לָךְ, וּמְבָרְכִים אוֹתָךְ; יִתְבָּרַךְ שִׁמְךָ בְּפִי כָּל חַי תָּמִיד לְעוֹלָם וָעֶד. בָּרוּךְ אַתָּה, יְיָ, מְקַדֵּשׁ         <j:conditional xml:id="shabbat_torah_haftarah_festival_seal_shabbat_seal">
          <tei:note type="instruction" xml:lang="en">On the Sabbath:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>הַשַּׁבָּת וְ        <j:endConditional target="#shabbat_torah_haftarah_festival_seal_shabbat_seal"/> יִשְׂרָאֵל וְהַזְּמַנִּים. <tei:milestone unit="prayer-part"/></tei:p></tei:div>
    </tei:body>
  </tei:text>
