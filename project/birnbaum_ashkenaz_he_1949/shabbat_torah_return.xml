<tei:div corresp="urn:x-opensiddur:text:siddur:shabbat/shacharit/torah/return"><tei:head xml:lang="he" resp="urn:x-opensiddur:contributor:opensiddur.org/efraim-feinstein">הכנסת ספר תורה</tei:head><tei:pb n="387" ed="1949 shabbat/shacharit/torah" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n411_medium.jpg"/>        <j:conditional xml:id="shabbat_torah_public_return">
          <tei:note type="instruction" xml:lang="en">When a minyan holds service:</tei:note>
          <tei:fs type="opensiddur:quorum">
            <tei:f name="minyan">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional><tei:note type="instruction" xml:lang="en">The Reader takes the Torah and recites:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:siddur:chol/shacharit/torah/yehalelu"/>        <j:conditional xml:id="shabbat_torah_psalm29">
          <tei:note type="instruction" xml:lang="en">On Sabbaths:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/29"/>        <j:endConditional target="#shabbat_torah_psalm29"/>        <j:conditional xml:id="shabbat_torah_psalm24">
          <tei:note type="instruction" xml:lang="en">On festivals occurring on weekdays:</tei:note>
<j:all>          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="yom-tov">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs><j:none>          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs></j:none></j:all>
        </j:conditional><tei:div corresp="urn:x-opensiddur:text:siddur:shabbat/shacharit/torah/return/psalm24"><j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/24"/></tei:div>        <j:endConditional target="#shabbat_torah_psalm24"/><tei:note type="instruction" xml:lang="en">While the Torah is being placed in the ark:</tei:note><tei:div corresp="urn:x-opensiddur:text:siddur:shabbat/shacharit/torah/return/uvnucho"><j:transclude type="external" target="urn:x-opensiddur:text:siddur:chol/shacharit/torah/uvnucho"/></tei:div>        <j:endConditional target="#shabbat_torah_public_return"/></tei:div>
