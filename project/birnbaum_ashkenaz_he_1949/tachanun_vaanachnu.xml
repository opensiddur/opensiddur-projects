<tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/tachanun/vaanachnu">
<tei:p><tei:milestone unit="prayer" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/tachanun/vaanachnu/text"/>
<tei:seg corresp="urn:x-opensiddur:text:siddur:chol/shacharit/tachanun/vaanachnu/vaanachnu" source="urn:x-opensiddur:text:bible:chronicles_2/20/12">וַאֲנַֽחְנוּ לֹא נֵדַע מַה נַּעֲשֶׂה, כִּי עָלֶֽיךָ עֵינֵֽינוּ. </tei:seg>
<tei:seg corresp="urn:x-opensiddur:text:siddur:chol/shacharit/tachanun/vaanachnu/zekhor" source="urn:x-opensiddur:text:bible:psalms/25/6">זְכֹר רַחֲמֶיךָ יְיָ, וַחֲסָדֶֽיךָ, כִּי מֵעוֹלָם הֵֽמָּה. </tei:seg>
<tei:seg corresp="urn:x-opensiddur:text:siddur:chol/shacharit/tachanun/vaanachnu/yehi" source="urn:x-opensiddur:text:bible:psalms/33/22">יְהִי חַסְדְּךָ יְיָ עָלֵֽינוּ, כַּאֲשֶׁר יִחַֽלְנוּ לָךְ. </tei:seg>
<tei:seg corresp="urn:x-opensiddur:text:siddur:chol/shacharit/tachanun/vaanachnu/al_tizkor" source="urn:x-opensiddur:text:bible:psalms/79/8">אַל תִּזְכָּר־לָֽנוּ עֲוֹנוֹת רִאשֹׁנִים; מַהֵר יְקַדְּמֽוּנוּ רַחֲמֶֽיךָ, כִּי דַלּֽוֹנוּ מְאֹד. </tei:seg>
<tei:seg corresp="urn:x-opensiddur:text:siddur:chol/shacharit/tachanun/vaanachnu/chonenu" source="urn:x-opensiddur:text:bible:psalms/123/3">חָנֵּֽנוּ יְיָ חָנֵּֽנוּ, כִּי רַב שָׂבַֽעְנוּ בוּז. </tei:seg>
<tei:seg corresp="urn:x-opensiddur:text:siddur:chol/shacharit/tachanun/vaanachnu/berogez" source="urn:x-opensiddur:text:bible:habakkuk/3/2">בְּרֹֽגֶז רַחֵם תִּזְכּוֹר. </tei:seg>
<tei:seg corresp="urn:x-opensiddur:text:siddur:chol/shacharit/tachanun/vaanachnu/ki_hu" source="urn:x-opensiddur:text:bible:psalms/103/14">כִּי הוּא יָדַע יִצְרֵֽנוּ, זָכוּר כִּי עָפָר אֲנָֽחְנוּ. <tei:note type="instruction" xml:lang="en">Reader</tei:note> </tei:seg>
<tei:seg corresp="urn:x-opensiddur:text:siddur:chol/shacharit/tachanun/vaanachnu/ozrenu" source="urn:x-opensiddur:text:bible:psalms/79/9">עָזְרֵֽנוּ, אֱלֹהֵי יִשְׁעֵֽנוּ, עַל דְּבַר כְּבוֹד שְׁמֶֽךָ, וְהַצִּילֵֽנוּ וְכַפֵּר עַל חַטֹּאתֵֽינוּ לְמַֽעַן שְׁמֶֽךָ.</tei:seg>
</tei:p>
