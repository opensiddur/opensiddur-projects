<tei:p><tei:pb n="629" ed="1949 festival musaf" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n653_medium.jpg"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:regalim/musaf/text/kohanim_response_3_6"/><tei:note type="instruction" xml:lang="en">Kohanim:</tei:note>לְךָ <tei:note type="instruction" xml:lang="en">Congregation:</tei:note><tei:seg source="urn:x-opensiddur:text:bible:chronicles_1/29/11">לְךָ, יְיָ, הַגְּדֻלָּה וְהַגְּבוּרָה וְהַתִּפְאֶֽרֶת וְהַנֵּֽצַח וְהַהוֹד, כִּי כֹל בַּשָּׁמַֽיִם וּבָאָֽרֶץ; לְךָ, יְיָ, הַמַּמְלָכָה וְהַמִּתְנַשֵּׂא לְכֹל לְרֹאשׁ.</tei:seg><tei:milestone unit="verse"/></tei:p>
