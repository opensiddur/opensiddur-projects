<tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vetiggaleh">
<tei:p>
<tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vetiggaleh/vetiggaleh"/>וְתִגָּלֶה וְתֵרָאֶה מַלְכוּתוֹ עָלֵֽינוּ בִּזְמַן קָרוֹב, וְיָחֹן פְּלֵטָתֵֽנוּ וּפְלֵטַת עַמּוֹ בֵּית יִשְׂרָאֵל לְחֵן וּלְחֶֽסֶד, לְרַחֲמִים וּלְרָצוֹן, וְנֹאמַר אָמֵן. הַכֹּל הָבוּ גֹֽדֶל לֵאלֹהֵֽינוּ, וּתְנוּ כָבוֹד לַתּוֹרָה. כֹּהֵן קְרָב; יַעֲמֹד (פְּלוֹנִי בֶּן פְּלוֹנִי) הַכֹּהֵן.
<tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vetiggaleh/barukh"/>בָּרוּךְ שֶׁנָּתַן תּוֹרָה לְעַמּוֹ יִשְׂרָאֵל בִּקְדֻשָּׁתוֹ.
<tei:milestone unit="prayer-part"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vetiggaleh/psalms_19_8"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/19/8">תּוֹרַת יְיָ תְּמִימָה, מְשִֽׁיבַת נָֽפֶשׁ. עֵדוּת יְיָ נֶאֱמָנָה, מַחְכִּֽימַת פֶּֽתִי.
</tei:seg><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vetiggaleh/psalms_19_9"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/19/9">פִּקּוּדֵי יְיָ יְשָׁרִים, מְשַׂמְּחֵי לֵב: מִצְוַת יְיָ בָּרָה, מְאִירַת עֵינָֽיִם.
</tei:seg><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vetiggaleh/psalms_29_11"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/11">יְיָ עֹז לְעַמּוֹ יִתֵּן: יְיָ יְבָרֵךְ אֶת עַמּוֹ בַשָּׁלוֹם.
</tei:seg><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/18/31"/>הָאֵל תָּמִים דַּרְכּוֹ; אִמְרַת יְיָ צְרוּפָה, מָגֵן הוּא לְכֹל הַחֹסִים בּוֹ.
<tei:milestone unit="verse"/>
</tei:p>
