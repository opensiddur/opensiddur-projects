<tei:div corresp="urn:x-opensiddur:text:prayer:kapparot/fowl"><tei:pb n="673" ed="1949 rosh hashana and erev yom kippur" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n697_medium.jpg"/><tei:p><j:conditional xml:id="festival_rh_bird_rooster">
          <tei:note type="instruction" xml:lang="en">With a rooster:</tei:note>
          <tei:fs type="opensiddur:practice">
            <tei:f name="kapparot-object">
              <tei:symbol value="rooster"/>
            </tei:f>
          </tei:fs>
        </j:conditional>זֶה חֲלִיפָתֵֽנוּ, זֶה תְּמוּרָתֵֽנוּ, זֶה כַּפָּרָתֵֽנוּ, זֶה הַתַּרְנְגֹל יֵלֵךְ לְמִיתָה, וַאֲנַֽחְנוּ נִכָּנֵס וְנֵלֵךְ לְחַיִּים טוֹבִים אֲרֻכִּים וּלְשָׁלוֹם.<j:endConditional target="#festival_rh_bird_rooster"/> <j:conditional xml:id="festival_rh_bird_hen">
          <tei:note type="instruction" xml:lang="en">With a hen:</tei:note>
          <tei:fs type="opensiddur:practice">
            <tei:f name="kapparot-object">
              <tei:symbol value="hen"/>
            </tei:f>
          </tei:fs>
        </j:conditional>זֹאת חֲלִיפָתֵֽנוּ, זֹאת תְּמוּרָתֵֽנוּ, זֹאת כַּפָּרָתֵֽנוּ, זֹאת הַתַּרְנְגֹֽלֶת תֵּלֵךְ לְמִיתָה, וַאֲנַֽחְנוּ נִכָּנֵס וְנֵלֵךְ לְחַיִּים טוֹבִים אֲרֻכִּים וּלְשָׁלוֹם.<j:endConditional target="#festival_rh_bird_hen"/> </tei:p></tei:div>
