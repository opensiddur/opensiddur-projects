<tei:div corresp="urn:x-opensiddur:text:prayer:kiddush_rosh_hashanah"><tei:pb n="667" ed="1949 rosh hashana and erev yom kippur" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n691_medium.jpg"/><tei:p>בָּרוּךְ אַתָּה, יְיָ אֱלֹהֵֽינוּ, מֶֽלֶךְ הָעוֹלָם, אֲשֶׁר בָּֽחַר בָּֽנוּ מִכָּל עָם, וְרוֹמְמָֽנוּ מִכָּל לָשׁוֹן, וְקִדְּשָֽׁנוּ בְּמִצְוֺתָיו. וַתִּתֶּן לָֽנוּ, יְיָ אֱלֹהֵֽינוּ, בְּאַהֲבָה אֶת יוֹם <j:conditional xml:id="festival_rh_kiddush_shabbat_0">
          <tei:note type="instruction" xml:lang="en">On the Sabbath:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>הַשַּׁבָּת הַזֶּה וְאֶת יוֹם<j:endConditional target="#festival_rh_kiddush_shabbat_0"/> הַזִּכָּרוֹן הַזֶּה, יוֹם <j:conditional xml:id="festival_rh_kiddush_shabbat_1">
          <tei:note type="instruction" xml:lang="en">On the Sabbath:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>זִכְרוֹן<j:endConditional target="#festival_rh_kiddush_shabbat_1"/> תְּרוּעָה <j:conditional xml:id="festival_rh_kiddush_shabbat_2">
          <tei:note type="instruction" xml:lang="en">On the Sabbath:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>בְּאַהֲבָה<j:endConditional target="#festival_rh_kiddush_shabbat_2"/> מִקְרָא קֹֽדֶשׁ, זֵֽכֶר לִיצִיאַת מִצְרָֽיִם. כִּי בָֽנוּ בָחַֽרְתָּ, וְאוֹתָֽנוּ קִדַּֽשְׁתָּ מִכָּל הָעַמִּים, וּדְבָרְךָ אֱמֶת וְקַיָּם לָעַד. בָּרוּךְ אַתָּה, יְיָ, מֶלֶךְ עַל כָּל הָאָרֶץ, מְקַדֵּשׁ <j:conditional xml:id="festival_rh_kiddush_shabbat_3">
          <tei:note type="instruction" xml:lang="en">On the Sabbath:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>הַשַּׁבָּת וְ<j:endConditional target="#festival_rh_kiddush_shabbat_3"/>יִשְׂרָאֵל וְיוֹם הַזִּכָּרוֹן.</tei:p></tei:div>
