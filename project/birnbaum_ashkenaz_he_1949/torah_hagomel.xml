<tei:div corresp="urn:x-opensiddur:text:prayer:birkat_hagomel">
<tei:p>
<tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:birkat_hagomel/blessing"/>בָּרוּךְ אַתָּה, יְיָ אֱלֹהֵֽינוּ, מֶֽלֶךְ הָעוֹלָם, הַגּוֹמֵל לְחַיָּבִים טוֹבוֹת, שֶׁגְּמָלַֽנִי כָּל טוֹב.
</tei:p><tei:p>
<tei:milestone unit="prayer-part"/><tei:note type="instruction" xml:lang="en">Congregation responds:</tei:note>
<tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:birkat_hagomel/response"/>מִי שֶׁגְּמָלְךָ כָּל טוֹב, הוּא יִגְמָלְךָ כָּל טוֹב סֶֽלָה.
<tei:milestone unit="prayer-part"/>
</tei:p>
