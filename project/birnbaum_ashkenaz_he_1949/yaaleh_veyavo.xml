  <tei:text>
    <tei:body>
        <tei:div corresp="urn:x-opensiddur:text:prayer:yaaleh_veyavo">
          <tei:div>
            <tei:p>(אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ, יַעֲלֶה וְיָבֹא, וְיַגִּֽיעַ וְיֵרָאֶה, וְיֵרָצֶה וְיִשָּׁמַע, וְיִפָּקֵד וְיִזָּכֵר זִכְרוֹנֵֽנוּ וּפִקְדוֹנֵֽנוּ, וְזִכְרוֹן אֲבוֹתֵֽינוּ, וְזִכְרוֹן מָשִֽׁיחַ בֶּן דָּוִד עַבְדֶּֽךָ, וְזִכְרוֹן יְרוּשָׁלַֽיִם עִיר קָדְשֶֽׁךָ, וְזִכְרוֹן כָּל עַמְּךָ בֵּית יִשְׂרָאֵל לְפָנֶֽיךָ, לִפְלֵיטָה וּלְטוֹבָה, לְחֵן וּלְחֶֽסֶד וּלְרַחֲמִים, לְחַיִּים וּלְשָׁלוֹם, בְּיוֹם</tei:p>
          </tei:div>
        <j:conditional xml:id="cond_yvy_rosh_hodesh">
          <tei:note type="instruction" xml:lang="en">Rosh Ḥodesh</tei:note>
          <tei:fs type="opensiddur:holiday">
            <tei:f name="rosh-hodesh">
              <tei:numeric value="1" max="2"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:prayer:yaaleh_veyavo/rosh_hodesh">
            <tei:p>רֹאשׁ הַחֹֽדֶשׁ</tei:p>
          </tei:div>
        <j:endConditional target="#cond_yvy_rosh_hodesh"/>
        <j:conditional xml:id="cond_yvy_pesach">
          <tei:note type="instruction" xml:lang="en">Pesaḥ</tei:note>
          <tei:fs type="opensiddur:holiday">
            <tei:f name="pesah">
              <tei:numeric value="1" max="8"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:prayer:yaaleh_veyavo/pesach">
            <tei:p>חַג הַמַּצּוֹת</tei:p>
          </tei:div>
        <j:endConditional target="#cond_yvy_pesach"/>
        <j:conditional xml:id="cond_yvy_sukkot">
          <tei:note type="instruction" xml:lang="en">Sukkoth</tei:note>
          <tei:fs type="opensiddur:holiday">
            <tei:f name="sukkot">
              <tei:numeric value="1" max="7"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:prayer:yaaleh_veyavo/sukkot">
            <tei:p>חַג הַסֻּכּוֹת</tei:p>
          </tei:div>
        <j:endConditional target="#cond_yvy_sukkot"/>
          <tei:div>
            <tei:p>הַזֶּה. זָכְרֵֽנוּ, יְיָ אֱלֹהֵֽינוּ, בּוֹ לְטוֹבָה, וּפָקְדֵֽנוּ בוֹ לִבְרָכָה, <tei:pb n="91" ed="1949 chol/shacharit/amidah" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n115_medium.jpg"/>וְהוֹשִׁיעֵֽנוּ בוֹ לְחַיִּים; וּבִדְבַר יְשׁוּעָה וְרַחֲמִים חוּס וְחָנֵּֽנוּ, וְרַחֵם עָלֵֽינוּ וְהוֹשִׁיעֵֽנוּ, כִּי אֵלֶֽיךָ עֵינֵֽינוּ, כִּי אֵל מֶֽלֶךְ חַנּוּן וְרַחוּם אָֽתָּה.)</tei:p>
          </tei:div>
        </tei:div>
    </tei:body>
  </tei:text>
