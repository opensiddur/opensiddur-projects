  <tei:text>
    <tei:body>
        <tei:div corresp="urn:x-opensiddur:text:prayer:korbanot/yehi_ratzon_amirah">
          <tei:p>יְהִי רָצוֹן מִלְּפָנֶֽיךָ, יְיָ אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ, שֶׁתְּהֵא אֲמִירָה זוֹ חֲשׁוּבָה וּמְקֻבֶּֽלֶת וּמְרֻצָּה לְפָנֶֽיךָ, כְּאִלּוּ הִקְרַֽבְנוּ קָרְבַּן הַתָּמִיד בְּמוֹעֲדוֹ וּבִמְקוֹמוֹ וּכְהִלְכָתוֹ.</tei:p>
        </tei:div>
    </tei:body>
