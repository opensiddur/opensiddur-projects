<tei:p><tei:pb n="669" ed="1949 rosh hashana and erev yom kippur" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n693_medium.jpg"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/text/min_hametzar"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/text/min_hametzar/psalms/118/5"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/118/5">מִן הַמֵּצַר קָרָֽאתִי יָהּ, עָנָֽנִי בַמֶּרְחָב יָהּ.</tei:seg><tei:milestone unit="verse"/> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/text/min_hametzar/psalms/118/6"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/118/6">יְיָ לִי, לֹא אִירָא; מַה יַּעֲשֶׂה לִי אָדָם.</tei:seg><tei:milestone unit="verse"/> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/text/min_hametzar/psalms/118/7"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/118/7">יְיָ לִי בְּעֹזְרָי, וַאֲנִי אֶרְאֶה בְשֹׂנְאָי.</tei:seg><tei:milestone unit="verse"/> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/text/min_hametzar/psalms/118/8"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/118/8">טוֹב לַחֲסוֹת בַּיְיָ מִבְּטֹחַ בָּאָדָם.</tei:seg><tei:milestone unit="verse"/> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/text/min_hametzar/psalms/118/9"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/118/9">טוֹב לַחֲסוֹת בַּיְיָ מִבְּטֹֽחַ בִּנְדִיבִים.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="prayer-part"/></tei:p>
