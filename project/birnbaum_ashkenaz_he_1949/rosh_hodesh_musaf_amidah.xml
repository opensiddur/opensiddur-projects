<tei:div corresp="urn:x-opensiddur:text:siddur:rosh_chodesh/musaf/amidah"><tei:head xml:lang="he">מוּסָף לְרֹאשׁ חֹדֶשׁ</tei:head><tei:pb n="575" ed="1949 rosh_chodesh/musaf" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n599_medium.jpg"/><tei:note type="instruction" xml:lang="en">The Amidah is recited in silent devotion while standing, facing east.</tei:note><tei:note type="instruction" xml:lang="en">The Reader repeats the Amidah aloud when a minyan holds service.</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:bible:deuteronomy/32/3"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/adonai_sefatai"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/avot/barukh_atah"/><j:transclude type="external" target="urn:x-opensiddur:text:siddur:rosh_chodesh/musaf/amidah/melekh"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/gevurot/atah_gibor"/>        <j:conditional xml:id="rosh_hodesh_musaf_rain">
          <tei:note type="instruction" xml:lang="en">Between Sukkoth and Pesaḥ add:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="geshem">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:siddur:rosh_chodesh/musaf/amidah/rain"/>        <j:endConditional target="#rosh_hodesh_musaf_rain"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/gevurot/mekhalkel_chayim"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/gevurot/mechayeh_hametim"/>        <j:conditional xml:id="rosh_hodesh_musaf_kedushah">
          <tei:note type="instruction" xml:lang="en">When the Reader repeats the Amidah, the following Kedushah is said.</tei:note>
<j:all>          <tei:fs type="opensiddur:quorum">
            <tei:f name="minyan">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:recitation">
            <tei:f name="repetition">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs></j:all>
        </j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:siddur:rosh_chodesh/musaf/amidah/kedushah"/>        <j:endConditional target="#rosh_hodesh_musaf_kedushah"/>        <j:conditional xml:id="rosh_hodesh_musaf_silent">
          <tei:note type="instruction" xml:lang="en">In silent devotion:</tei:note>
          <j:none>
<j:all>          <tei:fs type="opensiddur:quorum">
            <tei:f name="minyan">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:recitation">
            <tei:f name="repetition">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs></j:all>
          </j:none>
        </j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:siddur:rosh_chodesh/musaf/amidah/atah_kadosh"/>        <j:endConditional target="#rosh_hodesh_musaf_silent"/><j:transclude type="external" target="urn:x-opensiddur:text:siddur:rosh_chodesh/musaf/amidah/kedushat_hayom"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/avodah/retzeh"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/avodah/vetechezenah"/>        <j:conditional xml:id="rosh_hodesh_musaf_modim">
          <tei:note type="instruction" xml:lang="en">When the Reader repeats the Amidah, the Congregation responds here by saying:</tei:note>
<j:all>          <tei:fs type="opensiddur:quorum">
            <tei:f name="minyan">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:recitation">
            <tei:f name="repetition">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs></j:all>
        </j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:siddur:rosh_chodesh/musaf/amidah/modim_derabbanan"/>        <j:endConditional target="#rosh_hodesh_musaf_modim"/><j:transclude type="external" target="urn:x-opensiddur:text:siddur:rosh_chodesh/musaf/amidah/modim"/>        <j:conditional xml:id="rosh_hodesh_musaf_hanukkah">
          <tei:note type="instruction" xml:lang="en">On Ḥanukkah add:</tei:note>
          <tei:fs type="opensiddur:holiday">
            <tei:f name="hanukkah">
              <tei:numeric value="1" max="8"/>
            </tei:f>
          </tei:fs>
        </j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:siddur:rosh_chodesh/musaf/amidah/al_hanissim"/><j:transclude type="external" target="urn:x-opensiddur:text:siddur:rosh_chodesh/musaf/amidah/bimei"/>        <j:endConditional target="#rosh_hodesh_musaf_hanukkah"/><j:transclude type="external" target="urn:x-opensiddur:text:siddur:rosh_chodesh/musaf/amidah/veal_kulam"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/hodaah/hatov_shimkha"/>        <j:conditional xml:id="rosh_hodesh_musaf_kohanim">
          <tei:note type="instruction" xml:lang="en">Priestly blessing recited by the Reader:</tei:note>
<j:all>          <tei:fs type="opensiddur:quorum">
            <tei:f name="minyan">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:recitation">
            <tei:f name="repetition">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs></j:all>
        </j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:siddur:rosh_chodesh/musaf/amidah/kohanim"/>        <j:endConditional target="#rosh_hodesh_musaf_kohanim"/><j:transclude type="external" target="urn:x-opensiddur:text:siddur:rosh_chodesh/musaf/amidah/sim_shalom"/>        <j:conditional xml:id="rosh_hodesh_musaf_meditation">
          <tei:note type="instruction" xml:lang="en">After the Amidah add the following meditation:</tei:note>
          <j:none>
<j:all>          <tei:fs type="opensiddur:quorum">
            <tei:f name="minyan">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:recitation">
            <tei:f name="repetition">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs></j:all>
          </j:none>
        </j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:siddur:rosh_chodesh/musaf/amidah/elohai"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/yehi_ratzon"/>        <j:endConditional target="#rosh_hodesh_musaf_meditation"/></tei:div>
    </tei:body>
  </tei:text>
