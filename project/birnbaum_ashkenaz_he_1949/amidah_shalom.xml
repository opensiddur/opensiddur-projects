  <tei:text>
    <tei:body>
        <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/shalom">
          <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/shalom/sim_shalom">
            <tei:p>שִׂים שָׁלוֹם, טוֹבָה וּבְרָכָה, חֵן וָחֶֽסֶד וְרַחֲמִים, עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל עַמֶּֽךָ. בָּרְכֵֽנוּ אָבִֽינוּ, כֻּלָּֽנוּ כְּאֶחָד, בְּאוֹר פָּנֶֽיךָ; כִּי בְאוֹר פָּנֶֽיךָ נָתַֽתָּ לָּֽנוּ, יְיָ אֱלֹהֵֽינוּ, תּוֹרַת חַיִּים וְאַהֲבַת חֶֽסֶד, וּצְדָקָה וּבְרָכָה וְרַחֲמִים, וְחַיִּים וְשָׁלוֹם. וְטוֹב בְּעֵינֶֽיךָ לְבָרֵךְ אֶת עַמְּךָ יִשְׂרָאֵל בְּכָל עֵת וּבְכָל שָׁעָה בִּשְׁלוֹמֶֽךָ.</tei:p>
          </tei:div>
        <j:conditional xml:id="cond_shalom_seal_ordinary">
          <j:none>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="aseret-ymei-tshuva">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
          </j:none>
        </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/shalom/hamevarekh">
            <tei:p>בָּרוּךְ אַתָּה, יְיָ, הַמְבָרֵךְ אֶת עַמּוֹ יִשְׂרָאֵל בַּשָּׁלוֹם.</tei:p>
          </tei:div>
        <j:endConditional target="#cond_shalom_seal_ordinary"/>
        <j:conditional xml:id="cond_shalom_seal_aseret">
          <tei:note type="instruction" xml:lang="en">Between Rosh Hashanah and Yom Kippur say:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="aseret-ymei-tshuva">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/shalom/besefer_chayim">
            <tei:p>(בְּסֵֽפֶר חַיִּים, בְּרָכָה וְשָׁלוֹם וּפַרְנָסָה טוֹבָה, נִזָּכֵר וְנִכָּתֵב לְפָנֶֽיךָ, אֲנַֽחְנוּ וְכָל עַמְּךָ בֵּית יִשְׂרָאֵל, לְחַיִּים טוֹבִים וּלְשָׁלוֹם. בָּרוּךְ אַתָּה, יְיָ, עוֹשֵׂה הַשָּׁלוֹם.)</tei:p>
          </tei:div>
        <j:endConditional target="#cond_shalom_seal_aseret"/>
        </tei:div>
