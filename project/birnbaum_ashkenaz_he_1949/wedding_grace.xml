<tei:div corresp="urn:x-opensiddur:text:siddur:marriage/grace"><tei:head>ברכת המזון לנשואין</tei:head><tei:note type="instruction" xml:lang="en">Leader:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:poem:devai_haser"/><j:transclude type="external" target="urn:x-opensiddur:text:siddur:concluding_prayers/text/wedding_zimmun"/><tei:note type="instruction" xml:lang="en">Company, then Leader:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:siddur:concluding_prayers/text/wedding_response"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkat_hamazon/core"/><tei:note type="instruction" xml:lang="en">After the grace (page 759) the seven wedding blessings are repeated.</tei:note><j:conditional xml:id="festival_concluding_seven_meal">
          <tei:note type="instruction" xml:lang="en">With a minyan:</tei:note>
          <tei:fs type="opensiddur:quorum">
            <tei:f name="minyan">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:prayer:sheva_berakhot/after_meal"/><j:endConditional target="#festival_concluding_seven_meal"/></tei:div>
