<tei:div corresp="urn:x-opensiddur:text:siddur:shabbat/conclusion/kaddish"><tei:head xml:lang="he" resp="urn:x-opensiddur:contributor:opensiddur.org/efraim-feinstein">קדיש שלם</tei:head><tei:pb n="541" ed="1949 shabbat/conclusion" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n565_medium.jpg"/>        <j:conditional xml:id="shabbat_minchah_motzaei_full_kaddish">
          <tei:note type="instruction" xml:lang="en">When a minyan holds service:</tei:note>
          <tei:fs type="opensiddur:quorum">
            <tei:f name="minyan">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional><tei:note type="instruction" xml:lang="en">Reader:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/yitgadal"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/yehe_shmeh"/><tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:shabbat/conclusion/kaddish/yitbarakh"/><tei:seg source="urn:x-opensiddur:text:prayer:kaddish/yitbarakh">יִתְבָּרַךְ וְיִשְׁתַּבַּח, וְיִתְפָּאַר וְיִתְרוֹמַם, וְיִתְנַשֵּׂא וְיִתְהַדָּר, וְיִתְעַלֶּה וְיִתְהַלָּל שְׁמֵהּ דְּקֻדְשָׁא בְּרִיךְ הוּא, לְעֵֽלָּא         <j:conditional xml:id="shabbat_minchah_motzaei_second_leella">
          <tei:note type="instruction" xml:lang="en">During the Ten Days of Repentance, add:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="aseret-ymei-tshuva">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>לְעֵֽלָּא        <j:endConditional target="#shabbat_minchah_motzaei_second_leella"/> מִן כָּל בִּרְכָתָא וְשִׁירָתָא, תֻּשְׁבְּחָתָא וְנֶחֱמָתָא, דַּאֲמִירָן בְּעָלְמָא, וְאִמְרוּ אָמֵן.</tei:seg><tei:milestone unit="prayer-part"/></tei:p><tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:shabbat/conclusion/kaddish/titkabal"/><tei:seg source="urn:x-opensiddur:text:prayer:kaddish/titkabal">תִּתְקַבַּל צְלוֹתְהוֹן וּבָעוּתְהוֹן דְּכָל בֵּית יִשְׂרָאֵל קֳדָם אֲבוּהוֹן דִּי בִשְׁמַיָּא, וְאִמְרוּ אָמֵן.</tei:seg><tei:milestone unit="prayer-part"/></tei:p><j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/yatom/yehe_shlama"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/yatom/oseh_shalom"/>        <j:endConditional target="#shabbat_minchah_motzaei_full_kaddish"/></tei:div>
