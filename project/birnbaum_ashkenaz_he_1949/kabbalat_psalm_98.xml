<tei:div corresp="urn:x-opensiddur:text:bible:psalms/98"><tei:head xml:lang="he">תהלים צח</tei:head>
<tei:pb n="241" ed="1949 shabbat/kabbalat_shabbat" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n265_medium.jpg"/>
<tei:p>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/98/1"/>
מִזְמוֹר, שִׁירוּ לַייָ שִׁיר חָדָשׁ, כִּי נִפְלָאוֹת עָשָׂה, הוֹשִׁיעָה לּוֹ יְמִינוֹ וּזְרוֹעַ קָדְשׁוֹ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/98/2"/>
הוֹדִיעַ יְיָ יְשׁוּעָתוֹ, לְעֵינֵי הַגּוֹיִם גִּלָּה צִדְקָתוֹ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/98/3"/>
זָכַר חַסְדּוֹ וֶאֱמוּנָתוֹ לְבֵית יִשְׂרָאֵל; רָאוּ כָל אַפְסֵי אָרֶץ אֵת יְשׁוּעַת אֱלֹהֵינוּ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/98/4"/>
הָרִיעוּ לַייָ, כָּל הָאָרֶץ, פִּצְחוּ וְרַנְּנוּ וְזַמֵּרוּ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/98/5"/>
זַמְּרוּ לַייָ בְּכִנּוֹר, בְּכִנּוֹר וְקוֹל זִמְרָה.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/98/6"/>
בַּחֲצֹצְרוֹת וְקוֹל שׁוֹפָר, הָרִיעוּ לִפְנֵי הַמֶּלֶךְ יְיָ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/98/7"/>
יִרְעַם הַיָּם וּמְלֹאוֹ, תֵּבֵל וְיֹשְׁבֵי בָהּ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/98/8"/>
נְהָרוֹת יִמְחֲאוּ כָף, יַחַד הָרִים יְרַנֵּנוּ.
<tei:milestone unit="verse"/><tei:note type="instruction" xml:lang="en">Reader</tei:note>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/98/9"/>
לִפְנֵי יְיָ כִּי בָא לִשְׁפֹּט הָאָרֶץ; יִשְׁפֹּט תֵּבֵל בְּצֶדֶק, וְעַמִּים בְּמֵישָׁרִים.
<tei:milestone unit="verse"/></tei:p></tei:div>
    </tei:body>
  </tei:text>
