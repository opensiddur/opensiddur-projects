<tei:div corresp="urn:x-opensiddur:text:siddur:shabbat/day_meal/yah_ribbon" xml:lang="arc-Hebr"><tei:head xml:lang="he" resp="urn:x-opensiddur:contributor:opensiddur.org/efraim-feinstein">יה רבון</tei:head><tei:pb n="433" ed="1949 shabbat/day_meal" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n457_medium.jpg"/><tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:siddur:shabbat/day_meal/yah_ribbon/1"/><tei:seg source="urn:x-opensiddur:text:poem:yah_ribbon/1">יָהּ רִבּוֹן עָלַם וְעָלְמַיָּא, אַנְתְּ הוּא מַלְכָּא מֶֽלֶךְ מַלְכַיָּא, עוֹבַד גְּבוּרְתָּךְ וְתִמְהַיָּא שְׁפַר קָדָמַי לְהַחֲוָיָה.</tei:seg><tei:milestone unit="stanza"/></tei:p><j:transclude type="external" target="urn:x-opensiddur:text:poem:yah_ribbon/refrain/1"/><j:transclude type="external" target="urn:x-opensiddur:text:poem:yah_ribbon/2"/><j:transclude type="external" target="urn:x-opensiddur:text:poem:yah_ribbon/refrain/2"/><j:transclude type="external" target="urn:x-opensiddur:text:poem:yah_ribbon/3"/><j:transclude type="external" target="urn:x-opensiddur:text:poem:yah_ribbon/refrain/3"/><tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:siddur:shabbat/day_meal/yah_ribbon/4"/><tei:seg source="urn:x-opensiddur:text:poem:yah_ribbon/4">אֱלָהָא דִּי לֵהּ יְקַר וּרְבוּתָא, פְּרֹק יַת עָנָךְ מִפֻּם אַרְיָוָתָא, וְאַפֵּק יַת עַמָּךְ מִגּוֹ גָלוּתָא, עַמָּךְ דִּי בְחַרְתְּ מִכָּל אֻמַּיָּא.</tei:seg><tei:milestone unit="stanza"/></tei:p><j:transclude type="external" target="urn:x-opensiddur:text:poem:yah_ribbon/refrain/4"/><tei:pb n="435" ed="1949 shabbat/day_meal" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n459_medium.jpg"/><j:transclude type="external" target="urn:x-opensiddur:text:poem:yah_ribbon/5"/><j:transclude type="external" target="urn:x-opensiddur:text:poem:yah_ribbon/refrain/5"/></tei:div>
