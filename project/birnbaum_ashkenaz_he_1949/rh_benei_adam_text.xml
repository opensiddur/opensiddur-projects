<tei:p><tei:pb n="673" ed="1949 rosh hashana and erev yom kippur" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n697_medium.jpg"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:kapparot/verses"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:prayer:kapparot/verses/intro"/>בְּנֵי אָדָם,<tei:milestone unit="verse"/> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:prayer:kapparot/verses/psalms/107/10"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/107/10">יֹֽשְׁבֵי חֹֽשֶׁךְ וְצַלְמָֽוֶת, אֲסִירֵי עֳנִי וּבַרְזֶל.</tei:seg><tei:milestone unit="verse"/> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:prayer:kapparot/verses/psalms/107/14"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/107/14">יוֹצִיאֵם מֵחֹֽשֶׁךְ וְצַלְמָֽוֶת, וּמוֹסְרוֹתֵיהֶם יְנַתֵּק.</tei:seg><tei:milestone unit="verse"/> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:prayer:kapparot/verses/psalms/107/17"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/107/17">אֱוִלִים מִדֶּֽרֶךְ פִּשְׁעָם, וּמֵעֲוֺנֹתֵיהֶם יִתְעַנּוּ.</tei:seg><tei:milestone unit="verse"/> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:prayer:kapparot/verses/psalms/107/18"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/107/18">כָּל אֹֽכֶל תְּתַעֵב נַפְשָׁם, וַיַּגִּֽיעוּ עַד שַֽׁעֲרֵי מָוֶת.</tei:seg><tei:milestone unit="verse"/> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:prayer:kapparot/verses/psalms/107/19"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/107/19">וַיִּזְעֲקוּ אֶל יְיָ בַּצַּר לָהֶם, מִמְּצֻקוֹתֵיהֶם יוֹשִׁיעֵם.</tei:seg><tei:milestone unit="verse"/> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:prayer:kapparot/verses/psalms/107/20"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/107/20">יִשְׁלַח דְּבָרוֹ וְיִרְפָּאֵם, וִימַלֵּט מִשְּׁחִיתוֹתָם.</tei:seg><tei:milestone unit="verse"/> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:prayer:kapparot/verses/psalms/107/21"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/107/21">יוֹדוּ לַיְיָ חַסְדּוֹ, וְנִפְלְאוֹתָיו לִבְנֵי אָדָם.</tei:seg><tei:milestone unit="verse"/> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:prayer:kapparot/verses/job/33/23"/><tei:seg source="urn:x-opensiddur:text:bible:job/33/23">אִם יֵשׁ עָלָיו מַלְאָךְ מֵלִיץ, אֶחָד מִנִּי אָֽלֶף, לְהַגִּיד לְאָדָם יָשְׁרוֹ.</tei:seg><tei:milestone unit="verse"/> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:prayer:kapparot/verses/job/33/24"/><tei:seg source="urn:x-opensiddur:text:bible:job/33/24">וַיְחֻנֶּנּוּ, וַיֹּֽאמֶר: פְּדָעֵֽהוּ מֵרֶֽדֶת שָֽׁחַת, מָצָֽאתִי כֹֽפֶר.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="prayer-part"/></tei:p>
