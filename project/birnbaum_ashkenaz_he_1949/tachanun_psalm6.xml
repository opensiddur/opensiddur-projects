<tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/tachanun/psalm6">
<tei:head xml:lang="he">תהלים ו</tei:head>
<tei:p>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/6/2"/>יְיָ אַל בְּאַפְּךָ תוֹכִיחֵֽנִי, וְאַל בַּחֲמָתְךָ תְיַסְּרֵֽנִי.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/6/3"/>חָנֵּֽנִי, יְיָ, כִּי אֻמְלַל אָֽנִי; רְפָאֵֽנִי, יְיָ, כִּי נִבְהֲלוּ עֲצָמָי.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/6/4"/>וְנַפְשִׁי נִבְהֲלָה מְאֹד; וְאַתָּה יְיָ, עַד מָתָי.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/6/5"/>שׁוּבָה, יְיָ, חַלְּצָה נַפְשִׁי; הוֹשִׁיעֵֽנִי לְמַֽעַן חַסְדֶּֽךָ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/6/6"/>כִּי אֵין בַּמָּֽוֶת זִכְרֶֽךָ; בִּשְׁאוֹל מִי יֽוֹדֶה לָּךְ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/6/7"/>יָגַֽעְתִּי בְאַנְחָתִי, אַשְׂחֶה בְכָל לַֽיְלָה מִטָּתִי; בְּדִמְעָתִי עַרְשִׂי אַמְסֶה.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/6/8"/>עָשְׁשָׁה מִכַּֽעַס עֵינִי; עָתְקָה בְּכָל צוֹרְרָי.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/6/9"/>סֽוּרוּ מִמֶּֽנִּי, כָּל פֹּֽעֲלֵי אָֽוֶן, כִּי שָׁמַע יְיָ קוֹל בִּכְיִי.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/6/10"/>שָׁמַע יְיָ תְּחִנָּתִי; יְיָ תְּפִלָּתִי יִקָּח.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/6/11"/>יֵבֹֽשׁוּ וְיִבָּהֲלוּ מְאֹד כָּל אֹיְבָי; יָשֻֽׁבוּ יֵבֹֽשׁוּ רָֽגַע.
</tei:p>
