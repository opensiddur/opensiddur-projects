<tei:div corresp="urn:x-opensiddur:text:prayer:mi_sheberakh/oleh_latorah"><tei:pb n="371" ed="1949 shabbat/shacharit/torah" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n395_medium.jpg"/><tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh/oleh_latorah/opening"/>מִי שֶׁבֵּרַךְ אֲבוֹתֵינוּ, אַבְרָהָם יִצְחָק וְיַעֲקֹב, הוּא יְבָרֵךְ אֶת …<tei:note type="instruction" xml:lang="en">The name is given.</tei:note> שֶׁעָלָה לִכְבוֹד הַמָּקוֹם וְלִכְבוֹד הַתּוֹרָה         <j:conditional xml:id="shabbat_torah_mi_aliyah_opening_festival_honor">
          <tei:note type="instruction" xml:lang="en">On festivals:</tei:note>
<j:any>          <tei:fs type="opensiddur:holiday">
            <tei:f name="pesah">
              <tei:numeric value="1" max="8"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:holiday">
            <tei:f name="shavuot">
              <tei:numeric value="1" max="2"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:holiday">
            <tei:f name="sukkot">
              <tei:numeric value="1" max="7"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:holiday">
            <tei:f name="shmini-atzeret">
              <tei:numeric value="1" max="2"/>
            </tei:f>
          </tei:fs></j:any>
        </j:conditional>וְלִכְבוֹד הָרֶגֶל        <j:endConditional target="#shabbat_torah_mi_aliyah_opening_festival_honor"/>. הַקָּדוֹשׁ בָּרוּךְ הוּא יִשְׁמְרֵהוּ וְיַצִּילֵהוּ מִכָּל צָרָה וְצוּקָה וּמִכָּל נֶגַע וּמַחֲלָה, וְיִשְׁלַח בְּרָכָה וְהַצְלָחָה בְּכָל מַעֲשֵׂה יָדָיו         <j:conditional xml:id="shabbat_torah_mi_aliyah_opening_festival_pilgrimage">
          <tei:note type="instruction" xml:lang="en">On festivals:</tei:note>
<j:any>          <tei:fs type="opensiddur:holiday">
            <tei:f name="pesah">
              <tei:numeric value="1" max="8"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:holiday">
            <tei:f name="shavuot">
              <tei:numeric value="1" max="2"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:holiday">
            <tei:f name="sukkot">
              <tei:numeric value="1" max="7"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:holiday">
            <tei:f name="shmini-atzeret">
              <tei:numeric value="1" max="2"/>
            </tei:f>
          </tei:fs></j:any>
        </j:conditional>וְיִזְכֶּה לַעֲלוֹת לָרֶגֶל        <j:endConditional target="#shabbat_torah_mi_aliyah_opening_festival_pilgrimage"/> עִם כָּל יִשְׂרָאֵל אֶחָיו, וְנֹאמַר אָמֵן. <tei:milestone unit="prayer-part"/></tei:p></tei:div>
