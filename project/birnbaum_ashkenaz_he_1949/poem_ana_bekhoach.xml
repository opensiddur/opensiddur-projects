  <tei:text>
    <tei:body>
        <tei:div corresp="urn:x-opensiddur:text:poem:ana_bekhoach">
          <tei:lg>
            <tei:l>אָנָּא, בְּכֹֽחַ גְּדֻלַּת יְמִינְךָ תַּתִּיר צְרוּרָה.</tei:l>
            <tei:l>קַבֵּל רִנַּת עַמְּךָ, שַׂגְּבֵֽנוּ, טַהֲרֵֽנוּ, נוֹרָא.</tei:l>
            <tei:l><tei:pb n="35" ed="1949 all/shacharit/birchot_hashachar" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n59_medium.jpg"/>נָא, גִבּוֹר, דּוֹרְשֵׁי יִחוּדְךָ כְּבָבַת שָׁמְרֵם.</tei:l>
            <tei:l>בָּרְכֵם, טַהֲרֵם, רַחֲמֵם, צִדְקָתְךָ תָּמִיד גָּמְלֵם.</tei:l>
            <tei:l>חֲסִין קָדוֹשׁ, בְּרֹב טוּבְךָ נַהֵל עֲדָתֶֽךָ.</tei:l>
            <tei:l>יָחִיד גֵּאֶה, לְעַמְּךָ פְּנֵה, זוֹכְרֵי קְדֻשָּׁתֶֽךָ.</tei:l>
            <tei:l>שַׁוְעָתֵֽנוּ קַבֵּל וּשְׁמַע צַעֲקָתֵֽנוּ, יוֹדֵֽעַ תַּעֲלוּמוֹת.</tei:l>
          </tei:lg>
        </tei:div>
    </tei:body>
