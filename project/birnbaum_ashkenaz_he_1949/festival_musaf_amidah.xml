        </j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:siddur:regalim/musaf/amidah/kedushah/chol_hamoed"/><j:endConditional target="#festival_musaf_kedushah_chol"/><j:conditional xml:id="festival_musaf_ledor">
          <tei:note type="instruction" xml:lang="en">Reader:</tei:note>
