<tei:div corresp="urn:x-opensiddur:text:siddur:regalim/musaf/amidah"><tei:head>מוּסָף לְשָׁלֹשׁ רְגָלִים</tei:head><tei:note type="instruction" xml:lang="en">The Amidah is recited in silent devotion while standing, facing east.</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:siddur:regalim/musaf/text/ki_shem"/><j:transclude type="external" target="urn:x-opensiddur:text:siddur:regalim/musaf/text/sefatai"/><j:conditional xml:id="festival_musaf_tal">
          <tei:note type="instruction" xml:lang="en">On the first day of Pesaḥ, during the Reader’s repetition:</tei:note>
<j:all><j:all>          <tei:fs type="opensiddur:quorum">
            <tei:f name="minyan">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:recitation">
            <tei:f name="repetition">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs></j:all>          <tei:fs type="opensiddur:holiday">
            <tei:f name="pesah">
              <tei:numeric value="1" max="1"/>
            </tei:f>
          </tei:fs></j:all>
        </j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:prayer:tefillat_tal"/><j:endConditional target="#festival_musaf_tal"/><j:conditional xml:id="festival_musaf_geshem">
          <tei:note type="instruction" xml:lang="en">On Shemini Atsereth, during the Reader’s repetition:</tei:note>
<j:all><j:all>          <tei:fs type="opensiddur:quorum">
            <tei:f name="minyan">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:recitation">
            <tei:f name="repetition">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs></j:all><tei:fs type="opensiddur:hebrew-date"><tei:f name="month"><tei:numeric value="7"/></tei:f><tei:f name="day"><tei:numeric value="22"/></tei:f></tei:fs></j:all>
        </j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:prayer:tefillat_geshem"/><j:endConditional target="#festival_musaf_geshem"/><j:conditional xml:id="festival_musaf_ordinary_opening">
          <tei:note type="instruction" xml:lang="en">Except during the prayers for dew and rain:</tei:note>
          <j:none>
<j:any><j:all><j:all>          <tei:fs type="opensiddur:quorum">
            <tei:f name="minyan">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:recitation">
            <tei:f name="repetition">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs></j:all>          <tei:fs type="opensiddur:holiday">
            <tei:f name="pesah">
              <tei:numeric value="1" max="1"/>
            </tei:f>
          </tei:fs></j:all><j:all><j:all>          <tei:fs type="opensiddur:quorum">
            <tei:f name="minyan">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:recitation">
            <tei:f name="repetition">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs></j:all><tei:fs type="opensiddur:hebrew-date"><tei:f name="month"><tei:numeric value="7"/></tei:f><tei:f name="day"><tei:numeric value="22"/></tei:f></tei:fs></j:all></j:any>
          </j:none>
        </j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:siddur:regalim/musaf/text/avot"/><j:transclude type="external" target="urn:x-opensiddur:text:siddur:regalim/musaf/text/melekh"/><j:transclude type="external" target="urn:x-opensiddur:text:siddur:regalim/musaf/text/gevurot"/><j:conditional xml:id="festival_musaf_rain">
          <tei:note type="instruction" xml:lang="en">On Shemini Atsereth and Simḥath Torah add:</tei:note>
          <tei:fs type="opensiddur:holiday">
            <tei:f name="shmini-atzeret">
              <tei:numeric value="1" max="2"/>
            </tei:f>
          </tei:fs>
        </j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:siddur:regalim/musaf/text/rain"/><j:endConditional target="#festival_musaf_rain"/><j:endConditional target="#festival_musaf_ordinary_opening"/><j:transclude type="external" target="urn:x-opensiddur:text:siddur:regalim/musaf/text/mekhalkel"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/gevurot/mechayeh_hametim"/><j:conditional xml:id="festival_musaf_kedushah_major">
