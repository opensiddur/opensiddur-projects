<j:all><j:all>          <tei:fs type="opensiddur:quorum">
            <tei:f name="minyan">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:recitation">
            <tei:f name="repetition">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs></j:all><j:none>          <tei:fs type="opensiddur:practice">
            <tei:f name="birkat-kohanim">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs></j:none></j:all>
        </j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:siddur:regalim/musaf/text/kohanim_reader"/><j:endConditional target="#festival_musaf_reader_blessing"/><j:transclude type="external" target="urn:x-opensiddur:text:siddur:regalim/musaf/text/sim_shalom"/><j:conditional xml:id="festival_musaf_meditation">
