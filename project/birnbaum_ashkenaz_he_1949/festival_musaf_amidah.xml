        </j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:siddur:regalim/text/atah_kadosh"/><j:endConditional target="#festival_musaf_atah_kadosh"/><j:transclude type="external" target="urn:x-opensiddur:text:siddur:regalim/musaf/amidah/kedushat_hayom"/><j:transclude type="external" target="urn:x-opensiddur:text:siddur:regalim/musaf/text/retzeh"/><j:conditional xml:id="festival_musaf_duchen_retzeh">
