  <tei:text>
    <tei:body>
        <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/qedushat_hashem">
          <tei:div>
            <tei:p>אַתָּה קָדוֹשׁ וְשִׁמְךָ קָדוֹשׁ, וּקְדוֹשִׁים בְּכָל יוֹם יְהַלְלֽוּךָ סֶּֽלָה.</tei:p>
          </tei:div>
        <j:conditional xml:id="cond_qh_seal_ordinary">
          <j:none>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="aseret-ymei-tshuva">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
          </j:none>
        </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/qedushat_hashem/haeil_haqadosh">
            <tei:p>בָּרוּךְ אַתָּה, יְיָ, הָאֵל הַקָּדוֹשׁ.</tei:p>
          </tei:div>
        <j:endConditional target="#cond_qh_seal_ordinary"/>
        <j:conditional xml:id="cond_qh_seal_aseret">
          <tei:note type="instruction" xml:lang="en">Between Rosh Hashanah and Yom Kippur substitute:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="aseret-ymei-tshuva">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/qedushat_hashem/hamelekh_haqadosh">
            <tei:p>(בָּרוּךְ אַתָּה, יְיָ, הַמֶּֽלֶךְ הַקָּדוֹשׁ.)</tei:p>
          </tei:div>
        <j:endConditional target="#cond_qh_seal_aseret"/>
        </tei:div>
