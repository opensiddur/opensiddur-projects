            </tei:f>
          </tei:fs>
        </j:conditional>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/yatom"/>
        <j:endConditional target="#kaddish_psalm_49"/>
        <j:endConditional target="#psalm_49_occasion"/>
