        <j:declare xml:id="unit_service">
          <tei:fs type="opensiddur:service-time">
          <tei:f name="shaharit">
            <tei:binary value="true"/>
          </tei:f>
          <tei:f name="minha">
            <tei:binary value="false"/>
          </tei:f>
          <tei:f name="maariv">
            <tei:binary value="false"/>
          </tei:f>
          <tei:f name="musaf">
            <tei:binary value="false"/>
          </tei:f>
          <tei:f name="neila">
            <tei:binary value="false"/>
          </tei:f>
          <tei:f name="slihot">
            <tei:binary value="false"/>
          </tei:f>
          </tei:fs>
          <tei:fs type="opensiddur:holiday-aggregate">
          <tei:f name="shabbat">
            <tei:binary value="false"/>
          </tei:f>
          <tei:f name="yom-tov">
            <tei:binary value="false"/>
          </tei:f>
          </tei:fs>
        </j:declare>
<j:transclude type="external" target="urn:x-opensiddur:text:siddur:chol/shacharit/shir_shel_yom"/>
        <j:conditional xml:id="psalm_27_occasion">
          <tei:note type="instruction" xml:lang="en">The following is recited daily from Rosh Ḥodesh Elul until Simḥath Torah.</tei:note>
<j:any><tei:fs type="opensiddur:hebrew-date"><tei:f name="month"><tei:numeric value="5"/></tei:f><tei:f name="day"><tei:numeric value="30"/></tei:f></tei:fs><tei:fs type="opensiddur:hebrew-date"><tei:f name="month"><tei:numeric value="6"/></tei:f><tei:f name="day"><tei:numeric value="1" max="29"/></tei:f></tei:fs><tei:fs type="opensiddur:hebrew-date"><tei:f name="month"><tei:numeric value="7"/></tei:f><tei:f name="day"><tei:numeric value="1" max="21"/></tei:f></tei:fs><j:all><tei:fs type="opensiddur:hebrew-date"><tei:f name="month"><tei:numeric value="7"/></tei:f><tei:f name="day"><tei:numeric value="22"/></tei:f></tei:fs>          <tei:fs type="opensiddur:israel">
            <tei:f name="is-israel">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs></j:all></j:any>
        </j:conditional>
<j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/27"/>
        <j:conditional xml:id="kaddish_psalm_27">
          <tei:note type="instruction" xml:lang="en">Mourners’ Kaddish.</tei:note>
          <tei:fs type="opensiddur:quorum">
            <tei:f name="minyan">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
<j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/yatom"/>
        <j:endConditional target="#kaddish_psalm_27"/>
        <j:endConditional target="#psalm_27_occasion"/>
        <j:conditional xml:id="psalm_49_occasion">
          <tei:note type="instruction" xml:lang="en">The following is recited in the house of a mourner during the week of mourning.</tei:note>
          <tei:fs type="opensiddur:override">
            <tei:f name="house-of-mourning">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
<j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/49"/>
