<tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/lekha_adonai">
<tei:p>
<tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/lekha_adonai/lekha"/><tei:seg source="urn:x-opensiddur:text:bible:chronicles_1/29/11">לְךָ יְיָ הַגְּדֻלָּה וְהַגְּבוּרָה, וְהַתִּפְאֶֽרֶת וְהַנֵּֽצַח וְהַהוֹד, כִּי כֹל בַּשָּׁמַֽיִם וּבָאָֽרֶץ. לְךָ יְיָ הַמַּמְלָכָה וְהַמִּתְנַשֵּׂא לְכֹל לְרֹאשׁ.</tei:seg>
<tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/lekha_adonai/romemu_hadom"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/99/5">רוֹמְמוּ יְיָ אֱלֹהֵֽינוּ, וְהִשְׁתַּחֲווּ לַהֲדֹם רַגְלָיו, קָדוֹשׁ הוּא.</tei:seg>
<tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/lekha_adonai/romemu_har"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/99/9">רוֹמְמוּ יְיָ אֱלֹהֵֽינוּ, וְהִשְׁתַּחֲווּ לְהַר קָדְשׁוֹ, כִּי קָדוֹשׁ יְיָ אֱלֹהֵֽינוּ.</tei:seg>
<tei:milestone unit="prayer-part"/>
</tei:p>
