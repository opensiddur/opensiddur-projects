<tei:p><tei:pb n="621" ed="1949 festival musaf" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n645_medium.jpg"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:regalim/musaf/text/vehasi"/>וְהַשִּׂיאֵֽנוּ, יְיָ אֱלֹהֵֽינוּ, אֶת בִּרְכַּת מוֹעֲדֶֽיךָ לְחַיִּים וּלְשָׁלוֹם, לְשִׂמְחָה וּלְשָׂשׂוֹן, כַּאֲשֶׁר רָצִֽיתָ וְאָמַֽרְתָּ לְבָרְכֵֽנוּ. אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ, <j:conditional xml:id="festival_musaf_vehasi0">
          <tei:note type="instruction" xml:lang="en">On the Sabbath:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>רְצֵה בִמְנוּחָתֵֽנוּ<j:endConditional target="#festival_musaf_vehasi0"/> קַדְּשֵֽׁנוּ בְּמִצְוֹתֶֽיךָ וְתֵן חֶלְקֵֽנוּ בְּתוֹרָתֶֽךָ, שַׂבְּעֵֽנוּ מִטּוּבֶֽךָ, וְשַׂמְּחֵֽנוּ בִּישׁוּעָתֶֽךָ, וְטַהֵר לִבֵּֽנוּ לְעָבְדְךָ בֶּאֱמֶת, וְהַנְחִילֵֽנוּ, יְיָ אֱלֹהֵֽינוּ <j:conditional xml:id="festival_musaf_vehasi1">
          <tei:note type="instruction" xml:lang="en">On the Sabbath:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>בְּאַהֲבָה וּבְרָצוֹן<j:endConditional target="#festival_musaf_vehasi1"/> בְּשִׂמְחָה וּבְשָׂשׂוֹן <j:conditional xml:id="festival_musaf_vehasi2">
          <tei:note type="instruction" xml:lang="en">On the Sabbath:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>שַׁבָּת וּ<j:endConditional target="#festival_musaf_vehasi2"/>מוֹעֲדֵי קָדְשֶֽׁךָ, וְיִשְׂמְחוּ בְךָ יִשְׂרָאֵל מְקַדְּשֵׁי שְׁמֶֽךָ. בָּרוּךְ אַתָּה, יְיָ, מְקַדֵּשׁ <j:conditional xml:id="festival_musaf_vehasi3">
          <tei:note type="instruction" xml:lang="en">On the Sabbath:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>הַשַּׁבָּת וְ<j:endConditional target="#festival_musaf_vehasi3"/>יִשְׂרָאֵל וְהַזְּמַנִּים.<tei:milestone unit="prayer-part"/></tei:p>
