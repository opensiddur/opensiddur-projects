<tei:div corresp="urn:x-opensiddur:text:bible:psalms/95"><tei:head xml:lang="he">תהלים צה</tei:head>
<tei:pb n="237" ed="1949 shabbat/kabbalat_shabbat" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n261_medium.jpg"/>
<tei:p>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/95/1"/>
לְכוּ נְרַנְּנָה לַייָ, נָרִיעָה לְצוּר יִשְׁעֵנוּ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/95/2"/>
נְקַדְּמָה פָנָיו בְּתוֹדָה, בִּזְמִרוֹת נָרִיעַ לוֹ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/95/3"/>
כִּי אֵל גָּדוֹל יְיָ, וּמֶלֶךְ גָּדוֹל עַל כָּל אֱלֹהִים.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/95/4"/>
אֲשֶׁר בְּיָדוֹ מֶחְקְרֵי אָרֶץ, וְתוֹעֲפוֹת הָרִים לוֹ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/95/5"/>
אֲשֶׁר לוֹ הַיָּם, וְהוּא עָשָׂהוּ; וְיַבֶּשֶׁת יָדָיו יָצָרוּ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/95/6"/>
בֹּאוּ נִשְׁתַּחֲוֶה וְנִכְרָעָה, נִבְרְכָה לִפְנֵי יְיָ עֹשֵׂנוּ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/95/7"/>
כִּי הוּא אֱלֹהֵינוּ, וַאֲנַחְנוּ עַם מַרְעִיתוֹ וְצֹאן יָדוֹ; הַיּוֹם אִם בְּקֹלוֹ תִשְׁמָעוּ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/95/8"/>
אַל תַּקְשׁוּ לְבַבְכֶם כִּמְרִיבָה, כְּיוֹם מַסָּה בַּמִּדְבָּר.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/95/9"/>
אֲשֶׁר נִסּוּנִי אֲבוֹתֵיכֶם; בְּחָנוּנִי גַּם רָאוּ פָעֳלִי.
<tei:milestone unit="verse"/><tei:note type="instruction" xml:lang="en">Reader</tei:note>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/95/10"/>
אַרְבָּעִים שָׁנָה אָקוּט בְּדוֹר, וָאֹמַר עַם תֹּעֵי לֵבָב הֵם, וְהֵם לֹא יָדְעוּ דְרָכָי.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/95/11"/>
אֲשֶׁר נִשְׁבַּעְתִּי בְאַפִּי, אִם יְבֹאוּן אֶל מְנוּחָתִי.
<tei:milestone unit="verse"/></tei:p></tei:div>
