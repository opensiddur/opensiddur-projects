<tei:div corresp="urn:x-opensiddur:text:bible:psalms/100">
<tei:head xml:lang="he">תהלים ק</tei:head>
<tei:p>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/100/1"/>מִזְמוֹר לְתוֹדָה; הָרִֽיעוּ לַייָ כָּל הָאָֽרֶץ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/100/2"/>עִבְדוּ אֶת יְיָ בְּשִׂמְחָה, בֹּֽאוּ לְפָנָיו בִּרְנָנָה.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/100/3"/>דְּעוּ כִּי יְיָ הוּא אֱלֹהִים; הוּא עָשָֽׂנוּ וְלוֹ אֲנַֽחְנוּ, עַמּוֹ וְצֹאן מַרְעִיתוֹ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/100/4"/>בֹּֽאוּ שְׁעָרָיו בְּתוֹדָה, חֲצֵרוֹתָיו בִּתְהִלָּה; הֽוֹדוּ לוֹ, בָּרְכוּ שְׁמוֹ.
<tei:milestone unit="verse"/><tei:note type="instruction" xml:lang="en">Reader</tei:note>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/100/5"/>כִּי טוֹב יְיָ, לְעוֹלָם חַסְדּוֹ, וְעַד דֹּר וָדֹר אֱמוּנָתוֹ.
<tei:milestone unit="verse"/>
</tei:p>
