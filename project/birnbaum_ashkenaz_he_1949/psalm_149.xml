<tei:div corresp="urn:x-opensiddur:text:bible:psalms/149">
<tei:head xml:lang="he">תהלים קמט</tei:head>
<tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/149/1"/>הַלְלוּיָהּ; שִׁירוּ לַייָ שִׁיר חָדָשׁ, תְּהִלָּתוֹ בִּקְהַל חֲסִידִים. <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/149/2"/>יִשְׂמַח יִשְׂרָאֵל בְּעֹשָׂיו, בְּנֵי צִיּוֹן יָגִֽילוּ בְמַלְכָּם. <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/149/3"/>יְהַלְלוּ שְׁמוֹ בְמָחוֹל, בְּתֹף וְכִנּוֹר יְזַמְּרוּ לוֹ. <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/149/4"/>כִּי רוֹצֶה יְיָ בְּעַמּוֹ, יְפָאֵר עֲנָוִים בִּישׁוּעָה. <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/149/5"/>יַעְלְזוּ חֲסִידִים בְּכָבוֹד, יְרַנְּנוּ עַל מִשְׁכְּבוֹתָם. <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/149/6"/>רוֹמְמוֹת אֵל בִּגְרוֹנָם, וְחֶֽרֶב פִּיפִיּוֹת בְּיָדָם. <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/149/7"/>לַעֲשׂוֹת נְקָמָה בַּגּוֹיִם, תּוֹכֵחוֹת בַּלְאֻמִּים. <tei:milestone unit="verse"/><tei:note type="instruction" xml:lang="en">Reader</tei:note><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/149/8"/>לֶאְסֹר מַלְכֵיהֶם בְּזִקִּים, וְנִכְבְּדֵיהֶם בְּכַבְלֵי בַרְזֶל. <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/149/9"/>לַעֲשׂוֹת בָּהֶם מִשְׁפָּט כָּתוּב; הָדָר הוּא לְכָל חֲסִידָיו; הַלְלוּיָהּ. <tei:milestone unit="verse"/></tei:p>
