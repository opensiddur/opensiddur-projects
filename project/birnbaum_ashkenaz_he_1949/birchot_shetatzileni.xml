  <tei:text>
    <tei:body>
        <tei:div corresp="urn:x-opensiddur:text:prayer:birchot_hashachar/shetatzileni">
          <tei:p>יְהִי רָצוֹן מִלְּפָנֶֽיךָ, יְיָ אֱלֹהַי וֵאלֹהֵי אֲבוֹתַי, שֶׁתַּצִּילֵֽנִי הַיּוֹם וּבְכָל יוֹם מֵעַזֵּי פָנִים וּמֵעַזּוּת פָּנִים, מֵאָדָם רָע וּמֵחָבֵר רָע, וּמִשָּׁכֵן רָע וּמִפֶּֽגַע רָע וּמִשָּׂטָן הַמַּשְׁחִית, מִדִּין קָשֶׁה וּמִבַּֽעַל דִּין קָשֶׁה, בֵּין שֶׁהוּא בֶן־בְּרִית וּבֵין שֶׁאֵינוֹ בֶן־בְּרִית.</tei:p>
        </tei:div>
    </tei:body>
