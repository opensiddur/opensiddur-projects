  <tei:text>
    <tei:body>
        <tei:div corresp="urn:x-opensiddur:text:prayer:korbanot/pesukim">
          <tei:lg>
            <tei:l>יְיָ צְבָאוֹת עִמָּֽנוּ, מִשְׂגָּב־לָֽנוּ אֱלֹהֵי יַעֲקֹב, סֶֽלָה.</tei:l>
            <tei:l>יְיָ צְבָאוֹת, אַשְׁרֵי אָדָם בֹּטֵֽחַ בָּךְ.</tei:l>
            <tei:l>יְיָ, הוֹשִֽׁיעָה; הַמֶּֽלֶךְ יַעֲנֵֽנוּ בְיוֹם קָרְאֵֽנוּ.</tei:l>
          </tei:lg>
        </tei:div>
    </tei:body>
