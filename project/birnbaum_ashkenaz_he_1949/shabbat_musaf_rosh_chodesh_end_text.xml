<tei:div corresp="urn:x-opensiddur:text:prayer:amidah/retzeh_vechadesh"><tei:pb n="399" ed="1949 shabbat/musaf" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n423_medium.jpg"/><tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:amidah/retzeh_vechadesh/elohenu"/>אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ, רְצֵה בִמְנוּחָתֵנוּ, וְחַדֵּשׁ עָלֵינוּ בְּיוֹם הַשַּׁבָּת הַזֶּה אֶת הַחֹדֶשׁ הַזֶּה לְטוֹבָה וְלִבְרָכָה, לְשָׂשׂוֹן וּלְשִׂמְחָה, לִישׁוּעָה וּלְנֶחָמָה, לְפַרְנָסָה וּלְכַלְכָּלָה, לְחַיִּים וּלְשָׁלוֹם, לִמְחִילַת חֵטְא וְלִסְלִיחַת עָוֹן         <j:conditional xml:id="shabbat_musaf_leap">
          <tei:note type="instruction" xml:lang="en">During leap year:</tei:note>
          <tei:fs type="opensiddur:hebrew-date">
            <tei:f name="leap-year">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>וּלְכַפָּרַת פָּשַׁע        <j:endConditional target="#shabbat_musaf_leap"/>.<tei:milestone unit="prayer-part"/></tei:p><tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:amidah/retzeh_vechadesh/ki"/>כִּי בְעַמְּךָ יִשְׂרָאֵל בָּחַרְתָּ מִכָּל הָאֻמּוֹת, וְשַׁבַּת קָדְשְׁךָ לָהֶם הוֹדָעְתָּ, וְחֻקֵּי רָאשֵׁי חֳדָשִׁים לָהֶם קָבָעְתָּ. בָּרוּךְ אַתָּה, יְיָ, מְקַדֵּשׁ הַשַּׁבָּת וְיִשְׂרָאֵל וְרָאשֵׁי חֳדָשִׁים.<tei:milestone unit="prayer-part"/></tei:p></tei:div>
