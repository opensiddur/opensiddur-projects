<tei:div corresp="urn:x-opensiddur:text:siddur:hallel"><tei:head xml:lang="he" resp="urn:x-opensiddur:contributor:opensiddur.org/efraim-feinstein">סדר הלל</tei:head><tei:note type="instruction" xml:lang="en">Chanted after the Amidah of the morning service on Pesaḥ, Shavuoth, Sukkoth, Ḥanukkah and Rosh Ḥodesh</tei:note>        <j:conditional xml:id="hallel_occasion">
          <tei:note type="instruction" xml:lang="en">On Hallel occasions, except in a house of mourning during shiv‘ah:</tei:note>
<j:all>          <tei:fs type="opensiddur:hallel">
            <tei:f name="recite">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs><j:none>          <tei:fs type="opensiddur:override">
            <tei:f name="house-of-mourning">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs></j:none></j:all>
        </j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:prayer:hallel"/><j:transclude type="external" target="urn:x-opensiddur:text:siddur:hallel/kaddish"/>        <j:endConditional target="#hallel_occasion"/><tei:note type="instruction" xml:lang="en">Torah-reading on Rosh Ḥodesh, Ḥanukkah and Ḥol ha-Mo’ed—page 119; <tei:foreign xml:lang="he">אַשְׁרֵי</tei:foreign>, <tei:foreign xml:lang="he">וּבָא לְצִיּוֹן</tei:foreign>—page 127. Torah-reading on major festivals—page 361.</tei:note></tei:div>
