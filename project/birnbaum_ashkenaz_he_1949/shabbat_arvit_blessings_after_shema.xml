<tei:div corresp="urn:x-opensiddur:text:siddur:shabbat/arvit/blessings_after_shema"><tei:head xml:lang="he" resp="urn:x-opensiddur:contributor:opensiddur.org/efraim-feinstein">ברכות לאחר קריאת שמע</tei:head><j:declare xml:id="shabbat_arvit_service"><tei:fs type="opensiddur:service-time"><tei:f name="shaharit"><tei:binary value="false"/></tei:f><tei:f name="minha"><tei:binary value="false"/></tei:f><tei:f name="maariv"><tei:binary value="true"/></tei:f><tei:f name="musaf"><tei:binary value="false"/></tei:f><tei:f name="neila"><tei:binary value="false"/></tei:f><tei:f name="slihot"><tei:binary value="false"/></tei:f></tei:fs><tei:fs type="opensiddur:recitation"><tei:f name="silent"><tei:binary value="true"/></tei:f><tei:f name="repetition"><tei:binary value="false"/></tei:f></tei:fs></j:declare><tei:pb n="261" ed="1949 shabbat/arvit" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n285_medium.jpg"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:emet_veemunah/opening"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:emet_veemunah/moshe"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:emet_veemunah/mi_khamokha"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:emet_veemunah/malkhutkha"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:emet_veemunah/yimlokh"/><tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:shabbat/arvit/blessings_after_shema/emet_seal"/><tei:seg source="urn:x-opensiddur:text:prayer:emet_veemunah/seal">וְנֶאֱמַר: כִּי פָדָה יְיָ אֶת יַעֲקֹב, וּגְאָלוֹ מִיַּד חָזָק מִמֶּֽנּוּ. בָּרוּךְ אַתָּה, יְיָ, גָּאַל יִשְׂרָאֵל.</tei:seg><tei:milestone unit="prayer-part"/></tei:p><j:transclude type="external" target="urn:x-opensiddur:text:prayer:hashkivenu/opening"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:hashkivenu/hapores_sukkat_shalom"/>        <j:conditional xml:id="shabbat_arvit_veshamru">
          <tei:note type="instruction" xml:lang="en">On the Sabbath, Congregation and Reader:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:siddur:shabbat/arvit/verses/veshamru"/>        <j:endConditional target="#shabbat_arvit_veshamru"/>        <j:conditional xml:id="shabbat_arvit_regalim">
          <tei:note type="instruction" xml:lang="en">On Pesaḥ, Shavuoth and Sukkoth:</tei:note>
<j:all>          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="yom-tov">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs><j:any>          <tei:fs type="opensiddur:holiday">
            <tei:f name="pesah">
              <tei:numeric value="1" max="8"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:holiday">
            <tei:f name="shavuot">
              <tei:numeric value="1" max="2"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:holiday">
            <tei:f name="sukkot">
              <tei:numeric value="1" max="7"/>
            </tei:f>
          </tei:fs>          <tei:fs type="opensiddur:holiday">
            <tei:f name="shmini-atzeret">
              <tei:numeric value="1" max="2"/>
            </tei:f>
          </tei:fs></j:any></j:all>
        </j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:bible:leviticus/23/44"/>        <j:endConditional target="#shabbat_arvit_regalim"/>        <j:conditional xml:id="shabbat_arvit_rosh_hashanah">
          <tei:note type="instruction" xml:lang="en">On Rosh Hashanah:</tei:note>
          <tei:fs type="opensiddur:holiday">
            <tei:f name="rosh-hashana">
              <tei:numeric value="1" max="2"/>
            </tei:f>
          </tei:fs>
        </j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:siddur:shabbat/arvit/verses/tiku"/>        <j:endConditional target="#shabbat_arvit_rosh_hashanah"/>        <j:conditional xml:id="shabbat_arvit_half_kaddish">
          <tei:note type="instruction" xml:lang="en">When a minyan holds service:</tei:note>
          <tei:fs type="opensiddur:quorum">
            <tei:f name="minyan">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional><tei:p><tei:note type="instruction" xml:lang="en">Reader:</tei:note></tei:p><j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/yitgadal"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/yehe_shmeh"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/yitbarakh"/>        <j:endConditional target="#shabbat_arvit_half_kaddish"/><j:endDeclare target="#shabbat_arvit_service"/></tei:div>
    </tei:body>
