<tei:p><tei:pb n="767" ed="1949 concluding_prayers" facs="https://archive.org/download/PhilipBirnbaumHaSiddurHaShalemTheDailyPrayerBook1949/page/n791_medium.jpg"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon/harachaman/self"/>הָרַחֲמָן, הוּא יְבָרֵךְ אוֹתִי <j:conditional xml:id="festival_concluding_harachaman_self_wife-and-children">
          <tei:note type="instruction" xml:lang="en">Include wife and children:</tei:note>
          <tei:fs type="opensiddur:meal-context">
            <tei:f name="wife-and-children">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>וְאֶת אִשְׁתִּי וְאֶת זַרְעִי<j:endConditional target="#festival_concluding_harachaman_self_wife-and-children"/> וְאֶת כָּל אֲשֶׁר לִי.<tei:milestone unit="prayer-part"/></tei:p>
