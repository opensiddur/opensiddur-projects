  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:the_chassidim_are_going_to_ger">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_chassidim_are_going_to_ger/1"/>
        <tei:lg>
          <tei:l>Jadą Chassidim do góry, do góry</tei:l>
          <tei:l>Stare, Młode i bachury</tei:l>
          <tei:l>Jadą, jadą, ja-a-a-dą</tei:l>
          <tei:l>Jadą, jadą, ja-a-a-dą</tei:l>
          <tei:l>Jadą, jadą, ja-a-a-dą</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_chassidim_are_going_to_ger/2"/>
        <tei:lg>
          <tei:l>Chociaż w domu wszystko mają, wszystko mają</tei:l>
          <tei:l>A do Góry Uciekają</tei:l>
          <tei:l>Jadą, jadą, ja-a-a-dą... <tei:note type="instruction">(3×)</tei:note></tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Jadą Chassidim do góry, do góry...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_chassidim_are_going_to_ger/3"/>
        <tei:lg>
          <tei:l>W Czwartki, w piątki nie sypiają, nie sypiają</tei:l>
          <tei:l>całe noce chassidus gadają</tei:l>
          <tei:l>Jadą, jadą, ja-a-a-dą... <tei:note type="instruction">(3×)</tei:note></tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Jadą Chassidim do góry, do góry...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_chassidim_are_going_to_ger/4"/>
        <tei:lg>
          <tei:l>Wszyscy mają jedną wolę, jedną wole</tei:l>
          <tei:l>Stać blisko przy Rebbe stole</tei:l>
          <tei:l>Jadą, jadą, ja-a-a-dą... <tei:note type="instruction">(3×)</tei:note></tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Jadą Chassidim do góry, do góry...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_chassidim_are_going_to_ger/5"/>
        <tei:lg>
          <tei:l>Nic nikogo nie pytają, nie pytają</tei:l>
          <tei:l>tylko z Rebbe się witają</tei:l>
          <tei:l>Jadą, jadą, ja-a-a-dą... <tei:note type="instruction">(3×)</tei:note></tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Jadą Chassidim do góry, do góry...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_chassidim_are_going_to_ger/6"/>
        <tei:lg>
          <tei:l>Kiedy Rebbe daje sz’rajim, daje sz’rajim</tei:l>
          <tei:l>z tego mają Yiras szamaim</tei:l>
          <tei:l>Jadą, jadą , ja-a-a-dą... <tei:note type="instruction">(3×)</tei:note></tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Jadą Chassidim do góry, do góry...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_chassidim_are_going_to_ger/7"/>
        <tei:lg>
          <tei:l>Mięso jedzą, wódkę piją, wódkę piją</tei:l>
          <tei:l>Jejcer Horo za kapure biją</tei:l>
          <tei:l>Jadą, jadą, ja-a-a-dą... <tei:note type="instruction">(3×)</tei:note></tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Jadą Chassidim do góry, do góry...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_chassidim_are_going_to_ger/8"/>
        <tei:lg>
          <tei:l>A gdy Rebbe mówi Tojre, mówi Tojre</tei:l>
          <tei:l>uczy ich Avodas HaBojre</tei:l>
          <tei:l>Jadą, jadą, ja-a-a-dą... <tei:note type="instruction">(3×)</tei:note></tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Jadą Chassidim do góry, do góry...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_chassidim_are_going_to_ger/9"/>
        <tei:lg>
          <tei:l>A gdy z Rebbe się żegnają, sie żegnają</tei:l>
          <tei:l>Chassidus ze sobą zabierają</tei:l>
          <tei:l>Jadą, jadą, ja-a-a-dą</tei:l>
          <tei:l>Jadą, jadą, ja-a-a-dą</tei:l>
          <tei:l>Jadą, jadą, ja-a-a-dą</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Jadą Chassidim do góry, do góry</tei:l>
          <tei:l>Stare, Młode i bachury</tei:l>
          <tei:l>Jadą, jadą, ja-a-a-dą</tei:l>
          <tei:l>Jadą, jadą, ja-a-a-dą</tei:l>
          <tei:l>Jadą, jadą, ja-a-a-dą</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
