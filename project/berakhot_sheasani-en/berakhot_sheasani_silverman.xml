  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:berakhot_sheasani_silverman">
        <tei:head>Berakhot she’Asani, positive and inclusive formulations by rabbis Morris Silverman and Robert Gordis (1946)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:berakhot_sheasani_silverman/1"/>
        <tei:lg>
          <tei:l>Blessed art Thou</tei:l>
          <tei:l>O <j:divineName>Lord</j:divineName> <j:divineName>our God</j:divineName></tei:l>
          <tei:l>
            <j:divineName>King of the universe</j:divineName>
          </tei:l>
          <tei:l>who hast made me in Thine image.<tei:anchor xml:id="note_1"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:berakhot_sheasani_silverman/2"/>
        <tei:lg>
          <tei:l>Blessed art Thou</tei:l>
          <tei:l>O <j:divineName>Lord</j:divineName> <j:divineName>our God</j:divineName></tei:l>
          <tei:l>
            <j:divineName>King of the universe</j:divineName>
          </tei:l>
          <tei:l>who hast made me free.<tei:anchor xml:id="note_2"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:berakhot_sheasani_silverman/3"/>
        <tei:lg>
          <tei:l>Blessed art Thou</tei:l>
          <tei:l>O <j:divineName>Lord</j:divineName> <j:divineName>our God</j:divineName></tei:l>
          <tei:l>
            <j:divineName>King of the universe</j:divineName>
          </tei:l>
          <tei:l>who hast made me an Israelite.<tei:anchor xml:id="note_3"/></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" n="1" target="#note_1">
      <tei:p>Cf. Genesis 1:27</tei:p>
    </tei:note>
    <tei:note type="commentary" n="2" target="#note_2">
      <tei:p>A positive (default masculine) restatement of the phrase, “who hast not made me a slave.”</tei:p>
    </tei:note>
    <tei:note type="commentary" n="3" target="#note_3">
      <tei:p>An inclusive restatement of the phrase, “who hast not made me a gentile.”</tei:p>
    </tei:note>
  </tei:standOff>
