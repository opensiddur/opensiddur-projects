  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:paraliturgical_kaddish_for_mourners_landsberg">
        <tei:head>Paraliturgical ḳaddish for mourners, by Rabbi Max Landsberg (1884)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:paraliturgical_kaddish_for_mourners_landsberg/1"/>
        <tei:lg>
          <tei:l>From the depth of my sorrow I look up to thee,</tei:l>
          <tei:l><j:divineName>God</j:divineName> and <j:divineName>Father</j:divineName>,</tei:l>
          <tei:l>who art near to all that seek thee</tei:l>
          <tei:l>with a broken heart and a contrite spirit!<tei:anchor xml:id="note_1"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:paraliturgical_kaddish_for_mourners_landsberg/2"/>
        <tei:lg>
          <tei:l>In thy divine wisdom thou hast called hence</tei:l>
          <tei:l>my beloved <tei:note type="instruction">____</tei:note></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:paraliturgical_kaddish_for_mourners_landsberg/3"/>
        <tei:lg>
          <tei:l>Humbly and with silent resignation</tei:l>
          <tei:l>I bow before the decrees of thy holy will,</tei:l>
          <tei:l>O <j:divineName>God of Life</j:divineName>!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:paraliturgical_kaddish_for_mourners_landsberg/4"/>
        <tei:lg>
          <tei:l>Thou givest and takest away,</tei:l>
          <tei:l>thou sendest life and death.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:paraliturgical_kaddish_for_mourners_landsberg/5"/>
        <tei:lg>
          <tei:l>O, let me find comfort and consolation in my affliction;</tei:l>
          <tei:l>teach me even in severest trial</tei:l>
          <tei:l>to confide in thy goodness</tei:l>
          <tei:l>and to worship thy wisdom.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:paraliturgical_kaddish_for_mourners_landsberg/6"/>
        <tei:lg>
          <tei:l>May thy holy name be praised and glorified</tei:l>
          <tei:l>by the glad and the sorrowful,</tei:l>
          <tei:l>now and for evermore!</tei:l>
          <tei:l><tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
