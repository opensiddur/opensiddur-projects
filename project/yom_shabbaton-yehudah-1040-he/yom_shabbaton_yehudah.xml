  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yom_shabbaton_yehudah">
        <tei:head>יוֹם שַׁבָּתוֹן</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_shabbaton_yehudah/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">י</tei:seg>וֹם שַׁבָּתוֹן</tei:l>
          <tei:l>אֵין לִשְׁכּֽוֹחַ,</tei:l>
          <tei:l>זִכְרוֹ כְּרֵֽיחַ</tei:l>
          <tei:l>הַנִּיחֹֽחַ,</tei:l>
          <tei:l>יוֹנָה מָצְאָה בוֹ מָנֽוֹחַ,</tei:l>
          <tei:l>וְשָׁם יָנֽוּחוּ יְגִֽיעֵי כֹֽחַ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_shabbaton_yehudah/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הַ</tei:seg>יּוֹם נִכְבָּד</tei:l>
          <tei:l>לִבְנֵי אֱמוּנִים,</tei:l>
          <tei:l>זְהִירִים לְשָׁמְרוֹ</tei:l>
          <tei:l>אָבוֹת וּבָנִים,</tei:l>
          <tei:l>חָקוּק בִּשְׁנֵי</tei:l>
          <tei:l>לֻחוֹת אֲבָנִים,</tei:l>
          <tei:l>מֵרֹב אוֹנִים</tei:l>
          <tei:l>וְאַמִּיץ כֹּֽחַ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_shabbaton_yehudah/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וּ</tei:seg>בָֽאוּ כֻלָּם</tei:l>
          <tei:l>בִּבְרִית יַֽחַד,</tei:l>
          <tei:l>נַעֲשֶׂה וְנִשְׁמָע</tei:l>
          <tei:l>אָמְרוּ כְּאֶחָד,</tei:l>
          <tei:l>וּפָתְחוּ וְעָנוּ</tei:l>
          <tei:l>יְיָ אֶחָד,</tei:l>
          <tei:l>בָּרוּךְ הַנּוֹתֵן</tei:l>
          <tei:l>לַיָּעֵף כֹּֽח.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_shabbaton_yehudah/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">דִּ</tei:seg>בֶּר בְּקָדְשׁוֹ</tei:l>
          <tei:l>בְּהַר הַמּוֹר,</tei:l>
          <tei:l>יוֹם הַשְּׁבִיעִי</tei:l>
          <tei:l>זָכוֹר וְשָׁמוֹר,</tei:l>
          <tei:l>וְכָל פִּקּוּדָיו</tei:l>
          <tei:l>יַֽחַד לִגְמוֹר,</tei:l>
          <tei:l>חַזֵּק מָתְנַֽיִם</tei:l>
          <tei:l>וְאַמֵּץ כֹּֽח.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_shabbaton_yehudah/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הָ</tei:seg>עָם אֲשֶׁר נָע</tei:l>
          <tei:l>כַּצֹּאן תָּעָה,</tei:l>
          <tei:l>יִזְכּוֹר לְפָקְדוֹ</tei:l>
          <tei:l>בְּרִית וּשְׁבוּעָה,</tei:l>
          <tei:l>לְבַל יַעֲבָר בָּם</tei:l>
          <tei:l>מִקְרֵה רָעָה,</tei:l>
          <tei:l>כַּאֲשֶׁר נִשְׁבַּֽעְתָּ</tei:l>
          <tei:l>עַל מֵי נֹֽחַ.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
