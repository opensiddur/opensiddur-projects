      <tei:div corresp="urn:x-opensiddur:text:poem:aryeh_bayaar_damiti">
        <tei:pb n="35" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n71_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אַרְיֵה בַיַּעַר דָּמִיתִי וְנִמְשַׁלְתִּי בְחוֹבִי ·</tei:l> <tei:l>בְּמוֹ־נוֹאַל מִלָּתִי לָשׁוֹן הַבָּאָי ·</tei:l> <tei:l>נְחוּתִי מִקֵּשׁ כְּבֶן־קִישׁ וּמִסְפַּר חֲבֵרָיו ·</tei:l> <tei:l>כָּל־רֹאשׁ לָחֳלִי וְכָל־לֵבָב דַּוָּי׃</tei:l> <tei:l>דְּוֵי גוֹלָה וּנְקַלָּה הוֹנָאֲבְתִּי וְנֶעְכַּרְתִּי ·</tei:l> <tei:l>הוּנַעְתִּי חָגְתִּי וְרָוִיתִי רֹאשׁ וְנִשְׁכַּרְתִּי ·</tei:l> <tei:l>וּמִדּוֹחֶק אֲדוֹנִים חִנָּם לָהֶם נִמְכַּרְתִּי ·</tei:l> <tei:l>בְּהִתְעַטֵּף עָלַי נַפְשִׁי אֶת־יְיָ זָכַרְתִּי׃</tei:l> <tei:l>זָכַרְתִּי חַסְדְּךָ וְאַהֲבָתְךָ עָלַי כְּהִדְגִּילוֹ ·</tei:l> <tei:l>חוֹבוֹת הֶעֱבִירוּ וְאוֹתִי לְךָ הִסְגִּילוּ ·</tei:l> <tei:l>טְלָאֶיךָ עַתָּה בְחִנּוּן וּפִלּוּל יַרְגִּילוּ ·</tei:l> <tei:l>אֶבְיוֹנֵי אָדָם בִּקְדוֹשׁ יִשְׂרָאֵל יָגִילוּ׃</tei:l> <tei:l>יָגִילוּ יְרַנְּנוּ עֲבָדֶיךָ בְּפָקְדְךָ חוֹמוֹתַי ·</tei:l> <tei:l>כַּדְכֹד וְאַבְנֵי־חֵפֶץ הַגְּבוּלִים אֵימָתַי ·</tei:l> <tei:l>לְתֵל עוֹלָם עִירִי וּלְשֵׁפֶל רָמוֹתַי ·</tei:l> <tei:l>וְאַתָּה יְיָ עַד־מָתָי׃</tei:l> <tei:l>מָתַי תְּחַיֵּנוּ וּמִתְּהוֹמוֹת תַּעֲלֵנוּ ·</tei:l> <tei:l>נָאוֹר הָסֵר וְהָקֵל סִבְלוֹן עָלֵינוּ ·</tei:l> <tei:l>שֹׂבַע מַלֵּא אֲסָמֵינוּ הַצְלִיחָה מִפְעֲלֵינוּ ·</tei:l> <tei:l>יְהִי חַסְדְּךָ יְיָ עָלֵינוּ׃</tei:l> <tei:l>עָלֵינוּ הִמָּלֵא רַחֲמִים בַּצָּרָה דְרַשְׁתִּיךָ ·</tei:l> <tei:l>פֵּרַשְׂתִּי יָדַי אֵלֶיךָ בְּקִרְבִּי שִׁחֲרַתִּיךָ ·</tei:l> <tei:l>צָמְאָה <tei:pb n="36" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n73_medium.jpg"/>לְךָ נַפְשִׁי בַּלַּיְלָה כִּי־אִוִּיתִיךָ ·</tei:l> <tei:l>יְיָ אַל־אֵבוֹשָׁה כִּי־קְרָאתִיךָ׃</tei:l> <tei:l>קְרָאתִיךָ מֵעֹמֶק דְּוֵי עֵינַי רָמִים יָדַי נָשָׂאתִי הֲפִיצוֹתִי מַעְיְנֵי יִשְׁרִי כִּשְׁרוֹן מְחֵה וְהַעֲבֵר זְדוֹנִי ·</tei:l> <tei:l>יְיָ שְׁמַע תְּפִלָּתִי הַאֲזִינָה אֶל־תַּחֲנוּנָי׃</tei:l> <tei:l>תַּחֲנוּנַי אָזוֹן אוֹמְנִי מְחוֹלְלִי וּפְרוֹדְגִּי ·</tei:l> <tei:l>לְךָ צָפוּן תַּאֳב רַנְגִּי ·</tei:l> <tei:l>יוּצְלַל זְדוֹן וִיכֻפַּר חֵטְא שְׁגַגִּי ·</tei:l> <tei:l>אֲמָרַי הַאֲזִינָה יְיָ בִּינָה הֲגִיגִי׃</tei:l> <tei:l>הֲגִיגִי בַר יֵחָשֵׁב וְנִכוֹן פִּלּוּלִי ·</tei:l> <tei:l>שְׁמַע יָהּ סְלָחָה הוֹפֵי עֲקוּלִי ·</tei:l> <tei:l>חַזֵּק מַאֲמִינֶיהָ וּלְרָצוֹן יְהִי מִלּוּלִי ·</tei:l> <tei:l>הֶגְיוֹן לִבִּי לְפָנֶיךָ יְיָ צוּרִי וְגֹאֲלִי׃</tei:l> </tei:lg>
      </tei:div>
    </tei:body>
