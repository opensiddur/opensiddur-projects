      <tei:div corresp="urn:x-opensiddur:text:poem:afafunu_mayim_ad_nefesh">
        <tei:pb n="171" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n343_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו אֲפָפוּנוּ מַיִם עַד נֶפֶשׁ ·</tei:l> <tei:l>בָּאנוּ בְּעִמְקֵי מְצוּלָה ·</tei:l> <tei:l>גַּלֵּי יָם עָבְרוּ עָלֵינוּ ·</tei:l> <tei:l>דָּכִיוֹת תְּהוֹם כִּסָּתְנוּ׃</tei:l> <tei:l>הוֹדֵנוּ נֶהְפַּךְ לְמַשְׁחִית ·</tei:l> <tei:l>וְעוֹד לֹא עָצַרְנוּ כֹחַ ·</tei:l> <tei:l>זֹלְעָפוּנוּ עַל־חַטֹּאתֵינוּ ·</tei:l> <tei:l>חוֹלְחַלְנוּ עַל־רֹב פְּשָׁעֵינוּ׃</tei:l> <tei:l>טִכַּסְנוּ עֵצָה מַה־לַּעֲשׂוֹת ·</tei:l> <tei:l>יוֹעֵץ בְּקִרְבֵּנוּ אָיִן ·</tei:l> <tei:l>כּוֹנַנּוּ בְלֵב מַחֲשָׁבוֹת ·</tei:l> <tei:l>לְמֵרָחוֹק שְׂאַת דֵּעָה׃</tei:l> <tei:l>מַסּוֹרֶת בְּיָדֵנוּ מֵאֲבוֹתֵינוּ׃</tei:l> <tei:l>נְאָקָה תְשׁוּבָה <tei:pb n="172" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n345_medium.jpg"/>וּצְדָקָה ·</tei:l> <tei:l>סוֹתְרוֹת רוֹעַ־גְּזֵרוֹת ·</tei:l> <tei:l>עוֹד מְעַנּוֹת עָם׃</tei:l> <tei:l>פָּצַחְנוּ בְּהַסְכַּמַת־אַחַת ·</tei:l> <tei:l>צוֹם שֵׁנִי וַחֲמִישִׁי וְשֵׁנִי ·</tei:l> <tei:l>קָדוֹשׁ אוּלַי יַשְׁקוֹף ·</tei:l> <tei:l>רַחֲמָיו לְקַדֵּם לְרָגְזוֹ׃</tei:l> <tei:l>שַׁדַּי עָשִׂינוּ אֶת־שֶׁלָּנוּ ·</tei:l> <tei:l>תַּקִּיף עֲשֵׂה אֶת־שֶׁלְּךָ ·</tei:l> <tei:l>אַל־תֵּשֵׁב עִמָּנוּ בַּדִּין ·</tei:l> <tei:l>מִדֶּבֶר וּמֵחֶרֶב וּמֵרָעָב מַלְּטֵנוּ׃</tei:l> <tei:l>תֵּיקַר נַפְשֵׁנוּ בְּעֵינֶיךָ ·</tei:l> <tei:l>יָהּ סְלַח־לָנוּ מְחַל־לָנוּ כַּפֶּר לָנוּ ·</tei:l> <tei:l>כְּיוֹם רִדְתְּךָ בֶּעָנָן׃</tei:l> </tei:lg>
