    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:atah_helqi_vetsur_levavi">
        <tei:pb n="145" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n291_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אַתָּה חֶלְקִי וְצוּר לְבָבִי ·</tei:l> <tei:l>אֲוִיתִיךָ בַּלַּיְלָה עַל־מִשְׁכָּבִי ·</tei:l> <tei:l>אֵלֶיךָ יְיָ אֶקְרָא בַּעֲטוֹף לִבִּי׃</tei:l> <tei:l>בָּגַדְנוּ וְהִרְבִּינוּ הַמּוֹת וּכְעָסִים ·</tei:l> <tei:l>לְמִרְמָס אָנוּ מַעֲשִׂים כִּי אֵין בָּנוּ־מַעֲשִׂים׃</tei:l> <tei:l>גָּבְרוּ מְאֹד מְצוּקוֹתֵנוּ ·</tei:l> <tei:l>בָּרוֹאֶה שָׁגִינוּ פְּלִילוֹת פּוּקוֹתֵינוּ ·</tei:l> <tei:l>וּכְבֶגֶד עִדִּים כָּל־צִדְקוֹתֵנוּ׃</tei:l> <tei:l>דַּעַת חָסַרְנוּ פְּתָאִים מֵעָרְמָה ·</tei:l> <tei:l>תָּהֳלָה תָּשִׂים בְּמַלְאֲכֵי רוּמָה ·</tei:l> <tei:l>אַף כִּי־אֱנוֹשׁ רִמָּה׃</tei:l> <tei:l>הֵן אִיִּים תִּטּוֹל כַּדָּק ·</tei:l> <tei:l>וְאִם־עוּלְתָה תְּחַפֵּשׂ <tei:pb n="146" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n293_medium.jpg"/>וְתִבְדֹּק ·</tei:l> <tei:l>מַה־נְדַבֵּר וּמַה־נִּצְטַדָּק׃</tei:l> <tei:l>וָאֲבַקֵּשׁ גּוֹדֵר גָּדֵר וְעוֹמֵד בַּפֶּרֶץ ·</tei:l> <tei:l>וְיָשָׁר אֵין פָּנִים לְהָרִיץ ·</tei:l> <tei:l>אָבַד חָסִיד מִן־הָאָרֶץ׃</tei:l> <tei:l>זְמַן קִצִּי סָתוּם מִלִּידַע ·</tei:l> <tei:l>עֲוֹנוֹתַי הַטּוּ קַרְנִי לְהִגָּרֵעַ ·</tei:l> <tei:l>כִּי־פְשָׁעַי אֲנִי אֵדָע׃</tei:l> <tei:l>חָמָס אֶזְעַק וְאֵין־מוֹשִׁיעַ ·</tei:l> <tei:l>לָמָּה צַדִּיק מַכְבִּיר מַרְשִׁיעַ ·</tei:l> <tei:l>וְלֹא קָצְרָה יָדְךָ מֵהוֹשִׁיעַ׃</tei:l> <tei:l>טְלָאֶיךָ דּוֹפְקִים כַּיָּם הוֹמִים ·</tei:l> <tei:l>אֲנוּסִים הֲמוּטִים בְּיַד אֻמִּים ·</tei:l> <tei:l>לָמָּה הִשְׁכַּחְתָּנוּ תַּעַזְבֵנוּ לְאֹרֶךְ יָמִים׃</tei:l> <tei:l>יַעֲקֹב לִמְשִׁסָּה וְיִשְׂרָאֵל לְבוֹזְזִים ·</tei:l> <tei:l>כְּבוּדָה שְׂבֵעַת דִּפַּת חוֹזִים ·</tei:l> <tei:l>כְּרָחֵל נֶאֱלָמָה לִפְנֵי גוֹזְזִים׃</tei:l> <tei:l>כִּילַי וְנָבָל כַּמֶּלֶךְ בִּמְסִבּוֹ ·</tei:l> <tei:l>נָדִיב וְשׁוֹעַ נִטְרַד בְּחוֹבוֹ ·</tei:l> <tei:l>כִּכְלִי אֵין חֵפֶץ בּוֹ׃</tei:l> <tei:l>לֹא לְעוֹלָם תִּטּוֹר לְהַחֲרִיבֵנוּ ·</tei:l> <tei:l>שְׂמֹאלְךָ דִּחַתְנוּ וִימִינְךָ תְּקָרְבֵנוּ ·</tei:l> <tei:l>יְיָ עָשְׁקָה־לָּנוּ עָרְבֵנוּ׃</tei:l> <tei:l>מֵאָז תָּמִיד לָנוּ הַרְבָּה ·</tei:l> <tei:l>הֲקִיָּת שָׁבִים בְּרוּחַ נְדִיבָה ·</tei:l> <tei:l>אֶרְפָּא מְשׁוּבָתָם אֹהֲבֵם נְדָבָה׃</tei:l> <tei:l>נוֹבְעוֹת כְּנַחַל אֶגְלֵי ·</tei:l> <tei:l>הוֹלֵל שׁוֹקֵט וְשָׁבְתוּ גִּילִי ·</tei:l> <tei:l>וַאֲנִי כִּמְעַט נָטָיוּ רַגְלָי׃</tei:l> <tei:l>שֶׂה אוֹבֵד בַּקֵּשׁ עַם נוֹשַׁע ·</tei:l> <tei:l>אָוֶן מָצָא מִבֶּטֶן פֶּשַׁע ·</tei:l> <tei:l>צַדִּיק מָט לִפְנֵי רָשָׁע׃</tei:l> <tei:l>עֵדוּת בְּיַעֲקֹב בְּתְעוּדָה נֶחְתַּם ·</tei:l> <tei:l>בְּאֶרֶץ אוֹיֵב הִבְטַחְתָּ לְהַחֲיוֹתָם ·</tei:l> <tei:l>וְאַף־גַּם־זֹאת בִּהְיוֹתָם׃</tei:l> <tei:l>פְּשָׁעִים תַּעֲבִיר וְחוֹבוֹת תִּמְחוֹק ·</tei:l> <tei:l>הִרְחִיבָה שְּׁאוֹל נַפְשָׁהּ לִחְרוֹק ·</tei:l> <tei:l>וּפָעֲרָה פִיהָ לִבְלִי־חוֹק׃</tei:l> <tei:l>צְפֵה לְנַחְשׁוֹל קָרֵב לְהַפְשֵׁנוּ ·</tei:l> <tei:l>דַּלֵּנוּ הַעֲלֵנוּ מִטִּיט רִפְשֵׁנוּ ·</tei:l> <tei:l>שׁוּבָה יְיָ חַלְּצָה נַפְשֵׁנוּ׃</tei:l> <tei:l>קִדַּשְׁנוּ צוֹם בִּתְפִלָּה לִקְדָּם ·</tei:l> <tei:l>חוֹבֵשׁ וּצְרִי לְמַכָּתֵנוּ הַקְדֵּם ·</tei:l> <tei:l>זְכֹר עֲדָתְךָ קָנִיתָ קֶדֶם׃</tei:l> <tei:l>רֹגֶז הָנַח כַּעַס יַחֲשֹׂךְ ·</tei:l> <tei:l>אֲסוּרִים בַּעֲבוֹתוֹת אֲהוּב <tei:pb n="147" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n295_medium.jpg"/>וְחַמְשָׁךְ ·</tei:l> <tei:l>מִבֵּית כֶּלֶא יוֹשְׁבֵי חֹשֶׁךְ׃</tei:l> <tei:l>שִׁלּוּחַ קְרָא לִשְׁבוּרָה וּשְׁמוּטָה ·</tei:l> <tei:l>בְּרִית גֶּזַע שְׁבוֹר מַטֶּה ·</tei:l> <tei:l>רְפָא שְׁבָרֶיהָ כִּי־מָטָה׃</tei:l> <tei:l>תְּשׁוּבָה הֵשַׁבְתָּ לְתַנִּין וְזוֹחֵל ·</tei:l> <tei:l>תִּקְוָתִי הוּא סוֹלֵחַ וּמוֹחֵל ·</tei:l> <tei:l>הֵן יִקְטְלֵנִי לוֹ־אֲיַחֵל׃</tei:l> <tei:l>אֵלֵינוּ הַטֵּה בוֹרֵא אָזְנְךָ ·</tei:l> <tei:l>שְׁמַע יָהּ דוֹרְשֶׁךָ הַאֲזִינָה מְחַנְּנֶיךָ ·</tei:l> <tei:l>תִּכּוֹן תְּפִלָּתִי קְטֹרֶת לְפָנֶיךָ׃</tei:l> <tei:l>חַזֵּק כּוֹשֵׁל וְאַמֵּץ רִפְיוֹן ·</tei:l> <tei:l>מִקְדָּשׁ יַסֵּד יִשֵּׁב אַפִּרְיוֹן ·</tei:l> <tei:l>הֵיטִיבָה בִרְצוֹנְךָ אֶת־צִיּוֹן׃</tei:l> </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
