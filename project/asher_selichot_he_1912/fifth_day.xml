      <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/fifth_day">
        <tei:pb n="37" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n75_medium.jpg"/>
        <tei:head>סליחות ליום חמישי</tei:head>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/fifth_day/opening_instruction">
