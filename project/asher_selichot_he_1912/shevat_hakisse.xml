      <tei:div corresp="urn:x-opensiddur:text:poem:shevat_hakisse">
        <tei:pb n="127" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n255_medium.jpg"/>
        <tei:lg><tei:l>שֶׁבַח הַכִּסֵּא ·</tei:l> <tei:l>אֲשֶׁר לְמַעְלָה מִנִּשָּׂא ·</tei:l> <tei:l>יְחַלֶּה בַּעֲדֵנוּ לְצוּר הַמִּתְנַשֵּׂא׃</tei:l> <tei:l>מֶלֶךְ עַל כִּסֵּא ·</tei:l> <tei:l>לְעַמּוֹ יְהִי מַחְסֶה ·</tei:l> <tei:l>וְיִפֶן בְּצוּרָת־תָּם חֲקוּקָה בַּכִּסֵּא׃</tei:l> <tei:l>עַל הַיָּמִין אַרְיֵה ·</tei:l> <tei:l>יְחַלֶּה פְּנֵי אֶהְיֶה ·</tei:l> <tei:l>יָחוֹן וִירַחֲם זֶרַע כַּד יִהְיֶה׃</tei:l> <tei:l>וְיִשְׁעֵנוּ יֶהֱדֶה ·</tei:l> <tei:l>וְאוֹתָנוּ יְחַיֶּה ·</tei:l> <tei:l>וְיָשִׁיב הַמְּלוּכָה לְזֶרַע גּוּר אַרְיֵה׃</tei:l> <tei:l>נָא מֵהַשְּׂמֹאל שׁוֹר ·</tei:l> <tei:l>פְּגִיעָתֵנוּ יָשׁוּר ·</tei:l> <tei:l>לְלַמְּדֵנוּ הֵיטֵב הַמְצִיאֵנוּ לָאֲשׁוּר ·</tei:l> <tei:l>בְּרָכוֹת יַחְשׂוֹר ·</tei:l> <tei:l>וּמְרוּדֵנוּ יַעֲשׁוֹר ·</tei:l> <tei:l>וְיָשִׁיב לְבִצָּרוֹן הֲדָרַת־הוֹד בְּכוֹר־שׁוֹר׃</tei:l> <tei:l>רְאִית פְּנֵי אָדָם ·</tei:l> <tei:l>תְּחִנָּתֵנוּ יַקְדֵּם לִפְנֵי צוּר מָעוֹז יוֹצֵר הָאָדָם׃</tei:l> <tei:l>יַלְבִּין הַמְאָדָם ·</tei:l> <tei:l>יְעוֹרֵר הַנִּרְדָּם ·</tei:l> <tei:l>וְיִרְבֶּה הַמִּשְׂרָה ·</tei:l> <tei:l>לִקְרוּאֵי צֹאן אָדָם ·</tei:l> <tei:l>צִפְצוּף הַנֶּשֶׁר ·</tei:l> <tei:l>בִּכְנָפָיו יַחְשׁוֹר ·</tei:l> <tei:l>וְיָלִיץ צִדְקֵנוּ פְּנֵי אוֹהֵב יֹשֶׁר ·</tei:l> <tei:l>חֶלְקֵנוּ יְפַשֵּׁר ·</tei:l> <tei:l>וְעַפְעַפֵּנוּ יְיַשֵּׁר ·</tei:l> <tei:l>וִידַבֵּר בִּצְדָקָה לְעַם נְשׂוּאֵי נֶשֶׁר ·</tei:l> <tei:l>קְדָשֵׁי עֶלְיוֹנִים שְׂרָפִים וְאוֹפַנִּים ·</tei:l> <tei:pb n="128" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n257_medium.jpg"/><tei:l>הַפִּילוּ תְחִנָּתֵנוּ פְּנֵי אֲדֹנֵי הָאֲדֹנִים ·</tei:l> <tei:l>וְיִזְכּוֹר רִאשֹׁנִים ·</tei:l> <tei:l>וְאַהֲבַת אֵיתָנִים ·</tei:l> <tei:l>וְיָקִים שְׁבוּעָה לְדוֹרוֹת אַחֲרֹנִים׃</tei:l> </tei:lg>
      </tei:div>
