      <tei:div corresp="urn:x-opensiddur:text:poem:orkha_vaamitkha_shelah">
        <tei:pb n="108" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n217_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אוֹרְךָ וַאֲמִתְּךָ שְׁלַח ·</tei:l> <tei:l>אֱמוּנֶיךָ בְּטוּב הַצְלַח ·</tei:l> <tei:l>כִּי אַתָּה <tei:pb n="109" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n219_medium.jpg"/>יְיָ טוֹב וְסַלָּח׃</tei:l> <tei:l>בִּיטָה בְּעִנּוּי־נֶפֶשׁ ·</tei:l> <tei:l>בְּטוּבְךָ הוֹצִיאֵנִי לַחֹפֶשׁ ·</tei:l> <tei:l>כִּי־בָאוּ מַיִם עַד־נָפֶשׁ׃</tei:l> <tei:l>גַּעֲוָתֵינוּ יִהְיוּ נִקְשָׁבִים גָּלוּתֵנוּ הָשֵׁב לְיוֹשְׁבִים ·</tei:l> <tei:l>כִּי־גֵרִים אֲנַחְנוּ וְתוֹשָׁבִים׃</tei:l> <tei:l>דָּפַקְנוּ דַּלְתְּךָ לַחֲמוֹד ·</tei:l> <tei:l>דָּבַקְנוּ אֵלֶיךָ לִצְמוֹד ·</tei:l> <tei:l>כִּי דַלּוֹנוּ מְאֹד׃</tei:l> <tei:l>הֱלִיצוּנוּ זֵדִים בְּמֵצֵרֵינוּ ·</tei:l> <tei:l>הַצִּילֵנוּ וְנוֹדְךָ צוּרֵנוּ ·</tei:l> <tei:l>כִּי־הוֹשַׁעְתָּנוּ מִצָּרֵינוּ׃</tei:l> <tei:l>זְרוּיֶיךָ מְיַחֲלִים לְעוֹדְדָם ·</tei:l> <tei:l>וְזַכִּים בְּיִרְאָתְךָ לְסָעֳדָם ·</tei:l> <tei:l>כִּי־זֶה כָּל־הָאָדָם׃</tei:l> <tei:l>חֻקּוֹת הָעַמִּים תּוֹהוּ ·</tei:l> <tei:l>חֲשׁוּקָיו אַחֲרָיו יִנְהוּ ·</tei:l> <tei:l>כִּי־חַנּוּן וְרַחוּם הוּא׃</tei:l> <tei:l>טִירָתְךָ הֻשְׁמָה לְעִיִּים ·</tei:l> <tei:l>טִירָה בְּחוֹמוֹת בְּנוּיִים׃</tei:l> <tei:l>כִּי־טוֹב חַסְדְּךָ מֵחַיִּים׃</tei:l> <tei:l>יָדַעְתִּי וְאָשִׂיחָה בְּמַעֲנִי ·</tei:l> <tei:l>יֵבוֹשׁ וְיִכָּלֵם מְעַנִּי ·</tei:l> <tei:l>כִּי־יַעֲשֶׂה יְיָ דִּין עָנִי׃</tei:l> <tei:l>כִּבְּרוּ שִׂפְתֵי קָמַי ·</tei:l> <tei:l>כָּל־הַיּוֹם מְזַעֲמַי ·</tei:l> <tei:l>כִּי־כָלוּ בֶעָשָׁן יָמָי׃</tei:l> <tei:l>לָהֶם הָשֵׁב כְּפָעֳלָם ·</tei:l> <tei:l>לְעַמּוֹ יִלְמַד לְהוֹעִילָם ·</tei:l> <tei:l>כִּי־לֹא יִזְנַח לְעוֹלָם׃</tei:l> <tei:l>מְרַחֲמוֹ יִתֵּן מַאֲוָיו ·</tei:l> <tei:l>מִמֶּנּוּ יָסִיר דָּפְיוֹ ·</tei:l> <tei:l>כִּי מַה־טּוּבוֹ וּמַה־יָפְיוֹ׃</tei:l> <tei:l>נְשַׁמּוֹת הוּשְׁמוּ עָרַי ·</tei:l> <tei:l>נָכְרִים בָּאוּ שְׁעָרַי ·</tei:l> <tei:l>כִּי־נָשָׂאתִי חֶרְפַּת נְעוּרָי׃</tei:l> <tei:l>שׂוֹשׂ אָשִׂישׂ עָלֶיךָ ·</tei:l> <tei:l>שִׂיחַ לַעֲנוֹת גְּאוּלֶיךָ ·</tei:l> <tei:l>כִּי־שִׂמַּחְתַּנִי יְיָ בְּפָעֳלֶךָ׃</tei:l> <tei:l>עֱזוּז נוֹרָא וְאָיוֹם ·</tei:l> <tei:l>עַתָּה הַמְצִיאֵנוּ פִדְיוֹם ·</tei:l> <tei:l>כִּי־עָלֶיךָ הוֹרַגְנוּ כָל־הַיּוֹם׃</tei:l> <tei:l>פַּנֵּה דֶּרֶךְ עָקוֹב ·</tei:l> <tei:l>פְּאֵר הִלּוּלֶךָ לִנְקוֹב ·</tei:l> <tei:l>כִּי־פָדָה יְיָ אֶת־יַעֲקֹב׃</tei:l> <tei:l>צָרִים לְכַלּוֹת בַּחֲרֹץ ·</tei:l> <tei:l>צְפֵה מִשְּׁמֵי עָרֹץ ·</tei:l> <tei:l>כִּי־צֵל יָמֵינוּ עֲלֵי אָרֶץ׃</tei:l> <tei:l>קָרֵב קֵץ עֶדְנִי ·</tei:l> <tei:l>קוֹל לְהַשְׁמִיעַ לְעַנֵּינִי ·</tei:l> <tei:l>כִּי־קָרוֹב יוֹם יְיָ׃</tei:l> <tei:l>רָם זְרוֹעֲךָ תֵּרָאֶה ·</tei:l> <tei:l>רְעִיָּה פָּנִים הִתְרָאֶה ·</tei:l> <tei:l>כִּי־רָם יְיָ וְשָׁפָל יִרְאֶה׃</tei:l> <tei:l>שְׁמַע קוֹל תַּחֲנוּנִי ·</tei:l> <tei:pb n="110" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n221_medium.jpg"/><tei:l>שַׁוְעָתִי תַּעֲלֶה לִמְעוֹנִי ·</tei:l> <tei:l>כִּי שׁוֹמֵעַ אֶל אֶבְיוֹנִים יְיָ׃</tei:l> <tei:l>תָּחֹן בְּתוֹדָה תֵּרָצֶה ·</tei:l> <tei:l>תֹּאמַר לְעַמְּךָ אֶתְרַצֶּה ·</tei:l> <tei:l>כִּי־תוֹרָה מֵאִתִּי תֵצֵא ·</tei:l> <tei:l>שֶׁקֶל מֹאזְנַיִם יִכְבַּשׁ ·</tei:l> <tei:l>עֹז יַעְטֶה וְיִלְבָּשׁ ·</tei:l> <tei:l>כִּי־הוּא יַכְאִיב וְיֶחְבָּשׁ׃</tei:l> </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
