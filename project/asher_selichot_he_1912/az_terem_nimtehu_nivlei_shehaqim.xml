      <tei:div corresp="urn:x-opensiddur:text:poem:az_terem_nimtehu_nivlei_shehaqim">
        <tei:pb n="92" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n185_medium.jpg"/>
        <tei:lg><tei:l>אָז טֶרֶם נִמְתְּחוּ נִבְלֵי־שְׁחָקִים ·</tei:l> <tei:l>בָּאָרֶץ עַד לֹא־דֻבְּקוּ רְגָבִים׃</tei:l> <tei:l>גְּנָךְ שִׁבְעָה דְבָרִים הָיוּ מֻנָּבִים ·</tei:l> <tei:l>דָּת וְכֵס וְרִטִּית שׁוֹבָבִים׃</tei:l> <tei:l>הוֹד גַּן־עֵדֶן וְעָלֶק הֲבָהָבִים ·</tei:l> <tei:l>וּמְקוֹם כַּפָּרָה עַל־יָד מַקְרִיבִים׃</tei:l> <tei:l>זוֹהַר שֵׁם יִנּוֹן מְחוֹלֵל מֵחוֹבִים ·</tei:l> <tei:l>הֻכְנוּ אַלְפַּיִם קֹדֶם בְּרִית יְשׁוּבִים׃</tei:l> <tei:l>טְנוּנִים עַל־רָקִיעַ בּוֹלְטִים כִּשְׁבִיבִים ·</tei:l> <tei:l>יְעוּדִים וּמְשֻׁרָשִׁים פְּנֵי יוֹשֵׁב הַכְּרוּבִים׃</tei:l> <tei:l>כִּסֵּא הָיָה מֻנָּח בָּרָקִיעַ בְּיִצּוּבִים ·</tei:l> <tei:l>לְמוֹשַׁב מֶלֶךְ וְנוֹרָא עַל־סְבִיבִים׃</tei:l> <tei:l>מִימִינוֹ אֵשׁ־דָּת חֲקוּקָה בִנְכָתְבִים ·</tei:l> <tei:l>נְתוּנָה עַל בִּרְכּוֹ בְּשַׁעֲשׁוּעַ אֲהָבִים׃</tei:l> <tei:l>סָדוּר עַל־הַדָּרוֹם גַּן־רְטוּבִים ·</tei:l> <tei:l>עָרוּךְ עַל־הַצָּפוֹן תּוֹפֶת שַׁלְהָבִים׃</tei:l> <tei:l>פְּנֵי־הַמִּזְרָח יְרוּשָׁלַיִם הַבְּנוּיָה בְמַחֲצָבִים ·</tei:l> <tei:l>צָפוּן בְּתוֹכָהּ מִקְדָּשׁ־אֵל בִּישׁוּבִים׃</tei:l> <tei:l>קָבוּעַ בָּאֶמְצַע מִזְבַּח כִּפּוּר חִיּוּבִים ·</tei:l> <tei:l>רְבוּצָה עָלָיו אֶבֶן שְׁתִית חֲטוּבִים׃</tei:l> <tei:l>שֵׁם יִנּוֹן עָלֶיהָ חָקוּק בְּמִכְתָּבִים ·</tei:l> <tei:l>תֹּאַר שֵׁם־הַמְּפוֹרָשׁ בְּתָוִי נְלוּבִים׃</tei:l> <tei:l>שָׁמָּה בְּתוֹךְ לִפְנֵי מָאָזִין מֵאַשְׁנַבִּים לוּי תְּשׁוּבָה אֹרֶךְ לְנַדְוִים וּכְאֵבִים ·</tei:l> <tei:l>מְעַתֶּדֶת לְכַבֵּס צוֹאִים וּלְהַלְבִּישׁ מֻטָּבִים ·</tei:l> <tei:l>הָרֵק שֶׁמֶן עַל־רֹאשׁ שָׁבִים׃</tei:l> <tei:l>כֵּן אֲנַחְנוּ לָךְ עֲלָמִים וְשָׁבִים ·</tei:l> <tei:l>רְחַץ מִצִּחֵן וְהַשְׁלֵךְ טִמּוּם סְאָבִים ·</tei:l> <tei:l>בִּתְפִלָּה יְקַדְּמוּךָ בָּנִים־שׁוֹבָבִים ·</tei:l> <tei:l>יוֹם־יוֹם לְדָרְשָׁךְ בְּפִי־רְנִינִים׃</tei:l> <tei:l>יֵחָשֵׁב אֲמָרֵינוּ כְהָקְטֵר דָּמִים וַחֲלָבִים ·</tei:l> <tei:l>צִפְצוּפֵנוּ יְקֻבַּל כַּפְסוּנֵי פָרִים וּכְשָׂבִים׃</tei:l> <tei:l>חֲטָאֵינוּ הָעֵל בְּקַרְקַע נִטְפֵי־מְחוֹבִים ·</tei:l> <tei:l>קָרְבֵנוּ אֵלֶיךָ בַּחֲפִירַת רַחֲמֶיךָ הָרַבִּים׃</tei:l> </tei:lg>
