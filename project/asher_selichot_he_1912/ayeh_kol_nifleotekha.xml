      <tei:div corresp="urn:x-opensiddur:text:poem:ayeh_kol_nifleotekha">
        <tei:pb n="33" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n67_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אַיֵּה כָּל־נִפְלְאוֹתֶיךָ הַגְּדֹלוֹת וְהַנּוֹרָאוֹת ·</tei:l> <tei:l>אֲשֶׁר סִפְּרוּ־לָנוּ אֲבוֹתֵינוּ יְיָ צְבָאוֹת ·</tei:l> <tei:l>בְּרֶדֶת־יִשְׂרָאֵל מִצְרַיְמָה לְשִׁעְבּוּד וּתְלָאוֹת ·</tei:l> <tei:l>בְּחַבְלֵי־אָדָם מְשַׁכְתָּם וְלֹא־בְשַׁלְשְׁלָאוֹת׃</tei:l> <tei:l>גַּם מַעֲבִידֵיהֶם קָשֶׁה עֲבוֹדָה ·</tei:l> <tei:l>גַּזְרוּ בְּלֹא־זְכוּרִיהֶם לְאַבְּדָה ·</tei:l> <tei:pb n="34" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n69_medium.jpg"/><tei:l>דַּנְתָּם סְאָה בְּסָאָה מִדָּה בְמִדָּה ·</tei:l> <tei:l>דַּלִּים הוֹצֵאתָ בִּרְכוּשׁ כָּל־חֶמְדָּה׃</tei:l> <tei:l>הַיָּם וְגַלָּיו בְּעֻזְּךָ פּוֹרַרְתָּ ·</tei:l> <tei:l>הַיַּרְדֵּן הוֹבַשְׁתָּ וּבְרֶגֶל עָבְרוּ ·</tei:l> <tei:l>וּבַמִּדְבָּר כִּלְכַּלְתָּם וְדָבָר לֹא חָסְרוּ ·</tei:l> <tei:l>וּמַמְלָכוֹת וַעֲמָמִים בְּיָדָם נִמְסְרוּ׃</tei:l> <tei:l>זָנְחוּ טוֹב וּרְדָפוּם מַכְנִיעִים ·</tei:l> <tei:l>זָעֲקוּךָ וְשָׁמַעְתָּ וְהֶעֱמַדְתָּ־לָהֶם מוֹשִׁיעִים ·</tei:l> <tei:l>חָנוּ בְאַרְצָם כָּל־טוּב שְׂבֵעִים ·</tei:l> <tei:l>חָטְאוּ וְגָלוּ וּפְקַדְתָּם לְשִׁבְעִים׃</tei:l> <tei:l>טָפְלוּ שֶׁקֶר וְנִתְּנוּ לְמִרְמָס ·</tei:l> <tei:l>טְרוּדִים לְמַדְחֵפוֹת אַנְשֵׁי חָמָס ·</tei:l> <tei:l>יָצְאוּ מֵאַרְצָם וְקֵץ־דְּרוֹרָם נִכְמָס ·</tei:l> <tei:l>יָשְׁבוּ בַגּוֹיִם וְהָיוּ לָמַס׃</tei:l> <tei:l>כֹּחַ אַמֵּץ פְּלֵיטָה הַנִּשְׁאָרֶת ·</tei:l> <tei:l>כָּשְׁלָה כֹּחָהּ מִכֹּבֶד רָעָה מְמַאֶרֶת ·</tei:l> <tei:l>לְעֵת רִאשׁוֹנָה פְּקוּדָה מוּשְׁאָרֶת ·</tei:l> <tei:l>לְבֹא שְׁנִיָּה אָצָה מְמַהֶרֶת׃</tei:l> <tei:l>מֵעֵת לְעֵת צָרָתִי מְרֻבָּה מִיּוֹם שֶׁעָבַר קָשֶׁה הַבָּא ·</tei:l> <tei:l>נִלְאֵיתִי נְשׂא עוֹל־מַדְהֵבָה ·</tei:l> <tei:l>נוֹאֶמֶת מָרוּד וְהַבָּא הָאֱדוּנָה׃</tei:l> <tei:l>סְגֻלָּתְךָ דּוֹחֵק צוֹרֵר הַצָּר ·</tei:l> <tei:l>סוֹכֶה לְהָמִיר כְּבוֹדְךָ בְּצָר ·</tei:l> <tei:l>עַד־אָנָה יְיָ אֶקְרָא מִמֵּצַר ·</tei:l> <tei:l>עֲנֵנִי בַמֶּרְחָב יָהּ כִּי־יָדְךָ לֹא־תִקְצָר׃</tei:l> <tei:l>פְּשָׁעִים אִם־עָצְמוּ בֵינֵנוּ וּבֵינְךָ לְהַבְדִּילָה ·</tei:l> <tei:l>פַּרְגּוֹד אִם־נָעַל בִּפְנֵי הַתְּפִלָּה ·</tei:l> <tei:l>צוּר נָא כִּסֵּא כְבוֹדְךָ חֲתוֹר מְסִלָּה ·</tei:l> <tei:l>צַעֲקָתֵנוּ תָּבֹא לִפְנֵי כְבוֹדְךָ לְהִתְקַבְּלָה׃</tei:l> <tei:l>קְרָא שְׁנַת־רָצוֹן מֵעֹצֶב לְהִנָּפֵשׁ ·</tei:l> <tei:l>קַבֵּץ נְפוּצוֹתֵינוּ וַעֲבוֹר בְּרֹאשׁ ·</tei:l> <tei:l>רִיבָה יְיָ רִיב־נַפְשִׁי ·</tei:l> <tei:l>רְצֵה לְהַצִּילֵנִי אֱלֹהֵי קָדְשִׁי׃</tei:l> <tei:l>שִׁנֵּי־רְשָׁעִים בֶּחָצָץ תַּגְרֵס ·</tei:l> <tei:l>שְׁכוֹל וְאַלְמוֹן אוֹתָם תַּהֲרֹס ·</tei:l> <tei:l>תִּשְׁפֹּךְ דָּמָם אַרְצָה לָרֹס ·</tei:l> <tei:l>תְּמוּתָה הוֹתֵר וּבֶאֱמוּנָה תֵּאוֹרֵס׃</tei:l> <tei:l>גָּדוֹר פִּרְצַת סֻכַּת־דָּוִד הַנּוֹפֶלֶת ·</tei:l> <tei:l>רוֹמֵם קִרְיָה עַד־עָפָר <tei:pb n="35" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n71_medium.jpg"/>מֻשְׁפֶּלֶת ·</tei:l> <tei:l>שְׁבוּיָה נַחֵם נֶחָמָה מֻכְפֶּלֶת ·</tei:l> <tei:l>מְאוֹרַת הָאֵר וְתָאִיר מֵאֲפֵלֶת׃</tei:l> <tei:l>בְּנֵה עִירְךָ כִּימֵי עוֹלָם ·</tei:l> <tei:l>רַפֵּא מִזְבַּחֲךָ הֵיכָל וְאוּלָם ·</tei:l> <tei:l>יְהוּדָה וְיִשְׂרָאֵל שָׁם יַעֲבְדוּךָ כֻּלָּם ·</tei:l> <tei:l>וְיִתְגַּדֵּל שִׁמְךָ מֵעוֹלָם עַד־עוֹלָם׃</tei:l> </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
