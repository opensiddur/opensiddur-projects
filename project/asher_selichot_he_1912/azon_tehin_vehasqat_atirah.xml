      <tei:div corresp="urn:x-opensiddur:text:poem:azon_tehin_vehasqat_atirah">
        <tei:pb n="148" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n297_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אָזוֹן תְּחִן וְהַסְכֵּת עֲתִירָה ·</tei:l> <tei:l>אַף הָפֵר וְשַׁכֵּךְ עֶבְרָה ·</tei:l> <tei:l>בָּאֵי לְחַלּוֹתְךָ בְּנֶפֶשׁ מָרָה ·</tei:l> <tei:l>בְּשִׁמְךָ הַגָּדוֹל יִמְצְאוּ עֶזְרָה׃</tei:l> <tei:l>גַּעַת נֶאֱנָחִים עֱנוּתָם חֲזֵה ·</tei:l> <tei:l>גְּוִיּוֹת קוֹמֵם נָא אַל־תִּבְזֶה ·</tei:l> <tei:l>דְּרוֹשׁ עֶלְבּוֹנָם מִצָּר בּוֹזֶה ·</tei:l> <tei:l>דְּרוֹךְ פּוּרָה וְנֵצַח יִזֶּה׃</tei:l> <tei:l>הֲלֹא אַתָּה הָיִיתָ וְהִנְּךָ ·</tei:l> <tei:l>הָיוֹ תִהְיֶה בַּהֲדַר גְּאוֹנְךָ ·</tei:l> <tei:pb n="149" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n299_medium.jpg"/><tei:l>וְנֶאֱמַתָּ יִכּוֹן זֶרַע אֲמוּנְךָ ·</tei:l> <tei:l>וְהִנָּם כָּלִים מִתִּגְרַת חֲרוֹנְךָ׃</tei:l> <tei:l>זוֹעֲמוּ בְּאַוָּיִים וּמְמָאוֹיִים נִפְתּוּ ·</tei:l> <tei:l>זוֹרוּ בָּאֲפָסִים וְלֹא־נָחוּ ·</tei:l> <tei:l>חֲבֻלָה רוּחָם וְלֶעָפָר שָׁחוּ ·</tei:l> <tei:l>חָרְשׁוּ חוֹרְשִׁים וּמַעֲנִית הִפְתִּיחוּ׃</tei:l> <tei:l>טָבְעוּ בַבּוֹץ וְאֵין פּוֹצֶה ·</tei:l> <tei:l>טוֹרְפֵיהֶם שָׁלוּ מִקָּצֶה אֶל־קָצֶה ·</tei:l> <tei:l>יוֹם־יוֹם לוֹחֲצָם מְנַצֶּה ·</tei:l> <tei:l>יָד פּוֹרְשִׂים מִלַּחַץ לֵיצֵא׃</tei:l> <tei:l>כָּלוּ חַיִּים בְּיָגוֹן וַאֲנָחָה ·</tei:l> <tei:l>כוֹשֵׁל רַבָּה וְעָרְבָה שִׂמְחָה ·</tei:l> <tei:l>לְיֵשַׁע חוֹכִים וְהִנֵּה צְוָחָה ·</tei:l> <tei:l>לְמוֹטָם קָמִים וְכָרוּ שׁוּחָה׃</tei:l> <tei:l>מַעֲרִימִים סוֹד מִמְּךָ לְהַדִּיחָם ·</tei:l> <tei:l>מַכְבִּידִים עוֹל וּלְהַכְשִׁיל כֹּחָם ·</tei:l> <tei:l>נוֹאֲקִים אֵלֶיךָ בְּהִתְעַטֵּף רוּחָם ·</tei:l> <tei:l>נַחַת לִמְצֹא מִכֹּבֶד טָרְחָם׃</tei:l> <tei:l>שִׂיחַ צָגִים בְּמַעֲמַד צָפוּף ·</tei:l> <tei:l>סְלִיחָה מְבַקְּשִׁים בְּקָדְקֹד כָּפוּף ·</tei:l> <tei:l>עוֹשְׁקֵיהֶם יִקְנְאוּם וּנְתוּנָם לְשִׁסּוּף ·</tei:l> <tei:l>עַוִּים יִמַּסּוּ וְיִהְיוּ לִכְפוּף׃</tei:l> <tei:l>פְּדֵה דְּבֵקֶיךָ מֵחֵרֶץ וּכְלוֹי ·</tei:l> <tei:l>פַלְּטֵם מִצּוֹרֵר וּתְנֵם לְעִלּוּי ·</tei:l> <tei:l>צַוֵּה יְשׁוּעַת מְשַׁחֲרֶיךָ בְחִלּוּי ·</tei:l> <tei:l>צַדְּקֵם בְּדִינְךָ מִסְתָּר וְגָלוּי׃</tei:l> <tei:l>קַנּוֹא וְנוֹקֵם קַנֵּא לִשְׁמֶךָ ·</tei:l> <tei:l>קְצִין סַמְלוֹנִים מִצַּוָּאר עַמְּךָ ·</tei:l> <tei:l>רְאֵה עֲמָלֵינוּ וְשׁוּב מִזַּעֲמֶךָ ·</tei:l> <tei:l>רִיבָה רִיבֵנוּ מֵעַם הָרָמָה׃</tei:l> <tei:l>שִׁבְעָתַיִם הָשֵׁב לְחֵיק מְאַנְּנֵי ·</tei:l> <tei:l>שַׁכֵּר הַאֲצֵךְ מִדַּם מְעַנַּי ·</tei:l> <tei:l>תִּפְנֶה אָזְנְךָ לְקוֹל תַּחֲנוּנַי ·</tei:l> <tei:l>תִּרְצֵנִי בְקָרְאִי יְיָ אֲדֹנָי׃</tei:l> </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
