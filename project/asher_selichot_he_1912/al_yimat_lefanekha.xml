      <tei:div corresp="urn:x-opensiddur:text:poem:al_yimat_lefanekha">
        <tei:pb n="47" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n95_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אַל יִמְעַט לְפָנֶיךָ אֶת־כָּל־הַתְּלָאָה ·</tei:l> <tei:l>אֲשֶׁר אֵיפְךָ מִימֵי־קֶדֶם מִיצָאָה ·</tei:l> <tei:l>בְּאֵין־צָרִי וּתְעָלָה וּרְפוּאָה ·</tei:l> <tei:l>בִּקְקוּם בּוֹקְקִים בְּלַחַץ וְהוֹנְבִיאָה׃</tei:l> <tei:l>גָּבְרוּ עֲוֹנוֹתַי וְתַרְבֵּנִי לְפִיהֶם בִּסְאַסְאָה ·</tei:l> <tei:l>גְּמַלְתִּי רָעָה וְשִׁלַּמְתִּי סָאָה בְּסָאָה ·</tei:l> <tei:l>דִּמִּיתִי בְּרוֹב־חֲטָאִי לִסְדוֹם הַחַטָּאָה ·</tei:l> <tei:l>דִּירָתִי חָרְבָה וְגָלִיתִי מֵאֶרֶץ־נָוָאָה׃</tei:l> <tei:l>הִנְנִי עֲזוּבָה וּנְטוּשָׁה גְעוּלָה וּשְׂנוּאָה ·</tei:l> <tei:l>הוֹנוּנִי מוֹנַי הוֹי נִגְאָלָה וּמוֹרְאָה ·</tei:l> <tei:l>וְתָזוּג מִשָּׁלוֹם נַפְשִׁי מִיגִיעַת־לְאָה ·</tei:l> <tei:l>וַתְּהִי דִמְעָתִי לֶחֶם תַּבְרָאָה׃</tei:l> <tei:l>זָכְרִי יָמִים מִקֶּדֶם הָיִיתִי פְּלִיאָה ·</tei:l> <tei:l>נָוָה זָר וּמְקֻשָּׁטָה כְּכַלָּה־נָאָה ·</tei:l> <tei:l>חֻפַּת מְשׂוֹשִׂי הָאֵבַלְתִּי בְּהוֹלֵלָה וְסוֹבְאָה ·</tei:l> <tei:l>חִלַּלְתִּי נִזְרִי כְּמוֹעֶלֶת אֲשֶׁר נִטְמְאָה׃</tei:l> <tei:l>טִהֲרַנִי בְּאַהֲבָתוֹ וְיִעֲדַנִי עוֹד לְאִשָּׁאָה ·</tei:l> <tei:l>טִנַּפְתִּי מַעַשׂ וְלָעַגְתִּי דִּבְרֵי־נְבוּאָה ·</tei:l> <tei:l>יְקָשַׁנִי אַחַר־כֵּן וְנִלְכַּדְתִּי בְּיוֹם־שׁוֹאָה ·</tei:l> <tei:l>יָגַעְתִּי בְּרָעָה אַחַר רָעָה בָּאָה׃</tei:l> <tei:l>כָּמָהְתִּי לָאִישׁ הָרִאשׁוֹן וְנַפְשִׁי לוֹ צְמֵאָה ·</tei:l> <tei:l>כִּי־אָז מֵעַתָּה הָיִיתִי בְּרִיאָה ·</tei:l> <tei:l>לְאַהֲבָתוֹ דָמִיתִי הֱיוֹת בִּכְנָפָיו חֲבוּאָה ·</tei:l> <tei:l>לוֹ אַיֵּחֵל אִם־יִקְטְלֵנִי בִכְלִיאָה ·</tei:l> <tei:l>מַה־בֶּצַע בְּדָמִי בִּהְיוֹתִי לְמִשָּׁאָה ·</tei:l> <tei:l>מִי כָמוֹנִי לְיַחֲדְךָ בְּאַהֲבָה וְיִרְאָה׃</tei:l> <tei:l>נוֹרָא וְאָיוֹם נַפְשִׁי לְךָ קוֹרְאָה ·</tei:l> <tei:l>נִדְבַת־פִּי רְצֵה בְּקָרְבָּן הַעֲלָאָה ·</tei:l> <tei:l>שְׁדַר־שַׁוְעִי יִרְאֶה לְפָנֶיךָ בְּהַרְצָאָה ·</tei:l> <tei:l>שִׂים מִעוּט־דָּמִי כְּדַם הַמְצָאָה ·</tei:l> <tei:l>עוֹז־חֵלְבִּי שָׂא כְּחֵלֶב הַקְלָאָה ·</tei:l> <tei:l>עֲנֵנִי וְחָנֵּנִי רָם גָּאֹה־גָאָה׃</tei:l> <tei:l>פַּזֵּר חֲרוֹנְךָ עַל־אוֹיְבֶיךָ בְּקִנְאָה ·</tei:l> <tei:l>מִי־יוּכַל מִשְׁטָפִים לְגָאֹה־גָאָה ·</tei:l> <tei:l>צָמְתוּ בַבּוֹר חַיַּי <tei:pb n="48" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n97_medium.jpg"/>בְּמֵימֵי־רֶפֶשׁ וְצוֹאָה ·</tei:l> <tei:l>צַחֲנָתָם הֶאֱכִילוּנִי עֲבוּר טָהֳרָתִי לְטַמְּאָה ·</tei:l> <tei:l>קְצִינַי נֶחְנְקוּ עַל־קֹדֶשׁ הַיִרְאָה ·</tei:l> <tei:l>קוֹעֵי וְנִכְבָּדַי גּוֹרְדוּ בְּטִיט וְצֹאָה ·</tei:l> <tei:l>רוּחִי רָפְתָה עַל־הַתּוֹרָה הַמֻּפְלָאָה ·</tei:l> <tei:l>רְאִיתִיהָ פְּרוּעָה וּקְרוּעָה וּבְאֵשׁ קְלוּאָה׃</tei:l> <tei:l>שָׁבַת מְשׂוֹשׂ לִבִּי וְהָיִיתִי נִדְכָּאָה ·</tei:l> <tei:l>שַׁחוֹתִי וְנָעִיתִי בִּדְרִיסַת בְּנֵי לְבִיאָה ·</tei:l> <tei:l>תָּעָה לִבִּי וּפַלָּצוּת בִּעְתַּת וְהָדְכָּאָה ·</tei:l> <tei:l>תָּעִיתִי כְּשֶׂה אֹבֵד מִפֵּאָה לְפֵאָה ·</tei:l> <tei:l>מֵרוֹב־כַּעַס וּמִקּוֹצֶר־רוּחַ נְכָאָה ·</tei:l> <tei:l>שׁוֹאֶגֶת וְנוֹהֶמֶת לְךָ נַחֲלָתְךָ הַנִּלְאָה הַעַל־אֵלֶּה תִתְאַפַּק בְּאֻמָּה טְמֵאָה ·</tei:l> <tei:l>בְּרָקְךָ לְהַבְרִיק עָלֶיהָ פְּתַח לְהַרְאָה ·</tei:l> <tei:l>שְׁפֹר מִרְמָה חִצָּךְ וְחַרְבְּךָ הַבְּרִיאָה ·</tei:l> <tei:l>מֵחֶלְבָּהּ וּמִבְּשָׂרָהּ שַׂבֵּעַ אַיָּה וְרָאָה ·</tei:l> <tei:l>וּנְקָמָה הַכְּתוּבָה עֲלֵיהֶם תִּקְרַב וְתָבוֹאָה ·</tei:l> <tei:l>אֻמָּתְךָ עַל־כָּל־גּוֹי לְנַשָּׂאָה ·</tei:l> <tei:l>לְהוֹדִיעַ לְכָל שֶׁעוֹל־חַי נָשָׂאָה ·</tei:l> <tei:l>חֲזֹק גּוֹאֲלָה עַל־אֶבְרָתוֹ יְשָׂאָה ·</tei:l> <tei:l>זְבוּל־קָדְשׁוֹ בְּשִׂמְחַת־עוֹלָם יְבִיאָה ·</tei:l> <tei:l>קִנְיַן כָּל־טוּב לְהַשְׂבִּיעָה וּלְמַלְּאָה׃</tei:l> </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
