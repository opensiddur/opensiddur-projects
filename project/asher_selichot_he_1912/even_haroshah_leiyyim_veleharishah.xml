      <tei:div corresp="urn:x-opensiddur:text:poem:even_haroshah_leiyyim_veleharishah">
        <tei:pb n="176" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n353_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו אֶבֶן הָרֹאשָׁה ·</tei:l> <tei:l>לְעִיִּים וְלַחֲרִישָׁה ·</tei:l> <tei:l>וְנוֹחֲלֵי מוֹרָשָׁה ·</tei:l> <tei:l>מְנוֹד רֹאשׁ בִּלְאֻמִּים׃</tei:l> <tei:l>בְּקִרְבִּי לֵב נִכְאָב ·</tei:l> <tei:l>וְנִדְוֶה וְנִדְאָב ·</tei:l> <tei:l>וְנִשְׁאַרְנוּ כְּאֵין אָב ·</tei:l> <tei:l>וְהָיִינוּ כִּיתוֹמִים׃</tei:l> <tei:l>רַכָּה וַעֲנֻגָּה ·</tei:l> <tei:l>כְּשׁוֹשַׁנִּים סוּגָה ·</tei:l> <tei:l>עַתָּה הִיא נוּגָה ·</tei:l> <tei:l>מְסוּרָה בְּיַד קָמִים׃</tei:l> <tei:l>הָיְתָה כְּאַלְמָנָה ·</tei:l> <tei:l>קִרְיָה נֶאֱמָנָה ·</tei:l> <tei:l>וְזֶרַע מִי־מָנָה ·</tei:l> <tei:l>נִמְכְּרוּ בְּלֹא־דָמִים׃</tei:l> <tei:l>מְעֻנָּגָה וְרַכָּה ·</tei:l> <tei:l>צָלְחָה לִמְלוּכָה ·</tei:l> <tei:l>וּמַעֲנִיתָהּ אָרְכָה ·</tei:l> <tei:l>זֶה כַּמָּה יָמִים׃</tei:l> <tei:l>בֵּית יַעֲקֹב לְבִזָּה ·</tei:l> <tei:l>לְלַעַג וּלְעַזָּה ·</tei:l> <tei:l>וְהָעִיר הָעַלִּיזָה ·</tei:l> <tei:l>לְמַטְעֵי כְרָמִים׃</tei:l> <tei:l>רְוָיָה הַתַּרְעֵלָה ·</tei:l> <tei:l>בְּיַד בְּנֵי־עַוְלָה ·</tei:l> <tei:l>הָרְצוּיָה כְעוֹלָה ·</tei:l> <tei:l>וּכְקִטֹרֶת סַמִּים׃</tei:l> <tei:l>מָאֲסָה לְזוֹנָה ·</tei:l> <tei:l>תּוֹרַת אֲבִי זָנוּחַ ·</tei:l> <tei:l>וְלֹא מָצְאָה מְנוּחַ ·</tei:l> <tei:l>לֵילוֹת וְיָמִים׃</tei:l> <tei:l>נוֹרָא אֵל עֶלְיוֹן ·</tei:l> <tei:l>מִמְּךָ יְהִי צִבְיוֹן ·</tei:l> <tei:l>לְהָשִׁיב לְרִיב צִיּוֹן ·</tei:l> <tei:l>שְׁנַת שִׁלּוּמִים׃</tei:l> <tei:l>חַדֵּשׁ יָמֵינוּ כְּקֶדֶם ·</tei:l> <tei:l>מְעוֹנָה אֱלֹהֵי קֶדֶם ·</tei:l> <tei:l>וְלַבֵּן כַּצֶּמֶר אוֹדֶם ·</tei:l> <tei:l>וְכַשֶּׁלֶג כְּתָמִים׃</tei:l> <tei:l>חַזְּקֵנוּ בְּיִרְאָתֶךָ ·</tei:l> <tei:l>וּבְקִיּם תּוֹרָתֶךָ ·</tei:l> <tei:l>וּפָקְדֵנוּ בִּישׁוּעָתֶךָ ·</tei:l> <tei:l>אֵל מָלֵא רַחֲמִים׃</tei:l> </tei:lg>
      </tei:div>
