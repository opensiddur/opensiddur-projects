    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:honenu_adonai_honenu"><tei:pb n="48" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n97_medium.jpg"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:honenu_adonai_honenu/honenu"/><tei:lg><tei:l>חָנֵּנוּ יְיָ חָנֵּנוּ ·</tei:l> <tei:l>עֲנֵנוּ יְיָ עֲנֵנוּ ·</tei:l> <tei:l><tei:seg type="refrain">עָזְרֵנוּ אֱלֹהֵי יִשְׁעֵנוּ כִּי־עָלֶיךָ נִשְׁעָנוּ׃</tei:seg></tei:l></tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:honenu_adonai_honenu/eleh_beshalishmo"/><tei:lg><tei:l>אֵלֶּה בִשְׁלִשְׁמוֹ ·</tei:l> <tei:l>וְאֵלֶּה בְּפָרָשִׁימוֹ בַקְּרָב ·</tei:l> <tei:l>וַאֲנַחְנוּ בְּשֵׁם קָדְשְׁךָ לְהִתְעָרֵב ·</tei:l> <tei:l>שׁוֹכֵן־שְׁחַק לְיִשְׁעֵנוּ תִּקְרָב׃</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>עזרנו</tei:abbr><tei:expan>עָזְרֵנוּ אֱלֹהֵי יִשְׁעֵנוּ כִּי־עָלֶיךָ נִשְׁעָנוּ׃</tei:expan></tei:choice></tei:seg></tei:l></tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:honenu_adonai_honenu/eleh_belegyonam"/><tei:lg><tei:l>אֵלֶּה בְלִגְיוֹנָם ·</tei:l> <tei:l>וְאֵלֶּה בִגְאוֹנָם מִתְפָּאֲרִים ·</tei:l> <tei:l>וַאֲנַחְנוּ בְרַב לְהוֹשִׁיעַ מִתְחַבְּרִים לַעֲזוֹר לְאֵין־כֹּחַ מַכְבִּירִים ·</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>עזרנו</tei:abbr><tei:expan>עָזְרֵנוּ אֱלֹהֵי יִשְׁעֵנוּ כִּי־עָלֶיךָ נִשְׁעָנוּ׃</tei:expan></tei:choice></tei:seg></tei:l></tei:lg> <tei:pb n="49" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n99_medium.jpg"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:honenu_adonai_honenu/eleh_bemaginam"/><tei:lg><tei:l>אֵלֶּה בְמָגִנָּם וְאֵלֶּה בְצִנָּם מִסְתָּרִים ·</tei:l> <tei:l>וַאֲנַחְנוּ בְאִמְרָתְךָ מַחֲסֶה תָרִים ·</tei:l> <tei:l>מִזֶּרֶם־עָרִיצִים הֱיוֹת נִסְתָּרִים׃</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>עזרנו</tei:abbr><tei:expan>עָזְרֵנוּ אֱלֹהֵי יִשְׁעֵנוּ כִּי־עָלֶיךָ נִשְׁעָנוּ׃</tei:expan></tei:choice></tei:seg></tei:l></tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:honenu_adonai_honenu/eleh_betsahelah"/><tei:lg><tei:l>אֵלֶּה בְּצָהֳלָה וְשַׁעֲט ·</tei:l> <tei:l>וְאֵלֶּה בְּצִחְצוּחָה וּמְעַט ·</tei:l> <tei:l>וַאֲנַחְנוּ בְאוֹר בַּשַּׂלְמָה עָט ·</tei:l> <tei:l>מָרוֹם שָׂרִים דִּכּוּי בְּעָט׃</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>עזרנו</tei:abbr><tei:expan>עָזְרֵנוּ אֱלֹהֵי יִשְׁעֵנוּ כִּי־עָלֶיךָ נִשְׁעָנוּ׃</tei:expan></tei:choice></tei:seg></tei:l></tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:honenu_adonai_honenu/eleh_behanufat"/><tei:lg><tei:l>אֵלֶּה בַּהֲנוּפַת תְּרִיס ·</tei:l> <tei:l>וְאֵלֶּה בִּשְׁפְעַת־קַלְגַּסִּים ·</tei:l> <tei:l>וַאֲנַחְנוּ בְּמָגוֹן חוֹסִים ·</tei:l> <tei:l>בְּמָעוֹן מִתְגַּנְּסִים מַטֵּה גְּאוֹן גַּסִּים׃</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>עזרנו</tei:abbr><tei:expan>עָזְרֵנוּ אֱלֹהֵי יִשְׁעֵנוּ כִּי־עָלֶיךָ נִשְׁעָנוּ׃</tei:expan></tei:choice></tei:seg></tei:l></tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:honenu_adonai_honenu/eleh_beqarnei"/><tei:lg><tei:l>אֵלֶּה בְּקַרְנֵי נְבָחִים ·</tei:l> <tei:l>וְאֵלֶּה בְּקוֹל צוֹחִים ·</tei:l> <tei:l>וַאֲנַחְנוּ בְקוֹלוֹ בְּמֵי־שְׁבָחִים ·</tei:l> <tei:l>מְפָרֵק וּמְפוֹצֵץ סַלְעֵי־צְחִיחִים׃</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>עזרנו</tei:abbr><tei:expan>עָזְרֵנוּ אֱלֹהֵי יִשְׁעֵנוּ כִּי־עָלֶיךָ נִשְׁעָנוּ׃</tei:expan></tei:choice></tei:seg></tei:l></tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:honenu_adonai_honenu/eleh_betakhus_arkhan"/><tei:lg><tei:l>אֵלֶּה בְּטָכוּס־עָרְכָן ·</tei:l> <tei:l>וְאֵלֶּה בְּמַרְכוּס־צִרְכָן ·</tei:l> <tei:l>וַאֲנַחְנוּ בְּאֵין כְּעֶרְכּוֹ עַרְכָּן וְאָכֵן מֵעִים מוּכָן ·</tei:l> <tei:l>לְבָמוֹת הוֹרְכָן׃</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>עזרנו</tei:abbr><tei:expan>עָזְרֵנוּ אֱלֹהֵי יִשְׁעֵנוּ כִּי־עָלֶיךָ נִשְׁעָנוּ׃</tei:expan></tei:choice></tei:seg></tei:l></tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:honenu_adonai_honenu/eleh_benitshonmo"/><tei:lg><tei:l>אֵלֶּה בְּנִצְחוֹנְמוֹ וְאֵלֶּה בְּרִצְחוֹנְמוֹ הַבִּטְחוֹת ·</tei:l> <tei:l>וַאֲנַחְנוּ בְּשֵׁם נֶצַח־יִשְׂרָאֵל כַּפֵּינוּ שְׁטוּחוֹת ·</tei:l> <tei:l>מִלְעָרִיץ וּמִלְרֹא וּמִלְרַךְ מְנוּחוֹת ·</tei:l> <tei:l><tei:seg type="refrain">עָזְרֵנוּ אֱלֹהֵי יִשְׁעֵנוּ כִּי־עָלֶיךָ נִשְׁעָנוּ׃</tei:seg></tei:l><tei:l><tei:choice><tei:abbr>חננו וכו׳</tei:abbr><tei:expan>חָנֵּנוּ יְיָ חָנֵּנוּ · עֲנֵנוּ יְיָ עֲנֵנוּ · עָזְרֵנוּ אֱלֹהֵי יִשְׁעֵנוּ כִּי־עָלֶיךָ נִשְׁעָנוּ׃</tei:expan></tei:choice></tei:l></tei:lg> <tei:milestone unit="stanza"/></tei:div>
    </tei:body>
  </tei:text>
