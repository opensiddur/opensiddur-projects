      <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_fifth_day">
        <tei:pb n="140" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n281_medium.jpg"/>
        <tei:head>סליחות ליום חמישי של עשרת ימי תשובה</tei:head>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_fifth_day/opening_instruction">
          <j:conditional xml:id="penitential_fifth_day_opening_instruction_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_fifth_day/opening_instruction/printed">
            <tei:pb n="140" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n281_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say from <tei:foreign xml:lang="he">אַשְׁרֵי</tei:foreign> page 1, till <tei:foreign xml:lang="he">כִּי רַבּוּ</tei:foreign> page 7, after which say the following— </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_fifth_day_opening_instruction_printed"/>
          <j:conditional xml:id="penitential_fifth_day_opening_instruction_expanded">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <j:declare xml:id="penitential_fifth_day_opening_ten_days">
            <tei:fs type="opensiddur:holiday-aggregate">
              <tei:f name="aseret-ymei-tshuva">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:declare>
          <j:transclude target="urn:x-opensiddur:text:prayer:ashrei"/>
          <j:transclude target="urn:x-opensiddur:text:prayer:kaddish/selichot_preface"/>
          <j:transclude target="urn:x-opensiddur:text:prayer:kaddish/chatzi"/>
          <j:transclude target="urn:x-opensiddur:text:prayer:lekha_adonai_hatsedaqah"/>
          <j:transclude target="urn:x-opensiddur:text:prayer:shomea_tefillah"/>
          <j:endDeclare target="#penitential_fifth_day_opening_ten_days"/>
          <j:endConditional target="#penitential_fifth_day_opening_instruction_expanded"/>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_fifth_day/selah_lanu_avinu">
          <tei:pb n="140" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n281_medium.jpg"/>
          <tei:lg><tei:l>סְלַח־לָנוּ אָבִינוּ כִּי־בְרוֹב אוֹלְתֵּנוּ שָׁגִינוּ ·</tei:l> <tei:l>מְחַל־לָנוּ מַלְכֵּנוּ כִּי־רַבּוּ עֲוֹנֵינוּ׃</tei:l> </tei:lg>
        </tei:div>
        <j:transclude target="urn:x-opensiddur:text:poem:am_adonai_hizqu_venithazzaqah"/>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_fifth_day/pair_after_am">
          <j:conditional xml:id="penitential_fifth_day_pair_after_am_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_fifth_day/pair_after_am/printed">
            <tei:pb n="141" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n283_medium.jpg"/>
            <tei:note type="instruction" xml:lang="he">כי על רחמיך · אל ארך אפים · ויעבור · </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_fifth_day_pair_after_am_printed"/>
          <j:conditional xml:id="penitential_fifth_day_pair_after_am_expanded">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <j:transclude target="urn:x-opensiddur:text:prayer:ki_al_rahamekha"/>
          <j:transclude target="urn:x-opensiddur:text:prayer:el_erekh_apayim"/>
          <j:transclude target="urn:x-opensiddur:text:prayer:vayaavor/selichot_preliminary"/>
          <j:endConditional target="#penitential_fifth_day_pair_after_am_expanded"/>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_fifth_day/eleikha_nasanu">
          <tei:pb n="141" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n283_medium.jpg"/>
          <tei:lg><tei:l>אֵלֶיךָ נָשָׂאנוּ אֶת־עֵינֵינוּ ·</tei:l> <tei:l>הַיֹּשְׁבִי בַּשָּׁמָיִם׃</tei:l> <tei:l>בְּקָרְאֵנוּ עֲנֵנוּ אֱלֹהֵי צִדְקֵנוּ בַּצָּר הִרְחַבְתָּ לָּנוּ חָנֵּנוּ וּשְׁמַע תְּפִלָּתֵנוּ׃</tei:l> <tei:l>שׁוּבוּ שׁוּבוּ אָמַרְתָּ לָנוּ ·</tei:l> <tei:l>וְעַל־הַתְּשׁוּבָה מֵרֹאשׁ הִבְטַחְתָּנוּ׃</tei:l> <tei:l>רַחֲמֶיךָ רַבִּים יְיָ כְּמִשְׁפָּטֶיךָ חַיֵּנוּ׃</tei:l> <tei:l>אַל־תָּבֹא בְמִשְׁפָּט עִמָּנוּ ·</tei:l> <tei:l>כִּי לֹא־יִצְדַּק לְפָנֶיךָ כָל־חָי׃</tei:l> <tei:l>כְּרַחֵם אָב עַל בָּנִים כֵּן תְּרַחֵם יְיָ עָלֵינוּ׃</tei:l> <tei:l>לַיְיָ הַיְשׁוּעָה עַל־עַמְּךָ בִרְכָתֶךָ סֶּלָה׃</tei:l> <tei:l>יְיָ צְבָאוֹת עִמָּנוּ מִשְׂגָּב לָנוּ אֱלֹהֵי יַעֲקֹב סֶלָה׃</tei:l> <tei:l>יְיָ צְבָאוֹת אַשְׁרֵי אָדָם בֹּטֵחַ בָּךְ׃</tei:l> <tei:l>יְיָ הוֹשִׁיעָה הַמֶּלֶךְ יַעֲנֵנוּ בְיוֹם־קָרְאֵנוּ׃</tei:l> </tei:lg>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_fifth_day/selah_na">
          <tei:pb n="141" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n283_medium.jpg"/>
          <tei:p>סְלַח־נָא לַעֲוֹן הָעָם הַזֶּה כְּגֹדֶל חַסְדֶּךָ וְכַאֲשֶׁר נָשָׂאתָה לָעָם הַזֶּה מִמִּצְרַיִם וְעַד־הֵנָּה · וְשָׁם נֶאֱמַר׃ וַיֹּאמֶר יְיָ סָלַחְתִּי כִּדְבָרֶךָ׃ </tei:p>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_fifth_day/hateh_elohai">
          <tei:pb n="141" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n283_medium.jpg"/>
          <tei:p>הַטֵּה אֱלֹהַי אָזְנְךָ וּשְׁמַע פְּקָחָה עֵינֶיךָ וּרְאֵה שֹׁמְמָתֵינוּ וְהָעִיר אֲשֶׁר־נִקְרָא שִׁמְךָ עָלֶיהָ׃ כִּי לֹא עַל־צִדְקֹתֵינוּ אֲנַחְנוּ מַפִּילִים תַּחֲנוּנֵינוּ לְפָנֶיךָ כִּי עַל־רַחֲמֶיךָ הָרַבִּים׃ אֲדֹנָי שְׁמָעָה אֲדֹנָי סְלָחָה אֲדֹנָי הַקְשִׁיבָה וַעֲשֵׂה אַל־תְּאַחַר לְמַעַנְךָ אֱלֹהַי כִּי־שִׁמְךָ נִקְרָא עַל־עִירְךָ וְעַל־עַמֶּךָ׃ </tei:p>
        </tei:div>
        <j:transclude target="urn:x-opensiddur:text:poem:atah_haroeh_beelbon_neelamim"/>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_fifth_day/pair_after_atah">
          <j:conditional xml:id="penitential_fifth_day_pair_after_atah_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_fifth_day/pair_after_atah/printed">
            <tei:pb n="143" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n287_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say <tei:foreign xml:lang="he">אֵל מֶלֶךְ</tei:foreign> and <tei:foreign xml:lang="he">וַיַּעֲבוֹר</tei:foreign> </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_fifth_day_pair_after_atah_printed"/>
          <j:conditional xml:id="penitential_fifth_day_pair_after_atah_expanded">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <j:transclude target="urn:x-opensiddur:text:prayer:el_melekh_yoshev"/>
          <j:transclude target="urn:x-opensiddur:text:prayer:vayaavor"/>
          <j:endConditional target="#penitential_fifth_day_pair_after_atah_expanded"/>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_fifth_day/eleikha_shivaati">
          <tei:pb n="143" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n287_medium.jpg"/>
          <tei:lg><tei:l>אֵלֶיךָ יְיָ שִׁוַּעְתִּי ·</tei:l> <tei:l>וּבַבֹּקֶר תְּפִלָּתִי תְקַדְּמֶךָ׃</tei:l> <tei:l>אֵלֶיךָ נָשָׂאנוּ אֶת־עֵינֵינוּ ·</tei:l> <tei:l>הַיֹּשְׁבִי בַּשָּׁמָיִם׃</tei:l> <tei:l>אֵלֶיךָ יְיָ נַפְשִׁי אֶשָּׂא׃</tei:l> <tei:l>חָנֵּנוּ יְיָ חָנֵּנוּ כִּי רַב שָׂבַעְנוּ בוּז׃</tei:l> </tei:lg>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_fifth_day/verses_after_eleikha">
          <j:conditional xml:id="penitential_fifth_day_verses_after_eleikha_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_fifth_day/verses_after_eleikha/printed">
            <tei:pb n="143" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n287_medium.jpg"/>
            <tei:note type="instruction" xml:lang="he">רחמיך רבים · אל תבא · כרחם אב · ליי הישועה · יי צבאות עמנו · יי צבאות אשרי · יי הושיעה · כי לא על · יי שמעה </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_fifth_day_verses_after_eleikha_printed"/>
          <j:conditional xml:id="penitential_fifth_day_verses_after_eleikha_expanded">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div>
            <tei:milestone unit="prayer" corresp="urn:x-opensiddur:text:siddur:selichot/penitential_fifth_day/verses_after_eleikha/expanded"/>
            <tei:p><j:transclude target="urn:x-opensiddur:text:prayer:selichot/rahamekha_rabbim" type="inline"/> <j:transclude target="urn:x-opensiddur:text:prayer:keraham_av" type="inline"/> <j:transclude target="urn:x-opensiddur:text:prayer:selichot/ki_lo_al_tsidqotenu" type="inline"/> </tei:p>
            <tei:milestone unit="prayer"/>
          </tei:div>
          <j:endConditional target="#penitential_fifth_day_verses_after_eleikha_expanded"/>
        </tei:div>
        <j:transclude target="urn:x-opensiddur:text:poem:oznekha_hatteh_vehaqshev_leheqer_ranen"/>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_fifth_day/pair_after_oznekha">
          <j:conditional xml:id="penitential_fifth_day_pair_after_oznekha_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_fifth_day/pair_after_oznekha/printed">
            <tei:pb n="144" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n289_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say <tei:foreign xml:lang="he">אֵל מֶלֶךְ</tei:foreign> and <tei:foreign xml:lang="he">וַיַּעֲבוֹר</tei:foreign> </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_fifth_day_pair_after_oznekha_printed"/>
          <j:conditional xml:id="penitential_fifth_day_pair_after_oznekha_expanded">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <j:transclude target="urn:x-opensiddur:text:prayer:el_melekh_yoshev"/>
          <j:transclude target="urn:x-opensiddur:text:prayer:vayaavor"/>
          <j:endConditional target="#penitential_fifth_day_pair_after_oznekha_expanded"/>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_fifth_day/shuv_meharon">
          <tei:pb n="144" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n289_medium.jpg"/>
          <tei:lg><tei:l>שׁוּב מֵחֲרוֹן אַפֶּךָ וְהִנָּחֵם עַל־הָרָעָה לְעַמֶּךָ׃</tei:l> <tei:l>שׁוּבֵנוּ אֱלֹהֵי יִשְׁעֵנוּ ·</tei:l> <tei:l>וְהָפֵר כַּעַסְךָ עִמָּנוּ׃</tei:l> <tei:l>שׁוּבָה יְיָ רִבְבוֹת אַלְפֵי יִשְׂרָאֵל׃</tei:l> <tei:l>קְחוּ עִמָּכֶם דְּבָרִים וְשׁוּבוּ אֶל־יְיָ אִמְרוּ אֵלָיו כָּל־תִּשָּׂא עָוֹן וְקַח טוֹב וּנְשַׁלְּמָה פָרִים שְׂפָתֵינוּ׃</tei:l> </tei:lg>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_fifth_day/verses_after_shuv">
          <j:conditional xml:id="penitential_fifth_day_verses_after_shuv_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_fifth_day/verses_after_shuv/printed">
            <tei:pb n="144" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n289_medium.jpg"/>
            <tei:note type="instruction" xml:lang="he">רחמיך רבים · אל תבא · כרחם אב · ליי הישועה · יי צבאות עמנו · יי צבאות אשרי · יי הושיעה · כי לא על · יי שמעה </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_fifth_day_verses_after_shuv_printed"/>
          <j:conditional xml:id="penitential_fifth_day_verses_after_shuv_expanded">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div>
