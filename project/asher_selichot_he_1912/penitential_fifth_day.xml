          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_fifth_day/closing_repetition/printed">
            <tei:pb n="152" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n305_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say <tei:foreign xml:lang="he">זְכֹר רַחֲמֶיךָ</tei:foreign> page 16, till <tei:foreign xml:lang="he">גְּמִירָא בִשְׁבַיָּא</tei:foreign> page 23, and continue with the following— </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_fifth_day_closing_repetition_printed"/>
