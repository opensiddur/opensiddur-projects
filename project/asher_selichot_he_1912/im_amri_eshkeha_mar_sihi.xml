      <tei:div corresp="urn:x-opensiddur:text:poem:im_amri_eshkeha_mar_sihi">
        <tei:pb n="39" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n79_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אִם אָמְרִי אֶשְׁכְּחָה מַר שִׂיחִי ·</tei:l> <tei:l>הוּגוֹת דְּאַבוֹת הוּגִיחַ נַפְשִׁי לְהָשִׁיחַ ·</tei:l> <tei:l>בְּלִי נוּחַ עֶצֶב לְמוֹתַר מַטְרִיחַ ·</tei:l> <tei:l>שַׁחוֹתִי עַד־מְאֹד וַתִּקְצַר רוּחִי׃</tei:l> <tei:l>נִגָּשׁוֹת צָרוֹת כְּרוֹג שְׁתַּיִם שְׁתַּיִם ·</tei:l> <tei:l>רֵוַח אֵין בֵּינֵיהֶם מְעַקּוֹת כִּנְחֻשְׁתַּיִם ·</tei:l> <tei:l>דוֹבְקוֹת וְדוֹלְקוֹת בְּלִי־עֲצַלְתַּיִם ·</tei:l> <tei:l>קַיִץ הֶמְצוּ סוּר שְׂחוֹק וּמְצִלְתַּיִם׃</tei:l> <tei:l>הִרְכַּבְתָּ אֱנוֹשׁ לְרֹאשׁ עַמְּךָ הוֹרֵשׁ עַל־גַּבָּם ·</tei:l> <tei:l>צֵאת לָרְוָיָה צוֹעֲקִים אֵלֶיךָ מִשְׂגַּבָּם ·</tei:l> <tei:l>וְהִרְבִּינוּ סְרַעַפֵּיהֶם כָּל־הַיּוֹם בְּקִרְבָּם ·</tei:l> <tei:l>פֹּארוֹתָיו תֶּאֱרַכְנָה וְיָשִׁיב וְיַהֲפוֹךְ בָּם׃</tei:l> <tei:l>זְעִי רַבּוּ זְעוּ מֵאֱנוֹשׁ מוֹשִׁיעִים ·</tei:l> <tei:l>עָתְקוּ גַם גָּבְרוּ חֵילִי־רְשָׁעִים ·</tei:l> <tei:l>חָדְלוּ פְרָזוֹן וְלֹא נְדִיבִים שְׁעוּיִם ·</tei:l> <tei:l>סֵפֶר תַּנְחוּמֶיךָ לְמָרֵי־נֶפֶשׁ שַׁעֲשׁוּעִים׃</tei:l> <tei:l>טוֹפְלִים שֶׁקֶר תַּרְמִית־לִבָּם לְהַסְבִּיר ·</tei:l> <tei:l>נוֹשְׂאִים הֶבֶל פֵּיהֶם־פִּימוֹ לְהַגְבִּיר ·</tei:l> <tei:l>יוֹצְרֵי עָמָל עִלְּתָן לְהַכְבִּיר ·</tei:l> <tei:l>מְצִיקִים צוֹרְרִים עַמְּךָ מִמְּךָ לְהַעֲבִיר׃</tei:l> <tei:l>כוֹנְנוּ לְהַשְׁחִית בָּנִים לְאָבִיהֶם ·</tei:l> <tei:l>לֹא־תַחֲשֶׁה לַעֲנוֹתָם וּלְכַלּוֹתָם בְּאֶרֶץ אוֹיְבֵיהֶם ·</tei:l> <tei:l>שָׁלָּמָה הֱיוֹת קוֹוֶיךָ מִטּוּרֵי נְוֵהֶם ·</tei:l> <tei:l>יֵעוֹרוּ גְּאוּלִים בָּאוֹת לְקִרְיַת־מוֹעֲדֵיהֶם׃</tei:l> <tei:l>אֲדָמַת קֹדֶשׁ מְקוֹם <tei:pb n="40" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n81_medium.jpg"/>דְּבִירְךָ נַהֲלֵנוּ ·</tei:l> <tei:l>בְּקוֹל־תּוֹדָה וְרִנָּה הָמוֹן חוֹגְגֵנוּ ·</tei:l> <tei:l>זִבְחֵי־צֶדֶק נַקְרִיב לְךָ מָגִנֵּנוּ ·</tei:l> <tei:l>אֲמָרֵינוּ הַאֲזִינָה יְיָ בִּינָה הֲגִיגֵנוּ׃</tei:l> </tei:lg>
      </tei:div>
