      <tei:div corresp="urn:x-opensiddur:text:poem:el_har_hamor_givat_horiyah">
        <tei:pb n="113" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n227_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אֶל הַר הַמֹּר גִּבְעַת הוֹרִיָּה ·</tei:l> <tei:l>בֵּית עֲקֵד הָרוֹעִים וְשַׁר הָעֲלִיָּה ·</tei:l> <tei:l>גָּדוֹל־בָּעֲנָקִים כְּהַשְׁכֵּם לָזֶבַח וְהִשְׁתַּחֲוִיָּה ·</tei:l> <tei:l>הַבַּקָּתוֹ הַבַּקְתּוֹ וְהוֹצִיאָוֹ לִרְוָיָה׃</tei:l> <tei:l>הֵן בַּעֲשִׂירִית כְּנִסִּיתוֹ כְּפִיּוּסִים ·</tei:l> <tei:l>וְזֵרַזְתּוֹ כְּגִבּוֹר מְלֻמָּד בְּמִלְחֶמֶת אוֹנְסִים ·</tei:l> <tei:l>זָרַח מִמִּזְרָח וְהוֹדִיעַ בְּכָל־אֲפָסִים ·</tei:l> <tei:l>חֲיִיתָ בְנוֹ לִיקוֹד בִּקְדוֹחַ אֵשׁ הֲדַסִּים׃</tei:l> <tei:l>טוּב בְּהַקְרִין וְהֵאִיר הַשַּׁחַר ·</tei:l> <tei:l>יִחֵד בִּשְׁנֵי נְעָרָיו בַּעֲצַלְתַּיִם לֹא אַחַר ·</tei:l> <tei:l>כְּהוֹלֵךְ־בֶּחָלִיל וְסוֹפוֹ לַחֲזוֹר <tei:pb n="114" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n229_medium.jpg"/>מָחָר ·</tei:l> <tei:l>לָקַח־בְּנוֹ־בִדְבָרִים וַעֲצֵי הַמַּעֲרָכָה בָחָר׃</tei:l> <tei:l>מַאֲכֶלֶת שְׁנוּנָה מוּטָה לְטֶבַח ·</tei:l> <tei:l>נָדָנָהּ נָתַן מֵלְהַבְעִיתוֹ בְּאַבְחָה ·</tei:l> <tei:l>סָב וּבָחוּר לִשְׁנֵיהֶם הַשֶּׁבַח ·</tei:l> <tei:l>עָרְכוּ עֵצִים לְשֵׁם הַזֶּבַח׃</tei:l> <tei:l>פְּרִי־צַדִּיק כְּהֶאֱזִין בְּמִלָּה ·</tei:l> <tei:l>צוּר יִרְאֶה־לּוֹ הַשֶּׂה וְאִם־לָאו בְּנִי לְעֹלָה ·</tei:l> <tei:l>קְרוֹץ עַצְמוֹ הֵכִין וְתָלָה עַיִן לְמַעְלָה ·</tei:l> <tei:l>רָחַשׁ לְעָקְדוֹ הֵיטֵב מִלְהִפָּסֵל בִּמְעִילָה׃</tei:l> <tei:l>שָׁאַג־זָקֵן וּבִשְׁנוּנָה אָחַז ·</tei:l> <tei:l>תָּקְפוּ אֶרְאֵלִּים וַיִּצְעֲקוּ מִמַּחַז ·</tei:l> <tei:l>מָרוֹם כְּסָפִית צִמְצֵם שְׁכִינָתוֹ כְּרָז ·</tei:l> <tei:l>אַיִל־הֶרְאָהוּ אַחַר נֶאֱחָז׃</tei:l> <tei:l>יְדִיד הַנֶּאֱהָב כְּשָׁלַף הַתַּעַר ·</tei:l> <tei:l>רִחוּף מְגִנּוֹ וְעָמַד בַּשָּׁעַר ·</tei:l> <tei:l>בִּנְךָ יְחִידְךָ אָהוּב מִנּוֹעַר ·</tei:l> <tei:l>רְבָלְךָ אַל־תִּשְׁלַח יָדְךָ אֶל־הַנָּעַר׃</tei:l> <tei:l>בִּי נִשְׁבַּעְתִּי בְקִיּוּם הֲוָה ·</tei:l> <tei:l>יַעַן אֲשֶׁר עָשִׂיתָ אֶת הַדָּבָר הַזֶּה ·</tei:l> <tei:l>צִקוּן חֲנִינֶיךָ בְּצַר לָמוֹ אֶחֱזֶה ·</tei:l> <tei:l>חֲקוֹתָם לְחַיִּים כִּי אֶסְלַח לַעֲוֹן הָעָם הַזֶּה׃</tei:l> <tei:l>אָנָּא הַשֵּׁם הַנִּכְבָּד וְהַנּוֹרָא ·</tei:l> <tei:l>לְעֵת־צָרָה פְקַדְנוּךָ וְשִׁחַרְנוּךָ בְּמוֹרָא ·</tei:l> <tei:l>זְנַחְתָּנוּ רִחַקְתָּנוּ קָרְבֵנוּ וְהָכֵן עֲתִירָה ·</tei:l> <tei:l>לֹא נָסוֹג מִמְּךָ תְּחַיֵּנוּ וּבְשִׁמְךָ נִקְרָא׃</tei:l> <tei:l>חַזְּקֵנוּ וְאַמְּצֵנוּ לְמַעַן כִּסֵּא כְבוֹדֶךָ ·</tei:l> <tei:l>קוֹמְמֵנוּ וְהַחֲיֵנוּ בְּטַל אוֹרוֹת הוֹדֶךָ ·</tei:l> <tei:l>וְכַלֵּה דֶבֶר וְחֶרֶב מִנַּחֲלַת שְׂרִידֶךָ ·</tei:l> <tei:l>וְתֹאמַר־לְמַלְאָךְ הֶרֶף יָדֶךָ׃</tei:l> <tei:l>קִדַּמְנוּ־פָנֶיךָ אַדִּיר וְנָאוֹר ·</tei:l> <tei:l>בִּתְפִלָּה וּבַקָּשָׁה וּבְהַכְנָעַת שְׂאוֹר ·</tei:l> <tei:l>הֲקִימֵנוּ בְּאוֹר־פָּנֶיךָ אֲמִתְּךָ לָאוֹר ·</tei:l> <tei:l>כִּי־עִמְּךָ מְקוֹר־חַיִּים בְּאוֹרְךָ נִרְאֶה־אוֹר׃</tei:l> </tei:lg>
      </tei:div>
