      <tei:div corresp="urn:x-opensiddur:text:poem:im_afes_rova_haqen">
        <tei:pb n="101" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n203_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אִם אָפֵס רוֹבַע הַקֵּן ·</tei:l> <tei:l>אֹהֶל שִׁכֵּן אִבְדַרְקֵן ·</tei:l> <tei:l>אַל־נָאבְדָה עַל־כֵּן ·</tei:l> <tei:l>יֶשׁ לָנוּ אָב זָקֵן׃</tei:l> <tei:l>פָּנִים לוֹ תַכִּיר ·</tei:l> <tei:l>וְצִדְקוֹ לְפָנֶיךָ נַזְכִּיר ·</tei:l> <tei:l>צִוִּיתוֹ קַח־נָא אֶת־בִּנְךָ יַקִּיר ·</tei:l> <tei:l>וְנִמְצָה דָמוֹ עַל־קִיר׃</tei:l> <tei:l>רָץ אֵלָיו הַנַּעַר וְהִקְדִּישׁוֹ ·</tei:l> <tei:l>וְנַפְשׁוֹ קְשׁוּרָה בְנַפְשׁוֹ ·</tei:l> <tei:l>עִטְּרוֹ בְּעֵצִים וְאִשׁוֹ ·</tei:l> <tei:l>וְנֵזֶר־אֱלֹהָיו עַל־רֹאשׁוֹ׃</tei:l> <tei:l>יָחִיד רַךְ הוּגַשׁ כִּצְבִי ·</tei:l> <tei:l>עָנָה וְאָמַר אָבִי הִנֵּה הָאֵשׁ וְהָעֵצִים נָבִיא ·</tei:l> <tei:l>וּתְשׁוּרָה אֵין לְהָבִיא׃</tei:l> <tei:l>מִלִּין הֱשִׁיבוֹ מִלְּהַבְהִילוֹ ·</tei:l> <tei:l>עָנָה אָבִיו וְאָמַר־לוֹ ·</tei:l> <tei:l>אֱלֹהִים יִרְאֶה לּוֹ ·</tei:l> <tei:l>וְיוֹדֵעַ יְיָ אֶת־אֲשֶׁר־לוֹ׃</tei:l> <tei:l>בְּמִצְוֹתֶיךָ שְׁנֵיהֶם נִזְהָרִים ·</tei:l> <tei:l>וְאַחֲרֶיךָ לֹא מְהַרְהֲרִים ·</tei:l> <tei:l>חָשׁוּ מְאֹד נִמְהָרִים ·</tei:l> <tei:l>עַל אַחַד הֶהָרִים׃</tei:l> <tei:l>רָאוּ אֵשׁ וּתְלוּלָה ·</tei:l> <tei:l>מִהֲרוּ עֲצֵי עוֹלָה ·</tei:l> <tei:l>יַחַד בְּאַהֲבָה כְלוּלָה ·</tei:l> <tei:l>יִשְּׁרוּ בַּעֲרָבָה מְסִלָּה׃</tei:l> <tei:l>רָאָה יָחִיד כִּי הוּא הַשֶּׂה ·</tei:l> <tei:l>נָאַם לְהוֹרוֹ הַמְנֻסֶּה ·</tei:l> <tei:l>אוֹתִי כְכֶבֶשׂ תַּעֲשֶׂה ·</tei:l> <tei:l>לֹא־תַחְמֹל וְלֹא־תְכַסֶּה׃</tei:l> <tei:l>בִּי חָפֵץ וְנִכְסוֹף ·</tei:l> <tei:l>לִלְבָבִי־לוֹ אֶחֱשֹׂף וְאִם תִּמְנָעֵנִי סוֹף ·</tei:l> <tei:l>רוּחִי וְנִשְׁמָתִי אֵלָיו יֶאֱסוֹף׃</tei:l> <tei:l>יָדָיו וְרַגְלָיו עָקַד ·</tei:l> <tei:l>וְחַרְבּוֹ עָלָיו פָּקַד ·</tei:l> <tei:l>לְשׂוּמוֹ עַל־עֵצִים שָׁקַד ·</tei:l> <tei:l>וְהָאֵשׁ עַל־הַמִּזְבֵּחַ תּוּקַד׃</tei:l> <tei:l>צַוָּאר פָּשַׁט מֵאֵלָיו ·</tei:l> <tei:l>וְאָבִיו נִגַּשׁ אֵלָיו ·</tei:l> <tei:l>לְשֵׁם בְּעָלָיו ·</tei:l> <tei:l>וְהִנֵּה יְיָ נִצָּב עָלָיו׃</tei:l> <tei:l>חָקַר אֶת־אֲשֶׁר־נַעֲשֶׂה ·</tei:l> <tei:l>וְאָב עַל־בְּנוֹ לֹא חָסָה ·</tei:l> <tei:l>לִבּוֹ אֶל־כַּפָּיו נָשָׂא ·</tei:l> <tei:l>וַיַּרְא אֱלֹהִים אֶת כָּל־אֲשֶׁר־עָשָׂה׃</tei:l> <tei:l>קָרָא לִמְרֶחֶם <tei:pb n="102" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n205_medium.jpg"/>מִשְׁחָר ·</tei:l> <tei:l>תְּמוּרַת־בִּנְךָ הַנִּבְחָר ·</tei:l> <tei:l>הִנֵּה אַיִל אַחֵר ·</tei:l> <tei:l>וְעִשֵּׂר אַל־תְּאַחֵר׃</tei:l> <tei:l>חֲלִיפֵי אַזְכָּרָתוֹ ·</tei:l> <tei:l>תִּכּוֹן הַקְטָרָתוֹ ·</tei:l> <tei:l>וְתַעֲלֶה תְמוּרָתוֹ ·</tei:l> <tei:l>וְהָיָה הוּא וּתְמוּרָתוֹ׃</tei:l> <tei:l>זִכָּרוֹן לְפָנֶיךָ בַּשַּׁחַק ·</tei:l> <tei:l>לָעַד בַּסֵּפֶר יֻחַק ·</tei:l> <tei:l>בְּרִית־עוֹלָם לֹא־נִמְחָק ·</tei:l> <tei:l>אֶת־אַבְרָהָם וְאֶת־יִצְחָק׃</tei:l> <tei:l>קוֹרְאֶיךָ בָאִים לָקֹד ·</tei:l> <tei:l>בְּצִדְקַת עֲקֵדָה תִּשְׁקוֹד ·</tei:l> <tei:l>צֹאנְךָ בְּרַחֲמִים תִּפְקוֹד ·</tei:l> <tei:l>פְּנֵי הַצֹּאן אַל־עֲקוֹד׃</tei:l> </tei:lg>
      </tei:div>
    </tei:body>
