      <tei:div corresp="urn:x-opensiddur:text:poem:ezrahi_meever_hannahar">
        <tei:pb n="138" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n277_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אֶזְרָחִי מֵעֵבֶר הַנָּהָר ·</tei:l> <tei:l>אֵלֶיךָ רָץ וְלֹא־אֵחַר׃</tei:l> <tei:l>בְּחַנְתּוֹ בְּנִסְיוֹנוֹת עֶשֶׂר ·</tei:l> <tei:l>וְנִמְצָא שָׁלֵם בְּלִי־חֹסֶר׃</tei:l> <tei:l>גֹּרַשׁ מֵאֶרֶץ מוֹלַדְתּוֹ ·</tei:l> <tei:l>גּוֹי בָעוֹלָם שַׂמְתּוֹ׃</tei:l> <tei:l>דְּבָרְךָ הֵקִים וְלֹא־הֵפֵר ·</tei:l> <tei:l>וְנָאַם אָנֹכִי עָפָר וָאֵפֶר׃</tei:l> <tei:l>הִקְרִיב חָלָב וְחֶמְאָה ·</tei:l> <tei:l>וְנֶחֱנַט פְּרִי לְמֵאָה׃</tei:l> <tei:l>וְנָאַמְתָּ־לוֹ הַעֲלֵהוּ לְעוֹלָה ·</tei:l> <tei:l>בָּקַע עֵצִים וְעָרַךְ וְהֶעֱלָה׃</tei:l> <tei:l>זְכָר־לָנוּ הַיּוֹם עֲקֵדָתוֹ וְהַשְׁלָמַת יְחִידָתוֹ׃</tei:l> <tei:l>חוֹן הַיּוֹם שְׁבָטֵי־תָם ·</tei:l> <tei:l>וְתִשְׁכּוֹן בְּמִקְהֲלוֹתָם׃</tei:l> <tei:l>טִירַת מַטּוֹת שְׁנֵים־עָשָׂר ·</tei:l> <tei:l>מִנּוּ מֵהֶם אַל־יֶחְסַר׃</tei:l> <tei:l>יְדִידוֹת מִשְׁכְּנוֹתֶיךָ תְּבִיאֵם ·</tei:l> <tei:l>בְּחַר נַחֲלָתְךָ הַפָּעַם׃</tei:l> <tei:l>כְּנֹס כָּל־פְּזוּרֵי נִדְחֵיהֶם ·</tei:l> <tei:l>נַהֲגֵם לְבֵית מַאֲוַיֵּיהֶם׃</tei:l> <tei:l>לְקוּחִים מִמָּוֶת תַּחֲשׂוֹךְ ·</tei:l> <tei:l>וּמַשְׂטִין פֶּה סְתוֹם וַחֲשֹׂךְ׃</tei:l> <tei:l>נְשָׂאֵנוּ וּנְטַלֵּנוּ כִּימֵי עוֹלָם ·</tei:l> <tei:l>וְכַפֶּר לָנוּ כָּל־זָדוֹן וְנַעֲלָם׃</tei:l> <tei:l>סְלַח וַעֲבוֹר עַל־פֶּשַׁע ·</tei:l> <tei:l>וּמְחוֹל <tei:pb n="139" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n279_medium.jpg"/>אַשְׁמָה וָרֶשַׁע׃</tei:l> <tei:l>עֲנֵה הַיּוֹם כָּל־מְיַחֲלֶיךָ ·</tei:l> <tei:l>כִּי עֵינֵינוּ נְשׂוּאוֹת אֵלֶיךָ׃</tei:l> <tei:l>פְּדֵנוּ מִצָּרָה וְצוּקָה וְהַעֲלֵנוּ מִשּׁוּחָה עֲמוּקָה׃</tei:l> <tei:l>צַעֲקָתֵינוּ הַיּוֹם תְּקַבֵּל ·</tei:l> <tei:l>וְתַצִּילֵנוּ מִידֵי מְחַבֵּל׃</tei:l> <tei:l>קוֹמֵם בֵּית שְׁכִינַת הוֹדֶךָ ·</tei:l> <tei:l>וְאַל־תְּנַבֵּל כִּסֵּא כְבוֹדֶךָ׃</tei:l> <tei:l>רְפָא עַמְּךָ מִכָּל־שֶׁבֶר ·</tei:l> <tei:l>כִּי־בָאוּ בָנִים עַד־מַשְׁבֵּר׃</tei:l> <tei:l>שֶׁבֶץ אֲחָזַתְנוּ כַיּוֹלֵדָה ·</tei:l> <tei:l>וְכֹחַ אַיִן לַלֵּידָה׃</tei:l> <tei:l>תִּגְאַל עַמְּךָ מֵהַבְהַב ·</tei:l> <tei:l>כִּי עָלֶיךָ מַשְׁלִיכִים יְהָב׃</tei:l> <tei:l>תַּנְחֵם לָעִיר הַפְּנוּיָה ·</tei:l> <tei:l>תְּמַהֵר תִּשְׁבִּי מְנַחֵם וּנְחֶמְיָה׃</tei:l> </tei:lg>
      </tei:div>
