      <tei:div corresp="urn:x-opensiddur:text:poem:ani_yom_ira_eilekha_eqra">
        <tei:pb n="42" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n85_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אֲנִי יוֹם אִירָא אֵלֶיךָ אֶקְרָא ·</tei:l> <tei:l>בַּל־יַעֲשְׁקוּנִי זֵדִים עוֹזְבֵי־יְקָרָה ·</tei:l> <tei:l>גְּמוּל לָהֶם לְהָשִׁיב שָׁב לַבַּקָּרָה ·</tei:l> <tei:l>דִּין רֶשַׁע וָעוֹל מְלוֹאָם יִקְרָא׃</tei:l> <tei:l>הַחוֹשְׁבִים לְהַשְׁכִּיחַ שֵׁם־קוֹדֶשׁ הַנִּכְבָּד ·</tei:l> <tei:l>וּלְהַרְגִּיל שֵׁם־טֻמְאָה נִקְלֶה וְנֶעֱבָד ·</tei:l> <tei:l>זֶה דַרְכָּם טוֹבֵי־עַם אַבֵּד ·</tei:l> <tei:l>חָשׂוֹךְ הַשְּׁאָר מִפֶּרֶשׁ בֵּית הַבָּד׃</tei:l> <tei:l>טָרוֹף טָרְפוּ אָדָם לָמְדוּ כַּמִּדְבָּר ·</tei:l> <tei:l>יָדוּ גוֹרָל עַל־הֶפְקֵר בַּמִּדְבָּר ·</tei:l> <tei:l>כִּמְעַט כָּלוּ וְלֹא יַעֲדְרוּ דָבָר ·</tei:l> <tei:l>לוּלֵי רַחֲמֶיךָ אֲדוֹן בְּהֶסְבֵּר דַּבָּר׃</tei:l> <tei:l>מִי־יִהְרְהֵר אַחַר מֵהֻתַּף לַדִּינָה ·</tei:l> <tei:l>נוֹכָח לְהָשִׁיב מַחֲלָצָיו לַדִּינָה ·</tei:l> <tei:l>מָרְנוּ וְסוֹעֲרְנוּ וְנִשְׁמַט חֶרֶב הַיּוֹנָה ·</tei:l> <tei:l>עִמְּךָ הַדִּין וְיָדְךָ עַל־הָעֶלְיוֹנָה׃</tei:l> <tei:l>פֶּן יֹאמַר יָכָלְתִּי בַּעַל־הַמּוֹט ·</tei:l> <tei:l>צָרֵי יְהוּדָה יָגִילוּ כִּי־אֶמּוֹט ·</tei:l> <tei:l>קְרָא לְמִמְכָּרֵי־חִנָּם שְׁנַת שְׁמוֹט ·</tei:l> <tei:l>רֶשַׁע הַמּוֹשֵׁט יָד יִסּוֹג אָחוֹר וְיִקָּמוֹט׃</tei:l> <tei:l>שְׁטָרְךָ קוֹדֵם וְלוֹ נוֹשִׁים מְבַקְשִׁים ·</tei:l> <tei:l>שֶׁעְבּוּדְךָ לְהַרְחִיק רְצוּ אֲדוֹנִים קָשִׁים ·</tei:l> <tei:l>תְּחוּמֵי סִימָנֵי מִצְוָה לַעֲקוֹר מְגַשְׁשִׁים ·</tei:l> <tei:l>תְּבוּאָה קְדֻשַּׁת בְּלוּעָה מְלִילוֹת וְקַשִׁים׃</tei:l> <tei:l>שְׁפוֹט רָעָה תָּבֹא עֲלֵיהֶם וְהַאֲשִׁימֵם ·</tei:l> <tei:l>לָמוֹ עוֹלָל וְהִתְעוֹלֵל בְּכָבוֹד יְשִׁימֵם ·</tei:l> <tei:l>מָנַת־כּוֹסָם פְּחֵי מַפַּח הַגְשִׁימֵם ·</tei:l> <tei:l>הָשֵׁב שִׁבְעָתַיִם נְקוֹם־בְּרִית וְהַשֵּׁמֵם׃</tei:l> <tei:l>הָעִיר קִרְיַת טִירַת־נוֹף נָהֲלֵנוּ ·</tei:l> <tei:l>יָם גְּאוּלִים דָּרֵךְ לַעֲבוֹר קְהִלֵּינוּ ·</tei:l> <tei:l>בְּךָ תוֹחַלְתֵּנוּ וְאַתָּה רַב הָאֵל מְחוֹלְלֵנוּ ·</tei:l> <tei:l>נַחֲמֶנָּא יְהִי חַסְדְּךָ עָלֵינוּ׃</tei:l> </tei:lg>
