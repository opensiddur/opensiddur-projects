      <tei:div corresp="urn:x-opensiddur:text:poem:elohim_ein_biltekha">
        <tei:pb n="96" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n193_medium.jpg"/>
        <tei:lg><tei:l>אֱלֹהִים אֵין־בִּלְתֶּךָ ·</tei:l> <tei:l>לְדוֹר וָדוֹר מֶמְשַׁלְתֶּךָ ·</tei:l> <tei:l>וְלָעַד קִיּוּם בְּרִיתֶךָ׃</tei:l> <tei:l>בִּימִינְךָ אֵין־מַעֲצָר ·</tei:l> <tei:l>יָדְךָ לֹא־תִקְצַר ·</tei:l> <tei:l>אֵל עוֹנֶה בְצָר׃</tei:l> <tei:l>גָּבְרוּ מְאֹד נִפְלְאוֹתֶיךָ ·</tei:l> <tei:l>וְלָעַד שִׁלְטוֹן <tei:pb n="97" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n195_medium.jpg"/>מַלְכוּתֶךָ ·</tei:l> <tei:l>וְלֹא יִתַּמּוּ שְׁנוֹתֶיךָ׃</tei:l> <tei:l>דּוֹרֵשׁ דָּמִים ·</tei:l> <tei:l>הִצַּלְתָּנוּ כַמֶּה פְעָמִים ·</tei:l> <tei:l>וְהִשְׁפַּלְתָּ מְלָכִים רָמִים׃</tei:l> <tei:l>הֵן לֹא־שָׁנִיתָ ·</tei:l> <tei:l>אַתָּה הוּא שֶׁהָיִיתָ ·</tei:l> <tei:l>בְּנֵי־יַעֲקֹב לֹא־כִלִּיתָ׃</tei:l> <tei:l>וּמִבְּנֵי־בְנֵיהֶם אֲנַחְנוּ ·</tei:l> <tei:l>לָמָה לָנֶצַח זָנַחְתָּנוּ ·</tei:l> <tei:l>וּכְמֵת מִלֵּב נִשְׁכַּחְנוּ׃</tei:l> <tei:l>זְרוּיִם בְּכָל־פִּנָּה ·</tei:l> <tei:l>עֲבוּדִים בְּכָל־מְדִינָה ·</tei:l> <tei:l>וְאֵין־לָנוּ חֲנִינָה׃</tei:l> <tei:l>חֲשׁוּכִים בֵּין כָּל־אֻמָּה ·</tei:l> <tei:l>נְתוּנִים לְבוֹשֶׁת וְלִכְלִמָּה לְכָל־גּוֹי אֲדָמָה ·</tei:l> <tei:l>טָבַעְנוּ בְצוּל מַעֲמַקִּים ·</tei:l> <tei:l>יָרַדְנוּ וְאֵין־מֵקִים ·</tei:l> <tei:l>לְךָ־לְבַד נוֹאֲקִים׃</tei:l> <tei:l>יוֹשְׁבִים כַּעֲדֵי־שְׁקָרִים ·</tei:l> <tei:l>בְּלִי רֹאשׁ לְהָרִים ·</tei:l> <tei:l>לַעֲנָה וָרוֹשׁ שִׁכּוֹרִים׃</tei:l> <tei:l>כָּשַׁלְנוּ בַצָּהֳרַיִם כַּבַּלַּיְלָה ·</tei:l> <tei:l>כַּעִוְרִים נְגַשֵּׁשׁ בָּאֲפֵלָה ·</tei:l> <tei:l>וְאֵין לֵידַע קֵץ־הַגְּאֻלָּה׃</tei:l> <tei:l>לְקוּחֵי־כֶסֶף לְחֵרוּת יוֹצְאִים ·</tei:l> <tei:l>וַאֲנַחְנוּ יוֹם וָלֵיל נִלְאִים ·</tei:l> <tei:l>וּמָנוֹחַ לֹא מוֹצְאִים׃</tei:l> <tei:l>מָה כֹחִי לִסְבּוֹל טִיט רְפָשַׁי ·</tei:l> <tei:l>וּמָה קִצִּי כִּי אַאֲרִיךְ נַפְשָׁי ·</tei:l> <tei:l>עַד־זְמַן תּוֹצִיאִי לְחָפְשִׁי׃</tei:l> <tei:l>נֹאמַר בֹּקֶר מִי יִתֵּן עֶרֶב ·</tei:l> <tei:l>וּבְעֶרֶב מִי יִתֵּן בֹּקֶר ·</tei:l> <tei:l>מִפַּחַד לֵב וָקֶרֶב׃</tei:l> <tei:l>שֶׂה־פְזוּרָה אָנוּ מְשֻׁלִּים ·</tei:l> <tei:l>כָּל־מוֹצְאֵינוּ אוֹתָנוּ אוֹכְלִים ·</tei:l> <tei:l>וְעַל־נַפְשׁוֹתֵינוּ לֹא חוֹמְלִים׃</tei:l> <tei:l>עֵינַי סָבִיב הֲרִימוֹתִי ·</tei:l> <tei:l>שְׂמֹאל וְיָמִין צָפִיתִי ·</tei:l> <tei:l>וּמַכִּיר־לִי לֹא רָאִיתִי׃</tei:l> <tei:l>פָּנִיתִי לְכָל־צַד וְאֵין־עֶזְרָה ·</tei:l> <tei:l>צָעַקְתִּי־לְךָ וָאֶקְרָא ·</tei:l> <tei:l>עוֹנֶה בְעֵת־צָרָה׃</tei:l> <tei:l>צוּר יָדְךָ לֹא־קְצוּרָה ·</tei:l> <tei:l>לְךָ הַכֹּחַ וְהַגְּבוּרָה ·</tei:l> <tei:l>לָמָה־תִישָׁן עוּרָה׃</tei:l> <tei:l>קְשֹׁב חֲנוֹן שִׂיחֵנוּ ·</tei:l> <tei:l>רְאֵה בִתְשׁוּת־כֹּחֵנוּ ·</tei:l> <tei:l>וְאַל בְּאַפְּךָ תוֹכִיחֵנוּ׃</tei:l> <tei:l>שׁוּר בְּשִׁפְלוּת דּוֹרֵנוּ ·</tei:l> <tei:l>הַבֵּיט בְּכֹבֶד <tei:pb n="98" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n197_medium.jpg"/>צַעֲרֵנוּ ·</tei:l> <tei:l>וְאַל־בַּחֲמָתְךָ תְיַסְּרֵנוּ׃</tei:l> <tei:l>זַעֲקָתֵנוּ שְׁעֵה מִמְּעוֹנֶךָ ·</tei:l> <tei:l>בִּיטָה בְּאַנְקַת בָּנֶיךָ ·</tei:l> <tei:l>וְאַל־תְּשִׁיבֵנוּ רֵיקָם מִלְּפָנֶיךָ׃</tei:l> <tei:l>דְּרַשְׁנוּךָ בְּחִנּוּן וְשַׁוְעָה ·</tei:l> <tei:l>יָהּ הֵרָצֵה־לָנוּ בְּזוּ הַשָּׁעָה ·</tei:l> <tei:l>וְתַחֲנוּנֵנוּ יְיָ שְׁמָעָה׃</tei:l> </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
