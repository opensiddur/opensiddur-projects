      <tei:div corresp="urn:x-opensiddur:text:poem:taharot_rogez_taniah_vetizkor_rahem">
        <tei:pb n="123" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n247_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>תַּחֲרוֹת רוֹגֶז הָנַח וְתִזְכּוֹר רַחֵם ·</tei:l> <tei:l>תְּמִימֶיךָ־חֲנוֹת וְאַל־תִּשְׁכַּח בְּיַד לוֹחֵם ·</tei:l> <tei:l>שְׁאֵרִיתָם חֲמוֹל פְּלֵיטָתָם תְּרַחֵם ·</tei:l> <tei:l>שְׁבִיתָם כַּאֲפִיקִים שׁוֹבֵב וְכַדֶּשֶׁא תַפְרִיחֵם׃</tei:l> <tei:l>רָפוּ יְדֵי־עַם עֲנִיֵּי הַצֹּאן ·</tei:l> <tei:l>רָדוּ בָהֶם שׂוֹנְאֵיהֶם בְּעֹנִי וּבַלַּחֲצוֹן ·</tei:l> <tei:l>קוּם כִּי־עָלֶיךָ לִגְדוֹר פִּרְצוֹן ·</tei:l> <tei:l>קוּחָם פְּקַח וּקְרָא שְׁנַת־רָצוֹן׃</tei:l> <tei:l>צְבִי יִשְׂרָאֵל קֹדֶשׁ חֻלַּל עַל־בָּמוֹת ·</tei:l> <tei:l>צָרָיו עָלָיו יִשָּׁאוּן יַמִּים כַּהֲמוֹת ·</tei:l> <tei:l>כְּלָא אֵיד־שְׁאוֹל וּזְכֹר עוֹלָם יְמוֹת ·</tei:l> <tei:l>פְּקֻדַּת־מִשְׁנֶה כְּהוֹפָעַת אֵל־נְקָמוֹת׃</tei:l> <tei:l>עוּרִי לִבְשִׁי־עֹז וּזְרוֹעַ מְחוֹלֶלֶת קָמִים ·</tei:l> <tei:l>עוּרִי כִּימֵי־קֶדֶם דּוֹרוֹת עוֹלָמִים ·</tei:l> <tei:l>סַפַּח כּוֹס־חֲמָתְךָ וְאַף שְׁבַר לְאֻמִּים ·</tei:l> <tei:l>סַךְ־רַעַל פְּקוֹד בְּעוֹד נִשְׁלָם נִחוּמִים׃</tei:l> <tei:l>נֵצַח־יִשְׂרָאֵל קֹוֶיךָ חוּשָׁה לְעֶזְרָתָם ·</tei:l> <tei:l>נִגָּשִׂים וְנַעֲנִים וּבְךָ תִקְוָתָם ·</tei:l> <tei:l>מְיַחֲדִים שְׁמֶךָ וְזִכְרְךָ תַאֲוָתָם ·</tei:l> <tei:l>מְשׁוֹל בָּם אַתָּה וְעָצוּר בְּמַקְהֲלוֹתָם׃</tei:l> <tei:l>לְךָ־יְיַחֵילוּ הֵן אִם־תִּקְטְלֵם ·</tei:l> <tei:l>לְרַוְחָתָם וּלְשַׁוְעָתָם אֹזֶן בַּל־תַּעְלֵם ·</tei:l> <tei:l>כָּשַׁל כֹּחָם מֵרֹב הַאֵילָם ·</tei:l> <tei:l>כָּלוּ עֵינֵיהֶם מִתְּהוֹמוֹת מָתַי תַּעֲלֵם׃</tei:l> <tei:l>יֶלֶד שַׁעֲשׁוּעַ בְּיַד צָרָיו לָמַד לְאָבְלָה ·</tei:l> <tei:l>יָחַרְקוּ־שֵׁן גּוּרֵיהוּ כְּצֹאן מִמִּכְלָה ·</tei:l> <tei:l>טָבְעוּ כֹה מִנְּכָסָם וּלְעֶזְרָה נָפָוּ לְבֵית הַתְּפִלָּה ·</tei:l> <tei:l>טוּבְךָ וְרַחֲמֶיךָ מֵהֶם לֹא תִכְלָא׃</tei:l> <tei:l>חִנָּם פְּעוֹל חֶסֶד גְּמוֹל טוֹבָה לְחַיָּבִים ·</tei:l> <tei:l>חֲלוּף בִּקְדוֹשׁ צוֹם וּבַעֲצָרָה נִצָּבִים ·</tei:l> <tei:l>זְרֹם כְּלִים זֵדִים טוֹרְפִים כִּזְאֵבִים ·</tei:l> <tei:l>זוֹ לַעַגָּם וְרָב כּוֹסָם בְּאַדְמַת שׁוֹבָבִים׃</tei:l> <tei:l>וּנְקָמָה יִוָּדַע אֵפוֹא כִּי־אַתָּה גּוֹאֲלָם ·</tei:l> <tei:l>וְצַר הַצּוֹרֵר הַקָּשֶׁה וְהַכְבִּיד עֻלָּם ·</tei:l> <tei:pb n="124" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n249_medium.jpg"/><tei:l>הַקְדִּישֵׁם לְיוֹם הֲרֵגָה וּלְטְבִיחָה הֲתִיקָם כֻּלָּם ·</tei:l> <tei:l>הוֹרֵג שִׁבְעָתָיִם יֻקָּם וְשִׁבְעִים וְשִׁבְעָה יְשַׁלֵּם׃</tei:l> <tei:l>דַּלֵּה וְהַצֵּל לְקוּחֵי־מָוֶת וּלְהֹרֵג מָטִים ·</tei:l> <tei:l>דְּחוּפִים לְלַעַג בְּיַד שׁוֹאֲלֵי בְּחָרְףּ וְדוֹרְשֵׁי אִטִּים ·</tei:l> <tei:l>גְּבוּרָתָם בַּצוֹם נָשַׁחָה וְדָמָם לְפָנֶיךָ מְמַעֲטִים ·</tei:l> <tei:l>גָּלוּ רִיבָם אֵלֶיךָ גָּאֳלֵם מֵחֶרֶב לְהָטִים׃</tei:l> <tei:l>בִּלְתְּךָ לָמוֹ אֵין זוּלָתְךָ לֹא בָחָרוּ ·</tei:l> <tei:l>בְּעָשָׁן כָּלוּ עֵינֵיהֶם וְעַצְמוֹתָם כְּמוֹקֵד נִחָרוּ ·</tei:l> <tei:l>אוֹר חָשַׁךְ בַּעֲדָם כֹּחַ נֶעֱזַב וּתְלָאוֹת סְחַרְחָרוּ ·</tei:l> <tei:l>אוֹתְךָ פְּקָדוּךָ בַּצַּר וּבְעֵת־צַר לְךָ יִשְׁחָרוּ׃</tei:l> <tei:l>אָנָּא לְעֶזְרַת יְדִידֶיךָ הוֹעִידָה חוּשָׁה מַהֵרָה ·</tei:l> <tei:l>הַקָּטֹן לְאֶלֶף וְהַצָּעִיר לְהַעֲצִים וּלְהַגְבִּירָה ·</tei:l> <tei:l>יוֹדוּךָ חוֹכֵי־יִשְׁעֶךָ וִיהַלְלוּךָ עַם־נִבְרָא ·</tei:l> <tei:l>מִקְוֵה יִשְׂרָאֵל מוֹשִׁיעוֹ בְּעֵת־צָרָה׃</tei:l> </tei:lg>
      </tei:div>
