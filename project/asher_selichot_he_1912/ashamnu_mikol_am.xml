    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ashamnu_mikol_am">
        <tei:pb n="18" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n37_medium.jpg"/>
        <tei:lg><tei:l>אָשַׁמְנוּ מִכָּל־עָם ·</tei:l> <tei:l>בּוֹשְׁנוּ מִכָּל־דּוֹר ·</tei:l> <tei:l>גָּלָה מִמֶּנּוּ <tei:pb n="19" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n39_medium.jpg"/>מָשׂוֹשׂ ·</tei:l> <tei:l>דָּוֶה לִבֵּנוּ בַּחֲטָאֵינוּ ·</tei:l> <tei:l>הֻחְבַּל אֲוִיֵּנוּ ·</tei:l> <tei:l>וְנִפְרַע פֵּאֲרֵנוּ ·</tei:l> <tei:l>זְבֻל בֵּית־מִקְדָּשֵׁנוּ ·</tei:l> <tei:l>חָרֵב בַּעֲוֹנֵינוּ ·</tei:l> <tei:l>טִירָתֵנוּ הָיְתָה לְשַׁמָּה ·</tei:l> <tei:l>יֹפִי אַדְמָתֵנוּ לְזָרִים כֹּחֵנוּ לְנָכְרִים ·</tei:l> <tei:l>וַעֲדַיִן לֹא שַׁבְנוּ מִתּוֹעִיָּתֵנוּ ·</tei:l> <tei:l>וְאֵיךְ נָעִיז פָּנֵינוּ וְנַקְשֶׁה עָרְפֵנוּ ·</tei:l> <tei:l>לוֹמַר לְפָנֶיךָ יְיָ אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ צַדִּיקִים אֲנַחְנוּ וְלֹא חָטָאנוּ ·</tei:l> <tei:l>אֲבָל אֲנַחְנוּ וַאֲבוֹתֵינוּ חָטָאנוּ׃</tei:l> </tei:lg>
      </tei:div>
