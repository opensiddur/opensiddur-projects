      <tei:div corresp="urn:x-opensiddur:text:poem:yisrael_ammekha_tehinnah_orkhim">
        <tei:pb n="160" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n321_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו יִשְׂרָאֵל עַמְּךָ תְּחִנָּה עוֹרְכִים ·</tei:l> <tei:l>שֶׁהֵם מְצֵרִים וּלְהִוָּשַׁע צְרִיכִים ·</tei:l> <tei:l>צָרֵיהֶם עֻלָּם עֲלֵיהֶם מַאֲרִיכִים ·</tei:l> <tei:l>בְּכָל־זֹאת הַבָּאִים וְשִׁמְךָ מְבָרְכִים׃</tei:l> <tei:l>חוֹלִי וּמַכְאוֹב לְהִכָּתֵב לֹא־נִמְכָּר ·</tei:l> <tei:l>עֲלוּבִים מִנֹּעַר וּמֵהֶם לֹא־הוּסַר ·</tei:l> <tei:l>קָדוֹשׁ בְּיָדְךָ לְפַתֵּחַ מוֹסֵר ·</tei:l> <tei:l>כֶּאֱמוּנָתְךָ הֲנָגָה וְלֹא כֶאֱמֻנַת בָּשָׂר׃</tei:l> <tei:l>הַלּוֹבֵשׁ צְדָקָה וְלוֹ כִמְעִיל עֲטוּיָה ·</tei:l> <tei:l>וּמִמַּכָּה עַצְמָהּ מְתַקֵּן רְטִיָּה ·</tei:l> <tei:pb n="161" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n323_medium.jpg"/><tei:l>קוֹמֵם עֲדָתְךָ מִנְּפִילָתָהּ הַנְּטוּיָה ·</tei:l> <tei:l>בְּכֹחֲךָ הַגָּדוֹל וּבִזְרֹעֲךָ הַנְּטוּיָה׃</tei:l> <tei:l>שָׁעוּ הַחוֹשְׁבִים נַחֲלָתְךָ לְחַבֵּל ·</tei:l> <tei:l>כְּבוֹדְךָ לְהָמִיר וְאַחַר הֲבָלִים לְהִתְבַּלְבֵּל ·</tei:l> <tei:l>נֵצֶר מְשֻׁרָשִׁים לֵאלֹהַּ לְקַבֵּל ·</tei:l> <tei:l>יִרְאָתְךָ הַקְּדוֹשָׁה לִנְטוֹשׁ וּלְחַבֵּל׃</tei:l> <tei:l>בְּאַהֲבָתְךָ וּבְחֶמְלָתְךָ מְנַשֵּׂא וּמְנַטֵּל ·</tei:l> <tei:l>עֲצָתָם תְּסַכֵּל וּמַחְשְׁבוֹתָם תְּבַטֵּל ·</tei:l> <tei:l>רַבָּה מְהוּמָה בֵּינֵיהֶם הָטֵל ·</tei:l> <tei:l>וּמַלְאָךְ־אַכְזָרִי דּוֹחֶה וּמְטַלְטֵל׃</tei:l> <tei:l>בִּשְׁבִיל כְּבוֹד עַצְמְךָ וְשֵׁם קָדְשְׁךָ הַמְהֻלָּל ·</tei:l> <tei:l>נוֹרָאוֹת הַפְלֵא לְבַל בַּגּוֹיִם יִתְחַלֵּל ·</tei:l> <tei:l>יוֹעֲצֵיהֶם וְאֵיתָנֵיהֶם תּוֹלִיךְ שׁוֹלָל ·</tei:l> <tei:l>וְכָהֶם תְּעוֹלֵל כַּאֲשֶׁר בִּי הִתְעוֹלֵל׃</tei:l> <tei:l>מֵקִים מֵעָפָר דָּל וְאֶבְיוֹן מֵאַשְׁפָּה ·</tei:l> <tei:l>כְּנָסְתְּךָ בַּל־תִּתֵּן לְכַלָּה וּלְחֶרְפָּה ·</tei:l> <tei:l>אִם בְּפִקּוּדֶיךָ מִתְעַצֶּלֶת וּמִתְרַפָּה ·</tei:l> <tei:l>עַל־כָּל־פְּשָׁעֶיהָ חִבָּתְךָ תְּהֵא מְחַפָּה׃</tei:l> <tei:l>יְתֵרָה חִבָּתָם לְפָנֶיךָ אֲדוֹנֵי הָאֲדוֹנִים ·</tei:l> <tei:l>בְּכָךְ וּבְכָךְ קְרוּאִים לְךָ בָּנִים ·</tei:l> <tei:l>רַחֲמֶיךָ יְקַדְּמוּנוּ אֱלוֹהַּ עֶלְיוֹנִים וְתַחְתּוֹנִים ·</tei:l> <tei:l>טֶרֶם יִשְׁטְפוּנוּ הַמַּיִם הַזֵּידוֹנִים׃</tei:l> <tei:l>חֲפֵצֵי קִרְבָתְךָ עַל־כָּל־הַבָּאוֹת ·</tei:l> <tei:l>הָחִישָׁה לָמוֹ יְשׁוּעוֹת הַנְּבָאוֹת ·</tei:l> <tei:l>קָדוֹשׁ עֲשֵׂה עִמָּנוּ לְטוֹבָה אוֹת ·</tei:l> <tei:l>חָזָק וְאַמִּיץ גּוֹאֲלָם יְיָ צְבָאוֹת׃</tei:l> </tei:lg>
      </tei:div>
    </tei:body>
