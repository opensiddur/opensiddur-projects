      <tei:div corresp="urn:x-opensiddur:text:poem:ashem_baalei_ashmah_haqarta_miqedem">
        <tei:pb n="106" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n213_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אָשָׁם בַּעֲלֵי אַשְׁמָה חָקַרְתָּ מִקֶּדֶם ·</tei:l> <tei:l>בְּטֶרֶם יִגָּלֵם וַיִּצּוּר פַּרְצוּף־אָדָם ·</tei:l> <tei:l>גֵּעוּל יֵצֶר אָחוֹר וָקֶדֶם ·</tei:l> <tei:l>דֶּרֶךְ צְרִי הוֹרֵיתוֹ בְּמַדְרֵךְ וַיִּקֶדֶם׃</tei:l> <tei:l>הוּבְחַן יֶרַח־שְׁבִיעִי מֵחֳדָשִׁים לְהִתְפַּרֵעַ ·</tei:l> <tei:l>וְרֹאשׁ לְשָׁנִים וְשָׁמִטִּים וְיוֹבֵל וְיָרָק וּנְטִיעָה ·</tei:l> <tei:l>וּמָנִיתָ בְמִנְיָן עֲשֶׂרֶת יְמֵי פְגִיעָה ·</tei:l> <tei:l>יַחֲזוֹר בָּהֶם וְשָׁב רַחוּמִים לְתָבְעָה׃</tei:l> <tei:l>טָהֵר וְשָׁב בֵּינְתַיִם יִמְצְאוּ מְחִילָה ·</tei:l> <tei:l>יָהִיר אִם־יִתְיַהֵר מְשׁוּב מִתְּהוֹלֵלָה ·</tei:l> <tei:l>כְּנֹס כָּל־אֵילֵי־נְבָיוֹת <tei:pb n="107" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n215_medium.jpg"/>וְהַעֲלֵם בְּאַחַת עֹלָה ·</tei:l> <tei:l>לֹא הִשְׁווּ־לוֹ לְהִתְרַצּוֹת פְּנֵי קוֹנוֹ לְהִתְפַּלֵּלָה׃</tei:l> <tei:l>מִשְׁפַּט הָרַבִּים הֻשָׁם כָּל־הַשָּׁנָה כֻּלָּה לָשׁוּב ·</tei:l> <tei:l>נַעֲנִים וּנְרָצִים בְּנֶפֶשׁ וּמְאֹד וּבְשׁוּב ·</tei:l> <tei:l>סֵפֶר אִם־נִקְצַב וְנֶחְתַּם בְּחוֹשֵׁב ·</tei:l> <tei:l>עֶלְיוֹן קוֹרְעוֹ וְחָס עַל־הַיְּשׁוּב׃</tei:l> <tei:l>פִּלֵּס כֹּחַ הַתְּשׁוּבָה כְּנֶגֶד כָּל־הַכֹּחוֹת ·</tei:l> <tei:l>צִיר־עָבוֹת מַגַּעַת לְכֵס אֱלֹהֵי הָרוּחוֹת ·</tei:l> <tei:l>קוֹמְמַת דּוּכִיָּה מֵעוֹמֶק שׁוּחוֹת ·</tei:l> <tei:l>רֶגֶשׁ בְּלִי לָגַעַת מְגִנַּת לִדְחוֹת׃</tei:l> <tei:l>שָׁב וְהוֹדָה וְעָזַב בֵּינוֹ לְבֵין קוֹנוֹ ·</tei:l> <tei:l>שָׁת תַּעַל לִמְזוֹרוֹ וְאֹרֶךְ לְחָלְיוֹנוֹ ·</tei:l> <tei:l>תְּשׁוּבָה גְּדוֹלָה הֲשִׁיבָה וְנָקִי יֵצֵא בְדִינוֹ ·</tei:l> <tei:l>תְּקוֹף הִתְנַחֵם וְשָׁכַךְ עֲשַׁן חֲרוֹנוֹ׃</tei:l> </tei:lg>
