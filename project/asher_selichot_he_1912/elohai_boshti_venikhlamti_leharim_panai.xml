      <tei:div corresp="urn:x-opensiddur:text:poem:elohai_boshti_venikhlamti_leharim_panai">
        <tei:pb n="105" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n211_medium.jpg"/>
        <tei:lg><tei:l>אֱלֹהַי בֹּשְׁתִּי וְנִכְלַמְתִּי לְהָרִים פָּנַי ·</tei:l> <tei:l>בַּעֲבוּר כִּי־חָשַׂבְתָּ לְמַטָּה מֵעֲוֹנַי ·</tei:l> <tei:l>גָּמַר חָסִיד וְגַם פַּסּוּ אֱמוּנַי ·</tei:l> <tei:l>דְּרָכֶיךָ מִשְׁפָּט וֶאֱמוּנָה וַאֲנִי בוֹשׁ מֵעֲוֹנַי׃</tei:l> <tei:l>הֵפַרְנוּ בְרִיתְךָ וּמִצְוֹתֶיךָ לֹא שָׁמַרְנוּ ·</tei:l> <tei:l>וִיקַר כְּבוֹדֵנוּ בְּלֹא יוֹעִיל הֵמַרְנוּ׃</tei:l> <tei:l>זִלְזַל יְקָרֵנוּ וְטוֹב לְרַע אָמַרְנוּ ·</tei:l> <tei:l>חֶפְצֵי־רְצוֹנְךָ בִטַּלְנוּ וּרְצוֹנֵנוּ גָּמַרְנוּ׃</tei:l> <tei:l>טוֹב־מוֹעַשׂ חָסַרְנוּ וְדַלּוֹנוּ כִשְׁרוֹן ·</tei:l> <tei:l>יֹשֶׁר־נְתִיב עִקַּלְנוּ וּמֵאַסְנוּ כִּשְׁרוֹן ·</tei:l> <tei:l>כָּל־אִשִּׁים בָּטְלוּ וְנִיחוֹחֵי יְשֻׁרוּן ·</tei:l> <tei:l>לִסְלוֹחַ וּלְכַפֵּר לַחֲבַצֶּלֶת־הַשָּׁרוֹן׃</tei:l> <tei:l>מֵרָחוֹק נָשְׂאָה דֵעָה אֲיֻמָּה נִכְסָפָה ·</tei:l> <tei:l>נָאוֹר בַּמֶּה לְקַדֵּם מַחֲשֶׁבֶת יְסַפֶּה ·</tei:l> <tei:l>שִׂיחַ אֵין בַּפֶּיהָ וּנְשַׁלְּמָה פָרִים שָׂפָה ·</tei:l> <tei:l>עֲצָרָה לָכֵן קְרָאָה וְעָם אָסָפָה׃</tei:l> <tei:l>פָּנֶיךָ אַל־תַּסְתִּיר אֵלֶיךָ בְּשַׁוְּעֵנוּ ·</tei:l> <tei:l>צַדֵּק דִּינֵנוּ וּבְמִשְׁפָּט אַל־תַּרְשִׁיעֵנוּ ·</tei:l> <tei:l>קְרָאוּנְךָ בֶאֱמֶת מַהֲרָה חוּשָׁה לְהוֹשִׁיעֵנוּ ·</tei:l> <tei:l>רוֹגֶז הָנַח וּנְקְרָאֲךָ וַעֲנֵנוּ יִשְׁעֵנוּ׃</tei:l> <tei:l>שְׁבוּטֶיךָ לְבוּטֶיךָ לָמוֹ לְמָסוֹרֶת עֲצוּרָה ·</tei:l> <tei:l>תָּמִיד הֵין וּתְפִלָּה <tei:pb n="106" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n213_medium.jpg"/>לְהַקְדִּים לְצָרָה ·</tei:l> <tei:l>אֳוִי צָרְכָּמוֹ מְרֻבִּים וְדַעְתָּם קְצָרָה ·</tei:l> <tei:l>לְהָפֵק זְמָמָם יָדְךָ לֹא־קְצוּרָה׃</tei:l> <tei:l>יִשְׂרָאֵל זָנַח טוֹב וּמֵאוֹיֵב מְרֻדָּף ·</tei:l> <tei:l>הוּדַשׁ כְּמַתְבֵּן וּכְמֹץ־הָרִים רֻדָּף ·</tei:l> <tei:l>כְּבָחֳרוֹ בַּטוֹב וּצְדָקָה וָחֶסֶד רָדַף ·</tei:l> <tei:l>רָם הַצֵּל עָשׁוּק וּבַקֵּשׁ נִרְדָּף׃</tei:l> <tei:l>שׁוֹפְטֵנוּ מְחוֹקְקֵנוּ אוֹבְדוֹת צֹאן תִּדְרוֹשׁ ·</tei:l> <tei:l>מוֹנֵיהֶם הִדְמִימוּם וַיַּשְׁקוּם מֵי־רֹאשׁ ·</tei:l> <tei:l>עַל־גַּבָּם הֶאֱרִיכוּ מַעֲנִית כְּפָרָה לַחֲרוֹשׁ ·</tei:l> <tei:l>יְדִידֶיךָ הוּפְשָׁחוּ וְצוֹרֵר רַעֲנָן כִּבְרוֹשׁ׃</tei:l> <tei:l>חָפַצְנוּ בְּכָל־לֵב אֵלֶיךָ לָשׁוּבוֹ ·</tei:l> <tei:l>זְרוּיֶיךָ קַבֵּץ שִׁבְיוֹנִים הָשִׁיבָה ·</tei:l> <tei:l>קַלַּע וְהַעֲבֵר זָדוֹן וּרְפָא מְשׁוּבָה ·</tei:l> <tei:l>הֲשִׁיבֵנוּ יְיָ אֵלֶיךָ וְנָשׁוּבָה׃</tei:l> </tei:lg>
      </tei:div>
    </tei:body>
