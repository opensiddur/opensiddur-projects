    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yehabbienu_tsel_yado"><tei:pb n="40" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n81_medium.jpg"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yehabbienu_tsel_yado/yehabbienu"/><tei:lg><tei:l>יֶחֱבִיאֵנוּ צֵל יָדוֹ ·</tei:l> <tei:l>תַּחַת כַּנְפֵי־הַשְּׁכִינָה ·</tei:l> <tei:l>חוֹן יָחוֹן כִּי יִבְחוֹן לֵב עָקוֹב לַהֲכִינוֹ ·</tei:l> <tei:l>קוּמָה־נָּא אֱלֹהֵינוּ עוּזָה ·</tei:l> <tei:l>עוּזִי נָא ·</tei:l> <tei:l><tei:seg type="refrain">יְיָ לְשַׁוְעָתֵנוּ הַאֲזִינָה׃</tei:seg></tei:l></tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yehabbienu_tsel_yado/anah_eilekh"/><tei:lg><tei:l>אָנָה אֵלֵךְ מֵרוּחֶךָ וְאָנָה מִפָּנֶיךָ אֶבְרָחָה ·</tei:l> <tei:l>פָּנוֹתִי אֵין־מָנוֹס פְּאַת־מַעֲרָב וּמִזְרָח ·</tei:l> <tei:l>גִּלְגַּלְתִּי אַחֲרָיךָ לְשַׁחֲרֶךָ ·</tei:l> <tei:l>יַחַד כְּנָר בָּאוּרְחָה ·</tei:l> <tei:l>בְּהִשָּׁפְטֵי לְצִדְקָתִי ·</tei:l> <tei:l>הַשְּׂמָאלִית וְהַיְּמִינָה ·</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>יְיָ לְשַׁוְעָתֵנוּ</tei:abbr><tei:expan>יְיָ לְשַׁוְעָתֵנוּ הַאֲזִינָה׃</tei:expan></tei:choice></tei:seg></tei:l></tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yehabbienu_tsel_yado/shamayim"/><tei:lg><tei:l>דוֹק שָׁמֶיךָ בִּרְנָתַיִם ·</tei:l> <tei:l>גַם שָׁם אַתָּה־אָפֵן הוֹדְךָ שָׁם לְשָׁפְטֵנִי עַל־כָּל־הַנַּעֲשֶׂה ·</tei:l> <tei:l>וַהֲגִיגִי בְרוֹב שְׁגָנִי כְּבִעוּר־אֵשׁ נָפֶן ·</tei:l> <tei:l>נָצְרָה כָּל־שְׂפָתֵינוּ תֶּת־לָנוּ חֲנִינָה ·</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>יְיָ לְשַׁוְעָתֵנוּ</tei:abbr><tei:expan>יְיָ לְשַׁוְעָתֵנוּ הַאֲזִינָה׃</tei:expan></tei:choice></tei:seg></tei:l></tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yehabbienu_tsel_yado/sheol"/><tei:lg><tei:l>וְאִי־שְׁאוֹל בְּמַחְתַּרְתּוֹ ·</tei:l> <tei:l>אָף כִּי־אַצִּיעַ חָזִיתִי וְהִנְּךָ שָׁם לְהַפְרָה וּלְהַכְנִיעַ ·</tei:l> <tei:l>טִפֵּשׁ לִבִּי וְהַחֲרֵד כִּי בֵין מָוֶת כְּפֶשַׂע שָׁמוֹר ·</tei:l> <tei:l>שְׁאֵרִית נִדְחֵי בְּכָל־פִּנָּה וּפִנָּה ·</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>יְיָ לְשַׁוְעָתֵנוּ</tei:abbr><tei:expan>יְיָ לְשַׁוְעָתֵנוּ הַאֲזִינָה׃</tei:expan></tei:choice></tei:seg></tei:l></tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yehabbienu_tsel_yado/yam_gadol"/><tei:lg><tei:l>יָם־גָּדוֹל בְּאַחֲרִיתוֹ ·</tei:l> <tei:l>אָף כִּי אֶשְׁכּוֹנָה ·</tei:l> <tei:l>בְּךָ־יְמִינְךָ תֹּאחֲזֵנִי וּמַה־לְנַפְשִׁי אֶשְׁכְּנָה ·</tei:l> <tei:l>לוּלֵי רוֹב רַחֲמֶיךָ דַּרְכִּי לֹא־אֶפְנוֹנָה ·</tei:l> <tei:l>מְשׁוֹךְ חַסְדְּךָ לְנִנְגָּשִׁים תַּחַת יָד עַנְיָנָה ·</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>יְיָ לְשַׁוְעָתֵנוּ</tei:abbr><tei:expan>יְיָ לְשַׁוְעָתֵנוּ הַאֲזִינָה׃</tei:expan></tei:choice></tei:seg></tei:l></tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yehabbienu_tsel_yado/mirdat_laylah"/><tei:lg><tei:l>מֵרְדַּת־לַיְלָה תְּסוֹבְבֵנִי ·</tei:l> <tei:l>אָז יְשׁוּפֵנִי חֹשֶׁךְ ·</tei:l> <tei:l>נְגוֹהוֹת לְךָ הָאֲפֵלוֹת כָּאוֹר יָהֵל וּמוֹשֵׁךְ ·</tei:l> <tei:l>סָמַר בְּשָׂרִי מִפַּחְדֶּךָ ·</tei:l> <tei:l>כְּשׁוּף נָחָשׁ נוֹשֵׁךְ ·</tei:l> <tei:l>וַעֲלֵי־דָמִים כְּמוֹ נִרְדָּם בְּיַרְכְּתֵי הַסְּפִינָה ·</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>יְיָ לְשַׁוְעָתֵנוּ</tei:abbr><tei:expan>יְיָ לְשַׁוְעָתֵנוּ הַאֲזִינָה׃</tei:expan></tei:choice></tei:seg></tei:l></tei:lg> <tei:pb n="41" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n83_medium.jpg"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yehabbienu_tsel_yado/ahor_vaqedem"/><tei:lg><tei:l>אָחוֹר וָקֶדֶם צַרְתָּנִי ·</tei:l> <tei:l>פָּנָה אֶפְנֶה אָנָה וָאָנָה ·</tei:l> <tei:l>אָרְחִי וְרִבְעִי זֵרִיתָ ·</tei:l> <tei:l>צֵרַפְתַּנִי בַל־תִּמְצָא ·</tei:l> <tei:l>יְיָ חֲקַרְתַּנִי ·</tei:l> <tei:l>אַתָּה וְיָאוֹת בְּנַחְצָחוֹת ·</tei:l> <tei:l>בְּלַעַג לָשׁוֹן וְאֵין בִּינָה׃</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>יְיָ לְשַׁוְעָתֵנוּ</tei:abbr><tei:expan>יְיָ לְשַׁוְעָתֵנוּ הַאֲזִינָה׃</tei:expan></tei:choice></tei:seg></tei:l></tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yehabbienu_tsel_yado/qadem_na"/><tei:lg><tei:l>קַדְּמֵנָא רַחֲמֶיךָ כִּי לְךָ טוֹב לְהוֹדוֹת ·</tei:l> <tei:l>רְצֵה שַׁוְעַת־גְּדָיֶיךָ ·</tei:l> <tei:l>וַעֲמַל צֹאן אוֹבְדוֹת ·</tei:l> <tei:l>הִפָּלְטֵנוּ הֱיֵה לָנוּ לְצוּר־מָעוֹז לְבֵית־מְצוּדוֹת ·</tei:l> <tei:l>לְכָה לָנוּ לִישׁוּעָה ·</tei:l> <tei:l>כִּלְשִׁמְעוֹן וְלֵוִי אֲחֵי־דִינָה ·</tei:l> <tei:l><tei:seg type="refrain">יְיָ לְשַׁוְעָתֵנוּ הַאֲזִינָה׃</tei:seg></tei:l><tei:l><tei:choice><tei:abbr>יחביאנו וכו׳</tei:abbr><tei:expan>יֶחֱבִיאֵנוּ צֵל יָדוֹ · תַּחַת כַּנְפֵי־הַשְּׁכִינָה · חוֹן יָחוֹן כִּי יִבְחוֹן לֵב עָקוֹב לַהֲכִינוֹ · קוּמָה־נָּא אֱלֹהֵינוּ עוּזָה · עוּזִי נָא · יְיָ לְשַׁוְעָתֵנוּ הַאֲזִינָה׃</tei:expan></tei:choice></tei:l></tei:lg> <tei:milestone unit="stanza"/></tei:div>
    </tei:body>
  </tei:text>
