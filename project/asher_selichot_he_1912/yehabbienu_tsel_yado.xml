  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yehabbienu_tsel_yado"><tei:pb n="40" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n81_medium.jpg"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yehabbienu_tsel_yado/yehabbienu"/><tei:lg><tei:l>יַחְבִּיאֵנוּ צֵל יָדוֹ ·</tei:l> <tei:l>תַּחַת כַּנְפֵי־הַשְּׁכִינָה ·</tei:l> <tei:l>חוֹן יָחוֹן ·</tei:l> <tei:l>כִּי־יִבְחוֹן לֵב עָקוֹב לְהָבִינָה ·</tei:l> <tei:l>קוּמָה־נָא אֱלֹהֵינוּ עֻזָּה ·</tei:l> <tei:l>עוּז־נָא ·</tei:l> <tei:l><tei:seg type="refrain">יְיָ לִישׁוּעָתֵנוּ הַאֲזִינָה׃</tei:seg></tei:l></tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yehabbienu_tsel_yado/anah_eilekh"/><tei:lg><tei:l>אָנָה אֵלֵךְ מֵרוּחֶךָ וְאָנָה מִפָּנֶיךָ אֶבְרָח ·</tei:l> <tei:l>פִּנּוֹתַי אֵין־מָנוֹס פְּאַת־מַעֲרָב וּמִזְרָח ·</tei:l> <tei:l>גִּלְגַּלְתִּי אַחֲרֶיךָ לְשַׁחֲרֶךָ ·</tei:l> <tei:l>יַחַד כַּגָּר כָּאֹרַח ·</tei:l> <tei:l>בְּהִשָּׁפְטִי לְצִדְקָתִי ·</tei:l> <tei:l>הַשְּׂמָאִילָה וְהַיְמִינָה׃</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>יְיָ לישועתנו</tei:abbr><tei:expan>יְיָ לִישׁוּעָתֵנוּ הַאֲזִינָה׃</tei:expan></tei:choice></tei:seg></tei:l></tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yehabbienu_tsel_yado/shamayim"/><tei:lg><tei:l>דּוֹק שָׁמֶיךָ בְּיַרְכָתַיִם ·</tei:l> <tei:l>גַּם שָׁם אִם־אֶסַּק ·</tei:l> <tei:l>הוֹדְךָ שָׁם לְשָׁפְטֵנִי עַל־כָּל־הַנֶּעֱסָק ·</tei:l> <tei:l>וַהֲגִיגִי בְּרוֹב שְׁגָגִי כְּכִיוּר־אֵשׁ נָסָק ·</tei:l> <tei:l>נָצְרָה דַּל־שְׂפָתֵינוּ תֵּת־לָנוּ חֲנִינָה׃</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>יְיָ לישועתנו</tei:abbr><tei:expan>יְיָ לִישׁוּעָתֵנוּ הַאֲזִינָה׃</tei:expan></tei:choice></tei:seg></tei:l></tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yehabbienu_tsel_yado/sheol"/><tei:lg><tei:l>זֵוֵי־שְׁאוֹל בְּמַחְתַּרְתּוֹ אַף כִּי־אַצִּיעַ ·</tei:l> <tei:l>חֲזִיתִי וְהִנְּךָ שָׁם לְחַבְּרָה וּלְהַפְגִּיעַ ·</tei:l> <tei:l>טָפַשׁ לִבִּי וְהֶחֱרַד כִּי לְבֵין מָוֶת כְּפֶשַׂע ·</tei:l> <tei:l>שְׁמוֹר שְׁאֵרִית נִדְחֵי בְּכָל־פִּנָּה וּפִנָּה׃</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>יְיָ לישועתנו</tei:abbr><tei:expan>יְיָ לִישׁוּעָתֵנוּ הַאֲזִינָה׃</tei:expan></tei:choice></tei:seg></tei:l></tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yehabbienu_tsel_yado/yam_gadol"/><tei:lg><tei:l>יָם־גָּדוֹל בְּאַחֲרִיתוֹ ·</tei:l> <tei:l>אַף כִּי אֶשְׁכּוֹנָה ·</tei:l> <tei:l>כַף־יְמִינְךָ תֹאחֲזֵנִי ·</tei:l> <tei:l>וּמָה־לְנַפְשִׁי אֶשְׁכּוֹנָה ·</tei:l> <tei:l>לוּלֵי רוֹב רַחֲמֶיךָ ·</tei:l> <tei:l>דְּרָכַי לֹא־אֶסְפּוֹנָה ·</tei:l> <tei:l>מְשׁוֹךְ חֶסֶד לִנְגָשִׂים ·</tei:l> <tei:l>תַּחַת יָד עֲדִינָה׃</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>יְיָ לישועתנו</tei:abbr><tei:expan>יְיָ לִישׁוּעָתֵנוּ הַאֲזִינָה׃</tei:expan></tei:choice></tei:seg></tei:l></tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yehabbienu_tsel_yado/mirdat_laylah"/><tei:lg><tei:l>מֵרְדַת־לַיְלָה תְּסוֹבְבֵנִי ·</tei:l> <tei:l>אָז יְשׁוּפֵנִי חֹשֶׁךְ ·</tei:l> <tei:l>נְגוֹהוֹת לְךָ הָאֲפֵלוֹת כָּאוֹר יָהֵל וּמוֹשֵׁךְ ·</tei:l> <tei:l>סָמַר בְּשָׂרִי מִפַּחְדֶּךָ כְּשֹׂךְ נָחָשׁ נוֹשֵׁךְ ·</tei:l> <tei:l>וְעַל־הָדַם כְּמוֹ נִרְדָּם ·</tei:l> <tei:l>בְּיַרְכְּתֵי הַסְּפִינָה׃</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>יְיָ לישועתנו</tei:abbr><tei:expan>יְיָ לִישׁוּעָתֵנוּ הַאֲזִינָה׃</tei:expan></tei:choice></tei:seg></tei:l></tei:lg> <tei:pb n="41" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n83_medium.jpg"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yehabbienu_tsel_yado/ahor_vaqedem"/><tei:lg><tei:l>עָלַי שָׁתָה כַפֶּכָה ·</tei:l> <tei:l>אָחוֹר וָקֶדֶם צַרְתָּנִי ·</tei:l> <tei:l>פָּנָה אֶפְנֶה אָנָה וָאָנָה ·</tei:l> <tei:l>אָרְחִי וְרִבְעִי זֵרִיתָנִי ·</tei:l> <tei:l>צֵרַפְתַּנִי בַּל־הַמְּצִיא ·</tei:l> <tei:l>יְיָ חֲקַרְתַּנִי ·</tei:l> <tei:l>אַח וְאָחוֹת בְּצַחְצָחוֹת ·</tei:l> <tei:l>בִּלְעַג לָשׁוֹן וְאֵין בִּינָה׃</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>יְיָ לישועתנו</tei:abbr><tei:expan>יְיָ לִישׁוּעָתֵנוּ הַאֲזִינָה׃</tei:expan></tei:choice></tei:seg></tei:l></tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yehabbienu_tsel_yado/qadem_na"/><tei:lg><tei:l>קַדְּמָה־נָא רַחֲמֶיךָ ·</tei:l> <tei:l>כִּי לְךָ טוֹב לְהוֹדוֹת ·</tei:l> <tei:l>רְצֵה שַׁוְעַת־גְּדָיֶיךָ ·</tei:l> <tei:l>וַעֲמַל צֹאן אוֹבְדוֹת ·</tei:l> <tei:l>תְּפַלְּטֵנוּ הֱיֵה לָנוּ ·</tei:l> <tei:l>לְצוּר־מָעוֹן לְבֵית־מְצוּדוֹת ·</tei:l> <tei:l>לְכָה לָנוּ לִישׁוּעָה ·</tei:l> <tei:l>כִּלְשִׁמְעוֹן וּלְוִי אֲחֵי־דִינָה׃</tei:l> <tei:l><tei:seg type="refrain">יְיָ לִישׁוּעָתֵנוּ הַאֲזִינָה׃</tei:seg></tei:l><tei:l><tei:choice><tei:abbr>יחביאנו וכו׳</tei:abbr><tei:expan>יַחְבִּיאֵנוּ צֵל יָדוֹ · תַּחַת כַּנְפֵי־הַשְּׁכִינָה · חוֹן יָחוֹן · כִּי־יִבְחוֹן לֵב עָקוֹב לְהָבִינָה · קוּמָה־נָא אֱלֹהֵינוּ עֻזָּה · עוּז־נָא · יְיָ לִישׁוּעָתֵנוּ הַאֲזִינָה׃</tei:expan></tei:choice></tei:l></tei:lg> <tei:milestone unit="stanza"/></tei:div>
    </tei:body>
  </tei:text>
