      <tei:div corresp="urn:x-opensiddur:text:poem:tohelet_yisrael_hesed_lo_neezav">
        <tei:pb n="110" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n221_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>תּוֹחֶלֶת יִשְׂרָאֵל חֶסֶד לֹא־נֶעֱזָב ·</tei:l> <tei:l>הַקּוֹוָתָם נֵצַח אֵמוּן לֹא אִכְזָב ·</tei:l> <tei:l>שׁוֹמְרֵי חָזוֹן הַמּוֹעֵד רוֹאוֹת כְּמֵרֹזָב ·</tei:l> <tei:l>שָׁחוּ כָלוּ וְעֵמֶק הַבָּכָא זָב׃</tei:l> <tei:l>רוּם רַעֲנָן מַטֹּה מָטֹה שָׁפֵל ·</tei:l> <tei:l>רֹאשׁ לְזָנָב וְעִקָּר לַעֲרַאי וְטָפֵל ·</tei:l> <tei:l>קֵץ תּוֹחֶלֶת לְיוֹשְׁבֵי־חֹשֶׁךְ וּמַאֲפֵל ·</tei:l> <tei:l>קַוֵּה לָאוֹר וְשִׁית עָנָן וַעֲרָפֶל׃</tei:l> <tei:l>צְבִי־קֹדֶשׁ חִלַּלְתָּ רֵאשִׁית מִלְהָרְשִׁים ·</tei:l> <tei:l>צִיץ הַמַּטֶּה פָּרַח הַזָּדוֹן לְיוֹרְשִׁים ·</tei:l> <tei:l>פִּנִּיתָ סְלָעִים וּמְרָשִׁים לְהַשְׁבִּיחַ שָׁרָשִׁים ·</tei:l> <tei:l>פָּרִצַת מְשׂוֹשׂ פְּרָאִים וַחֲזִירֵי חוֹרָשִׁים׃</tei:l> <tei:l>עָרִיץ וְכָל־הַבָּא בָוְזוּ וְעוֹלֵל ·</tei:l> <tei:l>עוֹבֵר וָשָׁב וְזִיז־שָׂדַי יְעוֹלֵל ·</tei:l> <tei:l>סְבָאוּם סוֹבְאִים שְׁאָר הָשִׂים לְמוֹלֵל ·</tei:l> <tei:l>סוֹכַת יֶתֶר־הֲמוֹן לְזוֹלֵל הַתְּעוֹלֵל׃</tei:l> <tei:l>נֶטַע כֻּתַּךְ לְמָזוֹר בַּרְזֶל וַחֲרִיצִים ·</tei:l> <tei:l>נִטַּשְׁתָּ וְעָזַבְתָּ וּבְאוֹיְבֶיהָ פָּרִיצִים ·</tei:l> <tei:l>מִצֵּינַת חֲפוּי כֶּסֶף וִירַקְרַק חָרוּצִים ·</tei:l> <tei:l>מָדְרִים גָּז וָנֵץ וְאֶפְרוֹחֶיהָ קְרוּצִים׃</tei:l> <tei:l>לְכָל־הַבָּא עָלֵינוּ <tei:pb n="111" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n223_medium.jpg"/>מְעַט קָצַפְתָּ ·</tei:l> <tei:l>לְרָעָה עָזְרוּ גוֹי עַז חֲנֵפַת ·</tei:l> <tei:l>כַּף עַיִן בְּעַיִן מִפְּרוֹעַ אַכְפַּת ·</tei:l> <tei:l>כְּלַפֵּי חֶסֶד זְרוֹעַ גְּבוּי חָשַׂפַת׃</tei:l> <tei:l>יָד לְקַבֵּל פָּשַׁטְתָּ וְנָתַנּוּ סוֹרָרֶת ·</tei:l> <tei:l>יַד אֻמְלָה מִקּוֹל בְּקוֹל הֲנִסוֹרֶת ·</tei:l> <tei:l>טוֹר־חֶסֶד וּבְרִית לְאָבוֹת כַּסוֹרֶת ·</tei:l> <tei:l>טוּב־טַעַם פְּתַח לְהַתִּיר אוֹסֶרֶת׃</tei:l> <tei:l>הֶשְׁבּוֹן אַחַר הֶשְׁבּוֹן עַמְּךָ יִפְתּוֹר ·</tei:l> <tei:l>חוֹכֶה וְסוֹבֵה דָוָה וְחוֹזֵר לִפְתּוֹר ·</tei:l> <tei:l>זֶה אוֹר מַשְׂכִּיל יְכוֹלֶת לְהוֹרוֹת זְמַן קוֹל־הַתּוֹר מָתַי לִפְתּוֹר ·</tei:l> <tei:l>וּבְכָל־זֹאת חָלִילָה בְאֹמְרָה לַשָּׁקֶר׃</tei:l> <tei:l>וְזָר לֹא־יוֹעִיל קָלוֹנוּ לְיַקֵּר ·</tei:l> <tei:l>הַעֲקוֹב רַב וְהַפַּתוֹת תַּשׁ לַעֲקוֹר ·</tei:l> <tei:l>הַדָּבָר־עָלֶיךָ כְּלָיוֹת חוֹקֵר וּמְבַקֵּר׃</tei:l> <tei:l>דְּרוֹשׁ וּפְקוֹד דַּלַּת שִׁפְלוּת שְׁחוֹחָה ·</tei:l> <tei:l>דָּל־כֶּרֶם וּמְעוֹרְבָב צְדֵי צַחָה גְּדוֹר עֲזֹק עִדּוּר מִקִּמּוֹשׁ וָחוֹחַ ·</tei:l> <tei:l>גֶּפֶן מַטַּע לְהַבְשִׁיל עִנְבֵי נִיחוֹחַ׃</tei:l> <tei:l>בָּנוּ שִׁמְךָ עֶלְיוֹן נִקְרָא לְכָל־תִּכְלָה ·</tei:l> <tei:l>נָא בְּמִדַּת־חֶסֶד וְלֹא־בְכָלָה ·</tei:l> <tei:l>אַשְׁמָתֵנוּ גָדְלָה עַד תֹּמֶן וְעַכְלָא ·</tei:l> <tei:l>אַתָּה יְיָ רַחֲמֶיךָ לֹא־תִכְלָא׃</tei:l> <tei:l>שֶׁבַח הִלּוּל מִדּוֹתֶיךָ אֵין לְשַׁנּוֹת ·</tei:l> <tei:l>לְבֵית יִשְׂרָאֵל רַב טוּב חַנּוֹת ·</tei:l> <tei:l>מְקוֹם מְנוֹחָה שִׂים בְּרֹאשׁ פִּנּוֹת הָכֵן בְּלִי רוֹגֶז וְתוֹסֶפֶת עַנּוֹת׃</tei:l> <tei:l>הִמָּצֵא הַוְשִׁילֵנוּ כִּי נוֹחָלְנוּ ·</tei:l> <tei:l>קָרְבֵנוּ הַט שָׂשׂוֹן יִשְׁעֲךָ לְהָלְנוּ ·</tei:l> <tei:l>טוֹב וְסַלָּח לְךָ־לְבַד הוֹחָלְנוּ ·</tei:l> <tei:l>נַחֲמֵנוּ נָא יְהִי חַסְדְּךָ עָלֵינוּ׃</tei:l> </tei:lg>
      </tei:div>
    </tei:body>
