    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:leenenu_ashuqu_amalenu">
        <tei:pb n="19" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n39_medium.jpg"/>
        <tei:lg><tei:l>לְעֵינֵינוּ עָשׁוּקוּ עֲמָלֵנוּ ·</tei:l> <tei:l>מְמֻשָּׁךְ וּמֹרָט מִמֶּנּוּ ·</tei:l> <tei:l>נָתְנוּ עֹלָם עָלֵינוּ ·</tei:l> <tei:l>סָבַלְנוּ עַל־שִׁכְמֵנוּ ·</tei:l> <tei:l>עֲבָדִים מָשְׁלוּ בָנוּ ·</tei:l> <tei:l>פּוֹרֵק אֵין מִיָּדָם ·</tei:l> <tei:l>צָרוֹת רַבּוֹת סְבָבוּנוּ ·</tei:l> <tei:l>קְרָאנוּךָ יְיָ אֱלֹהֵינוּ ·</tei:l> <tei:l>רָחַקְתָּ מִמֶּנּוּ בַּעֲוֹנֵינוּ ·</tei:l> <tei:l>שַׁבְנוּ מֵאַחֲרֶיךָ ·</tei:l> <tei:l>תָּעִינוּ וְאָבַדְנוּ ·</tei:l> <tei:l>וַעֲדַיִן לֹא שַׁבְנוּ מִתּוֹעִיָּתֵנוּ ·</tei:l> <tei:l>וְאֵיךְ נָעִיז פָּנֵינוּ וְנַקְשֶׁה עָרְפֵנוּ ·</tei:l> <tei:l>לוֹמַר לְפָנֶיךָ יְיָ אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ ·</tei:l> <tei:l>צַדִּיקִים אֲנַחְנוּ וְלֹא חָטָאנוּ ·</tei:l> <tei:l>אֲבָל אֲנַחְנוּ וַאֲבוֹתֵינוּ חָטָאנוּ׃</tei:l> </tei:lg>
