          <j:conditional xml:id="penitential_last-monday-fast_day_conclusion_repeat_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
