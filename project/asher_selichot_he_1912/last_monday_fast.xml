            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/last_monday_fast/pair_after_afafunu/printed">
            <tei:pb n="172" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n345_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say <tei:foreign xml:lang="he">אֵל מֶלֶךְ</tei:foreign> and <tei:foreign xml:lang="he">וַיַּעֲבֹר</tei:foreign> </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_last-monday-fast_day_pair_after_afafunu_printed"/>
          <j:conditional xml:id="penitential_last-monday-fast_day_pair_after_afafunu_expanded">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
