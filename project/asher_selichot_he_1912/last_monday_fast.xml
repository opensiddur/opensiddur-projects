          <j:transclude target="urn:x-opensiddur:text:prayer:vayaavor"/>
          <j:endConditional target="#penitential_last-monday-fast_day_pair_after_afafunu_expanded"/>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/last_monday_fast/haazinah_adonai_tefillatenu">
          <tei:pb n="172" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n345_medium.jpg"/>
          <tei:lg><tei:l>הַאֲזִינָה יְיָ תְּפִלָּתֵנוּ הַקְשִׁיבָה לְקוֹל תַּחֲנוּנֵנוּ׃</tei:l> <tei:l>שְׁמַע יְיָ קוֹלֵנוּ נִקְרָא וְחָנֵּנוּ וַעֲנֵנוּ׃</tei:l> <tei:l>שִׁמְעָה יְיָ צֶדֶק הַקְשִׁיבָה רִנָּתֵנוּ׃</tei:l> </tei:lg>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/last_monday_fast/verses_after_haazinah">
          <j:conditional xml:id="penitential_last-monday-fast_day_verses_after_haazinah_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/last_monday_fast/verses_after_haazinah/printed">
            <tei:pb n="172" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n345_medium.jpg"/>
            <tei:note type="instruction" xml:lang="he">כרחם אב · ליי הישועה · יי צבאות עמנו · יי צבאות אשרי · יי הושיעה · כי לא על · יי שמעה׃ </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_last-monday-fast_day_verses_after_haazinah_printed"/>
          <j:conditional xml:id="penitential_last-monday-fast_day_verses_after_haazinah_expanded">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div>
            <tei:milestone unit="prayer" corresp="urn:x-opensiddur:text:siddur:selichot/last_monday_fast/verses_after_haazinah/expanded"/>
            <tei:p><j:transclude target="urn:x-opensiddur:text:prayer:keraham_av" type="inline"/> <j:transclude target="urn:x-opensiddur:text:prayer:selichot/ki_lo_al_tsidqotenu" type="inline"/> </tei:p>
            <tei:milestone unit="prayer"/>
          </tei:div>
          <j:endConditional target="#penitential_last-monday-fast_day_verses_after_haazinah_expanded"/>
        </tei:div>
        <j:transclude target="urn:x-opensiddur:text:poem:ozon_tahan_vehasket_atirah"/>
