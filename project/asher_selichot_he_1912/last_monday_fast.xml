          <j:transclude target="urn:x-opensiddur:text:prayer:vayaavor"/>
          <j:endConditional target="#penitential_last-monday-fast_day_pair_after_ozon_expanded"/>
        </tei:div>
        <j:transclude target="urn:x-opensiddur:text:poem:ezkerah_elohim_veehemayah/fast_day_recension"/>
