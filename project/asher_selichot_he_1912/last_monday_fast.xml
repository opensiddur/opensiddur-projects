          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/last_monday_fast/pair_after_ozon/printed">
            <tei:pb n="173" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n347_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say <tei:foreign xml:lang="he">אֵל מֶלֶךְ</tei:foreign> and <tei:foreign xml:lang="he">וַיַּעֲבֹר</tei:foreign> </tei:note>
          </tei:div>
