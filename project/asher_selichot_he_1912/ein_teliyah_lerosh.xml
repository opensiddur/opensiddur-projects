      <tei:div corresp="urn:x-opensiddur:text:poem:ein_teliyah_lerosh">
        <tei:pb n="45" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n91_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אֵין תְּלִיָּה לְרֹאשׁ אִם לְפִי מַעֲוֹה ·</tei:l> <tei:l>בַּעֲבוּר כִּי כָּל־לֵב חָזָק וְנַעֲוָה ·</tei:l> <tei:l>גִּשְׁתּוֹ בַדִּין הָמַס יִמַּס וְכַדוֹנַג מִשְׁתַּעֲוָה ·</tei:l> <tei:pb n="46" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n93_medium.jpg"/><tei:l>דַּנְתּוֹ שַׂמְתּוֹ גּוֹלָה נִמְשָׁל נִשְׁנָן וְזַעֲוָה׃</tei:l> <tei:l>הוּשַׁל כָּשַׁל נֶחֱשַׁל כָּשַׁל וְהֵזִיד ·</tei:l> <tei:l>וּבְיוֹדְעִים חוֹק חָלַף וְתוֹרָת עָבַר בְּמֵזִיד ·</tei:l> <tei:l>זְכוּת עוֹקֵד וְנֶעֱקָד וְתֹמַת זָר־נָזִיד ·</tei:l> <tei:l>חֲשׁוֹב הַיּוֹם לִשְׁגָגָה וּלְפוֹתָה וּכְיָזִיד׃</tei:l> <tei:l>טְרִי חָרֵט וּמָזוֹר־זוּר וְחָבוֹשׁ נַחֲלָה ·</tei:l> <tei:l>יוֹנָתְךָ בְחֵיקְךָ מָתוֹק רְאֵה כִּי נוֹחֲלָה׃</tei:l> <tei:l>כְּמַבְכִּירָה בְּכוֹרָה־סוֹרֶרֶת צוֹוַחַת קוֹל כְּחוֹלָה ·</tei:l> <tei:l>לֵאָה נִלְאָה יְגֵעָה לֹא־חוֹנְנָה־לָהּ ·</tei:l> <tei:l>מְרוּצָה בְּקִרְבֵּנוּ נְעוּצָה בְקוֹפִיץ וּמְפַלֶּצֶת דִּיוּסְטוּר ·</tei:l> <tei:l>נוּל עוֹל מוּל פִּיהוּ עָלֵינוּ אָטַר ·</tei:l> <tei:l>שׂוֹנֵא סַחַר וְהָסְבִּיב וּבְצָנָה אוֹתָנוּ עִטֵּר ·</tei:l> <tei:l>עָוֹן הִכְתִּיב וְהַחְתִּים בַּעַל־פֶּה וּבַשְּׁטָר׃</tei:l> <tei:l>פְּלִיטֵיךָ נַהֵל לְרַגְלֵ־הַנַּחֲלוֹת וּלְרַגְלֵ־הַמְּלָאכָה ·</tei:l> <tei:l>צָפוֹן סוֹךְ חֲבָא סָתֵר נִכְאָה וְחֶלְכָּה ·</tei:l> <tei:l>קְרָאנוּךָ מִמֵּצַר עֲנֵנוּ וְלִישׁוּעָתָה לֵכָה ·</tei:l> <tei:l>רַפֵּה מָטָה בְּקֶרֶב־שָׁנִים חַיֵּיה פָעֳלֶךָ ·</tei:l> <tei:l>שְׁאָר־יַעֲקֹב נָשׁוּבָה אֶל אֵל־גִּבּוֹר ·</tei:l> <tei:l>תָּמִיד דַּרְכּוֹ לִסְלוֹחַ וְעַל־פֶּשַׁע עֲבוֹר ·</tei:l> <tei:l>אֶל־עָנִי מַבִּיט לְהַעֲלוֹתוֹ מִשָּׁאוֹן־בּוֹר ·</tei:l> <tei:l>יָהִיר וְגָאוֹן שׂוֹנֵא מָשְׁלוֹ וּזְרוֹעוֹ לִשְׁבּוֹר׃</tei:l> <tei:l>בְּרַבִּים הָיִיתָ עִמָּנוּ גַּם עַתָּה הִמָּצֵא ·</tei:l> <tei:l>שְׁמַע־יְיָ מִתְחַנֶּנִיךָ וְלָנוּ הַיּוֹם הִרְצֵה ·</tei:l> <tei:l>חָזוֹק וְאַמִּיץ תַּשְׁלוּם פַּר שָׂפָה רְצֵה ·</tei:l> <tei:l>לְיֵשַׁע אֶת־מְשִׁיחֶךָ וּלְיֵשַׁע עַמְּךָ צֵא׃</tei:l> </tei:lg>
