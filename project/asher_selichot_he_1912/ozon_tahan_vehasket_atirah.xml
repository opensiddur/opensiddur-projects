      <tei:div corresp="urn:x-opensiddur:text:poem:ozon_tahan_vehasket_atirah">
        <tei:pb n="172" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n345_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו אֹזוֹן תַּחַן וְהַסְכֵּת עֲתִירָה ·</tei:l> <tei:l>אַף הָפֵר וְשַׁכֵּךְ עֶבְרָה ·</tei:l> <tei:l>בָּאֵי לְחַלּוֹתְךָ בְּנֶפֶשׁ מָרָה ·</tei:l> <tei:l>בְּשִׁמְךָ הַגָּדוֹל יִמְצְאוּ עֶזְרָה׃</tei:l> <tei:l>גְּעַת נֶאֱנָחִים עֱנוּתָם חֲזֵה ·</tei:l> <tei:l>גְּחִינַת קוֹמְתָם נָא אַל־תִּבְזֶה ·</tei:l> <tei:l>דְּרוֹשׁ עֶלְבּוֹנָם מִצַּר בּוֹזֶה ·</tei:l> <tei:l>דְּרוֹךְ פּוּרָה וְנֵצַח יָזֶה׃</tei:l> <tei:l>הֲלֹא אַתָּה הָיִיתָ וְהִנְּךָ ·</tei:l> <tei:l>הָיוֹ תִהְיֶה בַּהֲדַר גְּאוֹנֶךָ ·</tei:l> <tei:l>וְנָאֻמַת יִכּוֹן זֶרַע אֱמוּנֶיךָ ·</tei:l> <tei:l>וְהִנָּם כָּלִים מִתִּגְרַת חֲרוֹנֶךָ׃</tei:l> <tei:l>זוֹעֲמוּ בְּאֻוִּים וּכְמָאִים נִסְחוּ ·</tei:l> <tei:l>זוֹרוּ בְּאַפְסִים וְלֹא־נָחוּ ·</tei:l> <tei:l>הֶבְלוּ רוּחָם וְלֶעָפָר שָׁחוּ ·</tei:l> <tei:l>חָרְשׁוּ חוֹרְשִׁים וּמַעֲנִית הִמְתִּיחוּ׃</tei:l> <tei:l>טָבְעוּ בְבוֹץ וְאֵין־פּוֹצֶה ·</tei:l> <tei:l>טוֹרְפֵיהֶם שָׁלוּ מִקָּצֶה אֶל־קָצֶה ·</tei:l> <tei:l>יוֹם־יוֹם לוֹחֲמָם מַנְצֶה ·</tei:l> <tei:l>יַד פּוֹרְשִׂים מִלַּחַץ לִיצֵא׃</tei:l> <tei:l>כָּלוּ חַיֵּיהֶם בְּיָגוֹן וַאֲנָחָה ·</tei:l> <tei:l>כּוֹשֵׁל רַבָּה וְעָרְבָה שִׂמְחָה ·</tei:l> <tei:l>לִישַׁע חוֹכִים וְהִנֵּה צְוָחָה ·</tei:l> <tei:l>לְבִטְנָם קָמִים כָּרוּ <tei:pb n="173" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n347_medium.jpg"/>שׁוּחָה׃</tei:l> <tei:l>מַעֲרִימִים סוֹד מִמְּךָ לְהַדִּיחָם ·</tei:l> <tei:l>מַכְבִּידִים עֹל לְהַכְשִׁיל כֹּחָם ·</tei:l> <tei:l>נוֹאֲקִים אֵלֶיךָ בְּהִתְעַטֵּף רוּחָם ·</tei:l> <tei:l>נַחַרַת לִמְצוֹא מִכּוֹבֶד טָרְחָם׃</tei:l> <tei:l>שָׂח צָגִים בְּמַעֲמָד צָפוּף ·</tei:l> <tei:l>סְלִיחָה מְבַקְשִׁים בְּקָדְקוֹד כָּפוּף ·</tei:l> <tei:l>עוֹשְׁקֵיהֶם יַקְנִיאֵם וּנְתָנוּם לְשִׁסּוּף ·</tei:l> <tei:l>עֲוָעִים יִמַּסְכּוּ וְיִהְיוּ לְכָפוּף׃</tei:l> <tei:l>פְּדֵה דְבֵקֶיךָ מֵחֵרָץ וּכְלוֹי ·</tei:l> <tei:l>פַּלְּטֵם מִצּוֹרֵר וּתְנֵם לְעִלּוּי ·</tei:l> <tei:l>צַוֵּה יְשׁוּעוֹת מְשַׁחֲרֶיךָ בְּחִלּוּי ·</tei:l> <tei:l>צַדְּקֵם בְּרִנָּה כַּסְתָּר וְגִלּוּי׃</tei:l> <tei:l>קַנּוֹא וְנוֹקֵם קַנֵּא לִשְׁמֶךָ ·</tei:l> <tei:l>קַצֵּץ כַּמְלוֹנִים מִצַּוַּאר עַמֶּךָ ·</tei:l> <tei:l>רְאֵה עֲמָלֵינוּ וְשׁוּב מִזַּעְמֶךָ ·</tei:l> <tei:l>רִיבָה רִיבֵנוּ מֵעַם חָרְמָךְ׃</tei:l> <tei:l>שִׁבְעָתַיִם הָשֵׁב לְחֵיק מְאַנֵּינִי ·</tei:l> <tei:l>שַׁכֵּר חִצֶּיךָ מִדָּם מְעַנָּי ·</tei:l> <tei:l>תַּטֵּה אָזְנְךָ לְקוֹל תַּחֲנוּנָי ·</tei:l> <tei:l>תִּרְצֵנִי בְּקָרְאִי יְיָ יְיָ׃</tei:l> </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
