      <tei:div corresp="urn:x-opensiddur:text:poem:attah_hael_oseh_felaot">
        <tei:pb n="181" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n363_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו אַתָּה הָאֵל עוֹשֵׂה־פְלָאוֹת ·</tei:l> <tei:l>בָּעַמִּים הוֹדַעְתָּ נִפְלָאוֹת ·</tei:l> <tei:l>גָּאַלְתָּ בִזְרוֹעַ עַמְּךָ מִתְּלָאוֹת ·</tei:l> <tei:l>דִּכִּיתָ צָרֵיהֶם בְּמוֹתֵי תַחֲלוּאוֹת׃</tei:l> <tei:l>הָאוֹיֵב בְּקוּמוֹ לְעוֹרֵר מְדָנִים ·</tei:l> <tei:l>וְדִמָּה לְאַבֵּד פִּרְחֵי עֲדָנִים ·</tei:l> <tei:l>זָמַם לִשְׁקוֹל לְגִנְזֵי אֲדוֹנִים ·</tei:l> <tei:l>חֲלִיפֵי מְאַת כִּכְּרֵי אֲדָנִים׃</tei:l> <tei:l>טְלָאֶיךָ הוֹרֵתָ שְׁקָלֵיהֶם לְהַקְדִּים ·</tei:l> <tei:l>יְדָעַת הָעֲתִידוֹת וְדָרַשְׁתָּ נִשְׁקָדִים ·</tei:l> <tei:l>כְּנוּי לְהַמְצִיא לְלַהַב יוֹקְדִים ·</tei:l> <tei:l>לְקוּחִים לַמָּוֶת לִתְחִי נִפְקָדִים׃</tei:l> <tei:l>כְּפָה צָרָה מִשְׁתַּחֲוִים לְפָנִים ·</tei:l> <tei:l>נִמְסְרוּ לְעוֹלֵל קְנוֹקְנוֹת וּגְפָנִים ·</tei:l> <tei:l>כְּבָבוּם מוֹקְשִׁים בְּכָל־דְּפָנִים ·</tei:l> <tei:l>עֵינֵיהֶם לְךָ תוֹלִים וּבְסִתְרְךָ נִצְפָּנִים׃</tei:l> <tei:l>פּוּר נֶהְפַּךְ בְּאוֹיְבִים לִשְׁלוֹט ·</tei:l> <tei:l>צְלִיבָה הוּכַן אֲגָגִי לִקְלוֹט ·</tei:l> <tei:l>קָלַע וּבִלַּע פְּנֵי הַלּוֹט הַלּוֹט ·</tei:l> <tei:l>רִיבַי עִם נֶאֱשָׁמִים לַעֲלוֹט׃</tei:l> <tei:l>שָׁלוֹם וֶאֱמֶת כָּתַב לְבַל־יִצַּד ·</tei:l> <tei:l>תֹּקֶף וָיֶשַׁע סֶלַע <tei:pb n="182" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n365_medium.jpg"/>וּמִצַּד ·</tei:l> <tei:l>שׁוֹדֵד הוּשְׁדַּד וּבְרִשְׁתּוֹ נוֹצַד ·</tei:l> <tei:l>מַלְשִׁינִי נִסְחַף נִצְמַת וְנִרְצַד׃</tei:l> <tei:l>עָשׂוּ שְׂמָחוֹת וּלְדוֹרוֹת קְבָעוּם ·</tei:l> <tei:l>וּמִקְרָאוֹת שִׁלְּשׁוּם וְלֹא־רִבְּעוּם ·</tei:l> <tei:l>נִסְכְּמוּ מִמַּעַל וְעִמָּם תְּבָעוּם ·</tei:l> <tei:l>בְּסֵפֶר נֶחְקַק עַל־מָה קְבָעוּם׃</tei:l> <tei:l>רָמָה יָדְךָ לִסְלוֹחַ לְפוֹשְׁעִים ·</tei:l> <tei:l>יְהוּדִי וַהֲדַסָּה הֵקַמְתָּ מוֹשִׁיעִים ·</tei:l> <tei:l>צִדְקָתָם עוֹמֶדֶת לָעַד לְשַׁעֲשׁוּעִים ·</tei:l> <tei:l>חֵקֶר כְּבוֹדָם לְהִזָּכֵר לְנוֹשָׁעִים׃</tei:l> <tei:l>קַנֵּא לְשִׁמְךָ הַנִּקְדָּשׁ ·</tei:l> <tei:l>חֲזֵה כַּרְמְךָ נָבוּז וְנַהַשׁ ·</tei:l> <tei:l>זְרוּיֶיךָ לְקַבֵּץ וּלְשִׁמְךָ שִׁיר יְחֻדָּשׁ ·</tei:l> <tei:l>קַיְּמֵם וְהַחֲיֵּים בְּבִנְיַן בֵּית הַמִּקְדָּשׁ׃</tei:l> <tei:l>וּכְעָשׂוֹתְךָ פְלָאוֹת בְּאוֹתָם הַיָּמִים ·</tei:l> <tei:l>אוֹתָנוּ הַפְלֵא תְּשׁוּעַת עוֹלָמִים ·</tei:l> <tei:l>מְצָא לְפָנֶיךָ כוֹפֶר וְתַנְחוּמִים ·</tei:l> <tei:l>אֵל מֶלֶךְ יוֹשֵׁב עַל כִּסֵּא רַחֲמִים׃</tei:l> </tei:lg>
      </tei:div>
