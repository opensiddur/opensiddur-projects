      <tei:div corresp="urn:x-opensiddur:text:poem:eleikha_lev_venefesh_nishpokh_kamayim">
        <tei:pb n="116" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n233_medium.jpg"/>
        <tei:lg><tei:l>אֵלֶיךָ לֵב וָנֶפֶשׁ נִשְׁפּוֹךְ כַּמַּיִם ·</tei:l> <tei:l>כֻּלָּנוּ אֶל־אֵל בַּשָּׁמַיִם׃</tei:l> <tei:l>אַחֵינוּ זְקֵנִים עִם עוֹלְלֵיכֶם הִזַּכּוּ וְהָסִירוּ רוֹעַ־מַעַלְלֵיכֶם׃</tei:l> <tei:l>לְפָנָיו נַרְבֶּה תְחִנָּה וּבַקָּשָׁה ·</tei:l> <tei:l>וְעַל־זֹאת מֵאֱלֹהֵינוּ נְבַקְּשָׁה׃</tei:l> <tei:l>יִתְגַּבֵּר־טוֹב עַל־מְנֻוָּל ·</tei:l> <tei:l>דַּרְכּוֹ יַעֲזוֹב רָשָׁע וּפוֹשֵׁעַ וְעַוָּל׃</tei:l> <tei:l>הָכִינוּ־לֵב וְהֵיטִיבוּ מַחֲשָׁבָה ·</tei:l> <tei:l>כִּי גָדוֹל כֹּחַ הַתְּשׁוּבָה׃</tei:l> <tei:l>בְּקָהָל־רַב מִלִּין נַכְבִּיר ·</tei:l> <tei:l>וְלֹא־יִמְאַס אֵל־כַּבִּיר׃</tei:l> <tei:l>רוֹצֶה תְשׁוּבַת בּוֹגֵד וְנִשְׁחַת ·</tei:l> <tei:l>לְהָשִׁיב־נַפְשׁוֹ מִנִּי שָׁחַת׃</tei:l> <tei:l>שְׁמַע תַּחֲנוּן וְהֵעָתֵר לִמְבַקְשֶׁיךָ ·</tei:l> <tei:l>בְּנָשְׂאֵנוּ יָדֵינוּ אֶל־דְּבִיר קָדְשֶׁךָ׃</tei:l> <tei:l>וְיִהְיוּ־נָא אִמְרֵי פִינוּ לְרָצוֹן ·</tei:l> <tei:l>וְכַפֵּר עַל־חַטֹּאתֵינוּ אֹנֶס וְרָצוֹן׃</tei:l> <tei:l>חֲשׁוֹב זְכוֹר קְרִיאַת נְעִימָה ·</tei:l> <tei:l>וְהִנָּחֵם עַל־הָרָעָה לְעַמֶּךָ׃</tei:l> <tei:l>וַעֲשֵׂה חֵפֶץ־עֲבָדֶיךָ וִישַׁעַשְׁעוּן תַּנְחוּמֶיךָ ·</tei:l> <tei:l>סְמוּכִים בְּחַסְדְּךָ וּבְטוּחִים עַל־רַחֲמֶיךָ׃</tei:l> </tei:lg>
