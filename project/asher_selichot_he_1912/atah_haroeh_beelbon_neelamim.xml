      <tei:div corresp="urn:x-opensiddur:text:poem:atah_haroeh_beelbon_neelamim">
        <tei:pb n="141" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n283_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אַתָּה הָרוֹאֶה בְּעֶלְבּוֹן נֶעֱלָבִים ·</tei:l> <tei:l>אַתָּה הָאוֹמֵר שׁוּבוּ בָנִים שׁוֹבָבִים ·</tei:l> <tei:l>בְּעַצְמְךָ מֵעִיד עֵדוּת הַשָּׁבִים ·</tei:l> <tei:l>בְּיָדֵנוּ רְאָיוֹת מִסְּפֹרֶת וּכְתוּבִים׃</tei:l> <tei:l>גְּדוֹלָה תְּשׁוּבָה לְכִסֵּא מַגַּעַת ·</tei:l> <tei:l>גְּבוֹהָה לְמַעְלָה וּבָאָרֶץ מוּדַעַת ·</tei:l> <tei:l>דְּמוּיָה לַיָּם לְקוֹלָהּ נִשְׁמַעַת ·</tei:l> <tei:l>דּוֹחָה הַגְּזֵרָה גְּזַר־דִּין קוֹרַעַת׃</tei:l> <tei:l>הַתְּשׁוּבָה <tei:pb n="142" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n285_medium.jpg"/>עֲרִיבָה מִקָּרְבַּן וּקְטֹרֶת ·</tei:l> <tei:l>הַשְּׁטָר קוֹרַעַת וּפוֹרַעַת מַעֲוָת ·</tei:l> <tei:l>גּוֹרֶמֶת לְרַחֲמִים וּזְכֻיּוֹת מַזְכֶּרֶת ·</tei:l> <tei:l>וְחַיִל עָתְקָה וְגָבְרָה תַגְבֹּרֶת׃</tei:l> <tei:l>זְבוּדָה לְשִׁשָּׁה וּלְעוֹלָם קָדְמָה ·</tei:l> <tei:l>זְרוּיִם מְקַבֶּצֶת מִקְצֵוי אֲדָמָה ·</tei:l> <tei:l>חֵמָה מְשִׁיבָה מְגִנָּה כְּחוֹמָה ·</tei:l> <tei:l>חֶסֶד נְשִׂיאָה וּלְדֹרוֹת נִסְתַּיְמָה׃</tei:l> <tei:l>טוֹב וְיָשָׁר מוֹרֶה אָרְחוֹתֶיהָ ·</tei:l> <tei:l>טוֹבוּ אֹהָלֶיהָ נָעֲמוּ מִשְׁכְּנוֹתֶיהָ ·</tei:l> <tei:l>יָד פְּשׁוּטָה לְקַבֵּל בְּנוֹתֶיהָ ·</tei:l> <tei:l>יִדְרְשׁוּהָ כָּל יָמָּה תּוֹצְאוֹתֶיהָ׃</tei:l> <tei:l>כְּבוּדָה בַת־מֶלֶךְ וְהַצְנֵעַ קוֹרְאָה ·</tei:l> <tei:l>כְּלִי שָׁבוּר בּוֹ מִתְרָאָה ·</tei:l> <tei:l>לוֹבֶשֶׁת עֲנָוָה מְבִיאָה הַיִּרְאָה ·</tei:l> <tei:l>לַמֶּלֶךְ שָׁה רְאוּיָה וְנָאָה׃</tei:l> <tei:l>מִדַּת בָּשָׂר מְבַקֵּשׁ עֶלְבּוֹנוֹ ·</tei:l> <tei:l>מְפַרְסֵם בָּרַבִּים כַּעַם עִנְיָנוֹ ·</tei:l> <tei:l>נִשְׁתַּנָּה הַשֵּׁם לְעִלּוּי בְּדִינוֹ ·</tei:l> <tei:l>נִמְצָא בְּמִסְתָּר לְעוֹבְרֵי רְצוֹנוֹ׃</tei:l> <tei:l>סֶפֶק בְּיָדוֹ הַגְּדוֹלָה וְהַטּוֹבָה ·</tei:l> <tei:l>סְלִיחוֹת הָרַבּוֹת לְעֶדְרוֹ הַנִּשְׁבָּה ·</tei:l> <tei:l>עָוֹן הַנִּכְתָּם לְהַעֲבִירוֹ בְּאַהֲבָה ·</tei:l> <tei:l>עַמּוֹ הַמְּיֻחָד לְהַחֲזִירוֹ בִּתְשׁוּבָה׃</tei:l> <tei:l>פִּקַּח יוֹדֵעַ לִמְצֹא רְצוֹנוֹ ·</tei:l> <tei:l>פֶּתַח הַתְּשׁוּבָה וּמְזוֹר הֶגְיוֹנוֹ ·</tei:l> <tei:l>צוֹפֶה וְלוֹמֵד וְתוֹלָה עֵינוֹ ·</tei:l> <tei:l>צֶמֶד־הַבָּקָר יוֹדֵעַ קוֹנוֹ׃</tei:l> <tei:l>קוֹנֵנוּ מַגִּיד מֵישָׁרִים ·</tei:l> <tei:l>קַלִּים תַּבְלִיג לְהַחֲלִיף הַחֲמוּרִים ·</tei:l> <tei:l>רֵיקָם מָלֵא בְּשָׂלוֹם פָּרִים ·</tei:l> <tei:l>רְצֵה עֲתִירָתֵנוּ כְדָמִים וְאֵמוּרִים׃</tei:l> <tei:l>שְׂפָתֵינוּ נְשַׁלְּמָה פָרִים וּנְתָחִים ·</tei:l> <tei:l>שִׂיחֵנוּ קַבֵּל כְּעוֹלוֹת מוֹחִים ·</tei:l> <tei:l>תָּכוֹן תְּפִלָּתֵנוּ כִּרְקִיקִים מְשֻׁחִים ·</tei:l> <tei:l>תִּשְׁמַע שַׁוְעַת שׁוֹשַׁנַּת חוֹחִים׃</tei:l> <tei:l>בּוֹחֵן כְּלָיוֹת רוֹכֵב עֲרָבוֹת ·</tei:l> <tei:l>בְּרִית תִּזְכּוֹר תּוֹכֵן לִבּוֹת ·</tei:l> <tei:l>שִׁמְעָה בְקוֹלֵנוּ וְהַיְשַׁר נְתִיבוֹת ·</tei:l> <tei:l>אֱלֹהִים תִּהְיֶינָה אָזְנֶיךָ קַשֻּׁבוֹת׃</tei:l> <tei:l>חוֹקְקְךָ וּמְיַחֶדְךָ לְטַהֵר עֲבָדֶיךָ ·</tei:l> <tei:l>אַתָּה לְבַדֶּךָ וְאֵין בִּלְעָדֶיךָ ·</tei:l> <tei:pb n="143" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n287_medium.jpg"/><tei:l>רוֹצֶה בִּתְשׁוּבַת בָּאֵי עָדֶיךָ ·</tei:l> <tei:l>הַהֵ״י וְהַקּוֹ״ף הֵן הֵן עֵדֶיךָ׃</tei:l> <tei:l>וְאַתָּה מֶלֶךְ צוּר עוֹלָמִים ·</tei:l> <tei:l>תְּהַיָּה דָמִים תְּכַבֵּס נִכְתָּמִים׃</tei:l> <tei:l>עֲשֵׂה עִמָּנוּ הָאֵל־תָּמִים ·</tei:l> <tei:l>אֵל מֶלֶךְ יוֹשֵׁב עַל־כִּסֵּא רַחֲמִים׃</tei:l> </tei:lg>
      </tei:div>
    </tei:body>
