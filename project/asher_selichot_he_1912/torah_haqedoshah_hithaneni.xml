      <tei:div corresp="urn:x-opensiddur:text:poem:torah_haqedoshah_hithaneni">
        <tei:pb n="102" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n205_medium.jpg"/>
        <tei:lg><tei:l>תּוֹרָה הַקְּדוֹשָׁה ·</tei:l> <tei:l>הִתְחַנְּנִי בְבַקָּשָׁה ·</tei:l> <tei:l>פְּנֵי־הַצּוּר נַעֲרָץ בַּקֹּדֶשׁ׃</tei:l> <tei:l>שִׁפְכִי שִׂיחַ עָרֵב ·</tei:l> <tei:l>וְזִכְרִי מַעֲשֶׂה חוֹרֵב ·</tei:l> <tei:l>בְּנַעֲשֶׂה וְנִשְׁמַע נָמוּ לְהִתְקָרֵב׃</tei:l> <tei:l>רָגְנוּ שֵׂעִיר וּפָארָן ·</tei:l> <tei:l>דְּתּוֹתַיִךְ לִשְׁמֹר ·</tei:l> <tei:l>עָמַד וּמָדַד רָאָה וְהִתִּירָן׃</tei:l> <tei:l>קָדוֹשׁ הֶעְתִּיקָם ·</tei:l> <tei:l>לֹא שָׁמְרוּ חֻקָּם ·</tei:l> <tei:l>בְּאַף וּבְחֵמָה עָשׂוֹת בָּהֶם נָקָם׃</tei:l> <tei:l>צָעַד מֵרְבָבוֹת וְנִקְדַּשׁ בָּעֲרָבוֹת ·</tei:l> <tei:l>מִימִינוֹ אֵשׁ דָּת וְלַהַב שַׁלְהָבוֹת׃</tei:l> <tei:l>פָּנִים מַסְבִּירוֹת ·</tei:l> <tei:l>אֵלָיו מִתְחַבְּרוֹת ·</tei:l> <tei:l>הוּנְשְׁקוּ מִפִּיו עֲשֶׂרֶת הַדִּבְּרוֹת׃</tei:l> <tei:l>עוֹלָם נִתְבַּסֵּס ·</tei:l> <tei:l>אֲשֶׁר מִתְּנָאָיו נָמַס ·</tei:l> <tei:l>וּכְמוֹצֵא שָׁלָל־רָב עַל־אִמְרָתָךְ שָׂשׂ׃</tei:l> <tei:l>סוֹדֵי פִקּוּדָיִךְ ·</tei:l> <tei:l>נִמְסְרוּ לְדוֹדָיִךְ ·</tei:l> <tei:l>מֵאָז וְעַד־עַתָּה הֵמָּה מְכַבְּדָיִךְ׃</tei:l> <tei:l>נָדִים וְנָם נָעִים ·</tei:l> <tei:l>וּבְרֹגֶז שְׂבֵעִים ·</tei:l> <tei:l>בְּנֹפֶת צוּפַיִךְ תָּמִיד מִשְׁתַּעְשְׁעִים׃</tei:l> <tei:l>מַסֹּרֶת לְיַפּוֹת ·</tei:l> <tei:l>בִּכְתָב וּבְעַל־פֶּה ·</tei:l> <tei:l>יְקָרוּ אִמְרָתָךְ מִשֹּׁהַם וְיָשְׁפֵה׃</tei:l> <tei:l>לִבִּי לְחוֹקְקָיִךְ ·</tei:l> <tei:l>בַּעֲלִיל מְחוֹקְקָיִךְ ·</tei:l> <tei:l>קוֹבְעֵי עִתּוֹתָם לְפָרֵשׁ פְּקֻדָּיִךְ׃</tei:l> <tei:l>בַּלָּהוֹת <tei:pb n="103" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n207_medium.jpg"/>וּפְרָמוֹת ·</tei:l> <tei:l>לִרְאוֹת וּלְהַטוֹת ·</tei:l> <tei:l>שְׁנָתָם נוֹדֶדֶת בְּחַדְרֵי הַמִּטּוֹת׃</tei:l> <tei:l>יוֹם־יוֹם יִדְרֹשׁוּן ·</tei:l> <tei:l>בְּלִבָּם יַחֲרוֹשׁוּן ·</tei:l> <tei:l>לֶאֱסוֹר וּלְהַתִּיר בְּפִיהֶם יְפָרְשׁוּן׃</tei:l> <tei:l>טְמֵאוֹת וּטְהָרוֹת ·</tei:l> <tei:l>לְהַבְדִּיל וּלְהוֹרוֹת ·</tei:l> <tei:l>מִלַּחַץ וְדֹחַק עֵינֵיהֶם נוֹהֲרוֹת׃</tei:l> <tei:l>חֻקִּים וּמִשְׁפָּטִים ·</tei:l> <tei:l>עַל־פִּימוֹ שׁוֹפְטִים ·</tei:l> <tei:l>וְאוֹיְבֵיהֶם פְּלִילִים וּבָהֶם נִשְׁפָּטִים׃</tei:l> <tei:l>זִכְרִי זֹאת תְּעוּדָה ·</tei:l> <tei:l>הוֹגְנַיִךְ לְהִתְעוֹדְדָה וּמְלִיצֵי הֶגְיוֹנַיִךְ לַעֲזוֹר וּלְסַעֲדָה׃</tei:l> <tei:l>וְחַנִּי פְּנֵי קוֹנֵךְ ·</tei:l> <tei:l>בְּמַעַן חֲנוּנֵךְ ·</tei:l> <tei:l>כִּי הוּא אֱלֹהַיִךְ יוֹצְרֵךְ וַאֲדֹנֵךְ׃</tei:l> <tei:l>הֲלֹא אִם אֵין תַּמָּה ·</tei:l> <tei:l>הוֹגָה בִתְמִימָה ·</tei:l> <tei:l>הֵן בַּקֶּרֶן זָוִית נְתוּנָה וּמִשְׁתּוֹמֵמָה׃</tei:l> <tei:l>דּוֹק וְחֶלֶד עֲבוּרָהּ ·</tei:l> <tei:l>עוֹמְדִים בִּגְבוּרָה ·</tei:l> <tei:l>בְּיִרְאָה הַטְּהוֹרָה וּבְמִצְוָה בָּרָה׃</tei:l> <tei:l>גַּבְּרִי רְנָנִים וְשִׁפְכִי תַחֲנוּנִים ·</tei:l> <tei:l>עֲבוּר תְּפִלָּתֵנוּ בְּאֵין־סְבוֹךְ עֲנָנִים׃</tei:l> <tei:l>בּוֹא עָדָיו פִּתְחוֹן ·</tei:l> <tei:l>לִנְקוּתָם מִצִּחָן ·</tei:l> <tei:l>מֵאָזְנַיִם יִתֵּן כְּמֹר וְגַם יָחוֹן׃</tei:l> <tei:l>יֶאֱסוֹף עֲדַת מִי־מָנָה ·</tei:l> <tei:l>לְקִרְיָה נֶאֱמָנָה ·</tei:l> <tei:l>וּכְעֵדֶר בְּתוֹךְ הַדִּבְרוֹ מֵאָדָם תְּהוּמֶנָה׃</tei:l> <tei:l>שְׁבוּיִים יִמָּלֵט ·</tei:l> <tei:l>מֵאַנְשְׁמֵי עֲלָט ·</tei:l> <tei:l>עֲדֵי־עַד יְסוֹבְבֵם עֻז רָנֵּי פַלֵּט׃</tei:l> <tei:l>וּבְשׁוּבָה וְנַחַת ·</tei:l> <tei:l>יִוָּשְׁעוּ מִשַּׁחַת ·</tei:l> <tei:l>בַּקֵּשׁ צֹאן אוֹבְדוֹת וְגַם הַנִּדַּחַת׃</tei:l> <tei:l>רְפָאוֹת הַנַּחֲלָה ·</tei:l> <tei:l>יָסִיר כָּל־מַחֲלָה ·</tei:l> <tei:l>צֹאן אָדָם לְמַלֹּאות עִיר הַמְהֻלָּלָה׃</tei:l> <tei:l>תַּחֲבוֹשׁ הַנִּשְׁבֶּרֶת ·</tei:l> <tei:l>דַּלֵּל הַגַּבֶּרֶת ·</tei:l> <tei:l>קַנֵּא קִנְאָה גְדוֹלָה לְעִיר־הַמְחֻבֶּרֶת׃</tei:l> </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
