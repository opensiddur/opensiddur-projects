      <tei:div corresp="urn:x-opensiddur:text:poem:elekhah_veashuvah_el_ishi_harishon">
        <tei:pb n="120" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n241_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אֵלְכָה וְאָשׁוּבָה אֶל־אִישִׁי הָרִאשׁוֹן ·</tei:l> <tei:l>אֲשֶׁר מֵאָז נְצָרַנִי כְּאִישׁוֹן ·</tei:l> <tei:l>בָּחוּר בֶּאֱרֵים תְּהִלָּתוֹ בְּכָל־לָשׁוֹן ·</tei:l> <tei:l>בְּהַזְכִּירֵיהוּ אֵינֶנּוּ מַנִּיחַ־לִי לִישׁוֹן׃</tei:l> <tei:l>גְּאָלַנִי בִזְרוֹעַ מִבֵּין קְדֵשִׁים ·</tei:l> <tei:l>גַּם כְּלָלַנִי־יוֹפִי וְכֵלִים חֲדָשִׁים ·</tei:l> <tei:l>הִדְבִּירַנִי עַל־פִּי קְדוֹשִׁים ·</tei:l> <tei:l>הִדְבִּיקַנִי אֶצְלוֹ בִּכְתֻבָּה וְקִדּוּשִׁים׃</tei:l> <tei:l>הִרְבָּה מֹהַר וּמַתָּנָה וְקִנְיָן הִגְדִּיל הַשִּׂמְחָה בְּכָל עִנְיָן ·</tei:l> <tei:l>וְסִיד וְכִיד בֵּית חֲתָנוּת בִּנְיָן ·</tei:l> <tei:l>וּמָסַר לְשָׁרְתַנִי עֲלָמוֹת אֵין־מִנְיָן׃</tei:l> <tei:l>זֶבַח הֵכִין שִׁלֵּם נְדָרָיו ·</tei:l> <tei:l>זְבָדַנִי זְבַד־טוֹב בַּחֲדָרָיו ·</tei:l> <tei:l>חֲצֵרוֹת <tei:pb n="121" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n243_medium.jpg"/>קְטוֹרוֹת תִּכּוֹן סְדָרָיו ·</tei:l> <tei:l>חֲתָנִי־הַמֶּלֶךְ הֱבִיאַנִי חֲדָרָיו׃</tei:l> <tei:l>טָבַלְתִּי וּבָאתִי בַּעֲדִי עֲדָיִים ·</tei:l> <tei:l>טַהֲרוֹתַי נָתְנוּ רֵיחַ הַדּוּדָאִים ·</tei:l> <tei:l>יְצוּעִי עָלָה וְלָן בֵּין שָׁדָיִם ·</tei:l> <tei:l>יְמִינוֹ חִבְּקַנִי חִבּוּק־יָדָיִם׃</tei:l> <tei:l>כִּמְעַט רֶגַע אֵירַע דָּבָר ·</tei:l> <tei:l>כְּבוֹד הֵמִיר וְחוֹק־חַק שִׁבַּר ·</tei:l> <tei:l>לָכְתִּי דֶרֶךְ בְּרוּחַ וְלֹא לְהָבַר ·</tei:l> <tei:l>לִצְנַיִי וְיָצָאתִי וְדוֹדִי חָמַק עָבָר׃</tei:l> <tei:l>מֵעַי הָמוּ לְדוֹדִי קַנֵּנִי ·</tei:l> <tei:l>מַה־לִידִידִי בִּטֵּל אֲשֶׁר הִתְנַנִי ·</tei:l> <tei:l>נָסַע מֵעָלַי וְלֹא חָנַנִי ·</tei:l> <tei:l>נָאם בִּקַּשְׁתִּיו וְלֹא־מְצָאתִיו קְרָאתִיו וְלֹא־עָנָנִי׃</tei:l> <tei:l>סוּרָה אֲדוֹנִי סוּרָה חֲנַנְתִּיו כַּמָּה ·</tei:l> <tei:l>סָב וְלֹא־פָנָה הוֹחַלְתִּי עַד־מָה ·</tei:l> <tei:l>עָלַי לִבִּי כַּכִּנּוֹר יֶהֱמֶה ·</tei:l> <tei:l>עֵינִי נִגְּרָה וְלֹא־דָמָה׃</tei:l> <tei:l>פִּקְפֵּק בְּכָבוֹד לְמוֹרַד עֲנִיוּת ·</tei:l> <tei:l>פִּתְחֵי נִדָּה שָׂם נְקִיּוּת ·</tei:l> <tei:l>צָנוֹף צְנָפַנִי כַּדּוּר דְּחִיּוּת ·</tei:l> <tei:l>צְרוּרָה צְעוּרָה אַלְמְנוּת חַיּוּת׃</tei:l> <tei:l>קַוֵּה קִוִּיתִי יְיָ יוֹם־נֶחָמָה ·</tei:l> <tei:l>קָרֵב נְטוּשָׁה בְּאַף וּבְחֵמָה ·</tei:l> <tei:l>רִשְׁפֵי־אֵשׁ הִיוּ־לָהּ לְחוֹמָה ·</tei:l> <tei:l>רַחֵם תְּרַחֵם אֶת־לֹא־רֻחָמָה׃</tei:l> <tei:l>שׁוּבִי שׁוּבִי הַשּׁוּלַמִּית מִבֵּין שׁוֹסָיִךְ ·</tei:l> <tei:l>שׁוּבִי וְנֶחֱזֶה בָּךְ יֹאמַר עוֹשָׂיִךְ ·</tei:l> <tei:l>תִּקְעִי כַף מִלְּבָנוֹן רָצִיתִי מַעֲשָׂיִךְ ·</tei:l> <tei:l>תְּעוֹרֵר אַהֲבָתֵךְ כִּי־בוֹעֲלֵיךְ עֹשָׂיִךְ׃</tei:l> <tei:l>יָדוֹעַ תֵּדַע פְּנֵי צֹאנֶךָ ·</tei:l> <tei:l>צִיּוֹן מִכְלַל־יוֹפִי הֵטִיבָה בִרְצוֹנֶךָ ·</tei:l> <tei:l>חֲסִידֶיךָ רַנֵּן יְרַנְּנוּ צִדְקוֹת פִּרְזוֹנֶךָ ·</tei:l> <tei:l>קוֹלִי שָׁמַעְתָּ אַל־תַּעְלֵם אָזְנֶךָ׃</tei:l> </tei:lg>
      </tei:div>
    </tei:body>
