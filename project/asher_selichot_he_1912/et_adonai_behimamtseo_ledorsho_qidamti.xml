      <tei:div corresp="urn:x-opensiddur:text:poem:et_adonai_behimamtseo_ledorsho_qidamti">
        <tei:pb n="93" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n187_medium.jpg"/>
        <tei:lg><tei:l>אֶת־יְיָ בְּהִמָּצְאוֹ לְדָרְשׁוֹ קִדַּמְתִּי ·</tei:l> <tei:l>בְּעַד עֲוֹנוֹת לְכַפֵּר כִּי בְתוֹלָע נָאֳדַמְתִּי ·</tei:l> <tei:l>נִגְלֵי־הַלֵּב טוּמְטָם וּכְיָשֵׁן נִרְדַּמְתִּי ·</tei:l> <tei:l>כִּמְעַט כִּסְדוֹם הָיִיתִי וְלַעֲמוֹרָה דָמִיתִי׃</tei:l> <tei:l>דָּמִיתִי לְסוֹטָה פְּרוּעָה מְנָאֶפֶת וּתְלֵלָה ·</tei:l> <tei:l>הָיִיתִי כְבֶגֶד־עִדִּים וְהָשְׁמִיתִי כְּשִׂמְלָה דָּמִים מְגֹלָלָה ·</tei:l> <tei:l>וְחָסַרְתִּי מַפְגִּיעַ וְיוֹדֵעַ אֵין לְפַלְלָה ·</tei:l> <tei:l>רְאֵה יְיָ וְהַבִּיטָה כִּי־הָיִיתִי זוֹלֵלָה׃</tei:l> <tei:l>זוֹלֵלָה כְבוּדָה נֶהֶפְכָה בְיַד־מְנָאֵל ·</tei:l> <tei:l>חִנָּם נִמְכְּרָה לִצְמִיתֻת וְאֵין־גּוֹאֵל ·</tei:l> <tei:l>מַטָּע נָכוֹן וְנִשָּׂא חָרַב אֲרִיאֵל הֻשְׁלַךְ מִשָּׁמַיִם אֶרֶץ תִּפְאֶרֶת־יִשְׂרָאֵל׃</tei:l> <tei:l>יִשְׂרָאֵל לָבּוֹזְזִים וְלִמְשִׁסָּה עַד־מָתָי ·</tei:l> <tei:l>כָּאַרְבֶּה רַבּוּ עוֹרְקַי וְעָצְמוּ מְצַמְּתַי ·</tei:l> <tei:l>לַלֵּב בְּשׂוּמִי הֲרִיסוֹת חֻרְבּוֹתַי <tei:pb n="94" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n189_medium.jpg"/>וְשׁוֹמְמוֹתַי ·</tei:l> <tei:l>וְתִבְחַר מַחֲנָק נַפְשִׁי מָוֶת מֵעַצְמוֹתַי׃</tei:l> <tei:l>מֵעַצְמוֹתַי הַמְפֻצָּצוֹת וְהַמְפֻלָּחוֹת מִמַּכְעִיסֶיךָ וּמַנְאִיצֶיךָ ·</tei:l> <tei:l>נָאַמְתִּי נִלְאֵיתִי נְשֹׂא חֲרוֹנְךָ וְזַעְמֶךָ ·</tei:l> <tei:l>שִׂים לֵב לִגְאֹל חַיַּת נְעִימֶיךָ ·</tei:l> <tei:l>כִּי שִׁמְךָ נִקְרָא עַל־עִירְךָ וְעַל־עַמֶּךָ׃</tei:l> <tei:l>עַמְּךָ זְרוּיִם פּוּזָרִים בְּכָל־מַשְׁבוֹת ·</tei:l> <tei:l>פָּקְדּוּךָ בְצַר פְּחָדוּךָ בְּמַעַשׂ וּבְמַחֲשָׁבוֹת ·</tei:l> <tei:l>צְלֹל־זָדוֹן הַעֲבֵר וּרְפָא מְשׁוּבוֹת ·</tei:l> <tei:l>אֲדֹנָי שִׁמְעָה בְקוֹלֵנוּ תִּהְיֶינָה אָזְנֶיךָ קַשֻּׁבוֹת׃</tei:l> <tei:l>קַשֻּׁבוֹת תִּהְיֶינָה אָזְנְךָ לְשֶׁפֶךְ שִׂיחֵנוּ ·</tei:l> <tei:l>רֵיחַ־שְׁפָרָה קַבֵּל כְּרֵיחַ נִיחֹחֵנוּ שִׁחַרְנוּךָ מָגִנֵּנוּ וּבְךָ מִבְטַחֵנוּ ·</tei:l> <tei:l>וְשִׁמְךָ עָלֵינוּ נִקְרָא אַל־תַּנִּיחֵנוּ׃</tei:l> <tei:l>הִנַּחְתָּנוּ אָדוֹן זֶה כַמֶּה־שָׁנִים ·</tei:l> <tei:l>לַמָּה לְשַׁמָּה לְמָשָׁל וְלִשְׁנִינָה לְלַעַג וְלִכְלִמָּה ·</tei:l> <tei:l>יֵאָמֵן וְיוּחַשׁ הַמֻּבְטָח שֶׁהֻבְטַחְתָּ לַשּׁוֹמֵמָה ·</tei:l> <tei:l>אֲנִי יְיָ בָּנִיתִי הַנֶּהֱרָסוֹת נָטַעְתִּי הַנְּשַׁמָּה׃</tei:l> <tei:l>בְּרַחֲמִים גְּדוֹלִים תִּבָּנֶה וְתִכּוֹנְנָה ·</tei:l> <tei:l>שְׁמַע יָהּ תַּחֲנוּנָהּ כִּי־בָא עֵת לְחֶנְנָהּ ·</tei:l> <tei:l>חַזֵּק מַאֲמִירֶךָ בְּצֵל־יָדְךָ לְגוֹנְנָהּ ·</tei:l> <tei:l>וּפְדוּיֵי יְיָ יְשׁוּבוּן וּבָאוּ לְצִיּוֹן בְּרִנָּה׃</tei:l> </tei:lg>
      </tei:div>
    </tei:body>
