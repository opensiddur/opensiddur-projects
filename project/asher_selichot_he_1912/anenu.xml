      <tei:div corresp="urn:x-opensiddur:text:prayer:anenu">
        <tei:pb n="21" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n43_medium.jpg"/>
        <tei:lg><tei:l>עֲנֵנוּ יְיָ <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ אֱלֹהֵינוּ <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ אָבִינוּ <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ בּוֹרְאֵנוּ <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ גוֹאֲלֵנוּ <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ דוֹרְשֵׁנוּ <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ הָאֵל הַנֶּאֱמָן <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ וָתִיק וְחָסִיד <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ זַךְ וְיָשָׁר <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ חַי וְקַיָּם <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ טוֹב וּמֵטִיב <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ יוֹדֵעַ יִצְרֵי <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ כוֹבֵשׁ כְּעָסִים <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ לוֹבֵשׁ צְדָקוֹת <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ מֶלֶךְ מַלְכֵי הַמְּלָכִים <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ נוֹרָא וְנִשְׂגָּב <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ סוֹלֵחַ וּמוֹחֵל <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ עוֹנֶה בְעֵת רָצוֹן <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ פּוֹדֶה וּמַצִּיל <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ צַדִּיק וְיָשָׁר <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ קָשֶׁה לִכְעוֹס <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ רַחוּם וְחַנּוּן <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ שׁוֹמֵעַ אֶל־אֶבְיוֹנִים <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ תוֹמֵךְ תְּמִימִים <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ אֱלֹהֵי אֲבוֹתֵינוּ <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ אֱלֹהֵי אַבְרָהָם <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ פַּחַד יִצְחָק <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ אֲבִיר יַעֲקֹב <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ עֶזְרַת הַשְּׁבָטִים <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ מִשְׂגַּב אִמָּהוֹת <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ קָרוֹב לְקוֹרְאָיו <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ רַךְ לִרְצוֹת <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ עוֹנֶה בְּעֵת צָרָה <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ אֲבִי יְתוֹמִים <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> <tei:l>עֲנֵנוּ דַּיַּן אַלְמָנוֹת <tei:seg type="refrain">עֲנֵנוּ׃</tei:seg></tei:l> </tei:lg>
      </tei:div>
    </tei:body>
