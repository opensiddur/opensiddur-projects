      <tei:div corresp="urn:x-opensiddur:text:poem:shaarei_shamayim_belulei_esh_umayim">
        <tei:pb n="115" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n231_medium.jpg"/>
        <tei:lg><tei:l>שַׁעֲרֵי שָׁמַיִם ·</tei:l> <tei:l>בְּלוּלֵי אֵשׁ וּמַיִם ·</tei:l> <tei:l>שְׁלֹשׁ מֵאוֹת וְתִשְׁעִים כְּמִנְיַן שָׁמַיִם ·</tei:l> <tei:l>הִפָּתְחוּ לְחִנּוּן יָפַת פַּעֲמַיִם ·</tei:l> <tei:l><tei:seg type="refrain">וְתַעַל תְּפִלָּתָם אֶל־הַשָּׁמַיִם׃</tei:seg></tei:l> <tei:l>שַׁעֲרֵי רָקִיעַ בּוֹ מְאוֹרוֹת הוּתְקְעוּ ·</tei:l> <tei:l>וּמִמֶּנּוּ זוֹרְחִים בִּמְקוֹמָם לְהִשָּׁקֵעַ ·</tei:l> <tei:l>הִפָּתְחוּ לְחִנּוּן יָם־לָמוֹ הֻבְקַע ·</tei:l> <tei:l><tei:seg type="refrain">וְתַעַל תְּפִלָּתָם פְּנֵי מַעֲבִיב רָקִיעַ׃</tei:seg></tei:l> <tei:l>שַׁעֲרֵי זְבוּל ·</tei:l> <tei:l>שָׁבוֹ מִזְבֵּחַ סָבוּל ·</tei:l> <tei:l>וְהַשַּׂר מַקְטִיר־עָלָיו כְּמִכְהָן בְּכַרְבּוּל ·</tei:l> <tei:l>הִפָּתְחוּ לְחִנּוּן נִדְחָקִים לַחֲבוֹל ·</tei:l> <tei:l><tei:seg type="refrain">וְתַעַל תְּפִלָּתָם פְּנֵי יֹשֵׁב לַמַּבּוּל׃</tei:seg></tei:l> <tei:l>שַׁעֲרֵי וִילוֹן ·</tei:l> <tei:l>נִכְנָס וְיוֹצֵא בְּגִלָּיוֹן ·</tei:l> <tei:l>וּמִתְחַדֵּשׁ בְּכָל־יוֹם מִפִּתְחֵי־חַלּוֹן ·</tei:l> <tei:l>הִפָּתְחוּ לְחִנּוּן מַצַּבְתָּה בְּאַלּוֹן ·</tei:l> <tei:l><tei:seg type="refrain">וְתַעַל תְּפִלָּתָם פְּנֵי דָר רוּם וִילוֹן׃</tei:seg></tei:l> <tei:l>שַׁעֲרֵי שְׁחָקִים ·</tei:l> <tei:l>שָׁבוֹ רֵחַיִם שׁוֹחֲקִים ·</tei:l> <tei:l>עוֹמְדוֹת וּמוֹתְנוֹת מָן לַצַּדִּיקִים ·</tei:l> <tei:l>הִפָּתְחוּ לְחִנּוּן זְרוּיִם בַּמֶּרְחַקִּים ·</tei:l> <tei:l><tei:seg type="refrain">וְתַעַל תְּפִלָּתָם פְּנֵי מַעֲבִיב שְׁחָקִים׃</tei:seg></tei:l> <tei:l>שַׁעֲרֵי מָכוֹן ·</tei:l> <tei:l>שָׁבוֹ שְׁלָגִים יִכּוֹנוּ וּמַעֲרַת קִיטוֹר וְסַעַר בּוֹ יִשְׁכּוֹן ·</tei:l> <tei:l>הִפָּתְחוּ לְחִנּוּן עַם לִבּוֹ יִכּוֹן ·</tei:l> <tei:l><tei:seg type="refrain">וְתַעַל תְּפִלָּתָם פְּנֵי דָר רוּם מָכוֹן׃</tei:seg></tei:l> <tei:l>שַׁעֲרֵי מָעוֹן בּוֹ מְשׁוֹרְרִים יִשְׁאוּן ·</tei:l> <tei:l>וּבַיּוֹם הֵם חָשִׁים לְסַבֵּל יִשְׁמָעוּן ·</tei:l> <tei:l>הִפָּתְחוּ לְחִנּוּן לַמְּרוֹרִים לַלַּעֲוֹן ·</tei:l> <tei:l><tei:seg type="refrain">וְתַעַל תְּפִלָּתָם פְּנֵי דָר רוּם מָעוֹן׃</tei:seg></tei:l> <tei:l>שַׁעֲרֵי עֲרָבוֹת ·</tei:l> <tei:l>בּוֹ בְּרָכוֹת רַבּוֹת ·</tei:l> <tei:l>וְגִנְזֵי צְדָקָה וָחֶסֶד וְכָל־טוֹבוֹת ·</tei:l> <tei:l>הִפָּתְחוּ לְחִנּוּן בְּנֵי שְׁלֹשֶׁת אָבוֹת ·</tei:l> <tei:l><tei:seg type="refrain">וְתַעַל תְּפִלָּתָם פְּנֵי רוֹכֵב עֲרָבוֹת׃</tei:seg></tei:l> </tei:lg>
      </tei:div>
    </tei:body>
