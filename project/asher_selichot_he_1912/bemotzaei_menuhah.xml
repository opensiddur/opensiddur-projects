    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:bemotzaei_menuhah">
        <tei:pb n="15" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n31_medium.jpg"/>
        <tei:head>פזמון</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bemotzaei_menuhah/rubric"/>
        <j:conditional xml:id="refrain_instruction">
          <tei:fs type="asher:expansions">
            <tei:f name="refrains_present">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
        <tei:note type="instruction" xml:lang="en">Wherever the word <tei:foreign xml:lang="he">לשמוע</tei:foreign> occurs at the end of the verse, repeat from <tei:foreign xml:lang="he">לִשְׁמֹעַ</tei:foreign> till <tei:foreign xml:lang="he">וְאֶל־הַתְּפִלָּה</tei:foreign>.</tei:note>
        <j:endConditional target="#refrain_instruction"/>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bemotzaei_menuhah/1"/>
        <tei:lg>
          <tei:l>בְּמוֹצָאֵי מְנוּחָה קִדַּמְנוּךָ תְּחִלָּה ·</tei:l>
          <tei:l>הַט אָזְנְךָ מִמָּרוֹם יוֹשֵׁב תְּהִלָּה ·</tei:l>
          <tei:l>לִשְׁמֹעַ אֶל־הָרִנָּה וְאֶל־הַתְּפִלָּה :</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bemotzaei_menuhah/2"/>
        <tei:lg>
          <tei:l>אֶת־יְמִין עֹז עוֹרְרָה לַעֲשׂוֹת חָיִל ·</tei:l>
          <tei:l>בְּצֶדֶק נֶעֱקַד וְנִשְׁחַט תְּמוּרוֹ אַיִל ·</tei:l>
          <tei:l>גְּנוֹן־נָא גִזְעוֹ בְּזַעֲקָם בְּעוֹד לָיִל :</tei:l>
          <tei:l>
            <tei:choice>
              <tei:abbr>לשמוע</tei:abbr>
              <tei:expan>לִשְׁמֹעַ אֶל־הָרִנָּה וְאֶל־הַתְּפִלָּה :</tei:expan>
            </tei:choice>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bemotzaei_menuhah/3"/>
        <tei:lg>
          <tei:l>דְּרוֹשׁ־נָא דוֹרְשֶׁיךָ בְּדָרְשָׁם פָּנֶיךָ ·</tei:l>
          <tei:l>הִדָּרֶשׁ לָמוֹ מִשְּׁמֵי מְעוֹנֶךָ ·</tei:l>
          <tei:l>וְלִשְׁוָעַת חִנּוּנָם אַל־תַּעְלֵם אָזְנֶךָ :</tei:l>
          <tei:l>
            <tei:choice>
              <tei:abbr>לשמוע</tei:abbr>
              <tei:expan>לִשְׁמֹעַ אֶל־הָרִנָּה וְאֶל־הַתְּפִלָּה :</tei:expan>
            </tei:choice>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bemotzaei_menuhah/4"/>
        <tei:lg>
          <tei:l>זוֹחֲלִים וְרוֹעֲדִים מִיּוֹם בּוֹאֶךָ ·</tei:l>
          <tei:l>חָלִים כְּמַבְכִּירָה מֵעֶבְרַת מַשָּׂאֶךָ ·</tei:l>
          <tei:l>טִנּוּפָם מְחֵה־נָא וְיוֹדוּ פְלָאֶיךָ :</tei:l>
          <tei:l>
            <tei:choice>
              <tei:abbr>לשמוע</tei:abbr>
              <tei:expan>לִשְׁמֹעַ אֶל־הָרִנָּה וְאֶל־הַתְּפִלָּה :</tei:expan>
            </tei:choice>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bemotzaei_menuhah/5"/>
        <tei:lg>
          <tei:l>יוֹצֵר אַתָּה לְכָל־יְצִיר נוֹצָר ·</tei:l>
          <tei:l>כּוֹנַנְתָּ מֵאָז תֶּרֶף לְחַלְּצָם מִמֵּעָצָר ·</tei:l>
          <tei:l>לְחוֹנְנָם חִנָּם מֵאוֹצָר הַמְנֻצָּר :</tei:l>
          <tei:l>
            <tei:choice>
              <tei:abbr>לשמוע</tei:abbr>
              <tei:expan>לִשְׁמֹעַ אֶל־הָרִנָּה וְאֶל־הַתְּפִלָּה :</tei:expan>
            </tei:choice>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bemotzaei_menuhah/6"/>
        <tei:lg>
          <tei:l>מָרוֹם אִם־עָצְמוּ פִּשְׁעֵי קְהָלָךְ ·</tei:l>
          <tei:l>נָא שַׂגְּבֵם מֵאוֹצָר הַמּוּכָן בִּזְבוּלֶיךָ ·</tei:l>
          <tei:l>עָדֶיךָ לָחוֹן חִנָּם בָּאִים אֵלֶיךָ :</tei:l>
          <tei:l>
            <tei:choice>
              <tei:abbr>לשמוע</tei:abbr>
              <tei:expan>לִשְׁמֹעַ אֶל־הָרִנָּה וְאֶל־הַתְּפִלָּה :</tei:expan>
            </tei:choice>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bemotzaei_menuhah/7"/>
        <tei:lg>
          <tei:l>פְּנֵה־נָא אֶל־הַתְּלָאוֹת וְאַל־לַחֲטָאוֹת ·</tei:l>
          <tei:l>צַדֵּק צוֹעֲקֶיךָ מַפְלִיא פְלָאוֹת ·</tei:l>
          <tei:l>קְשׁוֹב־נָא חִנּוּנָם אֱלֹהִים יְיָ צְבָאוֹת :</tei:l>
          <tei:l>
            <tei:choice>
              <tei:abbr>לשמוע</tei:abbr>
              <tei:expan>לִשְׁמֹעַ אֶל־הָרִנָּה וְאֶל־הַתְּפִלָּה :</tei:expan>
            </tei:choice>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bemotzaei_menuhah/8"/>
        <tei:lg>
          <tei:l>רְצֵה עֲתִירָתָם בְּעָמְדָם בַּלֵּילוֹת ·</tei:l>
          <tei:l>שְׁעֵה בְרָצוֹן בְּקָרְבָּן כָּלִיל וְעוֹלוֹת ·</tei:l>
          <tei:l>תִּרְאֵם נִסֶּיךָ עֹשֵׂה גְדוֹלוֹת :</tei:l>
          <tei:l>לִשְׁמֹעַ אֶל־הָרִנָּה וְאֶל־הַתְּפִלָּה :</tei:l>
          <tei:l>
            <tei:choice>
              <tei:abbr>במוצאי וכו׳</tei:abbr>
              <tei:expan>בְּמוֹצָאֵי מְנוּחָה קִדַּמְנוּךָ תְּחִלָּה · הַט אָזְנְךָ מִמָּרוֹם יוֹשֵׁב תְּהִלָּה · לִשְׁמֹעַ אֶל־הָרִנָּה וְאֶל־הַתְּפִלָּה :</tei:expan>
            </tei:choice>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bemotzaei_menuhah/conclusion"/>
        <j:conditional xml:id="prayer_instruction">
          <tei:fs type="asher:expansions">
            <tei:f name="prayers_present">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
        <tei:note type="instruction" xml:lang="en">Say <tei:foreign xml:lang="he">אֵל מֶלֶךְ</tei:foreign> and <tei:foreign xml:lang="he">וַיַּעֲבֹר</tei:foreign></tei:note>
        <j:endConditional target="#prayer_instruction"/>
      </tei:div>
    </tei:body>
  </tei:text>
