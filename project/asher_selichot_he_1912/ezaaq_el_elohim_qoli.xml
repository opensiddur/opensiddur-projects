      <tei:div corresp="urn:x-opensiddur:text:poem:ezaaq_el_elohim_qoli">
        <tei:pb n="122" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n245_medium.jpg"/>
        <tei:lg><tei:l>אֶזְעַק אֶל־אֱלֹהִים קוֹלִי ·</tei:l> <tei:l>בֹּקֶר אֶעֱרָךְ־לְךָ בְּעַד־קְהָלִי ·</tei:l> <tei:l>יְיָ צוּרִי וְגֹאֲלִי׃</tei:l> <tei:l>גַּשְׁנוּ בְתַחֲנוּן וּבִתְפִלָּה ·</tei:l> <tei:l>דְּלָתְךָ שָׁקַדְנוּ רַב עֲלִילָה ·</tei:l> <tei:l>הָסֵר מֵעָלֵינוּ נֶגַע וּמַחֲלָה׃</tei:l> <tei:l>הַמְצֵא־לָנוּ סְלִיחוֹת ·</tei:l> <tei:l>וְהַעֲבֵר רָעָה מִנַּפְשׁוֹת הָאֲנָחוֹת ·</tei:l> <tei:l>אֵל אֱלֹהֵי הָרוּחוֹת׃</tei:l> <tei:l>זַעֲקָתֵינוּ־לְךָ בְּעָנְיֵנוּ וּתְלָאָה ·</tei:l> <tei:l>חַיָּתִי פְדֵה נָא מִשַּׁחַת וּשְׁאוֹלָה ·</tei:l> <tei:l>קָרְבָה אֶל־נַפְשִׁי גְאָלָהּ׃</tei:l> <tei:l>טוֹב מִבֶּטֶן גּוֹחִי ·</tei:l> <tei:l>יוֹצְרִי וְסִבְרִי וּמִבְטַחִי ·</tei:l> <tei:l>בְּיָדְךָ אַפְקִיד רוּחִי׃</tei:l> <tei:l>כְּבוֹשׁ־כַּעַסְךָ מִידִידֶךָ ·</tei:l> <tei:l>לִרְאוֹת־שַׁחַת אַל־תִּתֵּן חֲסִידֶךָ ·</tei:l> <tei:l>עֲנֵנִי יְיָ כִּי־טוֹב חַסְדֶּךָ׃</tei:l> <tei:l>מַכֵּה בְּלִי־תְרוּפָה ·</tei:l> <tei:l>נִצָּה לְחוֹרְפֶיךָ תִּשְׁלַח בְהַקְצָפָה ·</tei:l> <tei:l>וּבְעַמְּךָ לֹא לְמַגֵּפָה׃</tei:l> <tei:l>סִגַּפְנוּ בַּיּוֹם זֶה ·</tei:l> <tei:l>עַנּוּתֵינוּ לֹא־תְשַׁקֵּץ וְלֹא־תִבְזֶה ·</tei:l> <tei:l>סְלַח־נָא לַעֲוֹן הָעָם הַזֶּה׃</tei:l> <tei:l>פָּשַׁעְנוּ וּמָעַלְנוּ ·</tei:l> <tei:l>צוּר לְךָ חֲבוֹל חָבַלְנוּ ·</tei:l> <tei:l>לָכֵן כָּלִינוּ בְאַפֶּךָ וּבַחֲמָתְךָ נִבְהָלְנוּ׃</tei:l> <tei:l>קָדוֹשׁ רִיב אַל־תַּמְתַּח ·</tei:l> <tei:l>רְאֵה כִי־כַפַּי לְךָ אֶשְׁטָח ·</tei:l> <tei:l>יוֹם אִירָא אֲנִי אֵלֶיךָ אֶבְטָח׃</tei:l> <tei:l>שְׁפֹךְ שִׂיחַ עַמֶּךָ ·</tei:l> <tei:l>תָּחוֹן וְתַעַן שְׁלֵימֶךָ ·</tei:l> <tei:l>אַל־תִּנְאַץ לְמַעַן שְׁמֶךָ׃</tei:l> <tei:l>שְׁעֵה שַׁוְעַת אוֹנְנִים ·</tei:l> <tei:l>לְקוֹרְאֶיךָ מֵרוֹחַק הֲפָכַת מְעוֹנִים ·</tei:l> <tei:l>שׁוֹמֵעַ אֶל אֶבְיוֹנִים׃</tei:l> <tei:l>נְדִיבֵי עִם מַטַּע נַעֲמָנִים ·</tei:l> <tei:l>הַחוֹסִים קֹוֶיךָ טְהוֹרֶיךָ נִמְנִים ·</tei:l> <tei:l>מַהֵר תְּרַחֲמֵם כְּרַחֵם אָב עַל־בָּנִים׃</tei:l> </tei:lg>
