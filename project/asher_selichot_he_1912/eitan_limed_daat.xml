      <tei:div corresp="urn:x-opensiddur:text:poem:eitan_limed_daat">
        <tei:pb n="126" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n253_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אֵיתָן לִמֵּד דַּעַת ·</tei:l> <tei:l>טֶרֶם לְכָל מוֹדָעַת ·</tei:l> <tei:l>בָּאֵר שִׁמְךָ לְכָל־בָּאֵי עוֹלָם ·</tei:l> <tei:l>גִּלָּה כָל־סָתוּם וְנֶעְלָם׃</tei:l> <tei:l>גִּלּוּלִים מָאַס וְשִׁבֵּר ·</tei:l> <tei:l>תּוֹעִים לְשִׁמְךָ חִבֵּר ·</tei:l> <tei:l>דֶּרֶךְ מִישׁוֹר בָּחַר ·</tei:l> <tei:l>תּוֹרָה וּמִצְוֹת שָׁמַר וְלֹא אֵחַר׃</tei:l> <tei:l>הִצַּלְתּוֹ מֵאוּר־כַּשְׂדִּים ·</tei:l> <tei:l>גּוֹנַנְתּוֹ בְּעֵמֶק הַשִּׂדִּים ·</tei:l> <tei:l>וִיעַדְתּוֹ שְׂכָרְךָ הַרְבֵּה מְאֹד ·</tei:l> <tei:l>וְהִתְקַפְתּוֹ רוֹב עוֹשֶׁר וְכָבוֹד׃</tei:l> <tei:l>זָעַק וְהֵשִׁיב מַה־תִּתֶּן־לִי ·</tei:l> <tei:l>שׁוֹרֶשׁ וְעָנָף אֵין־לִי ·</tei:l> <tei:l>חִילְתוֹ בִּרְאִית מַחֲזֶה ·</tei:l> <tei:l>בְּשׂוֹרָתוֹ לֹא יִירָשְׁךָ זֶה׃</tei:l> <tei:l>טְנָא בִּכּוּרִים לְמֵאָה חֲנַנְתּוֹ ·</tei:l> <tei:l>לְקָרְבָּן נִיחֹחַ חֲשַׁקְתּוֹ ·</tei:l> <tei:l>יַחְדָּו בִּכְלָל לִבָּם רִצּוּ ·</tei:l> <tei:l>לַעֲשׂוֹת רְצוֹנְךָ רָצוּ׃</tei:l> <tei:l>כָּבַשׁ רַחֲמָיו לַעֲשׂוֹת רְצוֹנְךָ ·</tei:l> <tei:l>כֵּן יִכְבְּשׁוּ רַחֲמֶיךָ אֶת־כַּעַסְךָ מֵעַל־צֹאנֶךָ ·</tei:l> <tei:l>לִבָּם וְנַפְשָׁם הָיָה נָכוֹן ·</tei:l> <tei:l>לָכֵן תְּפִלָּתֵנוּ לְפָנֶיךָ קְטֹרֶת תִּכּוֹן׃</tei:l> <tei:l>מִהֵר וְלָקַח מַאֲכֶלֶת ·</tei:l> <tei:l>לָכֵן תַּצִּיל זַרְעָם מִמִּיתָה מְשֻׁכֶּלֶת ·</tei:l> <tei:l>נֶעֱקַד יְחִידוֹ כְּשֶׂה לַטֶּבַח ·</tei:l> <tei:l>לָכֵן עֲתִירָתֵנוּ תְּרַצֶּה כְּעוֹלָה וָזֶבַח׃</tei:l> <tei:l>סִדֵּר עֵצִים וְהִצִּית עֲלֵיהֶם אֵשׁ ·</tei:l> <tei:l>לָכֵן בַּעֲמִידָתֵנוּ הַיּוֹם לֹא נִתְבּוֹשֵׁשׁ ·</tei:l> <tei:l>עֲנִיתוֹ מִשְּׁמֵי שָׁמַיִם ·</tei:l> <tei:l>לָכֵן נִשְׁבַּעְתָּ־לוֹ בְשִׁמְךָ פַּעֲמָיִם׃</tei:l> <tei:l>פְּדִיתוֹ <tei:pb n="127" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n255_medium.jpg"/>בְּאַיִל בְּסְבַךְ אָחוּז ·</tei:l> <tei:l>לָכֵן בַּקָּשָׁתֵנוּ וְעִנּוּיֵנוּ לֹא־תִבְזוּ ·</tei:l> <tei:l>צַעֲקָתֵנוּ שְׁמַע וְשַׁוְעָתֵנוּ סַכּוֹת ·</tei:l> <tei:l>בִּזְכוּת אָב נָסַע סֻכּוֹת׃</tei:l> <tei:l>קוֹל מְבַשֵּׂר יִשָּׁמַע בָּעוֹלָם ·</tei:l> <tei:l>לִגְאוֹל עַם גֶּזַע גִּבּוֹרֵי עוֹלָם ·</tei:l> <tei:l>רַחֵם קְהַל עֲדַת מְקֻשָּׁטִים ·</tei:l> <tei:l>מִגֶּזַע שְׁנֵים עָשָׂר שְׁבָטִים׃</tei:l> <tei:l>שְׁכִינָתְךָ תַּשְׁכֵּן בְּתוֹכֵנוּ ·</tei:l> <tei:l>תַּנְחֵנוּ לִגְבוּל אַדְמָתֵנוּ ·</tei:l> <tei:l>תֵּפֶן אֵלֵינוּ בְרַחֲמִים ·</tei:l> <tei:l>כִּי כֵן נִקְרָאתָ מָלֵא רַחֲמִים׃</tei:l> </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
