      <tei:div corresp="urn:x-opensiddur:text:poem:atanu_lekhah_yotser_ruhot">
        <tei:pb n="184" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n369_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו אָתָאנוּ־לְךָ יוֹצֵר רוּחוֹת ·</tei:l> <tei:l>בְּרוֹב עֲוֹנֵינוּ כָּבְדוּ אֲנָחוֹת ·</tei:l> <tei:l>גְּזֵרוֹת עָצְמוּ וְרַבּוּ צְרִיחוֹת ·</tei:l> <tei:l>כִּי בְשִׁבְעָה עָשָׂר בְּתַמּוּז נִשְׁתַּבְּרוּ הַלּוּחוֹת׃</tei:l> <tei:l>גָּלִינוּ מִבֵּית הַבְּחִירָה ·</tei:l> <tei:l>וְהָשְׁכַּרָה בַּעֲדֵנוּ אוֹרָה ·</tei:l> <tei:l>דִּינֵנוּ נֶחְתָּם וּגְזֵרָה גְזוּרָה ·</tei:l> <tei:l>כִּי בְשִׁבְעָה עָשָׂר בְּתַמּוּז נִשְׂרְפָה הַתּוֹרָה׃</tei:l> <tei:l>הָרְסוּ אוֹיְבֵינוּ אֶת־הַהֵיכָל ·</tei:l> <tei:l>וּבָרְחָה שְׁכִינָה מִזָּוִיוֹת הֵיכָל ·</tei:l> <tei:l>וְנִמְסַרְנוּ בְּיַד זָדִים לְהִתְאַכֵּל ·</tei:l> <tei:l>כִּי בְשִׁבְעָה עָשָׂר בְּתַמּוּז הָעֳמַד צֶלֶם בַּהֵיכָל׃</tei:l> <tei:l>זָרַנוּ מֵעִיר אֶל־עִיר ·</tei:l> <tei:l>וְנִלְכַּד מִמֶּנּוּ רַב וְצָעִיר ·</tei:l> <tei:l>חָרְבָה עִירֵנוּ וְאֵשׁ בָּהּ הִבְעִיר ·</tei:l> <tei:l>כִּי בְשִׁבְעָה עָשָׂר בְּתַמּוּז נִבְקְעָה הָעִיר׃</tei:l> <tei:l>טִפֵּשׁ בְּמִקְדָּשֵׁנוּ צַר הַמַּשְׁמִיד ·</tei:l> <tei:l>וְנִטַּל מֵחָתָן וְכַלָּה אֶצְעָדָה וְצָמִיד ·</tei:l> <tei:l>יַעַן בְּכַעֲסוֹךָ נִתַּנּוּ לְהַשְׁמִיד ·</tei:l> <tei:l>כִּי בְשִׁבְעָה עָשָׂר בְּתַמּוּז בָּטֵל הַתָּמִיד׃</tei:l> <tei:l>כָּלָה מִמֶּנּוּ הוֹד וְשֶׁבַח ·</tei:l> <tei:l>חַרְבּוֹ שָׁלַף אוֹיֵב עָלֵינוּ לִזְבֹּחַ ·</tei:l> <tei:l>לִהְיוֹת עוֹלְלִים וְיוֹנְקִים מוּכָנִים לְטֶבַח ·</tei:l> <tei:l>כִּי בְשִׁבְעָה עָשָׂר בְּתַמּוּז נִבְטְלוּ עוֹלָה וָזָבַח׃</tei:l> <tei:l>מָרַדְנוּ לְשׁוֹכֵן מְעוֹנוֹת ·</tei:l> <tei:l>לָכֵן נִתְפַּזַּרְנוּ בְּכָל־פִּנּוֹת ·</tei:l> <tei:l>נֶהְפַּךְ מְחוֹלֵנוּ לְקִינוֹת ·</tei:l> <tei:l>כִּי <tei:pb n="185" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n371_medium.jpg"/>בְשִׁבְעָה עָשָׂר בְּתַמּוּז נִגְרְמוּ לָנוּ עֲוֹנוֹת׃</tei:l> <tei:l>סָרַרְנוּ לְפָנֶיךָ מֵרִיב לְשׁוֹנוֹת ·</tei:l> <tei:l>לָכֵן לִמְּדוּ לְשׁוֹנֵנוּ לוֹמַר קִינוֹת ·</tei:l> <tei:l>עֲוֹנֵינוּ בְּלִי לְהִמָּנוֹת ·</tei:l> <tei:l>כִּי בְשִׁבְעָה עָשָׂר בְּתַמּוּז נִבְטְלוּ הַקָּרְבָּנוֹת׃</tei:l> <tei:l>פֻּזַּרְנוּ בְּלִי מְצֹא רְוָחָה ·</tei:l> <tei:l>וְעַל־כֵּן רָבְתָה בָּנוּ יָגוֹן וַאֲנָחָה ·</tei:l> <tei:l>צוּר רְאֵה נַפְשֵׁנוּ כִּי־שָׁחָה ·</tei:l> <tei:l>וְשִׁבְעָה עָשָׂר בְּתַמּוּז הֲפוֹךְ לָנוּ לְשָׂשׂוֹן וּלְשִׂמְחָה׃</tei:l> <tei:l>קָשִׁינוּ עֹרֶף וְרָבְתָה עָלֵינוּ אָסוֹן ·</tei:l> <tei:l>וְלָכֵן נִתַּנּוּ לְבִזָּה וְלִרְפָסוֹן ·</tei:l> <tei:l>רְאֵה יְיָ וְחַלְּצֵנוּ מֵאָסוֹן ·</tei:l> <tei:l>וְשִׁבְעָה עָשָׂר בְּתַמּוּז הֲפוֹךְ לָנוּ לְשִׂמְחָה וּלְשָׂשׂוֹן׃</tei:l> <tei:l>שְׁעֵנוּ בְּשִׁמְךָ שׁוֹכֵן רוּמָה ·</tei:l> <tei:l>קַבֵּץ נְפוּצוֹתֵינוּ מֵאַרְבַּע פִּנּוֹת אֲדָמָה ·</tei:l> <tei:l>תּוֹסִיף יָדְךָ שֵׁנִית לִקְנוֹת אֲיוּמָה ·</tei:l> <tei:l>וְשִׁבְעָה עָשָׂר בְּתַמּוּז הֲפוֹךְ לָנוּ לְיוֹם יְשׁוּעָה וְנֶחָמָה׃</tei:l> </tei:lg>
      </tei:div>
