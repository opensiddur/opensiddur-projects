      <tei:div corresp="urn:x-opensiddur:text:poem:teshuvah_hashuvah_qedumah_meaz_lehetiv">
        <tei:pb n="144" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n289_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>תְּשׁוּבָה חֲשׁוּבָה קְדוּמָה מֵאָז לְהָטוֹב ·</tei:l> <tei:l>שׁוּבָה יִשְׂרָאֵל עַד־יְיָ מִלִּקְטוֹב׃</tei:l> <tei:l>רָשָׁע יַעֲזוֹב דַּרְכּוֹ כְּשׁוֹשַׁנָּה לִרְטוֹב ·</tei:l> <tei:l>קְצִיעוֹת בְּגָדֶתֶיךָ תַּחֲלִיף וְקַח טוֹב׃</tei:l> <tei:l>צָרוֹר הַמֹּר תָּמִיד בְּטוֹב לִסְחוֹר פְּשׁוּטָה יְמִינוֹ שְׁלוּחָה מִן הַחוֹר ·</tei:l> <tei:l>עֲנֶךָ אֶשְׁכַּח אַל־תֵּלֵךְ אָחוֹר ·</tei:l> <tei:l>סֵדֶר מִדּוֹתַי אַזְכִּיר בְּרִיתִי לִבְחוֹר׃</tei:l> <tei:l>נִכְלַמְנוּ בַּעֲוֹנֵנוּ בוֹשְׁנוּ בְּמַעֲשֵׂינוּ וְנָהִינוּ ·</tei:l> <tei:l>מַה־ <tei:pb n="145" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n291_medium.jpg"/>נְּדַבֵּר וְנִצְטַדֵּק אֱלֹהֵינוּ ·</tei:l> <tei:l>לֹא־כְחַטֹּאתֵינוּ תִגְמוֹל יוֹצְרֵנוּ אָבִינוּ ·</tei:l> <tei:l>כִּכְלוֹת כֹּחֵנוּ אַל־תַּעַזְבֵנוּ׃</tei:l> <tei:l>יָדַעְנוּ כִּי־חָטָאנוּ יַשֵּׁר הֶעָקוֹב ·</tei:l> <tei:l>מִטּוֹבוֹתֶיךָ תַּרְאֵנוּ וְשֵׁם אוֹיְבֶיךָ לִרְקוֹב ·</tei:l> <tei:l>חַנּוּן אַל־תֵּפֶן אֶל־רִשְׁעֵנוּ לִנְקוֹב ·</tei:l> <tei:l>זְכֹר לַעֲבָדֶיךָ לְאַבְרָהָם לְיִצְחָק וּלְיַעֲקֹב׃</tei:l> <tei:l>וְאִם פָּשַׁעְנוּ וּמָרִינוּ כְּתוֹר הָאָדָם ·</tei:l> <tei:l>הֲלֹא רַחֲמֶיךָ זְכֹר וְלַבֵּן אֲדָמִים ·</tei:l> <tei:l>דֶּשֶׁן עוֹלָתְךָ יִרְשֶׁנָּה לְפָנֶיךָ הֵרָם ·</tei:l> <tei:l>גָּלֻיוֹת וְעֵנִיוּת הַכֵּר לְגָאֳלָם יְדִידִים׃</tei:l> <tei:l>בָּנֶיךָ הֵם עַמְּךָ וְנַחֲלָתְךָ בְּחִנּוּן אָמְרֵנוּ הַאֲזִינָה וְהַצִּילֵנוּ מֵחֵץ הַשָּׁנוּן ·</tei:l> <tei:l>אֶת־לַחַן עֲתִירָתֵנוּ זְעַק רָנֵן ·</tei:l> <tei:l>יְיָ יְיָ אֵל רַחוּם וְחַנּוּן׃</tei:l> </tei:lg>
      </tei:div>
