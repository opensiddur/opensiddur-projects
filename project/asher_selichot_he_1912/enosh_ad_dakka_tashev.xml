      <tei:div corresp="urn:x-opensiddur:text:poem:enosh_ad_dakka_tashev">
        <tei:pb n="117" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n235_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אֱנוֹשׁ עַד־דַּכָּא תָּשֵׁב ·</tei:l> <tei:l>לִפְנֵי גְבָעוֹת וְתֵבֵל תִּישֵׁב׃</tei:l> <tei:l>בְּהֵאָמֵן אֶצְלְךָ שַׁעֲשׁוּעֵי יוֹמִים ·</tei:l> <tei:l>מְרַחֶפֶת עַל־פְּנֵי הַמָּיִם׃</tei:l> <tei:l>גִּיחוֹת כְּהָבָב מְדִינָה מְשַׁבֶּשֶׁת ·</tei:l> <tei:l>נְתָנָה לְמַרְפֵּא וּצְרִי הַחֲבוּשֶׁת׃</tei:l> <tei:l>דַּעַת טַעַם הַיְּחִידָה מֵהַשְׁחִית ·</tei:l> <tei:l>שָׂרִיגוֹ בְּרִינוֹ מַחֲצִית הֵפִית׃</tei:l> <tei:l>הַמַּצָּע־בִּלְבֵּל עֶלְיוֹן תָּבַע ·</tei:l> <tei:l>עֶרְכּוֹ בְּשַׂקּוֹ וְתַעֲנִיתוֹ קָבַע׃</tei:l> <tei:l>וְאַף כִּי מִבְּכוֹרָה נִגְרַשׁ ·</tei:l> <tei:l>פֵּרֵשׁ מֵאָבִיו וּלְהָשִׁיבוֹ דָרַשׁ׃</tei:l> <tei:l>זָבְדָה־לוֹ מַשְׂכֹּרֶת יְתֵרָה ·</tei:l> <tei:l>צִפָּה לְהַעֲמִיד בְּאֵר הַתּוֹרָה׃</tei:l> <tei:l>חַיוּת הַשְּׁבָטִים בְּצִדְקוֹ הֻדְבָּרוּ ·</tei:l> <tei:l>קָלוּט בְּזָהָב מֵעוֹת הַמִּדְבָּר׃</tei:l> <tei:l>טָסַם בְּנוֹ בָּקִי וּמְיֻשָּׁב ·</tei:l> <tei:l>רָאוּי לְהַשִּׂיא עֵצָה וּמֻחְשָׁב׃</tei:l> <tei:l>יִשְׂרָאֵל קוֹנָהּ יִכְמְרוּ נִיחוּמוֹ׃</tei:l> <tei:l>שׁוּבָה עַד שֶׁהוּא בְּמִתַּת רַחֲמָיו ·</tei:l> <tei:l>כָּתַב לְמַעֲלָה לְהַזְהִיר <tei:pb n="118" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n237_medium.jpg"/>חֲבַרְתָּהּ ·</tei:l> <tei:l>תֶּאְשַׁם שׁוֹמְרוֹן כִּי־מָרָתָה׃</tei:l> <tei:l>אֶל־נְתִיבוֹת עוֹלָם אוּלוּ ·</tei:l> <tei:l>לְחָכְמָה וּלְנְבִיאָה וְלַתּוֹרָה שָׁאֲלוּ׃</tei:l> <tei:l>בְּטוֹב וְיָשָׁר לְמֶלֶךְ־נִזְהָרוּ ·</tei:l> <tei:l>מִתּוֹךְ־סוֹדוֹ חֲסִידָיו נִכָּרוּ׃</tei:l> <tei:l>גְּדָל־חֶסֶד לוֹ נְיַחֵל נֵאוֹת מִבְּרִיוֹתָיו וְעֶלְבּוֹנֵנוּ מוֹחֵל׃</tei:l> <tei:l>דּוֹרוֹנוֹ בִּכְלִי־שָׁבוּר מוּבָל ·</tei:l> <tei:l>סַמֵּי־קְצִיעוֹתָיו בְּגָרוֹנֵנוּ מְקַבֵּל׃</tei:l> <tei:l>הוּא שֶׁהַנָּבִיא־מְקַלֵּס מַהֲלָתוֹ ·</tei:l> <tei:l>עוֹבֵר עַל־פֶּשַׁע שְׁיָרֵי נַחֲלָתוֹ׃</tei:l> <tei:l>וּמִי כָמוֹהוּ מוֹרֶה לַחֲטָאִים ·</tei:l> <tei:l>פָּשַׁר דְּבָרִים וְרִצּוּי מִבְטָאִים׃</tei:l> <tei:l>זָרִים תַּחֲלוּשׁוֹתָיו תּוֹסָפוֹת ·</tei:l> <tei:l>צְרִירוֹת רָעוֹת בְּמָעוֹת יָפוֹת׃</tei:l> <tei:l>חוֹטֵא לָשׁוּב אִם יִתְאַפֵּשׁ ·</tei:l> <tei:l>קְרִיאוֹת עִתּוֹתָיו בְּעוֹד־רֵישׁ׃</tei:l> <tei:l>טוֹבָה בִּשְׁבִילוֹ לְעוֹלָם נֶחֱרֶצֶת ·</tei:l> <tei:l>רַבִּים־וְיָחִיד זְכוּת נִמְצֵאת׃</tei:l> <tei:l>יַעַן כִּי נִהְיְתָה פַּעֲמַיִם שׁוּבוּ שׁוּבוּ לַאֲבִיכֶם שֶׁבַּשָּׁמַיִם׃</tei:l> <tei:l>כְּבֵן מְלָכִים שֶׁיָּצָא לְתַרְבּוּת תּוֹחַלְתּוֹ ·</tei:l> <tei:l>חוֹזֵר לְאָבִיו בִּקְרִיבוּת׃</tei:l> <tei:l>יִשְׂרָאֵל בְּנֶךָ יְקִירְךָ בְּכוֹרְךָ ·</tei:l> <tei:l>צַעֲצוּעֵי שַׁעֲשׁוּעֶיךָ זְכוֹר בּוֹרְךָ׃</tei:l> <tei:l>חוֹזֵר אֶצְלְךָ בִּתְשׁוּבָה שָׁב ·</tei:l> <tei:l>קְטֹרֶת הָכוֹן פְּלִילוֹ יֻקְשָׁב׃</tei:l> <tei:l>הֲמוֹן מֵעֶיךָ יֶהֱמוּ לוֹ ·</tei:l> <tei:l>קִדֵּם בְּסִינַי הַשְׁלִים לְמוּלוֹ׃</tei:l> <tei:l>טוּבְךָ וְרַחֲמֶיךָ הֻכְפַּל לוֹ ·</tei:l> <tei:l>נוֹעַם־דְּרָכֶיךָ בִּפְלִילוֹ׃</tei:l> <tei:l>יַעַן הַיְּחִידָה בְּמַחַט פָּתְחָה ·</tei:l> <tei:l>יַד־שֶׁלְךָ כְאוּלָם הֲפָתְחָה׃</tei:l> <tei:l>אָוֶן רָאוֹתְךָ בַּל תִּתְבּוֹנֵן ·</tei:l> <tei:l>יְדַע מְתֵי שָׁוְא לְבוֹנֵן׃</tei:l> <tei:l>יֵשׁ בְּנוֹהַג עוֹלָם כְּרַבִּים ·</tei:l> <tei:l>מְבַזֶּה אֶת־חֲבֵירוֹ בָּרַבִּים׃</tei:l> <tei:l>וְאַחַר־זְמַן רוּחוֹ בְּצַנְּנוֹ ·</tei:l> <tei:l>שִׁחֵר־טוּבוֹ וּמְבַקֵּשׁ רְצוֹנוֹ׃</tei:l> <tei:l>נוֹתֵן חוֹב־הַדִּין כְּבַתְּחִלָּה ·</tei:l> <tei:l>יָשׁוּב יְבַקֵּשׁ מִמֶּנּוּ מְחִילָה׃</tei:l> <tei:l>יִגְדַּל וְיִשְׂגַּב כֹּחַ־הַבּוֹרֵא ·</tei:l> <tei:l>בִּתְשׁוּבָה מוֹרֶה בְּהַצְנֵעַ קוֹרֵא׃</tei:l> <tei:l>וְרָאוּי הַשֵּׁם־הַנִּכְבָּד לְקַלְּסוֹ ·</tei:l> <tei:pb n="119" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n239_medium.jpg"/><tei:l>וּבִדְבָרִים מְרוּצִים לְפַיְּסוֹ׃</tei:l> <tei:l>עַד יֵעָרֶה־רוּחוֹ מִמָּרוֹם ·</tei:l> <tei:l>שְׁבוּתֵנוּ־יָשִׁיב מִצָּפוֹן וּמִדָּרוֹם׃</tei:l> <tei:l>טוֹב יֵטִיב מְקוֹם מִקְדָּשֵׁנוּ ·</tei:l> <tei:l>אָז מִזְבְּחוֹ נַעֲלֶה קָדָשֵׁינוּ׃</tei:l> <tei:l>וְאָז מְנוּחָתֵנוּ נְשַׁלְּמָה בְּחֻקִּים ·</tei:l> <tei:l>מִבְטָח כָּל־קַצְוֵי אֶרֶץ וְיָם רְחוֹקִים׃</tei:l> </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
