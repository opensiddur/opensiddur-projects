      <tei:div corresp="urn:x-opensiddur:text:poem:anahnu_hahomer_veatah_yotserenu">
        <tei:pb n="107" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n215_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אֲנַחְנוּ הַחֹמֶר וְאַתָּה יוֹצְרֵנוּ ·</tei:l> <tei:l>אֲמִתְּךָ וְחַסְדְּךָ תָּמִיד יִצְּרוּנוּ ·</tei:l> <tei:l>בְּאַפְּךָ אַל תוֹכִיחֵנוּ צוּרֵנוּ ·</tei:l> <tei:l>בְּשֶׁצֶף חֲמָתְךָ אַל תְּיַסְּרֵנוּ׃</tei:l> <tei:l>גַּשְׁתֵּנוּ אֵלֶיךָ בְּקִירַת דְּבָרִים ·</tei:l> <tei:l>גַּלְגֵּל רַחֲמֶיךָ מִשּׁוּב חֲפוּרִים ·</tei:l> <tei:l>דָּרַשְׁנוּ שִׁכְנְךָ בִּלְבָבוֹת נִשְׁבָּרִים ·</tei:l> <tei:l>דַּלֵּנוּ מֵרֶפֶשׁ וּרְפָא שְׁבָרִים׃</tei:l> <tei:l>הַעֲבֵר חֶרְפָּתֵנוּ אֲשֶׁר נָגוּר ·</tei:l> <tei:l>הַאֲלֵם מַלְשִׁין וְהַגְבֵּר סָנֵגוֹר ·</tei:l> <tei:l>וְשַׁעֲרֵי תְפִלָּתֵנוּ בַּל־תִּסְגּוֹר ·</tei:l> <tei:l>וְעַל־שׁוֹטְנֵנוּ חֲמוֹת תַּחְגּוֹר׃</tei:l> <tei:l>זַכֵּנוּ מֵחֵטְא וְהַחֲסֵנוּ בְּצִלֶּךָ ·</tei:l> <tei:l>זְדוֹנֵנוּ תִמְחֶה וְתַשְׁלִיךְ בִּמְצוּלֶךָ ·</tei:l> <tei:l>חֲבִיאֵנוּ <tei:pb n="108" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n217_medium.jpg"/>וְהַסְתִּירֵנוּ בְּסֵתֶר אָהֳלֶךָ ·</tei:l> <tei:l>חוּסָה עַל־עֲמָלֶךָ וּקְהָלֶךָ׃</tei:l> <tei:l>מִטֻּמְאָתֵנוּ טַהֵר וְעָרְלַת לְבָבֵנוּ מוֹל ·</tei:l> <tei:l>טוּב מִדָּתְךָ לָנוּ תִגְמוֹל יַעַן וַיִּבְעַן אוֹתָנוּ מִלִּגְמוֹל ·</tei:l> <tei:l>יֶהֱמוּ מֵעֶיךָ סְגֻלָּתְךָ תַחְמוֹל׃</tei:l> <tei:l>כְּמוֹ הָרָה תָּחִיל וְתִזְעַק ·</tei:l> <tei:l>כֵּן מִפָּנֶיךָ נָחִיל וְנִזְעַק ·</tei:l> <tei:l>לֹא־תִבְזֶה עֱנוּת זָעַק ·</tei:l> <tei:l>לֹא־תְשַׁקֵּץ עֲרֹךְ צָעַק׃</tei:l> <tei:l>מְשׁוּבָה יִשְׂרָאֵל הַבַּת־הַשּׁוֹבֵבָה ·</tei:l> <tei:l>מַלֵּא דְבָרְךָ וּלְנָוָה תְּשׁוֹבְבָה ·</tei:l> <tei:l>נָאוֹר הֲשִׁיבֵנוּ אֵלֶיךָ וְנָשׁוּבָה ·</tei:l> <tei:l>נְאֻם הַגֶּבֶר תְּסוֹבֵב נְקֵבָה׃</tei:l> <tei:l>שְׂרֵפָה בְּאֵשׁ כְּסוּחָה מִגַּעֲרָתְךָ סָלוָה ·</tei:l> <tei:l>וְאוֹיָה מוֹאֲסֵי בְרִיתְךָ ·</tei:l> <tei:l>עוֹלְלֶיהָ תְּעוֹלֵל וּתְחוֹן שְׁאֵרִיתְךָ ·</tei:l> <tei:l>עוֹד כְּקֶדֶם תִּכּוֹן עֲדָתְךָ׃</tei:l> <tei:l>פְּקוֹד גֶּפֶן זֹאת הַפְּנוּקָה ·</tei:l> <tei:l>פְּרַע בּוֹקְקֶיהָ בְּחֻקֵּי הַחֲקוּקָה ·</tei:l> <tei:l>צְרָרוּהָ צָרִים בְּבוּקָה מְבֻלָּקָה ·</tei:l> <tei:l>צוֹרְרֶיהָ תִּצוֹר לְחֶרֶב עֲלִיקָה׃</tei:l> <tei:l>קוֹמֵם נְפוּלָה בְּכַמָּה־שָׁנִים ·</tei:l> <tei:l>קְדוֹרָנִית יוֹשֶׁבֶת בְּמַחֲשַׁכֵּי אֲשֵׁנִים ·</tei:l> <tei:l>רָם תִּזְכּוֹר בְּרִית רִאשׁוֹנִים ·</tei:l> <tei:l>רוֹמֵם דְּבִירְךָ מִחֻרְבָּנִים רִאשִׁים׃</tei:l> <tei:l>שְׁעֵה שַׁוְעָה וְקַבֵּל פְּגִיעָה ·</tei:l> <tei:l>שְׁבוֹר רְשָׁעָה חֲבוֹשׁ צוֹלֵעָה ·</tei:l> <tei:l>תָּקִים שְׁבוּעָה תָּחִישׁ יְשׁוּעָה ·</tei:l> <tei:l>תְּמִימָה הוֹשִׁיעָה כִּי־הִגִּיעָה קֵץ וְשָׁעָה׃</tei:l> </tei:lg>
      </tei:div>
    </tei:body>
