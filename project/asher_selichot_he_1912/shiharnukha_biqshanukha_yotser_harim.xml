      <tei:div corresp="urn:x-opensiddur:text:poem:shiharnukha_biqshanukha_yotser_harim">
        <tei:pb n="104" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n209_medium.jpg"/>
        <tei:lg><tei:l>שִׁחַרְנוּךָ בִּקַּשְׁנוּךָ יוֹצֵר הָרִים ·</tei:l> <tei:l>מַגִּיד לְאָדָם שֵׂחַ וּדְבָרִים׃</tei:l> <tei:l>וְחָלִינוּךָ וּדְרַשְׁנוּךָ בּוֹשִׁים וַחֲפֵרִים ·</tei:l> <tei:l>אֶת־חַטֹּאתֵינוּ הַיּוֹם אָנוּ מְסַפְּרִים׃</tei:l> <tei:l>לִזְקֵנֵנוּ וִיעוּדֵנוּ זְקֵנִים וּנְעָרִים ·</tei:l> <tei:l>בֵּית הַתְּפִלָּה מִקְדָּשׁ מִזְעָרִים ·</tei:l> <tei:l>רְפוּיֵי יָדַיִם וּמְעוּדֵי אֵבָרִים ·</tei:l> <tei:l>בְּהוּלִים וּסְעוּרִים מִכָּל־עֲבָרִים׃</tei:l> <tei:l>יָגֹרְנוּ וְדָאַגְנוּ מִשְּׁנֵי גוֹנְלִירִים ·</tei:l> <tei:l>אַף וְחֵמָה שְׁנֵיהֶם קַטֵּגוֹרִים׃</tei:l> <tei:l>פִּשְׁפַּשְׁנוּ מַעֲשִׂים וְהִנָּם מְכוֹעָרִים ·</tei:l> <tei:l>רֶתֶת אֲחָזַתְנוּ חֲבָלִים וְצִירִים׃</tei:l> <tei:l>הוּשְׁחֲרוּ פָנֵינוּ וְהָלַכְנוּ קוֹדְרִים ·</tei:l> <tei:l>מוֹט הִתְמוֹטַטְנוּ וְנַעֲשִׂינוּ פְרוּרִים׃</tei:l> <tei:l>חַלְחֲלוּ מָתְנֵינוּ וְכַיּוֹלֵדָה מְצִירִים ·</tei:l> <tei:l>זָחַלְנוּ וַנִּירָא מֵעֲוֹנוֹתֵינוּ הַיְּתֵרִים׃</tei:l> <tei:l>קְחוּנוּ דְבָרִים בְּשִׁלּוּם פָּרִים ·</tei:l> <tei:l>תְּמוּנִים בְּטוּחִים וּלְרַחֲמֶיךָ מְסַבְּרִים׃</tei:l> </tei:lg>
