      <tei:div corresp="urn:x-opensiddur:text:poem:eqra_beshimkha_lehahaziq_bekha">
        <tei:pb n="30" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n61_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אֶקְרָא בְשִׁמְךָ לְהַחֲזִיק־בְּךָ אֶתְעוֹרֵר ·</tei:l> <tei:l>בִּתְפִלַּת אַשְׁמֹר אַקְדִּים שַׁחַר אֲעוֹרֵר ·</tei:l> <tei:l>נִגַּשְׁתִּי פְּנֵי תֵיבָה מִלֵּל לְבָרֵר ·</tei:l> <tei:l>דִּקְדַּקְתִּי מַעֲרָכֵי דַל־שָׂפָה לְגַדֵּר ·</tei:l> <tei:l>הֵן תָּוִי יַאֲוִינִי יַעֲנֵנִי־שַׁדַּי ·</tei:l> <tei:l>וְאֵיפוֹא מַפְגִּיעַ־הָגוּן וְאֵיֶּה כַּדִּי ·</tei:l> <tei:l>זִכִּיתִי לִבִּי יֹאמַר וְקֹשְׁט מַעֲבָדַי ·</tei:l> <tei:l>חַף־אָנִי מִפֶּשַׁע וְזָכּוּ מַעֲשֵׂי־יָדָי׃</tei:l> <tei:l>טוֹבָה לַחַיָּבִים גְּמוֹל וְלֹא לַחֲלוּי ·</tei:l> <tei:l>יַחְשָׁב כְּקָרְבַּן מֶלֶל וְכִנְיחָה כָּלִיל ·</tei:l> <tei:l>כְּפוּפֶיךָ זְקוֹף הֱיוֹתָם לְרֹאשׁ תָּלוּי ·</tei:l> <tei:l>לֹא תִמְצֶאנָה חַטֹּאת סֵתֶר וְגָלוּי ·</tei:l> <tei:l>מִשְׂגַּב בַּצָּרָה הֱיֵה לְבָךְ־חוֹסֶה ·</tei:l> <tei:l>נוֹדֵד אַל־תַּגְלֶה נִדָּח כְּשֶׂה ·</tei:l> <tei:l>שִׂימָה דִמְעָתִי בְּנֹאדֶךָ עֶרֶשׂ מְמַסֶּה ·</tei:l> <tei:l>עוֹז לִי בָךְ מָעוֹז וּמַחְסֶה׃</tei:l> <tei:l>צְפֵה וְהוֹצֵא לִרְוָיָה אֲסִירֶיךָ תַּתִּיר ·</tei:l> <tei:l>צְעָקוּךָ דְּפָקוּךָ קְרָאוּךָ בַּצָּר לְהַעְתִּיר ·</tei:l> <tei:l>קְבָעוּם קוֹבְעֵיהֶם וְרָשָׁע צַדִּיק מַכְתִּיר ·</tei:l> <tei:l>רַב וְשׁוֹפֵט לָמָּה פָנֶיךָ תַּסְתִּיר׃</tei:l> <tei:l>שְׁאוֹן־קָמֶיךָ הַעֲדֵה הָדֵק כָּלֶה ·</tei:l> <tei:l>תָּמִיד לְיוֹדְעֵי סוֹדְךָ גַּלֵּה ·</tei:l> <tei:l>אָנָּא נִדָּח הָשֵׁב קַבֵּץ גּוֹלֶה ·</tei:l> <tei:l>לַמָּרוֹם שָׁפָל הָקֵם וְיוֹרֵד הַעֲלֵה ·</tei:l> <tei:l>יֹאמְרוּ בַגּוֹיִם הִגְדִּיל יְיָ לַעֲשׂוֹת ·</tei:l> <tei:l>הַנְּשַׁמָּה הָיְתָה לָעֵדֶן וּלְבִצָּרוֹן הַנֶּהֱרָסוֹת ·</tei:l> <tei:l>בְּטוּחֶיךָ הַצֵּל נָטוּ בְצִלְּךָ לַחֲסוֹת ·</tei:l> <tei:l>רְדִיפָתָם בַּקֵּשׁ עָלֶיךָ הַדָּבָר לַעֲשׂוֹת ·</tei:l> <tei:l>שְׁמַעֵה דַּכָּא בִּימָה עֲטֹף רוּחוֹ ·</tei:l> <tei:l>יִהְיוּ לְרָצוֹן אֲמָרָיו וְשֶׁפֶךְ שִׂיחוֹ ·</tei:l> <tei:l>חַזֵּק רִפְיוֹן וְאַמֵּץ כּוֹשֵׁל לְהַרְוִיחוֹ ·</tei:l> <tei:l>כִּי־הִנְּךָ יוֹצֵר־הָרִים וּבוֹרֵא־רוּחַ מַגִּיד לָאָדָם מַה־שֵּׂחוֹ׃</tei:l> </tei:lg>
      </tei:div>
