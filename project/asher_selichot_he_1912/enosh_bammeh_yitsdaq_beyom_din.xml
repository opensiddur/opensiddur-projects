      <tei:div corresp="urn:x-opensiddur:text:poem:enosh_bammeh_yitsdaq_beyom_din">
        <tei:pb n="119" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n239_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אֱנוֹשׁ בַּמֶּה־יִצְדַּק בְּיוֹם־דִּין לִפְנֵי בּוֹרְאוֹ ·</tei:l> <tei:l>בַּמֶּה־יִקְדַּם וּבַמֶּה־יִזְכֶּה לְכַלְכֵּל אֶת־יוֹם בּוֹאוֹ׃</tei:l> <tei:l>גּוּרוּ לָכֶם וּפַחֲדוּ מִפְּנֵי מוֹרָאוֹ ·</tei:l> <tei:l>דִּרְשׁוּ יְיָ בְּהִמָּצְאוֹ׃</tei:l> <tei:l>דּוּמָה עַד־לֹא־יִשְׁכּוֹן יָצִיר וְלִפְנֵי שַׁחַת קָרוֹב ·</tei:l> <tei:l>הַבָּאָה תַחֲנוּן וְהָבֵר תְּפִלָּה לְיוֹצְרוֹ לָרוֹב׃</tei:l> <tei:l>וְשִׂיחַ־אֶנְקָתֵנוּ לָכֵן לְפָנָיו יֶעֱרוֹב ·</tei:l> <tei:l>קְרָאֻהוּ בִּהְיוֹתוֹ־קָרוֹב׃</tei:l> <tei:l>זִבְחֵי־אֱלֹהִים רוּחַ נִשְׁבָּרָה וְלֵב־נִדְכֶּה נִיחוֹחֵי נִסְכּוֹ ·</tei:l> <tei:l>חֶפְצוֹ אֵין־בְּכָלִיל וְלֹא בִתְמוּרַת עֶרְכּוֹ׃</tei:l> <tei:l>טוֹב־לֵב אוֹהֵב וְהִזְהִיר עֲלֵי תְּשׁוּבַת נִדְכּוֹ ·</tei:l> <tei:l>יַעֲזוֹב רָשָׁע דַּרְכּוֹ׃</tei:l> <tei:l>יְתַקְּנוּ הַרְכִּיבוֹ וִיַתֵּישְׁרוּ עִלּוּתוֹתָיו ·</tei:l> <tei:l>בַּלָּה פֶן יֵחָרֵץ עָלָיו וְתִתְחַזַּקְןָ מוֹסְרוֹתָיו׃</tei:l> <tei:l>לֹא־חָפֵץ בְּמֹת הַמֵּת כִּי־אִם בְּעָזְבוֹ תּוֹעֲבוֹתָיו ·</tei:l> <tei:l>וְאִישׁ אָוֶן מַחְשְׁבוֹתָיו׃</tei:l> <tei:l>מָעוֹז מִשְׂגָּב וְחִפּוּי לְחוֹסֵהוּ נוֹרָא מְאֹד מַלְכֵּנוּ וּמוֹרֶה אֵין־כָּמוֹהוּ ·</tei:l> <tei:l>סְלִיחָה וְתַחֲנוּן אִישׁ יְבַקֵּשׁ בַּעֲדֵהוּ ·</tei:l> <tei:l>וְיָשׁוּב אֶל־ <tei:pb n="120" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n241_medium.jpg"/>יְיָ וִירַחֲמֵהוּ׃</tei:l> <tei:l>עוֹנֶה מִמֵּצַר קוֹרְאָיו וּלְתַעֲלֻמָּם תְּרוּפָה מְמַהֵר לִשְׁלוֹחַ ·</tei:l> <tei:l>פּוֹנֶה לְעַנּוֹת עָנִי תְּפִלָּתוֹ בַּל־לְשַׁקֵּץ וְלִזְנוֹחַ׃</tei:l> <tei:l>צָעוֹק נִצְעַק מִכְּאֵב לֵב וְנִסְגּוֹד וְנִפְלוֹחַ ·</tei:l> <tei:l>אֶל־אֱלֹהֵינוּ כִּי־יַרְבֶּה לִסְלוֹחַ׃</tei:l> <tei:l>קְחוּנוּ דְבָרִים וְאוֹתָנוּ נוֹכִיחֶךָ ·</tei:l> <tei:l>רְצוֹת שְׁלוּמֵנוּ בְּעַד נִיחוֹחֶיךָ׃</tei:l> <tei:l>שֶׁכָּךְ הִבְטַחְתָּנוּ עַל־יְדֵי שְׁלוּחֶיךָ שׁוּבָה יִשְׂרָאֵל עַד־יְיָ אֱלֹהֶיךָ׃</tei:l> <tei:l>תְּשׁוֹבֵב יַעֲקֹב וְיִשְׂרָאֵל תֶּאֱסוֹף עָדֶיךָ ·</tei:l> <tei:l>תְּקַבֵּל תְּשׁוּבָתֵנוּ כּוֹפֶר תּוֹדֶיךָ׃</tei:l> <tei:l>בָּנוּ יֵאָמְנוּ מִנְהַג רַחֲמֶיךָ וַחֲסָדֶיךָ ·</tei:l> <tei:l>שׁוּבָה יְיָ עַד־מָתָי וְהִנָּחֵם עַל־עֲבָדֶיךָ׃</tei:l> </tei:lg>
      </tei:div>
