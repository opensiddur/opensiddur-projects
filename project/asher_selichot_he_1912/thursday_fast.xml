              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/thursday_fast/pair_after_yisrael/printed">
            <tei:pb n="170" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n341_medium.jpg"/>
