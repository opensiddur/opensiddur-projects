            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/thursday_fast/conclusion_repeat/printed">
            <tei:pb n="170" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n341_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Continue from <tei:foreign xml:lang="he">זְכוֹר רַחֲמֶיךָ</tei:foreign> page 164, till <tei:foreign xml:lang="he">הָרַחֲמִים וְהַסְּלִיחוֹת</tei:foreign> page 167. The Reader says <tei:foreign xml:lang="he">וְאַל יְעַכֵּב</tei:foreign>, and the Service is concluded as directed in page 167. </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_thursday-fast_day_conclusion_repeat_printed"/>
          <j:conditional xml:id="penitential_thursday-fast_day_conclusion_repeat_expanded">
