            <tei:pb n="170" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n341_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say <tei:foreign xml:lang="he">אֵל מֶלֶךְ</tei:foreign> and <tei:foreign xml:lang="he">וַיַּעֲבֹר</tei:foreign> </tei:note>
