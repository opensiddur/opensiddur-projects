      <tei:div corresp="urn:x-opensiddur:text:prayer:ki_al_rahamekha">
        <tei:pb n="8" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n17_medium.jpg"/>
        <tei:lg><tei:l>כִּי עַל רַחֲמֶיךָ הָרַבִּים אָנוּ בְטוּחִים ·</tei:l> <tei:l>וְעַל צִדְקוֹתֶיךָ אָנוּ נִשְׁעָנִים ·</tei:l> <tei:l>וְלִסְלִיחוֹתֶיךָ אָנוּ מְצַפִּים ·</tei:l> <tei:l>וְלִישׁוּעָתְךָ אָנוּ מְקַוִּים׃</tei:l> <tei:l>אַתָּה הוּא מֶלֶךְ אוֹהֵב צְדָקוֹת מִקֶּדֶם ·</tei:l> <tei:l>מַעֲבִיר עֲוֹנוֹת עַמּוֹ וּמֵסִיר חַטֹּאת יְרֵאָיו׃</tei:l> <tei:l>כָּרַת בְּרִית לָרִאשׁוֹנִים ·</tei:l> <tei:l>וּמֵקִים שְׁבוּעָה לָאַחֲרוֹנִים׃</tei:l> <tei:l>אַתָּה הוּא שֶׁיָּרַדְתָּ בֶּעָנָן כְּבוֹדֶךָ עַל הַר סִינַי וְהֶרְאֵיתָ דַּרְכֵי טוּבְךָ לְמֹשֶׁה עַבְדֶּךָ׃</tei:l> <tei:l>אָרְחוֹת חֲסָדֶיךָ גִּלִּיתָ לוֹ ·</tei:l> <tei:l>וְהוֹדַעְתּוֹ כִּי אַתָּה אֵל רַחוּם וְחַנּוּן ·</tei:l> <tei:l>אֶרֶךְ אַפַּיִם וְרַב חֶסֶד וּמַרְבֶּה לְהֵיטִיב ·</tei:l> <tei:l>וּמַנְהִיג אֶת־כָּל־הָעוֹלָם כֻּלּוֹ בְּמִדַּת הָרַחֲמִים׃</tei:l> <tei:l>וְכֵן כָּתוּב וַיֹּאמֶר אֲנִי אַעֲבִיר כָּל־טוּבִי עַל־פָּנֶיךָ וְקָרָאתִי בְשֵׁם יְיָ לְפָנֶיךָ ·</tei:l> <tei:l>וְחַנֹּתִי אֶת־אֲשֶׁר אָחֹן ·</tei:l> <tei:l>וְרִחַמְתִּי אֶת־אֲשֶׁר אֲרַחֵם׃</tei:l> </tei:lg>
