      <tei:div corresp="urn:x-opensiddur:text:poem:ahavat_oz_vetoqef_hafekh">
        <tei:pb n="151" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n303_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אַהֲבַת עֹז וְתוֹקֶף חִבָּה ·</tei:l> <tei:l>בְּרִית נְעוּרִים זְכֹר וְחֶסֶד תַּאֲוֶה ·</tei:l> <tei:l>גָּדֵר מְשׂוּכָה בְּמַסְלוּל נְתִיבָה ·</tei:l> <tei:l>דָּרַךְ אָב וְרָחַף בִּפְרִישַׁת אֶבְרָה׃</tei:l> <tei:l>הֹעַר מִקֶּדֶם וּמִמִּזְרָח הוּבָא ·</tei:l> <tei:l>וְצֶדֶק לְרַגְלָיו נִקְרָא וְנַחֲוָה ·</tei:l> <tei:l>זִהֵר תּוֹעִים מִדֶּרֶךְ תּוֹעֵבָה ·</tei:l> <tei:l>חָשַׂכֵם מֵאֵשׁ וּמִלֶּהָבָה׃</tei:l> <tei:l>טִירוֹת בָּתִּים מָאַס מִלְּיִשְׁבָה ·</tei:l> <tei:l>יְתָדוֹת אֹהָלִים הֵפִיעַ בָּעֲרָבָה ·</tei:l> <tei:l>כָּלוּ רוֹב יָמָיו בְּאֶפֶס תִּקְוָה ·</tei:l> <tei:l>לְמֶשֶׁק בֶּן־בַּיִת זְקֵנִיתוֹ לְהִתְחַשֵּׁבָה׃</tei:l> <tei:l>מַאֲמָר בְּבֹא וּפְקִידָה בְּהִתְקָרְבָה ·</tei:l> <tei:l>נָחַנְט שְׂרִיג יֹשֶׁר וּמִשְׁעֶנֶת שֵׂיבָה ·</tei:l> <tei:l>סִבֵּר תּוֹחַלְתּוֹ מִמְּךָ לֹא־נִכְזְבָה ·</tei:l> <tei:l>עֶשֶׁת מַחֲשַׁבְתּוֹ אֵלֶיךָ הוּשָׁבָה׃</tei:l> <tei:l>פְּקֹד בַּחֲנָנוֹ בְּעֵת לְפָנֶיךָ קְרֵבָה ·</tei:l> <tei:l>צִוִּיתוֹ עַל חֵשֶׁק תַּאֲוָתוֹ לְךָ לְהַקְרִיבָה ·</tei:l> <tei:l>קַח־נָא אֶת־בִּנְךָ אֶת־יְחִידְךָ וְהַעֲלֵהוּ לִנְדָבָה ·</tei:l> <tei:l>רְצִיתוֹ הִשְׁקִיתוֹ לְרֵיחַ־נִיחֹחַ לְהִתְעָרְבָה׃</tei:l> <tei:l>שִׂיחַ פִּיו בְּרַנֵּן וּתְנוּאוֹת־לֹא הִרְבָּה ·</tei:l> <tei:l>תַּעַן מִימוּתוֹ לֹא־הֵשִׁיב בַּהֲשָׁבָה ·</tei:l> <tei:l>בָּקַע עֵצִים וּמַעֲרָכָה שָׂדָה ·</tei:l> <tei:l>נִין עָקַד בְּרָצוֹן תַּאֲוָה׃</tei:l> <tei:l>יָדָיו וְרַגְלָיו קָשַׁר בְּעָקוּד וַעֲנִיבָה ·</tei:l> <tei:l>פֶּן בְּפִרְכּוּס יִפָּסֵל לְעוֹלַת חוֹבָה ·</tei:l> <tei:l>מַאֲכֶלֶת לְשָׁחֲטוֹ יָד בְּשִׁלְּחַת בְּנֶפֶשׁ תַּאֲוָה ·</tei:l> <tei:l>נַעַר אַל־תִּשְׁחַט קוֹל אֵלָיו בָּא׃</tei:l> <tei:l>כִּי נִשְׁבַּעְתִּי עֵקֶב אֲשֶׁר עַל־יְחִידְךָ נַפְשְׁךָ לֹא־נֶעְצְבָה ·</tei:l> <tei:l>זַרְעֲךָ אָשִׁית כְּצִמְחֵי רְבָבָה ·</tei:l> <tei:l>חַי הוּא וְאֶפְרוֹ <tei:pb n="152" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n305_medium.jpg"/>לְפָנַי צָבוּר וּמוּבָא ·</tei:l> <tei:l>חָשִׁיב הוּא לְפָנַי כְּטָבוּחַ בְּמוֹקֵד אַחֲוָה ·</tei:l> <tei:l>זְכוּתוֹ הַמְצִיאֵנוּ בְּהָרִיחֲךָ קְטֹרֶת הַעֲרָבָה ·</tei:l> <tei:l>קֶצֶף שַׁכֵּךְ וְחֵמָה תַּשְׁבִּית מִבַּת הַשּׁוֹבֵבָה ·</tei:l> <tei:l>וְכַאֲשֶׁר כָּבְשׁוּ יֵצֶר וּשְׁנֵיהֶם עָקְרוּ לֵב הַתַּאֲוָה ·</tei:l> <tei:l>כֵּן יִכְבְּשׁוּ רַחֲמֶיךָ אֶת־כַּעַסְךָ מִמְּשׁוּבָה ·</tei:l> <tei:l>וּבְרַחֲמִים גְּדוֹלִים אֵלֶיהָ שׁוּבָה ·</tei:l> <tei:l>וְתֹאמַר שׁוּבָה מְשׁוּבָה׃</tei:l> </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
