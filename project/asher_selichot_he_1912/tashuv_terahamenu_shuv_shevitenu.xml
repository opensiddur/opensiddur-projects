      <tei:div corresp="urn:x-opensiddur:text:poem:tashuv_terahamenu_shuv_shevitenu">
        <tei:pb n="98" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n197_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>תָּשׁוּב תְּרַחֲמֵנוּ שׁוּב שְׁבִיתֵנוּ כִנְאֻמֶךָ ·</tei:l> <tei:l>שׁוּב כְּקֶדֶם חַדֵּשׁ חִבַּת לְאֻמֶּךָ ·</tei:l> <tei:l>רַחֵק רֹגֶז וְקָרֵב שׁוּךְ זַעְמֶךָ׃</tei:l> <tei:l>שׁוּב מֵחֲרוֹן אַפֶּךָ וְהִנָּחֵם עַל־הָרָעָה לְעַמֶּךָ׃</tei:l> <tei:l>קַבֵּץ וּבַקֵּשׁ אֲבֵדוֹת וְחַזֵּק נַחֲלָתֶךָ ·</tei:l> <tei:l>צֹאן־הֲרֵגָה וְהַנְּגוּזָה בִרְחֵלוֹתֶךָ ·</tei:l> <tei:l>פֶּשַׁע אִם־רַב פְּנֵי־מְחִילוֹתֶךָ ·</tei:l> <tei:l>שׁוּב לְמַעַן עֲבָדֶיךָ שְׁבְטֵי נַחֲלָתֶךָ׃</tei:l> <tei:l>עֲוֹן אֲבוֹתֵינוּ הִטְעִינֵנוּ וּבוֹסֶר־הִטְעִימֵנוּ ·</tei:l> <tei:l>כַּף רַעַל הִשְׁקָנוּ הִלְעִיטֵנוּ וְהִרְעִימֵנוּ ·</tei:l> <tei:l>נָא כְּאָז בְּשָׁכֵן יַחַד הַנְּעִימֵנוּ ·</tei:l> <tei:l>שׁוּבֵנוּ אֱלֹהֵי יִשְׁעֵנוּ וְהָפֵר כַּעַסְךָ עִמָּנוּ׃</tei:l> <tei:l>מָאוֹס לֹא־מָאַסְתָּ חוֹסֶיךָ מֵעִידֶיךָ ·</tei:l> <tei:l>לוֹקִים בְּכוֹרַח וּלְהִתְמָרַח סִבְרָם עָדֶיךָ ·</tei:l> <tei:l>כַּעַס לְרַצּוֹת בְּמִדַּת יֹשֶׁר מַעְבִּירֶיךָ ·</tei:l> <tei:l>שׁוּבָה יְיָ עַד־מָתָי וְהִנָּחֵם עַל־עֲבָדֶיךָ׃</tei:l> <tei:l>יוֹם יוֹם נְצַפֶּה גִּלּוּי סוֹדֶךָ ·</tei:l> <tei:l>טָמוּם וְעָמוּם וּנְבֵלָה בְּשָׂר חֲסִידֶיךָ ·</tei:l> <tei:l>חֶרְפָּה שָׁבְרָה לִבֵּנוּ מְקוּיִים חֲסָדֶיךָ ·</tei:l> <tei:l>שׁוּבָה־יְיָ <tei:pb n="99" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n199_medium.jpg"/>חַלְּצָה־נַפְשֵׁנוּ וְהוֹשִׁיעֵנוּ לְמַעַן חַסְדֶּךָ׃</tei:l> <tei:l>זָנַחְנוּ וְנֶחֱשַׁבְנוּ עִם יוֹרְדֵי רֶגֶב ·</tei:l> <tei:l>וַיְהִי־לְאֵבֶל כִּנּוֹר וְשִׁיר וְעוּגָב ·</tei:l> <tei:l>הַקּוֹדְרִים בְּרִנָּה וְתוֹדָה הַהוֹלֵךְ כִּשְׂגָב ·</tei:l> <tei:l>שׁוּבָה יְיָ אֶת־שְׁבִיתֵנוּ כַּאֲפִיקִים בַּנֶּגֶב׃</tei:l> <tei:l>דִּמְעָה לֶחֶם חוֹסֶיךָ צוּרִי אֵל ·</tei:l> <tei:l>גּוֹאֵל אַיֵּה בְּחֵרוּף צָרֵי אֵל ·</tei:l> <tei:l>בְּחָזוֹן אָז כְּדִבַּרְתָּ לִישָׁרֵי אֵל ·</tei:l> <tei:l>שׁוּבָה יְיָ רִבְבוֹת אַלְפֵי־יִשְׂרָאֵל׃</tei:l> <tei:l>שְׁמָעָה יְיָ הַטֵּה אֹזֶן וְהַקְשִׁיבָה ·</tei:l> <tei:l>לִמְחוֹל סְלַח־נָא סָלַחְתִּי הָשִׁיבָה ·</tei:l> <tei:l>מְשׁוּבוֹתֵינוּ רַבּוּ וּפָתַחְתָּ יִשְׂרָאֵל־שׁוּבָה ·</tei:l> <tei:l>הֲשִׁיבֵנוּ יְיָ אֵלֶיךָ וְנָשׁוּבָה׃</tei:l> </tei:lg>
      </tei:div>
