      <tei:div corresp="urn:x-opensiddur:text:poem:melekh_melakhim_veram_al_ramim">
        <tei:pb n="139" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n279_medium.jpg"/>
        <tei:lg><tei:l>מֶלֶךְ מְלָכִים וְרָם עַל־רָמִים ·</tei:l> <tei:l>שׁוֹכֵן שְׁחָקִים וְיוֹשֵׁב בַּמְּרוֹמִים ·</tei:l> <tei:l>הַמְהֻלָּל וְהַמְשֻׁבָּח לְעוֹלְמֵי עוֹלָמִים בָּרוּךְ וּמְבֹרָךְ בְּפִי כָּל־יְקוּמִים׃</tei:l> <tei:l>רוֹאֵה בָעֳנִי אוֹנִים וַעֲגוּמִים ·</tei:l> <tei:l>שׁוּר־נָא בְּשִׁפְלוּת מְעוּטֵי־עַמִּים׃</tei:l> <tei:l>מְפוּזָרִים וּמְפוֹרָדִים בֵּין כָּל־הָעַמִּים ·</tei:l> <tei:l>וּבְבֹשֶׁת וּכְלִמָּה נֶחֱפָּרִים וְנִכְלָמִים׃</tei:l> <tei:l>אֲבֵלִים וּגְרוּדִים נְזוּפִים וְשׁוֹמְמִים ·</tei:l> <tei:l>לְמַכִּים נְתוּנִים גֵּוִים לְמַהֲלֻמִּים׃</tei:l> <tei:l>בְּכָל־בֹּקֶר מִי־יִתֵּן עֶרֶב נוֹאֲמִים ·</tei:l> <tei:l>בַּרֶמֶשׁ אוֹמְרִים מִי־יִתֵּן יִקְרַב אוֹר יָמִים׃</tei:l> <tei:l>אֵין לָהֶם מְנוּחָה וָשֶׁקֶט וּשְׁלוֹמִים ·</tei:l> <tei:l>בַּמֶּה לְהִתְנַחֵם יִמְצְאוּ תַּנְחוּמִים׃</tei:l> <tei:l>שָׁלוֹם מְצַפִּים וְהִנָּם נִלְחָמִים ·</tei:l> <tei:l>לְטוֹבָה מְקַוִּים וְהִנֵּה רוֹעַ תַּשְׁלוּמִים׃</tei:l> <tei:l>וַתִּבְחַר נַפְשָׁם מִיתַת רְדוּמִים ·</tei:l> <tei:l>מַה־נִּתְאוֹנֵן וּמַה־נֹּאמַר וַעֲוֹנוֹתֵינוּ גּוֹרְמִים׃</tei:l> <tei:l>חָטָאנוּ רָשַׁעְנוּ סַרְנוּ מִפְּקוּדֶיךָ הַנְּעִימִים ·</tei:l> <tei:l>זְכֹר רַחֲמֶיךָ יְיָ וַחֲסָדֶיךָ הָעֲצוּמִים׃</tei:l> <tei:pb n="140" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n281_medium.jpg"/><tei:l>קוּמָה וְהִמָּלֵא עָלֵינוּ רַחֲמִים ·</tei:l> <tei:l>קַבֵּץ פְּזוּרֵינוּ מֵאֲרָצוֹת וְיַמִּים׃</tei:l> <tei:l>אֲשֶׁר־מָכַרְתָּ חִנָּם לָאֲדוּמִים ·</tei:l> <tei:l>מַהֵר לְגָאֳלָם בְּלֹא כֶסֶף וְדָמִים׃</tei:l> <tei:l>צַוֵּה יְשׁוּעוֹת יַעֲקֹב הַצּוּר תָּמִים ·</tei:l> <tei:l>כִּי לְךָ יְיָ הַסְּלִיחוֹת וְהָרַחֲמִים׃</tei:l> </tei:lg>
      </tei:div>
