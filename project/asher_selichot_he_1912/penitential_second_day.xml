      <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_second_day">
        <tei:pb n="104" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n209_medium.jpg"/>
        <tei:head>סליחות ליום שני של עשרת ימי תשובה</tei:head>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_second_day/opening_instruction">
          <j:conditional xml:id="penitential_second_day_opening_instruction_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_second_day/opening_instruction/printed">
            <tei:pb n="104" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n209_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say from <tei:foreign xml:lang="he">אַשְׁרֵי</tei:foreign> page 1, till <tei:foreign xml:lang="he">כִּי רַבּוּ</tei:foreign> page 7, after which say the following— </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_second_day_opening_instruction_printed"/>
          <j:conditional xml:id="penitential_second_day_opening_instruction_expanded">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <j:declare xml:id="penitential_second_day_opening_ten_days">
            <tei:fs type="opensiddur:holiday-aggregate">
              <tei:f name="aseret-ymei-tshuva">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:declare>
          <j:transclude target="urn:x-opensiddur:text:prayer:ashrei"/>
          <j:transclude target="urn:x-opensiddur:text:prayer:kaddish/selichot_preface"/>
          <j:transclude target="urn:x-opensiddur:text:prayer:kaddish/chatzi"/>
          <j:transclude target="urn:x-opensiddur:text:prayer:lekha_adonai_hatsedaqah"/>
          <j:transclude target="urn:x-opensiddur:text:prayer:shomea_tefillah"/>
          <j:endDeclare target="#penitential_second_day_opening_ten_days"/>
          <j:endConditional target="#penitential_second_day_opening_instruction_expanded"/>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_second_day/selah_lanu_avinu">
          <tei:pb n="104" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n209_medium.jpg"/>
          <tei:lg><tei:l>סְלַח־לָנוּ אָבִינוּ כִּי־בְרֹב אִוַּלְתֵּנוּ שָׁגִינוּ ·</tei:l> <tei:l>מְחַל־לָנוּ מַלְכֵּנוּ כִּי־רַבּוּ עֲוֹנֵינוּ׃</tei:l> </tei:lg>
        </tei:div>
        <j:transclude target="urn:x-opensiddur:text:poem:shiharnukha_biqshanukha_yotser_harim"/>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_second_day/after_shiharnukha">
          <j:conditional xml:id="penitential_second_day_after_shiharnukha_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_second_day/after_shiharnukha/printed">
            <tei:pb n="104" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n209_medium.jpg"/>
            <tei:note type="instruction" xml:lang="he">כי על רחמיך · אל ארך אפים · ויעבור </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_second_day_after_shiharnukha_printed"/>
          <j:conditional xml:id="penitential_second_day_after_shiharnukha_expanded">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <j:transclude target="urn:x-opensiddur:text:prayer:ki_al_rahamekha"/>
          <j:transclude target="urn:x-opensiddur:text:prayer:el_erekh_apayim"/>
          <j:transclude target="urn:x-opensiddur:text:prayer:vayaavor/selichot_preliminary"/>
          <j:endConditional target="#penitential_second_day_after_shiharnukha_expanded"/>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_second_day/elohim_boshnu">
          <tei:pb n="104" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n209_medium.jpg"/>
          <tei:p>אֱלֹהִים בּוֹשְׁנוּ בְּמַעֲשֵׂינוּ וְנִכְלַמְנוּ בַּעֲוֹנֵנוּ׃ בְּקָרְאֵנוּ עֲנֵנוּ אֱלֹהֵי צִדְקֵנוּ בַּצָּר הִרְחַבְתָּ־לָנוּ · חָנֵּנוּ וּשְׁמַע תְּפִלָּתֵנוּ׃ שִׁמְעָה תְפִלָּתֵנוּ יְיָ וְשַׁוְעָתֵנוּ הַאֲזִינָה · אֶל־דִּמְעָתֵנוּ אַל־תֶּחֱרַשׁ׃ </tei:p>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_second_day/rahamekha_rabbim">
          <tei:pb n="104" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n209_medium.jpg"/>
          <tei:p>רַחֲמֶיךָ רַבִּים יְיָ כְּמִשְׁפָּטֶיךָ חַיֵּינוּ׃ אַל־תָּבֹא בְמִשְׁפָּט עִמָּנוּ · כִּי לֹא־יִצְדַּק לְפָנֶיךָ כָּל־חָי׃ </tei:p>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_second_day/keraham_av">
          <tei:pb n="104" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n209_medium.jpg"/>
          <tei:p>כְּרַחֵם אָב עַל־בָּנִים כֵּן תְּרַחֵם יְיָ עָלֵינוּ׃ לַיְיָ הַיְשׁוּעָה עַל־עַמְּךָ בִרְכָתֶךָ סֶלָה׃ יְיָ צְבָאוֹת <tei:pb n="105" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n211_medium.jpg"/>עִמָּנוּ מִשְׂגָּב לָנוּ אֱלֹהֵי יַעֲקֹב סֶלָה׃ יְיָ צְבָאוֹת אַשְׁרֵי אָדָם בֹּטֵחַ בָּךְ׃ יְיָ הוֹשִׁיעָה הַמֶּלֶךְ יַעֲנֵנוּ בְיוֹם־קָרְאֵנוּ׃ </tei:p>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_second_day/selah_na">
          <tei:pb n="105" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n211_medium.jpg"/>
          <tei:p>סְלַח־נָא לַעֲוֹן הָעָם הַזֶּה כְּגֹדֶל חַסְדֶּךָ וְכַאֲשֶׁר נָשָׂאתָה לָעָם הַזֶּה מִמִּצְרַיִם וְעַד־הֵנָּה · וְשָׁם נֶאֱמַר׃ וַיֹּאמֶר יְיָ סָלַחְתִּי כִּדְבָרֶךָ׃ </tei:p>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_second_day/hateh_elohai">
          <tei:pb n="105" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n211_medium.jpg"/>
          <tei:p>הַטֵּה אֱלֹהַי אָזְנְךָ וּשְׁמַע פְּקַח עֵינֶיךָ וּרְאֵה שֹׁמְמֹתֵינוּ וְהָעִיר אֲשֶׁר־נִקְרָא שִׁמְךָ עָלֶיהָ׃ כִּי לֹא עַל־צִדְקֹתֵינוּ אֲנַחְנוּ מַפִּילִים תַּחֲנוּנֵינוּ לְפָנֶיךָ כִּי עַל־רַחֲמֶיךָ הָרַבִּים׃ אֲדֹנָי שְׁמָעָה אֲדֹנָי סְלָחָה אֲדֹנָי הַקְשִׁיבָה וַעֲשֵׂה אַל־תְּאַחַר לְמַעַנְךָ אֱלֹהַי כִּי־שִׁמְךָ נִקְרָא עַל־עִירְךָ וְעַל־עַמֶּךָ׃ </tei:p>
        </tei:div>
        <j:transclude target="urn:x-opensiddur:text:poem:elohai_boshti_venikhlamti_leharim_panai"/>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_second_day/pair_after_elohai_boshti">
          <j:conditional xml:id="penitential_second_day_pair_after_elohai_boshti_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_second_day/pair_after_elohai_boshti/printed">
            <tei:pb n="106" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n213_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say <tei:foreign xml:lang="he">אֵל מֶלֶךְ</tei:foreign> and <tei:foreign xml:lang="he">וַיַּעֲבוֹר</tei:foreign> </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_second_day_pair_after_elohai_boshti_printed"/>
          <j:conditional xml:id="penitential_second_day_pair_after_elohai_boshti_expanded">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <j:transclude target="urn:x-opensiddur:text:prayer:el_melekh_yoshev"/>
          <j:transclude target="urn:x-opensiddur:text:prayer:vayaavor"/>
          <j:endConditional target="#penitential_second_day_pair_after_elohai_boshti_expanded"/>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_second_day/tashev_enosh">
          <tei:pb n="106" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n213_medium.jpg"/>
          <tei:p>תָּשֵׁב אֱנוֹשׁ עַד־דַּכָּא וַתֹּאמֶר שׁוּבוּ בְנֵי־אָדָם׃ אֶרְפָּא מְשׁוּבָתָם אֹהֲבֵם נְדָבָה כִּי־שָׁב אַפִּי מִמֶּנּוּ׃ הֲשִׁיבֵנוּ יְיָ אֵלֶיךָ וְנָשׁוּבָה · חַדֵּשׁ יָמֵינוּ כְּקֶדֶם׃ </tei:p>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_second_day/verses_after_tashev">
          <j:conditional xml:id="penitential_second_day_verses_after_tashev_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_second_day/verses_after_tashev/printed">
            <tei:pb n="106" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n213_medium.jpg"/>
            <tei:note type="instruction" xml:lang="he">רחמיך רבים · אל תבא · כרחם אב · ליי הישועה · יי צבאות עמנו · יי צבאות אשרי · יי הושיעה · כי לא על · יי שמעה </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_second_day_verses_after_tashev_printed"/>
          <j:conditional xml:id="penitential_second_day_verses_after_tashev_expanded">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div>
            <tei:milestone unit="prayer" corresp="urn:x-opensiddur:text:siddur:selichot/penitential_second_day/verses_after_tashev/expanded"/>
            <tei:p><j:transclude target="urn:x-opensiddur:text:prayer:selichot/rahamekha_rabbim" type="inline"/> <j:transclude target="urn:x-opensiddur:text:prayer:keraham_av" type="inline"/> <j:transclude target="urn:x-opensiddur:text:prayer:selichot/ki_lo_al_tsidqotenu" type="inline"/> </tei:p>
            <tei:milestone unit="prayer"/>
          </tei:div>
          <j:endConditional target="#penitential_second_day_verses_after_tashev_expanded"/>
        </tei:div>
        <j:transclude target="urn:x-opensiddur:text:poem:ashem_baalei_ashmah_haqarta_miqedem"/>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_second_day/pair_after_ashem">
          <j:conditional xml:id="penitential_second_day_pair_after_ashem_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_second_day/pair_after_ashem/printed">
            <tei:pb n="107" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n215_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say <tei:foreign xml:lang="he">אֵל מֶלֶךְ</tei:foreign> and <tei:foreign xml:lang="he">וַיַּעֲבוֹר</tei:foreign> </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_second_day_pair_after_ashem_printed"/>
          <j:conditional xml:id="penitential_second_day_pair_after_ashem_expanded">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <j:transclude target="urn:x-opensiddur:text:prayer:el_melekh_yoshev"/>
          <j:transclude target="urn:x-opensiddur:text:prayer:vayaavor"/>
          <j:endConditional target="#penitential_second_day_pair_after_ashem_expanded"/>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_second_day/atah_adonai">
          <tei:pb n="107" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n215_medium.jpg"/>
          <tei:p>אַתָּה יְיָ לֹא־תִכְלָא רַחֲמֶיךָ מִמֶּנּוּ חַסְדְּךָ וַאֲמִתְּךָ תָּמִיד יִצְּרוּנוּ׃ שׁוּבָה יִשְׂרָאֵל עַד־יְיָ־אֱלֹהֶיךָ כִּי כָשַׁלְתָּ בַּעֲוֹנֶךָ׃ כִּי שֹׁמֵעַ אֶל־אֶבְיוֹנִים יְיָ וְאֶת־אֲסִירָיו לֹא־בָזָה׃ </tei:p>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_second_day/verses_after_atah">
          <j:conditional xml:id="penitential_second_day_verses_after_atah_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/penitential_second_day/verses_after_atah/printed">
            <tei:pb n="107" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n215_medium.jpg"/>
            <tei:note type="instruction" xml:lang="he">רחמיך רבים · אל תבא · כרחם אב · ליי הישועה · יי צבאות עמנו · יי צבאות אשרי · יי הושיעה · כי לא על · יי שמעה </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_second_day_verses_after_atah_printed"/>
          <j:conditional xml:id="penitential_second_day_verses_after_atah_expanded">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="true"/>
              </tei:f>
