      <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tenth_tevet">
        <tei:pb n="174" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n349_medium.jpg"/>
        <tei:head>סליחות לעשרה בטבת׃</tei:head>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tenth_tevet/weekday_amidah">
          <tei:pb n="174" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n349_medium.jpg"/>
          <tei:note type="instruction" xml:lang="en">Prayers are said as on other week-days, adding <tei:foreign xml:lang="he">עֲנֵנוּ</tei:foreign> after <tei:foreign xml:lang="he">אַל תְּשִׁיבֵנוּ</tei:foreign> in <tei:foreign xml:lang="he">שְׁמַע קוֹלֵנוּ</tei:foreign> in the Ameedah. </tei:note>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tenth_tevet/opening_repeat">
          <j:conditional xml:id="penitential_tenth-tevet_day_opening_repeat_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tenth_tevet/opening_repeat/printed">
            <tei:pb n="174" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n349_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say from <tei:foreign xml:lang="he">סְלַח לָנוּ</tei:foreign> page 159, till <tei:foreign xml:lang="he">לְכָל־קֹרְאֶיךָ</tei:foreign> page 160, and continue with the following. </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_tenth-tevet_day_opening_repeat_printed"/>
          <j:conditional xml:id="penitential_tenth-tevet_day_opening_repeat_expanded">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <j:transclude target="urn:x-opensiddur:text:siddur:selichot/monday_fast/selah_lanu_avinu"/>
          <j:transclude target="urn:x-opensiddur:text:siddur:selichot/monday_fast/el_erekh_apayim_reprint"/>
          <j:transclude target="urn:x-opensiddur:text:siddur:selichot/monday_fast/vayaavor_reprint"/>
          <j:endConditional target="#penitential_tenth-tevet_day_opening_repeat_expanded"/>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tenth_tevet/ki_im_adonai_hahesed">
          <tei:pb n="174" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n349_medium.jpg"/>
          <tei:lg><tei:l>כִּי עִם יְיָ הַחֶסֶד ·</tei:l> <tei:l>וְהַרְבֵּה עִמּוֹ פְדוּת׃</tei:l> <tei:l>פְּדֵה אֱלֹהִים אֶת־יִשְׂרָאֵל ·</tei:l> <tei:l>מִכָּל צָרוֹתָיו׃</tei:l> <tei:l>וְהוּא יִפְדֶּה אֶת־יִשְׂרָאֵל ·</tei:l> <tei:l>מִכָּל עֲוֹנוֹתָיו׃</tei:l> <tei:l>פֹּדֶה יְיָ נֶפֶשׁ עֲבָדָיו ·</tei:l> <tei:l>וְלֹא יֶאְשְׁמוּ כָּל־הַחֹסִים בּוֹ׃</tei:l> <tei:l>כְּרַחֵם אָב עַל־בָּנִים כֵּן תְּרַחֵם יְיָ עָלֵינוּ׃</tei:l> <tei:l>לַיְיָ הַיְשׁוּעָה עַל־עַמְּךָ בִרְכָתֶךָ סֶּלָה׃</tei:l> <tei:l>יְיָ צְבָאוֹת עִמָּנוּ מִשְׂגָּב לָנוּ אֱלֹהֵי יַעֲקֹב סֶלָה׃</tei:l> <tei:l>יְיָ צְבָאוֹת אַשְׁרֵי אָדָם בֹּטֵחַ בָּךְ׃</tei:l> <tei:l>יְיָ הוֹשִׁיעָה הַמֶּלֶךְ יַעֲנֵנוּ בְיוֹם קָרְאֵנוּ׃</tei:l> </tei:lg>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tenth_tevet/selah_na">
          <tei:pb n="174" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n349_medium.jpg"/>
          <tei:p>סְלַח־נָא לַעֲוֹן הָעָם הַזֶּה כְּגֹדֶל חַסְדֶּךָ וְכַאֲשֶׁר נָשָׂאתָה לָעָם הַזֶּה מִמִּצְרַיִם וְעַד־הֵנָּה · וְשָׁם נֶאֱמַר׃ וַיֹּאמֶר יְיָ סָלַחְתִּי כִּדְבָרֶךָ׃ </tei:p>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tenth_tevet/hateh_elohai">
          <tei:pb n="174" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n349_medium.jpg"/>
          <tei:p>הַטֵּה אֱלֹהַי אָזְנְךָ וּשְׁמַע פְּקָחָה עֵינֶיךָ וּרְאֵה שֹׁמְמֹתֵינוּ וְהָעִיר אֲשֶׁר נִקְרָא שִׁמְךָ עָלֶיהָ׃ כִּי לֹא עַל־צִדְקֹתֵינוּ אֲנַחְנוּ מַפִּילִים תַּחֲנוּנֵינוּ לְפָנֶיךָ כִּי עַל־רַחֲמֶיךָ הָרַבִּים׃ אֲדֹנָי שְׁמָעָה אֲדֹנָי סְלָחָה אֲדֹנָי הַקְשִׁיבָה וַעֲשֵׂה אַל־תְּאַחַר לְמַעַנְךָ אֱלֹהַי כִּי־שִׁמְךָ נִקְרָא עַל־עִירְךָ וְעַל־עַמֶּךָ׃ </tei:p>
        </tei:div>
        <j:transclude target="urn:x-opensiddur:text:poem:ezkerah_matsoq_asher_qeraani"/>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tenth_tevet/pair_after_ezkerah">
          <j:conditional xml:id="penitential_tenth-tevet_day_pair_after_ezkerah_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tenth_tevet/pair_after_ezkerah/printed">
            <tei:pb n="175" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n351_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say <tei:foreign xml:lang="he">אֵל מֶלֶךְ</tei:foreign> and <tei:foreign xml:lang="he">וַיַּעֲבֹר</tei:foreign> </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_tenth-tevet_day_pair_after_ezkerah_printed"/>
          <j:conditional xml:id="penitential_tenth-tevet_day_pair_after_ezkerah_expanded">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <j:transclude target="urn:x-opensiddur:text:prayer:el_melekh_yoshev"/>
          <j:transclude target="urn:x-opensiddur:text:prayer:vayaavor"/>
          <j:endConditional target="#penitential_tenth-tevet_day_pair_after_ezkerah_expanded"/>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tenth_tevet/elohim_bau_goyim">
          <tei:pb n="175" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n351_medium.jpg"/>
          <tei:lg><tei:l>אֱלֹהִים בָּאוּ גוֹיִם בְּנַחֲלָתֶךָ ·</tei:l> <tei:l>טִמְּאוּ אֶת־הֵיכַל קָדְשֶׁךָ ·</tei:l> <tei:l>שָׂמוּ אֶת־יְרוּשָׁלַם לְעִיִּים׃</tei:l> <tei:l>אֱלֹהִים זֵדִים קָמוּ עָלֵינוּ וַעֲדַת עָרִיצִים בִּקְשׁוּ נַפְשֵׁנוּ וְלֹא שָׂמוּךָ לְנֶגְדָּם׃</tei:l> </tei:lg>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tenth_tevet/verses_after_elohim">
          <j:conditional xml:id="penitential_tenth-tevet_day_verses_after_elohim_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tenth_tevet/verses_after_elohim/printed">
            <tei:pb n="175" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n351_medium.jpg"/>
            <tei:note type="instruction" xml:lang="he">כרחם אב · ליי הישועה · יי צבאות עמנו · יי צבאות אשרי · יי הושיעה · כי לא על · יי שמעה׃ </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_tenth-tevet_day_verses_after_elohim_printed"/>
          <j:conditional xml:id="penitential_tenth-tevet_day_verses_after_elohim_expanded">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div>
            <tei:milestone unit="prayer" corresp="urn:x-opensiddur:text:siddur:selichot/tenth_tevet/verses_after_elohim/expanded"/>
            <tei:p><j:transclude target="urn:x-opensiddur:text:prayer:keraham_av" type="inline"/> <j:transclude target="urn:x-opensiddur:text:prayer:selichot/ki_lo_al_tsidqotenu" type="inline"/> </tei:p>
            <tei:milestone unit="prayer"/>
          </tei:div>
          <j:endConditional target="#penitential_tenth-tevet_day_verses_after_elohim_expanded"/>
        </tei:div>
        <j:transclude target="urn:x-opensiddur:text:poem:even_haroshah_leiyyim_veleharishah"/>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tenth_tevet/pair_after_even">
          <j:conditional xml:id="penitential_tenth-tevet_day_pair_after_even_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tenth_tevet/pair_after_even/printed">
            <tei:pb n="176" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n353_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say <tei:foreign xml:lang="he">אֵל מֶלֶךְ</tei:foreign> and <tei:foreign xml:lang="he">וַיַּעֲבֹר</tei:foreign> </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_tenth-tevet_day_pair_after_even_printed"/>
          <j:conditional xml:id="penitential_tenth-tevet_day_pair_after_even_expanded">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <j:transclude target="urn:x-opensiddur:text:prayer:el_melekh_yoshev"/>
          <j:transclude target="urn:x-opensiddur:text:prayer:vayaavor"/>
          <j:endConditional target="#penitential_tenth-tevet_day_pair_after_even_expanded"/>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tenth_tevet/refrain_instruction">
          <tei:head>פזמון׃</tei:head>
          <j:conditional xml:id="penitential_tenth-tevet_day_refrain_instruction_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="refrains_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tenth_tevet/refrain_instruction/printed">
            <tei:pb n="176" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n353_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Wherever the word <tei:foreign xml:lang="he">אבותי</tei:foreign> occurs at the end of the verses, repeat from <tei:foreign xml:lang="he">אֲבוֹתַי</tei:foreign> till <tei:foreign xml:lang="he">עַד הַחֹדֶשׁ הָעֲשִׂירִי</tei:foreign>. </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_tenth-tevet_day_refrain_instruction_printed"/>
        </tei:div>
        <j:transclude target="urn:x-opensiddur:text:poem:avotai_ki_vatehu_beshem_elohei_tsuri"/>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tenth_tevet/pair_after_avotai">
          <j:conditional xml:id="penitential_tenth-tevet_day_pair_after_avotai_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tenth_tevet/pair_after_avotai/printed">
            <tei:pb n="178" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n357_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say <tei:foreign xml:lang="he">אֵל מֶלֶךְ</tei:foreign> and <tei:foreign xml:lang="he">וַיַּעֲבֹר</tei:foreign> </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_tenth-tevet_day_pair_after_avotai_printed"/>
          <j:conditional xml:id="penitential_tenth-tevet_day_pair_after_avotai_expanded">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <j:transclude target="urn:x-opensiddur:text:prayer:el_melekh_yoshev"/>
          <j:transclude target="urn:x-opensiddur:text:prayer:vayaavor"/>
          <j:endConditional target="#penitential_tenth-tevet_day_pair_after_avotai_expanded"/>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tenth_tevet/conclusion_repeat">
          <j:conditional xml:id="penitential_tenth-tevet_day_conclusion_repeat_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tenth_tevet/conclusion_repeat/printed">
            <tei:pb n="178" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n357_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Continue from <tei:foreign xml:lang="he">זְכוֹר רַחֲמֶיךָ</tei:foreign> page 164, till <tei:foreign xml:lang="he">הָרַחֲמִים וְהַסְּלִיחוֹת</tei:foreign> page 167. The Reader says <tei:foreign xml:lang="he">וְאַל יְעַכֵּב</tei:foreign>, and the Service is concluded as directed in page 167. </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_tenth-tevet_day_conclusion_repeat_printed"/>
          <j:conditional xml:id="penitential_tenth-tevet_day_conclusion_repeat_expanded">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
