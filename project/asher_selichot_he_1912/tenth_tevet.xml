          <j:transclude target="urn:x-opensiddur:text:siddur:selichot/monday_fast/zekhor_lanu_berit_rishonim"/>
          <j:transclude target="urn:x-opensiddur:text:siddur:selichot/monday_fast/shema_qolenu_reprint"/>
          <j:transclude target="urn:x-opensiddur:text:siddur:selichot/monday_fast/amarenu_haazinah_reprint"/>
          <j:transclude target="urn:x-opensiddur:text:siddur:selichot/monday_fast/tavo_tefillatenu_reprint"/>
          <j:transclude target="urn:x-opensiddur:text:siddur:selichot/monday_fast/ashamnu_reprint"/>
          <j:transclude target="urn:x-opensiddur:text:siddur:selichot/monday_fast/hirshanu_ufashanu"/>
          <j:transclude target="urn:x-opensiddur:text:siddur:selichot/monday_fast/mashiah_tsidqekha"/>
          <j:transclude target="urn:x-opensiddur:text:siddur:selichot/monday_fast/veal_yeakkev"/>
          <j:transclude target="urn:x-opensiddur:text:siddur:selichot/monday_fast/conclusion"/>
          <j:endConditional target="#penitential_tenth-tevet_day_conclusion_repeat_expanded"/>
        </tei:div>
      </tei:div>
    </tei:body>
