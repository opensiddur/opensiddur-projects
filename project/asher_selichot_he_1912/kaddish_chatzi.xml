  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:kaddish/chatzi">
        <tei:pb n="3" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n7_medium.jpg"/>
        <tei:p corresp="urn:x-opensiddur:text:prayer:kaddish/yitgadal">יִתְגַּדַּל וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא בְּעָלְמָא דִּי בְרָא כִרְעוּתֵהּ וְיַמְלִיךְ מַלְכוּתֵהּ בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן וּבְחַיֵּי דְכָל־בֵּית יִשְׂרָאֵל בַּעֲגָלָא וּבִזְמַן קָרִיב וְאִמְרוּ אָמֵן׃</tei:p>
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:prayer:kaddish/yehe_shmeh"/>יְהֵא שְׁמֵהּ רַבָּא מְבָרַךְ לְעָלַם וּלְעָלְמֵי עָלְמַיָּא׃ <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:prayer:kaddish/yitbarakh"/>יִתְבָּרַךְ וְיִשְׁתַּבַּח וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְנַשֵּׂא וְיִתְהַדָּר וְיִתְעַלֶּה וְיִתְהַלָּל שְׁמֵהּ דְּקֻדְשָׁא בְּרִיךְ הוּא לְעֵלָּא<j:conditional xml:id="asher_half_kaddish_ten_days"><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="aseret-ymei-tshuva"><tei:binary value="true"/></tei:f></tei:fs></j:conditional> לְעֵלָּא<j:endConditional target="#asher_half_kaddish_ten_days"/> מִן כָּל בִּרְכָתָא וְשִׁירָתָא תֻּשְׁבְּחָתָא וְנֶחֱמָתָא דַּאֲמִירָן בְּעָלְמָא וְאִמְרוּ אָמֵן׃ </tei:p>
