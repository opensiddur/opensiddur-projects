      <tei:div corresp="urn:x-opensiddur:text:prayer:mahi_umasi">
        <tei:pb n="23" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n47_medium.jpg"/>
        <tei:lg><tei:l>מָחֵי וּמַסֵּי מֵמִית וּמְחַיֶּה ·</tei:l> <tei:l>מַפִּיק מִשְׁאוֹל לְחַיֵּי־עָלְמָא ·</tei:l> <tei:l>בְּרָא כְּדַחֲטֵי אַבוּהִי לָקְיֵהּ ·</tei:l> <tei:l>אַבוּהִי דְּחָיִס מַסֵּי לִכְאֵבֵהּ ·</tei:l> <tei:l>עַבְדָּא דְּמָרִיד נָפִיק בְּקוֹלָר ·</tei:l> <tei:l>מָרֵיהּ תָּאִיב וְתָבַר קוֹלָרֵיהּ ·</tei:l> <tei:l>בְּרָךְ בּוּכְרָךְ אֲנַן וְחָטִינַן קָמָךְ ·</tei:l> <tei:l>אוֹיוּ נַפְשִׁין בְּגַיְדִין מְרִירִין ·</tei:l> <tei:l>עַבְדָךְ אֲנַן וּמָרְדִינַן קָמָךְ ·</tei:l> <tei:l>הָא בְּבִזְתָא הָא בְּשִׁבְיְתָא וְהָא בְּמַלְקָיוּתָא ·</tei:l> <tei:l>בְּמָטוּ מִנָּךְ בְּרַחֲמָךְ דְּנָפִישִׁין ·</tei:l> <tei:l>אַסֵּי לִכְאֵבִין דְּתָקִיף עֲלַן עַד דְּלָא נֶהֱוֵי גְמִירָא בְּשִׁבְיָא׃</tei:l> </tei:lg>
