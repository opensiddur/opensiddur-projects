      <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/first_day">
        <tei:pb n="[unnumbered]" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n5_medium.jpg"/>
        <tei:head>סליחות ליום ראשון</tei:head>
        <tei:note type="instruction" xml:lang="en">The <tei:foreign xml:lang="he">סְלִיחוֹת</tei:foreign> (Propitiatory Prayers) are commenced on the Sunday before <tei:foreign xml:lang="he">רֹאשׁ הַשָּׁנָה</tei:foreign> (New Year), except when the Festival occurs on Monday or Tuesday, when they are begun instead on the Sunday week previous to the festival.</tei:note>
        <tei:note type="instruction" xml:lang="en">These Prayers are said at an early hour before the Morning Service.</tei:note>
        <tei:note type="instruction" xml:lang="en">The following Prayers, till <tei:foreign xml:lang="he">כִּי רַב הוּא</tei:foreign> page 7, are said every day before the <tei:foreign xml:lang="he">סְלִיחוֹת</tei:foreign> until <tei:foreign xml:lang="he">עֶרֶב יוֹם כִּפּוּר</tei:foreign>.</tei:note>
        <j:transclude target="urn:x-opensiddur:text:prayer:ashrei"/>
        <tei:note type="instruction" xml:lang="en">The Reader says the following Kaddish—</tei:note>
        <tei:note type="instruction" xml:lang="en">From <tei:foreign xml:lang="he">וְעַתָּה</tei:foreign> till <tei:foreign xml:lang="he">הֵמָּה</tei:foreign> is said in an under tone.</tei:note>
