      <tei:div corresp="urn:x-opensiddur:text:poem:ein_kemidat_basar_midotekha">
        <tei:pb n="38" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n77_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אֵין כְּמִדַּת בָּשָׂר מִדּוֹתֶיךָ ·</tei:l> <tei:l>אַיֵּה קִנְאָתְךָ וַעֲצַת עֲמִידָתֶךָ ·</tei:l> <tei:l>בַּת בָּחַרְתָּ לְבֵית חֶמְדָּתֶךָ ·</tei:l> <tei:l>בְּעָלֶיהָ אֲדוֹנִים וְאֵין לְצִמִּיתָתְךָ ·</tei:l> <tei:l>גּוֹעָה לְדוֹדִי אֲנִי מְאֹרֶסֶת ·</tei:l> <tei:l>גּוֹעַל רוֹדִי אֵיךְ נִדְרֶסֶת ·</tei:l> <tei:l>דִּין הֶרֶג לְעַצְמָהּ מְקַנֶּסֶת ·</tei:l> <tei:l>דְּחוּיָה וְגַם כִּי־נֶאֱנֶסֶת׃</tei:l> <tei:l>הָאֵם בְּלִי סֵפֶר לְשִׁלּוּחַ ·</tei:l> <tei:l>הַבֵּן כְּיָתוֹם אוֹבֵד שָׁלוּחַ ·</tei:l> <tei:l>וְגַן־נָעוּל הֶפְקֵר כַּמְלוֹחַ ·</tei:l> <tei:l>וּמַעְיָן הֶחָתוּם נִרְפַּס הֲלוֹךְ׃</tei:l> <tei:l>זַעַם כְּרֶגַע וְעַתָּה לַהֲפוֹךְ ·</tei:l> <tei:l>זְרִי־קֹדֶשׁ חוּצָה לִשְׁפּוֹךְ ·</tei:l> <tei:l>חֶבְרַת־רֵעַ חֲשׁוּבָה עֲזוּבָה כְּקוֹרַעַת בַּפּוּךְ׃</tei:l> <tei:l>טוֹב הַתּוֹאַר קַדְרוּנִית מְפָרֶךְ ·</tei:l> <tei:l>טְרִיָּה מַכָּה מִבְּלִי־אָרֵךְ ·</tei:l> <tei:l>יוֹם נָקָם נִכְסָם הָרֵךְ ·</tei:l> <tei:l>יוֹם שִׁלּוּם נִחָסָם חָרֵךְ׃</tei:l> <tei:l>כֹּחַ הַסַּבָּל הִכְשִׁיל נֶטֶל כָּבוּל וְשָׁכוּל הַנִּשְׁאָר מִקְטֵל ·</tei:l> <tei:l>לְלֹא לְמַרְגּוֹעַ נָד וּמְטֻלְטָל ·</tei:l> <tei:l>לֶעָמָל וְיָגֵעַ וְאַחֵר נוֹטֵל׃</tei:l> <tei:l>מַטַּע קֶרֶן שֶׁמֶן הַמֻּרְשָׁן מִרְמָס מַדּוּעַ כַּחֲרוּלֵי־כִבְשָׁן ·</tei:l> <tei:l>נוֹצֵר לְמַעֲלָה לֹא יִישָׁן נִטְעוֹ לְמָשְׁלָה פָּרוֹת הַבָּשָׁן׃</tei:l> <tei:l>שׂוֹרֵקָה מַדְבֵּצַע וְנִקְטֶפֶת ·</tei:l> <tei:l>סוֹרַחַת מַה־יִתְרוֹן וְנֶחְטֶפֶת ·</tei:l> <tei:l>עָל־יָדְךָ חֲקוּקָה וְטוֹטֶפֶת עַל־מָה אַהֲבָתָהּ נִשְׁמֶטֶת׃</tei:l> <tei:l>פְּעֻלַּת הָרוֹבִים בִּמְעוּט־מְלָאכְת ·</tei:l> <tei:l>פְּרָעַת שָׂכָר רָבָה וְהוֹלֶכֶת ·</tei:l> <tei:l>צוֹפָה הַפְּנוֹת וְעַתָּה נִמְשֶׁכֶת ·</tei:l> <tei:l>צָרָה פְּקוּדָה וְאַחֶרֶת נִסְמֶכֶת׃</tei:l> <tei:l>קֹדֶשׁ רֵאשִׁית עֲרֵמַת־שְׁעֹרִים ·</tei:l> <tei:l>קְצוֹת אֶרֶץ זְרוּיִים כִּשְׁעֹרִים ·</tei:l> <tei:l>רוּחַ מְנַשֶּׁבֶת בַּעֲלֵי־יְעָרִים ·</tei:l> <tei:l>רָדוּף נִשְׁמַט נָסִים וְנִסְעָרִים׃</tei:l> <tei:l>שְׁמוֹנָה וְתִשְׁעִים הָאָלוֹת הָאֵלֶּה ·</tei:l> <tei:l>שָׁלְמוּ אֵלֶּה כָּאֵלֶּה <tei:pb n="39" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n79_medium.jpg"/>וְכָאֵלֶּה ·</tei:l> <tei:l>תְּרַחֵם תְּקַבְּצֵנוּ מִקְּרָנוֹת אֵלֶּה ·</tei:l> <tei:l>אָז יֹאמְרוּ בַגּוֹיִם הִגְדִּיל יְיָ לַעֲשׂוֹת עִם־אֵלֶּה׃</tei:l> </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
