      <tei:div corresp="urn:x-opensiddur:text:poem:amanta_meaz_areshet_sefatayim">
        <tei:pb n="95" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n191_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו</tei:l> <tei:l>אָמַנְתָּ מֵאָז אֲרֶשֶׁת שְׂפָתָיִם ·</tei:l> <tei:l>בִּתְפִלָּה וּבְתַחֲנוּן דְּפֹק שַׁעֲרֵי־דְלָתַיִם ·</tei:l> <tei:l>גִּשְׁתֵּנוּ עָדֶיךָ בִּזְרוֹעוֹת וְלֹא־בְעַצְלְתַּיִם <tei:pb n="96" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n193_medium.jpg"/>דְּחוֹת רוֹעַ־פּוּרְעָנִיּוֹת הַמִּתְרַגְּשׁוֹת לְעִתּוֹתַיִם׃</tei:l> <tei:l>הִנְנוּ אָתָנוּ לָךְ בְּשִׁבְרוֹן רוּחַ וּדְכָאוֹת לֵב ·</tei:l> <tei:l>וְדוֹת לְפָנֶיךָ כָּל־פְּתוּל וְעִקְּשׁוּת־לֵב ·</tei:l> <tei:l>זֶה חוֹקֵר לְבָבוֹת הָרוֹפֵא לִשְׁבוּרֵי־לֵב ·</tei:l> <tei:l>חַדֵּשׁ נָכוֹן בְּקִרְבֵּנוּ וּבְרָא־לָנוּ טָהוֹר־לֵב׃</tei:l> <tei:l>מִכְּסַת מִקֶּדֶם אֵלּוּ יָמִים עֲשָׂרָה ·</tei:l> <tei:l>יָחִיד בָּהּ לָשׁוּב וְלִמְצֹא כַפָּרָה ·</tei:l> <tei:l>כָּל־הַשָּׁנָה כֻּלָּהּ לְרַבִּים מְסוּדָרָה ·</tei:l> <tei:l>לִשְׁוֹעַ וְלֵעָנוֹת בְּכָל־עֵת צוּקָה וְצָרָה׃</tei:l> <tei:l>מִהֵר הַיָּחִיד וְשָׁב בֵּנְתַיִם מוֹחֲלִין־לוֹ ·</tei:l> <tei:l>נוֹאָשׁ וְלֹא־שָׁב אֵין תְּקוּנָה לְעוֹוּלוֹ ·</tei:l> <tei:l>סָדַר וְעָרַךְ כָּל־אֵילֵי־נְבָיוֹת לְהוֹעִילוֹ ·</tei:l> <tei:l>עוֹתֵר וְצוֹעֵק וְאֵין־שׁוֹמֵעַ־לוֹ׃</tei:l> <tei:l>פְּגִיעַת־הָרַבִּים וְהַיָּחִיד לְךָ־לְבַד עוֹלָה ·</tei:l> <tei:l>צוּר כִּי אַתָּה שׁוֹמֵעַ תְּפִלָּה ·</tei:l> <tei:l>קַבְּלֵנוּ בְרָצוֹן וְהַמְצִיאֵנוּ מְחִילָה ·</tei:l> <tei:l>רְצֵנוּ כְקָרְבַּן כָּלִיל וְעוֹלָה׃</tei:l> <tei:l>שְׁפוֹט תִּשְׁפּוֹט אוֹתָנוּ בְּרַחֲמָנוּת וְחֶמְלָה ·</tei:l> <tei:l>בְּנֵי יְחוּסֶיךָ לְקוֹחִים־לְךָ לִסְגֻלָּה ·</tei:l> <tei:l>יֹקֶשׁ־מְרָרִים יוּצְלַל בִּמְצוּלָה ·</tei:l> <tei:l>נֶצַח לְהַלֶּלְךָ בְכָל־מִינֵי תְהִלָּה׃</tei:l> </tei:lg>
      </tei:div>
