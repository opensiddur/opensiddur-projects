      <tei:div corresp="urn:x-opensiddur:text:poem:taanit_tsibbur_qaveu">
        <tei:pb n="168" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n337_medium.jpg"/>
        <tei:lg><tei:l>אלהינו ואלהי אבותינו תַּעֲנִית צִבּוּר קָבְעוּ תְּבוֹעַ צְרָכִים ·</tei:l> <tei:l>שָׁב עָרֹךְ חַפֵּשׂ וְלַחֲקוֹר דְּרָכִים ·</tei:l> <tei:l>רַךְ לְרַצּוֹת בִּשְׁלשׁ עֶשְׂרֵה עֲרָכִים ·</tei:l> <tei:l>קָשֶׁה לִכְעוֹס תַּת לְאַפַּיִם אֲרָכִים׃</tei:l> <tei:l>צְדָדֶיךָ מְקֻשָּׁטִים עֵרֹם בְּלִי תַפְשִׁיט ·</tei:l> <tei:l>פְּאֵר הָרַחֲמִים וְהַסְּלִיחוֹת הוֹד תַּכְשִׁיט ·</tei:l> <tei:l>עֲרֹךְ שַׁוְעָתֵינוּ לְךָ לְבַד נוֹשִׁיט ·</tei:l> <tei:l>סֶדֶר הַחַיִּים וּפַרְנָסָה לִיצוּרִים תּוֹשִׁיט׃</tei:l> <tei:l>נִסְתְּמָה הַבִּירָה וְנִתְרוֹקֵן טוֹהַר הַשֻּׁלְחָן ·</tei:l> <tei:l>מִיַּיִן וּמֹחַ סָתַר מֵעֲבוֹדַת פֻּלְחָן לִשְׁפִיכַת הַנֶּפֶשׁ חֲשׁוֹב כְּבָשִׁית׃</tei:l> <tei:l>צִלְחֵן כְּמַעְתִּיר וּמִשְׂבֵּעַ גּוֹאֵל וְרוֹפֵא וְסַלְחָן׃</tei:l> <tei:l>יָאוּת לְךָ יַעַן מִמָּנָתְךָ נִשְׁכַּחַת ·</tei:l> <tei:l>טוּב וִיחֻדְּךָ הֱיוֹת נִזּוֹנִית וּמִתְפַּרְנֶסֶת ·</tei:l> <tei:l>חֵלֶף לְךָ שׁוֹאֶלֶת קוֹבֶלֶת וּמִתְנוֹסֶסֶת ·</tei:l> <tei:l>זְכוֹר דַּאֲוֹתֶיהָ לְפָנֶיךָ מְשִׂיחָה וּמְכַסֶּסֶת׃</tei:l> <tei:l>וְאֵלֶיךָ הִיא נְשִׁיָּה וּבְךָ חֲסִיָּה ·</tei:l> <tei:pb n="169" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n339_medium.jpg"/><tei:l>הַוּוֹתֶיהָ הַעֲבֵר מִי כָמוֹךָ חֲסִין יָהּ ·</tei:l> <tei:l>דֶּרֶךְ אֱמוּנָתְךָ בְּחַלְּקָךְ לִלְגִיוֹנָךְ אַפְסַנְיָא ·</tei:l> <tei:l>גְּמוֹל חֶסֶד לַעֲלוּבָה הַלָּזוּ אַכְסַנְיָא׃</tei:l> <tei:l>בְּקִיאִים וּמְיֻשָּׁבִים לְרַצּוֹתְךָ בִּדְבָרִים עֲרֵבִים ·</tei:l> <tei:l>אָפֵסוּ פָסוּ בְּכֹחָם קָטֵגוֹר מְעַרְבְּבִים מֵאוֹהֲבֵי לַאֲבִיהֶם שֶׁבַּשָּׁמַיִם זְרִיזִים וּמְעֹרָבִים ·</tei:l> <tei:l>יְרָאוּ נִדְבָּרִים הָתוּ שַׁחֲרִים וַעֲרָבִים׃</tei:l> <tei:l>הִקְדַּשְׁנוּ צוֹם עוֹלְלִים וְזִקְנֵי אֲסֻפּוֹת ·</tei:l> <tei:l>יִשַּׁרְנוּ רִנָּה וּתְפִלָּה וְשָׁקַדְנוּ שָׂפוֹת ·</tei:l> <tei:l>חֲשׂוֹךְ לְמַטָּה מֵעָוֹן וּשְׁלוֹמֵנוּ הַשְׁפּוֹת ·</tei:l> <tei:l>וּזְקוֹף דַּל מֵעָפָר וְאֶבְיוֹן מֵאַשְׁפּוֹת׃</tei:l> <tei:l>בְּתוֹר הַמַּעֲלָה וּבְמָרוֹת הֲגוּנוֹת תְרוּמוֹת ·</tei:l> <tei:l>עַרְבָתֵנוּ שִׂים לְטוֹב יוֹשֵׁב מְרוֹמוֹת ·</tei:l> <tei:l>וּבְמִקְוֵה טוֹהַר תָּדִיחַ קַלּוֹת וְרָמוֹת ·</tei:l> <tei:l>מְצוֹא תְפִלָּתֵנוּ חֶסֶד לְאָרְךָ רוֹמְמוֹת׃</tei:l> </tei:lg>
      </tei:div>
