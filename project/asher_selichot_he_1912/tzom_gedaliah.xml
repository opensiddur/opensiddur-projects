        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tzom_gedaliah/selah_lanu_avinu">
          <tei:pb n="91" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n183_medium.jpg"/>
          <tei:lg><tei:l>סְלַח־לָנוּ אָבִינוּ כִּי בְרֹב אִוַּלְתֵּנוּ שָׁגִינוּ ·</tei:l> <tei:l>מְחַל־לָנוּ מַלְכֵּנוּ כִּי־רַבּוּ עֲוֹנֵינוּ׃</tei:l> </tei:lg>
        </tei:div>
