    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:bematei_mispar_hillinu_fanekha"><tei:pb n="182" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n365_medium.jpg"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bematei_mispar_hillinu_fanekha/stanza_1"/><tei:lg><tei:l>בְּמַתֵּי מִסְפָּר חִלִּינוּ פָנֶיךָ ·</tei:l> <tei:l>לְשַׁוְעַת נְכָאִים אַל־תַּעְלֵם אָזְנֶיךָ ·</tei:l> <tei:l>הַקְשֵׁב תְּחִנָּתָם מִשְּׁמֵי מְעוֹנֶךָ ·</tei:l> <tei:l>כְּבִימֵי מוֹר וַהֲדַס הוֹשַׁעְתָּ בָּנֶיךָ׃</tei:l> </tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bematei_mispar_hillinu_fanekha/stanza_2"/><tei:lg><tei:l>תְּהִלּוֹת יִשְׂרָאֵל אַתָּה יוֹשֵׁב ·</tei:l> <tei:l>שַׁוְעָתָם מַאֲזִין וְרִנָּתָם קוֹשֵׁב ·</tei:l> <tei:l>רְפוּאוֹת לְמַחַץ מַקְדִּים וּמֵשִׁיב ·</tei:l> <tei:l>קִנְיָנְךָ לְהֵטִיב וּנְוֵיהֶם לְיַשֵּׁב׃</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>במתי</tei:abbr><tei:expan>בְּמַתֵּי מִסְפָּר חִלִּינוּ פָנֶיךָ · לְשַׁוְעַת נְכָאִים אַל־תַּעְלֵם אָזְנֶיךָ · הַקְשֵׁב תְּחִנָּתָם מִשְּׁמֵי מְעוֹנֶךָ · כְּבִימֵי מוֹר וַהֲדַס הוֹשַׁעְתָּ בָּנֶיךָ׃</tei:expan></tei:choice></tei:seg></tei:l> </tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bematei_mispar_hillinu_fanekha/stanza_3"/><tei:lg><tei:l>וְאוֹיֵב צַר הִלְטִישׁ עֵינֵי ·</tei:l> <tei:l>פִּיהוּ פָעַר לִשְׁאוֹף עָנִי ·</tei:l> <tei:l>עָשַׁת בְּשֶׁלּוֹ לְהַשְׁמִיד קָהָל וַהֲמוֹנַי ·</tei:l> <tei:l>סֶגֶל לְאַבֵּד חָרַת בְּנִשְׁתְּוָנָיו׃</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>במתי</tei:abbr><tei:expan>בְּמַתֵּי מִסְפָּר חִלִּינוּ פָנֶיךָ · לְשַׁוְעַת נְכָאִים אַל־תַּעְלֵם אָזְנֶיךָ · הַקְשֵׁב תְּחִנָּתָם מִשְּׁמֵי מְעוֹנֶךָ · כְּבִימֵי מוֹר וַהֲדַס הוֹשַׁעְתָּ בָּנֶיךָ׃</tei:expan></tei:choice></tei:seg></tei:l> </tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bematei_mispar_hillinu_fanekha/stanza_4"/><tei:lg><tei:l>נוֹקֵם לְצָרִים וְנוֹטֵר לְאוֹיְבִים ·</tei:l> <tei:l>מִדָּתָם מָדַדְתָּ כָּזָדוּ לַאֲהוּבִים ·</tei:l> <tei:pb n="183" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n367_medium.jpg"/><tei:l>לָהֶם וְנִינָיו הוּתְלוּ צְלוּבִים ·</tei:l> <tei:l>כִּבְחֲרוּזוֹת דָּגִים חָרוּזוּ תְּחוּבִים׃</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>במתי</tei:abbr><tei:expan>בְּמַתֵּי מִסְפָּר חִלִּינוּ פָנֶיךָ · לְשַׁוְעַת נְכָאִים אַל־תַּעְלֵם אָזְנֶיךָ · הַקְשֵׁב תְּחִנָּתָם מִשְּׁמֵי מְעוֹנֶךָ · כְּבִימֵי מוֹר וַהֲדַס הוֹשַׁעְתָּ בָּנֶיךָ׃</tei:expan></tei:choice></tei:seg></tei:l> </tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bematei_mispar_hillinu_fanekha/stanza_5"/><tei:lg><tei:l>יוֹם אֲשֶׁר שִׂבְּרוּ צוֹרְרִים ·</tei:l> <tei:l>טִבְחָה לָשִׁית בְּעַם נְצוּרִים ·</tei:l> <tei:l>הֻחְלְפָה הַדָּת וְנָפְלוּ פְגָרִים ·</tei:l> <tei:l>זוֹלְעֲפוּ וְנִזְעֲמוּ מוּבָסִים וּמוּגָרִים׃</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>במתי</tei:abbr><tei:expan>בְּמַתֵּי מִסְפָּר חִלִּינוּ פָנֶיךָ · לְשַׁוְעַת נְכָאִים אַל־תַּעְלֵם אָזְנֶיךָ · הַקְשֵׁב תְּחִנָּתָם מִשְּׁמֵי מְעוֹנֶךָ · כְּבִימֵי מוֹר וַהֲדַס הוֹשַׁעְתָּ בָּנֶיךָ׃</tei:expan></tei:choice></tei:seg></tei:l> </tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bematei_mispar_hillinu_fanekha/stanza_6"/><tei:lg><tei:l>וּבְכֵן יִתְעַלֶּה שִׁמְךָ וְיִתְנַשָּׂא ·</tei:l> <tei:l>הוֹדְךָ שְׁמֵי שָׁמַיִם כִּסָּה ·</tei:l> <tei:l>דַּכִּים בְּרוֹמְמָךְ נְתוּנִים לִמְשִׁיסָּה ·</tei:l> <tei:l>גֵּיא וְאַפְסֵי תֵבֵל תְּהִלָּתֶךָ מְכַסָּה׃</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>במתי</tei:abbr><tei:expan>בְּמַתֵּי מִסְפָּר חִלִּינוּ פָנֶיךָ · לְשַׁוְעַת נְכָאִים אַל־תַּעְלֵם אָזְנֶיךָ · הַקְשֵׁב תְּחִנָּתָם מִשְּׁמֵי מְעוֹנֶךָ · כְּבִימֵי מוֹר וַהֲדַס הוֹשַׁעְתָּ בָּנֶיךָ׃</tei:expan></tei:choice></tei:seg></tei:l> </tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bematei_mispar_hillinu_fanekha/stanza_7"/><tei:lg><tei:l>בִּינָה הֲגִיגֵנוּ עַתָּה ·</tei:l> <tei:l>וּרְאֵה בְעָנְיִי כְּאַפֵּךְ קוֹמָתָה ·</tei:l> <tei:l>עַל־צוּר הַצֵּר אָדוֹן קְרָאנוּךָ מִן־הַמֵּצַר ·</tei:l> <tei:l>אָנָּא הוֹצִיאֵנוּ לַמֶּרְחָב וְחַלְּצֵנוּ מִצָּר׃</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>במתי</tei:abbr><tei:expan>בְּמַתֵּי מִסְפָּר חִלִּינוּ פָנֶיךָ · לְשַׁוְעַת נְכָאִים אַל־תַּעְלֵם אָזְנֶיךָ · הַקְשֵׁב תְּחִנָּתָם מִשְּׁמֵי מְעוֹנֶךָ · כְּבִימֵי מוֹר וַהֲדַס הוֹשַׁעְתָּ בָּנֶיךָ׃</tei:expan></tei:choice></tei:seg></tei:l> </tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bematei_mispar_hillinu_fanekha/stanza_8"/><tei:lg><tei:l>מָאוֹר תַּרְבֶּה לָנוּ מְחִילָה ·</tei:l> <tei:l>שְׁמַע תְּפִלָּה וְהַעֲבֵר תִּפְלָה ·</tei:l> <tei:l>לוֹחֲצֵינוּ מְעַךְ וּמְלָאָם חַלְחָלָה ·</tei:l> <tei:l>מִמֶּנּוּ רַחֲמֶיךָ לֹא־תִכְלָא׃</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>במתי</tei:abbr><tei:expan>בְּמַתֵּי מִסְפָּר חִלִּינוּ פָנֶיךָ · לְשַׁוְעַת נְכָאִים אַל־תַּעְלֵם אָזְנֶיךָ · הַקְשֵׁב תְּחִנָּתָם מִשְּׁמֵי מְעוֹנֶךָ · כְּבִימֵי מוֹר וַהֲדַס הוֹשַׁעְתָּ בָּנֶיךָ׃</tei:expan></tei:choice></tei:seg></tei:l> </tei:lg> <tei:milestone unit="stanza"/></tei:div>
    </tei:body>
  </tei:text>
