      <tei:div corresp="urn:x-opensiddur:text:poem:bein_keseh_leasor"><tei:pb n="111" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n223_medium.jpg"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bein_keseh_leasor/stanza_1"/><tei:lg><tei:l><tei:seg type="refrain">בֵּין כֶּסֶה לֶעָשׂוֹר ·</tei:seg></tei:l> <tei:l><tei:seg type="refrain">הִשְׁלַכְנוּ רֹעַ שְׂאוֹר ·</tei:seg></tei:l> <tei:l><tei:seg type="refrain">צַדְּקֵנוּ בְּמִשְׁפָּט <tei:pb n="112" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n225_medium.jpg"/>בְּאוֹר הַחַיִּים לָאוֹר ·</tei:seg></tei:l> <tei:l><tei:seg type="refrain">הִנְנוּ אָתָנוּ־לְךָ אַדִּיר וְנָאוֹר ·</tei:seg></tei:l> <tei:l><tei:seg type="refrain">כִּי־עִמְּךָ מְקוֹר חַיִּים בְּאוֹרְךָ נִרְאֶה אוֹר׃</tei:seg></tei:l> </tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bein_keseh_leasor/stanza_2"/><tei:lg><tei:l>אָדוֹן עִמְּךָ־סְלִיחָה ·</tei:l> <tei:l>סְלַח־וּמְחַל לְשָׁבֶיךָ ·</tei:l> <tei:l>לְעֵת־הֵחָתֵם גְּזַר־דִּינְךָ ·</tei:l> <tei:l>לְטוֹבָה זָכְרָה־אֲהוּבֶיךָ ·</tei:l> <tei:l>יִוָּדַע כִּי־אֱלֹהִים בִּישֻׁרוּן קְרוֹבֶיךָ ·</tei:l> <tei:l>וְשִׂימֵנוּ כְּחוֹתָם עַל־לִבֶּךָ׃</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>בין כסה</tei:abbr><tei:expan>בֵּין כֶּסֶה לֶעָשׂוֹר · הִשְׁלַכְנוּ רֹעַ שְׂאוֹר · צַדְּקֵנוּ בְּמִשְׁפָּט בְּאוֹר הַחַיִּים לָאוֹר · הִנְנוּ אָתָנוּ־לְךָ אַדִּיר וְנָאוֹר · כִּי־עִמְּךָ מְקוֹר חַיִּים בְּאוֹרְךָ נִרְאֶה אוֹר׃</tei:expan></tei:choice></tei:seg></tei:l> </tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bein_keseh_leasor/stanza_3"/><tei:lg><tei:l>עֲרֹבָה לְטוֹב־תַּעֲרוֹב ·</tei:l> <tei:l>צוּו נִכְתָּמָם־לְמָחֳקָה ·</tei:l> <tei:l>זָכְרָה מְצוּקֵי־תֵבֵל פְּעֻלָּתָם אָבְד־פָּסְקָה ·</tei:l> <tei:l>רַחֵם בְּרֹגֶז־תִּזְכֹּר בָּנֶיךָ עֵת חֲקִיקָה ·</tei:l> <tei:l>כָּתְבָה עַל־לוּחַ אוֹתָם וְעַל־סֵפֶר חֻקָּה׃</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>בין כסה</tei:abbr><tei:expan>בֵּין כֶּסֶה לֶעָשׂוֹר · הִשְׁלַכְנוּ רֹעַ שְׂאוֹר · צַדְּקֵנוּ בְּמִשְׁפָּט בְּאוֹר הַחַיִּים לָאוֹר · הִנְנוּ אָתָנוּ־לְךָ אַדִּיר וְנָאוֹר · כִּי־עִמְּךָ מְקוֹר חַיִּים בְּאוֹרְךָ נִרְאֶה אוֹר׃</tei:expan></tei:choice></tei:seg></tei:l> <tei:l>בְּתַחֲנוּנִים כְּרָשׁ־וְדָל לְפָנֶיךָ קָרְבוּ ·</tei:l> <tei:l>רְאֵה־עָנְיָם מוֹרֶה מְאֹד בְּלַחַץ בְּשֶׁפֶל יָשָׁבוּ ·</tei:l> <tei:l>בְּיוֹם חַפֵּשׂ־תַּעֲלוּמוֹת עֶלְיוֹן כָּךְ יִיטָבוּ ·</tei:l> <tei:l>וְעַל־סִפְרְךָ כֻּלָּם יִכָּתֵבוּ׃</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>בין כסה</tei:abbr><tei:expan>בֵּין כֶּסֶה לֶעָשׂוֹר · הִשְׁלַכְנוּ רֹעַ שְׂאוֹר · צַדְּקֵנוּ בְּמִשְׁפָּט בְּאוֹר הַחַיִּים לָאוֹר · הִנְנוּ אָתָנוּ־לְךָ אַדִּיר וְנָאוֹר · כִּי־עִמְּךָ מְקוֹר חַיִּים בְּאוֹרְךָ נִרְאֶה אוֹר׃</tei:expan></tei:choice></tei:seg></tei:l> </tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bein_keseh_leasor/stanza_4"/><tei:lg><tei:l>שׁוֹחֲרֶיךָ הַמְצֵא לְחַנְנָם ·</tei:l> <tei:l>עוֹמְדִים הַשְׁכֵּם לְבַל יָעוֹז קָטֵגוֹר בְּעֵינֶיךָ בְּלִי־יַחְכֵּם ·</tei:l> <tei:l>מְלִיצִים וּפְרַקְלִיטִים בְּחַסְדְּךָ עִמָּם הַסְכֵּם ·</tei:l> <tei:l>כָּתְבוּ עַל־הַיְּהוּדִים כַּטּוֹב בְּעֵינֵיכֶם׃</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>בין כסה</tei:abbr><tei:expan>בֵּין כֶּסֶה לֶעָשׂוֹר · הִשְׁלַכְנוּ רֹעַ שְׂאוֹר · צַדְּקֵנוּ בְּמִשְׁפָּט בְּאוֹר הַחַיִּים לָאוֹר · הִנְנוּ אָתָנוּ־לְךָ אַדִּיר וְנָאוֹר · כִּי־עִמְּךָ מְקוֹר חַיִּים בְּאוֹרְךָ נִרְאֶה אוֹר׃</tei:expan></tei:choice></tei:seg></tei:l> </tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bein_keseh_leasor/stanza_5"/><tei:lg><tei:l>הֵן רוּחַ וְלֵב־עַמְּךָ שְׁבוּר וְחוֹלֶה ·</tei:l> <tei:l>הֵם חַטָּאת וְאָשָׁם וְנֶדֶר אֲשֶׁר יִפָּלֵא ·</tei:l> <tei:l>אֱמוּנִים וּבֵינוֹנִים רַחוּם חוֹתָם מַלֵּא ·</tei:l> <tei:l>אֵלֶּה לְחַיֵּי עוֹלָם וָאֵלֶּה׃</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>בין כסה</tei:abbr><tei:expan>בֵּין כֶּסֶה לֶעָשׂוֹר · הִשְׁלַכְנוּ רֹעַ שְׂאוֹר · צַדְּקֵנוּ בְּמִשְׁפָּט בְּאוֹר הַחַיִּים לָאוֹר · הִנְנוּ אָתָנוּ־לְךָ אַדִּיר וְנָאוֹר · כִּי־עִמְּךָ מְקוֹר חַיִּים בְּאוֹרְךָ נִרְאֶה אוֹר׃</tei:expan></tei:choice></tei:seg></tei:l> </tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bein_keseh_leasor/stanza_6"/><tei:lg><tei:l>לֹא לְפִי־רְאוּיִים תִּשְׁפּוֹט־הֲמוֹנָי ·</tei:l> <tei:l>יְשֻׁרוּן מְיַחֲדֶיךָ אַף־בְּלַחַץ מוֹנָי ·</tei:l> <tei:l>גְּלִיפַת־כְּתַב־צַוָּה לִשְׁבַח וְלֹא לִגְנַאי ·</tei:l> <tei:l>מִפְתַּח פִּתּוּחֵי חוֹתָם קֹדֶשׁ לַיְיָ׃</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>בין כסה</tei:abbr><tei:expan>בֵּין כֶּסֶה לֶעָשׂוֹר · הִשְׁלַכְנוּ רֹעַ שְׂאוֹר · צַדְּקֵנוּ בְּמִשְׁפָּט בְּאוֹר הַחַיִּים לָאוֹר · הִנְנוּ אָתָנוּ־לְךָ אַדִּיר וְנָאוֹר · כִּי־עִמְּךָ מְקוֹר חַיִּים בְּאוֹרְךָ נִרְאֶה אוֹר׃</tei:expan></tei:choice></tei:seg></tei:l> </tei:lg> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bein_keseh_leasor/stanza_7"/><tei:lg><tei:l>לְפַתּוֹתְךָ בְּתַחֲנֵן ·</tei:l> <tei:l>עֲבָדֶיךָ מַסְכִּימִים ·</tei:l> <tei:l>הִפָּתַח לָמוֹ וּזְכוֹר נִחוּמִים ·</tei:l> <tei:l>חֲסָדֶיךָ הַפְלֵא וְהַעֲבֵר כְּתָמִים ·</tei:l> <tei:l>אֵל מֶלֶךְ יוֹשֵׁב עַל כִּסֵּא רַחֲמִים׃</tei:l> <tei:l><tei:seg type="refrain"><tei:choice><tei:abbr>בין כסה וכו׳</tei:abbr><tei:expan>בֵּין כֶּסֶה לֶעָשׂוֹר · הִשְׁלַכְנוּ רֹעַ שְׂאוֹר · צַדְּקֵנוּ בְּמִשְׁפָּט בְּאוֹר הַחַיִּים לָאוֹר · הִנְנוּ אָתָנוּ־לְךָ אַדִּיר וְנָאוֹר · כִּי־עִמְּךָ מְקוֹר חַיִּים בְּאוֹרְךָ נִרְאֶה אוֹר׃</tei:expan></tei:choice></tei:seg></tei:l> </tei:lg> <tei:milestone unit="stanza"/></tei:div>
    </tei:body>
  </tei:text>
