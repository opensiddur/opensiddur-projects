  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_unity_cronbach">
        <tei:head>Prayer for Unity (Pour Out Thy Blessing), an alternative formulation of Shfokh Ḥamatekha by Rabbi Abraham Cronbach (1932)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_unity_cronbach/1"/>
        <tei:lg>
          <tei:l>O <j:divineName>God of Love</j:divineName>, <j:divineName>Father of Men</j:divineName>,</tei:l>
          <tei:l>from Whom alone desires of peace and fellowship come,</tei:l>
          <tei:l>and in Whom alone can such desires bear fruit,</tei:l>
          <tei:l>pour out Thy blessing that it may bring peace,</tei:l>
          <tei:l>abolishing war among the nations,</tei:l>
          <tei:l>and hasten in Thy love the time</tei:l>
          <tei:l>when all men will have been gathered to Thee</tei:l>
          <tei:l>in perfect unity.</tei:l>
          <tei:l><tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
