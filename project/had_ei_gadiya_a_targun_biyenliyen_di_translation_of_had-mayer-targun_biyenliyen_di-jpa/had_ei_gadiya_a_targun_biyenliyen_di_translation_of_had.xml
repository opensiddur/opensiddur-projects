          <tei:l>וִ֖סִ֥דִ֖י טִ֖רֵ֬י גֵ֥ׄן דִ֖י</tei:l>
          <tei:l>הַ֨דֵ֬י גַ֬דִ֖יַ֬א, הַ֨דֵ֬י גַ֬דִ֖יַ֬א</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:had_ei_gadiya_a_targun_biyenliyen_di_translation_of_had/10"/>
        <tei:lg>
          <tei:l>וִ֖קָ֥ד֬וֹשׁ֖ בָּ֬ר֬וּךְ־ה֬וּא<tei:anchor xml:id="note_16"/> מַ֥דֵ֨י דַ֨וַ֬ר</tei:l>
