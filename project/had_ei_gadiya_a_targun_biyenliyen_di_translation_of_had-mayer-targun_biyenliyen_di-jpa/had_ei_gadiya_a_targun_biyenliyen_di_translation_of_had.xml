          <tei:l>וִ֖סִ֥דִ֖י טִ֖רֵ֬י גֵ֥ׄן דִ֖י</tei:l>
          <tei:l>הַ֨דֵ֬י גַ֬דִ֖יַ֬א, הַ֨דֵ֬י גַ֬דִ֖יַ֬א</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:had_ei_gadiya_a_targun_biyenliyen_di_translation_of_had/7"/>
        <tei:lg>
          <tei:l>וִ֖נִ֥ו מַ֥דֵ֨י דַ֨וַ֬ר</tei:l>
          <tei:l>וִ֖הֵ֨י נַ֖אֵ֬י מֵ֬י</tei:l>
          <tei:l>מִ֖יֵ֖י נַ֖אֵ֬י נ֬וּר דִ֖י</tei:l>
          <tei:l>שַ֨ו נַ֖אֵ֬י גַ֨ן דִ֖י</tei:l>
          <tei:l>דַ֬גִׄ֨י נַ֖אֵ֬י ג֬וֹ דִ֖י</tei:l>
          <tei:l>נִ֬הֵ֬תִ֖י נַ֖אֵ֬י מַ֨ו דִ֖י</tei:l>
          <tei:l>מִ֬הַ֬ר נַ֖אֵ֬י גַ֬דִ֖יַ֬א דִ֖י</tei:l>
          <tei:l>בַ֬בַ֥א זַ֬בֵ֬ן</tei:l>
          <tei:l>וִ֖סִ֥דִ֖י טִ֖רֵ֬י גֵ֥ׄן דִ֖י</tei:l>
          <tei:l>הַ֨דֵ֬י גַ֬דִ֖יַ֬א, הַ֨דֵ֬י גַ֬דִ֖יַ֬א</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:had_ei_gadiya_a_targun_biyenliyen_di_translation_of_had/8"/>
        <tei:lg>
          <tei:l>וִ֖שׁ֨וֹחֵ֖ט֖<tei:anchor xml:id="note_14"/> מַ֥דֵ֨י דַ֨וַ֬ר</tei:l>
          <tei:l>וִ֖ת֥וּ נַ֖אֵ֬י נִ֥ו</tei:l>
          <tei:l>הֵ֨י נַ֖אֵ֬י מֵ֬י דִ֖י</tei:l>
          <tei:l>מִ֖יֵ֖י נַ֖אֵ֬י נ֬וּר דִ֖י</tei:l>
          <tei:l>שַ֨ו נַ֖אֵ֬י גַ֨ן דִ֖י</tei:l>
          <tei:l>דַ֬גִׄ֨י נַ֖אֵ֬י ג֬וֹ דִ֖י</tei:l>
          <tei:l>נִ֬הֵ֬תִ֖י נַ֖אֵ֬י מַ֨ו דִ֖י</tei:l>
          <tei:l>מִ֬הַ֬ר נַ֖אֵ֬י גַ֬דִ֖יַ֬א דִ֖י</tei:l>
          <tei:l>בַ֬בַ֥א זַ֬בֵ֬ן</tei:l>
          <tei:l>וִ֖סִ֥דִ֖י טִ֖רֵ֬י גֵ֥ׄן דִ֖י</tei:l>
          <tei:l>הַ֨דֵ֬י גַ֬דִ֖יַ֬א, הַ֨דֵ֬י גַ֬דִ֖יַ֬א</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:had_ei_gadiya_a_targun_biyenliyen_di_translation_of_had/9"/>
        <tei:lg>
          <tei:l>וִ֖מַ֬לְאַ֬ךְ הַ֬מַּ֬וֶ֬ת֖<tei:anchor xml:id="note_15"/> מַ֥דֵ֨י דַ֨וַ֬ר</tei:l>
          <tei:l>וִ֖ת֥וּ נַ֖אֵ֬י שׁ֨וֹחֵ֖ט֖</tei:l>
          <tei:l>ת֥וּ נַ֖אֵ֬י נִ֥ו דִ֖י</tei:l>
          <tei:l>הֵ֨י נַ֖אֵ֬י מֵ֬י דִ֖י</tei:l>
          <tei:l>מִ֖יֵ֖י נַ֖אֵ֬י נ֬וּר דִ֖י</tei:l>
          <tei:l>שַ֨ו נַ֖אֵ֬י גַ֨ן דִ֖י</tei:l>
          <tei:l>דַ֬גִׄ֨י נַ֖אֵ֬י ג֬וֹ דִ֖י</tei:l>
          <tei:l>נִ֬הֵ֬תִ֖י נַ֖אֵ֬י מַ֨ו דִ֖י</tei:l>
          <tei:l>מִ֬הַ֬ר נַ֖אֵ֬י גַ֬דִ֖יַ֬א דִ֖י</tei:l>
