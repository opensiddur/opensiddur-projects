    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:selichah_yitschak">
        <tei:head>סליחה מר׳ יצחק אבן גיאת</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:selichah_yitschak/1"/>
        <tei:lg>
          <tei:l>אֵלְכָה וְאָשׁוּבָה אֶל־אִישִׁי הָרִאשׁוֹן.</tei:l>
          <tei:l>אֲשֶׁר מֵאָז נְצָרַנִי כְאִישׁוֹן.</tei:l>
          <tei:l>בָּחוּר כָּאֲרָזִים תְּהִלָּתוֹ בְּכָל לָשׁוֹן.</tei:l>
          <tei:l>בְּזָכְרִי בוֹ אֵינֶנּוּ מַנִּיחַ לִי לִישׁוֹן:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:selichah_yitschak/2"/>
        <tei:lg>
          <tei:l>גְּאָלַנִי בִּזְרֹעַ מִבֵּין קְדֵשִׁים.</tei:l>
          <tei:l>גַּם כְּלָלַנִי יֹפִי וְכֵלִים חֲדָשִׁים.</tei:l>
          <tei:l>דִבֶּר־בִּי עַל־פִּי קְדוֹשִׁים.</tei:l>
          <tei:l>דִּבְּקַנִי אֶצְלוֹ בִּכְתֻבָּה וְקִדּוּשִׁים:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:selichah_yitschak/3"/>
        <tei:lg>
          <tei:l>הִרְבָּה מֹהַר וּמִקְנֶה וְקִנְיָן.</tei:l>
          <tei:l>הִגְדִּיל הַשִׂמְחָה בְּכָל־עִנְיָן.</tei:l>
          <tei:l>וְסִיֵד וְכִיֵר בֵּית חַתְנוּת בִּנְיָן.</tei:l>
          <tei:l>וּמָסַר לְשָׁרְתֵנִי עֲלָמוֹת אֵין מִנְיָן:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:selichah_yitschak/4"/>
        <tei:lg>
          <tei:l>זֶבַח הֵכִין ושִׁלֵּם נְדָרָיו.</tei:l>
          <tei:l>זְבָדַנִי זֶבֶד טוֹב בַּחֲדָרָיו.</tei:l>
          <tei:l>חֲצֵרוֹת קְטֻרוֹת תִּכּוֹן סְדָרָיו.</tei:l>
          <tei:l>חֲתָנִי הַמֶּלֶךְ הֱבִיאַנִי חֲדָרָיו:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:selichah_yitschak/5"/>
        <tei:lg>
          <tei:l>טָבַלְתִּי וּבָאתִי בַּעְדִי עֲדָיִים.</tei:l>
          <tei:l>טַהֲרוֹתַי נָתְנוּ רֵיחַ דוּדָאִים.</tei:l>
          <tei:l>יְצוּעִי עָלָה וְלָן בֵּין שָׁדַיִם.</tei:l>
          <tei:l>יְמִינוֹ חִבְּקַנִי חִבּוּק יָדָיִם:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:selichah_yitschak/6"/>
        <tei:lg>
          <tei:l>כִּמְעַט רֶגַע אִירַע דָּבָר.</tei:l>
          <tei:l>כָּבוֹד הֵמִיר וְחֹק חַק שָׁבַר.</tei:l>
          <tei:l>לֶכְתִּי דֶרֶךְ בָּרוּחַ וְלֹא לְהָבַר.</tei:l>
          <tei:l>לַצְתִּי וְאַצְתִּי וָדוֹדִי חָמַק עָבָר:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:selichah_yitschak/7"/>
        <tei:lg>
          <tei:l>מֵעַי הָמוּ לְדוֹדִי קָנַנִי.</tei:l>
          <tei:l>מַה־לִּידִידִי בִּטֵּל אֲשֶׁר הִתְנַנִי.</tei:l>
          <tei:l>נָסַע מֵעָלַי וְלֹא חַנַּנִי.</tei:l>
          <tei:l>נְאֻם בִּקַּשְׁתִּיו וְלֹא מְצָאתִיו קְרָאתִיו וְלֹא עָנָנִי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:selichah_yitschak/8"/>
        <tei:lg>
          <tei:l>סוּרָה אֲדוֹנִי סוּרָה חִנַּנְתִּיו כַּמֶּה.</tei:l>
          <tei:l>סֹב וְלֹא פָנָה הוֹחַלְתִּי עַד מֶה.</tei:l>
          <tei:l>עָלַי לִבִּי כְּכִנּוֹר יֶהֱמֶה.</tei:l>
          <tei:l>עֵינִי נִגְּרָה וְלֹא תִדְמֶה:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:selichah_yitschak/9"/>
        <tei:lg>
          <tei:l>פִּקְפֵּק בְּכָבוֹד לְמוֹרַד עֲנִיּוּת.</tei:l>
          <tei:l>פִּתְחֵי נִדָּה שָׂם נְקִיּוּת.</tei:l>
          <tei:l>צָנִיף צְנָפַנִי כַּדּוּר דְּחִיּוּת.</tei:l>
          <tei:l>צְרוּרָה צְעוּרָה אַלְמְנוּת חַיּוּת:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:selichah_yitschak/10"/>
        <tei:lg>
          <tei:l>קַוֹה קִוִּיתִי יְיָ יוֹם נֶחָמָה.</tei:l>
          <tei:l>קִרְבַת נְטוּשָׁה בְּאַף וּבְחֵמָה.</tei:l>
          <tei:l>רִשְׁפֵי אֵשׁ הָיָה לָּהּ לְחוֹמָה.</tei:l>
          <tei:l>רַחֵם תְּרַחֵם אֶת־לֹא רֻחָמָה:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:selichah_yitschak/11"/>
        <tei:lg>
          <tei:l>שׁוּבִי שׁוּבִי הַשּׁוּלַמִּית מִבֵּין שֹׁסַיִךְ.</tei:l>
          <tei:l>שׁוּבִי וְנֶחֱזֶה־בָּךְ יֹאמַר עֹשַׂיִךְ.</tei:l>
          <tei:l>תִּקְעִי כַף מִלְּבָנוֹן רָצִיתִי מַעֲשַׂיִךְ.</tei:l>
          <tei:l>תְּעוֹרֵר אַהֲבָתֵךְ כִּי בֹעֲלַיִךְ עֹשָׂיִךְ:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:selichah_yitschak/12"/>
        <tei:lg>
          <tei:l>יָדֹעַ תֵדַע פְּנֵי צֹאנֶךָ.</tei:l>
          <tei:l>צִיּוֹן מִכְלַל יֹפִי הֵטִיבָה בִרְצוֹנֶךָ.</tei:l>
          <tei:l>חֲסִידֶיךָ רַנֵּן יְרַנֵּנוּ צִדְקוֹת פִרְזוֹנֶךָ.</tei:l>
          <tei:l>קוֹלִי שָׁמָעְתָּ אַל־תַּעְלֵם אָזְנֶךָ:</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
