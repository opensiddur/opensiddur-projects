        <tei:lg>
          <tei:l>הַלְלֽוּהוּ</tei:l>
          <tei:l>שַׁבְּחֽוּהוּ</tei:l>
          <tei:l>וְהַעֲלֽוּהוּ</tei:l>
          <tei:l>לְעֹלָם׃</tei:l>
          <tei:l>עַם נוֹרָא וְקָדוֹשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushta_additions_for_the_public_repetition_of_the_amidah/38"/>
        <tei:lg>
          <tei:l>אֵל נָא</tei:l>
          <tei:l>לְעוֹלָם תָּעֳרׇץ</tei:l>
          <tei:l>וּלְעוֹלָם תֻּקְדָּשׁ</tei:l>
          <tei:l>וּלְעוֹלְמֵי עוֹלָמִים תִּמְלוֹךְ וְתִתְנַשֵׂא</tei:l>
          <tei:l>הָאֵל מֶֽלֶךְ נוֹרָא מָרוֹם וְקָדוֹשׁ</tei:l>
          <tei:l>כִּי אַתָּה הוּא מֶֽלֶךְ מַלְכֵי הַמְּלָכִים</tei:l>
          <tei:l>מַלְכוּתוֹ נֶֽצַח נוֹרְאוֹתָיו</tei:l>
          <tei:l>שִֽׂיחוּ סַפְּרוּ</tei:l>
          <tei:l>עֻזּוֹ פָּאֲרֽוּהוּ</tei:l>
          <tei:l>צְבָאָיו קַדְּשֽׁוּהוּ רוֹמְמֽוּהוּ</tei:l>
