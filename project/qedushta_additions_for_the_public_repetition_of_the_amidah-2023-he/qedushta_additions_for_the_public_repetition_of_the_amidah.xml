        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushta_additions_for_the_public_repetition_of_the_amidah/25"/>
        <tei:lg>
          <tei:l>כַּכָּתוּב —</tei:l>
          <tei:l>אֵין־קָד֥וֹשׁ כַּיהֹוָ֖ה כִּ֣י אֵ֣ין בִּלְתֶּ֑ךָ וְאֵ֥ין צ֖וּר כֵּאלֹהֵֽינוּ׃<tei:bibl>(שמואל א׳ ב:ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushta_additions_for_the_public_repetition_of_the_amidah/26"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>הַ֥לְלוּ יָ֨הּ ׀ הַֽלְלוּ־אֵ֥ל בְּקָדְשׁ֑וֹ הַֽ֝לְל֗וּהוּ בִּרְקִ֥יעַ עֻזּֽוֹ׃ <tei:bibl>(תהלים קנ:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushta_additions_for_the_public_repetition_of_the_amidah/27"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>לַ֭מְנַצֵּחַ שִׁ֣יר מִזְמ֑וֹר הָרִ֥יעוּ לֵ֝אלֹהִים כָּל־הָאָֽרֶץ׃ <tei:bibl>(תהלים סו:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushta_additions_for_the_public_repetition_of_the_amidah/28"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>יְפֵ֥ה נוֹף֮ מְשׂ֪וֹשׂ כָּל־הָ֫אָ֥רֶץ הַר־צִ֭יּוֹן יַרְכְּתֵ֣י צָפ֑וֹן קִ֝רְיַ֗ת מֶ֣לֶךְ רָֽב׃ אֱלֹהִ֥ים בְּאַרְמְנוֹתֶ֗יהָ נוֹדַ֥ע לְמִשְׂגָּֽב׃ <tei:bibl>(תהלים מח:ג-ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushta_additions_for_the_public_repetition_of_the_amidah/29"/>
        <tei:lg>
