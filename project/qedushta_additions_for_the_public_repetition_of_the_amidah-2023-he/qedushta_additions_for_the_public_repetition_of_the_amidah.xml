          <tei:l><tei:seg type="acrostic">ט</tei:seg>וֹב וְצַדִּיק אַתָּה</tei:l>
          <tei:l>לְעֹלָם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushta_additions_for_the_public_repetition_of_the_amidah/33"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יַ</tei:seg>מְשִׁיךְ זְמַן שְׁנוֹתֶֽיךָ</tei:l>
          <tei:l>הַלְלֽוּהוּ</tei:l>
          <tei:l><tei:seg type="acrostic">כׇּ</tei:seg>ל־הַמַּֽיִם יְבָרְכֽוּךָ</tei:l>
          <tei:l>שַׁבְּחֽוּהוּ</tei:l>
