  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:qedushta_additions_for_the_public_repetition_of_the_amidah">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushta_additions_for_the_public_repetition_of_the_amidah/1"/>
        <tei:lg>
          <tei:l>אֲ֭דֹנָי שְׂפָתַ֣י תִּפְתָּ֑ח</tei:l>
          <tei:l>וּ֝פִ֗י יַגִּ֥יד תְּהִלָּתֶֽךָ׃ <tei:bibl>(תהלים נא:יז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushta_additions_for_the_public_repetition_of_the_amidah/2"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יהוה אֱלֹהֵֽינוּ</tei:l>
          <tei:l>וֵאלֹהֵי אֲבוֹתֵֽינוּ׃</tei:l>
          <tei:l>אֱלֹהֵי אַבְרָהָם</tei:l>
          <tei:l>אֱלֹהֵי יִצְחָק</tei:l>
          <tei:l>וֵאלֹהֵי יַעֲקֹב׃</tei:l>
          <tei:l>הָאֵל הַגָּדוֹל הַגִּבּוֹר וְהַנּוֹרָא</tei:l>
          <tei:l>אֵל עֶלְיוֹן׃</tei:l>
          <tei:l>גּוֹמֵל חֲסָדִים טוֹבִים</tei:l>
          <tei:l>וְקוֹנֵה הַכֹּל</tei:l>
          <tei:l>וְזוֹכֵר חַסְדֵי אָבוֹת</tei:l>
          <tei:l>וּמֵבִיא גוֹאֵל לִבְנֵי בְנֵיהֶם</tei:l>
          <tei:l>לְמַֽעַן שְׁמוֹ בְּאַהֲבָה׃</tei:l>
          <tei:l>מֶֽלֶךְ עוֹזֵר וּמוֹשִֽׁיעַ וּמָגֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushta_additions_for_the_public_repetition_of_the_amidah/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אֲ</tei:seg>רוֹנָם נָשָֽׂאוּ</tei:l>
          <tei:l><tei:seg type="acrostic">בַּ</tei:seg>מִדְבָּר בָּֽאוּ</tei:l>
          <tei:l><tei:seg type="acrostic">גְּ</tei:seg>דוּדִים יָצָֽאוּ</tei:l>
          <tei:l><tei:seg type="acrostic">דִּ</tei:seg>גְלֵי עָם נִשָּֽׂאוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushta_additions_for_the_public_repetition_of_the_amidah/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ה</tei:seg>וֹלִיכָם מִיכָאֵל</tei:l>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>הוּא שַׂר יִשְׂרָאֵל</tei:l>
          <tei:l><tei:seg type="acrostic">זְ</tei:seg>קוּפִים אֵשׁ וְעָנָן מִפִּי אֵל</tei:l>
          <tei:l><tei:seg type="acrostic">חִ</tei:seg>תְכוּ ד׳ שְׁעָרִים בְּמִקְדַּשׁ אֵל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushta_additions_for_the_public_repetition_of_the_amidah/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">טֹ</tei:seg>הַרְתְּ! עֽוּרִי צִיּוֹן</tei:l>
          <tei:l><tei:seg type="acrostic">יְ</tei:seg>מִינֵךְ לִבְשִׁי לְפִדְיוֹן</tei:l>
          <tei:l><tei:seg type="acrostic">כִּ</tei:seg>פַּרְתְּ! עֽוּרִי צִיּוֹן</tei:l>
          <tei:l><tei:seg type="acrostic">לִ</tei:seg>קְטִי זֶֽרַע עַמֵּךְ הָאֶבְיוֹן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushta_additions_for_the_public_repetition_of_the_amidah/6"/>
        <tei:lg>
          <tei:l>כַּכָּתוּב —</tei:l>
          <tei:l>וַיְהִ֗י בִּנְסֹ֤עַ הָעָם֙ מֵאָ֣הֳלֵיהֶ֔ם לַעֲבֹ֖ר אֶת־הַיַּרְדֵּ֑ן וְהַכֹּהֲנִ֗ים נֹֽשְׂאֵ֛י הָאָר֥וֹן הַבְּרִ֖ית לִפְנֵ֥י הָעָֽם׃ <tei:bibl>(יהושע ג:יד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushta_additions_for_the_public_repetition_of_the_amidah/7"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>וּבָעֵ֣ת הַהִיא֩ יַעֲמֹ֨ד מִֽיכָאֵ֜ל הַשַּׂ֣ר הַגָּד֗וֹל הָעֹמֵד֮ עַל־בְּנֵ֣י עַמֶּ֒ךָ֒ וְהָיְתָה֙ עֵ֣ת צָרָ֔ה אֲשֶׁ֤ר לֹֽא־נִהְיְתָה֙ מִֽהְי֣וֹת גּ֔וֹי עַ֖ד הָעֵ֣ת הַהִ֑יא וּבָעֵ֤ת הַהִיא֙ יִמָּלֵ֣ט עַמְּךָ֔ כׇּל־הַנִּמְצָ֖א כָּת֥וּב בַּסֵּֽפֶר׃ <tei:bibl>(דניאל יב:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushta_additions_for_the_public_repetition_of_the_amidah/8"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>וַֽיהוָ֡ה הֹלֵךְ֩ לִפְנֵיהֶ֨ם יוֹמָ֜ם בְּעַמּ֤וּד עָנָן֙ לַנְחֹתָ֣ם הַדֶּ֔רֶךְ וְלַ֛יְלָה בְּעַמּ֥וּד אֵ֖שׁ לְהָאִ֣יר לָהֶ֑ם לָלֶ֖כֶת יוֹמָ֥ם וָלָֽיְלָה׃ <tei:bibl>(שמות יג:כא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushta_additions_for_the_public_repetition_of_the_amidah/9"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>עוּרִ֥י עוּרִ֛י לִבְשִׁ֥י עֻזֵּ֖ךְ צִיּ֑וֹן לִבְשִׁ֣י ׀ בִּגְדֵ֣י תִפְאַרְתֵּ֗ךְ יְרוּשָׁלִַ֙ם֙ עִ֣יר הַקֹּ֔דֶשׁ כִּ֣י לֹ֥א יוֹסִ֛יף יָבֹא־בָ֥ךְ ע֖וֹד עָרֵ֥ל וְטָמֵֽא׃ <tei:bibl>(ישעיהו נב:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushta_additions_for_the_public_repetition_of_the_amidah/10"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>וַיְדַבֵּ֨ר יְהוָ֤ה אֶל־מֹשֶׁה֙ לֵ֣ךְ עֲלֵ֣ה מִזֶּ֔ה אַתָּ֣ה וְהָעָ֔ם אֲשֶׁ֥ר הֶֽעֱלִ֖יתָ מֵאֶ֣רֶץ מִצְרָ֑יִם אֶל־הָאָ֗רֶץ אֲשֶׁ֣ר נִ֠שְׁבַּעְתִּי לְאַבְרָהָ֨ם לְיִצְחָ֤ק וּֽלְיַעֲקֹב֙ לֵאמֹ֔ר לְזַרְעֲךָ֖ אֶתְּנֶֽנָּה׃ <tei:bibl>(שמות לג:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushta_additions_for_the_public_repetition_of_the_amidah/11"/>
        <tei:lg>
          <tei:l>אֶתְּנֶֽנָּה לְעַם נַחֲלָתֶֽךָ</tei:l>
          <tei:l>מִשִּׁפְלוּת לְרוֹמְמוּת עַל־יָדֶֽיךָ</tei:l>
          <tei:l>צַדִּיקִים יִסְגְּדוּ לְפָנֶֽיךָ</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יהוה מָגֵן אַבְרָהָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushta_additions_for_the_public_repetition_of_the_amidah/12"/>
        <tei:lg>
          <tei:l>אַתָּה גִּבּוֹר לְעוֹלָם אֲדֹנָי</tei:l>
          <tei:l>מְחַיֵּה מֵתִים אַתָּה רַב לְהוֹשִֽׁיעַ׃</tei:l>
          <tei:l>מַשִׁיב הָרֽוּחַ וּמוֹרִיד הַגֶּֽשֶׁם׃</tei:l>
          <tei:l>מְכַלְכֵּל חַיִּים בְּחֶֽסֶד</tei:l>
          <tei:l>מְחַיֵּה מֵתִים בְּרַחֲמִים רַבִּים׃</tei:l>
          <tei:l>סוֹמֵךְ נוֹפְלִים</tei:l>
          <tei:l>וְרוֹפֵא חוֹלִים</tei:l>
          <tei:l>וּמַתִּיר אֲסוּרִים</tei:l>
          <tei:l>וּמְקַיֵּם אֱמוּנָתוֹ לִישֵׁנֵי עָפָר׃</tei:l>
          <tei:l>מִי כָמֽוֹךָ בַֽעַל גְּבוּרוֹת</tei:l>
          <tei:l>וּמִי דוֹמֶה לָּךְ</tei:l>
          <tei:l>מֶֽלֶךְ מֵמִית וּמְחַיֶּה וּמַצְמִֽיחַ יְשׁוּעָה׃</tei:l>
          <tei:l>וְנֶאֱמָן אַתָּה לְהַחֲיוֹת מֵתִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushta_additions_for_the_public_repetition_of_the_amidah/13"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מַ</tei:seg>עֲלֶה הָהָר עָלוּ בְּאוֹתָהּ שָׁנָה</tei:l>
          <tei:l><tei:seg type="acrostic">נַ</tei:seg>עֲלֶה הָהָֽרָה בְּכׇל־שָׁנָה</tei:l>
          <tei:l><tei:seg type="acrostic">סְ</tei:seg>גִידָה לִפְנֵי הָאָדוֹן אֵל קַנָּא</tei:l>
          <tei:l><tei:seg type="acrostic">עָ</tei:seg>לוּ הָהָרָה לְמַעֲנָהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushta_additions_for_the_public_repetition_of_the_amidah/14"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פָּ</tei:seg>רָשַׁת הַבְּרִית בְּסִינַי</tei:l>
          <tei:l><tei:seg type="acrostic">צַ</tei:seg>דִּיקִים בְּעַם אֱמוּנַי</tei:l>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>רְאוּ לִפְנֵי אֱלֹהֵיהֶם יהוה</tei:l>
          <tei:l><tei:seg type="acrostic">ר</tei:seg>וֹאֶה אֶת־הַפִּסְגָּה בְּעֵינַי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushta_additions_for_the_public_repetition_of_the_amidah/15"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שְׁ</tei:seg>בַנְיָה בֻּנִּי</tei:l>
          <tei:l><tei:seg type="acrostic">שֵׁ</tei:seg>רֵבְיָה בָּנִי</tei:l>
          <tei:l><tei:seg type="acrostic">תְּ</tei:seg>מִימֵי לֵוִי קַדְמִיאֵל וּכְנָנִי</tei:l>
          <tei:l><tei:seg type="acrostic">תָּ</tei:seg>מְהוּ כְּמוֹ תִּמְהוֹנִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushta_additions_for_the_public_repetition_of_the_amidah/16"/>
        <tei:lg>
          <tei:l>כַּכָּתוּב —</tei:l>
          <tei:l>וְעָנ֣וּ הַלְוִיִּ֗ם וְאָֽמְר֛וּ אֶל־כָּל־אִ֥ישׁ יִשְׂרָאֵ֖ל ק֥וֹל רָֽם׃ <tei:bibl>(דברים כז:יד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushta_additions_for_the_public_repetition_of_the_amidah/17"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>וְכָל־יִשְׂרָאֵ֡ל וּזְקֵנָ֡יו וְשֹׁטְרִ֣ים ׀ וְשֹׁפְטָ֡יו עֹמְדִ֣ים מִזֶּ֣ה ׀ וּמִזֶּ֣ה ׀ לָאָר֡וֹן נֶגֶד֩ הַכֹּהֲנִ֨ים הַלְוִיִּ֜ם נֹשְׂאֵ֣י ׀ אֲר֣וֹן בְּרִית־יְהוָ֗ה כַּגֵּר֙ כָּֽאֶזְרָ֔ח חֶצְיוֹ֙ אֶל־מ֣וּל הַר־גְּרִזִ֔ים וְהַֽחֶצְי֖וֹ אֶל־מ֣וּל הַר־עֵיבָ֑ל כַּאֲשֶׁ֨ר צִוָּ֜ה מֹשֶׁ֣ה עֶֽבֶד־יְהוָ֗ה לְבָרֵ֛ךְ אֶת־הָעָ֥ם יִשְׂרָאֵ֖ל בָּרִאשֹׁנָֽה׃ <tei:bibl>(יהושע ג:לג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushta_additions_for_the_public_repetition_of_the_amidah/18"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>וַיָּק֙וּמוּ֙ עַל־עׇמְדָ֔ם וַֽיִּקְרְא֗וּ בְּסֵ֨פֶר תּוֹרַ֧ת יְהֹוָ֛ה אֱלֹהֵיהֶ֖ם רְבִעִ֣ית הַיּ֑וֹם וּרְבִעִית֙ מִתְוַדִּ֣ים וּמִֽשְׁתַּחֲוִ֔ים לַיהֹוָ֖ה אֱלֹהֵיהֶֽם׃ <tei:bibl>(נחמיה ט:ג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushta_additions_for_the_public_repetition_of_the_amidah/19"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>וַיָּ֜קׇם עַֽל־מַֽעֲלֵ֣ה הַלְוִיִּ֗ם יֵשׁ֨וּעַ וּבָנִ֜י קַדְמִיאֵ֧ל שְׁבַנְיָ֛ה בֻּנִּ֥י שֵׁרֵבְיָ֖ה בָּנִ֣י כְנָ֑נִי וַֽיִּזְעֲקוּ֙ בְּק֣וֹל גָּד֔וֹל אֶל־יְהֹוָ֖ה אֱלֹהֵיהֶֽם׃<tei:bibl>(נחמיה ט:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushta_additions_for_the_public_repetition_of_the_amidah/20"/>
        <tei:lg>
          <tei:l>אֱלֹהֵיהֶם אַתָּה וְאָֽנוּ עַמֶּֽיךָ</tei:l>
          <tei:l>מְחַיֶּה מֵתִים עוֹשֶׂה מַעֲשֶֽׂיךָ</tei:l>
          <tei:l>נֶאֱמָנִים יִסְגְּדוּ לְפָנֶֽיךָ</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה מְחַיֵּה הַמֵּתִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushta_additions_for_the_public_repetition_of_the_amidah/21"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יִ</tei:seg>תְבָּרֵךְ אֱלֹהֵי יִשְׂרָאֵל</tei:l>
          <tei:l><tei:seg type="acrostic">צ</tei:seg>וּר אֲבוֹתֵֽינוּ אַתָּה הָאֵל</tei:l>
          <tei:l><tei:seg type="acrostic">חֲ</tei:seg>סִידֵי כׇּל־יִשְׂרָאֵל</tei:l>
          <tei:l><tei:seg type="acrostic">ק</tei:seg>וֹרְאִים הַלְּלוּ־אֵל</tei:l>
