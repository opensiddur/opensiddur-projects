        <tei:lg>
          <tei:l><tei:seg type="acrostic">יִ</tei:seg>תְקַדֵּשׁ וְיִתְעַלֶּה וְיִשְׁתַּבֵּֽחַ</tei:l>
          <tei:l><tei:seg type="acrostic">צַ</tei:seg>דִּיק וְנָאֶה לְשַׁבֵּֽחַ</tei:l>
          <tei:l><tei:seg type="acrostic">חֲ</tei:seg>בֵרַי בְּרֶֽנֶן שָׂמֵחַ</tei:l>
          <tei:l><tei:seg type="acrostic">קִ</tei:seg>רְאוּ תִּשְׁבָּחוֹת לַמְּנַצֵּֽחַ</tei:l>
