  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:baugesang_a_german_adaptation_of_the_piyyut_addir_hu">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_a_german_adaptation_of_the_piyyut_addir_hu/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">Die Zeremonien, welche gebraucht werden bei den zwei Osternächten mit großer Andacht gebeten und vollbracht, und lauten also aus ihrem Kabbala:</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_a_german_adaptation_of_the_piyyut_addir_hu/2"/>
        <tei:lg>
          <tei:l>Allmächtiger Gott,</tei:l>
          <tei:l>nun bau’ dein Tempel schiere,</tei:l>
          <tei:l>also in schier und also bald,</tei:l>
          <tei:l>in unseren Tagen schiere,</tei:l>
          <tei:l>ja schiere!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_a_german_adaptation_of_the_piyyut_addir_hu/3"/>
        <tei:lg>
          <tei:l>Barmherziger Gott,</tei:l>
          <tei:l>großer Gott,</tei:l>
          <tei:l>demütiger Gott,</tei:l>
          <tei:l>hoher Gott,</tei:l>
          <tei:l>feiner Gott,</tei:l>
          <tei:l>süßer und demütiger Gott,</tei:l>
          <tei:l>jüdischer Gott,</tei:l>
          <tei:l>nun bau’ dein Tempel schiere</tei:l>
          <tei:l>also schier und also bald,</tei:l>
          <tei:l>und bau’ dein Tempel schiere!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_a_german_adaptation_of_the_piyyut_addir_hu/4"/>
        <tei:lg>
          <tei:l>Kräftiger lebendiger mächtiger</tei:l>
          <tei:l>namhafter ewiger furchtsamer</tei:l>
          <tei:l>reicher königlicher wahrer</tei:l>
          <tei:l>schöner Gott,</tei:l>
          <tei:l>nun bau’ dein Tempel schiere</tei:l>
          <tei:l>also und also bald,</tei:l>
          <tei:l>in unseren Tagen schiere,</tei:l>
          <tei:l>nun bau’ dein Tempel schiere!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
