    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_dwelling_in_the_sukkah_of_the_livyatan_meir/1">
        <tei:head>Prayer for Dwelling in the Sukkah of the Livyatan, as taught in the name of Rabbi Meir of Rothenburg (ca. 13th c.)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_dwelling_in_the_sukkah_of_the_livyatan_meir/1/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">And it was the practice of Maharam of Rothenburg</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">on the night of the departure of Sukkot</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">to rise up into the Sukkah</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">and to request permission of her, saying:</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_dwelling_in_the_sukkah_of_the_livyatan_meir/1/2"/>
        <tei:lg>
          <tei:l>May it be your will</tei:l>
          <tei:l>that we merit in the coming year</tei:l>
          <tei:l>to dwell in the sukkah of the Livyatan</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
