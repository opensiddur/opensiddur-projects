  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:life_is_what_we_make_it_kaplan">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:life_is_what_we_make_it_kaplan/9"/>
        <tei:lg>
          <tei:l>יְמֵי־שְׁנוֹתֵינוּ בָהֶם שִׁבְעִים שָׁנָה</tei:l>
          <tei:l>וְאִם בִּגְבוּרֹת שְׁמוֹנִים שָׁנָה</tei:l>
          <tei:l>וְרׇהְבָּם עָמָל וָאָוֶן כִּי־גָז חִישׁ וַנָּעֻפָה׃ <tei:bibl>(תהלים צ:י)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:life_is_what_we_make_it_kaplan/12"/>
        <tei:lg>
          <tei:l>קוֹל קוֹרֵא בַּמִּדְבָּר פַּנּוּ דֶּרֶךְ יְהֹוָה</tei:l>
          <tei:l>יַשְּׁרוּ בָּעֲרָבָה מְסִלָּה לֵאלֹהֵינוּ׃ <tei:bibl>(ישעיה מ:ג)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
