  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yetsiv_pitgam_for_purim_mohr">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yetsiv_pitgam_for_purim_mohr/1"/>
        <tei:lg xml:lang="he">
          <tei:l>יְצִיב פִּתְגָם</tei:l>
          <tei:l>דְלוֹט מִסְדוֹם</tei:l>
          <tei:l>בְּרִבּוֹ רִבְבָן שִׁכּוּרִין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yetsiv_pitgam_for_purim_mohr/2"/>
        <tei:lg xml:lang="he">
          <tei:l>שָׁתֵי אֲנָא</tei:l>
          <tei:l>מְחֶנְוָנָא</tei:l>
          <tei:l>דְזַבִּן לַעֲנִיִּין וְעַשִׂירִין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yetsiv_pitgam_for_purim_mohr/3"/>
        <tei:lg xml:lang="he">
          <tei:l>חֲבִיתוֹהִי</tei:l>
          <tei:l>לְגוֹ מוֹהִי</tei:l>
          <tei:l>נָגֵד וְנָפֵק נְהַר דְּנוּרִין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yetsiv_pitgam_for_purim_mohr/4"/>
        <tei:lg xml:lang="he">
          <tei:l>בְּמֵי דִבְשׁוּתָא</tei:l>
          <tei:l>וְיַיִן שְׂרָפוּתָא</tei:l>
          <tei:l>וְזִיקִין דְּנוּר וּבָעוּרִין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yetsiv_pitgam_for_purim_mohr/5"/>
        <tei:lg xml:lang="he">
          <tei:l>שְׁתָא וּסְבָא</tei:l>
          <tei:l>מַה בַּחֲבִיתָּא</tei:l>
          <tei:l>וְעִמֵּיהּ שַׁרְיָין נְהוֹרִין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yetsiv_pitgam_for_purim_mohr/6"/>
        <tei:lg xml:lang="he">
          <tei:l>מַשְׁקִין שְׁתָא</tei:l>
          <tei:l>בְּלָא פִּסְקָא</tei:l>
          <tei:l>וְגַלְיָן לֵיהּ דְּמִטַטְרִין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yetsiv_pitgam_for_purim_mohr/7"/>
        <tei:lg xml:lang="he">
          <tei:l>בְּעֵית מִנֵיהּ</tei:l>
          <tei:l>יַת יֵינֵיהּ</tei:l>
          <tei:l>וּבַתְרוֹהִי דּוּבְשָׁה וּמֵי פֵּירִין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yetsiv_pitgam_for_purim_mohr/8"/>
        <tei:lg xml:lang="he">
          <tei:l>יוֹדְעֵי הִלְכָתָא</tei:l>
          <tei:l>מֵיכְלָא וּמִשְׁתָּא</tei:l>
          <tei:l>מִשׁוּפְרֵי שׁוּפְרִין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yetsiv_pitgam_for_purim_mohr/9"/>
        <tei:lg xml:lang="he">
          <tei:l>מַיָּא חַיָּא</tei:l>
          <tei:l>לְעָלְמַיָּא</tei:l>
          <tei:l>יְתָרְכוּן וְלָא מְשַׁחֲרִין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yetsiv_pitgam_for_purim_mohr/10"/>
        <tei:lg xml:lang="he">
          <tei:l>אָמִיר עֲלֵיהֹן</tei:l>
          <tei:l>בְּטֵלִין יְהוֹן</tei:l>
          <tei:l>ולָא יִתְחַשְׁבוּן הֵיךְ עַפְרִין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yetsiv_pitgam_for_purim_mohr/11"/>
        <tei:lg xml:lang="he">
          <tei:l>יִשְׁתוּן כְּעָן</tei:l>
          <tei:l>חַכִּים וְרַבָּן</tei:l>
          <tei:l>יְטוּפוּן עֵינוֹהִי חַמְרִין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yetsiv_pitgam_for_purim_mohr/12"/>
        <tei:lg xml:lang="he">
          <tei:l>רְעוּתָן הַב</tei:l>
          <tei:l>וְאַפָּנָא צְהַב</tei:l>
          <tei:l>יְנַהֲרוּן כִּנְהַר צַפְרִין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yetsiv_pitgam_for_purim_mohr/13"/>
        <tei:lg xml:lang="he">
          <tei:l>לִי הַב חַמְרָא</tei:l>
          <tei:l>כְּמָא דְאִתְאַמְרָא</tei:l>
          <tei:l>בִּמְסֵכְתָּא פּוּרִים וּשְׁאָר סָפְרִין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yetsiv_pitgam_for_purim_mohr/14"/>
        <tei:lg xml:lang="he">
          <tei:l>וִיהוֹן עֲדָנָא</tei:l>
          <tei:l>לְגוֹ נַפְשָׁתָנָא</tei:l>
          <tei:l>לִבְסוּמֵי בְּיוֹמָא דְפּוּרִין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yetsiv_pitgam_for_purim_mohr/15"/>
        <tei:lg xml:lang="he">
          <tei:l>יְרַוֵי יָתָן</tei:l>
          <tei:l>נוּנָא כְּלִוְיָתָן</tei:l>
          <tei:l>בְּכֵן לֵיהּ נַמְטֵי אַפְרִין</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
