  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_one_who_transitions_runyan">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_one_who_transitions_runyan/1"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן מִלְפָנֶיךָ</tei:l>
          <tei:l>יְיָ אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ,</tei:l>
          <tei:l>שֶׁתַּחְלִיפֵנִי לְשָׁלוֹם</tei:l>
          <tei:l>וְתַשְׁנוֹתֵינִי לְשָׁלוֹם</tei:l>
          <tei:l>וְתַהַפְכֵינִי לְשָׁלוֹם</tei:l>
          <tei:l>וְתְהַמִירֵינִי לְשָׁלוֹם,</tei:l>
          <tei:l>וְתַגִּיעֵנִי לְגוּף נָפְשֵׁינִי</tei:l>
          <tei:l>לְחַיִּים וּלְשִׂמְחָה וּלְשָׁלוֹם,</tei:l>
          <tei:l>וְתַצִּילֵנִי מִכַּף כׇּל־אוֹיֵב וְאוֹרֵב</tei:l>
          <tei:l>וְשׂוֹנְאַי בַּדֶּרֶךְ</tei:l>
          <tei:l>וּמִכׇּל־סַפְקוֹת הַמִּתְרַגְּשׁוֹת וּבָאוֹת לְעוֹלָם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_one_who_transitions_runyan/2"/>
        <tei:lg>
          <tei:l>וְתִשְׁלַח בְּרָכָה בְּכׇל־מַעֲשֵׂה יָדֵינִי,</tei:l>
          <tei:l>וְתִתְּנֵנִי לְחֵן</tei:l>
          <tei:l>וּלְחֶסֶד</tei:l>
          <tei:l>וּלְרַחֲמִים בְּעֵינֶיךָ</tei:l>
          <tei:l>וּבְעֵינֵי כׇל־רוֹאֵינִי,</tei:l>
          <tei:l>וְתִגְמְלֵנִי חֲסָדִים טוֹבִים</tei:l>
          <tei:l>וְתִשְׁמַע קוֹל תְּפִלָּתֵנִי</tei:l>
          <tei:l>כִּי אַתָּה שׁוֹמֵעַ תְּפִלָּת כׇּל־פֶּה:</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְיָ, שׁוֹמֵעַ תְּפִלָה:</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
