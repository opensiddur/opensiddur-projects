    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/2">
        <tei:head>תהלים ב׳</tei:head>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">1</tei:hi> לָ֭מָּה רָגְשׁ֣וּ גוֹיִ֑ם</tei:l>
          <tei:l>וּ֝לְאֻמִּ֗ים יֶהְגּוּ־רִֽיק׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/2/2/a"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">2</tei:hi> יִ֥תְיַצְּב֨וּ ׀ מַלְכֵי־אֶ֗רֶץ</tei:l>
          <tei:l>וְרוֹזְנִ֥ים נֽוֹסְדוּ־יָ֑חַד עַל־יְ֝הֹוָ֗ה</tei:l>
          <tei:l>וְעַל־מְשִׁיחֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">3</tei:hi> נְֽ֭נַתְּקָה אֶת־מֽוֹסְרוֹתֵ֑ימוֹ</tei:l>
          <tei:l>וְנַשְׁלִ֖יכָה מִמֶּ֣נּוּ עֲבֹתֵֽימוֹ׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">4</tei:hi> יוֹשֵׁ֣ב בַּשָּׁמַ֣יִם יִשְׂחָ֑ק</tei:l>
          <tei:l>אֲ֝דֹנָ֗י יִלְעַג־לָֽמוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/2/5/a"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">5</tei:hi> אָ֤ז יְדַבֵּ֣ר אֵלֵ֣ימוֹ בְאַפּ֑וֹ</tei:l>
          <tei:l>וּֽבַחֲרוֹנ֥וֹ יְבַהֲלֵֽמוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/2/9/a"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">9</tei:hi> תְּ֭רֹעֵם בְּשֵׁ֣בֶט בַּרְזֶ֑ל</tei:l>
          <tei:l>כִּכְלִ֖י יוֹצֵ֣ר תְּנַפְּצֵֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/2/6/a"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">6</tei:hi> וַ֭אֲנִי נָסַ֣כְתִּי</tei:l>
          <tei:l>מַלְכִּ֑י עַל־צִ֝יּ֗וֹן הַר־קׇדְשִֽׁי׃</tei:l>
          <tei:l><tei:hi rend="superscript">7</tei:hi> אֲסַפְּרָ֗ה אֶֽ֫ל־חֹ֥ק יְֽהֹוָ֗ה</tei:l>
          <tei:l>אָמַ֘ר אֵלַ֥י</tei:l>
          <tei:l>בְּנִ֥י אַ֑תָּה</tei:l>
          <tei:l>אֲ֝נִ֗י הַיּ֥וֹם יְלִדְתִּֽיךָ׃</tei:l>
          <tei:l><tei:hi rend="superscript">8</tei:hi> שְׁאַ֤ל מִמֶּ֗נִּי</tei:l>
          <tei:l>וְאֶתְּנָ֣ה ג֭וֹיִם נַחֲלָתֶ֑ךָ</tei:l>
          <tei:l>וַ֝אֲחֻזָּתְךָ֗ אַפְסֵי־אָֽרֶץ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/2/10/a"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">10</tei:hi> וְ֭עַתָּה מְלָכִ֣ים הַשְׂכִּ֑ילוּ</tei:l>
          <tei:l>הִ֝וָּסְר֗וּ שֹׁ֣פְטֵי אָֽרֶץ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">11</tei:hi> עִבְד֣וּ אֶת־יְהֹוָ֣ה בְּיִרְאָ֑ה</tei:l>
          <tei:l>וְ֝גִ֗ילוּ בִּרְעָדָֽה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/2/12/a"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">12</tei:hi> נַשְּׁקוּ־בַ֡ר</tei:l>
          <tei:l>פֶּן־יֶאֱנַ֤ף ׀</tei:l>
          <tei:l>וְתֹ֬אבְדוּ דֶ֗רֶךְ</tei:l>
          <tei:l>כִּֽי־יִבְעַ֣ר כִּמְעַ֣ט אַפּ֑וֹ</tei:l>
          <tei:l>אַ֝שְׁרֵ֗י</tei:l>
          <tei:l>כׇּל־ח֥וֹסֵי בֽוֹ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
