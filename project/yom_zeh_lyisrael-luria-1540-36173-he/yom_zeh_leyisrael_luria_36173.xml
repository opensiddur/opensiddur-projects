    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yom_zeh_leyisrael_luria_36173">
        <tei:head>יוֹם זֶה לְיִשְׁרַאֵל</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_zeh_leyisrael_luria_36173/1"/>
        <tei:lg>
          <tei:l>יוֹם זֶה לְיִשְׁרַאֵל</tei:l>
          <tei:l>אוֹרָה וְשִׂמְחָה שַׁבָּת מְנוּחָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_zeh_leyisrael_luria_36173/2"/>
        <tei:lg>
          <tei:l>צִוִיתָ פִקּוּדִים בְמַעֲמַד הַר סִינַי,</tei:l>
          <tei:l>שַׁבָּת וּמוֹעֲדִים לִשְׁמוֹר בְכָל שָׁנַי,</tei:l>
          <tei:l>לַעֲרוֹךְ לְפָנַי מַשְׂאֵת וַאֲרוּחָה,</tei:l>
          <tei:l>שַׁבָּת מְנוּחָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_zeh_leyisrael_luria_36173/3"/>
        <tei:lg>
          <tei:l>חֶמְדַת הַלְבָבוֹת</tei:l>
          <tei:l>לְאֻמָה שְׁבוּרָה,</tei:l>
          <tei:l>לִנְפָשׁוֹת נִכְאָבוֹת</tei:l>
          <tei:l>נְשָׁמָה יְתֵרָה,</tei:l>
          <tei:l>לְנֶפֶשׁ מְצֵרָה</tei:l>
          <tei:l>יָסִיר אֲנָחָה,</tei:l>
          <tei:l>שַׁבָּת מְנוּחָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_zeh_leyisrael_luria_36173/4"/>
        <tei:lg>
          <tei:l>קִדַשְׁתָ בֵרַכְתָ</tei:l>
          <tei:l>אוֹתוֹ מִכָל יָמִים,</tei:l>
          <tei:l>בְשֵׁשֶׁת כִלִיתָ</tei:l>
          <tei:l>מְלֶאכֶת עוֹלָמִים,</tei:l>
          <tei:l>בּוֹ מָצְאוּ עֲגוּמִים</tei:l>
          <tei:l>הַשְׁקֵט וּבִטְחָה,</tei:l>
          <tei:l>שַׁבָּת מְנוּחָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_zeh_leyisrael_luria_36173/5"/>
        <tei:lg>
          <tei:l>לְאִסּוּר מְלָאכָה</tei:l>
          <tei:l>צִוִיתָנוּ נוֹרָא,</tei:l>
          <tei:l>אֶזְכֶה הוֹד מְלוּכָה</tei:l>
          <tei:l>אִם שַׁבָּת אֶשְׁמֹרָה,</tei:l>
          <tei:l>אַקְרִיב שַׁי לַמּוֹרָא</tei:l>
          <tei:l>מִנְחָה מֶרְקָחָה,</tei:l>
          <tei:l>שַׁבָּת מְנוּחָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_zeh_leyisrael_luria_36173/6"/>
        <tei:lg>
          <tei:l>וְשִׁיר אֶעֱרָךְ לְךָ בְנִגּוּן וּנְעִימָה</tei:l>
          <tei:l>מוּל תִפְאֶרֶת גָדְלְךָ נַפְשִׁי לְךָ</tei:l>
          <tei:l>כָמַהּ לִסְגֻלָה תְמִימָה קַיֵם הַבְטָחָה,</tei:l>
          <tei:l>שַׁבָּת מְנוּחָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_zeh_leyisrael_luria_36173/7"/>
        <tei:lg>
          <tei:l>רְצֵה תְפִלָתִי כְמוֹ קָרְבַן נַחְשׁוֹן</tei:l>
          <tei:l>וְיוֹם מְנוּחָתִי בְרִנָה וּבְשָׂשׂוֹן</tei:l>
          <tei:l>חָבִיב כְבַת אִישׁוֹן בְרֹב הַצְלָחָה,</tei:l>
          <tei:l>שַׁבָּת מְנוּחָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_zeh_leyisrael_luria_36173/8"/>
        <tei:lg>
          <tei:l>יִשְׁעֲךָ קִוִינוּ יָהּ</tei:l>
          <tei:l>אַדִיר אַדִירִים</tei:l>
          <tei:l>בֶן דָוִד מַלְכֵנוּ</tei:l>
          <tei:l>שְׁלַח נָא לָעִבְרִים</tei:l>
          <tei:l>וְיִקְרָא לִדְרוֹרִים</tei:l>
          <tei:l>רֶוַח וַהֲנָחָה,</tei:l>
          <tei:l>שַׁבָּת מְנוּחָה.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
