  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_prayer_for_those_who_are_unable_to_safely_avoid_eating_eat">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_those_who_are_unable_to_safely_avoid_eating_eat/1"/>
        <tei:lg>
          <tei:l>ה׳ אֱלֹהָי,</tei:l>
          <tei:l>הִנְנִי מוּכָן/מוּכָנָה וּמְזֻמָּן/וּמְזֻמָּנָהּ</tei:l>
          <tei:l>לְהַצִּיל אֶת חַיַּי עַל יְדֵי אֲכִילַת חָמֵץ בְּפֶסַח,</tei:l>
          <tei:l>אֲנָא עֲזֹר לִי לִמְצוֹא נֶחָמָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_those_who_are_unable_to_safely_avoid_eating_eat/2"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן שֶׁאֶזְכֶּה לְחַיִּים שֶׁיֵּשׁ בָּהֶם חֵרוּת אֲמִתִּי</tei:l>
          <tei:l>כְּפִי שֶׁאֲנִי מְקַיֵּם/מְקַיֶּמֶת אֶת מִצְוַת פִּקּוּחַ נֶפֶשׁ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_those_who_are_unable_to_safely_avoid_eating_eat/3"/>
        <tei:lg>
          <tei:l>וִיְהִי רָצוֹן מִלְּפָנֶיךָ שֶׁאֶזְכֶּה לִשְׁמוֹר אֶת הַמִּצְווֹת בִּמְלוֹאָם,</tei:l>
          <tei:l>שֶׁנֶּאֱמַר ”וָחַי בָּהֶם“ <tei:bibl>(ויקרא יח:ה)</tei:bibl>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_those_who_are_unable_to_safely_avoid_eating_eat/4"/>
        <tei:lg>
          <tei:l>וְשֶׁאֶזְכֶּה לָצֵאת מִן הַמֵּצַר לַמֶּרְחָב,</tei:l>
          <tei:l>וּמֵאֲפֵלָה לְאוֹר גָּדוֹל.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_those_who_are_unable_to_safely_avoid_eating_eat/5"/>
        <tei:lg>
          <tei:l>שֶׁאֶמְצָא תִּקְוָה וְשַׁלְוָה</tei:l>
          <tei:l>בַּהֲזָנַת הַגּוּף שֶׁלִּי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_those_who_are_unable_to_safely_avoid_eating_eat/6"/>
        <tei:lg>
          <tei:l>הַשָּׁנָה וְתָמִיד.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
