    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:supplemental_stanzas_to_the_piyyut_shalom_aleikhem_rubin">
        <tei:head>Supplemental stanzas to the piyyut "Shalom Aleikhem," by Miriam Rubin</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:supplemental_stanzas_to_the_piyyut_shalom_aleikhem_rubin/1"/>
        <tei:lg>
          <tei:l>
            <tei:hi rend="italic">Shalom aleikhem, malaḥei hashalom</tei:hi>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:supplemental_stanzas_to_the_piyyut_shalom_aleikhem_rubin/2"/>
        <tei:lg>
          <tei:l>Calling oh angels, angles of peace.</tei:l>
          <tei:l>May peace bless our hearts</tei:l>
          <tei:l>May peace bless our homes</tei:l>
          <tei:l>May peace bless each one of us</tei:l>
          <tei:l>Soul, flesh, and bone</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:supplemental_stanzas_to_the_piyyut_shalom_aleikhem_rubin/3"/>
        <tei:lg>
          <tei:l>May peace bless our waters</tei:l>
          <tei:l>And the earth that grows our food,</tei:l>
          <tei:l>May peace bless the metals that connect us</tei:l>
          <tei:l>and the hot fires that cook our food</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
