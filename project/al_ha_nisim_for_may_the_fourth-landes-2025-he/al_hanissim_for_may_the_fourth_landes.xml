    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:al_hanissim_for_may_the_fourth_landes">
        <tei:head>עַל הַנִּסִּים בְּמַאי הָרְבִיעִי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:al_hanissim_for_may_the_fourth_landes/1"/>
        <tei:lg>
          <tei:l>עַל הַנִּסִּים</tei:l>
          <tei:l>וְעַל הַפֻּרְקָן</tei:l>
          <tei:l>וְעַל הַגְּבוּרוֹת</tei:l>
          <tei:l>וְעַל הַתְּשׁוּעוֹת</tei:l>
          <tei:l>וְעַל הַנִּפְלָאוֹת</tei:l>
          <tei:l>וְעַל הַמִּלְחָמוֹת שֶׁעָשִׂיתָ לַאֲבוֹתֵינוּ</tei:l>
          <tei:l>בַּיָּמִים הַהֵם</tei:l>
          <tei:l>וּבְגָלַקְסְיָה רְחוֹקָה מְאוֹד,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:al_hanissim_for_may_the_fourth_landes/2"/>
        <tei:lg>
          <tei:l>‏‎בִּימֵי לוּק וְלֵאָה</tei:l>
          <tei:l>כְּשֶׁעָמְדָה מַלְכוּת פַּלְפָּטִין הָרְשָׁעָה</tei:l>
          <tei:l>לַהֲרֹס וּלְאַבֵּד,</tei:l>
          <tei:l>לְחַזֵּק אֶת הַצַּד הָאָפֵל,</tei:l>
          <tei:l>לְהַשְׁמִיד כַּדּוּרֵי לֶכֶת</tei:l>
          <tei:l>עִם יָרֵחַ שֶׁלֹּא יָרֵחַ,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:al_hanissim_for_may_the_fourth_landes/3"/>
        <tei:lg>
          <tei:l>וְאַתָּה בְּרַחֲמֶךָ הָרַבִּים</tei:l>
          <tei:l>עָמַדְתָּ לָהֶם בְּעֵת צָרָתָם</tei:l>
          <tei:l>רַבְתָּ אֶת רִיבָם</tei:l>
          <tei:l>דַּנְתָּ אֶת דִּינָם</tei:l>
          <tei:l>נָקַמְתָּ אֶת נִקְמָתָם,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:al_hanissim_for_may_the_fourth_landes/4"/>
        <tei:lg>
          <tei:l>מָסַרְתָּ גִּבּוֹרִים בְּיַד חַלָּשִׁים,</tei:l>
          <tei:l>רַבִּים בְּיַד מְעַטִּים,</tei:l>
          <tei:l>טְמֵאִים בְּיַד טְהוֹרִים,</tei:l>
          <tei:l>זֵדִים בְּיַד עוֹסְקֵי כּוֹחֲךָ,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:al_hanissim_for_may_the_fourth_landes/5"/>
        <tei:lg>
          <tei:l>וְאֶת פַּלְפָּטִין הִפַּלְתָּ וְאֶת וֵיידֹּר וִתַּרְתָּ,</tei:l>
          <tei:l>אֶת אֶנְדּוֹר שִׁחְרַרְתָּ וְקוֹרְסַנְט קָשַׁרְתָּ,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:al_hanissim_for_may_the_fourth_landes/6"/>
        <tei:lg>
          <tei:l>וְקָבְעוּ יוֹם זֶה בַּהַלֵּל וּבְהוֹדָאָה</tei:l>
          <tei:l>לְהוֹדוֹת וּלְהַלֵּל לְשִׁמְךָ הַגָּדוֹל.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
