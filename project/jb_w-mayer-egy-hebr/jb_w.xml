  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:jb_w">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:jb_w/1"/>
        <tei:lg>
          <tei:l>יב וע <tei:note type="instruction">(— ב׳ פעמי׳)</tei:note></tei:l>
          <tei:l>נתי ינן</tei:l>
          <tei:l>יתיי אם דבנוי</tei:l>
          <tei:l>יב וע <tei:note type="instruction">(— ב׳ פעמי׳)</tei:note></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:jb_w/2"/>
        <tei:lg>
          <tei:l>אחאן יאי מיו</tei:l>
          <tei:l>כׄר ונם יב</tei:l>
          <tei:l>נתי ינן</tei:l>
          <tei:l>יתיי אם דבנוי</tei:l>
          <tei:l>וב וע <tei:note type="instruction">(— ב׳ פעמי׳)</tei:note></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:jb_w/3"/>
        <tei:lg>
          <tei:l>אחאן יאי טזם</tei:l>
          <tei:l>כׄר פזח מיו</tei:l>
          <tei:l>נתי ונמן יב</tei:l>
          <tei:l>נתי ינן</tei:l>
          <tei:l>יתיי אם דבנוי</tei:l>
          <tei:l>יב וע <tei:note type="instruction">(— ב׳ פעמי׳)</tei:note></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:jb_w/4"/>
        <tei:lg>
          <tei:l>אחאן יאי כׄת</tei:l>
          <tei:l>כׄר סךׄ טזם</tei:l>
          <tei:l>נתי פזחן מיו</tei:l>
          <tei:l>נתי ונמן יב</tei:l>
          <tei:l>נתי ינן</tei:l>
          <tei:l>יתיי אם דבנוי</tei:l>
          <tei:l>יב וע <tei:note type="instruction">(— ב׳ פעמי׳)</tei:note></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:jb_w/5"/>
        <tei:lg>
          <tei:l>אחאן יאי סצת</tei:l>
          <tei:l>כׄר עם כׄת</tei:l>
          <tei:l>נתי סכׄן טזם</tei:l>
          <tei:l>נתי פזחן מיו</tei:l>
          <tei:l>נתי ונמן יב</tei:l>
          <tei:l>נתי ינן</tei:l>
          <tei:l>יתיי אם דבנוי</tei:l>
          <tei:l>יב וע <tei:note type="instruction">(— ב׳ פעמי׳)</tei:note></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:jb_w/6"/>
        <tei:lg>
          <tei:l>אחאן יאי מו</tei:l>
          <tei:l>כׄר יהם סצת</tei:l>
          <tei:l>נתת עמן כׄת</tei:l>
          <tei:l>נתי סכׄן טזם</tei:l>
          <tei:l>נתי פזחן מיו</tei:l>
          <tei:l>נתי ונמן יב</tei:l>
          <tei:l>נתי ינן</tei:l>
          <tei:l>יתיי אם דבנוי</tei:l>
          <tei:l>יב וע <tei:note type="instruction">(— ב׳ פעמי׳)</tei:note></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:jb_w/7"/>
        <tei:lg>
          <tei:l>אחאן יאי יח</tei:l>
          <tei:l>כׄר זור מו</tei:l>
          <tei:l>נתי יהמן סצת</tei:l>
          <tei:l>נתת עמן כׄת</tei:l>
          <tei:l>נתי סכׄן טזם</tei:l>
          <tei:l>נתי פזחן מיו</tei:l>
          <tei:l>נתי ונמן יב</tei:l>
          <tei:l>נתי ינן</tei:l>
          <tei:l>יתיי אם דבנוי</tei:l>
          <tei:l>יב וע <tei:note type="instruction">(— ב׳ פעמי׳)</tei:note></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:jb_w/8"/>
        <tei:lg>
          <tei:l>אחאן יאי מחונו</tei:l>
          <tei:l>כׄר רכׄס יח</tei:l>
          <tei:l>נתי זורן מו</tei:l>
          <tei:l>נתי יהמן סצת</tei:l>
          <tei:l>נתת עמן כׄת</tei:l>
          <tei:l>נתי סכׄן טזם</tei:l>
          <tei:l>נתי פזחן מיו</tei:l>
          <tei:l>נתי ונמן יב</tei:l>
          <tei:l>נתי ינן</tei:l>
          <tei:l>יתיי אם דבנוי</tei:l>
          <tei:l>יב וע <tei:note type="instruction">(— ב׳ פעמי׳)</tei:note></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:jb_w/9"/>
        <tei:lg>
          <tei:l>אחאן יאי עךׄ ני מות</tei:l>
          <tei:l>כׄר דן מחונו</tei:l>
          <tei:l>נתי רכׄסן יח</tei:l>
          <tei:l>נתי זורן מו</tei:l>
          <tei:l>נתי יהמן סצת</tei:l>
          <tei:l>נתת עמן כׄת</tei:l>
          <tei:l>נתי סכׄן טזם</tei:l>
          <tei:l>נתי פזחן מיו</tei:l>
          <tei:l>נתי ונמן יב</tei:l>
          <tei:l>נתי ינן</tei:l>
          <tei:l>יתיי אם דבנוי</tei:l>
          <tei:l>יב וע <tei:note type="instruction">(— ב׳ פעמי׳)</tei:note></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:jb_w/10"/>
        <tei:lg>
          <tei:l>אחאן יאי צסר נטר אע</tei:l>
          <tei:l>כׄר כׄדב עךׄ ני מות</tei:l>
          <tei:l>נתי דנן מחונו</tei:l>
          <tei:l>נתי רכׄסן יח</tei:l>
          <tei:l>נתי זורן מו</tei:l>
          <tei:l>נתי יהמן סצת</tei:l>
          <tei:l>נתת עמן כׄת</tei:l>
          <tei:l>נתי סכׄן טזם</tei:l>
          <tei:l>נתי פזחן מיו</tei:l>
          <tei:l>נתי ונמן יב</tei:l>
          <tei:l>נתי ינן</tei:l>
          <tei:l>יתיי אם דבנוי</tei:l>
          <tei:l>יב וע <tei:note type="instruction">(— ב׳ פעמי׳)</tei:note></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
