    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/36">
        <tei:head>תְּהִלִּים ל״ו</tei:head>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>לַמְנַצֵּ֬חַ ׀ לְעֶֽבֶד־יְהוָ֬ה לְדָוִֽד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/36/2/a"/>
        <tei:lg>
          <tei:l>נְאֻֽם־פֶּ֣שַׁע לָ֭רָשָׁע בְּקֶ֣רֶב לִבִּ֑י</tei:l>
          <tei:l>אֵֽין־פַּ֥חַד אֱ֝לֹהִ֗ים לְנֶ֣גֶד עֵינָֽיו׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/36/3/a"/>
        <tei:lg>
          <tei:l>כִּֽי־הֶחֱלִ֣יק אֵלָ֣יו בְּעֵינָ֑יו</tei:l>
          <tei:l>לִמְצֹ֖א עֲוֺנ֣וֹ לִשְׂנֹֽא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/36/4/a"/>
        <tei:lg>
          <tei:l>דִּבְרֵי־פִ֭יו אָ֣וֶן וּמִרְמָ֑ה</tei:l>
          <tei:l>חָדַ֖ל לְהַשְׂכִּ֣יל לְהֵיטִֽיב׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/36/5"/>
        <tei:lg>
          <tei:l>אָ֤וֶן ׀ יַחְשֹׁ֗ב עַֽל־מִשְׁכָּ֫ב֥וֹ</tei:l>
          <tei:l>יִ֭תְיַצֵּב עַל־דֶּ֣רֶךְ לֹא־ט֑וֹב</tei:l>
          <tei:l>רָ֝֗ע לֹ֣א יִמְאָֽס׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>יְ֭הוָה בְּהַשָּׁמַ֣יִם חַסְדֶּ֑ךָ</tei:l>
          <tei:l>אֱ֝מֽוּנָתְךָ֗ עַד־שְׁחָקִֽים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/36/7/a"/>
        <tei:lg>
          <tei:l>צִדְקָֽתְךָ֨ ׀ כְּֽהַרְרֵי־אֵ֗ל</tei:l>
          <tei:l>מִ֭שְׁפָּטֶךָ תְּה֣וֹם רַבָּ֑ה</tei:l>
          <tei:l>אָ֤דָֽם־וּבְהֵמָ֖ה תוֹשִׁ֣יעַ יְהוָֽה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/36/8"/>
        <tei:lg>
          <tei:l>מַה־יָּקָ֥ר חַסְדְּךָ֗ אֱלֹ֫הִ֥ים</tei:l>
          <tei:l>וּבְנֵ֥י אָדָ֑ם</tei:l>
          <tei:l>בְּצֵ֥ל כְּ֝נָפֶ֗יךָ יֶחֱסָיֽוּן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/36/9/a"/>
        <tei:lg>
          <tei:l>יִ֭רְוְיֻן מִדֶּ֣שֶׁן בֵּיתֶ֑ךָ</tei:l>
          <tei:l>וְנַ֖חַל עֲדָנֶ֣יךָ תַשְׁקֵֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>כִּֽי־עִ֭מְּךָ מְק֣וֹר חַיִּ֑ים</tei:l>
          <tei:l>בְּ֝אוֹרְךָ֗ נִרְאֶה־אֽוֹר׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>מְשֹׁ֣ךְ חַ֭סְדְּךָ לְיֹדְעֶ֑יךָ</tei:l>
          <tei:l>וְ֝צִדְקָֽתְךָ֗ לְיִשְׁרֵי־לֵֽב׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>אַל־תְּ֭בוֹאֵנִי רֶ֣גֶל גַּאֲוָ֑ה</tei:l>
          <tei:l>וְיַד־רְ֝שָׁעִ֗ים אַל־תְּנִדֵֽנִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/36/13/a"/>
        <tei:lg>
          <tei:l>שָׁ֣ם נָ֭פְלוּ פֹּ֣עֲלֵי אָ֑וֶן</tei:l>
          <tei:l>דֹּ֝ח֗וּ וְלֹא־יָ֥כְלוּ קֽוּם׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
