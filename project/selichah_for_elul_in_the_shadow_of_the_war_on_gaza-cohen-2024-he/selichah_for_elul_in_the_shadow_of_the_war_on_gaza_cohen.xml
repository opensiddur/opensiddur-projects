    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:selichah_for_elul_in_the_shadow_of_the_war_on_gaza_cohen">
        <tei:head>סְלִיחָה לְחֹדֶשׁ אֱלוּל בְּצֵל הַמִּלְחָמָה בְּעַזָּה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:selichah_for_elul_in_the_shadow_of_the_war_on_gaza_cohen/1"/>
        <tei:lg>
          <tei:l>וַיִּשְׁמַן יְשֻׁרוּן וַיִּבְעָט</tei:l>
          <tei:l>שָׁמַנְתָּ עָבִיתָ כָּשִׂיתָ</tei:l>
          <tei:l>וַיִּטֹּשׁ אֱלוֹהַּ עָשָׂהוּ</tei:l>
          <tei:l>וַיְנַבֵּל צוּר יְשֻׁעָתוֹ. <tei:bibl>(דברים לב:טו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:selichah_for_elul_in_the_shadow_of_the_war_on_gaza_cohen/2"/>
        <tei:lg>
          <tei:l>שָׁמְנֵנוּ, עָבִינוּ, כְּשִׂנּוּ,</tei:l>
          <tei:l>נִטַּשְׁנוּ אֱלוֹהַּ עוֹשֵׂנוּ,</tei:l>
          <tei:l>נָבַלְנוּ צוּר יְשׁוּעָתֵנוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:selichah_for_elul_in_the_shadow_of_the_war_on_gaza_cohen/3"/>
        <tei:lg>
          <tei:l>הֶאָמַנְנוּ בֶּאֱלֹהֵי הַכֹּחַ,</tei:l>
          <tei:l>זָנַחְנוּ אֶת צָרְכֵי הַדַּל.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:selichah_for_elul_in_the_shadow_of_the_war_on_gaza_cohen/4"/>
        <tei:lg>
          <tei:l>הֵסַטְנוּ אֶת עֵינֵינוּ מִמַּעֲשֵׂה יָדֵינוּ,</tei:l>
          <tei:l>לְזַעֲקוֹת קָרְבְּנוֹתֵינוּ אִטַּמְנוּ אֶת אָזְנֵינוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:selichah_for_elul_in_the_shadow_of_the_war_on_gaza_cohen/5"/>
        <tei:lg>
          <tei:l>גַּם אֶת אַחֵינוּ וְאַחְיוֹתֵינוּ נָטַשְׁנוּ בְּשָׂדוֹת זָרִים,</tei:l>
          <tei:l>בְּעַד נִצָּחוֹן מְדֻמֶּה שִׁלַּמְנוּ בְּדָמִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:selichah_for_elul_in_the_shadow_of_the_war_on_gaza_cohen/6"/>
        <tei:lg>
          <tei:l>אֵין לָנוּ עַל מָה לְהִשָּׁעֵן</tei:l>
          <tei:l>בְּעָמְדֵנוּ לְפָנֶיךָ דָּר מְרוֹמִים,</tei:l>
          <tei:l>כְּבָר הִבְטַחְנוּ שֶׁנָּשׁוּב</tei:l>
          <tei:l>וְלֹא שַׁבְנוּ, חַי עוֹלָמִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:selichah_for_elul_in_the_shadow_of_the_war_on_gaza_cohen/7"/>
        <tei:lg>
          <tei:l>לִבֵּנוּ לִבְנֵי מִשְׁפְּחוֹתֵינוּ אֲשֶׁר דָּמָם נִשְׁפַּךְ.</tei:l>
          <tei:l>עַל הַנִּרְצָחִים בָּכִינוּ וּבוֹכִים.</tei:l>
          <tei:l>עַל זְקֵנוֹת וָטַף.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:selichah_for_elul_in_the_shadow_of_the_war_on_gaza_cohen/8"/>
        <tei:lg>
          <tei:l>אָז הִתַּרְנוּ אֶת הָרְצוּעָה,</tei:l>
          <tei:l>הָרֶסֶן נִשְׁלַח.</tei:l>
          <tei:l>וְהָיִינוּ עִוְּרִים וְחָרָשִׁים</tei:l>
          <tei:l>לַאֲשֶׁר עוֹלְלוּ אַחֵינוּ בִּשְׂדֵה קְרָב.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:selichah_for_elul_in_the_shadow_of_the_war_on_gaza_cohen/9"/>
        <tei:lg>
          <tei:l>עָרִים נְשָׁמוֹת, בָּתִּים הָרוּסִים, בָּתֵּי תְּפִלָּה רְמוּסִים, עִיֵּי חֳרָבוֹת.</tei:l>
          <tei:l>מִן הָאֲוִיר ומן הַיַּבָּשָׁה, יָרוּ וְהִפְצִיצוּ, כְּפָרִים וַעֲיָרוֹת שְׁלֵמוֹת.</tei:l>
          <tei:l>מִשְׁפָּחוֹת שְׁלֵמוֹת, דּוֹרוֹת עַל דּוֹרוֹת נֶהֶרְגוּ, כֹּחוֹתֵינוּ פָּשְׁטוּ וְכָבְשׁוּ</tei:l>
          <tei:l>וְחַיָּלִים יְהוּדִים הִתְגָּאוּ בִּבְזִיזָה בְּשֹׁד בְּהֶרֶג.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:selichah_for_elul_in_the_shadow_of_the_war_on_gaza_cohen/10"/>
        <tei:lg>
          <tei:l>הֲשִׁיבֵנוּ יְהֹוָה אֵלֶיךָ</tei:l>
          <tei:l>וְנָשׁוּבָה (ונשוב)</tei:l>
          <tei:l>חַדֵּשׁ יָמֵינוּ כְּקֶדֶם. <tei:bibl>(איכה ה:כא)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
