  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:gebed_voor_het_koninklijk_huis">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gebed_voor_het_koninklijk_huis/3"/>
        <tei:lg>
          <tei:l>A Sua Majestade a Rainha dos Paizes Baixos</tei:l>
          <tei:l>e Seu Real Consorte;</tei:l>
          <tei:l>as serenissimas Princezas suas Filhas,</tei:l>
          <tei:l>a serenissima Princeza, madama Sua May;</tei:l>
          <tei:l>aos descendentes da Caza Real de Orange-Nassâo;</tei:l>
          <tei:l>aos illustres Membros</tei:l>
          <tei:l>que concorren no Governo destas Terras</tei:l>
          <tei:l>e aos nobres e veneraveis Senhores Burgamestre e Magistrados</tei:l>
          <tei:l>desta Cidade de Amsterdam.</tei:l>
        </tei:lg>
      </tei:div>
