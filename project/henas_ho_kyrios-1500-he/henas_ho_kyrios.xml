  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/1"/>
        <tei:lg>
          <tei:l><tei:anchor xml:id="note_2"/>אֶחָד מֶלֶךְ יְיָי</tei:l>
          <tei:l>מִן הַעוֹלַם וְעָד הַעוֹלָם הוּא חַי</tei:l>
          <tei:l>בֵלִי גוּף וְצוּרָה</tei:l>
          <tei:l>וְיִשְׂרָאֵל הַלְלוּ־יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/2"/>
        <tei:lg>
          <tei:l>הַיָבַשַה הִפְרִיד מִן הַיָם</tei:l>
          <tei:l>הַשָמַיִם וְכֹל צֵבַאַם</tei:l>
          <tei:l>בַאָמִירַה וְחָכְמַה</tei:l>
          <tei:l>וְיִשְׂרָאֵל הַלְלוּ־יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/3"/>
        <tei:lg>
          <tei:l>וּלְסִינַי יָרַד</tei:l>
          <tei:l>תוֹרָה קֵדוֹשַה נַתַן לַנוּ החרד</tei:l>
          <tei:l>בֵקוֹלוֹת וּבְרָקִים וּבַרַד</tei:l>
          <tei:l>וְיִשְׂרָאֵל הַלְלוּ־יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/4"/>
        <tei:lg>
          <tei:l>לְמֹשֶה רַבֵינוּ רוֹעֶה</tei:l>
          <tei:l>הַנֶאֵמַן בֵכֹל דִי לֵיה</tei:l>
          <tei:l>נַתַן לוֹ הַתוֹרַה בֵלוּחוֹת שֵתֶי</tei:l>
          <tei:l>וְיִשְׂרָאֵל הַלְלוּ־יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/5"/>
        <tei:lg>
          <tei:l>וְיִשְׂרָאֵל קִבֵל אוֹתַה</tei:l>
          <tei:l>וּבְלִבוֹ נַטַע אוֹתַה</tei:l>
          <tei:l>כֵעֶדֶן טוֹב שוֹמֵר אוֹתַה</tei:l>
          <tei:l>וְיִשְרָאֵל הַלְלוּ־יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/6"/>
        <tei:lg>
          <tei:l>שַבַת ראֹש חֹדֶש וּמִילַה</tei:l>
          <tei:l>נַתַן לַנוּ אֶל נוֹרַא עַלִילַה</tei:l>
          <tei:l>בֵלִי שוּם מִילוּד וּמִילָה</tei:l>
          <tei:l>וְיִשְׂרָאֵל הַלְלוּ־יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/13"/>
        <tei:lg>
          <tei:l>לְקַדֶש אֶת יוֹם הַשָבַת</tei:l>
          <tei:l>כִי בֵּיוֹם הוּא נִישְבָת</tei:l>
          <tei:l>שֵשֶת יָמִים נַעָשֶה מֵלַאכַה</tei:l>
          <tei:l>וְיִשְׂרָאֵל הַלְלוּ־יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/14"/>
        <tei:lg>
          <tei:l>לְכַבֵד אַבַא וְאִימַא</tei:l>
          <tei:l>שֶנִיחְיֶה עָל הַאַדַמַה</tei:l>
          <tei:l>וּמְהַנְחִיל עוֹלַם אַבָא</tei:l>
          <tei:l>וְיִשְׂרָאֵל הַלְלוּ־יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/15"/>
        <tei:lg>
          <tei:l>לֹא תִרְצַח לֹא תִנְאָף לֹא תִגְנוֹב</tei:l>
          <tei:l>אֵשֶת רֵיעָךָ לֹא תָחְמוֹד</tei:l>
          <tei:l>וּלְאָמִין בֵשֶם יְיָי</tei:l>
          <tei:l>וְיִשְׂרָאֵל הַלְלוּ־יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/16"/>
        <tei:lg>
          <tei:l>לֹא תַעַנֶה בֵרֶעַךָ עֵד שָוא</tei:l>
          <tei:l>וּבֵית רֶיעָךָ לֹא תִתְאַו</tei:l>
          <tei:l>וְלַעַזוֹר אֶת בֵחִירֵי יָהּ</tei:l>
          <tei:l>וְיִשְׂרָאֵל הַלְלוּ־יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/17"/>
        <tei:lg>
          <tei:l>אֵל חַי קָיָם וְנוֹרַא</tei:l>
          <tei:l>הַצִילְינוּ בִמְהֵרַה</tei:l>
          <tei:l>שֶלַח לַנוּ הַגְאוּלַה</tei:l>
          <tei:l>וְיִשְׂרָאֵל הַלְלוּ־יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/19"/>
        <tei:lg>
          <tei:l>וְנַעַלֶה לְשַלֹש רְגַלִים</tei:l>
          <tei:l>בֵמִנחַת הַבִיכוּרִים</tei:l>
          <tei:l>וְנַקְרִיב קֹרבַן עוֹלָה</tei:l>
          <tei:l>וְיִשְׂרָאֵל הַלְלוּ־יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/20"/>
        <tei:lg>
          <tei:l><tei:anchor xml:id="note_14"/>ז שובנו לגבולינו</tei:l>
          <tei:l>מהרה התר עולינו</tei:l>
          <tei:l>ונשוררך גואלינו</tei:l>
          <tei:l>בשלש פעמי רגלינו</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
