      </j:conditional>
      <tei:div type="colophon" subtype="introduction">
        <tei:p>This prayer for democracy is an appeal to each other and to everyone who realizes what real freedom is and how fragile it is if we are not alert. Whether you call that praying or something else, that does not matter.</tei:p>
      </tei:div>
      <j:endConditional target="#osp_62942_introduction"/>
      <j:conditional xml:id="osp_62942_notes">
        <tei:fs type="opensiddur:paratext">
