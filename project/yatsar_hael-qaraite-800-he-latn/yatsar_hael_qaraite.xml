  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yatsar_hael_qaraite">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yatsar_hael_qaraite/1"/>
        <tei:lg>
          <tei:l>Yatsar ha’El et ha`olam:</tei:l>
          <tei:l>Sheshet yamim killa chullam:</tei:l>
          <tei:l>Yom shevi`i mikkelalam:</tei:l>
          <tei:l>Ḳiddesh oto gam berchahu:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yatsar_hael_qaraite/2"/>
        <tei:lg>
          <tei:l>`Al ken tsivva livné `ammo:</tei:l>
          <tei:l>Lishbot bayyom hahu lishmo:</tei:l>
          <tei:l>Ulhishtaḥavot el hadomo:</tei:l>
          <tei:l>`Im shevaḥot shabbeḥuhu:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yatsar_hael_qaraite/3"/>
        <tei:lg>
          <tei:l>Ḳir’u shirim banne`imim:</tei:l>
          <tei:l>Ushtu yenot `im mat`imim:</tei:l>
          <tei:l>Ya`an zé yom yom ta`atsumim:</tei:l>
          <tei:l>Ki ḳadosh hu ḳaddeshuhu:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yatsar_hael_qaraite/4"/>
        <tei:lg>
          <tei:l>Berach ha’El et hash-shabbat:</tei:l>
          <tei:l>Ya`an ki vo beyom shavat:</tei:l>
          <tei:l>Moré el ḳadmuto shabbat:</tei:l>
          <tei:l>Ki eḥad hu yaḥaduhu:</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
