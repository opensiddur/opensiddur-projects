      <tei:div corresp="urn:x-opensiddur:text:poem:a_berach_dodi_for_pesach_sheni_mayer">
        <tei:head>בְּרַח דּוֹדִי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_berach_dodi_for_pesach_sheni_mayer/1"/>
        <tei:lg>
          <tei:l>...גֹּאֲלֵ֕נוּ</tei:l>
          <tei:l>יְהוָ֥ה צְבָא֖וֹת שְׁמ֑וֹ</tei:l>
          <tei:l>קְד֖וֹשׁ יִשְׂרָאֵֽל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_berach_dodi_for_pesach_sheni_mayer/2"/>
        <tei:lg>
          <tei:l>בְּרַח דּוֹדִי! יְׄשֵׁנָה אֲנִי וְלִבִּי עֵר.</tei:l>
          <tei:l>צַׄח וְאָדוֹם חָׄמַֽקְתָּ עָבַֽרְתָּ קָׄרָֽאתִי בָּתֵּֽינוּ בּוֹעֵר.</tei:l>
          <tei:l>הַׄסּוֹבְבִים כָּׄרְתוּ אֶת־הָׄאֵפוֹד מֵעָלַי כְּדֵי לִי לְצַעֵר.</tei:l>
          <tei:l>נַׄפְשִׁי יָצָא חַׄזְּׄקֵֽׄנִי נָא וְׄאַׄמְּׄצֵֽׄנִי וְאַל־נָא תְּבַעֵר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_berach_dodi_for_pesach_sheni_mayer/3"/>
        <tei:lg>
          <tei:l>בְּרַח דּוֹדִי! יָׄרַֽדְתִּי אֶל־גִּׄנַּת אֱגוֹז דּׄוֹדִי לִרְאוֹת בְּגַנִּים.</tei:l>
          <tei:l>לַׄעֲרוּגַת בׇּׄשְׂמְךָ תְּׄלַקֵּט עוֹד שׁוֹשַׁנִּים.</tei:l>
          <tei:l>וּׄרְׄאֵֽנָה הַׄבָּנוֹת וּׄצְאֶֽינָה בְּבֵית הַגּוֹרְנִים.</tei:l>
          <tei:l>בֵּׄית זְׄבוּל מֵׄאֶֽרֶז רָׄהִׄיטֵֽנוּ עַל־פַּרְדֵּס רִמּוֹנִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_berach_dodi_for_pesach_sheni_mayer/4"/>
        <tei:lg>
          <tei:l>בְּרַח דּוֹדִי! כִּׄי חוֹלַת אַהֲבָה נַׄפְשִׁי בְּאַהֲבַת יְׄרִיעוֹת אֹהָלֶֽיךָ.</tei:l>
          <tei:l>הָׄשֵׁב יִׄשְׂרָאֵל רַׄעְיָתְךָ לְבֵיתָהּ צִׄיּוֹן לְקַיֵּם מִצְוֺתֶֽיךָ.</tei:l>
          <tei:l>וּׄבְבֵית הַמִּקְדָּשׁ נִׄזְבָּח אֶׄת־מִׄנְׄחוֹתֵֽינוּ נְקִיִּים כְּדִכְתִיב בְּתוֹרָתֶֽךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_berach_dodi_for_pesach_sheni_mayer/5"/>
        <tei:lg>
          <tei:l>בִּגְלַל אָבוֹת תּוֹשִֽׁיעַ בָּנִים</tei:l>
          <tei:l>וְתָבִיא גְּאֻלָּה לִבְנֵי בְנֵיהֶם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_berach_dodi_for_pesach_sheni_mayer/6"/>
        <tei:lg>
          <tei:l>בָּאַ״יְ גָּאַל יִשְׂרָאֵל׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
