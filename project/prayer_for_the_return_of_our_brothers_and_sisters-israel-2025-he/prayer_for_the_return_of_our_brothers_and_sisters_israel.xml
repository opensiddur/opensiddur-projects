    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_the_return_of_our_brothers_and_sisters_israel">
        <tei:head>תְּפִלָּה לְהֲשָׁבַת אַחֵינוּ וְאַחְיוֹתֵינוּ אֲשֶׁר בַּשֶּׁבִי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_return_of_our_brothers_and_sisters_israel/1"/>
        <tei:lg>
          <tei:l>אֱלֹהֵי יִשְׂרָאֵל, צוּר יִשְׂרְאֵל וְגוֹאֲלוֹ,</tei:l>
          <tei:l>אֵל רַחוּם וְחַנּוּן,</tei:l>
          <tei:l>בִּתְפִלָה וּבְתַחֲנוּנִים אָנוּ פּוֹנִים אֵלֶיךָ בָּעֵת הַזֹּאת,</tei:l>
          <tei:l>לְהַחֲזִיר אֶת יֶתֶר הַחֲטוּפִים וְהַחֲטוּפוֹת</tei:l>
          <tei:l>שֶׁנֶּעֶקְרוּ בְּיַד זְדוֹנִית מִבָּתֵּיהֶם</tei:l>
          <tei:l>וְנֶחְטְפוּ אֶל אֶרֶץ אוֹיֵב וְרִשְׁעָה,</tei:l>
          <tei:l>בְּיוֹם שִׂמְחַת תּוֹרָה תשפ”ד, לִפְנֵי <tei:note type="instruction">(___)</tei:note> יָמִים וְלֵילוֹת.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_return_of_our_brothers_and_sisters_israel/2"/>
        <tei:lg>
          <tei:l>נוֹשְׂאִים אָנוּ תְּחִנָּתֵנוּ לְפָנֶיךָ:</tei:l>
          <tei:l>אַב הָרַחֲמִים,</tei:l>
          <tei:l>הֱיֵה נָא בְּעֶזְרָם,</tei:l>
          <tei:l>חַזֵּק אֶת רוּחָם</tei:l>
          <tei:l>וְהָגֵן בַּעֲדָם,</tei:l>
          <tei:l>וְהָשֵׁב אֶת כָּל הַחַיִּים בְּמְהֵרָה</tei:l>
          <tei:l>וּבִזְמַן קָרוֹב</tei:l>
          <tei:l>לְחֵיק מִשְׁפְּחוֹתֵיהֶם וְיַקִּירֵיהֶן</tei:l>
          <tei:l>כְּמוֹ שֶׁאָמַרְתָּ:</tei:l>
          <tei:l>”הִנְנִי שָׁב שְׁבוּת אָהֳלֵי יַעֲקוֹב</tei:l>
          <tei:l>וּמִשְׁכְּנֹתָיו אֲרַחֵם“ <tei:bibl>(ירמיהו ל:יח)</tei:bibl>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_return_of_our_brothers_and_sisters_israel/3"/>
        <tei:lg>
          <tei:l>אֱלֹהֵי הָרַחֲמִים,</tei:l>
          <tei:l>עָשֵׂה לַהֲשָׁבַת גּוּפוֹת אַחֵינוּ וְאַחְיוֹתֵינוּ הַקְּדוֹשִׁים</tei:l>
          <tei:l>הַמֻּחְזָקוֹת בַּשֶּׁבִי בִּידֵי בְּנֵי־עַוְלָה,</tei:l>
          <tei:l>לְמַעַן יִזְכּוּ</tei:l>
          <tei:l>לְחֶסֶד אַחֲרוֹן</tei:l>
          <tei:l>וְלִמְנוּחָה נְכוֹנָה</tei:l>
          <tei:l>בְּאֶרֶץ קָדְשְׁךָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_return_of_our_brothers_and_sisters_israel/4"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן</tei:l>
          <tei:l>שֶׁתְּחַזֵּק וְתִשְׁמֹר וּתְבָרְךְ</tei:l>
          <tei:l>אֶת קְבַרְנִיטֵי הַמְּדִינָה, רָאשֶׁיהָ וְיוֹעֲצֶיהָ,</tei:l>
          <tei:l>לְמַעַן יְהְיוּ שְׁלִיחֵי צִבּוּר נֶאֱמָנִים,</tei:l>
          <tei:l>וְתִצְּלַח דַּרְכָּם וּפָעֳלָם</tei:l>
          <tei:l>לַהֲשָׁבַת יֶתֶר <tei:note type="instruction">(___)</tei:note> הַחֲטוּפִים וְהַחֲטוּפוֹת,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_return_of_our_brothers_and_sisters_israel/5"/>
        <tei:lg>
          <tei:l>וִיקֻיַּם בָּנוּ בִּמְהֵרָה בְּיָמֵינוּ מִקְרָא שֶכָּתוּב:</tei:l>
          <tei:l>”וּפְדוּיֵי יְהֹוָה יְשׁוּבוּן</tei:l>
          <tei:l>וּבָאוּ צִיּוֹן בְּרִנָּה</tei:l>
          <tei:l>וְשִׂמְחַת עוֹלָם עַל־רֹאשָׁם</tei:l>
          <tei:l>שָׂשׂוֹן וְשִׂמְחָה יַשִּׂיגוּן</tei:l>
          <tei:l>נָסוּ יָגוֹן וַאֲנָחָה“ <tei:bibl>(ישעיהו נא:יא)</tei:bibl>.</tei:l>
          <tei:l>”וְשָׁבוּ בָּנִים וּבָנוֹת לִגְבוּלָם“ <tei:bibl>(ע״פ ירמיהו לא:טז)</tei:bibl>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_return_of_our_brothers_and_sisters_israel/6"/>
        <tei:lg>
          <tei:l>אָמֵן, כֵּן יְהִי רָצוֹן.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
