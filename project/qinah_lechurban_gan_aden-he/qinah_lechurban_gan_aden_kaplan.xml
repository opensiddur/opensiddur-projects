  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:qinah_lechurban_gan_aden_kaplan">
        <tei:head>קִינָה לְחֻרְבַּן גַּן עֵדֶן</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:qinah_lechurban_gan_aden_kaplan/1"/>
        <tei:lg>
          <tei:l>וַיְקוֹנֵן יִרְמְיָהוּ</tei:l>
          <tei:l>כַּאֲשֶׁר שָׁמַע אוֹתָהּ שָׁרָה</tei:l>
          <tei:l>הַקִּינָה לְחֻרְבַּן גַּן עֵדֶן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:qinah_lechurban_gan_aden_kaplan/4"/>
        <tei:lg>
          <tei:l>בָּכוֹ תִּבְכֶּה בַּלַּיְלָה</tei:l>
          <tei:l>וְדִמַּתָּהּ אַל לֶחְיָהּ</tei:l>
          <tei:l>אֵין לָהּ מְנַחֵם מִי כָּל אוֹהֲבֶיהָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:qinah_lechurban_gan_aden_kaplan/5"/>
        <tei:lg>
          <tei:l>הֲשִׁיבֵנוּ נִשְׁמַת הַנְּשָׁמוֹת</tei:l>
          <tei:l>אֵלֶיךָ וְנָשׁוּבָה</tei:l>
          <tei:l>חָדֵּשׁ יָמֵינוּ כְּעֵדֶן</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
