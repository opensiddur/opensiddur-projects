  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:on_recovering_from_sickness_montagu">
        <tei:head>[Prayer] on Recovering from Sickness, by Lilian Helen Montagu (1895)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_recovering_from_sickness_montagu/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">On Recovering from Sickness.</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_recovering_from_sickness_montagu/2"/>
        <tei:lg>
          <tei:l>Almighty Father!—</tei:l>
          <tei:l>By Thy mercy,</tei:l>
          <tei:l>I am once more able to enjoy</tei:l>
          <tei:l>the priceless gift of good health;</tei:l>
          <tei:l>once more I feel health in my limbs</tei:l>
          <tei:l>and strength in my mind.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_recovering_from_sickness_montagu/3"/>
        <tei:lg>
          <tei:l>Almighty God,</tei:l>
          <tei:l>I thank Thee for having kept me alive.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_recovering_from_sickness_montagu/4"/>
        <tei:lg>
          <tei:l>O Lord, teach me</tei:l>
          <tei:l>to use my health and strength</tei:l>
          <tei:l>to do Thy service.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_recovering_from_sickness_montagu/5"/>
        <tei:lg>
          <tei:l>Truly the light is sweet,</tei:l>
          <tei:l>and a pleasant thing it is</tei:l>
          <tei:l>for the eyes to behold the sun. <tei:bibl>(Ecclesiastes 11:7)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
