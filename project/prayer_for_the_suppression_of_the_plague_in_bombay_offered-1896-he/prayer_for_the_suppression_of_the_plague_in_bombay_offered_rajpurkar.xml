    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_the_suppression_of_the_plague_in_bombay_offered_rajpurkar">
        <tei:head>תפלה לעצור המגפה בעיר במבי יע״א</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_suppression_of_the_plague_in_bombay_offered_rajpurkar/1"/>
        <tei:lg>
          <tei:l>תפלה לעצור המגפה בעיר במבי יע״א</tei:l>
          <tei:l>שנאמרה בבית הכנסת שער הרחמים</tei:l>
          <tei:l>ביום תענית צבור כב לחודש חשון שנת הׄתׄרׄנׄזׄ</tei:l>
          <tei:l>מאת הצעיר יוסף יחזקאל יצ״ו</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_suppression_of_the_plague_in_bombay_offered_rajpurkar/2"/>
        <tei:lg>
          <tei:l>אֵל מָלֵא רַחֲמִים</tei:l>
          <tei:l>בּוֹשְׁנוּ וְנִכְלָמְנוּ לְהָרִים עֵינֵינוּ</tei:l>
          <tei:l>וְלִפְרוֹשׂ כַּפֵּינוּ אֵלֶיךָ</tei:l>
          <tei:l>וּלְבַקֵּשׁ רַחֲמִים מִמְּךָ</tei:l>
          <tei:l>כִּי עֲוֺנוֹתֵינוּ עָבְרוּ רָאֹשֵׁינוּ</tei:l>
          <tei:l>וְאַשְׁמוֹתֵינוּ גָּדְלוּ עַד לַשָּׁמַיִם׃</tei:l>
          <tei:l>וּמִדַּת הַדִּין קָשַׁה עָלֵינוּ</tei:l>
          <tei:l>וְנֶגַע פָּשָׂה עָלֵינוּ</tei:l>
          <tei:l>וְהַדֶּבֶר הוֹלֵךְ וְגָדֵל</tei:l>
          <tei:l>כִּי חָרָה אַפֶּיךָ</tei:l>
          <tei:l>וְהַקֶּצָף יָצָא מִלְּפָנֶיךָ יְיָ אֱלֹהֵינוּ׃</tei:l>
          <tei:l>וְאֵימוֹת מָוֶת נָפְלוּ עָלֵינוּ</tei:l>
          <tei:l>יִרְאָה וַרָעָד בָּאוּ בָּנוּ</tei:l>
          <tei:l>עַל כֵּן בָּאנוּ הַיּוֹם</tei:l>
          <tei:l>לִשְׁפּוֹךְ עַתֵרָתֵנוּ לִפְנֵי הֲדוֹם רַגְלֶיךָ</tei:l>
          <tei:l>וּלְעוֹרֵר רַחֲמֶיךָ עַל כָׇּל הַמְיַחֲלִים לְחַסְדֶּךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_suppression_of_the_plague_in_bombay_offered_rajpurkar/3"/>
        <tei:lg>
          <tei:l>אָב הָרַחְמָן</tei:l>
          <tei:l>הִתְמַלֵּא רַחֲמִים עָלֵינוּ</tei:l>
          <tei:l>וְקַבֵּל בְּרָצוֹן אֶת תְּפִלְַּתֵנוּ</tei:l>
          <tei:l>אַל תִּפֶן לְרִשְׁעֵינוּ</tei:l>
          <tei:l>וְאַל תִּתְעַלָּם מִבַּקָּשָׁתֵנוּ</tei:l>
          <tei:l>וַעֲנֵינוּ הַיּוֹם</tei:l>
          <tei:l>כְּמוֹ שְׁעָנִית לְמֹשֶׁה עַבְדֶּךָ</tei:l>
          <tei:l>וְאָמַרְתָּ אֵלָיו</tei:l>
          <tei:l>סָלַחְתִּי כִּדְבָּרֶיךָ</tei:l>
          <tei:l>כֵּן סְלַח לָנוּ אָבִינוּ</tei:l>
          <tei:l>וּמְחוֹל לָנוּ מַלְכֵּנוּ</tei:l>
          <tei:l>וְהָסֵר מִמְּנוּ</tei:l>
          <tei:l>וּמִכׇּל עַמְּךָ יִשְׂרָאֵל</tei:l>
          <tei:l>וּמִכׇּל יוֹשְׁבֵי הָאָרֶץ הַזֹאת</tei:l>
          <tei:l>דֶּבֶר וְרָעָב וְיָגוֹן וּמַגֵּפָה</tei:l>
          <tei:l>וְכֹל גְּזֵירוֹת קָשׁוֹת וְרָעוֹת׃</tei:l>
          <tei:l>וּבְצֵל כְּנָפֶיךָ תַּסְתִּירֵנוּ</tei:l>
          <tei:l>וְאַל תִּתֵּן הַמַּשְׁחִית לָבֹא אֶל בָּתֵּינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_suppression_of_the_plague_in_bombay_offered_rajpurkar/4"/>
        <tei:lg>
          <tei:l>בּוֹרֵא עוֹלָם</tei:l>
          <tei:l>הִנֵּה אֲנַחְנוּ בְּטוּחִים עַל רַחֲמֶיךָ</tei:l>
          <tei:l>וְנִשְׁעָנְנִים עַל רוֹב חֲסָדֶיךָ</tei:l>
          <tei:l>כִּי דַּרְכְּךָ לְהַאֲרִיךְ אַפֶּיךָ</tei:l>
          <tei:l>וּמִנְהָֽגְךָ לְרָחֵם עַל בִּרְיוֹתֶיךָ׃</tei:l>
          <tei:l>עֲנֵי אֶת עֲתֵרָתֵנוּ</tei:l>
          <tei:l>וְתַחְשׁוֹב אֶת תְּפִלָּתֵנוּ כִּקְטוֹרֶת הַסַּמִּים</tei:l>
          <tei:l>שֶׁהִקְטִירוּ לְפָנֶיךָ אַהֲרוֹן וּבָנָיו הַכֹּהֲנִים</tei:l>
          <tei:l>וְתַעֲצוֹר אֶת הַמַּגֵּפָה הַזֹּאת מֵעָלֵינוּ</tei:l>
          <tei:l>וּמֵעַל כׇּל עַמְּךָ יִשְׂרָאֵל</tei:l>
          <tei:l>וּמֵעַל כׇּל הַֽמְקַוִּים לִישׁוּעָתְךָ׃</tei:l>
          <tei:l>וַחֲמוֹל עַל כׇּל</tei:l>
          <tei:l>מֻכִּים</tei:l>
          <tei:l>וּנְגוּעִים</tei:l>
          <tei:l>כִּי אֵל רָחוּם וְחַנּוּן אַתָּה׃</tei:l>
          <tei:l>רְפָאֵינוּ יְיָ וְנֵרָפֵה</tei:l>
          <tei:l>הוֹשִׁיעֵנוּ וְנִוָּשֵׁעָה</tei:l>
          <tei:l>כִּי תְּהִלָּתֵנוּ אַתָּה׃</tei:l>
          <tei:l>הֱיֶה נָא קָרוֹב לְשַׁוְעָתֵנוּ</tei:l>
          <tei:l>וְטֶרֶם נִקְרָא אֵלֶיךָ אַתָּה תַעֲנֵנוּ׃</tei:l>
          <tei:l>כְּמוֹ שֶׁנֶּאֱמַר וְהָיָה</tei:l>
          <tei:l>טֶרֶם יִקְרָאוּ וַאֲנִי אֶאֱנֶה</tei:l>
          <tei:l>עוֹד הֵם מְדַבְּרִים וַאֲנִי אֶשְׁמָא׃</tei:l>
          <tei:l>כִּי אֵין לָנוּ רוֹפֵא נֶאֱמָן וְרַחְמָן זֻלָתֶךָ</tei:l>
          <tei:l>וְאֵין לָנוּ פּוֹדֶה וּמַצִּיל</tei:l>
          <tei:l>וְעוֹנֶה וּמְרַחֵם</tei:l>
          <tei:l>בְּכׇל עֵת צָרָה וְצוּקָה בִלְעָדֶיךָ׃</tei:l>
          <tei:l>וְעֲשֵׂה נָא עִמָּנוּ הַחֶסֶד הַזֶּה</tei:l>
          <tei:l>לְמַעֲנָךְ אִם לֹא לְמַעֲנֵנוּ</tei:l>
          <tei:l>וְהוֹשִׁיעֵנוּ מְהֵרָה לְמַעַן שְׁמֶךָ׃</tei:l>
          <tei:l>אמן כן יהי רצון׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
