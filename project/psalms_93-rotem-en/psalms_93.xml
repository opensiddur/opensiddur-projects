  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/93">
        <tei:head>Psalms 93, abridged translation by Rabbi Levi Weiman-Kelman and Efrat Rotem</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/93/1"/>
        <tei:lg>
          <tei:l>YHVH is enthroned,</tei:l>
          <tei:l>robed in grandeur;</tei:l>
          <tei:l>YHVH is robed,</tei:l>
          <tei:l>girded with strength.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>God founded the solid earth to be unmoving.</tei:l>
          <tei:l>Ageless is Your throne,</tei:l>
          <tei:l>endless Your being.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/93/4/a"/>
        <tei:lg>
          <tei:l>Great waters cry out,</tei:l>
          <tei:l>great breakers of the sea,</tei:l>
          <tei:l>YHVH’s majesty on high!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/93/5/a"/>
        <tei:lg>
          <tei:l>Your law stands firm;</tei:l>
          <tei:l>Your temple pleasing holiness</tei:l>
          <tei:l>YHVH until the end of time!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
