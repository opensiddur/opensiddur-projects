    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:barukh_sheamar_68751">
        <tei:head>בָּרוּךְ שֶׁאָמַר</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:barukh_sheamar_68751/1"/>
        <tei:lg>
          <tei:l>בָּרוּךְ שֶׁאָמַר וְהָיָה הָעוֹלָם</tei:l>
          <tei:l>בָּרוּךְ הוּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:barukh_sheamar_68751/2"/>
        <tei:lg>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">א</tei:seg>וֹמֵר וְעֹשֶׂה</tei:l>
          <tei:l>בָּרוּךְ רְצוֹן־יְרֵאָ֥יו יַעֲשֶׂ֑ה׃ <tei:bibl>(תהלים קמה:יט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:barukh_sheamar_68751/3"/>
        <tei:lg>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">בּ</tei:seg>וֹרֵא בְּרֵאשִׁית</tei:l>
          <tei:l>בָּרוּךְ מַגִּיד אַחֲרִית מֵרֵאשִׁית׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:barukh_sheamar_68751/4"/>
        <tei:lg>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">גּ</tei:seg>וֹזֵר וּמְקַיֵּם נוֹרָא וְאָיֹם</tei:l>
          <tei:l>בָּ֤ר֣וּךְ אֲדֹנָי֮ י֤וֹם ׀ י֥֫וֹם׃ <tei:bibl>(תהלים סח:כ)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:barukh_sheamar_68751/5"/>
        <tei:lg>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">דָּ</tei:seg>ג֖וּל מֵרְבָבָֽה <tei:bibl>(שיר השירים ה:ח)</tei:bibl></tei:l>
          <tei:l>בָּרוּךְ אֵל נַעֲרָץ וְנִקְדָשׁ בְּסוֹד קְדֹשִׁים רַבָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:barukh_sheamar_68751/6"/>
        <tei:lg>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">הַ</tei:seg>מְּהֻלָּל בְּפִי כׇּל־נֶֽפֶשׁ</tei:l>
          <tei:l>בָּרוּךְ וּבַיּוֹם֙ הַשְּׁבִיעִ֔י שָׁבַ֖ת וַיִּנָּפַֽשׁ׃ <tei:bibl>(שמות לא:יז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:barukh_sheamar_68751/7"/>
        <tei:lg>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">וְ</tei:seg>אֵין עוֹד מִלְּבַדּוֹ</tei:l>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">וְ</tei:seg>אֶל־עֲבָדָיו הַנְּבִיאִים גָּלָה סוֹדוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:barukh_sheamar_68751/8"/>
        <tei:lg>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">זַ</tei:seg>ן וּמְפַרְנֵס לַכֹּל</tei:l>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">זִ</tei:seg>כְרוֹ וּשְׁבָחוֹ תָּמִיד בְּפִי כֹּל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:barukh_sheamar_68751/9"/>
        <tei:lg>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">חַ</tei:seg>י לָעַד וְקַיָּם לָנֶֽצַח</tei:l>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">חַ</tei:seg>נּוּן אֲשֶׁר לוֹ הַגְּדֻלָּ֨ה וְהַגְּבוּרָ֤ה והַתִּפְאֶ֙רֶת֙ וְהַנֵּ֣צַח׃ <tei:bibl>(דברי הימים א׳ כט:יא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:barukh_sheamar_68751/10"/>
        <tei:lg>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">טְ</tei:seg>ה֤וֹר עֵינַ֙יִם֙ <tei:bibl>(חבקוק א:יג)</tei:bibl></tei:l>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">טָ</tei:seg>ס וְדִבֵּר מִבֵּין כְּרוּבִים שְׁנַֽיִם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:barukh_sheamar_68751/11"/>
        <tei:lg>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">יָ</tei:seg>הּ מִסְתַּתֵּר בְּחֶבְיוֹן</tei:l>
          <tei:l>בָּרוּךְ שׁוֹמֵֽעַ צַעֲקַת עַם עָנִי וְאֶבְיוֹן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:barukh_sheamar_68751/12"/>
        <tei:lg>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">כְּ</tei:seg>בוֹדוֹ מָלֵא שָׁמַֽיִם וָאָֽרֶץ</tei:l>
          <tei:l>בָּרוּךְ וְכָ֥ל בַּשָּׁלִ֖שׁ עֲפַ֣ר הָאָ֑רֶץ׃ <tei:bibl>(ישעיה מ:יב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:barukh_sheamar_68751/13"/>
        <tei:lg>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">לְ</tei:seg>בַדּוֹ שׁוֹכֵן עֲלִיָּתוֹ</tei:l>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">לֹ֥</tei:seg>א יִיעַ֖ף וְלֹ֣א יִיגָ֑ע אֵ֥ין חֵ֖קֶר לִתְבוּנָתֽוֹ׃ <tei:bibl>(ישעיה מ:כח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:barukh_sheamar_68751/14"/>
        <tei:lg>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">מַ</tei:seg>עֲבִיר אֲפֵלָה וּמֵבִיא אוֹרָה</tei:l>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">מְ</tei:seg>נַהֵג עַמּוֹ בֵּית יִשְׂרָאֵל בְּדֶֽרֶךְ יְשָׁרָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:barukh_sheamar_68751/15"/>
        <tei:lg>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">נֶ֝</tei:seg>אְזָ֗ר בִּגְבוּרָֽה <tei:bibl>(תהלים סה:ז)</tei:bibl></tei:l>
          <tei:l>בָּרוּךְ שׁוֹכֵן סְתָרִים וְעִמֵּהּ שְׁרֵא וּנְהוֹרָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:barukh_sheamar_68751/16"/>
        <tei:lg>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">שָׂ</tei:seg>ם עִמּוֹ הַמְשֵׁל וָפַֽחַד</tei:l>
          <tei:l>בָּרוּךְ אֲשֶׁר֙ לֹא־יִשָּׂ֣א פָנִ֔ים וְלֹ֥א יִקַּ֖ח שֹֽׁחַד׃ <tei:bibl>(דברים י:יז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:barukh_sheamar_68751/17"/>
        <tei:lg>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">עֹ</tei:seg>שֶׂה בִּמְרוֹמָיו שָׁלוֹם</tei:l>
          <tei:l>בָּרוּךְ לָרָחוֹק וְלַקָּרוֹב אָמַר שָׁלוֹם שָׁלוֹם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:barukh_sheamar_68751/18"/>
        <tei:lg>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">פֹּ</tei:seg>עֵ֥ל יְ֝שׁוּע֗וֹת <tei:bibl>(תהלים ז:יב)</tei:bibl></tei:l>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">צַ</tei:seg>דִּיק קֹרֵ֥א הַדֹּר֖וֹת׃ <tei:bibl>(ישעיה מא:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:barukh_sheamar_68751/19"/>
        <tei:lg>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">קָ</tei:seg>ד֧וֹשׁ ׀ קָד֛וֹשׁ קָד֖וֹשׁ אָיֹם וְנוֹרָא</tei:l>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">רַ</tei:seg>חוּם וְחַנּוּן וְעִמּוֹ גְּבוּרָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:barukh_sheamar_68751/20"/>
        <tei:lg>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">שַׁ</tei:seg>דַּי שֹׁכֵ֥ן עַד֙</tei:l>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">תְּ֝</tei:seg>הִלָּת֗וֹ עֹמֶ֥דֶת לָעַֽד׃ <tei:bibl>(תהלים קיא:י)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:barukh_sheamar_68751/21"/>
        <tei:lg>
          <tei:l>בָּרוּךְ שֶׁאֵין לְפָנָיו</tei:l>
          <tei:l>לֹא־עַוְלָה</tei:l>
          <tei:l>וְלֹא־שִׁכְחָה</tei:l>
          <tei:l>לֹא־כָּזָב</tei:l>
          <tei:l>וְלֹא־מִרְמָה</tei:l>
          <tei:l>לֹא־מַשּׂוֹא פָנִים</tei:l>
          <tei:l>וְלֹא־מֶֽקַח שֹֽׁחַד</tei:l>
          <tei:l>וְהַכֹּל שֶׁלּוֹ</tei:l>
          <tei:l>וְהַכֹּל בְּמַאֲמָרוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:barukh_sheamar_68751/22"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְהֹוָה אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>הָאֵל</tei:l>
          <tei:l>הָאָב הָרַחְמָן</tei:l>
          <tei:l>הַמֶּֽלֶךְ הַגָּדוֹל וְהַקָּדוֹשׁ</tei:l>
          <tei:l>הַמְּהֻלָּל בְּפִי עַמּוֹ בֵּית יִשְׂרָאֵל</tei:l>
          <tei:l>מְשֻׁבָּח וּמְפֹאָר וּמְרוֹמָם תָּמִיד</tei:l>
          <tei:l>בִּלְשׁוֹן כׇּל־חֲסִידָיו</tei:l>
          <tei:l>וְעַמּוֹ</tei:l>
          <tei:l>וַעֲבָדָיו</tei:l>
          <tei:l>בְּשִׁירֵי דָּוִד עַבְדְּךָ בֶּן יִשַׁי</tei:l>
          <tei:l>נְהַלֲּלֶֽךָ יְהֹוָה אֱלֹהֵֽינוּ</tei:l>
          <tei:l>בִּשְׁבָחוֹ וּבְשִׁירוֹ וּבְזִמְרוֹ</tei:l>
          <tei:l>נוֹדֶֽךָ</tei:l>
          <tei:l>נְשַׁבְּחֶֽךָ נְפָאֲרֶֽךָ נְרוֹמְמֶֽךָ</tei:l>
          <tei:l>נַמְלִיכֶֽךָ נַקְדִישֶֽׁךָ נַעְרִיצֶֽךָ</tei:l>
          <tei:l>נוֹדֶה לְפָנֶֽיךָ</tei:l>
          <tei:l>נַזְכִּירָךְ וְנַזְכִּיר אֶת־שְׁמָךְ וְזִכְרָךְ עָלֵֽינוּ</tei:l>
          <tei:l>מַלְכֵּֽנוּ</tei:l>
          <tei:l>תָּמִיד יַֽחַד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:barukh_sheamar_68751/23"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה</tei:l>
          <tei:l>מֶֽלֶךְ מְהֻלָּל בְּדִבְרֵי שִׁיר</tei:l>
          <tei:l>וּבְתֻשְׁבָּחוֹת תָּמִיד</tei:l>
          <tei:l>לְעוֹלָם וָעֶד׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>