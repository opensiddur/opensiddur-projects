  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:erti_tikani_a_cveneburuli_translation_of_had_gadya">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:erti_tikani_a_cveneburuli_translation_of_had_gadya/1"/>
        <tei:lg>
          <tei:l>Erti tiḳani, erti tiḳani</tei:l>
          <tei:l>rom iq̇ida mamačemma</tei:l>
          <tei:l>or abazad,</tei:l>
          <tei:l>erti tiḳani, erti tiḳani!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:erti_tikani_a_cveneburuli_translation_of_had_gadya/2"/>
        <tei:lg>
          <tei:l>Da movida ḳaṭa</tei:l>
          <tei:l>da šeč̣ama tiḳani,</tei:l>
          <tei:l>rom iq̇ida mamač̣emma</tei:l>
          <tei:l>or abazad,</tei:l>
          <tei:l>erti tiḳani, erti tiḳani!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:erti_tikani_a_cveneburuli_translation_of_had_gadya/3"/>
        <tei:lg>
          <tei:l>Da movida ʣaɣli</tei:l>
          <tei:l>da uḳbina ḳaṭas,</tei:l>
          <tei:l>rom šeč̣ama tiḳani,</tei:l>
          <tei:l>rom iq̇ida mamač̣emma</tei:l>
          <tei:l>or abazad,</tei:l>
          <tei:l>erti tiḳani, erti tiḳani!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:erti_tikani_a_cveneburuli_translation_of_had_gadya/4"/>
        <tei:lg>
          <tei:l>Da movida joxi</tei:l>
          <tei:l>da cema ʣaɣli,</tei:l>
          <tei:l>rom uḳbina ḳaṭas,</tei:l>
          <tei:l>rom šeč̣ama tiḳani,</tei:l>
          <tei:l>rom iq̇ida mamač̣emma</tei:l>
          <tei:l>or abazad,</tei:l>
          <tei:l>erti tiḳani, erti tiḳani!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:erti_tikani_a_cveneburuli_translation_of_had_gadya/5"/>
        <tei:lg>
          <tei:l>Da movida cecxli</tei:l>
          <tei:l>da dac̣va joxi,</tei:l>
          <tei:l>rom cema ʣaɣli,</tei:l>
          <tei:l>rom uḳbina ḳaṭas,</tei:l>
          <tei:l>rom šeč̣ama tiḳani,</tei:l>
          <tei:l>rom iq̇ida mamač̣emma</tei:l>
          <tei:l>or abazad,</tei:l>
          <tei:l>erti tiḳani, erti tiḳani!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:erti_tikani_a_cveneburuli_translation_of_had_gadya/6"/>
        <tei:lg>
          <tei:l>Da movida c̣q̇ali</tei:l>
          <tei:l>da č̣aakro cecxli,</tei:l>
          <tei:l>rom dac̣va joxi,</tei:l>
          <tei:l>rom cema ʣaɣli,</tei:l>
          <tei:l>rom uḳbina ḳaṭas,</tei:l>
          <tei:l>rom šeč̣ama tiḳani,</tei:l>
          <tei:l>rom iq̇ida mamač̣emma</tei:l>
          <tei:l>or abazad,</tei:l>
          <tei:l>erti tiḳani, erti tiḳani!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:erti_tikani_a_cveneburuli_translation_of_had_gadya/7"/>
        <tei:lg>
          <tei:l>Da movida xari</tei:l>
          <tei:l>da dalia c̣q̇ali,</tei:l>
          <tei:l>rom č̣aakro cecxli,</tei:l>
          <tei:l>rom dac̣va joxi,</tei:l>
          <tei:l>rom cema ʣaɣli,</tei:l>
          <tei:l>rom uḳbina ḳaṭas,</tei:l>
          <tei:l>rom šeč̣ama tiḳani,</tei:l>
          <tei:l>rom iq̇ida mamač̣emma</tei:l>
          <tei:l>or abazad,</tei:l>
          <tei:l>erti tiḳani, erti tiḳani!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:erti_tikani_a_cveneburuli_translation_of_had_gadya/8"/>
        <tei:lg>
          <tei:l>Da movida šoxeṭa</tei:l>
          <tei:l>da daḳla xari,</tei:l>
          <tei:l>rom dalia c̣q̇ali,</tei:l>
          <tei:l>rom č̣aakro cecxli,</tei:l>
          <tei:l>rom dac̣va joxi,</tei:l>
          <tei:l>rom cema ʣaɣli,</tei:l>
          <tei:l>rom uḳbina ḳaṭas,</tei:l>
          <tei:l>rom šeč̣ama tiḳani,</tei:l>
          <tei:l>rom iq̇ida mamač̣emma</tei:l>
          <tei:l>or abazad,</tei:l>
          <tei:l>erti tiḳani, erti tiḳani!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:erti_tikani_a_cveneburuli_translation_of_had_gadya/9"/>
        <tei:lg>
          <tei:l>Da movida malax amaveti</tei:l>
          <tei:l>da daḳla šoxeṭa,</tei:l>
          <tei:l>rom daḳla xari,</tei:l>
          <tei:l>rom dalia c̣q̇ali,</tei:l>
          <tei:l>rom č̣aakro cecxli,</tei:l>
          <tei:l>rom dac̣va joxi,</tei:l>
          <tei:l>rom cema ʣaɣli,</tei:l>
          <tei:l>rom uḳbina ḳaṭas,</tei:l>
          <tei:l>rom šeč̣ama tiḳani,</tei:l>
          <tei:l>rom iq̇ida mamač̣emma</tei:l>
          <tei:l>or abazad,</tei:l>
          <tei:l>erti tiḳani, erti tiḳani!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:erti_tikani_a_cveneburuli_translation_of_had_gadya/10"/>
        <tei:lg>
          <tei:l>Da mobrʣanda aḳadoš baruxu</tei:l>
          <tei:l>da daḳla malax amaveti,</tei:l>
          <tei:l>rom daḳla šoxeṭi,</tei:l>
          <tei:l>rom daḳla xari,</tei:l>
          <tei:l>rom dalia c̣q̇ali,</tei:l>
          <tei:l>rom č̣aakro cecxli,</tei:l>
          <tei:l>rom dac̣va joxi,</tei:l>
          <tei:l>rom cema ʣaɣli,</tei:l>
          <tei:l>rom uḳbina ḳaṭas,</tei:l>
          <tei:l>rom sheč̣ama tiḳani,</tei:l>
          <tei:l>rom iq̇ida mamač̣emma</tei:l>
          <tei:l>or abazad,</tei:l>
          <tei:l>erti tiḳani, erti tiḳani!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
