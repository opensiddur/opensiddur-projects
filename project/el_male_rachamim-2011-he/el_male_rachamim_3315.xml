  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:el_male_rachamim_3315">
        <tei:head>אֵל מָלֵא רַחֲמִים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:el_male_rachamim_3315/1"/>
        <tei:lg>
          <tei:l>אֵל מָלֵא רַחֲמִים שׁוֹכֵן בַּמְּרוֹמִים,</tei:l>
          <tei:l>הַמְצֵא מְנוּחָה נְכוֹנָה עַל כַּנְפֵי הַשְּׁכִינָה,</tei:l>
          <tei:l>בְּמַעֲלוֹת קְדוֹשִׁים וּטְהוֹרִים</tei:l>
          <tei:l>כְּזוֹהַר הָרָקִיעַ מַזְהִירִים,</tei:l>
          <tei:l>בורך טוב בן בלימע ושלמה אֶת נִשְׁמַת</tei:l>
          <tei:l>שֶׁהָלַךְ לְעוֹלָמוֹ, בְּגַן עֵדֶן תְּהֵא מְנוּחָתוֹ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:el_male_rachamim_3315/2"/>
        <tei:lg>
          <tei:l>[אָנָא,] בַּעַל הָרַחֲמִים יַסְתִּירֵהוּ</tei:l>
          <tei:l>בְּסֵתֶר [כְּנָפֶיךָ] כְּנָפָיו לְעוֹלָמִים,</tei:l>
          <tei:l>וְיִצְרֹר [וּצְרֹר] בִּצְרוֹר הַחַיִּים</tei:l>
          <tei:l>אֶת נִשְׁמָתוֹ, יְיָ הוּא נַחֲלָתוֹ,</tei:l>
          <tei:l>וְיָנוּחַ בְּשָׁלוֹם עַל מִשְׁכָּבוֹ,</tei:l>
          <tei:l>וְנֹאמַר אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
