    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:introductory_piyyut_for_the_arvit_service_cohen">
        <tei:head>פיוט לתפילת ערבית</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:introductory_piyyut_for_the_arvit_service_cohen/1"/>
        <tei:lg>
          <tei:l>
            <tei:bibl>ברכות כו ב׳</tei:bibl>
          </tei:l>
          <tei:l>יַעֲקֹב תִּקֵּן תְּפִלַּת עַרְבִית</tei:l>
          <tei:l>שֶׁנֶּאֱמַר ”וַיִּפְגַּע בַּמָּקוֹם</tei:l>
          <tei:l>וַיָּלֶן שָׁם</tei:l>
          <tei:l>כִּי־בָ֣א הַשֶּׁמֶשׁ <tei:bibl>(בראשית כח:יא)</tei:bibl>“</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:introductory_piyyut_for_the_arvit_service_cohen/2"/>
        <tei:lg>
          <tei:l>וְיִפְגַּע יַעֲקֹב בַּמָּקוֹם...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:introductory_piyyut_for_the_arvit_service_cohen/3"/>
        <tei:lg>
          <tei:l>בבֹא הַשֶּׁמֶשׁ, בְּלִי כַּוָּנָה</tei:l>
          <tei:l>מָקוֹם עֲלוּם שֵׁם, אֶל נִסְתָּר.</tei:l>
          <tei:l>יַעֲקֹב פָּגַשׁ אֶת אֲשֶׁר אָהַב</tei:l>
          <tei:l>וְשָׂם אֶת רֹאשׁוֹ עַל הָאֶבֶן וְשָׁכַב.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:introductory_piyyut_for_the_arvit_service_cohen/4"/>
        <tei:lg>
          <tei:l>***</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:introductory_piyyut_for_the_arvit_service_cohen/5"/>
        <tei:lg>
          <tei:l>וְשָׁכַנְתְּ. בְּתוֹכִי. וּבְשָׂרֵינוּ, נַפְשֵׁנוּ,</tei:l>
          <tei:l>לְאֶחָד הָיִינוּ.</tei:l>
          <tei:l>תְּפִלָּתִי קולֵךְ, רֶשֶׁף אֵשׁ קָדשֵׁך,</tei:l>
          <tei:l>שְׂפָתַי רְמִיָה שְׂפָתֵךְ דּוּמִיָּה,</tei:l>
          <tei:l>לוּ שָׁמַעְנוּ לוּ רָאִינוּ</tei:l>
          <tei:l>אֲחוּזֵי בַּלָּהוֹת הָיִינוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:introductory_piyyut_for_the_arvit_service_cohen/6"/>
        <tei:lg>
          <tei:l>צַעֲקוֹתֵינוּ עוֹלוֹת</tei:l>
          <tei:l>מִבֵּין הַכְּרוּבִים</tei:l>
          <tei:l>עֵת רָצוֹן, שְׁעַת דִּמְדּוּמִים</tei:l>
          <tei:l>פִּי הַבְּאֵר, פִּי הָאָתוֹן</tei:l>
          <tei:l>וְהַמַּלְאָכִים עוֹלִים וְיוֹרְדִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:introductory_piyyut_for_the_arvit_service_cohen/7"/>
        <tei:lg>
          <tei:l>עֶרְגָּה וְזַעַם זֶה בָּזוֹ אֲחוּזִים</tei:l>
          <tei:l>הָעוֹלָם בּוֹעֵר וַאֲנַחְנוּ רְדוּמִים</tei:l>
          <tei:l>וּבַעַל הַבִּירָה אִיּוֹ?</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:introductory_piyyut_for_the_arvit_service_cohen/8"/>
        <tei:lg>
          <tei:l>לָך דּוּמִיָּה תְּהִלָּה</tei:l>
          <tei:l>פַּעַם קוֹלוֹת וּבְרָקִים, כָּעֵת שְׁתִיקָה</tei:l>
          <tei:l>האֶל מְקוֹמֵךְ הָלַכתְּ וְדַיּוֹ?</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:introductory_piyyut_for_the_arvit_service_cohen/9"/>
        <tei:lg>
          <tei:l>בְּעָמְדִי לְפָנֶיךָ לֹא דֹּם אֲנִי</tei:l>
          <tei:l>בְּזִכְרִי אֶת הָעוֹלָם לֹא שָׁקֵט אָנֹכִי</tei:l>
          <tei:l>אֲבָל לְרֶגַע אֶרְפֶּה אֶת יָדַי הַקְּפוּצוֹת</tei:l>
          <tei:l>אֶתְפַּלְלָה אֶל אֵל עַל אַף הַבַּלָּהוֹת</tei:l>
          <tei:l>כִּי אָכֵן יֵשׁ אֱלֹהִים בַּמָּקוֹם הַזֶּה.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
