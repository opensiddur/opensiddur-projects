          <tei:l>כַף לָמֶד</tei:l>
          <tei:l>מֵם נוּן</tei:l>
          <tei:l>סָמֶךְ עַיִן פֵּא</tei:l>
          <tei:l>צַדִי קוּף רֵישׁ</tei:l>
          <tei:l>שִׁין תַּו׃</tei:l>
          <tei:l>שֵׁמוֹת!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_barukh_pearlstein/3"/>
        <tei:p><tei:seg type="acrostic">אֵ</tei:seg>ל <tei:seg type="acrostic">בָּ</tei:seg>רוּךְ <tei:seg type="acrostic">גְּ</tei:seg>דוֹל <tei:seg type="acrostic">דֵּ</tei:seg>עָה,</tei:p>
        <tei:p><tei:seg type="acrostic">הֵ</tei:seg>כִין <tei:seg type="acrostic">וּ</tei:seg>פָעַל <tei:seg type="acrostic">זָ</tei:seg>הֳרֵי <tei:seg type="acrostic">חַ</tei:seg>מָּה.</tei:p>
        <tei:p><tei:seg type="acrostic">ט</tei:seg>וֹב <tei:seg type="acrostic">יָ</tei:seg>צַר <tei:seg type="acrostic">כָּ</tei:seg>בוֹד <tei:seg type="acrostic">לִ</tei:seg>שְׁמוֹ,</tei:p>
        <tei:p><tei:seg type="acrostic">מְ</tei:seg>אוֹרוֹת <tei:seg type="acrostic">נָ</tei:seg>תַן <tei:seg type="acrostic">סְ</tei:seg>בִיבוֹת <tei:seg type="acrostic">עֻ</tei:seg>זּוֹ.</tei:p>
        <tei:p><tei:seg type="acrostic">פִּ</tei:seg>ינוֹת <tei:seg type="acrostic">צְ</tei:seg>בָאָיו <tei:seg type="acrostic">קְ</tei:seg>דוֹשִׁים,</tei:p>
        <tei:p><tei:seg type="acrostic">ר</tei:seg>וֹמְמֵי <tei:seg type="acrostic">שַׁ</tei:seg>דַּי,</tei:p>
        <tei:p><tei:seg type="acrostic">תָּ</tei:seg>מִיד מְסַפְּרִים כְּבוֹד אֵל וּקְדוּשָּׁתוֹ.</tei:p>
        <tei:p>
          <tei:note type="instruction">× 2</tei:note>
        </tei:p>
