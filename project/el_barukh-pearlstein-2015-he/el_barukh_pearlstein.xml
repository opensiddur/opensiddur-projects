        <tei:head>אֵל בָּרוּךְ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_barukh_pearlstein/1"/>
        <tei:lg>
          <tei:l>אָלֶף בֵּית</tei:l>
          <tei:l>גִּימֵל דָּלֶת הֵא (הֵי!)</tei:l>
          <tei:l>וָו זַיִן</tei:l>
          <tei:l>חֵית טֵית יוּד (יֵא!)</tei:l>
          <tei:l>כַף לָמֶד</tei:l>
          <tei:l>מֵם נוּן</tei:l>
          <tei:l>סָמֶךְ עַיִן פֵּא</tei:l>
          <tei:l>צַדִי קוּף רֵישׁ</tei:l>
          <tei:l>שִׁין תַּו׃</tei:l>
          <tei:l>אוֹתִּיוֹת!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_barukh_pearlstein/2"/>
        <tei:lg>
          <tei:l>אָלֶף בֵּית</tei:l>
