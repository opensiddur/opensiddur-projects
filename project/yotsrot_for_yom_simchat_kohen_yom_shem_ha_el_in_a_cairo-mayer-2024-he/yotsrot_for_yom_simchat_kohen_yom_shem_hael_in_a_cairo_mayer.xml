    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yotsrot_for_yom_simchat_kohen_yom_shem_hael_in_a_cairo_mayer">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotsrot_for_yom_simchat_kohen_yom_shem_hael_in_a_cairo_mayer/1"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה אֱלֹהֵֽינוּ מֶֽלֶךְ הָעוֹלָם יוֹצֵ֥ר אוֹר֙ וּבוֹרֵ֣א חֹ֔שֶׁךְ...</tei:l>
          <tei:l><tei:note type="instruction">עד</tei:note> ...וְנִזְכֶּה כֻלָּֽנוּ מְהֵרָה לְאוֹרוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotsrot_for_yom_simchat_kohen_yom_shem_hael_in_a_cairo_mayer/2"/>
        <tei:lg>
          <tei:l>רָצִ֣יתָ <tei:seg type="acrostic">אֶ</tei:seg>ת־הָעָם לְהִטָּהֵר מִפֶּֽשַׁע</tei:l>
          <tei:l><tei:seg type="acrostic">בִּ</tei:seg>מְקוֹם אַשְׁמָה יֹֽשֶׁר צֶֽדֶק חֵֽלֶף רֶֽשַׁע</tei:l>
          <tei:l>בְּיוֹם שִׂמְחַת כֹּהֵן <tei:seg type="acrostic">גָּ</tei:seg>מַֽרְתָּ וְחָתַֽמְתָּ תְּשׁוּבוֹת תֵּֽשַׁע</tei:l>
          <tei:l><tei:seg type="acrostic">דּ</tei:seg>וּן־נָא בְּחַסְדְּךָ לְהָבִיא אֶת־אוֹר הַיֶּֽשַׁע</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotsrot_for_yom_simchat_kohen_yom_shem_hael_in_a_cairo_mayer/3"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה יוֹצֵר הַמְּאוֹרוֹת׃</tei:l>
          <tei:l>אַהֲבָה רַבָּה אֲהַבְתָּנוּ... <tei:note type="instruction">עד</tei:note> ...וּלְיַחֶדְךָ בְּאַהֲבָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotsrot_for_yom_simchat_kohen_yom_shem_hael_in_a_cairo_mayer/4"/>
        <tei:lg>
          <tei:l>יְהֹוָ֣ה <tei:seg type="acrostic">הַ</tei:seg>יּוֹם נַחֲזֹר לִקְרִיאַת שְׁמֶֽךָ</tei:l>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>נִשְׂמַח כִּי מָחַֽלְתָּ כִּפַּֽרְתְּ עַל־עַמֶּֽךָ</tei:l>
          <tei:l>בְּיוֹם שֵׁם הָאֵל <tei:seg type="acrostic">זׇ</tei:seg>כְרֵֽנוּ־נָא בְּרַחֲמֶֽיךָ</tei:l>
          <tei:l><tei:seg type="acrostic">חֲ</tei:seg>מֹל עָלֵֽינוּ בְּחֶמְלָה וְאַהֲבַת עוֹלָמֶֽךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotsrot_for_yom_simchat_kohen_yom_shem_hael_in_a_cairo_mayer/5"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה הַבּוֹחֵר בְּעַמּוֹ יִשְׂרָאֵל בְּאַהֲבָה׃</tei:l>
          <tei:l>שְׁמַ֖ע... <tei:note type="instruction">עד</tei:note> ...אֱמֶת... <tei:note type="instruction">עד</tei:note> ...לְךָ עָנוּ שִׁירָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotsrot_for_yom_simchat_kohen_yom_shem_hael_in_a_cairo_mayer/6"/>
        <tei:lg>
          <tei:l>אַרְצֶ֑ךָ <tei:seg type="acrostic">טִ</tei:seg>הַֽרְתָּ מִטֻּמְאַת אָשָׁם</tei:l>
          <tei:l><tei:seg type="acrostic">יֵ</tei:seg>שׁ הִנְחַֽלְתָּ לְאוֹהֲבֶֽיךָ וְיֻגְשַׁם</tei:l>
          <tei:l>בְּיוֹם שִׂמְחַת כֹּהֵן <tei:seg type="acrostic">כָּ</tei:seg>תוּב יְהִי וְנִרְשַׁם</tei:l>
          <tei:l><tei:seg type="acrostic">לָ</tei:seg>כֵן נָשִֽׁירָה כׇּל־מָה שֶׁהוּשַׁר שָׁם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotsrot_for_yom_simchat_kohen_yom_shem_hael_in_a_cairo_mayer/7"/>
        <tei:lg>
          <tei:l>בְּגִילָה בְּרִנָּה בְּשִׂמְחָה רַבָּה וְאָמְרוּ כֻלָּם</tei:l>
          <tei:l>מִֽי־כָמֹ֤כָה בָּֽאֵלִם֙ יְהֹוָ֔ה</tei:l>
          <tei:l>מִ֥י כָּמֹ֖כָה נֶאְדָּ֣ר בַּקֹּ֑דֶשׁ</tei:l>
          <tei:l>נוֹרָ֥א תְהִלֹּ֖ת עֹ֥שֵׂה פֶֽלֶא׃</tei:l>
          <tei:l>שִׁירָה חֲדָשָׁה שִׁבְּחוּ גְאוּלִים לְשִׁמְךָ עַל־שְׂפַת הַיָּם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotsrot_for_yom_simchat_kohen_yom_shem_hael_in_a_cairo_mayer/8"/>
        <tei:lg>
          <tei:l>שַׁ֝֗בְתָּ <tei:seg type="acrostic">מִ</tei:seg>מַּלְכוּתְךָ לֵאלֹהוּתְךָ בְּיוֹם זֶה</tei:l>
          <tei:l><tei:seg type="acrostic">נֹ</tei:seg>אמַר אֶת־שִׁמְךָ לְפִי קְדֻשָּׁתְךָ בְּיוֹם זֶה</tei:l>
          <tei:l>בְּיוֹם שֵׁם הָאֵל <tei:seg type="acrostic">סֶֽ</tei:seg>לָה וָעֶד נְזַמֵּר תְּהִלָּתְךָ בְּיוֹם זֶה</tei:l>
          <tei:l><tei:seg type="acrostic">עֵ</tei:seg>ת רְקֹד בָּאָה נִרְקֹד בְּסֻכָּתְךָ בְּיוֹם זֶה</tei:l>
          <tei:l>וּבְיוֹם שִׂמְחַת כֹּהֵן <tei:seg type="acrostic">פֵּ</tei:seg>רְשׁוּ הַחֲכָמִים בְּמִשְׁנָתְךָ בְּיוֹם זֶה</tei:l>
          <tei:l><tei:seg type="acrostic">צָ</tei:seg>הַל הַכֹּהֵן בַּעֲבוֹדָתְךָ בְּיוֹם זֶה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotsrot_for_yom_simchat_kohen_yom_shem_hael_in_a_cairo_mayer/9"/>
        <tei:lg>
          <tei:l>שְׁבִ֣ית <tei:seg type="acrostic">קְ</tei:seg>דוֹשֶֽׁיךָ תְּקַבֵּץ בִּמְהֵרָה</tei:l>
          <tei:l><tei:seg type="acrostic">רָ</tei:seg>אשֵֽׁינוּ נוֹטִים הָהָֽרָה</tei:l>
          <tei:l>בְּיוֹם שִׂמְחַת כֹּהֵן <tei:seg type="acrostic">שָׁ</tei:seg>עָה שֶׁיָּצָא מִן־הַקֹּדֶשׁ בִּטְהֹרָה</tei:l>
          <tei:l><tei:seg type="acrostic">תְּ</tei:seg>מִימִים וּקְדֹשִׁים שָׂמְחוּ אִתּוֹ בְּזִמְרָה</tei:l>
          <tei:l>וּבְיוֹם שֵׁם הָאֵל יֹֽׄשֶׁר צֶֽׄדֶק לִמַּֽדְתָּ לְכׇל־נִבְרָא</tei:l>
          <tei:l>חַׄסְדְּךָ קָׄרָֽאנוּ בְּפָרָשַׁת הַשִּׁירָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotsrot_for_yom_simchat_kohen_yom_shem_hael_in_a_cairo_mayer/10"/>
        <tei:lg>
          <tei:l>זֶה צוּר יִשָּׁעֵנוּ פָּצוֹ פֶּה וְאָמְרוּ</tei:l>
          <tei:l>יְהֹוָ֥ה ׀ יִמְלֹ֖ךְ לְעֹלָ֥ם וָעֶֽד׃</tei:l>
          <tei:l>צוּר יִשְׂרָאֵל קֽוּמָה לְעֶזְרַת יִשְׂרָאֵל</tei:l>
          <tei:l>וּפְדֵה כִנְאֻמֶֽךָ יְהוּדָה וְיִשְׂרָאֵל</tei:l>
          <tei:l>גֹּאֲלֵ֕נוּ יְהֹוָ֥ה צְבָא֖וֹת שְׁמ֑וֹ קְד֖וֹשׁ יִשְׂרָאֵֽל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotsrot_for_yom_simchat_kohen_yom_shem_hael_in_a_cairo_mayer/11"/>
        <tei:lg>
          <tei:l>יַעֲקֹֽב הִׄתְאַמֵּץ כִּׄי יִזְכׇּרְךָ הָאֵל</tei:l>
          <tei:l>הִׄנֵּה נְׄאֻם יְהֹוָה יָמִים בָּאִים שֶׁתִּגָּאֵל</tei:l>
          <tei:l>בְּיוֹם שִׂמְחַת כֹּהֵן וְׄגַם הׄוּא יוֹם שֵׁם הָאֵל</tei:l>
          <tei:l>פֵּׄרוּשַֽׁיִם יֵׄשׁ לַיּוֹם תְּשׁוּבָתַֽיִם לְכׇל־שׁוֹאֵל</tei:l>
          <tei:l>וּבְיוֹם שֵׁם הָאֵל יׄוֹם טׄוֹב עָשָׂה הַמְּתַוֵּךְ בֵּינֵנוּ וָאֵל</tei:l>
          <tei:l>נָֽׄחוּ חַׄזָּנִים שֶׁקָּרְבוּ לִפְנֵי תֵּבַת אֵל</tei:l>
          <tei:l>זַׄמְּרוּ קְׄהִלּוֹתַי לְמוֹשִֽׁיעַ וּמָגֵן וּמֵבִיא גּוֹאֵל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yotsrot_for_yom_simchat_kohen_yom_shem_hael_in_a_cairo_mayer/12"/>
        <tei:lg>
          <tei:l>בִּגְלַל אָבוֹת תּוֹשִֽיעַ בָנִים</tei:l>
          <tei:l>וְתָבִיא גְּאֻלָּה לִבְנֵי בְנֵיהֶם</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה צוּר יִשְׂרָאֵל וְגוֹאֲלוֹ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
