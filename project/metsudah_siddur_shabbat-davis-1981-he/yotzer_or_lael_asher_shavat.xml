      <tei:div corresp="urn:x-opensiddur:text:prayer:yotzer_or/lael_asher_shavat">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/1"/>לָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/2"/>אֲשֶׁר שָׁבַת מִכָּל הַמַּעֲשִׂים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/3"/>בַּיּוֹם הַשְּׁ֒בִיעִי הִתְעַלָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/4"/>וְיָשַׁב עַל כִּסֵּא כְבוֹדוֹ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/5"/>תִּפְאֶֽרֶת עָטָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/6"/>לְיוֹם הַמְּ֒נוּחָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/7"/>עֹֽנֶג קָרָא לְיוֹם הַשַּׁבָּת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/8"/>זֶה שֶֽׁבַח שֶׁל יוֹם הַשְּׁ֒בִיעִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/9"/>שֶׁבּוֹ שָׁבַת אֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/10"/>מִכָּל מְלַאכְתּוֹ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/11"/>וְיוֹם הַשְּׁ֒בִיעִי מְשַׁבֵּֽחַ וְאוֹמֵר.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/92/1"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/12"/>מִזְמוֹר שִׁיר לְיוֹם הַשַּׁבָּת
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/13"/>טוֹב לְהוֹדוֹת לַיהוֹה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/14"/>לְפִיכָךְ יְפָאֲרוּ וִיבָרְ֒כוּ לָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/15"/>כָּל יְצוּרָיו.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/16"/>שֶֽׁבַח יְקָר וּגְדֻלָּה וְכָבוֹד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/17"/>יִתְּ֒נוּ לָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/18"/>מֶֽלֶךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/19"/>יוֹצֵר כֹּל.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/20"/>הַמַּנְחִיל מְנוּחָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/21"/>לְעַמּוֹ יִשְׂרָאֵל בִּקְדֻשָּׁתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/22"/>בְּיוֹם שַׁבַּת קֹֽדֶשׁ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/23"/>שִׁמְךָ יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/24"/>יִתְקַדַּשׁ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/25"/>וְזִכְרְ֒ךָ מַלְכֵּֽנוּ יִתְפָּאַר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/26"/>בַּשָּׁמַֽיִם מִמַּֽעַל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/27"/>וְעַל הָאָֽרֶץ מִתָּֽחַת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/28"/>תִּתְבָּרֵךְ מוֹשִׁיעֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/29"/>עַל כָּל שֶֽׁבַח מַעֲשֵׂה יָדֶֽיךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/30"/>וְעַל מְאוֹרֵי אוֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/31"/>שֶׁיָצַֽרְתָּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_asher_shavat/32"/>הֵמָּה יְפָאֲרֽוּךָ סֶּֽלָה:</tei:p>
      </tei:div>
    </tei:body>
