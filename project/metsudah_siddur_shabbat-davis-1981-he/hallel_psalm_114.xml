      <tei:div corresp="urn:x-opensiddur:text:prayer:hallel/psalm_114">
        <tei:head xml:lang="he">תהלים קיד</tei:head>
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/114/1"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_114/1"/>בְּצֵאת יִשְׂרָאֵל מִמִּצְרָֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_114/2"/>בֵּית יַעֲקֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_114/3"/>מֵעַם לֹעֵז:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/114/2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_114/4"/>הָיְ֒תָה יְהוּדָה לְקָדְשׁוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_114/5"/>יִשְׂרָאֵל מַמְשְׁ֒לוֹתָיו:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/114/3"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_114/6"/>הַיָּם רָאָה וַיָּנֹס
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_114/7"/>הַיַּרְדֵּן יִסֹּב לְאָחוֹר:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/114/4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_114/8"/>הֶהָרִים רָקְ֒דוּ כְאֵילִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_114/9"/>גְּבָעוֹת כִּבְנֵי־צֹאן:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/114/5"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_114/10"/>מַה־לְּךָ הַיָּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_114/11"/>כִּי תָנוּס
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_114/12"/>הַיַּרְדֵּן תִּסֹּב לְאָחוֹר:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/114/6"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_114/13"/>הֶהָרִים תִּרְקְ֒דוּ כְאֵילִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_114/14"/>גְּבָעוֹת כִּבְנֵי־צֹאן:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/114/7"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_114/15"/>❖מִלִּפְנֵי אָדוֹן חֽוּלִי אָֽרֶץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_114/16"/>מִלִּפְנֵי אֱלֽוֹהַּ יַעֲקֹב:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/114/8"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_114/17"/>הַהֹפְ֒כִי הַצּוּר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_114/18"/>אֲגַם־מָֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_114/19"/>חַלָּמִישׁ לְמַעְיְ֒נוֹ־מָֽיִם:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
