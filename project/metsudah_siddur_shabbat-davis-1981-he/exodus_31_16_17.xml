      <tei:div corresp="urn:x-opensiddur:text:bible:exodus/31/16-17">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:exodus/31/16_17/1"/>וְשָׁמְ֒רוּ בְנֵי־יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:exodus/31/16_17/2"/>אֶת־הַשַּׁבָּת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:exodus/31/16_17/3"/>לַעֲשׂוֹת אֶת־הַשַּׁבָּת לְדֹרֹתָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:exodus/31/16_17/4"/>בְּרִית עוֹלָם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:exodus/31/16_17/5"/>בֵּינִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:exodus/31/16_17/6"/>וּבֵין בְּנֵי יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:exodus/31/16_17/7"/>אוֹת הִיא לְעֹלָם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:exodus/31/16_17/8"/>כִּי־שֵֽׁשֶׁת יָמִים עָשָׂה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:exodus/31/16_17/9"/>אֶת־הַשָּׁמַֽיִם וְאֶת־הָאָֽרֶץ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:exodus/31/16_17/10"/>וּבַיּוֹם הַשְּׁ֒בִיעִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:exodus/31/16_17/11"/>שָׁבַת וַיִּנָּפַשׁ:</tei:p>
