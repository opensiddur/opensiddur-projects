      <tei:div corresp="urn:x-opensiddur:text:prayer:ribbono_shel_olam_ani">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/1"/>רִבּוֹנוֹ שֶׁל עוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/2"/>אֲנִי שֶׁלָּךְ וַחֲלוֹמוֹתַי שֶׁלָּךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/3"/>חֲלוֹם חָלַמְתִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/4"/>וְאֵינִי יוֹדֵֽעַ מַה הוּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/5"/>יְהִי רָצוֹן מִלְּ֒פָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/6"/>יְהֹוָה אֱלֹהַי וֵאלֹהֵי אֲבוֹתַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/7"/>שֶׁיִּהְיוּ כָּל חֲלוֹמוֹתַי עָלַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/8"/>וְעַל כָּל יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/9"/>לְטוֹבָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/10"/>בֵּין שֶׁחָלַֽמְתִּי עַל עַצְמִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/11"/>וּבֵין שֶׁחָלַֽמְתִּי עַל אֲחֵרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/12"/>וּבֵין שֶׁחָלְ֒מוּ אֲחֵרִים עָלָי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/13"/>אִם טוֹבִים הֵם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/14"/>חַזְּ֒קֵם וְאַמְּ֒צֵם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/15"/>וְיִתְקַיְּ֒מוּ בִי וּבָהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/16"/>כַּחֲלוֹמוֹתָיו שֶׁל יוֹסֵף הַצַּדִּיק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/17"/>וְאִם צְרִיכִים רְפוּאָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/18"/>רַפְּאֵם כְּחִזְקִיָּֽהוּ מֶֽלֶךְ יְהוּדָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/19"/>מֵחָלְיוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/20"/>וּכְמִרְיָם הַנְּ֒בִיאָה מִצָּרַעְתָּהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/21"/>וּכְנַעֲמָן מִצָּרַעְתּוֹ
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:ribbono_shel_olam_ani/regalim_birkat_kohanim"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/34"/>וּכְמֵי מָרָה עַל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/35"/>יְדֵי משֶׁה רַבֵּֽנוּ
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:ribbono_shel_olam_ani/regalim_birkat_kohanim"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/22"/>וּכְמֵי מָרָה
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:ribbono_shel_olam_ani/regalim_birkat_kohanim"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/23"/>עַל יְדֵי משֶׁה רַבֵּֽנוּ
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/24"/>וּכְמֵי יְרִיחוֹ עַל יְדֵי אֱלִישָׁע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/25"/>וּכְשֵׁם שֶׁהָפַֽכְתָּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/26"/>אֶת קִלְלַת בִּלְעָם הָרָשָׁע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/27"/>מִקְּ֒לָלָה לִבְרָכָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/28"/>כֵּן תַּהֲפוֹךְ כָּל חֲלוֹמוֹתַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/29"/>עָלַי וְעַל כָּל יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/30"/>לְטוֹבָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/31"/>וְתִשְׁמְ֒רֵֽנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/32"/>וּתְחָנֵּֽנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_ani/33"/>וְתִרְצֵֽנִי אָמֵן:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
