      <tei:div corresp="urn:x-opensiddur:text:bible:exodus/20/8-11">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:exodus/20/8_11/1"/>זָכוֹר אֶת יוֹם הַשַּׁבָּת לְקַדְּ֒שׁוֹ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/20/9"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:exodus/20/8_11/2"/>שֵֽׁשֶׁת יָמִים תַּעֲבֹד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:exodus/20/8_11/3"/>וְעָשִֽׂיתָ כָּל־מְלַאכְתֶּֽךָ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/20/10"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:exodus/20/8_11/4"/>וְיוֹם הַשְּׁ֒בִיעִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:exodus/20/8_11/5"/>שַׁבָּת לַֽיהֹוָה אֱלֹהֶֽיךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:exodus/20/8_11/6"/>לֹא תַעֲשֶׂה כָל מְלָאכָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:exodus/20/8_11/7"/>אַתָּה וּבִנְךָ וּבִתֶּֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:exodus/20/8_11/8"/>עַבְדְּ֒ךָ וַאֲמָתְ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:exodus/20/8_11/9"/>וּבְהֶמְתֶּֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:exodus/20/8_11/10"/>וְגֵרְ֒ךָ אֲשֶׁר בִּשְׁעָרֶֽיךָ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/20/11"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:exodus/20/8_11/11"/>כִּי שֵֽׁשֶׁת יָמִים עָשָׂה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:exodus/20/8_11/12"/>אֶת הַשָּׁמַֽיִם וְאֶת הָאָֽרֶץ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:exodus/20/8_11/13"/>אֶת הַיָּם וְאֶת כָּל אֲשֶׁר בָּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:exodus/20/8_11/14"/>וַיָּֽנַח בַּיּוֹם הַשְּׁ֒בִיעִי:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:exodus/20/8_11/15"/>עַל־כֵּן בֵּרַךְ יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:exodus/20/8_11/16"/>אֶת־יוֹם הַשַּׁבָּת וַיְקַדְּ֒שֵׁהוּ:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
