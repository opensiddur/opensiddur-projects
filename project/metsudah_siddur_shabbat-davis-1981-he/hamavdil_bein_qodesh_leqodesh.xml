      <tei:div corresp="urn:x-opensiddur:text:prayer:hamavdil_bein_qodesh_leqodesh">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamavdil_bein_qodesh_leqodesh/1"/>בֵּין קְדֻשַּׁת שַׁבָּת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamavdil_bein_qodesh_leqodesh/2"/>לִקְדֻשַּׁת יוֹם טוֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamavdil_bein_qodesh_leqodesh/3"/>הִבְדַּֽלְתָּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamavdil_bein_qodesh_leqodesh/4"/>וְאֶת יוֹם הַשְּׁ֒בִיעִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamavdil_bein_qodesh_leqodesh/5"/>מִשֵּֽׁשֶׁת יְמֵי הַמַּעֲשֶׂה קִדַּֽשְׁתָּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamavdil_bein_qodesh_leqodesh/6"/>הִבְדַּֽלְתָּ וְקִדַּֽשְׁתָּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamavdil_bein_qodesh_leqodesh/7"/>אֶת עַמְּךָ יִשְׂרָאֵל בִּקְדֻשָּׁתֶֽךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamavdil_bein_qodesh_leqodesh/8"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamavdil_bein_qodesh_leqodesh/9"/>הַמַּבְדִּיל בֵּין קֹֽדֶשׁ לְקֹֽדֶשׁ:</tei:p>
      </tei:div>
