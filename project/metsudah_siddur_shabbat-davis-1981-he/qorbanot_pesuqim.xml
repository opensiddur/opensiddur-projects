<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/2"/>מִשְׂגָּב לָֽנוּ אֱלֹהֵי יַעֲקֹב סֶֽלָה:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/3"/>❖יְהֹוָה צְבָאוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/4"/>אַשְׁרֵי אָדָם בֹּטֵֽחַ בָּךְ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/5"/>יְהֹוָה הוֹשִֽׁיעָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/6"/>הַמֶּֽלֶךְ יַעֲנֵֽנוּ בְיוֹם־קָרְ֒אֵֽנוּ:
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/pesuqim/shabbat_minchah_uva_letziyyon"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/129"/>בָּרוּךְ הוּא אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/130"/>שֶׁבְּ֒רָאָֽנוּ לִכְבוֹדוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/131"/>וְהִבְדִּילָֽנוּ מִן הַתּוֹעִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/132"/>וְנָֽתַן לָֽנוּ תּוֹרַת אֱמֶת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/133"/>וְחַיֵּי עוֹלָם נָטַע בְּתוֹכֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/134"/>הוּא יִפְתַּח לִבֵּֽנוּ בְּתוֹרָתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/135"/>וְיָשֵׂם בְּלִבֵּֽנוּ אַהֲבָתוֹ וְיִרְאָתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/136"/>וְלַעֲשׂוֹת רְצוֹנוֹ וּלְעָבְדוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/137"/>בְּלֵבָב שָׁלֵם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/138"/>לְמַֽעַן לֹא נִיגַע לָרִיק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/139"/>וְלֹא נֵלֵד לַבֶּהָלָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/140"/>יְהִי רָצוֹן מִלְּפָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/141"/>יְהֹוָה אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/142"/>שֶׁנִּשְׁמֹר חֻקֶּֽיךָ בָּעוֹלָם הַזֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/143"/>וְנִזְכֶּה וְנִחְיֶה וְנִרְאֶה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/144"/>וְנִירַשׁ טוֹבָה וּבְרָכָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/145"/>לִשְׁנֵי יְמוֹת הַמָּשִֽׁיחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/146"/>וּלְחַיֵּי הָעוֹלָם הַבָּא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/147"/>לְמַֽעַן יְזַמֶּרְךָ כָבוֹד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/148"/>וְלֹא יִדֹּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/149"/>יְהֹוָה אֱלֹהַי לְעוֹלָם אוֹדֶֽךָָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/150"/>בָּרוּךְ הַגֶּֽבֶר אֲשֶׁר יִבְטַח בַּיהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/151"/>וְהָיָה יְהֹוָה מִבְטַחוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/152"/>בִּטְחוּ בַיהֹוָה עֲדֵי עַד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/153"/>כִּי בְּיָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/154"/>יְהֹוָה צוּר עוֹלָמִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/155"/>וְיִבְטְ֒חוּ בְךָ יוֹדְ֒עֵי שְׁמֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/156"/>כִּי לֹא עָזַֽבְתָּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/157"/>דֹרְ֒שֶֽׁיךָ יְהֹוָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/158"/>❖יְהֹוָה חָפֵץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/159"/>לְמַֽעַן צִדְקוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/160"/>יַגְדִּיל תּוֹרָה וְיַאְדִּיר:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_5"/>
