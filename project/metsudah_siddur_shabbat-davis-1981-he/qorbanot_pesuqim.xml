<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/168"/>הוּא יִפְתַּח לִבֵּֽנוּ בְּתוֹרָתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/169"/>וְיָשֵׂם בְּלִבֵּֽנוּ אַהֲבָתוֹ וְיִרְאָתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/170"/>וְלַעֲשׂוֹת רְצוֹנוֹ וּלְעָבְדוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/171"/>בְּלֵבָב שָׁלֵם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/172"/>לְמַֽעַן לֹא נִיגַע לָרִיק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/173"/>וְלֹא נֵלֵד לַבֶּהָלָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/174"/>יְהִי רָצוֹן מִלְּפָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/175"/>יְהֹוָה אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/176"/>שֶׁנִּשְׁמֹר חֻקֶּֽיךָ בָּעוֹלָם הַזֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/177"/>וְנִזְכֶּה וְנִחְיֶה וְנִרְאֶה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/178"/>וְנִירַשׁ טוֹבָה וּבְרָכָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/179"/>לִשְׁנֵי יְמוֹת הַמָּשִֽׁיחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/180"/>וּלְחַיֵּי הָעוֹלָם הַבָּא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/181"/>לְמַֽעַן יְזַמֶּרְךָ כָבוֹד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/182"/>וְלֹא יִדֹּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/183"/>יְהֹוָה אֱלֹהַי לְעוֹלָם אוֹדֶֽךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/184"/>בָּרוּךְ הַגֶּֽבֶר אֲשֶׁר יִבְטַח בַּיהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/185"/>וְהָיָה יְהֹוָה מִבְטַחוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/186"/>בִּטְחוּ בַיהֹוָה עֲדֵי עַד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/187"/>כִּי בְּיָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/188"/>יְהֹוָה צוּר עוֹלָמִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/189"/>❖וְיִבְטְ֒חוּ בְךָ יוֹדְ֒עֵי שְׁמֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/190"/>כִּי לֹא עָזַֽבְתָּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/191"/>דֹרְ֒שֶֽׁיךָ יְהֹוָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/192"/>יְהֹוָה חָפֵץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/193"/>לְמַֽעַן צִדְקוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/194"/>יַגְדִּיל תּוֹרָה וְיַאְדִּיר:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_6"/>
<j:conditional xml:id="variant_7"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/pesuqim/shabbat_conclusion_havdalah"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/122"/>לַיְהוּדִים הָיְ֒תָה אוֹרָה וְשִׂמְחָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/123"/>וְשָׂשׂוֹן וִיקָר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/124"/>כֵּן תִּהְיֶה לָּֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/125"/>כּוֹס יְשׁוּעוֹת אֶשָּׂא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/126"/>וּבְשֵׁם יְהֹוָה אֶקְרָא:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_7"/>
