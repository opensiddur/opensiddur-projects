<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/pesuqim/shabbat_minchah_uva_letziyyon"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/pesuqim/shabbat_conclusion_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/pesuqim/shabbat_conclusion_havdalah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/2"/>מִשְׂגָּב לָֽנוּ אֱלֹהֵי יַעֲקֹב סֶֽלָה:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/3"/>❖יְהֹוָה צְבָאוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/4"/>אַשְׁרֵי אָדָם בֹּטֵֽחַ בָּךְ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/5"/>יְהֹוָה הוֹשִֽׁיעָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/6"/>הַמֶּֽלֶךְ יַעֲנֵֽנוּ בְיוֹם־קָרְ֒אֵֽנוּ:
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/pesuqim/shabbat_minchah_uva_letziyyon"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/32"/>בָּרוּךְ הוּא אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/33"/>שֶׁבְּ֒רָאָֽנוּ לִכְבוֹדוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/34"/>וְהִבְדִּילָֽנוּ מִן הַתּוֹעִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/35"/>וְנָֽתַן לָֽנוּ תּוֹרַת אֱמֶת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/36"/>וְחַיֵּי עוֹלָם נָטַע בְּתוֹכֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/37"/>הוּא יִפְתַּח לִבֵּֽנוּ בְּתוֹרָתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/38"/>וְיָשֵׂם בְּלִבֵּֽנוּ אַהֲבָתוֹ וְיִרְאָתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/39"/>וְלַעֲשׂוֹת רְצוֹנוֹ וּלְעָבְדוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/40"/>בְּלֵבָב שָׁלֵם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/41"/>לְמַֽעַן לֹא נִיגַע לָרִיק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/42"/>וְלֹא נֵלֵד לַבֶּהָלָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/43"/>יְהִי רָצוֹן מִלְּפָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/44"/>יְהֹוָה אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/45"/>שֶׁנִּשְׁמֹר חֻקֶּֽיךָ בָּעוֹלָם הַזֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/46"/>וְנִזְכֶּה וְנִחְיֶה וְנִרְאֶה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/47"/>וְנִירַשׁ טוֹבָה וּבְרָכָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/48"/>לִשְׁנֵי יְמוֹת הַמָּשִֽׁיחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/49"/>וּלְחַיֵּי הָעוֹלָם הַבָּא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/50"/>לְמַֽעַן יְזַמֶּרְךָ כָבוֹד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/51"/>וְלֹא יִדֹּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/52"/>יְהֹוָה אֱלֹהַי לְעוֹלָם אוֹדֶֽךָָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/53"/>בָּרוּךְ הַגֶּֽבֶר אֲשֶׁר יִבְטַח בַּיהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/54"/>וְהָיָה יְהֹוָה מִבְטַחוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/55"/>בִּטְחוּ בַיהֹוָה עֲדֵי עַד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/56"/>כִּי בְּיָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/57"/>יְהֹוָה צוּר עוֹלָמִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/58"/>וְיִבְטְ֒חוּ בְךָ יוֹדְ֒עֵי שְׁמֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/59"/>כִּי לֹא עָזַֽבְתָּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/60"/>דֹרְ֒שֶֽׁיךָ יְהֹוָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/61"/>❖יְהֹוָה חָפֵץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/62"/>לְמַֽעַן צִדְקוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/63"/>יַגְדִּיל תּוֹרָה וְיַאְדִּיר:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/64"/>יִתְגַּדַּל וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/65"/>בְּעָלְמָא דִּי בְרָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/66"/>כִרְעוּתֵהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/67"/>וְיַמְלִיךְ מַלְכוּתֵהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/68"/>וְיַצְמַח פּוּרְקָנֵהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/69"/>וִיקָרֵב (קֵץ) מְשִׁיחֵהּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/70"/>בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/71"/>וּבְחַיֵּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/72"/>דְכָל בֵּית יִשְׂרָאֵל.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/73"/>בַּעֲגָלָא וּבִזְמַן קָרִיב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/74"/>וְאִמְרוּ אָמֵן:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_5"/>
<j:conditional xml:id="variant_6"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/pesuqim/shabbat_conclusion_amidah"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/77"/>בָּרוּךְ הוּא אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/78"/>שֶׁבְּ֒רָאָֽנוּ לִכְבוֹדוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/79"/>וְהִבְדִּילָֽנוּ מִן הַתּוֹעִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/80"/>וְנָֽתַן לָֽנוּ תּוֹרַת אֱמֶת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/81"/>וְחַיֵּי עוֹלָם נָטַע בְּתוֹכֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/82"/>הוּא יִפְתַּח לִבֵּֽנוּ בְּתוֹרָתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/83"/>וְיָשֵׂם בְּלִבֵּֽנוּ אַהֲבָתוֹ וְיִרְאָתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/84"/>וְלַעֲשׂוֹת רְצוֹנוֹ וּלְעָבְדוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/85"/>בְּלֵבָב שָׁלֵם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/86"/>לְמַֽעַן לֹא נִיגַע לָרִיק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/87"/>וְלֹא נֵלֵד לַבֶּהָלָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/88"/>יְהִי רָצוֹן מִלְּפָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/89"/>יְהֹוָה אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/90"/>שֶׁנִּשְׁמֹר חֻקֶּֽיךָ בָּעוֹלָם הַזֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/91"/>וְנִזְכֶּה וְנִחְיֶה וְנִרְאֶה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/92"/>וְנִירַשׁ טוֹבָה וּבְרָכָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/93"/>לִשְׁנֵי יְמוֹת הַמָּשִֽׁיחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/94"/>וּלְחַיֵּי הָעוֹלָם הַבָּא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/95"/>לְמַֽעַן יְזַמֶּרְךָ כָבוֹד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/96"/>וְלֹא יִדֹּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/97"/>יְהֹוָה אֱלֹהַי לְעוֹלָם אוֹדֶֽךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/98"/>בָּרוּךְ הַגֶּֽבֶר אֲשֶׁר יִבְטַח בַּיהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/99"/>וְהָיָה יְהֹוָה מִבְטַחוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/100"/>בִּטְחוּ בַיהֹוָה עֲדֵי עַד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/101"/>כִּי בְּיָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/102"/>יְהֹוָה צוּר עוֹלָמִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/103"/>❖וְיִבְטְ֒חוּ בְךָ יוֹדְ֒עֵי שְׁמֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/104"/>כִּי לֹא עָזַֽבְתָּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/105"/>דֹרְ֒שֶֽׁיךָ יְהֹוָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/106"/>יְהֹוָה חָפֵץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/107"/>לְמַֽעַן צִדְקוֹ
