<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/75"/>מִשְׂגָּב לָֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/76"/>אֱלֹהֵי יַעֲקֹב סֶֽלָה:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/pesuqim/shabbat_conclusion_havdalah"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/120"/>מִשְׂגָּב לָֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/121"/>אֱלֹהֵי יַעֲקֹב סֶֽלָה.
<tei:milestone unit="phrase"/>
