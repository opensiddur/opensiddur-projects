<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/pesuqim/shabbat_minchah_uva_letziyyon"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
