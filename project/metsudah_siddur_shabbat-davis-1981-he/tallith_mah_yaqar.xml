    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:tallith/mah_yaqar">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/36/8"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/mah_yaqar/1"/>מַה יָּקָר חַסְ֒דְּךָ אֱלֹהִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/mah_yaqar/2"/>וּבְ֒נֵי אָדָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/mah_yaqar/3"/>בְּצֵל כְּנָפֶֽיךָ יֶחֱסָֽיוּן:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/mah_yaqar/4"/>יִרְוְיֻן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/mah_yaqar/5"/>מִדֶּֽשֶׁן בֵּיתֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/mah_yaqar/6"/>וְנַֽחַל עֲדָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/mah_yaqar/7"/>תַשְׁקֵם:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/36/10"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/mah_yaqar/8"/>כִּי־עִמְּ֒ךָ מְקוֹר חַיִּים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/mah_yaqar/9"/>בְּאוֹרְ֒ךָ נִרְאֶה־אוֹר:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/36/11"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/mah_yaqar/10"/>מְשֹׁךְ חַסְדְּךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/mah_yaqar/11"/>לְיֹדְ֒עֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/mah_yaqar/12"/>וְצִדְ֒קָתְ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/mah_yaqar/13"/>לְיִשְׁ֒רֵי־לֵב:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
