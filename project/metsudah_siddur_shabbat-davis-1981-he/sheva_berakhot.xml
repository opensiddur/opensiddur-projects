      <tei:div corresp="urn:x-opensiddur:text:prayer:sheva_berakhot">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheva_berakhot/1"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheva_berakhot/2"/>אֱלֹהֵֽינוּ מֶֽלֶךְ הָעוֹלָם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheva_berakhot/18"/>אֲשֶׁר יָצַר אֶת הָאָדָם בְּצַלְמוֹ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheva_berakhot/19"/>בְּצֶּֽלֶם דְּמוּת תַּבְנִיתוֹ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheva_berakhot/20"/>וְהִתְקִין לוֹ מִמֶּֽנּוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheva_berakhot/21"/>בִּנְיַן עֲדֵי עַד.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheva_berakhot/22"/>בָּרוּךְ אַתָּה יְהֹוָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheva_berakhot/23"/>יוֹצֵר הָאָדָם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheva_berakhot/24"/>שׂוֹשׂ תָּשִׂישׂ וְתָגֵל הָעֲקָרָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheva_berakhot/25"/>בְּקִבּוּץ בָּנֶֽיהָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheva_berakhot/26"/>לְתוֹכָהּ בְּשִׂמְחָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheva_berakhot/27"/>בָּרוּךְ אַתָּה יְהֹוָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheva_berakhot/28"/>מְשַׂמֵּֽחַ צִיּוֹן בְּבָנֶֽיהָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheva_berakhot/29"/>שַׂמֵּֽחַ תְּשַׂמַּח
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheva_berakhot/30"/>רֵעִים הָאֲהוּבִים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheva_berakhot/31"/>כְּשַׂמֵּחֲךָ יְצִירְךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheva_berakhot/32"/>בְּגַן עֵֽדֶן מִקֶּֽדֶם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheva_berakhot/16"/>בָּרוּךְ אַתָּה יְהֹוָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheva_berakhot/17"/>מְשַׂמֵּֽחַ חָתָן וְכַלָּה:</tei:p>
      </tei:div>
