      <tei:div corresp="urn:x-opensiddur:text:prayer:yotzer_or/hakol_yodukha">
        <tei:p><j:conditional xml:id="when_1"><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="yom-tov"><tei:binary value="true"/></tei:f></tei:fs><j:none><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:none></j:all></j:conditional><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hakol_yodukha/1"/>הַכֹּל יוֹדֽוּךָ. וְהַכֹּל יְשַׁבְּ֒חֽוּךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hakol_yodukha/2"/>וְהַכֹּל יֹאמְ֒רוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hakol_yodukha/3"/>אֵין־קָדוֹשׁ כַּיהוֹה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hakol_yodukha/4"/>הַכֹּל יְרוֹמְ֒מֽוּךָ סֶּֽלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hakol_yodukha/5"/>יוֹצֵר הַכֹּל.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hakol_yodukha/6"/>הָאֵל הַפּוֹתֵֽחַ בְּכָל יוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hakol_yodukha/7"/>דַּלְתוֹת שַׁעֲרֵי מִזְרָח.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hakol_yodukha/8"/>וּבוֹקֵֽעַ חַלּוֹנֵי רָקִֽיעַ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hakol_yodukha/9"/>מוֹצִיא חַמָּה מִמְּ֒קוֹמָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hakol_yodukha/10"/>וּלְבָנָה מִמְּ֒כוֹן שִׁבְתָּהּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hakol_yodukha/11"/>וּמֵאִיר לְעוֹלָם כֻּלּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hakol_yodukha/12"/>וּלְיוֹשְׁ֒בָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hakol_yodukha/13"/>שֶׁבָּרָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hakol_yodukha/14"/>בְּמִדַּת הָרַחֲמִים.
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_1"/></tei:p>
