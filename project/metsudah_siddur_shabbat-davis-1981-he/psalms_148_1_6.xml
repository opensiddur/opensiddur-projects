      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/148/1-6">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/148/1"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/148/1_6/1"/>הַלְ֒לוּיָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/148/1_6/2"/>הַלְ֒לוּ אֶת־יְהֹוָה מִן הַשָּׁמַֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/148/1_6/3"/>הַלְ֒לֽוּהוּ בַּמְּ֒רוֹמִים:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/148/2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/148/1_6/4"/>הַלְ֒לֽוּהוּ כָל־מַלְאָכָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/148/1_6/5"/>הַלְ֒לֽוּהוּ כָּל־צְבָאָיו:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/148/3"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/148/1_6/6"/>הַלְ֒לֽוּהוּ שֶֽׁמֶשׁ וְיָרֵֽחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/148/1_6/7"/>הַלְ֒לֽוּהוּ כָּל־כּֽוֹכְ֒בֵי אוֹר:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/148/4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/148/1_6/8"/>הַלְ֒לֽוּהוּ שְׁמֵי הַשָּׁמָֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/148/1_6/9"/>וְהַמַּֽיִם אֲשֶׁר מֵעַל הַשָּׁמָֽיִם:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/148/5"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/148/1_6/10"/>יְהַלְ֒לוּ אֶת־שֵׁם יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/148/1_6/11"/>כִּי הוּא צִוָּה וְנִבְרָֽאוּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/148/6"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/148/1_6/12"/>וַיַּעֲמִידֵם לָעַד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/148/1_6/13"/>לְעוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/148/1_6/14"/>חָק־נָתַן וְלֹא יַעֲבוֹר:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
