<j:conditional xml:id="variant_11"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/pittum_haqetoret/bar_kappara/shabbat_minchah_qetoret"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
