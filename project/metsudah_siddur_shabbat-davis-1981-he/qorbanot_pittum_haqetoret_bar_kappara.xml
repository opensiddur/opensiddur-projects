<j:endConditional target="#variant_9"/>
<j:conditional xml:id="variant_10"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/pittum_haqetoret/bar_kappara/shabbat_minchah_qetoret"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pittum_haqetoret/bar_kappara/36"/>שֶׁל קְטֹֽרֶת,
