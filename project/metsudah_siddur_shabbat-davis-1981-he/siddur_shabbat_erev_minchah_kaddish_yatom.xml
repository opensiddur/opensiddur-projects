  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:shabbat/erev_minchah/kaddish_yatom">
        <tei:head xml:lang="he">קדיש יתום</tei:head>
        <j:declare xml:id="variants_1">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:kaddish/yatom/shabbat_musaf_aleinu_kaddish">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:kaddish/yatom/shabbat_minchah_mourners_kaddish">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:kaddish/yatom/shabbat_conclusion_kaddish">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/yatom"/>
        <j:endDeclare target="#variants_1"/>
        <j:conditional xml:id="when_1">
          <j:any>
            <tei:fs type="opensiddur:hebrew-date">
              <tei:f name="month">
                <tei:numeric value="5"/>
              </tei:f>
              <tei:f name="day">
                <tei:numeric value="30"/>
              </tei:f>
            </tei:fs>
            <tei:fs type="opensiddur:hebrew-date">
              <tei:f name="month">
                <tei:numeric value="6"/>
              </tei:f>
            </tei:fs>
            <tei:fs type="opensiddur:hebrew-date">
              <tei:f name="month">
                <tei:numeric value="7"/>
              </tei:f>
              <tei:f name="day">
                <tei:numeric value="1" max="22"/>
              </tei:f>
            </tei:fs>
          </j:any>
        </j:conditional>
        <j:declare xml:id="variants_2">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:bible:psalms/27/shabbat_shacharit_amidah">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/27"/>
        <j:endDeclare target="#variants_2"/>
        <j:endConditional target="#when_1"/>
      </tei:div>
