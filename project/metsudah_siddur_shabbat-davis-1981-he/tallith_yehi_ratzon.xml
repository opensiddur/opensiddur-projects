      <tei:div corresp="urn:x-opensiddur:text:prayer:tallith/yehi_ratzon">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/yehi_ratzon/1"/>יְהִי רָצוֹן מִלְּ֒פָנֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/yehi_ratzon/2"/>יְהֹוָה אֱלֹהַי וֵאלֹהֵי אֲבוֹתַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/yehi_ratzon/3"/>שֶׁתְּ֒הֵא חֲשׁוּבָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/yehi_ratzon/4"/>מִצְוַת צִיצִית לְפָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/yehi_ratzon/5"/>כְּאִלּוּ קִיַּמְתִּֽיהָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/yehi_ratzon/6"/>בְּכָל פְּרָטֶֽיהָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/yehi_ratzon/7"/>וְדִקְדּוּקֶֽיהָ וְכַוָּ֒נוֹתֶֽיהָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/yehi_ratzon/8"/>וְתַרְיַ"ג מִצְווֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/yehi_ratzon/9"/>הַתְּ֒לוּיוֹת בָּהּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tallith/yehi_ratzon/10"/>אָמֵן סֶלָה:</tei:p>
      </tei:div>
