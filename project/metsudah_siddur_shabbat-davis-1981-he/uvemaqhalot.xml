      <tei:div corresp="urn:x-opensiddur:text:prayer:uvemaqhalot">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvemaqhalot/1"/>וּבְמַקְהֲלוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvemaqhalot/2"/>רִבְבוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvemaqhalot/3"/>עַמְּ֒ךָ בֵּית יִשְׂרָאֵל.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvemaqhalot/4"/>בְרִנָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvemaqhalot/5"/>יִתְפָּאַר שִׁמְךָ מַלְכֵּֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvemaqhalot/6"/>בְּכָל דּוֹר וָדוֹר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvemaqhalot/7"/>שֶׁכֵּן חוֹבַת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvemaqhalot/8"/>כָּל הַיְ֒צוּרִים לְפָנֶֽיךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvemaqhalot/9"/>יְהֹוָה אֱלֹהֵֽינוּ. וֵאלֹהֵי אֲבוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvemaqhalot/10"/>❖לְהוֹדוֹת לְהַלֵּל לְשַׁבֵּחַ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvemaqhalot/11"/>לְפָאֵר לְרוֹמֵם לְהַדֵּר וּלְנַצֵֽחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvemaqhalot/12"/>לְבָרֵךְ לְעַלֵּה וּלְקַלֵּס
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvemaqhalot/13"/>עַל כָּל דִּבְרֵי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvemaqhalot/14"/>שִׁירוֹת וְתִשְׁבְּ֒חוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvemaqhalot/15"/>דָּוִד בֶּן יִשַׁי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvemaqhalot/16"/>עַבְדְּ֒ךָ מְשִׁיחֶךָ:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
