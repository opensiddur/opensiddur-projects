      <tei:div corresp="urn:x-opensiddur:text:prayer:kaddish/derabbanan/yitbarakh">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/yitbarakh/1"/>יִתְבָּרַךְ וְיִשְׁתַּבַּח
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/yitbarakh/2"/>וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְנַשֵּׂא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/yitbarakh/3"/>וְיִתְהַדָּר וְיִתְעַלֶּה וְיִתְהַלָּל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/yitbarakh/4"/>שְׁמֵהּ דְקוּדְשָׁא, בְּרִיךְ הוּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/yitbarakh/5"/>לְעֵֽלָּא <j:conditional xml:id="inline_1" type="marked"><tei:note type="instruction" xml:lang="he">בעשי"ת</tei:note><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="aseret-ymei-tshuva"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>וּלְעֵֽלָּא מִכָּל<j:endConditional target="#inline_1"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/yitbarakh/6"/><j:conditional xml:id="inline_2"><j:none><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="aseret-ymei-tshuva"><tei:binary value="true"/></tei:f></tei:fs></j:none></j:conditional>מִן כָּל<j:endConditional target="#inline_2"/> בִּרְ֒כָתָא וְשִׁירָתָא,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/yitbarakh/7"/>תֻּשְׁבְּחָתָא וְנֶחֱמָתָא,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/yitbarakh/8"/>דַּאֲמִירָן בְּעָלְ֒מָא, וְאִמְ֒רוּ אָמֵן:</tei:p>
