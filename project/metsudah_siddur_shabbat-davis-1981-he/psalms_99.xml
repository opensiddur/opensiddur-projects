      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/99">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/1"/>יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/2"/>מָלָךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/3"/>יִרְגְּזוּ עַמִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/4"/>ישֵׁב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/5"/>כְּרוּבִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/6"/>תָּנוּט הָאָֽרֶץ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/7"/>יְהֹוָה בְּצִיּוֹן גָּדוֹל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/8"/>וְרָם הוּא עַל־כָּל הָעַמִּים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/9"/>יוֹדוּ שִׁמְךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/10"/>גָּדוֹל וְנוֹרָא קָדוֹשׁ הוּא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/11"/>וְעֹז מֶֽלֶךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/12"/>מִשְׁפָּט אָהֵב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/13"/>אַתָּה כּוֹנַֽנְתָּ מֵישָׁרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/14"/>מִשְׁפָּט וּצְדָקָה בְּיַעֲקֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/15"/>אַתָּה עָשִֽׂיתָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/16"/>רוֹמְמוּ יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/17"/>וְהִשְׁתַּחֲווּ לַהֲדֹם רַגְלָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/18"/>קָדוֹשׁ הוּא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/19"/>משֶׁה וְאַהֲרֹן בְּכֹהֲנָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/20"/>וּשְׁמוּאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/21"/>בְּקֹרְאֵי שְׁמוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/22"/>קֹרִאים אֶל־יְהֹוָה וְהוּא יַעֲנֵם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/23"/>בְּעַמּוּד עָנָן יְדַבֵּר אֲלֵיהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/24"/>שָׁמְרוּ עֵדֹתָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/25"/>וְחֹק נָֽתַן־לָֽמוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/26"/>יְהֹוָה אֱלֹהֵֽינוּ אַתָּה עֲנִיתָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/27"/>אֵל נֹשֵׂא הָיִֽיתָ לָהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/28"/>וְנֹקֵם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/29"/>עַל־עֲלִילוֹתָם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/30"/>רוֹמְמוּ יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/31"/>וְהִשְׁתַּחֲווּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/32"/>לְהַר קָדְשׁוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/99/33"/>כִּי־קָדוֹשׁ יְהֹוָה אֱלֹהֵֽינוּ:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
