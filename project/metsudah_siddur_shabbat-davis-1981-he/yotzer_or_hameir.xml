      <tei:div corresp="urn:x-opensiddur:text:prayer:yotzer_or/hameir">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/1"/>הַמֵּאִיר לָאָֽרֶץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/2"/>וְלַדָּרִים עָלֶֽיהָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/3"/>בְּרַחֲמִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/4"/>וּבְטוּבוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/5"/>מְחַדֵּשׁ בְּכָל־יוֹם תָּמִיד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/6"/>מַעֲשֵׂה בְרֵאשִׁית.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/104/24"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/7"/>מָה־רַבּוּ מַעֲשֶֽׂיךָ יְהֹוָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/8"/>כֻּלָּם בְּחָכְמָה עָשִֽׂיתָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/9"/>מָלְ֒אָה הָאָֽרֶץ קִנְיָנֶֽךָ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/10"/>הַמֶּֽלֶךְ הַמְּ֒רוֹמָם לְבַדּוֹ מֵאָז.
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:yotzer_or/hameir/shabbat_shacharit_el_adon"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/36"/>הַמְּ֒שֻׁבָּח וְהַמְּ֒פֹאָר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/37"/>וְהַמִּתְנַשֵּׂא
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:yotzer_or/hameir/shabbat_shacharit_el_adon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/11"/>הַמְּ֒שֻׁבָּח וְהַמְּ֒פוֹאָר וְהַמִּתְנַשֵּׂא
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/13"/>מִימוֹת עוֹלָם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/14"/>אֱלֹהֵי עוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/15"/>בְּרַחֲמֶֽיךָ הָרַבִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/16"/>רַחֵם עָלֵֽינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/17"/>אֲדוֹן עֻזֵּֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/18"/>צוּר מִשְׂגַּבֵּֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/19"/>מָגֵן יִשְׁעֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/20"/>מִשְׂגָּב בַּעֲדֵֽנוּ.
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:yotzer_or/hameir/shabbat_shacharit_el_adon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/21"/>אֵין עֲרוֹךְ לְךָ.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:yotzer_or/hameir/shabbat_shacharit_el_adon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/22"/>וְאֵין זוּלָתֶֽךָ.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:yotzer_or/hameir/shabbat_shacharit_el_adon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/23"/>אֶֽפֶס בִּלְתֶּֽךָ
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_5"/>
<j:conditional xml:id="variant_6"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:yotzer_or/hameir/shabbat_shacharit_el_adon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/24"/>וּמִי דוֹמֶה לָךְ.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_6"/>
<j:conditional xml:id="variant_7"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:yotzer_or/hameir/shabbat_shacharit_el_adon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/25"/>❖אֵין עֲרוֹךְ לְךָ
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_7"/>
<j:conditional xml:id="variant_8"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:yotzer_or/hameir/shabbat_shacharit_el_adon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/26"/>יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_8"/>
<j:conditional xml:id="variant_9"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:yotzer_or/hameir/shabbat_shacharit_el_adon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/27"/>בָּעוֹלָם הַזֶּה.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_9"/>
<j:conditional xml:id="variant_10"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:yotzer_or/hameir/shabbat_shacharit_el_adon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/28"/>וְאֵין זוּלָתְ֒ךָ מַלְכֵּֽנוּ
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_10"/>
<j:conditional xml:id="variant_11"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:yotzer_or/hameir/shabbat_shacharit_el_adon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/29"/>לְחַיֵּי הָעוֹלָם הַבָּא.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_11"/>
<j:conditional xml:id="variant_12"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:yotzer_or/hameir/shabbat_shacharit_el_adon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/30"/>אֶֽפֶס בִּלְתְּ֒ךָ
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_12"/>
<j:conditional xml:id="variant_13"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:yotzer_or/hameir/shabbat_shacharit_el_adon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/31"/>גּוֹאֲלֵֽנוּ
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_13"/>
<j:conditional xml:id="variant_14"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:yotzer_or/hameir/shabbat_shacharit_el_adon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/32"/>לִימוֹת הַמָּשִֽׁיחַ.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_14"/>
<j:conditional xml:id="variant_15"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:yotzer_or/hameir/shabbat_shacharit_el_adon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/33"/>וְאֵין דוֹמֶה לְךָ
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_15"/>
<j:conditional xml:id="variant_16"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:yotzer_or/hameir/shabbat_shacharit_el_adon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/34"/>מוֹשִׁיעֵֽנוּ
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_16"/>
<j:conditional xml:id="variant_17"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:yotzer_or/hameir/shabbat_shacharit_el_adon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/hameir/35"/>לִתְחִיַּת הַמֵּתִים:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_17"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
