      <tei:div corresp="urn:x-opensiddur:text:prayer:birkhot_hashachar/shetargilenu">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/shetargilenu/1"/>וִיהִי רָצוֹן מִלְּ֒פָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/shetargilenu/2"/>יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/shetargilenu/3"/>וֵאלֹהֵי אֲבוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/shetargilenu/4"/>שֶׁתַּרְגִּילֵֽנוּ בְּתוֹרָתֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/shetargilenu/5"/>וְדַבְּ֒קֵֽנוּ בְּמִצְוֹתֶֽיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/shetargilenu/6"/>וְאַל תְּבִיאֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/shetargilenu/7"/>לֹא לִידֵי חֵטְא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/shetargilenu/8"/>וְלֹא לִידֵי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/shetargilenu/9"/>עֲבֵרָה וְעָוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/shetargilenu/10"/>וְלֹא לִידֵי נִסָּיוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/shetargilenu/11"/>וְלֹא לִידֵי בִזָּיוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/shetargilenu/12"/>וְאַל יִשְׁלֹט בָּֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/shetargilenu/13"/>יֵֽצֶר הָרָע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/shetargilenu/14"/>וְהַרְחִיקֵֽנוּ מֵאָדָם רָע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/shetargilenu/15"/>וּמֵחָבֵר רָע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/shetargilenu/16"/>וְדַבְּ֒קֵֽנוּ בְּיֵֽצֶר הַטּוֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/shetargilenu/17"/>וּבְ֒מַעֲשִׂים טוֹבִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/shetargilenu/18"/>וְכוֹף אֶת יִצְרֵֽנוּ הָרַע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/shetargilenu/19"/>לְהִשְׁתַּעְבֶּד־לָךְ</tei:p>
      </tei:div>
    </tei:body>
