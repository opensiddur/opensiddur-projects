      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/ledor_vador">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/ledor_vador/1"/>לְדוֹר וָדוֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/ledor_vador/2"/>נַגִּיד גָּדְלָךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/ledor_vador/3"/>וּלְנֵֽצַח נְצָחִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/ledor_vador/4"/>קְדֻשָּׁתְ֒ךָ נַקְדִּישׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/ledor_vador/5"/>וְשִׁבְחֲךָ אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/ledor_vador/6"/>מִפִּֽינוּ לֹא יָמוּשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/ledor_vador/7"/>לְעוֹלָם וָעֶד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/ledor_vador/8"/>כִּי אֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/ledor_vador/9"/>מֶֽלֶךְ גָּדוֹל וְקָדוֹשׁ אָֽתָּה:</tei:p>
      </tei:div>
    </tei:body>
