      <tei:div corresp="urn:x-opensiddur:text:prayer:hamappil">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/1"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/2"/>אֱלֹהֵֽינוּ מֶֽלֶךְ הָעוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/3"/>הַמַּפִּיל חֶבְלֵי שֵׁנָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/4"/>עַל עֵינָי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/5"/>וּתְנוּמָה עַל עַפְעַפָּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/6"/>וּמֵאִיר לְאִישׁוֹן בַּת עָֽיִן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/7"/>וִיהִי רָצוֹן מִלְּ֒פָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/8"/>יְהֹוָה אֱלֹהַי וֵאלֹהֵי אֲבוֹתַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/9"/>שֶׁתַּשְׁכִּיבֵֽנִי לְשָׁלוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/10"/>וְתַעֲמִידֵֽנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/11"/>לְחַיִּים טוֹבִים וּלְשָׁלוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/12"/>וְתֵן חֶלְקִי בְּתוֹרָתֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/13"/>וְתַרְגִּילֵֽנִי לִדְבַר מִצְוָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/14"/>וְעַל תַּרְגִּילֵֽנִי לִדְבַר עֲבֵרָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/15"/>וְאַל תְּבִיאֵֽנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/16"/>לֹא לִידֵי חֵטְא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/17"/>וְלֹא לִידֵי נִסָּיוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/18"/>וְלֹא לִידֵי בִזָּיוֹן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/19"/>יִשְׁלֹט בִּי יֵֽצֶר טוֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/20"/>וְאַל יִשְׁלֹט בִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/21"/>יֵֽצֶר הָרָע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/22"/>וְתַצִּילֵֽנוּ מִשָּׂטָן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/23"/>וּמִפֶּֽגַע רָע וּמֵחֳלָיִּם רָעִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/24"/>וְאַל יְבַהֲלֽוּנִי רַעְיוֹנַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/25"/>וַחֲלוֹמוֹת רָעִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/26"/>וְהַרְהוֹרִים רָעִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/27"/>וּתְהֵא מִטָּתִי שְׁלֵמָה לְפָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/28"/>וְהָאֵר עֵינַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/29"/>פֶּן אִישַׁן הַמָּֽוֶת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/30"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/31"/>הַמֵּאִיר לָעוֹלָם כֻּלּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamappil/32"/>בִּכְבוֹדוֹ:</tei:p>
      </tei:div>
    </tei:body>
