    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:numbers/29/12-13">
        <tei:head xml:lang="he">ליום א' וב' של סוכות</tei:head>
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/29/12"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/12_13/1"/>וּבַחֲמִשָּׁה עָשָׂר יוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/12_13/2"/>לַחֹֽדֶשׁ הַשְּׁבִיעִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/12_13/3"/>מִקְרָא קֹֽדֶשׁ יִהְיֶה לָכֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/12_13/4"/>כָּל מְלֶֽאכֶת עֲבֹדָה לֹא תַעֲשׂוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/12_13/5"/>וְחַגֹּתֶם חַג לַיהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/12_13/6"/>שִׁבְעַת יָמִים:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/29/13"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/12_13/7"/>וְהִקְרַבְתֶּם עֹלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/12_13/8"/>אִשֵּׁה רֵֽיחַ נִיחֹֽחַ לַיהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/12_13/9"/>פָּרִים בְּנֵי בָקָר שְׁלשָׁה עָשָׂר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/12_13/10"/>אֵילִם שְׁנָֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/12_13/11"/>כְּבָשִׂים בְּנֵי שָׁנָה אַרְבָּעָה עָשָׂר</tei:p>
