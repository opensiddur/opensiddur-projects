      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/127">
        <tei:head xml:lang="he">תהלים קכז</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/127/1"/>שִׁיר הַמַּעֲלוֹת לִשְׁלֹמֹה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/127/2"/>אִם־יְהֹוָה לֹא־יִבְנֶה בַֽיִת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/127/3"/>שָׁוְא עָמְלוּ בוֹנָיו בּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/127/4"/>אִם־יְהֹוָה לֹא־יִשְׁמָר־עִיר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/127/5"/>שָׁוְא שָׁקַד שׁוֹמֵר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/127/6"/>שָׁוְא לָכֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/127/7"/>מַשְׁכִּֽימֵי קוּם מְאַֽחֲרֵי־שֶֽׁבֶת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/127/8"/>אֹכְלֵי לֶֽחֶם הָעֲצָבִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/127/9"/>כֵּן יִתֵּן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/127/10"/>לִידִידוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/127/11"/>שֵׁנָא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/127/12"/>הִנֵּה נַחֲלַת יְהֹוָה בָּנִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/127/13"/>שָׂכָר פְּרִי הַבָּֽטֶן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/127/14"/>כְּחִצִּים בְּיַד־גִּבּוֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/127/15"/>כֵּן בְּנֵי הַנְּעוּרִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/127/16"/>אַשְׁרֵי הַגֶּֽבֶר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/127/17"/>אֲשֶׁר מִלֵּא אֶת־אַשְׁפָּתוֹ מֵהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/127/18"/>לֹא־יֵבֽשׁוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/127/19"/>כִּי־יְדַבְּרוּ אֶת־אוֹיְבִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/127/20"/>בַּשָּֽׁעַר:</tei:p>
      </tei:div>
