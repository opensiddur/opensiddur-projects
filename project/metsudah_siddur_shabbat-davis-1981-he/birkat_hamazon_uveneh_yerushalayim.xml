    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:birkat_hamazon/uveneh_yerushalayim">
        <tei:p><j:conditional xml:id="when_1"><tei:note type="instruction" xml:lang="he">לש"ע וש"ת:</tei:note><tei:fs type="opensiddur:holiday"><tei:f name="shmini-atzeret"><tei:binary value="true"/></tei:f></tei:fs></j:conditional><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/uveneh_yerushalayim/5"/>שְׁמִינִי עֲצֶֽרֶת
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_1"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/uveneh_yerushalayim/6"/>הַחַג הַזֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/uveneh_yerushalayim/7"/>לר"ה: הַזִּכָּרוֹן הַזֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/uveneh_yerushalayim/8"/>זָכְ֒רֵֽנוּ יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/uveneh_yerushalayim/9"/>בּוֹ לְטוֹבָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/uveneh_yerushalayim/10"/>וּפָקְ֒דֵֽנוּ בוֹ לִבְ֒רָכָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/uveneh_yerushalayim/11"/>וְהוֹשִׁיעֵֽנוּ בוֹ לְחַיִּים טוֹבִים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/uveneh_yerushalayim/12"/>וּבִדְ֒בַר יְשׁוּעָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/uveneh_yerushalayim/13"/>וְרַחֲמִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/uveneh_yerushalayim/14"/>חוּס וְחָנֵּֽנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/uveneh_yerushalayim/15"/>וְרַחֵם עָלֵֽינוּ וְהוֹשִׁיעֵֽנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/uveneh_yerushalayim/16"/>כִּי אֵלֶֽיךָ עֵינֵֽינוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/uveneh_yerushalayim/17"/>כִּי אֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/uveneh_yerushalayim/18"/>מֶֽלֶךְ חַנּוּן וְרַחוּם אָֽתָּה:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/uveneh_yerushalayim/19"/>וּבְ֒נֵה יְרוּשָׁלַֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/uveneh_yerushalayim/20"/>עִיר הַקֹּֽדֶשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/uveneh_yerushalayim/2"/>בִּמְ֒הֵרָה בְיָמֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/uveneh_yerushalayim/3"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/uveneh_yerushalayim/4"/>בּוֹנֵה בְרַחֲמָיו יְרוּשָׁלָֽיִם, אָמֵן:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
