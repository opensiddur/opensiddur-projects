      <tei:div corresp="urn:x-opensiddur:text:prayer:barukh_yotzerekh_barukh">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_yotzerekh_barukh/1"/>בָּרוּךְ יוֹצְ֒רֵךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_yotzerekh_barukh/2"/>בָּרוּךְ עוֹשֵׂךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_yotzerekh_barukh/3"/>בָּרוּךְ קוֹנֵךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_yotzerekh_barukh/4"/>בָּרוּךְ בּוֹרְ֒אֵךְ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_yotzerekh_barukh/5"/>כְּשֵׁם שֶׁאֲנִי רוֹקֵד כְּנֶגְדֵּךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_yotzerekh_barukh/6"/>וְאֵינִי יָכוֹל לִנְגֽוֹעַ בָּךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_yotzerekh_barukh/7"/>כַּךְ לֹא יוּכְ֒לוּ כָּל אוֹיְ֒בַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_yotzerekh_barukh/8"/>לִנְגֽוֹעַ בִּי לְרָעָה:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_yotzerekh_barukh/9"/>תִּפֹּל עֲלֵיהֶם אֵימָֽתָה וָפַֽחַד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_yotzerekh_barukh/10"/>בִּגְדֹל זְרוֹעֲךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_yotzerekh_barukh/11"/>יִדְּ֒מוּ כָּאָֽבֶן:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_yotzerekh_barukh/12"/>כָּאָֽבֶן יִדְּ֒מוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_yotzerekh_barukh/13"/>זְרוֹעֲךָ בִּגְדֹל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_yotzerekh_barukh/14"/>וָפַֽחַד אֵימָֽתָה עֲלֵיהֶם תִּפֹּל:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_yotzerekh_barukh/15"/>דָּוִד מֶֽלֶךְ יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_yotzerekh_barukh/16"/>חַי וְקַיָּם:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_yotzerekh_barukh/17"/>שָׁלוֹם עֲלֵיכֶם:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_yotzerekh_barukh/18"/>עֲלֵיכֶם שָׁלוֹם:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_yotzerekh_barukh/19"/>סִמָּן טוֹב וּמַזָּל טוֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_yotzerekh_barukh/20"/>יִהְיֶה לָֽנוּ וּלְכָל יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_yotzerekh_barukh/21"/>אָמֵן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_yotzerekh_barukh/22"/>קוֹל דּוֹדִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_yotzerekh_barukh/23"/>הִנֵּה זֶה בָּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_yotzerekh_barukh/24"/>מְדַלֵּג עַל הֶהָרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_yotzerekh_barukh/25"/>מְקַפֵּץ עַל הַגְּ֒בָעוֹת:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:song_of_songs/2/9"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_yotzerekh_barukh/26"/>דּוֹמֶה דוֹדִי לִצְבִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_yotzerekh_barukh/27"/>אוֹ לְעֹֽפֶר הָאַיָּלִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_yotzerekh_barukh/28"/>הִנֵּה זֶה עוֹמֵד אַחַר כָּתְלֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_yotzerekh_barukh/29"/>מַשְׁגִּֽיחַ מִן הַחַלּוֹנוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_yotzerekh_barukh/30"/>מֵצִיץ מִן הַחֲרַכִּים:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
