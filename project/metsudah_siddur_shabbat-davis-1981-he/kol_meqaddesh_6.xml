      <tei:div corresp="urn:x-opensiddur:text:poem:kol_meqaddesh/6">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/6/1"/>מְשֹׁךְ חַסְדְּ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/6/2"/>לְיוֹדְ֒עֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/6/3"/>אֵל קַנֹּא וְנוֹקֵם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/6/4"/>נוֹטְ֒רֵי לַיּוֹם הַשְּׁ֒בִיעִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/6/5"/>זָכוֹר וְשָׁמוֹר לְהָקֵם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/6/6"/>שַׂמְּ֒חֵם בְּבִנְיַן שָׁלֵם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/6/7"/>בְּאוֹר פָּנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/6/8"/>תַּבְהִיקֵם.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/36/9"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/6/9"/>יִרְוְיֻן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/6/10"/>מִדֶּֽשֶׁן בֵּיתֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/6/11"/>וְנַֽחַל עֲדָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/6/12"/>תַשְׁקֵם.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/6/13"/>עֲזֹר לַשּׁוֹבְ֒תִים בַּשְּׁ֒בִיעִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/6/14"/>בֶּחָרִישׁ וּבַקָּצִיר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/6/15"/>עוֹלָמִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/6/16"/>פּוֹסְ֒עִים בּוֹ פְּסִיעָה קְטַנָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/6/17"/>סוֹעֲדִים בּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/6/18"/>לְבָרֵךְ שָׁלשׁ פְּעָמִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/6/19"/>צִדְקָתָם תַּצְהִיר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/6/20"/>כְּאוֹר שִׁבְעַת הַיָּמִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/6/21"/>יְהֹוָה אֱלֹהֵי יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/6/22"/>אַהֲבַת תָּמִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/6/23"/>יְהֹוָה אֱלֹהֵי יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/6/24"/>תְּשׁוּעַת עוֹלָמִים:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
