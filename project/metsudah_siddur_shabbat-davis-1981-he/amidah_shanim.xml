    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/shanim">
        <tei:head xml:lang="he">ברכת השנים</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/1"/>בָּרֵךְ עָלֵֽינוּ יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/2"/>אֶת הַשָּׁנָה הַזֹּאת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/3"/>וְאֶת כָּל מִינֵי תְבוּאָתָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/4"/>לְטוֹבָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/5"/>וְתֵן
<tei:milestone unit="phrase"/>
<j:conditional xml:id="when_1"><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="tal-umatar"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/6"/>בְּרָכָה
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_1"/>
<j:conditional xml:id="when_2"><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="tal-umatar"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/7"/>טַל וּמָטָר לִבְ֒רָכָה
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/8"/>עַל פְּנֵי הָאֲדָמָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/9"/>וְשַׂבְּ֒עֵֽנוּ מִטּוּבָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/21"/>וּבָרֵךְ שְׁנָתֵנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/22"/>כַּשָּׁנִים הַטּוֹבוֹת לִבְרָכָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/10"/>כִּי אֵל טוֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/11"/>ומֵטִיב אַתָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/12"/>וּמְ֒בָרֵךְ הַשָׁנִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/13"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/14"/>מְבָרֵךְ הַשָּׁנִים:</tei:p>
