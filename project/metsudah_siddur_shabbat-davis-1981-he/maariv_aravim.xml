      <tei:div corresp="urn:x-opensiddur:text:prayer:maariv_aravim">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maariv_aravim/1"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maariv_aravim/2"/>אֱלֹהֵֽינוּ מֶֽלֶךְ הָעוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maariv_aravim/3"/>אֲשֶׁר בִּדְבָרוֹ מַעֲרִיב עֲרָבִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maariv_aravim/4"/>בְּחָכְמָה פּוֹתֵֽחַ שְׁעָרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maariv_aravim/24"/>וּבִתְבוּנָה מְשַׁנֶּה עִתִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maariv_aravim/7"/>וּמַחֲלִיף אֶת הַזְּ֒מַנִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maariv_aravim/8"/>וּמְסַדֵּר אֶת הַכּוֹכָבִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maariv_aravim/9"/>בְּמִשְׁמְ֒רוֹתֵיהֶם בָּרָקִֽיעַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maariv_aravim/10"/>כִּרְצוֹנוֹ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maariv_aravim/11"/>בּוֹרֵא יוֹם וָלָֽיְלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maariv_aravim/12"/>גּוֹלֵל אוֹר מִפְּ֒נֵי חֽשֶׁךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maariv_aravim/13"/>וְחֽשֶׁךְ מִפְּ֒נֵי אוֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maariv_aravim/14"/>וּמַעֲבִיר יוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maariv_aravim/15"/>וּמֵבִיא לָֽיְלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maariv_aravim/16"/>וּמַבְדִּיל בֵּין יוֹם וּבֵין לָֽיְלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maariv_aravim/17"/>יְהֹוָה צְבָאוֹת שְׁמוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maariv_aravim/18"/>❖אֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maariv_aravim/19"/>חַי וְקַיָּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maariv_aravim/20"/>תָּמִיד יִמְלֹךְ עָלֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maariv_aravim/21"/>לְעוֹלָם וָעֶד.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maariv_aravim/22"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maariv_aravim/23"/>הַמַּעֲרִיב עֲרָבִים:</tei:p>
