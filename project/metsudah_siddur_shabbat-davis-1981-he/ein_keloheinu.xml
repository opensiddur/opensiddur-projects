      <tei:div corresp="urn:x-opensiddur:text:poem:ein_keloheinu">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_keloheinu/1"/>אֵין כֵּאלֹהֵֽינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_keloheinu/2"/>אֵין כַּאדוֹנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_keloheinu/3"/>אֵין כְּמַלְכֵּֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_keloheinu/4"/>אֵין כְּמוֹשִׁיעֵֽנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_keloheinu/5"/>מִי כֵאלֹהֵֽינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_keloheinu/6"/>מִי כַאדוֹנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_keloheinu/7"/>מִי כְמַלְכֵּֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_keloheinu/8"/>מִי כְמוֹשִׁיעֵֽנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_keloheinu/9"/>נוֹדֶה לֵאלֹהֵֽינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_keloheinu/10"/>נוֹדֶה לַאדוֹנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_keloheinu/11"/>נוֹדֶה לְמַלְכֵּֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_keloheinu/12"/>נוֹדֶה לְמוֹשִׁיעֵֽנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_keloheinu/13"/>בָּרוּךְ אֱלֹהֵֽינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_keloheinu/14"/>בָּרוּךְ אֲדוֹנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_keloheinu/15"/>בָּרוּךְ מַלְכֵּֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_keloheinu/16"/>בָּרוּךְ מוֹשִׁיעֵֽנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_keloheinu/17"/>אַתָּה הוּא אֱלֹהֵֽינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_keloheinu/18"/>אַתָּה הוּא אֲדוֹנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_keloheinu/19"/>אַתָּה הוּא מַלְכֵּֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_keloheinu/20"/>אַתָּה הוּא מוֹשִׁיעֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_keloheinu/25"/>אַתָּה הוּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_keloheinu/27"/>שֶׁהִקְטִֽרוּ אֲבוֹתֵֽינוּ לְפָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_keloheinu/28"/>אֶת קְטֹֽרֶת הַסַּמִּים</tei:p>
      </tei:div>
