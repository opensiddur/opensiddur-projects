      <tei:div corresp="urn:x-opensiddur:text:prayer:veyamim_tovim_lesason">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veyamim_tovim_lesason/1"/>וְיָמִים טוֹבִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veyamim_tovim_lesason/2"/>לְשָׂשׂוֹן וּלְשִׂמְחָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veyamim_tovim_lesason/3"/>אֶת יוֹם חַג <tei:hi rend="small">(פלוני)</tei:hi> הַזֶּה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veyamim_tovim_lesason/4"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veyamim_tovim_lesason/5"/>מְקַדֵּשׁ הַשַּׁבָּת וְיִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veyamim_tovim_lesason/6"/>וְהַזְּ֒מַנִּים:</tei:p>
