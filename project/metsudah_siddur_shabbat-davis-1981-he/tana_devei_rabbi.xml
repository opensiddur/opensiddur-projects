      <tei:div corresp="urn:x-opensiddur:text:prayer:tana_devei_rabbi">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_rabbi/1"/>תָּנָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_rabbi/2"/>דְבֵי רַבִּי יִשְׁמָעֵאל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_rabbi/3"/>אִלְמָלֵא לֹא זָכוּ יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_rabbi/4"/>אֶלָּא לְהַקְבִּיל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_rabbi/5"/>פְּנֵי אֲבִיהֶם שֶׁבַּשָּׁמַֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_rabbi/6"/>פַּֽעַם אַחַת בַּחֹֽדֶשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_rabbi/7"/>דַּיָּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_rabbi/8"/>אָמַר אַבַּיֵּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_rabbi/9"/>הִילְ֒כָךְ צָרִיךְ לְמֵימְ֒רָא מְעֻמָּד:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:song_of_songs/8/5"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_rabbi/10"/>מִי זֹאת עוֹלָה מִן הַמִּדְבָּר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_rabbi/11"/>מִתְרַפֶּֽקֶת עַל דּוֹדָהּ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_rabbi/12"/>וִיהִי רָצוֹן מִלְּ֒פָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_rabbi/13"/>יְהֹוָה אֱלֹהַי וֵאלֹהֵי אֲבוֹתַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_rabbi/14"/>לְמַלֹּאת פְּגִימַת הַלְּ֒בָנָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_rabbi/15"/>וְלֹא יִהְיֶה בָהּ שׁוּם מִעוּט.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_rabbi/16"/>וְיִהְיֶה אוֹר הַלְּ֒בָנָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_rabbi/17"/>כְּאוֹר הַחַמָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_rabbi/18"/>וּכְאוֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_rabbi/19"/>שִׁבְעַת יְמֵי בְרֵאשִׁית
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_rabbi/20"/>כְּמוֹ שֶׁהָיְ֒תָה קֹֽדֶם מִעוּטָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_rabbi/21"/>שֶׁנֶּאֱמַר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_rabbi/22"/>אֶת שְׁנֵי הַמְּ֒אֹרוֹת הַגְּ֒דֹלִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_rabbi/23"/>וְיִתְקַיֵּם בָּֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_rabbi/24"/>מִקְרָא שֶׁכָּתוּב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_rabbi/25"/>וּבִקְשׁוּ אֶת יְהֹוָה אֱלֹהֵיהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_rabbi/26"/>וְאֵת דָּוִיד מַלְכָּם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_rabbi/27"/>אָמֵן:</tei:p>
      </tei:div>
    </tei:body>
