  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:birkhot_haftarah/al_hatorah_festival">
        <tei:p><j:conditional xml:id="when_1"><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="yom-tov"><tei:binary value="true"/></tei:f></tei:fs></j:conditional><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_festival/1"/>עַל הַתּוֹרָה וְעַל הָעֲבוֹדָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_festival/2"/>וְעַל הַנְּ֒בִיאִים
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_1"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_festival/3"/>וְעַל יוֹם הַשַּׁבָּת הַזֶּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_festival/4"/>וְעַל יוֹם—
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_festival/5"/>חַג הַמַּצּוֹת הַזֶּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_festival/6"/>חַג הַשָׁבוּעוֹת הַזֶּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_festival/7"/>חַג הַסֻּכּוֹת הַזֶּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_festival/8"/>הַשְּׁמִינִי חַג הָעֲצֶֽרֶת הַזֶּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_festival/9"/>שֶׁנָּתַֽתָּ לָּנוּ יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_festival/10"/><tei:hi rend="small">לשבת</tei:hi> לִקְדֻשָּׁה וְלִמְנוּחָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_festival/11"/>לְשָׂשׂוֹן וּלְשִׂמְחָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_festival/12"/>לְכָבוֹד וּלְתִפְאָֽרֶת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_festival/13"/>עַל־הַכֹּל יְהֹוָה אֱלֹהֵֽינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_festival/14"/>אֲנַֽחְנוּ מוֹדִים לָךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_festival/15"/>וּמְבָרְ֒כִים אוֹתָךְ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_festival/16"/>יִתְבָּרַךְ שִׁמְךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_festival/17"/>בְּפִי כָּל־חַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_festival/18"/>תָּמִיד לְעוֹלָם וָעֶד:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_festival/19"/>בָּרוּךְ אַתָּה יְהֹוָה.
<j:conditional xml:id="when_3"><j:none><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:none></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_festival/20"/>מְקַדֵּשׁ יִשְׂרָאֵל וְהַזְּ֒מַנִּים:
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_3"/>
<j:conditional xml:id="when_2"><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_festival/21"/>מְקַדֵּשׁ הַשַּׁבָּת וְיִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_festival/22"/>וְהַזְּ֒מַנִּים:
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_2"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
