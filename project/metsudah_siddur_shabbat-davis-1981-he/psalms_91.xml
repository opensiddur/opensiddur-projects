      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/91">
        <tei:head xml:lang="he">תהלים צא</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/1"/>ישֵׁב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/2"/>בְּסֵֽתֶר עֶלְיוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/3"/>בְּצֵל שַׁדַּי יִתְלוֹנָן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/4"/>אֹמַר לַיהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/5"/>מַחְסִי וּמְצוּדָתִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/6"/>אֱלֹהַי אֶבְטַח־בּוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/7"/>כִּי הוּא יַצִּילְךָ מִפַּח יָקוּשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/8"/>מִדֶּֽבֶר הַוּוֹת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/9"/>בְּאֶבְרָתוֹ יָֽסֶךְ לָךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/10"/>וְתַֽחַת־כְּנָפָיו תֶּחְסֶה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/11"/>צִנָּה וְסֹחֵרָה אֲמִתּוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/12"/>לֹא־תִירָא מִפַּֽחַד לָֽיְלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/13"/>מֵחֵץ יָעוּף יוֹמָם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/14"/>מִדֶּֽבֶר בָּאֹֽפֶל יַהֲלֹךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/15"/>מִקֶּֽטֶב יָשׁוּד צָהֳרָֽיִם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/16"/>יִפֹּל מִצִּדְּךָ אֶֽלֶף
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/17"/>וּרְבָבָה מִימִינֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/18"/>אֵלֶֽיךָ לֹא יִגָּשׁ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/19"/>רַק בְּעֵינֶֽיךָ תַבִּיט
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/20"/>וְשִׁלֻּמַת רְשָׁעִים תִּרְאֶה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/21"/>כִּי־אַתָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/22"/>יְהֹוָה מַחְסִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/23"/>עֶלְיוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/24"/>שַֽׂמְתָּ מְעוֹנֶֽךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/25"/>לֹא־תְאֻנֶּה אֵלֶֽיךָ רָעָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/26"/>וְנֶֽגַע לֹא־יִקְרַב בְּאָהֳלֶֽךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/27"/>כִּי מַלְאָכָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/28"/>יְצַוֶּה־לָּךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/29"/>לִשְׁמָרְךָ בְּכָל־דְּרָכֶֽיךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/30"/>עַל־כַּפַּֽיִם יִשָּׂאֽוּנְךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/31"/>פֶּן־תִּגֹּף בָּאֶֽבֶן רַגְלֶֽךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/32"/>עַל־שַֽׁחַל וָפֶֽתֶן תִּדְרֹךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/33"/>תִּרְמֹס כְּפִיר וְתַנִּין:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/34"/>כִּי בִי חָשַׁק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/35"/>וַאֲפַלְּטֵֽהוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/36"/>אֲשַׂגְּבֵֽהוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/37"/>כִּי־יָדַע שְׁמִי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/38"/>יִקְרָאֵֽנִי וְאֶעֱנֵֽהוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/39"/>עִמּוֹ־אָנֹכִי בְצָרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/40"/>אֲחַלְּצֵֽהוּ וַאֲכַבְּדֵֽהוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/41"/>❖אֹֽרֶךְ יָמִים אַשְׂבִּיעֵֽהוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/42"/>וְאַרְאֵֽהוּ בִּישׁוּעָתִי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/43"/>אֹֽרֶךְ יָמִים אַשְׂבִּיעֵֽהוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/91/44"/>וְאַרְאֵֽהוּ בִּישׁוּעָתִי:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
