      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/retzeh_vechaddesh">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vechaddesh/1"/>אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vechaddesh/2"/>רְצֵה בִמְנוּחָתֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vechaddesh/3"/>וְחַדֵּשׁ עָלֵֽינוּ בְּיוֹם הַשַּׁבָּת הַזֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vechaddesh/4"/>אֶת הַחֹֽדֶשׁ הַזֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vechaddesh/5"/>לְטוֹבָה וְלִבְרָכָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vechaddesh/6"/>לְשָׂשׁוֹן וּלְשִׂמְחָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vechaddesh/7"/>לִישׁוּעָה וּלְנֶחָמָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vechaddesh/8"/>לְפַרְנָסָה וּלְכַלְכָּלָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vechaddesh/9"/>לְחַיִּים טוֹבִים וּלְשָׁלוֹם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vechaddesh/10"/>לִמְחִֽילַת חֵטְא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vechaddesh/11"/>וְלִסְלִיחַת עָוֹן
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vechaddesh/12"/>וּלְכַפָּֽרַת פָּֽשַׁע).
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vechaddesh/13"/>וִיהִי הַחֹדֶשׁ הַזֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vechaddesh/14"/>סוֹף וְקֵץ לְכָל צָרוֹתֵֽינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vechaddesh/15"/>תְּחִילָה וָרֹאשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vechaddesh/16"/>לְפִדְיוֹן נַפְשֵֽׁינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vechaddesh/17"/>כִּי בְעַמְּ֒ךָ יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vechaddesh/18"/>בָּחַֽרְתָּ מִכָּל הָאֻמּוֹת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vechaddesh/19"/>וְשַׁבָּתוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vechaddesh/20"/>לָהֶם הוֹדָֽעְתָּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vechaddesh/21"/>וְחֻקֵּי רָאשֵׁי חֳדָשִׁים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vechaddesh/22"/>לָהֶם קָבָֽעְתָּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vechaddesh/23"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vechaddesh/24"/>מְקַדֵּשׁ הַשַּׁבָּת וְיִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vechaddesh/25"/>וְרָאשֵׁי חֳדָשִׁים:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
