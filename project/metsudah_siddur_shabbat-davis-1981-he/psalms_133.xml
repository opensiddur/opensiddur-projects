  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/133">
        <tei:head xml:lang="he">תהלים קלג</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/133/1"/>שִׁיר הַמַּעֲלוֹת לְדָוִד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/133/2"/>הִנֵּה מַה־טּוֹב וּמַה־נָּעִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/133/3"/>שֶֽׁבֶת אַחִים גַּם־יָֽחַד:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/133/4"/>כַּשֶּֽׁמֶן הַטּוֹב עַל הָרֹאשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/133/5"/>יֹרֵד עַל־הַזָּקָן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/133/6"/>זְקַן־אַהֲרֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/133/7"/>שֶׁיֹּרֵד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/133/8"/>עַל־פִּי מִדּוֹתָיו:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/133/9"/>כְּטַל־חֶרְמוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/133/10"/>שֶׁיֹּרֵד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/133/11"/>עַל־הַרְרֵי צִיּוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/133/12"/>כִּי שָׁם צִוָּה יְהֹוָה אֶת־הַבְּרָכָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/133/13"/>חַיִּים עַד־הָעוֹלָם:</tei:p>
