      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/tefillah/opening">
        <tei:head xml:lang="he">קבלת תפלה</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/1"/>אָב הָרַחֲמָן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/2"/>שְׁמַע קוֹלֵֽנוּ יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/3"/>חוּס וְרַחֵם עָלֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/4"/>וְקַבֵּל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/5"/>בְּרַחֲמִים וּבְ֒רָצוֹן אֶת תְּפִלָּתֵֽנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/6"/>כִּי אֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/7"/>שׁוֹמֵֽעַ תְּפִלּוֹת וְתַחֲנוּנִים אָֽתָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/8"/>וּמִלְּ֒פָנֶֽיךָ מַלְכֵּֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/9"/>רֵיקָם אַל תְּשִׁיבֵֽנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/10"/>חָנֵּֽנוּ וַעֲנֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/11"/>וּשְׁ֒מַע תְּפִלָתֵֽנוּ
<tei:milestone unit="phrase"/>
<j:conditional xml:id="when_1"><j:all><j:any><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="minor-fast"><tei:binary value="true"/></tei:f></tei:fs><tei:fs type="opensiddur:holiday"><tei:f name="tisha-bav"><tei:binary value="true"/></tei:f></tei:fs></j:any><tei:fs type="opensiddur:service-time"><tei:f name="minha"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/tefillah/opening/shabbat_conclusion_amidah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/17"/><tei:hi rend="small">עֲנֵֽנוּ יְהֹוָה עֲנֵֽנוּ</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/tefillah/opening/shabbat_conclusion_amidah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/18"/><tei:hi rend="small">בְּיוֹם צוֹם תַּעֲנִיתֵֽנוּ.</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/tefillah/opening/shabbat_conclusion_amidah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/19"/><tei:hi rend="small">כִּי בְצָרָה גְדוֹלָה אֲנָֽחְנוּ.</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/tefillah/opening/shabbat_conclusion_amidah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/20"/><tei:hi rend="small">אַל תֵּֽפֶן אֶל רִשְׁעֵֽנוּ</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_5"/>
<j:conditional xml:id="variant_6"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/tefillah/opening/shabbat_conclusion_amidah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/21"/><tei:hi rend="small">וְאַל תַּסְתֵּר פָּנֶֽיךָ מִמֶּֽנּוּ</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_6"/>
<j:conditional xml:id="variant_7"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/tefillah/opening/shabbat_conclusion_amidah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/22"/><tei:hi rend="small">וְאַל תִּתְעַלַּם</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_7"/>
<j:conditional xml:id="variant_8"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/tefillah/opening/shabbat_conclusion_amidah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/23"/><tei:hi rend="small">מִתְּ֒חִנָּתֵֽנוּ</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_8"/>
<j:conditional xml:id="variant_9"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/tefillah/opening/shabbat_conclusion_amidah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/24"/><tei:hi rend="small">הֱיֵה נָא קָרוֹב לְשַׁוְעָתֵֽנוּ</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_9"/>
<j:conditional xml:id="variant_10"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/tefillah/opening/shabbat_conclusion_amidah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/25"/><tei:hi rend="small">יְהִי נָא חַסְדְּךָ לְנַחֲמֵֽנוּ</tei:hi>
