      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/111">
        <tei:head xml:lang="he">תהלים קיא</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/111/1"/>הַלְלוּיָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/111/2"/>אוֹדֶה יְהֹוָה בְּכָל־לֵבָב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/111/3"/>בְּסוֹד יְשָׁרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/111/4"/>וְעֵדָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/111/5"/>גְּדֹלִים מַעֲשֵׂי יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/111/6"/>דְּרוּשִׁים לְכָל־חֶפְצֵיהֶם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/111/7"/>הוֹד־וְהָדָר פָּעֳלוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/111/8"/>וְצִדְקָתוֹ עֹמֶֽדֶת לָעַד:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/111/9"/>זֵֽכֶר עָשָׂה לְנִפְלְאֹתָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/111/10"/>חַנּוּן וְרַחוּם יְהֹוָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/111/11"/>טֶֽרֶף נָתַן לִירֵאָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/111/12"/>יִזְכֹּר לְעוֹלָם בְּרִיתוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/111/13"/>כֹּֽחַ מַעֲשָׂיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/111/14"/>הִגִּיד לְעַמּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/111/15"/>לָתֵת לָהֶם נַחֲלַת גּוֹיִם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/111/16"/>מַעֲשֵׂי יָדָיו אֱמֶת וּמִשְׁפָּט
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/111/17"/>נֶאֱמָנִים כָּל־פִּקּוּדָיו:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/111/18"/>סְמוּכִים לָעַד לְעוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/111/19"/>עֲשׂוּיִם בֶּאֱמֶת וְיָשָׁר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/111/20"/>פְּדוּת שָׁלַח לְעַמּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/111/21"/>צִוָּה־לְעוֹלָם בְּרִיתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/111/22"/>קָדוֹשׁ וְנוֹרָא שְׁמוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/111/23"/>רֵאשִׁית חָכְמָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/111/24"/>יִרְאַת יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/111/25"/>שֵֽׂכֶל טוֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/111/26"/>לְכָל־עֹשֵׂיהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/111/27"/>תְּהִלָּתוֹ עֹמֶֽדֶת לָעַד:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
