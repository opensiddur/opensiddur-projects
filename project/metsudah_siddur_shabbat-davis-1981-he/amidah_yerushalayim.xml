    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/yerushalayim">
        <tei:head xml:lang="he">בנין ירושלים</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yerushalayim/1"/>וְלִירוּשָׁלַֽיִם עִירְ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yerushalayim/2"/>בְּרַחֲמִים תָּשׁוּב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yerushalayim/3"/>וְתִשְׁכּוֹן בְּתוֹכָהּ כַּאֲשֶׁר דִּבַּֽרְתָּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yerushalayim/4"/>וּבְ֒נֵה אוֹתָהּ בְּקָרוֹב בְּיָמֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yerushalayim/5"/>בִּנְיַן עוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yerushalayim/6"/>וְכִסֵּא דָוִד עַבְדֶּךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yerushalayim/7"/>מְהֵרָה לְתוֹכָהּ תָּכִין:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yerushalayim/8"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yerushalayim/9"/>בּוֹנֵה יְרוּשָׁלָֽיִם:</tei:p>
      </tei:div>
