      <tei:div corresp="urn:x-opensiddur:text:prayer:birkhot_haftarah/al_hatorah_shabbat">
        <tei:p><j:conditional xml:id="when_1"><j:none><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="minor-fast"><tei:binary value="true"/></tei:f></tei:fs><tei:fs type="opensiddur:holiday"><tei:f name="tisha-bav"><tei:binary value="true"/></tei:f></tei:fs></j:none></j:conditional><j:endConditional target="#when_1"/><j:conditional xml:id="when_2"><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:conditional><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_shabbat/1"/>עַל הַתּוֹרָה. וְעַל הָעֲבוֹדָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_shabbat/2"/>וְעַל הַנְּ֒בִיאִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_shabbat/3"/>וְעַל יוֹם הַשַּׁבָּת הַזֶּה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_shabbat/4"/>שֶׁנָּתַֽתָּ לָֽנוּ יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_shabbat/5"/>לִקְדֻשָּׁה וְלִמְנוּחָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_shabbat/6"/>לְכָבוֹד וּלְתִפְאָֽרֶת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_shabbat/7"/>עַל־הַכֹּל יְהֹוָה אֱלֹהֵֽינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_shabbat/8"/>אֲנַֽחְנוּ מוֹדִים לָךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_shabbat/9"/>וּמְבָרְ֒כִים אוֹתָךְ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_shabbat/10"/>יִתְבָּרַךְ שִׁמְךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_shabbat/11"/>בְּפִי כָּל־חַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_shabbat/12"/>תָּמִיד לְעוֹלָם וָעֶד:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_shabbat/13"/>בָּרוּךְ אַתָּה יְהֹוָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_shabbat/14"/>מְקַדֵּשׁ הַשַּׁבָּת:
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_2"/></tei:p>
