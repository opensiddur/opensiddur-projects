      <tei:div corresp="urn:x-opensiddur:text:prayer:hinneh_el_yeshuati">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hinneh_el_yeshuati/1"/>הִנֵּה. אֵל יְשׁוּעָתִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hinneh_el_yeshuati/2"/>אֶבְטַח. וְלֹא אֶפְחָד.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hinneh_el_yeshuati/3"/>כִּי עָזִּי וְזִמְרָת יָהּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hinneh_el_yeshuati/4"/>יְהֹוָה. וַיְהִי לִי לִישׁוּעָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hinneh_el_yeshuati/5"/>וּשְׁאַבְתֶּם מַֽיִם בְּשָׂשׂוֹן.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hinneh_el_yeshuati/6"/>מִמַּעַיְנֵי הַיְשׁוּעָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hinneh_el_yeshuati/7"/>לַיהֹוָה הַיְשׁוּעָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hinneh_el_yeshuati/8"/>עַל עַמְּ֒ךָ בִרְכָתֶךָ סֶּֽלָה.</tei:p>
      </tei:div>
    </tei:body>
