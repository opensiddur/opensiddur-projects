      <tei:div corresp="urn:x-opensiddur:text:prayer:emet_veyatziv/emet">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veyatziv/emet/1"/>וְיַצִּיב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veyatziv/emet/2"/>וְנָכוֹן וְקַיָּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veyatziv/emet/3"/>וְיָשָׁר וְנֶאֱמָן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veyatziv/emet/4"/>וְאָהוּב וְחָבִיב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veyatziv/emet/5"/>וְנֶחְמָד וְנָעִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veyatziv/emet/6"/>וְנוֹרָא וְאַדִּיר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veyatziv/emet/7"/>וּמְ֒תֻקָּן וּמְ֒קֻבָּל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veyatziv/emet/8"/>וְטוֹב וְיָפֶה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veyatziv/emet/9"/>הַדָּבָר הַזֶּה עָלֵֽינוּ לְעוֹלָם וָעֶד:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veyatziv/emet/10"/>אֱמֶת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veyatziv/emet/11"/>אֱלֹהֵי עוֹלָם מַלְכֵּֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veyatziv/emet/12"/>צוּר יַעֲקֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veyatziv/emet/13"/>מָגֵן יִשְׁעֵֽנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veyatziv/emet/14"/>❖לְדֹר וָדֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veyatziv/emet/15"/>הוּא קַיָּם וּשְׁ֒מוֹ קַיָּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veyatziv/emet/16"/>וְכִסְאוֹ נָכוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veyatziv/emet/17"/>וּמַלְ֒כוּתוֹ וֶאֱמוּנָתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veyatziv/emet/18"/>לָעַד קַיָּֽמֶת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veyatziv/emet/19"/>וּדְ֒בָרָיו חָיִים וְקַיָּמִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veyatziv/emet/20"/>נֶאֱמָנִים וְנֶחֱמָדִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veyatziv/emet/21"/>לָעַד וּלְ֒עוֹלְ֒מֵי עוֹלָמִים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veyatziv/emet/22"/>עַל אֲבוֹתֵֽינוּ וְעָלֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veyatziv/emet/23"/>עַל בָּנֵֽינוּ וְעַל דּוֹרוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veyatziv/emet/24"/>וְעַל כָּל דּוֹרוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veyatziv/emet/25"/>זֶֽרַע יִשְׂרָאֵל עֲבָדֶֽיךָ:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
