    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/33">
        <tei:head xml:lang="he">תהלים לג</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/1"/>רַנְּנוּ צַדִּיקִים בַּיהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/2"/>לַיְשָׁרִים נָאוָה תְהִלָּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/3"/>הוֹדוּ לַיהֹוָה בְּכִנּוֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/4"/>בְּנֵֽבֶל עָשׂוֹר זַמְּרוּ־לוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/5"/>שִֽׁירוּ־לוֹ שִׁיר חָדָשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/6"/>הֵיטִֽיבוּ נַגֵּן בִּתְרוּעָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/7"/>כִּי־יָשָׁר דְּבַר־יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/8"/>וְכָל־מַעֲשֵֽׂהוּ בֶּאֱמוּנָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/9"/>אֹהֵב צְדָקָה וּמִשְׁפָּט
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/10"/>חֶֽסֶד יְהֹוָה מָלְאָה הָאָֽרֶץ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/11"/>בִּדְבַר יְהֹוָה שָׁמַֽיִם נַעֲשׂוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/12"/>וּבְרֽוּחַ פִּיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/13"/>כָּל־צְבָאָם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/14"/>כֹּנֵס כַּנֵּד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/15"/>מֵי הַיָּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/16"/>נֹתֵן בְּאוֹצָרוֹת תְּהוֹמוֹת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/17"/>יִירְאוּ מֵיְהֹוָה כָּל־הָאָֽרֶץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/18"/>מִמֶּֽנּוּ יָגֽוּרוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/19"/>כָּל־ישְׁבֵי תֵבֵל:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/20"/>כִּי הוּא אָמַר וַיֶּֽהִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/21"/>הוּא־צִוָּה וַיַּעֲמֹד:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/22"/>יְהֹוָה הֵפִיר עֲצַת־גּוֹיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/23"/>הֵנִיא מַחְשְׁבוֹת עַמִּים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/24"/>עֲצַת יְהֹוָה לְעוֹלָם תַּעֲמֹד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/25"/>מַחְשְׁבוֹת לִבּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/26"/>לְדֹר וָדֹר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/27"/>אַשְׁרֵי הַגּוֹי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/28"/>אֲשֶׁר־יְהֹוָה אֱלֹהָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/29"/>הָעָם בָּחַר לְנַֽחֲלָה לוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/30"/>מִשָּׁמַֽיִם הִבִּיט יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/31"/>רָאָה אֶת־כָּל־בְּנֵי הָאָדָם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/32"/>מִמְּכוֹן־שִׁבְתּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/33"/>הִשְׁגִּֽיחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/34"/>אֶל כָּל־ישְׁבֵי הָאָֽרֶץ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/35"/>הַיֹּצֵר יַֽחַד לִבָּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/36"/>הַמֵּבִין אֶל־כָּל־מַעֲשֵׂיהֶם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/37"/>אֵין הַמֶּֽלֶךְ נוֹשָׁע בְּרָב־חָֽיִל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/38"/>גִּבּוֹר לֹא־יִנָּצֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/39"/>בְּרָב־כֹּֽחַ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/40"/>שֶֽׁקֶר הַסּוּס
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/41"/>לִתְשׁוּעָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/42"/>וּבְרֹב חֵילוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/43"/>לֹא יְמַלֵּט:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/44"/>הִנֵּה עֵין יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/45"/>אֶל־יְרֵאָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/46"/>לַמְיַחֲלִים לְחַסְדּוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/47"/>לְהַצִּיל מִמָּֽוֶת נַפְשָׁם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/48"/>וּלְחַיּוֹתָם בָּרָעָב:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/49"/>נַפְשֵֽׁנוּ חִכְּתָה לַיהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/50"/>עֶזְרֵֽנוּ וּמָגִנֵּֽנוּ הוּא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/51"/>❖כִּי־בוֹ יִשְׂמַח לִבֵּֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/52"/>כִּי בְשֵׁם קָדְשׁוֹ בָטָֽחְנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/53"/>יְהִי־חַסְדְּךָ יְהֹוָה עָלֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/33/54"/>כַּאֲשֶׁר יִחַֽלְנוּ לָךְ:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
