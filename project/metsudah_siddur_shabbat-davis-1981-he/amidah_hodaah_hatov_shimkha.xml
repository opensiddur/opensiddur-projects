      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/hodaah/hatov_shimkha">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/hatov_shimkha/1"/>וְכֹל הַחַיִּים יוֹדֽוּךָ סֶּֽלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/hatov_shimkha/2"/>וִיהַלְ֒לוּ וְיבָרְ֒כוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/hatov_shimkha/3"/>אֶת שִׁמְ֒ךָ הַגָּדוֹל בְּאֱמֶת לְעוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/hatov_shimkha/4"/>כִּי טוֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/hatov_shimkha/5"/>הָאֵל יְשׁוּעָתֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/hatov_shimkha/6"/>וְעֶזְרָתֵֽנוּ סֶֽלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/hatov_shimkha/7"/>הָאֵל הַטּוֹב:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/hatov_shimkha/8"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/hatov_shimkha/9"/>הַטּוֹב שִׁמְךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/hatov_shimkha/10"/>וּלְךָ נָאֶה לְהוֹדוֹת:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/hatov_shimkha/11"/>אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ בָּרְ֒כֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/hatov_shimkha/12"/>בַבְּ֒רָכָה הַמְּ֒שֻׁלֶּֽשֶׁת בַּתּוֹרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/hatov_shimkha/13"/>הַכְּ֒תוּבָה עַל יְדֵי משֶׁה עַבְדֶּֽךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/hatov_shimkha/14"/>הָאֲמוּרָה מִפִּי אַהֲרֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/hatov_shimkha/15"/>וּבָנָיו כֹּהֲנִים עַם קְדוֹשֶֽׁךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/hatov_shimkha/16"/>כָּאָמוּר:</tei:p>
      </tei:div>
