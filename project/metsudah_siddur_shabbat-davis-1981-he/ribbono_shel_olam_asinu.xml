      <tei:div corresp="urn:x-opensiddur:text:prayer:ribbono_shel_olam_asinu">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_asinu/1"/>רִבּוֹנוֹ שֶׁל עוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_asinu/2"/>עָשִֽׂינוּ מַה שֶּׁגָּזַֽרְתָּ עָלֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_asinu/3"/>וְאַף אַתָּה עֲשֵׂה עִמָּֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_asinu/4"/>כְּמָה שֶׁהִבְטַחְתָּֽנוּ
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:deuteronomy/26/15"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_asinu/5"/>הַשְׁקִֽיפָה מִמְּ֒עוֹן קָדְשְׁ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_asinu/6"/>מִן הַשָּׁמַֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_asinu/7"/>וּבָרֵךְ אֶת עַמְּ֒ךָ אֶת יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_asinu/8"/>וְאֵת הָאֲדָמָה אֲשֶׁר נָתַֽתָּה לָּֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_asinu/9"/>כַּאֲשֶׁר נִשְׁבַּֽעְתָּ לַאֲבוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_asinu/10"/>אֶֽרֶץ זָבַת חָלָב וּדְבָשׁ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
