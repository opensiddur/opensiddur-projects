      <tei:div corresp="urn:x-opensiddur:text:prayer:yizkor/father">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yizkor/father/1"/>יִזְכּוֹר אֱלֹהִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yizkor/father/2"/>נִשְׁמַת אַבָּא מוֹרִי
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yizkor/father/3"/>(פב"פ)
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yizkor/father/4"/>שֶׁהָלַךְ לְעוֹלָמוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yizkor/father/5"/>בַּעֲבוּר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yizkor/father/6"/>שֶׁבְּ֒לִי נֶֽדֶר אֶתֵּן צְדָקָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yizkor/father/7"/>בַּעֲדוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yizkor/father/8"/>בִּשְׂכַר זֶה תְּהֵא נַפְשׁוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yizkor/father/9"/>צְרוּרָה בִּצְרוֹר הַחַיִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yizkor/father/10"/>עִם נִשְׁמוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yizkor/father/11"/>אַבְרָהָם יִצְחָק וְיַעֲקֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yizkor/father/12"/>שָׂרָה רִבְקָה רָחֵל וְלֵאָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yizkor/father/13"/>וְעִם שְׁאָר צַדִּיקִים וְצִדְקָנִיּוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yizkor/father/14"/>שֶׁבְּ֒גַן עֵֽדֶן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yizkor/father/15"/>וְנֹאמַר אָמֵן:</tei:p>
      </tei:div>
