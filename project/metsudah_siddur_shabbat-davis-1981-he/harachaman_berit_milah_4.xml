    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:harachaman_berit_milah/4">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/4/1"/>הָרַחֲמָן, הוּא יְבָרֵךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/4/2"/>הַמָּל בְּשַׂר הָעָרְלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/4/3"/>וּפָרַע וּמָצַץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/4/4"/>דְּמֵי הַמִּילָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/4/5"/>אִישׁ הַיָּרֵא וְרַךְ הַלֵּבָב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/4/6"/>עֲבוֹדָתוֹ פְּסוּלָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/4/7"/>אִם שְׁלָשׁ אֵֽלֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/4/8"/>לֹא יַֽעֲשֶׂה לָּהּ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/4/9"/>אָמֵן</tei:p>
      </tei:div>
