      <tei:div corresp="urn:x-opensiddur:text:poem:deror_yiqra_dunash">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/1"/>דְּרוֹר יִקְרָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/2"/>לְבֵן עִם בַּת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/3"/>וְיִנְצָרְכֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/4"/>כְּמוֹ בָבַת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/5"/>נְעִים שִׁמְכֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/6"/>וְלֹא יֻשְׁבַּת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/7"/>שְׁבוּ נֽוּחוּ בְּיוֹם שַׁבָּת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/8"/>דְּרוֹשׁ נָוִי וְאוּלָמִי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/9"/>וְאוֹת יֶֽשַׁע עֲשֵׂה עִמִּי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/10"/>נְטַע שׂוֹרֵק בְּתוֹךְ כַּרְמִי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/11"/>שְׁעֵה שַׁוְעַת בְּנֵי עַמִּי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/12"/>דְּרוֹךְ פּוּרָה בְּתוֹךְ בָּצְרָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/13"/>וְגַם בָּבֶל אֲשֶׁר גָּבְ֒רָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/14"/>נְתוֹץ צָרַי בְּאַף וְעֶבְרָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/15"/>שְׁמַע קוֹלִי בְּיוֹם אֶקְרָא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/16"/>אֱלֹהִים תֵּן בַּמִּדְבָּר הַר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/17"/>הֲדַס שִׁטָּה בְּרוֹשׁ תִּדְהָר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/18"/>וְלַמַּזְהִיר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/19"/>וְלַנִּזְהָר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/20"/>שְׁלוֹמִים תֵּן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/21"/>כְּמֵי נָהָר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/22"/>הֲדוֹךְ קָמַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/23"/>אֵל קַנָּא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/24"/>בְּמוֹג לֵבָב וּבַמְּ֒גִנָּה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/25"/>וְנַרְחִיב פֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/26"/>וּנְמַלֶּֽאנָּה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/27"/>לְשׁוֹנֵֽנוּ לְךָ רִנָּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/28"/>דְּעֵה חָכְמָה לְנַפְשֶֽׁךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/29"/>וְהִיא כֶֽתֶר לְרֹאשֶֽׁךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/30"/>נְצוֹר מִצְוַת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/31"/>קְדוֹשֶׁיךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:deror_yiqra_dunash/32"/>שְׁמוֹר שַׁבַּת קְדשֶֽׁךָ:</tei:p>
      </tei:div>
