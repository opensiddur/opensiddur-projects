      <tei:div corresp="urn:x-opensiddur:text:prayer:kiddush/asher_qiddeshanu/text">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/asher_qiddeshanu/text/1"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/asher_qiddeshanu/text/2"/>אֱלֹהֵֽינוּ מֶֽלֶךְ הָעוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/asher_qiddeshanu/text/3"/>אֲשֶׁר קִדְּ֒שָֽׁנוּ בְּמִצְוֹתָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/asher_qiddeshanu/text/4"/>וְרָצָה בָֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/asher_qiddeshanu/text/5"/>וְשַׁבַּת קָדְשׁוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/asher_qiddeshanu/text/6"/>בְּאַהֲבָה וּבְרָצוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/asher_qiddeshanu/text/7"/>הִנְחִילָֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/asher_qiddeshanu/text/8"/>זִכָּרוֹן לְמַעֲשֵׂה בְרֵאשִׁית.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/asher_qiddeshanu/text/9"/>(כִּי הוּא יוֹם) תְּחִלָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/asher_qiddeshanu/text/10"/>לְמִקְרָאֵי קֹֽדֶשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/asher_qiddeshanu/text/11"/>זֵֽכֶר לִיצִיאַת מִצְרָֽיִם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/asher_qiddeshanu/text/12"/>(כִּי בָֽנוּ בָחַֽרְתָּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/asher_qiddeshanu/text/13"/>וְאוֹתָֽנוּ קִדַּשְׁתָּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/asher_qiddeshanu/text/14"/>מִכָּל הָעַמִּים.)
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/asher_qiddeshanu/text/15"/>וְשַׁבַּת קָדְשְׁ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/asher_qiddeshanu/text/16"/>בְּאַהֲבָה וּבְרָצוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/asher_qiddeshanu/text/17"/>הִנְחַלְתָּֽנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/asher_qiddeshanu/text/18"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/asher_qiddeshanu/text/19"/>מְקַדֵּשׁ הַשַּׁבָּת:</tei:p>
