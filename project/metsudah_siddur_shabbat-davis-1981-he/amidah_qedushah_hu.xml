    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/hu">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/hu/1"/>❖הוּא אֱלֹהֵֽינוּ הוּא אָבִֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/hu/2"/>הוּא מַלְכֵּֽנוּ הוּא מוֹשִׁיעֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/hu/3"/>וְהוּא יוֹשִׁיעֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/hu/4"/>וְיִּגְאָלֵֽנוּ שֵׁנִית.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/hu/5"/>וְיַשְׁמִיעֵֽנוּ בְּרַחֲמָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/hu/6"/>שֵׁנִית
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/hu/7"/>לְעֵינֵי כָּל חַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/hu/8"/>לֵאמֹר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/hu/9"/>הֵן גָּאַֽלְתִּי אֶתְכֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/hu/10"/>אַחֲרִית כְרֵאשִׁית.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/hu/11"/>לִהְיוֹת לָכֶם לֵאלֹהִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/hu/12"/>אֲנִי יְהֹוָה אֱלֹהֵיכֶם:</tei:p>
