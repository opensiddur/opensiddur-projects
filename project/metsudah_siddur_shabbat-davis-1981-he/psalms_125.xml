      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/125">
        <tei:head xml:lang="he">תהלים קכה</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/125/1"/>שִׁיר הַמַּעֲלוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/125/2"/>הַבֹּטְחִים בַּיהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/125/3"/>כְּהַר־צִיּוֹן לֹא־יִמּוֹט
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/125/4"/>לְעוֹלָם יֵשֵׁב:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/125/5"/>יְרוּשָׁלַֽםִ הָרִים סָבִיב לָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/125/6"/>וַיהֹוָה סָבִיב לְעַמּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/125/7"/>מֵעַתָּה וְעַד־עוֹלָם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/125/8"/>כִּי לֹא יָנֽוּחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/125/9"/>שֵֽׁבֶט הָרֶֽשַׁע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/125/10"/>עַל גּוֹרַל הַצַּדִּיקִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/125/11"/>לְמַֽעַן לֹא־יִשְׁלְחוּ הַצַּדִּיקִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/125/12"/>בְּעַוְלָֽתָה יְדֵיהֶם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/125/13"/>הֵיטִֽיבָה יְהֹוָה לַטּוֹבִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/125/14"/>וְלִישָׁרִים בְּלִבּוֹתָם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/125/15"/>וְהַמַּטִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/125/16"/>עֲקַלְקַלּוֹתָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/125/17"/>יוֹלִיכֵם יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/125/18"/>אֶת־פֹּעֲלֵי הָאָֽוֶן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/125/19"/>שָׁלוֹם עַל־יִשְׂרָאֵל:</tei:p>
      </tei:div>
    </tei:body>
