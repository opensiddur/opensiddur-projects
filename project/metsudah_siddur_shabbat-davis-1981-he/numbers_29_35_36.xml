      <tei:div corresp="urn:x-opensiddur:text:bible:numbers/29/35-36">
        <tei:head xml:lang="he">לשמיני עצרת ושמחת תורה</tei:head>
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/29/35"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/35-36/1"/>בַּיּוֹם הַ֒שְּׁמִינִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/35-36/2"/>עֲצֶֽרֶת תִּהְיֶה לָכֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/35-36/3"/>כָּל מְלֶֽאכֶת עֲבֹדָה לֹא תַעֲשׂוּ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/35-36/4"/>וְהִקְרַבְתֶּם עֹלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/35-36/5"/>אִשֵּׁה רֵֽיחַ נִיחֹֽחַ לַיהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/35-36/6"/>פַּר אֶחָד אַֽיִל אֶחָד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/35-36/7"/>כְּבָשִׂים בְּנֵי שָׁנָה שִׁבְעָה</tei:p>
      </tei:div>
