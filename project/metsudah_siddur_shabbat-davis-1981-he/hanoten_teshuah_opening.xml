      <tei:div corresp="urn:x-opensiddur:text:prayer:hanoten_teshuah/opening">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/opening/1"/>הַנּוֹתֵן תְּשׁוּעָה לַמְּ֒לָכִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/opening/2"/>וּמֶמְשָׁלָה לַנְּ֒סִיכִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/opening/3"/>מַלְכוּתוֹ מַלְכוּת כָּל־עוֹלָמִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/opening/4"/>הַפּוֹצֶה אֶת־דָּוִד עַבְדּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/opening/5"/>מֵחֶֽרֶב רָעָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/opening/6"/>הַנּוֹתֵן בַּיָּם דֶּֽרֶךְ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/opening/7"/>וּבְמַֽיִם עַזִּים נְתִיבָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/opening/8"/>הוּא יְבָרֵךְ וְיִשְׁמֹר וְיִנְצֹר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/opening/9"/>וְיַעֲזֹר וִירוֹמֵם וִיגַדֵּל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/opening/10"/>וִינַשֵּׂא לְמַֽעְלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/opening/11"/>אֶת נְשִׂיא אַרְצוֹת הַבְּ֒רִית
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/opening/12"/>וּמִשְׁנֵֽהוּ</tei:p>
