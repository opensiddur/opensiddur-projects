      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/yismechu_vemalkhutekha">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismechu_vemalkhutekha/1"/>יִשְׂמְחוּ בְמַלְכוּתְ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismechu_vemalkhutekha/2"/>שׁוֹמְ֒רֵי שַׁבָּת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismechu_vemalkhutekha/3"/>וְקוֹרְ֒אֵי עֹֽנֶג.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismechu_vemalkhutekha/4"/>עַם מְקַדְּ֒שֵׁי שְׁבִיעִי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismechu_vemalkhutekha/5"/>כֻּלָּם יִשְׂבְּ֒עוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismechu_vemalkhutekha/6"/>וְיִתְעַנְּ֒גוּ מִטּוּבֶֽךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismechu_vemalkhutekha/7"/>וּבַשְּׁ֒בִיעִי רָצִֽיתָ בּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismechu_vemalkhutekha/8"/>וְקִדַּשְׁתּוֹ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismechu_vemalkhutekha/9"/>חֶמְדַּת יָמִים אוֹתוֹ קָרָֽאתָ.
<tei:milestone unit="phrase"/>
