<j:conditional xml:id="variant_17"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/yismechu_vemalkhutekha/shabbat_musaf_amidah_275"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/yismechu_vemalkhutekha/regalim_musaf_qedushat_hayom"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
