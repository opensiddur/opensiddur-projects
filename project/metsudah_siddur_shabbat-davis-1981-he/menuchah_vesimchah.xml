      <tei:div corresp="urn:x-opensiddur:text:poem:menuchah_vesimchah">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/1"/>מְנוּחָה וְשִׂמְחָה אוֹר לַיְּ֒הוּדִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/2"/>יוֹם שַׁבָּתוֹן יוֹם מַחֲמַדִּים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/3"/>שׁוֹמְ֒רָיו וְזוֹכְ֒רָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/4"/>הֵֽמָּה מְעִידִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/5"/>כִּי לְשִׁשָּׁה כֹּל בְּרוּאִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/6"/>וְעוֹמְ֒דִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/7"/>שְׁמֵי שָׁמַֽיִם אֶֽרֶץ וְיַמִּים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/8"/>כָּל צְבָא מָרוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/9"/>גְבוֹהִים וְרָמִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/10"/>תַּנִּין וְאָדָם וְחַיַּת רְאֵמִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/11"/>כִּי בְּיָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/12"/>יְהֹוָה צוּר עוֹלָמִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/13"/>הוּא אֲשֶׁר דִּבֶּר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/14"/>לְעַם סְגֻלָּתוֹ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/15"/>שָׁמוֹר לְקַדְּ֒שׁוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/16"/>מִבֹּאוֹ וְעַד צֵאתוֹ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/17"/>שַׁבָּת קֹֽדֶשׁ יוֹם חֶמְדָּתוֹ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/18"/>כִּי בוֹ שָׁבַת אֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/19"/>מִכָּל מְלַאכְתּוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/20"/>בְּמִצְוַת שַׁבָּת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/21"/>אֵל יַחֲלִיצָךְ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/22"/>קוּם קְרָא אֵלָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/23"/>יָחִישׁ לְאַמְּ֒צָךְ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/24"/>נִשְׁמַת כָּל חַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/25"/>וְגַם נַעֲרִיצָךְ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/26"/>אֱכֹל בְּשִׂמְחָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/27"/>כִּי כְבָר רָצָךְ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/28"/>בְּמִשְׁנֶה לֶֽחֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/29"/>וְקִדּוּשׁ רַבָּה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/30"/>בְּרוֹב מַטְעַמִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/31"/>וְרֽוּחַ נְדִיבָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/32"/>יִזְכּוּ לְרַב טוּב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/33"/>הַמִּתְעַנְּ֒גִים בָּהּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/34"/>בְּבִיאַת גּוֹאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:menuchah_vesimchah/35"/>לְחַיֵּי הָעוֹלָם הַבָּא.</tei:p>
      </tei:div>
    </tei:body>
