      <tei:div corresp="urn:x-opensiddur:text:poem:kol_meqaddesh/5">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/5/1"/>יוֹם קָדוֹשׁ הוּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/5/2"/>מִבֹּאוֹ וְעַד צֵאתוֹ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/5/3"/>כָּל זֶֽרַע יַעֲקֹב יְכַבְּ֒דֽוּהוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/5/4"/>כִּדְבַר הַמֶּֽלֶךְ וְדָתוֹ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/5/5"/>לָנֽוּחַ בּוֹ וְלִשְׂמֹֽחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/5/6"/>בְּתַעֲנוּג אָכוֹל וְשָׁתוֹ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/5/7"/>כָּל עֲדַת יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/5/8"/>יַעֲשׂוּ אוֹתוֹ.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
