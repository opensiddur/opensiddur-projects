      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/refuah">
        <tei:head xml:lang="he">רפואה</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/1"/>רְפָאֵֽנוּ יְהֹוָה וְנֵרָפֵא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/2"/>הוֹשִׁיעֵֽנוּ וְנִוָּשֵֽׁעָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/3"/>כִּי תְהִלָּתֵֽנוּ אָֽתָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/4"/>וְהַעֲלֵה אֲרוּכָה וּמַרְפֵּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/5"/>לְכָל תַּחֲלוּאֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/6"/>וּלְ֒כָל מַכְאוֹבֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/7"/>וּלְ֒כָל מַכּוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/19"/>כִּי אֵל מֶֽלֶךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/20"/>רוֹפֵא נֶאֱמָן וְרַחֲמָן אָֽתָּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/21"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/22"/>רוֹפֵא חוֹלֵי עַמּוֹ יִשְׂרָאֵל:</tei:p>
