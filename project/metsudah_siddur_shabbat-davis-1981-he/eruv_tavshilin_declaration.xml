      <tei:div corresp="urn:x-opensiddur:text:prayer:eruv_tavshilin/declaration">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eruv_tavshilin/declaration/1"/>בְּדֵין עֵרוּבָא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eruv_tavshilin/declaration/2"/>יְהֵא שָׁרָא לָנָא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eruv_tavshilin/declaration/3"/>לַאֲפוּיֵי וּלְבַשׁוּלֵי וּלְאַטְמוּנֵי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eruv_tavshilin/declaration/4"/>וּלְאַדְלוּקֵי שְׁרָגָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eruv_tavshilin/declaration/5"/>וּלְתַקָנָא וּלְמֶעְבַּד כָּל צָרְכָנָא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eruv_tavshilin/declaration/6"/>מִיוֹמָא טָבָא לְשַׁבַּתָּא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eruv_tavshilin/declaration/7"/>לָנָא וּלְכָל יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eruv_tavshilin/declaration/8"/>הַדָּרִים בָּעִיר הַזֹּאת:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
