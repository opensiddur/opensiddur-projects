      <tei:div corresp="urn:x-opensiddur:text:prayer:tefillat_tal">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/1"/>בְּדַעְתּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/2"/>אַבִּיעָה חִידוֹת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/3"/>בְּעַם זוּ בְּזוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/4"/>בְּטַל לְהַחֲדוֹת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/5"/>טַל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/6"/>גֵיא וּדְשָׁאֶיהָ לַחֲדוֹת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/7"/>דָּצִים בְּצִלּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/8"/>לְהֵחָדוֹת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/9"/>אוֹת יַלְדוּת טַל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/10"/>לְהָגֵן לְתוֹלָדוֹת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/11"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/12"/>מָגֵן אַבְרָהָם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/13"/>אַתָּה גִבּוֹר לְעוֹלָם אֲדֹנָי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/14"/>מְחַיֶּה מֵתִים אַתָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/15"/>רַב לְהוֹשִֽׁיעַ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/16"/>תְּהוֹמוֹת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/17"/>הֲדוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/18"/>לִרְסִיסוֹ כְּסוּפִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/19"/>וְכָל נְאוֹת דֶּֽשֶׁא לוֹ נִכְסָפִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/20"/>טַל זִכְרוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/21"/>גְבוּרוֹת מוֹסִיפִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/22"/>חָקוּק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/23"/>בְּגִישַׁת מוּסָפִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/24"/>טַל לְהַחֲיוֹת בּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/25"/>נְקִיקֵי סְעִיפִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/26"/>אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/27"/>טַל תֵּן לְרַצּוֹת אַרְצָךְ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/28"/>שִׁיתֵֽנוּ בְרָכָה בְּדִיצָךְ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/29"/>רוֹב דָּגָן וְתִירוֹשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/30"/>בְּהַפְרִיצָךְ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/31"/>קוֹמֵם עִיר בָּהּ חֶפְצָךְ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/32"/>בְּטַל:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/33"/>טַל צַוֵּה שָׁנָה טוֹבָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/34"/>וּמְעֻטֶּֽרֶת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/35"/>פְּרִי הָאָֽרֶץ לְגָאוֹן וּלְתִפְאֶֽרֶת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/36"/>עִיר כֲּסֻּכָּה נוֹתֶֽרֶת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/37"/>שִׂימָהּ בְּיָדְ֒ךָ עֲטֶֽרֶת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/38"/>בְּטַל:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/39"/>טַל נֽוֹפֶת עֲלֵי אֶֽרֶץ בְּרוּכָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/40"/>מִמֶּֽגֶד שָׁמַֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/41"/>שַׂבְּ֒עֵֽנוּ בְרָכָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/42"/>לְהָאִיר מִתּוֹךְ חֲשֵׁכָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/43"/>כַּנָּה אַחֲרֶֽיךָ מְשׁוּכָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/44"/>בְּטַל:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/45"/>טַל יַעֲסִיס צוּף
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/46"/>הָרִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/47"/>טְעֵם בִּמְאוֹדֶֽךָ מֻבְחָרִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/48"/>חֲנוּנֶֽיךָ חַלֵּץ מִמַּסְגֵּרִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/49"/>זִמְרָה נַנְעִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/50"/>וְקוֹל נָרִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/51"/>בְּטַל:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/52"/>טַל וָשֹֽׂבַע מַלֵּא אֲסָמֵֽינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/53"/>הַכָעֵת תְּחַדֵּשׁ יָמֵֽינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/54"/>דוֹד כְּעֶרְכְּ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/55"/>הַעֲמֵד שְׁמֵנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/56"/>גַּן רָוֶה שִׂימֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/57"/>בְּטַל:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/58"/>טַל בּוֹ תְבָרֵךְ מָזוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/59"/>בְּמַשְׁמַנֵּֽינוּ אַל יְהִי רָזוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/60"/>אֲיֻמָּה אֲשֶׁר הִסַּֽעְתָּ כַצֹּאן.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/61"/>אָֽנָא תָּפֵק לָהּ רָצוֹן.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/62"/>בְּטַל:
<tei:milestone unit="phrase"/>
<tei:note type="instruction" xml:lang="he">חזן</tei:note>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/63"/>שָׁאַתָּה הוּא יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/64"/>מַשִּׁיב הָרֽוּחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/65"/>וּמוֹרִיד הַטָּל:
<tei:milestone unit="phrase"/>
<tei:note type="instruction" xml:lang="he">קהל וחזן</tei:note>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/66"/>לִבְרָכָה וְלֹא לִקְלָלָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/67"/><tei:hi rend="small">אמן</tei:hi>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/68"/>לְחַיִּים וְלֹא לַמָּֽוֶת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/69"/><tei:hi rend="small">אמן</tei:hi>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/70"/>לְשֹֽׂבַע וְלֹא לְרָזוֹן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillat_tal/71"/><tei:hi rend="small">אמן</tei:hi></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
