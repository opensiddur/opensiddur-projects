      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/attah_echad">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/attah_echad/1"/>אַתָּה אֶחָד וְשִׁמְךָ אֶחָד.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:chronicles_1/17/21"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/attah_echad/2"/>וּמִי כְּעַמְּ֒ךָ יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/attah_echad/3"/>גּוֹי אֶחָד בָּאָֽרֶץ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/attah_echad/4"/>תִּפְאֶֽרֶת גְּדֻלָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/attah_echad/5"/>וַעֲטֶֽרֶת יְשׁוּעָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/attah_echad/6"/>יוֹם מְנוּחָה וּקְדֻשָּׁה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/attah_echad/7"/>לְעַמְּ֒ךָ נָתָֽתָּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/attah_echad/8"/>אַבְרָהָם יָגֵל. יִצְחָק יְרַנֵּן.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/attah_echad/9"/>יַעֲקֹב וּבָנָיו יָנֽוּחוּ בוֹ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/attah_echad/10"/>מְנוּחַת אַהֲבָה וּנְדָבָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/attah_echad/11"/>מְנוּחַת אֱמֶת וֶאֱמוּנָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/attah_echad/12"/>מְנוּחַת שָׁלוֹם וְשַׁלְוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/attah_echad/13"/>וְהַשְׁקֵט וָבֶֽטַח.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/attah_echad/14"/>מְנוּחָה שְׁלֵמָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/attah_echad/15"/>שֶׁאַתָּה רֽוֹצֶה בָהּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/attah_echad/16"/>יַכִּֽירוּ בָנֶֽיךָ וְיֵדְ֒עוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/attah_echad/17"/>כִּי מֵאִתְּ֒ךָ הִיא מְנוּחָתָם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/attah_echad/18"/>וְעַל מְנוּחָתָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/attah_echad/19"/>יַקְדִּֽישׁוּ אֶת שְׁמֶֽךָ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
