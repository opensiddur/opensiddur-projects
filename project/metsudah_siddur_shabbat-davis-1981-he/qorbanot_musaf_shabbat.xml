      <tei:div corresp="urn:x-opensiddur:text:prayer:qorbanot/musaf/shabbat">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/musaf/shabbat/1"/>וּבְיוֹם הַשַּׁבָּת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/musaf/shabbat/2"/>שְׁנֵי כְבָשִׂים בְּנֵי שָׁנָה תְּמִימִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/musaf/shabbat/3"/>וּשְׁנֵי עֶשְׂרֹנִים סֹֽלֶת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/musaf/shabbat/4"/>מִנְחָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/musaf/shabbat/5"/>בְּלוּלָה בַשֶּֽׁמֶן וְנִסְכּוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/musaf/shabbat/6"/>עֹלַת שַׁבַּת בְּשַׁבַּתּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/musaf/shabbat/7"/>עַל עֹלַת הַתָּמִיד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/musaf/shabbat/8"/>וְנִסְכָּהּ:</tei:p>
