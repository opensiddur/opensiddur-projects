      <tei:div corresp="urn:x-opensiddur:text:prayer:attah_hu/ad_shelo">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_hu/ad_shelo/1"/>אַתָּה הוּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_hu/ad_shelo/2"/>עַד שֶׁלֹּא נִבְרָא הָעוֹלָם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_hu/ad_shelo/3"/>אַתָּה הוּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_hu/ad_shelo/4"/>מִשֶּׁנִּבְרָא הָעוֹלָם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_hu/ad_shelo/5"/>אַתָּה הוּא בָּעוֹלָם הַזֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_hu/ad_shelo/6"/>וְאַתָּה הוּא לָעוֹלָם הַבָּא,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_hu/ad_shelo/7"/>קַדֵּשׁ אֶת שִׁמְ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_hu/ad_shelo/8"/>עַל מַקְדִּישֵׁי שְׁמֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_hu/ad_shelo/9"/>וְקַדֵּשׁ אֶת שִׁמְ֒ךָ בְּעֹלָמֶֽךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_hu/ad_shelo/10"/>וּבִישׁוּעָתְ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_hu/ad_shelo/11"/>תָּרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_hu/ad_shelo/12"/>וְתַגְבִּֽיהַּ קרְנֵֽנוּ לְמַֽעְלָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_hu/ad_shelo/13"/>וְהוֹשִׁיעֵֽנוּ בְּקָרוֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_hu/ad_shelo/14"/>לְמַֽעַן שְׁמֶֽךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_hu/ad_shelo/15"/>בָּרוּךְ הַמְקַדֵּשׁ שְׁמוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_hu/ad_shelo/16"/>בָּרַבִּים:</tei:p>
      </tei:div>
