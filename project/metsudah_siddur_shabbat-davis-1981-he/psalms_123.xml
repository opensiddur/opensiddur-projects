      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/123">
        <tei:head xml:lang="he">תהלים קכג</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/123/1"/>שִׁיר הַמַּעֲלוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/123/2"/>אֵלֶֽיךָ נָשָֽׂאתִי אֶת־עֵינַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/123/3"/>הַיּשְׁבִי בַּשָּׁמָֽיִם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/123/4"/>הִנֵּה כְעֵינֵי עֲבָדִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/123/5"/>אֶל־יַד אֲדוֹנֵיהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/123/6"/>כְּעֵינֵי שִׁפְחָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/123/7"/>אֶל־יַד גְּבִרְתָּהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/123/8"/>כֵּן עֵינֵֽינוּ אֶל־יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/123/9"/>עַד שֶׁיְּחָנֵּֽנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/123/10"/>חָנֵּֽנוּ יְהֹוָה חָנֵּֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/123/11"/>כִּי־רַב שָׂבַֽעְנוּ בוּז:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/123/12"/>❖רַבַּת שָֽׂבְעָה־לָּהּ נַפְשֵֽׁנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/123/13"/>הַלַּֽעַג הַשַּׁאֲנַנִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/123/14"/>הַבּוּז
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/123/15"/>לִגְאֵי יוֹנִֽים:</tei:p>
