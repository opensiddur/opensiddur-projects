      <tei:div corresp="urn:x-opensiddur:text:prayer:mimeqomo_hu_yifen">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mimeqomo_hu_yifen/1"/>❖מִמְּ֒קוֹמוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mimeqomo_hu_yifen/2"/>❖הוּא יִֽפֶן בְּרַחֲמָיו לְעַמּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mimeqomo_hu_yifen/3"/>וְיָחוֹן עַם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mimeqomo_hu_yifen/4"/>הַמְּ֒יַחֲדִים שְׁמוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mimeqomo_hu_yifen/5"/>עֶֽרֶב וָבֹֽקֶר בְּכָל יוֹם תָּמִיד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mimeqomo_hu_yifen/6"/>פַּעֲמַֽיִם בְּאַהֲבָה שְׁמַע אוֹמְרִים:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mimeqomo_hu_yifen/7"/>שְׁמַע יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mimeqomo_hu_yifen/8"/>יְהֹוָה אֱלֹהֵֽינוּ יְהֹוָה אֶחָד:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mimeqomo_hu_yifen/9"/>❖הוּא אֱלֹהֵֽינוּ הוּא אָבִֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mimeqomo_hu_yifen/10"/>הוּא מַלְכֵּֽנוּ הוּא מוֹשִׁיעֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mimeqomo_hu_yifen/11"/>וְהוּא יוֹשִׁיעֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mimeqomo_hu_yifen/12"/>וְיִּגְאָלֵֽנוּ שֵׁנִית.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mimeqomo_hu_yifen/13"/>וְיַשְׁמִיעֵֽנוּ בְּרַחֲמָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mimeqomo_hu_yifen/14"/>שֵׁנִית
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mimeqomo_hu_yifen/15"/>לְעֵינֵי כָּל חַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mimeqomo_hu_yifen/16"/>לֵאמֹר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mimeqomo_hu_yifen/17"/>הֵן גָּאַֽלְתִּי אֶתְכֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mimeqomo_hu_yifen/18"/>אַחֲרִית כְרֵאשִׁית.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mimeqomo_hu_yifen/19"/>לִהְיוֹת לָכֶם לֵאלֹהִים:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mimeqomo_hu_yifen/20"/>אֲנִי יְהֹוָה אֱלֹהֵיכֶם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mimeqomo_hu_yifen/21"/>אַדִּיר אַדִּירֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mimeqomo_hu_yifen/22"/>יְהֹוָה אֲדוֹנֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mimeqomo_hu_yifen/23"/>מָה אַדִּיר שִׁמְךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mimeqomo_hu_yifen/24"/>בְּכָל הָאָֽרֶץ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mimeqomo_hu_yifen/25"/>וְהָיָה יְהֹוָה לְמֶֽלֶךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mimeqomo_hu_yifen/26"/>עַל כָּל הָאָרֶץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mimeqomo_hu_yifen/27"/>בַּיוֹם הַהוּא יִהְיֶה יְהֹוָה אֶחָד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mimeqomo_hu_yifen/28"/>וּשְׁמוֹ אֶחָד:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mimeqomo_hu_yifen/29"/>וּבְדִבְרֵי קָדְשְׁ֒ךָ כָּתוּב לֵאמֹר:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
