      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/attah_vechartanu_mikol">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/attah_vechartanu_mikol/1"/>אַתָּה בְחַרְתָּֽנוּ מִכָּל הָעַמִּים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/attah_vechartanu_mikol/2"/>אָהַֽבְתָּ אוֹתָֽנוּ וְרָצִֽיתָ בָּֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/attah_vechartanu_mikol/3"/>וְרוֹמַמְתָּֽנוּ מִכָּל הַלְּ֒שׁוֹנוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/attah_vechartanu_mikol/4"/>וְקִדַּשְׁתָּֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/attah_vechartanu_mikol/5"/>בְּמִצְוֹתֶֽיךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/attah_vechartanu_mikol/6"/>וְקֵרַבְתָּֽנוּ מַלְכֵּֽנוּ לַעֲבוֹדָתֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/attah_vechartanu_mikol/7"/>וְשִׁמְךָ הַגָּדוֹל וְהַקָּדוֹשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/attah_vechartanu_mikol/8"/>עָלֵֽינוּ קָרָֽאתָ:</tei:p>
