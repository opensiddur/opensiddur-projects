    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:vayaazor/text">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaazor/text/1"/>וְיַעֲזוֹר וְיָגֵן וְיוֹשִֽׁיעַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaazor/text/2"/>לְכָל הַחוֹסִים בּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaazor/text/3"/>וְנֹאמַר אָמֵן.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaazor/text/4"/>הַכֹּל הָבוּ גֹֽדֶל לֵאלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaazor/text/5"/>וּתְנוּ כָבוֹד לַתּוֹרָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaazor/text/6"/>כֹּהֵן קְרָב.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaazor/text/7"/>יַעֲמֹד (פב"פ) הַכֹּהֵן.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaazor/text/8"/>בָּרוּךְ שֶׁנָּתַן תּוֹרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaazor/text/9"/>לְעַמּוֹ יִשְׂרָאֵל בִּקְדֻשָּׁתוֹ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:deuteronomy/4/4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaazor/text/10"/>וְאַתֶּם הַדְּ֒בֵקִים בַּיהוֹה אֱלֹהֵיכֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaazor/text/11"/>חַיִּים כֻּלְּ֒כֶם הַיּוֹם:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
