      <tei:div corresp="urn:x-opensiddur:text:prayer:hael_betaatzumot">
        <tei:p><j:conditional xml:id="when_1"><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="yom-tov"><tei:binary value="true"/></tei:f></tei:fs></j:conditional><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hael_betaatzumot/1"/>הָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hael_betaatzumot/2"/>בְּתַעֲצֻמוֹת עֻזֶּֽךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hael_betaatzumot/3"/>הַגָּדוֹל בִּכְבוֹד שְׁמֶֽךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hael_betaatzumot/4"/>הַגִּבּוֹר לָנֶֽצַח
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hael_betaatzumot/5"/>וְהַנּוֹרָא בְּנוֹרְ֒אוֹתֶֽיךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hael_betaatzumot/6"/>הַמֶּֽלֶךְ הַיּוֹשֵׁב עַל כִּסֵּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hael_betaatzumot/7"/>רָם וְנִשָּׂא:
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_1"/>
<j:conditional xml:id="when_2"><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hael_betaatzumot/8"/>שׁוֹכֵן עַד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hael_betaatzumot/9"/>מָרוֹם וְקָדוֹשׁ שְׁמוֹ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hael_betaatzumot/10"/>וְכָתוּב
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/33/1"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hael_betaatzumot/11"/>רַנְּ֒נוּ צַדִּיקִים בַּיהוֹה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hael_betaatzumot/12"/>לַיְ֒שָׁרִים נָאוָה תְהִלָּה:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hael_betaatzumot/13"/>בְּפִי יְשָׁרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hael_betaatzumot/14"/>תִּתְרוֹמָם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hael_betaatzumot/15"/>וּבְשִׂפְתֵי צַדִּיקִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hael_betaatzumot/16"/>תִּתְבָּרַךְ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hael_betaatzumot/17"/>וּבִלְשׁוֹן חֲסִידִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hael_betaatzumot/18"/>תִּתְקַדָּשׁ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hael_betaatzumot/19"/>וּבְקֶֽרֶב קְדוֹשִׁים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hael_betaatzumot/20"/>תִּתְהַלָּל:
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_2"/></tei:p>
