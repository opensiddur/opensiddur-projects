      <tei:div corresp="urn:x-opensiddur:text:poem:shalom_aleikhem">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shalom_aleikhem/1"/>שָׁלוֹם עֲלֵיכֶם מַלְאֲכֵי הַשָּׁרֵת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shalom_aleikhem/2"/>מַלְאֲכֵי עֶלְיוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shalom_aleikhem/3"/>מִמֶּֽלֶךְ מַלְכֵי הַמְּ֒לָכִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shalom_aleikhem/4"/>הַקָּדוֹשׁ בָּרוּךְ הוּא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shalom_aleikhem/5"/>בּוֹאֲכֶם לְשָׁלוֹם מַלְאֲכֵי הַשָּׁלוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shalom_aleikhem/6"/>מַלְאֲכֵי עֶלְיוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shalom_aleikhem/7"/>מִמֶּֽלֶךְ מַלְכֵי הַמְּ֒לָכִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shalom_aleikhem/8"/>הַקָּדוֹשׁ בָּרוּךְ הוּא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shalom_aleikhem/9"/>בָּרְכוּנִי לְשָׁלוֹם מַלְאֲכֵי הַשָּׁלוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shalom_aleikhem/10"/>מַלְאֲכֵי עֶלְיוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shalom_aleikhem/11"/>מִמֶּֽלֶךְ מַלְכֵי הַמְּ֒לָכִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shalom_aleikhem/12"/>הַקָּדוֹשׁ בָּרוּךְ הוּא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shalom_aleikhem/13"/>צֵאתְכֶם לְשָׁלוֹם מַלְאֲכֵי הַשָּׁלוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shalom_aleikhem/14"/>מַלְאֲכֵי עֶלְיוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shalom_aleikhem/15"/>מִמֶּֽלֶךְ מַלְכֵי הַמְּ֒לָכִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shalom_aleikhem/16"/>הַקָּדוֹשׁ בָּרוּךְ הוּא:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/91/11"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shalom_aleikhem/17"/>כִּי מַלְאָכָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shalom_aleikhem/18"/>יְצַוֶּה־לָּךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shalom_aleikhem/19"/>לִשְׁמָרְךָ בְּכָל־דְּרָכֶֽיךָ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/121/8"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shalom_aleikhem/20"/>יְהֹוָה יִשְׁמָר־צֵאתְ֒ךָ וּבוֹאֶךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shalom_aleikhem/21"/>מֵעַתָּה וְעַד־עוֹלָם:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
