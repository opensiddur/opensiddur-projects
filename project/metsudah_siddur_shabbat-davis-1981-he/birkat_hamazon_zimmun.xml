<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:birkat_hamazon/zimmun/lifecycle_berit_milah_birkat_hamazon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/zimmun/5"/>מֵעַתָּה וְעַד עוֹלָם:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:birkat_hamazon/zimmun/lifecycle_sheva_berakhot_birkat_hamazon"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="prayer" corresp="urn:x-opensiddur:text:poem:devai_haser"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/zimmun/33"/>דְּוַי הָסֵר וְגַם חָרוֹן,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/zimmun/34"/>וְאָז אִלֵּם בְּשִׁיר יָרוֹן,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/zimmun/35"/>נְחֵֽנוּ בְּמַעְגְּ֒לֵי צֶֽדֶק,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/zimmun/36"/>שְׁעֵה בִּרְכַּת (בְּנֵי יְשֻׁרוּן)
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/zimmun/37"/>בְּנֵי אַהֲרֹן:
<tei:milestone unit="phrase"/>
<tei:milestone unit="prayer"/>
<j:endConditional target="#variant_5"/>
<j:conditional xml:id="variant_6"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:birkat_hamazon/zimmun/lifecycle_berit_milah_birkat_hamazon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/zimmun/6"/>בִּרְ֒שׁוּת
