        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/zimmun/1"/>רַבּוֹתַי נְבָרֵךְ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/113/2"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:birkat_hamazon/zimmun/lifecycle_berit_milah_birkat_hamazon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/zimmun/2"/>יְהִי שֵׁם יְהֹוָה מְבֹרָךְ
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:birkat_hamazon/zimmun/lifecycle_berit_milah_birkat_hamazon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/zimmun/3"/>מֵעַתָּה וְעַד עוֹלָם:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<tei:milestone unit="verse"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:birkat_hamazon/zimmun/lifecycle_berit_milah_birkat_hamazon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/zimmun/4"/>יְהִי שֵׁם יְהֹוָה מְבֹרָךְ
