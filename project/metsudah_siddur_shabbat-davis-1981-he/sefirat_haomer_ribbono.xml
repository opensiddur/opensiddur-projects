      <tei:div corresp="urn:x-opensiddur:text:prayer:sefirat_haomer/ribbono">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/1"/>רִבּוֹנוֹ שֶׁל עוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/2"/>אַתָּה צִוִּיתָֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/3"/>עַל יְדֵי משֶׁה עַבְדֶּֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/4"/>לִסְפֹּר סְפִירַת הָֽעֹמֶר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/5"/>כְּדֵי לְטַהֲרֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/6"/>מִקְּ֒לִפּוֹתֵֽינוּ וּמִטֻּמְאוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/7"/>כְּמוֹ שֶׁכָּתַֽבְתָּ בְּתוֹרָתֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/8"/>וּסְפַרְתֶּם לָכֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/9"/>מִמָּחֳרַת הַשַּׁבָּת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/10"/>מִיּוֹם הֲבִיאֲכֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/11"/>אֶת עֹֽמֶר הַתְּ֒נוּפָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/12"/>שֶֽׁבַע שַׁבָּתוֹת תְּמִימוֹת תִּהְיֶֽינָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/13"/>עַד מִמָּחֳרַת הַשַּׁבָּת הַשְּׁ֒בִיעִית
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/14"/>תִּסְפְּ֒רוּ חֲמִשִּׁים יוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/15"/>כְּדֵי שֶׁיִּטָּהֲרוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/16"/>נַפְשׁוֹת עַמְּ֒ךָ יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/17"/>מִזֻּהֲמָתָם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/18"/>וּבְכֵן יְהִי רָצוֹן מִלְּ֒פָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/19"/>יְהֹוָה אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/20"/>שֶׁבִּזְכוּת סְפִירַת הָעֹֽמֶר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/21"/>שֶׁסָּפַֽרְתִּי הַיּוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/22"/>יְתֻקַּן מַה שֶּׁפָּגַֽמְתִּי בִּסְפִירָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/24"/>וְאֶטָּהֵר וְאֶתְקַדֵּשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/25"/>בִּקְדֻשָּׁה שֶׁל מַֽעְלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/26"/>וְעַל יְדֵי זֶה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/27"/>יֻשְׁפַּע שֶֽׁפַע רַב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/28"/>בְּכָל הָעוֹלָמוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/29"/>וּלְתַקֵּן אֶת נַפְשׁוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/30"/>וְרוּחוֹתֵֽינוּ וְנִשְׁמוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/31"/>מִכָּל סִיג וּפְגָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/32"/>וּלְטַהֲרֵֽנוּ וּלְקַדְּ֒שֵֽׁנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/33"/>בִּקְדֻשָּׁתְ֒ךָ הָעֶלְיוֹנָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/ribbono/34"/>אָמֵן סֶֽלָה:</tei:p>
      </tei:div>
