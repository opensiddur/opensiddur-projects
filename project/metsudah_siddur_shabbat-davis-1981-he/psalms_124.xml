    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/124">
        <tei:head xml:lang="he">תהלים קכד</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/124/1"/>שִׁיר הַמַּעֲלוֹת לְדָוִד
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:bible:psalms/124/shabbat_minchah_psalms"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/124/21"/>לוּלֵי יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/124/22"/>שֶׁהָֽיָה לָֽנוּ
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:bible:psalms/124/shabbat_minchah_psalms"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/124/2"/>לוּלֵי יְהֹוָה שֶׁהָֽיָה לָֽנוּ
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/124/3"/>יֹֽאמַר־נָא יִשְׂרָאֵל:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/124/4"/>לוּלֵי יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/124/5"/>שֶׁהָֽיָה לָֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/124/6"/>בְּקוּם עָלֵֽינוּ אָדָם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/124/7"/>אֲזַי חַיִּים בְּלָעֽוּנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/124/8"/>בַּחֲרוֹת אַפָּם בָּֽנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/124/9"/>אֲזַי הַמַּֽיִם שְׁטָפֽוּנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/124/10"/>נַֽחְלָה עָבַר עַל־נַפְשֵֽׁנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/124/11"/>אֲזַי עָבַר עַל־נַפְשֵֽׁנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/124/12"/>הַמַּֽיִם הַזֵּידוֹנִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/124/13"/>בָּרוּךְ יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/124/14"/>שֶׁלֹּא נְתָנָֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/124/15"/>טֶֽרֶף לְשִׁנֵּיהֶם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/124/16"/>❖נַפְשֵֽׁנוּ כְּצִפּוֹר נִמְלְטָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/124/17"/>מִפַּח יוֹקְשִׁים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/124/18"/>הַפַּח נִשְׁבָּר וַאֲנַֽחְנוּ נִמְלָֽטְנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/124/19"/>עֶזְרֵֽנוּ בְּשֵׁם יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/124/20"/>עֹשֵׂה שָׁמַֽיִם וָאָֽרֶץ:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
