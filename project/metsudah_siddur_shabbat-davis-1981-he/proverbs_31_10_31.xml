    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:proverbs/31/10-31">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/10"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/1"/>אֵֽשֶׁת־חַֽיִל מִי יִמְצָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/2"/>וְרָחֹק מִפְּ֒נִינִים מִכְרָהּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/11"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/3"/>בָּֽטַח בָּהּ לֵב בַּעְלָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/4"/>וְשָׁלָל לֹא יֶחְסָר:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/12"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/5"/>גְּמָלַֽתְהוּ טוֹב וְלֹא־רָע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/6"/>כֹּל יְמֵי חַיֶּֽיהָ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/13"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/7"/>דָּרְ֒שָׁה צֶֽמֶר וּפִשְׁתִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/8"/>וַתַּֽעַשׂ בְּחֵֽפֶץ כַּפֶּֽיהָ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/14"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/9"/>הָיְ֒תָה כָּאֳנִיּוֹת סוֹחֵר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/10"/>מִמֶּרְחָק תָּבִיא לַחְמָהּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/15"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/11"/>וַתָּֽקָם בְּעוֹד לַֽיְלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/12"/>וַתִּתֵּן טֶֽרֶף לְבֵיתָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/13"/>וְחֹק לְנַעֲרֹתֶֽיהָ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/16"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/14"/>זָמְ֒מָה שָׂדֶה וַתִּקָּחֵֽהוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/15"/>מִפְּ֒רִי כַפֶּֽיהָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/16"/>נָֽטְ֒עָה כָּֽרֶם:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/17"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/17"/>חָגְ֒רָה בְּעוֹז מָתְנֶֽיהָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/18"/>וַתְּ֒אַמֵּץ זְרוֹעֹתֶֽיהָ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/18"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/19"/>טָעֲמָה כִּי־טוֹב סַחְרָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/20"/>לֹא־יִכְבֶּה בַּלַּֽיְלָה נֵרָהּ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/21"/>יָדֶֽיהָ שִׁלְּ֒ חָה בַכִּישׁוֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/22"/>וְכַפֶּֽיהָ תָּֽמְ֒כוּ פָֽלֶךְ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/20"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/23"/>כַּפָּהּ פָּרְ֒שָׂה לֶעָנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/24"/>וְיָדֶֽיהָ שִׁלְּ֒חָה לָאֶבְיוֹן:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/21"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/25"/>לֹא־תִירָא לְבֵיתָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/26"/>מִשָּֽׁלֶג
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/27"/>כִּי כָל־בֵּיתָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/28"/>לָבֻשׁ שָׁנִים:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/22"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/29"/>מַרְבַדִּים עָֽשְׂ֒תָה־לָּהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/30"/>שֵׁשׁ וְאַרְגָּמָן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/31"/>לְבוּשָׁהּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/23"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/32"/>נוֹדָע בַּשְּׁ֒עָרִים בַּעְלָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/33"/>בְּשִׁבְתּוֹ עִם־זִקְנֵי־אָֽרֶץ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/24"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/34"/>סָדִין עָשְׂ֒תָה וַתִּמְכֹּר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/35"/>וַחֲגוֹר נָתְ֒נָה לַכְּנַעֲנִי:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/25"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/36"/>עוֹז־וְהָדָר לְבוּשָׁהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/37"/>וַתִּשְׂחַק לְיוֹם אַחֲרוֹן:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/26"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/38"/>פִּֽיהָ פָּתְ֒חָה בְחָכְמָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/39"/>וְתוֹרַת־חֶֽסֶד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/40"/>עַל־לְשׁוֹנָהּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/27"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/41"/>צוֹפִיָּה הֲלִיכוֹת בֵּיתָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/42"/>וְלֶֽחֶם עַצְלוּת לֹא תֹאכֵל:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/28"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/43"/>קָֽמוּ בָנֶֽיהָ וַיְאַשְּׁ֒רֽוּהָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/44"/>בַּעְלָהּ וַיְהַלְ֒לָהּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/29"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/45"/>רַבּוֹת בָּנוֹת עָֽשׂוּ חָֽיִל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/46"/>וְאַתְּ עָלִית עַל־כֻּלָּֽנָה:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/30"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/47"/>שֶֽׁקֶר הַחֵן וְהֶֽבֶל הַיֹּֽפִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/48"/>אִשָּׁה יִרְאַת־יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/49"/>הִיא תִתְהַלָּל:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/31/31"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/50"/>תְּנוּ־לָהּ מִפְּ֒רִי יָדֶֽיהָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:proverbs/31/10-31/51"/>וִיהַלְ֒לֽוּהָ בַשְּׁ֒עָרִים מַעֲשֶֽׂיהָ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>