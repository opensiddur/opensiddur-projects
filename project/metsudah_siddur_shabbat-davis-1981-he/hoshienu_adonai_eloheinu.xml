  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hoshienu_adonai_eloheinu">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/106/47"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshienu_adonai_eloheinu/1"/>הֽוֹשִׁיעֵֽנוּ יְהֹוָה אֱלֹהֵֽינוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshienu_adonai_eloheinu/2"/>וְקַבְּ֒צֵֽנוּ מִן־הַגּוֹיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshienu_adonai_eloheinu/3"/>לְהוֹדוֹת לְשֵׁם קָדְשֶֽׁךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshienu_adonai_eloheinu/4"/>לְהִשְׁתַּבֵּֽחַ בִּתְ֒הִלָּתֶֽךָ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/106/48"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshienu_adonai_eloheinu/5"/>בָּרוּךְ יְהֹוָה אֱלֹהֵי יִשְׂרָאֵל,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshienu_adonai_eloheinu/6"/>מִן־הָֽעוֹלָם וְעַד הָֽעוֹלָם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshienu_adonai_eloheinu/7"/>וְאָמַר כָּל־הָעָם אָמֵן, הַֽלְ֒לוּיָהּ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshienu_adonai_eloheinu/8"/>כֹּל הַנְּ֒שָׁמָה תְּהַלֵּל יָהּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshienu_adonai_eloheinu/9"/>הַֽלְ֒לוּיָהּ:</tei:p>
      </tei:div>
