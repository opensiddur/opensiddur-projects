    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/92">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/1"/>מִזְמוֹר שִׁיר לְיוֹם הַשַּׁבָּת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/2"/>טוֹב לְהֹדוֹת לַיהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/3"/>וּלְזַמֵּר לְשִׁמְךָ עֶלְיוֹן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/4"/>לְהַגִּיד בַּבֹּֽקֶר חַסְדֶּֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/5"/>וֶאֱמוּנָתְךָ בַּלֵּילוֹת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/6"/>עֲלֵי־עָשׂוֹר וַעֲלֵי־נָֽבֶל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/7"/>עֲלֵי הִגָּיוֹן בְּכִנּוֹר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/8"/>כִּי שִׂמַּחְתַּֽנִי יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/9"/>בְּפָעֳלֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/10"/>בְּמַעֲשֵׂי יָדֶֽיךָ אֲרַנֵּן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/11"/>מַה־גָּדְלוּ מַעֲשֶֽׂיךָ יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/12"/>מְאֹד עָמְקוּ מַחְשְׁבֹתֶֽיךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/13"/>אִישׁ־בַּֽעַר לֹא יֵדָע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/14"/>וּכְסִיל לֹא־יָבִין אֶת־זֹאת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/15"/>בִּפְרֹֽחַ רְשָׁעִים כְּמוֹ עֵֽשֶׂב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/16"/>וַיָּצִֽיצוּ כָּל־פֹּֽעֲלֵי אָֽוֶן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/17"/>לְהִשָּׁמְדָם עֲדֵי־עַד:
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:bible:psalms/92/shabbat_shacharit_amidah"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/39"/>וְאַתָּה מָרוֹם לְעֹלָם יְהֹוָה:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:bible:psalms/92/shabbat_shacharit_amidah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/18"/>וְאַתָּה מָרוֹם לְעֹלָם
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:bible:psalms/92/shabbat_shacharit_amidah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/19"/>יְהֹוָה:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/20"/>כִּי הִנֵּה אֹיְבֶֽיךָ יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/21"/>כִּי־הִנֵּה אֹיְבֶֽיךָ יֹאבֵֽדוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/22"/>יִתְפָּרְדוּ כָּל־פֹּֽעֲלֵי אָֽוֶן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/23"/>וַתָּֽרֶם כִּרְאֵים קַרְנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/24"/>בַּלֹּתִי בְּשֶֽׁמֶן רַעֲנָן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/25"/>וַתַּבֵּט עֵינִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/26"/>בְּשׁוּרָי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/27"/>בַּקָּמִים עָלַי מְרֵעִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/28"/>תִּשְׁמַֽעְנָה אָזְנָי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/29"/>צַדִּיק כַּתָּמָר יִפְרָח
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/30"/>כְּאֶֽרֶז בַּלְּבָנוֹן יִשְׂגֶּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/31"/>שְׁתוּלִים בְּבֵית יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/32"/>בְּחַצְרוֹת אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/33"/>יַפְרִֽיחוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/34"/>עוֹד יְנוּבוּן בְּשֵׂיבָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/35"/>דְּשֵׁנִים וְרַעֲנַנִּים יִהְיוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/36"/>לְהַגִּיד כִּי־יָשָׁר יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/37"/>צוּרִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/92/38"/>וְלֹא־עַוְלָֽתָה בּוֹ:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
