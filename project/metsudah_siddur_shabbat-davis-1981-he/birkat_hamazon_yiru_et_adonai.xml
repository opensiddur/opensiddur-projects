      <tei:div corresp="urn:x-opensiddur:text:prayer:birkat_hamazon/yiru_et_adonai">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/34/10"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/yiru_et_adonai/1"/>יְראוּ אֶת יְהֹוָה קְדוֹשָׁיו,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/yiru_et_adonai/2"/>כִּי אֵין מַחְסוֹר לִירֵאָיו:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/34/11"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/yiru_et_adonai/3"/>כְּפִירִים רָשׁוּ וְרָעֵֽבוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/yiru_et_adonai/4"/>וְדוֹרְ֒שֵׁי יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/yiru_et_adonai/5"/>לֹא יַחְסְ֒רוּ כָל טוֹב:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/yiru_et_adonai/6"/>הוֹדוּ לַיהֹוָה כִּי טוֹב,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/yiru_et_adonai/7"/>כִּי לְעוֹלָם חַסְדּוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/yiru_et_adonai/8"/>פּוֹתֵֽחַ אֶת יָדֶֽךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/yiru_et_adonai/9"/>וּמַשְׂבִּֽיעַ לְכָל חַי רָצוֹן:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:jeremiah/17/7"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/yiru_et_adonai/18"/>בָּרוּךְ הַגֶּֽבֶר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/yiru_et_adonai/10"/>אֲשֶׁר יִבְטַח בַּיהֹוָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/yiru_et_adonai/11"/>וְהָיָה יְהֹוָה מִבְטַחוֹ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/37/25"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/yiru_et_adonai/12"/>נַֽעַר הָיִֽיתִי גַם זָקַֽנְתִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/yiru_et_adonai/13"/>וְלֹא רָאִֽיתִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/yiru_et_adonai/14"/>צַדִּיק נֶעֱזָב,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/yiru_et_adonai/15"/>וְזַרְעוֹ מְבַקֵּשׁ לָֽחֶם:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/29/11"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/yiru_et_adonai/16"/>יְהֹוָה עוֹז לְעַמּוֹ יִתֵּן,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/yiru_et_adonai/17"/>יְהֹוָה יְבָרֵךְ אֶת עַמּוֹ בַּשָּׁלוֹם:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
