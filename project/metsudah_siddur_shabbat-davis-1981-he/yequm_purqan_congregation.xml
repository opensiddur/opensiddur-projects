      <tei:div corresp="urn:x-opensiddur:text:prayer:yequm_purqan/congregation">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yequm_purqan/congregation/1"/>יְקוּם פֻּרְקָן מִן שְׁמַיָּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yequm_purqan/congregation/2"/>חִנָּא וְחִסְדָּא וְרַחֲמֵי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yequm_purqan/congregation/3"/>וְחַיֵּי אֲרִיכֵי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yequm_purqan/congregation/4"/>וּמְזוֹנֵי רְוִיחֵי וְסִיַּעְתָּא דִשְׁמַיָּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yequm_purqan/congregation/5"/>וּבַרְיוּת גּוּפָא וּנְהוֹרָא מַעַלְיָא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yequm_purqan/congregation/6"/>זַרְעָא חַיָּא וְקַיָּמָא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yequm_purqan/congregation/7"/>זַרְעָא דִּי לָא יִפְסוֹק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yequm_purqan/congregation/8"/>וְדִי לָא יִבְטוֹל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yequm_purqan/congregation/9"/>מִפִּתְגָּמֵי אוֹרַיְתָא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yequm_purqan/congregation/10"/>לְמָרָנָן וְרַבָּנָן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yequm_purqan/congregation/11"/>חֲבוּרָתָא קַדִּישָׁתָא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yequm_purqan/congregation/12"/>דִּי בְאַרְעָא דְיִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yequm_purqan/congregation/13"/>וְדִי בְּבָבֶל.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yequm_purqan/congregation/14"/>לְרֵישֵׁי כַלֵּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yequm_purqan/congregation/15"/>וּלְרֵישֵׁי גַלְוָתָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yequm_purqan/congregation/16"/>וּלְרֵישֵׁי מְתִיבָתָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yequm_purqan/congregation/17"/>וּלְדַיָּנֵי דִי בָבָא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yequm_purqan/congregation/18"/>לְכָל תַּלְמִידֵיהוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yequm_purqan/congregation/19"/>וּלְכָל תַּלְמִידֵי תַלְמִידֵיהוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yequm_purqan/congregation/20"/>וּלְכָל מָאן דְּעָסְקִין
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yequm_purqan/congregation/21"/>בְּאוֹרַיְתָא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yequm_purqan/congregation/22"/>מַלְכָּא דְעָלְמָא יְבָרֵךְ יַתְהוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yequm_purqan/congregation/23"/>יַפִּישׁ חַיֵּיהוֹן וְיַסְגֵּא יוֹמֵיהוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yequm_purqan/congregation/24"/>וְיִתֵּן אַרְכָּא לִשְׁנֵיהוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yequm_purqan/congregation/25"/>וְיִתְפָּרְ֒קוּן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yequm_purqan/congregation/26"/>וְיִשְׁתֵּזְ֒בוּן מִן כָּל עָקָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yequm_purqan/congregation/27"/>וּמִן כָּל מַרְעִין בִּישִׁין.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yequm_purqan/congregation/28"/>מָרָן דִּי בִשְׁמַיָּא יְהֵא בְסַעְדְּ֒הוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yequm_purqan/congregation/29"/>כָּל זְמַן וְעִדָּן.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yequm_purqan/congregation/30"/>וְנֹאמַר אָמֵן:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
