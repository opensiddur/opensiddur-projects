      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/david">
        <tei:head xml:lang="he">מלכות בית דוד</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/david/1"/>אֶת צֶֽמַח דָּוִד עַבְדְּ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/david/2"/>מְהֵרָה תַצְמִֽיחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/david/3"/>וְקַרְנוֹ תָּרוּם בִּישׁוּעָתֶֽךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/david/4"/>כִּי לִישׁוּעָתְ֒ךָ קִוִּֽינוּ כָּל הַיּוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/david/5"/>וּמְ֒צַפִּים לִישׁוּעָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/david/6"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/david/7"/>מַצְמִֽיחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/david/8"/>קֶֽרֶן יְשׁוּעָה:</tei:p>
