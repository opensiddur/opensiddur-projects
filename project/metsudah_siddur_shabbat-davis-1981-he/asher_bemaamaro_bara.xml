      <tei:div corresp="urn:x-opensiddur:text:prayer:asher_bemaamaro_bara">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/1"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/2"/>אֱלֹהֵֽינוּ מֶֽלֶךְ הָעוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/3"/>אֲשֶׁר בְּמַאֲמָרוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/4"/>בָּרָא שְׁחָקִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/5"/>וּבְרֽוּחַ פִּיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/6"/>כָּל־צְבָאָם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/7"/>חֹק וּזְמַן נָתַן לָהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/8"/>שֶׁלֹּא יְשַׁנּוּ אֶת־תַּפְקִידָם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/9"/>שָׂשִׂים וּשְׂמֵחִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/10"/>לַעֲשׂוֹת רְצוֹן קוֹנָם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/11"/>פּוֹעֵל אֱמֶת שֶׁפְּ֒עֻלָּתוֹ אֱמֶת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/12"/>וְלַלְּ֒בָנָה אָמַר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/13"/>שֶׁתִּתְחַדֵּשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/14"/>עֲטֶֽרֶת תִּפְאֶֽרֶת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/15"/>לַעֲמֽוּסֵי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/16"/>בָֽטֶן.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/17"/>שֶׁהֵם עֲתִידִים לְהִתְחַדֵּשׁ כְּמוֹתָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/18"/>וּלְפָאֵר לְיוֹצְ֒רָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/19"/>עַל שֵׁם כְּבוֹד מַלְכוּתוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/20"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/21"/>מְחַדֵּשׁ חֳדָשִׁים:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/22"/>בָּרוּךְ יוֹצְ֒רֵךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/23"/>בָּרוּךְ עוֹשֵׂךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/24"/>בָּרוּךְ קוֹנֵךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/25"/>בָּרוּךְ בּוֹרְ֒אֵךְ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/26"/>כְּשֵׁם שֶׁאֲנִי רוֹקֵד כְּנֶגְדֵּךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/27"/>וְאֵינִי יָכוֹל לִנְגֽוֹעַ בָּךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/28"/>כַּךְ לֹא יוּכְ֒לוּ כָּל אוֹיְ֒בַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/29"/>לִנְגֽוֹעַ בִּי לְרָעָה:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/30"/>תִּפֹּל עֲלֵיהֶם אֵימָֽתָה וָפַֽחַד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/31"/>בִּגְדֹל זְרוֹעֲךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/32"/>יִדְּ֒מוּ כָּאָֽבֶן:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/33"/>כָּאָֽבֶן יִדְּ֒מוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/34"/>זְרוֹעֲךָ בִּגְדֹל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/35"/>וָפַֽחַד אֵימָֽתָה עֲלֵיהֶם תִּפֹּל:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/36"/>דָּוִד מֶֽלֶךְ יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/37"/>חַי וְקַיָּם:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/38"/>שָׁלוֹם עֲלֵיכֶם:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/39"/>עֲלֵיכֶם שָׁלוֹם:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/40"/>סִמָּן טוֹב וּמַזָּל טוֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/41"/>יִהְיֶה לָֽנוּ וּלְכָל יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/42"/>אָמֵן:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:song_of_songs/2/8"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/43"/>קוֹל דּוֹדִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/44"/>הִנֵּה זֶה בָּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/45"/>מְדַלֵּג עַל הֶהָרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/46"/>מְקַפֵּץ עַל הַגְּ֒בָעוֹת:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:song_of_songs/2/9"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/47"/>דּוֹמֶה דוֹדִי לִצְבִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/48"/>אוֹ לְעֹֽפֶר הָאַיָּלִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/49"/>הִנֵּה זֶה עוֹמֵד אַחַר כָּתְלֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/50"/>מַשְׁגִּֽיחַ מִן הַחַלּוֹנוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_bemaamaro_bara/51"/>מֵצִיץ מִן הַחֲרַכִּים:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
