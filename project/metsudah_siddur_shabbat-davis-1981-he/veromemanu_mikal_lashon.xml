    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:veromemanu_mikal_lashon">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/1"/>וְרוֹמְ֒מָֽנוּ מִכָּל לָשׁוֹן,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/2"/>וְקִדְּ֒שָֽׁנוּ בְּמִצְוֹתָיו.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/3"/>וַתִּתֶּן לָֽנוּ יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/4"/>בְּאַהֲבָה.
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/5"/>(שַׁבָּתוֹת לִמְנוּחָה וּ)
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/6"/>מוֹעֲדִים לְשִׂמְחָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/7"/>חַגִּים וּזְמַנִּים לְשָׂשׂוֹן.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/8"/>אֶת יוֹם
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/9"/>הַשַּׁבָּת הַזֶּה וְאֶת יוֹם
<tei:milestone unit="phrase"/>
<j:conditional xml:id="when_1"><tei:fs type="opensiddur:holiday"><tei:f name="pesah"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/10"/>חַג הַמַּצּוֹת הַזֶּה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/11"/>זְמַן חֵרוּתֵֽנוּ
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_1"/>
<j:conditional xml:id="when_2"><tei:fs type="opensiddur:holiday"><tei:f name="shavuot"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/12"/>חַג הַשָּׁבוּעוֹת הַזֶּה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/13"/>זְמַן מַתַּן תּוֹרָתֵֽנוּ
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_2"/>
<j:conditional xml:id="when_3"><tei:fs type="opensiddur:holiday"><tei:f name="sukkot"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/14"/>חַג הַסֻּכּוֹת הַזֶּה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/15"/>זְמַן שִׂמְחָתֵֽנוּ
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_3"/>
<tei:note type="instruction" xml:lang="he">לשמיני עצרת ולש"ת</tei:note>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/16"/>שְׁמִינִי חַג הָעֲצֶֽרֶת הַזֶּה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/17"/>זְמַן שִׂמְחָתֵֽנוּ
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/18"/>(בְּאַהֲבָה)
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/19"/>מִקְרָא קֹֽדֶשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/20"/>זֵֽכֶר לִיצִיאַת מִצְרָֽיִם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/21"/>כִּי בָֽנוּ בָחַֽרְתָּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/22"/>וְאוֹתָֽנוּ קִדַּֽשְׁתָּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/23"/>מִכָּל־הָעַמִּים.
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/24"/>(וְשַׁבָּת)
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/25"/>וּמוֹעֲדֵי קָדְשֶֽׁךָ
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/26"/>(בְּאַהֲבָה וּבְרָצוֹן)
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/27"/>בְּשִׂמְחָה וּבְשָׂשׂוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/28"/>הִנְחַלְתָּֽנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/29"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/30"/>מְקַדֵּשׁ
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/31"/>(הַשַּׁבָּת וְ)
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/32"/>יִשְׂרָאֵל וְהַזְּ֒מַנִּים:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
