      <tei:div corresp="urn:x-opensiddur:text:poem:kol_meqaddesh/3">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/3/1"/>דּוֹרְ֒שֵׁי יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/3/2"/>זֶֽרַע אַבְרָהָם אוֹהֲבוֹ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/3/3"/>הַמְאַחֲרִים לָצֵאת מִן הַשַּׁבָּת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/3/4"/>וּמְמַהֲרִים לָבֹא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/3/5"/>שְׂמֵחִים לְשָׁמְרוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/3/6"/>וּלְעָרֵב עֵרוּבוֹ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/118/24"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/3/7"/>זֶה הַיּוֹם עָשָׂה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/3/8"/>נָגִֽילָה וְנִשְׂמְ֒חָה בוֹ.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
