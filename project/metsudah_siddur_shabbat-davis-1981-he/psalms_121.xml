      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/121">
        <tei:head xml:lang="he">תהלים קכא</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/121/1"/>שִׁיר לַמַּעֲלוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/121/2"/>אֶשָּׂא עֵינַי אֶל־הֶהָרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/121/3"/>מֵאַֽיִן יָבֹא עֶזְרִי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/121/4"/>עֶזְרִי מֵעִם יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/121/5"/>עֹשֵׂה שָׁמַֽיִם וָאָֽרֶץ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/121/6"/>אַל־יִתֵּן לַמּוֹט רַגְלֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/121/7"/>אַל־יָנוּם שֹׁמְרֶֽךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/121/8"/>הִנֵּה לֹא־יָנוּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/121/9"/>וְלֹא יִישָׁן שׁוֹמֵר יִשְׂרָאֵל:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/121/10"/>יְהֹוָה שֹׁמְרֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/121/11"/>יְהֹוָה צִלְּךָ עַל־יַד יְמִינֶֽךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/121/12"/>יוֹמָם הַשֶּֽׁמֶשׁ לֹא־יַכֶּֽכָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/121/13"/>וְיָרֵֽחַ בַּלָּֽיְלָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/121/14"/>❖יְהֹוָה יִשְׁמָרְךָ מִכָּל־רָע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/121/15"/>יִשְׁמֹר אֶת־נַפְשֶֽׁךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/121/16"/>יְהֹוָה יִשְׁמָר־צֵאתְךָ וּבוֹאֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/121/17"/>מֵעַתָּה וְעַד־עוֹלָם:</tei:p>
      </tei:div>
