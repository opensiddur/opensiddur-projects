  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:shabbat/musaf/ashrei">
        <tei:head xml:lang="he">אשרי</tei:head>
        <j:declare xml:id="variants_1">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:ashrei/shabbat_shacharit_ashrei">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:ashrei/shabbat_musaf_ashrei">
              <tei:binary value="true"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:ashrei/shabbat_minchah_ashrei">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:ashrei"/>
        <j:endDeclare target="#variants_1"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:yehalelu_et_shem"/>
        <j:conditional xml:id="when_1">
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
        <j:declare xml:id="variants_2">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:bible:psalms/29/shabbat_musaf_ashrei">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/29"/>
        <j:endDeclare target="#variants_2"/>
        <j:endConditional target="#when_1"/>
        <j:conditional xml:id="when_2">
          <j:all>
            <tei:fs type="opensiddur:holiday-aggregate">
              <tei:f name="yom-tov">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
            <j:none>
              <tei:fs type="opensiddur:holiday-aggregate">
                <tei:f name="shabbat">
                  <tei:binary value="true"/>
                </tei:f>
              </tei:fs>
            </j:none>
          </j:all>
        </j:conditional>
        <j:declare xml:id="variants_3">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:bible:psalms/24/shabbat_minchah_berikh_shemeh">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/24"/>
        <j:endDeclare target="#variants_3"/>
        <j:endConditional target="#when_2"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:uvenuchoh_yomar_shuvah"/>
      </tei:div>
