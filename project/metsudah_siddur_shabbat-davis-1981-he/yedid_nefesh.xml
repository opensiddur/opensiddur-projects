    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:yedid_nefesh">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yedid_nefesh/1"/>יְדִיד נֶֽפֶשׁ אָב הָרַחֲמָן.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yedid_nefesh/2"/>מְשׁוֹךְ עַבְדְּ֒ךָ אֶל רְצוֹנֶֽךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yedid_nefesh/3"/>יָרוּץ עַבְדְּ֒ךָ כְּמוֹ אַיָּל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yedid_nefesh/4"/>יִשְׁתַּחֲוֶה אֶל מוּל הֲדָרֶֽךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yedid_nefesh/5"/>יֶעֱרַב לוֹ יְדִידוֹתֶֽיךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yedid_nefesh/6"/>מִנֹּֽפֶת צוּף
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yedid_nefesh/7"/>וְכָל טָֽעַם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yedid_nefesh/8"/>הָדוּר נָאֶה זִיו הָעוֹלָם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yedid_nefesh/9"/>נַפְשִׁי חוֹלַת אַהֲבָתֶֽךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yedid_nefesh/10"/>אָֽנָּא אֵל נָא רְפָא נָא לָהּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yedid_nefesh/11"/>בְּהַרְאוֹת לָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yedid_nefesh/12"/>נֹֽעַם זִיוֶֽךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yedid_nefesh/13"/>אָז תִּתְחַזֵּק וְתִתְרַפֵּא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yedid_nefesh/14"/>וְהָיְ֒תָה לָהּ שִׂמְחַת עוֹלָם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yedid_nefesh/15"/>וָתִיק יֶהֱמוּ נָא רַחֲמֶֽיךָ
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:yedid_nefesh/shabbat_seudah_shelishit"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yedid_nefesh/29"/>וְחֽוּסָה נָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yedid_nefesh/30"/>עַל בֵּן אֲהוּבֶֽךָ.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:yedid_nefesh/shabbat_seudah_shelishit"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yedid_nefesh/16"/>וְחֽוּסָה נָא עַל בֵּן אֲהוּבֶֽךָ.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yedid_nefesh/17"/>כִּי זֶה כַּמָּה נִכְסוֹף נִכְסַפְתִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yedid_nefesh/18"/>לִרְאוֹת מְהֵרָה בְּתִפְאֶֽרֶת עֻזֶּֽךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yedid_nefesh/19"/>אֵֽלֶּה חָמְ֒דָה לִבִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yedid_nefesh/20"/>וְחֽוּסָה נָא וְאַל תִּתְעַלֵּם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yedid_nefesh/21"/>הִגָּלֶה נָּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yedid_nefesh/22"/>וּפְרוֹס חֲבִיבִי עָלַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yedid_nefesh/23"/>אֶת סֻכַּת שְׁלוֹמֶֽךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yedid_nefesh/24"/>תָּאִיר אֶֽרֶץ מִכְּ֒בוֹדֶֽךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yedid_nefesh/25"/>נָגִֽילָה וְנִשְׂמְ֒חָה בָּךְ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yedid_nefesh/26"/>מַהֵר אֶהֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yedid_nefesh/27"/>כִּי בָא מוֹעֵד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yedid_nefesh/28"/>וְחָנֵּֽנוּ כִּימֵי עוֹלָם:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
