      <tei:div corresp="urn:x-opensiddur:text:prayer:adonai_mah_rabbu">
        <tei:head xml:lang="he">תהלים ג:ב–ט</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_mah_rabbu/1"/>יְהֹוָה מָה־רַבּוּ צָרָי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_mah_rabbu/2"/>רַבִּים קָמִים עָלָי:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/3/3"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_mah_rabbu/3"/>רַבִּים אֹמְ֒רִים לְנַפְשִׁי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_mah_rabbu/4"/>אֵין יְשׁוּעָֽתָה לוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_mah_rabbu/5"/>בֵאלֹהִים סֶֽלָה:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/3/4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_mah_rabbu/6"/>וְאַתָּה יְהֹוָה מָגֵן בַּעֲדִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_mah_rabbu/7"/>כְּבוֹדִי וּמֵרִים רֹאשִׁי:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/3/5"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_mah_rabbu/8"/>קוֹלִי אֶל־יְהֹוָה אֶקְרָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_mah_rabbu/9"/>וַיַּעֲנֵֽנִי מֵהַר קָדְשׁוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_mah_rabbu/10"/>סֶֽלָה:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_mah_rabbu/11"/>אֲנִי שָׁכַֽבְתִּי וָאִישָֽׁנָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_mah_rabbu/12"/>הֱקִיצֽוֹתִי כִּי יְהֹוָה יִסְמְ֒כֵֽנִי:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/3/7"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_mah_rabbu/13"/>לֹא אִירָא מֵרִבְבוֹת עָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_mah_rabbu/14"/>אֲשֶׁר סָבִיב שָֽׁתוּ עָלָי:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/3/8"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_mah_rabbu/15"/>קוּמָה יְהֹוָה הוֹשִׁיעֵֽנִי אֱלֹהַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_mah_rabbu/16"/>כִּי־הִכִּֽיתָ אֶת־כָּל אֹיְ֒בַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_mah_rabbu/17"/>לֶֽחִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_mah_rabbu/18"/>שִׁנֵּי רְשָׁעִים שִׁבַּֽרְתָּ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_mah_rabbu/19"/>לַיהֹוָה הַיְ֒שׁוּעָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_mah_rabbu/20"/>עַל־עַמְּ֒ךָ בִרְכָתֶֽךָ סֶֽלָה:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
