      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/95">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/1"/>לְכוּ נְרַנְּנָה לַיהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/2"/>נָרִֽיעָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/3"/>לְצוּר יִשְׁעֵֽנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/4"/>נְקַדְּמָה פָנָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/5"/>בְּתוֹדָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/6"/>בִּזְמִרוֹת נָרִֽיעַ לוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/7"/>כִּי אֵל גָּדוֹל יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/8"/>וּמֶֽלֶךְ גָּדוֹל עַל־כָּל־אֱלֹהִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/9"/>אֲשֶׁר בְּיָדוֹ מֶחְקְרֵי־אָֽרֶץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/10"/>וְתוֹעֲפוֹת הָרִים לוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/11"/>אֲשֶׁר־לוֹ הַיָּם וְהוּא עָשָֽׂהוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/12"/>וְיַבֶּֽשֶׁת יָדָיו יָצָֽרוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/13"/>בֹּֽאוּ נִשְׁתַּחֲוֶה וְנִכְרָֽעָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/14"/>נִבְרְכָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/15"/>לִפְנֵי־יְהֹוָה עֹשֵֽׂנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/16"/>כִּי הוּא אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/17"/>וַאֲנַֽחְנוּ עַם מַרְעִיתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/18"/>וְצֹאן יָדוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/19"/>הַיּוֹם אִם־בְּקֹלוֹ תִשְׁמָֽעוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/20"/>אַל־תַּקְשׁוּ לְבַבְכֶם כִּמְרִיבָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/21"/>כְּיוֹם מַסָּה בַּמִּדְבָּר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/22"/>אֲשֶׁר נִסּֽוּנִי אֲבוֹתֵיכֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/23"/>בְּחָנֽוּנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/24"/>גַּם־רָאוּ פָעֳלִי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/25"/>אַרְבָּעִים שָׁנָה אָקוּט בְּדוֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/26"/>וָאֹמַר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/27"/>עַם תֹּעֵי לֵבָב הֵם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/28"/>וְהֵם לֹא־יָדְעוּ דְרָכָי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/29"/>אֲשֶׁר־נִשְׁבַּֽעְתִּי בְאַפִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/30"/>אִם־יְבֹאוּן אֶל־מְנוּחָתִי:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
