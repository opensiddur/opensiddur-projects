      <tei:div corresp="urn:x-opensiddur:text:prayer:berikh_shemeh/berikh">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/1"/>בְּרִיךְ שְׁמֵהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/2"/>דְּמָרֵא עָלְמָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/3"/>בְּרִיךְ כִּתְרָךְ וְאַתְרָךְ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/4"/>יְהֵא רְעוּתָךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/5"/>עִם עַמָּךְ יִשְׂרָאֵל לְעָלָם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/6"/>וּפֻרְקַן יְמִינָךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/7"/>אַחֲזֵי לְעַמָּךְ בְּבֵית מַקְדְּ֒שָׁךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/8"/>וּלְאַמְטוּיֵי לָנָא מִטּוּב נְהוֹרָךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/9"/>וּלְקַבֵּל צְלוֹתָנָא בְּרַחֲמִין.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/10"/>יְהֵא רַעֲוָא קֳדָמָךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/11"/>דְּתוֹרִיךְ לָן חַיִּין בְּטִיבוּתָא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/12"/>וְלֶהֱוֵי אֲנָא פְקִידָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/13"/>בְּגוֹ צַדִּיקַיָּא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/14"/>לְמִרְחַם עָלַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/15"/>וּלְמִנְטַר יָתִי וְיַת כָּל דִּי לִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/16"/>וְדִי לְעַמָּךְ יִשְׂרָאֵל.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/17"/>אַנְתְּ הוּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/18"/>זָן לְכֹלָּא וּמְפַרְנֵס לְכֹלָּא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/19"/>אַנְתְּ הוּא שַׁלִּיט עַל כֹּלָּא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/20"/>אַנְתְּ הוּא דְּשַׁלִּיט עַל מַלְכַיָּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/21"/>וּמַלְכוּתָא דִּילָךְ הִיא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/22"/>אֲנָא עַבְדָּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/23"/>דְקֻדְשָׁא בְּרִיךְ הוּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/24"/>דְּסָגִידְנָא קַמֵּהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/25"/>וּמִקַּמֵּהּ דִּיקַר אוֹרַיְתֵהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/26"/>בְּכָל עִדָּן וְעִדָּן.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/27"/>לָא עַל אֱנָשׁ רָחִיצְנָא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/28"/>וְלָא עַל בַּר אֱלָהִין סָמִיכְנָא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/29"/>אֶלָּא בֶּאֱלָהָא דִשְׁמַיָּא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/30"/>דְּהוּא אֱלָהָא קְשׁוֹט.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/31"/>וְאוֹרַיְתֵהּ קְשׁוֹט.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/32"/>וּנְבִיאוֹהִי קְשׁוֹט.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/33"/>וּמַסְגֵּא לְמֶעְבַּד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/34"/>טַבְוָן וּקְשׁוֹט.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/35"/>בֵּהּ אֲנָא רָחִיץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/36"/>וְלִשְׁמֵהּ קַדִּישָׁא יַקִּירָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/37"/>אֲנָא אֵמַר תֻּשְׁבְּחָן.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/38"/>יְהֵא רַעֲוָא קֳדָמָךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/39"/>דְּתִפְתַּח לִבָּאִי בְּאוֹרַיְתָא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/40"/>❖וְתַשְׁלִים מִשְׁאֲלִין דְּלִבָּאִי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/41"/>וְלִבָּא דְכָל עַמָּךְ יִשְׂרָאֵל.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:berikh_shemeh/berikh/42"/>לְטַב וּלְחַיִּין וְלִשְׁלָם:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
