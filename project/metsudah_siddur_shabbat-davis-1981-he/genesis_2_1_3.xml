    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:genesis/2/1-3">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:genesis/2/1-3/1"/>וַיְכֻלּוּ הַשָּׁמַֽיִם וְהָאָֽרֶץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:genesis/2/1-3/2"/>וְכָל־צְבָאָם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:genesis/2/1-3/3"/>וַיְכַל אֱלֹהִים בַּיּוֹם הַשְּׁ֒בִיעִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:genesis/2/1-3/4"/>מְלַאכְתּוֹ אֲשֶׁר עָשָׂה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:genesis/2/1-3/5"/>וַיִּשְׁבֹּת בַּיּוֹם הַשְּׁ֒בִיעִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:genesis/2/1-3/6"/>מִכָּל־מְלַאכְתּוֹ אֲשֶׁר עָשָׂה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:genesis/2/1-3/7"/>וַיְבָֽרֶךְ אֱלֹהִים אֶת־יוֹם הַשְּׁ֒בִיעִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:genesis/2/1-3/8"/>וַיְקַדֵּשׁ אֹתוֹ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:genesis/2/1-3/9"/>כִּי בוֹ שָׁבַת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:genesis/2/1-3/10"/>מִכָּל־מְלַאכְתּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:genesis/2/1-3/11"/>אֲשֶׁר־בָּרָא אֱלֹהִים לַעֲשׂוֹת:</tei:p>
