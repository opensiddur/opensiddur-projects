      <tei:div corresp="urn:x-opensiddur:text:prayer:birkat_hachodesh/mi_sheasah">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hachodesh/mi_sheasah/1"/>מִי שֶׁעָשָׂה נִסִּים לַאֲבוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hachodesh/mi_sheasah/2"/>וְגָאַל אוֹתָם מֵעַבְדוּת לְחֵרוּת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hachodesh/mi_sheasah/3"/>הוּא יִגְאַל אוֹתָֽנוּ בְּקָרוֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hachodesh/mi_sheasah/4"/>וִיקַבֵּץ נִדָּחֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hachodesh/mi_sheasah/5"/>מֵאַרְבַּע כַּנְפוֹת הָאָֽרֶץ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hachodesh/mi_sheasah/6"/>חֲבֵרִים כָּל יִשְׂרָאֵל.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hachodesh/mi_sheasah/7"/>וְנֹאמַר אָמֵן:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
