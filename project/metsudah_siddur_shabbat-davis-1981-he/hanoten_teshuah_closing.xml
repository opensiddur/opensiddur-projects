      <tei:div corresp="urn:x-opensiddur:text:prayer:hanoten_teshuah/closing">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/closing/1"/>מֶֽלֶךְ מַלְכֵי הַמְּ֒לָכִים בְּרַֽחֲמָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/closing/2"/>יְחַיֵּם וְיִשְׁמְ֒רֵם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/closing/3"/>וּמִכָּל צָרָה וְיָגוֹן וָנֶֽזֶק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/closing/4"/>יַצִּילֵם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/closing/5"/>מֶֽלֶךְ מַלְכֵי הַמְּ֒לָכִים בְּרַֽחֲמָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/closing/6"/>יִתֵּן בְּלִבָּם רַחֲמָנוּת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/closing/7"/>לַעֲשׂוֹת טוֹבוֹת עִמָּֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/closing/8"/>וְעִם כָּל־יִשְׂרָאֵל.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/closing/9"/>בִּימֵיהֶם וּבְיָמֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/closing/10"/>תִּוָּשַׁע יְהוּדָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/closing/11"/>וְיִשְׂרָאֵל יִשְׁכֹּן לָבֶֽטַח.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/closing/12"/>וּבָא לְצִיּוֹן גּוֹאֵל.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/closing/13"/>וְכֵן יְהִי רָצוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/closing/14"/>וְנֹאמַר אָמֵן:</tei:p>
