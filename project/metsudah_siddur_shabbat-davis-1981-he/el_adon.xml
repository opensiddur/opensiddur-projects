      <tei:div corresp="urn:x-opensiddur:text:poem:el_adon">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/1"/>אֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/2"/>אָדוֹן עַל כָּל הַמַּעֲשִׂים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/3"/>בָּרוּךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/4"/>וּמְבֹרָךְ בְּפִי כָּל הַנְּשָׁמָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/5"/>גָּדְלוֹ וְטוּבוֹ מָלֵא עוֹלָם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/6"/>דַּֽעַת וּתְבוּנָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/7"/>סוֹבְ֒בִים הוֹדוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/8"/>הַמִּתְגָּאֶה עַל חַיּוֹת הַקֹּֽדֶשׁ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/9"/>וְנֶהְדָּר בְּכָבוֹד עַל הַמֶּרְכָּבָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/10"/>זְכוּת וּמִישׁוֹר לִפְנֵי כִסְאוֹ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/11"/>חֶֽסֶד וְרַחֲמִים מָלֵא כְבוֹדוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/12"/>טוֹבִים מְאוֹרוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/13"/>שֶׁבָּרָא אֱלֹהֵֽינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/14"/>יְצָרָם בְּדַֽעַת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/15"/>בְּבִינָה וּבְהַשְׂכֵּל.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/16"/>כֹּֽחַ וּגְבוּרָה נָתַן בָּהֶם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/17"/>לִהְיוֹת מוֹשְׁ֒לִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/18"/>בְּקֶֽרֶב תֵּבֵל:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/19"/>מְלֵאִים זִיו וּמְפִיקִים נֹֽגַהּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/20"/>נָאֶה זִיוָם בְּכָל הָעוֹלָם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/21"/>שְׂמֵחִים בְּצֵאתָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/22"/>וְשָׂשִׂים בְּבוֹאָם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/23"/>עוֹשִׂים בְּאֵימָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/24"/>רְצוֹן קוֹנָם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/25"/>פְּאֵר וְכָבוֹד נוֹתְ֒נִים לִשְׁמוֹ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/26"/>צָהֳלָה וְרִנָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/27"/>לְזֵֽכֶר מַלְכוּתוֹ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/28"/>קָרָא לַשֶּֽׁמֶשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/29"/>וַיִּזְרַח אוֹר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/30"/>רָאָה וְהִתְקִין
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/31"/>צוּרַת הַלְּ֒בָנָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/32"/>שֶֽׁבַח נוֹתְ֒נִים לוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/33"/>כָּל צְבָא מָרוֹם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/34"/>תִּפְאֶֽרֶת וּגְדֻלָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_adon/35"/>שְׂרָפִים וְאוֹפַנִּים וְחַיּוֹת הַקֹּֽדֶשׁ:</tei:p>
      </tei:div>
    </tei:body>
