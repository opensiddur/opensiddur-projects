      <tei:div corresp="urn:x-opensiddur:text:prayer:hallel/yehalelukha">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/yehalelukha/1"/>יְהַלְ֒לֽוּךָ יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/yehalelukha/2"/>כָּל־מַעֲשֶֽׂיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/yehalelukha/3"/>וַחֲסִידֶֽיךָ צַדִּיקִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/yehalelukha/4"/>עוֹשֵׂי רְצוֹנֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/yehalelukha/5"/>וְכָל עַמְּ֒ךָ בֵּית יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/yehalelukha/6"/>בְּרִנָּה יוֹדוּ וִיבָרְ֒כוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/yehalelukha/7"/>וִישַׁבְּ֒חוּ וִיפָאֲרוּ וִישׁוֹרְרוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/yehalelukha/8"/>וִירוֹמְ֒מוּ וְיַעֲרִֽיצוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/yehalelukha/9"/>וְיַקְדִּֽישׁוּ וְיַמְלִֽיכוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/yehalelukha/10"/>אֶת שִׁמְךָ מַלְכֵּֽנוּ תָּמִיד.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/yehalelukha/11"/>❖כִּי לְךָ טוֹב לְהוֹדוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/yehalelukha/12"/>וּלְשִׁמְךָ נָאֶה לְזַמֵּר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/yehalelukha/13"/>כִּי מֵעוֹלָם וְעַד עוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/yehalelukha/14"/>אַתָּה אֵל.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/yehalelukha/15"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/yehalelukha/16"/>מֶֽלֶךְ מְהֻלָּל בַּתִּשְׁבָּחוֹת:</tei:p>
      </tei:div>
