    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:al_tira_mipachad">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tira_mipachad/1"/>אַל תִּירָא מִפַּֽחַד פִּתְאֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tira_mipachad/2"/>וּמִשֹּׁאַת רְשָׁעִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tira_mipachad/3"/>כִּי תָבֹא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tira_mipachad/4"/>עֻֽצוּ עֵצָה וְתֻפָר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tira_mipachad/5"/>דַּבְּ֒רוּ דָבָר וְלֹא יָקוּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tira_mipachad/6"/>כִּי עִמָּֽנוּ אֵל:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tira_mipachad/7"/>וְעַד זִקְנָה אֲנִי הוּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tira_mipachad/8"/>וְעַד שֵׂיבָה אֲנִי אֶסְבֹּל:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tira_mipachad/9"/>אֲנִי עָשִֽׂיתִי וַאֲנִי אֶשָּׂא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tira_mipachad/10"/>וַאֲנִי אֶסְבֹּל וַאֲמַלֵּט:</tei:p>
      </tei:div>
