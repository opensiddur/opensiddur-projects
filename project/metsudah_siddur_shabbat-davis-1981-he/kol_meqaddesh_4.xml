      <tei:div corresp="urn:x-opensiddur:text:poem:kol_meqaddesh/4">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/4/1"/>זִכְרוּ תּוֹרַת משֶׁה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/4/2"/>בְּמִצְוַת שַׁבָּת גְּרוּסָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/4/3"/>חֲרוּתָה לַיּוֹם הַשְּׁ֒בִיעִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/4/4"/>כְּכַלָּה בֵּין רֵעוֹתֶֽיהָ מְשֻׁבָּצָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/4/5"/>טְהוֹרִים יִירָשֽׁוּהָ וִיקַדְּ֒שֽׁוּהָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/4/6"/>בְּמַאֲמַר כָּל אֲשֶׁר עָשָׂה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/4/7"/>וַיְכַל אֱלֹהִים בַּיּוֹם הַשְּׁ֒בִיעִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/4/8"/>מְלַאכְתּוֹ אֲשֶׁר עָשָׂה.</tei:p>
