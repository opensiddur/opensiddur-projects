<j:conditional xml:id="variant_10"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:ashrei/shabbat_shacharit_ashrei"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:ashrei/shabbat_minchah_ashrei"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashrei/65"/>בְּחַיֵּיכוֹן וּבְ֒יוֹמֵיכוֹן
