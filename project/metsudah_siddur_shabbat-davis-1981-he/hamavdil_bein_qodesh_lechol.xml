      <tei:div corresp="urn:x-opensiddur:text:prayer:hamavdil_bein_qodesh_lechol">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamavdil_bein_qodesh_lechol/1"/>בָּרוּךְ אַתָּה יְהֹוָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamavdil_bein_qodesh_lechol/2"/>אֱלֹהֵֽינוּ מֶֽלֶךְ הָעוֹלָם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamavdil_bein_qodesh_lechol/3"/>הַמַּבְדִּיל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamavdil_bein_qodesh_lechol/4"/>בֵּין קֹֽדֶשׁ לְחוֹל.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamavdil_bein_qodesh_lechol/5"/>בֵּין אוֹר לְחֽשֶׁךְ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamavdil_bein_qodesh_lechol/6"/>בֵּין יִשְׂרָאֵל לָעַמִּים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamavdil_bein_qodesh_lechol/7"/>בֵּין יוֹם הַשְּׁ֒בִיעִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamavdil_bein_qodesh_lechol/8"/>לְשֵֽׁשֶׁת יְמֵי הַמַּעֲשֶׂה.
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:hamavdil_bein_qodesh_lechol/regalim_kiddush"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamavdil_bein_qodesh_lechol/9"/>בָּרוּר אַתָּה יְהֹוָה.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
