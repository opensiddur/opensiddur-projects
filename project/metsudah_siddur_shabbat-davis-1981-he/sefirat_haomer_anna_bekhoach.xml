      <tei:div corresp="urn:x-opensiddur:text:prayer:sefirat_haomer/anna_bekhoach">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/anna_bekhoach/1"/>אָֽנָּא, בְּכֹֽחַ גְּדֻלַּת יְמִינְ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/anna_bekhoach/2"/>תַּתִּיר צְרוּרָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/anna_bekhoach/3"/>קַבֵּל רִנַּת עַמְּ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/anna_bekhoach/4"/>שַׂגְּ֒בֵֽנוּ טַהֲרֵֽנוּ נוֹרָא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/anna_bekhoach/5"/>נָא גִבּוֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/anna_bekhoach/6"/>דּוֹרְ֒שֵׁי יִחוּדְ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/anna_bekhoach/7"/>כְּבָבַת שָׁמְ֒רֵם:
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:sefirat_haomer/anna_bekhoach/sefirat_haomer"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/anna_bekhoach/19"/>בָּרְכֵם טַהֲרֵם רַחֲמֵם
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:sefirat_haomer/anna_bekhoach/sefirat_haomer"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/anna_bekhoach/8"/>בָּרְ֒כֵם טַהֲרֵם
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:sefirat_haomer/anna_bekhoach/sefirat_haomer"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/anna_bekhoach/9"/>רַחֲמֵי
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/anna_bekhoach/10"/>צִדְ֒קָתְ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/anna_bekhoach/11"/>תָּמִיד גָּמְ֒לֵם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/anna_bekhoach/12"/>חֲסִין קָדוֹשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/anna_bekhoach/13"/>בְּרֹב טוּבְ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/anna_bekhoach/14"/>נַהֵל עֲדָתֶֽךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/anna_bekhoach/15"/>יָחִיד גֵּאֶה לְעַמְּ֒ךָ פְּנֵה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/anna_bekhoach/16"/>זוֹכְ֒רֵי קְדֻשָּׁתֶֽךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/anna_bekhoach/17"/>שַׁוְעָתֵֽנוּ קַבֵּל וּשְׁ֒מַע צַעֲקָתֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/anna_bekhoach/18"/>יוֹדֵֽעַ תַּעֲלוּמוֹת:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
