      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/23">
        <tei:p><j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:bible:psalms/23/shabbat_day_meal_kiddush"><tei:binary value="true"/></tei:f></tei:fs></j:conditional><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/23/22"/>מִזְמוֹר לְדָוִד. יְהֹוָה רֹעִי לֹא אֶחְסָר: בִּנְאוֹת דֶּֽשֶׁא יַרְבִּיצֵֽנִי. עַל־מֵי מְנֻחוֹת יְנַהֲלֵֽנִי: נַפְשִׁי יְשׁוֹבֵב. יַנְחֵֽנִי בְמַעְגְּ֒לֵי־צֶֽדֶק לְמַֽעַן שְׁמוֹ: גַּם כִּי־אֵלֵךְ בְּגֵיא צַלְמָֽוֶת לֹא־אִירָא רָע. כִּי־אַתָּה עִמָּדִי. שִׁבְטְ֒ךָ וּמִשְׁעַנְתֶּֽךָ הֵֽמָּה יְנַחֲמֻֽנִי: תַּעֲרֹךְ לְפָנַי שֻׁלְחָן נֶֽגֶד צֹרְרָי. דִּשַּֽׁנְתָּ בַשֶּֽׁמֶן רֹאשִׁי. כּוֹסִי רְוָיָה: אַךְ טוֹב וָחֶֽסֶד יִרְדְּ֒פֽוּנִי כָּל־יְמֵי חַיָּי. וְשַֽׁבְתִּי בְּבֵית יְהֹוָה לְאֹֽרֶךְ יָמִים:
