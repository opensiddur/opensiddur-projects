      <tei:div corresp="urn:x-opensiddur:text:prayer:kaddish/shalem">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/1"/>יִתְגַּדַּל וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/2"/>בְּעָלְ֒מָא דִּי בְרָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/3"/>כִרְ֒עוּתֵהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/4"/>וְיַמְלִיךְ מַלְ֒כוּתֵהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/83"/>וְיַצְמַח פּוּרְ֒קָנֵהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/84"/>וִיקָרֵב (קֵץ) מְשִׁיחֵהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/7"/>בְּחַיֵּיכוֹן וּבְ֒יוֹמֵיכוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/85"/>וּבְ֒חַיֵּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/9"/>דְכָל בֵּית יִשְׂרָאֵל,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/10"/>בַּעֲגָלָא וּבִזְ֒מַן קָרִיב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/11"/>וְאִמְ֒רוּ אָמֵן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/12"/>יְהֵא שְׁמֵהּ רַבָּא מְבָרַךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/13"/>לְעָלַם וּלְ֒עָלְ֒מֵי עָלְ֒מַיָּא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/14"/>יִתְבָּרַךְ וְיִשְׁתַּבַּח
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/15"/>וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְנַשֵּׂא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/16"/>וְיִתְהַדָּר וְיִתְעַלֶּה וְיִתְהַלָּל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/17"/>שְׁמֵהּ דְקוּדְשָׁא, בְּרִיךְ הוּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/86"/>לְעֵֽלָּא <j:conditional xml:id="inline_1" type="marked"><tei:note type="instruction" xml:lang="he">בעשי"ת</tei:note><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="aseret-ymei-tshuva"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>וּלְ֒עֵֽלָּא מִכָּל<j:endConditional target="#inline_1"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/19"/><j:conditional xml:id="inline_2"><j:none><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="aseret-ymei-tshuva"><tei:binary value="true"/></tei:f></tei:fs></j:none></j:conditional>מִן כָּל<j:endConditional target="#inline_2"/> בִּרְ֒כָתָא וְשִׁירָתָא,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/20"/>תֻּשְׁבְּחָתָא וְנֶחֱמָתָא,
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/shalem/shabbat_musaf_amidah"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/94"/>דַּאֲמִירָן בְּעָלְמָא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/95"/>וְאִמְרוּ אָמֵן.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/shalem/shabbat_musaf_amidah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/21"/>דַּאֲמִירָן בְּעָלְ֒מָא, וְאִמְ֒רוּ אָמֵן:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/22"/>תִּתְקַבֵּל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/23"/>צְלוֹתְ֒הוֹן וּבָעוּתְ֒הוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/24"/>דְּכָל בֵּית יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/25"/>קֳדָם אֲבוּהוֹן דִּי בִשְׁ֒מַיָּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/26"/>וְאִמְ֒רוּ אָמֵן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/27"/>יְהֵא שְׁלָמָא רַבָּא מִן שְׁמַיָּא
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/shalem/shabbat_shacharit_amidah"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/92"/>וְחַיִּים
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/shalem/shabbat_conclusion_amidah"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/97"/>וְחַיִּים
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/shalem/shabbat_shacharit_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/shalem/shabbat_conclusion_amidah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
