      <tei:div corresp="urn:x-opensiddur:text:prayer:birkat_hachodesh/yechaddeshehu">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hachodesh/yechaddeshehu/1"/>יְחַדְּ֒שֵֽׁהוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hachodesh/yechaddeshehu/2"/>הַקָּדוֹשׁ בָּרוּךְ הוּא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hachodesh/yechaddeshehu/3"/>עָלֵֽינוּ וְעַל כָּל עַמּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hachodesh/yechaddeshehu/4"/>בֵּית יִשְׂרָאֵל.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hachodesh/yechaddeshehu/5"/>לְטוֹבָה וְלִבְרָכָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hachodesh/yechaddeshehu/6"/>לְשָׂשׂוֹן וּלְשִׂמְחָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hachodesh/yechaddeshehu/7"/>לִישׁוּעָה וּלְנֶחָמָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hachodesh/yechaddeshehu/8"/>לְפַרְנָסָה טוֹבָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hachodesh/yechaddeshehu/9"/>וּלְכַלְכָּלָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hachodesh/yechaddeshehu/10"/>לְחַיִּים טוֹבִים וּלְשָׁלוֹם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hachodesh/yechaddeshehu/11"/>לִשְׁמוּעוֹת טוֹבוֹת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hachodesh/yechaddeshehu/12"/>וְלִבְשׂוֹרוֹת טוֹבוֹת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hachodesh/yechaddeshehu/13"/>וְלִגְשָׁמִים בְּעִתָּם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hachodesh/yechaddeshehu/14"/>וְלִרְפוּאָה שְׁלֵמָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hachodesh/yechaddeshehu/15"/>וְלִגְאֻלָּה קְרוֹבָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hachodesh/yechaddeshehu/16"/>וְנֹאמַר אָמֵן:</tei:p>
      </tei:div>
