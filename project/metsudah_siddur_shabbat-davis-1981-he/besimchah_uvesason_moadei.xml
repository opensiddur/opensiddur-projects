        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:besimchah_uvesason_moadei/1"/>בְּשִׂמְחָה וּבְשָׂשׂוֹן
<tei:milestone unit="phrase"/>
<j:conditional xml:id="when_1"><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:besimchah_uvesason_moadei/2"/>(שַׁבָּת וּ)
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_1"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:besimchah_uvesason_moadei/3"/>מוֹעֲדֵי קָדְשֶֽׁךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:besimchah_uvesason_moadei/4"/>וְיִשְׂמְ֒חוּ בְךָ יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:besimchah_uvesason_moadei/5"/>מְקַדְּ֒שֵׁי שְׁמֶֽךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:besimchah_uvesason_moadei/6"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:besimchah_uvesason_moadei/7"/>מְקַדֵּשׁ
<tei:milestone unit="phrase"/>
<j:conditional xml:id="when_2"><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:besimchah_uvesason_moadei/8"/>(הַשַּׁבָּת וְ)
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:besimchah_uvesason_moadei/9"/>יִשְׂרָאֵל וְהַזְּ֒מַנִּים:</tei:p>
