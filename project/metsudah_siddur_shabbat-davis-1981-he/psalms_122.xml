      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/122">
        <tei:head xml:lang="he">תהלים קכב</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/122/1"/>שִׁיר הַמַּעֲלוֹת לְדָוִד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/122/2"/>שָׂמַֽחְתִּי בְּאֹמְרִים לִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/122/3"/>בֵּית יְהֹוָה נֵלֵךְ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/122/4"/>עֹמְדוֹת הָיוּ רַגְלֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/122/5"/>בִּשְׁעָרַֽיִךְ יְרוּשָׁלָֽםִ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/122/6"/>יְרוּשָׁלַֽםִ הַבְּנוּיָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/122/7"/>כְּעִיר שֶׁחֻבְּרָה־לָּהּ יַחְדָּו:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/122/8"/>שֶׁשָּׁם עָלוּ שְׁבָטִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/122/9"/>שִׁבְטֵי־יָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/122/10"/>עֵדוּת לְיִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/122/11"/>לְהֹדוֹת לְשֵׁם יְהֹוָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/122/12"/>כִּי שָֽׁמָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/122/13"/>יָשְׁבוּ כִסְאוֹת לְמִשְׁפָּט
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/122/14"/>כִּסְאוֹת לְבֵית דָּוִד:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/122/15"/>שַׁאֲלוּ שְׁלוֹם יְרוּשָׁלָֽםִ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/122/16"/>יִשְׁלָֽיוּ אֹהֲבָֽיִךְ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/122/17"/>יְהִי־שָׁלוֹם בְּחֵילֵךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/122/18"/>שַׁלְוָה בְּאַרְמְנוֹתָֽיִךְ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/122/19"/>❖לְמַֽעַן אַחַי וְרֵעָי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/122/20"/>אֲדַבְּרָה־נָּא שָׁלוֹם בָּךְ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/122/21"/>לְמַֽעַן בֵּית־יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/122/22"/>אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/122/23"/>אֲבַקְשָׁה טוֹב לָךְ:</tei:p>
      </tei:div>
