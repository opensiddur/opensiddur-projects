      <tei:div corresp="urn:x-opensiddur:text:prayer:yotzer_or/et_shem">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/et_shem/1"/>אֶת שֵׁם הָאֵל הַמֶּֽלֶךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/et_shem/2"/>הַגָּדוֹל הַגִּבּוֹר וְהַנּוֹרָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/et_shem/3"/>קָדוֹשׁ הוּא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/et_shem/4"/>וְכֻלָּם מְקַבְּ֒לִים עֲלֵיהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/et_shem/5"/>עֹל מַלְ֒כוּת שָׁמַֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/et_shem/6"/>זֶה מִזֶּה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/et_shem/7"/>וְנוֹתְ֒נִים בְּאַהֲבָה רְשׁוּת זֶה לָזֶה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/et_shem/8"/>לְהַקְדִּישׁ לְיוֹצְ֒רָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/et_shem/9"/>בְּנַֽחַת רֽוּחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/et_shem/10"/>בְּשָׂפָה בְרוּרָה וּבִנְ֒עִימָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/et_shem/11"/>קְדֻשָּׁה כֻּלָּם כְּאֶחָד עוֹנִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/et_shem/13"/>בְּאֵימָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/et_shem/12"/>וְאוֹמְ֒רִים בְּיִרְאָה</tei:p>
