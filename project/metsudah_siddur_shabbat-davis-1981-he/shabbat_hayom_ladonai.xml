      <tei:div corresp="urn:x-opensiddur:text:poem:shabbat_hayom_ladonai">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shabbat_hayom_ladonai/1"/>שַׁבָּת הַיּוֹם לַיהֹוָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shabbat_hayom_ladonai/2"/>מְאֹד צַהֲלוּ בְּרִנּוּנַי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shabbat_hayom_ladonai/3"/>וְגַם הַרְבּוּ מַעֲדָנַי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shabbat_hayom_ladonai/4"/>אוֹתוֹ לִשְׁמוֹר כְּמִצְוַת יְהֹוָה.
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shabbat_hayom_ladonai/5"/>שַׁבָּת הַיּוֹם לַיהֹוָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shabbat_hayom_ladonai/6"/>מֵעֲבוֹר דֶּֽרֶךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shabbat_hayom_ladonai/7"/>וּגְבוּלִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shabbat_hayom_ladonai/8"/>מֵעֲשׂוֹת הַיּוֹם פְּעָלִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shabbat_hayom_ladonai/9"/>לֶאֱכוֹל וְלִשְׁתּוֹת בְּהִלוּלִּים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shabbat_hayom_ladonai/10"/>זֶה הַיּוֹם עָשָׂה יְהֹוָה.
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shabbat_hayom_ladonai/11"/>שַׁבָּת הַיּוֹם לַיהֹוָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shabbat_hayom_ladonai/12"/>וְאִם תִּשְׁמְרֶֽנּוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shabbat_hayom_ladonai/13"/>יָהּ יִנְצָרְךָ כְּבָבַת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shabbat_hayom_ladonai/14"/>אַתָּה וּבִנְךָ וְגַם הַבַּת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shabbat_hayom_ladonai/15"/>וְקָרָאתָ עֹֽנֶג לַשַּׁבָּת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shabbat_hayom_ladonai/16"/>אָז תִּתְעַנַּג עַל יְהֹוָה.
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shabbat_hayom_ladonai/17"/>שַׁבָּת הַיּוֹם לַיהֹוָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shabbat_hayom_ladonai/18"/>אֱכוֹל מַשְׁמַנִּים וּמַעֲדַנִּים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shabbat_hayom_ladonai/19"/>וּמַטְעַמִּים הַרְבֵּה מִינִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shabbat_hayom_ladonai/20"/>אֱגוֹזֵי פֶֽרֶךְ וְרִמּוֹנִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shabbat_hayom_ladonai/21"/>וְאָכַלְתָּ וְשָׂבָֽעְתָּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shabbat_hayom_ladonai/22"/>וּבֵרַכְתָּ אֶת יְהֹוָה.
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shabbat_hayom_ladonai/23"/>שַׁבָּת הַיּוֹם לַיהֹוָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shabbat_hayom_ladonai/24"/>לַעֲרוֹךְ בַּשֻּׁלְחָן לֶֽחֶם חֲמוּדוֹת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shabbat_hayom_ladonai/25"/>לַעֲשׂוֹת הַיּוֹם שָׁלשׁ סְעוּדוֹת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shabbat_hayom_ladonai/26"/>אֶת הַשֵּׁם הַנִּכְבָּד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shabbat_hayom_ladonai/27"/>לְבָרֵךְ וּלְהוֹדוֹת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shabbat_hayom_ladonai/28"/>שִׁקְדוּ וְשִׁמְרוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shabbat_hayom_ladonai/29"/>וַעֲשׂוּ בָנַי.
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shabbat_hayom_ladonai/30"/>שַׁבָּת הַיּוֹם לַיהוָה:</tei:p>
      </tei:div>
