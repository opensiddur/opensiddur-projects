      <tei:div corresp="urn:x-opensiddur:text:poem:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1">
        <tei:p><j:conditional xml:id="when_1"><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="yom-tov"><tei:binary value="true"/></tei:f></tei:fs><j:none><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:none></j:all></j:conditional><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/1"/>יְהֹוָה יְהֹוָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/2"/>אֵל רַחוּם וְחַנּוּן.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/3"/>אֶֽרֶךְ אַפַּֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/4"/>וְרַב חֶֽסֶד וֶאֶמֶת:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/34/7"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/5"/>נֹצֵר חֶֽסֶד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/6"/>לָאֲלָפִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/7"/>נֹשֵׂא עָוֹן וָפֶֽשַׁע וְחַטָּאָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/18"/>וְנַקֵּה: <tei:milestone unit="verse"/><tei:hi rend="small">ג"פ</tei:hi>
<tei:milestone unit="phrase"/>
