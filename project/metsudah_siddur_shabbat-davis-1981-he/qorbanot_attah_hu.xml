      <tei:div corresp="urn:x-opensiddur:text:prayer:qorbanot/attah_hu">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/attah_hu/1"/>אַתָּה הוּא יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/attah_hu/2"/>שֶׁהִקְטִֽירוּ אֲבוֹתֵֽינוּ לְפָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/attah_hu/3"/>אֶת קְטֹֽרֶת הַסַּמִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/attah_hu/4"/>בִּזְ֒מַן שֶׁבֵּית הַמִּקְדָּשׁ הָיָה קַיָּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/attah_hu/5"/>כַּאֲשֶׁר צִוִּֽיתָ אוֹתָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/attah_hu/6"/>עַל יְדֵי משֶׁה נְבִיאֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/attah_hu/7"/>כַּכָּתוּב בְּתוֹרָתֶֽךָ:</tei:p>
