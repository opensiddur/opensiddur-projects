    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:aneni_beemet_yishekha">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:aneni_beemet_yishekha/1"/>עֲנֵֽנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:aneni_beemet_yishekha/2"/>בֶּאֱמֶת יִשְׁעֶֽךָ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:aneni_beemet_yishekha/3"/>וַיְהִי בִּנְסֹֽעַ הָאָרֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:aneni_beemet_yishekha/4"/>וַיֹּֽאמֶר משֶׁה קוּמָה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:aneni_beemet_yishekha/5"/>וְיָפֻֽצוּ אֹיְ֒בֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:aneni_beemet_yishekha/6"/>וְיָנֻֽסוּ מְשַׂנְאֶֽיךָ מִפָּנֶֽיךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:aneni_beemet_yishekha/7"/>כִּי מִצִּיּוֹן תֵּצֵא תוֹרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:aneni_beemet_yishekha/8"/>וּדְבַר יְהֹוָה מִירוּשָׁלָֽםִ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:aneni_beemet_yishekha/9"/>בָּרוּךְ שֶׁנָּתַן תּוֹרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:aneni_beemet_yishekha/10"/>לְעַמּוֹ יִשְׂרָאֵל בִּקְדֻשָּׁתוֹ:</tei:p>
      </tei:div>
