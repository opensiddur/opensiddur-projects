      <tei:div corresp="urn:x-opensiddur:text:prayer:qavveh_el_adonai">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/27/14"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qavveh_el_adonai/1"/>קַוֵּה אֶל יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qavveh_el_adonai/2"/>חֲזַק וְיַאֲמֵץ לִבֶּֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qavveh_el_adonai/3"/>וְקַוֵּה אֶל יְהֹוָה:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:samuel_1/2/2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qavveh_el_adonai/4"/>אֵין קָדוֹשׁ כַּיהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qavveh_el_adonai/5"/>כִּי אֵין בִּלְתֶּֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qavveh_el_adonai/6"/>וְאֵין צוּר כֵּאלֹהֵֽינוּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/18/32"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qavveh_el_adonai/7"/>כִּי מִי אֱלֽוֹהַּ מִבַּלְעֲדֵי יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qavveh_el_adonai/8"/>וּמִי צוּר זוּלָתִי אֱלֹהֵֽינוּ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
