      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/mimeqomekha_malkenu_tofia">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/mimeqomekha_malkenu_tofia/1"/>❖מִמְּ֒קוֹמְךָ מַלְכֵּֽנוּ תוֹפִֽיעַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/mimeqomekha_malkenu_tofia/2"/>וְתִמְלוֹךְ עָלֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/mimeqomekha_malkenu_tofia/3"/>כִּי מְחַכִּים אֲנַֽחְנוּ לָךְ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/mimeqomekha_malkenu_tofia/4"/>מָתַי תִּמְלוֹךְ בְּצִיּוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/mimeqomekha_malkenu_tofia/5"/>בְּקָרוֹב בְּיָמֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/mimeqomekha_malkenu_tofia/6"/>לְעוֹלָם וָעֶד תִּשְׁכּוֹן.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/mimeqomekha_malkenu_tofia/7"/>תִּתְגַּדַּל וְתִתְקַדַּשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/mimeqomekha_malkenu_tofia/8"/>בְּתוֹךְ יְרוּשָׁלַֽםִ עִירְ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/mimeqomekha_malkenu_tofia/9"/>לְדוֹר וָדוֹר וּלְנֵֽצַח נְצָחִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/mimeqomekha_malkenu_tofia/10"/>וְעֵינֵֽינוּ תִרְאֶֽינָה מַלְכוּתֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/mimeqomekha_malkenu_tofia/11"/>כַּדָּבָר הָאָמוּר בְּשִׁירֵי עֻזֶּֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/mimeqomekha_malkenu_tofia/12"/>עַל יְדֵי דָוִד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/mimeqomekha_malkenu_tofia/13"/>מְשִֽׁיחַ צִדְקֶֽךָ:</tei:p>
      </tei:div>
