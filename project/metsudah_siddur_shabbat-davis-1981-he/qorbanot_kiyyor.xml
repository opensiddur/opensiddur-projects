    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:qorbanot/kiyyor">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/30/17"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/kiyyor/1"/>וַיְדַבֵּר יְהֹוָה אֶל־משֶׁה לֵּאמֹר:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/30/18"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/kiyyor/2"/>וְעָשִֽׂיתָ כִּיּוֹר נְחֽשֶׁת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/kiyyor/3"/>וְכַנּוֹ נְחֽשֶׁת לְרָחְצָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/kiyyor/4"/>וְנָתַתָּ אֹת֒וֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/kiyyor/5"/>בֵּין־אֹֽהֶל מוֹעֵד וּבֵין הַמִּזְבֵּֽחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/kiyyor/6"/>וְנָתַתָּ שָֽׁמָּה מָֽיִם:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/30/19"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/kiyyor/7"/>וְרָחֲצוּ אַהֲרֹן וּבָנָיו מִמֶּֽנּוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/kiyyor/8"/>אֶת־יְדֵיהֶם וְאֶת־רַגְלֵיהֶם:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/30/20"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/kiyyor/9"/>בְּבֹאָם אֶל־אֹֽהֶל מוֹעֵד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/kiyyor/10"/>יִרְחֲצוּ־מַֽיִם וְלֹא יָמֻֽתוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/kiyyor/11"/>אוֹ בְגִשְׁתָּם אֶל־הַמִּזְבֵּֽחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/kiyyor/12"/>לְשָׁרֵת לְהַקְטִיר אִשֶּׁה לַיהוֹה:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/30/21"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/kiyyor/13"/>וְרָחֲצוּ יְדֵיהֶם וְרַגְלֵיהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/kiyyor/14"/>וְלֹא יָמֻֽתוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/kiyyor/15"/>וְהָיְ֒תָה לָהֶם חָק־עוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/kiyyor/16"/>לוֹ וּלְ֒זַרְעוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/kiyyor/17"/>לְדֹרֹתָם:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
