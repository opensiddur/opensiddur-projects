    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hinneh_lo_yanum">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/121/4"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hinneh_lo_yanum/1"/>הִנֵּה לֹא יָנוּם וְלֹא יִישָׁן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hinneh_lo_yanum/2"/>שׁוֹמֵר יִשְׂרָאֵל:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:genesis/49/18"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hinneh_lo_yanum/3"/>לִישׁוּעָתְ֒ךָ קִוִּֽיתִי יְהֹוָה
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hinneh_lo_yanum/4"/>קִוִּֽיתִי יְהֹוָה לִישׁוּעָתְ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hinneh_lo_yanum/5"/>יְהֹוָה לִישׁוּעָתְ֒ךָ קִוִּֽיתִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hinneh_lo_yanum/6"/>בְּשֵׁם יְהֹוָה אֱלֹהֵי יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hinneh_lo_yanum/7"/>מִימִינִי מִיכָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hinneh_lo_yanum/8"/>וּמִשְּׂ֒מֹאלִי גַבְרִיאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hinneh_lo_yanum/9"/>וּמִלְּ֒פָנַי אוֹרִיאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hinneh_lo_yanum/10"/>וּמֵאֲחוֹרַי רְפָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hinneh_lo_yanum/11"/>וְעַל רֹאשִי שְׁכִינַת אֵל:</tei:p>
