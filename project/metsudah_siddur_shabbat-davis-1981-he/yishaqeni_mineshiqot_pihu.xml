  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:yishaqeni_mineshiqot_pihu">
        <tei:p>
          <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:song_of_songs/1/2"/>
          <tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yishaqeni_mineshiqot_pihu/1"/>
          <tei:hi rend="small"> יִשָּׁקֵֽנִי מִנְּ֒שִׁיקוֹת פִּֽיהוּ כִּי־טוֹבִים דֹּדֶֽיךָ מִיָּֽיִן:</tei:hi>
          <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:song_of_songs/4/16"/>
          <tei:hi rend="small">עֽוּרִי צָפוֹן וּבֽוֹאִי תֵימָן הָפִֽיחִי גַנִּי יִזְּ֒לוּ בְשָׂמָיו יָבֹא דוֹדִי לְגַנּוֹ וְיֹאכַל פְּרִי מְגָדָיו:</tei:hi>
          <tei:hi rend="small"><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:song_of_songs/2/8"/>קוֹל דּוֹדִי הִנֵּה־זֶה בָּא מְדַלֵּג עַל־הֶהָרִים מְקַפֵּץ עַל־הַגְּ֒בָעוֹת:</tei:hi>
          <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:song_of_songs/5/1"/>
          <tei:hi rend="small">בָּֽאתִי לְגַנִּי אֲחתִי כַלָּה אָרִֽיתִי מוֹרִי עִם־בְּשָׂמִי אָכַֽלְתִּי יַעְרִי עִם־דִּבְשִׁי שָׁתִֽיתִי יֵינִי עִם־חֲלָבִי אִכְלוּ רֵעִים שְׁתוּ וְשִׁכְרוּ דּוֹדִים:</tei:hi>
          <tei:milestone unit="phrase"/>
          <tei:milestone unit="verse"/>
        </tei:p>
      </tei:div>
    </tei:body>
