      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/yismach_mosheh_bemattenat">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismach_mosheh_bemattenat/1"/>יִשְׂמַח משֶׁה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismach_mosheh_bemattenat/2"/>בְּמַתְּ֒נַת חֶלְקוֹ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismach_mosheh_bemattenat/3"/>כִּי עֶֽבֶד נֶאֱמָן קָרָֽאתָ־לּוֹ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismach_mosheh_bemattenat/4"/>כְּלִיל תִּפְאֶֽרֶת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismach_mosheh_bemattenat/5"/>בְּרֹאשׁוֹ נָתַֽתָּ לוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismach_mosheh_bemattenat/6"/>בְּעָמְדוֹ לְפָנֶֽיךָ עַל־הַר סִינָי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismach_mosheh_bemattenat/7"/>וּשְׁנֵי לוּחוֹת אֲבָנִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismach_mosheh_bemattenat/8"/>הוֹרִיד בְּיָדוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismach_mosheh_bemattenat/9"/>וְכָתוּב בָּהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismach_mosheh_bemattenat/10"/>שְׁמִירַת שַׁבָּת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismach_mosheh_bemattenat/11"/>וְכֵן כָּתוּב בְּתוֹרָתֶֽךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismach_mosheh_bemattenat/12"/>וְשָׁמְ֒רוּ בְנֵי־יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismach_mosheh_bemattenat/13"/>אֶת־הַשַּׁבָּת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismach_mosheh_bemattenat/14"/>לַעֲשׂוֹת אֶת־הַשַּׁבָּת לְדֹרֹתָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismach_mosheh_bemattenat/15"/>בְּרִית עוֹלָם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismach_mosheh_bemattenat/16"/>בֵּינִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismach_mosheh_bemattenat/17"/>וּבֵין בְּנֵי יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismach_mosheh_bemattenat/18"/>אוֹת הִיא לְעֹלָם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismach_mosheh_bemattenat/19"/>כִּי־שֵֽׁשֶׁת יָמִים עָשָׂה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismach_mosheh_bemattenat/20"/>אֶת־הַשָּׁמַֽיִם וְאֶת־הָאָֽרֶץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismach_mosheh_bemattenat/21"/>וּבַיּוֹם הַשְּׁ֒בִיעִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yismach_mosheh_bemattenat/22"/>שָׁבַת וַיִּנָּפַשׁ:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
