      <tei:div corresp="urn:x-opensiddur:text:prayer:terumat_hadeshen">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:terumat_hadeshen/1"/>וַיְדַבֵּר יְהֹוָה אֶל־משֶׁה לֵּאמֹר:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:leviticus/6/2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:terumat_hadeshen/2"/>צַו אֶת־אַהֲרֹן וְאֶת־בָּנָיו לֵאמֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:terumat_hadeshen/3"/>זֹאת תּוֹרַת הָעֹלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:terumat_hadeshen/4"/>הִוא הָעֹלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:terumat_hadeshen/5"/>עַל מוֹקְ֒דָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:terumat_hadeshen/6"/>עַל־הַמִּזְבֵּֽחַ כָּל־הַלַּֽיְלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:terumat_hadeshen/7"/>עַד־הַבֹּֽקֶר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:terumat_hadeshen/8"/>וְאֵשׁ הַמִּזְבֵּֽחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:terumat_hadeshen/9"/>תּוּקַד בּוֹ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:leviticus/6/3"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:terumat_hadeshen/10"/>וְלָבַשׁ הַכֹּהֵן מִדּוֹ בַד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:terumat_hadeshen/11"/>וּמִכְנְ֒סֵי־בַד יִלְבַּשׁ עַל־בְּשָׂרוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:terumat_hadeshen/12"/>וְהֵרִים אֶת־הַדֶּֽשֶׁן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:terumat_hadeshen/13"/>אֲשֶׁר תֹּאכַל הָאֵשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:terumat_hadeshen/14"/>אֶת הָעֹלָה עַל־הַמִּזְבֵּֽחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:terumat_hadeshen/15"/>וְשָׂמוֹ אֵֽצֶל הַמִּזְבֵּֽחַ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:leviticus/6/4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:terumat_hadeshen/16"/>וּפָשַׁט אֶת־בְּגָדָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:terumat_hadeshen/17"/>וְלָבַשׁ בְּגָדִים אֲחֵרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:terumat_hadeshen/18"/>וְהוֹצִיא אֶת־הַדֶּֽשֶׁן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:terumat_hadeshen/19"/>אֶל־מִחוּץ לַמַּחֲנֶה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:terumat_hadeshen/20"/>אֶל־מָקוֹם טָהוֹר:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:leviticus/6/5"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:terumat_hadeshen/21"/>וְהָאֵשׁ עַל־הַמִּזְבֵּֽחַ תּֽוּקַד־בּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:terumat_hadeshen/22"/>לֹא תִכְבֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:terumat_hadeshen/23"/>וּבִעֵר עָלֶֽיהָ הַכֹּהֵן עֵצִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:terumat_hadeshen/24"/>בַּבֹּֽקֶר בַּבֹּֽקֶר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:terumat_hadeshen/25"/>וְעָרַךְ עָלֶֽיהָ הָעֹלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:terumat_hadeshen/26"/>וְהִקְטִיר עָלֶֽיהָ חֶלְ֒בֵי הַשְּׁ֒לָמִים:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:leviticus/6/6"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:terumat_hadeshen/27"/>אֵשׁ תָּמִיד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:terumat_hadeshen/28"/>תּוּקַד עַל־הַמִּזְבֵּֽחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:terumat_hadeshen/29"/>לֹא תִכְבֶּה:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
