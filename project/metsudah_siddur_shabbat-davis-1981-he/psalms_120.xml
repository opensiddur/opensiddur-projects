      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/120">
        <tei:head xml:lang="he">תהלים קכ</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/120/1"/>שִׁיר הַמַּעֲלוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/120/2"/>אֶל־יְהֹוָה בַּצָּרָֽתָה לִּי קָרָֽאתִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/120/3"/>וַיַּעֲנֵֽנִי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/120/4"/>יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/120/5"/>הַצִּֽילָה נַפְשִׁי מִשְּׂפַת־שֶֽׁקֶר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/120/6"/>מִלָּשׁוֹן רְמִיָּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/120/7"/>מַה־יִּתֵּן לְךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/120/8"/>וּמַה־יֹּסִיף לָךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/120/9"/>לָשׁוֹן רְמִיָּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/120/10"/>חִצֵּי גִבּוֹר שְׁנוּנִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/120/11"/>עִם גַּחֲלֵי רְתָמִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/120/12"/>אֽוֹיָה־לִּי כִּי־גַֽרְתִּי מֶֽשֶׁךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/120/13"/>שָׁכַֽנְתִּי עִם־אָהֳלֵי קֵדָר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/120/14"/>רַבַּת שָֽׁכְנָה־לָּהּ נַפְשִׁי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/120/15"/>עִם שׂוֹנֵא שָׁלוֹם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/120/16"/>אֲנִי־שָׁלוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/120/17"/>וְכִי אֲדַבֵּר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/120/18"/>הֵֽמָּה לַמִּלְחָמָה:</tei:p>
      </tei:div>
