      <tei:div corresp="urn:x-opensiddur:text:prayer:eizehu_meqoman/2">
        <tei:head xml:lang="he">משנה ב</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/2/1"/>פָּרִים הַנִּשְׂרָפִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/2/2"/>וּשְׂ֒עִירִים הַנִּשְׂרָפִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/2/3"/>שְׁחִיטָתָן בַּצָּפוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/2/4"/>וְקִבּוּל דָּמָן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/2/5"/>בִּכְ֒לִי שָׁרֵת בַּצָּפוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/2/6"/>וְדָמָן טָעוּן הַזָּיָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/2/7"/>עַל הַפָּרֹֽכֶת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/2/8"/>וְעַל מִזְבַּח הַזָּהָב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/2/9"/>מַתָּנָה אַחַת מֵהֶן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/2/10"/>מְעַכָּֽבֶת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/2/11"/>שְׁיָרֵי הַדָּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/2/12"/>הָיָה שׁוֹפֵךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/2/13"/>עַל יְסוֹד מַעֲרָבִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/2/14"/>שֶׁל מִזְבֵּֽחַ הַחִיצוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/2/15"/>אִם לֹא נָתַן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/2/16"/>לֹא עִכֵּב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/2/17"/>אֵֽלּוּ וָאֵֽלּוּ נִשְׂרָפִין
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/2/18"/>בְּבֵית הַדָּֽשֶׁן:</tei:p>
