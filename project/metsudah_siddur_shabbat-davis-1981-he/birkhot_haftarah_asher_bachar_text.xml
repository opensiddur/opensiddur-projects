      <tei:div corresp="urn:x-opensiddur:text:prayer:birkhot_haftarah/asher_bachar/text">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/asher_bachar/text/1"/>בָּרוּךְ אַתָּה יְהֹוָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/asher_bachar/text/2"/>אֱלֹהֵֽינוּ מֶֽלֶךְ הָֽעוֹלָם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/asher_bachar/text/3"/>אֲשֶׁר בָּחַר בִּנְבִיאִים טוֹבִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/asher_bachar/text/4"/>וְרָצָה בְדִבְרֵיהֶם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/asher_bachar/text/5"/>הַנֶּאֱמָרִים בֶּאֱמֶת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/asher_bachar/text/6"/>בָּרוּךְ אַתָּה יְהֹוָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/asher_bachar/text/7"/>הַבּוֹחֵר בַּתּוֹרָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/asher_bachar/text/8"/>וּבְמשֶׁה עַבְדּוֹ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/asher_bachar/text/9"/>וּבְיִשְׂרָאֵל עַמּוֹ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/asher_bachar/text/10"/>וּבִנְבִיאֵי הָאֱמֶת וָצֶֽדֶק:</tei:p>
