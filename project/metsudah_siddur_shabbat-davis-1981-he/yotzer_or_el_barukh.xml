      <tei:div corresp="urn:x-opensiddur:text:prayer:yotzer_or/el_barukh">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/1"/>אֵל בָּרוּךְ גְּדוֹל דֵּעָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/2"/>הֵכִין וּפָעַל זָהֳרֵי חַמָּה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/3"/>טוֹב יָצַר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/4"/>כָּבוֹד לִשְׁ֒מוֹ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/5"/>מְאוֹרוֹת נָתַן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/6"/>סְבִיבוֹת עֻזּוֹ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/7"/>פִּנּוֹת צְבָאָיו קְדוֹשִׁים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/8"/>רוֹמְ֒מֵי שַׁדַּי,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/17"/>תָּמִיד מְסַפְּ֒רִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/18"/>כְּבוֹד אֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/10"/>וּקְ֒דֻשָּׁתוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/11"/>תִּתְבָּרֵךְ יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/19"/>בַּשָּׁמַֽיִם מִמַּֽעַל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/20"/>וְעַל הַאָֽרֶץ מִתָּֽחַת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/13"/>עַל כָּל שֶֽׁבַח מַעֲשֵׂה יָדֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/14"/>וְעַל מְאֽוֹרֵי אוֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/21"/>שֶׁיָצַרְתָּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/16"/>הֵֽמָּה יְפָאֲרֽוּךָ סֶּֽלָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/22"/>תִּתְבָּרֵךְ לָנֶצַח צוּרֵֽנוּ מַלְכֵּֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/23"/>וְגוֹאֲלֵֽנוּ, בּוֹרֵא קְדוֹשִׁים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/24"/>יִשְׁתַּבַּח שִׁמְ֒ךָ לָעַד מַלְכֵּֽנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/25"/>יוֹצֵר מְשָׁרְתִים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/26"/>וַאֲשֶׁר מְשָׁרְתָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/27"/>כֻּלָּם עוֹמְ֒דִים בְּרוּם עוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/28"/>וּמַשְׁמִיעִים בְּיִרְאָה יַֽחַד בְּקוֹל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/29"/>דִּבְ֒רֵי אֱלֹהִים חַיִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/30"/>וּמֶֽלֶךְ עוֹלָם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/31"/>כֻּלָם אֲהוּבִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/32"/>כֻּלָּם בְּרוּרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/33"/>כֻּלָּם גִּבּוֹרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/34"/>כֻּלָּם קְדוֹשִׁים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/35"/>וְכֻלָּם עֹשִׂים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/36"/>בְּאֵימָה וּבְ֒יִרְאָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/37"/>רְצוֹן קוֹנָם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/38"/>❖וְכֻלָּם פּוֹתְ֒חִים אֶת פִּיהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/39"/>בִּקְ֒דֻשָּׁה וּבְ֒טָהֳרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/40"/>בְּשִׁירָה וּבְ֒זִמְרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/41"/>וּמְ֒בָרְכִין וּמְ֒שַׁבְּ֒חִין וּמְ֒פָאֲרִין
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/42"/>וּמַעֲרִיצִין וּמַקְדִּישִׁין
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/el_barukh/43"/>וּמַמְלִיכִין:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
