      <tei:div corresp="urn:x-opensiddur:text:prayer:birkhot_hashachar/zokhrenu">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/zokhrenu/1"/>אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/zokhrenu/2"/>זָכְ֒רֵֽנוּ בְּזִכָּרוֹן טוֹב לְפָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/zokhrenu/3"/>וּפָקְ֒דֵֽנוּ בִּפְ֒קֻדַּת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/zokhrenu/4"/>יְשׁוּעָה וְרַחֲמִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/zokhrenu/5"/>מִשְּׁ֒מֵי שְׁמֵי קֶֽדֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/zokhrenu/6"/>וּזְ֒כָר לָֽנוּ יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/zokhrenu/7"/>אַהֲבַת הַקַּדְמוֹנִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/zokhrenu/8"/>אַבְרָהָם יִצְחָק וְיִשְׂרָאֵל עֲבָדֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/zokhrenu/9"/>אֶת הַבְּ֒רִית וְאֶת הַחֶֽסֶד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/zokhrenu/10"/>וְאֶת הַשְּׁ֒בוּעָה שֶׁנִּשְׁבַּֽעְתָּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/zokhrenu/11"/>לְאַבְרָהָם אָבִֽינוּ בְּהַר הַמֹּרִיָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/zokhrenu/12"/>וְאֶת הָעֲקֵדָה שֶׁעָקַד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/zokhrenu/13"/>אֶת יִצְחָק בְּנוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/zokhrenu/14"/>עַל גַּבֵּי הַמִּזְבֵּֽחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/zokhrenu/15"/>כַּכָּתוּב בְּתוֹרָתֶֽךָ:</tei:p>
