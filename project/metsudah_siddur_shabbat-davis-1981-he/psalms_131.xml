  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/131">
        <tei:head xml:lang="he">תהלים קלא</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/131/1"/>שִׁיר הַמַּעֲלוֹת לְדָוִד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/131/2"/>יְהֹוָה לֹא־גָבַהּ לִבִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/131/3"/>וְלֹא־רָמוּ עֵינַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/131/4"/>וְלֹא־הִלַּֽכְתִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/131/5"/>בִּגְדֹלוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/131/6"/>וּבְנִפְלָאוֹת מִמֶּֽנִּי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/131/7"/>אִם־לֹא שִׁוִּֽיתִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/131/8"/>וְדוֹמַֽמְתִּי נַפְשִׁי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/131/9"/>כְּגָמֻל עֲלֵי אִמּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/131/10"/>כַּגָּמֻל עָלַי נַפְשִׁי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/131/11"/>יַחֵל יִשְׂרָאֵל אֶל־יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/131/12"/>מֵעַתָּה וְעַד־עוֹלָם:</tei:p>
