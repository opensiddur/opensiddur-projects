      <tei:div corresp="urn:x-opensiddur:text:bible:numbers/28/16-19">
        <tei:head xml:lang="he">ליום א' וב' דפסח</tei:head>
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/28/16"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/28/16_19/1"/>וּבַחֹֽדֶשׁ הָרִאשׁוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/28/16_19/2"/>בְּאַרְבָּעָה עָשָׂר יוֹם לַחֹֽדֶשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/28/16_19/3"/>פֶּֽסַח
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/28/16_19/4"/>לַיהֹוָה.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/28/17"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/28/16_19/5"/>וּבַחֲמִשָּׁה עָשָׂר יוֹם לַחֹֽדֶשׁ הַזֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/28/16_19/6"/>חָג.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/28/16_19/7"/>שִׁבְעַת יָמִים מַצּוֹת יֵאָכֵל:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/28/18"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/28/16_19/8"/>בַּיּוֹם הָרִאשׁוֹן מִקְרָא קֹֽדֶשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/28/16_19/9"/>כָּל מְלֶֽאכֶת עֲבֹדָה לֹא תַעֲשׂוּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/28/19"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/28/16_19/10"/>וְהִקְרַבְתֶּם אִשֶּׁה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/28/16_19/11"/>עֹלָה לַיהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/28/16_19/12"/>פָּרִים בְּנֵי בָקָר שְׁנַֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/28/16_19/13"/>וְאַֽיִל אֶחָד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/28/16_19/14"/>וְשִׁבְעָה כְבָשִׂים בְּנֵי שָׁנָה
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
