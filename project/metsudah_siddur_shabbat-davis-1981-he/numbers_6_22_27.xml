      <tei:div corresp="urn:x-opensiddur:text:bible:numbers/6/22-27">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/6/22-27/1"/>וַיְדַבֵּר יְהֹוָה אֶל מֹשֶׁה לֵאמֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/6/22-27/2"/>דַבֵּר אֶל אַהֲרֹן וְאֶל בָּנָיו לֵאמֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/6/22-27/3"/>כֹּה תְבָרְ֒כוּ אֶת בְּנֵי יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/6/22-27/4"/>אָמוֹר לָהֶם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/6/22-27/5"/>יְבָרֶכְ֒ךָ יְהֹוָה וְיִשְׁמְרֶֽךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/6/22-27/6"/>יָאֵר יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/6/22-27/7"/>פָּנָיו אֵלֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/6/22-27/8"/>וִיחֻנֶּֽךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/6/22-27/9"/>יִשָּׂא יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/6/22-27/10"/>פָּנָיו אֵלֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/6/22-27/11"/>וְיָשֵׂם לְךָ שָׁלוֹם:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/6/27"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/6/22-27/12"/>וְשָׂמוּ אֶת שְׁמִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/6/22-27/13"/>עַל בְּנֵי יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/6/22-27/14"/>וַאֲנִי אַבָרְ֒כֵם:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
