    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/112">
        <tei:head xml:lang="he">תהלים קיב</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/112/1"/>הַלְלוּיָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/112/2"/>אַשְׁרֵי־אִישׁ יָרֵא אֶת־יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/112/3"/>בְּמִצְוֹתָיו חָפֵץ מְאֹד:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/112/4"/>גִּבּוֹר בָּאָֽרֶץ יִהְיֶה זַרְעוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/112/5"/>דּוֹר יְשָׁרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/112/6"/>יְבֹרָךְ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/112/7"/>הוֹן־וָעֽשֶׁר בְּבֵיתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/112/8"/>וְצִדְקָתוֹ עֹמֶֽדֶת לָעַד:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/112/9"/>זָרַח בַּחֽשֶׁךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/112/10"/>אוֹר לַיְשָׁרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/112/11"/>חַנּוּן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/112/12"/>וְרַחוּם וְצַדִּיק:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/112/13"/>טוֹב־אִישׁ חוֹנֵן וּמַלְוֶה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/112/14"/>יְכַלְכֵּל דְּבָרָיו בְּמִשְׁפָּט:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/112/15"/>כִּי־לְעוֹלָם לֹא־יִמּוֹט
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/112/16"/>לְזֵֽכֶר עוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/112/17"/>יִהְיֶה צַדִּיק:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/112/18"/>מִשְּׁמוּעָה רָעָה לֹא יִירָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/112/19"/>נָכוֹן לִבּוֹ בָּטֻֽחַ בַּיהֹוָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/112/20"/>סָמוּךְ לִבּוֹ לֹא יִירָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/112/21"/>עַד אֲשֶׁר־יִרְאֶה בְצָרָיו:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/112/22"/>פִּזַּר נָתַן לָאֶבְיוֹנִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/112/23"/>צִדְקָתוֹ עֹמֶֽדֶת לָעַד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/112/24"/>קַרְנוֹ תָּרוּם בְּכָבוֹד:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/112/25"/>רָשָׁע יִרְאֶה וְכָעָס
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/112/26"/>שִׁנָּיו יַחֲרֹק וְנָמָס
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/112/27"/>תַּאֲוַת רְשָׁעִים תֹּאבֵד:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
