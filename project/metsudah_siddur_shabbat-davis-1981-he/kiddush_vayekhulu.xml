      <tei:div corresp="urn:x-opensiddur:text:prayer:kiddush/vayekhulu">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/vayekhulu/1"/>וַיְהִי עֶֽרֶב וַיְהִי בֹֽקֶר:
<tei:milestone unit="phrase"/>
<tei:note type="instruction" xml:lang="he">בקול רם</tei:note>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/vayekhulu/2"/>יוֹם הַשִּׁשִּׁי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/vayekhulu/3"/>וַיְכֻלּוּ הַשָּׁמַֽיִם וְהָאָֽרֶץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/vayekhulu/4"/>וְכָל־צְבָאָם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/vayekhulu/5"/>וַיְכַל אֱלֹהִים בַּיּוֹם הַשְּׁ֒בִיעִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/vayekhulu/6"/>מְלַאכְתּוֹ אֲשֶׁר עָשָׂה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/vayekhulu/7"/>וַיִּשְׁבֹּת בַּיּוֹם הַשְּׁ֒בִיעִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/vayekhulu/8"/>מִכָּל־מְלַאכְתּוֹ אֲשֶׁר עָשָׂה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/vayekhulu/9"/>וַיְבָֽרֶךְ אֱלֹהִים אֶת־יוֹם הַשְּׁ֒בִיעִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/vayekhulu/10"/>וַיְקַדֵּשׁ אֹתוֹ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/vayekhulu/11"/>כִּי בוֹ שָׁבַת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/vayekhulu/12"/>מִכָּל מְלַאכְתּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/vayekhulu/13"/>אֲשֶׁר־בָּרָא אֱלֹהִים לַעֲשׂוֹת:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kiddush/vayekhulu/14"/><tei:hi rend="small">סַבְרִי מָרָנָן וְרַבּוֹתַי:</tei:hi></tei:p>
      </tei:div>
    </tei:body>
