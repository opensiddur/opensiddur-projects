  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/128">
        <tei:head xml:lang="he">תהלים קכח</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/128/1"/>שִׁיר הַמַּעֲלוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/128/2"/>אַשְׁרֵי כָּל־יְרֵא יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/128/3"/>הַהֹלֵךְ בִּדְרָכָיו:
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:bible:psalms/128/chol_keriat_shema_al_hamittah"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/128/19"/>יְגִֽיעַ כַּפֶּֽיךָ כִּי תֹאכֵל
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:bible:psalms/128/chol_keriat_shema_al_hamittah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/128/4"/>יְגִֽיעַ כַּפֶּֽיךָ
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:bible:psalms/128/chol_keriat_shema_al_hamittah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/128/5"/>כִּי תֹאכֵל
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/128/6"/>אַשְׁרֶֽיךָ וְטוֹב לָךְ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/128/7"/>אֶשְׁתְּךָ כְּגֶֽפֶן פֹּרִיָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/128/8"/>בְּיַרְכְּתֵי בֵיתֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/128/9"/>בָּנֶֽיךָ כִּשְׁתִלֵי זֵיתִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/128/10"/>סָבִיב לְשֻׁלְחָנֶֽךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/128/11"/>הִנֵּה כִי־כֵן יְבֹֽרַךְ גָּֽבֶר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/128/12"/>יְרֵא יְהֹוָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/128/13"/>יְבָרֶכְךָ יְהֹוָה מִצִּיּוֹן
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:bible:psalms/128/chol_keriat_shema_al_hamittah"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/128/20"/>וּרְאֵה בְּטוּב יְרוּשָׁלָֽםִ
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:bible:psalms/128/chol_keriat_shema_al_hamittah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/128/14"/>וּרְאֵה
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_5"/>
<j:conditional xml:id="variant_6"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:bible:psalms/128/chol_keriat_shema_al_hamittah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/128/15"/>בְּטוּב יְרוּשָׁלָֽםִ
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_6"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/128/16"/>כֹּל יְמֵי חַיֶּֽיךָ:
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_7"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:bible:psalms/128/chol_keriat_shema_al_hamittah"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/128/21"/>וּרְאֵה־
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/128/22"/>בָנִים לְבָנֶֽיךָ
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_7"/>
<j:conditional xml:id="variant_8"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:bible:psalms/128/chol_keriat_shema_al_hamittah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/128/17"/>וּרְאֵה־בָנִים לְבָנֶֽיךָ
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_8"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/128/18"/>שָׁלוֹם עַל־יִשְׂרָאֵל:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
