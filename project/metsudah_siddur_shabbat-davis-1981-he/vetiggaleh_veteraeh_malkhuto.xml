    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:vetiggaleh_veteraeh_malkhuto">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vetiggaleh_veteraeh_malkhuto/1"/>וְתִגָּלֶה וְתֵרָאֶה מַלְכוּתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vetiggaleh_veteraeh_malkhuto/2"/>עָלֵֽינוּ בִּזְמַן קָרוֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vetiggaleh_veteraeh_malkhuto/3"/>וְיָחוֹן פְּלֵטָתֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vetiggaleh_veteraeh_malkhuto/4"/>וּפְלֵטַת עַמּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vetiggaleh_veteraeh_malkhuto/5"/>בֵּית יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vetiggaleh_veteraeh_malkhuto/6"/>לְחֵן וּלְחֶֽסֶד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vetiggaleh_veteraeh_malkhuto/7"/>וּלְרַחֲמִים וּלְרָצוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vetiggaleh_veteraeh_malkhuto/8"/>וְנֹאמַר אָמֵן.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vetiggaleh_veteraeh_malkhuto/9"/>הַכֹּל הָבוּ גֹֽדֶל לֵאלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vetiggaleh_veteraeh_malkhuto/10"/>וּתְנוּ כָבוֹד לַתּוֹרָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vetiggaleh_veteraeh_malkhuto/11"/>כֹּהֵן קְרָב.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vetiggaleh_veteraeh_malkhuto/12"/>יַעֲמֹד (פב"פ) הַכֹּהֵן.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vetiggaleh_veteraeh_malkhuto/13"/>בָּרוּךְ שֶׁנָּתַן תּוֹרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vetiggaleh_veteraeh_malkhuto/14"/>לְעַמּוֹ יִשְׂרָאֵל בִּקְדֻשָּׁתוֹ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vetiggaleh_veteraeh_malkhuto/15"/>וְאַתֶּם הַדְּ֒בֵקִים בַּיהֹוָה אֱלֹהֵיכֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vetiggaleh_veteraeh_malkhuto/16"/>חַיִּים כֻּלְּכֶם הַיּוֹם:</tei:p>
      </tei:div>
