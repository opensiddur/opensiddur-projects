      <tei:div corresp="urn:x-opensiddur:text:prayer:av_harachamim/hu_yerachem/text">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/1"/>אָב הָרַחֲמִים הוּא יְרַחֵם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/2"/>עַם עֲמוּסִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/3"/>וְיִזְכֹּר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/4"/>בְּרִית אֵיתָנִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/5"/>וְיַצִּיל נַפְשׁוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/6"/>מִן הַשָּׁעוֹת הָרָעוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/7"/>וְיִגְעַר בְּיֵֽצֶר הָרָע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/8"/>מִן הַנְּ֒שׂוּאִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/9"/>וְיָחוֹן אוֹתָֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/10"/>לִפְלֵטַת עוֹלָמִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/11"/>וִימַלֵּא מִשְׁאֲלוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/12"/>בְּמִדָּה טוֹבָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/13"/>יְשׁוּעָה וְרַחֲמִים:</tei:p>
