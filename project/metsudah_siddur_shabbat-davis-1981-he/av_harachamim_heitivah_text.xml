      <tei:div corresp="urn:x-opensiddur:text:prayer:av_harachamim/heitivah/text">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/heitivah/text/1"/>אָב הָרַחֲמִים
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/51/20"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/heitivah/text/2"/>הֵיטִֽיבָה בִרְצוֹנְ֒ךָ אֶת צִיּוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/heitivah/text/3"/>תִּבְנֶה חוֹמוֹת יְרוּשָׁלָֽםִ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/heitivah/text/4"/>כִּי בְךָ לְבַד בָּטָֽחְנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/heitivah/text/5"/>מֶֽלֶךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/heitivah/text/6"/>אֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/heitivah/text/7"/>רָם וְנִשָּׂא אֲדוֹן עוֹלָמִים:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/10/35"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/heitivah/text/8"/>וַיְהִי בִּנְסֹֽעַ הָאָרֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/heitivah/text/9"/>וַיֹּֽאמֶר משֶׁה קוּמָה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/heitivah/text/10"/>וְיָפֻֽצוּ אֹיְ֒בֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/heitivah/text/11"/>וְיָנֻֽסוּ מְשַׂנְאֶֽיךָ מִפָּנֶֽיךָ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/heitivah/text/12"/>כִּי מִצִּיּוֹן תֵּצֵא תוֹרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/heitivah/text/13"/>וּדְבַר יְהֹוָה מִירוּשָׁלָֽםִ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/heitivah/text/14"/>בָּרוּךְ שֶׁנָּתַן תּוֹרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/heitivah/text/15"/>לְעַמּוֹ יִשְׂרָאֵל בִּקְדֻשָּׁתוֹ:</tei:p>
      </tei:div>
    </tei:body>
