    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hashir_shehaleviyyim_hau">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/1"/>הַשִּׁיר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/2"/>שֶׁהַלְ֒וִיִּם הָיוּ אוֹמְ֒רִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/3"/>בְּבֵית הַמִּקְדָּשׁ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/4"/>בַּיּוֹם הָרִאשׁוֹן הָיוּ אוֹמְ֒רִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/5"/>לַיהֹוָה הָאָֽרֶץ וּמְלֹאָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/6"/>תֵּבֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/7"/>וְיֽשְׁ֒בֵי בָהּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/8"/>בַּשֵּׁנִי הָיוּ אוֹמְ֒רִים.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/48/2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/9"/>גָּדוֹל יְהֹוָה וּמְהֻלָּל מְאֹד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/10"/>בְּעִיר אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/11"/>הַר קָדְשׁוֹ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/12"/>בַּשְּׁ֒לִישִׁי הָיוּ אוֹמְ֒רִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/13"/>אֱלֹהִים נִצָּב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/14"/>בַּעֲדַת אֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/15"/>בְּקֶֽרֶב אֱלֹהִים יִשְׁפֹּט:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/16"/>בָּרְ֒בִיעִי הָיוּ אוֹמְ֒רִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/17"/>אֵל נְקָמוֹת יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/18"/>אֵל נְקָמוֹת הוֹפִֽיעַ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/19"/>בַּחֲמִישִׁי הָיוּ אוֹמְ֒רִים.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/81/2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/20"/>הַרְנִֽינוּ לֵאלֹהִים עֻזֵּֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/21"/>הָרִֽיעוּ לֵאלֹהֵי יַעֲקֹב:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/22"/>בַּשִּׁשִּׁי הָיוּ אוֹמְ֒רִים.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/93/1"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/23"/>יְהֹוָה מָלָךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/24"/>גֵּאוּת לָבֵשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/25"/>לָבֵשׁ יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/26"/>עֹז הִתְאַזָּר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/27"/>אַף תִּכּוֹן תֵּבֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/28"/>בַּל תִּמּוֹט:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/29"/>בַּשַּׁבָּת הָיוּ אוֹמְרִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/30"/>מִזְמוֹר שִׁיר לְיוֹם הַשַּׁבָּת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/31"/>מִזְמוֹר שִׁיר לֶעָתִיד לָבֹא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/32"/>לְיוֹם שֶׁכֻּלּוֹ שַׁבָּת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hashir_shehaleviyyim_hau/33"/>וּמְנוּחָה לְחַיֵּי הָעוֹלָמִים:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
