  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:ein_kamokha">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/86/8"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_kamokha/1"/>אֵין כָּמֽוֹךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_kamokha/2"/>בָאֱלֹהִים אֲדֹנָי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_kamokha/3"/>וְאֵין כְּמַעֲשֶֽׂיךָ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_kamokha/4"/>מַלְכוּתְ֒ךָ מַלְכוּת כָּל עוֹלָמִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_kamokha/5"/>וּמֶמְשַׁלְתְּ֒ךָ בְּכָל דּוֹר וָדוֹר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_kamokha/6"/>יְהֹוָה מֶֽלֶךְ יְהֹוָה מָלָךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_kamokha/7"/>יְהֹוָה יִמְלֹךְ לְעוֹלָם וָעֶד:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_kamokha/8"/>יְהֹוָה עֹז לְעַמּוֹ יִתֵּן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_kamokha/9"/>יְהֹוָה יְבָרֵךְ אֶת עַמּוֹ בַשָּׁלוֹם:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
