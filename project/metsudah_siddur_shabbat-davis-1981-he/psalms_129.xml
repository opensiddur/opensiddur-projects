      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/129">
        <tei:head xml:lang="he">תהלים קכט</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/129/1"/>שִׁיר הַמַּעֲלוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/129/2"/>רַבַּת צְרָרֽוּנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/129/3"/>מִנְּעוּרַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/129/4"/>יֹֽאמַר־נָא יִשְׂרָאֵל:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/129/5"/>רַבַּת צְרָרֽוּנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/129/6"/>מִנְּעוּרָי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/129/7"/>גַּם לֹא־יָֽכְלוּ לִי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/129/8"/>עַל־גַּבִּי חָרְשׁוּ חֹרְשִׁים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/129/9"/>הֶאֱרִֽיכוּ לְמַעֲנִיתָם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/129/10"/>יְהֹוָה צַדִּיק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/129/11"/>קִצֵּץ עֲבוֹת רְשָׁעִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/129/12"/>יֵבֽשׁוּ וְיִסֹּֽגוּ אָחוֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/129/13"/>כֹּל שׂנְאֵי צִיּוֹן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/129/14"/>יִהְיוּ כַּחֲצִיר גַּגּוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/129/15"/>שֶׁקַּדְמַת שָׁלַף יָבֵשׁ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/129/16"/>שֶׁלֹּא מִלֵּא כַפּוֹ קוֹצֵר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/129/17"/>וְחִצְנוֹ מְעַמֵּר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/129/18"/>וְלֹא אָמְרוּ הָעֹבְרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/129/19"/>בִּרְכַּת־יְהֹוָה אֲלֵיכֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/129/20"/>בֵּרַֽכְנוּ אֶתְכֶם בְּשֵׁם יְהֹוָה:</tei:p>
      </tei:div>
