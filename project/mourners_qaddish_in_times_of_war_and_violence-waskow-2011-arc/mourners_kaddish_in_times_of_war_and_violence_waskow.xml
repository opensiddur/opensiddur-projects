  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:mourners_kaddish_in_times_of_war_and_violence_waskow">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mourners_kaddish_in_times_of_war_and_violence_waskow/1"/>
        <tei:lg xml:lang="he">
          <tei:l>יִתְגַּדַּל וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא (<tei:note type="instruction">קהל:</tei:note> אָמֵן)‏</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mourners_kaddish_in_times_of_war_and_violence_waskow/2"/>
        <tei:lg xml:lang="he">
          <tei:l>בְּעָלְמָא דִּי בְרָא כִרְעוּתֵהּ</tei:l>
          <tei:l>וְיַמְלִיךְ מַלְכוּתֵהּ</tei:l>
          <tei:l>בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן</tei:l>
          <tei:l>וּבְחַיֵּי דְכָל בֵּית יִשְׂרָאֵל</tei:l>
          <tei:l>בַּעֲגָלָא וּבִזְמַן קָרִיב</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן. (<tei:note type="instruction">קהל:</tei:note> אָמֵן)‏</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mourners_kaddish_in_times_of_war_and_violence_waskow/3"/>
        <tei:lg xml:lang="he">
          <tei:l>יְהֵא שְׁמֵהּ רַבָּא מְבָרַךְ</tei:l>
          <tei:l>לְעָלַם וּלְעָלְמֵי עָלְמַיָּא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mourners_kaddish_in_times_of_war_and_violence_waskow/4"/>
        <tei:lg xml:lang="he">
          <tei:l>יִתְבָּרַךְ וְיִשְׁתַּבַּח</tei:l>
          <tei:l>וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְנַשֵּׂא</tei:l>
          <tei:l>וְיִתְהַדַּר וְיִתְעַלֶּה וְיִתְהַלַּל</tei:l>
          <tei:l>שְׁמֵהּ דְּקֻדְשָׁא (<tei:note type="instruction">קהל:</tei:note> בְּרִיךְ הוּא)‏</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mourners_kaddish_in_times_of_war_and_violence_waskow/5"/>
        <tei:lg xml:lang="he">
          <tei:l>לְעֵלָּא מִן כָּל־בִּרְכָתָא וְשִׁירָתָא</tei:l>
          <tei:l>תֻּשְׁבְּחָתָא וְנֶחְמָתָא</tei:l>
          <tei:l>דַּאֲמִירָן בְּעָלְמָא</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן. (<tei:note type="instruction">קהל:</tei:note> אָמֵן)‏</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mourners_kaddish_in_times_of_war_and_violence_waskow/6"/>
        <tei:lg xml:lang="he">
          <tei:l>יְהֵא שְׁלָמָא רַבָּא מִן שְׁמַיָּא</tei:l>
          <tei:l>וְחַיִּים עָלֵינוּ</tei:l>
          <tei:l>וְעַל כָּל יִשְׂרָאֵל.</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן. (<tei:note type="instruction">קהל:</tei:note> אָמֵן)‏</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mourners_kaddish_in_times_of_war_and_violence_waskow/7"/>
        <tei:lg xml:lang="he">
          <tei:l>עוֹשֶׂה שָׁלוֹם בִּמְרוֹמָיו</tei:l>
          <tei:l>הוּא יַעֲשֶׂה שָׁלוֹם עָלֵינוּ</tei:l>
          <tei:l>וְעַל כָּל יִשְׂרָאֵל</tei:l>
          <tei:l>וְעַל כָּל יִשְׁמָעֵאל</tei:l>
          <tei:l>וְעַל כָּל יוֺשְׁבֵי תֵבֶל</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן. (<tei:note type="instruction">קהל:</tei:note> אָמֵן)‏</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
