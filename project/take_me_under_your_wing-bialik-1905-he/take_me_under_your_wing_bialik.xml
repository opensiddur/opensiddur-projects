    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:take_me_under_your_wing_bialik">
        <tei:head>הַכְנִיסִינִי תַּחַת כְּנָפֵךְ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:take_me_under_your_wing_bialik/1"/>
        <tei:lg>
          <tei:l>הַכְנִיסִינִי תַּחַת כְּנָפֵךְ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:take_me_under_your_wing_bialik/2"/>
        <tei:lg>
          <tei:l>הַכְנִיסִינִי תַּחַת כְּנָפֵךְ,</tei:l>
          <tei:l>וַהֲיִי לִי אֵם וְאָחוֹת,</tei:l>
          <tei:l>וִיהִי חֵיקֵךְ מִקְלַט רֹאשִׁי,</tei:l>
          <tei:l>קַן־תְּפִלּוֹתַי הַנִּדָּחוֹת.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:take_me_under_your_wing_bialik/3"/>
        <tei:lg>
          <tei:l>וּבְעֵת רַחֲמִים, בֵּין־הַשְּׁמָשׁוֹת,</tei:l>
          <tei:l>שְׁחִי וַאֲגַל לָךְ סוֹד יִסּוּרָי:</tei:l>
          <tei:l>אוֹמְרִים, יֵשׁ בָּעוֹלָם נְעוּרִים –</tei:l>
          <tei:l>הֵיכָן נְעוּרָי?</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:take_me_under_your_wing_bialik/4"/>
        <tei:lg>
          <tei:l>וְעוֹד רָז אֶחָד לָךְ אֶתְוַדֶּה:</tei:l>
          <tei:l>נַפְשִׁי נִשְׂרְפָה בְלַהֲבָהּ;</tei:l>
          <tei:l>אוֹמְרִים, אַהֲבָה יֵשׁ בָּעוֹלָם –</tei:l>
          <tei:l>מַה־זֹּאת אַהֲבָה?</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:take_me_under_your_wing_bialik/5"/>
        <tei:lg>
          <tei:l>הַכּוֹכָבִים רִמּוּ אוֹתִי,</tei:l>
          <tei:l>הָיָה חֲלוֹם – אַךְ גַּם הוּא עָבָר;</tei:l>
          <tei:l>עַתָּה אֵין לִי כְלוּם בָּעוֹלָם –</tei:l>
          <tei:l>אֵין לִי דָבָר.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:take_me_under_your_wing_bialik/6"/>
        <tei:lg>
          <tei:l>הַכְנִיסִינִי תַּחַת כְּנָפֵךְ,</tei:l>
          <tei:l>וַהֲיִי לִי אֵם וְאָחוֹת,</tei:l>
          <tei:l>וִיהִי חֵיקֵךְ מִקְלַט רֹאשִׁי,</tei:l>
          <tei:l>קַן־תְּפִלּוֹתַי הַנִּדָּחוֹת.</tei:l>
        </tei:lg>
