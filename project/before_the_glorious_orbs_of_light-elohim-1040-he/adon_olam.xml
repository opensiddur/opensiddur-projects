  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:adon_olam">
        <tei:head>אֲדוֹן עוֹלָם</tei:head>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>אֲדוֹן עוֹלָם אֲשֶׁר מָלַךְ</tei:l>
          <tei:l>בְּטֶֽרֶם כׇּל־יְצִיר נִבְרָא׃</tei:l>
          <tei:l>לְעֵת נַֽעֲשָׂה כְּחֶפְצוֹ כֹּל</tei:l>
          <tei:l>אֲזַי מֶֽלֶךְ שְׁמוֹ נִקְרָא׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְהוּא אֶחָד וְאֵין שֵׁנִי</tei:l>
          <tei:l>לְהַמְשִׁיל לוֹ לְהַחְבִּירָה׃</tei:l>
          <tei:l>וְאַֽחֲרֵי כִּכְלּוֹת הַכֹּל</tei:l>
          <tei:l>לְבַדּוֹ יִמְלֹךְ נוֹרָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam/beli_reshit"/>
        <tei:lg>
          <tei:l>בְּלִי רֵאשִׁית</tei:l>
          <tei:l>בְּלִי תַּכְלִית</tei:l>
          <tei:l>וְלוֹ הָעֹז</tei:l>
          <tei:l>וְהַמִּשְׂרָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam/vehu_hayah"/>
        <tei:lg>
          <tei:l>וְהוּא הָיָה</tei:l>
          <tei:l>וְהוּא הֹוֶה</tei:l>
          <tei:l>וְהוּא יִֽהְיֶה</tei:l>
          <tei:l>בְּתִפְאֲרָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>בְּלִי עֵֽרֶךְ בְּלִי דִמְיוֹן</tei:l>
          <tei:l>בְּלִי שִׁנּוּי וְהַתְּמוּרָה׃</tei:l>
          <tei:l>בְּלִי חִבּוּר בְּלִי פֵרוּד</tei:l>
          <tei:l>גְּדׇל־כֹּחַ וְהַגְּבוּרָה׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְהוּא אֵלִי וְחַי גּֽוֹאֲלִי</tei:l>
          <tei:l>וְצוּר חֶבְלִי בְּיוֹם צָרָה׃</tei:l>
          <tei:l>וְהוּא נִסִּי וּמָנוֹס לִי</tei:l>
          <tei:l>מְנָת כּוֹסִי בְּיוֹם אֶקְרָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam/beyado"/>
        <tei:lg>
          <tei:l>בְּיָדוֹ אַפְקִיד רוּחִי</tei:l>
          <tei:l>בְּעֵת אִישַׁן וְאָעִֽירָה׃</tei:l>
          <tei:l>וְעִם רוּחִי גְּוִיָּתִי</tei:l>
          <tei:l>אֲדֹנָי לִי וְלֹא אִירָא׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
