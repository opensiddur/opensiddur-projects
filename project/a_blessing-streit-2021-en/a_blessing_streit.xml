  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:a_blessing_streit">
        <tei:head>A Blessing, by Kohenet Ilana Joy Streit</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_blessing_streit/1"/>
        <tei:lg>
          <tei:l>A Blessing</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_blessing_streit/2"/>
        <tei:p>may love and beauty</tei:p>
        <tei:p>flow through you</tei:p>
        <tei:p>may anger trickle and pour<tei:lb/>out of you</tei:p>
        <tei:p>may music enfold you</tei:p>
        <tei:p>may streamers of joy surround you<tei:lb/>mosquitoes eat to their fill<tei:lb/>before they get to you</tei:p>
        <tei:p>may you wake up in the morning<tei:lb/>a little lighter<tei:lb/>a little surer<tei:lb/>voices of strength and knowing<tei:lb/>a little louder</tei:p>
        <tei:p>pathways of courage and chutzpah<tei:lb/>a little deeper<tei:lb/>oceans of joy and belonging<tei:lb/>more your home<tei:lb/>gardens of playfulness and creativity<tei:lb/>more familiar with your hands<tei:lb/>in their soil</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
