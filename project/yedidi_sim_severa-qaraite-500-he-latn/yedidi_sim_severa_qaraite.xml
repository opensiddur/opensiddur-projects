  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:yedidi_sim_severa_qaraite">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yedidi_sim_severa_qaraite/1"/>
        <tei:lg>
          <tei:l>Yedidi sim sevara</tei:l>
          <tei:l>vechavvana cheshera</tei:l>
          <tei:l>Ḳerav liḳro betora</tei:l>
          <tei:l>bereshit bara</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Ḳerav liḳro betora</tei:l>
          <tei:l>bereshit bara</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yedidi_sim_severa_qaraite/2"/>
        <tei:lg>
          <tei:l>Tsevi ḥen toch ḥaverim</tei:l>
          <tei:l>umiggeza‘ yesharim</tei:l>
          <tei:l>Veshoresh habberurim</tei:l>
          <tei:l>bereshit bara</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Ḳerav liḳro betora</tei:l>
          <tei:l>bereshit bara</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yedidi_sim_severa_qaraite/3"/>
        <tei:lg>
          <tei:l>Ḥazaḳ ve’emats vetashit</tei:l>
          <tei:l>levav ḥatan bereshit</tei:l>
          <tei:l>Be‘iyunit uma‘asit</tei:l>
          <tei:l>bereshit bara</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Ḳerav liḳro betora</tei:l>
          <tei:l>bereshit bara</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yedidi_sim_severa_qaraite/4"/>
        <tei:lg>
          <tei:l>Ḳero ḳiru veshirim</tei:l>
          <tei:l>umizmorim yeḳarim</tei:l>
          <tei:l>Le’ash-sher ben gevirim</tei:l>
          <tei:l>bereshit bara</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Ḳerav liḳro betora</tei:l>
          <tei:l>bereshit bara</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yedidi_sim_severa_qaraite/5"/>
        <tei:lg>
          <tei:l>Ḥasadav tsur yetsavvé</tei:l>
          <tei:l>be‘atid gam behové</tei:l>
          <tei:l>Betuvo lach yeravvé</tei:l>
          <tei:l>bereshit bara</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Ḳerav liḳro betora</tei:l>
          <tei:l>bereshit bara</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yedidi_sim_severa_qaraite/6"/>
        <tei:lg>
          <tei:l>Zechut avot tedira</tei:l>
          <tei:l>lecha maḡen vesitra</tei:l>
          <tei:l>Lehats-tsilecha mits-tsara</tei:l>
          <tei:l>bereshit bara</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Ḳerav liḳro betora</tei:l>
          <tei:l>bereshit bara</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yedidi_sim_severa_qaraite/7"/>
        <tei:lg>
          <tei:l>Ḳedoshi hammezakké</tei:l>
          <tei:l>lehatḥil ken yezakké</tei:l>
          <tei:l>Lehashlimah</tei:l>
          <tei:l>leḥoché</tei:l>
          <tei:l>bereshit bara.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Ḳerav liḳro betora</tei:l>
          <tei:l>bereshit bara</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
