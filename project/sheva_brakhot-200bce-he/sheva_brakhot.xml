    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:sheva_brakhot">
        <tei:head>שבע ברכות</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:sheva_brakhot/1"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>שֶׁהַכֹּל בָּרָא</tei:l>
          <tei:l>לִכְבוֹדוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:sheva_brakhot/2"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>יוֹצֵר הָאָדָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:sheva_brakhot/3"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>אֲשֶׁר יָצַר אֶת־הָאָדָם</tei:l>
          <tei:l>בְּצַלְמוֹ,</tei:l>
          <tei:l>בְּצֶֽלֶם דְּמוּת תַּבְנִיתוֹ</tei:l>
          <tei:l>וְהִתְקִין לוֹ</tei:l>
          <tei:l>מִמֶּֽנּוּ</tei:l>
          <tei:l>בִּנְיַן עֲדֵי־עַד.</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>יוֹצֵר הָאָדָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:sheva_brakhot/4"/>
        <tei:lg>
          <tei:l>שׂוֹשׂ תָּשִׂישׂ</tei:l>
          <tei:l>וְתָגֵל (<tei:note type="instruction">נ״א:</tei:note> הָ)עֲקָרָה</tei:l>
          <tei:l>בְּקִבּוּץ בָּנֶֽיהָ</tei:l>
          <tei:l>לְתוֹכָהּ</tei:l>
          <tei:l>(<tei:note type="instruction">נ״ס:</tei:note> בִּמְהֵרָה) בְּשִׂמְחָה.</tei:l>
          <tei:l>‏בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>מְשַׂמֵּֽחַ צִיּוֹן</tei:l>
          <tei:l>בְּבָנֶֽיהָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:sheva_brakhot/5"/>
        <tei:lg>
          <tei:l>שַׂמֵּֽחַ תְּשַׂמַּח</tei:l>
          <tei:l>רֵעִים הָאֲהוּבִים כְּשַׂמֵּחֲךְ(ךָ)</tei:l>
          <tei:l>יְצִירָךְ (<tei:note type="instruction">נ״א:</tei:note> יְצִירְךָ) בְּגַן עֵֽדֶן</tei:l>
          <tei:l>מִקֶּֽדֶם.</tei:l>
          <tei:l>‏בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>מְשַׂמֵּֽחַ חָתָן וְכַלָּה׃‏</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:sheva_brakhot/6"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>אֲשֶׁר בָּרָא שָׂשׂוֹן וְשִׂמְחָה</tei:l>
          <tei:l>חָתָן וְכַלָּה</tei:l>
          <tei:l>גִּילָה רִנָּה דִּיצָה וְחֶדְוָה</tei:l>
          <tei:l>אַהֲבָה וְאַחְוָה</tei:l>
          <tei:l>(<tei:note type="instruction">נ״א:</tei:note> וְ)שָׁלוֹם וְרֵעוּת.</tei:l>
          <tei:l>מְהֵרָה</tei:l>
          <tei:l>יְיָ אֱלֹהֵֽינוּ</tei:l>
          <tei:l>יִשָּׁמַע בְּעָרֵי יְהוּדָה</tei:l>
          <tei:l>וּבְחֻצוֹת יְרוּשָׁלָםִ</tei:l>
          <tei:l>קוֹל שָׂשׂוֹן וְקוֹל שִׂמְחָה</tei:l>
          <tei:l>קוֹל חָתָן וְקוֹל כַּלָּה</tei:l>
          <tei:l>קוֹל מִצְהֲלוֹת (<tei:note type="instruction">נ״ס:</tei:note> חֻפּוֹת)</tei:l>
          <tei:l>חֲתָנִים מֵֽחֻפָּתָם</tei:l>
          <tei:l>וּנְעָרִים</tei:l>
          <tei:l>מִמִּשְׁתֵּה נְגִינָתָם.</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>מְשַׂמֵּֽחַ (<tei:note type="instruction">נ״ס:</tei:note> הֶֽ)חָתָן</tei:l>
          <tei:l>עִם הַכַּלָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:sheva_brakhot/7"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>בּוֹרֵא פְּרִי הַגֶּֽפֶן (<tei:note type="instruction">נ״א:</tei:note> הַגָּֽפֶן)׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
