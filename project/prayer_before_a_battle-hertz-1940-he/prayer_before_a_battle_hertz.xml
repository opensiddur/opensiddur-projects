  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_before_a_battle_hertz">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_before_a_battle_hertz/1"/>
        <tei:lg>
          <tei:l>אָבִֽינוּ שֶׁבַּשָּׁמַֽיִם.</tei:l>
          <tei:l>עֲשֵׂה רְצוֹנְךָ בַּשָּׁמַֽיִם מִמַּֽעַל.</tei:l>
          <tei:l>וְתֵן נַֽחַת רֽוּחַ לֽירֵאֶֽיךָ מִתָּֽחַת.</tei:l>
          <tei:l>וְהַטּוֹב בְּעֵינֶֽיךָ עֲשֵׂה. <tei:bibl>(ברכות כט ב׳)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_before_a_battle_hertz/3"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ שׁוֹמֵֽעַ תְּפִלָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_before_a_battle_hertz/4"/>
        <tei:lg>
          <tei:l>בְּיָדְךָ אַפְקִיד רוּחִי.</tei:l>
          <tei:l>פָּדִֽיתָה אֹתִי יְיָ אֵל אֱמֶת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_before_a_battle_hertz/5"/>
        <tei:lg>
          <tei:l>שְׁמַע יִשְׂרָאֵל יְיָ אֱלֹהֵינוּ יְיָ אֶחָד׃</tei:l>
          <tei:l>בָּרוּךְ שֵׁם</tei:l>
          <tei:l>כְּבוֹד מַלְכוּתוֹ לְעוֹלָם וָעֶד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_before_a_battle_hertz/6"/>
        <tei:lg>
          <tei:l>אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
