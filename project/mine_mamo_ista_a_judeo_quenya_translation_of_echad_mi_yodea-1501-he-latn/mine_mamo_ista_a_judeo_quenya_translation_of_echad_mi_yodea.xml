        <tei:lg xml:lang="qya-Hebr">
          <tei:l>מִנֶי מַמוֹ אִסְטַה?</tei:l>
          <tei:l>מִנֶי אִסְטַנְיֶי טַנַה!</tei:l>
          <tei:l>מִנֶי נָה אֶרֻא יֶי אוֹר מֶנֶל קֶמֶנְיֶי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:mine_mamo_ista_a_judeo_quenya_translation_of_echad_mi_yodea/2"/>
