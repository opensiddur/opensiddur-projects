  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:man_kevatakh">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:man_kevatakh/1"/>
        <tei:lg xml:lang="he">
          <tei:l>מַן־כְּוָתָךְ</tei:l>
          <tei:l><tei:seg type="acrostic">אַ</tei:seg>רְיָה נַהֲמָאאֲמַר מֹשֶׁה׃</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>קַלֵיהּ נָהֵים וּמַרְעִישׁ עַלְמָאאָמְרִין מַלְאָכַיָּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:man_kevatakh/2"/>
        <tei:lg xml:lang="he">
          <tei:l>מַן־כְּוָתָךְ</tei:l>
          <tei:l><tei:seg type="acrostic">גִּ</tei:seg>יבוֹר בְּגֵיוְתָאאֲמַר מֹשֶׁה׃</tei:l>
          <tei:l><tei:seg type="acrostic">דְּ</tei:seg>כוּלֵיהּ עַלְמָא מִנָּךְ מְתַתְּתָּאאָמְרִין מַלְאָכַיָּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:man_kevatakh/3"/>
        <tei:lg xml:lang="he">
          <tei:l>מַן־כְּוָתָךְ</tei:l>
          <tei:l><tei:seg type="acrostic">הֲ</tei:seg>דוֹר בְּקֻדְשָׁא אֲמַר מֹשֶׁה׃</tei:l>
          <tei:l><tei:seg type="acrostic">וַ</tei:seg>עֲבַד נִיסִן בְּצַפְרָא וּבְרַמְשָׁא אָמְרִין מַלְאָכַיָּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:man_kevatakh/4"/>
        <tei:lg xml:lang="he">
          <tei:l>מַן־כְּוָתָךְ</tei:l>
          <tei:l><tei:seg type="acrostic">ז</tei:seg>וֹקֵף כְּפוּפִיםאֲמַר מֹשֶׁה׃</tei:l>
          <tei:l><tei:seg type="acrostic">חָ</tei:seg>מֵי מִסְכֵּינִים וְזָיֵין סְכִיפִין אָמְרִין מַלְאָכַיָּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:man_kevatakh/5"/>
        <tei:lg xml:lang="he">
          <tei:l>מַן־כְּוָתָךְ</tei:l>
          <tei:l><tei:seg type="acrostic">טָ</tei:seg>בָא וּמֵיטִיבָא אֲמַר מֹשֶׁה׃</tei:l>
          <tei:l><tei:seg type="acrostic">יְ</tei:seg>הַב לִבְרִיָתָא אוֹצָרֵיהּ טָבָא אָמְרִין מַלְאָכַיָּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:man_kevatakh/6"/>
        <tei:lg xml:lang="he">
          <tei:l>מַן־כְּוָתָךְ</tei:l>
          <tei:l><tei:seg type="acrostic">כּ</tei:seg>וֹבֵשׁ חוֹבִיןאֲמַר מֹשֶׁה׃</tei:l>
          <tei:l><tei:seg type="acrostic">לִֹ</tei:seg>ידֵהּ מְקָרֵב טוּבָן דְּתַיְבִין אָמְרִין מַלְאָכַיָּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:man_kevatakh/7"/>
        <tei:lg xml:lang="he">
          <tei:l>מַן־כְּוָתָךְ</tei:l>
          <tei:l><tei:seg type="acrostic">מֶ</tei:seg>לֶךְ מַלְכַיָּאאֲמַר מֹשֶׁה׃</tei:l>
          <tei:l><tei:seg type="acrostic">נְ</tei:seg>סַב אַרְכַּיּיָא מִן־כׇּל־אִיפַּרְכַיָּא אָמְרִין מַלְאָכַיָּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:man_kevatakh/8"/>
        <tei:lg xml:lang="he">
          <tei:l>מַן־כְּוָתָךְ</tei:l>
          <tei:l><tei:seg type="acrostic">ס</tei:seg>וֹמֵךְ נוֹפְלִיםאֲמַר מֹשֶׁה׃</tei:l>
          <tei:l><tei:seg type="acrostic">ע</tei:seg>וֹנֶה עֲלוּבִים דהוו מוּשְׁפָּלִים אָמְרִין מַלְאָכַיָּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:man_kevatakh/9"/>
        <tei:lg xml:lang="he">
          <tei:l>מַן־כְּוָתָךְ</tei:l>
          <tei:l><tei:seg type="acrostic">פּ</tei:seg>וֹדֶה וְחוֹבֵשׁאֲמַר מֹשֶׁה׃</tei:l>
          <tei:l><tei:seg type="acrostic">צְ</tei:seg>דָקָה לוֹבֵשׁ נְקָמָה מִתְלָבֵּשׁ אָמְרִין מַלְאָכַיָּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:man_kevatakh/10"/>
        <tei:lg xml:lang="he">
          <tei:l>מַן־כְּוָתָךְ</tei:l>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>רֵב לְעַבְדָּךְ אֲמַר מֹשֶׁה׃</tei:l>
          <tei:l><tei:seg type="acrostic">רַ</tei:seg>בְרְבִין עוּבְדָּךְ וְכוֹלָּא עוֹבָדֵי יְדָךְאָמְרִין מַלְאָכַיָּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:man_kevatakh/11"/>
        <tei:lg xml:lang="he">
          <tei:l>מַן־כְּוָתָךְ</tei:l>
          <tei:l><tei:seg type="acrostic">שָׁ</tei:seg>לִיט בְּאֶכְּסוּסְיָאאֲמַר מֹשֶׁה׃</tei:l>
          <tei:l>יָהּ עָבֵיד נִיסַיָּא עֲמֻסַיָּא אָמְרִין מַלְאָכַיָּא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:man_kevatakh/12"/>
        <tei:lg xml:lang="he">
          <tei:l>מַן־כְּוָתָךְ</tei:l>
          <tei:l><tei:seg type="acrostic">תַּ</tei:seg>קִּיף בְּאֶרְאֶלִּים אֲמַר מֹשֶׁה</tei:l>
          <tei:l>לִשְׁמָךְ מְהַלְלִים — מִֽי־כָמֹ֤כָה בָּֽאֵלִם֙ אָמְרִין מַלְאָכַיָּא׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
