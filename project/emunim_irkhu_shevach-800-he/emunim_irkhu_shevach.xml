  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:emunim_irkhu_shevach">
        <tei:head>אֱמוּנִים עִרְכוּ שֶֽׁבַח</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunim_irkhu_shevach/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אֱ֯</tei:seg>מוּנִים עִרְכוּ שֶֽׁבַח</tei:l>
          <tei:l>לָאֵל וְטִבְחוּ טֶֽבַח</tei:l>
          <tei:l>וַאֲמַרְתֶּ֡ם זֶֽבַח־פֶּ֨סַח</tei:l>
          <tei:l>ה֜וּא לֽיהו֗ה׃ <tei:bibl>(שמות יב:כז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunim_irkhu_shevach/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הָ֯</tei:seg>רִֽימוּ קוֹל שִׁירִים</tei:l>
          <tei:l>שִׂמְחוּ בְּלֵיל־שִׁמּוּרִים</tei:l>
          <tei:l>עַל־מַצּ֥וֹת וּמְרֹרִ֖ים</tei:l>
          <tei:l>אִכְלוּ וּשְׁתוּ יֵינָי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunim_irkhu_shevach/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רִ֯</tei:seg>אשׁוֹן לְכׇל־רִאשׁוֹנִים</tei:l>
          <tei:l>עַל־יַד צִיר אֱמוּנִים</tei:l>
          <tei:l>מִיַּד כׇּל־מְעַנִּים</tei:l>
          <tei:l>הִצִּיל כׇּל־הֲמוֹנָי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunim_irkhu_shevach/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נִ֯</tei:seg>סֵּי אֵל זָכַֽרְתִּי</tei:l>
          <tei:l>וַחֲסָדָיו סִפַּֽרְתִּי</tei:l>
          <tei:l>עַתָּ֣ה יָדַ֔עְתִּי</tei:l>
          <tei:l>כִּֽי־גָד֥וֹל יהו֖ה׃ <tei:bibl>(שמות יח:יא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunim_irkhu_shevach/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כְּ֯</tei:seg>כוֹכְבֵי הַשָּׁמַיִם</tei:l>
          <tei:l>מְנַשֶּׁה וְאֶפְרַיִם</tei:l>
          <tei:l>יָצְאוּ מִמִּצְרַיִם</tei:l>
          <tei:l>כׇּל־צִבְאוֹת יהוה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunim_irkhu_shevach/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הִ֯</tei:seg>נְחִיל תּוֹרָתוֹ</tei:l>
          <tei:l>לְעַמּוֹ וַעֲדָתוֹ</tei:l>
          <tei:l>שׁוֹמְרֵי מִצְוָתוֹ</tei:l>
          <tei:l>עַם נוֹשַׁע בַּיהוה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunim_irkhu_shevach/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נִ֯</tei:seg>פְלָאִים מַעֲשֶֽׂיךָ</tei:l>
          <tei:l>וַעֲצוּמִים נִסֶּֽיךָ</tei:l>
          <tei:l>יֹאמְרוּ כׇּל־חוֹסֶיךָ</tei:l>
          <tei:l>ט֗וֹב לַחֲס֥וֹת בַּיהו֑ה׃ <tei:bibl>(תהלים קיח:ח-ט)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
