  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ki_vo_yishteh_tzaddiq_tamim_mohr">
        <tei:head>כִּי בוֹ יִשְׁתֶּה צַדִּיק תָּמִים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ki_vo_yishteh_tzaddiq_tamim_mohr/1"/>
        <tei:lg>
          <tei:l>יוֹם זֶה מְכֻבָּד מִכׇּל־יָמִים</tei:l>
          <tei:l>כִּי בוֹ יִשְׁתֶּה צַדִּיק תָּמִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ki_vo_yishteh_tzaddiq_tamim_mohr/2"/>
        <tei:lg>
          <tei:l>כׇּל־הַשָּׁנָה תַּעֲשֶׂה מְלַאכְתֶּֽךָ</tei:l>
          <tei:l>וְיוֹם הַפּוּרִים לְיֵינֶֽךָ</tei:l>
          <tei:l>פּוּרִים לֹא תַּעֲשֶׂה בּוֹ מְלָאכָה</tei:l>
          <tei:l>כִּי חַג הוּא לִפְרִי הַכְּרָמִים׃</tei:l>
          <tei:l>יוֹם זֶה...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ki_vo_yishteh_tzaddiq_tamim_mohr/3"/>
        <tei:lg>
          <tei:l>רִאשׁוֹן הוּא לִימֵי שִׁכָּרוֹן</tei:l>
          <tei:l>יוֹם מִשְׁתֶּה יוֹם עֲבֹדַת גָּרוֹן</tei:l>
          <tei:l>עַל־כֵּן כׇּל־אִישׁ בְּיֵינוֹ יָרוֹן</tei:l>
          <tei:l>עַל־שְׁתֵּי כּוֹסוֹת יִבְצְעוּ תְּמִימִים׃</tei:l>
          <tei:l>יוֹם זֶה...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ki_vo_yishteh_tzaddiq_tamim_mohr/4"/>
        <tei:lg>
          <tei:l>אֱכֹל לְבִיבוֹת שְׁתֵה יֵין עָסִיס</tei:l>
          <tei:l>כִּי הַיַּֽיִן יִתֶּן לְכׇל־בּוֹ יָשִׂישׂ</tei:l>
          <tei:l>אוֹר פְּנֵי מֶֽלֶךְ כַּשֶּֽׁמֶן כָּתִית</tei:l>
          <tei:l>מַרְפֵּה לְנֶֽפֶשׁ וְאֹֽרֶךְ יָמִים׃</tei:l>
          <tei:l>יוֹם זֶה...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ki_vo_yishteh_tzaddiq_tamim_mohr/5"/>
        <tei:lg>
          <tei:l>לֹא תֶּחְסַר כׇּל־בּוֹ וְשָׁתִֽיתָ וְשָׂמַֽחְתָּ</tei:l>
          <tei:l>וּבֵרַֽכְתָּ אֶת־הַיַּֽיִן עַל־הַשֻּׁלְחָן עָרַֽכְתָּ</tei:l>
          <tei:l>יִשְׂמַח גַּם־הֶעָנִי בְּמָנוֹת שָׁלַֽחְתָּ</tei:l>
          <tei:l>כִּי־אָסוּר בְּפוּרִים פָּנִים נִזְעָמִים׃</tei:l>
          <tei:l>יוֹם זֶה...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ki_vo_yishteh_tzaddiq_tamim_mohr/6"/>
        <tei:lg>
          <tei:l>הַכּוֹסוֹת מְסַפְּרִים כְּבוֹדוֹ</tei:l>
          <tei:l>וְגַם הַמַּרְתֵּף מָלֵא חַסְדּוֹ</tei:l>
          <tei:l>רְאוּ כִּי כׇּל־אֵֽלֶּה עָשָׂה יָדוֹ</tei:l>
          <tei:l>כִּי מִשְׁתֶּה הוּא לְבוֹעֲרִים וַחֲכָמִים׃</tei:l>
          <tei:l>יוֹם זֶה...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
