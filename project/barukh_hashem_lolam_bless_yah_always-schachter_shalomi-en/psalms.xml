  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms">
        <tei:head>Barukh Hashem l'Olam :: Bless Yah Always, translated by Rabbi Zalman Schachter-Shalomi</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/89/53"/>
        <tei:lg>
          <tei:l><tei:hi rend="italic">Barukh</tei:hi> <j:divineName>Yah</j:divineName> always, <tei:hi rend="italic">Amen</tei:hi>, <tei:hi rend="italic">Amen</tei:hi>. <tei:bibl>(Psalms 89:53)</tei:bibl></tei:l>
          <tei:l>From Tsiyyon,</tei:l>
          <tei:l>From your dwelling</tei:l>
          <tei:l>in Yerushalayim,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>We send our Hallelu-<j:divineName>Yah</j:divineName>. <tei:bibl>(Psalms 135:21)</tei:bibl></tei:l>
          <tei:l><tei:hi rend="italic">Barukh</tei:hi>, too, to you, <j:divineName>Yah</j:divineName>,</tei:l>
          <tei:l><j:divineName>Yisrael’s god</j:divineName>,</tei:l>
          <tei:l>Who alone, does amazing things. <tei:bibl>(Psalms 72:18)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/72/19"/>
        <tei:lg>
          <tei:l>May the glorious <j:divineName>Presence</j:divineName>,</tei:l>
          <tei:l>Governing numberless worlds,</tei:l>
          <tei:l>Manifest in this world</tei:l>
          <tei:l>In all magnificence, <tei:hi rend="italic">Amen</tei:hi>, <tei:hi rend="italic">Amen</tei:hi>. <tei:bibl>(Psalms 72:19)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
