          <tei:l>בְּנֵה בֵּיתְךָ בְּקָרוֹב.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_hu/3"/>
        <tei:lg>
