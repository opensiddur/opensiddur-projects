        <tei:head>אַדִּיר הוּא</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_hu/1"/>
        <tei:lg>
          <tei:l>אַדִּיר הוּא</tei:l>
          <tei:l>יִבְנֶה בֵּיתוֹ בְּקָרוֹב.</tei:l>
          <tei:l>בִּמְהֵרָה בְּיָמֵינוּ בְּקָרוֹב.</tei:l>
          <tei:l>אֵל בְּנֵה בְּנֵה בְּנֵה,</tei:l>
          <tei:l>בְּנֵה בֵּיתְךָ בְּקָרוֹב.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_hu/2"/>
