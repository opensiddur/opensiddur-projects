    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:hashem_boqer_eerokh_lakh_paytan">
        <tei:head>יְיָ בּוֹקֶר אֶעֱרוֹךְ לְךָ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hashem_boqer_eerokh_lakh_paytan/1"/>
        <tei:lg>
          <tei:l>יְיָ בּוֹקֶר אֶעֱרוֹךְ לְךָ</tei:l>
          <tei:l>גַם בוֹקֶר תִּשְּׁמַע קוֹלִי בְּחַסְדְךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hashem_boqer_eerokh_lakh_paytan/2"/>
        <tei:lg>
          <tei:l>שְׁמַע קוֹלִי יוֹשֵּׁב שָּׁמַיִם</tei:l>
          <tei:l>עֶרֶב וָבוֹקֶר וְצָהֳרָיִם</tei:l>
          <tei:l>לְךָ נָשָׁאתִי לֵב גַם עֵינַיִם</tei:l>
          <tei:l>וּבְרוֹב חֲסָדֶיךָ אָבֹא בֵיתֶיךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hashem_boqer_eerokh_lakh_paytan/3"/>
        <tei:lg>
          <tei:l>לִבִּי סְחַרְחַר עֲזַבַנִי כֹּחִי</tei:l>
          <tei:l>כִּי אֶזְכְּרָה חַטָּאתִי בְרוּחִי</tei:l>
          <tei:l>לָכֵן יָרֵאתִי אֵן אָבוֹא בְּאָרְחִי</tei:l>
          <tei:l>אֶשְׁתַּחֲוֶה אֶל הֵיכַל בֵיתֶךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hashem_boqer_eerokh_lakh_paytan/4"/>
        <tei:lg>
          <tei:l>מִי יִתֵּן לִי אֵבֶר כַּיוֹנָה</tei:l>
          <tei:l>מִפַחְדְךָ אָעוּפָּה וְאֶשְׁכּוֹנָה</tei:l>
          <tei:l>אִם אֶסַּק שַׁמַיִם שָׁם אַתָּה מְעוֹנָה</tei:l>
          <tei:l>יְיָ נְחֵנִי בְּצִדְקָתֶיךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hashem_boqer_eerokh_lakh_paytan/5"/>
        <tei:lg>
          <tei:l>הַלְּלִי נַפְשִׁי אֱלֹהִים תָּמִיד</tei:l>
          <tei:l>לֵב לָשּׁוֹן קָשׁוּר כִפְתִיל צָמִיד</tei:l>
          <tei:l>הוּא יוֹצֵר הַכׇּל וְהַכׇּל מַעַמִיד</tei:l>
          <tei:l>הוּא עָשְׂךָ וַיְכוֹנְנֶךָ׃ <tei:bibl>(דברים לב:ו)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
