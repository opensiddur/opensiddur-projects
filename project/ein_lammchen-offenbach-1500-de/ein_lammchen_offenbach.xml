  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ein_lammchen_offenbach">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ein_lammchen_offenbach/1"/>
        <tei:lg>
          <tei:l>Ein Lämmchen, ein Lämmchen!</tei:l>
          <tei:l>Es kaufte sich mein Vater,</tei:l>
          <tei:l>zwei Susse galt der Kauf.</tei:l>
          <tei:l>Ein Lämmchen.</tei:l>
          <tei:l>Da kam voll Tück’ und Hader,</tei:l>
          <tei:l>die Katz’ und fraß es auf,</tei:l>
          <tei:l>das Lämmchen.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ein_lammchen_offenbach/2"/>
        <tei:lg>
          <tei:l>Ein Hund, den es verdrossen,</tei:l>
          <tei:l>dass floss unschuldig Blut</tei:l>
          <tei:l>vom Lämmchen,</tei:l>
          <tei:l>kam pfeilschnell hergeschossen,</tei:l>
          <tei:l>zerriss die Katz’ in Wut,</tei:l>
          <tei:l>ums Lämmchen.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ein_lammchen_offenbach/3"/>
        <tei:lg>
          <tei:l>Ein Stock stand nah beim Hunde,</tei:l>
          <tei:l>der lang ihm schon gedroht,</tei:l>
          <tei:l>ums Lämmchen.</tei:l>
          <tei:l>Er schlug zur selben Stunde</tei:l>
          <tei:l>den Hund, er schlug ihn tot.</tei:l>
          <tei:l>ums Lämmchen.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ein_lammchen_offenbach/4"/>
        <tei:lg>
          <tei:l>Am glüh’nden Feuerherde</tei:l>
          <tei:l>der Stock den Rächer fand.</tei:l>
          <tei:l>ums Lämmchen.</tei:l>
          <tei:l>Die Flamme ihn verzehrte</tei:l>
          <tei:l>und schnell war er verbrannt.</tei:l>
          <tei:l>ums Lämmchen.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ein_lammchen_offenbach/5"/>
        <tei:lg>
          <tei:l>Da sprudelt eine Quelle,</tei:l>
          <tei:l>das Wasser strömt heraus;</tei:l>
          <tei:l>ums Lämmchen.</tei:l>
          <tei:l>Es floss zur Brandes Stelle</tei:l>
          <tei:l>und löscht das Feuer aus;</tei:l>
          <tei:l>ums Lämmchen.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ein_lammchen_offenbach/6"/>
        <tei:lg>
          <tei:l>Ein durts’ger Ochse eilte</tei:l>
          <tei:l>zur Wasserquelle schnell;</tei:l>
          <tei:l>ums Lämmchen.</tei:l>
          <tei:l>Er trank daraus und weilte,</tei:l>
          <tei:l>bis trocken war der Quell.</tei:l>
          <tei:l>ums Lämmchen.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ein_lammchen_offenbach/7"/>
        <tei:lg>
          <tei:l>Da ward der Ochs ergriffen</tei:l>
          <tei:l>Vom Schlächter mit Gewalt!</tei:l>
          <tei:l>ums Lämmchen.</tei:l>
          <tei:l>Das Messer ward geschliffen,</tei:l>
          <tei:l>Geschlachtet war er bald;</tei:l>
          <tei:l>ums Lämmchen.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ein_lammchen_offenbach/8"/>
        <tei:lg>
          <tei:l>Dem Schlächter nahle leise</tei:l>
          <tei:l>der Todesengel sich,</tei:l>
          <tei:l>ums Lämmchen.</tei:l>
          <tei:l>Er tat nach seiner Weise —</tei:l>
          <tei:l>Der Schlächter drauf verblich.</tei:l>
          <tei:l>ums Lämmchen.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ein_lammchen_offenbach/9"/>
        <tei:lg>
          <tei:l>Gott richtet Welt und Wesen!</tei:l>
          <tei:l>Die Guten, wie die Bösen.</tei:l>
          <tei:l>Der Würger gab er Tod zum Lohn,</tei:l>
          <tei:l>weil er gewürgt des Menschen Sohn.</tei:l>
          <tei:l>Der hingeführt zur Schlächterbank</tei:l>
          <tei:l>den Ochsen, der das Wasser trank,</tei:l>
          <tei:l>das ausgelöscht den Feuerbrand,</tei:l>
          <tei:l>in dem der Stock den Rächer fand,</tei:l>
          <tei:l>der Stock, der ohne Recht und Fug</tei:l>
          <tei:l>den Hund tot auf der Stelle schlug,</tei:l>
          <tei:l>der in der Wut die Katz’ zerriss,</tei:l>
          <tei:l>die das unschuld’ge Lämmchen biss,</tei:l>
          <tei:l>das Lämmchen meinem Vater war,</tei:l>
          <tei:l>er kauft’ es für zwei Susse bar.</tei:l>
          <tei:l>Das Lämmchen!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
