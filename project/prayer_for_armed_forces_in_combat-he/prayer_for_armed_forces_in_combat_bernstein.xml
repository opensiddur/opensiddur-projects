  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_armed_forces_in_combat_bernstein">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_armed_forces_in_combat_bernstein/1"/>
        <tei:lg>
          <tei:l>עַל מָה עָלֵינוּ לְהִתְפַּלֵּל, רִבּוֹנוֹ שֶׁל עוֹלָם?</tei:l>
          <tei:l>עַל עֹוז וְתַעֲצוּמוֹת?</tei:l>
          <tei:l>עַל נִצָּחוֹן?</tei:l>
          <tei:l>עַל שָׁלוֹם הַבָּא בִּמְהֵרָה?</tei:l>
          <tei:l>אָכֵן!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_armed_forces_in_combat_bernstein/2"/>
        <tei:lg>
          <tei:l>אַךְ מִתְפַּלְּלִים אָנוּ גַּם</tei:l>
          <tei:l>לִהְיוֹת רְאוּיִם</tei:l>
          <tei:l>לֶאֱמוּנַת</tei:l>
          <tei:l>יַקִּירֵינוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_armed_forces_in_combat_bernstein/3"/>
        <tei:lg>
          <tei:l>נְבַקֵּשׁ עֶזְרָתְךָ</tei:l>
          <tei:l>לְבַל תֵּחָלֵד נַפְשֵׁנוּ</tei:l>
          <tei:l>בַּמְּלָאכָה הַקָּשָׁה</tei:l>
          <tei:l>אֲשֶׁר עָלֵינוּ לַעֲשׂוֹת.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_armed_forces_in_combat_bernstein/4"/>
        <tei:lg>
          <tei:l>וּמֵעַל לַכֹּל, הָאֵר עֵינֵינוּ לִרְאוֹת</tei:l>
          <tei:l>כִּי לְמַעַנְךָ הֵם קָרְבְּנוֹתֵינוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_armed_forces_in_combat_bernstein/5"/>
        <tei:lg>
          <tei:l>אָמֵן.</tei:l>
        </tei:lg>
      </tei:div>
