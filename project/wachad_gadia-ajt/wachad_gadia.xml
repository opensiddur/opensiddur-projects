      <tei:div corresp="urn:x-opensiddur:text:poem:wachad_gadia">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wachad_gadia/1"/>
        <tei:lg>
          <tei:l>וַואחַד גַּדְיָא וַואחַד גַּדְיָא</tei:l>
          <tei:l>אֶלְדִי שְׁרָא לִי בָּאבָּא</tei:l>
          <tei:l>בְּזוּז פְלוּס׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wachad_gadia/2"/>
        <tei:lg>
          <tei:l>וּזָׄאת אֶלְקַטּוּס</tei:l>
          <tei:l>וּכְּלָאת אֶזְׄדִי,</tei:l>
          <tei:l>אֶלְדִי שְׁרָא לִי</tei:l>
          <tei:l>בָּאבָּא בְּזוּז פְלוּס</tei:l>
          <tei:l>וַואחַד גַּדְיָא וַואחַד גַּדְיָא</tei:l>
          <tei:l>אֶלְדִי שְׁרָא לִי בָּאבָּא</tei:l>
          <tei:l>בְּזוּז פְלוּס׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wachad_gadia/3"/>
        <tei:lg>
          <tei:l>וּזָׄאת אֶלְכַּלְבָּה̈</tei:l>
          <tei:l>וּגֶׄדְמַת אֶלְקַטּוּס,</tei:l>
          <tei:l>אֶלְדִי כְּלָאת אֶזְׄדִי,</tei:l>
          <tei:l>אֶלְדִי שְׁרָא לִי</tei:l>
          <tei:l>בָּאבָּא בְּזוּז פְלוּס</tei:l>
          <tei:l>וַואחַד גַּדְיָא וַואחַד גַּדְיָא</tei:l>
          <tei:l>אֶלְדִי שְׁרָא לִי בָּאבָּא</tei:l>
          <tei:l>בְּזוּז פְלוּס׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wachad_gadia/4"/>
        <tei:lg>
          <tei:l>וּזָׄאת אֶלְעַסָא</tei:l>
          <tei:l>וּדַרְבֶּת אֶלְכַּלְבָּה̈</tei:l>
          <tei:l>אֶלְדִי גֶׄדְמַת אֶלְקַטּוּס,</tei:l>
          <tei:l>אֶלְדִי כְּלָאת אֶזְׄדִי,</tei:l>
          <tei:l>אֶלְדִי שְׁרָא לִי</tei:l>
          <tei:l>בָּאבָּא בְּזוּז פְלוּס</tei:l>
          <tei:l>וַואחַד גַּדְיָא וַואחַד גַּדְיָא</tei:l>
          <tei:l>אֶלְדִי שְׁרָא לִי בָּאבָּא</tei:l>
          <tei:l>בְּזוּז פְלוּס׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wachad_gadia/5"/>
        <tei:lg>
          <tei:l>וּזָׄא אַ[ל]נָּאר</tei:l>
          <tei:l>וּאַחְרַק אֶלְעַסָא</tei:l>
          <tei:l>אֶלְדִי דַרְבֶּת אֶלְכַּלְבָּה̈,</tei:l>
          <tei:l>אֶלְדִי גֶׄדְמַת אֶלְקַטּוּס,</tei:l>
          <tei:l>אֶלְדִי כְּלָאת אֶזְׄדִי,</tei:l>
          <tei:l>אֶלְדִי שְׁרָא לִי</tei:l>
          <tei:l>בָּאבָּא בְּזוּז פְלוּס</tei:l>
          <tei:l>וַואחַד גַּדְיָא וַואחַד גַּדְיָא</tei:l>
          <tei:l>אֶלְדִי שְׁרָא לִי בָּאבָּא</tei:l>
          <tei:l>בְּזוּז פְלוּס׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wachad_gadia/6"/>
        <tei:lg>
          <tei:l>וּזָׄא אֶלְמָאה̈</tei:l>
          <tei:l>וּטְפָא אַ[ל]נָּאר</tei:l>
          <tei:l>אֶלְדִי אַחְרַק אֶלְעַסָא,</tei:l>
          <tei:l>אֶלְדִי דַרְבֶּת אֶלְכַּלְבָּה̈,</tei:l>
          <tei:l>אֶלְדִי גֶׄדְמַת אֶלְקַטּוּס,</tei:l>
          <tei:l>אֶלְדִי כְּלָאת אֶזְׄדִי,</tei:l>
          <tei:l>אֶלְדִי שְׁרָא לִי</tei:l>
          <tei:l>בָּאבָּא בְּזוּז פְלוּס</tei:l>
          <tei:l>וַואחַד גַּדְיָא וַואחַד גַּדְיָא</tei:l>
          <tei:l>אֶלְדִי שְׁרָא לִי בָּאבָּא</tei:l>
          <tei:l>בְּזוּז פְלוּס׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wachad_gadia/7"/>
        <tei:lg>
          <tei:l>וּזָׄא אַ[ל]תַּור</tei:l>
          <tei:l>וּשְׁרַבּ אֶלְמָאה̈,</tei:l>
          <tei:l>אֶלְדִי טְפָא אַ[ל]נָּאר,</tei:l>
          <tei:l>אֶלְדִי אַחְרַק אֶלְעַסָא,</tei:l>
          <tei:l>אֶלְדִי דַרְבֶּת אֶלְכַּלְבָּה̈,</tei:l>
          <tei:l>אֶלְדִי גֶׄדְמַת אֶלְקַטּוּס,</tei:l>
          <tei:l>אֶלְדִי כְּלָאת אֶזְׄדִי,</tei:l>
          <tei:l>אֶלְדִי שְׁרָא לִי בָּאבָּא</tei:l>
          <tei:l>בְּזוּז פְלוּס׃</tei:l>
          <tei:l>וַואחַד גַּדְיָא וַואחַד גַּדְיָא</tei:l>
          <tei:l>אֶלְדִי שְׁרָא לִי בָּאבָּא</tei:l>
          <tei:l>בְּזוּז פְלוּס׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wachad_gadia/8"/>
        <tei:lg>
          <tei:l>וּזָׄא אֶ[ל]דַבָּאח</tei:l>
          <tei:l>וּדְבַּח אַ[ל]תַּוּר</tei:l>
          <tei:l>אֶלְדִי שְׁרַבּ אֶלְמָאה̈,</tei:l>
          <tei:l>אֶלְדִי טְפָא אַ[ל]נָּאר,</tei:l>
          <tei:l>אֶלְדִי אַחְרַק אֶלְעַסָא,</tei:l>
          <tei:l>אֶלְדִי דַרְבֶּת אֶלְכַּלְבָּה̈,</tei:l>
          <tei:l>אֶלְדִי גֶׄדְמַת אֶלְקַטּוּס,</tei:l>
          <tei:l>אֶלְדִי כְּלָאת אֶזְׄדִי,</tei:l>
          <tei:l>אֶלְדִי שְׁרָא לִי</tei:l>
          <tei:l>בָּאבָּא בְּזוּז פְלוּס</tei:l>
          <tei:l>וַואחַד גַּדְיָא וַואחַד גַּדְיָא</tei:l>
          <tei:l>אֶלְדִי שְׁרָא לִי בָּאבָּא</tei:l>
          <tei:l>בְּזוּז פְלוּס׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wachad_gadia/9"/>
        <tei:lg>
          <tei:l>וּזָׄא מֶּלְךְּ אֶל־מוּת</tei:l>
          <tei:l>וּדְבַּח אֶ[ל]דַבָּאח</tei:l>
          <tei:l>אֶלְדִי דְבַּח אַ[ל]תַּוּר</tei:l>
          <tei:l>אֶלְדִי שְׁרַבּ אֶלְמָאה̈,</tei:l>
          <tei:l>אֶלְדִי טְפָא אַ[ל]נָּאר,</tei:l>
          <tei:l>אֶלְדִי אַחְרַק אֶלְעַסָא,</tei:l>
          <tei:l>אֶלְדִי דַרְבֶּת אֶלְכַּלְבָּה̈,</tei:l>
          <tei:l>אֶלְדִי גֶׄדְמַת אֶלְקַטּוּס,</tei:l>
          <tei:l>אֶלְדִי כְּלָאת אֶזְׄדִי,</tei:l>
          <tei:l>אֶלְדִי שְׁרָא לִי</tei:l>
          <tei:l>בָּאבָּא בְּזוּז פְלוּס</tei:l>
          <tei:l>וַואחַד גַּדְיָא וַואחַד גַּדְיָא</tei:l>
          <tei:l>אֶלְדִי שְׁרָא לִי בָּאבָּא</tei:l>
          <tei:l>בְּזוּז פְלוּס׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wachad_gadia/10"/>
        <tei:lg>
          <tei:l>וּזָׄא הַקָּדוֹשׁ בָּרוּךְ הוּא</tei:l>
          <tei:l>וּדְבַּח מֶּלְךְּ אֶל־מוּת</tei:l>
          <tei:l>אֶלְדִי דְבַּח אֶ[ל]דַבָּאח</tei:l>
          <tei:l>אֶלְדִי דְבַּח אַ[ל]תַּוּר</tei:l>
          <tei:l>אֶלְדִי שְׁרַבּ אֶלְמָאה̈,</tei:l>
          <tei:l>אֶלְדִי טְפָא אַ[ל]נָּאר,</tei:l>
          <tei:l>אֶלְדִי אַחְרַק אֶלְעַסָא,</tei:l>
          <tei:l>אֶלְדִי דַרְבֶּת אֶלְכַּלְבָּה̈,</tei:l>
          <tei:l>אֶלְדִי גֶׄדְמַת אֶלְקַטּוּס,</tei:l>
          <tei:l>אֶלְדִי כְּלָאת אֶזְׄדִי,</tei:l>
          <tei:l>אֶלְדִי שְׁרָא לִי</tei:l>
          <tei:l>בָּאבָּא בְּזוּז פְלוּס</tei:l>
          <tei:l>וַואחַד גַּדְיָא וַואחַד גַּדְיָא</tei:l>
          <tei:l>אֶלְדִי שְׁרָא לִי בָּאבָּא</tei:l>
          <tei:l>בְּזוּז פְלוּס׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
