  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_of_parents_for_a_son_or_daughter_in_the_armed_forces_klein">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_of_parents_for_a_son_or_daughter_in_the_armed_forces_klein/1"/>
        <tei:lg>
          <tei:l>אֱלֹהֵינוּ וְאָבִינוּ,</tei:l>
          <tei:l>עָלֵינוּ לְשַׁבֵּחַ עַל דַּאֲגָתְךָ הָאוֹהֶבֶת וְהָרְחוּמָה</tei:l>
          <tei:l>עֲבוּר בְּנֵנוּ (בִּתֵּנוּ),</tei:l>
          <tei:l>הַיּוֹצֵא (שֶׁיָּצָא)</tei:l>
          <tei:l>לְשָׁרֵת בִּצְבָא</tei:l>
          <tei:l>אַרְצֵנוּ הָאֲהוּבָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_of_parents_for_a_son_or_daughter_in_the_armed_forces_klein/2"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן מִלְּפָנֶיךָ</tei:l>
          <tei:l>שֶׁיָּשׁוּב (תָּשׁוּב) אֵלֵינוּ בְּשָׁלוֹם.</tei:l>
          <tei:l>חַזֵּק אֶת גּוּפוֹ (גּוּפָהּ) וְנַפְשׁוֹ (וְנַפְשָׁהּ),</tei:l>
          <tei:l>שְׁמוֹר עָלָיו (עָלֶיהָ) בִּשְׁעַת נִסָּיוֹן וְסַכָּנָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_of_parents_for_a_son_or_daughter_in_the_armed_forces_klein/3"/>
        <tei:lg>
          <tei:l>יִזְכֹּור (תִּזְכֹּור)</tei:l>
          <tei:l>אֶת אַהֲבַת אָבִיו וְאִמּוֹ (אָבִיהָ וְאִמָּהּ),</tei:l>
          <tei:l>אֲשֶׁר תְּפִלָּתָם תְּלַוֶּה אוֹתוֹ (אוֹתָהּ)</tei:l>
          <tei:l>בְּכָל דְּרָכָיו (דְּרָכֶיהָ),</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_of_parents_for_a_son_or_daughter_in_the_armed_forces_klein/4"/>
        <tei:lg>
          <tei:l>וְיִשָּׁאֵר (וְתִשָּׁאֵר) חָזָק (חֲזָקָה) בֶּאֱמוּנָתוֹ (בֶּאֱמוּנָתָהּ) בְּךָ.</tei:l>
          <tei:l>תָּאִיר בְּאוֹרְךָ</tei:l>
          <tei:l>אֶת דַּרְכָּם וְאֶת דַּרְכֵי אֲחֵיהֶם לַנֶּשֶׁק,</tei:l>
          <tei:l>וְתִתְחַזֵּק בָּהֶם הַתִּקְוָה</tei:l>
          <tei:l>כִּי הֵם שֻׁתָּפִים בְּבִנְיָן שֶׁל עוֹלָם טוֹב יוֹתֵר.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_of_parents_for_a_son_or_daughter_in_the_armed_forces_klein/5"/>
        <tei:lg>
          <tei:l>קָרֵב יוֹם בּוֹ תֶּחְדַּל הַמִּלְחָמָה מִן הָאָרֶץ,</tei:l>
          <tei:l>קָרֵב יוֹם בּוֹ יִמָּחוּ דִּמְעוֹת הַצַּעַר</tei:l>
          <tei:l>מֵעַל כָּל פָּנִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_of_parents_for_a_son_or_daughter_in_the_armed_forces_klein/6"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה ה׳</tei:l>
          <tei:l>שׁוֹמֵעַ תְּפִלָּה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_of_parents_for_a_son_or_daughter_in_the_armed_forces_klein/7"/>
        <tei:lg>
          <tei:l>אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
