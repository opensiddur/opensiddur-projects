  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hoshana_for_healing_and_consolation_marx">
        <tei:head>Hoshana for Healing and Consolation, by Rabbi Dr. Dalia Marx</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshana_for_healing_and_consolation_marx/1"/>
        <tei:lg>
          <tei:l><tei:hi rend="italic">Hoshana</tei:hi> for Healing and Consolation</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshana_for_healing_and_consolation_marx/2"/>
        <tei:lg>
          <tei:l><tei:hi rend="italic">hosha na</tei:hi>, please save!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshana_for_healing_and_consolation_marx/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">א</tei:seg> For the sake of true love</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshana_for_healing_and_consolation_marx/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ב</tei:seg> For the sake of blessing at all times</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshana_for_healing_and_consolation_marx/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ג</tei:seg> For the sake of rainfall, anytime</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshana_for_healing_and_consolation_marx/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ד</tei:seg> For the sake of paths and their rectification</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshana_for_healing_and_consolation_marx/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ה</tei:seg> For the sake of mountains and their crossing</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshana_for_healing_and_consolation_marx/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ו</tei:seg> For the sake of encounters and their purpose</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshana_for_healing_and_consolation_marx/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ז</tei:seg> For the sake of lasting memories</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshana_for_healing_and_consolation_marx/10"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ח</tei:seg> For the sake of good dreams</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshana_for_healing_and_consolation_marx/11"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ט</tei:seg> For the sake of goodness throughout all possible worlds</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshana_for_healing_and_consolation_marx/12"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">י</tei:seg> For the sake of the beauty of life</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshana_for_healing_and_consolation_marx/13"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כ</tei:seg> For the sake of strength to the weary<tei:anchor xml:id="note_1"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshana_for_healing_and_consolation_marx/14"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ל</tei:seg> For the sake of a caress for those in pain</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshana_for_healing_and_consolation_marx/15"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מ</tei:seg> For the sake of rest and restoring strength</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshana_for_healing_and_consolation_marx/16"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נ</tei:seg> For the sake of consolation and peace</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshana_for_healing_and_consolation_marx/17"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ס</tei:seg> For the sake of the measure between self-doubt and self-confidence</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshana_for_healing_and_consolation_marx/18"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ע</tei:seg> For the sake of conflicts and their resolution</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshana_for_healing_and_consolation_marx/19"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פ</tei:seg> For the sake of opening the heart</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshana_for_healing_and_consolation_marx/20"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">צ</tei:seg> For the sake of healing the pain</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshana_for_healing_and_consolation_marx/21"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ק</tei:seg> For the sake of yearning voices</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshana_for_healing_and_consolation_marx/22"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ר</tei:seg> For the sake of arousing compassion</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshana_for_healing_and_consolation_marx/23"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ש</tei:seg> For the sake of rest when it’s needed</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshana_for_healing_and_consolation_marx/24"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ת</tei:seg> For the sake of hope and fulfillment</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hoshana_for_healing_and_consolation_marx/25"/>
        <tei:lg>
          <tei:l><tei:hi rend="italic">hosha na</tei:hi> please, save!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
