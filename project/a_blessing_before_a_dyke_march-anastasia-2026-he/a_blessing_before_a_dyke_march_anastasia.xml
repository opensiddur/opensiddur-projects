    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_blessing_before_a_dyke_march_anastasia">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_blessing_before_a_dyke_march_anastasia/6"/>
        <tei:lg>
          <tei:l>בְּרוּכָה אַתְ יָהּ</tei:l>
          <tei:l>אוֹהֶבֶת הָעוֹלָם</tei:l>
          <tei:l>הַלֵב הַפּוֹעֵם שֶׁל כֹּל הָעוֹלָמוֹת</tei:l>
          <tei:l>בּוֹרֵאת צְחוֹקָן שֶׁל כַּלּוֹת</tei:l>
          <tei:l>וּשְׂשׂוֹנָן שֶׁל שֻׁתָפוֹת לְמַאֲבָק<tei:anchor xml:id="note_2"/></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
