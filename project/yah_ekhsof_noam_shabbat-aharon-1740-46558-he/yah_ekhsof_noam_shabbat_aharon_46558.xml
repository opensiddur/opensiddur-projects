    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yah_ekhsof_noam_shabbat_aharon_46558">
        <tei:head>יָהּ אֶכְסוֹף נוֹעַם שַׁבָּת</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yah_ekhsof_noam_shabbat_aharon_46558/1"/>
        <tei:lg>
          <tei:l>יָהּ אֶכְסוֹף נוֹעַם שַׁבָּת</tei:l>
          <tei:l>הֵמֵתְאֶמֶת וּמִתְאַחֶדֶת בְסְגֻלָתֶךָ,</tei:l>
          <tei:l>מְשֹׁךְ נֹעַם יִרְאָתֶךָ</tei:l>
          <tei:l>לְעַם מְבַקְשֵׁי רְצוֹנֶךָ.</tei:l>
          <tei:l>קַדְשֵׁם בִּקְדֻשַּׁת הַשַּׁבָּת</tei:l>
          <tei:l>הַמִּתְאַחֶדֶת בְּתוֹרָתֶךָ.</tei:l>
          <tei:l>פְּתַח לָהֶם נֹעַם וְרָצוֹן</tei:l>
          <tei:l>לִפְתּוֹחַ שַׁעֲרֵי רְצוֹנֶךָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yah_ekhsof_noam_shabbat_aharon_46558/2"/>
        <tei:lg>
          <tei:l>הָיָה הֹוֶה שְׁמוֹר</tei:l>
          <tei:l>שׁוֹמְרֵי וּמְצַפִּים שַׁבַּת קָדְשֶׁךָ.</tei:l>
          <tei:l>כְּמוֹ אַיָּל תַעֲרֹג עַל אֲפִיקֵי מָיִם,</tei:l>
          <tei:l>כֵּן נַפְשָׁם תַּעֲרֹג לְקַבֵּל נֹעַם קְדוּשָׁת שַׁבָּת</tei:l>
          <tei:l>הַמִּתְאַחֶדֶת בְּשֵׁם קָדְשֶׁךָ.</tei:l>
          <tei:l>הַצֵּל מְאַחֲרֵי לִפְרשׁ מִן הַשַּׁבָּת,</tei:l>
          <tei:l>לְבִלְתִּי תִּהְיֶה סָגוּר מֵהֶם.</tei:l>
          <tei:l>שִׁשָּׁה יָמִים הַמְקַבְּלִים קְדֻשָּׁה מִשַּׁבַּת קָדְשֶׁךָ,</tei:l>
          <tei:l>וְטַהֵר לִבָּם בֶּאֱמֶת וּבֶאֱמוּנָה לְעָבְדֶּךָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yah_ekhsof_noam_shabbat_aharon_46558/3"/>
        <tei:lg>
          <tei:l>וְיִהְיוּ רַחֲמֶיךָ מִתְגּוֹלְלִים</tei:l>
          <tei:l>עַל עַם קָדְשֶׁךָ,</tei:l>
          <tei:l>לְהַשְׁקוֹת צְמֵאֵי חַסְדֶּךָ</tei:l>
          <tei:l>מִנָּהָר הַיּוֹצֵא מֵעֵדֶן.</tei:l>
          <tei:l>לְעַטֵר אֶת יִשְׂרָאֵל בְּתִפְאֶרֶת הַמְפָאֲרִים אוֹתְךָ</tei:l>
          <tei:l>(בְּיוֹם שַׁבָּת) עַל יְדֵי שַׁבַּת קָדְשֶׁךָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yah_ekhsof_noam_shabbat_aharon_46558/4"/>
        <tei:lg>
          <tei:l>כָּל שִׁשָּׁה יָמִים</tei:l>
          <tei:l>לְהַנְחִילָם נַחֲלַת יַעֲקֹב בְּחִירֶךָ.</tei:l>
          <tei:l>הַשַּׁבָּת נוֹעַם הַנְּשָׁמוֹת,</tei:l>
          <tei:l>וְהַשְּׁבִיעִי עֹנֶג הָרוּחוֹת וְעֵדֶן הַנְּפָשׁוֹת,</tei:l>
          <tei:l>לְהִתְעַדֵּן בְּאַהֲבָתֶךָ וּבְיִרְאָתֶךָ,</tei:l>
          <tei:l>שַׁבָּת קֹדֶשׁ</tei:l>
          <tei:l>נַפְשִׁי חוֹלַת אַהֲבָתֶךָ,</tei:l>
          <tei:l>שַׁבָּת קוֹדֶשׁ</tei:l>
          <tei:l>נַפְשׁוֹת יִשְׂרָאֵל בְּצֵל כְּנָפֶיךָ יֶחֱסָיוּן,</tei:l>
          <tei:l>יִרְוְיֻן מִדֶּשֶׁן בֵּיתֶךָ.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
