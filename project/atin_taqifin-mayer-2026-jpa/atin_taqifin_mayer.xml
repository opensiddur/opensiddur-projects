  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:atin_taqifin_mayer">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:atin_taqifin_mayer/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אָ</tei:seg>תִין <tei:seg type="acrostic">תַ</tei:seg>קִּיפִין עֲבַד מֹשֶׁה בְּעֵינֵיהוֹן דְּיִשְׂרָאֵל</tei:l>
          <tei:l><tei:seg type="acrostic">בִּ</tei:seg>רְכָן <tei:seg type="acrostic">שְׁ</tei:seg>בִיחָן עֲבַד טֹובִיָּה בְּעֵינֵיהוֹן דְּיַעֲקֹב</tei:l>
          <tei:l><tei:seg type="acrostic">גֵּ</tei:seg>יוְתָנִין <tei:seg type="acrostic">רַ</tei:seg>בְרְבִין עֲבַד שְׁמַעְיָה בְּעֵינֵיהוֹן דִּישֻׁרוּן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:atin_taqifin_mayer/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">דְּ</tei:seg>בִירַיָּא <tei:seg type="acrostic">קַ</tei:seg>דִּישַׁיָּא אֲמַר יֶֽרֶד בְּאוּדְנֵיהוֹן דְּיִשְׂרָאֵל</tei:l>
          <tei:l><tei:seg type="acrostic">הִ</tei:seg>ילְכָתָא <tei:seg type="acrostic">צַ</tei:seg>דִּיקָתָא אֲמַר חֶֽבֶר בְּאוּדְנֵיהוֹן דְּיַעֲקֹב</tei:l>
          <tei:l><tei:seg type="acrostic">וּ</tei:seg>שְׁמַעְתָּתָא <tei:seg type="acrostic">פְּ</tei:seg>רִישָׁתָא אֲמַר יְקֽוּתִיאֵל בְּאוּדְנֵיהוֹן דִּישֻׁרוּן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:atin_taqifin_mayer/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זַ</tei:seg>כְוָן <tei:seg type="acrostic">עֲ</tei:seg>דִיפָן יְהַב אֲבִי־גְדוֹר בִּידֵיהוֹן דְּיִשְׂרָאֵל</tei:l>
          <tei:l><tei:seg type="acrostic">חֵ</tei:seg>ירוּ <tei:seg type="acrostic">סַ</tei:seg>גִּיאָה יְהַב אֲבִי־שֹוֹכוֹ בִּידֵיהוֹן דְּיַעֲקֹב</tei:l>
          <tei:l><tei:seg type="acrostic">טִ</tei:seg>יבוּ <tei:seg type="acrostic">נְ</tei:seg>עִימָא יְהַב אֲבִי־זָנוֹחַ בִּידֵיהוֹן דִּישֻׁרוּן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:atin_taqifin_mayer/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יְ</tei:seg>רוּתְתָּא <tei:seg type="acrostic">מְ</tei:seg>שַׁבַּחְתָּא אוֹרִית בֶּן־נְתַנְאֵל בִּידֵיהוֹן דְּיִשְׂרָאֵל</tei:l>
          <tei:l><tei:seg type="acrostic">כֹּֽ</tei:seg>לָּא <tei:seg type="acrostic">לְ</tei:seg>מֶחְזֵי עֲבַד מֹשֶׁה בְּעֵינֵיהוֹן דְּיִשְׂרָאֵל׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
