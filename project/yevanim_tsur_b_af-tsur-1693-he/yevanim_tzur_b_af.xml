  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yevanim_tzur_b_af">
        <tei:head>יְוָנִים צוּר בְּאַף</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yevanim_tzur_b_af/1"/>
        <tei:lg>
          <tei:l>יְוָנִים צוּר בְּאַף נָגַף וְהִכָּה</tei:l>
          <tei:l>וְצִוָּֽנוּ לְהַדְלִיק נֵר חֲנֻכָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yevanim_tzur_b_af/2"/>
        <tei:lg>
          <tei:l>עָרִיצֵיהֶם תְּהוֹם יָרְדוּ וְאָבָדוּ</tei:l>
          <tei:l>וְנִלְכְּדוּ בְּפַח גַּם חָח וְחַכָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yevanim_tzur_b_af/3"/>
        <tei:lg>
          <tei:l>קְרוּאִים נַחֲלַת שַׁדַּי בְּחַסְדּוֹ</tei:l>
          <tei:l>עֲלֵיהֶם חָס וְהִצְדִּיקָם וְזִכָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yevanim_tzur_b_af/4"/>
        <tei:lg>
          <tei:l>וּמַתִּתְיָה עָנָהוּ יָהּ וְשָׁמַע</tei:l>
          <tei:l>תִּפְלָתוֹ נְקִיָּה הִיא וְזַכָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yevanim_tzur_b_af/5"/>
        <tei:lg>
          <tei:l>בְּחֶמְלָתוֹ יְחוֹנֵן עוֹד עֲדָתוֹ</tei:l>
          <tei:l>אֲשֶׁר יִשְׁעוֹ מְצַפָּה גַּם מְחַכָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yevanim_tzur_b_af/6"/>
        <tei:lg>
          <tei:l>וְיִתְגַּדֵּל שְׁמוֹ אֵל רָם וְנִשָּׂא</tei:l>
          <tei:l>וְשׁוֹכֵן אֶת־שְׁפַל רֽוּחַ וְדַכָּא׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
