      <tei:div corresp="urn:x-opensiddur:text:prayer:items_for_the_second_seder_plate_turnip_peels_mayer">
        <tei:head>קְלִפּוֹת לֶפֶת</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:items_for_the_second_seder_plate_turnip_peels_mayer/5"/>
        <tei:lg>
          <tei:l>שְׁפֹ֤ךְ חֲמָתְךָ֗ אֶֽל־הַגּוֹיִם֮ אֲשֶׁ֢ר לֹא־יְדָ֫ע֥וּךָ וְעַ֥ל מַמְלָכ֑וֹת אֲשֶׁ֥ר בְּ֝שִׁמְךָ֗ לֹ֣א קָרָֽאוּ׃ כִּ֭י אָכַ֣ל אֶֽת־יַעֲקֹ֑ב וְֽאֶת־נָוֵ֥הוּ הֵשַֽׁמּוּ׃ <tei:bibl>(תהלים עט:ו-ז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:items_for_the_second_seder_plate_turnip_peels_mayer/6"/>
        <tei:lg>
          <tei:l>שְׁפׇךְ־עֲלֵיהֶ֥ם זַעְמֶ֑ךָ וַחֲר֥וֹן אַ֝פְּךָ֗ יַשִּׂיגֵֽם׃ <tei:bibl>(תהלים סט:כה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:items_for_the_second_seder_plate_turnip_peels_mayer/7"/>
        <tei:lg>
          <tei:l>תִּרְדֹּ֤ף בְּאַף֙ וְתַשְׁמִידֵ֔ם מִתַּ֖חַת שְׁמֵ֥י יְהֹוָֽה׃ <tei:bibl>(איכה ג:סו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:items_for_the_second_seder_plate_turnip_peels_mayer/8"/>
        <tei:lg>
          <tei:l>כֵּ֠ן יֹאבְד֤וּ כׇל־אוֹיְבֶיךָ֙ יְהֹוָ֔ה וְאֹ֣הֲבָ֔יו כְּצֵ֥את הַשֶּׁ֖מֶשׁ בִּגְבֻרָת֑וֹ <tei:bibl>(שופטים ה:לא)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
