  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:eshet_chayil_sinclair">
        <tei:head>אֵשֶׁת חַיִל</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eshet_chayil_sinclair/1"/>
        <tei:lg>
          <tei:l>אֵשֶׁת חַיִל מִי יִמְצָא</tei:l>
          <tei:l>וְרָחוֹק מִפְּנִינִים מִכְרָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eshet_chayil_sinclair/2"/>
        <tei:lg>
          <tei:l>בָּטַח בָּהּ לֵב בַּעְלָהּ</tei:l>
          <tei:l>וְשָׁלָל לא יֶחְסָר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eshet_chayil_sinclair/3"/>
        <tei:lg>
          <tei:l>גְּמָלַתְהוּ טוֹב וְלֹא רָע</tei:l>
          <tei:l>כֹּל יְמֵי חַיֶּיה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eshet_chayil_sinclair/4"/>
        <tei:lg>
          <tei:l>דּוֹדִי לִי וַאֲנִי לוֹ</tei:l>
          <tei:l>הָרוֹעֶה בַּשּׁוֹשַׁנִּים <tei:bibl>(שיר השירים ב:טז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eshet_chayil_sinclair/5"/>
        <tei:lg>
          <tei:l>הִנָּךְ יָפָה רַעְיָתִי הִנָּךְ יָפָה</tei:l>
          <tei:l>עֵינַיִךְ יוֹנִים <tei:bibl>(שיר השירים א:טו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eshet_chayil_sinclair/6"/>
        <tei:lg>
          <tei:l>וְדָבַק בְּאִשְׁתּוֹ</tei:l>
          <tei:l>וְהָיוּ לְבָשָׂר אֶחָד <tei:bibl>(בראשית ב:כד (חלק))</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eshet_chayil_sinclair/7"/>
        <tei:lg>
          <tei:l>זָמְמָה שָׂדֶה וַתִּקָּחֵהוּ</tei:l>
          <tei:l>מִפְּרִי כַפֶּיהָ נָטְעָה כָּרֶם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eshet_chayil_sinclair/8"/>
        <tei:lg>
          <tei:l>חָגְרָה בְעוֹז מָתְנֶיהָ</tei:l>
          <tei:l>וַתְּאַמֵּץ זְרוֹעוֹתֶיהָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eshet_chayil_sinclair/9"/>
        <tei:lg>
          <tei:l>טוֹב עַיִן הוּא יְבֹרָךְ</tei:l>
          <tei:l>כִּי נָתַן מִלַּחְמוֹ לַדָּל <tei:bibl>(משלי כב:ט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eshet_chayil_sinclair/10"/>
        <tei:lg>
          <tei:l>יִשָּׁקֵנִי מִנְּשִׁיקוֹת פִּיהוּ</tei:l>
          <tei:l>כִּי טוֹבִים דּוֹדֶיךָ מִיָּיִן <tei:bibl>(שיר השירים א:ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eshet_chayil_sinclair/11"/>
        <tei:lg>
          <tei:l>כַּפָּהּ פָּרְשָׂה לֶעָנִי</tei:l>
          <tei:l>וְיָדֶיהָ שִׁלְּחָה לָאֶבְיוֹן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eshet_chayil_sinclair/12"/>
        <tei:lg>
          <tei:l>לֹא תִירָא לְבֵיתָהּ מִשָּׁלֶג</tei:l>
          <tei:l>כִּי כָל בֵּיתָהּ לָבוּשׁ שָׁנִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eshet_chayil_sinclair/13"/>
        <tei:lg>
          <tei:l>מַה דּוֹדֵךְ מִדּוֹד</tei:l>
          <tei:l>הַיָּפָה בַּנָּשִׁים <tei:bibl>(שיר השירים ה:ט (חלק))</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eshet_chayil_sinclair/14"/>
        <tei:lg>
          <tei:l>נוֹדָע בַּשְּׁעָרִים בַּעְלָהּ</tei:l>
          <tei:l>בְּשִׁבְתּוֹ עִם זִקְנֵי אָרֶץ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eshet_chayil_sinclair/15"/>
        <tei:lg>
          <tei:l>סַלְסְלֶהָ וּתְרוֹמְמֶךָּ</tei:l>
          <tei:l>תְּכַבֵּדְךָ כִּי תְחַבְּקֶנָּה <tei:bibl>(משלי ד:ח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eshet_chayil_sinclair/16"/>
        <tei:lg>
          <tei:l>עֹז וְהָדָר לְבוּשָׁהּ</tei:l>
          <tei:l>וְתִשׂחַק לְיוֹם אַחֲרוֹן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eshet_chayil_sinclair/17"/>
        <tei:lg>
          <tei:l>פִּיהָ פָּתְחָה בְחָכְמָה</tei:l>
          <tei:l>וְתוֹרַת חֶסֶד עַל לְשׁוֹנָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eshet_chayil_sinclair/18"/>
        <tei:lg>
          <tei:l>צוֹפִיָּה הֲלִיכוֹת בֵּיתָהּ</tei:l>
          <tei:l>וְלֶחֶם עַצְלוּת לֹא תֹאכֵל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eshet_chayil_sinclair/19"/>
        <tei:lg>
          <tei:l>קָמוּ בָנֶיהָ וַיְאַשְּׁרוּהָ</tei:l>
          <tei:l>בַּעְלָהּ וַיְהַלְלָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eshet_chayil_sinclair/20"/>
        <tei:lg>
          <tei:l>רַבּוֹת בָּנוֹת עָשׂוּ חָיִל</tei:l>
          <tei:l>וְאַתְּ עָלִית עַל כֻּלָּנָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eshet_chayil_sinclair/21"/>
        <tei:lg>
          <tei:l>שֶׁקֶר הַחֵן וְהֶבֶל הַיֹּפִי</tei:l>
          <tei:l>אִשָּׁה יִרְאַת ה’ הִיא תִתְהַלָּל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eshet_chayil_sinclair/22"/>
        <tei:lg>
          <tei:l>תְּנוּ לָהּ מִפְּרִי יָדֶיָה</tei:l>
          <tei:l>וִיהַלְלוּהָ בַשְׁעָרִים מַעֲשֶׂיהָ</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
