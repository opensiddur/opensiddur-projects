  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:anna_bekhoach">
        <tei:head>אָנָּא בְּכֹחַ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:anna_bekhoach/1-7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אָ</tei:seg>נָּא,</tei:l>
          <tei:l>בְּכֹֽחַ גְּדֻלַּת יְמִינְךָ,</tei:l>
          <tei:l>תַּתִּיר צְרוּרָה.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קַ</tei:seg>בֵּל רִנַּת עַמְּךָ,</tei:l>
          <tei:l>שַׂגְּבֵֽנוּ, טַהֲרֵנוּ,</tei:l>
          <tei:l>נוֹרָא.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נָ</tei:seg>א גִבּוֹר,</tei:l>
          <tei:l>דּוֹרְשֵׁי יִחוּדְךָ,</tei:l>
          <tei:l>כְּבָבַת שָׁמְרֵם.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בָּ</tei:seg>רְכֵם, טַהֲרֵם,</tei:l>
          <tei:l>רַחֲמֵי צִדְקָתְךָ</tei:l>
          <tei:l>תָּמִיד גָּמְלֵם.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חָ</tei:seg>סִין קָדוֹשׁ,</tei:l>
          <tei:l>בְּרוֹב טוּבְךָ</tei:l>
          <tei:l>נַהֵל עֲדָתֶֽךָ.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>חִיד, גֵּאֶה,</tei:l>
          <tei:l>לְעַמְּךָ פְּנֵה,</tei:l>
          <tei:l>זוֹכְרֵי קְדֻשָּׁתֶֽךָ.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שַׁ</tei:seg>וְעָתֵֽנוּ קַבֵּל,</tei:l>
          <tei:l>וּשְׁמַע צַעֲקָתֵֽנוּ,</tei:l>
          <tei:l>יוֹדֵֽעַ תַּעֲלוּמוֹת.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">[בלחש]</tei:note>
          </tei:l>
          <tei:l>בָּרוּךְ שֵׁם</tei:l>
          <tei:l>כְּבוֹד מַלְכוּתוֹ</tei:l>
          <tei:l>לְעוֹלָם וָעֶד׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
