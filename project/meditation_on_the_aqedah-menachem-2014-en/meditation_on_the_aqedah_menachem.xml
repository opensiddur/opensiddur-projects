  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:meditation_on_the_aqedah_menachem">
        <tei:head>Meditation on the Aqedah, by Shim’on Menachem</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:meditation_on_the_aqedah_menachem/1"/>
        <tei:lg>
          <tei:l>My God and the God of my ancestors,</tei:l>
          <tei:l>My limbs, my heart, the tips of my fingers buzz with creation.</tei:l>
          <tei:l>This body is Your instrument</tei:l>
          <tei:l>Ready to move</tei:l>
          <tei:l>On the knife’s edge of action.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:meditation_on_the_aqedah_menachem/2"/>
        <tei:lg>
          <tei:l>My God and the God of my ancestors calls out,</tei:l>
          <tei:l>Avraham, Avraham</tei:l>
          <tei:l>Which one am I?</tei:l>
          <tei:l>Do I put forth my hand?</tei:l>
          <tei:l>Do I not?</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:meditation_on_the_aqedah_menachem/3"/>
        <tei:lg>
          <tei:l>Ribbono shel olam,</tei:l>
          <tei:l>If I step beck, will I tip the balance of mercy?</tei:l>
          <tei:l>If I move, will I doom us all?</tei:l>
          <tei:l>And if the angel calls, will I hear?</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:meditation_on_the_aqedah_menachem/4"/>
        <tei:lg>
          <tei:l>Ribon kol haOlamim,</tei:l>
          <tei:l>This body, my breath, my vanities</tei:l>
          <tei:l>I empty them before You</tei:l>
          <tei:l>All that is left is <tei:hi rend="italic">hineini</tei:hi></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
