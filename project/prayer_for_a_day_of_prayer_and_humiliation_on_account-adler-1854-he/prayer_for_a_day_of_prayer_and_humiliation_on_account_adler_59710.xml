  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_a_day_of_prayer_and_humiliation_on_account_adler_59710">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_a_day_of_prayer_and_humiliation_on_account_adler_59710/2"/>
        <tei:lg>
          <tei:l>אָתָֽאנוּ לְחַלּוֹת פָּנֶֽיךָ</tei:l>
          <tei:l>כִּי חֶֽסֶד וֶאֱמֶת יְקַדְּמוּ פָנֶֽיךָ</tei:l>
          <tei:l>נָא אַל תְּשִׁיבֵֽנוּ</tei:l>
          <tei:l>נָא אַל תְּשִׁיבֵֽנוּ רֵיקָם מִלְּפָנֶֽיךָ</tei:l>
          <tei:l>סְלַח לָֽנוּ,</tei:l>
          <tei:l>וּשְׁלַח לָֽנוּ יְשׁוּעָה וְרַחֲמִים</tei:l>
          <tei:l>מִמְּעוֹנֶֽךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_a_day_of_prayer_and_humiliation_on_account_adler_59710/3"/>
        <tei:lg>
          <tei:l>אָתָֽאנוּ לְבַקֵּשׁ מִמְּךָ כַּפָּרָה</tei:l>
          <tei:l>אָיֹם וְנוֹרָא</tei:l>
          <tei:l>מִשְׂגָּב לְעִתּוֹת בַּצָּרָה</tei:l>
          <tei:l>תְּחַיֵּֽינוּ תְּחׇנֵּֽנוּ</tei:l>
          <tei:l>וּבְשִׁמְךָ נִקְרָא</tei:l>
          <tei:l>סְלַח לָֽנוּ</tei:l>
          <tei:l>וּשְׁלַח לָֽנוּ יְשׁוּעָה וְרַחֲמִים</tei:l>
          <tei:l>מִמְּעוֹנֶֽךָ׃</tei:l>
        </tei:lg>
      </tei:div>
