    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:bachodesh_ziv_mayer">
        <tei:head>בַּחֹדֶשׁ זִיו</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bachodesh_ziv_mayer/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">אמת ויציב עד אֵין אֱלֹהִים זוּלָתֶךָ</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bachodesh_ziv_mayer/2"/>
        <tei:lg>
          <tei:l>בַּחֹ֨דֶשׁ <tei:seg type="acrostic">זִ</tei:seg>יו נִבְנָה הָרִאשׁוֹן</tei:l>
          <tei:l>הַשֵּׁנִ֜י <tei:seg type="acrostic">כָּ</tei:seg>מֽוֹהוּ בֵּית תְּפִלַּת כׇּל־לָשׁוֹן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bachodesh_ziv_mayer/3"/>
        <tei:lg>
          <tei:l>בְּאַרְבָּעָ֨ה <tei:seg type="acrostic">רָ</tei:seg>אשֵׁי שָׁנִים הֵבֵֽאנוּ מַעַשְׂרוֹת</tei:l>
          <tei:l>עָשָׂ֥ר <tei:seg type="acrostic">נֶ</tei:seg>אֶסְפוּ תַּֽחַת הַשֵּֽׁבֶט כְּבָשִׂים וּפָרוֹת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bachodesh_ziv_mayer/4"/>
        <tei:lg>
          <tei:l>י֛וֹם <tei:seg type="acrostic">יָ</tei:seg>ד רָמָה הוּא יוֹם זְרֽוֹעַ נְטוּיָה</tei:l>
          <tei:l>בֵּ֥ין <tei:seg type="acrostic">לְ</tei:seg>אֻמִּים הוֹצֵאתָֽנוּ הֲלֹא הִיא גְּלוּיָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bachodesh_ziv_mayer/5"/>
        <tei:lg>
          <tei:l>הָעַרְבַּ֖יִם <tei:seg type="acrostic">ט</tei:seg>וֹבִים הֵם גַּם נִיסָן וְאִיֵּר</tei:l>
          <tei:l>יַעֲשׂ֣וּ <tei:seg type="acrostic">וְ</tei:seg>יִשְׁמְעוּ בְּיוֹם מְשֻׁיָּר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bachodesh_ziv_mayer/6"/>
        <tei:lg>
          <tei:l>אֹת֑וֹ <tei:seg type="acrostic">בַּֽ</tei:seg>יִת אוֹתָהּ עִיר אוֹתוֹ הַמִּזְבֵּֽחַ</tei:l>
          <tei:l>עַל <tei:seg type="acrostic">הָ</tei:seg>אֵשׁ תִּצְלֽוּהוּ כׇּל־יִשְׂרָאֵל זוֹבֵֽחַ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bachodesh_ziv_mayer/7"/>
        <tei:lg>
          <tei:l>מַצּ֥וֹת <tei:seg type="acrostic">אִ</tei:seg>כְלוּ לְזֵֽכֶר חִפָּזוֹן הַיְּצִיאָה</tei:l>
          <tei:l>וּמְרֹרִ֖ים <tei:seg type="acrostic">מָ</tei:seg>רִים כְּמוֹ רֹאשׁ וְלַעֲנָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bachodesh_ziv_mayer/8"/>
        <tei:lg>
          <tei:l>יֹאכְלֻֽהוּ <tei:seg type="acrostic">נָ</tei:seg>א בְּשִׂמְחָה כִּי הוֹשַׁעְתַּֽנִי</tei:l>
          <tei:l>לֹא־עָשָׂה אֶת־הָרִאשׁוֹן יַעֲשֶׂה אֶת־הַשֵּׁנִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bachodesh_ziv_mayer/9"/>
        <tei:lg>
          <tei:l>הַשֵּׁנִי כָּרִאשׁוֹן בִּלְשׁוֹן יָם מִצְרַֽיִם</tei:l>
          <tei:l>הֶעֱבַרְתָֽנוּ מֵאָז וְתַעֲבִירֵֽנוּ שִׁבְעָתַֽיִם</tei:l>
          <tei:l>הַיּוֹצְאִים רָאוּ וְעָמְדוּ עַל־רַגְלַֽיִם</tei:l>
          <tei:l>הַשִּׁיר שֶׁשָּׁרוּ נָשִׁיר בְּכִפְלַֽיִם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bachodesh_ziv_mayer/10"/>
        <tei:lg>
          <tei:l>עֶזְרַת אֲבוֹתֵינוּ...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
