  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:wachad_gadia">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wachad_gadia/1"/>
        <tei:lg>
          <tei:l>waḥad gadia, waḥad gadia,</tei:l>
          <tei:l>eldi chra li baba</tei:l>
          <tei:l>b-zouz flous</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wachad_gadia/2"/>
        <tei:lg>
          <tei:l>ou-jat el-qattous</tei:l>
          <tei:l>ou-klat ejdi,</tei:l>
          <tei:l>eldi chra li baba</tei:l>
          <tei:l>b-zouz flous,</tei:l>
          <tei:l>waḥad gadia, waḥad gadia,</tei:l>
          <tei:l>eldi chra li baba</tei:l>
          <tei:l>b-zouz flous</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wachad_gadia/3"/>
        <tei:lg>
          <tei:l>ou-jat el-kalba</tei:l>
          <tei:l>ou-gedmat el-qattous,</tei:l>
          <tei:l>eldi klat ejdi,</tei:l>
          <tei:l>eldi chra li baba</tei:l>
          <tei:l>b-zouz flous,</tei:l>
          <tei:l>waḥad gadia, waḥad gadia,</tei:l>
          <tei:l>eldi chra li baba</tei:l>
          <tei:l>b-zouz flous</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wachad_gadia/4"/>
        <tei:lg>
          <tei:l>ou-jat el-ʕasa</tei:l>
          <tei:l>ou-darbet el-kalba,</tei:l>
          <tei:l>eldi gedmat el-qattous,</tei:l>
          <tei:l>eldi klat ejdi,</tei:l>
          <tei:l>eldi chra li baba</tei:l>
          <tei:l>b-zouz flous,</tei:l>
          <tei:l>waḥad gadia, waḥad gadia,</tei:l>
          <tei:l>eldi chra li baba</tei:l>
          <tei:l>b-zouz flous</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wachad_gadia/5"/>
        <tei:lg>
          <tei:l>ou-ja a-nar</tei:l>
          <tei:l>ou-aḥraq el-ʕaṣa,</tei:l>
          <tei:l>eldi darbet el-kalba,</tei:l>
          <tei:l>eldi gedmat el-qattous,</tei:l>
          <tei:l>eldi klat ejdi,</tei:l>
          <tei:l>eldi chra li baba</tei:l>
          <tei:l>b-zouz flous,</tei:l>
          <tei:l>waḥad gadia, waḥad gadia,</tei:l>
          <tei:l>eldi chra li baba</tei:l>
          <tei:l>b-zouz flous</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wachad_gadia/6"/>
        <tei:lg>
          <tei:l>ou-ja el-mah</tei:l>
          <tei:l>ou-ṭfa a-nar</tei:l>
          <tei:l>eldi aḥraq el-ʕaṣa,</tei:l>
          <tei:l>eldi darbet el-kalba,</tei:l>
          <tei:l>eldi gedmat el-qattous,</tei:l>
          <tei:l>eldi klat ejdi,</tei:l>
          <tei:l>eldi chra li baba</tei:l>
          <tei:l>b-zouz flous,</tei:l>
          <tei:l>waḥad gadia, waḥad gadia,</tei:l>
          <tei:l>eldi chra li baba</tei:l>
          <tei:l>b-zouz flous</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wachad_gadia/7"/>
        <tei:lg>
          <tei:l>ou-ja a-taur</tei:l>
          <tei:l>ou-chrab el-mah,</tei:l>
          <tei:l>eldi ṭfa a-nar</tei:l>
          <tei:l>eldi aḥraq el-ʕaṣa,</tei:l>
          <tei:l>eldi darbet el-kalba,</tei:l>
          <tei:l>eldi gedmat el-qattous,</tei:l>
          <tei:l>eldi klat ejdi,</tei:l>
          <tei:l>eldi chra li baba</tei:l>
          <tei:l>b-zouz flous,</tei:l>
          <tei:l>waḥad gadia, waḥad gadia,</tei:l>
          <tei:l>eldi chra li baba</tei:l>
          <tei:l>b-zouz flous</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wachad_gadia/8"/>
        <tei:lg>
          <tei:l>ou-ja a-dabaḥ</tei:l>
          <tei:l>ou-dbaḥ a-taur</tei:l>
          <tei:l>eldi chrab el-mah,</tei:l>
          <tei:l>eldi ṭfa a-nar</tei:l>
          <tei:l>eldi aḥraq el-ʕaṣa,</tei:l>
          <tei:l>eldi darbet el-kalba,</tei:l>
          <tei:l>eldi gedmat el-qattous,</tei:l>
          <tei:l>eldi klat ejdi,</tei:l>
          <tei:l>eldi chra li baba</tei:l>
          <tei:l>b-zouz flous,</tei:l>
          <tei:l>waḥad gadia, waḥad gadia,</tei:l>
          <tei:l>eldi chra li baba</tei:l>
          <tei:l>b-zouz flous</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wachad_gadia/9"/>
        <tei:lg>
          <tei:l>ou-ja melk el-mout</tei:l>
          <tei:l>ou-dbaḥ a-dabaḥ,</tei:l>
          <tei:l>eldi dbaḥ a-taur,</tei:l>
          <tei:l>eldi chrab el-mah,</tei:l>
          <tei:l>eldi ṭfa a-nar,</tei:l>
          <tei:l>eldi aḥraq el-ʕaṣa,</tei:l>
          <tei:l>eldi darbet el-kalba,</tei:l>
          <tei:l>eldi gedmat el-qattous,</tei:l>
          <tei:l>eldi klat ejdi,</tei:l>
          <tei:l>eldi chra li baba</tei:l>
          <tei:l>b-zouz flous,</tei:l>
          <tei:l>waḥad gadia, waḥad gadia,</tei:l>
          <tei:l>eldi chra li baba</tei:l>
          <tei:l>b-zouz flous</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wachad_gadia/10"/>
        <tei:lg>
          <tei:l>ou-ja ha-qadoch barouḵ hou</tei:l>
          <tei:l>ou-dbaḥ melk el-mout,</tei:l>
          <tei:l>eldi dbaḥ a-dabaḥ,</tei:l>
          <tei:l>eldi dbaḥ a-taur</tei:l>
          <tei:l>eldi chrab el-mah,</tei:l>
          <tei:l>eldi ṭfa a-nar</tei:l>
          <tei:l>eldi aḥraq el-ʕaṣa,</tei:l>
          <tei:l>eldi darbet el-kalba,</tei:l>
          <tei:l>eldi gedmat el-qattous,</tei:l>
          <tei:l>eldi klat ejdi,</tei:l>
          <tei:l>eldi chra li baba</tei:l>
          <tei:l>b-zouz flous,</tei:l>
          <tei:l>waḥad gadia, waḥad gadia,</tei:l>
          <tei:l>eldi chra li baba</tei:l>
          <tei:l>b-zouz flous</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
