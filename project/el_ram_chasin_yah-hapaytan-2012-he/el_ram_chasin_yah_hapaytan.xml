    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:el_ram_chasin_yah_hapaytan">
        <tei:head>אל רם חסין יה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_ram_chasin_yah_hapaytan/1"/>
        <tei:lg>
          <tei:l>אֵל רָם חֲסִין יָהּ</tei:l>
          <tei:l>שׁוֹכֵן עֲלִיָּה</tei:l>
          <tei:l>מַהֵרָה גוֹאֵל</tei:l>
          <tei:l>לְעַם שִׁבְטֵי יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_ram_chasin_yah_hapaytan/2"/>
        <tei:lg>
          <tei:l>אֵל נִשָּׂא וָרָם</tei:l>
          <tei:l>גַּלֵּה קֵץ נֶעְלָם</tei:l>
          <tei:l>לִבְנֵי אַבְרָהָם</tei:l>
          <tei:l>עַם בָּחַר לוֹ יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_ram_chasin_yah_hapaytan/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שׁ</tei:seg>וֹכֵן בַּשַּׁחַק</tei:l>
          <tei:l>מֵהֶם אַל תִּרְחַק</tei:l>
          <tei:l>לְזֶרַע יִצְחָק</tei:l>
          <tei:l>הוֹצֵא לִרְוָיָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_ram_chasin_yah_hapaytan/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>עִיר תִּפְאַרְתָּךְ</tei:l>
          <tei:l>קְַבֵּץ עֲדָתָךְ</tei:l>
          <tei:l>לִבְנֵי יַעֲקֹב</tei:l>
          <tei:l>שְׁלַח אֵלִיָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_ram_chasin_yah_hapaytan/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>קְדַּשׁ הֲדוֹמָךְ</tei:l>
          <tei:l>יְָשִׁיר בּוֹ עַמָּךְ</tei:l>
          <tei:l>בְּשִׁירַת מֹשֶׁה</tei:l>
          <tei:l>נָבִיא בְּחִיר יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_ram_chasin_yah_hapaytan/10"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הָ</tei:seg>רֵם עַם אֶבְיוֹן</tei:l>
          <tei:l>וּבְנֵה אַפִּרְיוֹן</tei:l>
          <tei:l>לְגֶזַע אַהֲרֹן</tei:l>
          <tei:l>יַקְרִיבוּ לְיָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_ram_chasin_yah_hapaytan/12"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חַזֵּק</tei:seg> וְאַסֵּף</tei:l>
          <tei:l>לְבֵית יוֹסֵף</tei:l>
          <tei:l>יִרְבּוּ וְיִפְרוּ</tei:l>
          <tei:l>כְּגֶפֶן פּוֹרִיָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_ram_chasin_yah_hapaytan/14"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אַמֵּץ</tei:seg> בֶּן דָּוִד</tei:l>
          <tei:l>וְיִשְׁפֹּט תָּמִיד</tei:l>
          <tei:l>כָּל צַר תַּשְׁמִיד</tei:l>
          <tei:l>גָּרֵשׁ מֵעִיר יָהּ</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
