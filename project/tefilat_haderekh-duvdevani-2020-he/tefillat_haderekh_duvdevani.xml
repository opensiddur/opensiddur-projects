  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:tefillat_haderekh_duvdevani">
        <tei:head>תפילת הדרך</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tefillat_haderekh_duvdevani/1"/>
        <tei:lg>
          <tei:l>הלל הזקן אומר</tei:l>
          <tei:l>למקום שלבי אוהב לשם רגלי מוליכות אותי</tei:l>
          <tei:l>על פי תוספתא סוכה ד</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tefillat_haderekh_duvdevani/2"/>
        <tei:lg>
          <tei:l>הַנַּח לְרַגְלַי לָלֶכֶת</tei:l>
          <tei:l>לַמָּקוֹם</tei:l>
          <tei:l>שֶׁלִבִּי אוֹהֵב</tei:l>
          <tei:l>פְּתָח לִבִּי לְאֶהֹב</tei:l>
          <tei:l>אֶת הַמָּקוֹם</tei:l>
          <tei:l>אֵלָיו רַגְלָי הוֹלְכוֹת.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
