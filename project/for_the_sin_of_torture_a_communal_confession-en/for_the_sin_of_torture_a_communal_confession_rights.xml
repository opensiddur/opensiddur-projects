  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:for_the_sin_of_torture_a_communal_confession_rights">
        <tei:head>For the Sin of Torture: A Communal Confession by Rabbi Ed Feld</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:for_the_sin_of_torture_a_communal_confession_rights/1"/>
        <tei:lg>
          <tei:l>For the sin which we have committed before You</tei:l>
          <tei:l>for averting our eyes.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:for_the_sin_of_torture_a_communal_confession_rights/2"/>
        <tei:lg>
          <tei:l>For the sin which have committed before You</tei:l>
          <tei:l>for closing our ears.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:for_the_sin_of_torture_a_communal_confession_rights/3"/>
        <tei:lg>
          <tei:l>For the sin which we have committed before you</tei:l>
          <tei:l>through excessive fear.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:for_the_sin_of_torture_a_communal_confession_rights/4"/>
        <tei:lg>
          <tei:l>For the sin which we have committed before You</tei:l>
          <tei:l>through diminishing the image of God.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:for_the_sin_of_torture_a_communal_confession_rights/5"/>
        <tei:lg>
          <tei:l>For the sin which we have committed before You</tei:l>
          <tei:l>for the suffering and torture committed on others.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:for_the_sin_of_torture_a_communal_confession_rights/6"/>
        <tei:lg>
          <tei:l>For the sin which we have committed before You</tei:l>
          <tei:l>with the violence done in our name.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:for_the_sin_of_torture_a_communal_confession_rights/7"/>
        <tei:lg>
          <tei:l>For the sin which we have committed before You</tei:l>
          <tei:l>with our full knowledge or without our knowledge.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:for_the_sin_of_torture_a_communal_confession_rights/8"/>
        <tei:lg>
          <tei:l>
            <tei:hi rend="italic">V’al kulam eloah s’liḥot,</tei:hi>
          </tei:l>
          <tei:l>
            <tei:hi rend="italic">s’laḥ lanu, m’ḥal lanu, kaper lanu.</tei:hi>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>For all these sins, forgiving God,</tei:l>
          <tei:l>forgive us, pardon us, grant us atonement.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
