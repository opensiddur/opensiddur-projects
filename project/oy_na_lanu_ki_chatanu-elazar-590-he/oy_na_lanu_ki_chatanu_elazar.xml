    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:oy_na_lanu_ki_chatanu_elazar">
        <tei:head>אוֹי נָא לָֽנוּ כִּי חָטָֽאנוּ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:oy_na_lanu_ki_chatanu_elazar/1"/>
        <tei:lg>
          <tei:l>אוֹי נָא לָֽנוּ כִּי חָטָֽאנוּ.</tei:l>
          <tei:l>נֵשֵׁב בָּדָד וְנִבְכֶּה.</tei:l>
          <tei:l>עַל־אֵֽלֶּה אֶבְכֶּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:oy_na_lanu_ki_chatanu_elazar/2"/>
        <tei:lg>
          <tei:l>עַל אַרְמוֹן כִּי נֻטָּשׁ.</tei:l>
          <tei:l>נֵשֵׁב בָּדָד וְנִבְכֶּה.</tei:l>
          <tei:l>עַל בַּֽיִת כִּי נִשְׂרַף.</tei:l>
          <tei:l>נֵשֵׁב בָּדָד וְנִבְכֶּה.</tei:l>
          <tei:l>עַל־אֵֽלֶּה אֶבְכֶּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:oy_na_lanu_ki_chatanu_elazar/3"/>
        <tei:lg>
          <tei:l>עַל גְּזֵרוֹת כִּי נֻפָּֽצוּ.</tei:l>
          <tei:l>נֵשֵׁב בָּדָד וְנִבְכֶּה.</tei:l>
          <tei:l>עַל דְּבִיר כִּי נֶהֱרַס.</tei:l>
          <tei:l>נֵשֵׁב בָּדָד וְנִבְכֶּה.</tei:l>
          <tei:l>עַל־אֵֽלֶּה אֶבְכֶּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:oy_na_lanu_ki_chatanu_elazar/4"/>
        <tei:lg>
          <tei:l>עַל הֲדוּרִים כִּי נִכְחָֽדוּ.</tei:l>
          <tei:l>נֵשֵׁב בָּדָד וְנִבְכֶּה.</tei:l>
          <tei:l>עַל וָוִים כִּי הָבְקָֽעוּ.</tei:l>
          <tei:l>נֵשֵׁב בָּדָד וְנִבְכֶּה.</tei:l>
          <tei:l>עַל־אֵֽלֶּה אֶבְכֶּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:oy_na_lanu_ki_chatanu_elazar/5"/>
        <tei:lg>
          <tei:l>עַל זֵדִים כִּי הָגְבָּֽרוּ.</tei:l>
          <tei:l>נֵשֵׁב בָּדָד וְנִבְכֶּה.</tei:l>
          <tei:l>עַל חֶרְפָּה כִּי הָגְדָּֽלָה.</tei:l>
          <tei:l>נֵשֵׁב בָּדָד וְנִבְכֶּה.</tei:l>
          <tei:l>עַל־אֵֽלֶּה אֶבְכֶּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:oy_na_lanu_ki_chatanu_elazar/6"/>
        <tei:lg>
          <tei:l>עַל טֽוּרֵי אֶֽבֶן כִּי נִפְרָֽשׁוּ.</tei:l>
          <tei:l>נֵשֵׁב בָּדָד וְנִבְכֶּה.</tei:l>
          <tei:l>עַל יְלָדִים כִּי נִפְזָֽרוּ.</tei:l>
          <tei:l>נֵשֵׁב בָּדָד וְנִבְכֶּה.</tei:l>
          <tei:l>עַל־אֵֽלֶּה אֶבְכֶּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:oy_na_lanu_ki_chatanu_elazar/7"/>
        <tei:lg>
          <tei:l>עַל כַּֽעַס כִּי הִרְבָּה.</tei:l>
          <tei:l>נֵשֵׁב בָּדָד וְנִבְכֶּה.</tei:l>
          <tei:l>עַל לִמּוּדִים כִּי נִמְנָֽעוּ.</tei:l>
          <tei:l>נֵשֵׁב בָּדָד וְנִבְכֶּה.</tei:l>
          <tei:l>עַל־אֵֽלֶּה אֶבְכֶּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:oy_na_lanu_ki_chatanu_elazar/8"/>
        <tei:lg>
          <tei:l>עַל מְלָכִים כִּי נִמְאָֽסוּ.</tei:l>
          <tei:l>נֵשֵׁב בָּדָד וְנִבְכֶּה.</tei:l>
          <tei:l>עַל נְדִיבִים כִּי פַֽסּוּ.</tei:l>
          <tei:l>נֵשֵׁב בָּדָד וְנִבְכֶּה.</tei:l>
          <tei:l>עַל־אֵֽלֶּה אֶבְכֶּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:oy_na_lanu_ki_chatanu_elazar/9"/>
        <tei:lg>
          <tei:l>עַל שָׂרִים כִּי שֻׁדָּֽדוּ.</tei:l>
          <tei:l>נֵשֵׁב בָּדָד וְנִבְכֶּה.</tei:l>
          <tei:l>עַל עֲנָוִים כִּי הוֹבִֽישׁוּ.</tei:l>
          <tei:l>נֵשֵׁב בָּדָד וְנִבְכֶּה.</tei:l>
          <tei:l>עַל־אֵֽלֶּה אֶבְכֶּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:oy_na_lanu_ki_chatanu_elazar/10"/>
        <tei:lg>
          <tei:l>עַל פְּדוּיִם כִּי גָֽלוּ.</tei:l>
          <tei:l>נֵשֵׁב בָּדָד וְנִבְכֶּה.</tei:l>
          <tei:l>עַל צְמוּדִים כִּי נִפְרָֽדוּ.</tei:l>
          <tei:l>נֵשֵׁב בָּדָד וְנִבְכֶּה.</tei:l>
          <tei:l>עַל־אֵֽלֶּה אֶבְכֶּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:oy_na_lanu_ki_chatanu_elazar/11"/>
        <tei:lg>
          <tei:l>עַל קְרוֹבִים כִּי נִרְחָֽקוּ.</tei:l>
          <tei:l>נֵשֵׁב בָּדָד וְנִבְכֶּה.</tei:l>
          <tei:l>עַל רְבִיבִים כִּי נִמְחוּ.</tei:l>
          <tei:l>נֵשֵׁב בָּדָד וְנִבְכֶּה.</tei:l>
          <tei:l>עַל־אֵֽלֶּה אֶבְכֶּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:oy_na_lanu_ki_chatanu_elazar/12"/>
        <tei:lg>
          <tei:l>עַל שְׁלֵמִים כִּי טֻלְטָֽלוּ.</tei:l>
          <tei:l>נֵשֵׁב בָּדָד וְנִבְכֶּה.</tei:l>
          <tei:l>עַל תְּמִידִים כִּי בֻטָּֽלוּ.</tei:l>
          <tei:l>נֵשֵׁב בָּדָד וְנִבְכֶּה.</tei:l>
          <tei:l>עַל־אֵֽלֶּה אֶבְכֶּה׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
