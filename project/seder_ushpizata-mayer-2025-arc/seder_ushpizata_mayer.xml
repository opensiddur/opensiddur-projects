  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:seder_ushpizata_mayer">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_ushpizata_mayer/1"/>
        <tei:lg xml:lang="he">
          <tei:l>עוּלוּ אוּשְׁפִּיזָתָא עִילְיָתָא קַדִּישָׁתָא</tei:l>
          <tei:l>עוּלוּ אִמָּהָתָא עִילְיָתָא קַדִּישָׁתָא</tei:l>
          <tei:l>לְמִיתַב בְּצִילָּא דִמְהֵימְנוּתָא עִלָּאָה</tei:l>
          <tei:l>בְּצִלָּא דְקֻדְשָׁא בְּרִיךְ הוּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_ushpizata_mayer/2"/>
        <tei:lg xml:lang="he">
          <tei:l>תֵּיעוּל שָׂרָה רִבְקָה לֵאָה וְרָחֵל</tei:l>
          <tei:l>מִרְיָם דְּבוֹרָה וְרוּת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_ushpizata_mayer/3"/>
        <tei:lg xml:lang="he">
          <tei:l>תִּיבוּ תִּיבוּ אוּשְׁפִּיזָתָא עִילְיָתָא</tei:l>
          <tei:l>תִּיבוּ תִּיבוּ אוּשְׁפִּיזָתָא קַדִּישָׁתָא</tei:l>
          <tei:l>תִּיבוּ תִּיבוּ אוּשְׁפִּיזָתָא דִמְהֵימְנוּתָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_ushpizata_mayer/4"/>
        <tei:lg xml:lang="he">
          <tei:l>מַאן חָמֵי חֶדְוָה דְּצַדִּיקַיָּיא</tei:l>
          <tei:l>וּדְנָשִׁין זַכְיָין דְּעַבְדִּין</tei:l>
          <tei:l>לְגַבֵּי קוּדְשָׁא בְּרִיךְ הוּא׃ <tei:bibl>(זוהר פרשת שלח ר׳)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_ushpizata_mayer/5"/>
        <tei:lg xml:lang="he">
          <tei:l>אֲזַמֵּן לִסְעוּדָתִי אוּשְׁפִּיזָתָא עִלְיָתָא׃</tei:l>
          <tei:l>שָׂרָה רִבְקָה לֵאָה וְרָחֵל</tei:l>
          <tei:l>מִרְיָם דְּבוֹרָה וְרוּת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_ushpizata_mayer/6"/>
        <tei:lg xml:lang="he">
          <tei:l>
            <tei:note type="instruction">ביום א׳ (יום טוב של סוכות)</tei:note>
          </tei:l>
        </tei:lg>
        <tei:lg xml:lang="he">
          <tei:l>בְּמָטוּ מִנִּיךְ</tei:l>
          <tei:l>שָׂרָה דְּכִירְתָּא</tei:l>
          <tei:l>אֻשְׁפִּיזְתָּא עִלִיתָא</tei:l>
          <tei:l>דְּיֵתְבוּ עִמִּי וְעִמִּיךְ כׇּל־אוּשְׁפִּיזָתָא עִילְיָתָא׃</tei:l>
          <tei:l>רִבְקָה לֵאָה וְרָחֵל מִרְיָם דְּבוֹרָה וְרוּת׃</tei:l>
          <tei:l>וַֽיהֹוָ֛ה פָּקַ֥ד אֶת־שָׂרָ֖ה כַּאֲשֶׁ֣ר אָמָ֑ר</tei:l>
          <tei:l>וַיַּ֧עַשׂ יְהֹוָ֛ה לְשָׂרָ֖ה כַּאֲשֶׁ֥ר דִּבֵּֽר׃ <tei:bibl>(בראשית כא:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_ushpizata_mayer/7"/>
        <tei:lg xml:lang="he">
          <tei:l>
            <tei:note type="instruction">ביום ב׳ (יום טוב שני בגלות)</tei:note>
          </tei:l>
        </tei:lg>
        <tei:lg xml:lang="he">
          <tei:l>בְּמָטוּ מִנִּיךְ</tei:l>
          <tei:l>רִבְקָה רְחִימְתָּא</tei:l>
          <tei:l>אֻשְׁפִּיזְתָּא עִלִיתָא</tei:l>
          <tei:l>דְּיֵתְבוּ עִמִּי וְעִמִּיךְ כׇּל־אוּשְׁפִּיזָתָא עִילְיָתָא׃</tei:l>
          <tei:l>שָׂרָה לֵאָה וְרָחֵל מִרְיָם דְּבוֹרָה וְרוּת׃</tei:l>
          <tei:l>וַיְבָרְכ֤וּ אֶת־רִבְקָה֙ וַיֹּ֣אמְרוּ לָ֔הּ</tei:l>
          <tei:l>אֲחֹתֵ֕נוּ אַ֥תְּ הֲיִ֖י לְאַלְפֵ֣י רְבָבָ֑ה</tei:l>
          <tei:l>וְיִירַ֣שׁ זַרְעֵ֔ךְ אֵ֖ת שַׁ֥עַר שֹׂנְאָֽיו׃ <tei:bibl>(בראשית כד:ס)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_ushpizata_mayer/8"/>
        <tei:lg xml:lang="he">
          <tei:l>
            <tei:note type="instruction">ביום ג׳</tei:note>
          </tei:l>
        </tei:lg>
        <tei:lg xml:lang="he">
          <tei:l>בְּמָטוּ מִנִּיךְ</tei:l>
          <tei:l>לֵאָה יָלֵידְתָּא</tei:l>
          <tei:l>אֻשְׁפִּיזְתָּא עִלִיתָא</tei:l>
          <tei:l>דְּיֵתְבוּ עִמִּי וְעִמִּיךְ כׇּל־אוּשְׁפִּיזָתָא עִילְיָתָא׃</tei:l>
          <tei:l>שָׂרָה רִבְקָה וְרָחֵל מִרְיָם דְּבוֹרָה וְרוּת׃</tei:l>
          <tei:l>וַתֹּ֣אמֶר לֵאָ֔ה בְּאׇשְׁרִ֕י</tei:l>
          <tei:l>כִּ֥י אִשְּׁר֖וּנִי בָּנ֑וֹת</tei:l>
          <tei:l>וַתִּקְרָ֥א אֶת־שְׁמ֖וֹ אָשֵֽׁר׃ <tei:bibl>(בראשית ל:ג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_ushpizata_mayer/9"/>
        <tei:lg xml:lang="he">
          <tei:l>
            <tei:note type="instruction">ביום ד׳</tei:note>
          </tei:l>
        </tei:lg>
        <tei:lg xml:lang="he">
          <tei:l>בְּמָטוּ מִנִּיךְ</tei:l>
          <tei:l>רָחֵל מִתְנַחֲמְתָּא</tei:l>
          <tei:l>אֻשְׁפִּיזְתָּא עִלִיתָא</tei:l>
          <tei:l>דְּיֵתְבוּ עִמִּי וְעִמִּיךְ כׇּל־אוּשְׁפִּיזָתָא עִילְיָתָא׃</tei:l>
          <tei:l>שָׂרָה רִבְקָה וְלֵאָה מִרְיָם דְּבוֹרָה וְרוּת׃</tei:l>
          <tei:l>כֹּ֣ה ׀ אָמַ֣ר יְהֹוָ֗ה</tei:l>
          <tei:l>מִנְעִ֤י קוֹלֵךְ֙ מִבֶּ֔כִי</tei:l>
          <tei:l>וְעֵינַ֖יִךְ מִדִּמְעָ֑ה</tei:l>
          <tei:l>כִּי֩ יֵ֨שׁ שָׂכָ֤ר לִפְעֻלָּתֵךְ֙ נְאֻם־יְהֹוָ֔ה</tei:l>
          <tei:l>וְשָׁ֖בוּ מֵאֶ֥רֶץ אוֹיֵֽב׃ <tei:bibl>(ירמיה לא:טו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_ushpizata_mayer/10"/>
        <tei:lg xml:lang="he">
          <tei:l>
            <tei:note type="instruction">ביום ה׳</tei:note>
          </tei:l>
        </tei:lg>
        <tei:lg xml:lang="he">
          <tei:l>בְּמָטוּ מִנִּיךְ</tei:l>
          <tei:l>מִרְיָם נְבִיאֲתָא</tei:l>
          <tei:l>אֻשְׁפִּיזְתָּא עִלִיתָא</tei:l>
          <tei:l>דְּיֵתְבוּ עִמִּי וְעִמִּיךְ כׇּל־אוּשְׁפִּיזָתָא עִילְיָתָא׃</tei:l>
          <tei:l>שָׂרָה רִבְקָה לֵאָה וְרָחֵל דְּבוֹרָה וְרוּת׃</tei:l>
          <tei:l>וַתִּקַּח֩ מִרְיָ֨ם הַנְּבִיאָ֜ה אֲח֧וֹת אַהֲרֹ֛ן אֶת־הַתֹּ֖ף בְּיָדָ֑הּ</tei:l>
          <tei:l>וַתֵּצֶ֤אןָ כׇֽל־הַנָּשִׁים֙ אַחֲרֶ֔יהָ בְּתֻפִּ֖ים וּבִמְחֹלֹֽת׃ <tei:bibl>(שמות טו:כ)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_ushpizata_mayer/11"/>
        <tei:lg xml:lang="he">
          <tei:l>
            <tei:note type="instruction">ביום ו׳</tei:note>
          </tei:l>
        </tei:lg>
        <tei:lg xml:lang="he">
          <tei:l>בְּמָטוּ מִנִּיךְ</tei:l>
          <tei:l>דְּבוֹרָה דַּיָּנְתָּא</tei:l>
          <tei:l>אֻשְׁפִּיזְתָּא עִלִיתָא</tei:l>
          <tei:l>דְּיֵתְבוּ עִמִּי וְעִמִּיךְ כׇּל־אוּשְׁפִּיזָתָא עִילְיָתָא׃</tei:l>
          <tei:l>שָׂרָה רִבְקָה לֵאָה וְרָחֵל מִרְיָם וְרוּת׃</tei:l>
          <tei:l>עוּרִ֤י עוּרִי֙ דְּבוֹרָ֔ה ע֥וּרִי ע֖וּרִי דַּבְּרִי־שִׁ֑יר</tei:l>
          <tei:l>ק֥וּם בָּרָ֛ק וּֽשְׁבֵ֥ה שֶׁבְיְךָ֖ בֶּן־אֲבִינֹֽעַם׃ <tei:bibl>(שופטים ה:יב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_ushpizata_mayer/12"/>
        <tei:lg xml:lang="he">
          <tei:l>
            <tei:note type="instruction">ביום ז׳ (הושענא רבא)</tei:note>
          </tei:l>
        </tei:lg>
        <tei:lg xml:lang="he">
          <tei:l>בְּמָטוּ מִנִּיךְ</tei:l>
          <tei:l>רוּת גִּיּוֹרְתָא</tei:l>
          <tei:l>אֻשְׁפִּיזְתָּא עִלִיתָא</tei:l>
          <tei:l>דְּיֵתְבוּ עִמִּי וְעִמִּיךְ כׇּל־אוּשְׁפִּיזָתָא עִילְיָתָא׃</tei:l>
          <tei:l>שָׂרָה רִבְקָה לֵאָה וְרָחֵל מִרְיָם וּדְבוֹרָה׃</tei:l>
          <tei:l>וַתֹּ֤אמֶר רוּת֙ אַל־תִּפְגְּעִי־בִ֔י</tei:l>
          <tei:l>לְעׇזְבֵ֖ךְ לָשׁ֣וּב מֵאַחֲרָ֑יִךְ</tei:l>
          <tei:l>כִּ֠י אֶל־אֲשֶׁ֨ר תֵּלְכִ֜י אֵלֵ֗ךְ</tei:l>
          <tei:l>וּבַאֲשֶׁ֤ר תָּלִ֙ינִי֙ אָלִ֔ין</tei:l>
          <tei:l>עַמֵּ֣ךְ עַמִּ֔י</tei:l>
          <tei:l>וֵאלֹהַ֖יִךְ אֱלֹהָֽי׃ <tei:bibl>(רות א:טז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_ushpizata_mayer/13"/>
        <tei:lg xml:lang="he">
          <tei:l>
            <tei:note type="instruction">ביום שמיני עצרת שבגלות</tei:note>
          </tei:l>
        </tei:lg>
        <tei:lg xml:lang="he">
          <tei:l>בְּמָטוּ מִנִּיךְ</tei:l>
          <tei:l>אֶסְתֵּר מַלְכְּתָא</tei:l>
          <tei:l>אֻשְׁפִּיזְתָּא עִלִיתָא</tei:l>
          <tei:l>דְּיֵתְבוּ עִמִּי וְעִמִּיךְ כׇּל־אוּשְׁפִּיזָתָא עִילְיָתָא׃</tei:l>
          <tei:l>שָׂרָה רִבְקָה לֵאָה וְרָחֵל מִרְיָם דְּבוֹרָה וְרוּת׃</tei:l>
          <tei:l>וַיְהִ֣י ׀ בַּיּ֣וֹם הַשְּׁלִישִׁ֗י וַתִּלְבַּ֤שׁ אֶסְתֵּר֙ מַלְכ֔וּת</tei:l>
          <tei:l>וַֽתַּעֲמֹ֞ד בַּחֲצַ֤ר בֵּית־הַמֶּ֙לֶךְ֙ הַפְּנִימִ֔ית נֹ֖כַח בֵּ֣ית הַמֶּ֑לֶךְ</tei:l>
          <tei:l>וְ֠הַמֶּלֶךְ יוֹשֵׁ֞ב עַל־כִּסֵּ֤א מַלְכוּתוֹ֙ בְּבֵ֣ית הַמַּלְכ֔וּת נֹ֖כַח פֶּ֥תַח הַבָּֽיִת׃ <tei:bibl>(אסתר ה:א)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>