    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:memorial_prayer_for_abraham_lincoln_goldstein">
        <tei:head>שריך לינקאלען</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:memorial_prayer_for_abraham_lincoln_goldstein/1"/>
        <tei:lg>
          <tei:l>רָ֘חַ֤שׁ לִבִּ֨י ׀ דָּ֘בָ֤ר ט֗וֹב אֹמֵ֣ר אָ֭נִי מַעֲשַׂ֣י לְמֶ֑לֶךְ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:memorial_prayer_for_abraham_lincoln_goldstein/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אַ</tei:seg>שְׁרֶיךָ לִינְקאָלֶען מִי כָמוֹכָה</tei:l>
          <tei:l><tei:seg type="acrostic">בֵּ</tei:seg>ין מְלָכִים וְשָׁרִים מְאוֹד נִשֵּׂאתָ</tei:l>
          <tei:l><tei:seg type="acrostic">רַ</tei:seg>בּוֹת פָּעַלְתָּ בְּנֶפֶשׁ נְמוּכָה</tei:l>
          <tei:l><tei:seg type="acrostic">הִ</tei:seg>נְּךָ לְיָחִיד בְּאֶרֶץ דָּמִיתָ</tei:l>
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>י בָּרוֹזְנִים כְּלִינְקאָלֶען וּמִי יִתְהַלֵּל כָּמוֹהוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:memorial_prayer_for_abraham_lincoln_goldstein/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>ךָ שֵׁם גַּם בַּגִּבּוֹרִים</tei:l>
          <tei:l><tei:seg type="acrostic">יְ</tei:seg>מִינְךָ עֹשָׂה חָיִל</tei:l>
          <tei:l><tei:seg type="acrostic">נֶ</tei:seg>גְדָם חָזַרְתָּ חֶרֶב חֲלָלִים</tei:l>
          <tei:l><tei:seg type="acrostic">קֶ</tei:seg>שֶׁת דָּרַכְתָּ יוֹמָם וָלַיִל</tei:l>
          <tei:l><tei:seg type="acrostic">אָ</tei:seg>ב אֶחָד בְּרָאָנוּ אָמַרְתָ</tei:l>
          <tei:l><tei:seg type="acrostic">לָ</tei:seg>כֵן דְּרוֹר הִשְׁמַעְתָּ פְּקוּדֶיךָ</tei:l>
          <tei:l><tei:seg type="acrostic">עַ</tei:seg>ם הַכּוּשִׁים לְחֵרוּת גָּאַלְתָּ</tei:l>
          <tei:l><tei:seg type="acrostic">נֶ</tei:seg>צַח יְפָאֲרוּ וִיבָרְכוּ שְׁמֶךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:memorial_prayer_for_abraham_lincoln_goldstein/4"/>
        <tei:lg>
          <tei:l>מִי בָּרוֹזְנִים כְּלִינְקאָלֶען</tei:l>
          <tei:l>וּמִי יִתְפָּאֵר כָּמוֹהוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:memorial_prayer_for_abraham_lincoln_goldstein/5"/>
        <tei:lg>
          <tei:l>אַייזֶק גּאָלְדְשְׁטֵיין הַלֵּוִי</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
