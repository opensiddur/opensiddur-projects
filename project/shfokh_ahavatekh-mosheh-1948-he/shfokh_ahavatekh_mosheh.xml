    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:shfokh_ahavatekh_mosheh">
        <tei:head>שְׁפוֹךְ אֲהָבָתֵךְ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:shfokh_ahavatekh_mosheh/1"/>
        <tei:lg>
          <tei:l>שְׁפוֹךְ אֲהָבָתֵךְ עַל הַגּוֹיִם אֲשֶׁר יְדָעוּךָ</tei:l>
          <tei:l>וְעַל מַמְלָכוֹת אֲשֶׁר בְּשִׁמְךָ קוֹרְאִים</tei:l>
          <tei:l>בִּגְלַל חֲסָדִים שֶׁהֵם עוֹשִׂים עִם זֶרַע יַעֲקֹב</tei:l>
          <tei:l>וּמְגִינִּים עַל עַמְּךָ יִשְׁרָאֵל</tei:l>
          <tei:l>מִפְּנֵי אוֹכְלֵיהֶם,</tei:l>
          <tei:l>יִזְכּוּ לִרְאוֹת בְּטוֹבַת בְּחִירֶיךָ</tei:l>
          <tei:l>וְלִשְׂמוֹחַ בְּשִׂמְחַת גּוֹיֶּךָ. <tei:bibl>(תהלים קו:ה)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
