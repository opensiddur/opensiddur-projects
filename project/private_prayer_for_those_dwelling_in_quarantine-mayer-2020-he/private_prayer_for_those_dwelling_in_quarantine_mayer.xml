    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:private_prayer_for_those_dwelling_in_quarantine_mayer">
        <tei:head>תפילה פרטי ליושבי הסגר</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:private_prayer_for_those_dwelling_in_quarantine_mayer/1"/>
        <tei:lg>
          <tei:l>מִי שֶׁבֵּרַךְ אֲבוֹתַי אַנְשֵׁי תַּם</tei:l>
          <tei:l>וּפָקַד אִמּוֹתַי יוֹשְׁבוֹת אֹהָלִים</tei:l>
          <tei:l>וָיּוֹרֶה לְעַבְדּוֹ עֵץ רְפוּאַת הַמַּיִם</tei:l>
          <tei:l>וְרָפָא אֶת הַנְּבִיאָה מִצְרַעֲתָהּ</tei:l>
          <tei:l>וְכָרַת בְּרִית שָׁלוֹם</tei:l>
          <tei:l>לְאוֹהֵב שָׁלוֹם</tei:l>
          <tei:l>וְנָתַן רִפּוּי לִבְנֵי הַנְּבִיאִים</tei:l>
          <tei:l>וְשָׁלַח הַחֲלָמָה לַמְּלָכִים וְלַגֵּרִים</tei:l>
          <tei:l>הוּא יְחַזְּקֵנִי בְּהֶסְגֵּרַי</tei:l>
          <tei:l>וְיַעֲמֹץ לִבִּי בִּבְדִידוֹתַי.</tei:l>
          <tei:l>אֵיכָ֣ה ׀ יָשְׁבָ֣ה בָדָ֗ד</tei:l>
          <tei:l>בַּת־עַמְּךָ אָהֳלִיבָה</tei:l>
          <tei:l>לְקַבֵּל וּלְקַיֵּם אֶת־דִּבְרֵי הָרוֹפְאִים וְיוֹדְעֵי הַמַּחֲלִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:private_prayer_for_those_dwelling_in_quarantine_mayer/2"/>
        <tei:lg>
          <tei:l>וְהוֹי אֱלֹהַי וֵאלֹהֵי אֲבוֹתַי</tei:l>
          <tei:l>כִּֽי־מַר־לִ֤י מְאֹד֙</tei:l>
          <tei:l>לְהַפְרִידֵנִי מִמִּצְווֹתֶיךָ הַצִּבּוּרִים</tei:l>
          <tei:l>שֶׁהֵם חָיִינוּ וְאֹרֶךְ יָמֵינוּ</tei:l>
          <tei:l>וּמְקוֹר שִׂמְחָה וְרִנָּה בְּצָרוֹתֵינוּ.</tei:l>
          <tei:l>אֲבָל מֻכָּר וְיָדוּעַ לִי</tei:l>
          <tei:l>כִּי מַעְלָה מַעְלָה עַל כׇּל־מִצְוָה גְּדוֹלָה וּקְטַנָּה</tei:l>
          <tei:l>(חוּץ מִלָּסוּר מֵעֲבוֹדָה זָרָה</tei:l>
          <tei:l>וְגִלּוּי עֲרָיוֹת וּשְׁפִיכוּת דָּמִים)</tei:l>
          <tei:l>עָלַי לִפְקֹחַ נֶפֶשׁ לִחְיוֹת בָּהֶם</tei:l>
          <tei:l>וּלְהַחֲיוֹת בָּהֶם</tei:l>
          <tei:l>שֶׁבְּחֶסֶד וֶאֱמֶת יִהְיוּ חָיִינוּ</tei:l>
          <tei:l>וְאֹרֶךְ יָמֵינוּ לְעֹלָם וָעֶד</tei:l>
          <tei:l>וְהַשְׁתָּא קְרוֹבָה לָבוֹא</tei:l>
          <tei:l>קַיֵּם־לִי וּלְכׇל־בֵּית יִשְׂרָאֵל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:private_prayer_for_those_dwelling_in_quarantine_mayer/3"/>
        <tei:lg>
          <tei:l>כְּמוֹ שֶׁכָּתוּב עַל־יַד מֹשֶׁה נְבִיאֲךָ</tei:l>
          <tei:l>כָּאָמוּר —</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:private_prayer_for_those_dwelling_in_quarantine_mayer/5"/>
        <tei:lg>
          <tei:l>וַיֹּ֩אמֶר֩ אִם־שָׁמ֨וֹעַ תִּשְׁמַ֜ע לְק֣וֹל ׀ יְהֹוָ֣ה אֱלֹהֶ֗יךָ</tei:l>
          <tei:l>וְהַיָּשָׁ֤ר בְּעֵינָיו֙ תַּעֲשֶׂ֔ה</tei:l>
          <tei:l>וְהַֽאֲזַנְתָּ֙ לְמִצְוֺתָ֔יו</tei:l>
          <tei:l>וְשָׁמַרְתָּ֖ כׇּל־חֻקָּ֑יו</tei:l>
          <tei:l>כׇּֽל־הַמַּחֲלָ֞ה אֲשֶׁר־שַׂ֤מְתִּי בְמִצְרַ֙יִם֙ לֹא־אָשִׂ֣ים עָלֶ֔יךָ</tei:l>
          <tei:l>כִּ֛י אֲנִ֥י יְהֹוָ֖ה רֹפְאֶֽךָ׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וַיֹּ֩אמֶר֩ אִם־שָׁמ֨וֹעַ תִּשְׁמַ֜ע לְק֣וֹל ׀ יְהֹוָ֣ה אֱלֹהֶ֗יךָ</tei:l>
          <tei:l>וְהַיָּשָׁ֤ר בְּעֵינָיו֙ תַּעֲשֶׂ֔ה</tei:l>
          <tei:l>וְהַֽאֲזַנְתָּ֙ לְמִצְוֺתָ֔יו</tei:l>
          <tei:l>וְשָׁמַרְתָּ֖ כׇּל־חֻקָּ֑יו</tei:l>
          <tei:l>כׇּֽל־הַמַּחֲלָ֞ה אֲשֶׁר־שַׂ֤מְתִּי בְמִצְרַ֙יִם֙ לֹא־אָשִׂ֣ים עָלֶ֔יךָ</tei:l>
          <tei:l>כִּ֛י אֲנִ֥י יְהֹוָ֖ה רֹפְאֶֽךָ׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וַאֲמַר֩ אִם־קַבָּ֨לָא תְקַבֵּ֜יל לְמֵימְרָ֣א ׀ דַּי֣יָ אֱלָהָ֗ךְ</tei:l>
          <tei:l>וּדְכָשַׁ֤ר קֳדָמ֙וֹהִי֙ תַּעֲבֵ֔יד</tei:l>
          <tei:l>וּתְצִ֖ית לְפִקּוֹד֑וֹהִי</tei:l>
          <tei:l>וְתִטַּר־כָּל־קְיָמוֹהִי־</tei:l>
          <tei:l>כָּל־מַרְעִ֞ין דְּשַׁוִּ֤יתִי בְּמִצְרַ֙יִם֙ לָא־אֲשַׁוֵּ֣ינוּן עֲלָ֔ךְ</tei:l>
          <tei:l>אֲרֵ֛י אֲנָ֥א יְיָ֖ אָסָֽךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:private_prayer_for_those_dwelling_in_quarantine_mayer/6"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:private_prayer_for_those_dwelling_in_quarantine_mayer/7"/>
        <tei:lg>
          <tei:l>וַיִּצְעַ֣ק מֹשֶׁ֔ה אֶל־יְהֹוָ֖ה לֵאמֹ֑ר</tei:l>
          <tei:l>אֵ֕ל נָ֛א רְפָ֥א נָ֖א לָֽהּ׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וַיִּצְעַ֣ק מֹשֶׁ֔ה אֶל־יְהֹוָ֖ה לֵאמֹ֑ר</tei:l>
          <tei:l>אֵ֕ל נָ֛א רְפָ֥א נָ֖א לָֽהּ׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְצַלִּ֣י מֹשֶׁ֔ה קֳדָם־יְיָ֖ לְמֵימַ֑ר</tei:l>
          <tei:l>אֱלָ֕הָא בְּבָע֛וּ אַסִּ֥י כְעַ֖ן יָתַֽהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:private_prayer_for_those_dwelling_in_quarantine_mayer/8"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:private_prayer_for_those_dwelling_in_quarantine_mayer/9"/>
        <tei:lg>
          <tei:l>וַיַּעֲמֹ֥ד בֵּֽין־הַמֵּתִ֖ים וּבֵ֣ין הַֽחַיִּ֑ים</tei:l>
          <tei:l>וַתֵּעָצַ֖ר הַמַּגֵּפָֽה׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וַיַּעֲמֹ֥ד בֵּֽין־הַמֵּתִ֖ים וּבֵ֣ין הַֽחַיִּ֑ים</tei:l>
          <tei:l>וַתֵּעָצַ֖ר הַמַּגֵּפָֽה׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְקָ֥ם בֵּין־מִיתַ֖יָּא וּבֵ֣ין חַיַּ֑יָּא</tei:l>
          <tei:l>וְאִתְכְּלִ֖י מוֹתָֽנָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:private_prayer_for_those_dwelling_in_quarantine_mayer/10"/>
        <tei:lg>
          <tei:l>וּבְמַשְּׂאוֹת יִרְמְיָהוּ נְבִיאֶיךָ</tei:l>
          <tei:l>כָּתוּב לֵאמֹר —</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:private_prayer_for_those_dwelling_in_quarantine_mayer/11"/>
        <tei:lg>
          <tei:l>רְפָאֵ֤נִי יְהֹוָה֙ וְאֵ֣רָפֵ֔א הוֹשִׁיעֵ֖נִי וְאִוָּשֵׁ֑עָה</tei:l>
          <tei:l>כִּ֥י תְהִלָּתִ֖י אָֽתָּה׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>רְפָאֵ֤נִי יְהֹוָה֙ וְאֵ֣רָפֵ֔א הוֹשִׁיעֵ֖נִי וְאִוָּשֵׁ֑עָה</tei:l>
          <tei:l>כִּ֥י תְהִלָּתִ֖י אָֽתָּה׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>אַסְיֵ֤נִי יְיָ֙ וְאֶ֣תַּסֵ֔י פְרוֹקְנִ֖י וְאֶתְפְּרַ֑ק</tei:l>
          <tei:l>אֲרֵ֥י תּוּשְׁבַּחְתִּ֖י אָֽתְּ:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:private_prayer_for_those_dwelling_in_quarantine_mayer/12"/>
        <tei:lg>
          <tei:l>וּבְסֵפֶר יַלְקוּט זְמִירוֹת לְדָוִד</tei:l>
          <tei:l>כָּתַב עַבְדְּךָ לֵאמֹר —</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:private_prayer_for_those_dwelling_in_quarantine_mayer/13"/>
        <tei:lg>
          <tei:l>יֹ֭שֵׁב בְּסֵ֣תֶר עֶלְי֑וֹן</tei:l>
          <tei:l>בְּצֵ֥ל שַׁ֝דַּ֗י יִתְלוֹנָֽן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:private_prayer_for_those_dwelling_in_quarantine_mayer/14"/>
        <tei:lg>
          <tei:l>אֹמַ֗ר לַ֭יהֹוָה מַחְסִ֣י וּמְצוּדָתִ֑י</tei:l>
          <tei:l>אֱ֝לֹהַ֗י אֶבְטַח־בּֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:private_prayer_for_those_dwelling_in_quarantine_mayer/15"/>
        <tei:lg>
          <tei:l>כִּ֤י ה֣וּא יַ֭צִּילְךָ מִפַּ֥ח יָק֗וּשׁ</tei:l>
          <tei:l>מִדֶּ֥בֶר הַוּֽוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:private_prayer_for_those_dwelling_in_quarantine_mayer/16"/>
        <tei:lg>
          <tei:l>בְּאֶבְרָת֨וֹ ׀ יָ֣סֶךְ לָ֭ךְ וְתַחַת־כְּנָפָ֣יו תֶּחְסֶ֑ה</tei:l>
          <tei:l>צִנָּ֖ה וְסֹחֵרָ֣ה אֲמִתּֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:private_prayer_for_those_dwelling_in_quarantine_mayer/17"/>
        <tei:lg>
          <tei:l>לֹֽא־תִ֭ירָא מִפַּ֣חַד לָ֑יְלָה</tei:l>
          <tei:l>מֵ֝חֵ֗ץ יָע֥וּף יוֹמָֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:private_prayer_for_those_dwelling_in_quarantine_mayer/18"/>
        <tei:lg>
          <tei:l>מִ֭דֶּבֶר בָּאֹ֣פֶל יַהֲלֹ֑ךְ</tei:l>
          <tei:l>מִ֝קֶּ֗טֶב יָשׁ֥וּד צׇהֳרָֽיִם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:private_prayer_for_those_dwelling_in_quarantine_mayer/19"/>
        <tei:lg>
          <tei:l>יִפֹּ֤ל מִצִּדְּךָ֨ ׀ אֶ֗לֶף וּרְבָבָ֥ה מִימִינֶ֑ךָ</tei:l>
          <tei:l>אֵ֝לֶ֗יךָ לֹ֣א יִגָּֽשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:private_prayer_for_those_dwelling_in_quarantine_mayer/20"/>
        <tei:lg>
          <tei:l>רַ֭ק בְּעֵינֶ֣יךָ תַבִּ֑יט</tei:l>
          <tei:l>וְשִׁלֻּמַ֖ת רְשָׁעִ֣ים תִּרְאֶֽה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:private_prayer_for_those_dwelling_in_quarantine_mayer/21"/>
        <tei:lg>
          <tei:l>כִּֽי־אַתָּ֣ה יְהֹוָ֣ה מַחְסִ֑י</tei:l>
          <tei:l>עֶ֝לְי֗וֹן שַׂ֣מְתָּ מְעוֹנֶֽךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:private_prayer_for_those_dwelling_in_quarantine_mayer/22"/>
        <tei:lg>
          <tei:l>לֹא־תְאֻנֶּ֣ה אֵלֶ֣יךָ רָעָ֑ה</tei:l>
          <tei:l>וְ֝נֶ֗גַע לֹא־יִקְרַ֥ב בְּאׇהֳלֶֽךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:private_prayer_for_those_dwelling_in_quarantine_mayer/23"/>
        <tei:lg>
          <tei:l>כִּ֣י מַ֭לְאָכָיו יְצַוֶּה־לָּ֑ךְ</tei:l>
          <tei:l>לִ֝שְׁמׇרְךָ֗ בְּכׇל־דְּרָכֶֽיךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:private_prayer_for_those_dwelling_in_quarantine_mayer/24"/>
        <tei:lg>
          <tei:l>עַל־כַּפַּ֥יִם יִשָּׂא֑וּנְךָ</tei:l>
          <tei:l>פֶּן־תִּגֹּ֖ף בָּאֶ֣בֶן רַגְלֶֽךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:private_prayer_for_those_dwelling_in_quarantine_mayer/25"/>
        <tei:lg>
          <tei:l>עַל־שַׁ֣חַל וָפֶ֣תֶן תִּדְרֹ֑ךְ</tei:l>
          <tei:l>תִּרְמֹ֖ס כְּפִ֣יר וְתַנִּֽין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:private_prayer_for_those_dwelling_in_quarantine_mayer/26"/>
        <tei:lg>
          <tei:l>כִּ֤י בִ֣י חָ֭שַׁק וַאֲפַלְּטֵ֑הוּ</tei:l>
          <tei:l>אֲ֝שַׂגְּבֵ֗הוּ כִּֽי־יָדַ֥ע שְׁמִֽי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:private_prayer_for_those_dwelling_in_quarantine_mayer/27"/>
        <tei:lg>
          <tei:l>יִקְרָאֵ֨נִי ׀ וְֽאֶעֱנֵ֗הוּ</tei:l>
          <tei:l>עִמּֽוֹ־אָנֹכִ֥י בְצָרָ֑ה</tei:l>
          <tei:l>אֲ֝חַלְּצֵ֗הוּ וַאֲכַבְּדֵֽהוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:private_prayer_for_those_dwelling_in_quarantine_mayer/29"/>
        <tei:lg>
          <tei:l>אֹ֣רֶךְ יָ֭מִים אַשְׂבִּיעֵ֑הוּ</tei:l>
          <tei:l>וְ֝אַרְאֵ֗הוּ בִּישׁוּעָתִֽי׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>אֹ֣רֶךְ יָ֭מִים אַשְׂבִּיעֵ֑הוּ</tei:l>
          <tei:l>וְ֝אַרְאֵ֗הוּ בִּישׁוּעָתִֽי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:private_prayer_for_those_dwelling_in_quarantine_mayer/30"/>
        <tei:lg>
          <tei:l>כִּי אַתָּה רוֹפֵא כׇל־בָּשָׂר</tei:l>
          <tei:l>וּמַפְלִיא לַעֲשׂוֹת</tei:l>
          <tei:l>וְרוֹפֵא חוֹלֵי</tei:l>
          <tei:l>עַמְּךָ יִשְׂרָאֵל</tei:l>
          <tei:l>וְנָתַן וְנוֹתֵן וְיִתֵּן רְפוּאָה</tei:l>
          <tei:l>לְכׇל־בְּנֵי אָדָם יְצוּרֶיךָ.</tei:l>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>שׁוֹמֵעַ תְּפִלָּה׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
