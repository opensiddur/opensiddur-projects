  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai_there_is_none_like_yhvh">
        <tei:head>אֵין אַדִּיר כַּיְיָ (מִפִּי אֵל)‏</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai_there_is_none_like_yhvh/1"/>
        <tei:lg>
          <tei:l>מִפִּי אֵל, מִפִּי אֵל,</tei:l>
          <tei:l>יִבוֹרַךְ יִשְׂרָאֵל.</tei:l>
          <tei:l>מִפִּי אֵל, מִפִּי אֵל,</tei:l>
          <tei:l>יִבוֹרַךְ יִשְׂרָאֵל.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai_there_is_none_like_yhvh/2"/>
        <tei:lg>
          <tei:l>אֵין <tei:seg type="acrostic">אַ</tei:seg>דִּיר כַּיְיָ,</tei:l>
          <tei:l>וְאֵין <tei:seg type="acrostic">בָּ</tei:seg>רוּךְ כְּבֶן עַמְרָם.</tei:l>
          <tei:l>אֵין <tei:seg type="acrostic">גְ</tei:seg>דוּלָה כַּתּוֹרָה,</tei:l>
          <tei:l>וְאֵין <tei:seg type="acrostic">דּ</tei:seg>וֹרְשֶׁיהָּ כְּיִשְׂרָאֵל.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai_there_is_none_like_yhvh/3"/>
        <tei:lg>
          <tei:l>אֵין <tei:seg type="acrostic">הָ</tei:seg>דוּר כַּיְיָ,</tei:l>
          <tei:l>וְאֵין <tei:seg type="acrostic">וָ</tei:seg>תִיק כְּבֶן עַמְרָם.</tei:l>
          <tei:l>אֵין <tei:seg type="acrostic">זְ</tei:seg>כִיָה כַּתּוֹרָה,</tei:l>
          <tei:l>וְאֵין <tei:seg type="acrostic">חֲ</tei:seg>כָמֶיהָּ כְּיִשְׂרָאֵל.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai_there_is_none_like_yhvh/4"/>
        <tei:lg>
          <tei:l>אֵין <tei:seg type="acrostic">טָ</tei:seg>הוֹר כַּיְיָ,</tei:l>
          <tei:l>וְאֵין <tei:seg type="acrostic">יָ</tei:seg>שָׁר כְּבֶן עַמְרָם.</tei:l>
          <tei:l>אֵין <tei:seg type="acrostic">כְּ</tei:seg>בוּדָה כַּתּוֹרָה,</tei:l>
          <tei:l>וְאֵין <tei:seg type="acrostic">ל</tei:seg>וֹמְדֶיהָ כְּיִשְׂרָאֵל.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai_there_is_none_like_yhvh/5"/>
        <tei:lg>
          <tei:l>אֵין <tei:seg type="acrostic">מֶ</tei:seg>לֶךְ כַּיְיָ,</tei:l>
          <tei:l>וְאֵין <tei:seg type="acrostic">נָ</tei:seg>בִיא כְּבֶן עַמְרָם.</tei:l>
          <tei:l>אֵין <tei:seg type="acrostic">סְ</tei:seg>גֻלָּה כַּתּוֹרָה,</tei:l>
          <tei:l>וְאֵין <tei:seg type="acrostic">ע</tei:seg>וֹסְקֶיהָ כְּיִשְׂרָאֵל.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai_there_is_none_like_yhvh/6"/>
        <tei:lg>
          <tei:l>אֵין <tei:seg type="acrostic">פּ</tei:seg>וֹדֶה כַּיְיָ,</tei:l>
          <tei:l>וְאֵין <tei:seg type="acrostic">צַ</tei:seg>דִּיק כְּבֶן עַמְרָם.</tei:l>
          <tei:l>אֵין <tei:seg type="acrostic">קְ</tei:seg>דוּשָׁה כַּתּוֹרָה,</tei:l>
          <tei:l>וְאֵין <tei:seg type="acrostic">ר</tei:seg>וֹמְמֶיהָ כְּיִשְׂרָאֵל.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai_there_is_none_like_yhvh/7"/>
        <tei:lg>
          <tei:l>אֵין <tei:seg type="acrostic">קָ</tei:seg>דוֹשׁ כַּיְיָ,</tei:l>
          <tei:l>וְאֵין <tei:seg type="acrostic">רַ</tei:seg>חוּם כְּבֶן עַמְרָם.</tei:l>
          <tei:l>אֵין <tei:seg type="acrostic">שְׁ</tei:seg>מִירָה כַּתּוֹרָה,</tei:l>
          <tei:l>וְאֵין <tei:seg type="acrostic">תּ</tei:seg>וֹמְכֶיהָ כְּיִשְׂרָאֵל.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
