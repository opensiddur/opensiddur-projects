  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:waahed_ezdiwa_a_judeo_moroccan_arabic_darija_adaptation">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:waahed_ezdiwa_a_judeo_moroccan_arabic_darija_adaptation/1"/>
        <tei:lg>
          <tei:l>وحد الجديوة</tei:l>
          <tei:l>وحد الجديوة</tei:l>
          <tei:l>دی شرالی بابا</tei:l>
          <tei:l>بجوج ڢلوس</tei:l>
          <tei:l>وحد الجديوة</tei:l>
          <tei:l>وحد الجديوة</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:waahed_ezdiwa_a_judeo_moroccan_arabic_darija_adaptation/2"/>
        <tei:lg>
          <tei:l>وجات ال⁧قطيطة⁩</tei:l>
          <tei:l>وکلت⁩ الجديوة</tei:l>
          <tei:l>دی شرالی بابا</tei:l>
          <tei:l>بجوج ڢلوس</tei:l>
          <tei:l>وحد الجديوة</tei:l>
          <tei:l>وحد الجديوة</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:waahed_ezdiwa_a_judeo_moroccan_arabic_darija_adaptation/3"/>
        <tei:lg>
          <tei:l>وجات ال⁧کليبة⁩</tei:l>
          <tei:l>وعضت ال⁧قطيطة⁩</tei:l>
          <tei:l>دی کلت⁩ الجديوة</tei:l>
          <tei:l>دی شرالی بابا</tei:l>
          <tei:l>بجوج ڢلوس</tei:l>
          <tei:l>وحد الجديوة</tei:l>
          <tei:l>وحد الجديوة</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:waahed_ezdiwa_a_judeo_moroccan_arabic_darija_adaptation/4"/>
        <tei:lg>
          <tei:l>وجات العصوة</tei:l>
          <tei:l>وضربت ال⁧کليبة</tei:l>
          <tei:l>دی عضت ال⁧قطيطة⁩</tei:l>
          <tei:l>دی کلت⁩ الجديوة</tei:l>
          <tei:l>دی شرالی بابا</tei:l>
          <tei:l>بجوج ڢلوس</tei:l>
          <tei:l>وحد الجديوة</tei:l>
          <tei:l>وحد الجديوة</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:waahed_ezdiwa_a_judeo_moroccan_arabic_darija_adaptation/5"/>
        <tei:lg>
          <tei:l>وجات العويڢية</tei:l>
          <tei:l>وحرقت العصوة</tei:l>
          <tei:l>دی ضربت ال⁧کليبة</tei:l>
          <tei:l>دی عضت ال⁧قطيطة⁩</tei:l>
          <tei:l>دی کلت⁩ الجديوة</tei:l>
          <tei:l>دی شرالی بابا</tei:l>
          <tei:l>بجوج ڢلوس</tei:l>
          <tei:l>وحد الجديوة</tei:l>
          <tei:l>وحد الجديوة</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:waahed_ezdiwa_a_judeo_moroccan_arabic_darija_adaptation/6"/>
        <tei:lg>
          <tei:l>وجات المويمة</tei:l>
          <tei:l>وطڢات العويڢيه</tei:l>
          <tei:l>دی حرقت العصوة</tei:l>
          <tei:l>دی ضربت ال⁧کليبة</tei:l>
          <tei:l>دی عضت ال⁧قطيطة⁩</tei:l>
          <tei:l>دی کلت⁩ الجديوة</tei:l>
          <tei:l>دی شرالی بابا</tei:l>
          <tei:l>بجوج ڢلوس</tei:l>
          <tei:l>وحد الجديوة</tei:l>
          <tei:l>وحد الجديوة</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:waahed_ezdiwa_a_judeo_moroccan_arabic_darija_adaptation/7"/>
        <tei:lg>
          <tei:l>وجا التور</tei:l>
          <tei:l>وشرب المويمة</tei:l>
          <tei:l>دی طڢات العويڢيه</tei:l>
          <tei:l>دی حرقت العصوة</tei:l>
          <tei:l>دی ضربت ال⁧کليبة</tei:l>
          <tei:l>دی عضت ال⁧قطيطة⁩</tei:l>
          <tei:l>دی کلت⁩ الجديوة</tei:l>
          <tei:l>دی شرالی بابا</tei:l>
          <tei:l>بجوج ڢلوس</tei:l>
          <tei:l>وحد الجديوة</tei:l>
          <tei:l>وحد الجديوة</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:waahed_ezdiwa_a_judeo_moroccan_arabic_darija_adaptation/8"/>
        <tei:lg>
          <tei:l>وجا الذبّح</tei:l>
          <tei:l>وذبح التور</tei:l>
          <tei:l>دی شرب المويمة</tei:l>
          <tei:l>دی طڢات العويڢيه</tei:l>
          <tei:l>دی حرقت العصوة</tei:l>
          <tei:l>دی ضربت ال⁧کليبة</tei:l>
          <tei:l>دی عضت ال⁧قطيطة⁩</tei:l>
          <tei:l>دی کلت⁩ الجديوة</tei:l>
          <tei:l>دی شرالی بابا</tei:l>
          <tei:l>بجوج ڢلوس</tei:l>
          <tei:l>وحد الجديوة</tei:l>
          <tei:l>وحد الجديوة</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:waahed_ezdiwa_a_judeo_moroccan_arabic_darija_adaptation/9"/>
        <tei:lg>
          <tei:l>وجا ملاك هموت</tei:l>
          <tei:l>وذبح الذبّح</tei:l>
          <tei:l>دی ذبح التور</tei:l>
          <tei:l>دی شرب المويمة</tei:l>
          <tei:l>دی طڢات العويڢيه</tei:l>
          <tei:l>دی حرقت العصوة</tei:l>
          <tei:l>دی ضربت ال⁧کليبة</tei:l>
          <tei:l>دی عضت ال⁧قطيطة⁩</tei:l>
          <tei:l>دی کلت⁩ الجديوة</tei:l>
          <tei:l>دی شرالی بابا</tei:l>
          <tei:l>بجوج ڢلوس</tei:l>
          <tei:l>وحد الجديوة</tei:l>
          <tei:l>وحد الجديوة</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:waahed_ezdiwa_a_judeo_moroccan_arabic_darija_adaptation/10"/>
        <tei:lg>
          <tei:l>وجا هقدوش بروك هوا</tei:l>
          <tei:l>وذبح ملاك هموت</tei:l>
          <tei:l>دی ذبح الذبّح</tei:l>
          <tei:l>دی ذبح التور</tei:l>
          <tei:l>دی شرب المويمة</tei:l>
          <tei:l>دی طڢات العويڢيه</tei:l>
          <tei:l>دی حرقت العصوة</tei:l>
          <tei:l>دی ضربت ال⁧کليبة</tei:l>
          <tei:l>دی عضت ال⁧قطيطة⁩</tei:l>
          <tei:l>دی کلت⁩ الجديوة</tei:l>
          <tei:l>دی شرالی بابا</tei:l>
          <tei:l>بجوج ڢلوس</tei:l>
          <tei:l>وحد الجديوة</tei:l>
          <tei:l>وحد الجديوة</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
