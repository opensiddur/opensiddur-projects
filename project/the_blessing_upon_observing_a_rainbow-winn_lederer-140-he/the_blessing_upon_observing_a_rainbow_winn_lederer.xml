      <tei:div corresp="urn:x-opensiddur:text:prayer:the_blessing_upon_observing_a_rainbow_winn_lederer">
        <tei:head>בִּרְכַּת הַקֶּשֶׁת</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_blessing_upon_observing_a_rainbow_winn_lederer/1"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>זוֹכֵר הַבְּרִית</tei:l>
          <tei:l>וְנֶאֱמָן בִּבְרִיתוֹ</tei:l>
          <tei:l>וְקַיָּים בְּמַאֲמָרוֹ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_blessing_upon_observing_a_rainbow_winn_lederer/2"/>
        <tei:lg>
          <tei:l>
            <tei:bibl>בראשית ט:ח-יז</tei:bibl>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">y=ט:ח</tei:hi> וַיֹּ֤אמֶר אֱלֹהִים֙ אֶל־נֹ֔חַ וְאֶל־בָּנָ֥יו אִתּ֖וֹ לֵאמֹֽר׃ <tei:hi rend="superscript">ט</tei:hi> וַאֲנִ֕י הִנְנִ֥י מֵקִ֛ים אֶת־בְּרִיתִ֖י אִתְּכֶ֑ם וְאֶֽת־זַרְעֲכֶ֖ם אַֽחֲרֵיכֶֽם׃ <tei:hi rend="superscript">י</tei:hi> וְאֵ֨ת כׇּל־נֶ֤פֶשׁ הַֽחַיָּה֙ אֲשֶׁ֣ר אִתְּכֶ֔ם בָּע֧וֹף בַּבְּהֵמָ֛ה וּֽבְכׇל־חַיַּ֥ת הָאָ֖רֶץ אִתְּכֶ֑ם מִכֹּל֙ יֹצְאֵ֣י הַתֵּבָ֔ה לְכֹ֖ל חַיַּ֥ת הָאָֽרֶץ׃ <tei:hi rend="superscript">יא</tei:hi> וַהֲקִמֹתִ֤י אֶת־בְּרִיתִי֙ אִתְּכֶ֔ם וְלֹֽא־יִכָּרֵ֧ת כׇּל־בָּשָׂ֛ר ע֖וֹד מִמֵּ֣י הַמַּבּ֑וּל וְלֹֽא־יִהְיֶ֥ה ע֛וֹד מַבּ֖וּל לְשַׁחֵ֥ת הָאָֽרֶץ׃ <tei:hi rend="superscript">יב</tei:hi> וַיֹּ֣אמֶר אֱלֹהִ֗ים זֹ֤את אֽוֹת־הַבְּרִית֙ אֲשֶׁר־אֲנִ֣י נֹתֵ֗ן בֵּינִי֙ וּבֵ֣ינֵיכֶ֔ם וּבֵ֛ין כׇּל־נֶ֥פֶשׁ חַיָּ֖ה אֲשֶׁ֣ר אִתְּכֶ֑ם לְדֹרֹ֖ת עוֹלָֽם׃ <tei:hi rend="superscript">יג</tei:hi> אֶת־קַשְׁתִּ֕י נָתַ֖תִּי בֶּֽעָנָ֑ן וְהָֽיְתָה֙ לְא֣וֹת בְּרִ֔ית בֵּינִ֖י וּבֵ֥ין הָאָֽרֶץ׃ <tei:hi rend="superscript">יד</tei:hi> וְהָיָ֕ה בְּעַֽנְנִ֥י עָנָ֖ן עַל־הָאָ֑רֶץ וְנִרְאֲתָ֥ה הַקֶּ֖שֶׁת בֶּעָנָֽן׃ <tei:hi rend="superscript">טו</tei:hi> וְזָכַרְתִּ֣י אֶת־בְּרִיתִ֗י אֲשֶׁ֤ר בֵּינִי֙ וּבֵ֣ינֵיכֶ֔ם וּבֵ֛ין כׇּל־נֶ֥פֶשׁ חַיָּ֖ה בְּכׇל־בָּשָׂ֑ר וְלֹֽא־יִֽהְיֶ֨ה ע֤וֹד הַמַּ֙יִם֙ לְמַבּ֔וּל לְשַׁחֵ֖ת כׇּל־בָּשָֽׂר׃ <tei:hi rend="superscript">טז</tei:hi> וְהָיְתָ֥ה הַקֶּ֖שֶׁת בֶּֽעָנָ֑ן וּרְאִיתִ֗יהָ לִזְכֹּר֙ בְּרִ֣ית עוֹלָ֔ם בֵּ֣ין אֱלֹהִ֔ים וּבֵין֙ כׇּל־נֶ֣פֶשׁ חַיָּ֔ה בְּכׇל־בָּשָׂ֖ר אֲשֶׁ֥ר עַל־הָאָֽרֶץ׃ <tei:hi rend="superscript">יז</tei:hi> וַיֹּ֥אמֶר אֱלֹהִ֖ים אֶל־נֹ֑חַ זֹ֤את אֽוֹת־הַבְּרִית֙ אֲשֶׁ֣ר הֲקִמֹ֔תִי בֵּינִ֕י וּבֵ֥ין כׇּל־בָּשָׂ֖ר אֲשֶׁ֥ר עַל־הָאָֽרֶץ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_blessing_upon_observing_a_rainbow_winn_lederer/3"/>
        <tei:lg>
          <tei:l>
            <tei:bibl>יחזקאל א:כח</tei:bibl>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>כְּמַרְאֵ֣ה הַקֶּ֡שֶׁת</tei:l>
          <tei:l>אֲשֶׁר֩ יִֽהְיֶ֨ה בֶעָנָ֜ן בְּי֣וֹם הַגֶּ֗שֶׁם</tei:l>
          <tei:l>כֵּ֣ן מַרְאֵ֤ה הַנֹּ֙גַהּ֙ סָבִ֔יב</tei:l>
          <tei:l>ה֕וּא מַרְאֵ֖ה דְּמ֣וּת כְּבוֹד־יְהוָ֑ה</tei:l>
          <tei:l>וָֽאֶרְאֶה֙ וָאֶפֹּ֣ל עַל־פָּנַ֔י</tei:l>
          <tei:l>וָאֶשְׁמַ֖ע ק֥וֹל מְדַבֵּֽר׃ {ס}</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_blessing_upon_observing_a_rainbow_winn_lederer/4"/>
        <tei:lg>
          <tei:l>
            <tei:bibl>בראשית רבה לה:ג</tei:bibl>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>אֶת קַשְׁתִּי נָתַתִּי <tei:bibl>(בראשית ט:יג)</tei:bibl>,</tei:l>
          <tei:l>קִישׁוּתִי,</tei:l>
          <tei:l>דָּבָר שֶׁהוּא מֻקָּשׁ לִי,</tei:l>
          <tei:l>אֶפְשָׁר?</tei:l>
          <tei:l>כֵּן, אֶלָּא קַשִּׁין דְּפֵירֵי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_blessing_upon_observing_a_rainbow_winn_lederer/5"/>
        <tei:lg>
          <tei:l>
            <tei:bibl>חגיגה טז א:יד</tei:bibl>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>דרש ר׳ יהודה ברבי נחמני מתורגמניה דריש לקיש</tei:l>
          <tei:l>כל המסתכל בג׳ דברים עיניו כהות</tei:l>
          <tei:l>בקשת ובנשיא ובכהנים</tei:l>
          <tei:l>בקשת דכתיב</tei:l>
          <tei:l>”כמראה הקשת אשר יהיה בענן ביום הגשם...</tei:l>
          <tei:l>הוא מראה דמות כבוד ה׳“ <tei:bibl>(יחזקאל א:כח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_blessing_upon_observing_a_rainbow_winn_lederer/6"/>
        <tei:lg>
          <tei:l>
            <tei:bibl>חגיגה טז א:יא</tei:bibl>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>כׇּל שֶׁלֹּא חָס עַל כְּבוֹד קוֹנוֹ,</tei:l>
          <tei:l>רָתוּי לוֹ שֶׁלֹּא בָּא לְעוֹלָם. <tei:bibl>(משנה חגיגה ב:א)</tei:bibl></tei:l>
          <tei:l>מַאי הִיא?</tei:l>
          <tei:l>רַבִּי אַבָּא אָמַר: זֶה הַמִּסְתַּכֵּל בַּקֶּשֶׁת.</tei:l>
          <tei:l>רַב יוֹסֵף אָמַר: זֶה הָעוֹבֵר עֲבֵירָה בַּסֵּתֶר.</tei:l>
          <tei:l>מִסְתַּכֵּל בַּקֶּשֶׁת,</tei:l>
          <tei:l>דִּכְתִיב: ”כְּמַרְאֵה הַקֶּשֶׁת אֲשֶׁר יִהְיֶה בֶעָנָן בְּיוֹם הַגֶּשֶׁם</tei:l>
          <tei:l>כֵּן מַרְאֵה הַנֹּגַהּ סָבִיב</tei:l>
          <tei:l>הוּא מַרְאֵה דְּמוּת כְּבוֹד ה׳“ <tei:bibl>(יחזקאל א:כח)</tei:bibl>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_blessing_upon_observing_a_rainbow_winn_lederer/7"/>
        <tei:lg>
          <tei:l>
            <tei:bibl>בראשית רבה לה:ג</tei:bibl>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְאוֹחֲרָנָא דְּרַשׁ, כְּתִיב:</tei:l>
          <tei:l>וְהָיְתָה הַקֶּשֶׁת בֶּעָנָן וּרְאִיתִיהָ</tei:l>
          <tei:l>לִזְכֹּר בְּרִית עוֹלָם</tei:l>
          <tei:l>”בֵּין אֱלֹהִים וּבֵין כָּל נֶפֶשׁ חַיָּה“ <tei:bibl>(בראשית ט:טז)</tei:bibl> וגו׳,</tei:l>
          <tei:l>בֵּין אֱלֹהִים זוֹ מִדַּת הַדִּין שֶׁלְּמַעְלָה,</tei:l>
          <tei:l>וּבֵין כָּל נֶפֶשׁ חַיָּה, זוֹ מִדַּת הַדִּין שֶׁל מַטָּה,</tei:l>
          <tei:l>מִדַּת הַדִּין שֶׁל מַעְלָה קָשָׁה,</tei:l>
          <tei:l>וּמִדַּת הַדִּין שֶׁל מַטָּה רָפָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_blessing_upon_observing_a_rainbow_winn_lederer/8"/>
        <tei:lg>
          <tei:l>
            <tei:bibl>בראשית רבה לה:ג</tei:bibl>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְחַד מִנְּהוֹן דְּרַשׁ,</tei:l>
          <tei:l>כָּתוּב אֶחָד אוֹמֵר וְכָל חֲפָצִים לֹא יִשְׁווּ בָהּ <tei:bibl>(משלי ח:יא)</tei:bibl>,</tei:l>
          <tei:l>וְכָתוּב אֶחָד אוֹמֵר וְכָל חֲפָצֶיךָ לֹא יִשְׁווּ בָהּ <tei:bibl>(משלי ג:טו)</tei:bibl>,</tei:l>
          <tei:l>חֲפָצִים אֵלּוּ מִצְווֹת וּמַעֲשִׂים טוֹבִים,</tei:l>
          <tei:l>חֲפָצֶיךָ אֵלּוּ אֲבָנִים טוֹבוֹת וּמַרְגָּלִיּוֹת.</tei:l>
          <tei:l>רַבִּי אַחָא בְּשֵׁם רַבִּי תַּנְחוּם בַּר רַבִּי חִיָּא</tei:l>
          <tei:l>חֲפָצַי וַחֲפָצֶיךָ לֹא יִשְׁווּ בָהּ.</tei:l>
          <tei:l>כִּי אִם בְּזֹאת יִתְהַלֵּל הַמִּתְהַלֵּל</tei:l>
          <tei:l>הַשְׂכֵּל וְיָדֹעַ אוֹתִי</tei:l>
          <tei:l>כִּי אֲנִי ה׳ עֹשֶׂה חֶסֶד מִשְׁפָּט <tei:bibl>(ירמיה ט:כג)</tei:bibl> וגו׳</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_blessing_upon_observing_a_rainbow_winn_lederer/9"/>
        <tei:lg>
          <tei:l>
            <tei:bibl>פרקי אבות ה:ו</tei:bibl>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>עֲשָׂרָה דְבָרִים נִבְרְאוּ בְּעֶרֶב שַׁבָּת בֵּין הַשְּׁמָשׁוֹת, וְאֵלּוּ הֵן,</tei:l>
          <tei:l>פִּי הָאָרֶץ,</tei:l>
          <tei:l>וּפִי הַבְּאֵר,</tei:l>
          <tei:l>וּפִי הָאָתוֹן,</tei:l>
          <tei:l>וְהַקֶּשֶׁת...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_blessing_upon_observing_a_rainbow_winn_lederer/10"/>
        <tei:lg>
          <tei:l>
            <tei:bibl>ברכות נט א׳:יב</tei:bibl>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְאָמַר רַבִּי אֲלֶכְּסַנְדְּרִי אָמַר רַבִּי יְהוֹשֻׁעַ בֶּן לֵוִי:</tei:l>
          <tei:l>הָרוֹאֶה אֶת הַקֶּשֶׁת בֶּעָנָן צָרִיךְ שֶׁיִּפּוֹל עַל פָּנָיו,</tei:l>
          <tei:l>שֶׁנֶּאֱמַר: ”כְּמַרְאֵה הַקֶּשֶׁת אֲשֶׁר יִהְיֶה בֶעָנָן וְגוֹ׳</tei:l>
          <tei:l>וָאֶרְאֶה וָאֶפֹּל עַל פָּנַי“ <tei:bibl>(יחזקאל א:כח)</tei:bibl>.</tei:l>
          <tei:l>לָיְיטִי עֲלַהּ בְּמַעְרְבָא,</tei:l>
          <tei:l>מִשּׁוּם דְּמִחֲזֵי כְּמַאן דְּסָגֵיד לְקַשְׁתָּא.</tei:l>
          <tei:l>אֲבָל בָּרוֹכֵי וַדַּאי מְבָרֵךְ.</tei:l>
          <tei:l>מַאי מְבָרֵךְ? —</tei:l>
          <tei:l>”בָּרוּךְ ... זוֹכֵר הַבְּרִית“.</tei:l>
          <tei:l>בְּמַתְנִיתָא תָּנָא,</tei:l>
          <tei:l>רַבִּי יִשְׁמָעֵאל בְּנוֹ שֶׁל רַבִּי יוֹחָנָן בֶּן בְּרוֹקָא אוֹמֵר:</tei:l>
          <tei:l>”נֶאֱמָן בִּבְרִיתוֹ</tei:l>
          <tei:l>וְקַיָּים בְּמַאֲמָרוֹ“.</tei:l>
          <tei:l>אָמַר רַב פָּפָּא: הִלְכָּךְ נֵימְרִינְהוּ לְתַרְוַיְיהוּ:</tei:l>
          <tei:l>”בָּרוּךְ ... זוֹכֵר הַבְּרִית,</tei:l>
          <tei:l>וְנֶאֱמָן בִּבְרִיתוֹ</tei:l>
          <tei:l>וְקַיָּים בְּמַאֲמָרוֹ“.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>