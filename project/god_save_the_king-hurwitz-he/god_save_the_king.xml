  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:god_save_the_king">
        <tei:head>אֵל שְׁמֹר הַמֶּֽלֶךְ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:god_save_the_king/1"/>
        <tei:lg>
          <tei:l>אֵל שְׁמֹר וִילְיֶם מַלְכֵּֽנוּ</tei:l>
          <tei:l>לְעוֹלָם יְחִי מַלְכֵּֽנוּ</tei:l>
          <tei:l>אֵל שְׁמֹר הַמֶּֽלֶךְ׃</tei:l>
          <tei:l>שְׁלַח שָלוֹם בִּנְוֵֽהוּ</tei:l>
          <tei:l>בְּעֹז וְהָדָר עַטְּרֵֽהוּ</tei:l>
          <tei:l>לָעַד הַמְשִׁילֵֽהוּ</tei:l>
          <tei:l>אֵל שְׁמֹר הַמֶּֽלֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:god_save_the_king/2"/>
        <tei:lg>
          <tei:l>אָנָּא אֱלֹהִים קוּמָה,</tei:l>
          <tei:l>בְּאוֹיְבָיו תְּנָה מְהוּמָה,</tei:l>
          <tei:l>וְהַפִּילֵימוֹ׃</tei:l>
          <tei:l>הָפֵר תַּחְבֻּלֹתָם,</tei:l>
          <tei:l>סַכֶּל־נָא עֲצָתָם,</tei:l>
          <tei:l>לְעַמּוֹ תֵּן מִשְׁאֲלֹתָם,</tei:l>
          <tei:l>וְהוֹשִׁיעֵמוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:god_save_the_king/3"/>
        <tei:lg>
          <tei:l>מִבְחַר בִּרְכָתְךָ אֵל!</tei:l>
          <tei:l>לְהָרִיק עָלָיו הוֹאֵל׃</tei:l>
          <tei:l>לָעַד יִמְלוֹךְ!<tei:anchor xml:id="note_2"/></tei:l>
          <tei:l>יָגֵן בְּעַד חֻקֵּֽינוּ</tei:l>
          <tei:l>אָז יִשְׂמַח לִבֵּֽנוּ</tei:l>
          <tei:l>וְנָשִׁיר בְּכָל מְאֹדֵֽנוּ</tei:l>
          <tei:l>אֵל שְׁמֹר הַמֶּֽלֶךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:god_save_the_king/4"/>
        <tei:lg>
          <tei:l>עוֹד עֵינָיו תֶּֽחֱזֶינָה</tei:l>
          <tei:l>יְדִידוּת וְאַחְוָה תִרְבֶּינָה</tei:l>
          <tei:l>בְּכָל עִיר וָפֶלֶךְ׃</tei:l>
          <tei:l>יֵרְדְּ שִׁבְטוֹ בִּגְדֻלָּה</tei:l>
          <tei:l>נָעָבְדֶנּוּ בְּגִילָה</tei:l>
          <tei:l>וְנָרוֹן בְּקוֹל צָֽהֲלָה</tei:l>
          <tei:l>אֵל שְׁמֹר הַמֶּֽלֶךְ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
