  <tei:standOff type="notes">
    <tei:note type="commentary" n="1" target="#note_1">
      <tei:p>Lit. “heart.” The heart is seen in traditional Jewish texts as the seat of wisdom.</tei:p>
    </tei:note>
  </tei:standOff>
