  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu/1"/>
        <tei:lg xml:lang="qya-Hebr">
          <tei:l>רִמִי מָרֶי טְיֶלֶּר נַר אִאִלֻאַסְטוֹ מֶנַּה!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu/2"/>
        <tei:lg xml:lang="qya-Hebr">
          <tei:l>קֻי מֶן אֶטֻּלְיַנֶי לנוּאַלְטוֹ</tei:l>
          <tei:l>אַפַּה לָא קַרְנֶי טִאֶן נָאמַי</tei:l>
          <tei:l>נָאנֶי פַרֶן מֶן!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu/3"/>
        <tei:lg xml:lang="qya-Hebr">
          <tei:l>קֻי קַרְנֶי טִאֶן נָאמַי</tei:l>
          <tei:l>אַפַּה לָא קַרְנֶי קוֹרְדוֹנְטִן</tei:l>
          <tei:l>נָאנֶי פַרֶן מֶן!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu/4"/>
        <tei:lg xml:lang="qya-Hebr">
          <tei:l>קֻי קַרְנֶי קוֹרְדוֹנְטִן,</tei:l>
          <tei:l>אַפַּה לָא נַקַנְטֶי מִנּוֹאנַנְטַין</tei:l>
          <tei:l>נָאנֶי פַרֶן מֶן!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu/5"/>
        <tei:lg xml:lang="qya-Hebr">
          <tei:l>קֻי נַקַנְטֶי מִנּוֹאנַנְטַין</tei:l>
          <tei:l>אַפַּה לָא מֶן אַנְטַנֶי אַרְמַנְטָה</tei:l>
          <tei:l>נָאנֶי פַרֶן מֶן!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu/6"/>
        <tei:lg xml:lang="qya-Hebr">
          <tei:l>קֻי מֶן אַנְטַנֶי אַרְמַנְטָה</tei:l>
          <tei:l>אַפַּה לָא רָאמֶן חְיַנְדֶי אִאֶאַרַה</tei:l>
          <tei:l>נָאנֶי פַרֶן מֶן!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu/7"/>
        <tei:lg xml:lang="qya-Hebr">
          <tei:l>קֻי רָאמֶן חְיַנְדֶי אִאֶאַרַה</tei:l>
          <tei:l>אַפַּה לָא מֶן טֶרְטֻלְיַנֶס פַּרְקַין</tei:l>
          <tei:l>נָאנֶי פַרֶן מֶן!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu/8"/>
        <tei:lg xml:lang="qya-Hebr">
          <tei:l>קֻי מֶן טֶרְטֻלְיַנֶס פַּרְקַין</tei:l>
          <tei:l>אַפַּה לָא קֻאוֹסְטַנֶי קוֹטּוֹר מִס</tei:l>
          <tei:l>נָאנֶי פַרֶן מֶן!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu/9"/>
        <tei:lg xml:lang="qya-Hebr">
          <tei:l>קֻי קֻאוֹסְטַנֶי קוֹטּוֹר מִס</tei:l>
          <tei:l>אַפַּה לָא סוֹרְנֶי סַנְגִאֶמַּן רַבַֿנְדַסֶּי טֶר קַנְקֻאַין יֵנִאוֹן</tei:l>
          <tei:l>נָאנֶי פַרֶן מֶן!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu/10"/>
        <tei:lg xml:lang="qya-Hebr">
          <tei:l>קֻי סוֹרְנֶי סַנְגִאֶמַּן רַבַֿנְדַסֶּי טֶר קַנְקֻאַין יֵנִאוֹן</tei:l>
          <tei:l>אַפַּה לָא מֶן מַיטַנֶי אִמֶנֶלְמַצוֹן</tei:l>
          <tei:l>נָאנֶי פַרֶן מֶן!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu/11"/>
        <tei:lg xml:lang="qya-Hebr">
          <tei:l>קֻי מֶן מַיטַנֶי אִמֶנֶלְמַצוֹן</tei:l>
          <tei:l>אַפַּה לָא מֶן אַנְטַנֶי אִסֶנְדַרֶן</tei:l>
          <tei:l>נָאנֶי פַרֶן מֶן!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu/12"/>
        <tei:lg xml:lang="qya-Hebr">
          <tei:l>קֻי מֶן אַנְטַנֶי אִסֶנְדַרֶן</tei:l>
          <tei:l>אַפַּה לָא מֶן אַמְנַטֻלְיַנֶי אוֹרוֹנְטַה סִנַיוֹ</tei:l>
          <tei:l>נָאנֶי פַרֶן מֶן!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu/13"/>
        <tei:lg xml:lang="qya-Hebr">
          <tei:l>קֻי מֶן אַמְנַטֻלְיַנֶי אוֹרוֹנְטַה סִנַיוֹ</tei:l>
          <tei:l>אַפַּה לָא מֶן אַנְטַנֶי אִאַקְסַנִיא</tei:l>
          <tei:l>נָאנֶי פַרֶן מֶן!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu/14"/>
        <tei:lg xml:lang="qya-Hebr">
          <tei:l>קֻי מֶן אַנְטַנֶי אִאַקְסַנִיא</tei:l>
          <tei:l>אַפַּה לָא מֶן מִטֻלְיַנֶי נוֹארֶנַּה ישראל [אִרַּחֶלוֹ]</tei:l>
          <tei:l>נָאנֶי פַרֶן מֶן!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nane_faren_men_a_judeo_quenya_translation_of_dayenu/15"/>
        <tei:lg xml:lang="qya-Hebr">
          <tei:l>קֻי מֶן מִטֻלְיַנֶי נוֹארֶנַּה ישראל [אִרַּחֶלוֹ]</tei:l>
          <tei:l>אַפַּה לָא מֶן קַרַסְטַנֶי אוֹרוֹמָארַה קִלְמֶאוֹ</tei:l>
          <tei:l>נָאנֶי פַרֶן מֶן!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
