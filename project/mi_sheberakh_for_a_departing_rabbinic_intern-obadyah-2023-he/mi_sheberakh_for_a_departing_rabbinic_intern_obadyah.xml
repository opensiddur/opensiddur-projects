  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_for_a_departing_rabbinic_intern_obadyah">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_for_a_departing_rabbinic_intern_obadyah/1"/>
        <tei:lg>
          <tei:l>מִי שֶׁבֵּרֵךְ אִמּוֹתֵ֫ינוּ וַאֲבוֹתֵ֫ינוּ יְבָרֵךְ</tei:l>
          <tei:l>אֶת מוֹרָתֵנוּ <tei:note type="instruction">[שם]</tei:note></tei:l>
          <tei:l>שֶׁעָלְתָה לִכְבוֹד הַמָּקוֹם וְלִכְבוֹד הַתּוֹרָה [וְלִכְבוֹד הַשַּׁבָּת]</tei:l>
          <tei:l>[וְלִכְבוֹד הַרֶ֫גֶל].</tei:l>
          <tei:l>הַקָּדוֹשׁ בָּרוּךְ הוּא יִשְׁמְרֶהָ וִיחַיֶּהָ.</tei:l>
          <tei:l>בָּרֵך ה׳ חֵילָהּ וּפֹעַל יָדֶיהָ יִרְצֶה.</tei:l>
          <tei:l>וּבַעֲבוּר שֶׁעוֹסֶקֶת בְּאוֹרָיְתָא</tei:l>
          <tei:l>קַדִּשְתָּא יְהֵא לַהּ חִנָּא וְחִסְדָּא וְרַֽחֲמֵי.</tei:l>
          <tei:l>יְהִי רָצוֹן שֶׁתַּקְרִיב בְּנֵי יִשְׂרָאֵל</tei:l>
          <tei:l>לַתּוֹרָה לָעֲבוֹדָה וְלִגְמִילוּת חֲסָדִים.</tei:l>
          <tei:l>בַּעֲבוֹדַת הַקֹּדֶשׁ</tei:l>
          <tei:l>תִזְכֶּה שֶׁתִּקָּרֵא “עֶבֶד נֶֽאֱמָן”.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_for_a_departing_rabbinic_intern_obadyah/2"/>
        <tei:lg>
          <tei:l>[<tei:note type="instruction">בין ר״ה וי״כ:</tei:note></tei:l>
          <tei:l>וְיִכְתְּבֵנּוּ בְּסֵ֫פֶר חַיִּים טוֹבִים]</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_for_a_departing_rabbinic_intern_obadyah/3"/>
        <tei:lg>
          <tei:l>וְכֵן יְהִי רָצוֹן</tei:l>
          <tei:l>וְנֹאמַר אָמֵן:</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
