    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:the_internationale_pottier">
        <tei:head>הָאִינְטֶרְנַצְיוֹנָל</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_internationale_pottier/1"/>
        <tei:lg>
          <tei:l>הָאִינְטֶרְנַצְיוֹנָל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_internationale_pottier/2"/>
        <tei:lg>
          <tei:l>קוּם הִתְנַעֵרָה עַם חֵלֵכָה</tei:l>
          <tei:l>עַם עֲבָדִים וּמְזֵי רָעָב</tei:l>
          <tei:l>אֵשׁ הַנְּקָמוֹת הַלַּב לִחֵכַה</tei:l>
          <tei:l>לִקְרַאת אוֹיַב הִכּוֹן לַקְּרָב.</tei:l>
          <tei:l>עוֹלָם יָשָׁן עֲדֵי הַיְּסוֹד נַחְרִימָה</tei:l>
          <tei:l>מִגַּב כָּפוּף נִפְרֹק הָעֹל</tei:l>
          <tei:l>אֶת עוֹלָמֵנוּ אָז נָקִימָה</tei:l>
          <tei:l>לֹא כְּלוּם מִתְּמוֹל, מָחָר – הַכֹּל!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_internationale_pottier/3"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">מקהלה</tei:note>
          </tei:l>
          <tei:l>זֶה יִהְיֶה קְרַב אַחֲרוֹן</tei:l>
          <tei:l>בְּמִלְחֶמֶת עוֹלָם</tei:l>
          <tei:l>עִם הָאִינְטֶרְנַצְיוֹנַל יַעוֹר,</tei:l>
          <tei:l>יִשְׂגָב אָדָם!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_internationale_pottier/4"/>
        <tei:lg>
          <tei:l>רַק לָנוּ עֲמֵלֵי כַּפַּיִם</tei:l>
          <tei:l>רַק לָנוּ עֲמֵלֵי הַיְּקוּם</tei:l>
          <tei:l>הָאֲדָמָה וּבִרְכוֹתֶיהָ</tei:l>
          <tei:l>וּלְכָל הוֹלְכֵי בָּטֵל לֹא כְלוּם</tei:l>
          <tei:l>עֲבוּר הַדְּרוֹר וּפְדוּת הָרוּחַ</tei:l>
          <tei:l>וּפְרֹק הָעֹל מִגַּב הָעָם</tei:l>
          <tei:l>לַבֵּה הָאֵשׁ וְהַךְ בְּכוֹחַ</tei:l>
          <tei:l>כָּל עוֹד בַּרְזֶל עוֹדֶנּוּ חַם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_internationale_pottier/5"/>
        <tei:lg>
          <tei:l>אֵין רַב רִיבֵנוּ וּמוֹשִׁיעַ</tei:l>
          <tei:l>לֹא אֵל, לֹא מֶלֶךְ, לֹא גִּבּוֹר</tei:l>
          <tei:l>בִּזְרוֹעַ נְטוּיָה נַבְקִיעַ</tei:l>
          <tei:l>אֲנַחְנוּ דֶּרֶךְ אֶל הָאוֹר</tei:l>
          <tei:l>וְכִי רַעַם אֲבָדוֹן יָרִיעַ</tei:l>
          <tei:l>עַל רֹאשׁ אוֹיְבֵינוּ לְהֻמַּם</tei:l>
          <tei:l>עָלֵינוּ שֶׁמֶשׁ דְּרוֹר יַפְצִיעַ</tei:l>
          <tei:l>לִשְׁפֹּךְ אֶת זָהֳרָהּ הַחַם</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
