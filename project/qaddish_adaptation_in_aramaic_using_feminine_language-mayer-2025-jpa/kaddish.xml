  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:kaddish">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaddish/titqabbal-selichot_preface"/>
        <tei:lg>
          <tei:l>תִּתְגַדַּל וְתִתְקַדַּשׁ שְׁכִינְתָּא רַבְּתָא (<tei:note type="instruction">קהל –</tei:note> אָמֵן)</tei:l>
          <tei:l>בְּבִרְיָתָא דִּילִידַת כִּרְעוּתָהּ</tei:l>
          <tei:l>וְתַשְׁלִיט שִׁלְטוֹנָהּ</tei:l>
          <tei:l><j:conditional xml:id="cond_1" type="marked"><tei:fs type="opensiddur:rite"><tei:f name="sepharad"><tei:binary value="true"/></tei:f></tei:fs></j:conditional><tei:note type="instruction">ספרדים</tei:note> וְתַצְמַח פֻּרְקָנָהּ<j:endConditional target="#cond_1"/></tei:l>
          <tei:l><j:conditional xml:id="cond_2" type="marked"><tei:fs type="opensiddur:rite"><tei:f name="sepharad"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>וְתַבַּע לְעָלְמָא דְּאָתֵי (<tei:note type="instruction">קהל –</tei:note> אָמֵן)<j:endConditional target="#cond_2"/></tei:l>
          <tei:l>בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן</tei:l>
          <tei:l>וּבְחַיֵּי דְּכׇל־בֵּית יִשְׂרָאֵל</tei:l>
          <tei:l>בַּעֲגַלָא וּבִזְמַן קָרִיב</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>(<tei:note type="instruction">קהל –</tei:note> אָמֵן׃ תֶּהֱוֵי שְׁכִינְתָּא רַבְּתָא מְבָרָכָא</tei:l>
          <tei:l>לְעָלַם וּלְעָלְמֵי עָלְמַיָּא׃)</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>תִּתְבָּרַךְ וְתִשְׁתַּבַּח</tei:l>
          <tei:l>וְתִתְפָּאַר וְתִתְרוֹמַם</tei:l>
          <tei:l>וְתִתְנַשֵּׂא וְתִתְהַדָּר וְתִתְעַלֶּה</tei:l>
          <tei:l>וְתִתְהַלָּל שְׁכִינְתָּא קַדִּישְׁתָּא בְּרִיכָא הִיא (<tei:note type="instruction">קהל –</tei:note> בְּרִיכָא הִיא)</tei:l>
          <tei:l>לְעֵֽלָּא מִן־כׇּל־בִּרְכָן<tei:anchor xml:id="note_1"/> וְזִמְרִין תֻּשְׁבְּחָתָא וְנֶחָמָתָא</tei:l>
          <tei:l>דַּאֲמִירָן בְּעָלְמָא</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן׃ (<tei:note type="instruction">קהל –</tei:note> אָמֵן׃)</tei:l>
          <tei:l>
            <tei:note type="instruction">סוף חצי קדיש</tei:note>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">לקדיש דְּרַבָּתָנָן</tei:note>
          </tei:l>
          <tei:l>עַל־יִשְׂרָאֵל</tei:l>
          <tei:l>וְעַל־רַבָּתָנָן</tei:l>
          <tei:l>וְעַל־תַּלְמִידְתֵּיהֵין</tei:l>
          <tei:l>וְעַל־תַּלְמִידְתֵּי תַּלְמִידְתֵּיהֵין</tei:l>
          <tei:l>וְעַל־כׇּל־מָאן דְּעוֹסְקָן בְּאוֹרַיְתָא</tei:l>
          <tei:l>דִּי בְאַתְרָא<tei:anchor xml:id="note_3"/> הָדֵין וְדִי בְכׇל־אֲתַר וַאֲתַר</tei:l>
          <tei:l>יְהֵא לְהֵין וּלְכוֹן שְׁלָמָא רַבָּא</tei:l>
          <tei:l>חִנָּא וְחִסְדָּא וְרַחֲמִין</tei:l>
          <tei:l>וְחַיִּין אֲרִיכִין וּמְזוֹנֵי רְוִיחֵי</tei:l>
          <tei:l>וּפֻרְקָנָא מִן־קֳדָם־אִמְהֵין דְּבִשְׁמַיָּא</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן׃ (<tei:note type="instruction">קהל –</tei:note> אָמֵן׃)</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">לקדיש שלם</tei:note>
          </tei:l>
          <tei:l>תִּתְקַבַּל צְלוֹתְהֵין וּבָעוּתְהֵין</tei:l>
          <tei:l>דְּכׇל־בְּנַת־יִשְׂרָאֵל</tei:l>
          <tei:l>קֳדָם־אִמְהֵין דְּבִשְׁמַיָּא</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן׃ (<tei:note type="instruction">קהל –</tei:note> אָמֵן׃)</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>
            <j:conditional xml:id="cond_3" type="marked">
              <tei:fs type="opensiddur:rite">
                <tei:f name="ashkenaz">
                  <tei:binary value="true"/>
                </tei:f>
              </tei:fs>
            </j:conditional>
            <tei:note type="instruction">אשכנזים</tei:note>
            <j:endConditional target="#cond_3"/>
          </tei:l>
          <tei:l><j:conditional xml:id="cond_4" type="marked"><tei:fs type="opensiddur:rite"><tei:f name="ashkenaz"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>יְהֵא שְׁלָמָא רַבָּא מִן־שְׁמַיָא<j:endConditional target="#cond_4"/></tei:l>
          <tei:l><j:conditional xml:id="cond_5" type="marked"><tei:fs type="opensiddur:rite"><tei:f name="ashkenaz"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>חַיִּים טוֹבִים עָלֵֽינוּ<j:endConditional target="#cond_5"/></tei:l>
          <tei:l><j:conditional xml:id="cond_6" type="marked"><tei:fs type="opensiddur:rite"><tei:f name="ashkenaz"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>וְעַל־כׇּל־יִשְׂרָאֵל<j:endConditional target="#cond_6"/></tei:l>
          <tei:l><j:conditional xml:id="cond_7" type="marked"><tei:fs type="opensiddur:rite"><tei:f name="ashkenaz"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>וְעַל־כׇּל־יוֹשְׁבֵי תֵּבֵל<j:endConditional target="#cond_7"/></tei:l>
          <tei:l><j:conditional xml:id="cond_8" type="marked"><tei:fs type="opensiddur:rite"><tei:f name="ashkenaz"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>וְאִמְרוּ אָמֵן: (<tei:note type="instruction">קהל –</tei:note> אָמֵן׃)<j:endConditional target="#cond_8"/></tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>
            <j:conditional xml:id="cond_9" type="marked">
              <tei:fs type="opensiddur:rite">
                <tei:f name="sepharad">
                  <tei:binary value="true"/>
                </tei:f>
              </tei:fs>
            </j:conditional>
            <tei:note type="instruction">ספרדים</tei:note>
            <j:endConditional target="#cond_9"/>
          </tei:l>
          <tei:l><j:conditional xml:id="cond_10" type="marked"><tei:fs type="opensiddur:rite"><tei:f name="sepharad"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>יְהֵא שְׁלָמָא רַבָּא מִן־שְׁמַיָא<j:endConditional target="#cond_10"/></tei:l>
          <tei:l><j:conditional xml:id="cond_11" type="marked"><tei:fs type="opensiddur:rite"><tei:f name="sepharad"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>חַיִּים וְשָׁבָע<j:endConditional target="#cond_11"/></tei:l>
          <tei:l><j:conditional xml:id="cond_12" type="marked"><tei:fs type="opensiddur:rite"><tei:f name="sepharad"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>וִישׁוּעָה וְנֶחָמָה<j:endConditional target="#cond_12"/></tei:l>
          <tei:l><j:conditional xml:id="cond_13" type="marked"><tei:fs type="opensiddur:rite"><tei:f name="sepharad"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>וְשֵׁיזָבָא וּרְפוּאָה<j:endConditional target="#cond_13"/></tei:l>
          <tei:l><j:conditional xml:id="cond_14" type="marked"><tei:fs type="opensiddur:rite"><tei:f name="sepharad"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>וּגְאֻלָּה<j:endConditional target="#cond_14"/></tei:l>
          <tei:l><j:conditional xml:id="cond_15" type="marked"><tei:fs type="opensiddur:rite"><tei:f name="sepharad"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>וּסְלִיחָה וְכַפָּרָה<j:endConditional target="#cond_15"/></tei:l>
          <tei:l><j:conditional xml:id="cond_16" type="marked"><tei:fs type="opensiddur:rite"><tei:f name="sepharad"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>וְרֵֽוַח וְהַצָּלָה<j:endConditional target="#cond_16"/></tei:l>
          <tei:l><j:conditional xml:id="cond_17" type="marked"><tei:fs type="opensiddur:rite"><tei:f name="sepharad"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>לָֽנוּ<j:endConditional target="#cond_17"/></tei:l>
          <tei:l><j:conditional xml:id="cond_18" type="marked"><tei:fs type="opensiddur:rite"><tei:f name="sepharad"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>וּלְכׇל־עַמָּהּ יִשְׂרָאֵל<j:endConditional target="#cond_18"/></tei:l>
          <tei:l><j:conditional xml:id="cond_19" type="marked"><tei:fs type="opensiddur:rite"><tei:f name="sepharad"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>וְעַל־כׇּל־יוֹשְׁבֵי תֵּבֵל<j:endConditional target="#cond_19"/></tei:l>
          <tei:l><j:conditional xml:id="cond_20" type="marked"><tei:fs type="opensiddur:rite"><tei:f name="sepharad"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>וְאִמְרוּ אָמֵן: (<tei:note type="instruction">קהל –</tei:note> אָמֵן׃)<j:endConditional target="#cond_20"/></tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>מוֹצְאֵת שָׁלוֹם בְּעֵינָיו</tei:l>
          <tei:l>הִיא <j:conditional xml:id="cond_21" type="marked"><tei:fs type="opensiddur:rite"><tei:f name="sepharad"><tei:binary value="true"/></tei:f></tei:fs></j:conditional><tei:note type="instruction">ספרדים</tei:note> בְּרַחֲמֶֽיהָ<j:endConditional target="#cond_21"/> תּוֹצִיא שָׁלוֹם</tei:l>
          <tei:l>עָלֵֽינוּ</tei:l>
          <tei:l>וְעַל־כׇּל־יִשְׂרָאֵל</tei:l>
          <tei:l>וְעַל־כׇּל־יוֹשְׁבֵי תֵּבֵל</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן:</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" n="1" target="#note_1">
      <tei:p>בעשרת ימי תשובה לְעֵֽלָּא לְעֵֽלָּא מִכׇּל־בִּרְכָן</tei:p>
    </tei:note>
    <tei:note type="commentary" n="3" target="#note_3">
      <tei:p>בארץ ישראל יש מוסיפין: קַדִּישָׁא</tei:p>
    </tei:note>
  </tei:standOff>
</tei:TEI>