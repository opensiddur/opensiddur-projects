  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:whoa">
        <tei:head>Whoa, Mary, don’t you weep no more! (Hebrew adaptation by Isaac Gantwerk Mayer)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:whoa/1"/>
        <tei:lg>
          <tei:l>Whoa, Mary, don’t you weep no more!</tei:l>
          <tei:l>Whoa, Mary, don’t you weep no more!</tei:l>
          <tei:l>Pharaoh’s army got drownded!</tei:l>
          <tei:l>Whoa, Mary don’t you weep!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:whoa/2"/>
        <tei:lg>
          <tei:l>If I could I surely would</tei:l>
          <tei:l>stand on the rock where Moses stood!</tei:l>
          <tei:l>Pharaoh’s army...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:whoa/3"/>
        <tei:lg>
          <tei:l>One of these nights ‘round twelve o’clock,</tei:l>
          <tei:l>this old world’s gonna reel and rock!</tei:l>
          <tei:l>Pharaoh’s army...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:whoa/4"/>
        <tei:lg>
          <tei:l>God told Moses what to do,</tei:l>
          <tei:l>to lead the Hebrew children through!</tei:l>
          <tei:l>Pharaoh’s army...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:whoa/5"/>
        <tei:lg>
          <tei:l>Moses stood on the Red Sea shore,</tei:l>
          <tei:l>smote the water with a two-by-four!</tei:l>
          <tei:l>Pharaoh’s army...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:whoa/6"/>
        <tei:lg>
          <tei:l>God gave Noah the rainbow sign:</tei:l>
          <tei:l>No more water, but fire next time!</tei:l>
          <tei:l>Pharaoh’s army...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
