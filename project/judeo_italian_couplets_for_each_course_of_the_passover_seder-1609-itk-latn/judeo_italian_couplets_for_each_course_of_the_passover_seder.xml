  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_course_of_the_passover_seder">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_course_of_the_passover_seder/1"/>
        <tei:lg>
          <tei:l>cadesc</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Émpi il bicchiero<tei:anchor xml:id="note_1"/></tei:l>
          <tei:l>ben pieno di vino</tei:l>
          <tei:l>e di <tei:hi rend="italic">chidusc</tei:hi> laude</tei:l>
          <tei:l>al Signor divino.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_course_of_the_passover_seder/2"/>
        <tei:lg>
          <tei:l>urhaz</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Lava le mani</tei:l>
          <tei:l>con ogne mondezza</tei:l>
          <tei:l>senza far <tei:hi rend="italic">berahà</tei:hi></tei:l>
          <tei:l>con politezza.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_course_of_the_passover_seder/3"/>
        <tei:lg>
          <tei:l>carpas</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Nel haróssèt dell’appio</tei:l>
          <tei:l>infonderai</tei:l>
          <tei:l>e <tei:hi rend="italic">bore peri ha-adama</tei:hi></tei:l>
          <tei:l>benedirai.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_course_of_the_passover_seder/4"/>
        <tei:lg>
          <tei:l>giahaz</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Parti il <tei:hi rend="italic">scimùr</tei:hi> di mezzo</tei:l>
          <tei:l>e mezzo di esso,</tei:l>
          <tei:l>sia per <tei:hi rend="italic">aficómèn</tei:hi></tei:l>
          <tei:l>riposto e messo.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_course_of_the_passover_seder/5"/>
        <tei:lg>
          <tei:l>magghid</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Dirai la <tei:hi rend="italic">hagada</tei:hi></tei:l>
          <tei:l>come e qui scritto</tei:l>
          <tei:l>da <tei:hi rend="italic">ha lahma</tei:hi> sin che</tei:l>
          <tei:l>el resto abbi ditto.<tei:anchor xml:id="note_3"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_course_of_the_passover_seder/6"/>
        <tei:lg>
          <tei:l>rohza</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Un’altra volta</tei:l>
          <tei:l>lavate le mani</tei:l>
          <tei:l>con <tei:hi rend="italic">berahà</tei:hi></tei:l>
          <tei:l>senza pensieri vani.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_course_of_the_passover_seder/7"/>
        <tei:lg>
          <tei:l>mozzi mazza</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Piglia il <tei:hi rend="italic">scimùr</tei:hi></tei:l>
          <tei:l>di sopra e ci farai</tei:l>
          <tei:l><tei:hi rend="italic">hamozzi lehem</tei:hi>,</tei:l>
          <tei:l>e non ne mangiarai.<tei:anchor xml:id="note_4"/></tei:l>
          <tei:l>Ma spezza quella mezza</tei:l>
          <tei:l>e detto poi</tei:l>
          <tei:l><tei:hi rend="italic">gnal ahilat mazza</tei:hi> —</tei:l>
          <tei:l>mangia ambi doi.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_course_of_the_passover_seder/8"/>
        <tei:lg>
          <tei:l>maror</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Nel <tei:hi rend="italic">haróssèt</tei:hi> lattuca</tei:l>
          <tei:l>avrai infusa</tei:l>
          <tei:l>con dir <tei:hi rend="italic">gnal ahilat</tei:hi></tei:l>
          <tei:l><tei:hi rend="italic">maror</tei:hi> che s’usa.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_course_of_the_passover_seder/9"/>
        <tei:lg>
          <tei:l>coréch</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Del terzo scimùr</tei:l>
          <tei:l>volgi in una foglia<tei:anchor xml:id="note_5"/></tei:l>
          <tei:l>e di zeher lamicdasc</tei:l>
          <tei:l>di mala voglia.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_course_of_the_passover_seder/10"/>
        <tei:lg>
          <tei:l>sciulhan gnoréch</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Concia la mensa</tei:l>
          <tei:l>e il cibo in bocca caccia</tei:l>
          <tei:l>e mangia quanto voi</tei:l>
          <tei:l>che pro ti faccia.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_course_of_the_passover_seder/11"/>
        <tei:lg>
          <tei:l>zafun</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>L’<tei:hi rend="italic">aficómèn</tei:hi> che già</tei:l>
          <tei:l>hai riservato</tei:l>
          <tei:l>in fin, con devozion’<tei:anchor xml:id="note_6"/></tei:l>
          <tei:l>sarà mangiato.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_course_of_the_passover_seder/12"/>
        <tei:lg>
          <tei:l>baréch</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Senza mangiar’</tei:l>
          <tei:l>né ber’ altro procura</tei:l>
          <tei:l>dir <tei:hi rend="italic">berahà</tei:hi></tei:l>
          <tei:l>e per zimmun pon’ cura.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_course_of_the_passover_seder/13"/>
        <tei:lg>
          <tei:l>hallél</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="italic">Scefóch</tei:hi> comincia</tei:l>
          <tei:l>et<tei:anchor xml:id="note_7"/> il <tei:hi rend="italic">hallél</tei:hi> finisci</tei:l>
          <tei:l>e quel che ti</tei:l>
          <tei:l>a salvo benedisci.<tei:anchor xml:id="note_8"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:judeo_italian_couplets_for_each_course_of_the_passover_seder/14"/>
        <tei:lg>
          <tei:l>nirza</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Prega Iddio</tei:l>
          <tei:l>che il bon<tei:anchor xml:id="note_9"/> voler’ accetta</tei:l>
          <tei:l>e che in <tei:hi rend="italic">Gieruscialaim</tei:hi></tei:l>
          <tei:l>ce rimetta!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" n="1" target="#note_1">
      <tei:p>A dialectal form. In standard Italian, this word would be written <tei:hi rend="italic">bicchiere</tei:hi>.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="3" target="#note_3">
      <tei:p>A dialectal form. In standard Italian, this phrase would be written <tei:hi rend="italic">il resto abbi detto</tei:hi>.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="4" target="#note_4">
      <tei:p>A dialectal form. In standard Italian, this word would be written <tei:hi rend="italic">mangerai</tei:hi>.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="5" target="#note_5">
      <tei:p>In modern Italian, this word is exclusively used for a plant’s leaf. A metaphorical “leaf” — i.e. a folded food as intended here, would be referred to as a <tei:hi rend="italic">sfoglia</tei:hi> instead — puff pastry, for instance, is <tei:hi rend="italic">pasta sfoglia</tei:hi>.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="6" target="#note_6">
      <tei:p>This is the first of multiple words in this portion written without their final vowel, a process known as apocope and common in Italian poetry to this day. Most of these words, excepting commonly abbreviated forms such as <tei:hi rend="italic">dir</tei:hi> for <tei:hi rend="italic">dire</tei:hi>, are here written with an apostrophe to mark the elided vowel.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="7" target="#note_7">
      <tei:p>An obsolete form of the prevocalic “and.” In modern Italian, it would, in poetic contexts, be written <tei:hi rend="italic">ed</tei:hi>.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="8" target="#note_8">
      <tei:p>A dialectal form. In standard Italian, this word would be written <tei:hi rend="italic">benedici</tei:hi>.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="9" target="#note_9">
      <tei:p>A dialectal form. In standard Italian, this word would be written <tei:hi rend="italic">buon</tei:hi>.</tei:p>
    </tei:note>
  </tei:standOff>
</tei:TEI>