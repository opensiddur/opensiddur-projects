      <tei:div corresp="urn:x-opensiddur:text:prayer:hosha_na_for_election_day_mayer">
        <tei:head>הוֹשַֽׁעְנָא ליום הבחירות</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_election_day_mayer/1"/>
        <tei:lg>
          <tei:l>הוֹשַֽׁעְנָא – <tei:seg type="acrostic">אַ</tei:seg>חֲוָה וְאֵמוּן בְּאַדְמָתֵֽנוּ – הוֹשַֽׁעְנָא</tei:l>
          <tei:l>הוֹשַֽׁעְנָא – <tei:seg type="acrostic">בְּ</tei:seg>רָכָה וּבִטָּחוֹן בִּבְחִירָתֵֽנוּ – הוֹשַֽׁעְנָא</tei:l>
          <tei:l>הוֹשַֽׁעְנָא – <tei:seg type="acrostic">גְּ</tei:seg>בוּרָה וּגְמִילַת חֶֽסֶד בִּגְדוֹלֵֽנוּ – הוֹשַֽׁעְנָא</tei:l>
          <tei:l>הוֹשַֽׁעְנָא — <tei:seg type="acrostic">דִּ</tei:seg>ין וְדֶֽרֶךְ אֶֽרֶץ בְּדַיָּנֵֽינוּ — הוֹשַֽׁעְנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_election_day_mayer/2"/>
        <tei:lg>
          <tei:l>הוֹשַֽׁעְנָא — <tei:seg type="acrostic">ה</tei:seg>וֹד וְהָדָר בְּהֵיכְלוֹתֵֽנוּ — הוֹשַֽׁעְנָא</tei:l>
          <tei:l>הוֹשַֽׁעְנָא — <tei:seg type="acrostic">וַ</tei:seg>דָּאוּת וּוֶֽתֶק בִּוְעָדֵֽינוּ — הוֹשַֽׁעְנָא</tei:l>
          <tei:l>הוֹשַֽׁעְנָא — <tei:seg type="acrostic">זְ</tei:seg>כוּת וּזְרִיזוּת בִּזְקֵנֵֽינוּ — הוֹשַֽׁעְנָא</tei:l>
          <tei:l>הוֹשַֽׁעְנָא — <tei:seg type="acrostic">חֵ</tei:seg>ן וָחֶֽסֶד בְּחַבְלֵֽנוּ — הוֹשַֽׁעְנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_election_day_mayer/3"/>
        <tei:lg>
          <tei:l>הוֹשַֽׁעְנָא — <tei:seg type="acrostic">ט</tei:seg>וּב טַֽעַם בְּטִעוּנֵֽינוּ — הוֹשַֽׁעְנָא</tei:l>
          <tei:l>הוֹשַֽׁעְנָא — <tei:seg type="acrostic">יֹֽ</tei:seg>שֶׁר וִידִידוּת בִּיסוֹדוֹתֵֽינוּ — הוֹשַֽׁעְנָא</tei:l>
          <tei:l>הוֹשַֽׁעְנָא — <tei:seg type="acrostic">כָּ</tei:seg>בוֹד וְכִשָּׁרוֹן בְּכִנְסוֹתֵֽנוּ — הוֹשַֽׁעְנָא</tei:l>
          <tei:l>הוֹשַֽׁעְנָא — <tei:seg type="acrostic">לִ</tei:seg>מּוּד וָלֶֽקַח בְּלִשְׁכוֹתֵֽינוּ — הוֹשַֽׁעְנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_election_day_mayer/4"/>
        <tei:lg>
          <tei:l>הוֹשַֽׁעְנָא — <tei:seg type="acrostic">מִ</tei:seg>דּוֹת מֵלִיץ בְּמֶמְשַׁלְתֵּֽנוּ — הוֹשַֽׁעְנָא</tei:l>
          <tei:l>הוֹשַֽׁעְנָא — <tei:seg type="acrostic">נְ</tei:seg>דִיבוּת וּנְצִיגוּת בְּנִהוּלֵֽנוּ — הוֹשַֽׁעְנָא</tei:l>
          <tei:l>הוֹשַֽׁעְנָא — <tei:seg type="acrostic">סִ</tei:seg>יּֽוּעַ וְסַבְלָנוּת בְּסַמְכֻיּוֹתֵֽינוּ — הוֹשַֽׁעְנָא</tei:l>
          <tei:l>הוֹשַֽׁעְנָא — <tei:seg type="acrostic">עֲ</tei:seg>נָוָה וָעֹֽצֶם בְּעֵדוֹתֵֽנוּ — הוֹשַֽׁעְנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_election_day_mayer/5"/>
        <tei:lg>
          <tei:l>הוֹשַֽׁעְנָא — <tei:seg type="acrostic">פְּ</tei:seg>אֵר וּפְדוּת בִּפְקִידֵֽינוּ — הוֹשַֽׁעְנָא</tei:l>
          <tei:l>הוֹשַֽׁעְנָא — <tei:seg type="acrostic">צְ</tei:seg>דָקָה וּצְנִיעוּת בְּצִבּוּרֵֽנוּ — הוֹשַֽׁעְנָא</tei:l>
          <tei:l>הוֹשַֽׁעְנָא — <tei:seg type="acrostic">קִ</tei:seg>דְמָה וְקִיּוּם בִּקְהִלּוֹתֵֽנוּ — הוֹשַֽׁעְנָא</tei:l>
          <tei:l>הוֹשַֽׁעְנָא — <tei:seg type="acrostic">רְ</tei:seg>וָיָה וְרַחֲמִים בְּרָשׁוּתֵֽנוּ — הוֹשַֽׁעְנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_election_day_mayer/6"/>
        <tei:lg>
          <tei:l>הוֹשַֽׁעְנָא — <tei:seg type="acrostic">שָׁ</tei:seg>לוֹם וְשַׁלְוָה בְּשִׁלְטוֹנֵֽנוּ — הוֹשַֽׁעְנָא</tei:l>
          <tei:l>הוֹשַֽׁעְנָא — <tei:seg type="acrostic">תְּ</tei:seg>קוּמָה וְתוֹחֶֽלֶת תִּקְוָה בִּתְקוּפָתֵֽנוּ — הוֹשַֽׁעְנָא</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
