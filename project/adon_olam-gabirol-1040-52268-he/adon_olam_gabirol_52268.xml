  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:adon_olam_gabirol_52268">
        <tei:head>אֲדוֹן עוֹלָם (אשכנז)‏</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam_gabirol_52268/1"/>
        <tei:lg>
          <tei:l>אֲדוֹן עוֹלָם אֲשֶׁר מָלַךְ</tei:l>
          <tei:l>בְּטֶֽרֶם כׇּל־יְצִיר נִבְרָא׃</tei:l>
          <tei:l>לְעֵת נַֽעֲשָׂה כְּחֶפְצוֹ כֹּל</tei:l>
          <tei:l>אֲזַי מֶֽלֶךְ שְׁמוֹ נִקְרָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam_gabirol_52268/2"/>
        <tei:lg>
          <tei:l>וְאַֽחֲרֵי כִּכְלּוֹת הַכֹּל</tei:l>
          <tei:l>לְבַדּוֹ יִמְלֹךְ נוֹרָא׃</tei:l>
          <tei:l>וְהוּא הָיָה וְהוּא הֹוֶה</tei:l>
          <tei:l>וְהוּא יִֽהְיֶה בְּתִפְאֲרָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam_gabirol_52268/3"/>
        <tei:lg>
          <tei:l>וְהוּא אֶחָד וְאֵין שֵׁנִי</tei:l>
          <tei:l>לְהַמְשִׁיל לוֹ לְהַחְבִּירָה׃</tei:l>
          <tei:l>בְּלִי רֵאשִׁית בְּלִי תַּכְלִית</tei:l>
          <tei:l>וְלוֹ הָעֹז וְהַמִּשְׂרָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam_gabirol_52268/4"/>
        <tei:lg>
          <tei:l>וְהוּא אֵלִי וְחַי גּֽוֹאֲלִי</tei:l>
          <tei:l>וְצוּר חֶבְלִי בְּיוֹם צָרָה׃</tei:l>
          <tei:l>וְהוּא נִסִּי וּמָנוֹס לִי</tei:l>
          <tei:l>מְנָת כּוֹסִי בְּיוֹם אֶקְרָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam_gabirol_52268/5"/>
        <tei:lg>
          <tei:l>בְּיָדוֹ אַפְקִיד רוּחִי</tei:l>
          <tei:l>בְּעֵת אִישַׁן וְאָעִֽירָה׃</tei:l>
          <tei:l>וְעִם רוּחִי גְּוִיָּתִי</tei:l>
          <tei:l>אֲדֹנָי לִי וְלֹא אִירָא׃</tei:l>
        </tei:lg>
      </tei:div>
