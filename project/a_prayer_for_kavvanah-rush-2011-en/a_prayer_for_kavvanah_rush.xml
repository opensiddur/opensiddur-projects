  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_prayer_for_kavvanah_rush">
        <tei:head>A Prayer for Kavvanah, by Amanda Rush</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_kavvanah_rush/1"/>
        <tei:lg>
          <tei:l><tei:hi rend="italic">Hashem</tei:hi>, as I open my Siddur,</tei:l>
          <tei:l>let me pray with proper kavanah.</tei:l>
          <tei:l>Let me pray with sincerity,</tei:l>
          <tei:l>paying careful attention to every word I utter.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_kavvanah_rush/2"/>
        <tei:lg>
          <tei:l><tei:hi rend="italic">Hashem</tei:hi>, let me concentrate with my whole being</tei:l>
          <tei:l>on the meaning of each and every word, sentence and prayer.</tei:l>
          <tei:l>Keep my mind from wandering to other subjects,</tei:l>
          <tei:l>and keep me from neglecting to put my heart and soul</tei:l>
          <tei:l>into each and every prayer, praise and blessing.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_kavvanah_rush/3"/>
        <tei:lg>
          <tei:l>May my prayer come before You, O <tei:hi rend="italic">Hashem</tei:hi>,</tei:l>
          <tei:l>at a time of grace,</tei:l>
          <tei:l>and may it be accepted favorably by You.</tei:l>
          <tei:l><tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
