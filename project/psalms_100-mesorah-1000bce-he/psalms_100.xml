    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/100">
        <tei:head>תהלים ק׳</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/100/1-5"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">א</tei:hi> מִזְמ֥וֹר</tei:l>
          <tei:l>לְתוֹדָ֑ה</tei:l>
          <tei:l>הָרִ֥יעוּ לַ֝יהוָ֗ה</tei:l>
          <tei:l>כָּל־הָאָֽרֶץ׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ב</tei:hi> עִבְד֣וּ אֶת־יְהוָ֣ה</tei:l>
          <tei:l>בְּשִׂמְחָ֑ה</tei:l>
          <tei:l>בֹּ֥אוּ לְ֝פָנָ֗יו</tei:l>
          <tei:l>בִּרְנָנָֽה׃</tei:l>
          <tei:l><tei:hi rend="superscript">ג</tei:hi> דְּע֗וּ כִּֽי־יְהוָה֮ ה֤וּא אֱלֹ֫הִ֥ים</tei:l>
          <tei:l>הֽוּא־עָ֭שָׂנוּ</tei:l>
          <tei:l>ולא [וְל֣וֹ] אֲנַ֑חְנוּ</tei:l>
          <tei:l>עַ֝מּ֗וֹ</tei:l>
          <tei:l>וְצֹ֣אן מַרְעִיתֽוֹ׃</tei:l>
          <tei:l><tei:hi rend="superscript">ד</tei:hi> בֹּ֤אוּ שְׁעָרָ֨יו ׀</tei:l>
          <tei:l>בְּתוֹדָ֗ה חֲצֵרֹתָ֥יו</tei:l>
          <tei:l>בִּתְהִלָּ֑ה</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>הֽוֹדוּ־ל֝֗וֹ</tei:l>
          <tei:l>בָּרֲכ֥וּ שְׁמֽוֹ׃</tei:l>
          <tei:l><tei:hi rend="superscript">ה</tei:hi> כִּי־ט֣וֹב יְ֭הֹוָה לְעוֹלָ֣ם</tei:l>
          <tei:l>חַסְדּ֑וֹ</tei:l>
          <tei:l>וְעַד־דֹּ֥ר וָ֝דֹ֗ר</tei:l>
          <tei:l>אֱמוּנָתֽוֹ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
