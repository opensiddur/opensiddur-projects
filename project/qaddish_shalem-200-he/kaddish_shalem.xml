  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:kaddish_shalem">
        <tei:head>קדיש שלם</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaddish_shalem/1"/>
        <tei:lg>
          <tei:l>יִתְגַּדַל וְיִתְקַדָּשׁ שְׁמֵיהּ רַבָּא</tei:l>
          <tei:l>בְּעַלְמָא דִּי בְרָא כִרְעוּתֵיהּ</tei:l>
          <tei:l>וְיַמְלִיךְ מַלְכוּתֵיהּ</tei:l>
          <tei:l>וְיַצְמַח פּוּרְקָנֵיהּ</tei:l>
          <tei:l>וִיקָרֵב מְשִׁיחֵיהּ</tei:l>
          <tei:l>בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן</tei:l>
          <tei:l>וְיִפְרוֹק עַמֵיהּ בְּרַחְמְתֵיהּ</tei:l>
          <tei:l>בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן</tei:l>
          <tei:l>וּבְחַיֵּי דְּכָל בֵּית יִשְׂרָאֵל</tei:l>
          <tei:l>בַּעֲגָלָא וּבִזְמַן קָרִיב</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן׃‫ (אָמֵן)‬</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaddish_shalem/2"/>
        <tei:lg>
          <tei:l>יְהֵא שְׁמֵיהּ רַבָּא מְבָרַךְ</tei:l>
          <tei:l>לְעַלָם וּלְעַלְמֵיו עַלמַיָּא</tei:l>
          <tei:l>יְתְבָּרַךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaddish_shalem/3"/>
        <tei:lg>
          <tei:l>וְיִשְׁתַּבַּח וְיִתְפָּאֵר</tei:l>
          <tei:l>וְיִתְרוֹמָם וְיִתְנַשֵׂא</tei:l>
          <tei:l>וְיִתְהַדַּר וְיִתְעַלֵה וְיִתְהַלָּל</tei:l>
          <tei:l>שְׁמֵיהּ דְּקוּדְשָׁא בְּרִיךְ הוּא</tei:l>
          <tei:l>לְעֵילָא מִכָּל בִּרְכָתָא שִׁירָתָא</tei:l>
          <tei:l>תִּשְׁבְּחָתָא וְנֶחָמָתָא</tei:l>
          <tei:l>דַאֲמִירָן בְּעַלְמָא</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן׃‫ (אָמֵן) ‬</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaddish_shalem/4"/>
        <tei:lg>
          <tei:l>תִּתְקַבָּל צְלוֹתְכוֹן</tei:l>
          <tei:l>וְתִּתְעַבֵּיד בָּעוּתְכוֹן׃</tei:l>
          <tei:l>(אָמֵן)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaddish_shalem/5"/>
        <tei:lg>
          <tei:l>‫וּצְלוֹתְהוֹן וּבָעוּתְהוֹן דְעַמָא</tei:l>
          <tei:l>כָּל בֵּית יִשְׂרָאֵל</tei:l>
          <tei:l>קָדָם מָארֵיהּ דְבִשְּׁמַיָּא</tei:l>
          <tei:l>בְּכָל זְמַן</tei:l>
          <tei:l>וּבְכָל עִידַן</tei:l>
          <tei:l>וְעִידָנָא הָדֵין</tei:l>
          <tei:l>לְחַיִּים טוֹבִים</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן׃ (אָמֵן) ‬</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaddish_shalem/6"/>
        <tei:lg>
          <tei:l>תִּתְבְּנֵי קַרְתָּא דִירוּשְׁלֵם</tei:l>
          <tei:l>וִיתוּב פּוּלְחָנָא דִי שְׁמַיָּא לְאִתְרֵיהּ</tei:l>
          <tei:l>בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן</tei:l>
          <tei:l>וּבְחַיֵּי כָּל בֵּית יִשְׂרָאֵל</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן׃‫ (אָמֵן) ‬</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaddish_shalem/7"/>
        <tei:lg>
          <tei:l>תִּשְׁתַּלַח אֲסוּתָא רְפוּאָה</tei:l>
          <tei:l>דְחַיֵּי וּדְרַחֲמֵי מִן קָדָם קוּדְשָׁא בְּרִיךְ הוּא</tei:l>
          <tei:l>לְאַסָאָה יַתְכוֹן וּלְרַחֲמָא עֲלֵיכוֹן</tei:l>
          <tei:l>וּלְכָל מַאן דְצָרִיךְ לְאַסְוָתָא דְיִשְׂרָאֵל</tei:l>
          <tei:l>וִיתַּסֵי מִן קָדָמוֹהִי</tei:l>
          <tei:l>לְחַיּים וּלְשָׁלוֹם</tei:l>
          <tei:l>וְלִרְפוּאָה וְלִגְאוּלָה</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן׃‫ (אָמֵן) ‬</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaddish_shalem/8"/>
        <tei:lg>
          <tei:l>יֵיתִין שִׁמְעִין טָבִין</tei:l>
          <tei:l>וּבְשׂוֹרַן טָבָן</tei:l>
          <tei:l>עַל מַקְדְּשָׁא</tei:l>
          <tei:l>וְעַל הֵיכְלָא</tei:l>
          <tei:l>וְעַל אַתְרֵיהּ קַדִּישָׁא</tei:l>
          <tei:l>וְעַל מַלְכוּת מָשִׁיחַ בֶּן דָוִד</tei:l>
          <tei:l>בַּעֲגָּלָא וּבִזְמַן קָרִיב</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן׃‫ (אָמֵן) ‬</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaddish_shalem/9"/>
        <tei:lg>
          <tei:l>יְהֵא שְׁלָמָא רַבָּא מִן שְׁמַיָּיא</tei:l>
          <tei:l>וְסַיְיעֲתָא וּפוּרְקָנָא עֲלָנָא וַעֲלֵיכוֹן</tei:l>
          <tei:l>וְעַל כָּל קְהַלֵיכוֹן דְיִשְׂרָאֵל</tei:l>
          <tei:l>לְחַיּים וּלְשָׁלוֹם וְלִרְפוּאָה</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן׃‫ (אָמֵן) ‬</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaddish_shalem/10"/>
        <tei:lg>
          <tei:l>דְּכִירִין לְטַב</tei:l>
          <tei:l>וְעוֹד יִהְיֶה דוּכְרָנְכוֹן לְטַב</tei:l>
          <tei:l>לְשֵׁם טַב</tei:l>
          <tei:l>לְרוֹמְמָה</tei:l>
          <tei:l>לְקֶרֶן זְקוּפָה</tei:l>
          <tei:l>לְאַצְלַח דְעוֹבָרִין טָבִין</tei:l>
          <tei:l>לְכָל קְהָלָה קַדִּישָׁא הָדֵין</tei:l>
          <tei:l>מֵרַבְרְבֵיכוֹן וְעַד זְעִירֵיכוֹן‫</tei:l>
          <tei:l>מַלְכָּא דְעַלְמָא יְבָרֵךְ יַתְכוֹן׃</tei:l>
          <tei:l>(אָמֵן)‬</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaddish_shalem/11"/>
        <tei:lg>
          <tei:l>וְיַפֵּשׁ יַתְכוֹן׃</tei:l>
          <tei:l>(אָמֵן)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaddish_shalem/12"/>
        <tei:lg>
          <tei:l>וְיסַגִי יַתְכוֹן׃</tei:l>
          <tei:l>(אָמֵן)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaddish_shalem/13"/>
        <tei:lg>
          <tei:l>וְיִשְׁמַע לְקוֹל צְלוֹתְכוֹן׃</tei:l>
          <tei:l>(אָמֵן)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaddish_shalem/14"/>
        <tei:lg>
          <tei:l>וְיָעִיק לִמְעִיקֵיכוֹן׃</tei:l>
          <tei:l>(אָמֵן)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaddish_shalem/15"/>
        <tei:lg>
          <tei:l>וִיכַנֵשׂ מְבַדְרֵיכוֹן׃</tei:l>
          <tei:l>(אָמֵן)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaddish_shalem/16"/>
        <tei:lg>
          <tei:l>וִישֵׁיצֵי כָל דְחַקֵיכוֹן׃</tei:l>
          <tei:l>(אָמֵן)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaddish_shalem/17"/>
        <tei:lg>
          <tei:l>וְיבְנֶה מַקְדְשָׁא בְּחַיֵּיכוֹן</tei:l>
          <tei:l>חֲבֵרִים כָּל בֵּית יִשְׂרָאֵל</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן׃‫ (אָמֵן)‬</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaddish_shalem/18"/>
        <tei:lg>
          <tei:l>עוֹשֶׂה שָׁלוֹם בִּמְרוֹמָיו</tei:l>
          <tei:l>הוּא בְּרַחֲמָיו יַעֲשֶׂה שָׁלוֹם עָלֵינוּ</tei:l>
          <tei:l>וְעַל כָּל יִשְׂרָאֵל</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן׃‫ (אָמֵן)‬</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaddish_shalem/19"/>
        <tei:lg>
          <tei:l>לַיְּהוּדִ֕ים הָֽיְתָ֥ה אוֹרָ֖ה וְשִׂמְחָ֑ה</tei:l>
          <tei:l>וְשָׂשֹׂ֖ן וִיקָֽר׃ <tei:bibl>(אסתר ח:טז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaddish_shalem/20"/>
        <tei:lg>
          <tei:l>וְכָל יִשְׂרָאֵל</tei:l>
          <tei:l>בִּכְלַל כָּל הַבְּרָכוֹת</tei:l>
          <tei:l>יִהְיוּ לְחַיִּים טוֹבִים וּלְשָׁלוּם וְלִרְפוּאָה</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן׃‫ (אָמֵן)‬</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaddish_shalem/21"/>
        <tei:lg>
          <tei:l>לְשָׁנָה הַבָּאָה בִּירוּשָׁלַיִם׃</tei:l>
          <tei:l>יָבֹא מָשִׁיחַ בֶּן דָּוִד בִּמְהֵרָה בְיָמֵינוּ</tei:l>
          <tei:l>אָמֵן׃‫ (אָמֵן)‬</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaddish_shalem/22"/>
        <tei:lg>
          <tei:l>שָׁלוֹם עֲלֵיכֶם</tei:l>
          <tei:l>עֲלֵיכֶם שָׁלוֹם</tei:l>
          <tei:l>בְרָכָה וְטוֹבָה</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
