    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:elohai_neshamah">
        <tei:head>אלהי נשמה</tei:head>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>אֱלֹהַי,</tei:l>
          <tei:l>נְשָׁמָה שֶׁנָתַתָּ בִּי טְהוֹרָה הִיא.</tei:l>
          <tei:l>אַתָּה בְרַאתָהּ,</tei:l>
          <tei:l>וַאֲנִי קִבַּלְתִיהָ;</tei:l>
          <tei:l>אַתָּה יְצַרְתָהּ,</tei:l>
          <tei:l>וְהִיא שַׁבְרִיר קְדוּשָה;</tei:l>
          <tei:l>אַתָּה נְפַחְתָהּ בִּי,</tei:l>
          <tei:l>וְהִיא צֶלֶם אֱלֹהִים שֶׁבִּי.</tei:l>
          <tei:l>אַתָּה מְשַׁמְּרָהּ בְּקִרְבִּי,</tei:l>
          <tei:l>וְעָלַי לְשָׁמְרָהּ טְהוֹרָה.</tei:l>
          <tei:l>אַתָּה מְחַדְּשָׁהּ בִּי בְּכֹל בֹּקֶר בְּחֶמְלָה,</tei:l>
          <tei:l>וַאֲנִי בּוֹחֵר/ת בָּחַיִּים וּבַטּוֹב.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>כֹּל זְמָן שֶׁהַנְּשָׁמָה בְּקִרְבִּי</tei:l>
          <tei:l>מוֹדה אֲנִי לְפָנֵיךָ</tei:l>
          <tei:l>ה׳ אֱלֹהַי וֶאֱלֹהֵי אֲבוֹתַי וְאִמּוֹתַי.</tei:l>
          <tei:l>אַתָּה רִבּוֹן כֹּל הַמַּעֲשִֹים,</tei:l>
          <tei:l>אֲדוֹן כֹּל הַנְשָׁמוֹת,</tei:l>
          <tei:l>וַאֲנִי אֲבַקֵּשׁ דְּרָכִים לְמִימוּשׁ צַלְמְךָ בִּדְמוּתִי.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בָּרוּך אַתָּה ה׳,</tei:l>
          <tei:l>אֲשֶר בְּיָדוֹ נֶפֶש כֹּל חַי וְרוּחַ כֹּל בְּשַֹר אִישׁ.</tei:l>
        </tei:lg>
      </tei:div>
