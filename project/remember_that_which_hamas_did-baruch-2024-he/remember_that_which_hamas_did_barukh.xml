      <tei:div corresp="urn:x-opensiddur:text:prayer:remember_that_which_hamas_did_barukh">
        <tei:head>זָכוֹר אֵת אֲשֶׁר־עָשָׂה לְךָ חָמָאס</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:remember_that_which_hamas_did_barukh/1"/>
        <tei:lg>
          <tei:l>זָכ֕וֹר אֵ֛ת אֲשֶׁר־עָשָׂ֥ה לְךָ֖ חָמָ֑אס</tei:l>
          <tei:l>בַּיוֹ֥ם שִׂמְחַתְכֶ֖ם הָעֲצַֽרֶת׃</tei:l>
          <tei:l>אֲשֶׁ֨ר שָׂרַֽפְךָ֜ מִשָׁמַ֗יִם</tei:l>
          <tei:l>וַיְזַנֵּ֤ב בְּךָ֙</tei:l>
          <tei:l>מִן־הַיוֹשְׁבִ֣ים בְּגְּבוּלוֹתֶ֔יךָ</tei:l>
          <tei:l>וְאַתָּ֖ה עָיֵ֣ף וְיָגֵ֑עַ</tei:l>
          <tei:l>וְשָׂנֵ֖א אִ֥ישׁ אֶת־אָֽחִיו׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:remember_that_which_hamas_did_barukh/2"/>
        <tei:lg>
          <tei:l>וְהָיָ֡ה בְּהָנִ֣יחַ יְהוָ֣ה אֱלֹהֶ֣יךָ לְ֠ךָ</tei:l>
          <tei:l>מִכָּל־אֹ֨יְבֶ֜יךָ מִסָּבִ֗יב</tei:l>
          <tei:l>בָּאָ֨רֶץ֙ אֲשֶׁ֣ר יְהוָֽה־אֱ֠לֹהֶיךָ נֹתֵ֨ן לְךָ֤</tei:l>
          <tei:l>נַֽחֲלָה֙ לְרִשְׁתָּ֔הּ</tei:l>
          <tei:l>תִּמְחֶה֙ אֶת־זֵ֣כֶר חָמָ֔ס</tei:l>
          <tei:l>מִתַּ֖חַת הַשָּׁמָ֑יִם</tei:l>
          <tei:l>לֹ֖א תִּשְׁכָּֽח׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
