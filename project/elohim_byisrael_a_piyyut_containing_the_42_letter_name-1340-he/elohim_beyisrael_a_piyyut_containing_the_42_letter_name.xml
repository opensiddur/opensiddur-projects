    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:elohim_beyisrael_a_piyyut_containing_the_42_letter_name">
        <tei:head>אֱלֹהִים בְּיִשְׂרָאֵל</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_beyisrael_a_piyyut_containing_the_42_letter_name/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אֱ</tei:seg>לֹהִים בְּיִשְׂרָאֵל</tei:l>
          <tei:l>גָדוֹל יִחוּדֶךָ</tei:l>
          <tei:l>תְּשַׂגְּבֵנוּ צִדְקָתֶךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_beyisrael_a_piyyut_containing_the_42_letter_name/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>דוֹשׁ</tei:l>
          <tei:l>רְאֵה עֲלִילוֹת שׂוֹנְאֵינוּ</tei:l>
          <tei:l>טַהֵר נַחֲלָתֶךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_beyisrael_a_piyyut_containing_the_42_letter_name/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נִ</tei:seg>שְׂגַּב גְּאַל דּוֹרְשֶׁיךָ</tei:l>
          <tei:l>יִגְדַּל כֹּחַ שְׁמוֹתֶיךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_beyisrael_a_piyyut_containing_the_42_letter_name/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>שִׁמְךָ טַכֵּס רוּחֵנוּ</tei:l>
          <tei:l>צֶמַח תָּבִיא גְּאֻלָּתֵנוּ <tei:bibl>(זכריה ג:ח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_beyisrael_a_piyyut_containing_the_42_letter_name/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חָ</tei:seg>סִיד קָדוֹשׁ</tei:l>
          <tei:l>בְּרוֹב טוּבְךָ</tei:l>
          <tei:l>נוֹי עַנְוְתָנוּתֶךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_beyisrael_a_piyyut_containing_the_42_letter_name/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יֶ</tei:seg>הֱמוּ גֹּדֶל לְבָבֵנוּ</tei:l>
          <tei:l>פְּדֵנוּ זְכֹר קְדוּשָׁתֶךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_beyisrael_a_piyyut_containing_the_42_letter_name/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שְׁ</tei:seg>עֵה קוֹל וִידוּיֵינוּ</tei:l>
          <tei:l>צַדֵּק יוֹדֵעַ תְּהִלָּתֶךָ.‏</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
