  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_closing_prayer_seixas">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_closing_prayer_seixas/1"/>
        <tei:lg>
          <tei:l>יְהִי יְהוָה אֱלֹהֵינוּ עִמָּנוּ כַּאֲשֶׁר הָיָה עִם־אֲבֹתֵינוּ</tei:l>
          <tei:l>אַל־יַעַזְבֵנוּ וְאַל־יִטְּשֵׁנוּ׃</tei:l>
          <tei:l>לְהַטּוֹת לְבָבֵנוּ אֵלָיו</tei:l>
          <tei:l>לָלֶכֶת בְּכָל־דְּרָכָיו</tei:l>
          <tei:l>וְלִשְׁמֹר מִצְוֺתָיו</tei:l>
          <tei:l>וְחֻקָּיו וּמִשְׁפָּטָיו אֲשֶׁר צִוָּה אֶת־אֲבֹתֵינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_closing_prayer_seixas/2"/>
        <tei:lg>
          <tei:l>וְיִהְיוּ דְבָרַי אֵלֶּה</tei:l>
          <tei:l>אֲשֶׁר הִתְחַנַּנְתִּי לִפְנֵי יְהוָה</tei:l>
          <tei:l>קְרֹבִים אֶל־יְהוָה אֱלֹהֵינוּ יוֹמָם וָלָיְלָה</tei:l>
          <tei:l>לַעֲשׂוֹת מִשְׁפַּט עַבְדּוֹ</tei:l>
          <tei:l>וּמִשְׁפַּט עַמּוֹ יִשְׂרָאֵל</tei:l>
          <tei:l>דְּבַר־יוֹם בְּיוֹמוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_closing_prayer_seixas/3"/>
        <tei:lg>
          <tei:l>שֶׁיֵדְעוּ כׇּל יוֹשְׁבֵי תֵבֵל</tei:l>
          <tei:l>כִּי יְיָ הוּא אֱלֹהִים וְאֵין עוֹד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_closing_prayer_seixas/4"/>
        <tei:lg>
          <tei:l>לֹא־יָמוּשׁ סֵפֶר הַתּוֹרָה הַזֶּה מִפִּיךָ</tei:l>
          <tei:l>וְהָגִיתָ בּוֹ יוֹמָם וָלַיְלָה</tei:l>
          <tei:l>לְמַעַן תִּשְׁמֹר לַעֲשׂוֹת כְּכָל־הַכָּתוּב בּוֹ</tei:l>
          <tei:l>כִּי־אָז תַּצְלִיחַ אֶת־דְּרָכֶךָ</tei:l>
          <tei:l>וְאָז תַּשְׂכִּיל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_closing_prayer_seixas/5"/>
        <tei:lg>
          <tei:l>הֲלוֹא צִוִּיתִיךָ</tei:l>
          <tei:l>חֲזַק וֶאֱמָץ</tei:l>
          <tei:l>אַל־תַּעֲרֹץ וְאַל־תֵּחָת</tei:l>
          <tei:l>כִּי עִמְּךָ יְהוָה אֱלֹהֶיךָ</tei:l>
          <tei:l>בְּכֹל אֲשֶׁר תֵּלֵךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_closing_prayer_seixas/6"/>
        <tei:lg>
          <tei:l>תְּקֻבַּל בְּרַחֲמִים וּבְרָצוֹן תְּפִלָּתֵנוּ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
