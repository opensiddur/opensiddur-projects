  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_on_behalf_of_one_celebrating_a_birthday_kaplan">
        <tei:head>מי שברך לתקופת יום הולדת</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_on_behalf_of_one_celebrating_a_birthday_kaplan/1"/>
        <tei:lg>
          <tei:l>מִי שֶׁבֵּרַךְ אֲבוֹתֵֽינוּ</tei:l>
          <tei:l>אַבְרָהָם יִצְחָק וְיַעֲקֹב</tei:l>
          <tei:l>הוּא יְבָרֵךְ אֶת (<tei:note type="instruction">...</tei:note>)</tei:l>
          <tei:l>לִתְקוּפַת יוֹם הֻלַּדְתּוֹ/הֻלַּדְתָּהּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_on_behalf_of_one_celebrating_a_birthday_kaplan/2"/>
        <tei:lg>
          <tei:l>הָאֱלֹהִים הָרוֹעֶה אוֹתוֹ מֵעוֹדוֹ/אוֹתָהּ מֵעוֹדָהּ</tei:l>
          <tei:l>עַד הַיּוֹם הַזֶּה</tei:l>
          <tei:l>יִשְׁמְרֵֽהוּ/יִשְׁמְרֶֽהָ</tei:l>
          <tei:l>וִיחַיֵּֽהוּ/וִיחַיֶּֽהָ</tei:l>
          <tei:l>וִיאַשְּׁרֵֽהוּ/וִיאַשְּׁרֶֽהָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_on_behalf_of_one_celebrating_a_birthday_kaplan/3"/>
        <tei:lg>
          <tei:l>וְיוֹסִיף לוֹ/לָהּ שְׁנוֹת חַיִּים וּבְרָכָה</tei:l>
          <tei:l>בְּטוֹב וּבִנְעִימוֹת בְּרָב־עֹז וְשָׁלוֹם</tei:l>
          <tei:l>וְנָֽסוּ יָגוֹן וַאֲנָחָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_on_behalf_of_one_celebrating_a_birthday_kaplan/4"/>
        <tei:lg>
          <tei:l>יְחַדֵּֽהוּ/יְחַדֶּֽהָ בְאֽשֶׁר</tei:l>
          <tei:l>וּבְשִׂמְחַת לֵבָב</tei:l>
          <tei:l>שֶׁל־כׇּל־אֲהוּבֵי נַפְשׁוֹ/נַפְשָׁהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_on_behalf_of_one_celebrating_a_birthday_kaplan/5"/>
        <tei:lg>
          <tei:l>וִימַלֵּא</tei:l>
          <tei:l>כׇּל־מִשְׁאֲלוֹת לִבּוֹ/לִבָּהּ</tei:l>
          <tei:l>תִּקְווֹתָיו/תִּקְווֹתֶֽיהָ</tei:l>
          <tei:l>וּתְפִלּוֹתָיו/וּתְפִלּוֹתֶֽיהָ לְטוֹבָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_on_behalf_of_one_celebrating_a_birthday_kaplan/6"/>
        <tei:lg>
          <tei:l>אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mi_sheberakh_on_behalf_of_one_celebrating_a_birthday_kaplan/7"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְהֹוָה אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם</tei:l>
          <tei:l>שֶׁהֶחֱיָֽנוּ</tei:l>
          <tei:l>וְקִיְּמָֽנוּ</tei:l>
          <tei:l>וְהִגִּיעָֽנוּ</tei:l>
          <tei:l>לַזְּמָן הַזֶּה:</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
