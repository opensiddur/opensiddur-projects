      <tei:div type="colophon" subtype="introduction">
        <tei:p>Guest Chaplain: Rabbi Philip S. Bernstein, Temple B’rith Kodesh, Rochester, New York</tei:p>
        <tei:p>Sponsor: Sen. Jacob Javits (R-NY)</tei:p>
        <tei:p>Date of Prayer: 23 April 1958</tei:p>
      </tei:div>
      <j:endConditional target="#osp_55580_introduction"/>
      <j:conditional xml:id="osp_55580_notes">
        <tei:fs type="opensiddur:paratext">
          <tei:f name="include">
            <tei:binary value="true"/>
          </tei:f>
        </tei:fs>
      </j:conditional>
      <tei:div type="colophon" subtype="notes">
        <tei:p>This prayer of the guest chaplain was offered in the fourth month of the second session of the 85th US Congress in the Senate, and published in the <tei:hi rend="italic">Congressional Record</tei:hi>, vol. 104, part 6 (23 April 1958), page 6991. The prayer was offered in the context of Congressional legislation made in recognition of the 10th anniversary of the establishment of the State of Israel.</tei:p>
      </tei:div>
