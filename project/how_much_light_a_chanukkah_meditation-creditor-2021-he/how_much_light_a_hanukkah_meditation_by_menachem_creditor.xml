  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:how_much_light_a_hanukkah_meditation_by_menachem_creditor">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:how_much_light_a_hanukkah_meditation_by_menachem_creditor/1"/>
        <tei:lg>
          <tei:l>תָּנוּ רַבָּנַן:</tei:l>
          <tei:l>מִצְוַת חֲנוּכָּה, נֵר אִישׁ וּבֵיתוֹ.</tei:l>
          <tei:l>וְהַמְהַדְּרִין, נֵר לְכׇל אֶחָד וְאֶחָד.</tei:l>
          <tei:l>וְהַמְהַדְּרִין מִן הַמְהַדְּרִין,</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בֵּית שַׁמַּאי אוֹמְרִים: יוֹם רִאשׁוֹן מַדְלִיק שְׁמֹנָה, מִכָּאן וְאֵילָךְ פּוֹחֵת וְהוֹלֵךְ.</tei:l>
          <tei:l>וּבֵית הִלֵּל אוֹמְרִים: יוֹם רִאשׁוֹן מַדְלִיק אַחַת, מִכָּאן וְאֵילָךְ מוֹסִיף וְהוֹלֵךְ. ...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
