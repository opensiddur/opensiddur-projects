  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_peace_mazor">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_peace_mazor/1"/>
        <tei:lg>
          <tei:l><j:divineName>God</j:divineName> <j:divineName>Allah</j:divineName> <j:divineName>Hashem</j:divineName></tei:l>
          <tei:l>Strengthen the hands of those who strive for peace in our region</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_peace_mazor/2"/>
        <tei:lg>
          <tei:l>May they know and feel that they are not alone,</tei:l>
          <tei:l>behind them we all stand, people of all faiths, ages, gender</tei:l>
          <tei:l>who pray for peace and quiet in our land.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_peace_mazor/3"/>
        <tei:lg>
          <tei:l>May all the hostages return to their homes.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_peace_mazor/4"/>
        <tei:lg>
          <tei:l>We pray for the end of this vicious blood cycle.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_peace_mazor/5"/>
        <tei:lg>
          <tei:l>May this be a land of life to all its inhabitants</tei:l>
          <tei:l>from here and on.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_peace_mazor/6"/>
        <tei:lg>
          <tei:l>And let us say: <tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>