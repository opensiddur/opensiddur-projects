        <tei:lg>
          <tei:l><tei:seg type="acrostic">שׁ</tei:seg>וֹמֵר שְׁאֵרִית</tei:l>
          <tei:l><tei:seg type="acrostic">תּ</tei:seg>וֹמֵךְ הַבְּרִית</tei:l>
          <tei:l>חַדֵּ֥שׁ יָמֵ֖ינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:fourth_blessing_of_a_neilah_service_amidah_for_tishah_beav_mayer/42"/>
        <tei:lg>
          <tei:l>כַּכָּתוּב בַּחֲתִימַת קִינוֹת הַנָּבִיא הַנִּקְדָּשׁ מֵרֶֽחֶם לֵאמֹר</tei:l>
          <tei:l>הֲשִׁיבֵ֨נוּ יְהֹוָ֤ה ׀ אֵלֶ֙יךָ֙ וְֽנָשׁ֔וּבָ</tei:l>
          <tei:l>חַדֵּ֥שׁ יָמֵ֖ינוּ כְּקֶֽדֶם׃ <tei:bibl>(איכה ה:כא)</tei:bibl></tei:l>
          <tei:l>כִּי אַתָּה יְהֹוָה אֱלֹהֵֽינוּ מְנַחֵם יִשְׂרָאֵל</tei:l>
          <tei:l>וּמְחַדֵּשׁ יְמֵי יְשֻׁרוּן בְּכׇל־דּוֹר וְדוֹר</tei:l>
          <tei:l>וּמִבִּלְעָדֶֽיךָ אֵין־לָֽנוּ מְנַחֵם וּמַחֲזִיר</tei:l>
          <tei:l>וּמֵשִׁיב וּמְחַדֵּשׁ</tei:l>
          <tei:l>אֶֽלָּא אָֽתָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:fourth_blessing_of_a_neilah_service_amidah_for_tishah_beav_mayer/43"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה</tei:l>
          <tei:l>מְנַחֵם צִיּוֹן וּבוֹנֶה יְרוּשָׁלָֽיִם׃</tei:l>
        </tei:lg>
