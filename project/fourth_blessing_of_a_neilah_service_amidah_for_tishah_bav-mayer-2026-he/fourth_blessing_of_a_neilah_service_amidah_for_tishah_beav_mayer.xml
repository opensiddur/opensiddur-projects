          <tei:l><tei:seg type="acrostic">בּ</tei:seg>וֹרֵא עוֹלָמוֹת</tei:l>
          <tei:l>חַדֵּ֥שׁ יָמֵ֖ינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:fourth_blessing_of_a_neilah_service_amidah_for_tishah_beav_mayer/32"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">גּ</tei:seg>וֹמֵל חֲסָדִים</tei:l>
          <tei:l><tei:seg type="acrostic">דּ</tei:seg>וֹבֵר עֲתִידִים</tei:l>
          <tei:l>חַדֵּ֥שׁ יָמֵ֖ינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:fourth_blessing_of_a_neilah_service_amidah_for_tishah_beav_mayer/33"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ה</tei:seg>וֹגֵן בִּצְדָקָה</tei:l>
          <tei:l><tei:seg type="acrostic">וּ</tei:seg>מַאֲזִין לַזְּעָקָה</tei:l>
          <tei:l>חַדֵּ֥שׁ יָמֵ֖ינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:fourth_blessing_of_a_neilah_service_amidah_for_tishah_beav_mayer/34"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ז</tei:seg>וֹכֵר אָבוֹת</tei:l>
          <tei:l><tei:seg type="acrostic">ח</tei:seg>וֹקֵר מַחְשָׁבוֹת</tei:l>
          <tei:l>חַדֵּ֥שׁ יָמֵ֖ינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:fourth_blessing_of_a_neilah_service_amidah_for_tishah_beav_mayer/35"/>
