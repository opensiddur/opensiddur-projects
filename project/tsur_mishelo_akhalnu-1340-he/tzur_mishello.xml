    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:tzur_mishello">
        <tei:head>צוּר מִשֶּׁלּוֹ אָכַֽלְנוּ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tzur_mishello/refrain"/>
        <tei:lg>
          <tei:l>צוּר מִשֶּׁלּוֹ אָכַֽלְנוּ</tei:l>
          <tei:l>בָּרְכוּ אֱמוּנַי</tei:l>
          <tei:l>שָׂבַֽעְנוּ וְהוֹתַֽרְנוּ</tei:l>
          <tei:l>כִּדְבַר יְיָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tzur_mishello/1"/>
        <tei:lg>
          <tei:l>הַזָּן אֶת עוֹלָמוֹ</tei:l>
          <tei:l>רוֹעֵֽנוּ אָבִֽינוּ</tei:l>
          <tei:l>אָכַֽלְנוּ אֶת לַחְמוֹ</tei:l>
          <tei:l>וְיֵינוֹ שָׁתִֽינוּ</tei:l>
          <tei:l>עַל כֵּן נוֹדֶה לִשְׁמוֹ</tei:l>
          <tei:l>וּנְהַלְּלוֹ בְּפִֽינוּ</tei:l>
          <tei:l>אָמַֽרְנוּ וְעָנִֽינוּ</tei:l>
          <tei:l>אֵין קָדוֹשׁ כַּייָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tzur_mishello/2"/>
        <tei:lg>
          <tei:l>בְּשִׁיר וְקוֹל תּוֹדָה</tei:l>
          <tei:l>נְבָרֵךְ לֵאלֹהֵֽינוּ,</tei:l>
          <tei:l>עַל אֶֽרֶץ חֶמְדָּה טוֹבָה</tei:l>
          <tei:l>שֶׁהִנְחִיל לַאֲבוֹתֵֽינוּ,</tei:l>
          <tei:l>מָזוֹן וְצֵדָה</tei:l>
          <tei:l>הִשְׂבִּֽיעַ לְנַפְשֵׁנוּ,</tei:l>
          <tei:l>חַסְדּוֹ גָּבַר עָלֵֽינוּ</tei:l>
          <tei:l>וֶאֱמֶת יְיָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tzur_mishello/3"/>
        <tei:lg>
          <tei:l>רַחֵם בְּחַסְדֶּֽךָ</tei:l>
          <tei:l>עַל עַמְּךָ צוּרֵֽנוּ,</tei:l>
          <tei:l>עַל צִיּוֹן מִשְׁכַּן כְּבוֹדֶֽךָ</tei:l>
          <tei:l>זְבוּל בֵּית תִּפְאַרְתֵּֽנוּ,</tei:l>
          <tei:l>בֶּן דָּוִד עַבְדֶּֽךָ</tei:l>
          <tei:l>יָבוֹא וְיִגְאָלֵֽנוּ,</tei:l>
          <tei:l>רֽוּחַ אַפֵּֽינוּ</tei:l>
          <tei:l>מְשִֽׁיחַ יְיָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tzur_mishello/4"/>
        <tei:lg>
          <tei:l>יִבָּנֶה הַמִּקְדָּשׁ</tei:l>
          <tei:l>עִיר צִיּוֹן תְּמַלֵּא</tei:l>
          <tei:l>וְשָׁם נָשִׁיר שִׁיר חָדָשׁ</tei:l>
          <tei:l>וּבִרְנָנָה נַעֲלֶה</tei:l>
          <tei:l>הָרַחֲמָן הַנִּקְדָּשׁ</tei:l>
          <tei:l>יִתְבָּרַךְ וְיִתְעַלֶּה</tei:l>
          <tei:l>עַל כּוֹס יַֽיִן מָלֵא</tei:l>
          <tei:l>כְּבִרְכַּת יְיָ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
