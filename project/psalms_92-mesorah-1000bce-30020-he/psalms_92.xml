      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/92">
        <tei:head>תהלים צ״ב</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/92/1"/>
        <tei:lg>
          <tei:l>מִזְמוֹר שִׁיר לְיוֹם הַשַּׁבָּת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/92/2/a"/>
        <tei:lg>
          <tei:l>טוֹב לְהֹדוֹת לַיהוה,</tei:l>
          <tei:l>וּלְזַמֵּר לְשִׁמְךָ עֶלְיוֹן׃</tei:l>
          <tei:l>לְהַגִּיד בַּבּוֹקֶר חַסְדֶּךָ,</tei:l>
          <tei:l>וֶאֱמוּנָתְךָ בַּלֵּילוֹת׃</tei:l>
          <tei:l>עֲלֵי־עָשֹוֹר וַעֲלֵי־נָבֶל, עֲלֵי הִגָּיוֹן בְּכִנּוֹר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/92/5/a"/>
        <tei:lg>
          <tei:l>כִּי שִׂמַּחְתַּנִי יהוה בְּפָעֳלֶךָ,</tei:l>
          <tei:l>בְּמַעֲשֵׂי יָדֶיךָ אֲרַנֵּן׃</tei:l>
          <tei:l>מַה־גָּדְלוּ מַעֲשֶׂיךָ יהוה,</tei:l>
          <tei:l>מְאֹד עָמְקוּ מַחְשְׁבֹתֶיךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>אִישׁ בַּעַר לֹא יֵדָע,</tei:l>
          <tei:l>וּכְסִיל לֹא־יָבִין אֶת זֹאת׃</tei:l>
          <tei:l>בִּפְרֹחַ רְשָׁעִים כְּמוֹ עֵשֶׂב,</tei:l>
          <tei:l>וַיָּצִיצוּ כָּל־פֹּעֲלֵי אָוֶן,</tei:l>
          <tei:l>לְהִשָּׁמְדָם עֲדֵי עַד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/92/9"/>
        <tei:lg>
          <tei:l>וְאַתָּה מָרוֹם לְעוֹלָם יהוה׃</tei:l>
          <tei:l>כִּי־הִנֵּה אֹיְבֶיךָ יהוה,</tei:l>
          <tei:l>כִּי הִנֵּה אֹיְבֶיךָ יֹאבֵדוּ,</tei:l>
          <tei:l>יִתְפָּרְדוּ כָּל־פֹּעֲלֵי אָוֶן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/92/11/a"/>
        <tei:lg>
          <tei:l>וַתָּרֶם כִּרְאֵים קַרְנִי,</tei:l>
          <tei:l>בַּלֹּתִי בְּשֶׁמֶן רַעֲנָן׃</tei:l>
          <tei:l>וַתַּבֵּט עֵינִי בְּשׁוּרָי,</tei:l>
          <tei:l>בַּקָּמִים עָלַי מְרֵעִים תִּשְׁמַעְנָה אָזְנָי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/92/13/a"/>
        <tei:lg>
          <tei:l>צַדִּיק כַּתָּמָר יִפְרָח,</tei:l>
          <tei:l>כְּאֶרֶז בַּלְּבָנוֹן יִשְׂגֶּה׃</tei:l>
          <tei:l>שְׁתוּלִים בְּבֵית יהוה,</tei:l>
          <tei:l>בְּחַצְרוֹת אֱלֹהֵינוּ יַפְרִיחוּ׃</tei:l>
          <tei:l>עוֹד יְנוּבוּן בְּשֵׂיבָה,</tei:l>
          <tei:l>דְּשֵׁנִים וְרַעֲנַנִּים יִהְיוּ׃</tei:l>
          <tei:l>לְהַגִּיד כִּי־יָשָׁר יהוה,</tei:l>
          <tei:l>צוּרִי וְלֹא עַוְלָתָה בּוֹ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
