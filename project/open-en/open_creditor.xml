  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:open_creditor">
        <tei:head>Open, by Rabbi Menachem Creditor</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:open_creditor/1"/>
        <tei:lg>
          <tei:l>In this silence</tei:l>
          <tei:l>I do not call to You, my God.</tei:l>
          <tei:l>I do not call out at all</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:open_creditor/2"/>
        <tei:lg>
          <tei:l>Instead, for an instant of openness</tei:l>
          <tei:l>I offer, not demand</tei:l>
          <tei:l>I surrender, just for a moment</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:open_creditor/3"/>
        <tei:lg>
          <tei:l>Instead of asking for my needs</tei:l>
          <tei:l>or of challenging You, our usual way</tei:l>
          <tei:l>I am quiet and available to You</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:open_creditor/4"/>
        <tei:lg>
          <tei:l>You, You, You</tei:l>
          <tei:l>I am here</tei:l>
          <tei:l>I am open</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>