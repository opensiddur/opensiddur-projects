  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:blessing_for_dreidel_spinning">
        <tei:head>A Blessing for Dreidel Spinning, by Lieba B. Deutsch</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_for_dreidel_spinning/1"/>
        <tei:lg>
          <tei:l>May I achieve self-realization in the present moment, and</tei:l>
          <tei:l>Fully receive the Shekhinah’s abundant protection.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_for_dreidel_spinning/2"/>
        <tei:lg>
          <tei:l>Blessed are You,</tei:l>
          <tei:l>Ruler of Time and Space,</tei:l>
          <tei:l>Who directs us to spin the <tei:hi rend="italic">dreidel</tei:hi>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_for_dreidel_spinning/3"/>
        <tei:lg>
          <tei:l>
            <tei:hi rend="italic">Amen.</tei:hi>
          </tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
