    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ashorer_shirim_naim_tsur">
        <tei:head>אֲשׁוֹרֵר שִׁירִים נָאִים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashorer_shirim_naim_tsur/1"/>
        <tei:lg>
          <tei:l>אֲשׁוֹרֵר שִׁירִים נָאִים</tei:l>
          <tei:l>לְשׁוֹכֵן מְעוֹנִים</tei:l>
          <tei:l>הִגְבִּיר הַחַשְׁמוֹנָאִים</tei:l>
          <tei:l>מַמְלֶֽכֶת כֹּהֲנִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashorer_shirim_naim_tsur/2"/>
        <tei:lg>
          <tei:l>יְוָנִים קָמוּ נֶגְדִּי</tei:l>
          <tei:l>כׇּל־חֵיל אַנְטִיּוֹכוֹס</tei:l>
          <tei:l>בִּקְשׁוּ לְאַבְּדִי</tei:l>
          <tei:l>כׇּל־הֶגְמוֹן וְדוּכּוֹס</tei:l>
          <tei:l>וְצוּר מָגֵן בַּעֲדִי</tei:l>
          <tei:l>הִשְׁקָם סַף רַֽעַל כּוֹס</tei:l>
          <tei:l>תָּעוּ כְּמוֹ פְרָאִים</tei:l>
          <tei:l>נָפְלוּ בְּאַשְׁמַנִּים׃</tei:l>
          <tei:l>הִגְבִּיר...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashorer_shirim_naim_tsur/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">עַ</tei:seg>ל־כֵּן הוֹרוּ הַמּוֹרִים</tei:l>
          <tei:l>לְהַעֲלוֹת נֵרוֹת</tei:l>
          <tei:l>וּלְתַשְׁמִישׁ הֵם אֲסוּרִים</tei:l>
          <tei:l>אַךְ לִרְאוֹת מְאוֹרוֹת</tei:l>
          <tei:l>בַּפְּתָחִים וּבַשְּׁעָרִים</tei:l>
          <tei:l>יִהְיוּ מְסֻדָּרוֹת</tei:l>
          <tei:l>לְפַרְסֵם נֵס וּפְלָאִים</tei:l>
          <tei:l>לְעֵין כׇּל־הֲמוֹנִים׃</tei:l>
          <tei:l>הִגְבִּיר...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashorer_shirim_naim_tsur/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>דוֹשׁ רַב הַצְּבָאוֹת</tei:l>
          <tei:l>צוּר הַכֹּל מְחוֹלֵל</tei:l>
          <tei:l>בַּעֲשׂוֹתוֹ נוֹרָאוֹת</tei:l>
          <tei:l>אֶגְמֹר אֶת־הַהַלֵּל</tei:l>
          <tei:l>גַּם אֶתֵּן רֹב הוֹדָאוֹת</tei:l>
          <tei:l>אֵלָיו עֵת אֶתְפַּלֵּל</tei:l>
          <tei:l>וּבְעֵת מֵעָי מְלֵאִים</tei:l>
          <tei:l>בְּבִרְכַּת מְזוֹנִים׃</tei:l>
          <tei:l>הִגְבִּיר...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashorer_shirim_naim_tsur/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>עֻזְּךָ אֵל נוֹרָא</tei:l>
          <tei:l>כׇּל־שׂוֹטְנַי הַצְמִיתָה</tei:l>
          <tei:l>וּבְרֹב זַֽעַם וְעֶבְרָה</tei:l>
          <tei:l>אֶת־זִכְרָם הַשְׁבִּיתָה</tei:l>
          <tei:l>וּבְנֵה בֵּית הַבְּחִירָה</tei:l>
          <tei:l>וֶהְיֵה לִי עֶזְרָתָה</tei:l>
          <tei:l>וְנִשְׁמַת כׇּל־בְּרוּאִים</tei:l>
          <tei:l>תּוֹדֶֽךָּ צוּר בִּרְנָנִים׃</tei:l>
          <tei:l>הִגְבִּיר...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
