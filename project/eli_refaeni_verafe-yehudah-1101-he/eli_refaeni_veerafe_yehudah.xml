  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:eli_refaeni_veerafe_yehudah">
        <tei:head>אֱלִי, רְפָאֵנִי וְאֵרָפֵא</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eli_refaeni_veerafe_yehudah/1"/>
        <tei:lg>
          <tei:l>אֱלִי, רְפָאֵנִי וְאֵרָפֵא,</tei:l>
          <tei:l>אַל יֶחֱרֶה אַפָּךְ וְאֶסָּפֶה!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eli_refaeni_veerafe_yehudah/2"/>
        <tei:lg>
          <tei:l>סַמִּי וּמֶרְקָחִי לְךָ – בֵּין טוֹב</tei:l>
          <tei:l>בֵין רָע, וּבֵין חָזָק וּבֵין רָפֶה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eli_refaeni_veerafe_yehudah/3"/>
        <tei:lg>
          <tei:l>אַתָּה אֲשֶׁר תִּבְחַר וְלֹא אָנִי,</tei:l>
          <tei:l>עַל דַּעְתְּךָ הָרָע וְהַיָּפֶה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:eli_refaeni_veerafe_yehudah/4"/>
        <tei:lg>
          <tei:l>לֹא עַל רְפוּאָתִי אֲנִי נִסְמָךְ –</tei:l>
          <tei:l>רַק אֶל רְפוּאָתְךָ אֲנִי צוֹפֶה.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
