    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/82">
        <tei:head>תהלים פ״ב</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/82/1-8"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">א</tei:hi> <tei:note type="instruction">מִזְמ֗וֹר לְאָ֫סָ֥ף</tei:note></tei:l>
          <tei:l>אֱֽלֹהִ֗ים נִצָּ֥ב</tei:l>
          <tei:l>בַּעֲדַת־אֵ֑ל</tei:l>
          <tei:l>בְּקֶ֖רֶב אֱלֹהִ֣ים</tei:l>
          <tei:l>יִשְׁפֹּֽט׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ב</tei:hi> עַד־מָתַ֥י</tei:l>
          <tei:l>תִּשְׁפְּטוּ־עָ֑וֶל</tei:l>
          <tei:l>וּפְנֵ֥י רְ֝שָׁעִ֗ים</tei:l>
          <tei:l>תִּשְׂאוּ־סֶֽלָה׃</tei:l>
          <tei:l><tei:hi rend="superscript">ג</tei:hi> שִׁפְטוּ־דַ֥ל</tei:l>
          <tei:l>וְיָת֑וֹם עָנִ֖י</tei:l>
          <tei:l>וָרָ֣שׁ</tei:l>
          <tei:l>הַצְדִּֽיקוּ׃</tei:l>
          <tei:l><tei:hi rend="superscript">ד</tei:hi> פַּלְּטוּ־דַ֥ל וְאֶבְי֑וֹן</tei:l>
          <tei:l>מִיַּ֖ד רְשָׁעִ֣ים הַצִּֽילוּ׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ה</tei:hi> לֹ֤א יָֽדְע֨וּ ׀</tei:l>
          <tei:l>וְלֹ֥א יָבִ֗ינוּ בַּחֲשֵׁכָ֥ה יִתְהַלָּ֑כוּ</tei:l>
          <tei:l>יִ֝מּ֗וֹטוּ</tei:l>
          <tei:l>כָּל־מ֥וֹסְדֵי אָֽרֶץ׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ו</tei:hi> אֲֽנִי־אָ֭מַרְתִּי אֱלֹהִ֣ים אַתֶּ֑ם</tei:l>
          <tei:l>וּבְנֵ֖י עֶלְי֣וֹן</tei:l>
          <tei:l>כֻּלְּכֶֽם׃</tei:l>
          <tei:l><tei:hi rend="superscript">ז</tei:hi> אָ֭כֵן כְּאָדָ֣ם תְּמוּת֑וּן</tei:l>
          <tei:l>וּכְאַחַ֖ד הַשָּׂרִ֣ים תִּפֹּֽלוּ׃</tei:l>
          <tei:l><tei:hi rend="superscript">ח</tei:hi> קוּמָ֣ה אֱ֭לֹהִים</tei:l>
          <tei:l>שָׁפְטָ֣ה הָאָ֑רֶץ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>כִּֽי־אַתָּ֥ה תִ֝נְחַ֗ל</tei:l>
          <tei:l>בְּכָל־הַגּוֹיִֽם׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
