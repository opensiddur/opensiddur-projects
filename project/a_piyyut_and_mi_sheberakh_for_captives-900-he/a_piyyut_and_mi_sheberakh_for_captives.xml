  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:a_piyyut_and_mi_sheberakh_for_captives">
        <tei:head>יש מקומות שנהגו לבקש רחמים על האסור בבית האסורים כדרך הזה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_piyyut_and_mi_sheberakh_for_captives/1"/>
        <tei:lg>
          <tei:l>הָאֵל כֹּל יָכוֹל בּוֹרֵא יֵשׁ מֵאַיִן</tei:l>
          <tei:l>לֹא יַשִּׂיגֶנּוּ שֶׁמַע אוֹזֶן וְלֹא רְאוּת עַיִן</tei:l>
          <tei:l>נִשְׂגָּב לְבַדּוֹ וּמֵעֵין כֹּל נֶעְלָם</tei:l>
          <tei:l>כְּבוֹדוֹ מָלֵא עוֹלָם</tei:l>
          <tei:l>הַצּוּר יָשָׁר תָּמִים פָּעֳלוֹ</tei:l>
          <tei:l>הַמֵּאִיר עֵינֵי הַמְחַכִּים לוֹ</tei:l>
          <tei:l>יוֹצִיאֵם לְאוֹר גָּדוֹל מִצַּלְמָוֶת וּמֵחוֹשֶׁךְ</tei:l>
          <tei:l>לְמַכִּירָיו חַסְדּוֹ וְצִדְקָתוֹ מוֹשֵׁךְ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_piyyut_and_mi_sheberakh_for_captives/2"/>
        <tei:lg>
          <tei:l>נוֹרָא תְהִלּוֹת עוֹשֵׂה פֶלֶא</tei:l>
          <tei:l>הַמּוֹצִיא מִמַּסְגֵּר אַסִּיר וּמִבֵּית כֶּלֶא</tei:l>
          <tei:l>מְגַלֶּה עֲמֻקוֹת מִנִּי יַם</tei:l>
          <tei:l>מוֹשִׁיב יְחִידִים לֹא נוֹדָע מְקוֹמָם אַיָּם</tei:l>
          <tei:l>מוֹצִיא אֲסִירִים בַּכּוֹשָׁרוֹת</tei:l>
          <tei:l>מְנַהֵל לְאַט פְּלֵטַת צֹאן הַנִּשְׁאָרוֹת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_piyyut_and_mi_sheberakh_for_captives/3"/>
        <tei:lg>
          <tei:l>שִׂימָה בְנֹאדְךָ דִּמְעַת הָעֲשׁוּקִים</tei:l>
          <tei:l>הָאֲסוּרִים בְּכַבְלֵי בַרְזֶל וְזִיקִּים</tei:l>
          <tei:l>נֶעֱצָרִים וְנִלְכָּדִים בְּבֵית כֶּלֶא וָסוֹהַר</tei:l>
          <tei:l>נְתוּנִים בְּמַחֲשַׁכִּים בְּלִי שֶׁמֶשׁ‏‏‏ וָסַהַר</tei:l>
          <tei:l>רְעֵבִים צְמֵאִים מְעֻונִּים וּלְחוּצִים</tei:l>
          <tei:l>בְּצַעַר וְצָרָה וְיִסּוּרִין נֹגְשֵׂיהֶם אָצִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_piyyut_and_mi_sheberakh_for_captives/4"/>
        <tei:lg>
          <tei:l>הָאֵל הַגָּדוֹל הַגִּבּוֹר וְהַנּוֹרָא</tei:l>
          <tei:l>הָעוֹנֶה לְקוֹרְאָיו לְעִתּוֹת בַּצָּרָה</tei:l>
          <tei:l>שְׁמַע נָא לִתְפִלַּת אֲסִירֵי עַמְּךָ בֵּית יִשְׂרָאֵל וְאֶל נַאֲקָתָם</tei:l>
          <tei:l>פְּתַח שָׁמַיִם לִתְפִלָּתָם וְדַלְתֵי מָרוֹם לְזַעֲקָתָם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_piyyut_and_mi_sheberakh_for_captives/5"/>
        <tei:lg>
          <tei:l>וְהַתֵּר אֲגֻדּוֹת מוֹטָם וּפַתֵּחַ חַרְצֻבּוֹתֵיהֶם</tei:l>
          <tei:l>וְשַׁלַּח רְצוּצִים חָפְשִׁים כַּיּוֹנִים מֵאֲרֻבּוֹתֵיהֶם</tei:l>
          <tei:l>דַּלְתוֹת מַאֲסָרָם תְּגַדֵּעַ וְתִשְׁבּוֹר</tei:l>
          <tei:l>וּבְדַם בְּרִיתְךָ [תְּשַׁלַּח] אֲסִירִים מִבּוֹר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_piyyut_and_mi_sheberakh_for_captives/6"/>
        <tei:lg>
          <tei:l>וַחֲמוֹל נָא עַל שְׁבִי עַמְּךָ וְעַל הַמַּלְקוֹחַ</tei:l>
          <tei:l>וֶאֱמוֹר לַאֲסִירִים פְּקַח קוֹחַ</tei:l>
          <tei:l>וְהָשֵׁב לְבִצָּרוֹן אֲסִירֵי הַתִּקְוָה</tei:l>
          <tei:l>בְּעֵדוֹתֶיךָ נֶאֶמְנוּ מְאֹד לְבֵיתְךָ נָאוָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_piyyut_and_mi_sheberakh_for_captives/7"/>
        <tei:lg>
          <tei:l>וּבְתוֹכָם וּבִכְלָלָם</tei:l>
          <tei:l>תּוֹצִיא וְתַתִּיר תְּמַלֵּט וּתְפַלֵּט</tei:l>
          <tei:l>פלוני עִם כׇּל אֲסִירֵי עַמְּךָ בֵּית יִשְׂרָאֵל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_piyyut_and_mi_sheberakh_for_captives/8"/>
        <tei:lg>
          <tei:l>הָאֵל אַב הָרַחֲמָן</tei:l>
          <tei:l>אֵל מֶלֶךְ נֶאֱמָן</tei:l>
          <tei:l>הוֹצִיאֵם מִמַּסְגֵּרָם</tei:l>
          <tei:l>וְהַתִּירֵם מִמַּאֲסָרָם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_piyyut_and_mi_sheberakh_for_captives/9"/>
        <tei:lg>
          <tei:l>וּפַלְּטֵם וּמַלְּטֵם מִכָּל צָרָה וְצוּקָה וָצַעַר</tei:l>
          <tei:l>יַחַד אֲנָשִׁים וְנָשִׁים טַף זָקֵן וָנַעַר</tei:l>
          <tei:l>כִּי אַתָּה צוּרָם גּוֹאֲלָם וּפוֹדָם</tei:l>
          <tei:l>יוֹדוּ לַייָ חַסְדּוֹ וְנִפְלְאוֹתָיו לִבְנֵי אָדָם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_piyyut_and_mi_sheberakh_for_captives/10"/>
        <tei:lg>
          <tei:l>וְקַיֵּים בּוֹ וּבָהֶם מִקְרָאֵי דִכְתִיבֵי</tei:l>
          <tei:l>כִּי שׁוֹמֵעַ אֶל אֶבְיוֹנִים יְיָ</tei:l>
          <tei:l>וְאֶת אֲסִירָיו לֹא בָזָה׃ <tei:bibl>(תהלים סט:לד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_piyyut_and_mi_sheberakh_for_captives/11"/>
        <tei:lg>
          <tei:l>וְעוֹד כְּתִיב</tei:l>
          <tei:l>גּוֹל אֶל יְיָ</tei:l>
          <tei:l>יְפַלְּטֵהוּ</tei:l>
          <tei:l>יַצִּילֵהוּ</tei:l>
          <tei:l>כִּי חָפֵץ בּוֹ׃ <tei:bibl>(תהלים כב:ט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_piyyut_and_mi_sheberakh_for_captives/12"/>
        <tei:lg>
          <tei:l>וְעוֹד כְּתִיב</tei:l>
          <tei:l>תָּבֹא לְפָנֶיךָ אֶנְקַת אָסִיר</tei:l>
          <tei:l>כְּגוֹדֶל זְרוֹעֲךָ</tei:l>
          <tei:l>הוֹתֵר בְּנֵי תְמוּתָה׃ <tei:bibl>(תהלים עט:יא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_piyyut_and_mi_sheberakh_for_captives/13"/>
        <tei:lg>
          <tei:l>וְעוֹד כְּתִיב</tei:l>
          <tei:l>לֵאמֹר לַאֲסוּרִים צֵאוּ</tei:l>
          <tei:l>לַאֲשֶׁר בַּחֹשֶׁךְ הִגָּלוּ</tei:l>
          <tei:l>עַל דְּרָכִים יִרְעוּ</tei:l>
          <tei:l>וּבְכָל שְׁפָיִים מַרְעִיתָם׃ <tei:bibl>(ישעיה מט:ט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_piyyut_and_mi_sheberakh_for_captives/14"/>
        <tei:lg>
          <tei:l>וְעוֹד כְּתִיב</tei:l>
          <tei:l>לְהוֹצִיא מִמַּסְגֵּר אַסִּיר</tei:l>
          <tei:l>מִבֵּית כֶּלֶא יוֹשְׁבֵי חֹשֶׁךְ׃ <tei:bibl>(ישעיה מב:ז חלק)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_piyyut_and_mi_sheberakh_for_captives/15"/>
        <tei:lg>
          <tei:l>וְעוֹד כְּתִיב</tei:l>
          <tei:l>יוֹשְׁבֵי חֹשֶךְ וְצַלְמָוֶת</tei:l>
          <tei:l>אֲסִירֵי עֳונִי וּבַרְזֶל׃ <tei:bibl>(תהלים קז:י)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_piyyut_and_mi_sheberakh_for_captives/16"/>
        <tei:lg>
          <tei:l>וְעוֹד כְּתִיב</tei:l>
          <tei:l>וַיִּצְעֲקוּ אֶל יְיָ בַּצַּר לָהֶם</tei:l>
          <tei:l>וּמִמְּצוּקוֹתֵיהֶם יוֹצִיאֵם׃ <tei:bibl>(תהלים קז:כח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_piyyut_and_mi_sheberakh_for_captives/17"/>
        <tei:lg>
          <tei:l>וְעוֹד כְּתִיב</tei:l>
          <tei:l>יוֹצִיאֵם מֵחֹשֶׁךְ וְצַלְמָוֶת</tei:l>
          <tei:l>וּמוֹסְרוֹתֵיהֶם יְנַתֵּק׃ <tei:bibl>(תהלים קז:יד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_piyyut_and_mi_sheberakh_for_captives/18"/>
        <tei:lg>
          <tei:l>וְעוֹד כְּתִיב</tei:l>
          <tei:l>כִּי שִׁבַּר דַּלְתוֹת נְחוֹשֶׁת</tei:l>
          <tei:l>וּבְרִיחֵי בַרְזֶל גִּדֵּעַ׃ <tei:bibl>(תהלים קז:טז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_piyyut_and_mi_sheberakh_for_captives/19"/>
        <tei:lg>
          <tei:l>וְעוֹד כְּתִיב</tei:l>
          <tei:l>יוֹדוּ לַייָ חַסְדּוֹ</tei:l>
          <tei:l>וְנִפְלְאוֹתָיו לִבְנֵי אָדָם׃ <tei:bibl>(תהלים קז:טו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_piyyut_and_mi_sheberakh_for_captives/20"/>
        <tei:lg>
          <tei:l>וְעוֹד כְּתִיב</tei:l>
          <tei:l>לְמַעַן יְחַלְּצוּן יְדִידֶיךָ</tei:l>
          <tei:l>הוֹשִׁיעָה יְמִינְךָ וַעֲנֵינוּ׃ <tei:bibl>(תהלים ס:ז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_piyyut_and_mi_sheberakh_for_captives/21"/>
        <tei:lg>
          <tei:l>מִי שֶׁבֵּרַךְ אַבְרָהָם יִצְחָק וְיַעֲקֹב</tei:l>
          <tei:l>וְכׇל חֲסִידֵי עוֹלָם</tei:l>
          <tei:l>מִי שֶׁעָנָה לְיוֹסֵף בְּבֵית הָאֲסוּרִים</tei:l>
          <tei:l>וְעָנָה לְיוֹנָה בִּמְעֵי הַדָּגָה</tei:l>
          <tei:l>וְהוֹצִיא חֲנַנְיָה מִישָׁאֵל וַעֲזַרְיָה מִתּוֹךְ כִּבְשַׁן הָאֵשׁ</tei:l>
          <tei:l>וְדָנִיּאֵל מִגּוֹב הָאֲרָיוֹת</tei:l>
          <tei:l>הוּא יוֹצִיא וְיַתִּיר פלוני</tei:l>
          <tei:l>עִם כָּל אֲסִירֵי עַמּוֹ יִשְׂרָאֵל</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
