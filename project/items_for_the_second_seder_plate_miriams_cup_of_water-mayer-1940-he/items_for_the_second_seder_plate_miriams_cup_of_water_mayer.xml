    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:items_for_the_second_seder_plate_miriams_cup_of_water_mayer">
        <tei:head>כּוֹס לְמִרְיָם</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:items_for_the_second_seder_plate_miriams_cup_of_water_mayer/3"/>
        <tei:lg>
          <tei:l>רַבִּי יוֹסִי בֶּן־רַבִּי יְהוּדָה אוֹמֵר: ”שְׁלֹשָׁה פַּרְנַסִים טוֹבִים עָמְדוּ לְיִשְׂרָאֵל. אֵלּוּ הֵן: מֹשֶׁה, וְאַהֲרֹן, וּמִרְיָם. וְשָׁלוֹשׁ מַּתָּנוֹת טוֹבוֹת נִיתְּנוּ עַל יָדָם, וְאֵלּוּ הֵן: בְּאֵר, וְעָנָן, וּמָן. בּאֵר בִּזְכוּת מִרְיָם... מֵתָה מִריָם נִסְתַּלֵּק הַבּאֵר, שֶׁנֶאֶמַר וַתָּ֤מׇת שָׁם֙ מִרְיָ֔ם וּכְתִיב בַּתְרֵיהּ וְלֹא־הָ֥יָה מַ֖יִם לָעֵדָ֑ה.“</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:items_for_the_second_seder_plate_miriams_cup_of_water_mayer/5"/>
        <tei:lg>
          <tei:l>זֹאת כּוֹס מִרְיָם הַנְּבִיאָה.</tei:l>
          <tei:l>זְכוּרָה לְטוֹבָה!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:items_for_the_second_seder_plate_miriams_cup_of_water_mayer/6"/>
        <tei:lg>
          <tei:l>מִרְיָם הַנְּבִיאָה</tei:l>
          <tei:l>אַז תָּשִׁיר כִּי גָאֹה גָּאָה</tei:l>
          <tei:l>בִּזְכוּתָהּ שָׁאַבְנוּ מַיִם</tei:l>
          <tei:l>מִמַּעַיְנֵי הַיְשׁוּעָה</tei:l>
          <tei:l>כְּשֶׁהָיָה בַּיּוֹם הָהוּא</tei:l>
          <tei:l>תְּחוֹלֵל עִמָּנוּ</tei:l>
          <tei:l>וּתְבַשֵּׂר לָנוּ גְאֻלָּה</tei:l>
          <tei:l>חֲדָשָׁה וּשְׁלֵמָה</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
