    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:qohelet_lo_tsadaq_mazor">
        <tei:head>קֹהֶלֶת לֹא צָדַק</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:qohelet_lo_tsadaq_mazor/1"/>
        <tei:lg>
          <tei:l>קֹהֶלֶת לֹא צָדַק</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:qohelet_lo_tsadaq_mazor/2"/>
        <tei:lg>
          <tei:l>בְּיָמִים בָּהֶם כָּל הָעִתִּים קוֹרְסוֹת אַחַת אֶל תּוֹךְ רְעוּתָהּ,</tei:l>
          <tei:l>וְאֵין בְּרֵרָה אֶלָּא לִבְכּוֹת וְלִשְׂחוֹק בְּאוֹתָן עֵינַיִם,</tei:l>
          <tei:l>לִסְפֹּד וְלִרְקוֹד גַּם יַחַד,</tei:l>
          <tei:l>וְהִיסְטוֹרְיָה אֲרֻכָּה נִדְחֶסֶת אֶל יוֹם וְשָׁעָה אַחַת,</tei:l>
          <tei:l>נְבַקֵּשׁ אֶת הַכּוֹחַ לְהָכִיל</tei:l>
          <tei:l>אֶת עָצְמַת הַלְּבָבוֹת הַמִּתְפַּקְּעִים.</tei:l>
          <tei:l>לִשְׂמֹחַ עִם הַזּוֹכִים לַחֲבֹק כְּבָר הַיּוֹם,</tei:l>
          <tei:l>לַעֲטֹף אֶת הַמִּתְכַּנְּסִים בִּכְמִיהָתָם וְנַפְשָׁם נִרְעֶדֶת,</tei:l>
          <tei:l>לֶאֱחֹז בַּתִּקְוָה בְּלִי לְהַרְפּוֹת,</tei:l>
          <tei:l>וּלְהוֹתִיר מֶרְחָב שֶׁל שֶׁקֶט לַזְּעָקָה שֶׁאֵין לָהּ קוֹל.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:qohelet_lo_tsadaq_mazor/3"/>
        <tei:lg>
          <tei:l>אָנָּא, תֵּן לָנוּ מָקוֹם לְהִשָּׁבֵר בּוֹ לִרְסִיסִים,</tei:l>
          <tei:l>וְרוּחַ לְהִבָּנוֹת שׁוּב, מֵחָדָשׁ.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
