  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:for_understanding_henriques">
        <tei:head>[Prayer] for understanding, by Basil Lucas Quixano Henriques (1916)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:for_understanding_henriques/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">For understanding.</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:for_understanding_henriques/2"/>
        <tei:lg>
          <tei:l>Lord of the Universe,</tei:l>
          <tei:l>I know not what Thou art,</tei:l>
          <tei:l>and yet I feel Thy presence</tei:l>
          <tei:l>to be before me at all times.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:for_understanding_henriques/3"/>
        <tei:lg>
          <tei:l>Thou hast no eyes,</tei:l>
          <tei:l>and yet I know no act</tei:l>
          <tei:l>nor thought of mine</tei:l>
          <tei:l>is hidden from Thy sight;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:for_understanding_henriques/4"/>
        <tei:lg>
          <tei:l>Thou hast no hands,</tei:l>
          <tei:l>and yet when I am faint and weak,</tei:l>
          <tei:l>I feel Thy love upholding me;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:for_understanding_henriques/5"/>
        <tei:lg>
          <tei:l>Thou hast no ears,</tei:l>
          <tei:l>and yet when I call unto Thee,</tei:l>
          <tei:l>I know that Thou art listening;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:for_understanding_henriques/6"/>
        <tei:lg>
          <tei:l>Thou hast no voice,</tei:l>
          <tei:l>and yet when I pray unto Thee</tei:l>
          <tei:l>I hear Thy answer in my heart;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:for_understanding_henriques/7"/>
        <tei:lg>
          <tei:l>Thou hast no form,</tei:l>
          <tei:l>and yet, O King</tei:l>
          <tei:l>I see thee ever before me.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:for_understanding_henriques/8"/>
        <tei:lg>
          <tei:l>All that is beautiful and pure art Thou,</tei:l>
          <tei:l>all that is tender and merciful,</tei:l>
          <tei:l>all that is righteous and good.</tei:l>
          <tei:l>For Thou art love.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:for_understanding_henriques/9"/>
        <tei:lg>
          <tei:l>O Father in Heaven,</tei:l>
          <tei:l>help me to understand Thee better</tei:l>
          <tei:l>and open my heart to Thy holiness.</tei:l>
          <tei:l><tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
