  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:elohai_neshamah">
        <tei:head>אֱלֹהַי נְשָׁמָה</tei:head>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>אֱלֹהַי, נְשָׁמָה שֶׁנָּתַֽתָּ בִּי טְהוֹרָה הִיא,</tei:l>
          <tei:l>אַתָּה בְרָאתָהּ, אַתָּה יְצַרְתָּהּ,</tei:l>
          <tei:l>אַתָּה נְפַחְתָּהּ בִּי,</tei:l>
          <tei:l>וְאַתָּה מְשַׁמְּרָהּ בְּקִרְבִּי,</tei:l>
          <tei:l>וְאַתָּה עָתִיד לִטְּלָהּ מִמֶּנִּי,</tei:l>
          <tei:l>וּלְהַחֲזִירָהּ בִּי לֶעָתִיד לָבֹא.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>כָּל זְמַן שֶׁהַנְּשָׁמָה בְּקִרְבִּי</tei:l>
          <tei:l>מוֹדֶה אֲנִי לְפָנֶיךָ יְיָ אֱלֹהַי וֵאלֹהֵי אֲבוֹתַי,</tei:l>
          <tei:l>רִבּוֹן כָּל הַמַּעֲשִׂים,</tei:l>
          <tei:l>אֲדוֹן כָּל הַנְּשָׁמוֹת.</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>הַמַּחֲזִיר נְשָׁמוֹת לִפְגָרִים מֵתִים:</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
