  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:atsitu_li_ilinaya">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:atsitu_li_ilinaya/1"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">אַ</tei:seg>צִיתוּ לִי אִילָנַיָּא וְכׇל־שְׁתִילַיָּא</tei:l>
          <tei:l>דִּשְׁתִילוּ מִן־יוֹמָא דִּבְרֵאשִׁית</tei:l>
          <tei:l>דְּבַׄר הַמְדָתָא בַּעֵי לְמֵסַק</tei:l>
          <tei:l>לְאַכְסַדְרָא דְּבַר פַּנְדֵירָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:atsitu_li_ilinaya/2"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">גּ</tei:seg>וּפְנָה אֲמָרָא קוּצְרָא אֲנָא יִצְטְלֵב בְּרֵישִׁי</tei:l>
          <tei:l>דְּמִנִּי נִסְבִּין חַמְרָא בְּנִיסוּכִין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:atsitu_li_ilinaya/3"/>
        <tei:lg xml:lang="he">
          <tei:l>אֲ<tei:seg type="acrostic">דָ</tei:seg>רָא אֲמָרָא יִצְטְלֵב בְּרֵישִׁי וְלָא יְכִילְנָא</tei:l>
          <tei:l>[דְּמִן־כְּשׁוֹרַי אִתְעֲבִידָא תֵּיבוֹתָא]</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:atsitu_li_ilinaya/4"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">חִ</tei:seg>ילָא אֲנָא אֲמָר תְּאֵינְתָּא</tei:l>
          <tei:l>יִצְטְלֵב בְּרֵישִׁי וְלָא יְכִילְנָא</tei:l>
          <tei:l>דְּמִנִּי נִסְבִּין לְבִיכּוּרַיָּא</tei:l>
          <tei:l><tei:seg type="acrostic">וּ</tei:seg>מִנִּי לְבֵישׁ אָדָם וְחַוָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:atsitu_li_ilinaya/5"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">זֵ</tei:seg>יתָא אֲמָרָה יִֹצְטְלֵב בְּרֵישִׁי וְלָא יְכִילְנָא</tei:l>
          <tei:l>דְּמִנִּי נִסְבִּין מִישְׁחָא לִמְנָרְתָּא</tei:l>
          <tei:l><tei:seg type="acrostic">חֲ</tei:seg>כִּים רָזַיָּא בְּרַא יָתִי</tei:l>
          <tei:l>לְמִפְרַע שְׁטָרֵיהּ דְּעוֹבַדְיָה נְבִיאָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:atsitu_li_ilinaya/6"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">טָ</tei:seg>ב חֲרִינָא דְּיִצְטְלֵב בְּרֵישֵׁיהּ</tei:l>
          <tei:l>אֲמָר דִּיקְלָא קֳדָם נְטוֹרֵיהּ</tei:l>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>דְעִין כׇּל־בְּנֵי בִּיסְרָא</tei:l>
          <tei:l>דְּהוּא הָמָן רְשִׁיעָא בַּר בְּרֵיהּ דַּאֲגַג עֲמָלֵקָאָה</tei:l>
          <tei:l><tei:seg type="acrostic">כׇּ</tei:seg>ל־מַלְכַיָּא יוֹדוּן קֳדָמָךְ</tei:l>
          <tei:l>דְּאַתְּ הוּא אֱלָהָא וְלֵית בַּר־מִינָּךְ</tei:l>
          <tei:l><tei:seg type="acrostic">לָ</tei:seg>ךְ יָאֵי לְמִפְרוֹק בָּנַיָּא</tei:l>
          <tei:l>כְּמָא דִּפְרַקְתָּא יָת אַבָהָתְהוֹן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:atsitu_li_ilinaya/7"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">מֵ</tei:seg>יתִיב קוּדְשָׁא וַאֲמָר לֵיהּ</tei:l>
          <tei:l>יִישַׁר חֵילָךְ כׇּל־מָה דַּאֲמָרְתָּ</tei:l>
          <tei:l><tei:seg type="acrostic">נְ</tei:seg>סֵיבִיתָךְ בְּעֵצָה דְּיִצְטְלֵב בְּרֵישָׁךְ</tei:l>
          <tei:l>דְּאַתְּ זוֹגָא לִכְנִישׁ דְּצִיּוֹן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:atsitu_li_ilinaya/8"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">סְ</tei:seg>בֵירִית אֲמָרָת אֶתְרוֹגָא דְּיִצְטְלֵב בְּרֵישִׁי וְלָא יְכִילְנָא</tei:l>
          <tei:l>[בְּדִיל דַּאֲנָא אַבָּא דַּהֲדָרָא דְּחַגָּא]</tei:l>
          <tei:l>דְּעָׄלַי אֲתָא כׇּל־עַלְמָא כֻּלְּהוֹן</tei:l>
          <tei:l>לְמֵיסַב מִן־אִיבַּי לְשַׁבָּחָא קֳדָמָךְ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:atsitu_li_ilinaya/9"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>תַח אָסָא פּוּמֵיהּ וַאֲמָר יִצְטְלֵב בְּרֵישִׁי וְלָא יְכִילְנָא</tei:l>
          <tei:l>הָא אֲנָא שׁוּתָּף עִם־אֶתְרוֹגָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:atsitu_li_ilinaya/10"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">צְ</tei:seg>וַח בְּלוּטָא וַאֲמָר יִצְטְלֵב בְּרֵישִׁי וְלָא יְכִילְנָא</tei:l>
          <tei:l>דְּבוֹרָה מֵנִיקָה דְּרִבְקָה קְבוּרָה תְּחוֹתוֹי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:atsitu_li_ilinaya/11"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">קְ</tei:seg>רָא בּוּטְמָא וַאֲמָר יִצְטְלֵב בְּרֵישִׁי וְלָא יְכִילְנָא</tei:l>
          <tei:l>דְּאַבְשָׁלוֹם בְּרֵיהּ דְּדָוִד אִיתְּלַי בְּרֵישִׁי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:atsitu_li_ilinaya/12"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">ר</tei:seg>וּמָּנָא אֲמָר יִצְטְלֵב בְּרֵישִׁי וְלָא יְכִילְנָא</tei:l>
          <tei:l>דְּצַדִּיקַיָּא מְּתִילִין לׇקֳבְּלִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:atsitu_li_ilinaya/13"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">שְׁ</tei:seg>מַעוּ מִנִּי אֲמַר אַרְזָא</tei:l>
          <tei:l>צְלִיבוּ יָתֵיהּ לְהָמָן רְשִׁיעָה</tei:l>
          <tei:l>וּלְעַסְרָה בָּנוֹי עַלֵי צְלִיבָא</tei:l>
          <tei:l>דְּאַ<tei:seg type="acrostic">תְ</tei:seg>קִין יָתֵיהּ לְנַפְשֵׁיהּ</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
