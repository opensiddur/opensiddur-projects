  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:piyyutim_to_introduce_the_first_aliyot_of_each_book_mayer">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:piyyutim_to_introduce_the_first_aliyot_of_each_book_mayer/2"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן לְאֵל עֶלְיוֹן</tei:l>
          <tei:l>צֶמַח עוֹלָם, אֶחָד, רִאשׁוֹן</tei:l>
          <tei:l>חַזֵּקְנוּ נָא, בַּזְּמַן הַבָּא,</tei:l>
          <tei:l>קוֹרְאִים אֶת „בְּרֵאשִׁית בָּרָא”</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:piyyutim_to_introduce_the_first_aliyot_of_each_book_mayer/3"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן לְאֵל עֶלְיוֹן</tei:l>
          <tei:l>עֲנֵנוּ כִּי עַמְּךָ אֶבְיוֹן</tei:l>
          <tei:l>קָרָאנוּ אֶת „בְּרֵאשִׁית בָּרָא”</tei:l>
          <tei:l>בְּרָא נָא אֶת הָעוֹלָם הַבָּא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:piyyutim_to_introduce_the_first_aliyot_of_each_book_mayer/5"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן לְאֵל עֶלְיוֹן</tei:l>
          <tei:l>צֹהַר עוֹלָם, אֶחָד, רִאשׁוֹן</tei:l>
          <tei:l>חַזֵּקְנוּ נָא, בִּזְכוּת אָבוֹת,</tei:l>
          <tei:l>קוֹרְאִים אֶת „וְאֵלֶּה שְׁמוֹת”</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:piyyutim_to_introduce_the_first_aliyot_of_each_book_mayer/6"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן לְאֵל עֶלְיוֹן</tei:l>
          <tei:l>עֲנֵנוּ כִּי עַמְּךָ אֶבְיוֹן</tei:l>
          <tei:l>קָרָאנוּ אֶת „וְאֵלֶּה שְׁמוֹת”</tei:l>
          <tei:l>בְּקַע נָא אֶת כָּל גָּלֻיּוֹת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:piyyutim_to_introduce_the_first_aliyot_of_each_book_mayer/8"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן לְאֵל עֶלְיוֹן</tei:l>
          <tei:l>צִדְקַת עוֹלָם, אֶחָד, רִאשׁוֹן</tei:l>
          <tei:l>חַזֵּקְנוּ נָא, מִתּוֹךְ הַסְּנֶה,</tei:l>
          <tei:l>קוֹרְאִים אֶת „וַיִּקְרָא אֶל מֹשֶׁה”</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:piyyutim_to_introduce_the_first_aliyot_of_each_book_mayer/9"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן לְאֵל עֶלְיוֹן</tei:l>
          <tei:l>עֲנֵנוּ כִּי עַמְּךָ אֶבְיוֹן</tei:l>
          <tei:l>קָרָאנוּ אֶת „וַיִּקְרָא אֶל מֹשֶׁה”</tei:l>
          <tei:l>בְּנֵה נָא אֶת יהוה יִרְאֶה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:piyyutim_to_introduce_the_first_aliyot_of_each_book_mayer/11"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן לְאֵל עֶלְיוֹן</tei:l>
          <tei:l>צוֹפֶה עוֹלָם, אֶחָד, רִאשׁוֹן</tei:l>
          <tei:l>חַזֵּקְנו נָא, יָהּ אֲדֹנָי,</tei:l>
          <tei:l>קוֹרְאִים אֶת „בְּמִדְבַּר סִינַי”</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:piyyutim_to_introduce_the_first_aliyot_of_each_book_mayer/12"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן לְאֵל עֶלְיוֹן</tei:l>
          <tei:l>עֲנֵנוּ כִּי עַמְּךָ אֶבְיוֹן</tei:l>
          <tei:l>קָרָאנוּ אֶת „בְּמִדְבַּר סִינַי”</tei:l>
          <tei:l>בַּטֵּל נָא אֶת כָּל חַטֹּאתַי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:piyyutim_to_introduce_the_first_aliyot_of_each_book_mayer/14"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן לְאֵל עֶלְיוֹן</tei:l>
          <tei:l>צוּר עוֹלָם, אֶחָד, רִאשׁוֹן</tei:l>
          <tei:l>חַזֵּקְנוּ נָא, הָאֱלֹהִים,</tei:l>
          <tei:l>קוֹרְאִים אֶת „אֵלֶּה הַדְּבָרִים”</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:piyyutim_to_introduce_the_first_aliyot_of_each_book_mayer/15"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן לְאֵל עֶלְיוֹן</tei:l>
          <tei:l>עֲנֵנוּ כִּי עַמְּךָ אֶבְיוֹן</tei:l>
          <tei:l>קָרָאנוּ אֶת „אֵלֶּה הַדְּבָרִים”</tei:l>
          <tei:l>בָּרְכֵנוּ נָא בְּרֹב יָמִים</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
