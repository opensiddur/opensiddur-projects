    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_the_holy_roman_emperor_and_empress">
        <tei:head>ברכה לאדונינו הקיסר ירה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_holy_roman_emperor_and_empress/1"/>
        <tei:lg>
          <tei:l>הָאֱלֹהִים</tei:l>
          <tei:l>אֲשֶׁר בָרָא אֶת הַשָׁמַיִם וְאֶת הָאָרֶץ וְכׇל צְבָאָם</tei:l>
          <tei:l>וַאֲשֶׁר בֵרַךְ אֶת אֲבוֹתֵינוּ</tei:l>
          <tei:l>אַבְרָהַם יִצְחָק וְיַעֲקֹב</tei:l>
          <tei:l>מֹשֶה וְאַהֲרֹן</tei:l>
          <tei:l>דָוִד וּשְׁלֹמֹה</tei:l>
          <tei:l>וְכׇל הַמְבוּרָכִים</tei:l>
          <tei:l>הוּא יְבָרֵךְ אֲדוֹנֵנוּ הַמְיוּחָס מְאֹד</tei:l>
          <tei:l>הַקֵיסֵר רוֹמִי הַמְהוּלָל לעפלטוס</tei:l>
          <tei:l>אוֹתוֹ וְאֶת אִשְׁתוֹ מַרגרֶעטה</tei:l>
          <tei:l>וְאֶת כׇל אֲשֶׁר לָהֶם</tei:l>
          <tei:l>יָרוּם הוֹדוֹ וְקַרְנוֹ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_holy_roman_emperor_and_empress/2"/>
        <tei:lg>
          <tei:l>יִגְדַל כִסֵא מַלְכוּתוֹ יָרוּם מְאֹד</tei:l>
          <tei:l>וְנִשָׂא וְּגָבַה מְאֹד</tei:l>
          <tei:l>וִיְחַיֵיהוּ וְיִשְׁמְרֵהוּ</tei:l>
          <tei:l>מִכׇל צָרָה וְצוּקָה</tei:l>
          <tei:l>וְיַדְבֵר עַמִים תַחְתָיו</tei:l>
          <tei:l>וְיִפְלוּ שׂוֹנְאָיו תָחַת כַפוֹת רַגְלָיו</tei:l>
          <tei:l>וּבְכֹל אֲשֶׁר יִפְנֶה יַצְלִיחַ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_holy_roman_emperor_and_empress/3"/>
        <tei:lg>
          <tei:l>וְיִתֵן לוֹ אֱלֹהִים לֵב חָכָם וְנָבוֹן</tei:l>
          <tei:l>לַעֲשׂוֹת מִשְׁפָט וּצְדָקָה</tei:l>
          <tei:l>חֶסֶד וְרַחֲמִים</tei:l>
          <tei:l>וְלִהֲיוֹת טוֹב וּמֵטִיב לַכֹּל</tei:l>
          <tei:l>וִיְחַיֵיהוּ בִבְרִיאַת גוּף וּנְשָׁמָה</tei:l>
          <tei:l>לְאֹרֶךְ יָמִים טוֹבִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_holy_roman_emperor_and_empress/4"/>
        <tei:lg>
          <tei:l>וְיַשְׂכִיל וִיַצְלִיחַ בְכׇל דְרָכָיו</tei:l>
          <tei:l>וּבְכׇל מִלְחֲמוֹתָיו</tei:l>
          <tei:l>הוּא וְזַרְעוֹ וְזֶרַע זַרְעוֹ</tei:l>
          <tei:l>וְכׇל יוֹעֲצֵיהֶם</tei:l>
          <tei:l>וְכׇל שָׂרֵי צִבְאוֹתֵיהֶם</tei:l>
          <tei:l>וְכׇל חֲיָילֵיהֶם</tei:l>
          <tei:l>כׇל אֶחָד וְאֶחָד בִשְׁמוֹ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_holy_roman_emperor_and_empress/5"/>
        <tei:lg>
          <tei:l>וּבְיָמָיו וּבְיָמֵינוּ</tei:l>
          <tei:l>תִוָשַׁע יְהוּדָה</tei:l>
          <tei:l>וְיִשְׂרָאֵל יִשְׁכוֹן לָבֶטַח</tei:l>
          <tei:l>וּבָא לְצִיוֹן גוֹאֵל</tei:l>
          <tei:l>וְכֵן יִהִי רָצוֹן</tei:l>
          <tei:l>וְנֹאמַר אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
