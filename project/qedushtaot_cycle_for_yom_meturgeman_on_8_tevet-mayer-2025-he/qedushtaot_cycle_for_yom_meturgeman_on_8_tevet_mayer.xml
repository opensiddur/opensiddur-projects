    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer">
        <tei:head>מחזור קדושתאות ליום המתורגמן (ח׳ בטבת)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/1"/>
        <tei:lg>
          <tei:l>מגן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/2"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְהֹוָה אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ</tei:l>
          <tei:l>אֱלֹהֵי אַבְרָהָם</tei:l>
          <tei:l>אֱלֹהֵי יִצְחָק</tei:l>
          <tei:l>וֵאלֹהֵי יַעֲקֹב</tei:l>
          <tei:l>הָאֵל הַגָּדוֹל הַגִּבּוֹר וְהַנּוֹרָא</tei:l>
          <tei:l>אֵל עֶלְיוֹן</tei:l>
          <tei:l>גּוֹמֵל חֲסָדִים טוֹבִים</tei:l>
          <tei:l>וְקוֹנֵה הַכֹּל</tei:l>
          <tei:l>וְזוֹכֵר חַסְדֵי אָבוֹת</tei:l>
          <tei:l>וּמֵבִיא גוֹאֵל לִבְנֵי בְנֵיהֶם</tei:l>
          <tei:l>לְמַֽעַן שְׁמוֹ בְּאַהֲבָה</tei:l>
          <tei:l>מֶֽלֶךְ עוֹזֵר</tei:l>
          <tei:l>וּמוֹשִֽׁיעַ וּמָגֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/3"/>
        <tei:lg>
          <tei:l>אֻׄמִּים שִׁבְעִים כִּלְשׁוֹנָם</tei:l>
          <tei:l>בָּׄבֶֽלָה קִבְּלוּם בִּגְלַל עֲווֹנָם</tei:l>
          <tei:l>גָּׄמַֽלְתָּ לְאַב גּוֹיִם בַּהֲמוֹנָם</tei:l>
          <tei:l>דִּׄבּוּר קֹֽדֶשׁ לְשׇׁמְרוֹ כְּאִישׁוֹנָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/4"/>
        <tei:lg>
          <tei:l>הִׄנֵּֽנוּ בָּנָיו לְבוּשֵׁי גְּדִיל כָּחֹל</tei:l>
          <tei:l>וְׄהִבְדַּֽלְנוּ בֵּין־שְׂפַת קֹֽדֶשׁ לְחֹל</tei:l>
          <tei:l>זִׄמְרָתֵֽנוּ בִּלְשׁוֹנְךָ בְּתֹף וּמָחוֹל</tei:l>
          <tei:l>חָׄמַֽלְתְּ עָלָיו וְהִרְבִּיתָֽנוּ כַּחוֹל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/5"/>
        <tei:lg>
          <tei:l>טְׄמֵאוֹת הָאֲרָצוֹת שֶׁשָּֽׁמָּה גָּלִֽינוּ</tei:l>
          <tei:l>יְׄהוּדִים הֻכְרַחְנוּ לְשַׁנּוֹת אֶת־פִּֽנּוּ</tei:l>
          <tei:l>כִּׄלְשׁוֹן עַם וְעַם וּמִלּוֹתָיו הָגִֽינוּ</tei:l>
          <tei:l>לָׄכֵן הִמְשַֽׁלְנוּ אִישׁ מְתֻרְגְּמָן כִּנִּֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/6"/>
        <tei:lg>
          <tei:l>כַּכָּתוּב —</tei:l>
          <tei:l>עַל־כֵּ֞ן קָרָ֤א שְׁמָהּ֙ בָּבֶ֔ל</tei:l>
          <tei:l>כִּי־שָׁ֛ם בָּלַ֥ל יְהוָ֖ה שְׂפַ֣ת כָּל־הָאָ֑רֶץ</tei:l>
          <tei:l>וּמִשָּׁם֙ הֱפִיצָ֣ם יְהוָ֔ה עַל־פְּנֵ֖י כָּל־הָאָֽרֶץ׃ <tei:bibl>(בראשית יא:ט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/7"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>וְלֹא־יִקָּרֵ֥א ע֛וֹד אֶת־שִׁמְךָ֖ אַבְרָ֑ם</tei:l>
          <tei:l>וְהָיָ֤ה שִׁמְךָ֙ אַבְרָהָ֔ם</tei:l>
          <tei:l>כִּ֛י אַב־הֲמ֥וֹן גּוֹיִ֖ם נְתַתִּֽיךָ׃ <tei:bibl>(בראשית יז:ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/8"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>כִּֽי־בָרֵ֣ךְ אֲבָרֶכְךָ֗ וְהַרְבָּ֨ה אַרְבֶּ֤ה אֶֽת־זַרְעֲךָ֙</tei:l>
          <tei:l>כְּכוֹכְבֵ֣י הַשָּׁמַ֔יִם וְכַח֕וֹל אֲשֶׁ֖ר עַל־שְׂפַ֣ת הַיָּ֑ם</tei:l>
          <tei:l>וְיִרַ֣שׁ זַרְעֲךָ֔ אֵ֖ת שַׁ֥עַר אֹיְבָֽיו׃ <tei:bibl>(בראשית כב:יז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/9"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>וְאֶת־עַמִּ֣י יוֹר֔וּ בֵּ֥ין קֹ֖דֶשׁ לְחֹ֑ל</tei:l>
          <tei:l>וּבֵין־טָמֵ֥א לְטָה֖וֹר יוֹדִעֻֽם׃ <tei:bibl>(יחזקאל מד:כג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/10"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>הַֽ֭לְלוּהוּ בְתֹ֣ף וּמָח֑וֹל</tei:l>
          <tei:l>הַֽ֝לְל֗וּהוּ בְּמִנִּ֥ים וְעוּגָֽב׃ <tei:bibl>(תהלים קנ:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/11"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>אֵ֗יךְ נָשִׁ֥יר אֶת־שִׁיר־יְהוָ֑ה עַ֝֗ל אַדְמַ֥ת נֵכָֽר׃ <tei:bibl>(תהלים קלז:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/12"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>וַיִּשְׁלַ֤ח סְפָרִים֙ אֶל־כָּל־מְדִינ֣וֹת הַמֶּ֔לֶךְ</tei:l>
          <tei:l>אֶל־מְדִינָ֤ה וּמְדִינָה֙ כִּכְתָבָ֔הּ</tei:l>
          <tei:l>וְאֶל־עַ֥ם וָעָ֖ם כִּלְשׁוֹנ֑וֹ</tei:l>
          <tei:l>לִהְי֤וֹת כָּל־אִישׁ֙ שֹׂרֵ֣ר בְּבֵית֔וֹ וּמְדַבֵּ֖ר כִּלְשׁ֥וֹן עַמּֽוֹ׃ <tei:bibl>(אסתר א:כב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/13"/>
        <tei:lg>
          <tei:l>כִּלְשׁ֥וֹן עַמּֽוֹ הַמְּתֻרְגְּמָן מְפָרֵשׁ</tei:l>
          <tei:l>פֶּן־מֵחׇכְמָתָךְ עַם־זוּ יִתְחָרֵשׁ</tei:l>
          <tei:l>גּוֹנְנֵֽנוּ יוֹצֵר כׇּל־בִּנְיָן וָשֹֽׁרֶשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/14"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה מָגֵן אַבְרָהָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/15"/>
        <tei:lg>
          <tei:l>מחייה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/16"/>
        <tei:lg>
          <tei:l>אַתָּה גִּבּוֹר לְעוֹלָם אֲדֹנָי</tei:l>
          <tei:l>מְחַיֵּה מֵתִים אַתָּה רַב לְהוֹשִֽׁיעַ</tei:l>
          <tei:l>מָשִּׁיב הָרֽוּחַ וּמוֹרִיד הַגֶּֽשֶׁם</tei:l>
          <tei:l>מְכַלְכֵּל חַיִּים בְּחֶֽסֶד</tei:l>
          <tei:l>מְחַיֵּה מֵתִים בְּרַחֲמִים רַבִּים</tei:l>
          <tei:l>סוֹמֵךְ נוֹפְלִים</tei:l>
          <tei:l>וְרוֹפֵא חוֹלִים</tei:l>
          <tei:l>וּמַתִּיר אֲסוּרִים</tei:l>
          <tei:l>וּמְקַיֵּם אֱמוּנָתוֹ לִישֵׁנֵי עָפָר</tei:l>
          <tei:l>מִי כָמֽוֹךָ בַֽעַל גְּבוּרוֹת</tei:l>
          <tei:l>וּמִי דוֹמֶה לָּךְ</tei:l>
          <tei:l>מֶֽלֶךְ מֵמִית וּמְחַיֶּה</tei:l>
          <tei:l>וּמַצְמִֽיחַ יְשׁוּעָה</tei:l>
          <tei:l>וְנֶאֱמָן אַתָּה לְהַחֲיוֹת מֵתִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/17"/>
        <tei:lg>
          <tei:l>מַׄלְאָכִי נִקְרָא סוֹפֵר הַתּוֹרָה</tei:l>
          <tei:l>נָׄתָן־לָהּ כְּתָב וְלָשׁוֹן לְהוֹצִיא לְאוֹרָה</tei:l>
          <tei:l>סׄוֹפֵר רָאוּי לוּלֵא כְּבָר קָרָה</tei:l>
          <tei:l>עֶׄזְרָא כָהֲנָא וְסָפְרָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/18"/>
        <tei:lg>
          <tei:l>פַּׄרְשֶֽׁגֶן הַנִּשְׁתְּוָן נִיתַּן בְּיָדוֹ</tei:l>
          <tei:l>צַׄו אֶת־עַמָּךְ לְפָרֵשׁ אֶת־הוֹדוֹ</tei:l>
          <tei:l>קָׄרָא הוּא עִם־הַתִּרְשָׁתָא מִסֵּֽפֶר כְּבוֹדוֹ</tei:l>
          <tei:l>רָׄאָה כׇּל־הָעָם וַיִּשְׂמַח עַל־עׇמְדוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/19"/>
        <tei:lg>
          <tei:l>שָׁׄרְתֵי הַדְּבִיר בְּעֵת קוֹל קְרָא</tei:l>
          <tei:l>שׂוֹם שֶֽׂכֶל וַיָּבִֽינוּ בַּמִּקְרָא</tei:l>
          <tei:l>תִּׄרְגְּמוּ אֶת־מִצְוָתָךְ הַבָּרָה</tei:l>
          <tei:l>תַּרְגּוּם קָבֽוּעַ עַד־תֹּם הַשִּׁירָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/20"/>
        <tei:lg>
          <tei:l>כַּכָּתוּב —</tei:l>
          <tei:l>וַיְדַבֵּ֣ר מֹשֶׁ֗ה בְּאָזְנֵי֙ כָּל־קְהַ֣ל יִשְׂרָאֵ֔ל</tei:l>
          <tei:l>אֶת־דִּבְרֵ֥י הַשִּׁירָ֖ה הַזֹּ֑את עַ֖ד תֻּמָּֽם׃ <tei:bibl>(דברים לא:ל)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/21"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>מַשָּׂ֥א דְבַר־יְהֹוָ֖ה אֶל־יִשְׂרָאֵ֑ל בְּיַ֖ד מַלְאָכִֽי׃ <tei:bibl>(מלאכי א:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/22"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>וְזֶ֣ה ׀ פַּרְשֶׁ֣גֶן הַֽנִּשְׁתְּוָ֗ן אֲשֶׁ֤ר נָתַן֙ הַמֶּ֣לֶךְ אַרְתַּחְשַׁ֔סְתְּא לְעֶזְרָ֥א הַכֹּהֵ֖ן הַסֹּפֵ֑ר</tei:l>
          <tei:l>סֹפֵ֞ר דִּבְרֵ֧י מִצְוֺת־יְהֹוָ֛ה וְחֻקָּ֖יו עַל־יִשְׂרָאֵֽל׃ <tei:bibl>(עזרא ז:יא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/23"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>וַֽיִּקְרְא֥וּ בַסֵּ֛פֶר בְּתוֹרַ֥ת הָאֱלֹהִ֖ים מְפֹרָ֑שׁ</tei:l>
          <tei:l>וְשׂ֣וֹם שֶׂ֔כֶל וַיָּבִ֖ינוּ בַּמִּקְרָֽא׃ <tei:bibl>(נחמיה ח:ח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/24"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>וַיֹּ֣אמֶר נְחֶמְיָ֣ה ה֣וּא הַתִּרְשָׁ֡תָא וְעֶזְרָ֣א הַכֹּהֵ֣ן ׀ הַסֹּפֵ֡ר וְהַלְוִיִּם֩ הַמְּבִינִ֨ים אֶת־הָעָ֜ם לְכָל־הָעָ֗ם</tei:l>
          <tei:l>הַיּ֤וֹם קָדֹֽשׁ־הוּא֙ לַיהוָ֣ה אֱלֹהֵיכֶ֔ם</tei:l>
          <tei:l>אַל־תִּֽתְאַבְּל֖וּ וְאַל־תִּבְכּ֑וּ</tei:l>
          <tei:l>כִּ֤י בוֹכִים֙ כָּל־הָעָ֔ם כְּשָׁמְעָ֖ם אֶת־דִּבְרֵ֥י הַתּוֹרָֽה׃ <tei:bibl>(נחמיה ח:ט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/25"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>וַיֵּלְכ֨וּ כָל־הָעָ֜ם לֶאֱכֹ֤ל וְלִשְׁתּוֹת֙ וּלְשַׁלַּ֣ח מָנ֔וֹת וְלַעֲשׂ֖וֹת שִׂמְחָ֣ה גְדוֹלָ֑ה</tei:l>
          <tei:l>כִּ֤י הֵבִ֙ינוּ֙ בַּדְּבָרִ֔ים אֲשֶׁ֥ר הוֹדִ֖יעוּ לָהֶֽם׃ <tei:bibl>(נחמיה ח:יב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/26"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>פִּקּ֘וּדֵ֤י יְהֹוָ֣ה יְ֭שָׁרִים מְשַׂמְּחֵי־לֵ֑ב</tei:l>
          <tei:l>מִצְוַ֥ת יְהֹוָ֥ה בָּ֝רָ֗ה מְאִירַ֥ת עֵינָֽיִם׃ <tei:bibl>(תהלים יט:י)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/27"/>
        <tei:lg>
          <tei:l>עֵינָֽיִם הַמְּתֻרְגְּמָן פּוֹקֵֽחַ</tei:l>
          <tei:l>כַּטַּל אִמְרָתָךְ לֶֽקַח טוֹב לוֹקֵחַ</tei:l>
          <tei:l>הַחֲיֵֽנוּ הַמַּמְטִיר וְרוֹפֵא וְרוֹקֵֽחַ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/28"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה מְחַיֵּה הַמֵּתִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/29"/>
        <tei:lg>
          <tei:l>משלש</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/30"/>
        <tei:lg>
          <tei:l>יָוָן קָם וְהַדֹּב נִכְבַּשׁ</tei:l>
          <tei:l>צַדִּיק קִבְּלוֹ בַּכְּהֻנָּה נִלְבַּשׁ</tei:l>
          <tei:l>חָלָה וָמֵת וְנֶחֱנַט בִּדְבַשׁ</tei:l>
          <tei:l>קָמָה מַלְכוּת תַּלְמַי וַתְגֻבַּשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/31"/>
        <tei:lg>
          <tei:l>הׄוּא אָמַר קָנִֽיתִי־לִי אוֹצָר כׇּל־חׇכְמָה</tei:l>
          <tei:l>רַעֲיוֹנוֹת הַפְּלוֹסוֹפִין מִכׇּל־הָאֲדָמָה</tei:l>
          <tei:l>אֲבָל אֵין בְּיָדִי סִפְרֵי רֻחָמָה</tei:l>
          <tei:l>לְאַרְמוֹנִי הֲבִיאוּם וְאֵדְעָה לָמָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/32"/>
        <tei:lg>
          <tei:l>הֵׄבִֽיאוּ לוֹ שִׁבְעִים זִקְנֵי יִשְׂרָאֵל</tei:l>
          <tei:l>כְּׄדֵי לְתַרְגֵּם אֶת־סִפְרֵי הָאֵל</tei:l>
          <tei:l>הֵׄן אִישׁ לְחַדְרוֹ זֶה לָזֶה אֵין שׁוֹאֵל</tei:l>
          <tei:l>נִׄפְלָא עָשָׂה לָהֶם וְלָֽנוּ הַגּוֹאֵל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/33"/>
        <tei:lg>
          <tei:l>כַּכָּתוּב —</tei:l>
          <tei:l>וְעַתָּ֕ה אֱמֶ֖ת אַגִּ֣יד לָ֑ךְ</tei:l>
          <tei:l>הִנֵּה־עוֹד֩ שְׁלֹשָׁ֨ה מְלָכִ֜ים עֹמְדִ֣ים לְפָרַ֗ס</tei:l>
          <tei:l>וְהָֽרְבִיעִי֙ יַעֲשִׁ֤יר עֹֽשֶׁר־גָּדוֹל֙ מִכֹּ֔ל</tei:l>
          <tei:l>וּכְחֶזְקָת֣וֹ בְעׇשְׁר֔וֹ יָעִ֣יר הַכֹּ֔ל אֵ֖ת מַלְכ֥וּת יָוָֽן׃ <tei:bibl>(דניאל יא:ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/34"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>וְעָמַ֖ד מֶ֣לֶךְ גִּבּ֑וֹר וּמָשַׁל֙ מִמְשָׁ֣ל רַ֔ב וְעָשָׂ֖ה כִּרְצוֹנֽוֹ׃ <tei:bibl>(דניאל יא:ג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/35"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>וָאֶתְּנָ֤ה לִבִּי֙ לָדַ֣עַת חָכְמָ֔ה וְדַ֥עַת הוֹלֵל֖וֹת</tei:l>
          <tei:l>וְשִׂכְל֑וּת יָדַ֕עְתִּי שֶׁגַּם־זֶ֥ה ה֖וּא רַעְי֥וֹן רֽוּחַ׃ <tei:bibl>(קוהלת א:יז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/36"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>אִמְר֥וּ לַאֲחֵיכֶ֖ם עַמִּ֑י</tei:l>
          <tei:l>וְלַאֲחֽוֹתֵיכֶ֖ם רֻחָֽמָה׃ <tei:bibl>(הושע ב:ג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/37"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>וְֽ֭הַחׇכְמָה מֵאַ֣יִן תִּמָּצֵ֑א</tei:l>
          <tei:l>וְאֵ֥י זֶ֝֗ה מְק֣וֹם בִּינָֽה׃ <tei:bibl>(איוב כח:יב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/38"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>וַיֹּ֤אמֶר ׀ לָאָדָ֗ם</tei:l>
          <tei:l>הֵ֤ן יִרְאַ֣ת אֲ֭דֹנָי הִ֣יא חׇכְמָ֑ה</tei:l>
          <tei:l>וְס֖וּר מֵרָ֣ע בִּינָֽה׃ <tei:bibl>(איוב כח:כח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/39"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>מִזְמ֡וֹר שִׁ֤ירוּ לַֽיהוָ֨ה ׀ שִׁ֣יר חָ֭דָשׁ כִּֽי־נִפְלָא֣וֹת עָשָׂ֑ה</tei:l>
          <tei:l>הוֹשִֽׁיעָה־לּ֥וֹ יְ֝מִינ֗וֹ וּזְר֥וֹעַ קָדְשֽׁוֹ׃ <tei:bibl>(תהלים צח:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/40"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר —</tei:l>
          <tei:l>יִמְלֹ֤ךְ יְהוָ֨ה ׀ לְעוֹלָ֗ם</tei:l>
          <tei:l>אֱלֹהַ֣יִךְ צִ֭יּוֹן לְדֹ֥ר וָדֹ֗ר</tei:l>
          <tei:l>הַֽלְלוּ־יָֽהּ׃ <tei:bibl>(תהלים קמו:י)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/41"/>
        <tei:lg>
          <tei:l>וְאַתָּ֥ה קָד֑וֹשׁ י֝וֹשֵׁ֗ב תְּהִלּ֥וֹת יִשְׂרָאֵֽל׃ <tei:bibl>(תהלים כב:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/42"/>
        <tei:lg>
          <tei:l>אל־נא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/43"/>
        <tei:lg>
          <tei:l>אֵל נָא!</tei:l>
          <tei:l>יְׄצִׄירוֹת עֶֽשֶׂר יָצַֽרְתָּ</tei:l>
          <tei:l>בִּלְשׁוֹנָךְ</tei:l>
          <tei:l>חֻׄקֶּֽׄיךָ וּמִשְׁפָּטֶיךָ נֶהֱגֶה</tei:l>
          <tei:l>בִּלְשׁוֹנֵֽנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/44"/>
        <tei:lg>
          <tei:l>הָׄרִׄים וּגְבָעוֹת הֲרִימֽוֹתָ</tei:l>
          <tei:l>בִּלְשׁוֹנָךְ</tei:l>
          <tei:l>אֱׄלֹׄהֵי הָאֱלֹהִים נְבָרְכָךְ</tei:l>
          <tei:l>בִּלְשׁוֹנֵֽׄנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/45"/>
        <tei:lg>
          <tei:l>בִּׄנְׄיַן עוֹלָם בָּנִֽיתָ</tei:l>
          <tei:l>בִּלְשׁוֹנָךְ</tei:l>
          <tei:l>אַׄבִּֽׄיעָה חִידוֹת וּנְהַלְלָךְ</tei:l>
          <tei:l>בִּלְשׁוֹנֵֽנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/46"/>
        <tei:lg>
          <tei:l>רָׄהִׄיטֵי הַמִּקְדָּשׁ הֲקִימֽוֹתָ</tei:l>
          <tei:l>בִּלְשׁוֹנָךְ</tei:l>
          <tei:l>מַׄהֲׄרוּ עַמִּי וּנְשַׁבֵּֽחַ</tei:l>
          <tei:l>בִּלְשׁוֹנֵֽנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/47"/>
        <tei:lg>
          <tei:l>כֹּׄהׄ אָמַר רָם וְנִשָּׂא</tei:l>
          <tei:l>בִּלְשׁוֹנָךְ</tei:l>
          <tei:l>נֹֽׄחַׄ קִבֵּל שֶׁנּוֹדֶה־לָךְ</tei:l>
          <tei:l>בִּלְשׁוֹנֵֽנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/48"/>
        <tei:lg>
          <tei:l>זִׄקְׄנֵי הָעָם הֶחְכַּֽמְתָּ</tei:l>
          <tei:l>בִּלְשׁוֹנָךְ</tei:l>
          <tei:l>אִׄםׄ נׄוֹאֲמִים נְסַפֵּר תְּהִלָּתָךְ</tei:l>
          <tei:l>בִּלְשׁוֹנֵֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/49"/>
        <tei:lg>
          <tei:l>חי וקים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/50"/>
        <tei:lg>
          <tei:l>חַיּ וְקַיָּם נוֹרָא וּמָרוֹם וְקָדוֹשׁ׃</tei:l>
