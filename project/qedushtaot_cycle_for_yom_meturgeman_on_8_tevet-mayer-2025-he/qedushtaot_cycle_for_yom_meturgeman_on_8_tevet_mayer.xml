          <tei:l>עַד בְּנֵי יַעֲקֹב שֶׁבִּשְׁבִילוֹ הׇפְכִי אֲגַם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/102"/>
        <tei:lg>
          <tei:l>עֵֽׄגֶל שֵׁנִי יְהֵא אָדָם זָהִיר</tei:l>
          <tei:l>כִּי אַהֲרֹן טָעָה לִקְרֹא פָּז מָהִיר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/103"/>
        <tei:lg>
          <tei:l>בִּׄרְכַּת כֹּהֲנִים כִּי יִשָּׂא פְּנֵי אֵל אֶחָד</tei:l>
          <tei:l>הוּא לֹא־יִשָּׂא פָנִים וְלֹא־יִקַּח שֹֽׁחַד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/104"/>
        <tei:lg>
          <tei:l>דָּׄוִד וְאַמְנׄוֹן לֹא אֲבָל מָה עַל־תָּמָר</tei:l>
          <tei:l>אַל־תִּרְגְּמוּ אִם־אַמְנוֹן בֶּן־דָּוִד תַּלְמוּד לוֹמַר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/105"/>
        <tei:lg>
          <tei:l>קִרְאוּ בָּהּ לְשֶׁבַח כׇּל־כָּתוּב בָּהּ לִגְנַאי</tei:l>
          <tei:l>לִכְבוֹד הַתּוֹרָה אֲשֶׁר נָתַן יְהֹוָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/106"/>
        <tei:lg>
          <tei:l>שַׁׄנְּנוּ גּׄוֹמְלִים לִׄלְמֹד וְלִקְרֹא יִשְׁכָּבֶֽנָּה</tei:l>
          <tei:l>עֵׄינַֽיִם פֹּׄה לׄוֹמְדוֹת כִּי טְחוֹרִים תִּרְאֶֽינָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/107"/>
        <tei:lg>
          <tei:l>חָׄטָא רֹׄאשְׁךָ מִיָּׄד כִּי לֹא אָמַרְתָּ צוֹאָה</tei:l>
          <tei:l>שַׁׄי בְּיַׄד נִׄין כִּי מִמֵּי רֶֽגֶל הַתְּבוּאָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/108"/>
        <tei:lg>
          <tei:l>בּֽוֹאוּ נִרְאוּ כִּי קָשֶׁה הוּא הֶעָמֵל</tei:l>
          <tei:l>שֶׁהַמְּתֻרְגְּמָן נוֹדֵב כִּי הוּא לַצִּבּוּר חוֹמֵל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/109"/>
        <tei:lg>
          <tei:l>וְלֹא־לְדַבֵּר עַל בַּֽעַל הַקְּרִיאָה</tei:l>
          <tei:l>שֶׁצָּרִיךְ לַהֲגוֹת בַּמִּלֵּי יִרְאָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/110"/>
        <tei:lg>
          <tei:l>כׇּל־זֶה וְזֶה וְהֵם בְּנֵי אָדָם</tei:l>
          <tei:l>לֹא מַֽלְאֲכֵי־אֵשׁ אֶֽלָּא בָּשָׂר וָדָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/111"/>
        <tei:lg>
          <tei:l>כׇּל־הַזְּמַן הַמַּלְאָכִים וְשַׂרְפֵי הַקֹּֽדֶשׁ</tei:l>
          <tei:l>וּכְרוּבִים וְחַיּוֹת מִרְכֶּֽבֶת הַקֹּֽדֶשׁ</tei:l>
          <tei:l>שֶׁאֵין מַפְטִירִין בְּמַעֲשָׂהּ כִּי־הוּא קֹֽדֶשׁ</tei:l>
          <tei:l>אֲבָל יֵשׁ מַפְטִירִין בּוֹ בְּחַג עֲצֶֽרֶת הַקֹּֽדֶשׁ</tei:l>
          <tei:l>וּמְשָׁרְתִים וְאֶרְאֶלִּים וְכׇל־בְּרִיאוֹת הַקֹּֽדֶשׁ</tei:l>
          <tei:l>קוֹרְאִים זֶה לָזֶה בְּשָׁלוֹשׁ קְדֻשּׁוֹת בַּקֹּֽדֶשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qedushtaot_cycle_for_yom_meturgeman_on_8_tevet_mayer/112"/>
        <tei:lg>
          <tei:l>כַּכָּתוּב עַל־יַד נְבִיאֶךָ...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
