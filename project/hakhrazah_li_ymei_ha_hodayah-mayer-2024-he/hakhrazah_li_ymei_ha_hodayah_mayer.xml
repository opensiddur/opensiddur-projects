    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hakhrazah_li_ymei_ha_hodayah_mayer">
        <tei:head>הכרזה לימי הודיה (פורים וחנוכה)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hakhrazah_li_ymei_ha_hodayah_mayer/1"/>
        <tei:lg>
          <tei:l>אַחֵֽינוּ כׇּל־בֵּית יִשְׂרָאֵל וְכָל־הַנִּלְוִים עָלֵֽינוּ שְׁמָֽעוּ!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hakhrazah_li_ymei_ha_hodayah_mayer/2"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">בשבת זכור</tei:note>
          </tei:l>
          <tei:l>בְּיוֹם <tei:note type="instruction">פלוני</tei:note></tei:l>
          <tei:l>וּבְעָרֵי פְּרָזוֹת בְּיוֹם <tei:note type="instruction">פלוני</tei:note></tei:l>
          <tei:l>יוֹמֵי פּוּרַֽיָּא אִינּוּן</tei:l>
          <tei:l>דְּלָא לְמִסְפַּד בְּהוֹן וּדְלָא לְהִתְעַנּוֹת בְּהוֹן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hakhrazah_li_ymei_ha_hodayah_mayer/3"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">בשבת שלפני חנוכה</tei:note>
          </tei:l>
          <tei:l>מִיּוֹם <tei:note type="instruction">פלוני</tei:note></tei:l>
          <tei:l>עַד־יוֹם <tei:note type="instruction">פלוני</tei:note> בַּשָּׁבוּעַ הַבָּא</tei:l>
          <tei:l>יוֹמֵי דַחֲנוּכָּה תְּמָנְיָא אִינּוּן</tei:l>
          <tei:l>דְּלָא לְמִסְפַּד בְּהוֹן וּדְלָא לְהִתְעַנּוֹת בְּהוֹן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hakhrazah_li_ymei_ha_hodayah_mayer/4"/>
        <tei:lg>
          <tei:l>וּכְנִסֵּי פְּלָאֶֽיךָ וְרֹב יְשׁוּעוֹתֶֽיךָ שֶׁעָשִֽׂיתָ עִם־אֲבוֹתֵֽינוּ</tei:l>
          <tei:l>כֵּן עֲשֵׂה עִמָּֽנוּ יְהֹוָה אֱלֹהֵֽינוּ פֶּֽלֶא וְנִסִּים</tei:l>
          <tei:l>וְתוֹשִׁיעֵֽנוּ מִיַּד שׂוֹנְאֵֽינוּ בַּיָּמִים הָאֵֽלֶּה כְּבַיָּמִים הַהֵם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hakhrazah_li_ymei_ha_hodayah_mayer/5"/>
        <tei:lg>
          <tei:l>כַּכָּתוּב בְּדִבְרֵי תּוֹרָתֶֽךָ —</tei:l>
          <tei:l>וַיֹּ֗אמֶר הִנֵּ֣ה אָנֹכִי֮ כֹּרֵ֣ת בְּרִית֒</tei:l>
          <tei:l>נֶ֤גֶד כָּֽל־עַמְּךָ֙ אֶעֱשֶׂ֣ה נִפְלָאֹ֔ת</tei:l>
          <tei:l>אֲשֶׁ֛ר לֹֽא־נִבְרְא֥וּ בְכָל־הָאָ֖רֶץ וּבְכָל־הַגּוֹיִ֑ם</tei:l>
          <tei:l>וְרָאָ֣ה כָל־הָ֠עָם אֲשֶׁר־אַתָּ֨ה בְקִרְבּ֜וֹ אֶת־מַעֲשֵׂ֤ה יְהוָה֙</tei:l>
          <tei:l>כִּֽי־נוֹרָ֣א ה֔וּא אֲשֶׁ֥ר אֲנִ֖י עֹשֶׂ֥ה עִמָּֽךְ׃ <tei:bibl>(שמות לד:י)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hakhrazah_li_ymei_ha_hodayah_mayer/6"/>
        <tei:lg>
          <tei:l>וּבְשִׁירֵי עַבְדְּךָ מְשִׁיחֲךָ כָּתוּב לֵאמֹר —</tei:l>
          <tei:l>אַתָּ֣ה הָ֭אֵל עֹ֣שֵׂה פֶ֑לֶא</tei:l>
          <tei:l>הוֹדַ֖עְתָּ בָעַמִּ֣ים עֻזֶּֽךָ׃ <tei:bibl>(תהלים עז:טו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hakhrazah_li_ymei_ha_hodayah_mayer/7"/>
        <tei:lg>
          <tei:l>וּבִנְבוּאוֹת נְבִיאֵי קׇדְשְׁךָ כָּתוּב לֵאמֹר —</tei:l>
          <tei:l>כִּימֵ֥י צֵאתְךָ֖ מֵאֶ֣רֶץ מִצְרָ֑יִם</tei:l>
          <tei:l>אַרְאֶ֖נּוּ נִפְלָאֽוֹת׃ <tei:bibl>(מיכה ז:טו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hakhrazah_li_ymei_ha_hodayah_mayer/8"/>
        <tei:lg>
          <tei:l>וְכֵן יְהִי רָצוֹן</tei:l>
          <tei:l>וְנֹאמַר אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
