      <tei:div corresp="urn:x-opensiddur:text:prayer:preview/parallel">
        <tei:head>כּוֹתֶרֶת רִאשׁוֹנָה</tei:head>
        <tei:milestone unit="chapter" n="1"/>
        <tei:milestone unit="parsha" n="דֻּגְמָה"/>
        <tei:milestone unit="aliyah" n="1"/>
        <tei:milestone unit="citation" n="דוגמה א:א"/>
        <tei:milestone unit="verse" n="1"/>
        <tei:p xml:id="parallel_paragraph">אָ֖ב, בֵּ֣ן, שָׁל֑וֹם; (סֵפֶר) [דֻּגְמָה]. <tei:hi rend="bold">הַדְגָּשָׁה</tei:hi><tei:hi rend="italic">וְאוֹת נְטוּיָה.</tei:hi><tei:note type="instruction">הוֹרָאָה לְדֻגְמָה.</tei:note><tei:note type="editorial">הֶעָרָה מַעֲרַכְתִּית.</tei:note></tei:p>
        <tei:milestone unit="verse" n="2"/>
        <tei:p>דֻּגְמָה לִקְרִיאָה: <tei:choice><tei:abbr>דוג׳</tei:abbr><tei:expan>דֻּגְמָה</tei:expan></tei:choice><tei:choice><tei:sic>דוגמהה</tei:sic><tei:corr>דוגמה</tei:corr></tei:choice><tei:ref target="#preview_bibliography">מָקוֹר בָּדוּי</tei:ref></tei:p>
        <tei:div>
          <tei:head>כּוֹתֶרֶת שְׁנִיָּה</tei:head>
          <tei:p>מִשְׁפָּט קָצָר לְדֻגְמָה.</tei:p>
          <tei:list type="ordered">
            <tei:label xml:lang="en">1.</tei:label>
            <tei:item>
              <tei:p>פְּרִיט 1</tei:p>
            </tei:item>
            <tei:label xml:lang="en">2.</tei:label>
            <tei:item>
