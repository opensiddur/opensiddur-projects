        <tei:milestone unit="verse" n="1"/>
        <tei:p xml:id="parallel_paragraph">גּוּף הַטֶּקְסְט גּוּף הַטֶּקְסְט גּוּף הַטֶּקְסְט <tei:hi rend="italic">הַדְגָּשָׁה נְטוּיָה</tei:hi> גּוּף הַטֶּקְסְט <tei:hi rend="bold">הַדְגָּשָׁה עָבָה</tei:hi> גּוּף הַטֶּקְסְט <tei:hi rend="small-caps">הַדְגָּשָׁה בְּאוֹתִיּוֹת קְטַנּוֹת</tei:hi> גּוּף הַטֶּקְסְט<tei:hi rend="sup">הַדְגָּשָׁה עִלִּית</tei:hi> גּוּף הַטֶּקְסְט <tei:hi rend="large">הַדְגָּשָׁה גְּדוֹלָה</tei:hi> גּוּף הַטֶּקְסְט <tei:hi rend="small">הַדְגָּשָׁה קְטַנָּה</tei:hi> גּוּף הַטֶּקְסְט גּוּף הַטֶּקְסְט גּוּף הַטֶּקְסְט<tei:note type="instruction">הוֹרָאָה</tei:note><tei:note type="editorial">הֶעָרָה</tei:note></tei:p>
        <tei:milestone unit="verse" n="2"/>
        <tei:p>גּוּף הַטֶּקְסְט <tei:choice><tei:abbr>קִצּוּר</tei:abbr><tei:expan>פֵּרוּשׁ הַקִּצּוּר</tei:expan></tei:choice> גּוּף הַטֶּקְסְט <tei:choice><tei:sic>טָעוּת דְּפוּס</tei:sic><tei:corr>תִּקּוּן</tei:corr></tei:choice> גּוּף הַטֶּקְסְט <tei:choice><j:read>קְרִי</j:read><j:written>כְּתִיב</j:written></tei:choice> גּוּף הַטֶּקְסְט <tei:choice><j:option>גּוּף הַטֶּקְסְט</j:option><j:option>נֻסָּח חֲלוּפִי</j:option></tei:choice> גּוּף הַטֶּקְסְט <tei:foreign xml:lang="en">foreign</tei:foreign> גּוּף הַטֶּקְסְט <tei:ref target="#preview_bibliography">הַפְנָיָה</tei:ref> גּוּף הַטֶּקְסְט</tei:p>
