  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hallel_blessing">
        <tei:head>Hallel blessing (trans. Rabbi Max Grunwald, 1907)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hallel_blessing/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">Prayed on Pesach, Shavuot, and Sukkot, on new moon days and on Hanukkah.</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hallel_blessing/2"/>
        <tei:lg>
          <tei:l>Praise and thanks be to you,</tei:l>
          <tei:l>O <j:divineName>God</j:divineName>!</tei:l>
          <tei:l>For our sanctification</tei:l>
          <tei:l>you have given us your commandments,</tei:l>
          <tei:l>for our elevation and perfection,</tei:l>
          <tei:l>you want us to know and glorify you</tei:l>
          <tei:l>in your greatness and grace.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
