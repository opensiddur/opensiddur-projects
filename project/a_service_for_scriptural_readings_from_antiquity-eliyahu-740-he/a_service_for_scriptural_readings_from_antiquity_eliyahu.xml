          <tei:l>וְהַגּוֹאֲלֵנוּ וְהַמּוֹשִׁיעֶנּוּ מִכַּף כׇּל־עָרִיצִים׃</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְהוָה</tei:l>
          <tei:l>הָאֵל הָעוֹזֵר וּמוֹשִׁיעַ׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְהוָה</tei:l>
          <tei:l>הָאֵל הַנְּקָמוֹת</tei:l>
          <tei:l>הַמְּשַׁלֵּם גְּמוּל לָאוֹיְבִים</tei:l>
          <tei:l>וּמָגֵן לַצַּדִּיקִים</tei:l>
          <tei:l>וּמוֹשִׁיעַ עַמּוֹ מִיַּד שׂוֹנְאֵיהֶם׃</tei:l>
          <tei:l>בָּרוּךְ מׇרְדֳּכַי בְּרוּכָה אֶסְתֵּר בְּרוּכִים כׇּל־יִשְׂרָאֵל׃</tei:l>
          <tei:l>אָרוּר הָמָן וַאֲרוּרִים כׇּל־בָּנָיו׃</tei:l>
          <tei:l>חַרְבוֹנָה זָכוּר לַטּוֹב׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_service_for_scriptural_readings_from_antiquity_eliyahu/30"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ואחר קריאת מגילת איכה הוא מוסיף ואומר —</tei:note>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בָּרוּךְ דַּיַּן הָאֱמֶת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_service_for_scriptural_readings_from_antiquity_eliyahu/31"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">הקורא בכתובים אּחרים אומר —</tei:note>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְהוָה אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם</tei:l>
          <tei:l>אֲשֶׁר קִדְּשָׁנוּ בְּמִצְוֹתָיו</tei:l>
          <tei:l>וְצִוָּנוּ לִקְרוֹת בְּכִתְבֵי הַקֹּדֶשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_service_for_scriptural_readings_from_antiquity_eliyahu/32"/>
        <tei:lg>
          <tei:l>פרשיות המקרא שונות</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">(פרשיות שהן זהויות בתלמוד בבלי ובמסכת סופרים לא רשומות כאן)</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_service_for_scriptural_readings_from_antiquity_eliyahu/33"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ביום ראש השנה קוראים ויקרא כג:כג-לב</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_service_for_scriptural_readings_from_antiquity_eliyahu/34"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ביום תשעה באב קוראים בתוכחות של ויקרא כו:ג-מו</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_service_for_scriptural_readings_from_antiquity_eliyahu/35"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">בליל שביעי מהתחלתה עד פסוק שְׁת֥וּ וְשִׁכְר֖וּ דּוֹדִֽים, ובליל שמיני מפסוק אֲנִ֥י יְשֵׁנָ֖ה וְלִבִּ֣י עֵ֑ר עד סופה׃</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_service_for_scriptural_readings_from_antiquity_eliyahu/36"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">מגילת רות קורא במוצאי ימים טובים של שבועות של גלות. מוצאי יום אחד מהתחלתה עד פסוק וַתֵּ֖שֶׁב אֶת־חֲמוֹתָֽהּ, ומוצאי יום שני מפסוק וַתֹּ֥אמֶר לָ֖הּ נָעֳמִ֣י חֲמוֹתָ֑הּ עד סופה׃</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_service_for_scriptural_readings_from_antiquity_eliyahu/37"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">מגילת קהלת קורא לילי שמיני עצרת של גלות, בליל אחד מהתחלתה עד פסוק מַה־יִּהְיֶ֥ה אַחֲרָ֖יו תַּ֥חַת הַשָּֽׁמֶשׁ, ובליל שני מפסוק ט֥וֹב שֵׁ֖ם מִשֶּׁ֣מֶן ט֑וֹב עד סופה׃</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_service_for_scriptural_readings_from_antiquity_eliyahu/38"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">חוץ מעצם יום פורים, גם בשבת ראשונה של אדר קורא מגילת אסתר מהתחלתה עד הפסוק וַיַּ֥עַשׂ הָעֵֽץ, ובשבת זכור, שבת שנית של אדר קורא מהפסוק בַּלַּ֣יְלָה הַה֔וּא עד סופה׃</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_service_for_scriptural_readings_from_antiquity_eliyahu/39"/>
        <tei:lg>
          <tei:l>מזמורי ימים טובים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_service_for_scriptural_readings_from_antiquity_eliyahu/40"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">בחנוכה קורא מזמור ל׳</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_service_for_scriptural_readings_from_antiquity_eliyahu/41"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">בפורים קורא מזמור ז׳ או מזמור פג</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_service_for_scriptural_readings_from_antiquity_eliyahu/42"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ביום ראשון וחול המועד של פסח קורא מזמור קלה</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_service_for_scriptural_readings_from_antiquity_eliyahu/43"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">בימים אחרונים של פסח קורא מזמור קלו</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_service_for_scriptural_readings_from_antiquity_eliyahu/44"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">בשבועות קורא מזמור כט</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_service_for_scriptural_readings_from_antiquity_eliyahu/45"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">בתשעה בעב קורא ירמיהו יד יט־כב ואחר כך קורא מזמור עט ומזמור קלז</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_service_for_scriptural_readings_from_antiquity_eliyahu/46"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">בראש השנה קורא מזמור מז</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_service_for_scriptural_readings_from_antiquity_eliyahu/47"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ביום הכפורים קורא מזמור קג ומזמור קל</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_service_for_scriptural_readings_from_antiquity_eliyahu/48"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">בסוכות קורא מזמור עו</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_service_for_scriptural_readings_from_antiquity_eliyahu/49"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">בשמיני עצרת קורא מזמור ו׳</tei:note>
          </tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
