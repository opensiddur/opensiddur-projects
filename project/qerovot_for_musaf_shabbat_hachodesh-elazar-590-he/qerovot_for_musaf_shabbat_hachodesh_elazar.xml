        <tei:lg>
          <tei:l>אַתָּה יָצַֽרְתָּ עוֹלָמְךָ מִקֶּֽדֶם</tei:l>
          <tei:l>כִּלִּֽיתָ מְלַאכְתְּךָ בַּיּוֹם הַשְּׁבִיעִי</tei:l>
          <tei:l>אָהַֽבְתָּ אוֹתָֽנוּ וְרָצִֽיתָ בָּנוּ</tei:l>
          <tei:l>וְרוֹמַמְתָּֽנוּ מִכׇּל־הַלְּשׁוֹנוֹת</tei:l>
          <tei:l>וְקִדַּשְׁתָּֽנוּ בְּמִצְווֹתֶֽיךָ</tei:l>
          <tei:l>וְקֵרַבְתָּֽנוּ מַלְכֵּֽנוּ לַעֲבוֹדָתֶֽךָ</tei:l>
          <tei:l>וְשִׁמְךָ הַגָּדוֹל וְהַקָּדוֹשׁ</tei:l>
          <tei:l>עָלֵֽינוּ קָרָֽאתָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qerovot_for_musaf_shabbat_hachodesh_elazar/24"/>
        <tei:lg>
          <tei:l>וַתִּתֶּן לָנוּ יהוה אֱלֹהֵֽינוּ</tei:l>
          <tei:l>בְּאַהֲבָה שַׁבָּתוֹת לִמְנוּחָה</tei:l>
          <tei:l>וְרָאשֵׁי חֳדָשִׁים לְכַפָּרָה</tei:l>
          <tei:l>וּלְפִי שֶׁחָטָֽאנוּ לְפָנֶֽיךָ אֲנַֽחְנוּ וַאֲבוֹתֵֽינוּ</tei:l>
          <tei:l>חׇרְבָה עִירֵֽנוּ</tei:l>
          <tei:l>וְשָׁמֵם בֵּית מִקְדָּשֵֽׁנוּ</tei:l>
          <tei:l>וְגָלָה יְקָרֵֽנוּ</tei:l>
          <tei:l>וְנֻטַּל כָּבוֹד מִבֵּית חַיֵּֽינוּ</tei:l>
          <tei:l>וְאֵין אֲנַֽחְנוּ יְכוֹלִים לַעֲשׂוֹת חוֹבוֹתֵֽינוּ בְּבֵית בְּחִירָתֶֽךָ</tei:l>
          <tei:l>בַּבַּֽיִת הַגָּדוֹל וְהַקָּדוֹשׁ שֶׁנִּקְרָא שִׁמְךָ עָלָיו</tei:l>
          <tei:l>מִפְּנֵי הַיָּד שֶׁנִּשְׁתַּלְּחָה בְמִקְדָּשֶֽׁךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:qerovot_for_musaf_shabbat_hachodesh_elazar/25"/>
