    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yedidekha_el_yelidei_ish_tam_tsur">
        <tei:head>יְדִידֶֽיךָ אַל יְלִידֵי אִישׁ תָּם</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yedidekha_el_yelidei_ish_tam_tsur/1"/>
        <tei:lg>
          <tei:l>יְדִידֶֽיךָ אַל יְלִידֵי אִישׁ תָּם</tei:l>
          <tei:l>בְּבוֹא עֲלֵיהֶם יָוָן בִּזְדוֹנָם</tei:l>
          <tei:l>עָמַדְתָּ לָהֶם בְּעֵת צָרָתָם</tei:l>
          <tei:l>רַבְתָּ אֶת־רִיבָם דַּנְתָּ אֶת־דִּינָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yedidekha_el_yelidei_ish_tam_tsur/2"/>
        <tei:lg>
          <tei:l>מוֹנִים גַּם שׂוֹטְנִים עָלַי נֶאֱסָֽפוּ</tei:l>
          <tei:l>כִּזְאֵבִים טוֹרְפִים אוֹתִי רָדָֽפוּ</tei:l>
          <tei:l>לְהַשְׁמִיד גִּזְעֵי כׇּל־מַחְשְׁבוֹתָם</tei:l>
          <tei:l>מִרְמוֹת גַּם הַוּוֹת תַּחְשֹׁב לְשׁוֹנָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yedidekha_el_yelidei_ish_tam_tsur/3"/>
        <tei:lg>
          <tei:l>יַֽחַד נוֹעֲצוּ עַל־עַם סְגֻלָּה</tei:l>
          <tei:l>לְבַטֵּל שַׁבָּת חֹֽדֶשׁ וּמִילָה</tei:l>
          <tei:l>אַתָּה הֵפַֽרְתָּ כׇּל־מֹעֲצוֹתָם</tei:l>
          <tei:l>וְגַם קִלְקַֽלְתָּ אֶת־כׇּל־עִנְיָנָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yedidekha_el_yelidei_ish_tam_tsur/4"/>
        <tei:lg>
          <tei:l>חַסְדְּךָ נוֹדֶה בְּתֹף וְכִנּוֹר</tei:l>
          <tei:l>כִּי נָפַל חָלָל הַשַּׂר נִיקָנוֹר</tei:l>
          <tei:l>כָּשְׁלוּ וְנָפְלוּ כׇּל־חֵילוֹתָם</tei:l>
          <tei:l>רָגְזוּ וְחָלוּ רֻבֵּי הֲמוֹנָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yedidekha_el_yelidei_ish_tam_tsur/5"/>
        <tei:lg>
          <tei:l>נְזַמֵּר שִׁמְךָ וְגַם נַעֲרִיץ</tei:l>
          <tei:l>כִּי בָּאֵשׁ נִשְׂרַף בַּגְרִיס הַפָּרִיץ</tei:l>
          <tei:l>בְּאַף פָּרַֽצְתָּ כׇּל־גְּדֵרוֹתָם</tei:l>
          <tei:l>מָחַֽצְתָּ רֹאשָׁם גָּדַֽעְתָּ קַרְנָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yedidekha_el_yelidei_ish_tam_tsur/6"/>
        <tei:lg>
          <tei:l>וַיִּבְרַח מַלְכָּם הוּא אַנְטִיּֽוֹכוֹס</tei:l>
          <tei:l>בּֽוֹשׁוּ הִכָּֽלְמוּ כׇּל־שַׂר וְדֽוּכּוֹס</tei:l>
          <tei:l>מַֽטָּה מַמְלַכְתָּם מַֽטָּה מֶמְשַׁלְתָּם</tei:l>
          <tei:l>נָדַד קְצִינָם נִגְעַל מָגִנָּם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yedidekha_el_yelidei_ish_tam_tsur/7"/>
        <tei:lg>
          <tei:l>כֹּהֲנֵי אֵל חַי בְּנֵי חַשְׁמוֹנַאי</tei:l>
          <tei:l>הֵרִָימוּ קֶָרֶן עֲדַת אֱמוּנַי</tei:l>
          <tei:l>פֶָּרַח הֵצִיץ נֵץ נֵס יְשׁוּעָתָם</tei:l>
          <tei:l>נוֹדְעוּ בָעַמִּים פִּלְאֵי פֻרְקָנָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yedidekha_el_yelidei_ish_tam_tsur/8"/>
        <tei:lg>
          <tei:l>הֵיכַל הַקֹּֽדֶשׁ בָּֽאוּ פְּנִֽימָה</tei:l>
          <tei:l>וּצְלֹחִית שֶֽׁמֶן מָצְאוּ חֲתוּמָה</tei:l>
          <tei:l>בִּרְאוֹתָם אוֹתָהּ עָצְמָה שִׂמְחָתָם</tei:l>
          <tei:l>גָּדֵל מְשׂוֹשָׂם וְרַב שְׂשׂוֹנָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yedidekha_el_yelidei_ish_tam_tsur/9"/>
        <tei:lg>
          <tei:l>שַׁמְנָהּ שְׁמוֹנָה יָמִים הִדְלִֽיקוּ</tei:l>
          <tei:l>וּמוֹרֵי צֶֽדֶק קָבְעוּ וְחָקְקוּ</tei:l>
          <tei:l>לְהַדְלִיק בָּהֶם תָּמִיד נֵרוֹתָם</tei:l>
          <tei:l>לִשְׂמֹאל כְּנִיסַת פִּתְחֵי מְלוֹנָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yedidekha_el_yelidei_ish_tam_tsur/10"/>
        <tei:lg>
          <tei:l>מִשְׁתֶּה וְשִׂמְחָה רָאוּי לְהַרְבּוֹת</tei:l>
          <tei:l>לְפַרְסֵם נִסֵּי שׁוֹכֵן עֲרָבוֹת</tei:l>
          <tei:l>וּלְהוֹדוֹת לִשְׁמוֹ תּוֹךְ תְּפִלָּתָם</tei:l>
          <tei:l>וְגַם בִּבְרָכָה אַחַר מְזוֹנָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yedidekha_el_yelidei_ish_tam_tsur/11"/>
        <tei:lg>
          <tei:l>וְהַלֵּל גָּמוּר יֹאמְרוּ בְּגִילָה</tei:l>
          <tei:l>וּבְנֵי יְוָנִים יִהְיוּ לְכָלָה</tei:l>
          <tei:l>כִּֽי־חִנָּ֣ם טָֽמְנוּ־לִ֭י שַׁ֣חַת רִשְׁתָּ֑ם</tei:l>
          <tei:l>הָשֵׁב עֲלֵיהֶם מַהֵר אֶת־אוֹנָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yedidekha_el_yelidei_ish_tam_tsur/12"/>
        <tei:lg>
          <tei:l>נִסִּים עֲשֵׂה עִם־עַמְּךָ כְּקֶֽדֶם</tei:l>
          <tei:l>שׇׁמְרֵם וְעׇזְרֵם עוֹד גַּם עוֹדְדָם</tei:l>
          <tei:l>הָחִישׁ פְּדוּתָם הָשֵׁב שְׁבוּתָם</tei:l>
          <tei:l>וּבְנֵה מִקְדָּשָׁם וּדְבִיר אַרְמוֹנָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yedidekha_el_yelidei_ish_tam_tsur/13"/>
        <tei:lg>
          <tei:l>הֵן צִדְקוֹתֶיךָ תָּמִיד יְתַנּוּ</tei:l>
          <tei:l>וְלִכְבוֹד שִׁמְךָ יְקָר יִתֵּנוּ</tei:l>
          <tei:l>אֲזַי תִּתְגַּדֵּל בְּמַקְהֵלוֹתָם</tei:l>
          <tei:l>וְגַם תִּתְקַדֵּשׁ בְּטוּב הֶגְיוֹנָם׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
