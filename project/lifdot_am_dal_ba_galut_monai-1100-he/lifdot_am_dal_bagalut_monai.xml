    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:lifdot_am_dal_bagalut_monai">
        <tei:head>לִפְדּוֹת עַם דַּל בַּגָּלוּת מוֹנַי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lifdot_am_dal_bagalut_monai/1"/>
        <tei:lg>
          <tei:l>לִפְדּוֹת עַם דַּל בַּגָּלוּת מוֹנַי</tei:l>
          <tei:l>עַתָּ֕ה יִגְדַּל־ נָ֖א כֹּ֣חַ אֲדֹנָ֑י׃ <tei:bibl>(במדבר יד:יז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lifdot_am_dal_bagalut_monai/2"/>
        <tei:lg>
          <tei:l>יוֹנָה תַּמָּה בְּיַד זָר עַד מָה</tei:l>
          <tei:l>וְעוֹבֵד חַמָּה יָדוֹ רָמָה</tei:l>
          <tei:l>גַּפְנִי לְשַׁמָּה שָׁם בֶּן־אַמָּה</tei:l>
          <tei:l>ע֤וּרָה ׀ לָ֖מָּה תִישַׁ֥ן ׀ אֲדֹנָ֑י׃ <tei:bibl>(תהלים מד:כד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lifdot_am_dal_bagalut_monai/3"/>
        <tei:lg>
          <tei:l>כּוֹבֵשׁ וּמַכְבִּיד עוֹל עַל עֲמֵלִים</tei:l>
          <tei:l>הַחֲרֵם וְהַשְׁמֵד עוֹבְדֵי אֱלִילִים</tei:l>
          <tei:l>נְדוּדִים בְּבֵיתְךָ שְׁתוּלִים</tei:l>
          <tei:l>וְיֹאמְר֣וּ תָ֭מִיד יִגְדַּ֣ל יְהֹוָ֑ה׃ <tei:bibl>(תהלים לה:כז)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
