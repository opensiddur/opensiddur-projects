    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:qinah_al_meorot_charvot_barzel_rimon">
        <tei:head>קינה על מאורעות חרבות ברזל</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:qinah_al_meorot_charvot_barzel_rimon/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">(הצעה: לומר בניגון של אלי ציון ועריה)</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:qinah_al_meorot_charvot_barzel_rimon/2"/>
        <tei:lg>
          <tei:l>שִׂמְחַת תּוֹרָה – שְׁמִינִי עֲצֶרֶת,</tei:l>
          <tei:l>נֶהְפַּךְ מְחוֹלֵנוּ לְתוּגָה קוֹדֶרֶת;</tei:l>
          <tei:l>בְּיוֹם זֶה נִפְרְצוּ הַגְּדֵרוֹת,</tei:l>
          <tei:l>יִשּׁוּבֵי הָעוֹטֵף, אֳפָקִים וּשְׂדֵרוֹת.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:qinah_al_meorot_charvot_barzel_rimon/3"/>
        <tei:lg>
          <tei:l>אֵיכָה אַרְצֵנוּ הָיְתָה לְמִרְמָס,</tei:l>
          <tei:l>וַתִּמָּלֵא הָאָרֶץ חַמַאס,</tei:l>
          <tei:l>מֵרְצוּעַת עַזָּה מְקוֹר הָרֶשַׁע,</tei:l>
          <tei:l>מִשֹּׁרֶשׁ חַמַאס יָצָא צֶפַע.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:qinah_al_meorot_charvot_barzel_rimon/4"/>
        <tei:lg>
          <tei:l>אֵיכָה בִּמְקוֹם שֶׁבַע הַקָּפוֹת,</tei:l>
          <tei:l>נָסוּ עַל נַפְשָׁם מֵאֵימַת חֲטִיפוֹת,</tei:l>
          <tei:l>אוֹיֵב אַכְזָר מַצִּית שְׂרֵפוֹת,</tei:l>
          <tei:l>רוֹצֵחַ, מַשְׁפִּיל, בְּלִי לְהַרְפּוֹת.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:qinah_al_meorot_charvot_barzel_rimon/5"/>
        <tei:lg>
          <tei:l>אֵיכָה בִּמְקוֹם תְּפִלַּת הַגֶּשֶׁם,</tei:l>
          <tei:l>יָרַד דּוֹדִי לַעֲרוּגוֹת הַבֹּשֶׂם,</tei:l>
          <tei:l>שׁוֹשַׁנִּים נִטְבָּחִים, חִלּוּל הַשֵׁם,</tei:l>
          <tei:l>לִמְרַצְּחִים אַל תִּתֵּן יָד וָשֵׁם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:qinah_al_meorot_charvot_barzel_rimon/6"/>
        <tei:lg>
          <tei:l>אֵיכָה בִּשְׁנַת שִׁבְעִים וָשֵׁשׁ,</tei:l>
          <tei:l>תִּמְרוֹת עָשָׁן דָּם וָאֵשׁ,</tei:l>
          <tei:l>יְהוּדִי בְּמַחְבּוֹא נֶחֱרַד וְלוֹחֵשׁ,</tei:l>
          <tei:l>תַּחַת עֹנֶג שַׁבַּת קֹדֶשׁ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:qinah_al_meorot_charvot_barzel_rimon/7"/>
        <tei:lg>
          <tei:l>אֵיכָה בְּנֵי צִיּוֹן הַיְקָרִים,</tei:l>
          <tei:l>נָפְלוּ בִּידֵי אַנָּסִים אֲרוּרִים,</tei:l>
          <tei:l>מְרוּטֵי לֶחִי נְתוּנִים לְמַכִּים,</tei:l>
          <tei:l>אַחִים חֲטוּפִים בִּידֵי חֲמָסִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:qinah_al_meorot_charvot_barzel_rimon/8"/>
        <tei:lg>
          <tei:l>בַּיּוֹם בּוֹ שִׁמְךָ הִתְחַלֵּל,</tei:l>
          <tei:l>לוֹחֲמִים נֶאֶבְקוּ אֶת שִׁמְךָ לְגַדֵּל,</tei:l>
          <tei:l>הַבֵּט וּרְאֵה – מִי כְּעַמְּךָ יִשְׂרָאֵל,</tei:l>
          <tei:l>חַזְּקֵנוּ וְאַמְּצֵנוּ, וּבָא לְצִיּוֹן גּוֹאֵל.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:qinah_al_meorot_charvot_barzel_rimon/9"/>
        <tei:lg>
          <tei:l>כְּבַרְזֶל‭ ‬לַחֲמוּ‭ ‬אַמִּיצוֹת‭ ‬וְאַמִּיצִים‭ ‬אֲהוּבִים‭,‬</tei:l>
          <tei:l>עֲדִינֵי נֶפֶשׁ מִיַּד צַר מְגִנִּים,</tei:l>
          <tei:l>בִּגְבוּרָתָם רָאִינוּ תְּשׁוּעַת עוֹלָמִים,</tei:l>
          <tei:l>נִזְקְפָה קוֹמָתֵנוּ דּוֹר גְּאוּלִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:qinah_al_meorot_charvot_barzel_rimon/10"/>
        <tei:lg>
          <tei:l>בַּיּוֹם בּוֹ נִטְמְאָה נַחֲלָתֵנוּ,</tei:l>
          <tei:l>הֻתְּרָה לְפִרְסוּם גְּבוּרַת עַמֵּנוּ,</tei:l>
          <tei:l>נַפְשָׁם בְּכַפָּם מוֹסְרִים גִּבּוֹרֵינוּ,</tei:l>
          <tei:l>אָבִינוּ מַלְכֵּנוּ נְקֹם נִקְמַת אַחֵינוּ!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:qinah_al_meorot_charvot_barzel_rimon/11"/>
        <tei:lg>
          <tei:l>עַל שִׁמְךָ הַגָּדוֹל נִקְרָא שְׁמֵנוּ,</tei:l>
          <tei:l>זוֹכֵר וּמַזְכִּיר בְּרִית אֲבוֹתֵינוּ,</tei:l>
          <tei:l>מִצָּפוֹן וּמִדָּרוֹם עוֹמְדִים לְכַלּוֹתֵנוּ,</tei:l>
          <tei:l>וּבְרִיתְךָ עוֹמֶדֶת לָנוּ בְּאַרְצֵנוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:qinah_al_meorot_charvot_barzel_rimon/12"/>
        <tei:lg>
          <tei:l>עָרִיצֵי פָּרַס יָזְמוּ עֲלִילוֹת,</tei:l>
          <tei:l>מַטָּחִים שָׁלְחוּ לְנוֹשְׂאֵי תְּפִלּוֹת,</tei:l>
          <tei:l>סְפוּנִים יָשְׁבוּ וְעֵינֵיהֶם מְיַחֲלוֹת,</tei:l>
          <tei:l>אֶת נִסֶּיךָ רָאוּ – נוֹרָא תְּהִלּוֹת.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:qinah_al_meorot_charvot_barzel_rimon/13"/>
        <tei:lg>
          <tei:l>כַּנְפֵי רוּחַ, כַּנְפֵי נְשָׁרִים,</tei:l>
          <tei:l>רָאוֹ רָאִינוּ בְּרַעֲיוֹת חַיָּלִים,</tei:l>
          <tei:l>הוֹרִים וִילָדִים אֶת יַקִּירֵיהֶם מְקַבְּרִים,</tei:l>
          <tei:l>חַזְּקֵם וְאַמְּצֵם עֲדַת אַבִּירִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:qinah_al_meorot_charvot_barzel_rimon/14"/>
        <tei:lg>
          <tei:l>גַּלֵּי שִׂנְאָה שׁוֹטְפִים עוֹלָמֶךָ,</tei:l>
          <tei:l>שׁוֹצְפִים צוֹרְרִים עַל מַקְדִּישֵׁי שְׁמֶךָ,</tei:l>
          <tei:l>רוֹדְפִים אֶת שְׁלוּחֶיךָ נוֹשְׂאֵי דְּגָלֶיךָ,</tei:l>
          <tei:l>בְּאַהֲבָה יְהִי נָא עָלֵינוּ דִּלּוּגֶיךָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:qinah_al_meorot_charvot_barzel_rimon/15"/>
        <tei:lg>
          <tei:l>הָשֵׁב חֲטוּפִים, קְרָא דְּרוֹר לַשְּׁבוּיִים,</tei:l>
          <tei:l>נְטַע עֲקוּרִים בְּאַהֲבַת נְצָחִים,</tei:l>
          <tei:l>שַׁקֵּם פְּצוּעִים רוֹמֵם נִדְכָּאִים,</tei:l>
          <tei:l>נַהֵל עֲדָתְךָ בְּחֶסֶד וּבְרַחֲמִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:qinah_al_meorot_charvot_barzel_rimon/16"/>
        <tei:lg>
          <tei:l>מוֹדִים אֲנַחְנוּ לָךְ עַל מְדִינָתֵנוּ,</tei:l>
          <tei:l>עַל גְּאֻלָּתֵנוּ וְעַל פְּדוּת נַפְשֵׁנוּ,</tei:l>
          <tei:l>מְאֻחָדִים תּוֹלִיכֵנוּ קוֹמְמִיּוּת בְּאַרְצֵנוּ,</tei:l>
          <tei:l>הָחֵשׁ בֶּן דָּוִד מְשִׁיחַ צִדְקֵנוּ.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
