      <tei:div corresp="urn:x-opensiddur:text:prayer:a_prayer_of_thanks_on_the_return_of_the_hostages_on_simchat_kainan">
        <tei:head>תפילת הודיה לשוב החטופים שמחת תורה תשפ״ו</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_of_thanks_on_the_return_of_the_hostages_on_simchat_kainan/1"/>
        <tei:lg>
          <tei:l>הֹדוּ לַה׳ כִּי־טוֹב, כִּי לְעוֹלָם חַסְדּוֹ.</tei:l>
          <tei:l>יֹאמְרוּ גְּאוּלֵי ה׳ אֲשֶׁר גְּאָלָם מִיַּד־צָר... <tei:bibl>(תהלים קז:א-ב)</tei:bibl></tei:l>
          <tei:l>יֹשְׁבֵי חֹשֶׁךְ וְצַלְמָוֶת, אֲסִירֵי עֳנִ֮י וּבַרְזֶל... <tei:bibl>(תהלים קז:י)</tei:bibl></tei:l>
          <tei:l>יוֹדוּ לַה׳ חַסְדּוֹ וְנִפְלְאוֹתָיו לִבְנֵי אָדָם,</tei:l>
          <tei:l>וִירוֹמְמוּהוּ בִּקְהַל־עָם <tei:bibl>(תהלים קז:לא-לב)</tei:bibl>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_of_thanks_on_the_return_of_the_hostages_on_simchat_kainan/2"/>
        <tei:lg>
          <tei:l>אֲדוֹן הַשָּׁלוֹם וְרַחוּם וְחַנּוּן,</tei:l>
          <tei:l>נוֹדֶה בְּרֹב עָם וּבְעֵדָה גְּדוֹלָה, עַל גֹּדֶל חַסְדֶּךָ</tei:l>
          <tei:l>אֲשֶׁר גָּאַלְתָּ לָנוּ אֶת בָּנֵינוּ וּבְנוֹתֵינוּ</tei:l>
          <tei:l>מִשְּׁבִי הָאֹיֵב</tei:l>
          <tei:l>שֶׁכָּתוּב: ”יוֹצִיאֵם מֵחֹשֶׁךְ וְצַלְמָוֶת</tei:l>
          <tei:l>וּמוֹסְרוֹתֵיהֶם יְנַתֵּק“ <tei:bibl>(תהלים קז:יד)</tei:bibl>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_of_thanks_on_the_return_of_the_hostages_on_simchat_kainan/3"/>
        <tei:lg>
          <tei:l>וְנוֹדֶה לְפָנֶיךָ, ה׳ אֱלֹהֵינוּ,</tei:l>
          <tei:l>עַל שֶׁנָּתַתָּ תְּבוּנָה, אֹמֶץ וּנְחִישׁוּת בְּקֶרֶב בְּרוּאֶיךָ</tei:l>
          <tei:l>לַעֲשׂוֹת בְּכֹחַ אֱנוֹשׁ לְהָשִׁיב בָּנֵינוּ וּבְנוֹתֵינוּ אֶל מִשְׁפְּחוֹתֵיהֶם,</tei:l>
          <tei:l>וְאֶת הַחֲלָלִים לְהָבִיא לִמְנוּחַת עוֹלָמִים, כְּדִבְרֵי נְבִיאֶךָ:</tei:l>
          <tei:l>“ה׳ אֱלֹהִים שְׁלָחַנִי לַחֲבֹשׁ לְנִשְׁבְּרֵי־לֵב</tei:l>
          <tei:l>לִקְרֹא לִשְׁבוּיִם דְּרוֹר וְלַאֲסוּרִים פְּקַח־קוֹחַ ...</tei:l>
          <tei:l>לְנַחֵם כָּל־אֲבֵלִים” <tei:bibl>(ישעיה סא:א-ב)</tei:bibl>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_of_thanks_on_the_return_of_the_hostages_on_simchat_kainan/4"/>
        <tei:lg>
          <tei:l>רַחֵם נָא עַל שְׁבוּיֵנוּ שֶׁחָזְרוּ לְבֵיתָם,</tei:l>
          <tei:l>וּרְפָא אֶת גוּפָם וְנַפְשָׁם מִמְּאֵרַת הַשֶּׁבִי וּמִפַּחַד בַּלֵּילוֹת.</tei:l>
          <tei:l>קַיֵּם בָּהֶם אֶת דִּבְרֵי קָדְשֶׁךָ:</tei:l>
          <tei:l>”ה׳, הֶעֱלִיתָ מִן־שְׁאוֹל נַפְשִׁי, חִיִּיתַנִי מִיָּרְדִי־בוֹר“ <tei:bibl>(תהלים ל:ד)</tei:bibl>.</tei:l>
          <tei:l>”לֹא־תִירָא מִפַּחַד לָיְלָה, מֵחֵץ יָעוּף יוֹמָם“ <tei:bibl>(תהלים צא:ה)</tei:bibl>,</tei:l>
          <tei:l>”וְלֹא־תְאֻנֶּה אֵלֶיךָ רָעָה“ <tei:bibl>(תהלים צא:י)</tei:bibl>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_of_thanks_on_the_return_of_the_hostages_on_simchat_kainan/5"/>
        <tei:lg>
          <tei:l>וְתֵן בִּבְנֵי מִשְׁפְּחוֹתֵיהֶם הַכֹּחַ</tei:l>
          <tei:l>לְקַבֵּל,</tei:l>
          <tei:l>לְאַחוֹת,</tei:l>
          <tei:l>לְהַשְׁלִים</tei:l>
          <tei:l>וּלְהַחְלִים –</tei:l>
          <tei:l>”הָרֹפֵא לִשְׁבוּרֵי לֵב</tei:l>
          <tei:l>וּמְחַבֵּשׁ לְעַצְבוֹתָם“ <tei:bibl>(תהלים קמז:ג)</tei:bibl>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_of_thanks_on_the_return_of_the_hostages_on_simchat_kainan/6"/>
        <tei:lg>
          <tei:l>עֲנֵנוּ ה׳ בְּרַחֲמֶיךָ גַּם עַל אֵלֶּה שֶׁלֹּא שָׁבוּ חַיִּים לִגְבוּלֵנוּ.</tei:l>
          <tei:l>תֵּן בְּיָדֵינוּ לַהֲשִׁיבָם לַאֲדָמָה בְּכָבוֹד,</tei:l>
          <tei:l>וּלְמַלֵּא אֶת חוֹבָתֵנוּ בְּאַהֲבָה,</tei:l>
          <tei:l>בְּדִמְעָה וּבְלֵב שָׁבוּר,</tei:l>
          <tei:l>כִּי אֵין דָּבָר שָׁלֵם יוֹתֵר מִלֵּב שָׁבוּר.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_of_thanks_on_the_return_of_the_hostages_on_simchat_kainan/7"/>
        <tei:lg>
          <tei:l>וִיהִי רָצוֹן שֶׁיִּוָּדַע בִּמְהֵרָה גּוֹרַל הַנֶּעְדָּרִים,</tei:l>
          <tei:l>וְיִתְקַיֵּם בָּנוּ מִקְרָא שֶׁכָּתוּב:</tei:l>
          <tei:l>“וְלֹא נֶעְדַּר־לָהֶם מִן־הַקָּטֹן וְעַד־הַגָּדוֹל</tei:l>
          <tei:l>וְעַד־בָּנִים וּבָנוֹת” <tei:bibl>(שמואל א׳ ל:יט)</tei:bibl>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_of_thanks_on_the_return_of_the_hostages_on_simchat_kainan/8"/>
        <tei:lg>
          <tei:l>וּלְאַחֵינוּ וְאַחְיוֹתֵינוּ בְּכָל גְּבוּל יִשְׂרָאֵל,</tei:l>
          <tei:l>מִמִּישׁוֹרֵי הַנֶּגֶב וְעַד מְרוֹמֵי הַגָּלִיל,</tei:l>
          <tei:l>אֲשֶׁר הַיּוֹם עַיִן בְּמַר בּוֹכָה וְלֵב שָׂמֵחַ,</tei:l>
          <tei:l>יְהִי רָצוֹן שֶׁיִּתְקַיְּמוּ בָּכֶם וּבָנוּ דִּבְרֵי נְבִיאֶךָ:</tei:l>
          <tei:l>“וּבָנוּ חָרְבוֹת עוֹלָם,</tei:l>
          <tei:l>שֹׁמְמוֹת רִאשֹׁנִים יְקוֹמֵמוּ” <tei:bibl>(ישעיה סא:ד)</tei:bibl>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_of_thanks_on_the_return_of_the_hostages_on_simchat_kainan/9"/>
        <tei:lg>
          <tei:l>אֱלֹהֵינוּ שֶׁבַּשָּׁמַיִם,</tei:l>
          <tei:l>הַשְׁכֵּן שָׁלוֹם בָּאָרֶץ</tei:l>
          <tei:l>וְאַחֲוָה בֵּין בָּנֶיךָ.</tei:l>
          <tei:l>חַזֵּק אֶת עַמְּךָ יִשְׂרָאֵל בֶּאֱמוּנָה וּבְתִקְוָה,</tei:l>
          <tei:l>וְהָשֵׁב שָׂשׂוֹן וְשִׂמְחָה לְצִיּוֹן.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_of_thanks_on_the_return_of_the_hostages_on_simchat_kainan/10"/>
        <tei:lg>
          <tei:l>וְנֹאמַר לְפָנֶיךָ הַיּוֹם בְּתוֹדָה</tei:l>
          <tei:l>יַחְדָּיו בְּקוֹל גָּדוֹל:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_of_thanks_on_the_return_of_the_hostages_on_simchat_kainan/11"/>
        <tei:lg>
          <tei:l>בָּרוּךְ מַתִּיר אֲסוּרִים. אמן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_of_thanks_on_the_return_of_the_hostages_on_simchat_kainan/12"/>
        <tei:lg>
          <tei:l>בָּרוּךְ הַמֵּשִׁיב בָּנִים לִגְבוּלָם. אמן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_of_thanks_on_the_return_of_the_hostages_on_simchat_kainan/13"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה ה׳, הַטּוֹב וְהַמֵּטִיב. אמן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_of_thanks_on_the_return_of_the_hostages_on_simchat_kainan/14"/>
        <tei:lg>
          <tei:l>בָּרוּךְ דַּיַּן הָאֱמֶת, אֲשֶׁר לֹא־עָזַב חַסְדּוֹ אֶת־הַחַיִּים וְאֶת־הַמֵּתִים. אמן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_of_thanks_on_the_return_of_the_hostages_on_simchat_kainan/15"/>
        <tei:lg>
          <tei:l>בָּרוּךְ שֶׁחָלַק מֵחָכְמָתוֹ לְבָשָׂר וָדָם. אמן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_of_thanks_on_the_return_of_the_hostages_on_simchat_kainan/16"/>
        <tei:lg>
          <tei:l>בָּרוּךְ מַצִּיב גְּבוּל אַלְמָנָה. אמן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_of_thanks_on_the_return_of_the_hostages_on_simchat_kainan/17"/>
        <tei:lg>
          <tei:l>בָּרוּךְ הַמְרַפֵּא לִשְׁבוּרֵי לֵב</tei:l>
          <tei:l>וְשָׂם שָׁלוֹם בָּאָרֶץ. אָמֵן.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
