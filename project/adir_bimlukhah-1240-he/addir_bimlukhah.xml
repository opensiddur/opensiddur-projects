    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:addir_bimlukhah">
        <tei:head>אַדִּיר בִּמְלוּכָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_bimlukhah/1"/>
        <tei:lg>
          <tei:l>כִּי לוֹ נָאֶה.</tei:l>
          <tei:l>כִּי לוֹ יָאֶה׃</tei:l>
          <tei:l><tei:seg type="acrostic">אַ</tei:seg>דִּיר בִּמְלוּכָה.</tei:l>
          <tei:l><tei:seg type="acrostic">בָּ</tei:seg>חוּר כַּהֲלָכָה.</tei:l>
          <tei:l><tei:seg type="acrostic">גְּ</tei:seg>דוּדָיו יֹאמְרוּ לוֹ.</tei:l>
          <tei:l>לְךָ וּלְךָ.</tei:l>
          <tei:l>לְךָ כִּי לְךָ.</tei:l>
          <tei:l>לְךָ אַף לְךָ.</tei:l>
          <tei:l>לְךָ יְיָ הַמַּמְלָכָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_bimlukhah/2"/>
        <tei:lg>
          <tei:l>כִּי לוֹ נָאֶה.</tei:l>
          <tei:l>כִּי לוֹ יָאֶה׃</tei:l>
          <tei:l><tei:seg type="acrostic">דַּ</tei:seg>גוּל בִּמְלוּכָה.</tei:l>
          <tei:l><tei:seg type="acrostic">הָ</tei:seg>דוּר כַּהֲלָכָה.</tei:l>
          <tei:l><tei:seg type="acrostic">וָ</tei:seg>תִיקָיו יֹאמְרוּ לוֹ</tei:l>
          <tei:l>לְךָ וּלְךָ.</tei:l>
          <tei:l>לְךָ כִּי לְךָ.</tei:l>
          <tei:l>לְךָ אַף לְךָ.</tei:l>
          <tei:l>לְךָ יְיָ הַמַּמְלָכָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_bimlukhah/3"/>
        <tei:lg>
          <tei:l>כִּי לוֹ נָאֶה.</tei:l>
          <tei:l>כִּי לוֹ יָאֶה׃</tei:l>
          <tei:l><tei:seg type="acrostic">זַ</tei:seg>כַּאי בִּמְלוּכָה.</tei:l>
          <tei:l><tei:seg type="acrostic">חָ</tei:seg>סִין כַּהֲלָכָה.</tei:l>
          <tei:l><tei:seg type="acrostic">טַ</tei:seg>פְסְרָיו יֹאמְרוּ לוֹ.</tei:l>
          <tei:l>לְךָ וּלְךָ.</tei:l>
          <tei:l>לְךָ כִּי לְךָ.</tei:l>
          <tei:l>לְךָ אַף לְךָ.</tei:l>
          <tei:l>לְךָ יְיָ הַמַּמְלָכָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_bimlukhah/4"/>
        <tei:lg>
          <tei:l>כִּי לוֹ נָאֶה.</tei:l>
          <tei:l>כִּי לוֹ יָאֶה׃</tei:l>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>חִיד בִּמְלוּכָה.</tei:l>
          <tei:l><tei:seg type="acrostic">כַּ</tei:seg>בִּיר כַּהֲלָכָה.</tei:l>
          <tei:l><tei:seg type="acrostic">לִ</tei:seg>מּוּדָיו יֹאמְרוּ לוֹ.</tei:l>
          <tei:l>לְךָ וּלְךָ.</tei:l>
          <tei:l>לְךָ כִּי לְךָ.</tei:l>
          <tei:l>לְךָ אַף לְךָ.</tei:l>
          <tei:l>לְךָ יְיָ הַמַּמְלָכָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_bimlukhah/5"/>
        <tei:lg>
          <tei:l>כִּי לוֹ נָאֶה.</tei:l>
          <tei:l>כִּי לוֹ יָאֶה׃</tei:l>
          <tei:l><tei:seg type="acrostic">מָ</tei:seg>רוֹם בִּמְלוּכָה.</tei:l>
          <tei:l><tei:seg type="acrostic">נ</tei:seg>וֹרָא כַּהֲלָכָה.</tei:l>
          <tei:l><tei:seg type="acrostic">סְ</tei:seg>בִיבָיו יֹאמְרוּ לוֹ.</tei:l>
          <tei:l>לְךָ וּלְךָ.</tei:l>
          <tei:l>לְךָ כִּי לְךָ.</tei:l>
          <tei:l>לְךָ אַף לְךָ.</tei:l>
          <tei:l>לְךָ יְיָ הַמַּמְלָכָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_bimlukhah/6"/>
        <tei:lg>
          <tei:l>כִּי לוֹ נָאֶה.</tei:l>
          <tei:l>כִּי לוֹ יָאֶה׃</tei:l>
          <tei:l><tei:seg type="acrostic">עָ</tei:seg>נָיו בִּמְלוּכָה.</tei:l>
          <tei:l><tei:seg type="acrostic">פּ</tei:seg>וֹדֶה כַּהֲלָכָה.</tei:l>
          <tei:l><tei:seg type="acrostic">צַ</tei:seg>דִּיקָיו יֹאמְרוּ לוֹ.</tei:l>
          <tei:l>לְךָ וּלְךָ.</tei:l>
          <tei:l>לְךָ כִּי לְךָ.</tei:l>
          <tei:l>לְךָ אַף לְךָ.</tei:l>
          <tei:l>לְךָ יְיָ הַמַּמְלָכָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_bimlukhah/7"/>
        <tei:lg>
          <tei:l>כִּי לוֹ נָאֶה.</tei:l>
          <tei:l>כִּי לוֹ יָאֶה׃</tei:l>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>דוֹשׁ בִּמְלוּכָה.</tei:l>
          <tei:l><tei:seg type="acrostic">רַ</tei:seg>חוּם כַּהֲלָכָה.</tei:l>
          <tei:l><tei:seg type="acrostic">שִׁ</tei:seg>נְאַנָּיו יֹאמְרוּ לוֹ.</tei:l>
          <tei:l>לְךָ וּלְךָ.</tei:l>
          <tei:l>לְךָ כִּי לְךָ.</tei:l>
          <tei:l>לְךָ אַף לְךָ.</tei:l>
          <tei:l>לְךָ יְיָ הַמַּמְלָכָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_bimlukhah/8"/>
        <tei:lg>
          <tei:l>כִּי לוֹ נָאֶה.</tei:l>
          <tei:l>כִּי לוֹ יָאֶה׃</tei:l>
          <tei:l><tei:seg type="acrostic">תַּ</tei:seg>קִיף בִּמְלוּכָה.</tei:l>
          <tei:l>תּוֹמֵךְ כַּהֲלָכָה.</tei:l>
          <tei:l>תְּמִימָיו יֹאמְרוּ לוֹ.</tei:l>
          <tei:l>לְךָ וּלְךָ.</tei:l>
          <tei:l>לְךָ כִּי לְךָ.</tei:l>
          <tei:l>לְךָ אַף לְךָ.</tei:l>
          <tei:l>לְךָ יְיָ הַמַּמְלָכָה׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
