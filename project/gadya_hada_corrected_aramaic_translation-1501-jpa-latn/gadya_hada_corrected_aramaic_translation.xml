  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:gadya_hada_corrected_aramaic_translation">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:gadya_hada_corrected_aramaic_translation/1"/>
        <tei:lg>
          <tei:l>Gaḏyå ḥăḏa, gaḏyå ḥăḏå</tei:l>
          <tei:l>Di-zḇēn abbå</tei:l>
          <tei:l>bi-ṯrē zuzē</tei:l>
          <tei:l>Gaḏyå ḥăḏa, gaḏyå ḥăḏå</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:gadya_hada_corrected_aramaic_translation/2"/>
        <tei:lg>
          <tei:l>Va-ăṯå šunnårå</tei:l>
          <tei:l>Va-ăḵal yåṯ gaḏyå</tei:l>
          <tei:l>Di-zḇēn abbå</tei:l>
          <tei:l>bi-ṯrē zuzē</tei:l>
          <tei:l>Gaḏyå ḥăḏa, gaḏyå ḥăḏå</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:gadya_hada_corrected_aramaic_translation/3"/>
        <tei:lg>
          <tei:l>Va-ăṯå kalbå</tei:l>
          <tei:l>U-nḵēt l-šunnårå</tei:l>
          <tei:l>Da-ăḵal yåṯ gaḏyå</tei:l>
          <tei:l>Di-zḇēn abbå</tei:l>
          <tei:l>bi-ṯrē zuzē</tei:l>
          <tei:l>Gaḏyå ḥăḏa, gaḏyå ḥăḏå</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:gadya_hada_corrected_aramaic_translation/4"/>
        <tei:lg>
          <tei:l>Va-ăṯå ḥuṭrå</tei:l>
          <tei:l>U-mḥē yåṯ kalbå</tei:l>
          <tei:l>Di-nḵēt l-šunnårå</tei:l>
          <tei:l>Da-ăḵal yåṯ gaḏyå</tei:l>
          <tei:l>Di-zḇēn abbå</tei:l>
          <tei:l>bi-ṯrē zuzē</tei:l>
          <tei:l>Gaḏyå ḥăḏa, gaḏyå ḥăḏå</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:gadya_hada_corrected_aramaic_translation/5"/>
        <tei:lg>
          <tei:l>Va-ăṯå nurå</tei:l>
          <tei:l>V-oqiḏ yåṯ ḥuṭrå</tei:l>
          <tei:l>U-mḥē yåṯ kalbå</tei:l>
          <tei:l>Di-nḵēt l-šunnårå</tei:l>
          <tei:l>Da-ăḵal yåṯ gaḏyå</tei:l>
          <tei:l>Di-zḇēn abbå</tei:l>
          <tei:l>bi-ṯrē zuzē</tei:l>
          <tei:l>Gaḏyå ḥăḏa, gaḏyå ḥăḏå</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:gadya_hada_corrected_aramaic_translation/6"/>
        <tei:lg>
          <tei:l>Va-ăṯo mayyå</tei:l>
          <tei:l>V-aḏȝiḵu yåṯ nurå</tei:l>
          <tei:l>D-oqiḏ yåṯ ḥuṭrå</tei:l>
          <tei:l>Di-mḥē yåṯ kalbå</tei:l>
          <tei:l>Di-nḵēt l-šunnårå</tei:l>
          <tei:l>Da-ăḵal yåṯ gaḏyå</tei:l>
          <tei:l>Di-zḇēn abbå</tei:l>
          <tei:l>bi-ṯrē zuzē</tei:l>
          <tei:l>Gaḏyå ḥăḏa, gaḏyå ḥăḏå</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:gadya_hada_corrected_aramaic_translation/7"/>
        <tei:lg>
          <tei:l>Va-ăṯå torå</tei:l>
          <tei:l>U-šṯē yåṯ mayyå</tei:l>
          <tei:l>D-aḏȝiḵu yåṯ nurå</tei:l>
          <tei:l>D-oqiḏ yåṯ ḥuṭrå</tei:l>
          <tei:l>Di-mḥē yåṯ kalbå</tei:l>
          <tei:l>Di-nḵēt l-šunnårå</tei:l>
          <tei:l>Da-ăḵal yåṯ gaḏyå</tei:l>
          <tei:l>Di-zḇēn abbå</tei:l>
          <tei:l>bi-ṯrē zuzē</tei:l>
          <tei:l>Gaḏyå ḥăḏa, gaḏyå ḥăḏå</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:gadya_hada_corrected_aramaic_translation/8"/>
        <tei:lg>
          <tei:l>Va-ăṯå ṭabbåḥå</tei:l>
          <tei:l>U-nḵēs yåṯ torå</tei:l>
          <tei:l>Di-šṯē yåṯ mayyå</tei:l>
          <tei:l>D-aḏȝiḵu yåṯ nurå</tei:l>
          <tei:l>D-oqiḏ yåṯ ḥuṭrå</tei:l>
          <tei:l>Di-mḥē yåṯ kalbå</tei:l>
          <tei:l>Di-nḵēt l-šunnårå</tei:l>
          <tei:l>Da-ăḵal yåṯ gaḏyå</tei:l>
          <tei:l>Di-zḇēn abbå</tei:l>
          <tei:l>bi-ṯrē zuzē</tei:l>
          <tei:l>Gaḏyå ḥăḏa, gaḏyå ḥăḏå</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:gadya_hada_corrected_aramaic_translation/9"/>
        <tei:lg>
          <tei:l>Va-ăṯå mal’ăḵa d-moṯa</tei:l>
          <tei:l>U-nḵēs yåṯ ṭabbåḥå</tei:l>
          <tei:l>Di-nḵēs yåṯ torå</tei:l>
          <tei:l>Di-šṯē yåṯ mayyå</tei:l>
          <tei:l>D-aḏȝiḵu yåṯ nurå</tei:l>
          <tei:l>D-oqiḏ yåṯ ḥuṭrå</tei:l>
          <tei:l>Di-mḥē yåṯ kalbå</tei:l>
          <tei:l>Di-nḵēt l-šunnårå</tei:l>
          <tei:l>Da-ăḵal yåṯ gaḏyå</tei:l>
          <tei:l>Di-zḇēn abbå</tei:l>
          <tei:l>bi-ṯrē zuzē</tei:l>
          <tei:l>Gaḏyå ḥăḏa, gaḏyå ḥăḏå</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:gadya_hada_corrected_aramaic_translation/10"/>
        <tei:lg>
          <tei:l>Va-ăṯå Quḏšå Briḵ Hu</tei:l>
          <tei:l>U-nḵēs yåṯ mal’ăḵa d-moṯa</tei:l>
          <tei:l>Di-nḵēs yåṯ ṭabbåḥå</tei:l>
          <tei:l>Di-nḵēs yåṯ torå</tei:l>
          <tei:l>Di-šṯē yåṯ mayyå</tei:l>
          <tei:l>D-aḏȝiḵu yåṯ nurå</tei:l>
          <tei:l>D-oqiḏ yåṯ ḥuṭrå</tei:l>
          <tei:l>Di-mḥē yåṯ kalbå</tei:l>
          <tei:l>Di-nḵēt l-šunnårå</tei:l>
          <tei:l>Da-ăḵal yåṯ gaḏyå</tei:l>
          <tei:l>Di-zḇēn abbå</tei:l>
          <tei:l>bi-ṯrē zuzē</tei:l>
          <tei:l>Gaḏyå ḥăḏa, gaḏyå ḥăḏå</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
