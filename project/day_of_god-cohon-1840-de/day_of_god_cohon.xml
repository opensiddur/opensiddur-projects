  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:day_of_god_cohon">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:day_of_god_cohon/1"/>
        <tei:lg>
          <tei:l>O Tag des Herrn</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:day_of_god_cohon/2"/>
        <tei:lg>
          <tei:l>O Tag des Herrn!</tei:l>
          <tei:l>Du nahst</tei:l>
          <tei:l>Und das Herz erbebt,</tei:l>
          <tei:l>Und Schauer fassen die Seele,</tei:l>
          <tei:l>Sie gedenket ihrer Missethat,</tei:l>
          <tei:l>Sie gedenket, daß ihr Richter naht,</tei:l>
          <tei:l>Und zittert.</tei:l>
          <tei:l>Sie bangt, sie zagt; sie weint und klagt</tei:l>
          <tei:l>Und vergeht in Thränen.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:day_of_god_cohon/3"/>
        <tei:lg>
          <tei:l>Fasse Muth, o belastet Herz!</tei:l>
          <tei:l>Schau du nur trostvoll himmelwärts!</tei:l>
          <tei:l>Gütig ist der Herr,</tei:l>
          <tei:l>Gern gibt er Gehör,</tei:l>
          <tei:l>Naht sich auszusöhnen.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:day_of_god_cohon/4"/>
        <tei:lg>
          <tei:l>Herr Gott, sieh’,</tei:l>
          <tei:l>Sieh’ meines Herzens Wehen,</tei:l>
          <tei:l>Und neig dein Ohr!</tei:l>
          <tei:l>Herr vermmm,</tei:l>
          <tei:l>Vernimm mein heißes Flehen,</tei:l>
          <tei:l>Oeffn’ uns das Thor!</tei:l>
          <tei:l>Nimm weg die Missethat,</tei:l>
          <tei:l>Oeffn’ uns das Thor der Gnad’,</tei:l>
          <tei:l>Und zieh’ uns empor.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
