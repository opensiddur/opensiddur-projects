  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_prayer_for_today_held">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_today_held/1"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן מִלְּפָנֶיךָ</tei:l>
          <tei:l>יְיָ אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ</tei:l>
          <tei:l>שֶׁהַטּוֹב יִנְצַח אֶת הָרַע,</tei:l>
          <tei:l>שֶׁהָאוֹר יִנְצַח אֶת הַחֹשֶׂךְ,</tei:l>
          <tei:l>וְשֶׁהָאַהֲבָה וְהַחֶסֶד יְנַצְּחוּ אֶת הַשִּׂנְאָה וְהָאַכְזָרִיּוּת.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_today_held/2"/>
        <tei:lg>
          <tei:l>אֱלֹהֵי עוֹלָם,</tei:l>
          <tei:l>הֶיֵה עִמָּנוּ וְהֶיֵה עוֹזֵר לָנוּ בְּמַאֲבָקֵנוּ</tei:l>
          <tei:l>לְהַעֲבִיר מֶמְשֶׁלֶת זָדוֹן מִן הָאָרֶץ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_today_held/3"/>
        <tei:lg>
          <tei:l>תֵּן בְּיוֹשְׁבֵי אַרְצֵנוּ לֵב בָּשָׂר,</tei:l>
          <tei:l>וְנִלְמַד כֻּלָּנוּ כְּאֶחָד</tei:l>
          <tei:l>לְאַהֵב אֶת הַחֶסֶד וּלְרַדֵּף אֶת הַצֶּדֶק;</tei:l>
          <tei:l>תֵּן בָּנוּ אֶת הָאֹמֶץ</tei:l>
          <tei:l>לְאַהֵב אֶת הַגֵּר, הַיָּתוֹם, וְהָאַלְמָנָה,</tei:l>
          <tei:l>וּלְהָגֵן עַל הָעֲנִיִּים וְהַמְדֻכָּאִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_today_held/4"/>
        <tei:lg>
          <tei:l>אָנָּא</tei:l>
          <tei:l>תֵּן בָּנוּ אֶת הַכֹּחַ וְהָרָצוֹן</tei:l>
          <tei:l>לְהַתְחִיל מִבְּרֵאשִׁית.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_today_held/5"/>
        <tei:lg>
          <tei:l>יִהְיוּ לְרָצוֹן אִמְרֵי פִינוּ,</tei:l>
          <tei:l>הֶגְּיוֹן לִבֵּנוּ,</tei:l>
          <tei:l>וּמַעֲשֵׂי יָדֵינוּ</tei:l>
          <tei:l>לְפָנֶיךָ יְיָ</tei:l>
          <tei:l>צוּרֵינוּ וְגוֹאֲלֵינוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_today_held/6"/>
        <tei:lg>
          <tei:l>אָמֵן אָמֵן.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
