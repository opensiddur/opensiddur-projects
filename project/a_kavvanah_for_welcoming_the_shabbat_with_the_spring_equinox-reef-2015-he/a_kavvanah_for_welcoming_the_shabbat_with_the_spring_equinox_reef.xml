  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_kavvanah_for_welcoming_the_shabbat_with_the_spring_equinox_reef">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_kavvanah_for_welcoming_the_shabbat_with_the_spring_equinox_reef/3"/>
        <tei:lg>
          <tei:l>וַיֹּ֣אמֶר אֱלֹהִ֗ים</tei:l>
          <tei:l>יְהִ֤י מְאֹרֹת֙ בִּרְקִ֣יעַ הַשָּׁמַ֔יִם</tei:l>
          <tei:l>לְהַבְדִּ֕יל בֵּ֥ין הַיּ֖וֹם וּבֵ֣ין הַלָּ֑יְלָה</tei:l>
          <tei:l>וְהָי֤וּ לְאֹתֹת֙</tei:l>
          <tei:l>וּלְמ֣וֹעֲדִ֔ים</tei:l>
          <tei:l>וּלְיָמִ֖ים</tei:l>
          <tei:l>וְשָׁנִֽים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_kavvanah_for_welcoming_the_shabbat_with_the_spring_equinox_reef/5"/>
        <tei:lg>
          <tei:l>וְנֵדְעָ֣ה נִרְדְּפָ֗ה לָדַ֙עַת֙ אֶת־יְהוָ֔ה</tei:l>
          <tei:l>כְּשַׁ֖חַר נָכ֣וֹן מֽוֹצָא֑וֹ</tei:l>
          <tei:l>וְיָב֤וֹא כַגֶּ֙שֶׁם֙ לָ֔נוּ</tei:l>
          <tei:l>כְּמַלְק֖וֹשׁ י֥וֹרֶה אָֽרֶץ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_kavvanah_for_welcoming_the_shabbat_with_the_spring_equinox_reef/7"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>אֲשֶׁר קִדְּשָֽׁנוּ בְּמִצְוֺתָיו</tei:l>
          <tei:l>וְצִוָּֽנוּ לְהַדְלִיק נֵר שֶׁל שַׁבָּת:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_kavvanah_for_welcoming_the_shabbat_with_the_spring_equinox_reef/9"/>
        <tei:lg>
          <tei:l>כִּֽי־הִנֵּ֥ה הסתו [הַסְּתָ֖יו] עָבָ֑ר</tei:l>
          <tei:l>הַגֶּ֕שֶׁם חָלַ֖ף הָלַ֥ךְ לֽוֹ׃</tei:l>
          <tei:l>הַנִּצָּנִים֙ נִרְא֣וּ בָאָ֔רֶץ</tei:l>
          <tei:l>עֵ֥ת הַזָּמִ֖יר הִגִּ֑יעַ</tei:l>
          <tei:l>וְק֥וֹל הַתּ֖וֹר נִשְׁמַ֥ע בְּאַרְצֵֽנוּ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
