      <tei:div corresp="urn:x-opensiddur:text:poem:ki_ner_echenokh_shaashui_yoseh">
        <tei:head>כִּי נֵר אֶחֱנֹךְ שַׁעֲשׁוּעִי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ki_ner_echenokh_shaashui_yoseh/1"/>
        <tei:lg>
          <tei:l>כִּ֤י נֵ֣ר <tei:seg type="acrostic">אֶ</tei:seg>חֱנֹךְ שַׁעֲשׁוּעִי</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>הַלֵּל וּבְתוֹדוֹת שְׁמוֹנָה לְשַׁוְעִי</tei:l>
          <tei:l><tei:seg type="acrostic">גַּ</tei:seg>ם רַחֲמָיו וַחֲסָדָיו לְהַשְׁעִי</tei:l>
          <tei:l>יִשְׁעִ֗י מִשְׂגַּבִּי֙ וּמְנוּסִ֔י מֹשִׁעִ֕י׃ <tei:bibl>(שמואל ב׳ כב:ג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ki_ner_echenokh_shaashui_yoseh/2"/>
        <tei:lg>
          <tei:l>מִ֭צְוָה <tei:seg type="acrostic">דְּ</tei:seg>לִיקַת נֵרוֹת הַגָּשָׁתָם</tei:l>
          <tei:l><tei:seg type="acrostic">הִ</tei:seg>תְנַדְּבוּ מַטּוֹת כְּמִנְיַן גִּישָׁתָם</tei:l>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>אוֹר נְתִיבוֹת גִּשְׁמֵי פְּגִישָׁתָם</tei:l>
          <tei:l>וְחָיוּ֙ וְלֹ֣א יָמֻ֔תוּ בְּגִשְׁתָּ֖ם׃ <tei:bibl>(במדבר ד:יט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ki_ner_echenokh_shaashui_yoseh/3"/>
        <tei:lg>
          <tei:l>וְת֣וֹרָה א֑וֹר <tei:seg type="acrostic">זִ</tei:seg>קּוּק עֲלִילָתוֹ</tei:l>
          <tei:l><tei:seg type="acrostic">חֲ</tei:seg>נֻכַּת בַּֽיִת הַר נַחֲלָתוֹ</tei:l>
          <tei:l><tei:seg type="acrostic">טְ</tei:seg>הוֹרִים בִּקְדֻשָּׁה לְחַלּוֹתוֹ</tei:l>
          <tei:l>שִׂ֥ימוּ כָ֝ב֗וֹד תְּהִלָּתֽוֹ׃ <tei:bibl>(תהלים סו:ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ki_ner_echenokh_shaashui_yoseh/4"/>
        <tei:lg>
          <tei:l>וְדֶ֥רֶךְ <tei:seg type="acrostic">יְ</tei:seg>נַהֵל נְאוֹת אוּלָם</tei:l>
          <tei:l><tei:seg type="acrostic">כְּ</tei:seg>שָׂשׂ חֲנֻכּוֹת מֵעוֹלָם</tei:l>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>חִנּוּךְ שְׁבִיעִית הִפְעִילָם</tei:l>
          <tei:l>הַשְׁקֵ֥ט וָבֶ֖טַח עַד־עוֹלָֽם׃ <tei:bibl>(ישעיה כב:יז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ki_ner_echenokh_shaashui_yoseh/5"/>
        <tei:lg>
          <tei:l>חַ֝יִּ֗ים <tei:seg type="acrostic">מ</tei:seg>וֹצְאֵיהֶם מֵאִתּוֹ</tei:l>
          <tei:l><tei:seg type="acrostic">נָ</tei:seg>אוֹר עָשׁ כֹּל יָפֶה בְּעִתּוֹ</tei:l>
          <tei:l><tei:seg type="acrostic">סַ</tei:seg>מִּים וְנֵרוֹת עֹרְכוּ שְׁעוֹתוֹ</tei:l>
          <tei:l>חֲנֻכַּ֣ת הַמִּזְבֵּ֗חַ בְּיוֹם֙ הִמָּשַׁ֣ח אֹת֔וֹ׃ <tei:bibl>(במדבר ז:פד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ki_ner_echenokh_shaashui_yoseh/6"/>
        <tei:lg>
          <tei:l>תּוֹכְח֥וֹת <tei:seg type="acrostic">עֹ</tei:seg>ז תַּעֲצוּם סוֹדָיו</tei:l>
          <tei:l><tei:seg type="acrostic">פִּ</tei:seg>נַּת יִקְרַת בֹּחַן מוּסָדָיו</tei:l>
          <tei:l><tei:seg type="acrostic">צַ</tei:seg>חוּת חַשְׁמוֹנִים וְנִסֵּי חֲסָדָיו</tei:l>
          <tei:l>זַמְּר֣וּ לַיהֹוָ֣ה חֲסִידָ֑יו׃ <tei:bibl>(תהלים ל:ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ki_ner_echenokh_shaashui_yoseh/7"/>
        <tei:lg>
          <tei:l>מוּסָֽר <tei:seg type="acrostic">קָ</tei:seg>נַֽנִי נְתִיבוֹת שָׁלוֹם</tei:l>
          <tei:l><tei:seg type="acrostic">רִ</tei:seg>נּוּן שִׁיר חֲנֻכַּת נְוֵה שָׁלוֹם</tei:l>
          <tei:l><tei:seg type="acrostic">שַׁ</tei:seg>אֲלוּ וְדִרְשׁוּ אֶת שְׁלוֹם</tei:l>
          <tei:l><tei:seg type="acrostic">תּ</tei:seg>וֹלְדוֹת זֶֽרַע הַשָּׁלוֹם</tei:l>
          <tei:l>קַוֵּ֥ה לְשָׁל֖וֹם׃ <tei:bibl>(ירמיה ח:טו)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
