    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ofan_piyyut_for_the_shabbat_before_shavuot">
        <tei:head>אוֹפָן לשבת לפני שבעות</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ofan_piyyut_for_the_shabbat_before_shavuot/1"/>
        <tei:lg>
          <tei:l>קָד֧וֹשׁ ׀ קָד֛וֹשׁ קָד֖וֹשׁ יְהֹוָ֣ה צְבָא֑וֹת</tei:l>
          <tei:l>מְלֹ֥א כׇל־הָאָ֖רֶץ כְּבוֹדֽוֹ׃ <tei:bibl>(ישעיה ו:ג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ofan_piyyut_for_the_shabbat_before_shavuot/2"/>
        <tei:lg>
          <tei:l>אׇרְחוֹת אֶרְאֶלִּים יַקְדִּֽישׁוּ בְּרִדְתּוֹ לְסִינָי</tei:l>
          <tei:l>מְלֹ֥א כׇל־הָאָ֖רֶץ כְּבוֹדֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ofan_piyyut_for_the_shabbat_before_shavuot/3"/>
        <tei:lg>
          <tei:l>בְּרוּאֵי בְרָקִים יִרְעֲדוּ בְּבֹאוֹ לְסִינָי</tei:l>
          <tei:l>מְלֹ֥א כׇל־הָאָ֖רֶץ כְּבוֹדֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ofan_piyyut_for_the_shabbat_before_shavuot/4"/>
        <tei:lg>
          <tei:l>כְּבוֹדוֹ נִגְלָה עַל־הַר סִינָי</tei:l>
          <tei:l>וּמַלְכוּתוֹ עַל־הַר סִינָי</tei:l>
          <tei:l>אָמוֹן אֶצְלוֹ מַתְּנַת סִינָי</tei:l>
          <tei:l>וְדִבְּרוֹת עֲשָׂרָה שָׁמְעוּ בְּסִינָי</tei:l>
          <tei:l>וַיְקַבְּלוּ הֲלָכָה לְמֹשֶׁה מִסִּינַי׃</tei:l>
          <tei:l>קָדוֹשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ofan_piyyut_for_the_shabbat_before_shavuot/5"/>
        <tei:lg>
          <tei:l>גְּנוּזֵי גַּלְגַּלִּים הִלְלוּ וְרוֹמְמוּ בְּסִינָי</tei:l>
          <tei:l>מְלֹ֥א כׇל־הָאָ֖רֶץ כְּבוֹדֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ofan_piyyut_for_the_shabbat_before_shavuot/6"/>
        <tei:lg>
          <tei:l>דִּגְלֵי דְבֵקִים יַאֲדִירוּ בְּפׇצְחוֹ בְּסִינָי</tei:l>
          <tei:l>מְלֹ֥א כׇל־הָאָ֖רֶץ כְּבוֹדֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ofan_piyyut_for_the_shabbat_before_shavuot/7"/>
        <tei:lg>
          <tei:l>הוֹגֵי הֲדוּרִים מְפָאֲרִים בְּשׁוּרוֹ בְּסִינָי</tei:l>
          <tei:l>מְלֹ֥א כׇל־הָאָ֖רֶץ כְּבוֹדֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ofan_piyyut_for_the_shabbat_before_shavuot/8"/>
        <tei:lg>
          <tei:l>וְרָצִים וְשָׁבִים מִתְיַחֲדִים בְּהַטּוֹתוֹ לְסִינָי</tei:l>
          <tei:l>מְלֹ֥א כׇל־הָאָ֖רֶץ כְּבוֹדֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ofan_piyyut_for_the_shabbat_before_shavuot/9"/>
        <tei:lg>
          <tei:l>זִקֵּי זֹהֲרִים זֹרָֽזוּ בְּהַשְׁגִּיחוֹ עַל הַר סִינָי</tei:l>
          <tei:l>מְלֹ֥א כׇל־הָאָ֖רֶץ כְּבוֹדֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ofan_piyyut_for_the_shabbat_before_shavuot/10"/>
        <tei:lg>
          <tei:l>חֲיָלֵי חַשְׁמַלִּים רָעֲשׁוּ בְסִינָי</tei:l>
          <tei:l>מְלֹ֥א כׇל־הָאָ֖רֶץ כְּבוֹדֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ofan_piyyut_for_the_shabbat_before_shavuot/11"/>
        <tei:lg>
          <tei:l>טַפְסְרֵי טְפוּחִים רָקְדוּ בְסִינָי</tei:l>
          <tei:l>מְלֹ֥א כׇל־הָאָ֖רֶץ כְּבוֹדֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ofan_piyyut_for_the_shabbat_before_shavuot/12"/>
        <tei:lg>
          <tei:l>יְקָרִים יוֹקְדִים דָּצוּ בְסִינָי</tei:l>
          <tei:l>מְלֹ֥א כׇל־הָאָ֖רֶץ כְּבוֹדֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ofan_piyyut_for_the_shabbat_before_shavuot/13"/>
        <tei:lg>
          <tei:l>קְהַל קְדוֹשִׁים קָֽמוּ בְסִינָי</tei:l>
          <tei:l>מְלֹ֥א כׇל־הָאָ֖רֶץ כְּבוֹדֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ofan_piyyut_for_the_shabbat_before_shavuot/14"/>
        <tei:lg>
          <tei:l>רָאוּ רֶֽכֶב רִבֹּתַֽיִם אַלְפֵי שִׁנְאָן בְּסִינָי</tei:l>
          <tei:l>מְלֹ֥א כׇל־הָאָ֖רֶץ כְּבוֹדֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ofan_piyyut_for_the_shabbat_before_shavuot/15"/>
        <tei:lg>
          <tei:l>שַֽׁאַג שׁוֹפָרוֹת שָׁמְעוּ בְּסִינָי</tei:l>
          <tei:l>מְלֹ֥א כׇל־הָאָ֖רֶץ כְּבוֹדֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ofan_piyyut_for_the_shabbat_before_shavuot/16"/>
        <tei:lg>
          <tei:l>תּוֹרָה תְּמִימָה תִּכְבַּדְתָּם בְּסִינָי</tei:l>
          <tei:l>מְלֹ֥א כׇל־הָאָ֖רֶץ כְּבוֹדֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ofan_piyyut_for_the_shabbat_before_shavuot/17"/>
        <tei:lg>
          <tei:l>וְהַחַיּוֹת יְשׁוֹרֵֽרוּ</tei:l>
          <tei:l>וּכְרוּבִים יְפָאֵֽרוּ</tei:l>
          <tei:l>וּשְׂרָפִים יָרֹֽנּוּ</tei:l>
          <tei:l>וְאֶרְאֶלִּים יְבָרֵֽכוּ</tei:l>
          <tei:l>פְּנֵי כׇּל־חַיָּה</tei:l>
          <tei:l>וְאוֹפָן וּכְרוּב</tei:l>
          <tei:l>לְעֻמַּת שְׂרָפִים</tei:l>
          <tei:l>לְעֻמָּתָם מְשַׁבְּחִים וְאוֹמְרִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ofan_piyyut_for_the_shabbat_before_shavuot/18"/>
        <tei:lg>
          <tei:l>בָּר֥וּךְ כְּבוֹד־יְהֹוָ֖ה מִמְּקוֹמֽוֹ׃ <tei:bibl>(יחזקאל ג:יב)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
