  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:maariv_aravim_22068">
        <tei:head>מַעֲרִיב עֲרָבִים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:maariv_aravim_22068/1"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ אֱלֹהֵֽינוּ מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>אֲשֶׁר בִּדְבָרוֹ</tei:l>
          <tei:l>מַעֲרִיב עֲרָבִים׃</tei:l>
          <tei:l>בְּחָכְמָה</tei:l>
          <tei:l>פּוֹתֵֽחַ שְׁעָרִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:maariv_aravim_22068/2"/>
        <tei:lg>
          <tei:l>וּבִתְבוּנָה מְשַׁנֶּה עִתִּים</tei:l>
          <tei:l>וּמַחֲלִיף</tei:l>
          <tei:l>אֶת הַזְּמַנִּים</tei:l>
          <tei:l>וּמְסַדֵּר אֶת הַכּוֹכָבִים</tei:l>
          <tei:l>בְּמִשְׁמְרוֹתֵֽיהֶם בָּרָקִֽיעַ כְּרְצוֹנוֹ:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:maariv_aravim_22068/3"/>
        <tei:lg>
          <tei:l>בּוֹרֵא יוֹם וָלָֽיְלָה</tei:l>
          <tei:l>גּוֹלֵל אוֹר מִפְּנֵי חֹֽשֶׁךְ וְחֹֽשֶׁךְ מִפְּנֵי אוֹר:</tei:l>
          <tei:l>וּמַעֲבִיר יוֹם</tei:l>
          <tei:l>וּמֵֽבִיא לָֽיְלָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:maariv_aravim_22068/4"/>
        <tei:lg>
          <tei:l>וּמַבְדִּיל בֵּין יוֹם וּבֵין לָֽיְלָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:maariv_aravim_22068/5"/>
        <tei:lg>
          <tei:l>יְיָ צְבָאוֹת</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>שְׁמוֹ:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:maariv_aravim_22068/6"/>
        <tei:lg>
          <tei:l>אֵל חַי וְקַיָּם</tei:l>
          <tei:l>תָּמִיד</tei:l>
          <tei:l>יִמְלוֹךְ עָלֵֽינוּ לְעוֹלָם וָעֶד:</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>הַמַּעֲרִיב עֲרָבִים:</tei:l>
        </tei:lg>
      </tei:div>
