    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_the_royal_family_of_queen_victoria_varady">
        <tei:head>הַנּוֹתֵן תְּשׁוּעָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_royal_family_of_queen_victoria_varady/1"/>
        <tei:lg>
          <tei:l>הַנּוֹתֵן תְּשׁוּעָה לַמְּלָכִים</tei:l>
          <tei:l>וּמֶמְשָׁלָה לַנְּסִיכִים</tei:l>
          <tei:l>מַלְכוּתוֹ מַלְכוּת כׇּל־עוֹלָמִים</tei:l>
          <tei:l>הַפּוֹצֶה אֶת דָּוִד עַבְדּוֹ מֵחֶרֶב רָעָה.</tei:l>
          <tei:l>הַנּוֹתֵן בַּיָּם דֶּרֶךְ</tei:l>
          <tei:l>וּבְמַיִם עַזִּים נְתִיבָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_royal_family_of_queen_victoria_varady/2"/>
        <tei:lg>
          <tei:l>הוּא יְבָרֵךְ וְיִשְׁמוֹר וְיִנְצוֹר וְיַעֲזוֹר</tei:l>
          <tei:l>וִירוֹמֵם וִיגַדֵּל וִינַשֵּׂא לְמַעְלָה</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>יָרוּם הוֹדָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_royal_family_of_queen_victoria_varady/3"/>
        <tei:lg>
          <tei:l>מֶלֶךְ מַלְכֵי הַמְּלָכִים</tei:l>
          <tei:l>בְּרַחֲמָיו יְחַיֶהָ וְיִשְׁמְרֶהָ</tei:l>
          <tei:l>וּמִכָּל צָרָה וְיָגוֹן וָנֶזֶק יַצִּילֶהָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_royal_family_of_queen_victoria_varady/4"/>
        <tei:lg>
          <tei:l>וַיְדַבֵּר עַמִּים תַּחַת רַגְלֶיהָ</tei:l>
          <tei:l>וְיַפִּיל שׂוֹנְאֶיהָ לְפָנֶיהָ</tei:l>
          <tei:l>וּבְכָל אֲשֶׁר תִּפְנֶה תַצְלִיחַ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_royal_family_of_queen_victoria_varady/5"/>
        <tei:lg>
          <tei:l>מֶלֶךְ מַלְכֵי הַמְּלָכִים</tei:l>
          <tei:l>בְּרַחֲמָיו יִתֵּן בְּלִבָּהּ</tei:l>
          <tei:l>וּבְלֵב כׇּל יוֹעֲצֶיהָ וְשָׂרֶיהָ</tei:l>
          <tei:l>רַחֲמָנוֹת לַעֲשׂוֹת טוֹבָה עִמָּנוּ</tei:l>
          <tei:l>וְעִם כׇּל יִשְׂרָאֵל.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_royal_family_of_queen_victoria_varady/6"/>
        <tei:lg>
          <tei:l>בְּיָמֶיהָ וּבְיָמֵינוּ תִּוָּשַׁע יְהוּדָה.</tei:l>
          <tei:l>וְיִשְׂרָאֵל יִשְׁכּוֹן לָבֶטַח</tei:l>
          <tei:l>וּבָא לְצִיּוֹן גּוֹאֵל.</tei:l>
          <tei:l>וְכֵן יְהִי רָצוֹן</tei:l>
          <tei:l>וְנֺאמַר אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
