  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:avinu_shebashamayim_obadyah">
        <tei:head>אָבִינוּ שֶׁבַּשָּׁמַיִם</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:avinu_shebashamayim_obadyah/1"/>
        <tei:lg>
          <tei:l>אָבִ֫ינוּ שֶׁבַּשָּׁמַ֫יִם,</tei:l>
          <tei:l>שְׁמַע קוֹלֵ֫נוּ וְקַבֵּל תְּפִלָּתֵ֫נוּ בְּרָצוֹן:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:avinu_shebashamayim_obadyah/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אַ</tei:seg>ל תְּאַבְּדֵ֫נוּ בְּאֹרֶךְ גָּלוּתֵ֫נוּ:</tei:l>
          <tei:l><tei:seg type="acrostic">בַּ</tei:seg>שְֹּרֵ֫נוּ בְּשׂוֹרוֹת טוֹבוֹת:</tei:l>
          <tei:l><tei:seg type="acrostic">גְּ</tei:seg>זֹר עָלֵ֫ינוּ גְּזֵרוֹת טוֹבוֹת:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:avinu_shebashamayim_obadyah/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">דְּ</tei:seg>רַשְׁנ֫וּךָ הִמָּצֵא לָ֫נוּ:</tei:l>
          <tei:l><tei:seg type="acrostic">הֵ</tei:seg>עָתֵר לָ֫נוּ הַיּוֹם וּבְכָ֯ל יוֹם וָיוֹם בִּתְפִלָּתֵ֫נוּ:</tei:l>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>נִקְרָא וְאַתָּה תַעֲנֵ֫נוּ:</tei:l>
          <tei:l><tei:seg type="acrostic">זָ̊</tei:seg>כְרֵ֫נוּ בְּזִכְרוֹן טוֹב מִלְּפָנֶ֫יךָ:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:avinu_shebashamayim_obadyah/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ח</tei:seg>וּס וְרַחֵם עָלֵ֫ינוּ:</tei:l>
          <tei:l><tei:seg type="acrostic">טַ</tei:seg>הֲרֵ֫נוּ מֵעֲווֹנֵ֫ינוּ:</tei:l>
          <tei:l><tei:seg type="acrostic">יֶ</tei:seg>הֱמוּ נָא רַחֲמֶ֫יךָ עָלֵ֫ינוּ:</tei:l>
          <tei:l><tei:seg type="acrostic">כְּ</tei:seg>בֹשׁ אֶת עֲווֺנוֹתֵ֫נוּ:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:avinu_shebashamayim_obadyah/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>חַם אֶת לוֹחֲמֵ֫ינוּ:</tei:l>
          <tei:l><tei:seg type="acrostic">מַ</tei:seg>לֵּא מִשְׁאֲלוֹת לִבֵּ֫נוּ לְטוֹבָה לַעֲבוֹדָתֶ֫ךָ:</tei:l>
          <tei:l><tei:seg type="acrostic">נָ</tei:seg>א חוּסָה כְּרֹב רַחֲמֶ֫יךָ:</tei:l>
          <tei:l><tei:seg type="acrostic">סְ</tei:seg>מֹךְ אֶת נְפִילָתֵ֫נוּ:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:avinu_shebashamayim_obadyah/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">עֲ</tei:seg>נֵ֫נוּ בְּיוֹם קָ֯רְאֵ֫נוּ:</tei:l>
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>דֵ֫נוּ מִידֵי כָּ̊ל צָרָה:</tei:l>
          <tei:l><tei:seg type="acrostic">צַ</tei:seg>דְּקֵ֫נוּ בְּמִשְׁפָּטֶ֫יךָ:</tei:l>
          <tei:l><tei:seg type="acrostic">קָ֯</tei:seg>רְבֵ֫נוּ לַעֲבוֹדָתֶ֫ךָ:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:avinu_shebashamayim_obadyah/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רְ</tei:seg>אֵה בְּדֹחַק הַשָּׁעָה:</tei:l>
          <tei:l><tei:seg type="acrostic">שִׁ</tei:seg>ית שָׁלוֹם בֵּינֵ֫ינוּ:</tei:l>
          <tei:l><tei:seg type="acrostic">תֵּ</tei:seg>ן שָׁלוֹם בָּאָ֫רֶץ:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:avinu_shebashamayim_obadyah/8"/>
        <tei:lg>
          <tei:l>וְכֵן יְהִי רָצוֹן</tei:l>
          <tei:l>וְנֹאמַר אָמֵן.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
