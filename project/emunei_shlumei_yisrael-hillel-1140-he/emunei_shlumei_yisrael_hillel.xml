    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel">
        <tei:head>אֱמוּנֵי שְׁלוּמֵי יִשְׂרָאֵל</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אֱ</tei:seg>מוּנֵי שְׁלוּמֵי יִשְׂרָאֵל גִּזְרָתָם כְּשֹֽׁהַם</tei:l>
          <tei:l>נְטַשְׁתָּם זְנַחְתָּם וְהָיִֽיתָ כְּגִבּוֹר נִדְהָם</tei:l>
          <tei:l>בְּתִתְּךָ בְּיַד רָשָׁע הַמְּזֹהָם</tei:l>
          <tei:l>נְדִ֘יבֵ֤י עַמִּ֨ים ׀ נֶאֱסָ֗פוּ עַם֮ אֱלֹהֵ֢י אַבְרָ֫הָ֥ם <tei:bibl>(תהלים מז:י)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>עֶשְׂרִים בְּסִיוָן גּוֹמֵר פֵּרוֹת וּמַפְרִֽיחַ</tei:l>
          <tei:l>בְּתַתְּקְלָ״א לִפְרָט נִתְּנוּ בְיָדוֹ לְהַכְרִֽיחַ</tei:l>
          <tei:l>כְּאֶחָד נִתְרַצּוּ לְהַעֲלוֹת לְאִשִּׁים לְהַרִֽיחַ</tei:l>
          <tei:l>הַֽדּוּדָאִ֣ים נָֽתְנוּ־רֵ֗יחַ <tei:bibl>(שיר השירים ז:יד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">גָּ</tei:seg>מַר לְכַלּוֹת נַפְשָׁם בְּלִי פִּדְיוֹם</tei:l>
          <tei:l>בַּעֲצַת הָרָשָׁע הַמְּנֻוָּל לְהַרְחִיק הַתְּיוֹם</tei:l>
          <tei:l>נְתָנָם בְּמִגְדָּל לְהַכְרִיחָם אָיֹם</tei:l>
          <tei:l>אַ֣ךְ בִּ֥י יָשֻׁ֛ב יַהֲפֹ֥ךְ יָד֖וֹ כׇּל־הַיּֽוֹם׃ <tei:bibl>(איכה ג:ג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">דָּ</tei:seg>בָר זֶה כְּשׇׁמְעָם נִתְרַצּוּ יַֽחַד</tei:l>
          <tei:l>כִּבְסִין נַעֲשֶׂ֥ה וְנִשְׁמָֽע <tei:bibl>(שמות כד:ז)</tei:bibl> לְהָשִׁיב כְּאֶחָד</tei:l>
          <tei:l>כֻּלָּם בְּנֵי אִישׁ אֶחָד</tei:l>
          <tei:l>מִטָּה הַמֻּשְׁלֶֽמֶת מִלְּהִכָּחֵד</tei:l>
          <tei:l>שְׁמַ֖ע יִשְׂרָאֵ֑ל יְהֹוָ֥ה אֱלֹהֵ֖ינוּ יְהֹוָ֥ה ׀ אֶחָֽד׃ <tei:bibl>(דברים ד:ו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הֵ</tei:seg>ם כְּעָנוּ עָלָיו נַשְׁלִיךְ יַהַב</tei:l>
          <tei:l>וְלֹא נָשִׂים כִּסְלֵֽינוּ בֵּאלֹהֵי זָהָב</tei:l>
          <tei:l>לַעֲרֹךְ מַעֲרָכָה צִוָּה קְדוֹשִׁים לְהַבְהֵב</tei:l>
          <tei:l>וַיְהִי֩ בַעֲל֨וֹת הַלַּ֜הַב <tei:bibl>(שופטים יג:כ)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וַ</tei:seg>יֹּאמְרוּ לְהוֹצִיא אוֹתָם לְבֵית הַשְּׂרֵפָה</tei:l>
          <tei:l>יַחְדָּו שָׂמְחוּ כְּהַכְנָסַת כַּלָּה לְחֻפָּה</tei:l>
          <tei:l>עָלֵֽינוּ לְשַׁבֵּֽחַ שִׁבְּחוּ בְּנֶֽפֶשׁ כְּסוּפָה</tei:l>
          <tei:l>הִנָּ֨ךְ יָפָ֤ה רַעְיָתִי֙ הִנָּ֣ךְ יָפָ֔ה <tei:bibl>(שיר השירים ד:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זִ</tei:seg>וְּגוּ יַֽחַד פִּרְחֵי כְּהֻנָּה בַּעֲנִיבָתָם</tei:l>
          <tei:l>יְחִיאֵל וִיקוּתִיאֵל בִּכְהֻנָּה וּבְשֵׁרוּתָם</tei:l>
          <tei:l>בְּאַהַב נִמְתְּחוּ עַל־הָעַמּוּד לִכְפּוֹתָם</tei:l>
          <tei:l>הַנְּעִימִם֙ בְּחַיֵּיהֶ֔ם וּבְמוֹתָ֖ם <tei:bibl>(שמואל ב׳ א:כג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חֻ</tei:seg>תְּמוּ בְּחוֹתַם קֹֽדֶשׁ בַּחוּרִים וִישִׁישִׁים</tei:l>
          <tei:l>וְעָלוּ לְמִנְיָן וְהֵם אֶחָד וּשְׁלֹשִׁים</tei:l>
          <tei:l>יְהוּדָה וְיִצְחָק מֹשֶׁה חֲסִידִים מְאֻשָּׁשִׁים</tei:l>
          <tei:l>וִיהוּדָ֗ה עֹ֥ד רָד֙ עִם־אֵ֔ל וְעִם־קְדוֹשִׁ֖ים <tei:bibl>(הושע יב:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">טְ</tei:seg>בוּעִים בְּחוֹתָמָם אַרְבָּעָה בְּלִי כַחַד</tei:l>
          <tei:l>בָּרוּךְ וּשְׁמוּאֵל אָחִיו נִגְוְעוּ כְּאַחַד</tei:l>
          <tei:l>מְנַחֵם וִיהוּדָה אַחִים בְּאֵימָה וָפַחַד</tei:l>
          <tei:l>הִנֵּ֣ה מַה־טּ֭וֹב וּמַה־נָּעִ֑ים שֶׁ֖בֶת אַחִ֣ים גַּם־יָֽחַד׃ <tei:bibl>(תהלים קלג:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel/10"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יַ</tei:seg>חַד הַנָּשִׁים לְבֵית הַמּוֹקֵד בְּחֵילֵךְ</tei:l>
          <tei:l>אִשָּׁה רְעוּתָהּ מְזָרֶֽזֶת לְמַהֵר וְלֵילֵךְ</tei:l>
          <tei:l>שְׁבַע עֶשְׂרֵה מֵהֶם נִמְנוּ בְּפֶֽלֶךְ</tei:l>
          <tei:l>בִּשְׂמָחֹ֣ת וָגִ֑יל תְּ֝בֹאֶ֗ינָה בְּהֵ֣יכַל מֶֽלֶךְ׃ <tei:bibl>(תהלים מה:טז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel/11"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כְּ</tei:seg>הַגִּֽיעַ הָאֵשׁ לַאֲסִירֵי יְדֵי הַכֹּהֲנִים</tei:l>
          <tei:l>נִתְּקוּ הַמּוֹסֵרוֹת מֵעַל־יְדֵי הַבָּנִים</tei:l>
          <tei:l>צָרְחוּ צְרָפַֽתְנוּ הָאֵשׁ וְיָצָֽאנוּ כֵנִים</tei:l>
          <tei:l>יִ֥תְיַצְּב֨וּ ׀ מַלְכֵי־אֶ֗רֶץ וְרוֹזְנִ֥ים <tei:bibl>(תהלים ב:ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel/12"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">לֹ</tei:seg>א שַׁךְ חֲרוֹן הַצּוֹרֵר מֵעֲלֵֽיהֶם</tei:l>
          <tei:l>צִוָּה עֲבָדָיו לְהַחֲזִירָם לְבֵית מוֹקְדֵֽיהֶם</tei:l>
          <tei:l>הַכֵּה וּפָצוֹעַ הִכּוּם בְּאָלוֹת וּבְמַקְלוֹתֵֽיהֶם</tei:l>
          <tei:l>תָּשִׁ֨יב לָהֶ֥ם גְּמ֛וּל יְהֹוָ֖ה כְּמַעֲשֵׂ֥ה יְדֵיהֶֽם׃ <tei:bibl>(איכה ג:סד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel/13"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מַ</tei:seg>לְאֲכֵי מַֽעְלָה יִבְכָּיוּן עַל־דַּאֲבוֹנָי</tei:l>
          <tei:l>כִּי רַבּוּ מַכְאוֹבַי וְגָדְלוּ יְגוֹנָי</tei:l>
          <tei:l>שְׁלֽשֶׁת הַגִּבּוֹרִים אֲשֶׁר נָפְלוּ לְפָנָי</tei:l>
          <tei:l>וַיַּצִּקֻ֖ם לִפְנֵ֥י יְהֹוָֽה׃ <tei:bibl>(יהושע ז:כג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel/14"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נ</tei:seg>וֹרָא וְאַדִּיר צוֹפֶה בְּעֶלְבּוֹן יְרֵאָיו</tei:l>
          <tei:l>לְבָרֵר לְקׇרְבְּנוֹתָיו מְשַׁבְּחָיו בַּנָּאָיו</tei:l>
          <tei:l>בְּאֵֽלֶּה הַחֲסִידִים אֲשֶׁר־נִקְרְאוּ מְקֹרָאָיו</tei:l>
          <tei:l>הֵכִ֧ין יְהֹוָ֛ה זֶ֖בַח הִקְדִּ֥ישׁ קְרֻאָֽיו׃ <tei:bibl>(צפניה א:ז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel/15"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">סֶֽ</tei:seg>מֶךְ וְתֹֽקֶף אוֹת וּפֶֽלֶא לְגַדְּלָה</tei:l>
          <tei:l>שְׂרֵפַת נְשָׁמָה וְגוּף לֹא־כָלָה</tei:l>
          <tei:l>עַֽיִן רָאֲתָה וְאֹֽזֶן שָׁמְעָה וּמִלְּלָה</tei:l>
          <tei:l>נֵּ֭ס לְהִתְנוֹסֵ֑ס מִ֝פְּנֵ֗י קֹ֣שֶׁט סֶֽלָה׃ <tei:bibl>(תהלים ס:ו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel/16"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">עָ</tei:seg>מְדוּ בְנִסְיוֹנָם וְקִבְּלוּ דִין בַּעֲלִיזוֹת</tei:l>
          <tei:l>וְלֹא נָסֹג אָחוֹר לֵב וְעֵינַֽיִם נְלוֹזוֹת</tei:l>
          <tei:l>רְאוּיִם לִקְבּֽוֹעַ תְּפִלּוֹת עֲזִיזוֹת</tei:l>
          <tei:l>וַנָּצ֛וּמָה וַנְּבַקְשָׁ֥ה.. עַל־זֹ֑את <tei:bibl>(עזרא ח:כג עם שנוי לשון)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel/17"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>דוּת וְכַפָּרָה יְחוֹקְקוּ לִישֻׁרוּן בַּסֵּֽפֶר</tei:l>
          <tei:l>תַּעֲמוֹד זְכוּתָם לְעֻמָּם כַּֽעַס לְהָפֵר</tei:l>
          <tei:l>עַ֧ל הַכֹּהֲנִ֛ים וְעַל־כׇּל־עַ֥ם הַקָּהָ֖ל יְכַפֵּֽר׃ <tei:bibl>(ויקרא טז:לג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel/18"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">צַ</tei:seg>דִּיק יִצְרַח אָפְסוּ חֲסִידֵי הַזֶּֽבַח</tei:l>
          <tei:l>חֲנַנְיָה וַחֲבֵרָיו מָסְרוּ נַפְשָׁם לָאֶֽבַח</tei:l>
          <tei:l>רַבִּי עֲקִֽיבָא וַחֲבֵירָיו בַּעֲלֵי הַטֶּֽבַח</tei:l>
          <tei:l>כֹּרְתֵ֖י בְרִיתִ֣י עֲלֵי־זָֽבַח׃ <tei:bibl>(תהלים נ:ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel/19"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>דוֹשׁ זָכֹר יִזְכֹּר זֹאת הָעֲקֵדָה</tei:l>
          <tei:l>עִם עֲקֵדַת יִצְחָק אוֹתָהּ לְהֵעָנְדָה</tei:l>
          <tei:l>רְצוּיָה וַעֲשׂוּיָה כַּדָּת וְכִתְעוּדָה</tei:l>
          <tei:l>זֹ֥את תּוֹרַ֖ת הָעֹלָ֑ה הִ֣וא הָעֹלָ֡ה עַל֩ <tei:hi rend="subscript">מ</tei:hi>וֹקְדָ֨ה‏ <tei:bibl>(ויקרא ו:ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel/20"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רָ</tei:seg>אֹה תִרְאֶה בְּעֳנִי יִשְׂרָאֵל</tei:l>
          <tei:l>וְקַנֵּא לְשִׁמְךָ הַגָּדוֹל לְחׇרְבוֹת אֲרִיאֵל</tei:l>
          <tei:l>וּלְדַם חֲסִידֶֽךָ הַשָּׁפוּךְ הוֹאֵל</tei:l>
          <tei:l>נְקֹ֗ם נִקְמַת֙ בְּנֵ֣י יִשְׂרָאֵ֔ל <tei:bibl>(במדבר לא:ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel/21"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שְׁ</tei:seg>פִיכַת דַּם חֲסִידֶֽיךָ לְעֵינֵֽינוּ תוֹדִֽיעַ</tei:l>
          <tei:l>וְעַד־מָתַי תִּהְיֶה כְּגִבּוֹר לֹא־יוּכַל לְהוֹשִֽׁיעַ</tei:l>
          <tei:l>אוֹיְבַי רִיב תָּרִיב וּדְמֵיהֶם תַּשְׁפִּֽיעַ</tei:l>
          <tei:l>אֵל־נְקָמ֥וֹת יְהֹוָ֑ה אֵ֖ל נְקָמ֣וֹת הוֹפִֽיעַ׃ <tei:bibl>(תהלים צד:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel/22"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">תָּ</tei:seg>בֹא תְפִלָּתִי לְפָנֶֽיךָ לְמַֽעְלָה לְמָֽעְלָה</tei:l>
          <tei:l>אֶנְקַת אָסִיר וּדְמֵי חֲסִידֶֽיךָ לְהִתְקַבְּלָה</tei:l>
          <tei:l>בַּהֲבִיאֲךָ עַל־הָאוֹיֵב נֶחֱרָצָה וְכָלָה</tei:l>
          <tei:l>תַּבַּ֣עְנָה שְׂפָתַ֣י תְּהִלָּ֑ה <tei:bibl>(תהלים קיט:קעא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel/23"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הַ</tei:seg>קֹּל֙ ק֣וֹל יַעֲקֹ֔ב <tei:bibl>(בראשית כז:כב)</tei:bibl> בִּצְוָחָה וּבִנְהִימָה</tei:l>
          <tei:l>מִדַּם שֶׁשָּׁפְכוּ יְדֵי עֵשָׁו לְהִנָּקְמָה</tei:l>
          <tei:l>שְׂרֵפַת בֵּית הַבְּחִירָה וְתוֹרְתְךָ הַמְרוֹמָמָה</tei:l>
          <tei:l>תּ֘וֹרַ֤ת יְהֹוָ֣ה תְּ֭מִימָה <tei:bibl>(תהלים יט:ח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel/24"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יִ</tei:seg>תְאַשְּׁרוּ עַל־מְחִיצָתָן הֲרוּגֵי בְלוּיֵשׁ</tei:l>
          <tei:l>לֹא נִסְתַּפְּקוּ לוֹמַר יְהֹוָה בְּקִרְבֵּֽינוּ הַיֵשׁ <tei:bibl>(שמות יז:ז עם שנוי לשון)</tei:bibl></tei:l>
          <tei:l>נִתְחַזְקוּ בְּמָעוּזָם כְּמוֹ אַרְיֵה וָלַיִשׁ</tei:l>
          <tei:l>לְהַנְחִ֖יל אֹהֲבַ֥י ׀ יֵ֑שׁ <tei:bibl>(משלי ח:כא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel/25"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">לָ</tei:seg>נֶֽצַח יָרִיב רִיבָם לְמַֽעַן שְׁמוֹ</tei:l>
          <tei:l>יִוָדַע בַּגּוֹיִם לְעֵינֵֽינוּ תְּשׁוּעַת נוֹאֲמוֹ</tei:l>
          <tei:l>מֵרֹ֖אשׁ פַּרְע֥וֹת אוֹיֵֽב <tei:bibl>(דברים לב:מב)</tei:bibl> מְהֵרָה בְּהִנָּקְמוֹ</tei:l>
          <tei:l>הַרְנִ֤ינוּ גוֹיִם֙ עַמּ֔וֹ <tei:bibl>(דברים לב:מג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel/26"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>עֵֽמֶק הוֹרִידוּם בְּלֹא־קֶֽבֶר לְהִשָּׁפֵט</tei:l>
          <tei:l>רְאֵה וְהַבִּֽיטָה אֱלֹהֵי הַמִּשְׁפָּט</tei:l>
          <tei:l>קַיֶּם־נָא בְּאוֹיְבַי הֶחָזוֹן וְהַמִּשְׁפָּט</tei:l>
          <tei:l>וְה֣וֹרַדְתִּ֔ים אֶל־עֵ֖מֶק יְהוֹשָׁפָ֑ט <tei:bibl>(יואל ד:ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel/27"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בִּ</tei:seg>י<tei:seg type="acrostic">נָ</tei:seg>ה הֲגִיגִי אֱלֹהֵי תְהִלָּתִי וְתוֹחַלְתִּי</tei:l>
          <tei:l>שִׂימָה בְנֹאדְךָ וּלְפָנֶֽיךָ דִּמְעַת לֶחֱיָתִי</tei:l>
          <tei:l>קַיֶּם־נָא מְהֵרָה חֶזְיוֹן נְבוּאָתִי</tei:l>
          <tei:l>וְנִקֵּ֖יתִי דָּמָ֣ם לֹֽא־נִקֵּ֑יתִי <tei:bibl>(יואל ד:כא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel/28"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יַעַ</tei:seg>ן עָֽבְרוּ חֹק וְחָלְפוּ תְעוּדָה</tei:l>
          <tei:l>מִקְדָּשַׁי וְצִיּוֹן חָרְשׁוּ רֵיקָם לְהַעֲמִידָה</tei:l>
          <tei:l>נִקְמַת הַדָּם וְנִקְמַת הֶחָמָס תַּצְמִידָה</tei:l>
          <tei:l>מֵֽחֲמַס֙ בְּנֵ֣י יְהוּדָ֔ה <tei:bibl>(יואל ד:יט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel/29"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קַבֶּ</tei:seg>ל־נָא צְקוֹנִי אֵל עֶלְיוֹן</tei:l>
          <tei:l>חִישׁ מִפְלָט וְהַצֵּל עַמְּךָ הָאֶבְיוֹן</tei:l>
          <tei:l>תָּשִׁיב עִירְךָ וְנָוְךָ כְּמִקֶּֽדֶם בְּצִבְיוֹן</tei:l>
          <tei:l>וַיהֹוָ֖ה שֹׁכֵ֥ן בְּצִיּֽוֹן׃ <tei:bibl>(יואל ד:כא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:emunei_shlumei_yisrael_hillel/30"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חָזָק וְאַמִּיץ אָמֵן</tei:seg> יֵאָמֵן בֶּאֱמוּנָה</tei:l>
          <tei:l>דְּבָרוֹ הַטּוֹב יְמַהֵר וְיָחִישׁ לַהֲקִימֶֽנָּה</tei:l>
          <tei:l>הֲמוֹן עִיר לְמַלֹּאוֹת וְאַרְמוֹן לְכוֹנְנָה</tei:l>
          <tei:l>וּפְדוּיֵ֨י יְהֹוָ֜ה יְשֻׁב֗וּן וּבָ֤אוּ צִיּוֹן֙ בְּרִנָּ֔ה <tei:bibl>(ישעיהו לה:י)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>