        <tei:lg>
          <tei:l>‏על פי ה׳ —</tei:l>
          <tei:l>מלמד שמת בנשיקה‏ <tei:bibl>(רש״י על במדבר לג:לח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kiss_of_death_meit/2"/>
        <tei:lg>
          <tei:l>נשיקה —</tei:l>
          <tei:l>דמיא כמשחל בניתא מחלבא <tei:bibl>(ברכות ח׳ א)</tei:bibl></tei:l>
        </tei:lg>
