            <tei:binary value="true"/>
          </tei:f>
        </tei:fs>
      </j:conditional>
      <tei:div type="colophon" subtype="notes">
        <tei:p>Dr. Daniel Matt shared this list of chronograms in a Facebook post on 29 August 2018.</tei:p>
      </tei:div>
      <j:endConditional target="#osp_21651_notes"/>
