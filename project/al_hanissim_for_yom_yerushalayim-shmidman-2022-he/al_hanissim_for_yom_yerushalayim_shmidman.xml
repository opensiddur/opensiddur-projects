    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:al_hanissim_for_yom_yerushalayim_shmidman">
        <tei:head>על הניסים ליום ירושלים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:al_hanissim_for_yom_yerushalayim_shmidman/1"/>
        <tei:lg>
          <tei:l>עַל הַנִּסִּים</tei:l>
          <tei:l>וְעַל הַפֻּרְקָן</tei:l>
          <tei:l>וְעַל הַגְּבוּרוֹת</tei:l>
          <tei:l>וְעַל הַתְּשׁוּעוֹת</tei:l>
          <tei:l>וְעַל הַמִּלְחָמוֹת שֶׁעָשִׂיתָ לַאֲבוֹתֵינוּ</tei:l>
          <tei:l>בַּיָּמִים הָהֵם בַּזְּמַן הַזֶּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:al_hanissim_for_yom_yerushalayim_shmidman/2"/>
        <tei:lg>
          <tei:l>בִּימֵי שַׁחֲרוּת מְדִינָתֵנוּ וְשִׁחְרוּר אֻמָּתֵנוּ,</tei:l>
          <tei:l>שָׁכַן בָּדָד לְבַב אַרְצֵנוּ, קִרְיַת מְשׂוֹשֵׂנוּ.</tei:l>
          <tei:l>הַכְּמֵהִים לַאֲבָנֶיהָ תִּנּוּ שְׁבָחֶיהָ,</tei:l>
          <tei:l>בְּחִירֵי מְשׁוֹרְרֶיךָ כְּכִנּוֹר לְשִׁירֶיהָ.</tei:l>
          <tei:l>מִבֵּין הַחֲרַכִּים צָצוּ בְּנֵי עַמְּךָ</tei:l>
          <tei:l>לְהַשְׂבִּיעַ עֵינָם מִשְּׂרִידֵי טוּב הֵיכָלֶךָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:al_hanissim_for_yom_yerushalayim_shmidman/3"/>
        <tei:lg>
          <tei:l>רָגְשׁוּ גּוֹיִים וְהִתְרוֹעֲעוּ,</tei:l>
          <tei:l>עָמְדוּ עָלֵינוּ לְכַלּוֹתֵנוּ.</tei:l>
          <tei:l>נֶגְדָּם אָזְרוּ חַיִל גְּדוּדֵי בָּנֶיךָ,</tei:l>
          <tei:l>וּבְרִיתְךָ אֶת אֲבוֹתֵינוּ לָנוּ קִיַּמְתָּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:al_hanissim_for_yom_yerushalayim_shmidman/4"/>
        <tei:lg>
          <tei:l>הַר קָדְשְׁךָ בְּיָדֵינוּ הִפְקַדְתָּ,</tei:l>
          <tei:l>וְשַׁעֲרֵי שָׁלֵם לָנוּ פָּתַחְתָּ.</tei:l>
          <tei:l>דַּרְכֵי צִיּוֹן צָהֲלוּ בִּמְחוֹלוֹת חוֹגְגֶיךָ,</tei:l>
          <tei:l>וּפַעֲמֵי רַגְלֵינוּ הֵשַׁבְתָּ לַהֲדוֹם רַגְלֶיךָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:al_hanissim_for_yom_yerushalayim_shmidman/5"/>
        <tei:lg>
          <tei:l>וְהִנֵּה חוֹזוֹת עֵינֵינוּ בִּזְרִיחַת אוֹר פָּנֶיךָ</tei:l>
          <tei:l>עַל חַצְרוֹת מְנוּחָתֶךָ,</tei:l>
          <tei:l>וְהִנֵּה שׁוֹמְעוֹת אָזְנֵינוּ קוֹל שָׂשׂוֹן וְשִׂמְחָה</tei:l>
          <tei:l>בְּחוּצוֹת חֶמֶד נַחֲלָתֶךָ,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:al_hanissim_for_yom_yerushalayim_shmidman/6"/>
        <tei:lg>
          <tei:l>וַעֲדֵי עַד נַעֲלֶה אֶת נֶצַח תִּפְאַרְתָּהּ</tei:l>
          <tei:l>לְרֹאשׁ שִׂמְחָתֵנוּ.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
