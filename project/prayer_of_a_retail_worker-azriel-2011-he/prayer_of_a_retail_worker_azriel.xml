  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_of_a_retail_worker_azriel">
        <tei:head>תחינה של עובד קמעונאי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_of_a_retail_worker_azriel/1"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן מִלְּפָנֶיךָ</tei:l>
          <tei:l>יְיָ אֱלֹהַי וֵאלֹהֵי אֲבוֹתַי</tei:l>
          <tei:l>שֶׁתַּצִּילֵנִי הַיּוֹם וּבְכָל יוֹם</tei:l>
          <tei:l>מִלָּקוֹחוֹת נִרְגְּנִים,</tei:l>
          <tei:l>וּמִמְּנַהֲלִים פַּחִדָנִים.</tei:l>
          <tei:l>וְאִם אֲנִי חַיָּב לְהִתְמוֹדֵד עִמָם,</tei:l>
          <tei:l>תְּנֵנִי אֶת אוֹרֶךְ הָרוּחַ</tei:l>
          <tei:l>וְאֶת הַשֵׂכֶל כְּדֵי שֶׁכָּל־זֶה יַעֲבוֹד.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_of_a_retail_worker_azriel/2"/>
        <tei:lg>
          <tei:l>וּתְּנֵנִי לִשְׁלוֹט בְּרוּחִי עִם בַּתִי,</tei:l>
          <tei:l>וְאַל תִּתֵּן לִי לִשְׁכּוֹחַ וְלוֹ גַּם לְרֶגַע אֶחָד שֶׁהִיא הַכִי יְקָרָה.</tei:l>
          <tei:l>וּתְּנֵנִי לְהַקְדִּישׁ תִּשׂוּמַת לֵב לְחוֹבוֹתַי כִּלַפֵּי אִשְּׁתִי</tei:l>
          <tei:l>וּלְהִתְרַכֵּז בָּאֳשְׁרָהּ</tei:l>
          <tei:l>וּלְהֵרְאוֹת לָהּ תְּכוּפוֹת שֶׁאֲנִי אוֹהֵב אוֹתָהּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_of_a_retail_worker_azriel/3"/>
        <tei:lg>
          <tei:l>בְּכָל־אֵלֶּה אֲנִי מְבַקֵשׁ מִמְּךָ לַעֲזוֹר,</tei:l>
          <tei:l>כִּי אֲנִי לֹא יָכוֹל לַעֲשׂוֹת אֵת אֵלֶּה לְבַד</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
