      <tei:div corresp="urn:x-opensiddur:text:prayer:shema">
        <tei:head>שְׁמַע</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:shema/torah_procession-barukh_shem"/>
        <tei:lg>
          <tei:l>שְׁמַ֖ע יִשְׂרָאֵ֑ל</tei:l>
          <tei:l>יְהוָ֥ה אֱלֹהֵ֖ינוּ</tei:l>
          <tei:l>יְהוָ֥ה ׀ אֶחָֽד׃ <tei:bibl>(דברים ו:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:note type="instruction">[בלחש]</tei:note> בָּרוּךְ שֵׁם כְּבוֹד מַלְכוּתוֹ לְעוֹלָם וָעֶד׃ <tei:bibl>(משנה יומא ג:ח, פסחים נו א, מדרש תנחומא – בובר קדושים ו׳, ועוד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְאָ֣הַבְתָּ֔ אֵ֖ת יְהוָ֣ה אֱלֹהֶ֑יךָ בְּכָל־לְבָבְךָ֥ וּבְכָל־נַפְשְׁךָ֖ וּבְכָל־מְאֹדֶֽךָ׃ <tei:bibl>(דברים ו:ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְהָי֞וּ הַדְּבָרִ֣ים הָאֵ֗לֶּה</tei:l>
          <tei:l>אֲשֶׁ֨ר אָנֹכִ֧י מְצַוְּךָ֛ הַיּ֖וֹם עַל־לְבָבֶֽךָ׃</tei:l>
          <tei:l>וְשִׁנַּנְתָּ֣ם לְבָנֶ֔יךָ</tei:l>
          <tei:l>וְדִבַּרְתָּ֖ בָּ֑ם בְּשִׁבְתְּךָ֤ בְּבֵיתֶ֙ךָ֙ וּבְלֶכְתְּךָ֣ בַדֶּ֔רֶךְ וּֽבְשָׁכְבְּךָ֖ וּבְקוּמֶֽךָ׃ <tei:bibl>(דברים ו:ו-ז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וּקְשַׁרְתָּ֥ם לְא֖וֹת עַל־יָדֶ֑ךָ וְהָי֥וּ לְטֹטָפֹ֖ת בֵּ֥ין עֵינֶֽיךָ׃וּכְתַבְתָּ֛ם עַל־מְזוּזֹ֥ת בֵּיתֶ֖ךָ וּבִשְׁעָרֶֽיךָ׃ <tei:bibl>(דברים ו:ח-ט)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
