  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:birkhot_hashachar">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkhot_hashachar/lasekhvi"/>
        <tei:lg>
          <tei:l>Dass ich erlebe,</tei:l>
          <tei:l>wie die Natur unterscheidet</tei:l>
          <tei:l>zwischen dem Tag und der Nacht:</tei:l>
          <tei:l>ein Segen ist‘s.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkhot_hashachar/poqeach_ivrim"/>
        <tei:lg>
          <tei:l>Dass ich erlebe,</tei:l>
          <tei:l>wie die Welt sich den Blinden</tei:l>
          <tei:l>auftut: ein Segen ist‘s.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkhot_hashachar/malbish_arummim"/>
        <tei:lg>
          <tei:l>Dass ich erlebe,</tei:l>
          <tei:l>wie der Tag sich in Stimmung</tei:l>
          <tei:l>kleidet: ein Segen ist‘s.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkhot_hashachar/mattir_asurim"/>
        <tei:lg>
          <tei:l>Dass ich erlebe,</tei:l>
          <tei:l>wie der Mensch sich von Starrem</tei:l>
          <tei:l>befreit: ein Segen ist‘s.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkhot_hashachar/zoqef_kefufim"/>
        <tei:lg>
          <tei:l>Dass ich erlebe,</tei:l>
          <tei:l>wie der Körper sich dem Geist</tei:l>
          <tei:l>zuneigt: ein Segen ist‘s.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkhot_hashachar/sheasah_li"/>
        <tei:lg>
          <tei:l>Dass ich erlebe,</tei:l>
          <tei:l>wie das Sein sich eine Form</tei:l>
          <tei:l>erschafft: ein Segen ist‘s.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkhot_hashachar/hamekhin"/>
        <tei:lg>
          <tei:l>Dass ich erlebe,</tei:l>
          <tei:l>wie der Schritt sich in Wege</tei:l>
          <tei:l>wandelt: ein Segen ist‘s.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkhot_hashachar/ozer_yisrael"/>
        <tei:lg>
          <tei:l>Dass ich erlebe,</tei:l>
          <tei:l>wie der Anfang sich ins Jetzt</tei:l>
          <tei:l>einwebt: ein Segen ist‘s.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
