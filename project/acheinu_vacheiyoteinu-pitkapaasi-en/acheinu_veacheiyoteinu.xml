  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:acheinu_veacheiyoteinu">
        <tei:head>Aḥeinu v'Aḥeiyoteinu, an inclusive adaptation of the prayer for captives after 7 October 2023 by Me’ira Rakhel Pitkapaasi</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:acheinu_veacheiyoteinu/1"/>
        <tei:lg>
          <tei:l>Our family, the whole house of Yisrael,</tei:l>
          <tei:l>Our brothers and our sisters, each and everyone</tei:l>
          <tei:l>In distress, in captivity,</tei:l>
          <tei:l>On dry land or on the sea</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:acheinu_veacheiyoteinu/2"/>
        <tei:lg>
          <tei:l>We send prayers of freedom,</tei:l>
          <tei:l>Please come home everyone.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:acheinu_veacheiyoteinu/3"/>
        <tei:lg>
          <tei:l>May <j:divineName>Raḥameem</j:divineName> spread mercy upon you</tei:l>
          <tei:l>Remove you from the Narrows,</tei:l>
          <tei:l>Bring you into comfort,</tei:l>
          <tei:l>From darkness into the light,</tei:l>
          <tei:l>From oppression into redemption,</tei:l>
          <tei:l>Swiftly, we pray that you will</tei:l>
          <tei:l>Come home soon!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
