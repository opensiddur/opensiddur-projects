  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:seder_tashlikh">
        <tei:head>סֵדֶר תַּשְׁלִיךְ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_tashlikh/1"/>
        <tei:lg>
          <tei:l>מִי־אֵל כָּמוֹךָ</tei:l>
          <tei:l>נֹשֵׂא עָוֺן</tei:l>
          <tei:l>וְעֹבֵר עַל־פֶּשַׁע לִשְׁאֵרִית נַחֲלָתוֹ</tei:l>
          <tei:l>לֹא־הֶחֱזִיק לָעַד אַפּוֹ</tei:l>
          <tei:l>כִּי־חָפֵץ חֶסֶד הוּא׃</tei:l>
          <tei:l>יָשׁוּב יְרַחֲמֵנוּ</tei:l>
          <tei:l>יִכְבֹּשׁ עֲוֺנֹתֵינוּ</tei:l>
          <tei:l>וְתַשְׁלִיךְ בִּמְצֻלוֹת יָם כׇּל־חַטֹּאותָם׃ <tei:bibl>(מיכה ז:יח-יט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_tashlikh/3"/>
        <tei:lg>
          <tei:l>תִּתֵּן אֱמֶת לְיַעֲקֹב</tei:l>
          <tei:l>חֶסֶד לְאַבְרָהָם</tei:l>
          <tei:l>אֲשֶׁר־נִשְׁבַּעְתָּ לַאֲבֹתֵינוּ</tei:l>
          <tei:l>מִימֵי קֶדֶם׃ <tei:bibl>(מיכה ז:כ)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_tashlikh/4"/>
        <tei:lg>
          <tei:l>מִן־הַמֵּצַר קָרָאתִי יָּהּ</tei:l>
          <tei:l>עָנָנִי בַמֶּרְחָב יָהּ׃</tei:l>
          <tei:l>יְהֹוָה לִי לֹא אִירָא</tei:l>
          <tei:l>מַה־יַּעֲשֶׂה לִי אָדָם׃</tei:l>
          <tei:l>יְהֹוָה לִי בְּעֹזְרָי</tei:l>
          <tei:l>וַאֲנִי אֶרְאֶה בְשֹׂנְאָי׃</tei:l>
          <tei:l>טוֹב לַחֲסוֹת בַּיהֹוָה</tei:l>
          <tei:l>מִבְּטֹחַ בָּאָדָם׃</tei:l>
          <tei:l>טוֹב לַחֲסוֹת בַּיהֹוָה</tei:l>
          <tei:l>מִבְּטֹחַ בִּנְדִיבִים׃ <tei:bibl>(תהלים קיח:ה-ט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_tashlikh/5"/>
        <tei:lg>
          <tei:l>לֹא־יָרֵעוּ וְלֹא־יַשְׁחִיתוּ</tei:l>
          <tei:l>בְּכׇל־הַר קׇדְשִׁי</tei:l>
          <tei:l>כִּי־מָלְאָה הָאָרֶץ דֵּעָה אֶת־יְהֹוָה</tei:l>
          <tei:l>כַּמַּיִם לַיָּם מְכַסִּים׃ <tei:bibl>(ישעיה יא:ט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_tashlikh/6"/>
        <tei:lg>
          <tei:l>אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
