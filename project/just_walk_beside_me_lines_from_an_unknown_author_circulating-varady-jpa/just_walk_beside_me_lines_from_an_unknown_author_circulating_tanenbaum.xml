  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:just_walk_beside_me_lines_from_an_unknown_author_circulating_tanenbaum">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:just_walk_beside_me_lines_from_an_unknown_author_circulating_tanenbaum/1"/>
        <tei:lg>
          <tei:l>לָא־תֵּיזִיל קֳדָמַי</tei:l>
          <tei:l>דִּילְמָא לָא־אֱזִיל בָּתְרָךְ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:just_walk_beside_me_lines_from_an_unknown_author_circulating_tanenbaum/2"/>
        <tei:lg>
          <tei:l>לָא־תֵּיזִיל בַּתְרַי</tei:l>
          <tei:l>דִּילְמָא לָא־אֱדַבַּר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:just_walk_beside_me_lines_from_an_unknown_author_circulating_tanenbaum/3"/>
        <tei:lg>
          <tei:l>בְּרַם זִיל עִמִּי</tei:l>
          <tei:l>וַהֲוִי־לִי לִרְחִימִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:just_walk_beside_me_lines_from_an_unknown_author_circulating_tanenbaum/4"/>
        <tei:lg>
          <tei:l>וְכַּחֲדָא נֵיזִיל</tei:l>
          <tei:l>בְּאׇרְחֵיהּ דְרַחֲמָנָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:just_walk_beside_me_lines_from_an_unknown_author_circulating_tanenbaum/5"/>
        <tei:lg>
          <tei:l>וּתְרַחֵם לְחַבְרָךְ כְּוָתָךְ</tei:l>
          <tei:l>[אֲמַר רַבִּי עֲקִיבָא]</tei:l>
          <tei:l>הַאי הוּא כְּלָלָא רַבָּא דְּאוֹרַיתָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:just_walk_beside_me_lines_from_an_unknown_author_circulating_tanenbaum/6"/>
        <tei:lg>
          <tei:l>לָא יִטוֹל עַם בְּאַפֵּי עַם זְיַן</tei:l>
          <tei:l>וְלָא יִתְאַלְפוּן עוֹד מִבְּכֵן קְרָבָא:</tei:l>
        </tei:lg>
      </tei:div>
