    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_kislev_through_hanukkah">
        <tei:head>תפילה לחודש כסלו עד סוף חנוכה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_kislev_through_hanukkah/1"/>
        <tei:lg>
          <tei:l>ק֥וּמִי א֖וֹרִי כִּ֣י בָ֣א אוֹרֵ֑ךְ</tei:l>
          <tei:l>וּכְב֥וֹד יְהוָ֖ה עָלַ֥יִךְ זָרָֽח׃</tei:l>
          <tei:l>כִּֽי־הִנֵּ֤ה הַחֹ֙שֶׁךְ֙ יְכַסֶּה־אֶ֔רֶץ</tei:l>
          <tei:l>וַעֲרָפֶ֖ל לְאֻמִּ֑ים</tei:l>
          <tei:l>וְעָלַ֙יִךְ֙ יִזְרַ֣ח יְהוָ֔ה</tei:l>
          <tei:l>וּכְבוֹד֖וֹ עָלַ֥יִךְ יֵרָאֶֽה׃</tei:l>
          <tei:l>וְהָלְכ֥וּ גוֹיִ֖ם לְאוֹרֵ֑ךְ</tei:l>
          <tei:l>וּמְלָכִ֖ים לְנֹ֥גַהּ זַרְחֵֽךְ׃ <tei:bibl>(ישעיה ס:א-ג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_kislev_through_hanukkah/2"/>
        <tei:lg>
          <tei:l>לֹא־יִֽהְיֶה־לָּ֨ךְ ע֤וֹד</tei:l>
          <tei:l>הַשֶּׁ֙מֶשׁ֙ לְא֣וֹר יוֹמָ֔ם</tei:l>
          <tei:l>וּלְנֹ֕גַהּ הַיָּרֵ֖חַ לֹא־יָאִ֣יר לָ֑ךְ</tei:l>
          <tei:l>וְהָיָה־לָ֤ךְ יְהוָה֙ לְא֣וֹר עוֹלָ֔ם</tei:l>
          <tei:l>וֵאלֹהַ֖יִךְ לְתִפְאַרְתֵּֽךְ׃</tei:l>
          <tei:l>לֹא־יָב֥וֹא עוֹד֙ שִׁמְשֵׁ֔ךְ</tei:l>
          <tei:l>וִירֵחֵ֖ךְ לֹ֣א יֵאָסֵ֑ף</tei:l>
          <tei:l>כִּ֣י יְהוָ֗ה יִֽהְיֶה־לָּךְ֙ לְא֣וֹר עוֹלָ֔ם</tei:l>
          <tei:l>וְשָׁלְמ֖וּ יְמֵ֥י אֶבְלֵֽךְ׃ <tei:bibl>(ישעיה ס:יט-כ)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
