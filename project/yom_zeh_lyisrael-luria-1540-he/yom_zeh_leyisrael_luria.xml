    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yom_zeh_leyisrael_luria">
        <tei:head>יוֹם זֶה לְיִשְׁרַאֵל</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_zeh_leyisrael_luria/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">י</tei:seg>וֹם זֶה</tei:l>
          <tei:l>לְיִשְׁרַאֵל</tei:l>
          <tei:l>אוֹרָה וְשִׂמְחָה</tei:l>
          <tei:l>שַׁבָּת מְנוּחָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_zeh_leyisrael_luria/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">צִ</tei:seg>וִיתָ פִקּוּדִים</tei:l>
          <tei:l>בְמַעֲמַד הַר סִינַי,</tei:l>
          <tei:l>שַׁבָּת וּמוֹעֲדִים</tei:l>
          <tei:l>לִשְׁמוֹר בְכָל שָׁנַי,</tei:l>
          <tei:l>לַעֲרוֹךְ לְפָנַי</tei:l>
          <tei:l>מַשְׂאֵת וַאֲרוּחָה,</tei:l>
          <tei:l>שַׁבָּת מְנוּחָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_zeh_leyisrael_luria/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חֶ</tei:seg>מְדַת הַלְבָבוֹת</tei:l>
          <tei:l>לְאֻמָה שְׁבוּרָה,</tei:l>
          <tei:l>לִנְפָשׁוֹת נִכְאָבוֹת</tei:l>
          <tei:l>נְשָׁמָה יְתֵרָה,</tei:l>
          <tei:l>לְנֶפֶשׁ מְצֵרָה</tei:l>
          <tei:l>יָסִיר אֲנָחָה,</tei:l>
          <tei:l>שַׁבָּת מְנוּחָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_zeh_leyisrael_luria/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קִ</tei:seg>דַשְׁתָ בֵרַכְתָ</tei:l>
          <tei:l>אוֹתוֹ מִכָל יָמִים,</tei:l>
          <tei:l>בְשֵׁשֶׁת כִלִיתָ</tei:l>
          <tei:l>מְלֶאכֶת עוֹלָמִים,</tei:l>
          <tei:l>בּוֹ מָצְאוּ עֲגוּמִים</tei:l>
          <tei:l>הַשְׁקֵט וּבִטְחָה,</tei:l>
          <tei:l>שַׁבָּת מְנוּחָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_zeh_leyisrael_luria/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>אִסּוּר מְלָאכָה</tei:l>
          <tei:l>צִוִיתָנוּ נוֹרָא,</tei:l>
          <tei:l>אֶזְכֶה הוֹד מְלוּכָה</tei:l>
          <tei:l>אִם שַׁבָּת אֶשְׁמֹרָה,</tei:l>
          <tei:l>אַקְרִיב שַׁי לַמּוֹרָא</tei:l>
          <tei:l>מִנְחָה מֶרְקָחָה,</tei:l>
          <tei:l>שַׁבָּת מְנוּחָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_zeh_leyisrael_luria/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>שִׁיר אֶעֱרָךְ לְךָ</tei:l>
          <tei:l>בְנִגּוּן וּנְעִימָה</tei:l>
          <tei:l>מוּל תִפְאֶרֶת</tei:l>
          <tei:l>גָדְלְךָ נַפְשִׁי לְךָ</tei:l>
          <tei:l>כָמַהּ לִסְגֻלָה תְמִימָה</tei:l>
          <tei:l>קַיֵם הַבְטָחָה,</tei:l>
          <tei:l>שַׁבָּת מְנוּחָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_zeh_leyisrael_luria/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רְ</tei:seg>צֵה תְפִלָתִי</tei:l>
          <tei:l>כְמוֹ קָרְבַן נַחְשׁוֹן</tei:l>
          <tei:l>וְיוֹם מְנוּחָתִי</tei:l>
          <tei:l>בְרִנָה וּבְשָׂשׂוֹן</tei:l>
          <tei:l>חָבִיב כְבַת אִישׁוֹן</tei:l>
          <tei:l>בְרֹב הַצְלָחָה,</tei:l>
          <tei:l>שַׁבָּת מְנוּחָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_zeh_leyisrael_luria/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יִ</tei:seg>שְׁעֲךָ קִוִינוּ</tei:l>
          <tei:l>יָהּ אַדִיר אַדִירִים</tei:l>
          <tei:l>בֶן דָוִד מַלְכֵנוּ</tei:l>
          <tei:l>שְׁלַח נָא לָעִבְרִים</tei:l>
          <tei:l>וְיִקְרָא לִדְרוֹרִים</tei:l>
          <tei:l>רֶוַח וַהֲנָחָה,</tei:l>
          <tei:l>שַׁבָּת מְנוּחָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_zeh_leyisrael_luria/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אָ</tei:seg>נָא עֶלְיוֹן נוֹרָא,</tei:l>
          <tei:l>הַבִיטָה עָנְיֵנוּ,</tei:l>
          <tei:l>פְדֵנוּ בִמְהֵרָה,</tei:l>
          <tei:l>חָנֵנוּ וַעֲנֵנוּ,</tei:l>
          <tei:l>שַׂמַח נַפְשֵׁנוּ,</tei:l>
          <tei:l>בְאוֹר וְשִׂמְחָה,</tei:l>
          <tei:l>שַׁבָּת מְנוּחָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_zeh_leyisrael_luria/10"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חַ</tei:seg>דֵשׁ מִקְדָשֵׁנוּ</tei:l>
          <tei:l>זָכְרָה נֶחֶרֶבֶת,</tei:l>
          <tei:l>טוּבְךָ מוֹשִׁיעֵנוּ</tei:l>
          <tei:l>תְנָה לַנֶעֱצֶבֶת,</tei:l>
          <tei:l>בְּשַׁבָּת יוֹשֶׁבֶת</tei:l>
          <tei:l>בִזְמִיר וּשְׁבָחָה,</tei:l>
          <tei:l>שַׁבָּת מְנוּחָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_zeh_leyisrael_luria/11"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זְ</tei:seg>כוֹר קָדוֹשׁ לָנוּ</tei:l>
          <tei:l>בִזְכוּת יִקְרַת הַיּוֹם,</tei:l>
          <tei:l>שְׁמוֹר נָא אוֹתָנוּ בְיוֹם זֶה</tei:l>
          <tei:l>וּבְכָל יוֹם,</tei:l>
          <tei:l>דּוֹדִי צַח</tei:l>
          <tei:l>וְאָיוֹם תָבִיא רְוָחָה,</tei:l>
          <tei:l>שַׁבָּת מְנוּחָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_zeh_leyisrael_luria/12"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ק</tei:seg>וֹל רִנָה וִישׁוּעָה,</tei:l>
          <tei:l>לְיִשְׂרָאֵל הַשְׁמִיעָה,</tei:l>
          <tei:l>בְבאֹ חֶזְיוֹן תְשׁוּעָה,</tei:l>
          <tei:l>צוּר מַצְמִיחַ יְשׁוּעָה,</tei:l>
          <tei:l>אוֹר שִׁמְשִׁי הוֹפִיעָה,</tei:l>
          <tei:l>תָמִיד הַזְרִיחָה,</tei:l>
          <tei:l>שַׁבָּת מְנוּחָה.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
