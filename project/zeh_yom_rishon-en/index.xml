      <tei:div type="colophon" subtype="introduction">
        <tei:p>NOTE: The refrain This day is holy to our God is based on Nehemiah 8:10, a verse spoken by the leaders of the people on the festival of the First of the Seventh Month.</tei:p>
      </tei:div>
      <j:endConditional target="#osp_33715_introduction"/>
