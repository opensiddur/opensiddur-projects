                    <tei:binary value="true"/>
                  </tei:f>
                </tei:fs>
                <tei:fs type="opensiddur:holiday-aggregate">
                  <tei:f name="minor-fast">
                    <tei:binary value="true"/>
                  </tei:f>
                </tei:fs>
                <tei:fs type="opensiddur:holiday">
                  <tei:f name="tzom-tammuz">
                    <tei:binary value="true"/>
                  </tei:f>
                </tei:fs>
              </j:any>
            </j:none>
          </j:none>
        </j:conditional>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:yehalelu_et_shem"/>
        <j:endConditional target="#when_2"/>
