      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/aneinu/opening">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/aneinu/opening/1"/>עֲנֵֽנוּ יְהֹוָה עֲנֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/aneinu/opening/2"/>בְּיוֹם צוֹם תַּעֲנִיתֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/aneinu/opening/3"/>כִּי בְצָרָה גְדוֹלָה אֲנָֽחְנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/aneinu/opening/4"/>אַל תֵּֽפֶן אֶל רִשְׁעֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/aneinu/opening/5"/>וְאַל תַּסְתֵּר פָּנֶֽיךָ מִמֶּֽנּוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/aneinu/opening/6"/>וְאַל תִּתְעַלַּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/aneinu/opening/7"/>מִתְּ֒חִנָּתֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/aneinu/opening/8"/>הֱיֵה נָא קָרוֹב לְשַׁוְעָתֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/aneinu/opening/9"/>יְהִי נָא חַסְדְּ֒ךָ לְנַחֲמֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/aneinu/opening/10"/>טֶֽרֶם נִקְרָא אֵלֶֽיךָ עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/aneinu/opening/11"/>כַּדָּבָר שֶׁנֶּאֱמַר
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:isaiah/65/24"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/aneinu/opening/12"/>וְהָיָה טֶֽרֶם יִקְרָֽאוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/aneinu/opening/13"/>וַאֲנִי אֶעֱנֶה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/aneinu/opening/14"/>עוֹד הֵם מְדַבְּ֒רִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/aneinu/opening/15"/>וַאֲנִי אֶשְׁמָע.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/aneinu/opening/16"/>כִּי אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/aneinu/opening/17"/>הָעוֹנֶה בְּעֵת צָרָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/aneinu/opening/18"/>פּוֹדֶה וּמַצִּיל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/aneinu/opening/19"/>בְּכָל עֵת צָרָה וְצוּקָה:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/aneinu/opening/20"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/aneinu/opening/21"/>הָעוֹנֶה לְעַמּוֹ יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/aneinu/opening/22"/>בְּעֵת צָרָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/aneinu/opening/23"/>כִּי אַתָּה שׁוֹמֵֽעַ תְּפִלַּת כָּל פֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/aneinu/opening/24"/>עַמְּ֒ךָ יִשְׂרָאֵל בְּרַחֲמִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/aneinu/opening/25"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/aneinu/opening/26"/>שׁוֹמֵֽעַ תְּפִלָּה:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
