      <tei:div corresp="urn:x-opensiddur:text:prayer:pesuqei_dezimrah/barukh_sheamar/barukh">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pesuqei_dezimrah/barukh_sheamar/barukh/1"/>בָּרוּךְ שֶׁאָמַר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pesuqei_dezimrah/barukh_sheamar/barukh/2"/>וְהָיָה הָעוֹלָם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pesuqei_dezimrah/barukh_sheamar/barukh/3"/>בָּרוּךְ הוּא,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pesuqei_dezimrah/barukh_sheamar/barukh/4"/>בָּרוּךְ עֹשֶׂה בְרֵאשִׁית,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pesuqei_dezimrah/barukh_sheamar/barukh/5"/>בָּרוּךְ אוֹמֵר וְעוֹשֶׂה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pesuqei_dezimrah/barukh_sheamar/barukh/6"/>בָּרוּךְ גּוֹזֵר וּמְקַיֵּם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pesuqei_dezimrah/barukh_sheamar/barukh/7"/>בָּרוּךְ מְרַחֵם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pesuqei_dezimrah/barukh_sheamar/barukh/8"/>עַל הָאָֽרֶץ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pesuqei_dezimrah/barukh_sheamar/barukh/9"/>בָּרוּךְ מְרַחֵם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pesuqei_dezimrah/barukh_sheamar/barukh/10"/>עַל הַבְּ֒רִיּוֹת,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pesuqei_dezimrah/barukh_sheamar/barukh/11"/>בָּרוּךְ מְשַׁלֵּם שָׂכָר טוֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pesuqei_dezimrah/barukh_sheamar/barukh/12"/>לִירֵאָיו,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pesuqei_dezimrah/barukh_sheamar/barukh/13"/>בָּרוּךְ חַי לָעַד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pesuqei_dezimrah/barukh_sheamar/barukh/14"/>וְקַיָּם לָנֶֽצַח,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pesuqei_dezimrah/barukh_sheamar/barukh/15"/>בָּרוּךְ פּוֹדֶה וּמַצִּיל,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pesuqei_dezimrah/barukh_sheamar/barukh/16"/>בָּרוּךְ שְׁמוֹ:</tei:p>
