      <tei:div corresp="urn:x-opensiddur:text:prayer:yehalelu_et_shem">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/1"/>יְהַלְ֒לוּ אֶת־שֵׁם יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/2"/>כִּי־נִשְׂגָּב שְׁמוֹ לְבַדּוֹ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/3"/>הוֹדוֹ עַל־אֶֽרֶץ וְשָׁמָֽיִם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/4"/>וַיָּֽרֶם קֶֽרֶן לְעַמּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/5"/>תְּהִלָּה לְכָל־חֲסִידָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/6"/>לִבְנֵי יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/7"/>עַם קְרֹבוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/8"/>הַלְ֒לוּיָהּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/9"/>לְדָוִד מִזְמוֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/10"/>לַיהוָֹה הָאָֽרֶץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/11"/>וּמְ֒לוֹאָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/12"/>תֵּבֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/13"/>וְיֽשְׁ֒בֵי בָהּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/14"/>כִּי־הוּא עַל־יַמִּים יְסָדָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/15"/>וְעַל־נְהָרוֹת יְכוֹנְ֒נֶֽהָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/16"/>מִי־יַעֲלֶה בְהַר־יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/17"/>וּמִי יָקוּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/18"/>בִּמְ֒קוֹם קָדְשׁוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/19"/>נְקִי כַפַּֽיִם וּבַר־לֵבָב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/20"/>אֲשֶׁר לֺא־נָשָׂא לַשָּׁוְא נַפְשִׁי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/21"/>וְלֺא נִשְׁבַּע לְמִרְמָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/22"/>יִשָּׂא בְרָכָה מֵאֵת יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/23"/>וּצְ֒דָקָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/24"/>מֵאֱלֺהֵי יִשְׁעוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/25"/>זֶה דּוֹר דּוֹרְ֒שָׁיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/26"/>מְבַקְ֒שֵׁי פָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/27"/>יַעֲקֹב סֶֽלָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/28"/>שְׂאוּ שְׁעָרִים רָאשֵׁיכֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/29"/>וְהִנָּשְׂ֒אוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/30"/>פִּתְ֒חֵי עוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/31"/>וְיָבוֹא מֶֽלֶךְ הַכָּבוֹד:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/32"/>מִי זֶה מֶֽלֶךְ הַכָּבוֹד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/33"/>יְהֹוָה עִזּוּז וְגִבּוֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/34"/>יְהֹוָה גִּבּוֹר מִלְחָמָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/35"/>שְׂאוּ שְׁעָרִים רָאשֵׁיכֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/36"/>וּשְׂ֒אוּ פִּתְ֒חֵי עוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/37"/>וְיָבוֹא מֶֽלֶךְ הַכָּבוֹד:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/38"/>מִי הוּא זֶה מֶֽלֶךְ הַכָּבוֹד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/39"/>יְהֹוָה צְבָאוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/40"/>הוּא מֶֽלֶךְ הַכָּבוֹד סֶֽלָה:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/41"/>וּבְ֒נֻחֹה יֹאמַר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/42"/>שׁוּבָה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/43"/>רִבְ֒בוֹת אַלְ֒פֵי יִשְׂרָאֵל:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/44"/>קוּמָה יְהֹוָה לִמְ֒נוּחָתֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/45"/>אַתָּה וַאֲרוֹן עֻזֶּֽךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/46"/>כֹּהֲנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/47"/>יִלְבְּ֒שׁוּ צֶֽדֶק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/48"/>וַחֲסִידֶֽיךָ יְרַנֵּֽנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/49"/>בַּעֲבוּר דָּוִד עַבְדֶּֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/50"/>אַל תָּשֵׁב פְּנֵי מְשִׁיחֶֽךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/51"/>כִּי לֶֽקַח טוֹב נָתַֽתִּי לָכֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/52"/>תּוֹרָתִי אַל תַּעֲזֹֽבוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/53"/>עֵץ חַיִּים הִיא לַמַּחֲזִיקִים בָּהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/54"/>וְתוֹמְ֒כֶֽיהָ מְאֻשָּׁר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/55"/>דְּרָכֶֽיהָ דַּרְ֒כֵי נֹֽעַם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/56"/>וְכָל נְתִיבוֹתֶֽיהָ שָׁלוֹם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/57"/>הֲשִׁיבֵֽנוּ יְהֹוָה אֵלֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/58"/>וְנָשׁוּבָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehalelu_et_shem/59"/>חַדֵּשׁ יָמֵֽינוּ כְּקֶֽדֶם:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
