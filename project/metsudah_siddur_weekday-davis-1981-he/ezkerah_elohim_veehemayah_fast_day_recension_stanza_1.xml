      <tei:div corresp="urn:x-opensiddur:text:poem:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/1"/>יְהֺוָה יְהֺוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/2"/>אֵל רַחוּם וְחַנּוּן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/3"/>אֶֽרֶךְ אַפַּֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/4"/>וְרַב־חֶֽסֶד וֶאֱמֶת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/5"/>נֹצֵר חֶֽסֶד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/6"/>לָאֲלָפִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/7"/>נֹשֵׂא עָוֹן וָפֶֽשַׁע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/8"/>וְחַטָּאָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/9"/>וְנַקֵּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/10"/>וְסָלַחְתָּ לַעֲוֺנֵֽנוּ וּלְ֒חַטָּאתֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/11"/>וּנְ֒חַלְתָּֽנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/12"/>סְלַח־לָֽנוּ אָבִֽינוּ כִּי־חָטָֽאנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/13"/>מְחַל־לָֽנוּ מַלְכֵּֽנוּ כִּי־פָשָֽׁעְנוּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/86/5"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/14"/>כִּי־אַתָּה אֲדֺנָי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/15"/>טוֹב וְסַלָּח
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/16"/>וְרַב־חֶֽסֶד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/17"/>לְכָל־קוֹרְ֒אֶֽיךָ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
