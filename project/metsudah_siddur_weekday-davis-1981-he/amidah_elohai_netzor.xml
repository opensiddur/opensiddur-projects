    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/elohai_netzor">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/1"/>אֱלֹהַי נְצוֹר לְשׁוֹנִי מֵרָע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/2"/>וּשְׂפָתַי מִדַּבֵּר מִרְמָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/3"/>וְלִמְקַלְ֒לַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/4"/>נַפְשִׁי תִדּוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/5"/>וְנַפְשִׁי כֶּעָפָר לַכֹּל תִּהְיֶה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/6"/>פְּתַח לִבִּי בְּתוֹרָתֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/7"/>וְאַחֲרֵי מִצְוֹתֶֽיךָ תִּרְדּוֹף נַפְשִׁי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/8"/>וְכָל הַקָמִים וְהַחוֹשְׁ֒בִים עָלַי רָעָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/9"/>מְהֵרָה הָפֵר עֲצָתָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/10"/>וְקַלְקֵל מַחֲשַׁבְתָּם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/11"/>(יְהִי רָצוֹן מִלְפָנֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/12"/>יְהֹוָה אֱלֹהַי וֵאלֹהֵי אֲבוֹתַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/13"/>שֶׁלֹּא תַעֲלֶה קִנְאַת אָדָם עָלַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/14"/>וְלֹא קִנְאָתִי עַל אֲחֵרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/15"/>וְשֶׁלֹּא אֶכְעֺס הַיּוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/16"/>וְשֶׁלֹּא אַכְעִיסֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/17"/>וְתַצִּילֵנִי מִיֵּֽצֶר הָרָע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/18"/>וְתֵן בְּלִבִּי הַכְנָעָה וַעֲנָוָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/19"/>מַלְכֵּֽנוּ וֵאלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/20"/>יַחֵד שִׁמְךָ בְּעוֹלָמֶֽךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/21"/>בְּנֵה עִירְ֒ךָ, יַסֵּד בֵּיתֶֽךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/22"/>וְשַׁכְלֵל הֵיכָלֶֽךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/23"/>וְקַבֵּץ קִבּוּץ גָּלֻיּוֹת,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/24"/>וּפְדֵה צֺאנֶֽךָ וְשַׂמַּח עֲדָתֶֽךָ.)
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/25"/>עֲשֵׂה לְמַֽעַן שְׁמֶֽךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/26"/>עֲשֵׂה לְמַֽעַן יְמִינֶֽךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/27"/>עֲשֵׂה לְמַֽעַן תּוֹרָתֶֽךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/28"/>עֲשֵׂה לְמַֽעַן קְדֻשָּׁתֶֽךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/29"/>לְמַֽעַן יֵחָלְ֒צוּן יְדִידֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/30"/>הוֹשִֽׁיעָה יְמִינְ֒ךָ וַעֲנֵֽנִי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/31"/>יִהְיוּ לְרָצוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/32"/>אִמְרֵי פִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/33"/>וְהֶגְיוֹן לִבִּי לְפָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/34"/>יְהֹוָה צוּרִי וְגוֹאֲלִי:
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/elohai_netzor/chol_minchah_shemoneh_esreh"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/39"/>עֹשֶׂה <j:conditional xml:id="inline_1" type="marked"><tei:note type="instruction" xml:lang="he">בעשי"ת</tei:note><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="aseret-ymei-tshuva"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>הַשָּׁלוֹם<j:endConditional target="#inline_1"/> <j:conditional xml:id="inline_2"><j:none><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="aseret-ymei-tshuva"><tei:binary value="true"/></tei:f></tei:fs></j:none></j:conditional>שָׁלוֹם<j:endConditional target="#inline_2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/40"/>בִּמְרוֹמָיו
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
