<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/45"/>עֹשֶׂה שָׁלוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/46"/>בִּמְרוֹמָיו
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
