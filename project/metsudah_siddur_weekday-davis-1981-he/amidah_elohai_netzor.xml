<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/41"/>עֹשֶׂה <j:conditional xml:id="inline_3" type="marked"><tei:note type="instruction" xml:lang="he">בעשי"ת</tei:note><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="aseret-ymei-tshuva"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>הַשָּׁלוֹם<j:endConditional target="#inline_3"/> <j:conditional xml:id="inline_4"><j:none><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="aseret-ymei-tshuva"><tei:binary value="true"/></tei:f></tei:fs></j:none></j:conditional>שָׁלוֹם<j:endConditional target="#inline_4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/42"/>בִּמְרוֹמָיו
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/elohai_netzor/rosh_chodesh_musaf"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/43"/>עֹשֶׂה <j:conditional xml:id="inline_5" type="marked"><tei:note type="instruction" xml:lang="he">בעשי"ת</tei:note><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="aseret-ymei-tshuva"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>הַשָּׁלוֹם<j:endConditional target="#inline_5"/> <j:conditional xml:id="inline_6"><j:none><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="aseret-ymei-tshuva"><tei:binary value="true"/></tei:f></tei:fs></j:none></j:conditional>שָׁלוֹם<j:endConditional target="#inline_6"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/elohai_netzor/44"/>בִּמְרוֹמָיו
