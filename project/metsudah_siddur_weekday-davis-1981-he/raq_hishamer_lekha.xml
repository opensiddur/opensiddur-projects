    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:raq_hishamer_lekha">
        <tei:head xml:lang="he">זכירת מעמד הר סיני</tei:head>
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:deuteronomy/4/9"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:raq_hishamer_lekha/1"/>רַק הִשָּֽׁמֶר לְךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:raq_hishamer_lekha/2"/>וּשְׁמֹר נַפְשְׁ֒ךָ מְאֹד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:raq_hishamer_lekha/3"/>פֶּן תִּשְׁכַּח אֶת הַדְּ֒בָרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:raq_hishamer_lekha/4"/>אֲשֶׁר רָאוּ עֵינֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:raq_hishamer_lekha/5"/>וּפֶן יָסֽוּרוּ מִלְּ֒בָבְ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:raq_hishamer_lekha/6"/>כֹּל יְמֵי חַיֶּֽיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:raq_hishamer_lekha/7"/>וְהוֹדַעְתָּם לְבָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:raq_hishamer_lekha/8"/>וְלִבְנֵי בָנֶֽיךָ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:deuteronomy/4/10"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:raq_hishamer_lekha/9"/>יוֹם אֲשֶׁר עָמַֽדְתָּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:raq_hishamer_lekha/10"/>לִפְנֵי יְהֹוָה אֱלֺהֶֽיךָ בְּחֹרֵב:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
