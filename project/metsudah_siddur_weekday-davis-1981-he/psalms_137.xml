      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/137">
        <tei:head xml:lang="he">תהלים קלז</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/137/1"/>עַל־נַהֲרוֹת בָּבֶל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/137/2"/>שָׁם יָשַֽׁבְנוּ גַּם־בָּכִֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/137/3"/>בְּזָכְרֵֽנוּ אֶת־צִיּוֹן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/137/4"/>עַל־עֲרָבִים בְּתוֹכָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/137/5"/>תָּלִֽינוּ כִּנֹּרוֹתֵֽינוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/137/6"/>כִּי שָׁם שְׁאֵלֽוּנוּ שׁוֹבֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/137/7"/>דִּבְ֒רֵי־שִׁיר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/137/8"/>וְתוֹלָלֵֽינוּ שִׂמְחָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/137/9"/>שִֽׁירוּ לָֽנוּ מִשִּׁיר צִיּוֹן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/137/10"/>אֵיךְ נָשִׁיר אֶת־שִׁיר־יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/137/11"/>עַל אַדְ֒מַת נֵכָר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/137/12"/>אִם־אֶשְׁכָּחֵךְ יְרוּשָׁלָֽםִ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/137/13"/>תִּשְׁכַּח יְמִינִי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/137/14"/>תִּדְבַּק לְשׁוֹנִי לְחִכִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/137/15"/>אִם־לֺא אֶזְכְּרֵֽכִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/137/16"/>אִם־לֺא אַעֲלֶה אֶת־יְרוּשָׁלַֽםִ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/137/17"/>עַל רֹאשׁ שִׂמְחָתִי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/137/18"/>זְכֹר יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/137/19"/>לִבְנֵי אֱדוֹם אֵת יוֹם יְרוּשָׁלָֽםִ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/137/20"/>הָאֹמְ֒רִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/137/21"/>עָֽרוּ עָֽרוּ עַד הַיְ֒סוֹד בָּהּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/137/22"/>בַּת־בָּבֶל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/137/23"/>הַשְּׁ֒דוּדָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/137/24"/>אַשְׁרֵי שֶׁיְּ֒שַׁלֶּם־לָךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/137/25"/>אֶת־גְּמוּלֵךְ שֶׁגָּמַלְתְּ לָֽנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/137/26"/>אַשְׁרֵי שֶׁיֹּאחֵז
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/137/27"/>וְנִפֵּץ אֶת־עֹלָלַֽיִךְ אֶל־הַסָּֽלַע:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
