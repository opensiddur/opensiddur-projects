      <tei:div corresp="urn:x-opensiddur:text:prayer:pittum_haqetoret_hatzori">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/1"/>פִּטּוּם הַקְּ֒טֺרֶת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/2"/>הַצֳּרִי וְהַצִּפֹּרֶן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/3"/>הַחֶלְ֒בְּנָה וְהַלְּבוֹנָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/4"/>מִשְׁקַל שִׁבְעִים שִׁבְעִים מָנָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/5"/>מוֹר וּקְ֒צִיעָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/6"/>שִׁבֹּלֶת נֵרְדְּ וְכַרְכֹּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/7"/>מִשְׁקַל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/8"/>שִׁשָּׁה עָשָׂר שִׁשָּׁה עָשָׂר מָנֶה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/9"/>הַקּשְׁטְ שְׁנֵים עָשָׂר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/10"/>וְקִלּוּפָה שְׁלֹשָׁה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/11"/>וְקִנָּמוֹן תִּשְׁעָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/12"/>בֹּרִית כַּרְשִׁינָה תִּשְׁעָה קַבִּין.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/13"/>יֵין קַפְרִיסִין
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/14"/>סְאִין תְּלָתָא וְקַבִּין תְּלָתָא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/15"/>וְאִם אֵין לוֹ יֵין קַפְרִיסִין
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/16"/>מֵבִיא חֲמַר חִוּרְיָן עַתִּיק.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/17"/>מֶלַח סְדוֹמִית רֹבַע הַקָב.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/18"/>מַעֲלֶה עָשָׁן כָּל שֶׁהוּא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/19"/>רַבִּי נָתָן הַבַּבְלִי אוֹמֵר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/20"/>אַף כִּפַּת הַיַּרְדֵּן כָּל שֶׁהוּא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/21"/>וְאִם נָתַן בָּהּ דְּבַשׁ פְּסָלָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/22"/>וְאִם חִסַּר אַחַת מִכָּל סַמָּנֶיהָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/23"/>חַיָּב מִיתָה:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
