      <tei:div corresp="urn:x-opensiddur:text:prayer:yehi_shem_adonai">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_shem_adonai/1"/>יְהִי שֵׁם יְיָ מְבֹרָךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_shem_adonai/2"/>מֵעַתָּה וְעַד עוֹלָם:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_shem_adonai/3"/>דְּוַי הָסֵר וְגַם חָרוֹן,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_shem_adonai/4"/>וְאָז אִלֵּם בְּשִׁיר יָרוֹן,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_shem_adonai/5"/>נְחֵֽנוּ בְּמַעְגְּ֒לֵי צֶֽדֶק,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_shem_adonai/6"/>שְׁעֵה בִּרְכַּת (בְּנֵי יְשֻׁרוּן)
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_shem_adonai/7"/>בְּנֵי אַהֲרֹן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_shem_adonai/8"/>בִּרְשׁוּת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_shem_adonai/9"/>מָרָנָן וְרַבָּנָן וְרַבּוֹתַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_shem_adonai/10"/>נְבָרֵךְ אֱלֺהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_shem_adonai/11"/>שֶׁהַשִּׁמְחָה בִּמְעוֹנוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_shem_adonai/12"/>(וְ)שֶׁאָכַֽלְנוּ מִשֶּׁלּוֹ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_shem_adonai/13"/>בָּרוּךְ אֱלֺהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_shem_adonai/14"/>שֶׁהַשִּׁמְחָה בִּמְעוֹנוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_shem_adonai/15"/>(וְ)שֶׁאָכַֽלְנוּ מִשֶּׁלּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_shem_adonai/16"/>וּבְטוּבוֹ חָיִֽינוּ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_shem_adonai/17"/>בָּרוּךְ אֱלֺהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_shem_adonai/18"/>שֶׁהַשִּׁמְחָה בִּמְעוֹנוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_shem_adonai/19"/>(וְ)שֶׁאָכַֽלְנוּ מִשֶּׁלּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_shem_adonai/20"/>וּבְטוּבוֹ חָיִֽינוּ:</tei:p>
