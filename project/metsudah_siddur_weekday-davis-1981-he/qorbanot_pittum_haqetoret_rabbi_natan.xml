      <tei:div corresp="urn:x-opensiddur:text:prayer:qorbanot/pittum_haqetoret/rabbi_natan">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pittum_haqetoret/rabbi_natan/1"/>תַּנְיָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pittum_haqetoret/rabbi_natan/2"/>רַבִּי נָתָן אוֹמֵר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pittum_haqetoret/rabbi_natan/3"/>כְּשֶׁהוּא שׁוֹחֵק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pittum_haqetoret/rabbi_natan/4"/>אוֹמֵר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pittum_haqetoret/rabbi_natan/5"/>הָדֵק הֵיטֵב הֵיטֵב הָדֵק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pittum_haqetoret/rabbi_natan/6"/>מִפְּ֒נֵי שֶׁהַקּוֹל יָפֶה לַבְּ֒שָׂמִים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pittum_haqetoret/rabbi_natan/7"/>פִּטְּ֒מָהּ לַחֲצָאִין
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pittum_haqetoret/rabbi_natan/8"/>כְּשֵׁרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pittum_haqetoret/rabbi_natan/9"/>לִשְׁלִישׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pittum_haqetoret/rabbi_natan/10"/>וְלִרְבִֽיעַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pittum_haqetoret/rabbi_natan/11"/>לֹא שָׁמַֽעְנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pittum_haqetoret/rabbi_natan/12"/>אָמַר רַבִּי יְהוּדָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pittum_haqetoret/rabbi_natan/13"/>זֶה הַכְּ֒לָל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pittum_haqetoret/rabbi_natan/14"/>אִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pittum_haqetoret/rabbi_natan/15"/>כְּמִדָּתָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pittum_haqetoret/rabbi_natan/16"/>כְּשֵׁרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pittum_haqetoret/rabbi_natan/17"/>לַחֲצָאִין
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pittum_haqetoret/rabbi_natan/18"/>וְאִם חִסַּר אַחַת מִכָּל סַמָּנֶֽיהָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pittum_haqetoret/rabbi_natan/19"/>חַיָּב מִיתָה:</tei:p>
      </tei:div>
