      <tei:div corresp="urn:x-opensiddur:text:prayer:sheva_berakhot/asher_yatzar_haadam">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheva_berakhot/asher_yatzar_haadam/1"/>בָּרוּךְ אַתָּה יְהוָֹה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheva_berakhot/asher_yatzar_haadam/2"/>אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheva_berakhot/asher_yatzar_haadam/3"/>אֲשֶׁר יָצַר אֶת הָאָדָם בְּצַלְמוֹ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheva_berakhot/asher_yatzar_haadam/4"/>בְּצֶּֽלֶם דְּמוּת תַּבְנִיתוֹ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheva_berakhot/asher_yatzar_haadam/5"/>וְהִתְקִין לוֹ מִמֶּֽנּוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheva_berakhot/asher_yatzar_haadam/6"/>בִּנְיַן עֲדֵי עַד.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheva_berakhot/asher_yatzar_haadam/7"/>בָּרוּךְ אַתָּה יְהוָֹה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheva_berakhot/asher_yatzar_haadam/8"/>יוֹצֵר הָאָדָם:</tei:p>
      </tei:div>
