      <tei:div corresp="urn:x-opensiddur:text:prayer:vayomer_david">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/1"/>וַיֹּֽאמֶר דָּוִד אֶל־גָּד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/2"/>צַר־לִי מְאֹד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/3"/>נִפְּ֒לָה־נָּא בְיַד־יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/4"/>כִּי־רַבִּים רַחֲמָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/5"/>וּבְ֒יַד־אָדָם אַל־אֶפֹּֽלָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/6"/>רַחוּם וְחַנּוּן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/7"/>חָטָֽאתִי לְפָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/8"/>יְהֹוָה מָלֵא רַחֲמִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/9"/>רַחֵם עָלַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/10"/>וְקַבֵּל תַּחֲנוּנָי:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/6/2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/11"/>יְהֹוָה אַל־בְּאַפְּ֒ךָ תוֹכִיחֵֽנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/12"/>וְאַל־בַּחֲמָתְ֒ךָ תְיַסְּ֒רֵֽנִי:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/6/3"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/13"/>חָנֵּֽנִי יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/14"/>כִּי אֻמְלַל אָֽנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/15"/>רְפָאֵֽנִי יְהֹוָה כִּי נִבְהֲלוּ עֲצָמָי:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/6/4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/16"/>וְנַפְשִׁי נִבְהֲלָה מְאֹד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/17"/>וְאַתָּה יְהֹוָה עַד־מָתָי:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/6/5"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/18"/>שׁוּבָה יְהֹוָה חַלְּ֒צָה נַפְשִׁי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/19"/>הוֹשִׁיעֵֽנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/20"/>לְמַֽעַן חַסְדֶּֽךָ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/6/6"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/21"/>כִּי אֵין בַּמָּֽוֶת זִכְרֶךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/22"/>בִּשְׁ֒אוֹל מִי־יוֹדֶה לָּךְ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/6/7"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/23"/>יָגַֽעְתִּי־בְּאַנְחָתִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/24"/>אַשְׂחֶה בְכָל־לַֽיְלָה מִטָּתִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/25"/>בְּדִמְעָתִי עַרְשִׂי אַמְסֶה:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/6/8"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/26"/>עָשְׁ֒שָׁה מִכַּֽעַס עֵינִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/27"/>עָתְ֒קָה בְּכָל־צוֹרְ֒רָי:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/6/9"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/28"/>סֽוּרוּ מִמֶּֽנִּי כָּל־פֹּֽעֲלֵי אָוֶן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/29"/>כִּי־שָׁמַע יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/30"/>קוֹל בִּכְיִי:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/6/10"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/31"/>שָׁמַע יְהֹוָה תְּחִנָּתִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/32"/>יְהֹוָה תְּפִלָּתִי יִקָּח:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/6/11"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/33"/>יֵבֽשׁוּ וְיִבָּהֲלוּ מְאֹד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/34"/>כָּל־אֹיְ֒בָי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/35"/>יָשֻֽׁבוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayomer_david/36"/>יֵבֽשׁוּ רָֽגַע:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
