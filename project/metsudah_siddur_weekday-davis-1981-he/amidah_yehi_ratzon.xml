      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/yehi_ratzon">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yehi_ratzon/1"/>יְהִי רָצוֹן מִלְּ֒פָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yehi_ratzon/2"/>יְהֹוָה אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yehi_ratzon/3"/>שֶׁיִּבָּנֶה בֵּית הַמִּקְדָּשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yehi_ratzon/4"/>בִּמְהֵרָה בְיָמֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yehi_ratzon/5"/>וְתֵן חֶלְקֵֽנוּ בְּתוֹרָתֶֽךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yehi_ratzon/6"/>וְשָׁם נַעֲבָדְךָ בְּיִרְאָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yehi_ratzon/7"/>כִּימֵי עוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yehi_ratzon/8"/>וּכְשָׁנִים קַדְמוֹנִיּוֹת:</tei:p>
      </tei:div>
