      <tei:div corresp="urn:x-opensiddur:text:prayer:barukh_shem_kevod">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_shem_kevod/1"/>בָּרוּךְ שֵׁם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_shem_kevod/2"/>כְּבוֹד מַלְכוּתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_shem_kevod/3"/>לְעוֹלָם וָעֶד:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_shem_kevod/4"/>וְאָהַבְתָּ אֵת יְהֹוָה אֱלֹהֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_shem_kevod/5"/>בְּכָל֯־לְ֯בָבְךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_shem_kevod/6"/>וּבְכָל־נַפְשְׁךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_shem_kevod/7"/>וּבְכָל־מְאֹדֶֽךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_shem_kevod/8"/>וְהָיוּ הַדְּ֒בָרִים הָאֵֽלֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_shem_kevod/9"/>אֲשֶׁר֯ אָ֯נֹכִי מְצַוְּךָ הַיּוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_shem_kevod/10"/>עַל֯־לְ֯בָבֶֽךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_shem_kevod/11"/>וְשִׁנַּנְתָּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_shem_kevod/12"/>לְבָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_shem_kevod/13"/>וְדִבַּרְתָּ בָּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_shem_kevod/14"/>בְּשִׁבְתְּ֒ךָ בְּבֵיתֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_shem_kevod/15"/>וּבְלֶכְתְּ֒ךָ בַדֶּֽרֶךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_shem_kevod/16"/>וּבְשָׁכְבְּ֒ךָ וּבְקוּמֶֽךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_shem_kevod/17"/>וּקְשַׁרְתָּם לְאוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_shem_kevod/18"/>עַל֯־יָ֯דֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_shem_kevod/19"/>וְהָיוּ לְטֹטָפֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_shem_kevod/20"/>בֵּין עֵינֶֽיךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_shem_kevod/21"/>וּכְתַבְתָּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_shem_kevod/22"/>עַל־מְזֻזוֹת בֵּיתֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_shem_kevod/23"/>וּבִשְׁעָרֶֽיךָ:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
