      <tei:div corresp="urn:x-opensiddur:text:poem:maoz_tzur/1">
        <tei:head xml:lang="he">
          <tei:hi rend="large">מעוז צור</tei:hi>
        </tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/1/1"/>מָעוֹז צוּר יְשׁוּעָתִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/1/2"/>לְךָ נָאֶה לְשַׁבֵּֽחַ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/1/3"/>תִּכּוֹן בֵּית תְּפִלָּתִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/1/4"/>וְשָׁם תּוֹדָה נְזַבֵּֽחַ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/1/5"/>לְעֵת תָּכִין מַטְבֵּֽחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/1/6"/>מִצָּר הַמְ֒נַבֵּֽחַ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/1/7"/>אָז אֶגְמוֹר בְּשִׁיר מִזְמוֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/1/8"/>חֲנֻכַּת הַמִּזְבֵּֽחַ:</tei:p>
      </tei:div>
