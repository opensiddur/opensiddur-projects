      <tei:div corresp="urn:x-opensiddur:text:prayer:ein_kamokha/melekh">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_kamokha/melekh/1"/>יְהוָֹה מֶֽלֶךְ, יְהוָֹה מָלָֽךְ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_kamokha/melekh/2"/>יְהוָֹה יִמְלֹךְ, לְעֹלָם וָעֶד:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_kamokha/melekh/3"/>יְהוָֹה מֶֽלֶךְ, יְהוָֹה מָלָֽךְ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_kamokha/melekh/4"/>יְהוָֹה יִמְלֹךְ, לְעֹלָם וָעֶד:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:zechariah/14/9"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_kamokha/melekh/5"/>וְהָיָה יְהוָֹה לְמֶֽלֶךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_kamokha/melekh/6"/>עַל־כָּל־הָאָֽרֶץ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_kamokha/melekh/7"/>בַּיּוֹם הַהוּא יִהְיֶה יְהוָֹה אֶחָד,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_kamokha/melekh/8"/>וּשְׁמוֹ אֶחָד:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
