      <tei:div corresp="urn:x-opensiddur:text:prayer:birkat_hamazon/zimmun/yehi_shem">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/zimmun/yehi_shem/1"/>יְהִי שֵׁם יְהֹוָה מְבֹרָךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/zimmun/yehi_shem/2"/>מֵעַתָּה וְעַד עוֹלָם:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/zimmun/yehi_shem/3"/>בִּרְ֒שׁוּת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/zimmun/yehi_shem/4"/>מָרָנָן וְרַבָּנָן וְרַבּוֹתַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/zimmun/yehi_shem/5"/>נְבָרֵךְ (בעשרה אֱלֺהֵֽינוּ)
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/zimmun/yehi_shem/6"/>שֶׁאָכַֽלְנוּ מִשֶּׁלּוֹ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/zimmun/yehi_shem/7"/>בָּרוּךְ (בעשרה אֱלֺהֵֽינוּ)
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/zimmun/yehi_shem/8"/>שֶֽׁאָכַֽלְנוּ מִשֶּׁלּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/zimmun/yehi_shem/9"/>וּבְ֒טוּבוֹ חָיִֽינוּ:</tei:p>
