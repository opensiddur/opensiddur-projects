      <tei:div corresp="urn:x-opensiddur:text:prayer:haleluyah_barukh_adonai">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haleluyah_barukh_adonai/1"/>הַלְ֒לוּיָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haleluyah_barukh_adonai/2"/>בָּרוּךְ יְהֹוָה מִצִּיּוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haleluyah_barukh_adonai/3"/>שֹׁכֵן יְרוּשָׁלָֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haleluyah_barukh_adonai/4"/>הַלְ֒לוּיָהּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haleluyah_barukh_adonai/5"/>בְּרוּךְ יְהֹוָה אֱלֹהִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haleluyah_barukh_adonai/6"/>אֱלֹהֵי יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haleluyah_barukh_adonai/7"/>עֹשֵׂה נִפְלָאוֹת לְבַדּוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haleluyah_barukh_adonai/8"/>וּבָרוּךְ שֵׁם כְּבוֹדוֹ לְעוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haleluyah_barukh_adonai/9"/>וְיִמָּלֵא כְבוֹדוֹ אֶת־כָּל־הָאָרֶץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haleluyah_barukh_adonai/10"/>אָמֵן וְאָמֵן:</tei:p>
      </tei:div>
