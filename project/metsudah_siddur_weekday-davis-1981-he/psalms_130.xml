      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/130">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/130/1"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/130/1"/>שִׁיר הַמַּעֲלוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/130/2"/>מִמַּעֲמַקִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/130/3"/>קְרָאתִֽיךָ יְהֹוָה:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/130/2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/130/4"/>אֲדֹנָי שִׁמְעָה בְקוֹלִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/130/5"/>תִּהְיֶֽינָה אָזְנֶֽיךָ קַשֻּׁבוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/130/6"/>לְקוֹל תַּחֲנוּנָי:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/130/3"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/130/7"/>אִם־עֲוֹנוֹת תִּשְׁמָר־יָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/130/8"/>אֲדֹנָי מִי יַעֲמֹד:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/130/4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/130/9"/>כִּי־עִמְּ֒ךָ הַסְּ֒לִיחָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/130/10"/>לְמַֽעַן תִּוּרֵא:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/130/5"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/130/11"/>קִוּיתִי יְהֹוָה קִוּתָה נַפְשִׁי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/130/12"/>וְלִדְ֒בָרוֹ הוֹחָֽלְתִּי:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/130/6"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/130/13"/>נַפְשִׁי לַאדֹנָי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/130/14"/>מִשֹּׁמְ֒רִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/130/15"/>לַבֹּֽקֶר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/130/16"/>שֹׁמְ֒רִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/130/17"/>לַבֹּֽקֶר:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/130/7"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/130/18"/>יַחֵל יִשְׂרָאֵל אֶל־יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/130/19"/>כִּי־עִם־יְהֹוָה הַחֶֽסֶד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/130/20"/>וְהַרְבֵּה עִמּוֹ פְדוּת:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/130/8"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/130/21"/>וְהוּא יִפְדֶּה אֶת־יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/130/22"/>מִכֹּל עֲוֹנוֹתָיו:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
