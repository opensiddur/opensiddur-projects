      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/shanim/barekh_aleinu">
        <tei:head xml:lang="he">ברכת השנים</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/barekh_aleinu/1"/>בָּרֵךְ עָלֵֽינוּ יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/barekh_aleinu/2"/>אֶת־הַשָּׁנָה הַזֹּאת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/barekh_aleinu/3"/>וְאֶת־כָּל־מִינֵי תְבוּאָתָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/barekh_aleinu/4"/>לְטוֹבָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/barekh_aleinu/5"/>וְתֵן
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/barekh_aleinu/6"/>בְּרָכָה
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/barekh_aleinu/7"/>טַל וּמָטָר לִבְרָכָה*
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/barekh_aleinu/8"/>עַל־פְּנֵי הָאֲדָמָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/barekh_aleinu/9"/>וְשַׂבְּ֒עֵֽנוּ מִטּוּבֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/barekh_aleinu/10"/>כִּי אֵל טוֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/barekh_aleinu/11"/>ומֵטִיב אַתָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/barekh_aleinu/12"/>וּמְבָרֵךְ הַשָׁנִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/barekh_aleinu/13"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shanim/barekh_aleinu/14"/>מְבָרֵךְ הַשָּׁנִים:</tei:p>
