      <tei:div corresp="urn:x-opensiddur:text:prayer:vaydabber_adonai_el_msheh">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vaydabber_adonai_el_msheh/1"/>וַיְדַבֵּר יְהֹוָה אֶל־משֶׁה לֵּאמֹר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vaydabber_adonai_el_msheh/2"/>צַו אֶת־אַהֲרֹן וְאֶת־בָּנָיו לֵאמֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vaydabber_adonai_el_msheh/3"/>זֹאת תּוֹרַת הָעֹלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vaydabber_adonai_el_msheh/4"/>הִוא הָעֹלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vaydabber_adonai_el_msheh/5"/>עַל מוֹקְ֒דָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vaydabber_adonai_el_msheh/6"/>עַל־הַמִּזְבֵּֽחַ כָּל־הַלַּֽיְלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vaydabber_adonai_el_msheh/7"/>עַד־הַבֹּֽקֶר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vaydabber_adonai_el_msheh/8"/>וְאֵשׁ הַמִּזְבֵּֽחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vaydabber_adonai_el_msheh/9"/>תּוּקַד בּוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vaydabber_adonai_el_msheh/10"/>וְלָבַשׁ הַכֹּהֵן מִדּוֹ בַד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vaydabber_adonai_el_msheh/11"/>וּמִכְנְ֒סֵי־בַד יִלְבַּשׁ עַל־בְּשָׂרוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vaydabber_adonai_el_msheh/12"/>וְהֵרִים אֶת־הַדֶּֽשֶׁן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vaydabber_adonai_el_msheh/13"/>אֲשֶׁר תֹּאכַל הָאֵשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vaydabber_adonai_el_msheh/14"/>אֶת הָעֹלָה עַל־הַמִּזְבֵּֽחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vaydabber_adonai_el_msheh/15"/>וְשָׂמוֹ אֵֽצֶל הַמִּזְבֵּֽחַ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vaydabber_adonai_el_msheh/16"/>וּפָשַׁט אֶת־בְּגָדָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vaydabber_adonai_el_msheh/17"/>וְלָבַשׁ בְּגָדִים אֲחֵרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vaydabber_adonai_el_msheh/18"/>וְהוֹצִיא אֶת־הַדֶּֽשֶׁן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vaydabber_adonai_el_msheh/19"/>אֶל־מִחוּץ לַמַּחֲנֶה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vaydabber_adonai_el_msheh/20"/>אֶל־מָקוֹם טָהוֹר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vaydabber_adonai_el_msheh/21"/>וְהָאֵשׁ עַל־הַמִּזְבֵּֽחַ תּֽוּקַד־בּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vaydabber_adonai_el_msheh/22"/>לֹא תִכְבֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vaydabber_adonai_el_msheh/23"/>וּבִעֵר עָלֶֽיהָ הַכֹּהֵן עֵצִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vaydabber_adonai_el_msheh/24"/>בַּבֹּֽקֶר בַּבֹּֽקֶר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vaydabber_adonai_el_msheh/25"/>וְעָרַךְ עָלֶֽיהָ הָעֹלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vaydabber_adonai_el_msheh/26"/>וְהִקְטִיר עָלֶֽיהָ חֶלְבֵי הַשְּׁ֒לָמִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vaydabber_adonai_el_msheh/27"/>אֵשׁ תָּמִיד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vaydabber_adonai_el_msheh/28"/>תּוּקַד עַל־הַמִּזְבֵּֽחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vaydabber_adonai_el_msheh/29"/>לֹא תִכְבֶּה:</tei:p>
      </tei:div>
