      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/mishpat">
        <tei:head xml:lang="he">דין</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/mishpat/1"/>הָשִֽׁיבָה שׁוֹפְ֒טֵֽינוּ כְּבָרִאשׁוֹנָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/mishpat/2"/>וְיוֹעֲצֵֽינוּ כְּבַתְּ֒חִלָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/mishpat/3"/>וְהָסֵר מִמֶּֽנּוּ יָגוֹן וַאֲנָחָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/mishpat/4"/>וּמְלוֹךְ עָלֵֽינוּ מְהֵרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/mishpat/5"/>אַתָּה יְהֹוָה לְבַדְּ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/mishpat/6"/>בְּחֶֽסֶד וּבְרַחֲמִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/mishpat/7"/>וְצַדְּ֒קֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/mishpat/8"/>בְּצֶֽדֶק וּבְמִשְׁפָּט:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/mishpat/9"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/mishpat/10"/>מֶֽלֶךְ אֹהֵב צְדָקָה וּמִשְׁפָּט:
<tei:milestone unit="phrase"/>
<j:conditional xml:id="when_1"><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="aseret-ymei-tshuva"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/mishpat/11"/><tei:hi rend="small">בָּרוּךְ אַתָּה יְהֹוָה</tei:hi>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/mishpat/12"/><tei:hi rend="small">הַמֶּֽלֶךְ הַמִּשְׁפָּט:</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_1"/></tei:p>
