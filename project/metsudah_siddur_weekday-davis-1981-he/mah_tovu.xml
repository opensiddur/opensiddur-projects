      <tei:div corresp="urn:x-opensiddur:text:prayer:mah_tovu">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mah_tovu/1"/>מַה טֹּֽבוּ אֹהָלֶֽיךָ יַעֲקֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mah_tovu/2"/>מִשְׁכְּ֒נֹתֶֽיךָ יִשְׂרָאֵל:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/5/8"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mah_tovu/3"/>וַאֲנִי בְּרֹב חַסְדְּ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mah_tovu/4"/>אָבוֹא בֵיתֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mah_tovu/5"/>אֶשְׁתַּחֲוֶה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mah_tovu/6"/>אֶל הֵיכַל־קָדְשְׁ֒ךָ בְּיִרְאָתֶֽךָ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mah_tovu/7"/>יְהֹוָה אָהַֽבְתִּי מְעוֹן בֵּיתֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mah_tovu/8"/>וּמְקוֹם מִשְׁכַּן כְּבוֹדֶֽךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mah_tovu/9"/>וַאֲנִי אֶשְׁתַּחֲוֶה וְאֶכְרָֽעָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mah_tovu/10"/>אֶבְרְ֒כָה לִפְנֵי יְהֹוָה עֹשִׂי:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/69/14"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mah_tovu/11"/>וַאֲנִי תְפִלָּתִי־לְךָ יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mah_tovu/12"/>עֵת רָצוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mah_tovu/13"/>אֱלֹהִים בְּרָב־חַסְדֶּֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mah_tovu/14"/>עֲנֵֽנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mah_tovu/15"/>בֶּאֱמֶת יִשְׁעֶֽךָ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
