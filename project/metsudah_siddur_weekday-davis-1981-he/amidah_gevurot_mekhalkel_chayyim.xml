      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/gevurot/mekhalkel_chayyim">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/mekhalkel_chayyim/1"/>מְכַלְכֵּל חַיִּים בְּחֶֽסֶד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/mekhalkel_chayyim/2"/>מְחַיֵּה מֵתִים בְּרַחֲמִים רַבִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/mekhalkel_chayyim/3"/>סוֹמֵךְ נוֹפְ֒לִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/mekhalkel_chayyim/4"/>וְרוֹפֵא חוֹלִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/mekhalkel_chayyim/5"/>וּמַתִּיר אֲסוּרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/mekhalkel_chayyim/6"/>וּמְקַיֵּם אֱמוּנָתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/mekhalkel_chayyim/7"/>לִישֵׁנֵי עָפָר,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/mekhalkel_chayyim/8"/>מִי כָמֽוֹךָ בַּֽעַל גְּבוּרוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/mekhalkel_chayyim/9"/>וּמִי דּֽוֹמֶה לָּךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/mekhalkel_chayyim/10"/>מֶֽלֶךְ מֵמִית וּמְחַיֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/mekhalkel_chayyim/11"/>וּמַצְמִֽיחַ יְשׁוּעָה:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/mekhalkel_chayyim/12"/><tei:hi rend="small">מִי כָמֽוֹךָ אָב הָרַחַמָן</tei:hi>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/mekhalkel_chayyim/13"/><tei:hi rend="small">זוֹכֵר יְצוּרָיו לְחַיִּים</tei:hi>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/mekhalkel_chayyim/14"/><tei:hi rend="small">בְּרַחֲמִים:</tei:hi></tei:p>
      </tei:div>
    </tei:body>
