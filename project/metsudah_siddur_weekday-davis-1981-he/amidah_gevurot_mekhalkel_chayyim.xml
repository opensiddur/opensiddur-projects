      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/gevurot/mekhalkel_chayyim">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/mekhalkel_chayyim/1"/>מוֹרִיד הַטָּל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/mekhalkel_chayyim/2"/>מְכַלְכֵּל חַיִּים בְּחֶֽסֶד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/mekhalkel_chayyim/3"/>מְחַיֵּה מֵתִים בְּרַחֲמִים רַבִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/mekhalkel_chayyim/4"/>סוֹמֵךְ נוֹפְ֒לִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/mekhalkel_chayyim/5"/>וְרוֹפֵא חוֹלִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/mekhalkel_chayyim/6"/>וּמַתִּיר אֲסוּרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/mekhalkel_chayyim/7"/>וּמְקַיֵּם אֱמוּנָתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/mekhalkel_chayyim/8"/>לִישֵׁנֵי עָפָר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/mekhalkel_chayyim/9"/>מִי כָמֽוֹךָ בַּֽעַל גְּבוּרוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/mekhalkel_chayyim/10"/>וּמִי דּֽוֹמֶה לָּךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/mekhalkel_chayyim/11"/>מֶֽלֶךְ מֵמִית וּמְחַיֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/mekhalkel_chayyim/12"/>וּמַצְמִֽיחַ יְשׁוּעָה:</tei:p>
