      <tei:div corresp="urn:x-opensiddur:text:prayer:veal_hanissim_veal">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hanissim_veal/1"/>וְעַל הַנִּסִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hanissim_veal/2"/>וְעַל הַפֻּרְקָן וְעַל הַגְּ֒בוּרוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hanissim_veal/3"/>וְעַל הַתְּ֒שׁוּעוֹת וְעַל הַנִּפְלָאוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hanissim_veal/4"/>וְעַל הַנֶּחָמוֹת וְעַל הַמִּלְחָמוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hanissim_veal/5"/>שֶׁעָשִֽׂיתָ לַאֲבוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hanissim_veal/6"/>בַּיָּמִים הָהֵם בִּזְּ֒מַן הַזֶּה:</tei:p>
