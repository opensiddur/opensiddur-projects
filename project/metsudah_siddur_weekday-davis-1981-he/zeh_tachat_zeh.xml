      <tei:div corresp="urn:x-opensiddur:text:prayer:zeh_tachat_zeh">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zeh_tachat_zeh/1"/>זֶה תַּחַת זֶה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zeh_tachat_zeh/2"/>זֶה חִלּוּף זֶה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zeh_tachat_zeh/3"/>זֶה מָחוּל עַל זֶה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zeh_tachat_zeh/4"/>וְיִכָּנֵס זֶה הַבֵּן לְחַיִּים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zeh_tachat_zeh/5"/>לְתּוֹרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zeh_tachat_zeh/6"/>וּלְחֻפָּה וּלְמַעֲשִׂים טוֹבִים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zeh_tachat_zeh/7"/>אָמֵן:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zeh_tachat_zeh/8"/>יְשִׂמְךָ אֱלֺהִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zeh_tachat_zeh/9"/>כְּאֶפְרַיִם וְכִמְנַשֶּׁה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zeh_tachat_zeh/10"/>יְבָרֶכְךָ יְהוָֹה וְיִשְׁמְרֶֽךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zeh_tachat_zeh/11"/>יָאֵר יְהוָֹה פָּנָיו אֵלֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zeh_tachat_zeh/12"/>וִיחֻנֶּֽךָּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zeh_tachat_zeh/13"/>יִשָּׁא יְהוָֹה פָּנָיו אֵלֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zeh_tachat_zeh/14"/>וְיָשֵׂם לְךָ שָׁלוֹם.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/121/5"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zeh_tachat_zeh/15"/>יְהוָֹה שֹׁמְרֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zeh_tachat_zeh/16"/>יְהוָֹה צִלְּךָ עַל יַד יְמִינֶֽךָ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/3/2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zeh_tachat_zeh/17"/>כִּי אוֹרֶךְ יָמִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zeh_tachat_zeh/18"/>וּשְׁנוֹת חַיִּים וְשָׁלוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zeh_tachat_zeh/19"/>יוֹסִֽיפוּ לָךְ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/121/7"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zeh_tachat_zeh/20"/>יְהוָֹה יִשְׁמָרְךָ מִכָּל רָע,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zeh_tachat_zeh/21"/>יִשְׁמוֹר אֶת נַפְשֶֽׁךָ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
