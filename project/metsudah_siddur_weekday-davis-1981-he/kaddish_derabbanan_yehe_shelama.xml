      <tei:div corresp="urn:x-opensiddur:text:prayer:kaddish/derabbanan/yehe_shelama">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/yehe_shelama/1"/>יְהֵא שְׁלָמָא רַבָּא מִן שְׁמַיָּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/yehe_shelama/2"/>וְחַיִּים טוֹבִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/yehe_shelama/3"/>עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/yehe_shelama/4"/>וְאִמְרוּ אָמֵן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/yehe_shelama/5"/>עוֹשֶׂה שָׁלוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/yehe_shelama/6"/>(<tei:hi rend="small">בעשי"ת</tei:hi> הַשָּׁלוֹם)
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/yehe_shelama/7"/>בִּמְרוֹמָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/yehe_shelama/8"/>הוּא בְּרַחֲמָיו יַעֲשֶׂה שָׁלוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/yehe_shelama/9"/>עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/yehe_shelama/10"/>וְאִמְרוּ אָמֵן:</tei:p>
