      <tei:div corresp="urn:x-opensiddur:text:prayer:av_harachamim/hu_yerachem/text">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/1"/>אָב הָרַחֲמִים הוּא יְרַחֵם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/2"/>עַם עֲמוּסִים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/3"/>וְיִזְכֹּר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/4"/>בְּרִית אֵיתָנִים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/5"/>וְיַצִּיל נַפְ֒שׁוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/6"/>מִן הַשָּׁעוֹת הָרָעוֹת,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/7"/>וְיִגְעַר בְּיֵֽצֶר הָרָע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/8"/>מִן הַנְּ֒שׂוּאִים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/9"/>וְיָחוֹן אוֹתָֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/10"/>לִפְ֒לֵטַת עוֹלָמִים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/11"/>וִימַלֵּא מִשְׁאֲלוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/12"/>בְּמִדָּה טוֹבָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/13"/>יְשׁוּעָה וְרַחֲמִים:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/14"/>וְתִגָּלֶה וְתֵרָאֶה מַלְכוּתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/15"/>עָלֵֽינוּ בִּזְ֒מַן קָרוֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/16"/>וְיָחוֹן פְּלֵטָתֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/17"/>וּפְ֒לֵטַת עַמּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/18"/>בֵּית יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/19"/>לְחֵן וּלְ֒חֶֽסֶד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/20"/>וּלְ֒רַחֲמִים וּלְ֒רָצוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/21"/>וְנֹאמַר אָמֵן,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/22"/>הַכֹּל הָבוּ גֹֽדֶל לֵאלֺהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/23"/>וּתְ֒נוּ כָבוֹד לַתּוֹרָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/24"/>כֹּהֵן קְרָב,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/25"/>יַעֲמֹד (פב"פ) הַכֹּהֵן,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/26"/>בָּרוּךְ שֶׁנָּתַן תּוֹרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/27"/>לְעַמּוֹ יִשְׂרָאֵל בִּקְ֒דֻשָּׁתוֹ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:deuteronomy/4/4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/28"/>וְאַתֶּם הַדְּ֒בֵקִים בַּיהוָֹה אֱלֺהֵיכֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/hu_yerachem/text/29"/>חַיִּים כֻּלְּ֒כֶם הַיּוֹם:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
