      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/avodah/retzeh">
        <tei:head xml:lang="he">עבודה</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/avodah/retzeh/1"/>רְצֵה יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/avodah/retzeh/2"/>בְּעַמְּ֒ךָ יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/avodah/retzeh/3"/>וְלִתְפִלָּתָם שְׁעֵה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/avodah/retzeh/4"/>וְהָשֵׁב אֶת הָעֲבוֹדָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/avodah/retzeh/5"/>לִדְבִיר בֵּיתֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/avodah/retzeh/6"/>וְאִשֵּׁי יִשְׂרָאֵל,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/avodah/retzeh/7"/>וּתְפִלָּתָם בְּאַהֲבָה תְקַבֵּל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/avodah/retzeh/8"/>בְּרָצוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/avodah/retzeh/9"/>וּתְהִי לְרָצוֹן תָּמִיד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/avodah/retzeh/10"/>עֲבוֹדַת יִשְׂרָאֵל עַמֶּֽךָ:</tei:p>
      </tei:div>
