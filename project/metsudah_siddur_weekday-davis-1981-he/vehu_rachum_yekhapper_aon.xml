      <tei:div corresp="urn:x-opensiddur:text:prayer:vehu_rachum_yekhapper_aon">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_rachum_yekhapper_aon/1"/>וְהוּא רַחוּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_rachum_yekhapper_aon/2"/>יְכַפֵּר עָוֹן וְלֹא־יַשְׁחִית
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_rachum_yekhapper_aon/3"/>וְהִרְבָּה לְהָשִׁיב אַפּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_rachum_yekhapper_aon/4"/>וְלֹא־יָעִיר כָּל־חֲמָתוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_rachum_yekhapper_aon/5"/>יְהֹוָה הוֹשִׁיעָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_rachum_yekhapper_aon/6"/>הַמֶּֽלֶךְ יַעֲנֵֽנוּ בְיוֹם־קָרְאֵֽנוּ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_rachum_yekhapper_aon/7"/>בָּרְ֒כוּ אֶת יְהֹוָה הַמְ֒בֹרָךְ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_rachum_yekhapper_aon/8"/>בָּרוּךְ יְהֹוָה הַמְ֒בֹרָךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_rachum_yekhapper_aon/9"/>לְעוֹלָם וָעֶד:</tei:p>
      </tei:div>
