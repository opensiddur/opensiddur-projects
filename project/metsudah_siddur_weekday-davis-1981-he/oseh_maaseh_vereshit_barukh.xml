      <tei:div corresp="urn:x-opensiddur:text:prayer:oseh_maaseh_vereshit_barukh">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:oseh_maaseh_vereshit_barukh/1"/>בָּרוּךְ אַתָּה יְהוָֹה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:oseh_maaseh_vereshit_barukh/2"/>אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:oseh_maaseh_vereshit_barukh/3"/>עוֹשֵׂה מַעֲשֵׂה בְרֵאשִׁית:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:oseh_maaseh_vereshit_barukh/4"/>בָּרוּךְ אַתָּה יְהוָֹה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:oseh_maaseh_vereshit_barukh/5"/>אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:oseh_maaseh_vereshit_barukh/6"/>שֶׁכֹּחוֹ וּגְבוּרָתוֹ מָלֵא עוֹלָם:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:oseh_maaseh_vereshit_barukh/7"/>בָּרוּךְ אַתָּה יְהוָֹה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:oseh_maaseh_vereshit_barukh/8"/>אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:oseh_maaseh_vereshit_barukh/9"/>זוֹכֵר הַבְּרִית
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:oseh_maaseh_vereshit_barukh/10"/>וְנֶאֱמָן בִּבְרִיתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:oseh_maaseh_vereshit_barukh/11"/>וְקַיָּם בְּמַאֲמָרוֹ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:oseh_maaseh_vereshit_barukh/12"/>בָּרוּךְ אַתָּה יְהוָֹה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:oseh_maaseh_vereshit_barukh/13"/>אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:oseh_maaseh_vereshit_barukh/14"/>עוֹשֵׂה מַעֲשֵׂה בְרֵאשִׁית:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:oseh_maaseh_vereshit_barukh/15"/>בָּרוּךְ אַתָּה יְהוָֹה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:oseh_maaseh_vereshit_barukh/16"/>אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:oseh_maaseh_vereshit_barukh/17"/>שֶׁעָֽשָׂה לִּי נֵס בַּמָּקוֹם הַזֶּה:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:oseh_maaseh_vereshit_barukh/18"/>בָּרוּךְ אַתָּה יְהוָֹה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:oseh_maaseh_vereshit_barukh/19"/>אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:oseh_maaseh_vereshit_barukh/20"/>שֶׁעָֽשָׂה נֵס
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:oseh_maaseh_vereshit_barukh/21"/>לְאָבִי/לְאִמִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:oseh_maaseh_vereshit_barukh/22"/>בַּמָּקוֹם הַזֶּה:</tei:p>
