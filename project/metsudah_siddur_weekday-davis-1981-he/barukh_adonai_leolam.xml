    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:barukh_adonai_leolam">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/89/53"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_adonai_leolam/1"/>בָּרוּךְ יְהֹוָה לְעוֹלָם אָמֵן וְאָמֵן:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/135/21"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_adonai_leolam/2"/>בָּרוּךְ יְהֹוָה מִצִּיּוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_adonai_leolam/3"/>שֹׁכֵן יְרוּשָׁלָֽםִ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_adonai_leolam/4"/>הַלְ֒לוּיָהּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/72/18"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_adonai_leolam/5"/>בָּרוּךְ יְהֹוָה אֱלֹהִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_adonai_leolam/6"/>אֱלֹהֵי יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_adonai_leolam/7"/>עֹשֵׂה נִפְלָאוֹת לְבַדּוֹ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/72/19"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_adonai_leolam/8"/>וּבָרוּךְ שֵׁם כְּבוֹדוֹ לְעוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_adonai_leolam/9"/>וְיִמָּלֵא כְבוֹדוֹ אֶת־כָּל־הָאָֽרֶץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_adonai_leolam/10"/>אָמֵן וְאָמֵן:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
