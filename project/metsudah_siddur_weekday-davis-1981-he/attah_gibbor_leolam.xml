  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:attah_gibbor_leolam">
        <tei:head xml:lang="he">גבורות</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_gibbor_leolam/1"/>אַתָּה גִבּוֹר לְעוֹלָם אֲדֹנָי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_gibbor_leolam/2"/>מְחַיֶּה מֵתִים אַתָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_gibbor_leolam/3"/>רַב לְהוֹשִֽׁיעַ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_gibbor_leolam/4"/>מוֹרִיד הַטָּל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_gibbor_leolam/5"/>מְכַלְכֵּל חַיִּים בְּחֶֽסֶד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_gibbor_leolam/6"/>מְחַיֵּה מֵתִים בְּרַחֲמִים רַבִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_gibbor_leolam/7"/>סוֹמֵךְ נוֹפְ֒לִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_gibbor_leolam/8"/>וְרוֹפֵא חוֹלִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_gibbor_leolam/9"/>וּמַתִּיר אֲסוּרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_gibbor_leolam/10"/>וּמְקַיֵּם אֱמוּנָתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_gibbor_leolam/11"/>לִישֵׁנֵי עָפָר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_gibbor_leolam/12"/>מִי כָמֽוֹךָ בַּֽעַל גְּבוּרוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_gibbor_leolam/13"/>וּמִי דּֽוֹמֶה לָּךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_gibbor_leolam/14"/>מֶֽלֶךְ מֵמִית וּמְחַיֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_gibbor_leolam/15"/>וּמַצְמִֽיחַ יְשׁוּעָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_gibbor_leolam/16"/>וְנֶאֱמָן אַתָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_gibbor_leolam/17"/>לְהַחֲיוֹת מֵתִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_gibbor_leolam/18"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_gibbor_leolam/19"/>מְחַיֵּה הַמֵּתִים:</tei:p>
      </tei:div>
