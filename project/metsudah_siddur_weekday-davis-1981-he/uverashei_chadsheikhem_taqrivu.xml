    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:uverashei_chadsheikhem_taqrivu">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/28/11"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uverashei_chadsheikhem_taqrivu/1"/>וּבְרָאשֵׁי חָדְשֵׁיכֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uverashei_chadsheikhem_taqrivu/2"/>תַּקְרִֽיבוּ עֹלָה לַיהוָֹה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uverashei_chadsheikhem_taqrivu/3"/>פָּרִים בְּנֵי־בָקָר שְׁנַֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uverashei_chadsheikhem_taqrivu/4"/>וְאַֽיִל אֶחָד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uverashei_chadsheikhem_taqrivu/5"/>כְּבָשִׂים בְּנֵי־שָׁנָה שִׁבְעָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uverashei_chadsheikhem_taqrivu/6"/>תְּמִימִם:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/28/12"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uverashei_chadsheikhem_taqrivu/7"/>וּשְׁלשָׁה עֶשְׂרֹנִים סֹֽלֶת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uverashei_chadsheikhem_taqrivu/8"/>מִנְחָה בְּלוּלָה בַשֶּֽׁמֶן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uverashei_chadsheikhem_taqrivu/9"/>לַפָּר הָאֶחָד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uverashei_chadsheikhem_taqrivu/10"/>וּשְׁ֒נֵי עֶשְׂרֹנִים סֹֽלֶת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uverashei_chadsheikhem_taqrivu/11"/>מִנְחָה בְּלוּלָה בַשֶּֽׁמֶן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uverashei_chadsheikhem_taqrivu/12"/>לָאַֽיִל הָאֶחָד:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/28/13"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uverashei_chadsheikhem_taqrivu/13"/>וְעִשָּׂרֹן עִשָּׂרוֹן סֹֽלֶת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uverashei_chadsheikhem_taqrivu/14"/>מִנְחָה בְּלוּלָה בַשֶּֽׁמֶן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uverashei_chadsheikhem_taqrivu/15"/>לַכֶּֽבֶשׂ הָאֶחָד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uverashei_chadsheikhem_taqrivu/16"/>עֹלָה רֵֽיחַ נִיחֹֽחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uverashei_chadsheikhem_taqrivu/17"/>אִשֶּׁה לַיהוָֹה:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/28/14"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uverashei_chadsheikhem_taqrivu/18"/>וְנִסְכֵּיהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uverashei_chadsheikhem_taqrivu/19"/>חֲצִי הַהִין יִהְיֶה לַפָּר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uverashei_chadsheikhem_taqrivu/20"/>וּשְׁלִישִׁת הַהִין לָאַֽיִל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uverashei_chadsheikhem_taqrivu/21"/>וּרְבִיעִת הַהִין לַכֶּֽבֶשׂ יָֽיִן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uverashei_chadsheikhem_taqrivu/22"/>זֹאת עֹלַת חֹֽדֶשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uverashei_chadsheikhem_taqrivu/23"/>בְּחָדְשׁוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uverashei_chadsheikhem_taqrivu/24"/>לְחָדְשֵׁי הַשָּׁנָה:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/28/15"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uverashei_chadsheikhem_taqrivu/25"/>וּשְׂעִיר עִזִּים אֶחָד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uverashei_chadsheikhem_taqrivu/26"/>לְחַטָּאת לַיהוָֹה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uverashei_chadsheikhem_taqrivu/27"/>עַל עֹלַת הַתָּמִיד יֵעָשֶׂה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uverashei_chadsheikhem_taqrivu/28"/>וְנִסְכּוֹ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
