    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:mizmor_shir_chanukat_habayit">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/30/1"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/1"/>מִזְמוֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/2"/>שִׁיר־חֲנֻכַּת הַבַּֽיִת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/3"/>לְדָוִד:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/30/2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/4"/>אֲרוֹמִמְךָ יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/5"/>כִּי דִלִּיתָֽנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/6"/>וְלֹא־שִׂמַּֽחְתָּ אֹיְ֒בַי לִי:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/30/3"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/7"/>יְהֹוָה אֱלֹהָי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/8"/>שִׁוַּעְתִּי אֵלֶֽיךָ וַתִּרְפָּאֵֽנִי:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/30/4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/9"/>יְהֹוָה הֶעֱלִֽיתָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/10"/>מִן־שְׁאוֹל נַפְשִׁי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/11"/>חִיִּיתַֽנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/12"/>מִיָּרְ֒דִי־בוֹר:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/30/5"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/13"/>זַמְּ֒רוּ לַיהוָֹה חֲסִידָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/14"/>וְהוֹדוּ לְזֵֽכֶר קָדְשׁוֹ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/30/6"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/15"/>כִּי רֶֽגַע בְּאַפּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/16"/>חַיִּים בִּרְצוֹנוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/17"/>בָּעֶֽרֶב יָלִין בֶּֽכִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/18"/>וְלַבֹּֽקֶר רִנָּה:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/30/7"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/19"/>וַאֲנִי אָמַֽרְתִּי בְשַׁלְוִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/20"/>בַּל־אֶמּוֹט לְעוֹלָם:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/30/8"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/21"/>יְהֹוָה בִּרְצוֹנְ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/22"/>הֶעֱמַֽדְתָּה לְהַרְרִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/23"/>עֹז
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/24"/>הִסְתַּֽרְתָּ פָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/25"/>הָיִֽיתִי נִבְהָל:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/30/9"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/26"/>אֵלֶֽיךָ יְהֹוָה אֶקְרָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/27"/>וְאֶל־אֲדֹנָי אֶתְחַנָּן:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/30/10"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/28"/>מַה־בֶּֽצַע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/29"/>בְּדָמִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/30"/>בְּרִדְתִּי אֶל שָֽׁחַת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/31"/>הֲיוֹדְ֒ךָ עָפָר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/32"/>הֲיַגִּיד אֲמִתֶּֽךָ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/30/11"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/33"/>שְׁמַע יְהֹוָה וְחָנֵּֽנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/34"/>יְהֹוָה הֱיֵה־עֹזֵר לִי:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/30/12"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/35"/>הָפַֽכְתָּ מִסְפְּדִי לְמָחוֹל לִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/36"/>פִּתַּחְתָּ שַׂקִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/37"/>וַתְּ֒אַזְּ֒רֵֽנִי שִׂמְחָה:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/30/13"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/38"/>לְמַֽעַן יְזַמֶּרְךָ כָבוֹד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/39"/>וְלֹא יִדֹּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mizmor_shir_chanukat_habayit/40"/>יְהֹוָה אֱלֹהַי לְעוֹלָם אוֹדֶֽךָּ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>