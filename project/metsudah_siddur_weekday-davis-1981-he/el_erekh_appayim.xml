      <tei:div corresp="urn:x-opensiddur:text:prayer:el_erekh_appayim">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim/1"/>אֵל אֶֽרֶךְ אַפַּֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim/2"/>וּמָלֵא רַחֲמִים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim/3"/>אַל־תַּסְתֵּר פָּנֶֽיךָ מִמֶּֽנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim/4"/>חֽוּסָה יְהֹוָה עַל־יִשְׂרָאֵל עַמֶּֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim/5"/>וְהַצִּילֵֽנוּ מִכָּל־רָע:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim/6"/>חָטָֽאנוּ לְךָ אָדוֹן,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim/7"/>סְלַח נָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim/8"/>כְּרוֹב רַחֲמֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim/9"/>אֵל:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/10/35"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim/10"/>וַיְהִי בִּנְ֒סֹֽעַ הָאָרֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim/11"/>וַיּֽאמֶר משֶׁה קוּמָה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim/12"/>וְיָפֻֽצוּ אֹיְ֒בֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim/13"/>וְיָנֻֽסוּ מְשַׂנְאֶֽיךָ מִפָּנֶֽיךָ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim/14"/>כִּי מִצִּיּוֹן תֵּצֵא תוֹרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim/15"/>וּדְ֒בַר יְהֹוָה מִירוּשָׁלָֽםִ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim/16"/>בָּרוּךְ שֶׁנָּתַן תּוֹרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim/17"/>לְעַמּוֹ יִשְׂרָאֵל בִּקְ֒דֻשָּׁתוֹ:</tei:p>
      </tei:div>
