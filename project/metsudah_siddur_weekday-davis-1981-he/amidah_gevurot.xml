  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/gevurot">
        <tei:head xml:lang="he">גבורות</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/1"/>אַתָּה גִבּוֹר לְעוֹלָם אֲדֹנָי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/2"/>מְחַיֶּה מֵתִים אַתָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/3"/>רַב לְהוֹשִֽׁיעַ:
<tei:milestone unit="phrase"/>
<j:conditional xml:id="when_1"><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="geshem"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/4"/>מוֹרִיד הַטָּל
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_1"/>
<j:conditional xml:id="when_2"><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="geshem"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/gevurot/chol_hamoed_musaf"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/5"/>מַשִּׁיב הָרֽוּחַ
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/gevurot/chol_hamoed_musaf"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/6"/>וּמוֹרִיד הַגֶּֽשֶׁם:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<j:endConditional target="#when_2"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/gevurot/rosh_chodesh_musaf"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/7"/>מְכַלְכֵּל חַיִּים בְּחֶֽסֶד
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_5"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/8"/>מְחַיֵּה מֵתִים בְּרַחֲמִים רַבִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/9"/>סוֹמֵךְ נוֹפְ֒לִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/10"/>וְרוֹפֵא חוֹלִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/11"/>וּמַתִּיר אֲסוּרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/12"/>וּמְקַיֵּם אֱמוּנָתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/13"/>לִישֵׁנֵי עָפָר,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/14"/>מִי כָמֽוֹךָ בַּֽעַל גְּבוּרוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/15"/>וּמִי דּֽוֹמֶה לָּךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/16"/>מֶֽלֶךְ מֵמִית וּמְחַיֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/17"/>וּמַצְמִֽיחַ יְשׁוּעָה:
<tei:milestone unit="phrase"/>
<j:conditional xml:id="when_6"><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="aseret-ymei-tshuva"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<j:conditional xml:id="variant_7"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/gevurot/rosh_chodesh_musaf"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/gevurot/chol_hamoed_musaf"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/18"/><tei:hi rend="small">מִי כָמֽוֹךָ אָב הָרַחַמָן</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_7"/>
<j:conditional xml:id="variant_8"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/gevurot/rosh_chodesh_musaf"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/gevurot/chol_hamoed_musaf"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/19"/><tei:hi rend="small">זוֹכֵר יְצוּרָיו לְחַיִּים</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_8"/>
<j:conditional xml:id="variant_9"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/gevurot/rosh_chodesh_musaf"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/gevurot/chol_hamoed_musaf"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/20"/><tei:hi rend="small">בְּרַחֲמִים:</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_9"/>
<j:endConditional target="#when_6"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/21"/>וְנֶאֱמָן אַתָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/22"/>לְהַחֲיוֹת מֵתִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/23"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/gevurot/24"/>מְחַיֵּה הַמֵּתִים:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>