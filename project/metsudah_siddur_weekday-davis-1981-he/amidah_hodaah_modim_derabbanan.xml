  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/hodaah/modim_derabbanan">
        <tei:p>
          <tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim_derabbanan/1"/>
          <tei:hi rend="small">מוֹדִים אֲנַֽחְנוּ לָךְ</tei:hi>
          <tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim_derabbanan/2"/>
          <tei:hi rend="small">שָׁאַתָּה הוּא יְהֹוָה אֱלֹהֵֽינוּ</tei:hi>
          <tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim_derabbanan/3"/>
          <tei:hi rend="small">וֵאלֹהֵי אֲבוֹתֵֽינוּ</tei:hi>
          <tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim_derabbanan/4"/>
          <tei:hi rend="small">אֱלֹהֵי כָל בָּשָׂר</tei:hi>
          <tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim_derabbanan/5"/>
          <tei:hi rend="small">יוֹצְ֒רֵֽנוּ יוֹצֵר בְּרֵאשִׁית</tei:hi>
          <tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim_derabbanan/6"/>
          <tei:hi rend="small">בְּרָכוֹת וְהוֹדָאוֹת</tei:hi>
          <tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim_derabbanan/7"/>
          <tei:hi rend="small">לְשִׁמְךָ הַגָּדוֹל וְהַקָּדוֹשׁ</tei:hi>
          <tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim_derabbanan/8"/>
          <tei:hi rend="small">עַל שֶׁהֶחֱיִיתָֽנוּ וְקִיַּמְתָּֽנוּ</tei:hi>
          <tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim_derabbanan/9"/>
          <tei:hi rend="small">כֵּן תְּחַיֵּֽינוּ</tei:hi>
          <tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim_derabbanan/10"/>
          <tei:hi rend="small">וּתְקַיְּ֒מֵֽנוּ</tei:hi>
          <tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim_derabbanan/11"/>
          <tei:hi rend="small">וְתֶאֱסוֹף גָּלֻיּוֹתֵֽינוּ</tei:hi>
          <tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim_derabbanan/12"/>
          <tei:hi rend="small">לְחַצְרוֹת קָדְשֶֽׁךָ</tei:hi>
          <tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim_derabbanan/13"/>
          <tei:hi rend="small">לִשְׁמוֹר חֻקֶּֽיךָ</tei:hi>
          <tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim_derabbanan/14"/>
          <tei:hi rend="small">וְלַעֲשׂוֹת רְצוֹנֶֽךָ</tei:hi>
          <tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim_derabbanan/15"/>
          <tei:hi rend="small">וּלְעָבְדְּ֒ךָ בְּלֵבָב שָׁלֵם</tei:hi>
          <tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim_derabbanan/16"/>
          <tei:hi rend="small">עַל שֶׁאָֽנוּ מוֹדִים לָךְ,</tei:hi>
          <tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim_derabbanan/17"/>
          <tei:hi rend="small">בָּרוּךְ אֵל</tei:hi>
          <tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim_derabbanan/18"/>
          <tei:hi rend="small">הַהוֹדָאוֹת:</tei:hi>
        </tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
