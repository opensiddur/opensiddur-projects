    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:eizehu_meqoman_shel">
        <tei:head xml:lang="he">
          <tei:hi rend="small">משנה א</tei:hi>
        </tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman_shel/1"/>אֵיזֶהוּ מְקוֹמָן שֶׁל זְבָחִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman_shel/2"/>קָדְשֵׁי קָדָשִׁים שְׁחִיטָתָן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman_shel/3"/>בַּצָּפוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman_shel/4"/>פָּר וְשָׂעִיר שֶׁל יוֹם הַכִּפּוּרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman_shel/5"/>שְׁחִיטָתָן בַּצָּפוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman_shel/6"/>וְקִבּוּל דָּמָן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman_shel/7"/>בִּכְלִי שָׁרֵת בַּצָּפוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman_shel/8"/>וְדָמָן טָעוּן הַזָּיָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman_shel/9"/>עַל בֵּין הַבַּדִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman_shel/10"/>וְעַל הַפָּרֹֽכֶת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman_shel/11"/>וְעַל מִזְבַּח הַזָּהָב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman_shel/12"/>מַתָּנָה אַחַת מֵהֶן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman_shel/13"/>מְעַכָּֽבֶת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman_shel/14"/>שְׁיָרֵי הַדָּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman_shel/15"/>הָיָה שׁוֹפֵךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman_shel/16"/>עַל יְסוֹד מַעֲרָבִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman_shel/17"/>שֶׁל מִזְבֵּֽחַ הַחִיצוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman_shel/18"/>אִם לֹא נָתַן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman_shel/19"/>לֹא עִכֵּב:</tei:p>
      </tei:div>
