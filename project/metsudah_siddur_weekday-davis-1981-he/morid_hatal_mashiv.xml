    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:morid_hatal_mashiv">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:morid_hatal_mashiv/1"/>מוֹרִיד הַטָּל
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:morid_hatal_mashiv/2"/>מַשִּׁיב הָרֽוּחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:morid_hatal_mashiv/3"/>וּמוֹרִיד הַגֶּֽשֶׁם:
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:morid_hatal_mashiv/rosh_chodesh_musaf"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:morid_hatal_mashiv/4"/>מְכַלְכֵּל חַיִּים בְּחֶֽסֶד
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:morid_hatal_mashiv/5"/>מְחַיֵּה מֵתִים בְּרַחֲמִים רַבִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:morid_hatal_mashiv/6"/>סוֹמֵךְ נוֹפְ֒לִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:morid_hatal_mashiv/7"/>וְרוֹפֵא חוֹלִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:morid_hatal_mashiv/8"/>וּמַתִּיר אֲסוּרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:morid_hatal_mashiv/9"/>וּמְקַיֵּם אֱמוּנָתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:morid_hatal_mashiv/10"/>לִישֵׁנֵי עָפָר,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:morid_hatal_mashiv/11"/>מִי כָמֽוֹךָ בַּֽעַל גְּבוּרוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:morid_hatal_mashiv/12"/>וּמִי דּֽוֹמֶה לָּךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:morid_hatal_mashiv/13"/>מֶֽלֶךְ מֵמִית וּמְחַיֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:morid_hatal_mashiv/14"/>וּמַצְמִֽיחַ יְשׁוּעָה:
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:morid_hatal_mashiv/rosh_chodesh_musaf"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:morid_hatal_mashiv/15"/><tei:hi rend="small">מִי כָמֽוֹךָ אָב הָרַחַמָן</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:morid_hatal_mashiv/rosh_chodesh_musaf"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:morid_hatal_mashiv/16"/><tei:hi rend="small">זוֹכֵר יְצוּרָיו לְחַיִּים</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:morid_hatal_mashiv/rosh_chodesh_musaf"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:morid_hatal_mashiv/17"/><tei:hi rend="small">בְּרַחֲמִים:</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:morid_hatal_mashiv/18"/>וְנֶאֱמָן אַתָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:morid_hatal_mashiv/19"/>לְהַחֲיוֹת מֵתִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:morid_hatal_mashiv/20"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:morid_hatal_mashiv/21"/>מְחַיֵּה הַמֵּתִים:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
