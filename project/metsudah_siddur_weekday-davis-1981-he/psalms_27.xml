      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/27">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/27/1"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/1"/>לְדָוִד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/2"/>יְהֹוָה אוֹרִי וְיִשְׁעִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/3"/>מִמִּי אִירָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/4"/>יְהֹוָה מָעוֹז חַיַּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/5"/>מִמִּי אֶפְחָד:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/27/2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/6"/>בִּקְ֒רֹב עָלַי מְרֵעִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/7"/>לֶאֱכֹל אֶת בְּשָׂרִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/8"/>צָרַי וְאֹיְ֒בַי לִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/9"/>הֵֽמָּה כָשְׁ֒לוּ וְנָפָֽלוּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/27/3"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/10"/>אִם תַּחֲנֶה עָלַי מַחֲנֶה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/11"/>לֺא יִירָא לִבִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/12"/>אִם תָּקוּם עָלַי מִלְחָמָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/13"/>בְּזֹאת אֲנִי בוֹטֵֽחַ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/27/4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/14"/>אַחַת שָׁאַֽלְתִּי מֵאֵת יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/15"/>אוֹתָהּ אֲבַקֵּשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/16"/>שִׁבְתִּי בְּבֵית יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/17"/>כָּל יְמֵי חַיַּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/18"/>לַחֲזוֹת בְּנֹֽעַם יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/19"/>וּלְ֒בַקֵּר בְּהֵיכָלוֹ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/27/5"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/20"/>כִּי יִצְפְּ֒נֵֽנִי בְּסֻכֹּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/21"/>בְּיוֹם רָעָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/22"/>יַסְתִּרֵֽנִי בְּסֵֽתֶר אָהֳלוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/23"/>בְּצוּר יְרוֹמְ֒מֵֽנִי:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/27/6"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/24"/>וְעַתָּה יָרוּם רֹאשִׁי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/25"/>עַל אֹיְ֒בַי סְבִיבוֹתָי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/26"/>וְאֶזְבְּחָה בְאָהֳלוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/27"/>זִבְחֵי תְרוּעָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/28"/>אָשִֽׁירָה וַאֲזַמְּ֒רָה לַיהוָֹה:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/27/7"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/29"/>שְׁמַע יְהֹוָה קוֹלִי אֶקְרָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/30"/>וְחָנֵּֽנִי וַעֲנֵֽנִי:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/27/8"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/31"/>לְךָ אָמַר לִבִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/32"/>בַּקְּ֒שׁוּ פָנָי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/33"/>אֶת פָּנֶֽיךָ יְהֹוָה אֲבַקֵּשׁ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/27/9"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/34"/>אַל תַּסְתֵּר פָּנֶֽיךָ מִמֶּֽנִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/35"/>אַל תַּט בְּאַף עַבְדֶּֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/36"/>עֶזְרָתִי הָיִֽיתָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/37"/>אַל תִּטְּ֒שֵֽׁנִי וְאַל תַּעַזְ֒בֵֽנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/38"/>אֱלֺהֵי יִשְׁעִי:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/27/10"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/39"/>כִּי אָבִי וְאִמִּי עֲזָבֽוּנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/40"/>וַיהוָֹה יַאַסְ֒פֵֽנִי:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/27/11"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/41"/>הוֹרֵֽנִי יְהֹוָה דַּרְכֶּֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/42"/>וּנְ֒חֵֽנִי בְּאֹֽרַח מִישׁוֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/43"/>לְמַֽעַן שׁוֹרְ֒רָי:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/27/12"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/44"/>אַל תִּתְּ֒נֵֽנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/45"/>בְּנֶֽפֶשׁ צָרָי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/46"/>כִּי קָֽמוּ בִי עֵֽדֵי שֶֽׁקֶר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/47"/>וִיפֵֽחַ חָמָס:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/27/13"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/48"/>לוּלֵא הֶאֱמַֽנְתִּי לִרְאוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/49"/>בְּטוּב יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/50"/>בְּאֶֽרֶץ חַיִּים:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/27/14"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/51"/>קַוּה אֶל יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/52"/>חֲזַק וְיַאֲמֵץ לִבֶּךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/27/53"/>וְקַוּה אֶל יְהֹוָה:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
