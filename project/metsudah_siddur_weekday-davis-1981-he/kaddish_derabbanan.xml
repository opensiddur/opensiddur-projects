    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:kaddish/derabbanan">
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/chatzi"/>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/22"/>עַל יִשְׂרָאֵל וְעַל רַבָּנָן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/23"/>וְעַל תַלְמִידֵיהוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/24"/>וְעַל כָּל תַּלְמִידֵי תַלְמִידֵיהוֹן,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/25"/>וְעַל כָּל מָאן דְּעָסְ֒קִין בְּאוֹרַיְתָא,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/26"/>דִּי בְאַתְרָא הָדֵין
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/27"/>וְדִי בְכָל אֲתַר וַאֲתַר,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/28"/>יְהֵא לְהוֹן וּלְכוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/29"/>שְׁלָמָא רַבָּא חִנָּא וְחִסְדָּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/30"/>וְרַחֲמִין וְחַיִּין אֲרִיכִין
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/31"/>וּמְזוֹנָא רְוִיחֵי וּפוּרְקָנָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/32"/>מִן קֳדָם אֲבוּהוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/33"/>דְבִשְׁמַיָּא וְאַרְעָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/34"/>וְאִמְרוּ אָמֵן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/35"/>יְהֵא שְׁלָמָא רַבָּא מִן שְׁמַיָּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/36"/>וְחַיִּים טוֹבִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/37"/>עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/38"/>וְאִמְרוּ אָמֵן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/39"/>עוֹשֶׂה שָׁלוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/40"/><j:conditional xml:id="inline_1" type="marked"><tei:note type="instruction" xml:lang="he">בעשי"ת</tei:note><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="aseret-ymei-tshuva"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>הַשָּׁלוֹם<j:endConditional target="#inline_1"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/41"/>בִּמְרוֹמָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/42"/>הוּא בְּרַחֲמָיו יַעֲשֶׂה שָׁלוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/43"/>עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/44"/>וְאִמְרוּ אָמֵן:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
