      <tei:div corresp="urn:x-opensiddur:text:prayer:qorbanot/yehi_ratzon_amirah">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/1"/>יְהִי רָצוֹן מִלְּ֒פָנֶֽיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/2"/>יְהֹוָה אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ,
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/yehi_ratzon_amirah/chol_shacharit_qetoret"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/11"/>אִם נִתְחַיַּֽבְתִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/12"/>חַטָּאת
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/yehi_ratzon_amirah/chol_shacharit_qetoret_373"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/15"/>אִם נִתְחַיַּֽבְתִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/16"/>אָשָׁם
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/3"/>שֶׁתְּ֒הֵא אֲמִירָה זוּ,
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/yehi_ratzon_amirah/chol_shacharit_qetoret"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/13"/>מְרֻצָּה לְפָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/14"/>כְּאִֽלּוּ הִקְרַֽבְתִּי חַטָּאת:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/yehi_ratzon_amirah/chol_shacharit_qetoret_373"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
