    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:qorbanot/yehi_ratzon_amirah">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/1"/>יְהִי רָצוֹן מִלְּ֒פָנֶֽיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/2"/>יְהֹוָה אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/3"/>שֶׁתְּ֒הֵא אֲמִירָה זוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/4"/>חֲשׁוּבָה וּמְקֻבֶּֽלֶת,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/5"/>וּמְרֻצָּה לְפָנֶֽיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/6"/>כְּאִלּוּ הִקְרַֽבְנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/7"/>קָרְבַּן הַתָּמִיד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/8"/>בְּמוֹעֲדוֹ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/9"/>וּבִמְ֒קוֹמוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_amirah/10"/>וּכְהִלְכָתוֹ:</tei:p>
      </tei:div>
