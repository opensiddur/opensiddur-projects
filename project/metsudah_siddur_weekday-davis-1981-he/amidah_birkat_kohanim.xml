    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/birkat_kohanim">
        <tei:head xml:lang="he">ברכת כהנים</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/1"/>אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ בָּרְ֒כֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/2"/>בַבְּ֒רָכָה הַמְּ֒שֻׁלֶּֽשֶׁת בַּתּוֹרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/3"/>הַכְּ֒תוּבָה עַל יְדֵי משֶׁה עַבְדֶּֽךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/4"/>הָאֲמוּרָה מִפִּי אַהֲרֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/5"/>וּבָנָיו כֹּהֲנִים עַם קְדוֹשֶֽׁךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/6"/>כָּאָמוּר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/7"/>יְבָרֶכְ֒ךָ יְהֹוָה וְיִשְׁמְ֒רֶֽךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/8"/>יָאֵר יְהֹוָה פָּנָיו אֵלֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/9"/>וִיחֻנֶּֽךָּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/10"/>יִשָּׂא יְהֹוָה פָּנָיו אֵלֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/11"/>וְיָשֵׂם לְךָ שָׁלוֹם:
<tei:milestone unit="phrase"/>
<j:conditional xml:id="when_1"><j:all><tei:fs type="opensiddur:quorum"><tei:f name="minyan"><tei:binary value="true"/></tei:f></tei:fs><tei:fs type="opensiddur:recitation"><tei:f name="repetition"><tei:binary value="true"/></tei:f></tei:fs><tei:fs type="opensiddur:practice"><tei:f name="birkat-kohanim"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/birkat_kohanim/rosh_chodesh_musaf"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/birkat_kohanim/chol_hamoed_musaf"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/12"/><tei:hi rend="small">אַדִּיר בַּמָּרוֹם שׁוֹכֵן בִּגְ֒בוּרָה,</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/birkat_kohanim/rosh_chodesh_musaf"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/birkat_kohanim/chol_hamoed_musaf"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/13"/><tei:hi rend="small">אַתָּה שָׁלוֹם וְשִׁמְךָ שָׁלוֹם.</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/birkat_kohanim/rosh_chodesh_musaf"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/birkat_kohanim/chol_hamoed_musaf"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/14"/><tei:hi rend="small">יְהִי רָצוֹן שֶׁתָּשִׂים עָלֵֽינוּ</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/birkat_kohanim/rosh_chodesh_musaf"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/birkat_kohanim/chol_hamoed_musaf"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/15"/><tei:hi rend="small">וְעַל כָּל עַמְּ֒ךָ בֵּית יִשְׂרָאֵל</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_5"/>
<j:conditional xml:id="variant_6"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/birkat_kohanim/rosh_chodesh_musaf"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/birkat_kohanim/chol_hamoed_musaf"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/16"/><tei:hi rend="small">חַיִּים וּבְרָכָה</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_6"/>
<j:conditional xml:id="variant_7"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/birkat_kohanim/rosh_chodesh_musaf"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/birkat_kohanim/chol_hamoed_musaf"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/17"/><tei:hi rend="small">לְמִשְׁמֶֽרֶת שָׁלוֹם:</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_7"/>
<j:endConditional target="#when_1"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
