    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:aval_anachnu">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:aval_anachnu/1"/>אֲבָל אֲנַֽחְנוּ עַמְּ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:aval_anachnu/2"/>בְּנֵי בְרִיתֶֽךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:aval_anachnu/3"/>בְּנֵי אַבְרָהָם אֹהַבְךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:aval_anachnu/4"/>שֶׁנִּשְׁבַּֽעְתָּ לּוֹ בְּהַר הַמֹּרִיָּה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:aval_anachnu/5"/>זֶֽרַע יִצְחָק יְחִידוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:aval_anachnu/6"/>שֶׁנֶּעֱקַד עַל גַּבֵּי הַמִּזְבֵּֽחַ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:aval_anachnu/7"/>עֲדַת יַעֲקֹב בִּנְךָ בְּכוֹרֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:aval_anachnu/8"/>שֶׁמֵּאַהֲבָתְ֒ךָ שֶׁאָהַֽבְתָּ אוֹתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:aval_anachnu/9"/>וּמִשִּׂמְחָתְ֒ךָ שֶׁשָּׂמַֽחְתָּ בּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:aval_anachnu/10"/>קָרָֽאתָ אֶת שְׁמוֹ יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:aval_anachnu/11"/>וִישֻׁרוּן:</tei:p>
