      <tei:div corresp="urn:x-opensiddur:text:prayer:ribbon_kal_haolamim">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/1"/>רִבּוֹן כָּל הָעוֹלָמִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/2"/>וַאֲדוֹנֵי הָאֲדוֹנִים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/3"/>לֹא עַל צִדְקוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/4"/>אֲנַֽחְנוּ מַפִּילִים תַּחֲנוּנֵֽינוּ לְפָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/5"/>כִּי עַל רַחֲמֶֽיךָ הָרַבִּים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/6"/>מָה אָֽנוּ מֶה חַיֵּֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/7"/>מֶה חַסְדֵּֽנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/8"/>מַה צִּדְקוֹתֵֽינוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/9"/>מַה יְּשׁוּעָתֵֽנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/10"/>מַה כֹּחֵֽנוּ מַה גְּבוּרָתֵֽנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/11"/>מַה נֹּאמַר לְפָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/12"/>יְהֹוָה אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/13"/>הֲלֹא כָּל הַגִּבּוֹרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/14"/>כְּאַֽיִן לְפָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/15"/>וְאַנְשֵׁי הַשֵּׁם כְּלֹא הָיוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/16"/>וַחֲכָמִים כִּבְלִי מַדָּע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/17"/>וּנְבוֹנִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/18"/>כִּבְלִי הַשְׂכֵּל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/19"/>כִּי רוֹב מַעֲשֵׂיהֶם תֹּֽהוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/20"/>וִימֵי חַיֵּיהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/21"/>הֶֽבֶל לְפָנֶֽיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/22"/>וּמוֹתַר הָאָדָם מִן הַבְּ֒הֵמָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/23"/>אָֽיִן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/24"/>כִּי הַכֹּל הָֽבֶל:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/25"/>לְבַד הַנְשָׁמָה הַטְּ֒הוֹרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/26"/>שֶׁהִיא עֲתִידָה לִתֵּן דִּין וְחֶשְׁבּוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/27"/>לִפְנֵי כִסֵּא כְבוֹדֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/28"/>וְכָל הַגּוֹיִם כְּאַֽיִן נֶגְדֶּֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/29"/>שֶׁנֶּאֶמַר
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:isaiah/40/15"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/30"/>הֵן גּוֹיִם כְּמַר מִדְּ֒לִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/31"/>וּכְשַֽׁחַק מֹאזְ֒נַֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/32"/>נֶחְשָֽׁבוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbon_kal_haolamim/33"/>הֵן אִיִּים כַּדַּק יִטּוֹל:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
