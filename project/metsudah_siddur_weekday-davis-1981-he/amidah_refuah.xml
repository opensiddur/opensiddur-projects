      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/refuah">
        <tei:head xml:lang="he">רפואה</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/1"/>רְפָאֵֽנוּ יְהֹוָה וְנֵרָפֵא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/2"/>הוֹשִׁיעֵֽנוּ וְנִוּשֵֽׁעָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/3"/>כִּי תְהִלָּתֵֽנוּ אָֽתָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/4"/>וְהַעֲלֵה אֲרוּכָה וּמַרְפֵּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/5"/>לְכָל תַּחֲלוּאֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/6"/>וּלְכָל מַכְאוֹבֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/7"/>וּלְכָל מַכּוֹתֵֽינוּ
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/refuah/chol_minchah_shemoneh_esreh"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/refuah/chol_arvit_shemoneh_esreh"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/8"/><tei:hi rend="small">יְהִי רָצוֹן מִלְפָנֶֽיךָ</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/refuah/chol_minchah_shemoneh_esreh"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/refuah/chol_arvit_shemoneh_esreh"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/9"/><tei:hi rend="small">יְהֹוָה אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/refuah/chol_minchah_shemoneh_esreh"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/refuah/chol_arvit_shemoneh_esreh"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/10"/><tei:hi rend="small">שֶׁתִּשְׁלַח מְהֵרָה</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/refuah/chol_minchah_shemoneh_esreh"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/refuah/chol_arvit_shemoneh_esreh"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/11"/><tei:hi rend="small">רְפוּאָה שְׁלֵמָה מִן הַשָּׁמַֽיִם,</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/refuah/chol_minchah_shemoneh_esreh"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/refuah/chol_arvit_shemoneh_esreh"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/12"/><tei:hi rend="small">רְפוּאַת הַנֶּֽפֶשׁ</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_5"/>
<j:conditional xml:id="variant_6"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/refuah/chol_minchah_shemoneh_esreh"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/refuah/chol_arvit_shemoneh_esreh"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/13"/><tei:hi rend="small">וּרְפוּאַת הַגּוּף,</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_6"/>
<j:conditional xml:id="variant_7"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/refuah/chol_minchah_shemoneh_esreh"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/refuah/chol_arvit_shemoneh_esreh"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/14"/><tei:hi rend="small">לַחוֹלֶה</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_7"/>
<j:conditional xml:id="variant_8"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/refuah/chol_minchah_shemoneh_esreh"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/refuah/chol_arvit_shemoneh_esreh"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/15"/><tei:hi rend="small">(פלוני/פלונית)</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_8"/>
<j:conditional xml:id="variant_9"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/refuah/chol_minchah_shemoneh_esreh"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/refuah/chol_arvit_shemoneh_esreh"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/16"/><tei:hi rend="small">בֶּן/בַּת</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_9"/>
<j:conditional xml:id="variant_10"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/refuah/chol_minchah_shemoneh_esreh"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/refuah/chol_arvit_shemoneh_esreh"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/17"/><tei:hi rend="small">(פלונית)</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_10"/>
<j:conditional xml:id="variant_11"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/refuah/chol_minchah_shemoneh_esreh"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/refuah/chol_arvit_shemoneh_esreh"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/18"/><tei:hi rend="small">בְּתוֹךְ שְׁאָר חוֹלֵי יִשְׂרָאֵל:</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_11"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/19"/>כִּי אֵל מֶֽלֶךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/20"/>רוֹפֵא נֶאֱמָן וְרַחֲמָן אָֽתָּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/21"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/refuah/22"/>רוֹפֵא חוֹלֵי עַמּוֹ יִשְׂרָאֵל:</tei:p>
      </tei:div>
