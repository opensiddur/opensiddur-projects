    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:meein_shalosh/body">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/1"/>וְעַל הַגֶּֽפֶן וְעַל פְּרִי הַגֶּֽפֶן
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/2"/>וְעַל תְּנוּבַת הַשָּׂדֶה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/3"/>וְעַל אֶֽרֶץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/4"/>חֶמְדָּה טוֹבָה וּרְ֒חָבָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/5"/>שֶׁרָצִֽיתָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/6"/>וְהִנְחַֽלְתָּ לַאֲבוֹתֵֽינוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/7"/>לֶאֱכֹל מִפִּרְיָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/8"/>וְלִשְׂבֹּֽעַ מִטּוּבָהּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/9"/>רַחֵם נָא יְהֹוָה אֱלֺהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/10"/>עַל יִשְׂרָאֵל עַמֶּֽךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/11"/>וְעַל יְרוּשָׁלַֽיִם עִירֶֽךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/12"/>וְעַל צִיּוֹן מִשְׁכַּן כְּבוֹדֶֽךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/13"/>וְעַל מִזְבְּ֒חֶֽךָ וְעַל הֵיכָלֶֽךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/14"/>וּבְ֒נֵה יְרוּשָׁלַֽיִם עִיר הַקֹּֽדֶשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/15"/>בִּמְ֒הֵרָה בְיָמֵֽינוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/16"/>וְהַעֲלֵֽנוּ לְתוֹכָהּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/17"/>וְשַׂמְּ֒חֵֽנוּ בְּבִנְיָנָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/18"/>וְנֹאכַל מִפִּרְיָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/19"/>וְנִשְׂבַּע מִטּוּבָהּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/20"/>וּנְ֒בָרֶכְ֒ךָ עָלֶֽיהָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/21"/>בִּקְ֒דֻשָּׁה וּבְ֒טָהֳרָה,
<tei:milestone unit="phrase"/>
<j:conditional xml:id="when_1"><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/22"/>וּרְ֒צֵה וְהַחֲלִיצֵנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/23"/>בְּיוֹם הַשַּׁבָּת הַזֶּה,
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_1"/>
<j:conditional xml:id="when_2"><tei:fs type="opensiddur:holiday"><tei:f name="rosh-hodesh"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/24"/>וְזָכְ֒רֵֽנוּ לְטוֹבָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/25"/>בְּיוֹם רֹאשׁ הַחֹֽדֶשׁ הַזֶּה,
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_2"/>
<j:conditional xml:id="when_3"><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="yom-tov"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/26"/>וְשַׂמְּ֒חֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/27"/>בְּיוֹם חַג הַמַּצּוֹת הַזֶּה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/28"/>בְּיוֹם חַג הַשָּׁבֻעוֹת הַזֶּה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/29"/>בְּיוֹם חַג הַסֻּכּוֹת הַזֶּה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/30"/>בְּיוֹם הַשְּׁ֒מִינִי חַג הָעֲצֶֽרֶת הַזֶּה,
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_3"/>
<j:conditional xml:id="when_4"><tei:fs type="opensiddur:holiday"><tei:f name="rosh-hashana"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/31"/>וְזָכְ֒רֵֽנוּ לְטוֹבָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_shalosh/body/32"/>בְּיוֹם הַזִּכָּרוֹן הַזֶּה,
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_4"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>