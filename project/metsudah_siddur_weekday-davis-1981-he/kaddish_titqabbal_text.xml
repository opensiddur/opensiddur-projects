      <tei:div corresp="urn:x-opensiddur:text:prayer:kaddish/titqabbal/text">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/titqabbal/text/1"/>תִּתְקַבֵּל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/titqabbal/text/2"/>צְלוֹתְ֒הוֹן וּבָעוּתְ֒הוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/titqabbal/text/3"/>דְּכָל בֵּית יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/titqabbal/text/4"/>קֳדָם אֲבוּהוֹן דִּי בִשְׁ֒מַיָּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/titqabbal/text/5"/>וְאִמְרוּ אָמֵן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/titqabbal/text/6"/>יְהֵא שְׁלָמָא רַבָּא מִן שְׁמַיָּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/titqabbal/text/7"/>וְחַיִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/titqabbal/text/8"/>עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/titqabbal/text/9"/>וְאִמְרוּ אָמֵן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/titqabbal/text/10"/>עוֹשֶׂה שָׁלוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/titqabbal/text/11"/>(<tei:hi rend="small">בעשי"ת</tei:hi> הַשָּׁלוֹם)
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/titqabbal/text/12"/>בִּמְרוֹמָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/titqabbal/text/13"/>הוּא יַעֲשֶׂה שָׁלוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/titqabbal/text/14"/>עָלֵינוּ וְעַל כָּל יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/titqabbal/text/15"/>וְאִמְרוּ אָמֵן</tei:p>
      </tei:div>
