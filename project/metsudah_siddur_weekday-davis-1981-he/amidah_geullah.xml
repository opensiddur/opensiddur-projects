      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/geullah">
        <tei:head xml:lang="he">גאולה</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/geullah/1"/>רְאֵה נָא בְעָנְיֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/geullah/2"/>וְרִֽיבָה רִיבֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/geullah/3"/>וּגְאָלֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/geullah/4"/>גְאוּלָה שְׁלֵמָה מְהֵרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/geullah/5"/>לְמַֽעַן שְׁמֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/geullah/6"/>כִּי אֵל גּוֹאֵל חָזָק אָֽתָּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/geullah/7"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/geullah/8"/>גּוֹאֵל יִשְׂרָאֵל:</tei:p>
      </tei:div>
