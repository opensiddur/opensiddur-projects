    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:eizehu_meqoman/6">
        <tei:head xml:lang="he">
          <tei:hi rend="small">משנה ו</tei:hi>
        </tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/6/1"/>הַתּוֹדָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/6/2"/>וְאֵיל נָזִיר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/6/3"/>קָדָשִׁים קַלִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/6/4"/>שְׁחִיטָתָן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/6/5"/>בְּכָל־מָקוֹם בָּעֲזָרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/6/6"/>וְדָמָן טָעוּן שְׁתֵּי מַתָּנוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/6/7"/>שֶׁהֵן אַרְבַּע,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/6/8"/>וְנֶאֱכָלִין בְּכָל־הָעִיר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/6/9"/>לְכָל־אָדָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/6/10"/>בְּכָל־מַאֲכָל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/6/11"/>לְיוֹם וָלַֽיְלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/6/12"/>עַד־חֲצוֹת,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/6/13"/>הַמּוּרָם מֵהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/6/14"/>כַּיּוֹצֵא בָהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/6/15"/>אֶלָּא שֶׁהַמּוּרָם נֶאֱכָל לַכֹּהֲנִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/6/16"/>לִנְשֵׁיהֶם וְלִבְנֵיהֶם וּלְעַבְדֵיהֶם:</tei:p>
      </tei:div>
