      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/94">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/1"/>אֵל נְקָמוֹת יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/2"/>אֵל נְקָמוֹת הוֹפִֽיעַ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/3"/>הִנָּשֵׂא שֹׁפֵט הָאָֽרֶץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/4"/>הָשֵׁב גְּמוּל עַל גֵּאִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/5"/>עַד מָתַי רְשָׁעִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/6"/>יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/7"/>עַד מָתַי רְשָׁעִים יַעֲלֺֽזוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/8"/>יַבִּֽיעוּ יְדַבְּ֒רוּ עָתָק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/9"/>יִתְאַמְּ֒רוּ כָּל פֹּֽעֲלֵי אָֽוֶן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/10"/>עַמְּ֒ךָ יְהֹוָה יְדַכְּ֒אוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/11"/>וְנַחֲלָתְ֒ךָ יְעַנּוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/12"/>אַלְמָנָה וְגֵר יַהֲרֹֽגוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/13"/>וִיתוֹמִים יְרַצֵּֽחוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/14"/>וַיֹּאמְ֒רוּ לֺא יִרְאֶה יָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/15"/>וְלֺא יָבִין אֱלֺהֵי יַעֲקֹב:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/16"/>בִּֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/17"/>בֹּעֲרִים בָּעָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/18"/>וּכְ֒סִילִים מָתַי תַּשְׂכִּֽילוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/19"/>הֲנֹֽטַע אֹֽזֶן הֲלֺא יִשְׁמָע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/20"/>אִם יוֹצֵר עַֽיִן הֲלֺא יַבִּיט:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/21"/>הֲיֹסֵר גּוֹיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/22"/>הֲלֺא יוֹכִֽיחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/23"/>הַמְ֒לַמֵּד אָדָם דָּֽעַת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/24"/>יְהֹוָה יֹדֵֽעַ מַחְשְׁ֒בוֹת אָדָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/25"/>כִּי הֵֽמָּה הָֽבֶל:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/26"/>אַשְׁרֵי הַגֶּֽבֶר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/27"/>אֲשֶׁר תְּיַסְּ֒רֶֽנּוּ יָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/28"/>וּמִתּוֹרָתְ֒ךָ תְלַמְּ֒דֶֽנּוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/29"/>לְהַשְׁקִיט לוֹ מִֽימֵי רָע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/30"/>עַד יִכָּרֶה לָרָשָׁע שָֽׁחַת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/31"/>כִּי לֺא יִטּשׁ יְהֹוָה עַמּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/32"/>וְנַחֲלָתוֹ לֺא יַעֲזֹב:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/33"/>כִּי עַד צֶֽדֶק יָשׁוּב מִשְׁפָּט
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/34"/>וְאַחֲרָיו כָּל יִשְׁ֒רֵי לֵב:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/35"/>מִי יָקוּם לִי עִם מְרֵעִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/36"/>מִי יִתְיַצֵּב לִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/37"/>עִם פֹּֽעֲלֵי אָֽוֶן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/38"/>לוּלֵי יְהֹוָה עֶזְרָֽתָה לִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/39"/>כִּמְ֒עַט
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/40"/>שָׁכְ֒נָה דוּמָה נַפְשִׁי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/41"/>אִם אָמַֽרְתִּי מָֽטָה רַגְלִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/42"/>חַסְדְּ֒ךָ יְהֹוָה יִסְעָדֵֽנִי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/43"/>בְּרֹב שַׂרְעַפַּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/44"/>בְּקִרְבִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/45"/>תַּנְחוּמֶֽיךָ יְשַׁעַשְׁ֒עוּ נַפְשִׁי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/46"/>הַיְ֒חָבְרְךָ כִּסֵּא הַוּוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/47"/>יֹצֵר עָמָל עֲלֵי חֹק:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/48"/>יָגֽוֹדּוּ עַל נֶֽפֶשׁ צַדִּיק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/49"/>וְדָם נָקִי יַרְשִֽׁיעוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/50"/>וַיְ֒הִי יְהֹוָה לִי לְמִשְׂגָּב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/51"/>וֵאלֺהַי לְצוּר מַחְסִי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/52"/>וַיָּֽשֶׁב עֲלֵיהֶם אֶת אוֹנָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/53"/>וּבְ֒רָעָתָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/54"/>יַצְמִיתֵם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/94/55"/>יַצְמִיתֵם יְהֹוָה אֱלֺהֵֽינוּ:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
