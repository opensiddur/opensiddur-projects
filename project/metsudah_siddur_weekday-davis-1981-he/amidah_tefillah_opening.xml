      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/tefillah/opening">
        <tei:head xml:lang="he">קבלת תפלה</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/1"/>אָב הָרַחֲמָן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/2"/>שְׁמַע קוֹלֵֽנוּ יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/3"/>חוּס וְרַחֵם עָלֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/4"/>וְקַבֵּל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/5"/>בְּרַחֲמִים וּבְרָצוֹן אֶת תְּפִלָּתֵֽנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/6"/>כִּי אֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/7"/>שׁוֹמֵֽעַ תְּפִלּוֹת וְתַחֲנוּנִים אָֽתָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/8"/>וּמִלְּ֒פָנֶֽיךָ מַלְכֵּֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/9"/>רֵיקָם אַל תְּשִׁיבֵֽנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/10"/>חָנֵּֽנוּ וַעֲנֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/11"/>וּשְׁמַע תְּפִלָתֵֽנוּ*
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/tefillah/opening/chol_minchah_shemoneh_esreh"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/12"/>כִּי אַתָּה שׁוֹמֵֽעַ תְּפִלַּת כָּל פֶּה
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/tefillah/opening/chol_minchah_shemoneh_esreh"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/13"/>עַמְּ֒ךָ יִשְׂרָאֵל בְּרַחֲמִים:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/tefillah/opening/chol_minchah_shemoneh_esreh"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/14"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/tefillah/opening/chol_minchah_shemoneh_esreh"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tefillah/opening/15"/>שׁוֹמֵֽעַ תְּפִלָּה:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/></tei:p>
