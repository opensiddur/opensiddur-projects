      <tei:div corresp="urn:x-opensiddur:text:poem:maoz_tzur/2">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/2/1"/>רָעוֹת שָׂבְ֒עָה נַפְשִׁי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/2/2"/>בְּיָגוֹן כֹּחִי כִּלָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/2/3"/>חַיַּי מֵ֒רְרוּ בְּקוּשִׁי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/2/4"/>בְּשִׁעְבּוּד מַלְכוּת עֶגְלָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/2/5"/>וּבְיָדוֹ הַגְּ֒דוֹלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/2/6"/>הוֹצִיא אֶת הַסְּגֻלָּה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/2/7"/>חֵיל פַּרְעֹה וְכָל זַרְעוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/2/8"/>יָרְדוּ כְּאֶֽבֶן בִּמְצוּלָה:</tei:p>
      </tei:div>
