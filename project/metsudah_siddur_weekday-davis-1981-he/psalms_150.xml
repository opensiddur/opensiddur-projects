      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/150">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/150/1"/>הַלְ֒לוּיָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/150/2"/>הַֽלְ֒לוּ־אֵל בְּקָדְשׁוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/150/3"/>הַלְ֒לֽוּהוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/150/4"/>בִּרְקִֽיעַ עֻזּוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/150/5"/>הַלְ֒לֽוּהוּ בִּגְבוּרֹתָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/150/6"/>הַלְ֒לֽוּהוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/150/7"/>כְּרֹב גֻּדְלוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/150/8"/>הַלְ֒לֽוּהוּ בְּתֵֽקַע שׁוֹפָר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/150/9"/>הַלְ֒לֽוּהוּ בְּנֵֽבֶל וְכִנּוֹר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/150/10"/>הַלְ֒לֽוּהוּ בְּתֹף וּמָחוֹל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/150/11"/>הַלְ֒לֽוּהוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/150/12"/>בְּמִנִּים וְעֻגָב:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/150/13"/>הַלְ֒לֽוּהוּ בְצִלְצְלֵי־שָֽׁמַע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/150/14"/>הַלְ֒לֽוּהוּ בְּצִלְצְלֵי תְרוּעָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/150/15"/>כֹּל הַנְּ֒שָׁמָה תְּהַלֵּל יָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/150/16"/>הַלְ֒לוּיָהּ:</tei:p>
      </tei:div>
