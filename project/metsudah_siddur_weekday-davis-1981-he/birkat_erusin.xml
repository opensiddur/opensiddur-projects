    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:birkat_erusin">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_erusin/1"/>בָּרוּךְ אַתָּה יְהוָֹה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_erusin/2"/>אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_erusin/3"/>אֲשֶׁר קִדְּשָֽׁנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_erusin/4"/>בְּמִצְוֹתָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_erusin/5"/>וְצִוּנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_erusin/6"/>עַל הָֽעֲרָיוֹת,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_erusin/7"/>וְאָֽסַר לָֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_erusin/8"/>אֶת הָאֲרוּסוֹת,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_erusin/9"/>וְהִתִּיר לָֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_erusin/10"/>אֶת הַנְּשׂוּאוֹת לָֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_erusin/11"/>עַל־יְדֵי חֻפָּה וְקִדּוּשִׁין.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_erusin/12"/>בָּרוּךְ אַתָּה יְהוָֹה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_erusin/13"/>מְקַדֵּשׁ עַמּוֹ יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_erusin/14"/>עַל־יְדֵי חֻפָּה וְקִדּוּשִׁין:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_erusin/15"/>הֲרֵי אַתְּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_erusin/16"/>מְקֻדֶּֽשֶׁת לִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_erusin/17"/>בְּטַבַּֽעַת זוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_erusin/18"/>כְּדַת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_erusin/19"/>מֹשֶׁה וְיִשְׂרָאֵל:</tei:p>
