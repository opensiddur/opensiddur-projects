      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/24">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/1"/>לְדָוִד מִזְמוֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/2"/>לַיהוָֹה הָאָֽרֶץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/3"/>וּמְ֒לוֹאָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/4"/>תֵּבֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/5"/>וְיֽשְׁ֒בֵי בָהּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/6"/>כִּי הוּא עַל יַמִּים יְסָדָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/7"/>וְעַל נְהָרוֹת יְכוֹנְ֒נֶֽהָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/8"/>מִי יַעֲלֶה בְהַר יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/9"/>וּמִי יָקוּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/10"/>בִּמְ֒קוֹם קָדְשׁוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/11"/>נְקִי כַפַּֽיִם וּבַר לֵבָב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/12"/>אֲשֶׁר לֺא נָשָׂא לַשָּׁוְא נַפְשִׁי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/13"/>וְלֺא נִשְׁבַּע לְמִרְמָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/14"/>יִשָּׂא בְרָכָה מֵאֵת יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/15"/>וּצְ֒דָקָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/16"/>מֵאֱלֺהֵי יִשְׁעוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/17"/>זֶה דּוֹר דּוֹרְ֒שָׁיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/18"/>מְבַקְ֒שֵׁי פָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/19"/>יַעֲקֹב סֶֽלָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/20"/>שְׂאוּ שְׁעָרִים רָאשֵׁיכֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/21"/>וְהִנָּשְׂ֒אוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/22"/>פִּתְ֒חֵי עוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/23"/>וְיָבוֹא מֶֽלֶךְ הַכָּבוֹד:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/24"/>מִי זֶה מֶֽלֶךְ הַכָּבוֹד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/25"/>יְהֹוָה עִזּוּז וְגִבּוֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/26"/>יְהֹוָה גִּבּוֹר מִלְחָמָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/27"/>שְׂאוּ שְׁעָרִים רָאשֵׁיכֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/28"/>וּשְׂ֒אוּ פִּתְ֒חֵי עוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/29"/>וְיָבוֹא מֶֽלֶךְ הַכָּבוֹד:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/30"/>מִי הוּא זֶה מֶֽלֶךְ הַכָּבוֹד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/31"/>יְהֹוָה צְבָאוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/24/32"/>הוּא מֶֽלֶךְ הַכָּבוֹד סֶֽלָה:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
