    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:mechayyeh_metim_berachamim">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mechayyeh_metim_berachamim/1"/>מְחַיֵּה מֵתִים בְּרַחֲמִים רַבִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mechayyeh_metim_berachamim/2"/>סוֹמֵךְ נוֹפְ֒לִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mechayyeh_metim_berachamim/3"/>וְרוֹפֵא חוֹלִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mechayyeh_metim_berachamim/4"/>וּמַתִּיר אֲסוּרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mechayyeh_metim_berachamim/5"/>וּמְקַיֵּם אֱמוּנָתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mechayyeh_metim_berachamim/6"/>לִישֵׁנֵי עָפָר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mechayyeh_metim_berachamim/7"/>מִי כָמֽוֹךָ בַּֽעַל גְּבוּרוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mechayyeh_metim_berachamim/8"/>וּמִי דּֽוֹמֶה לָּךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mechayyeh_metim_berachamim/9"/>מֶֽלֶךְ מֵמִית וּמְחַיֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mechayyeh_metim_berachamim/10"/>וּמַצְמִֽיחַ יְשׁוּעָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mechayyeh_metim_berachamim/11"/>וְנֶאֱמָן אַתָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mechayyeh_metim_berachamim/12"/>לְהַחֲיוֹת מֵתִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mechayyeh_metim_berachamim/13"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:mechayyeh_metim_berachamim/14"/>מְחַיֵּה הַמֵּתִים:</tei:p>
