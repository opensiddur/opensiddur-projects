      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/1"/>אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/2"/>מֶֽלֶךְ רַחֲמָן רַחֵם עָלֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/3"/>טוֹב וּמֵטִיב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/4"/>הִדָּֽרֶשׁ לָֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/5"/>שֽׁוּבָה עָלֵֽינוּ בַּהֲמוֹן רַחֲמֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/6"/>בִּגְלַל אָבוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/7"/>שֶׁעָשׂוּ רְצוֹנֶֽךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/8"/>בְּנֵה בֵיתְ֒ךָ כְּבַתְּ֒חִלָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/9"/>וְכוֹנֵן מִקְדָּשְׁ֒ךָ עַל מְכוֹנוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/10"/>וְהַרְאֵֽנוּ בְּבִנְיָנוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/11"/>וְשַׂמְּ֒חֵֽנוּ בְּתִקּוּנוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/12"/>וְהָשֵׁב כֹּהֲנִים לַעֲבוֹדָתָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/13"/>וּלְוִיִּם לְשִׁירָם וּלְזִמְרָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/14"/>וְהָשֵׁב יִשְׂרָאֵל לִנְוֵיהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/15"/>וְשָׁם נַעֲלֶה וְנֵרָאֶה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/16"/>וְנִשְׁתַּחֲוֶה לְפָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/17"/>בְּשָׁלשׁ פַּעֲמֵי רְגָלֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/18"/>כַּכָּתוּב בְּתוֹרָתֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/19"/>שָׁלוֹשׁ פְּעָמִים בַּשָּׁנָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/20"/>יֵרָאֶה כָל זְכוּרְ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/21"/>אֶת פְּנֵי יְהֹוָה אֱלֹהֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/22"/>בַּמָּקוֹם אֲשֶׁר יִבְחָר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/23"/>בְּחַג הַמַּצּוֹת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/24"/>וּבְחַג הַשָּׁבֻעוֹת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/25"/>וּבְחַג הַסֻּכּוֹת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/26"/>וְלֹא יֵרָאֶה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/27"/>אֶת פְּנֵי יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/28"/>רֵיקָם.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:deuteronomy/16/17"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/29"/>אִישׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/30"/>כְּמַתְּ֒נַת יָדוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/31"/>כְּבִרְכַּת יְהֹוָה אֱלֹהֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/melokh_al_kol_haolam/32"/>אֲשֶׁר נָֽתַן לָךְ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
