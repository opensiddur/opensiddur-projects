      <tei:div corresp="urn:x-opensiddur:text:prayer:qorbanot/yehi_ratzon_miqdash">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_miqdash/1"/>יְהִי רָצוֹן מִלְּ֒פָנֶֽיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_miqdash/2"/>יְהֹוָה אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_miqdash/3"/>שֶׁתְּ֒רַחֵם עָלֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_miqdash/4"/>וְתִמְחָל לָֽנוּ עַל כָּל חַטֹּאתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_miqdash/5"/>וּתְכַפֶּר לָֽנוּ אֶת כָּל עֲוֹנוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_miqdash/6"/>וְתִסְלַח לָֽנוּ עַל־כָּל פְּשָׁעֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_miqdash/7"/>וְשֶׁתִּבְנֶה בֵּית הַמִּקְדָּשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_miqdash/8"/>בִּמְהֵרָה בְיָמֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_miqdash/9"/>וְנַקְרִיב לְפָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_miqdash/10"/>קָרְבַּן הַתָּמִיד שֶׁיְּ֒כַפֵּר בַּעֲדֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_miqdash/11"/>כְּמוֹ שֶׁכָּתַֽבְתָּ עָלֵֽינוּ בְּתוֹרָתֶֽךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_miqdash/12"/>עַל יְדֵי משֶׁה עַבְדֶּֽךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_miqdash/13"/>מִפִּי כְבוֹדֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/yehi_ratzon_miqdash/14"/>כָּאָמוּר:</tei:p>
      </tei:div>
