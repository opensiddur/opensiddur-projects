    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:qorbanot/qetoret">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/30/34"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/qetoret/1"/>וַיֹּֽאמֶר יְהֹוָה אֶל־משֶׁה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/qetoret/2"/>קַח־לְךָ סַמִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/qetoret/3"/>נָטָף וּשְׁחֵֽלֶת וְחֶלְבְּנָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/qetoret/4"/>סַמִּים וּלְבֹנָה זַכָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/qetoret/5"/>בַּד בְּבַד יִהְיֶה:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/30/35"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/qetoret/6"/>וְעָשִֽׂיתָ אֹתָהּ קְטֹֽרֶת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/qetoret/7"/>רֹֽקַח מַעֲשֵׂה רוֹקֵֽחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/qetoret/8"/>מְמֻלָּח טָהוֹר קֹֽדֶשׁ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/30/36"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/qetoret/9"/>וְשָׁחַקְתָּ מִמֶּֽנָּה הָדֵק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/qetoret/10"/>וְנָתַתָּה מִמֶּֽנָּה לִפְנֵי הָעֵדֻת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/qetoret/11"/>בְּאֹֽהֶל מוֹעֵד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/qetoret/12"/>אֲשֶׁר אִוּעֵד לְךָ שָֽׁמָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/qetoret/13"/>קֹֽדֶשׁ קָדָשִׁים תִּהְיֶה לָכֶם:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/qetoret/14"/>וְנֶאֱמַר
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/30/7"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/qetoret/15"/>וְהִקְטִיר עָלָיו אַהֲרֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/qetoret/16"/>קְטֹֽרֶת סַמִּים בַּבֹּֽקֶר בַּבֹּֽקֶר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/qetoret/17"/>בְּהֵיטִיבוֹ אֶת־הַנֵּרֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/qetoret/18"/>יַקְטִירֶֽנָּה:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/30/8"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/qetoret/19"/>וּבְהַעֲלֹת אַהֲרֹן אֶת־הַנֵּרֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/qetoret/20"/>בֵּין הָֽעַרְבַּֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/qetoret/21"/>יַקְטִירֶֽנָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/qetoret/22"/>קְטֹֽרֶת תָּמִיד לִפְנֵי יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/qetoret/23"/>לְדֹרֹתֵיכֶם:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
