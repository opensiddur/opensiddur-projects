        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatov_vehammetiv_barukh/1"/>בָּרוּךְ אַתָּה יְהוָֹה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatov_vehammetiv_barukh/2"/>אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatov_vehammetiv_barukh/3"/>הַטוֹב וְהַמֵּטִיב:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatov_vehammetiv_barukh/4"/>בָּרוּךְ אַתָּה יְהוָֹה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatov_vehammetiv_barukh/5"/>אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatov_vehammetiv_barukh/6"/>דַּיַּן הָאֱמֶת:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatov_vehammetiv_barukh/7"/>בָּרוּךְ אַתָּה יְהוָֹה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatov_vehammetiv_barukh/8"/>אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatov_vehammetiv_barukh/9"/>מַלְבִּישׁ עֲרֻמִּים:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatov_vehammetiv_barukh/10"/>בָּרוּךְ אַתָּה יְהוָֹה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatov_vehammetiv_barukh/11"/>אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatov_vehammetiv_barukh/12"/>בּוֹרֵא מִינֵי בְשָׂמִים:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatov_vehammetiv_barukh/13"/>בָּרוּךְ אַתָּה יְהוָֹה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatov_vehammetiv_barukh/14"/>אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatov_vehammetiv_barukh/15"/>בּוֹרֵא עֲצֵי בְשָׂמִים:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatov_vehammetiv_barukh/16"/>בָּרוּךְ אַתָּה יְהוָֹה
