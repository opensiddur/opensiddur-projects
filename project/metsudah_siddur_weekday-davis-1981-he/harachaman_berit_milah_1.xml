  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:harachaman_berit_milah/1">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/1/1"/>הָרַחֲמָן, הוּא יְבָרֵךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/1/2"/>אֲבִי הַיֶּֽלֶד וְאִמּוֹ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/1/3"/>וְיִזְכּוּ לְגַדְּ֒לוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/1/4"/>וּלְחַנְּ֒כוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/1/5"/>וּלְחַכְּ֒מוֹ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/1/6"/>מִיּוֹם הַשְּׁ֒מִינִי וָהָֽלְאָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/1/7"/>יֵרָצֶה דָמוֹ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/1/8"/>וִיהִי יְהוָֹה אֱלֺהָיו עִמּוֹ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/1/9"/>אָמֵן</tei:p>
      </tei:div>
