    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:harachaman_berit_milah/6">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/6/1"/>הָרַחֲמָן, הוּא יִשְׁלַח לָֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/6/2"/>כֹּהֵן צֶֽדֶק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/6/3"/>אֲשֶׁר לֻקַּח לְעֵילוֹם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/6/4"/>עַד הוּכַן כִּסְאוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/6/5"/>כַּשֶּׁמֶשׁ וְיָהֲלוֹם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/6/6"/>וַיָּֽלֶט פָּנָיו בְּאַדַּרְתּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/6/7"/>וַיִּגְלוֹם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/6/8"/>בְּרִיתִי הָיְתָה אִתּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/6/9"/>הַחַיִּים וְהַשָּׁלוֹם:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/6/10"/>אָמֵן</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
