      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/95/1-3">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/95/1"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/1-3/1"/>לְכוּ נְרַנְּ֒נָה לַיהוָֹה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/1-3/2"/>נָרִֽיעָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/1-3/3"/>לְצוּר יִשְׁעֵֽנוּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/95/2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/1-3/4"/>נְקַדְּ֒מָה פָנָיו בְּתוֹדָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/1-3/5"/>בִּזְמִרוֹת נָרִֽיעַ לוֹ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/95/3"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/1-3/6"/>כִּי אֵל גָּדוֹל יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/95/1-3/7"/>וּמֶֽלֶךְ גָּדוֹל עַל כָּל אֱלֺהִים:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
