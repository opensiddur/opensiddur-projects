      <tei:div corresp="urn:x-opensiddur:text:prayer:zakhor_et_asher">
        <tei:head xml:lang="he">זכירת מחיית עמלק</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zakhor_et_asher/1"/>זָכוֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zakhor_et_asher/2"/>אֵת אֲשֶׁר עָשָׂה לְךָ עֲמָלֵק,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zakhor_et_asher/3"/>בַּדֶּֽרֶךְ בְּצֵאתְ֒כֶם מִמִּצְרָֽיִם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zakhor_et_asher/4"/>אֲשֶׁר קָרְ֒ךָ בַּדֶּֽרֶךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zakhor_et_asher/5"/>וַיְ֒זַנֵּב בְּךָ כָּל הַנֶּחֱשָׁלִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zakhor_et_asher/6"/>אַחֲרֶֽיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zakhor_et_asher/7"/>וְאַתָּה עָיֵף וְיָגֵֽעַ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zakhor_et_asher/8"/>וְלֺא יָרֵא אֱלֺהִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zakhor_et_asher/9"/>וְהָיָה בְּהָנִֽיחַ יְהֹוָה אֱלֺהֶֽיךָ לְךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zakhor_et_asher/10"/>מִכָּל אֹיְ֒בֶֽיךָ מִסָּבִיב,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zakhor_et_asher/11"/>בָּאָֽרֶץ אֲשֶׁר יְהֹוָה אֱלֺהֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zakhor_et_asher/12"/>נֹתֵן לְךָ נַחֲלָה לְרִשְׁתָּהּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zakhor_et_asher/13"/>תִּמְחֶה אֶת זֵֽכֶר עֲמָלֵק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zakhor_et_asher/14"/>מִתַּחַת הַשָּׁמָֽיִם, לֺא תִּשְׁכָּח:</tei:p>
      </tei:div>
