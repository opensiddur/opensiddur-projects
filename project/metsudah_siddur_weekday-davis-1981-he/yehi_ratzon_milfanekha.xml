      <tei:div corresp="urn:x-opensiddur:text:prayer:yehi_ratzon_milfanekha">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_ratzon_milfanekha/1"/><tei:hi rend="small">יְהִי רָצוֹן מִלְפָנֶֽיךָ</tei:hi><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_ratzon_milfanekha/2"/><tei:hi rend="small">יְהֹוָה אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ</tei:hi><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_ratzon_milfanekha/3"/><tei:hi rend="small">שֶׁתִּשְׁלַח מְהֵרָה</tei:hi><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_ratzon_milfanekha/4"/><tei:hi rend="small">רְפוּאָה שְׁלֵמָה מִן הַשָּׁמַֽיִם,</tei:hi><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_ratzon_milfanekha/5"/><tei:hi rend="small">רְפוּאַת הַנֶּֽפֶשׁ</tei:hi><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_ratzon_milfanekha/6"/><tei:hi rend="small">וּרְפוּאַת הַגּוּף,</tei:hi><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_ratzon_milfanekha/7"/><tei:hi rend="small">לַחוֹלֶה</tei:hi><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_ratzon_milfanekha/8"/><tei:hi rend="small">(פלוני/פלונית)</tei:hi><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_ratzon_milfanekha/9"/><tei:hi rend="small">בֶּן/בַּת</tei:hi><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_ratzon_milfanekha/10"/><tei:hi rend="small">(פלונית)</tei:hi><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_ratzon_milfanekha/11"/><tei:hi rend="small">בְּתוֹךְ שְׁאָר חוֹלֵי יִשְׂרָאֵל:</tei:hi><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_ratzon_milfanekha/12"/>כִּי אֵל מֶֽלֶךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_ratzon_milfanekha/13"/>רוֹפֵא נֶאֱמָן וְרַחֲמָן אָֽתָּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_ratzon_milfanekha/14"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yehi_ratzon_milfanekha/15"/>רוֹפֵא חוֹלֵי עַמּוֹ יִשְׂרָאֵל:</tei:p>
      </tei:div>
