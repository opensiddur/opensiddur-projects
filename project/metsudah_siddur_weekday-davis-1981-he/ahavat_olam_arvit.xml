      <tei:div corresp="urn:x-opensiddur:text:prayer:ahavat_olam_arvit">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ahavat_olam_arvit/1"/>אַהֲבַת עוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ahavat_olam_arvit/2"/>בֵּית יִשְׂרָאֵל עַמְּ֒ךָ אָהָֽבְתָּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ahavat_olam_arvit/3"/>תּוֹרָה וּמִצְוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ahavat_olam_arvit/4"/>חֻקִּים וּמִשְׁפָּטִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ahavat_olam_arvit/5"/>אוֹתָֽנוּ לִמַּֽדְתָּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ahavat_olam_arvit/6"/>עַל כֵּן יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ahavat_olam_arvit/7"/>בְּשָׁכְבֵֽנוּ וּבְקוּמֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ahavat_olam_arvit/8"/>נָשִֽׂיחַ בְּחֻקֶּֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ahavat_olam_arvit/9"/>וְנִשְׂמַח
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ahavat_olam_arvit/10"/>בְּדִבְרֵי תַלמוּד תּוֹרָתֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ahavat_olam_arvit/11"/>וּבְמִצְוֹתֶֽיךָ לְעוֹלָם וָעֶד.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ahavat_olam_arvit/12"/>כִּי הֵם חַיֵּֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ahavat_olam_arvit/13"/>וְאֹֽרֶךְ יָמֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ahavat_olam_arvit/14"/>וּבָהֶם נֶהְגֶּה יוֹמָם וָלָֽיְלָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ahavat_olam_arvit/15"/>וְאַהֲבָתְ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ahavat_olam_arvit/16"/>אַל תָּסִיר מִמֶּֽנּוּ לְעוֹלָמִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ahavat_olam_arvit/17"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ahavat_olam_arvit/18"/>אוֹהֵב עַמּוֹ יִשְׂרָאֵל:</tei:p>
      </tei:div>
