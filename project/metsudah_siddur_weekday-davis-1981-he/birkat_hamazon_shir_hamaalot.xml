      <tei:div corresp="urn:x-opensiddur:text:prayer:birkat_hamazon/shir_hamaalot">
        <tei:head xml:lang="he">תהלים קכו</tei:head>
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/126/1"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/shir_hamaalot/1"/>שִׁיר הַמַּעֲלוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/shir_hamaalot/2"/>בְּשׁוּב יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/shir_hamaalot/3"/>אֶת־שִׁיבַת צִיּוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/shir_hamaalot/4"/>הָיִֽינוּ כְּחֹלְ֒מִים:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/126/2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/shir_hamaalot/5"/>אָז יִמָּלֵא שְׂחוֹק פִּֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/shir_hamaalot/6"/>וּלְ֒שׁוֹנֵֽנוּ רִנָּה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/shir_hamaalot/7"/>אָז יֹאמְ֒רוּ בַגּוֹיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/shir_hamaalot/8"/>הִגְדִּיל יְהֹוָה לַעֲשׂוֹת עִם־אֵֽלֶּה:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/126/3"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/shir_hamaalot/9"/>הִגְדִּיל יְהֹוָה לַעֲשׂוֹת עִמָּֽנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/shir_hamaalot/10"/>הָיִֽינוּ שְׂמֵחִים:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/126/4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/shir_hamaalot/11"/>שׁוּבָה יְהֹוָה אֶת־שְׁבִיתֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/shir_hamaalot/12"/>כַּאֲפִיקִים בַּנֶּֽגֶב:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/126/5"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/shir_hamaalot/13"/>הַזֹּרְ֒עִים בְּדִמְעָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/shir_hamaalot/14"/>בְּרִנָּה יִקְצֹֽרוּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/126/6"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/shir_hamaalot/15"/>הָלוֹךְ יֵלֵךְ וּבָכֹה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/shir_hamaalot/16"/>נֹשֵׂא מֶֽשֶׁךְ־הַזָּֽרַע,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/shir_hamaalot/17"/>בֹּא־יָבֹא בְרִנָּה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/shir_hamaalot/18"/>נֹשֵׂא אֲלֻמֹּתָיו:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
