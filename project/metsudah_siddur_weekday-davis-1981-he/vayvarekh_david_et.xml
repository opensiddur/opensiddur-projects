      <tei:div corresp="urn:x-opensiddur:text:prayer:vayvarekh_david_et">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/1"/>וַיְבָֽרֶךְ דָּוִיד אֶת־יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/2"/>לְעֵינֵי כָּל־הַקָּהָל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/3"/>וַיֹּֽאמֶר דָּוִיד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/4"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/5"/>אֱלֹהֵי יִשְׂרָאֵל אָבִֽינוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/6"/>מֵעוֹלָם וְעַד־עוֹלָם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/7"/>לְךָ יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/8"/>הַגְּ֒דֻלָּה וְהַגְּ֒בוּרָה וְהַתִּפְאֶֽרֶת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/9"/>וְהַנֵּֽצַח וְהַהוֹד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/10"/>כִּי־כֹל בַּשָּׁמַֽיִם וּבָאָֽרֶץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/11"/>לְךָ יְהֹוָה הַמַּמְלָכָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/12"/>וְהַמִּתְנַשֵּׂא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/13"/>לְכֹל לְרֹאשׁ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/14"/>וְהָעֽשֶׁר וְהַכָּבוֹד מִלְּ֒פָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/15"/>וְאַתָּה מוֹשֵׁל בַּכֹּל,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/16"/>וּבְיָדְ֒ךָ כֹּֽחַ וּגְבוּרָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/17"/>וּבְיָדְ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/18"/>לְגַדֵּל וּלְחַזֵּק לַכֹּל:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/19"/>וְעַתָּה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/20"/>מוֹדִים אֲנַֽחְנוּ לָךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/21"/>וּמְהַלְ֒לִים לְשֵׁם תִּפְאַרְתֶּֽךָ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/22"/>אַתָּה־הוּא יְהֹוָה לְבַדֶּֽךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/23"/>אַתָּה עָשִֽׂיתָ אֶת־הַשָּׁמַֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/24"/>שְׁמֵי הַשָּׁמַֽיִם וְכָל־צְבָאָם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/25"/>הָאָֽרֶץ וְכָל־אֲשֶׁר עָלֶֽיהָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/26"/>הַיַּמִּים וְכָל־אֲשֶׁר בָּהֶם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/27"/>וְאַתָּה מְחַיֶּה אֶת־כֻּלָּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/28"/>וּצְ֒בָא הַשָּׁמַֽיִם לְךָ מִשְׁתַּחֲוִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/29"/>אַתָּה הוּא יְהֹוָה הָאֱלֹהִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/30"/>אֲשֶׁר בָּחַֽרְתָּ בְּאַבְרָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/31"/>וְהוֹצֵאתוֹ מֵאוּר כַּשְׂדִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/32"/>וְשַֽׂמְתָּ שְׁמוֹ אַבְרָהָם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/33"/>וּמָצָֽאתָ אֶת־לְבָבוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayvarekh_david_et/34"/>נֶאֱמָן לְפָנֶֽיךָ</tei:p>
      </tei:div>
