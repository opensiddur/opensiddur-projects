      <tei:div corresp="urn:x-opensiddur:text:prayer:pittum_haqetoret_hatzori/rashbag">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/1"/>רַבָּן שִׁמְעוֹן בֶּן גַּמְלִיאֵל אוֹמֵר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/2"/>הַצֳּרִי אֵינוֹ אֶלָּא שְׂרָף
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/3"/>הַנּוֹטֵף מֵעֲצֵי הַקְּ֒טָף,
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:pittum_haqetoret_hatzori/rashbag/chol_shacharit_aleinu"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/15"/>בֹּרִית כַּרְשִׁינָה לָמָּה הִיא בָאָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/16"/>כְּדֵי לְיַפּוֹת בָּהּ אֶת הַצִּפֹּרֶן
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:pittum_haqetoret_hatzori/rashbag/chol_shacharit_aleinu"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/4"/>בֹּרִית כַּרְשִׁינָה
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:pittum_haqetoret_hatzori/rashbag/chol_shacharit_aleinu"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/5"/>שֶׁשָׁפִין בָּה אֶת הַצִפֹּרֶן
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/6"/>כִּדֵי שֶׁתְּ֒הֵא נָאָה
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:pittum_haqetoret_hatzori/rashbag/chol_shacharit_aleinu"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/17"/>יֵין קַפְרִיסִין לָמָּה הוּא בָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/18"/>כְּדֵי לִשְׁרוֹת בּוֹ אֶת הַצִּפֹּרֶן
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:pittum_haqetoret_hatzori/rashbag/chol_shacharit_aleinu"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/7"/>יֵין קַפְרִיסִין
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_5"/>
<j:conditional xml:id="variant_6"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:pittum_haqetoret_hatzori/rashbag/chol_shacharit_aleinu"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/8"/>שֶׁשׁוֹרִין בּוֹ אֶת הַצִפֹּרֶן
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_6"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/9"/>כְּדֵי שֶׁתְּ֒הֵא עַזָּה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/10"/>וַהֲלֹא מֵי רַגְלַֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/11"/>יָפִין לָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/12"/>אֶלָּא שֶׁאֵין מַכְנִיסִין
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/13"/>מֵי רַגְלַֽיִם בַּמִּקְדָּשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/14"/>מִפְּנֵי הַכָּבוֹד:</tei:p>
      </tei:div>
