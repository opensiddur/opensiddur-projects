      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/49">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/1"/>לַמְנַצֵּֽחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/2"/>לִבְנֵי קֹֽרַח מִזְמוֹר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/3"/>שִׁמְ֒עוּ זֹאת כָּל־הָעַמִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/4"/>הַאֲזִֽינוּ כָּל יֽשְׁ֒בֵי חָֽלֶד:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/5"/>גַּם בְּנֵי אָדָם גַּם בְּנֵי אִישׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/6"/>יַֽחַד עָשִׁיר וְאֶבְיוֹן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/7"/>פִּי יְדַבֵּר חָכְמוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/8"/>וְהָגוּת לִבִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/9"/>תְבוּנוֹת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/10"/>אַטֶּה לְמָשָׁל אָזְנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/11"/>אֶפְתַּח
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/12"/>בְּכִנּוֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/13"/>חִידָתִי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/14"/>לָֽמָּה אִירָא בִּֽימֵי רָע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/15"/>עֲוֹן עֲקֵבַי יְסוּבֵּֽנִי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/16"/>הַבֹּטְ֒חִים עַל חֵילָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/17"/>וּבְ֒רֹב עָשְׁרָם יִתְהַלָּֽלוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/18"/>אָח לֺא פָדֹה יִפְדֶּה אִישׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/19"/>לֺא יִתֵּן לֵאלֺהִים כָּפְרוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/20"/>וְיֵקַר פִּדְיוֹן נַפְשָׁם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/21"/>וְחָדַל לְעוֹלָם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/22"/>וִיחִי עוֹד לָנֶֽצַח
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/23"/>לֺא יִרְאֶה הַשָּֽׁחַת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/24"/>כִּי יִרְאֶה חֲכָמִים יָמֽוּתוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/25"/>יַֽחַד כְּסִיל וָבַֽעַר יֹאבֵֽדוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/26"/>וְעָזְ֒בוּ לַאֲחֵרִים חֵילָם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/27"/>קִרְבָּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/28"/>בָּתֵּֽימוֹ לְעוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/29"/>מִשְׁכְּ֒נֹתָם לְדוֹר וָדֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/30"/>קָרְ֒אוּ בִשְׁמוֹתָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/31"/>עֲלֵי אֲדָמוֹת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/32"/>וְאָדָם בִּיקָר בַּל־יָלִין
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/33"/>נִמְשַׁל כַּבְּ֒הֵמוֹת נִדְמוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/34"/>זֶה דַרְכָּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/35"/>כֶּֽסֶל לָֽמוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/36"/>וְאַחֲרֵיהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/37"/>בְּפִיהֶם יִרְצוּ סֶֽלָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/38"/>כַּצֹּאן לִשְׁ֒אוֹל שַׁתּוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/39"/>מָֽוֶת יִרְעֵם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/40"/>וַיִּרְדּוּ בָם יְשָׁרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/41"/>לַבֹּֽקֶר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/42"/>וְצוּרָם לְבַלּוֹת שְׁאוֹל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/43"/>מִזְּ֒בֻל לוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/44"/>אַךְ־אֱלֺהִים יִפְדֶּה נַפְשִׁי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/45"/>מִיַּד שְׁאוֹל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/46"/>כִּי יִקָּחֵֽנִי סֶֽלָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/47"/>אַל־תִּירָא כִּי־יַעֲשִׁר אִישׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/48"/>כִּי־יִרְבֶּה כְּבוֹד בֵּיתוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/49"/>כִּי לֺא בְמוֹתוֹ יִקַּח הַכֹּל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/50"/>לֺא־יֵרֵד אַחֲרָיו כְּבוֹדוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/51"/>כִּי־נַפְשׁוֹ בְּחַיָּיו יְבָרֵךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/52"/>וְיוֹדֻֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/53"/>כִּי־תֵיטִיב לָךְ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/54"/>תָּבוֹא עַד־דּוֹר אֲבוֹתָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/55"/>עַד־נֵֽצַח לֺא יִרְאוּ אוֹר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/56"/>אָדָם בִּיקָר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/57"/>וְלֺא־יָבִין
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/49/58"/>נִמְשַׁל כַּבְּ֒הֵמוֹת נִדְמוּ:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
