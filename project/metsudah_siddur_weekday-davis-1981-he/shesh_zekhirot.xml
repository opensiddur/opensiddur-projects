    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:shesh_zekhirot">
        <tei:head xml:lang="he">זכירת יציאת מצרים</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/1"/>לְמַֽעַן תִּזְכֹּר אֶת יוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/2"/>צֵאתְ֒ךָ מֵאֶֽרֶץ מִצְרַֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/3"/>כֹּל יְמֵי חַיֶּֽיךָ:
<tei:milestone unit="phrase"/>
<tei:note type="description" xml:lang="he">זכירת מעמד הר סיני</tei:note>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:deuteronomy/4/9"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/4"/>רַק הִשָּֽׁמֶר לְךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/5"/>וּשְׁמֹר נַפְשְׁ֒ךָ מְאֹד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/6"/>פֶּן תִּשְׁכַּח אֶת הַדְּ֒בָרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/7"/>אֲשֶׁר רָאוּ עֵינֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/8"/>וּפֶן יָסֽוּרוּ מִלְּ֒בָבְ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/9"/>כֹּל יְמֵי חַיֶּֽיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/10"/>וְהוֹדַעְתָּם לְבָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/11"/>וְלִבְנֵי בָנֶֽיךָ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/12"/>יוֹם אֲשֶׁר עָמַֽדְתָּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/13"/>לִפְנֵי יְהֹוָה אֱלֺהֶֽיךָ בְּחֹרֵב:
<tei:milestone unit="phrase"/>
<tei:note type="description" xml:lang="he">זכירת מחיית עמלק</tei:note>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:deuteronomy/25/17"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/14"/>זָכוֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/15"/>אֵת אֲשֶׁר עָשָׂה לְךָ עֲמָלֵק,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/16"/>בַּדֶּֽרֶךְ בְּצֵאתְ֒כֶם מִמִּצְרָֽיִם:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:deuteronomy/25/18"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/17"/>אֲשֶׁר קָרְ֒ךָ בַּדֶּֽרֶךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/18"/>וַיְ֒זַנֵּב בְּךָ כָּל הַנֶּחֱשָׁלִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/19"/>אַחֲרֶֽיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/20"/>וְאַתָּה עָיֵף וְיָגֵֽעַ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/21"/>וְלֺא יָרֵא אֱלֺהִים:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:deuteronomy/25/19"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/22"/>וְהָיָה בְּהָנִֽיחַ יְהֹוָה אֱלֺהֶֽיךָ לְךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/23"/>מִכָּל אֹיְ֒בֶֽיךָ מִסָּבִיב,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/24"/>בָּאָֽרֶץ אֲשֶׁר יְהֹוָה אֱלֺהֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/25"/>נֹתֵן לְךָ נַחֲלָה לְרִשְׁתָּהּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/26"/>תִּמְחֶה אֶת זֵֽכֶר עֲמָלֵק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/27"/>מִתַּחַת הַשָּׁמָֽיִם, לֺא תִּשְׁכָּח:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:note type="description" xml:lang="he">זכירת מעשה העגל</tei:note>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:deuteronomy/9/7"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/28"/>זְכֹר אַל תִּשְׁכַּח
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/29"/>אֵת אֲשֶׁר הִקְצַֽפְתָּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/30"/>אֶת יְהֹוָה אֱלֺהֶֽיךָ בַּמִּדְבָּר:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:note type="description" xml:lang="he">זכירת מעשה מרים</tei:note>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:deuteronomy/24/9"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/31"/>זָכוֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/32"/>אֵת אֲשֶׁר עָשָׂה יְהֹוָה אֱלֺהֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/33"/>לְמִרְיָם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/34"/>בַּדֶּֽרֶךְ בְּצֵאתְ֒כֶם מִמִּצְרָֽיִם:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:note type="description" xml:lang="he">זכירת השבת</tei:note>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shesh_zekhirot/35"/>זָכוֹר אֶת יוֹם הַשַּׁבָּת לְקַדְּ֒שׁוֹ:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
