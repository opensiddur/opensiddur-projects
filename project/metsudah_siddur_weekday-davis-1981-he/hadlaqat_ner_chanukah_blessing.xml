      <tei:div corresp="urn:x-opensiddur:text:prayer:hadlaqat_ner_chanukah/blessing">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_chanukah/blessing/1"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_chanukah/blessing/2"/>אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_chanukah/blessing/3"/>אֲשֶׁר קִדְּ֒שָֽׁנוּ בְּמִצְוֹתָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_chanukah/blessing/4"/>וְצִוָּֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_chanukah/blessing/5"/>לְהַדְלִיק נֵר חֲנֻכָּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_chanukah/blessing/6"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_chanukah/blessing/7"/>אֱלֹהֵינוּ מֶֽלֶךְ הָעוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_chanukah/blessing/8"/>שֶׁעָשָׂה נִסִּים לַאֲבוֹתֵינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_chanukah/blessing/9"/>בַּיָּמִים הָהֵם בַּזְּ֒מַן הַזֶּה:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_chanukah/blessing/10"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_chanukah/blessing/11"/>אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_chanukah/blessing/12"/>שֶׁהֶחֱיָֽנוּ וְקִיְּמָנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_chanukah/blessing/13"/>וְהִגִּיעָֽנוּ לַזְּ֒מַן הַזֶּה:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_chanukah/blessing/14"/>הַנֵּרוֹת הַלָּלוּ אָנוּ מַדְלִיקִין
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_chanukah/blessing/15"/>עַל הַנִּסִּים וְעַל הַנִּפְלָאוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_chanukah/blessing/16"/>וְעַל הַתְּ֒שׁוּעוֹת וְעַל הַמִּלְחָמוֹת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_chanukah/blessing/17"/>שֶׁעָשִֽׂיתָ לַאֲבוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_chanukah/blessing/18"/>בַּיָּמִים הָהֵם בַּזְּ֒מַן הַזֶּה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_chanukah/blessing/19"/>עַל יְדֵי כֹּהֲנֶֽיךָ הַקְּ֒דוֹשִׁים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_chanukah/blessing/20"/>וְכָל מִצְוַת שְׁמוֹנַת יְמֵי חֲנֻכָּה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_chanukah/blessing/21"/>הַנֵּרוֹת הַלָּלוּ קֹֽדֶשׁ הֵם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_chanukah/blessing/22"/>וְאֵין לָֽנוּ רְשׁוּת לְהִשְׁתַּמֵּשׁ בָּהֶם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_chanukah/blessing/23"/>אֶלָּא לִרְאוֹתָם בִּלְבָד.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_chanukah/blessing/24"/>כְּדֵי לְהוֹדוֹת וּלְהַלֵּל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_chanukah/blessing/25"/>לְשִׁמְךָ הַגָּדוֹל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_chanukah/blessing/26"/>עַל נִסֶּֽיךָ וְעַל יְשׁוּעָתֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_chanukah/blessing/27"/>וְעַל נִפְלְ֒אוֹתֶֽיךָ:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
