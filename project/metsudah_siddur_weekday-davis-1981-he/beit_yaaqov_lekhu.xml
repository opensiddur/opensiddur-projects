      <tei:div corresp="urn:x-opensiddur:text:prayer:beit_yaaqov_lekhu">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:isaiah/2/5"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/1"/>בֵּית יַעֲקֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/2"/>לְכוּ וְנֵלְ֒כָה בְּאוֹר יְהוָֹה:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:micah/4/5"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/3"/>כִּי כָּל־הָעַמִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/4"/>יֵֽלְ֒כוּ אִישׁ בְּשֵׁם אֱלֺֽהָיו,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/5"/>וַֽאֲנַֽחְנוּ נֵלֵךְ בְּשֵׁם־יְהוָֹה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/6"/>אֱלֹהֵֽינוּ לְעוֹלָם וָעֶד:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:kings_1/8/57"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/7"/>יְהִי יְהוָֹה אֱלֹהֵֽינוּ עִמָּֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/8"/>כַּֽאֲשֶׁר הָיָה עִם־אֲבוֹתֵֽינוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/9"/>אַל־יַֽעַזְ֒בֵֽנוּ וְאַל־יִטְּ֒שֵֽׁנוּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:kings_1/8/58"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/10"/>לְהַטּוֹת לְבָבֵֽנוּ אֵלָיו,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/11"/>לָלֶֽכֶת בְּכָל־דְּרָכָיו,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/12"/>וְלִשְׁמֹר מִצְוֹתָיו, וְחֻקָּיו,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/13"/>וּמִשְׁפָּטָיו,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/14"/>אֲשֶׁר צִוָּה אֶת־אֲבֹתֵֽינוּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:kings_1/8/59"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/15"/>וְיִהְיוּ דְבָרַי אֵֽלֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/16"/>אֲשֶׁר הִתְחַנַּֽנְתִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/17"/>לִפְנֵי יְהוָֹה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/18"/>קְרֹבִים אֶל יְהוָֹה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/19"/>יוֹמָם וָלָֽיְלָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/20"/>לַעֲשׂוֹת מִשְׁפַּט עַבְדּוֹ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/21"/>וּמִשְׁפַּט עַמּוֹ יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/22"/>דְּבַר־יוֹם בְּיוֹמוֹ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:kings_1/8/60"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/23"/>לְמַֽעַן דַּֽעַת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/24"/>כָּל־עַמֵּי הָאָֽרֶץ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/25"/>כִּי יְהוָֹה הוּא הָֽאֱלֹהִים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/26"/>אֵין עוֹד:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
