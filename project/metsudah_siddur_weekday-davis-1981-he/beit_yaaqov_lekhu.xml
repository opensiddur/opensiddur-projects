<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/111"/>כְּשִׁמְךָ אֱלֺהִים כֵּן תְּהִלָּתְ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/112"/>עַל קַצְוֵי אֶֽרֶץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/113"/>צֶֽדֶק מָלְ֒אָה יְמִינֶֽךָ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/48/12"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/114"/>יִשְׂמַח הַר צִיּוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/115"/>תָּגֵֽלְנָה בְּנוֹת יְהוּדָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/116"/>לְמַֽעַן מִשְׁפָּטֶֽיךָ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/48/13"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/117"/>סֹֽבּוּ צִיּוֹן וְהַקִּיפֽוּהָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/118"/>סִפְ֒רוּ מִגְדָּלֶֽיהָ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/48/14"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/119"/>שִֽׁיתוּ לִבְּ֒כֶם לְחֵילָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/120"/>פַּסְּ֒גוּ אַרְמְ֒נוֹתֶֽיהָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/121"/>לְמַֽעַן תְּסַפְּ֒רוּ לְדוֹר אַחֲרוֹן:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/48/15"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/122"/>כִּי זֶה אֱלֺהִים אֱלֺהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/123"/>עוֹלָם וָעֶד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:beit_yaaqov_lekhu/124"/>הוּא יְנַהֲגֵֽנוּ עַל מוּת:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
