      <tei:div corresp="urn:x-opensiddur:text:prayer:leummatam_meshabbechim_veomerim_barukh">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:leummatam_meshabbechim_veomerim_barukh/1"/>לְעֻמָּתָם מְשַׁבְּ֒חִים וְאוֹמְ֒רִים:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:leummatam_meshabbechim_veomerim_barukh/2"/>בָּרוּךְ כְּבוֹד יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:leummatam_meshabbechim_veomerim_barukh/3"/>מִמְּ֒קוֹמוֹ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:leummatam_meshabbechim_veomerim_barukh/4"/>וּבְ֒דִבְרֵי קָדְשְׁ֒ךָ כָּתוּב לֵאמֹר:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:leummatam_meshabbechim_veomerim_barukh/5"/>יִמְלֹךְ יְהֹוָה לְעוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:leummatam_meshabbechim_veomerim_barukh/6"/>אֱלֹהַֽיִךְ צִיּוֹן לְדֹר וָדֹר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:leummatam_meshabbechim_veomerim_barukh/7"/>הַלְ֒לוּיָהּ:</tei:p>
      </tei:div>
