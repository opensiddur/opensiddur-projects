    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:viduy/introduction">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/1"/>אֱלֺהֵֽינוּ וֵאלֺהֵי אֲבוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/2"/>תָּבֹא לְפָנֶֽיךָ תְּפִלָּֽתֵֽנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/3"/>וְאַל־תִּתְעַלַּם מִתְּ֒חִנָּתֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/4"/>שֶׁאֵין אָֽנוּ עַזֵּי פָנִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/5"/>וּקְשֵׁי עֹֽרֶף
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/6"/>לוֹמַר לְפָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/7"/>יְהֹוָה אֱלֺהֵֽינוּ וֵאלֺהֵי אֲבוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/8"/>צַדִּיקִים אֲנַֽחְנוּ וְלֺא חָטָֽאנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/9"/>אֲבָל אֲנַֽחְנוּ וַאֲבוֹתֵֽינוּ חָטָֽאנוּ:</tei:p>
