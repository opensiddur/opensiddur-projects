      <tei:div corresp="urn:x-opensiddur:text:prayer:ribbono_shel_olam_hareini">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_hareini/1"/>רִבּוֹנוֹ שֶׁל־עוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_hareini/2"/>הֲרֵינִי מוֹחֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_hareini/3"/>לְכָל־מִי שֶׁהִכְעִיס וְהִקְנִיט אוֹתִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_hareini/4"/>אוֹ שֶׁחָטָא כְּנֶגְדִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_hareini/5"/>בֵּין בְּגוּפִי בֵּין בְּמָמוֹנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_hareini/6"/>בֵין בִּכְבוֹדִי בֵין בְכָל אֲשֶׁר לִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_hareini/7"/>בֵין בְּאוֹנֶס בֵּין בְּרָצוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_hareini/8"/>בֵּין בְּשׁוֹגֵג בֵּין בְּמֵזִיד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_hareini/9"/>בֵין בְּדִבּוּר בֵּין בְּמַעֲשֶׂה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_hareini/10"/>בֵּין בְּגִלְגוּל זֶה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_hareini/11"/>בֵּין בְּגִלְגּוּל אַחֵר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_hareini/12"/>לְכָל־בַּר יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_hareini/13"/>וְלֹא יֵעָנֵשׁ שׁוּם אָדָם בְסִבָּתִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_hareini/14"/>יְהִי רָצוֹן מִלְּפָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_hareini/15"/>יְהֹוָה אֱלֹהַי וֵאלֹהֵי אֲבוֹתַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_hareini/16"/>שֶׁלֹּא אֶחְטֶא עוֹד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_hareini/17"/>וְלֹא אֶחֱזוֹר בָּהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_hareini/18"/>וְלֹא אָשׁוּב עוֹד לְהַכְעִיסֶךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_hareini/19"/>וְלֹא אֶעֱשֶׂה הָרַע בְּעֵינֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_hareini/20"/>וּמַה־שֶׁחָטָֽאתִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_hareini/21"/>מְחוֹק בְּרַחֲמֶֽיךָ הָרַבִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_hareini/22"/>וְלֹא עַל יְדֵי יִסּוּרִים וָחֳלָיִם רָעִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_hareini/23"/>יִהְיוּ לְרָצוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_hareini/24"/>אִמְרֵי־פִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_hareini/25"/>וְהֶגְיוֹן לִבִּי לְפָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam_hareini/26"/>יְהֹוָה צוּרִי וְגֹאֲלִי:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
