    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:av_harachaman_shema">
        <tei:head xml:lang="he">קבלת תפלה</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachaman_shema/1"/>אָב הָרַחֲמָן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachaman_shema/2"/>שְׁמַע קוֹלֵֽנוּ יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachaman_shema/3"/>חוּס וְרַחֵם עָלֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachaman_shema/4"/>וְקַבֵּל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachaman_shema/5"/>בְּרַחֲמִים וּבְרָצוֹן אֶת תְּפִלָּתֵֽנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachaman_shema/6"/>כִּי אֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachaman_shema/7"/>שׁוֹמֵֽעַ תְּפִלּוֹת וְתַחֲנוּנִים אָֽתָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachaman_shema/8"/>וּמִלְּ֒פָנֶֽיךָ מַלְכֵּֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachaman_shema/9"/>רֵיקָם אַל תְּשִׁיבֵֽנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachaman_shema/10"/>חָנֵּֽנוּ וַעֲנֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachaman_shema/11"/>וּשְׁמַע תְּפִלָתֵֽנוּ*
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachaman_shema/12"/>כִּי אַתָּה שׁוֹמֵֽעַ תְּפִלַּת כָּל פֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachaman_shema/13"/>עַמְּ֒ךָ יִשְׂרָאֵל בְּרַחֲמִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachaman_shema/14"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachaman_shema/15"/>שׁוֹמֵֽעַ תְּפִלָּה:</tei:p>
      </tei:div>
