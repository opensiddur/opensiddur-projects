      <tei:div corresp="urn:x-opensiddur:text:prayer:al_hanissim/purim/bimei">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/purim/bimei/1"/>בִּימֵי מָרְדְּ֒כַי וְאֶסְתֵּר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/purim/bimei/2"/>בְּשׁוּשַׁן הַבִּירָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/purim/bimei/3"/>כְּשֶׁעָמַד עֲלֵיהֶם הָמָן הָרָשָׁע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/purim/bimei/4"/>בִּקֵּשׁ לְהַשְׁמִיד לַהֲרוֹג
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/purim/bimei/5"/>וּלְאַבֵּד אֶת־כָּל־הַיְּ֒הוּדִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/purim/bimei/6"/>מִנַּֽעַר וְעַד־זָקֵן טַף וְנָשִׁים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/purim/bimei/7"/>בְּיוֹם אֶחָד בִּשְׁלוֹשָׁה עָשָׂר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/purim/bimei/8"/>לְחֹֽדֶשׁ שְׁנֵים־עָשָׂר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/purim/bimei/9"/>הוּא־חֹֽדֶשׁ אֲדָר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/purim/bimei/10"/>וּשְׁלָלָם לָבוֹז:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/purim/bimei/11"/>וְאַתָּה בְּרַחֲמֶֽיךָ הָרַבִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/purim/bimei/12"/>הֵפַֽרְתָּ אֶת־עֲצָתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/purim/bimei/13"/>וְקִלְקַֽלְתָּ אֶת־מַחֲשַׁבְתּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/purim/bimei/14"/>וַהֲשֵׁבֽוֹתָ לּוֹ גְּמוּלוֹ בְּרֹאשׁוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/purim/bimei/15"/>וְתָלוּ אוֹתוֹ וְאֶת־בָּנָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/purim/bimei/16"/>עַל־הָעֵץ:</tei:p>
      </tei:div>
