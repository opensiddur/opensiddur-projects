      <tei:div corresp="urn:x-opensiddur:text:prayer:hallel/psalm_116">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/1"/>אָהַֽבְתִּי כִּי־יִשְׁמַע יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/2"/>אֶת־קוֹלִי תַּחֲנוּנָי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/3"/>כִּי־הִטָּה אָזְנוֹ לִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/4"/>וּבְיָמַי אֶקְרָא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/5"/>אֲפָפֽוּנִי חֶבְלֵי־מָֽוֶת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/6"/>וּמְצָרֵי שְׁאוֹל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/7"/>מְצָאֽוּנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/8"/>צָרָה וְיָגוֹן אֶמְצָא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/9"/>וּבְשֵׁם־יְהֹוָה אֶקְרָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/10"/>אָנָּה יְהֹוָה מַלְּ֒טָה נַפְשִׁי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/11"/>חַנּוּן יְהֹוָה וְצַדִּיק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/12"/>וֵאלֹהֵֽינוּ מְרַחֵם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/13"/>שֹׁמֵר פְּתָאיִם יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/14"/>דַּלּוֹתִי וְלִי יְהוֹשִֽׁיעַ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/15"/>שׁוּבִי נַפְשִׁי לִמְנוּחָֽיְכִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/16"/>כִּי־יְהֹוָה גָּמַל עָלָֽיְכִי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/17"/>כִּי חִלַּֽצְתָּ נַפְשִׁי מִמָּֽוֶת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/18"/>אֶת־עֵינִי מִן־דִּמְעָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/19"/>אֶת־רַגְלִי מִדֶּֽחִי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/20"/>אֶתְהַלֵּךְ לִפְנֵי יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/21"/>בְּאַרְצוֹת הַחַיִּים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/22"/>הֶאֱמַֽנְתִּי כִּי אֲדַבֵּר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/23"/>אֲנִי עָנִֽיתִי מְאֹד:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/24"/>אֲנִי אָמַֽרְתִּי בְחָפְזִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/25"/>כָּל־הָאָדָם כֹּזֵב:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/26"/>מָה־אָשִׁיב לַיהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/27"/>כָּל־תַּגְמוּלֽוֹהִי עָלָי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/28"/>כּוֹס־יְשׁוּעוֹת אֶשָּׂא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/29"/>וּבְשֵׁם יְהֹוָה אֶקְרָא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/30"/>נְדָרַי לַיהֹוָה אֲשַׁלֵּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/31"/>נֶגְדָה־נָּא לְכָל־עַמּוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/32"/>יָקָר בְּעֵינֵי יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/33"/>הַמָּֽוְתָה לַחֲסִידָיו:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/34"/>אָנָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/35"/>כִּי־אֲנִי עַבְדֶּֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/36"/>אֲנִי־עַבְדְּ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/37"/>בֶּן־אֲמָתֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/38"/>פִּתַּֽחְתָּ לְמוֹסֵרָי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/39"/>לְךָ־אֶזְבַּח זֶֽבַח תּוֹדָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/40"/>וּבְשֵׁם יְהֹוָה אֶקְרָא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/41"/>נְדָרַי לַיהֹוָה אֲשַׁלֵּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/42"/>נֶגְדָה־נָּא לְכָל־עַמּוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/43"/>בְּחַצְרוֹת בֵּית יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/44"/>בְּתוֹכֵֽכִי יְרוּשָׁלָֽםִ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_116/45"/>הַלְ֒לוּיָהּ:</tei:p>
      </tei:div>
