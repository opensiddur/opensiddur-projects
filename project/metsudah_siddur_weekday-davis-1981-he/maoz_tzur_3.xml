    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:maoz_tzur/3">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/3/1"/>דְּבִיר קָדְשׁוֹ הֱבִיאַֽנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/3/2"/>וְגַם שָׁם לֹא שָׁקַֽטְתִּי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/3/3"/>וּבָא נוֹגֵשׂ וְהִגְלַֽנִי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/3/4"/>כִּי זָרִים עָבַֽדְתִּי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/3/5"/>וְיֵין רַעַֽל מָסַֽכְתִּי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/3/6"/>כִּמְעַט שֶׁעָבַֽרְתִּי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/3/7"/>קֵץ בָּבֶל.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/3/8"/>זְרֻבָּבֶל.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/3/9"/>לְקֵץ שִׁבְעִים נוֹשָֽׁעְתִּי:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
