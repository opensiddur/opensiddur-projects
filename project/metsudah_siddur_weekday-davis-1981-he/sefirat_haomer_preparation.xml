      <tei:div corresp="urn:x-opensiddur:text:prayer:sefirat_haomer/preparation">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/preparation/1"/>הִנְ֒נִי מוּכָן וּמְזֻמָּן לְקַיֵּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/preparation/2"/>מִצְוַת עֲשֵׂה שֶׁל סְפִירַת הָעֹֽמֶר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/preparation/3"/>כְּמוֹ שֶׁכָּתוּב בַּתּוֹרָה.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:leviticus/23/15"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/preparation/4"/>וּסְפַרְתֶּם לָכֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/preparation/5"/>מִמָּחֳרַת הַשַּׁבָּת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/preparation/6"/>מִיּוֹם הֲבִיאֲכֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/preparation/7"/>אֶת עֹֽמֶר הַתְּ֒נוּפָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/preparation/8"/>שֶֽׁבַע שַׁבָּתוֹת תְּמִימוֹת תִּהְיֶֽינָה:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:leviticus/23/16"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/preparation/9"/>עַד מִמָּחֳרַת הַשַּׁבָּת הַשְּׁ֒בִיעִית
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/preparation/10"/>תִּסְפְּ֒רוּ חֲמִשִּׁים יוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/preparation/11"/>וְהִקְרַבְתֶּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sefirat_haomer/preparation/12"/>מִנְחָה חֲדָשָׁה לַיהוָֹה:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
