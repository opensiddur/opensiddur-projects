    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:shelamim_qadashim_qallim">
        <tei:head xml:lang="he">
          <tei:hi rend="small">משנה ז</tei:hi>
        </tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shelamim_qadashim_qallim/1"/>שְׁלָמִים קָדָשִׁים קַלִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shelamim_qadashim_qallim/2"/>שְׁחִיטָתָן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shelamim_qadashim_qallim/3"/>בְּכָל מָקוֹם בָּעֲזָרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shelamim_qadashim_qallim/4"/>וְדָמָן טָעוּן שְׁתֵּי מַתָּנוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shelamim_qadashim_qallim/5"/>שֶׁהֵן אַרְבַּע,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shelamim_qadashim_qallim/6"/>וְנֶאֱכָלִין בְּכָל הָעִיר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shelamim_qadashim_qallim/7"/>לְכָל אָדָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shelamim_qadashim_qallim/8"/>בְּכָל מַאֲכָל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shelamim_qadashim_qallim/9"/>לִשְׁנֵי יָמִים וְלַֽיְלָה אֶחָד:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shelamim_qadashim_qallim/10"/>הַמּוּרָם מֵהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shelamim_qadashim_qallim/11"/>כַּיּוֹצֵא בָהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shelamim_qadashim_qallim/12"/>אֶלָּא שֶׁהַמּוּרָם נֶאֱכָל לַכֹּהֲנִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shelamim_qadashim_qallim/13"/>לִנְשֵׁיהֶם וְלִבְנֵיהֶם וּלְעַבְדֵיהֶם:</tei:p>
      </tei:div>
