      <tei:div corresp="urn:x-opensiddur:text:prayer:shema_yisrael_adonai">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_yisrael_adonai/1"/>שְׁמַע יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_yisrael_adonai/2"/>יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_yisrael_adonai/3"/>יְהֹוָה אֶחָד:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_yisrael_adonai/4"/><tei:hi rend="small">בָּרוּךְ שֵׁם כְּבוֹד מַלְכוּתוֹ</tei:hi>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_yisrael_adonai/5"/><tei:hi rend="small">לְעוֹלָם וָעֶד:</tei:hi>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_yisrael_adonai/6"/>וְאָהַבְתָּ אֵת יְהֹוָה אֱלֹהֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_yisrael_adonai/7"/>בְּכָל֯־לְ֯בָבְךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_yisrael_adonai/8"/>וּבְכָל־נַפְשְׁךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_yisrael_adonai/9"/>וּבְכָל־מְאֹדֶֽךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_yisrael_adonai/10"/>וְהָיוּ הַדְּ֒בָרִים הָאֵֽלֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_yisrael_adonai/11"/>אֲשֶׁר֯ אָ֯נֹכִי מְצַוְּךָ הַיּוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_yisrael_adonai/12"/>עַל֯־לְ֯בָבֶֽךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_yisrael_adonai/13"/>וְשִׁנַּנְתָּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_yisrael_adonai/14"/>לְבָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_yisrael_adonai/15"/>וְדִבַּרְתָּ בָּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_yisrael_adonai/16"/>בְּשִׁבְתְּ֒ךָ בְּבֵיתֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_yisrael_adonai/17"/>וּבְלֶכְתְּ֒ךָ בַדֶּֽרֶךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_yisrael_adonai/18"/>וּבְשָׁכְבְּ֒ךָ וּבְקוּמֶֽךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_yisrael_adonai/19"/>וּקְשַׁרְתָּם לְאוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_yisrael_adonai/20"/>עַל֯־יָ֯דֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_yisrael_adonai/21"/>וְהָיוּ לְטֹטָפֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_yisrael_adonai/22"/>בֵּין עֵינֶֽיךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_yisrael_adonai/23"/>וּכְתַבְתָּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_yisrael_adonai/24"/>עַל־מְזֻזוֹת בֵּיתֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_yisrael_adonai/25"/>וּבִשְׁעָרֶֽיךָ:</tei:p>
      </tei:div>
    </tei:body>
