        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tzaddiqim/1"/>עַל־הַצַּדִּיקִים וְעַל־הַחֲסִידִים
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/tzaddiqim/chol_minchah_shemoneh_esreh"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tzaddiqim/15"/>וְעַל זִקְ֒נֵי שְׁאֵרִית
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tzaddiqim/16"/>עַמְּ֒ךָ בֵּית יִשְׂרָאֵל
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/tzaddiqim/chol_arvit_shemoneh_esreh"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tzaddiqim/19"/>וְעַל זִקְ֒נֵי שְׁאֵרִית עַמְּ֒ךָ
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/tzaddiqim/chol_minchah_shemoneh_esreh"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/tzaddiqim/chol_arvit_shemoneh_esreh"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tzaddiqim/2"/>וְעַל־זִקְנֵי עַמְּ֒ךָ
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/tzaddiqim/chol_minchah_shemoneh_esreh"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tzaddiqim/3"/>בֵּית יִשְׂרָאֵל
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tzaddiqim/4"/>וְעַל־פְּלֵיטַת (בֵּית) סוֹפְ֒רֵיהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tzaddiqim/5"/>וְעַל־גֵּרֵי הַצֶּֽדֶק וְעָלֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tzaddiqim/6"/>יֶהֱמוּ נָא רַחֲמֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tzaddiqim/7"/>יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tzaddiqim/8"/>וְתֵן שָׂכָר טוֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tzaddiqim/9"/>לְכָל־הַבּוֹטְ֒חִים בְּשִׁמְךָ בֶּאֱמֶת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tzaddiqim/10"/>וְשִׂים חֶלְקֵֽנוּ עִמָּהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tzaddiqim/11"/>וּלְעוֹלָם לֹא נֵבוֹשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tzaddiqim/12"/>כִּי בְךָ בָטָֽחְנוּ:
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/tzaddiqim/chol_minchah_shemoneh_esreh"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tzaddiqim/17"/>וְעַל חַסְדְּ֒ךָ הַגָּדוֹל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tzaddiqim/18"/>בֶּאֱמֶת נִשְׁעָֽנְנוּ:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_5"/>
<j:conditional xml:id="variant_6"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/tzaddiqim/chol_arvit_shemoneh_esreh"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tzaddiqim/20"/>וְעַל חַסְדְּ֒ךָ הַגָּדוֹל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tzaddiqim/21"/>בֶּאֱמֶת נִשְׁעָֽנְנוּ:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_6"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tzaddiqim/13"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/tzaddiqim/14"/>מִשְׁעָן וּמִבְטָח לַצַּדִּיקִים:</tei:p>
