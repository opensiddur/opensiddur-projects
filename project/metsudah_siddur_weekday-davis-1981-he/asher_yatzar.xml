      <tei:div corresp="urn:x-opensiddur:text:prayer:asher_yatzar">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_yatzar/1"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_yatzar/2"/>אֱלֹהֵֽינוּ מֶֽלֶךְ הָעוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_yatzar/3"/>אֲשֶׁר יָצַר אֶת הָאָדָם בְּחָכְמָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_yatzar/4"/>וּבָֽרָא בוֹ נְקָבִים נְקָבִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_yatzar/5"/>חֲלוּלִים חֲלוּלִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_yatzar/6"/>גָּלוּי וְיָדֽוּעַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_yatzar/7"/>לִפְנֵי כִסֵּא כְבוֹדֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_yatzar/8"/>שֶׁאִם יִפָּתֵֽחַ אֶחָד מֵהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_yatzar/9"/>אוֹ יִסָּתֵם אֶחָד מֵהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_yatzar/10"/>אִי אֶפְשַׁר לְהִתְקַיֵּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_yatzar/11"/>וְלַעֲמֹד לְפָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_yatzar/12"/>אֲפִילוּ שָׁעָה אֶחָת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_yatzar/13"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_yatzar/14"/>רוֹפֵא כָל בָּשָׂר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_yatzar/15"/>וּמַפְלִיא לַעֲשׂוֹת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_yatzar/16"/>אֱלֹהַי,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_yatzar/17"/>נְשָׁמָה שֶׁנָּתַֽתָּ בִּי טְהוֹרָה הִיא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_yatzar/18"/>אַתָּה בְרָאתָהּ אַתָּה יְצַרְתָּהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_yatzar/19"/>אַתָּה נְפַחְתָּהּ בִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_yatzar/20"/>וְאַתָּה מְשַׁמְּ֒רָהּ בְּקִרְבִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_yatzar/21"/>וְאַתָּה עָתִיד לִטְּ֒לָהּ מִמֶּֽנִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_yatzar/22"/>וּלְהַחֲזִירָהּ בִּי לֶעָתִיד לָבֹא,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_yatzar/23"/>כָּל זְמַן שֶׁהַנְּ֒שָׁמָה בְקִרְבִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_yatzar/24"/>מוֹדֶה אֲנִי לְפָנֶֽיךָ יְהֹוָה אֱלֹהַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_yatzar/25"/>וֵאלֹהֵי אֲבוֹתַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_yatzar/26"/>רִבּוֹן כָּל הַמַּעֲשִׂים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_yatzar/27"/>אֲדוֹן כָּל הַנְּ֒שָׁמוֹת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_yatzar/28"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_yatzar/29"/>הַמַּחֲזִיר נְשָׁמוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_yatzar/30"/>לִפְגָרִים מֵתִים:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
