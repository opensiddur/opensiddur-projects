      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/naaritz">
        <tei:head xml:lang="he">קדושה</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/naaritz/1"/>כֶּֽתֶר יִתְּ֒נוּ לְךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/naaritz/2"/>יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/naaritz/3"/>מַלְאָכִים הֲמֽוֹנֵי מַֽעְלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/naaritz/4"/>עִם עַמְּ֒ךָ יִשְׂרָאֵל קְבוּצֵי מַֽטָּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/naaritz/5"/>יַחַד כֻּלָּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/naaritz/6"/>קְדֻשָּׁה לְךָ יְשַׁלֵּֽשׁוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/naaritz/7"/>כַּדָּבָר הָאָמוּר עַל יַד נְבִיאֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/naaritz/8"/>וְקָרָא זֶה אֶל זֶה וְאָמַר:</tei:p>
      </tei:div>
