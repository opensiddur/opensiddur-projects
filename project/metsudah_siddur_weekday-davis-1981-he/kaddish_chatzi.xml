      <tei:div corresp="urn:x-opensiddur:text:prayer:kaddish/chatzi">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/1"/>יִתְגַּדַּל וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/2"/>בְּעָלְ֒מָא דִּי בְרָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/3"/>כִרְעוּתֵהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/4"/>וְיַמְלִיךְ מַלְכוּתֵהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/5"/>וְיַצְמַח פּוּרְקָנֵהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/6"/>וִיקָרֵב (קֵץ) מְשִׁיחֵהּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/7"/>בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/8"/>וּבְחַיֵּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/9"/>דְכָל בֵּית יִשְׂרָאֵל,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/10"/>בַּעֲגָלָא וּבִזְמַן קָרִיב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/11"/>וְאִמְרוּ אָמֵן</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
