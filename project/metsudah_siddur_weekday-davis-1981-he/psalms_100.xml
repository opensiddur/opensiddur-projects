      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/100">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/100/1"/>מִזְמוֹר לְתוֹדָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/100/2"/>הָרִֽיעוּ לַיהוָֹה כָּל־הָאָֽרֶץ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/100/3"/>עִבְדוּ אֶת יְהֹוָה בְּשִׂמְחָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/100/4"/>בֹּֽאוּ לְפָנָיו בִּרְנָנָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/100/5"/>דְּעוּ כִּי־יְהֹוָה הוּא אֱלֹהִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/100/6"/>הוּא עָשָֽׂנוּ וְלוֹ (וְלֹא) אֲנַֽחְנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/100/7"/>עַמּוֹ וְצֹאן מַרְעִיתוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/100/8"/>בֹּֽאוּ שְׁעָרָיו בְּתוֹדָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/100/9"/>חֲצֵרֹתָיו בִּתְהִלָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/100/10"/>הֽוֹדוּ לוֹ בָּרְ֒כוּ שְׁמוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/100/11"/>כִּי־טוֹב יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/100/12"/>לְעוֹלָם חַסְדּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/100/13"/>וְעַד־דֹּר וָדֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/100/14"/>אֱמוּנָתוֹ:</tei:p>
