      <tei:div corresp="urn:x-opensiddur:text:prayer:tefillin/umechokhmatekha">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillin/umechokhmatekha/1"/>וּמֵחָכְמָתְ֒ךָ אֵל עֶלְיוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillin/umechokhmatekha/2"/>תַּאֲצִיל עָלַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillin/umechokhmatekha/3"/>וּמִבִּינָתְ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillin/umechokhmatekha/4"/>תְּבִינֵֽנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillin/umechokhmatekha/5"/>וּבְחַסְדְּ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillin/umechokhmatekha/6"/>תַּגְדִּיל עָלַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillin/umechokhmatekha/7"/>וּבִגְבוּרָתְ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillin/umechokhmatekha/8"/>תַּצְמִית אוֹיְ֒בַי וְקָמַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillin/umechokhmatekha/9"/>וְשֶׁמֶן הַטּוֹב תָּרִיק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillin/umechokhmatekha/10"/>עַל שִׁבְעָה קְנֵי הַמְּ֒נוֹרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillin/umechokhmatekha/11"/>לְהַשְׁפִּֽיעַ טוּבְ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillin/umechokhmatekha/12"/>לִבְרִיּוֹתֶֽיךָ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/145/16"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillin/umechokhmatekha/13"/>פּוֹתֵחַ אֶת יָדֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tefillin/umechokhmatekha/14"/>וּמַשְׂבִּֽיעַ לְכָל חַי רָצוֹן:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
