    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:eizehu_meqoman/3">
        <tei:head xml:lang="he">
          <tei:hi rend="small">משנה ג</tei:hi>
        </tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/3/1"/>חַטֹּאת הַצִּבּוּר וְהַיָּחִיד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/3/2"/>אֵֽלּוּ הֵן חַטֹּאת הַצִּבּוּר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/3/3"/>שְׂעִירֵי רָאשֵׁי חֳדָשִׁים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/3/4"/>וְשֶׁל מוֹעֲדוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/3/5"/>שְׁחִיטָתָן בַּצָּפוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/3/6"/>וְקִבּוּל דָּמָן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/3/7"/>בִּכְלִי שָׁרֵת בַּצָּפוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/3/8"/>וְדָמָן טָעוּן אַרְבַּע מַתָּנוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/3/9"/>עַל אַרְבַּע קְרָנוֹת,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/3/10"/>כֵּיצַד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/3/11"/>עָלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/3/12"/>בַכֶּֽבֶשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/3/13"/>וּפָנָה לַסּוֹבֵב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/3/14"/>וּבָא לוֹ לְקֶֽרֶן דְּרוֹמִית מִזְרָחִית,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/3/15"/>מִזְרָחִית צְפוֹנִית,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/3/16"/>צְפוֹנִית מַעֲרָבִית,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/3/17"/>מַעֲרָבִית דְּרוֹמִית,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/3/18"/>שְׁיָרֵי הַדָּם הָיָה שׁוֹפֵךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/3/19"/>עַל יְסוֹד דְּרוֹמִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/3/20"/>וְנֶאֱכָלִין
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/3/21"/>לִפְנִים מִן הַקְּ֒לָעִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/3/22"/>לְזִכְרֵי כְהֻנָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/3/23"/>בְּכָל מַאֲכָל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/3/24"/>לְיוֹם וָלַֽיְלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eizehu_meqoman/3/25"/>עַד חֲצוֹת:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
