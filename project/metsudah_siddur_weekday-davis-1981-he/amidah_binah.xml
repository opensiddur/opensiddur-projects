    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/binah">
        <tei:head xml:lang="he">בינה</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/1"/>אַתָּה חוֹנֵן לְאָדָם דַּֽעַת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/2"/>וּמְלַמֵּד לֶאֱנוֹשׁ בִּינָה:
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/binah/chol_arvit_shemoneh_esreh"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="prayer" corresp="urn:x-opensiddur:text:prayer:amidah/attah_chonantanu/text"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/7"/>(אַתָּה חוֹנַנְתָּֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/8"/>לְמַדַּע תּוֹרָתֶֽךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/9"/>וַתְּ֒לַמְּ֒דֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/10"/>לַעֲשׂוֹת חֻקֵּי רְצוֹנֶֽךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/11"/>וַתַּבְדֵּל יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/12"/>בֵּין קֹֽדֶשׁ לְחֹל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/13"/>בֵּין אוֹר לְחֽשֶׁךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/14"/>בֵּין יִשְׂרָאֵל לָעַמִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/15"/>בֵּין יוֹם הַשְּׁ֒בִיעִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/16"/>לְשֵֽׁשֶׁת יְמֵי הַמַּעֲשֶׂה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/17"/>אָבִֽינוּ מַלְכֵּֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/18"/>הָחֵל עָלֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/19"/>הַיָּמִים הַבָּאִים לִקְרָאתֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/20"/>לְשָׁלוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/21"/>חֲשׂוּכִים מִכָּל חֵטְא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/22"/>וּמְנֻקִּים מִכָּל עָוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/23"/>וּמְדֻבָּקִים בְּיִרְאָתֶֽךָ:)
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/24"/>וְחָנֵּֽנוּ מֵאִתְּ֒ךָ
<tei:milestone unit="phrase"/>
<tei:milestone unit="prayer"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/binah/chol_arvit_shemoneh_esreh"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/3"/>חָנֵּֽנוּ מֵאִתְּ֒ךָ
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/4"/>חָכְמָה בִּינָה וָדָּעַת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/5"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/6"/>חוֹנֵן הַדָּֽעַת:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
