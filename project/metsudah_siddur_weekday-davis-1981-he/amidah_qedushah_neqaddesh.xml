      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/neqaddesh">
        <tei:head xml:lang="he">קדושה</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/neqaddesh/1"/>נַקְדִישָׁךְ וְנַעֲרִיצָךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/neqaddesh/2"/>כְּנֹֽעַם שִֽׂיחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/neqaddesh/3"/>סוֹד שַׂרְפֵי קֽוֹדֶשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/neqaddesh/4"/>הַמְּ֒שַׁלְּ֒שִׁים לְךָ קְדֻשָּׁה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/neqaddesh/5"/>כַּכָּתוּב עַל יַד נְבִיאֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/neqaddesh/6"/>וְקָרָא זֶה אֶל זֶה וְאָמַר:</tei:p>
