      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/uminchatam_veniskeihem">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/uminchatam_veniskeihem/1"/>וּמִנְחָתָם וְנִסְכֵּיהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/uminchatam_veniskeihem/2"/>כַּמְדֻבָּר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/uminchatam_veniskeihem/3"/>שְׁלֹשָׁה עֶשְׂרֹנִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/uminchatam_veniskeihem/4"/>לַפָּר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/uminchatam_veniskeihem/5"/>וּשְׁנֵי עֶשְׂרֹנִים לָאָֽיִל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/uminchatam_veniskeihem/6"/>וְעִשָּׂרוֹן לַכֶּֽבֶשׂ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/uminchatam_veniskeihem/7"/>וְיַֽיִן כְּנִסְכּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/uminchatam_veniskeihem/8"/>וְשָׂעִיר לְכַפֵּר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/uminchatam_veniskeihem/9"/>וּשְׁנֵי תְמִידִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/uminchatam_veniskeihem/10"/>כְּהִלְכָתָם:</tei:p>
