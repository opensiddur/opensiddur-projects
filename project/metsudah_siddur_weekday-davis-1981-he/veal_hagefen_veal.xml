      <tei:div corresp="urn:x-opensiddur:text:prayer:veal_hagefen_veal">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/1"/>וְעַל הַגֶּֽפֶן וְעַל פְּרִי הַגֶּֽפֶן
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/2"/>וְעַל תְּנוּבַת הַשָּׂדֶה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/3"/>וְעַל אֶֽרֶץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/4"/>חֶמְדָּה טוֹבָה וּרְ֒חָבָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/5"/>שֶׁרָצִֽיתָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/6"/>וְהִנְחַֽלְתָּ לַאֲבוֹתֵֽינוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/7"/>לֶאֱכֹל מִפִּרְיָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/8"/>וְלִשְׂבֹּֽעַ מִטּוּבָהּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/9"/>רַחֵם נָא יְהֹוָה אֱלֺהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/10"/>עַל יִשְׂרָאֵל עַמֶּֽךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/11"/>וְעַל יְרוּשָׁלַֽיִם עִירֶֽךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/12"/>וְעַל צִיּוֹן מִשְׁכַּן כְּבוֹדֶֽךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/13"/>וְעַל מִזְבְּ֒חֶֽךָ וְעַל הֵיכָלֶֽךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/14"/>וּבְ֒נֵה יְרוּשָׁלַֽיִם עִיר הַקֹּֽדֶשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/15"/>בִּמְ֒הֵרָה בְיָמֵֽינוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/16"/>וְהַעֲלֵֽנוּ לְתוֹכָהּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/17"/>וְשַׂמְּ֒חֵֽנוּ בְּבִנְיָנָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/18"/>וְנֹאכַל מִפִּרְיָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/19"/>וְנִשְׂבַּע מִטּוּבָהּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/20"/>וּנְ֒בָרֶכְ֒ךָ עָלֶֽיהָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/21"/>בִּקְ֒דֻשָּׁה וּבְ֒טָהֳרָה,
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/22"/>וּרְ֒צֵה וְהַחֲלִיצֵנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/23"/>בְּיוֹם הַשַּׁבָּת הַזֶּה,
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/24"/>וְזָכְ֒רֵֽנוּ לְטוֹבָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/25"/>בְּיוֹם רֹאשׁ הַחֹֽדֶשׁ הַזֶּה,
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/26"/>וְשַׂמְּ֒חֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/27"/>בְּיוֹם חַג הַמַּצּוֹת הַזֶּה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/28"/>בְּיוֹם חַג הַשָּׁבֻעוֹת הַזֶּה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/29"/>בְּיוֹם חַג הַסֻּכּוֹת הַזֶּה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/30"/>בְּיוֹם הַשְּׁ֒מִינִי חַג הָעֲצֶֽרֶת הַזֶּה,
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/31"/>וְזָכְ֒רֵֽנוּ לְטוֹבָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/32"/>בְּיוֹם הַזִּכָּרוֹן הַזֶּה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/33"/>כִּי אַתָּה יְהֹוָה טוֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/34"/>וּמֵטִיב לַכֹּל,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/35"/>וְנוֹדֶה לְךָ עַל הָאָֽרֶץ
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/36"/>וְעַל הַמִּחְיָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/37"/>בָּרוּךְ אַתָּה יְהֹוָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/38"/>עַל הָאָֽרֶץ וְעַל הַמִּחְיָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/39"/>(וְעַל הַכַּלְכָּלָה):
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/40"/>וְעַל פְּרִי הַגָּֽפֶן,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/41"/>בָּרוּךְ אַתָּה יְהֹוָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/42"/>עַל הָאָֽרֶץ וְעַל פְּרִי הַגָּֽפֶן:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/43"/>וְעַל הַפֵּרוֹת,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/44"/>בָּרוּךְ אַתָּה יְהֹוָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/45"/>עַל הָאָֽרֶץ וְעַל הַפֵּרוֹת:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/46"/>וְעַל הַמִּחְיָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/47"/>וְעַל פְּרִי הַגָּֽפֶן,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/48"/>בָּרוּךְ אַתָּה יְהֹוָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/49"/>עַל הָאָֽרֶץ וְעַל הַמִּחְיָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/50"/>(וְעַל הַכַּלְכָּלָה)
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veal_hagefen_veal/51"/>וְעַל פְּרִי הַגָּֽפֶן:</tei:p>
      </tei:div>
