      <tei:div corresp="urn:x-opensiddur:text:prayer:adonai_eloheikhem_emet">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_eloheikhem_emet/1"/>יְהֹוָה אֱלֹהֵיכֶם֯ אֱ֯מֶת:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_eloheikhem_emet/2"/>וְיַצִּיב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_eloheikhem_emet/3"/>וְנָכוֹן וְקַיָּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_eloheikhem_emet/4"/>וְיָשָׁר וְנֶאֱמָן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_eloheikhem_emet/5"/>וְאָהוּב וְחָבִיב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_eloheikhem_emet/6"/>וְנֶחְמָד וְנָעִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_eloheikhem_emet/7"/>וְנוֹרָא וְאַדִּיר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_eloheikhem_emet/8"/>וּמְתֻקָּן וּמְקֻבָּל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_eloheikhem_emet/9"/>וְטוֹב וְיָפֶה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_eloheikhem_emet/10"/>הַדָּבָר הַזֶּה עָלֵֽינוּ לְעוֹלָם וָעֶד:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_eloheikhem_emet/11"/>אֱמֶת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_eloheikhem_emet/12"/>אֱלֹהֵי עוֹלָם מַלְכֵּֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_eloheikhem_emet/13"/>צוּר יַעֲקֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_eloheikhem_emet/14"/>מָגֵן יִשְׁעֵֽנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_eloheikhem_emet/15"/>לְדֹר וָדֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_eloheikhem_emet/16"/>הוּא קַיָּם וּשְׁמוֹ קַיָּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_eloheikhem_emet/17"/>וְכִסְאוֹ נָכוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_eloheikhem_emet/18"/>וּמַלְכוּתוֹ וֶאֱמוּנָתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_eloheikhem_emet/19"/>לָעַד קַיָּֽמֶת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_eloheikhem_emet/20"/>וּדְבָרָיו חָיִים וְקַיָּמִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_eloheikhem_emet/21"/>נֶאֱמָנִים וְנֶחֱמָדִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_eloheikhem_emet/22"/>לָעַד וּלְעוֹלְ֒מֵי עוֹלָמִים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_eloheikhem_emet/23"/>עַל אֲבוֹתֵֽינוּ וְעָלֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_eloheikhem_emet/24"/>עַל בָּנֵֽינוּ וְעַל דּוֹרוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_eloheikhem_emet/25"/>וְעַל כָּל דּוֹרוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_eloheikhem_emet/26"/>זֶֽרַע יִשְׂרָאֵל עֲבָדֶֽיךָ:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
