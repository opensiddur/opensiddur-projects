      <tei:div corresp="urn:x-opensiddur:text:prayer:vekharot_immo_haberit">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vekharot_immo_haberit/1"/>וְכָרוֹת עִמּוֹ הַבְּ֒רִית
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vekharot_immo_haberit/2"/>לָתֵת אֶת־אֶֽרֶץ הַכְּ֒נַעֲנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vekharot_immo_haberit/3"/>הַחִתִּי הָאֱמֹרִי וְהַפְּ֒רִזִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vekharot_immo_haberit/4"/>וְהַיְבוּסִי וְהַגִּרְגָּשִׁי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vekharot_immo_haberit/5"/>לָתֵת לְזַרְעוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vekharot_immo_haberit/6"/>וַתָּֽקֶם אֶת־דְּבָרֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vekharot_immo_haberit/7"/>כִּי צַדִּיק אָֽתָּה:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:nehemiah/9/9"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vekharot_immo_haberit/8"/>וַתֵּֽרֶא אֶת־עֳנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vekharot_immo_haberit/9"/>אֲבֹתֵֽינוּ בְּמִצְרָֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vekharot_immo_haberit/10"/>וְאֶת־זַעֲקָתָם שָׁמַֽעְתָּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vekharot_immo_haberit/11"/>עַל־יַם־סוּף:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:nehemiah/9/10"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vekharot_immo_haberit/12"/>וַתִּתֵּן אֹתֹת וּמֹפְ֒תִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vekharot_immo_haberit/13"/>בְּפַרְעֹה וּבְכָל־עֲבָדָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vekharot_immo_haberit/14"/>וּבְכָל־עַם אַרְצוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vekharot_immo_haberit/15"/>כִּי יָדַֽעְתָּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vekharot_immo_haberit/16"/>כִּי הֵזִֽידוּ עֲלֵיהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vekharot_immo_haberit/17"/>וַתַּֽעַשׂ־לְךָ שֵׁם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vekharot_immo_haberit/18"/>כְּהַיּוֹם הַזֶּה:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:nehemiah/9/11"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vekharot_immo_haberit/19"/>וְהַיָּם בָּקַֽעְתָּ לִפְנֵיהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vekharot_immo_haberit/20"/>וַיַּעַבְרוּ בְתוֹךְ־הַיָּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vekharot_immo_haberit/21"/>בַּיַּבָּשָׁה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vekharot_immo_haberit/22"/>וְאֶת־רֹדְ֒פֵיהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vekharot_immo_haberit/23"/>הִשְׁלַֽכְתָּ בִמְצוֹלֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vekharot_immo_haberit/24"/>כְּמוֹ־אֶֽבֶן בְּמַֽיִם עַזִּים:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
