      <tei:div corresp="urn:x-opensiddur:text:prayer:tana_devei_eliyyahu">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_eliyyahu/1"/>תָּנָא דְבֵי אֵלִיָּֽהוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_eliyyahu/2"/>כָּל הַשּׁוֹנֶה הֲלָכוֹת בְּכָל יוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_eliyyahu/3"/>מֻבְטָח לוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_eliyyahu/4"/>שֶׁהוּא בֶּן עוֹלָם הַבָּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_eliyyahu/5"/>שֶׁנֶּאֱמַר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_eliyyahu/6"/>הֲלִיכוֹת עוֹלָם לוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_eliyyahu/7"/>אַל תִּקְרֵי הֲלִיכוֹת אֶלָּא הֲלָכוֹת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_eliyyahu/8"/>אָמַר רַבִּי אֶלְעָזָר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_eliyyahu/9"/>אָמַר רַבִּי חֲנִינָא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_eliyyahu/10"/>תַּלְמִידֵי חֲכָמִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_eliyyahu/11"/>מַרְבִּים שָׁלוֹם בָּעוֹלָם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_eliyyahu/12"/>שֶׁנֶּאֱמַר
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:isaiah/54/13"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_eliyyahu/13"/>וְכָל בָּנַֽיִךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_eliyyahu/14"/>לִמּוּדֵי יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_eliyyahu/15"/>וְרַב שְׁלוֹם בָּנָֽיךְ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_eliyyahu/16"/>אַל תִּקְרֵי בָּנָֽיךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_eliyyahu/17"/>אֶלָּא בּוֹנָֽיךְ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/119/165"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_eliyyahu/18"/>שָׁלוֹם רָב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_eliyyahu/19"/>לְאֹהֲבֵי תוֹרָתֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_eliyyahu/20"/>וְאֵין
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_eliyyahu/21"/>לָֽמוֹ מִכְשׁוֹל:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/122/7"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_eliyyahu/22"/>יְהִי שָׁלוֹם בְּחֵילֵךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_eliyyahu/23"/>שַׁלְוָה בְּאַרְמְּנוֹתָֽיךְ
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/122/8"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_eliyyahu/24"/>לְמַֽעַן אַחַי וְרֵעָי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_eliyyahu/25"/>אֲדַבְּרָה נָא שָׁלוֹם בָּךְ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/122/9"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_eliyyahu/26"/>לְמַֽעַן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_eliyyahu/27"/>בֵּית יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tana_devei_eliyyahu/28"/>אֲבַקְ֒שָׁה טוֹב לָךְ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
