      <tei:div corresp="urn:x-opensiddur:text:prayer:birkat_hamazon/veal_hakol">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/veal_hakol/1"/>וְעַל הַכֹּל יְהֹוָה אֱלֺהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/veal_hakol/2"/>אֲנַֽחְנוּ מוֹדִים לָךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/veal_hakol/3"/>וּמְ֒בָרְ֒כִים אוֹתָךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/veal_hakol/4"/>יִתְבָּרַךְ שִׁמְךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/veal_hakol/5"/>בְּפִי כָּל חַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/veal_hakol/6"/>תָּמִיד לְעוֹלָם וָעֶד כַּכָּתוּב
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:deuteronomy/8/10"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/veal_hakol/7"/>וְאָכַלְתָּ וְשָׂבָֽעְתָּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/veal_hakol/8"/>וּבֵרַכְתָּ אֶת יְהֹוָה אֱלֺהֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/veal_hakol/9"/>עַל הָאָֽרֶץ הַטּוֹבָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/veal_hakol/10"/>אֲשֶׁר נָתַן לָךְ
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/veal_hakol/11"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/veal_hakol/12"/>עַל הָאָֽרֶץ וְעַל הַמָּזוֹן:</tei:p>
