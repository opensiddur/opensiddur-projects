      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/20">
        <tei:p><j:conditional xml:id="when_1"><j:none><tei:fs type="opensiddur:holiday"><tei:f name="rosh-hodesh"><tei:binary value="true"/></tei:f></tei:fs><tei:fs type="opensiddur:hebrew-date"><tei:f name="month"><tei:numeric value="7"/></tei:f><tei:f name="day"><tei:numeric value="9" max="30"/></tei:f></tei:fs><tei:fs type="opensiddur:holiday"><tei:f name="hanukkah"><tei:binary value="true"/></tei:f></tei:fs><tei:fs type="opensiddur:hebrew-date"><tei:f name="month"><tei:numeric value="12"/></tei:f><tei:f name="day"><tei:numeric value="14" max="15"/></tei:f></tei:fs><tei:fs type="opensiddur:hebrew-date"><tei:f name="month"><tei:numeric value="13"/></tei:f><tei:f name="day"><tei:numeric value="14" max="15"/></tei:f></tei:fs><tei:fs type="opensiddur:hebrew-date"><tei:f name="month"><tei:numeric value="1"/></tei:f></tei:fs><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="chol-hamoed"><tei:binary value="true"/></tei:f></tei:fs><tei:fs type="opensiddur:holiday"><tei:f name="tisha-bav"><tei:binary value="true"/></tei:f></tei:fs><tei:fs type="opensiddur:override"><tei:f name="house-of-mourning"><tei:binary value="true"/></tei:f></tei:fs><tei:fs type="opensiddur:hebrew-date"><tei:f name="month"><tei:numeric value="2"/></tei:f><tei:f name="day"><tei:numeric value="14"/></tei:f></tei:fs><tei:fs type="opensiddur:holiday"><tei:f name="lag-baomer"><tei:binary value="true"/></tei:f></tei:fs><tei:fs type="opensiddur:hebrew-date"><tei:f name="month"><tei:numeric value="3"/></tei:f><tei:f name="day"><tei:numeric value="1" max="12"/></tei:f></tei:fs><tei:fs type="opensiddur:hebrew-date"><tei:f name="month"><tei:numeric value="5"/></tei:f><tei:f name="day"><tei:numeric value="15"/></tei:f></tei:fs><tei:fs type="opensiddur:hebrew-date"><tei:f name="month"><tei:numeric value="11"/></tei:f><tei:f name="day"><tei:numeric value="15"/></tei:f></tei:fs><tei:fs type="opensiddur:override"><tei:f name="brit-milah"><tei:binary value="true"/></tei:f></tei:fs><tei:fs type="opensiddur:override"><tei:f name="wedding"><tei:binary value="true"/></tei:f></tei:fs><tei:fs type="opensiddur:override"><tei:f name="sheva-brachot"><tei:binary value="true"/></tei:f></tei:fs></j:none></j:conditional><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/20/1"/>לַמְנַצֵּֽחַ מִזְמוֹר לְדָוִד:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/20/2"/>יַעַנְ֒ךָ יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/20/3"/>בְּיוֹם צָרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/20/4"/>יְשַׂגֶּבְ֒ךָ שֵׁם אֱלֺהֵי יַעֲקֹב:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/20/5"/>יִשְׁלַח עֶזְרְךָ מִקֹּֽדֶשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/20/6"/>וּמִצִּיּוֹן יִסְעָדֶֽךָּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/20/7"/>יִזְכֹּר כָּל מִנְחֹתֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/20/8"/>וְעוֹלָתְ֒ךָ יְדַשְּׁ֒נֶה סֶּֽלָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/20/9"/>יִתֶּן לְךָ כִלְ֒בָבֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/20/10"/>וְכָל עֲצָתְ֒ךָ יְמַלֵּא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/20/11"/>נְרַנְּ֒נָה בִּישׁוּעָתֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/20/12"/>וּבְ֒שֵׁם אֱלֺהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/20/13"/>נִדְגֹּל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/20/14"/>יְמַלֵּא יְהֹוָה כָּל מִשְׁאֲלוֹתֶֽיךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/20/15"/>עַתָּה יָדַֽעְתִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/20/16"/>כִּי הוֹשִֽׁיעַ יְהֹוָה מְשִׁיחוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/20/17"/>יַעֲנֵֽהוּ מִשְּׁ֒מֵי קָדְשׁוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/20/18"/>בִּגְ֒בוּרוֹת יֵֽשַׁע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/20/19"/>יְמִינוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/20/20"/>אֵֽלֶּה בָרֶֽכֶב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/20/21"/>וְאֵֽלֶּה בַסּוּסִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/20/22"/>וַאֲנַֽחְנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/20/23"/>בְּשֵׁם יְהֹוָה אֱלֺהֵֽינוּ נַזְכִּיר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/20/24"/>הֵֽמָּה כָּרְ֒עוּ וְנָפָֽלוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/20/25"/>וַאֲנַֽחְנוּ קַֽמְנוּ וַנִּתְעוֹדָד:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/20/26"/>יְהֹוָה הוֹשִׁיעָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/20/27"/>הַמֶּֽלֶךְ יַעֲנֵֽנוּ בְיוֹם קָרְאֵֽנוּ:
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_1"/></tei:p>
      </tei:div>
