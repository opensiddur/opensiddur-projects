  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:maoz_tzur/4">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/4/1"/>כְּרוֹת קוֹמַת בְּרוֹשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/4/2"/>בִּקֵּשׁ אֲגָגִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/4/3"/>בֶּן הַמְּדָתָא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/4/4"/>וְנִהְיְ֒תָה לוֹ לְפַח וּלְמוֹקֵשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/4/5"/>וְגַאֲוָתוֹ נִשְׁבָּתָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/4/6"/>רֹאשׁ יְמִינִי נִשֵּֽׂאתָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/4/7"/>וְאוֹיֵב שְׁמוֹ מָחִֽיתָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/4/8"/>רֹב בָּנָיו וְקִנְיָנָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/4/9"/>עַל הָעֵץ תָּלִֽיתָ:</tei:p>
      </tei:div>
