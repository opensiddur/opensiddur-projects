      <tei:div corresp="urn:x-opensiddur:text:prayer:hallel/psalm_113">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_113/1"/>הַלְ֒לוּיָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_113/2"/>הַלְ֒לוּ עַבְדֵי יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_113/3"/>הַלְ֒לוּ אֶת שֵׁם יְהֹוָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_113/4"/>יְהִי שֵׁם יְהֹוָה מְבֹרָךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_113/5"/>מֵעַתָּה וְעַד־עוֹלָם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_113/6"/>מִמִּזְרַח־שֶֽׁמֶשׁ עַד־מְבוֹאוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_113/7"/>מְהֻלָּל שֵׁם יְהֹוָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_113/8"/>רָם עַל־כָּל־גּוֹיִם יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_113/9"/>עַל הַשָּׁמַֽיִם כְּבוֹדוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_113/10"/>מִי כַּיהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_113/11"/>הַמַּגְבִּיהִי לָשָֽׁבֶת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_113/12"/>הַמַּשְׁפִּילִי לִרְאוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_113/13"/>בַּשָּׁמַֽיִם וּבָאָֽרֶץ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_113/14"/>מְקִימִי מֵעָפָר דָּל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_113/15"/>מֵאַשְׁפֹּת יָרִים אֶבְיוֹן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_113/16"/>לְהוֹשִׁיבִי עִם־נְדִיבִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_113/17"/>עִם נְדִיבֵי עַמּוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_113/18"/>מוֹשִׁיבִי עֲקֶֽרֶת הַבַּֽיִת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_113/19"/>אֵם־הַבָּנִים שְׂמֵחָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hallel/psalm_113/20"/>הַלְ֒לוּיָהּ:</tei:p>
      </tei:div>
