      <tei:div corresp="urn:x-opensiddur:text:prayer:barukh_eloheinu_sheakhalnu_mishello">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/1"/>בָּרוּךְ (בעשרה אֱלֺהֵֽינוּ)
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/2"/>שֶֽׁאָכַֽלְנוּ מִשֶּׁלּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/3"/>וּבְטוּבוֹ חָיִֽינוּ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/4"/>הָרַחֲמָן, הוּא יְבָרֵךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/5"/>אֲבִי הַיֶּֽלֶד וְאִמּוֹ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/6"/>וְיִזְכּוּ לְגַדְּ֒לוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/7"/>וּלְחַנְּ֒כוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/8"/>וּלְחַכְּ֒מוֹ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/9"/>מִיּוֹם הַשְּׁ֒מִינִי וָהָֽלְאָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/10"/>יֵרָצֶה דָמוֹ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/11"/>וִיהִי יְהוָֹה אֱלֺהָיו עִמּוֹ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/12"/>אָמֵן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/13"/>הָרַחֲמָן, הוּא יְבָרֵךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/14"/>בַּעַל בְּרִית הַמִּילָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/15"/>אֲשֶׁר שָׂשׂ לַעֲשׂוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/16"/>צֶֽדֶק בְּגִילָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/17"/>וִישַׁלֵּם פָּעֳלוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/18"/>וּמַשְׂכֻּרְתּוֹ כְּפוּלָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/19"/>וְיִתְּנֵֽהוּ לְמַֽעֲלָה לְמָֽעְלָה:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/20"/>אָמֵן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/21"/>הָרַחֲמָן, הוּא יְבָרֵךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/22"/>רַךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/23"/>הַנִּמּוֹל לִשְׁמֹנָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/24"/>וְיִהְיוּ יָדָיו וְלִבּוֹ לְאֵל אֱמוּנָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/25"/>וְיִזְכֶּה לִרְאוֹת פְּנֵי הַשְּׁ֒כִינָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/26"/>שָׁלשׁ פְּעָמִים בַּשָּׁנָה:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/27"/>אָמֵן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/28"/>הָרַחֲמָן, הוּא יְבָרֵךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/29"/>הַמָּל בְּשַׂר הָעָרְלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/30"/>וּפָרַע וּמָצַץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/31"/>דְּמֵי הַמִּילָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/32"/>אִישׁ הַיָּרֵא וְרַךְ הַלֵּבָב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/33"/>עֲבוֹדָתוֹ פְּסוּלָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/34"/>אִם שְׁלָשׁ אֵֽלֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/35"/>לֺא יַֽעֲשֶׂה לָּהּ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/36"/>אָמֵן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/37"/>הָרַחֲמָן, הוּא יִשְׁלַח לָֽנוּ מְשִׁיחוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/38"/>הוֹלֵךְ תָּמִים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/39"/>בִּזְכוּת חֲתַן לַמּוּלוֹת דָּמִים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/40"/>לְבַשֵּׁר בְּשׂוֹרוֹת טוֹבוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/41"/>וְנִחוּמִים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/42"/>לְעַם אֶחָד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/43"/>מְפֻזָּר וּמְפֹרָד בֵּין הָעַמִּים:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/44"/>אָמֵן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/45"/>הָרַחֲמָן, הוּא יִשְׁלַח לָֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/46"/>כֹּהֵן צֶֽדֶק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/47"/>אֲשֶׁר לֻקַּח לְעֵילוֹם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/48"/>עַד הוּכַן כִּסְאוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/49"/>כַּשֶּׁמֶשׁ וְיָהֲלוֹם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/50"/>וַיָּֽלֶט פָּנָיו בְּאַדַּרְתּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/51"/>וַיִּגְלוֹם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/52"/>בְּרִיתִי הָיְתָה אִתּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/53"/>הַחַיִּים וְהַשָּׁלוֹם:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:barukh_eloheinu_sheakhalnu_mishello/54"/>אָמֵן</tei:p>
      </tei:div>
