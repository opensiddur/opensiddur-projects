      <tei:div corresp="urn:x-opensiddur:text:prayer:yotzer_or/titbarakh">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/titbarakh/1"/>תִּתְבָּרֵךְ לָנֶצַח צוּרֵֽנוּ מַלְכֵּֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/titbarakh/2"/>וְגוֹאֲלֵֽנוּ, בּוֹרֵא קְדוֹשִׁים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/titbarakh/3"/>יִשְׁתַּבַּח שִׁמְךָ לָעַד מַלְכֵּֽנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/titbarakh/4"/>יוֹצֵר מְשָׁרְ֒תִים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/titbarakh/5"/>וַאֲשֶׁר מְשָׁרְ֒תָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/titbarakh/6"/>כֻּלָּם עוֹמְ֒דִים בְּרוּם עוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/titbarakh/7"/>וּמַשְׁמִיעִים בְּיִרְאָה יַֽחַד בְּקוֹל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/titbarakh/8"/>דִּבְרֵי אֱלֹהִים חַיִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/titbarakh/9"/>וּמֶֽלֶךְ עוֹלָם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/titbarakh/10"/>כֻּלָם אֲהוּבִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/titbarakh/11"/>כֻּלָּם בְּרוּרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/titbarakh/12"/>כֻּלָּם גִּבּוֹרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/titbarakh/13"/>כֻּלָּם קְדוֹשִׁים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/titbarakh/14"/>וְכֻלָּם עֹשִׂים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/titbarakh/15"/>בְּאֵימָה וּבְיִרְאָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/titbarakh/16"/>רְצוֹן קוֹנָם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/titbarakh/17"/>וְכֻלָּם פּוֹתְ֒חִים אֶת פִּיהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/titbarakh/18"/>בִּקְדֻשָּׁה וּבְטָהֳרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/titbarakh/19"/>בְּשִׁירָה וּבְזִמְרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/titbarakh/20"/>וּמְבָרְ֒כִין וּמְשַׁבְּ֒חִין וּמְפָאֲרִין
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/titbarakh/21"/>וּמַעֲרִיצִין וּמַקְדִּישִׁין
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/titbarakh/22"/>וּמַמְלִיכִין:</tei:p>
      </tei:div>
