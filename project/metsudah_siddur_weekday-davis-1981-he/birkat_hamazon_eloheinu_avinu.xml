    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:birkat_hamazon/eloheinu_avinu">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/eloheinu_avinu/1"/>אֱלֺהֵֽינוּ אָבִֽינוּ רְעֵֽנוּ זוּנֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/eloheinu_avinu/2"/>פַּרְנְ֒סֵֽנוּ וְכַלְכְּ֒לֵֽנוּ וְהַרְוִיחֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/eloheinu_avinu/3"/>וְהַרְוַח לָֽנוּ יְהֹוָה אֱלֺהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/eloheinu_avinu/4"/>מְהֵרָה מִכָּל צָרוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/eloheinu_avinu/5"/>וְנָא אַל תַּצְרִיכֵֽנוּ יְהֹוָה אֱלֺהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/eloheinu_avinu/6"/>לֺא לִידֵי מַתְּ֒נַת בָּשָׂר וָדָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/eloheinu_avinu/7"/>וְלֺא לִידֵי הַלְוָאָתָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/eloheinu_avinu/8"/>כִּי אִם לְיָדְ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/eloheinu_avinu/9"/>הַמְ֒לֵאָה הַפְּ֒תוּחָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/eloheinu_avinu/10"/>הַקְּ֒דוֹשָׁה וְהָרְ֒חָבָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/eloheinu_avinu/11"/>שֶׁלֺּא נֵבוֹשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/eloheinu_avinu/12"/>וְלֺא נִכָּלֵם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_hamazon/eloheinu_avinu/13"/>לְעוֹלָם וָעֶד:</tei:p>
      </tei:div>
