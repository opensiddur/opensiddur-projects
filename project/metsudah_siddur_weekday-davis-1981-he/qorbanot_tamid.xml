    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:qorbanot/tamid">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/1"/>וַיְדַבֵּר יְהֹוָה אֶל־משֶׁה לֵּאמֹר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/2"/>צַו אֶת־בְּנֵי יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/3"/>וְאָמַרְתָּ אֲלֵהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/4"/>אֶת־קָרְבָּנִי לַחְמִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/5"/>לְאִשַּׁי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/6"/>רֵֽיחַ נִיחֹחִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/7"/>תִּשְׁמְ֒רוּ לְהַקְרִיב לִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/8"/>בְּמוֹעֲדוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/9"/>וְאָמַרְתָּ לָהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/10"/>זֶה הָאִשֶּׁה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/11"/>אֲשֶׁר תַּקְרִֽיבוּ לַיהוָֹה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/12"/>כְּבָשִׂים בְּנֵי־שָׁנָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/13"/>תְמִימִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/14"/>שְׁנַֽיִם לַיּוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/15"/>עֹלָה תָמִיד:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/16"/>אֶת־הַכֶּֽבֶשׂ אֶחָד תַּעֲשֶׂה בַבֹּֽקֶר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/17"/>וְאֵת הַכֶּֽבֶשׂ הַשֵּׁנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/18"/>תַּעֲשֶׂה בֵּין הָעַרְבָּֽיִם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/19"/>וַֽעֲשִׂירִית הָאֵיפָה סֹֽלֶת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/20"/>לְמִנְחָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/21"/>בְּלוּלָה בְּשֶֽׁמֶן כָּתִית
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/22"/>רְבִיעִת הַהִין:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/23"/>עֹלַת תָּמִיד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/24"/>הָעֲשֻׂיָה בְּהַר סִינַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/25"/>לְרֵֽיחַ נִיחֹֽחַ אִשֶּׁה לַיהוָֹה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/26"/>וְנִסְכּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/27"/>רְבִיעִת הַהִין לַכֶּֽבֶשׂ הָאֶחָד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/28"/>בַּקֹּֽדֶשׁ הַסֵּךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/29"/>נֶֽסֶךְ שֵׁכָר לַיהוָֹה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/30"/>וְאֵת הַכֶּֽבֶשׂ הַשֵּׁנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/31"/>תַּעֲשֶׂה בֵּין הָעַרְבָּֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/32"/>כְּמִנְחַת הַבֹּֽקֶר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/33"/>וּכְנִסְכּוֹ תַּעֲשֶׂה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/tamid/34"/>אִשֵּׁה רֵֽיחַ נִיחֹֽחַ לַיהוָֹה:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
