      <tei:div corresp="urn:x-opensiddur:text:prayer:vayyomer_adonai_el">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyomer_adonai_el/1"/>וַֽיֹּאמֶר֯ יְ֯הֹוָה֯ אֶ֯ל־משֶׁה לֵּאמֹר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyomer_adonai_el/2"/>דַּבֵּר֯ אֶ֯ל־בְּנֵי יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyomer_adonai_el/3"/>וְאָמַרְתָּ אֲלֵהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyomer_adonai_el/4"/>וְעָשׂוּ לָהֶם צִיצִת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyomer_adonai_el/5"/>עַל־כַּנְ֒פֵי בִגְ֒דֵיהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyomer_adonai_el/6"/>לְדֹרֹתָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyomer_adonai_el/7"/>וְנָתְ֒נוּ עַל־צִיצִת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyomer_adonai_el/8"/>הַכָּנָף֯
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyomer_adonai_el/9"/>פְּ֯תִיל תְּכֵֽלֶת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyomer_adonai_el/10"/>וְהָיָה לָכֶם לְצִיצִת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyomer_adonai_el/11"/>וּרְאִיתֶם֯ אֹ֯תוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyomer_adonai_el/12"/>וּזְכַרְתֶּם֯
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyomer_adonai_el/13"/>אֶ֯ת־כָּל־מִצְוֹת֯ יְ֯הֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyomer_adonai_el/14"/>וַעֲשִׂיתֶם֯ אֹ֯תָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyomer_adonai_el/15"/>וְלֹא תָתֽוּרוּ אַחֲרֵי לְבַבְכֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyomer_adonai_el/16"/>וְאַחֲרֵי עֵינֵיכֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyomer_adonai_el/17"/>אֲשֶׁר֯־אַ֯תֶּם זֹנִים֯ אַ֯חֲרֵיהֶם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyomer_adonai_el/18"/>לְמַֽעַן תִּזְכְּ֒רוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyomer_adonai_el/19"/>וַעֲשִׂיתֶם֯ אֶ֯ת־כָּל־מִצְוֹתָי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyomer_adonai_el/20"/>וִהְיִיתֶם קְדשִׁים לֵאלֹהֵיכֶם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyomer_adonai_el/21"/>אֲנִי יְהֹוָה אֱלֹהֵיכֶם֯
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyomer_adonai_el/22"/>אֲ֯שֶׁר הוֹצֵֽאתִי אֶתְכֶם֯
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyomer_adonai_el/23"/>מֵ֯אֶֽרֶץ מִצְרַֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyomer_adonai_el/24"/>לִהְיוֹת לָכֶם לֵאלֹהִים֯
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyomer_adonai_el/25"/>אֲ֯נִי יְהֹוָה אֱלֹהֵיכֶם֯:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyomer_adonai_el/26"/>אֱ֯מֶת</tei:p>
      </tei:div>
    </tei:body>
