      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/93">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/93/1"/>יְהֹוָה מָלָךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/93/2"/>גֵּאוּת לָבֵשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/93/3"/>לָבֵשׁ יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/93/4"/>עֹז הִתְאַזָּר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/93/5"/>אַף תִּכּוֹן תֵּבֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/93/6"/>בַּל תִּמּוֹט:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/93/7"/>נָכוֹן כִּסְאֲךָ מֵאָז
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/93/8"/>מֵעוֹלָם אָֽתָּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/93/9"/>נָשְׂ֒אוּ נְהָרוֹת יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/93/10"/>נָשְׂ֒אוּ נְהָרוֹת קוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/93/11"/>יִשְׂ֒אוּ נְהָרוֹת דָּכְיָם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/93/12"/>מִקֹּלוֹת מַֽיִם רַבִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/93/13"/>אַדִּירִים מִשְׁבְּ֒רֵי יָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/93/14"/>אַדִּיר בַּמָּרוֹם יְהֹוָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/93/15"/>עֵדֹתֶֽיךָ נֶאֶמְ֒נוּ מְאֹד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/93/16"/>לְבֵיתְ֒ךָ נָאֲוָה קֹֽדֶשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/93/17"/>יְהֹוָה לְאֹֽרֶךְ יָמִים:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
