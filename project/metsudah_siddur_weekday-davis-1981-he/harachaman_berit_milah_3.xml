    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:harachaman_berit_milah/3">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/3/1"/>הָרַחֲמָן, הוּא יְבָרֵךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/3/2"/>רַךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/3/3"/>הַנִּמּוֹל לִשְׁמֹנָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/3/4"/>וְיִהְיוּ יָדָיו וְלִבּוֹ לְאֵל אֱמוּנָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/3/5"/>וְיִזְכֶּה לִרְאוֹת פְּנֵי הַשְּׁ֒כִינָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/3/6"/>שָׁלשׁ פְּעָמִים בַּשָּׁנָה:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/3/7"/>אָמֵן</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
