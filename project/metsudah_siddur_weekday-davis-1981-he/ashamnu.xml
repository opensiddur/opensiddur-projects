      <tei:div corresp="urn:x-opensiddur:text:prayer:ashamnu">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu/1"/>אָשַֽׁמְנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu/2"/>בָּגַֽדְנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu/3"/>גָּזַֽלְנוּ. דִּבַּֽרְנוּ דֹּֽפִי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu/4"/>הֶעֱוִֽינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu/5"/>וְהִרְשַֽׁעְנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu/6"/>זַֽדְנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu/7"/>חָמַֽסְנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu/8"/>טָפַֽלְנוּ שֶֽׁקֶר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu/9"/>יָעַֽצְנוּ רָע.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu/10"/>כִּזַּֽבְנוּ. לַֽצְנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu/11"/>מָרַֽדְנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu/12"/>נִאַֽצְנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu/13"/>סָרַֽרְנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu/14"/>עָוִֽינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu/15"/>פָּשַֽׁעְנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu/16"/>צָרַֽרְנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu/17"/>קִשִּֽׁינוּ עֹֽרֶף.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu/18"/>רָשַֽׁעְנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu/19"/>שִׁחַֽתְנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu/20"/>תִּעַֽבְנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu/21"/>תָּעִֽינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu/22"/>תִּעְתָּֽעְנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu/23"/>סַֽרְנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu/24"/>מִמִּצְוֹתֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu/25"/>וּמִמִּשְׁפָּטֶֽיךָ הַטּוֹבִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu/26"/>וְלֺא שָֽׁוָה לָֽנוּ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:nehemiah/9/33"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu/27"/>וְאַתָּה צַדִּיק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu/28"/>עַל כָּל הַבָּא עָלֵֽינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu/29"/>כִּי אֱמֶת עָשִֽׂיתָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu/30"/>וַאֲנַֽחְנוּ הִרְשָֽׁעְנוּ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>