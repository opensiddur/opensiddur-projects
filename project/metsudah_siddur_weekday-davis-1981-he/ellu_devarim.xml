      <tei:div corresp="urn:x-opensiddur:text:prayer:ellu_devarim">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ellu_devarim/1"/>אֵֽלּוּ דְבָרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ellu_devarim/2"/>שֶׁאֵין לָהֶם שִׁעוּר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ellu_devarim/3"/>הַפֵּאָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ellu_devarim/4"/>וְהַבִּכּוּרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ellu_devarim/5"/>וְהָרְ֒אָיוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ellu_devarim/6"/>וּגְ֒מִילוּת חֲסָדִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ellu_devarim/7"/>וְתַלְמוּד תּוֹרָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ellu_devarim/8"/>אֵֽלּוּ דְבָרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ellu_devarim/9"/>שֶׁאָדָם אוֹכֵל פֵּרוֹתֵיהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ellu_devarim/10"/>בָּעוֹלָם הַזֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ellu_devarim/11"/>וְהַקֶּֽרֶן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ellu_devarim/12"/>קַיֶּֽמֶת לָעוֹלָם הַבָּא,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ellu_devarim/13"/>וְאֵֽלּוּ הֵן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ellu_devarim/14"/>כִּבּוּד אָב וָאֵם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ellu_devarim/15"/>וּגְ֒מִילוּת חֲסָדִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ellu_devarim/16"/>וְהַשְׁכָּמַת בֵּית הַמִּדְרָשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ellu_devarim/17"/>שַׁחֲרִית וְעַרְ֒בִית
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ellu_devarim/18"/>וְהַכְנָסַת אוֹרְ֒חִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ellu_devarim/19"/>וּבִקּוּר חוֹלִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ellu_devarim/20"/>וְהַכְנָסַת כַּלָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ellu_devarim/21"/>וּלְוָיַת הַמֵּת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ellu_devarim/22"/>וְעִיּוּן תְּפִלָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ellu_devarim/23"/>וַהֲבָאַת שָׁלוֹם בֵּין אָדָם לַחֲבֵרוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ellu_devarim/24"/>ובֵין אִישׁ לְאִשְׁתּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ellu_devarim/25"/>וְתַלְמוּד תּוֹרָה כְּנֶֽגֶד כֻּלָּם:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
