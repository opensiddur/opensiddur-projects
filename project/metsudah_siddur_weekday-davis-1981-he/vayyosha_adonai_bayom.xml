  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:vayyosha_adonai_bayom">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/14/30"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyosha_adonai_bayom/1"/>וַיּֽוֹשַׁע יְהֹוָה בַּיּוֹם הַהוּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyosha_adonai_bayom/2"/>אֶת־יִשְׂרָאֵל מִיַּד מִצְרָֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyosha_adonai_bayom/3"/>וַיַּרְא יִשְׂרָאֵל אֶת־מִצְרַֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyosha_adonai_bayom/4"/>מֵת עַל־שְׂפַת הַיָּם:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/14/31"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyosha_adonai_bayom/5"/>וַיַּרְא יִשְׂרָאֵל אֶת־הַיָּד הַגְּ֒דֹלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyosha_adonai_bayom/6"/>אֲשֶׁר עָשָׂה יְהֹוָה בְּמִצְרַֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyosha_adonai_bayom/7"/>וַיִּירְ֒אוּ הָעָם אֶת יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyosha_adonai_bayom/8"/>וַיַּאֲמִֽינוּ בַּיהוָֹה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayyosha_adonai_bayom/9"/>וּבְמשֶׁה עַבְדּוֹ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
