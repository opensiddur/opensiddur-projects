  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:velammalshinim_al_tehi">
        <tei:head xml:lang="he">ברכת המינים</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:velammalshinim_al_tehi/1"/>וְלַמַּלְשִׁינִים אַל תְּהִי תִקְוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:velammalshinim_al_tehi/2"/>וְכָל הָרִשְׁעָה כְּרֶגַע תֹּאבֵד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:velammalshinim_al_tehi/3"/>וְכָל אֹיְ֒בֶֽיךָ מְהֵרָה יִכָּרֵֽתוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:velammalshinim_al_tehi/4"/>וְהַזֵּדִים מְהֵרָה תְעַקֵּר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:velammalshinim_al_tehi/5"/>וּתְ֒שַׁבֵּר וּתְ֒מַגֵּר וּתְ֒כַלֵם וְתַשְׁפִּילֵם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:velammalshinim_al_tehi/6"/>וְתַכְנִיעֵם בִּמְ֒הֵרָה בְיָמֵֽינוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:velammalshinim_al_tehi/7"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:velammalshinim_al_tehi/8"/>שׁוֹבֵר אֹיְ֒בִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:velammalshinim_al_tehi/9"/>וּמַכְנִֽיעַ זֵדִים:</tei:p>
