      <tei:div corresp="urn:x-opensiddur:text:prayer:birshut_hakohanim_vehaleviyyim">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birshut_hakohanim_vehaleviyyim/1"/>בִּרְשׁוּת הַכֹּהֲנִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birshut_hakohanim_vehaleviyyim/2"/>וְהַלְ֒וִיִּם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birshut_hakohanim_vehaleviyyim/3"/>אֶקְרָא לֵאלֺהֵי הָעִבְרִיִּים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birshut_hakohanim_vehaleviyyim/4"/>אֲהוֹדֶנּוּ בְּכָל אִיִּים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birshut_hakohanim_vehaleviyyim/5"/>אֲבָרְכָה אֶת יְהוָֹה,
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birshut_hakohanim_vehaleviyyim/6"/>נוֹדֶה לְשִׁמְךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birshut_hakohanim_vehaleviyyim/7"/>בְּתוֹךְ אֱמוּנַי,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birshut_hakohanim_vehaleviyyim/8"/>בְּרוּכִים אַתֶּם לַיהוָֹה:</tei:p>
