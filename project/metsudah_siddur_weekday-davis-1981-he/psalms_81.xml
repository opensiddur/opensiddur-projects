      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/81">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/1"/>לַמְנַצֵּֽחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/2"/>עַל הַגִּתִּית לְאָסָף:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/3"/>הַרְנִֽינוּ לֵאלֺהִים עֻזֵּנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/4"/>הָרִֽיעוּ לֵאלֺהֵי יַעֲקֹב:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/5"/>שְׂאוּ זִמְרָה וּתְ֒נוּ תֹף
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/6"/>כִּנּוֹר נָעִים עִם נָֽבֶל:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/7"/>תִּקְ֒עוּ בַחֹֽדֶשׁ שׁוֹפָר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/8"/>בַּכֶּֽסֶה לְיוֹם חַגֵּֽנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/9"/>כִּי חֹק לְיִשְׂרָאֵל הוּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/10"/>מִשְׁפָּט לֵאלֺהֵי יַעֲקֹב:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/11"/>עֵדוּת בִּיהוֹסֵף שָׂמוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/12"/>בְּצֵאתוֹ עַל אֶֽרֶץ מִצְרָֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/13"/>שְׂפַת לֺא יָדַֽעְתִּי אֶשְׁמָע:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/14"/>הֲסִירֽוֹתִי מִסֵּֽבֶל שִׁכְמוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/15"/>כַּפָּיו מִדּוּד תַּעֲבֹֽרְ֒נָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/16"/>בַּצָּרָה קָרָֽאתָ וָאֲחַלְּ֒צֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/17"/>אֶעֶנְךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/18"/>בְּסֵֽתֶר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/19"/>רַֽעַם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/20"/>אֶבְחָנְ֒ךָ עַל מֵי מְרִיבָה סֶֽלָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/21"/>שְׁמַע עַמִּי וְאָעִֽידָה בָּךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/22"/>יִשְׂרָאֵל אִם תִּשְׁמַע לִי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/23"/>לֺא יִהְיֶה בְךָ אֵל זָר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/24"/>וְלֺא תִשְׁתַּחֲוֶה לְאֵל נֵכָר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/25"/>אָנֹכִי יְהֹוָה אֱלֺהֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/26"/>הַמַּעַלְ֒ךָ מֵאֶֽרֶץ מִצְרָֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/27"/>הַרְחֶב פִּֽיךָ וַאֲמַלְ֒אֵֽהוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/28"/>וְלֺא שָׁמַע עַמִּי לְקוֹלִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/29"/>וְיִשְׂרָאֵל לֺא אָֽבָה לִי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/30"/>וָאֲשַׁלְּ֒חֵֽהוּ בִּשְׁרִירוּת לִבָּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/31"/>יֵלְ֒כוּ בְּמוֹעֲצוֹתֵיהֶם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/32"/>לוּ עַמִּי שֹׁמֵֽעַ לִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/33"/>יִשְׂרָאֵל בִּדְ֒רָכַי יְהַלֵּֽכוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/34"/>כִּמְ֒עַט אוֹיְ֒בֵיהֶם אַכְנִֽיעַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/35"/>וְעַל צָרֵיהֶם אָשִׁיב יָדִי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/36"/>מְשַׂנְ֒אֵי יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/37"/>יְכַחֲשׁוּ לוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/38"/>וִיהִי עִתָּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/39"/>לְעוֹלָם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/40"/>וַיַּאֲכִילֵֽהוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/41"/>מֵחֵֽלֶב חִטָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/42"/>וּמִצּוּר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/81/43"/>דְּבַשׁ אַשְׂבִּיעֶֽךָּ:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
