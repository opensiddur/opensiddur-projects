      <tei:div corresp="urn:x-opensiddur:text:prayer:hamaavir_shenah_meeinay">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/1"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/2"/>אֱלֹהֵֽינוּ מֶֽלֶךְ הָעוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/3"/>הַמַּעֲבִיר שֵׁנָה מֵעֵינָי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/4"/>וּתְנוּמָה מֵעַפְעַפָּי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/5"/>וִיהִי רָצוֹן מִלְּ֒פָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/6"/>יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/7"/>וֵאלֹהֵי אֲבוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/8"/>שֶׁתַּרְגִּילֵֽנוּ בְּתוֹרָתֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/9"/>וְדַבְּ֒קֵֽנוּ בְּמִצְוֹתֶֽיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/10"/>וְאַל תְּבִיאֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/11"/>לֹא לִידֵי חֵטְא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/12"/>וְלֹא לִידֵי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/13"/>עֲבֵרָה וְעָוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/14"/>וְלֹא לִידֵי נִסָּיוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/15"/>וְלֹא לִידֵי בִזָּיוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/16"/>וְאַל יִשְׁלֹט בָּֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/17"/>יֵֽצֶר הָרָע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/18"/>וְהַרְחִיקֵֽנוּ מֵאָדָם רָע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/19"/>וּמֵחָבֵר רָע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/20"/>וְדַבְּ֒קֵֽנוּ בְּיֵֽצֶר הַטּוֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/21"/>וּבְ֒מַעֲשִׂים טוֹבִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/22"/>וְכוֹף אֶת יִצְרֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/23"/>לְהִשְׁתַּעְבֶּד־לָךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/24"/>וּתְנֵֽנוּ הַיּוֹם וּבְכָל יוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/25"/>לְחֵן וּלְחֶֽסֶד וּלְרַחֲמִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/26"/>בְּעֵינֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/27"/>וּבְעֵינֵי כָל רוֹאֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/28"/>וְתִגְמְ֒לֵֽנוּ חֲסָדִים טוֹבִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/29"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/30"/>גּוֹמֵל חֲסָדִים טוֹבִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamaavir_shenah_meeinay/31"/>לְעַמּוֹ יִשְׂרָאֵל:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
