      <tei:div corresp="urn:x-opensiddur:text:prayer:haolah_qodesh_qadashim">
        <tei:head xml:lang="he">
          <tei:hi rend="small">משנה ד</tei:hi>
        </tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haolah_qodesh_qadashim/1"/>הָעוֹלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haolah_qodesh_qadashim/2"/>קֹֽדֶשׁ קָדָשִׁים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haolah_qodesh_qadashim/3"/>שְׁחִיטָתָהּ בַּצָּפוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haolah_qodesh_qadashim/4"/>וְקִבּוּל דָּמָהּ בִּכְלִי שָׁרֵת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haolah_qodesh_qadashim/5"/>בַּצָּפוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haolah_qodesh_qadashim/6"/>וְדָמָהּ טָעוּן שְׁתֵּי מַתָּנוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haolah_qodesh_qadashim/7"/>שֶׁהֵן אַרְבַּע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haolah_qodesh_qadashim/8"/>וּטְעוּנָה הֶפְשֵׁט וְנִתּֽוּחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haolah_qodesh_qadashim/9"/>וְכָלִיל לָאִשִּׁים:</tei:p>
