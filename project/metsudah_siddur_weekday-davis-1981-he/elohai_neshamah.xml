    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:elohai_neshamah">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohai_neshamah/1"/>אֱלֹהַי,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohai_neshamah/2"/>נְשָׁמָה שֶׁנָּתַֽתָּ בִּי טְהוֹרָה הִיא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohai_neshamah/3"/>אַתָּה בְרָאתָהּ אַתָּה יְצַרְתָּהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohai_neshamah/4"/>אַתָּה נְפַחְתָּהּ בִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohai_neshamah/5"/>וְאַתָּה מְשַׁמְּ֒רָהּ בְּקִרְבִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohai_neshamah/6"/>וְאַתָּה עָתִיד לִטְּ֒לָהּ מִמֶּֽנִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohai_neshamah/7"/>וּלְהַחֲזִירָהּ בִּי לֶעָתִיד לָבֹא,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohai_neshamah/8"/>כָּל זְמַן שֶׁהַנְּ֒שָׁמָה בְקִרְבִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohai_neshamah/9"/>מוֹדֶה אֲנִי לְפָנֶֽיךָ יְהֹוָה אֱלֹהַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohai_neshamah/10"/>וֵאלֹהֵי אֲבוֹתַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohai_neshamah/11"/>רִבּוֹן כָּל הַמַּעֲשִׂים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohai_neshamah/12"/>אֲדוֹן כָּל הַנְּ֒שָׁמוֹת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohai_neshamah/13"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohai_neshamah/14"/>הַמַּחֲזִיר נְשָׁמוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohai_neshamah/15"/>לִפְגָרִים מֵתִים:</tei:p>
      </tei:div>
