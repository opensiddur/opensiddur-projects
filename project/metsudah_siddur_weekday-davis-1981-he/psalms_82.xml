      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/82">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/82/1"/>מִזְמוֹר לְאָסָף
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/82/2"/>אֱלֺהִים נִצָּב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/82/3"/>בַּעֲדַת אֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/82/4"/>בְּקֶֽרֶב אֱלֺהִים יִשְׁפֹּט:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/82/5"/>עַד מָתַי תִּשְׁפְּטוּ עָֽוֶל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/82/6"/>וּפְ֒נֵי רְשָׁעִים תִּשְׂ֒אוּ סֶֽלָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/82/7"/>שִׁפְ֒טוּ דָל וְיָתוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/82/8"/>עָנִי וָרָשׁ הַצְדִּֽיקוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/82/9"/>פַּלְּ֒טוּ דַל וְאֶבְיוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/82/10"/>מִיַּד רְשָׁעִים הַצִּֽילוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/82/11"/>לֺא יָדְ֒עוּ וְלֺא יָבִֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/82/12"/>בַּחֲשֵׁכָה יִתְהַלָּֽכוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/82/13"/>יִמּֽוֹטוּ כָּל מֽוֹסְ֒דֵי אָֽרֶץ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/82/14"/>אֲנִי אָמַֽרְתִּי אֱלֺהִים אַתֶּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/82/15"/>וּבְ֒נֵי עֶלְיוֹן כֻּלְּ֒כֶם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/82/16"/>אָכֵן כְּאָדָם תְּמוּתוּן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/82/17"/>וּכְ֒אַחַד הַשָּׂרִים תִּפֹּֽלוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/82/18"/>קוּמָה אֱלֺהִים שָׁפְ֒טָה הָאָרֶץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/82/19"/>כִּי אַתָּה תִנְחַל בְּכָל הַגּוֹיִם:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
