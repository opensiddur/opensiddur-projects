  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/hodaah/modim">
        <tei:head xml:lang="he">הודאה</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim/1"/>מוֹדִים אֲנַֽחְנוּ לָךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim/2"/>שָׁאַתָּה הוּא יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim/3"/>וֵאלֹהֵי אֲבוֹתֵֽינוּ לְעוֹלָם וָעֶד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim/4"/>צוּר חַיֵּֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim/5"/>מָגֵן יִשְׁעֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim/6"/>אַתָּה הוּא לְדוֹר וָדוֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim/7"/>נוֹדֶה לְּךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim/8"/>וּנְסַפֵּר תְּהִלָּתֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim/9"/>עַל חַיֵּֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim/10"/>הַמְּ֒סוּרִים בְּיָדֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim/11"/>וְעַל־נִשְׁמוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim/12"/>הַפְּ֒קוּדוֹת לָךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim/13"/>וְעַל־נִסֶּֽיךָ שֶׁבְּ֒כָל־יוֹם עִמָּֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim/14"/>וְעַל־נִפְלְ֒אוֹתֶֽיךָ וְטוֹבוֹתֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim/15"/>שֶׁבְּ֒כָל־עֵת,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim/16"/>עֶֽרֶב וָבֹֽקֶר וְצָהֳרָֽיִם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim/17"/>הַטּוֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim/18"/>כִּי לֹא־כָלוּ רַחֲמֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim/19"/>וְהַמְרַחֵם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim/20"/>כִּי לֹא־תַֽמּוּ חֲסָדֶֽיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/hodaah/modim/21"/>כִּי מֵעוֹלָם קִוּינוּ לָךְ:</tei:p>
