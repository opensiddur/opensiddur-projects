    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:kaddish/derabbanan/al_yisrael">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/al_yisrael/1"/>עַל יִשְׂרָאֵל וְעַל רַבָּנָן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/al_yisrael/2"/>וְעַל תַלְמִידֵיהוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/al_yisrael/3"/>וְעַל כָּל תַּלְמִידֵי תַלְמִידֵיהוֹן,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/al_yisrael/4"/>וְעַל כָּל מָאן דְּעָסְ֒קִין בְּאוֹרַיְתָא,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/al_yisrael/5"/>דִּי בְאַתְרָא הָדֵין
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/al_yisrael/6"/>וְדִי בְכָל אֲתַר וַאֲתַר,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/al_yisrael/7"/>יְהֵא לְהוֹן וּלְכוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/al_yisrael/8"/>שְׁלָמָא רַבָּא חִנָּא וְחִסְדָּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/al_yisrael/9"/>וְרַחֲמִין וְחַיִּין אֲרִיכִין
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/al_yisrael/10"/>וּמְזוֹנָא רְוִיחֵי וּפוּרְקָנָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/al_yisrael/11"/>מִן קֳדָם אֲבוּהוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/al_yisrael/12"/>דְבִשְׁמַיָּא וְאַרְעָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/derabbanan/al_yisrael/13"/>וְאִמְרוּ אָמֵן:</tei:p>
      </tei:div>
