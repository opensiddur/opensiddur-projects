      <tei:div corresp="urn:x-opensiddur:text:poem:maoz_tzur/5">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/5/1"/>יְוָנִים נִקְבְּצוּ עָלַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/5/2"/>אֲזַי בִּימֵי חַשְׁמַנִּים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/5/3"/>וּפָרְצוּ חוֹמוֹת מִגְדָּלַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/5/4"/>וְטִמְּ֒אוּ כָּל הַשְּׁמָנִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/5/5"/>וּמִנּוֹתַר קַנְקַנִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/5/6"/>נַעֲשֶׂה נֵס לַשּׁוֹשַׁנִּים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/5/7"/>בְּנֵי בִינָה יְמֵי שְׁמוֹנָה קָבְ֒עוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/5/8"/>שִׁיר וּרְנָנִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/5/9"/>חֲשׂוֹף זְרוֹעַ קָדְשֶׁךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/5/10"/>וְקָרֵב קֵץ הַיְשׁוּעָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/5/11"/>נְקֹם נִקְמַת דַם עֲבָדֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/5/12"/>מֵאֻמָּה הָרְשָׁעָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/5/13"/>כִּי אָרְכָה לָנוּ הַשָּׁעָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/5/14"/>וְאֵין קֵץ לִימֵי הָרָעָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/5/15"/>דְּחֵה אַדְמוֹן בְּצֵל צַלְמוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maoz_tzur/5/16"/>וְהָקֵם לָנוּ רוֹעִים שִׁבְעָה:</tei:p>
