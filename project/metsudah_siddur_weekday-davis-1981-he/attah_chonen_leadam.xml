    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:attah_chonen_leadam">
        <tei:head xml:lang="he">בינה</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_chonen_leadam/1"/>אַתָּה חוֹנֵן לְאָדָם דַּֽעַת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_chonen_leadam/2"/>וּמְ֒לַמֵּד לֶאֱנוֹשׁ בִּינָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_chonen_leadam/3"/>(אַתָּה חוֹנַנְתָּֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_chonen_leadam/4"/>לְמַדַּע תּוֹרָתֶֽךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_chonen_leadam/5"/>וַתְּ֒לַמְּ֒דֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_chonen_leadam/6"/>לַעֲשׂוֹת חֻקֵּי רְצוֹנֶֽךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_chonen_leadam/7"/>וַתַּבְדֵּל יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_chonen_leadam/8"/>בֵּין קֹֽדֶשׁ לְחֹל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_chonen_leadam/9"/>בֵּין אוֹר לְחֽשֶׁךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_chonen_leadam/10"/>בֵּין יִשְׂרָאֵל לָעַמִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_chonen_leadam/11"/>בֵּין יוֹם הַשְּׁ֒בִיעִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_chonen_leadam/12"/>לְשֵֽׁשֶׁת יְמֵי הַמַּעֲשֶׂה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_chonen_leadam/13"/>אָבִֽינוּ מַלְכֵּֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_chonen_leadam/14"/>הָחֵל עָלֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_chonen_leadam/15"/>הַיָּמִים הַבָּאִים לִקְרָאתֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_chonen_leadam/16"/>לְשָׁלוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_chonen_leadam/17"/>חֲשׂוּכִים מִכָּל חֵטְא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_chonen_leadam/18"/>וּמְנֻקִּים מִכָּל עָוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_chonen_leadam/19"/>וּמְדֻבָּקִים בְּיִרְאָתֶֽךָ:)
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_chonen_leadam/20"/>וְחָנֵּֽנוּ מֵאִתְּ֒ךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_chonen_leadam/21"/>חָכְמָה בִּינָה וָדָּֽעַת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_chonen_leadam/22"/>בָּרוּךְ אַתָּה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:attah_chonen_leadam/23"/>חוֹנֵן הַדָּֽעַת:</tei:p>
      </tei:div>
