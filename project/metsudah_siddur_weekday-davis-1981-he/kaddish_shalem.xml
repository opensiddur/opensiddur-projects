      <tei:div corresp="urn:x-opensiddur:text:prayer:kaddish/shalem">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/1"/>יִתְגַּדַּל וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/2"/>בְּעָלְ֒מָא דִּי בְרָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/3"/>כִרְעוּתֵהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/4"/>וְיַמְלִיךְ מַלְכוּתֵהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/55"/>וְיַצְמַח פּוּרְ֒קָנֵהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/56"/>וִיקָרֵב (קֵץ) מְשִׁיחֵהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/7"/>בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/57"/>וּבְחַיֵּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/9"/>דְכָל בֵּית יִשְׂרָאֵל,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/10"/>בַּעֲגָלָא וּבִזְמַן קָרִיב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/11"/>וְאִמְרוּ אָמֵן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/12"/>יְהֵא שְׁמֵהּ רַבָּא מְבָרַךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/13"/>לְעָלַם וּלְעָלְ֒מֵי עָלְ֒מַיָּא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/14"/>יִתְבָּרַךְ וְיִשְׁתַּבַּח
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/15"/>וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְנַשֵּׂא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/16"/>וְיִתְהַדָּר וְיִתְעַלֶּה וְיִתְהַלָּל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/17"/>שְׁמֵהּ דְקוּדְשָׁא, בְּרִיךְ הוּא
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/shalem/hallel"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/65"/>לְעֵֽלָּא
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/shalem/hallel"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/58"/>לְעֵֽלָּא <j:conditional xml:id="inline_1" type="marked"><tei:note type="instruction" xml:lang="he">בעשי"ת</tei:note><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="aseret-ymei-tshuva"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>וּלְ֒עֵֽלָּא מִכָּל<j:endConditional target="#inline_1"/>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/19"/><j:conditional xml:id="inline_2"><j:none><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="aseret-ymei-tshuva"><tei:binary value="true"/></tei:f></tei:fs></j:none></j:conditional>מִן כָּל<j:endConditional target="#inline_2"/> בִּרְכָתָא וְשִׁירָתָא,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/20"/>תֻּשְׁבְּחָתָא וְנֶחֱמָתָא,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/21"/>דַּאֲמִירָן בְּעָלְ֒מָא, וְאִמְרוּ אָמֵן,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/22"/>תִּתְקַבֵּל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/23"/>צְלוֹתְ֒הוֹן וּבָעוּתְ֒הוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/24"/>דְּכָל בֵּית יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/25"/>קֳדָם אֲבוּהוֹן דִּי בִשְׁ֒מַיָּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/26"/>וְאִמְרוּ אָמֵן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/27"/>יְהֵא שְׁלָמָא רַבָּא מִן שְׁמַיָּא
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/shalem/chol_minchah_tachanun"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/63"/>וְחַיִּים טוֹבִים
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/shalem/hallel"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/66"/>וְחַיִּים טוֹבִים
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/shalem/chol_minchah_tachanun"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/shalem/hallel"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/59"/>וְחַיִּים
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_5"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/29"/>עָלֵֽינוּ וְעַל כָּל יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/30"/>וְאִמְרוּ אָמֵן:
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_6"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/shalem/chol_arvit_aleinu"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/64"/>עוֹשֶׂה שָׁלוֹם בִּמְרוֹמָיו
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_6"/>
<j:conditional xml:id="variant_7"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/shalem/hallel"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/67"/>עוֹשֶׂה שָׁלוֹם בִּמְרוֹמָיו
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_7"/>
<j:conditional xml:id="variant_8"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/shalem/chol_arvit_aleinu"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/shalem/hallel"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/60"/>עוֹשֶׂה שָׁלוֹם
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_8"/>
<j:conditional xml:id="variant_9"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/shalem/chol_arvit_aleinu"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/shalem/hallel"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/61"/><j:conditional xml:id="inline_3" type="marked"><tei:note type="instruction" xml:lang="he">בעשי"ת</tei:note><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="aseret-ymei-tshuva"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>הַשָּׁלוֹם<j:endConditional target="#inline_3"/>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_9"/>
<j:conditional xml:id="variant_10"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/shalem/chol_arvit_aleinu"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/shalem/hallel"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/62"/>בִּמְרוֹמָיו
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_10"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/34"/>הוּא יַעֲשֶׂה שָׁלוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/35"/>עָלֵינוּ וְעַל כָּל יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/36"/>וְאִמְרוּ אָמֵן</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
