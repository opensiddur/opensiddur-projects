        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/1"/>יְהֹוָה צְבָאוֹת עִמָּנוּ
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/pesuqim/chol_arvit_motzaei_shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/68"/>מִשְׂגָּב לָֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/69"/>אֱלֹהֵי יַעֲקֹב סֶֽלָה:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/pesuqim/chol_arvit_motzaei_shabbat"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/2"/>מִשְׂגָּב לָֽנוּ אֱלֹהֵי יַעֲקֹב סֶֽלָה:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/3"/>יְהֹוָה צְבָאוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/4"/>אַשְׁרֵי אָדָם בֹּטֵֽחַ בָּךְ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/5"/>יְהֹוָה הוֹשִֽׁיעָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/6"/>הַמֶּֽלֶךְ יַעֲנֵֽנוּ בְיוֹם־קָרְאֵֽנוּ:
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/pesuqim/chol_shacharit_ashrei_uva_letziyyon"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/30"/>בָּרוּךְ הוּא אֱלֺהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/31"/>שֶׁבְּ֒רָאָֽנוּ לִכְ֒בוֹדוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/32"/>וְהִבְדִּילָֽנוּ מִן הַתּוֹעִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/33"/>וְנָֽתַן לָֽנוּ תּוֹרַת אֱמֶת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/34"/>וְחַיֵּי עוֹלָם נָטַע בְּתוֹכֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/35"/>הוּא יִפְתַּח לִבֵּֽנוּ בְּתוֹרָתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/36"/>וְיָשֵׂם בְּלִבֵּֽנוּ אַהֲבָתוֹ וְיִרְאָתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/37"/>וְלַעֲשׂוֹת רְצוֹנוֹ וּלְ֒עָבְ֒דוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/38"/>בְּלֵבָב שָׁלֵם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/39"/>לְמַֽעַן לֺא נִיגַע לָרִיק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/40"/>וְלֺא נֵלֵד לַבֶּהָלָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/41"/>יְהִי רָצוֹן מִלְּ֒פָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/42"/>יְהֹוָה אֱלֺהֵֽינוּ וֵאלֺהֵי אֲבוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/43"/>שֶׁנִּשְׁמֹר חֻקֶּֽיךָ בָּעוֹלָם הַזֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/44"/>וְנִזְכֶּה וְנִחְיֶה וְנִרְאֶה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/45"/>וְנִירַשׁ טוֹבָה וּבְ֒רָכָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/46"/>לִשְׁ֒נֵי יְמוֹת הַמָּשִֽׁיחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/47"/>וּלְ֒חַיֵּי הָעוֹלָם הַבָּא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/48"/>לְמַֽעַן יְזַמֶּרְ֒ךָ כָבוֹד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/49"/>וְלֺא יִדֹּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/50"/>יְהֹוָה אֱלֺהַי לְעוֹלָם אוֹדֶֽךָּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/51"/>בָּרוּךְ הַגֶּֽבֶר אֲשֶׁר יִבְטַח בַּיהוָֹה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/52"/>וְהָיָה יְהֹוָה מִבְטַחוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/53"/>בִּטְ֒חוּ בַיהוָֹה עֲדֵי עַד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/54"/>כִּי בְּיָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/55"/>יְהֹוָה צוּר עוֹלָמִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/56"/>וְיִבְטְחוּ בְךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/57"/>יוֹדְ֒עֵי שְׁמֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/58"/>כִּי לֺא עָזַֽבְתָּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/59"/>דֹרְ֒שֶֽׁיךָ יְהֹוָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/60"/>יְהֹוָה חָפֵץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/61"/>לְמַֽעַן צִדְקוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/62"/>יַגְדִּיל תּוֹרָה וְיַאְדִּיר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/63"/>(יְהֺוָה אֲדוֹנֵֽינוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/64"/>מָה אַדִּיר שִׁמְךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/65"/>בְּכָל הָאָֽרֶץ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/66"/>חִזְ֒קוּ וְיַאֲמֵץ לְבַבְ֒כֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/67"/>כָּל הַמְ֒יַחֲלִים לַיהֹוָה:)
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/pesuqim/chol_arvit_motzaei_shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/70"/>בָּרוּךְ הוּא אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/71"/>שֶׁבְּ֒רָאָֽנוּ לִכְבוֹדוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/72"/>וְהִבְדִּילָֽנוּ מִן הַתּוֹעִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/73"/>וְנָֽתַן לָֽנוּ תּוֹרַת אֱמֶת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/74"/>וְחַיֵּי עוֹלָם נָטַע בְּתוֹכֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/75"/>הוּא יִפְתַּח לִבֵּֽנוּ בְּתוֹרָתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/76"/>וְיָשֵׂם בְּלִבֵּֽנוּ אַהֲבָתוֹ וְיִרְאָתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/77"/>וְלַעֲשׂוֹת רְצוֹנוֹ וּלְעָבְדוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/78"/>בְּלֵבָב שָׁלֵם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/79"/>לְמַֽעַן לֹא נִיגַע לָרִיק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/80"/>וְלֹא נֵלֵד לַבֶּהָלָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/81"/>יְהִי רָצוֹן מִלְּפָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/82"/>יְהֹוָה אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/83"/>שֶׁנִּשְׁמֹר חֻקֶּֽיךָ בָּעוֹלָם הַזֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/84"/>וְנִזְכֶּה וְנִחְיֶה וְנִרְאֶה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/85"/>וְנִירַשׁ טוֹבָה וּבְרָכָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/86"/>לִשְׁנֵי יְמוֹת הַמָּשִֽׁיחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/87"/>וּלְחַיֵּי הָעוֹלָם הַבָּא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/88"/>לְמַֽעַן יְזַמֶּרְךָ כָבוֹד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/89"/>וְלֹא יִדֹּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/90"/>יְהֹוָה אֱלֹהַי לְעוֹלָם אוֹדֶֽךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/91"/>בָּרוּךְ הַגֶּֽבֶר אֲשֶׁר יִבְטַח בַּיהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/92"/>וְהָיָה יְהֹוָה מִבְטַחוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/93"/>בִּטְחוּ בַיהֹוָה עֲדֵי עַד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/94"/>כִּי בְּיָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/95"/>יְהֹוָה צוּר עוֹלָמִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/96"/>וְיִבְטְ֒חוּ בְךָ יוֹדְ֒עֵי שְׁמֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/97"/>כִּי לֹא עָזַֽבְתָּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/98"/>דֹרְ֒שֶֽׁיךָ יְהֹוָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/99"/>יְהֹוָה חָפֵץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/100"/>לְמַֽעַן צִדְקוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/101"/>יַגְדִּיל תּוֹרָה וְיַאְדִּיר:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/28/9"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/pesuqim/chol_shacharit_ashrei_uva_letziyyon"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/pesuqim/chol_arvit_motzaei_shabbat"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/7"/>הוֹשִֽׁיעָה אֶת־עַמֶּֽךָ
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_5"/>
<j:conditional xml:id="variant_6"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/pesuqim/chol_shacharit_ashrei_uva_letziyyon"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/pesuqim/chol_arvit_motzaei_shabbat"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/8"/>וּבָרֵךְ אֶת־נַחֲלָתֶֽךָ
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_6"/>
<j:conditional xml:id="variant_7"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/pesuqim/chol_shacharit_ashrei_uva_letziyyon"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:qorbanot/pesuqim/chol_arvit_motzaei_shabbat"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/pesuqim/9"/>וּרְעֵם וְנַשְּׂ֒אֵם עַד־הָעוֹלָם:
<tei:milestone unit="phrase"/>
