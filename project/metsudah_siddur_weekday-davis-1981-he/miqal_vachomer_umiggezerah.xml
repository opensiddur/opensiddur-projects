      <tei:div corresp="urn:x-opensiddur:text:prayer:miqal_vachomer_umiggezerah">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/1"/>מִקַּל וָחֹֽמֶר,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/2"/>וּמִגְּ֒זֵרָה שָׁוָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/3"/>מִבִּנְיַן אָב מִכָּתוּב אֶחָד,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/4"/>וּמִבִּנְיַן אָב מִשְּׁ֒נֵי כְתוּבִים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/5"/>מִכְּ֒לָל וּפְרָט,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/6"/>וּמִפְּ֒רָט וּכְלָל,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/7"/>כְּלָל וּפְרָט
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/8"/>וּכְלָל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/9"/>אִי אַתָּה דָן אֶלָּא כְּעֵין הַפְּ֒רָט,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/10"/>מִכְּ֒לָל שֶׁהוּא צָרִיךְ לִפְרָט
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/11"/>וּמִפְּ֒רָט שֶׁהוּא צָרִיךְ לִכְלָל,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/12"/>כָּל דָּבָר שֶׁהָיָה בִּכְלָל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/13"/>וְיָצָא מִן הַכְּ֒לָל לְלַמֵּד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/14"/>לֹא לְלַמֵּד עַל עַצְמוֹ יָצָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/15"/>אֶלָּא לְלַמֵּד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/16"/>עַל הַכְּ֒לָל כֻּלּוֹ יָצָא,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/17"/>כָּל דָּבָר שֶׁהָיָה בִּכְלָל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/18"/>וְיָצָא לִטְעֹן טֹֽעַן אֶחָד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/19"/>שֶׁהוּא כְעִנְיָנוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/20"/>יָצָא לְהָקֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/21"/>וְלֹא לְהַחֲמִיר,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/22"/>כָּל דָּבָר שֶׁהָיָה בִּכְלָל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/23"/>וְיָצָא לִטְעֹן טֹֽעַן אַחֵר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/24"/>שֶׁלֹּא כְעִנְיָנוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/25"/>יָצָא לְהָקֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/26"/>וּלְהַחֲמִיר,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/27"/>כָּל דָּבָר שֶׁהָיָה בִּכְלָל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/28"/>וְיָצָא לִדּוֹן בַּדָּבָר הֶחָדָשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/29"/>אִי אַתָּה יָכוֹל לְהַחֲזִירוֹ לִכְלָלוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/30"/>עַד שֶׁיַּחֲזִירֶֽנּוּ הַכָּתוּב לִכְלָלוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/31"/>בְּפֵרוּשׁ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/32"/>דָּבָר הַלָּמֵד מֵעִנְיָנוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/33"/>וְדָבָר הַלָּמֵד מִסּוֹפוֹ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/34"/>וְכֵן שְׁנֵי כְתוּבִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/35"/>הַמַּכְחִישִׁים זֶה אֶת זֶה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/36"/>עַד שֶׁיָּבֹא הַכָּתוּב הַשְּׁ֒לִישִׁי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqal_vachomer_umiggezerah/37"/>וְיַכְרִֽיעַ בֵּינֵיהֶם:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
