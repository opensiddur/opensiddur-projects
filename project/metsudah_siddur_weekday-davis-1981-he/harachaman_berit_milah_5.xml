  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:harachaman_berit_milah/5">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/5/1"/>הָרַחֲמָן, הוּא יִשְׁלַח לָֽנוּ מְשִׁיחוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/5/2"/>הוֹלֵךְ תָּמִים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/5/3"/>בִּזְכוּת חֲתַן לַמּוּלוֹת דָּמִים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/5/4"/>לְבַשֵּׁר בְּשׂוֹרוֹת טוֹבוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/5/5"/>וְנִחוּמִים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/5/6"/>לְעַם אֶחָד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/5/7"/>מְפֻזָּר וּמְפֹרָד בֵּין הָעַמִּים:
<tei:milestone unit="phrase"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/5/8"/>אָמֵן</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
