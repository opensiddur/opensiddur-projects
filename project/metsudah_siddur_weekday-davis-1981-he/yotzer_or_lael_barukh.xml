    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:yotzer_or/lael_barukh">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_barukh/1"/>לָאֵל בָּרוּךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_barukh/2"/>נְעִימוֹת יִתֵּֽנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_barukh/3"/>לַמֶּֽלֶךְ אֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_barukh/4"/>חַי וְקַיָּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_barukh/5"/>זְמִירוֹת יֹאמֵֽרוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_barukh/6"/>וְתִשְׁבָּחוֹת יַשְׁמִֽיעוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_barukh/7"/>כִּי הוּא לְבַדּוֹ מָרוֹם וְקָדוֹשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_barukh/8"/>פּוֹעֵל גְּבוּרוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_barukh/9"/>עֹשֶׂה חֲדָשׁוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_barukh/10"/>בַּֽעַל מִלְחָמוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_barukh/11"/>זוֹרֵֽעַ צְדָקוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_barukh/12"/>מַצְמִֽיחַ יְשׁוּעוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_barukh/13"/>בּוֹרֵא רְפוּאוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_barukh/14"/>נוֹרָא תְהִלּוֹת אֲדוֹן הַנִּפְלָאוֹת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_barukh/15"/>הַמְ֒חַדֵּשׁ בְּטוּבוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_barukh/16"/>בְּכָל יוֹם תָּמִיד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_barukh/17"/>מַעֲשֵׂה בְרֵאשִׁית:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_barukh/18"/>כָּאָמוּר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_barukh/19"/>לְעֹשֵׂה אוֹרִים גְּדֹלִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_barukh/20"/>כִּי לְעוֹלָם חַסְדּוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_barukh/21"/>(וְהִתְקִין מְאוֹרוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yotzer_or/lael_barukh/22"/>מְשַׂמֵּֽחַ עוֹלָמוֹ אֲשֶׁר בָּרָא.)</tei:p>
      </tei:div>
    </tei:body>
