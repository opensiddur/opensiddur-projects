      <tei:div corresp="urn:x-opensiddur:text:prayer:vehiqtir_alav_aharon">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehiqtir_alav_aharon/1"/>וְהִקְטִיר עָלָיו אַהֲרֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehiqtir_alav_aharon/2"/>קְטֹֽרֶת סַמִּים בַּבֹּֽקֶר בַּבֹּֽקֶר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehiqtir_alav_aharon/3"/>בְּהֵיטִיבוֹ אֶת־הַנֵּרֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehiqtir_alav_aharon/4"/>יַקְטִירֶֽנָּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehiqtir_alav_aharon/5"/>וּבְהַעֲלֹת אַהֲרֹן אֶת־הַנֵּרֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehiqtir_alav_aharon/6"/>בֵּין הָֽעַרְבַּֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehiqtir_alav_aharon/7"/>יַקְטִירֶֽנָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehiqtir_alav_aharon/8"/>קְטֹֽרֶת תָּמִיד לִפְנֵי יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehiqtir_alav_aharon/9"/>לְדֹרֹתֵיכֶם:</tei:p>
