          <tei:l>דְּזוּנֵּי בָּאבִּי</tei:l>
          <tei:l>בִּתְרֵי זוּזֵי</tei:l>
          <tei:l>חַד גַּדְיָא, חַד גַּדְיָא,</tei:l>
          <tei:l>בָּאבִּי זוּנֵּי בִּתְרֵי זוּזֵי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:babi_zunne_tre_zuze_a_lishana_deni_zakho_jewish_neo_aramaic/10"/>
        <tei:lg>
          <tei:l>סֵילֵי הַקָּדּוֹשׁ בָּרוּךְ הוּא</tei:l>
          <tei:l>צְׄבַחְלֵי דָּו מַלְאַךְ הַמַּוֶת</tei:l>
          <tei:l>דְּצְׄבַחְלֵי דָּו שׁוֹחֵט</tei:l>
          <tei:l>דְּצְׄבַחְלֵי דָּו תּוֹרָא</tei:l>
          <tei:l>דְשְׁתֵּילֵי דָּו מַיָא</tei:l>
          <tei:l>דְּמוֹגְׄבֵילֵי דָּו נוּרָא</tei:l>
          <tei:l>דְּמוֹקֵיזְלֵי דָּו עַצָּא</tei:l>
          <tei:l>דְּמְכֵילֵי דָּו כַּלְבָּא</tei:l>
          <tei:l>דְּנְגְּזְלָה דָּו קַטוּסָה</tei:l>
          <tei:l>דִּבְּכִלָּה דָּו גַּדְיָא</tei:l>
          <tei:l>דְּזוּנֵּי בָּאבִּי</tei:l>
          <tei:l>בִּתְרֵי זוּזֵי</tei:l>
          <tei:l>חַד גַּדְיָא, חַד גַּדְיָא,</tei:l>
          <tei:l>בָּאבִּי זוּנֵּי בִּתְרֵי זוּזֵי.</tei:l>
