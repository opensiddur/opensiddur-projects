          <tei:l>סֵילֵי כַּלְבָּא</tei:l>
          <tei:l>נְגְּזְלָה דָּו קַטוּסָה</tei:l>
          <tei:l>דִּבְּכִלָּה דָּו גַּדְיָא</tei:l>
          <tei:l>דְּזוּנֵּי בָּאבִּי</tei:l>
          <tei:l>בִּתְרֵי זוּזֵי</tei:l>
          <tei:l>חַד גַּדְיָא, חַד גַּדְיָא,</tei:l>
          <tei:l>בָּאבִּי זוּנֵּי בִּתְרֵי זוּזֵי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:babi_zunne_tre_zuze_a_lishana_deni_zakho_jewish_neo_aramaic/4"/>
