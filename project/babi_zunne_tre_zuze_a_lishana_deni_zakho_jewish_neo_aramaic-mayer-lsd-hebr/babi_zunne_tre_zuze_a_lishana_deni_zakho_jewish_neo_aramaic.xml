      <tei:div corresp="urn:x-opensiddur:text:poem:babi_zunne_tre_zuze_a_lishana_deni_zakho_jewish_neo_aramaic">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:babi_zunne_tre_zuze_a_lishana_deni_zakho_jewish_neo_aramaic/1"/>
        <tei:lg>
          <tei:l>דְּזוּנֵּי בָּאבִּי</tei:l>
          <tei:l>בִּתְרֵי זוּזֵי</tei:l>
          <tei:l>חַד גַּדְיָא, חַד גַּדְיָא,</tei:l>
          <tei:l>בָּאבִּי זוּנֵּי בִּתְרֵי זוּזֵי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:babi_zunne_tre_zuze_a_lishana_deni_zakho_jewish_neo_aramaic/2"/>
        <tei:lg>
          <tei:l>סֵילָה קַטוּסָה</tei:l>
          <tei:l>בְּכִלָּה דָּו גַּדְיָא</tei:l>
          <tei:l>דְּזוּנֵּי בָּאבִּי</tei:l>
          <tei:l>בִּתְרֵי זוּזֵי</tei:l>
          <tei:l>חַד גַּדְיָא, חַד גַּדְיָא,</tei:l>
          <tei:l>בָּאבִּי זוּנֵּי בִּתְרֵי זוּזֵי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:babi_zunne_tre_zuze_a_lishana_deni_zakho_jewish_neo_aramaic/3"/>
