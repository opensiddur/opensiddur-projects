  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms">
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>בָּרֲכִ֥י נַפְשִׁ֗י אֶת־יְה֫וָ֥ה</tei:l>
          <tei:l>יְהוָ֣ה אֱ֭לֹהַי גָּדַ֣לְתָּ מְּאֹ֑ד</tei:l>
          <tei:l>ה֭וֹד וְהָדָ֣ר לָבָֽשְׁתָּ׃ <tei:bibl>(תהלים קד:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/104/2/a"/>
        <tei:lg>
          <tei:l>עֹֽטֶה־א֭וֹר כַּשַּׂלְמָ֑ה</tei:l>
          <tei:l>נוֹטֶ֥ה שָׁ֝מַ֗יִם כַּיְרִיעָֽה׃ <tei:bibl>(תהלים קד:ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>הַשָּׂם־עָבִ֥ים רְכוּב֑וֹ...</tei:l>
          <tei:l>הַֽ֝מְהַלֵּ֗ךְ עַל־כַּנְפֵי־רֽוּחַ׃ <tei:bibl>(תהלים קד:ג חלק)</tei:bibl></tei:l>
          <tei:l>עֹשֶׂ֣ה מַלְאָכָ֣יו רוּח֑וֹת</tei:l>
          <tei:l>מְ֝שָׁרְתָ֗יו אֵ֣שׁ לֹהֵֽט׃ <tei:bibl>(תהלים קד:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/104/5/a"/>
        <tei:lg>
          <tei:l>יָֽסַד־אֶ֭רֶץ עַל־מְכוֹנֶ֑יהָ</tei:l>
          <tei:l>בַּל־תִּ֝מּ֗וֹט עוֹלָ֥ם וָעֶֽד׃ <tei:bibl>(תהלים קד:ה)</tei:bibl></tei:l>
          <tei:l>הַֽמְשַׁלֵּ֣חַ מַ֭עְיָנִים בַּנְּחָלִ֑ים</tei:l>
          <tei:l>בֵּ֥ין הָ֝רִ֗ים יְהַלֵּכֽוּן׃ <tei:bibl>(תהלים קד:י)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/104/11/a"/>
        <tei:lg>
          <tei:l>יַ֭שְׁקוּ כָּל־חַיְת֣וֹ שָׂדָ֑י</tei:l>
          <tei:l>יִשְׁבְּר֖וּ פְרָאִ֣ים צְמָאָֽם׃ <tei:bibl>(תהלים קד:יא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/104/12/a"/>
        <tei:lg>
          <tei:l>עֲ֭לֵיהֶם עוֹף־הַשָּׁמַ֣יִם יִשְׁכּ֑וֹן</tei:l>
          <tei:l>מִבֵּ֥ין עֳ֝פָאיִ֗ם יִתְּנוּ־קֽוֹל׃ <tei:bibl>(תהלים קד:יב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/104/13/a"/>
        <tei:lg>
          <tei:l>מַשְׁקֶ֣ה הָ֭רִים מֵעֲלִיּוֹתָ֑יו</tei:l>
          <tei:l>מִפְּרִ֥י מַ֝עֲשֶׂ֗יךָ תִּשְׂבַּ֥ע הָאָֽרֶץ׃ <tei:bibl>(תהלים קד:יג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/104/14/a"/>
        <tei:lg>
          <tei:l>מַצְמִ֤יחַ חָצִ֨יר ׀ לַבְּהֵמָ֗ה</tei:l>
          <tei:l>וְ֭עֵשֶׂב לַעֲבֹדַ֣ת הָאָדָ֑ם</tei:l>
          <tei:l>לְה֥וֹצִיא לֶ֝֗חֶם מִן־הָאָֽרֶץ׃ <tei:bibl>(תהלים קד:יד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>וְיַ֤יִן ׀ יְשַׂמַּ֬ח לְֽבַב־אֱנ֗וֹשׁ...</tei:l>
          <tei:l>וְ֝לֶ֗חֶם לְֽבַב־אֱנ֥וֹשׁ יִסְעָֽד׃ <tei:bibl>(תהלים קד:טו חלק)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/104/16/a"/>
        <tei:lg>
          <tei:l>יִ֭שְׂבְּעוּ עֲצֵ֣י יְהוָ֑ה</tei:l>
          <tei:l>אַֽרְזֵ֥י לְ֝בָנ֗וֹן אֲשֶׁ֣ר נָטָֽע׃ <tei:bibl>(תהלים קד:טז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/104/19/a"/>
        <tei:lg>
          <tei:l>עָשָׂ֣ה יָ֭רֵחַ לְמוֹעֲדִ֑ים</tei:l>
          <tei:l>שֶׁ֝֗מֶשׁ יָדַ֥ע מְבוֹאֽוֹ׃ <tei:bibl>(תהלים קד:יט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/104/24/a"/>
        <tei:lg>
          <tei:l>מָֽה־רַבּ֬וּ מַעֲשֶׂ֨יךָ ׀ יְֽהוָ֗ה</tei:l>
          <tei:l>כֻּ֭לָּם בְּחָכְמָ֣ה עָשִׂ֑יתָ... <tei:bibl>(תהלים קד:כד חלק)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>הַֽלְל֣וּ אֶת־יְ֭הוָה מִן־הַשָּׁמַ֑יִם</tei:l>
          <tei:l>הַֽ֝לְל֗וּהוּ בַּמְּרוֹמִֽים׃ <tei:bibl>(תהלים קמח:א חלק)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/148/2/a"/>
        <tei:lg>
          <tei:l>הַֽלְל֥וּהוּ כָל־מַלְאָכָ֑יו</tei:l>
          <tei:l>הַֽ֝לְל֗וּהוּ כָּל־צבאו [צְבָאָֽיו׃] <tei:bibl>(תהלים קמח:ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/148/3/a"/>
        <tei:lg>
          <tei:l>הַֽ֭לְלוּהוּ שֶׁ֣מֶשׁ וְיָרֵ֑חַ</tei:l>
          <tei:l>הַ֝לְל֗וּהוּ כָּל־כּ֥וֹכְבֵי אֽוֹר׃ <tei:bibl>(תהלים קמח:ג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/148/5/a"/>
        <tei:lg>
          <tei:l>יְֽ֭הַֽלְלוּ אֶת־שֵׁ֣ם יְהוָ֑ה</tei:l>
          <tei:l>כִּ֤י ה֭וּא צִוָּ֣ה וְנִבְרָֽאוּ׃ <tei:bibl>(תהלים קמח:ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/148/7/a"/>
        <tei:lg>
          <tei:l>הַֽלְל֣וּ אֶת־יְ֭הוָה מִן־הָאָ֑רֶץ</tei:l>
          <tei:l>תַּ֝נִּינִ֗ים וְכָל־תְּהֹמֽוֹת׃ <tei:bibl>(תהלים קמח:ז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/148/8/a"/>
        <tei:lg>
          <tei:l>אֵ֣שׁ וּ֭בָרָד שֶׁ֣לֶג וְקִיט֑וֹר</tei:l>
          <tei:l>ר֥וּחַ סְ֝עָרָ֗ה עֹשָׂ֥ה דְבָרֽוֹ׃ <tei:bibl>(תהלים קמח:ח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/148/9/a"/>
        <tei:lg>
          <tei:l>הֶהָרִ֥ים וְכָל־גְּבָע֑וֹת</tei:l>
          <tei:l>עֵ֥ץ פְּ֝רִ֗י וְכָל־אֲרָזִֽים׃ <tei:bibl>(תהלים קמח:ט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/148/10/a"/>
        <tei:lg>
          <tei:l>הַֽחַיָּ֥ה וְכָל־בְּהֵמָ֑ה</tei:l>
          <tei:l>רֶ֝֗מֶשׂ וְצִפּ֥וֹר כָּנָֽף׃ <tei:bibl>(תהלים קמח:י)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/148/11/a"/>
        <tei:lg>
          <tei:l>מַלְכֵי־אֶ֭רֶץ וְכָל־לְאֻמִּ֑ים</tei:l>
          <tei:l>שָׂ֝רִ֗ים וְכָל־שֹׁ֥פְטֵי אָֽרֶץ׃ <tei:bibl>(תהלים קמח:יא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/148/12/a"/>
        <tei:lg>
          <tei:l>בַּחוּרִ֥ים וְגַם־בְּתוּל֑וֹת</tei:l>
          <tei:l>זְ֝קֵנִ֗ים עִם־נְעָרִֽים׃ <tei:bibl>(תהלים קמח:יב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/148/13/a"/>
        <tei:lg>
          <tei:l>יְהַלְל֤וּ ׀ אֶת־שֵׁ֬ם יְהוָ֗ה</tei:l>
          <tei:l>כִּֽי־נִשְׂגָּ֣ב שְׁמ֣וֹ לְבַדּ֑וֹ</tei:l>
          <tei:l>ה֝וֹד֗וֹ עַל־אֶ֥רֶץ וְשָׁמָֽיִם׃ <tei:bibl>(תהלים קמח:יג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/104/31/a"/>
        <tei:lg>
          <tei:l>יְהִ֤י כְב֣וֹד יְהוָ֣ה לְעוֹלָ֑ם</tei:l>
          <tei:l>יִשְׂמַ֖ח יְהוָ֣ה בְּמַעֲשָֽׂיו׃ <tei:bibl>(תהלים קד:כא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>פָּקַ֥דְתָּ הָאָ֨רֶץ ׀ וַתְּשֹׁ֪קְקֶ֡הָ רַבַּ֬ת תַּעְשְׁרֶ֗נָּה</tei:l>
          <tei:l>פֶּ֣לֶג אֱ֭לֹהִים מָ֣לֵא מָ֑יִם</tei:l>
          <tei:l>תָּכִ֥ין דְּ֝גָנָ֗ם כִּי־כֵ֥ן תְּכִינֶֽהָ׃ <tei:bibl>(תהלים סה:י)</tei:bibl></tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>תְּלָמֶ֣יהָ רַ֭וֵּה...</tei:l>
          <tei:l>בִּרְבִיבִ֥ים תְּ֝מֹגְגֶ֗נָּה</tei:l>
          <tei:l>צִמְחָ֥הּ תְּבָרֵֽךְ׃ <tei:bibl>(תהלים סה:יא חלק)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/65/12/a"/>
        <tei:lg>
          <tei:l>עִ֭טַּרְתָּ שְׁנַ֣ת טוֹבָתֶ֑ךָ</tei:l>
          <tei:l>וּ֝מַעְגָּלֶ֗יךָ יִרְעֲפ֥וּן דָּֽשֶׁן׃ <tei:bibl>(תהלים סה:יב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/65/13/a"/>
        <tei:lg>
          <tei:l>יִ֭רְעֲפוּ נְא֣וֹת מִדְבָּ֑ר</tei:l>
          <tei:l>וְ֝גִ֗יל גְּבָע֥וֹת תַּחְגֹּֽרְנָה׃ <tei:bibl>(תהלים סה:יג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/65/14/a"/>
        <tei:lg>
          <tei:l>לָבְשׁ֬וּ כָרִ֨ים ׀ הַצֹּ֗אן</tei:l>
          <tei:l>וַעֲמָקִ֥ים יַֽעַטְפוּ־בָ֑ר</tei:l>
          <tei:l>יִ֝תְרוֹעֲע֗וּ אַף־יָשִֽׁירוּ׃ <tei:bibl>(תהלים סה:יד)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>