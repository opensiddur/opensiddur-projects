                <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/mishpat"/>
                <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/minim"/>
                <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/tzaddiqim"/>
                <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/yerushalayim"/>
                <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/david"/>
                <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/tefillah"/>
                <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/avodah"/>
                <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/hodaah"/>
                <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/shalom"/>
                <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/elohai_netzor"/>
                <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/yehi_ratzon"/>
                <j:endDeclare target="#section_minchah_silent_settings"/>
              </tei:div>
            </tei:div>
            <tei:div xml:id="section_minchah_repetition">
              <j:conditional xml:id="section_minchah_repetition_condition">
                <tei:note type="instruction"><tei:foreign xml:lang="he">במניין:</tei:foreign> <tei:foreign xml:lang="en">With a minyan:</tei:foreign> </tei:note>
                <j:all>
                  <tei:fs type="opensiddur:quorum">
                    <tei:f name="minyan">
                      <tei:binary value="true"/>
                    </tei:f>
                  </tei:fs>
                </j:all>
              </j:conditional>
              <tei:div>
                <tei:head xml:lang="he">חזרת הש״ץ</tei:head>
