            <j:transclude type="external" target="urn:x-opensiddur:text:siddur:chol/shacharit/pesuqei_dezimrah/hoshiah_et_ammekha"/>
            <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/19"/>
            <j:endDeclare target="#section_morning_settings"/>
          </tei:div>
          <j:endConditional target="#section_morning_condition"/>
        </tei:div>
        <tei:div xml:id="section_supplementary_psalms">
