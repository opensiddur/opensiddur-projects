                  <tei:div>
                    <tei:note type="description" xml:lang="he">החזן אומר מודים והקהל אומרים מודים דרבנן באותה שעה.</tei:note>
                    <tei:note type="description" xml:lang="en">The reader says Modim while the congregation recites Modim derabbanan.</tei:note>
                    <tei:div xml:id="section_modim_reader">
                      <tei:div>
                        <tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he">חזן</tei:note>
                        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/hodaah"/>
