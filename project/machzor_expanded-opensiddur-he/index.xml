                <tei:f name="yom-tov">
                  <tei:binary value="false"/>
                </tei:f>
                <tei:f name="aseret-ymei-tshuva">
                  <tei:binary value="false"/>
                </tei:f>
              </tei:fs>
              <tei:fs type="opensiddur:hebrew-date">
                <tei:f name="month">
                  <tei:numeric value="6"/>
                </tei:f>
                <tei:f name="day">
                  <tei:numeric value="29"/>
                </tei:f>
              </tei:fs>
            </j:all>
          </j:conditional>
          <tei:div>
