                <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/shalom"/>
                <j:endDeclare target="#section_minchah_repetition_settings"/>
              </tei:div>
              <j:endConditional target="#section_minchah_repetition_condition"/>
            </tei:div>
            <tei:div xml:id="section_whole_kaddish">
              <j:conditional xml:id="section_whole_kaddish_condition">
                <tei:note type="instruction"><tei:foreign xml:lang="he">במניין:</tei:foreign> <tei:foreign xml:lang="en">With a minyan:</tei:foreign> </tei:note>
