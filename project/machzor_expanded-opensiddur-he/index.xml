        </tei:div>
        <tei:div xml:id="section_morning">
          <j:conditional xml:id="section_morning_condition">
            <j:all>
              <tei:fs type="opensiddur:service-time">
                <tei:f name="shaharit">
                  <tei:binary value="true"/>
                </tei:f>
              </tei:fs>
              <tei:fs type="opensiddur:holiday">
                <tei:f name="rosh-hashana">
                  <tei:numeric value="1"/>
                </tei:f>
              </tei:fs>
            </j:all>
          </j:conditional>
