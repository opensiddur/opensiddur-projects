            <tei:head xml:lang="en">Erev Rosh ha-Shanah Minchah</tei:head>
            <j:declare xml:id="section_weekday_minchah_settings">
              <tei:fs type="opensiddur:service-time">
                <tei:f name="shaharit">
                  <tei:binary value="false"/>
                </tei:f>
                <tei:f name="minha">
                  <tei:binary value="true"/>
                </tei:f>
                <tei:f name="maariv">
                  <tei:binary value="false"/>
                </tei:f>
                <tei:f name="musaf">
                  <tei:binary value="false"/>
                </tei:f>
                <tei:f name="neila">
                  <tei:binary value="false"/>
                </tei:f>
                <tei:f name="slihot">
                  <tei:binary value="false"/>
                </tei:f>
              </tei:fs>
              <tei:fs type="opensiddur:holiday-aggregate">
                <tei:f name="shabbat">
                  <tei:binary value="false"/>
