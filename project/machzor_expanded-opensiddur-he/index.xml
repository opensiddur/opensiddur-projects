                <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/minim"/>
                <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/tzaddiqim"/>
                <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/yerushalayim"/>
                <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/david"/>
                <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/tefillah"/>
