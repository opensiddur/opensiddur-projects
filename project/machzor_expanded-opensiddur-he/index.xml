            <j:transclude type="external" target="urn:x-opensiddur:text:prayer:mah_tovu"/>
            <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/17/6"/>
            <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/17/15"/>
            <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/31/15"/>
            <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/28/2"/>
            <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/30/3"/>
