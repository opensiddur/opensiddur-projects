            <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/5/3"/>
            <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/5/4"/>
            <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/17/6"/>
            <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/26/12"/>
