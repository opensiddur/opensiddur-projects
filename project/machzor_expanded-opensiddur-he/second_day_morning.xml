s type="opensiddur:service-time"><tei:f name="shaharit"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional><tei:div xml:id="morning_tallit"><tei:head xml:lang="he">סֵֽדֶר עֲטִיפַת הַטַּלִּית.</tei:head><tei:head resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Wrapping in the tallit</tei:head><tei:note type="description" xml:lang="en" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n24.jpg">Before draping oneself in the <tei:foreign xml:lang="he">טלית</tei:foreign> the following is said:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:tallith/hineni_mitattef"/><tei:note type="description" xml:lang="en" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n24.jpg">Then this <tei:foreign xml:lang="he">ברכה</tei:foreign> is recited while standing:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:tallith/lehitattef"/><tei:note type="instruction" xml:lang="en" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n24.jpg">One then drapes oneself in the <tei:foreign xml:lang="he">טלית</tei:foreign> and says:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:tallith/mah_yaqar"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:tallith/yehi_ratzon"/><tei:note type="instruction" xml:lang="en" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n24.jpg">One then removes the <tei:foreign xml:lang="he">טלית</tei:foreign> from the face and drapes oneself in such a way that there should be one <tei:foreign xml:lang="he">ציצת</tei:foreign> in front and one behind on each side.</tei:note></tei:div><tei:div xml:id="morning_preliminaries"><tei:head xml:lang="he">תְּפִלּוֹת.</tei:head><tei:head xml:lang="en">Prayers</tei:head><tei:note type="description" xml:lang="en" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n25.jpg">On entering the Synagogue:</tei:note><tei:div xml:id="expanded_morning_entrance_verses"><j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/5/8"/><j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/55/15/b"/></tei:div><j:transclude type="external" target="urn:x-opensiddur:text:prayer:mah_tovu"/><j:transclude type="external" target="urn:x-opensiddur:text:poem:shachar_avaqeshkha_gabirol"/><tei:note type="description" xml:lang="en" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n25.jpg">Before the morning prayer:</tei:note><tei:div xml:id="expanded_morning_before_prayer"><j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/17/6"/><j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/17/15"/><j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/31/15"/><j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/28/2"/><j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/30/3"/><j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/30/9"/><j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/31/17"/><j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/38/16"/><j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/39/13/shimah"/><j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/30/11"/><j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/122/1"/><j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/119/162"/><j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/5/3"/><j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/5/4"/><j:declare xml:id="repeated_psalm_printing"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:bible:psalms/17/6/second_day_morning_printing"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:bible:psalms/17/6/second_day_night_printing"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:bible:psalms/17/6/second_day_repeat_printing"><tei:binary value="true"/></tei:f></tei:fs></j:declare><j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/17/6"/><j:endDeclare target="#repeated_psalm_printing"/><j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/26/12"/></tei:div><j:transclude type="external" target="urn:x-opensiddur:text:poem:yigdal"/></tei:div><tei:div xml:id="morning_blessings"><tei:head xml:lang="he">תְּפִלַּת שַׁחֲרִית.</tei:head><tei:head xml:lang="en">Morning Prayer</tei:head><j:transclude type="external" target="urn:x-opensiddur:text:poem:adon_olam"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:al_netilat_yadayim"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:asher_yatzar"/><j:conditional xml:id="torah_study_early"><tei:note type="instruction" resp="urn:x-opensiddur:contributor:opensiddur.org/codex"><tei:foreign xml:lang="he">שלא כמנהג אשכנז</tei:foreign><tei:foreign xml:lang="en">Outside the German rite</tei:foreign></tei:note><j:none><tei:fs type="opensiddur:rite"><tei:f name="german"><tei:binary value="true"/></tei:f></tei:fs></j:none></j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hatorah/laasoq"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hatorah/vehaarev"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hatorah/asher_bachar"/><j:transclude type="external" target="urn:x-opensiddur:text:bible:numbers/6/24-/6/26"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:ellu_devarim"/><j:endConditional target="#torah_study_early"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:elohai_neshamah"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hashachar/lasekhvi"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hashachar/shelo_asani_goy"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hashachar/shelo_asani_aved"/><j:conditional xml:id="morning_birkhot_hashachar_shelo_asani_ishah_condition"><tei:note type="instruction" resp="urn:x-opensiddur:contributor:opensiddur.org/codex"><tei:foreign xml:lang="he">לזכר</tei:foreign><tei:foreign xml:lang="en">Men</tei:foreign></tei:note><j:all><tei:fs type="opensiddur:person"><tei:f name="gender"><tei:symbol value="male"/></tei:f></tei:fs></j:all></j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hashachar/shelo_asani_ishah"/><j:endConditional target="#morning_birkhot_hashachar_shelo_asani_ishah_condition"/><j:conditional xml:id="morning_birkhot_hashachar_sheasani_kirtzono_condition"><tei:note type="instruction" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n33.jpg"><tei:foreign resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">לנשים, במקום הברכה הקודמת:</tei:foreign><tei:foreign xml:lang="en">In place of the preceding benediction women say:</tei:foreign></tei:note><j:all><tei:fs type="opensiddur:person"><tei:f name="gender"><tei:symbol value="female"/></tei:f></tei:fs></j:all></j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hashachar/sheasani_kirtzono"/><j:endConditional target="#morning_birkhot_hashachar_sheasani_kirtzono_condition"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hashachar/poqeach_ivrim"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hashachar/malbish_arummim"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hashachar/mattir_asurim"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hashachar/zoqef_kefufim"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hashachar/roqa_haaretz"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hashachar/sheasah_li"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hashachar/hamekhin"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hashachar/ozer_yisrael"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hashachar/oter_yisrael"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hashachar/hanoten_layaef"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hashachar/hamaavir_shenah"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hashachar/shetargilenu-/gomel_chasadim"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hashachar/shetatzileni"/><tei:note type="instruction" xml:lang="he" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n35.jpg">לְעוֹלָם יְהֵא אָדָם יְרֵא שָׁמַֽיִם בְּסֵֽתֶר וּמוֹדֶה עַל־הָאֱמֶת וְדוֹבֵר אֱמֶת בִּלְבָבוֹ וְיַשְׁכֵּם וְיֹאמַר:</tei:note><tei:note type="instruction" xml:lang="en" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n36.jpg">Let man always fear God in private, acknowledge the truth, speak truth in his heart and rise early in the morning and say:</tei:note><j:transclude type="external" target="urn:x-opensiddur:text:prayer:ribbon_kol_haolamim"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:aval_anachnu"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:lefikhakh"/><j:transclude type="external" target="urn:x-opensiddur:text:bible:deuteronomy/6/4"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:shema/barukh_shem"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:attah_hu/ad_shelo-/uvishuatekha"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:attah_hu/bashamayim"/><j:conditional xml:id="torah_study_late"><tei:note type="instruction" resp="urn:x-opensiddur:contributor:opensiddur.org/codex"><tei:foreign xml:lang="he">למנהג אשכנז</tei:foreign><tei:foreign xml:lang="en">In the German rite</tei:foreign></tei:note><j:all><tei:fs type="opensiddur:rite"><tei:f name="german"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional><j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hatorah/laasoq"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hatorah/vehaarev"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hatorah/asher_bachar"/><j:transclude type="external" target="urn:x-opensiddur:text:bible:numbers/6/24-/6/26"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:ellu_devarim"/><j:endConditional target="#torah_study_late"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:qorbanot/kiyyor"/><j:transclude type="external" target="urn:x-opensiddur:text:bible:leviticus/6/3-/6/4"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:qorbanot/tamid"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:qorbanot/veshachat"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:qorbanot/attah_hu"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:qorbanot/qetoret"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:qorbanot/pittum_haqetoret"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:qorbanot/pittum_haqetoret/rashbag"/><j:transclude type="external" target="urn:x-opensiddur:text:prayer:qorbanot/pittum_haqetoret/rabbi_natan"/><j:transclude type="external" target="urn:x-open