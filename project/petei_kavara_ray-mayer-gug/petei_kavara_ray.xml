  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:petei_kavara_ray">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:petei_kavara_ray/1"/>
        <tei:lg>
          <tei:l>Peteĩ kavara ra’y,</tei:l>
          <tei:l>peteĩ kavara ra’y,</tei:l>
          <tei:l>ojoguava’ekue che ru</tei:l>
          <tei:l>mokõi pláta rehe,</tei:l>
          <tei:l>peteĩ kavara ra’y,</tei:l>
          <tei:l>peteĩ kavara ra’y.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:petei_kavara_ray/2"/>
        <tei:lg>
          <tei:l>Ha upéi katu ou mbarakaja</tei:l>
          <tei:l>ha ho’u pe kavara ra’y,</tei:l>
          <tei:l>ojoguava’ekue che ru</tei:l>
          <tei:l>mokõi pláta rehe,</tei:l>
          <tei:l>peteĩ kavara ra’y,</tei:l>
          <tei:l>peteĩ kavara ra’y.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:petei_kavara_ray/3"/>
        <tei:lg>
          <tei:l>Ha upéi katu ou jagua</tei:l>
          <tei:l>ha oisu’u pe mbarakaja,</tei:l>
          <tei:l>ho’uva’ekue pe kavara ra’y,</tei:l>
          <tei:l>ojoguava’ekue che ru</tei:l>
          <tei:l>mokõi pláta rehe,</tei:l>
          <tei:l>peteĩ kavara ra’y,</tei:l>
          <tei:l>peteĩ kavara ra’y.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:petei_kavara_ray/4"/>
        <tei:lg>
          <tei:l>Ha upéi katu ou yvyra’i</tei:l>
          <tei:l>ha oinupã pe jagua,</tei:l>
          <tei:l>oisu’uva’ekue pe mbarakaja,</tei:l>
          <tei:l>ho’uva’ekue pe kavara ra’y,</tei:l>
          <tei:l>ojoguava’ekue che ru</tei:l>
          <tei:l>mokõi pláta rehe,</tei:l>
          <tei:l>peteĩ kavara ra’y,</tei:l>
          <tei:l>peteĩ kavara ra’y.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:petei_kavara_ray/5"/>
        <tei:lg>
          <tei:l>Ha upéi katu ou tata</tei:l>
          <tei:l>ha ohapý pe yvyra’i,</tei:l>
          <tei:l>oinupãva’ekue pe jagua,</tei:l>
          <tei:l>oisu’uva’ekue pe mbarakaja,</tei:l>
          <tei:l>ho’uva’ekue pe kavara ra’y,</tei:l>
          <tei:l>ojoguava’ekue che ru</tei:l>
          <tei:l>mokõi pláta rehe,</tei:l>
          <tei:l>peteĩ kavara ra’y,</tei:l>
          <tei:l>peteĩ kavara ra’y.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:petei_kavara_ray/6"/>
        <tei:lg>
          <tei:l>Ha upéi katu ou y</tei:l>
          <tei:l>ha ombogue pe tata,</tei:l>
          <tei:l>ohapyva’ekue pe yvyra’i,</tei:l>
          <tei:l>oinupãva’ekue pe jagua,</tei:l>
          <tei:l>oisu’uva’ekue pe mbarakaja,</tei:l>
          <tei:l>ho’uva’ekue pe kavara ra’y,</tei:l>
          <tei:l>ojoguava’ekue che ru</tei:l>
          <tei:l>mokõi pláta rehe,</tei:l>
          <tei:l>peteĩ kavara ra’y,</tei:l>
          <tei:l>peteĩ kavara ra’y.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:petei_kavara_ray/7"/>
        <tei:lg>
          <tei:l>Ha upéi katu ou guéi</tei:l>
          <tei:l>ha ho’u pe y,</tei:l>
          <tei:l>ombogueva’ekue pe tata,</tei:l>
          <tei:l>ohapyva’ekue pe yvyra’i,</tei:l>
          <tei:l>oinupãva’ekue pe jagua,</tei:l>
          <tei:l>oisu’uva’ekue pe mbarakaja,</tei:l>
          <tei:l>ho’uva’ekue pe kavara ra’y,</tei:l>
          <tei:l>ojoguava’ekue che ru</tei:l>
          <tei:l>mokõi pláta rehe,</tei:l>
          <tei:l>peteĩ kavara ra’y,</tei:l>
          <tei:l>peteĩ kavara ra’y.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:petei_kavara_ray/8"/>
        <tei:lg>
          <tei:l>Ha upéi katu ou so’oñemuha</tei:l>
          <tei:l>ha ojuka pe guéi,</tei:l>
          <tei:l>ho’uva’ekue pe y,</tei:l>
          <tei:l>ombogueva’ekue pe tata,</tei:l>
          <tei:l>ohapyva’ekue pe yvyra’i,</tei:l>
          <tei:l>oinupãva’ekue pe jagua,</tei:l>
          <tei:l>oisu’uva’ekue pe mbarakaja,</tei:l>
          <tei:l>ho’uva’ekue pe kavara ra’y,</tei:l>
          <tei:l>ojoguava’ekue che ru</tei:l>
          <tei:l>mokõi pláta rehe,</tei:l>
          <tei:l>peteĩ kavara ra’y,</tei:l>
          <tei:l>peteĩ kavara ra’y.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:petei_kavara_ray/9"/>
        <tei:lg>
          <tei:l>Ha upéi katu ou ñemano</tei:l>
          <tei:l>ha ojuka pe so’oñemuha,</tei:l>
          <tei:l>ojukava’ekue pe guéi,</tei:l>
          <tei:l>ho’uva’ekue pe y,</tei:l>
          <tei:l>ombogueva’ekue pe tata,</tei:l>
          <tei:l>ohapyva’ekue pe yvyra’i,</tei:l>
          <tei:l>oinupãva’ekue pe jagua,</tei:l>
          <tei:l>oisu’uva’ekue pe mbarakaja,</tei:l>
          <tei:l>ho’uva’ekue pe kavara ra’y,</tei:l>
          <tei:l>ojoguava’ekue che ru</tei:l>
          <tei:l>mokõi pláta rehe,</tei:l>
          <tei:l>peteĩ kavara ra’y,</tei:l>
          <tei:l>peteĩ kavara ra’y.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:petei_kavara_ray/10"/>
        <tei:lg>
          <tei:l>Ha upéi katu ou Tupã ojehovasáva</tei:l>
          <tei:l>ha ojuka pe ñemano</tei:l>
          <tei:l>ojukava’ekue pe so’oñemuha,</tei:l>
          <tei:l>ojukava’ekue pe guéi,</tei:l>
          <tei:l>ho’uva’ekue pe y,</tei:l>
          <tei:l>ombogueva’ekue pe tata,</tei:l>
          <tei:l>ohapyva’ekue pe yvyra’i,</tei:l>
          <tei:l>oinupãva’ekue pe jagua,</tei:l>
          <tei:l>oisu’uva’ekue pe mbarakaja,</tei:l>
          <tei:l>ho’uva’ekue pe kavara ra’y,</tei:l>
          <tei:l>ojoguava’ekue che ru</tei:l>
          <tei:l>mokõi pláta rehe,</tei:l>
          <tei:l>peteĩ kavara ra’y,</tei:l>
          <tei:l>peteĩ kavara ra’y.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
