      <tei:div corresp="urn:x-opensiddur:text:poem:banu_hoshekh_lgaresh_by_sara_levi_tanai">
        <tei:head>בָּאנוּ חֹשֶׁךְ לְגָרֵשׁ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:banu_hoshekh_lgaresh_by_sara_levi_tanai/1"/>
        <tei:lg>
          <tei:l>בָּאנוּ חֹשֶׁךְ לְגָרֵשׁ.‏</tei:l>
          <tei:l>בְּיָדֵינוּ אוֹר וַאֵשׁ.‏</tei:l>
          <tei:l>כׇּל אֶחָד הוּא אוֹר קָטָן,‏</tei:l>
          <tei:l>וְכֻלָּנוּ – אוֹר אֵיתָן.‏</tei:l>
          <tei:l>סוּרָה חֹשֶׁךְ! הָלְאָה שְׁחוֹר!‏</tei:l>
          <tei:l>סוּרָה מִפְּנֵי הָאוֹר!‏</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
