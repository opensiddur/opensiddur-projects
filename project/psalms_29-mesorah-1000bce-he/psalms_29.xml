    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/29">
        <tei:head>תהלים כ״ט</tei:head>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>מִזְמוֹר לְדָוִד,</tei:l>
          <tei:l>הָבוּ לַיהוה בְּנֵי אֵלִים׃</tei:l>
          <tei:l>הָבוּ לַיהוה כָּבוֹד וָעֹז׃</tei:l>
          <tei:l>הָבוּ לַיהוה כְּבוֹד שְׁמוֹ,</tei:l>
          <tei:l>הִשְׁתַּחֲווּ לַיהוה בְּהַדְרַת קֹדֶשׁ׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>קוֹל יהוה עַל הַמָּיִם,</tei:l>
          <tei:l>אֵל הַכָּבוֹד הִרְעִים,</tei:l>
          <tei:l>יהוה עַל מַיִם רַבִּים׃</tei:l>
          <tei:l>קוֹל יהוה בַּכֹּחַ׃</tei:l>
          <tei:l>קוֹל יהוה בֶּהָדָר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/29/5/a"/>
        <tei:lg>
          <tei:l>קוֹל יהוה שֹׁבֵר אֲרָזִים,</tei:l>
          <tei:l>וַיְשַׁבֵּר יהוה אֶת אַרְזֵי הַלְּבָנוֹן׃</tei:l>
          <tei:l>וַיַּרְקִידֵם כְּמוֹ עֵגֶל,</tei:l>
          <tei:l>לְבָנוֹן וְשִׂרְיוֹן כְּמוֹ בֶן רְאֵמִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>קוֹל יהוה חֹצֵב לַהֲבוֹת אֵשׁ׃</tei:l>
          <tei:l>קוֹל יהוה יָחִיל מִדְבָּר,</tei:l>
          <tei:l>יָחִיל יהוה מִדְבַּר קָדֵשׁ׃</tei:l>
          <tei:l>קוֹל יהוה יְחוֹלֵל אַיָּלוֹת, וַיֶּחֱשֹף יְעָרוֹת,</tei:l>
          <tei:l>וּבְהֵיכָלוֹ, כֻּלּוֹ אֹמֵר כָּבוֹד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/29/10/a"/>
        <tei:lg>
          <tei:l>יהוה לַמַּבּוּל יָשָׁב,</tei:l>
          <tei:l>וַיֵּשֶׁב יהוה מֶלֶךְ לְעוֹלָם׃</tei:l>
          <tei:l>יהוה עֹז לְעַמּוֹ יִתֵּן,</tei:l>
          <tei:l>יהוה יְבָרֵךְ אֶת עַמּוֹ בַשָּׁלוֹם:</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
