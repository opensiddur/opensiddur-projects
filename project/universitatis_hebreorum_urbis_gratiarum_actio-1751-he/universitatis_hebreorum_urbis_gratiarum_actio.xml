    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:universitatis_hebreorum_urbis_gratiarum_actio">
        <tei:head>תְשׁוּאוֹת מִקְהִלַת הָעִבְרִים בְּרוֹמָא</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:universitatis_hebreorum_urbis_gratiarum_actio/1"/>
        <tei:lg>
          <tei:l>מִקְהִלַת הָעִבְרִים אֲשֶׁר בְּרוֹמָא תְשׁוּאוֹת חֵן חֵן <tei:bibl>(זכריה ד:ז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:universitatis_hebreorum_urbis_gratiarum_actio/2"/>
        <tei:lg>
          <tei:l>לְרוֹמְמוּת הָאַפִּיפְיוֹר גָדוֹל וָטוֹב בִּמְאֹד מְאֹד הַמּוֹלֵךְ בְּשַׁלְוָה עַל כִּסֵא מַלְכוּתוֹ בָּרוּךְ אַרְבָּעָה עַשָׂר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:universitatis_hebreorum_urbis_gratiarum_actio/3"/>
        <tei:lg>
          <tei:l>עַל כִּי הִפְלִיא חַסְדוֹ עִמָהּ בִּצְדָקָה רַב לְהוֹשִׂיעַ <tei:bibl>(ישעיה סג:א)</tei:bibl> בִּזְמַן שֶׁנְּהַר טֵיבֵירי שָׁטָף וְעָבָר עַל־כָּל־גְּדוֹתָיו <tei:bibl>(כמו ישעיה ח:ז-ח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:universitatis_hebreorum_urbis_gratiarum_actio/4"/>
        <tei:lg>
          <tei:l>מִתְּחִלַת פֵיבְרָארוֹ עַד שִׁבְעָה בּוֹ שְׁנַת אׄתׄשׄנׄאׄ</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
