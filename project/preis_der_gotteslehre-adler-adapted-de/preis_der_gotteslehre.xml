  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:preis_der_gotteslehre">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:preis_der_gotteslehre/1"/>
        <tei:lg>
          <tei:l>Preis der Gotteslehre.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:preis_der_gotteslehre/2"/>
        <tei:lg>
          <tei:l>Du, meine Seele, schwinge</tei:l>
          <tei:l>Dich auf zu Gottes Thron,</tei:l>
          <tei:l>Aus meinem Mund erklinge</tei:l>
          <tei:l>Des Dankes Jubelton,</tei:l>
          <tei:l>Dass Er, der Herr der Gnade,</tei:l>
          <tei:l>Durch Seines Dieners Mund,</tei:l>
          <tei:l>Und für des Lebens Pfade,</tei:l>
          <tei:l>Gab Seine Lehre kund!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:preis_der_gotteslehre/4"/>
        <tei:lg>
          <tei:l>Ja, Vater, sei gepriesen,</tei:l>
          <tei:l>Du dort im Himmelszelt,</tei:l>
          <tei:l>Der solches Heil erwiesen</tei:l>
          <tei:l>Durch Israel der Welt:</tei:l>
          <tei:l>Du Helfer in Gefahren,</tei:l>
          <tei:l>Du Schutz in Leid und Tod,</tei:l>
          <tei:l>Auch ich will treu bewahren</tei:l>
          <tei:l>Dein heiliges Gebot.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
