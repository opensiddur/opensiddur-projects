    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_in_the_aftermath_of_the_hurricane_barth">
        <tei:head>אחרי הסערה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_in_the_aftermath_of_the_hurricane_barth/1"/>
        <tei:lg>
          <tei:l>אֶשָּׂא עֵינַי אֶל הֶהָרִים</tei:l>
          <tei:l>מֵאַיִן יָבֹא עֶזְרִי׃ <tei:bibl>(תהלים קכא:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_in_the_aftermath_of_the_hurricane_barth/3"/>
        <tei:lg>
          <tei:l>עֶזְרִי מֵעִם יְהוָה עֹשֵׂה שָׁמַיִם וָאָרֶץ׃ <tei:bibl>(תהלים קכא:ב)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
