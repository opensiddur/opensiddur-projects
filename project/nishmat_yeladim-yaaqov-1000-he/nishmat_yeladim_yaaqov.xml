      <tei:div corresp="urn:x-opensiddur:text:poem:nishmat_yeladim_yaaqov">
        <tei:head>נִשְׁמַת יְלָדִים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nishmat_yeladim_yaaqov/1"/>
        <tei:lg>
          <tei:l>נִשְׁמַת <tei:seg type="acrostic">יְ</tei:seg>לָדִים שׁוֹמְמִים עַל־חׇרְבַּן אֲרִיאֵל</tei:l>
          <tei:l>בּוֹשִׁים וְנִכְלָמִים עַל לֹא־שָׁמְעוּ דְּבַר הָאֵל</tei:l>
          <tei:l>שִׁמְע֥וּ דְבַר־יְהֹוָ֖ה בֵּ֣ית יַעֲקֹ֑ב וְכׇֽל־מִשְׁפְּח֖וֹת בֵּ֥ית יִשְׂרָאֵֽל׃ <tei:bibl>(ירמיה ב:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nishmat_yeladim_yaaqov/2"/>
        <tei:lg>
          <tei:l>נִשְׁמַת <tei:seg type="acrostic">עֲ</tei:seg>נִיִּם מִשְׁתּוֹמְמִים מִיּוֹם אֲשֶׁר נָֽסוּ צְלָלַי</tei:l>
          <tei:l>תְּוַעֲדָךְ דּוֹבֵר צֶֽדֶק נָאַם לָהֶם שִׁמְעוּ בָנִים מִלָּי</tei:l>
          <tei:l>מַה־מָּצְא֨וּ אֲבוֹתֵיכֶ֥ם בִּי֙ עָ֔וֶל כִּ֥י רָחֲק֖וּ מֵעָלָ֑י׃ <tei:bibl>(ירמיה ב:ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nishmat_yeladim_yaaqov/3"/>
        <tei:lg>
          <tei:l>נִשְׁמַת <tei:seg type="acrostic">קְ</tei:seg>דוֹשִׁים שׁוֹכְבִים בֵּין תַּנּוּר וְכִירַֽיִם</tei:l>
          <tei:l>קְדוֹרַנִּית הוֹלְכִים עַל כִּי־מָאֲסוּ דָּת שׁוֹכֵן שָׁמָֽיִם</tei:l>
          <tei:l>וְלֹ֣א אָֽמְר֔וּ אַיֵּ֣ה יְהֹוָ֔ה הַמַּעֲלֶ֥ה אֹתָ֖נוּ מֵאֶ֣רֶץ מִצְרָ֑יִם׃ <tei:bibl>(ירמיה ב:ו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nishmat_yeladim_yaaqov/4"/>
        <tei:lg>
          <tei:l>נִשְׁמַת חֲרֵדִים <tei:seg type="acrostic">בְּ</tei:seg>עׇנְיָם חֲשׁוּכִים בִּמְקוֹם שִׁבְיָם</tei:l>
          <tei:l>תְּגַדְּלָךְ הֵרִֽימוּ קוֹל בִּתְחִנּוֹת בְּקוֹל יַמִּים וְדׇכְיָם</tei:l>
          <tei:l>אוֹמְרִים וְאִֽלּוּ פִּֽינוּ מָלֵא שִׁירָה כַּיָּם׃</tei:l>
        </tei:lg>
      </tei:div>
