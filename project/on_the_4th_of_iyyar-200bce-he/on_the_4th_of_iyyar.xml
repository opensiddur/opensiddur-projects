      <tei:div corresp="urn:x-opensiddur:text:prayer:on_the_4th_of_iyyar">
        <tei:head>בְּאַרְבָּעָה בְּחֹדֶשׁ אִיָּר</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_4th_of_iyyar/1"/>
        <tei:lg>
          <tei:l>בְּאַרְבָּעָה בְּחֹדֶשׁ אִיָּר</tei:l>
          <tei:l>רָאִיתִי בָּרוּחַ בְּמַרְאֶה הַקֹּדֶשׁ וְכׇל־נְבוּאָיו</tei:l>
          <tei:l>וְהִתְפַּלַּ֗לְתִּי לִפְנֵ֥י יְ֝הֹוָ֗ה וְאָמַֽרְתִּי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_4th_of_iyyar/2"/>
        <tei:lg>
          <tei:l>בָּ֭רוּךְ כִּי־שָׁבַ֣ר רְשָׁעִ֑ים</tei:l>
          <tei:l>וְ֝הֶעֱמִ֗יד קֶ֥רֶן צַדִּיקִֽים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_4th_of_iyyar/3"/>
        <tei:lg>
          <tei:l>וְדַעֲת֣וֹ וְ֭חׇכְמָתוֹ בְּכׇל־לִבִּ֑י</tei:l>
          <tei:l>כִּ֤י אַתָּ֣ה ה֖וּא שׁוֹפֵ֣ט הַצֶּֽדֶק׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_4th_of_iyyar/4"/>
        <tei:lg>
          <tei:l>וְלֹא־יֵצֵ֣א מִ֭לְּפָנֶֽיךָ מִֽשְׁפַּט־שָׁ֑קֶר</tei:l>
          <tei:l>כִּי־אִ֣ם אֱמֶ֣ת וֶאֱמוּנָֽה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_4th_of_iyyar/5"/>
        <tei:lg>
          <tei:l>תִּתֵּ֣ן לָ֭אָדָם כִּדְרָכָ֑יו</tei:l>
          <tei:l>וְכִפְרִ֥י מַ֝עֲלָלָ֗יו תָּשִׁ֥יב לֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_4th_of_iyyar/6"/>
        <tei:lg>
          <tei:l>אֵ֣ין כַּחַ֣שׁ בְּכׇל־מַעֲשֶׂ֑יךָ</tei:l>
          <tei:l>וְאֵ֣ין כָּ֝זָ֗ב בְּכׇל־דְּבָרֶֽךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_4th_of_iyyar/7"/>
        <tei:lg>
          <tei:l>כׇּל־פׇּ֭עָלְךָ תָּמִ֣ים יַ֑חַד</tei:l>
          <tei:l>וְעָ֖וֶל בַּל־יִמָּצֵ֥א בְּמַעֲשֶֽׂךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_4th_of_iyyar/8"/>
        <tei:lg>
          <tei:l>כְּנָהָ֣ר שׁ֭וֹטֵף הִרְבֵּ֥יתָה מִשְׁפָּטֶ֑ךָ</tei:l>
          <tei:l>וּכְזֶ֥רַע מְ֝בֹרָ֗ךְ הִצְמַ֥חְתָּה צִדְקָתֶֽךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_4th_of_iyyar/9"/>
        <tei:lg>
          <tei:l>אַשְׁרֵ֣י יִ֭זְכֶּה בִּקְדֻשָּׁתֶ֑ךָ</tei:l>
          <tei:l>יְסַפֵּ֥ר כְּ֝בוֹדְךָ֗ בְּכׇל־יֽוֹם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_4th_of_iyyar/10"/>
        <tei:lg>
          <tei:l>עֶ֭זְרָתִי מִלִּפְנֵ֣י כְּבוֹדֶ֑ךָ</tei:l>
          <tei:l>לְאוּכַ֥ל לָ֝נֶצַ֗ח לַעֲמֹ֥ד בִּרְצוֹנֶֽךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_4th_of_iyyar/11"/>
        <tei:lg>
          <tei:l>כִּ֣י תְּמ֣וֹל וְהַיּ֑וֹם</tei:l>
          <tei:l>אַשְׁרֵ֖י שׁוֹמְרֵ֣י פִּקּוּדֶֽיךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_4th_of_iyyar/12"/>
        <tei:lg>
          <tei:l>[...]</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
