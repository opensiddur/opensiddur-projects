  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hanaavah_babanot_neeman">
        <tei:head>Hana'avah Babanōt, a song by Amitai Ne'eman (1955)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hanaavah_babanot_neeman/1"/>
        <tei:lg>
          <tei:l>Fairest among maidens,</tei:l>
          <tei:l>oh pray! let thine eyes shine upon me</tei:l>
          <tei:l>let thine eyes shine upon me</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hanaavah_babanot_neeman/2"/>
        <tei:lg>
          <tei:l>Come, my beloved, for thou art handsome</tei:l>
          <tei:l>And infinitely gentle.</tei:l>
          <tei:l>Stretch out thine arms to embrace me</tei:l>
          <tei:l>And hug me again and again.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
