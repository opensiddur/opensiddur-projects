  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:elohai_netsor_giorgio_rubin">
        <tei:head>אֱלֹהַי נְצוֹר</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohai_netsor_giorgio_rubin/2"/>
        <tei:lg>
          <tei:l>אֱלֹהַי, נְצוֹר לְשׁוֹנִי מֵרָע</tei:l>
          <tei:l>וּשְׂפָתַי מִדַּבֵּר מִרְמָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohai_netsor_giorgio_rubin/3"/>
        <tei:lg>
          <tei:l>וְלִמְקַלְלַי נַפְשִׁי תִדֹּם</tei:l>
          <tei:l>וְנַפְשִׁי כֶּעָפָר לַכֹּל תִּהְיֶה.</tei:l>
          <tei:l>פְּתַח לִבִּי בְּתוֹרָתֶךָ וּבְמִצְוֺתֶיךָ תִּרְדֹּף נַפְשִׁי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohai_netsor_giorgio_rubin/5"/>
        <tei:lg>
          <tei:l>יִהְיוּ לְרָצוֹן אִמְרֵי פִי</tei:l>
          <tei:l>וְהֶגְיוֹן לִבִּי לְפָנֶיךָ</tei:l>
          <tei:l>יְיָ צוּרִי וְגוֹאֲלִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:elohai_netsor_giorgio_rubin/6"/>
        <tei:lg>
          <tei:l>עֹשֶׂה שָׁלוֹם בִּמְרוֹמָיו</tei:l>
          <tei:l>הוּא יַעֲשֶׂה שָׁלוֹם עָלֵינוּ</tei:l>
          <tei:l>וְעַל כָּל־יִשְׂרָאֵל,</tei:l>
          <tei:l>אָמֵן.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
