  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_lawsuit_with_god_levi">
        <tei:head>‎אַ דִין־תּוֹרָה מיט גאָט</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_lawsuit_with_god_levi/1"/>
        <tei:lg>
          <tei:l>צַפְרָא טָבָא לְךָ רִבּוֹנוֹ שֶׁל עוֹלָם</tei:l>
          <tei:l>אֲנִי, לֵוִי־יִצְחָק בֶּן־שָׂרָה מִבֶּרְדִיצֶ׳ב,</tei:l>
          <tei:l>בָּאתִי אֵלֶיךָ בַּדִּין תּוֹרָה מִצַּד עַמְּךָ יִשְׂרָאֵל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_lawsuit_with_god_levi/2"/>
        <tei:lg>
          <tei:l>מָה לְךָ אֵצֶל עַמְּךָ יִשְׂרָאֵל?</tei:l>
          <tei:l>לָמָּה הִטַּלְתָּ עַצְמְךָ עַל עַמְּךָ יִשְׂרָאֵל</tei:l>
          <tei:l>בְּכָל עִנְיָן שֶׁהוּא ”צַו אֶת בְּנֵי־יִשְׂרָאֵל“</tei:l>
          <tei:l>(בְּכָל עִנְיָן שֶׁהוּא ”אֱמֹר אֶל־בְּנֵי־יִשְׂרָאֵל“)<tei:anchor xml:id="note_1"/></tei:l>
          <tei:l>בְּכָל עִנְיָן שֶׁהוּא ”דַּבֵּר אֶל בְּנֵי־יִשְׂרָאֵל“</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_lawsuit_with_god_levi/3"/>
        <tei:lg>
          <tei:l>אָב הָרַחֲמָן,</tei:l>
          <tei:l>כַּמָּה אֻמּוֹת יֵשׁ בָּעוֹלָם</tei:l>
          <tei:l>בַּבְלִיִּים, פָּרְסִיִּים, אֲדֹמִיִּים</tei:l>
          <tei:l>הָרוּסִים מָה הֵם אוֹמְרִים?</tei:l>
          <tei:l>הַקֵּיסָר שֶׁלָּהֶם הוּא קֵיסָר</tei:l>
          <tei:l>הַגֶּרְמָנִים מָה הֵם אוֹמְרִים?</tei:l>
          <tei:l>הַקֵּיסָר שֶׁלָּהֶם הוּא קֵיסָר</tei:l>
          <tei:l>וְהָאַנְגְּלִים מָה הֵם אוֹמְרִים?</tei:l>
          <tei:l>הַמַּלְכוּת שֶׁלָּהֶם הוּא קֵיסָר</tei:l>
          <tei:l>וַאֲנִי, לֵוִי־יִצְחָק בֶּן־שָׂרָה מִבֶּרְדִיצֶ׳ב אוֹמֵר:</tei:l>
          <tei:l>”יִתְגַּדַּל וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא!“</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_lawsuit_with_god_levi/4"/>
        <tei:lg>
          <tei:l>וַאֲנִי, לֵוִי־יִצְחָק בֶּן־שָׂרָה מִבֶּרְדִיצֶ׳ב אוֹמֵר:</tei:l>
          <tei:l>”לֹא אָזוּז מִמְּקוֹמִי!</tei:l>
          <tei:l>מִמְּקוֹמִי לֹא אָזוּז</tei:l>
          <tei:l>עַד שֶׁיִּהְיֶה הַקֵּץ</tei:l>
          <tei:l>עַד שֶׁיִּהְיֶה סוֹף לְגָלוּת</tei:l>
          <tei:l>יִתְגַּדַּל וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא!“</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
