      <tei:div corresp="urn:x-opensiddur:text:prayer:supplement_to_the_selichot_following_aseh_lemaan_shemekha_levine">
        <tei:head>תוספת לסליחות לזיכרון המוסרים נפשם בחרבות ברזל</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:supplement_to_the_selichot_following_aseh_lemaan_shemekha_levine/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">זיכרון המוסרים נפשם בחרבות ברזל –</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">קטע תוספת לסליחות אלול והימים הנוראים</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">בסוף ”עֲשֵׂה לְמַעַן שְׁמֶךָ“</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:supplement_to_the_selichot_following_aseh_lemaan_shemekha_levine/2"/>
        <tei:lg>
          <tei:l>עֲשֵׂה לְמַעַן חַיָּלֵי וְחַיָּלוֹת צַהַ״ל,</tei:l>
          <tei:l>אַנְשֵׁי וּנְשֵׁי כּוֹחוֹת הַבִּטָּחוֹן,</tei:l>
          <tei:l>הַשּׁוֹטְרִים וְהַשּׁוֹטְרוֹת,</tei:l>
          <tei:l>הַחֲטוּפִים וָהַחֲטוּפוֹת,</tei:l>
          <tei:l>תּוֹשָׁבֵי וְתוֹשָׁבוֹת מְדִינַת יִשְׂרָאֵל,</tei:l>
          <tei:l>וְנִפְגְּעֵי וְנִפְגְּעוֹת פְּעֻלּוֹת הָאֵיבָה,</tei:l>
          <tei:l>אֲשֶׁר מָסְרוּ אֶת נַפְשָׁם</tei:l>
          <tei:l>עַל יִחוּד קְדֻשַּׁת שְׁמֶךָ,</tei:l>
          <tei:l>וְעַל קְדֻשַּׁת הָעָם</tei:l>
          <tei:l>וְהָאָרֶץ</tei:l>
          <tei:l>בְּמִלְחֶמֶת חַרְבוֹת בַּרְזֶל,</tei:l>
          <tei:l>וְחוּסָה עַל יִשְֹרָאֵל עַמֶּךָ.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
