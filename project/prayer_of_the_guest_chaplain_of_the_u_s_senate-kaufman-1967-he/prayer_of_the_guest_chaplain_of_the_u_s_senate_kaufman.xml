  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_of_the_guest_chaplain_of_the_u_s_senate_kaufman">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_of_the_guest_chaplain_of_the_u_s_senate_kaufman/5"/>
        <tei:lg>
          <tei:l>מַה־נָּאווּ עַל־הֶהָרִים</tei:l>
          <tei:l>רַגְלֵי מְבַשֵּׂר</tei:l>
          <tei:l>מַשְׁמִיעַ שָׁלוֹם <tei:bibl>(ישעיה נב:ז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_of_the_guest_chaplain_of_the_u_s_senate_kaufman/6"/>
        <tei:lg>
          <tei:l>הֱוֵי מִתַּלְמִידָיו שֶׁל אַהֲרֹן</tei:l>
          <tei:l>אוֹהֵב שָׁלוֹם...</tei:l>
          <tei:l>אוֹהֵב אֶת הַבְּרִיּוֹת</tei:l>
          <tei:l>וּמְקָרְבָן לַתּוֹרָה <tei:bibl>(משנה אבות א:יב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_of_the_guest_chaplain_of_the_u_s_senate_kaufman/7"/>
        <tei:lg>
          <tei:l>אָמֵן</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
