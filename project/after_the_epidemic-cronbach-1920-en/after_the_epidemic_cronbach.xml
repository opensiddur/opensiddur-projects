  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:after_the_epidemic_cronbach">
        <tei:head>[Prayer] After the Epidemic, by Rabbi Abraham Cronbach (ca. 1920)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:after_the_epidemic_cronbach/1"/>
        <tei:lg>
          <tei:l>We thank Thee, O <j:divineName>Father</j:divineName>,</tei:l>
          <tei:l>that Thou hast preserved us</tei:l>
          <tei:l>through the days of trial and danger.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:after_the_epidemic_cronbach/2"/>
        <tei:lg>
          <tei:l>Hold fast our hearts, dear <j:divineName>Lord</j:divineName>,</tei:l>
          <tei:l>that health</tei:l>
          <tei:l>and peace</tei:l>
          <tei:l>and victory may,</tei:l>
          <tei:l>no less than sickness,</tei:l>
          <tei:l>war</tei:l>
          <tei:l>and defeat,</tei:l>
          <tei:l>bind us with bonds of love</tei:l>
          <tei:l>unto Thee.</tei:l>
          <tei:l><tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
