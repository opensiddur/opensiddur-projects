  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:einn_kidlingr_an_old_norse_translation_of_had_gadya">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:einn_kidlingr_an_old_norse_translation_of_had_gadya/1"/>
        <tei:lg>
          <tei:l>Einn kiðlingr, einn kiðlingr,</tei:l>
          <tei:l>er keyptisk af mínn faðir</tei:l>
          <tei:l>fyrir tvá penningar,</tei:l>
          <tei:l>einn kiðlingr, einn kiðlingr.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:einn_kidlingr_an_old_norse_translation_of_had_gadya/2"/>
        <tei:lg>
          <tei:l>Þá kom kǫttrinn,</tei:l>
          <tei:l>ok át kiðlinginn,</tei:l>
          <tei:l>er keyptisk af mínn faðir</tei:l>
          <tei:l>fyrir tvá penningar,</tei:l>
          <tei:l>einn kiðlingr, einn kiðlingr.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:einn_kidlingr_an_old_norse_translation_of_had_gadya/3"/>
        <tei:lg>
          <tei:l>Þá kom hundrinn,</tei:l>
          <tei:l>ok beit kǫttinn,</tei:l>
          <tei:l>er át kiðlinginn,</tei:l>
          <tei:l>er keyptisk af mínn faðir</tei:l>
          <tei:l>fyrir tvá penningar,</tei:l>
          <tei:l>einn kiðlingr, einn kiðlingr.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:einn_kidlingr_an_old_norse_translation_of_had_gadya/4"/>
        <tei:lg>
          <tei:l>Þá kom kepprinn,</tei:l>
          <tei:l>ok sló hundinn,</tei:l>
          <tei:l>er beit kǫttinn,</tei:l>
          <tei:l>er át kiðlinginn,</tei:l>
          <tei:l>er keyptisk af mínn faðir</tei:l>
          <tei:l>fyrir tvá penningar,</tei:l>
          <tei:l>einn kiðlingr, einn kiðlingr.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:einn_kidlingr_an_old_norse_translation_of_had_gadya/5"/>
        <tei:lg>
          <tei:l>Þá kom eldrinn,</tei:l>
          <tei:l>ok brendi keppinn,</tei:l>
          <tei:l>er sló hundinn,</tei:l>
          <tei:l>er beit kǫttinn,</tei:l>
          <tei:l>er át kiðlinginn,</tei:l>
          <tei:l>er keyptisk af mínn faðir</tei:l>
          <tei:l>fyrir tvá penningar,</tei:l>
          <tei:l>einn kiðlingr, einn kiðlingr.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:einn_kidlingr_an_old_norse_translation_of_had_gadya/6"/>
        <tei:lg>
          <tei:l>Þá kom vatnit,</tei:l>
          <tei:l>ok sløkkði eldinn,</tei:l>
          <tei:l>er brendi keppinn,</tei:l>
          <tei:l>er sló hundinn,</tei:l>
          <tei:l>er beit kǫttinn,</tei:l>
          <tei:l>er át kiðlinginn,</tei:l>
          <tei:l>er keyptisk af mínn faðir</tei:l>
          <tei:l>fyrir tvá penningar,</tei:l>
          <tei:l>einn kiðlingr, einn kiðlingr.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:einn_kidlingr_an_old_norse_translation_of_had_gadya/7"/>
        <tei:lg>
          <tei:l>Þá kom uxinn,</tei:l>
          <tei:l>ok drakk vatnit,</tei:l>
          <tei:l>er sløkkði eldinn,</tei:l>
          <tei:l>er brendi keppinn,</tei:l>
          <tei:l>er sló hundinn,</tei:l>
          <tei:l>er beit kǫttinn,</tei:l>
          <tei:l>er át kiðlinginn,</tei:l>
          <tei:l>er keyptisk af mínn faðir</tei:l>
          <tei:l>fyrir tvá penningar,</tei:l>
          <tei:l>einn kiðlingr, einn kiðlingr.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:einn_kidlingr_an_old_norse_translation_of_had_gadya/8"/>
        <tei:lg>
          <tei:l>Þá kom slátrinn,</tei:l>
          <tei:l>ok slátraði uxanum,</tei:l>
          <tei:l>er drakk vatnit,</tei:l>
          <tei:l>er sløkkði eldinn,</tei:l>
          <tei:l>er brendi keppinn,</tei:l>
          <tei:l>er sló hundinn,</tei:l>
          <tei:l>er beit kǫttinn,</tei:l>
          <tei:l>er át kiðlinginn,</tei:l>
          <tei:l>er keyptisk af mínn faðir</tei:l>
          <tei:l>fyrir tvá penningar,</tei:l>
          <tei:l>einn kiðlingr, einn kiðlingr.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:einn_kidlingr_an_old_norse_translation_of_had_gadya/9"/>
        <tei:lg>
          <tei:l>Þá kom engill dauðans,</tei:l>
          <tei:l>ok slátraði slátranum,</tei:l>
          <tei:l>er slátraði uxanum,</tei:l>
          <tei:l>er drakk vatnit,</tei:l>
          <tei:l>er sløkkði eldinn,</tei:l>
          <tei:l>er brendi keppinn,</tei:l>
          <tei:l>er sló hundinn,</tei:l>
          <tei:l>er beit kǫttinn,</tei:l>
          <tei:l>er át kiðlinginn,</tei:l>
          <tei:l>er keyptisk af mínn faðir</tei:l>
          <tei:l>fyrir tvá penningar,</tei:l>
          <tei:l>einn kiðlingr, einn kiðlingr.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:einn_kidlingr_an_old_norse_translation_of_had_gadya/10"/>
        <tei:lg>
          <tei:l>Þá kom hinn heilagr blezadr Guð</tei:l>
          <tei:l>ok slátraði engli dauðans,</tei:l>
          <tei:l>er slátraði slátranum,</tei:l>
          <tei:l>er slátraði uxanum,</tei:l>
          <tei:l>er drakk vatnit,</tei:l>
          <tei:l>er sløkkði eldinn,</tei:l>
          <tei:l>er brendi keppinn,</tei:l>
          <tei:l>er sló hundinn,</tei:l>
          <tei:l>er beit kǫttinn,</tei:l>
          <tei:l>er át kiðlinginn,</tei:l>
          <tei:l>er keyptisk af mínn faðir</tei:l>
          <tei:l>fyrir tvá penningar,</tei:l>
          <tei:l>einn kiðlingr, einn kiðlingr.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
