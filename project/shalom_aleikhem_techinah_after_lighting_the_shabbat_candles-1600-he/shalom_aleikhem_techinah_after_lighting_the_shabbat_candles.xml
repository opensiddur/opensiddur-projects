    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:shalom_aleikhem_techinah_after_lighting_the_shabbat_candles">
        <tei:head>תְּחִנַּת שָׁלוֹם עֲלֵיכֶם</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:shalom_aleikhem_techinah_after_lighting_the_shabbat_candles/1"/>
        <tei:lg xml:lang="yi">
          <tei:l>
            <tei:note type="instruction">דיא ברכה זאלין דיא װײבר זאגין נאך דיא ליכט צינדן אן פרײטג צו נכט׃</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:shalom_aleikhem_techinah_after_lighting_the_shabbat_candles/2"/>
        <tei:lg>
          <tei:l>שָׁלוֹם עֲלֵיכֶם מַלְאֲכֵי הַשָׁלוֹם</tei:l>
          <tei:l>בְּבֹאֲכֶם בְּשָׁלוֹם</tei:l>
          <tei:l>כַּאֲשֶׁר צִוָה אֶתְכֶם אֲדוֹנֵינוּ</tei:l>
          <tei:l>הַמֶלֶךְ הַכָּבוֹד וְהַקָדוֹשׁ</tei:l>
          <tei:l>אֲדוֹן הַשָׁלוֹם</tei:l>
          <tei:l>רִבּוֹן כׇּל הָעוֹלָמִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:shalom_aleikhem_techinah_after_lighting_the_shabbat_candles/3"/>
        <tei:lg>
          <tei:l>אֲדוֹן כׇּל הַבְרִיוֹת</tei:l>
          <tei:l>וַאֲדוֹן עַל כׇּל אֲשֶׁר עָשִׂיתָ</tei:l>
          <tei:l>וַאֲשֶׁר אַתָּה עָתִיד לַעֲשׂוֹת</tei:l>
          <tei:l>עֲשֵׂה עִמִי חֶסֶד</tei:l>
          <tei:l>וְעִם בִּרְיוֹתֶךָ</tei:l>
          <tei:l>וּבְּרוּכִים הַמַלְאָכִים שֶׁעוֹשִׂים רְצוֹנֶךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:shalom_aleikhem_techinah_after_lighting_the_shabbat_candles/4"/>
        <tei:lg>
          <tei:l>אֲדוֹן הַשָׁלוֹם</tei:l>
          <tei:l>תְּבָרְכֵנִי בְשָׁלוֹם</tei:l>
          <tei:l>וְתִפְקְדֵנִי בְּשָׁלוֹם לְחַיִים טוֹבִים וּלְשָלוֹם</tei:l>
          <tei:l>וְתִזְכֵנִי לְמִצְוֺתֶיךָ</tei:l>
          <tei:l>וְתֵן לִי חֵן וְשֵׂכֶל טוֹב בְּעֵנֶיךָ</tei:l>
          <tei:l>וּבְעֵנֵי כׇּל רוֹאַי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:shalom_aleikhem_techinah_after_lighting_the_shabbat_candles/5"/>
        <tei:lg>
          <tei:l>וְתַעֲבוֹר וְהִמְחוֹל לִי</tei:l>
          <tei:l>עַל כׇּל חַטוֹאתַי וְעֲוֺנוֹתַי וּפְשָׁעַי</tei:l>
          <tei:l>וְתִזְכֵּנִי לְקַבֵּל שַׁבָּתוֹת וְיָמִים טוֹבִים</tei:l>
          <tei:l>מִתּוֹךְ רוֹב עוֹשֶׁר וְכָּבוֹד</tei:l>
          <tei:l>וּמִתּוֹךְ מִיעוּט עֲוֺנוֹת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:shalom_aleikhem_techinah_after_lighting_the_shabbat_candles/6"/>
        <tei:lg>
          <tei:l>וְהָסֵר מִמֶנִי</tei:l>
          <tei:l>וּמִזַרְעִי</tei:l>
          <tei:l>וּמִזֶרַע זַרְעִי</tei:l>
          <tei:l>מֵעַתָּה וְעַד עוֹלָם</tei:l>
          <tei:l>כׇל חוֹלִי</tei:l>
          <tei:l>וְכׇל דַלוֹת וְעֶנִיוֹת וְאֶבְיוֹנוֹת</tei:l>
          <tei:l>וְלֹא תְּהֵא צָרָה</tei:l>
          <tei:l>בְּיוֹם מְנוּחָתֵנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:shalom_aleikhem_techinah_after_lighting_the_shabbat_candles/7"/>
        <tei:lg>
          <tei:l>וְתֵן בִּי יֵצֶר טוֹב</tei:l>
          <tei:l>בְּאַהֲבָה וּבְּיִרְאָה</tei:l>
          <tei:l>וְאֶהֱיֶה מְכוּבַּד בְּעֵינֶיךָ</tei:l>
          <tei:l>וּבְעֵינֵי כׇל רוֹאַי</tei:l>
          <tei:l>כִּי אַתָּה הַמֶלֶךְ</tei:l>
          <tei:l>אָמֵן סֶלָה׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
