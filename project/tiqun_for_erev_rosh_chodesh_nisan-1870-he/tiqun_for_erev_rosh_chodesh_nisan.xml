    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:tiqun_for_erev_rosh_chodesh_nisan">
        <tei:head>תיקון לערב ראש חודש ניסן</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_erev_rosh_chodesh_nisan/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">קבלו וקיימו אנשי מעשה להתענות</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">יום שלפני ראש חודש ניסן</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">וביום צום תעניתם יאמרו נוסח זה:</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_erev_rosh_chodesh_nisan/2"/>
        <tei:lg>
          <tei:l>אַתָּה הוּא יְהֹוָה הָאֱלֹהִים</tei:l>
          <tei:l>הַפּוֹתֵֽחַ וּמַשְׁפִּיעַ טַלְלֵי רָצוֹן</tei:l>
          <tei:l>בְּרָכָה וּנְדָבָה בְּעוֹלָמוֹת הָעֶלְיוֹנִים</tei:l>
          <tei:l>וּמֵהֶם לָעוֹלָמוֹת שֶׁל־מַֽטָּה</tei:l>
          <tei:l>וּבַיּוֹם הַחֹֽדֶשׁ הַזֶּה נִיסָן רֹאשׁ חֳדָשִׁים</tei:l>
          <tei:l>הַבָּא עָלֵֽינוּ בְּרַחֲמִים</tei:l>
          <tei:l>יִפָּתְחוּ לָזוּן וּלְפַרְנֵס</tei:l>
          <tei:l>מִקַּרְנֵי רְאֵמִים וְעַד־בֵּיצֵי כִּנִּים</tei:l>
          <tei:l>וּמָה רַב־טוּבְךָ</tei:l>
          <tei:l>אֲשֶׁר עָשִֽׂיתָ עִם־כׇּל־בְּרוּאֶֽיךָ</tei:l>
          <tei:l>וְעִמָּֽנוּ</tei:l>
          <tei:l>בָּרָעָב זַנְתָּֽנוּ</tei:l>
          <tei:l>וּבַשָּׂבָע כִּלְכַּלְתָּֽנוּ</tei:l>
          <tei:l>וְאָכַֽלְנוּ וְשָׂבַֽעְנוּ</tei:l>
          <tei:l>וְהוֹתַֽרְנוּ בְּיָדְךָ הַטּוֹבָה עָלֵֽינוּ</tei:l>
          <tei:l>לֹא־חָסַֽרְנוּ דָּבָר</tei:l>
          <tei:l>וְלֹא בְרֹֽעַ מַעֲלָלֵֽינוּ גְּמַלְתָּֽנוּ</tei:l>
          <tei:l>כִּי יָדַֽעְנוּ כִּי אֵין־בָּֽנוּ לֹא־תּוֹרָה וְלֹא־מַעֲשִׂים טוֹבִים</tei:l>
          <tei:l>וְלֹא־יֵשׁ בְּכׇל־יְמֵי חַיֵּֽינוּ</tei:l>
          <tei:l>אֲפִֽילּוּ רֶֽגַע שֶׁעָשִֽׂינוּ בוֹ רְצוֹנֶֽךָ כְּטוּב לְבָבֵֽנוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_erev_rosh_chodesh_nisan/3"/>
        <tei:lg>
          <tei:l>רַק כִּלִּֽינוּ שָׁנֵֽינוּ</tei:l>
          <tei:l>בְהַבְלֵי הָעוֹלָם</tei:l>
          <tei:l>לְהַשְׂבִּֽיעַ יִצְרֵֽנוּ אַכְזָרִי</tei:l>
          <tei:l>וּלְהַשְׁפִּיל וּלְהַכְנִֽיעַ</tei:l>
          <tei:l>וּלְטַמֵּא וּלְתַעֵב</tei:l>
          <tei:l>בְּכׇל־מִינֵי טֻמְאוֹת וְתוֹעֵבוֹת</tei:l>
          <tei:l>לְנַפְשֵֽׁנוּ הַיְּקָרָה וְהַמְּהֻדֶּֽרֶת</tei:l>
          <tei:l>אֲשֶׁר הִיא חֵֽלֶק מִמָּךְ</tei:l>
          <tei:l>וּפָגַֽמְנוּ בִּשְׁמוֹתֶֽיךָ הַקְּדוֹשִׁים</tei:l>
          <tei:l>וְהִגְבַּֽרְנוּ הַדִּינִים הַקָּשִׁים עַל־הָרַחֲמִים</tei:l>
          <tei:l>וְאַף־גַּם־זֹאת</tei:l>
          <tei:l>כִּי בֹֽשְׁנוּ וְנִכְלַֽמְנוּ</tei:l>
          <tei:l>לְהָרִים פָּנֵֽינוּ אֵלֶֽיךָ</tei:l>
          <tei:l>כִּי בְטוֹבָה אֲשֶׁר הִשְׁפַּֽעְתָּ עָלֵֽינוּ</tei:l>
          <tei:l>בָּעַֽטְנוּ בָּךְ</tei:l>
          <tei:l>וְעָשִֽׂינוּ נֶאָצוֹת גְּדוֹלוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_erev_rosh_chodesh_nisan/4"/>
        <tei:lg>
          <tei:l>וְלִי אֲנִי עַבְדֶּֽךָ הַמִּתְפַּלֵּל לְפָנֶֽיךָ</tei:l>
          <tei:l>הֵטַֽבְתָּ חַסְדֶּֽךָ עַל־כֹּל</tei:l>
          <tei:l>וְנָתַֽתָּ לִי כְּבִרְכָתֶֽךָ</tei:l>
          <tei:l>יוֹתֵר מִן־הָרָאוּי</tei:l>
          <tei:l>לִי קָטֹ֜נְתִּי מִכֹּ֤ל הַחֲסָדִים֙ וּמִכׇּל־הָ֣אֱמֶ֔ת</tei:l>
          <tei:l>אֲשֶׁ֥ר עָשִׂ֖יתָ אֶת־עַבְדֶּ֑ךָ</tei:l>
          <tei:l>בְּנִדְבַת לִבֶּֽךָ.</tei:l>
          <tei:l>וְיָרֵא אָנֹכִי מְאֹד לְנַפְשִׁי הָעֲלוּבָה</tei:l>
          <tei:l>שֶׁלֹּא אֶהְיֶה מִן־כַּת אוֹיְבֶֽיךָ וְשׂוֹנְאֶֽיךָ</tei:l>
          <tei:l>אֲשֶׁר נֶאֱמַר בָּהֶם</tei:l>
          <tei:l>וּמְשַׁלֵּ֧ם לְשֹׂנְאָ֛יו אֶל־פָּנָ֖יו</tei:l>
          <tei:l>לְהַאֲבִיד֑וֹ חַס וְשָׁלוֹם</tei:l>
          <tei:l>וּלְהַאֲכִילֵֽנִי בָּעוֹלָם הַזֶּה</tei:l>
          <tei:l>מִעוּט זָכִיּוֹת אֲשֶׁר בְּיָדִי.</tei:l>
          <tei:l>וְאִם־כָּֽכָה אַתָּה עֹֽשֶׂה לִי</tei:l>
          <tei:l>אָנָּא יְהֹוָה בַּֽעַל הָרַחֲמִים</tei:l>
          <tei:l>קַח־נָא בִּרְכָתִי</tei:l>
          <tei:l>וְאַל־אֶרְאֶה בְרָעָתִי בָּעוֹלָם הַבָּא</tei:l>
          <tei:l>אֶֽרֶץ הַחַיִּים עוֹלָם הַנִּצְחִי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_erev_rosh_chodesh_nisan/5"/>
        <tei:lg>
          <tei:l>וְאִם־מִדַּת טוּבְךָ</tei:l>
          <tei:l>הוּא לָתֵת וּלְהַשְׁפִּֽיעַ</tei:l>
          <tei:l>וְלֹא־לָשׁוּב לְקַחְתּוֹ</tei:l>
          <tei:l>הִנֵּה אָנֹכִי בָּא אֵלֶֽיךָ</tei:l>
          <tei:l>בְּיוֹם צוֹם הַתַּעֲנִית הַזֶּה</tei:l>
          <tei:l>בְּלֵב נִשְׁבָּר וְנִדְכֶּה</tei:l>
          <tei:l>לְבַקֵּשׁ רַחֲמִים וְתַחֲנוּנִים לְפָנֶֽיךָ</tei:l>
          <tei:l>עֲשֵׂה עִם־עַבְדְּךָ כְּחַסְדֶּֽךָ</tei:l>
          <tei:l>וְהָיָה הַטּוֹב הַהוּא אֲשֶׁר תֵּטִיב</tei:l>
          <tei:l>עִמִּי לַעֲשׂוֹת רְצוֹנְךָ בְּלֵבָב שָׁלֵם</tei:l>
          <tei:l>וְלַעֲשׂוֹת צְדָקָה וָחֶֽסֶד אֵלַי כׇּל־הַיּוֹם</tei:l>
          <tei:l>וְתָסִיר אֶת־לֵב הָאֶֽבֶן מִבְּשָׂרֵֽנוּ</tei:l>
          <tei:l>וְתִתֵּן־לָֽנוּ לֵב טָהוֹר</tei:l>
          <tei:l>שֶׁלֹּא־נְבַעֵט בָּךְ מֵרֹב טוֹבָה</tei:l>
          <tei:l>וְלֹא־נִשְׁתַּמֵּשׁ בְּמַתְּנוֹתֶֽיךָ</tei:l>
          <tei:l>לִדְבָרִים רָעִים וְתַעֲנוּגֵי הַגּוּף</tei:l>
          <tei:l>לְמַֽעַן לֹא־נֵבוֹשׁ בָּעוֹלָם הַזֶּה</tei:l>
          <tei:l>וְלֹא־נִכָּלֵם לְעוֹלָם הַבָּא.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_erev_rosh_chodesh_nisan/6"/>
        <tei:lg>
          <tei:l>וּבְכֵן יְהִי רָצוֹן מִלְּפָנֶֽיךָ</tei:l>
          <tei:l>יְהֹוָה אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ</tei:l>
          <tei:l>שֶׁתַּשְׁפִּֽיעַ טַל הָעֶלְיוֹן</tei:l>
          <tei:l>מִתְּרֵין מַזָּלִין נוֹצֵ״ר וְנַקֵּ״ה</tei:l>
          <tei:l>דֶּֽרֶךְ חֵיךְ וְגָרוֹן</tei:l>
          <tei:l>לְאַֽבָּא וְאִֽמָּא</tei:l>
          <tei:l>וּמִן־אַֽבָּא וְאִֽמָּא לִזְעֵיר אַנְפִּין</tei:l>
          <tei:l>וּמִזְּעֵיר אַנְפִּין לַחֲקַל תַּפּוּחִין</tei:l>
          <tei:l>קַדִּישִׁין וּמֵהֶם יִשְׁתַּלְשֵׁל וְיַגִּֽיעַ</tei:l>
          <tei:l>וְיֵרָאֶה הַשֶּֽׁפַע הַהוּא בְּכׇל־הָעוֹלָמוֹת</tei:l>
          <tei:l>וְרַוֵּה פְּנֵי תֵבֵל</tei:l>
          <tei:l>וְשַׁבַּע אֶת־הָעוֹלָם כֻּלּוֹ מִטּוּבָךְ</tei:l>
          <tei:l>וּמַלֵּא יָדֵֽינוּ מִבִּרְכוֹתֶֽיךָ</tei:l>
          <tei:l>וּמֵעֹֽשֶׁר מַתְּנוֹת יָדֶֽיךָ</tei:l>
          <tei:l>וּבִימִינְךָ תִּסְעָדֵֽנוּ</tei:l>
          <tei:l>הַטְרִיפֵֽנוּ לֶֽחֶם חֻקֵּֽינוּ</tei:l>
          <tei:l>לָֽנוּ וּלְכׇל־בְּנֵי בֵּיתֵֽנוּ</tei:l>
          <tei:l>וְלֹא־יְנֻכֶּה מִזָּכִיּוֹתֵֽינוּ מְאֽוּמָה</tei:l>
          <tei:l>וַנִּֽשְׂבַּֽע־לֶ֙חֶם֙ וַנִּהְיֶ֣ה טוֹבִ֔ים</tei:l>
          <tei:l>כִּי אַתָּה הָאֵל</tei:l>
          <tei:l>פּוֹתֵ֥חַ אֶת־יָדֶ֑ךָ</tei:l>
          <tei:l>וּמַשְׂבִּ֖יעַ לְכׇל־חַ֣י רָצֽוֹן׃ <tei:bibl>(תהלים קמה:טז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_erev_rosh_chodesh_nisan/7"/>
        <tei:lg>
          <tei:l>יִ֥הְיֽוּ־לְרָצ֨וֹן ׀ אִמְרֵי־פִ֡י</tei:l>
          <tei:l>וְהֶגְי֣וֹן לִבִּ֣י</tei:l>
          <tei:l>לְפָנֶ֑יךָ</tei:l>
          <tei:l>יְ֝הֹוָ֗ה צוּרִ֥י וְגֹאֲלִֽי׃ <tei:bibl>(תהלים יט:טו)</tei:bibl></tei:l>
          <tei:l>וִיהִ֤י ׀ נֹ֤עַם אֲדֹנָ֥י אֱלֹהֵ֗ינוּ עָ֫לֵ֥ינוּ</tei:l>
          <tei:l>וּמַעֲשֵׂ֣ה יָ֭דֵינוּ כּוֹנְﬞנָ֥ה עָלֵ֑ינוּ</tei:l>
          <tei:l>וּֽמַעֲשֵׂ֥ה יָ֝דֵ֗ינוּ כּוֹנְﬞנֵֽהוּ׃ <tei:bibl>(תהלים צ:יז)</tei:bibl></tei:l>
          <tei:l>אָמֵן כֵּן יְהִי רָצוֹן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tiqun_for_erev_rosh_chodesh_nisan/8"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">קריאות</tei:note>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בראשית כז:כח–כט</tei:l>
          <tei:l>דברים לג:יג–יז</tei:l>
          <tei:l>זכריה ח</tei:l>
          <tei:l>תהלים כג</tei:l>
          <tei:l>תהלים כד</tei:l>
          <tei:l>תהלים קלג</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
