    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer">
        <tei:head>אַהֲבָה תְּלַבְלֵב כְּמוֹ־פֶֽרַח</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/1"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְהֹוָה אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>יוֹצֵ֥ר אוֹר֙ וּבוֹרֵ֣א חֹ֔שֶׁךְ</tei:l>
          <tei:l>עֹשֶׂ֥ה שָׁל֖וֹם וּב֣וֹרֵא אֶת־הַכֹּל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/2"/>
        <tei:lg>
          <tei:l>אוֹר עוֹלָם</tei:l>
          <tei:l>אוֹצַר חַיִּים</tei:l>
          <tei:l>אוֹרוֹת מֵאֹֽפֶל</tei:l>
          <tei:l>אָמַר וַיֶֽהִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/3"/>
        <tei:lg>
          <tei:l>אַהֲבָה תְּלַבְלֵב כְּמוֹ־פֶֽרַח</tei:l>
          <tei:l>אֲנֻחַם בְּחֶצְיוֹ לַיֶּֽרַח</tei:l>
          <tei:l>לַמְנַצֵּ֣חַ עַל־שֹׁ֭שַׁנִּים לִבְנֵי־קֹ֑רַח <tei:bibl>(תהלים מה:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/4"/>
        <tei:lg>
          <tei:l>בִּשְׁנַת אַרְבָּעִים לַצְּעִידוֹת</tei:l>
          <tei:l>בֵּרְרוּ רְגִילֵי אֲבֵדוֹת</tei:l>
          <tei:l>מַ֝שְׂכִּ֗יל שִׁ֣יר יְדִידֹֽת׃ <tei:bibl>(תהלים מה:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/5"/>
        <tei:lg>
          <tei:l>יִׄשְׂרָאֵל שׁוֹכְבֵי קֶֽבֶר בִּיבָבָה</tei:l>
          <tei:l>צָׄרַפְתָּם וְכִפַּרְתָּם מֵחוֹבָה</tei:l>
          <tei:l>הֱבִיאַ֙נִי֙ אֶל־בֵּ֣ית הַיָּ֔יִן</tei:l>
          <tei:l>וְדִגְל֥וֹ עָלַ֖י אַהֲבָֽה׃ <tei:bibl>(שיר השירים ב:ד)</tei:bibl></tei:l>
          <tei:l>קָדוֹשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/6"/>
        <tei:lg>
          <tei:l>גְּדוֹלֵי חִשּׁוּבֵי זְמַן רָאוּ בְּטוֹב</tei:l>
          <tei:l>גָּמְרָה אֲבֵדָה מִן־הָעָם מְבַקֵּשׁ טוֹב</tei:l>
          <tei:l>רָ֘חַ֤שׁ לִבִּ֨י ׀ דָּ֘בָ֤ר ט֗וֹב <tei:bibl>(תהלים מה:ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/7"/>
        <tei:lg>
          <tei:l>דּוּמָה שַׂר־הַמָּֽוֶת אָמַר לֹא־אֵלֵךְ</tei:l>
          <tei:l>דַּרְכֵּֽנוּ אַֽרְצָה שְׁמַרְתָּֽנוּ בְּדֶֽרֶךְ הַמֶּֽלֶךְ</tei:l>
          <tei:l>אֹמֵ֣ר אָ֭נִי מַעֲשַׂ֣י לְמֶ֑לֶךְ <tei:bibl>(תהלים מה:ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/8"/>
        <tei:lg>
          <tei:l>הֲבֵאתָֽנוּ לְאֶֽרֶץ אוֹר בָּהִיר</tei:l>
          <tei:l>הִשְׁמַֽדְתָּ אֶת־כְּנַֽעַן הַיָּהִיר</tei:l>
          <tei:l>לְ֝שׁוֹנִ֗י עֵ֤ט ׀ סוֹפֵ֬ר מָהִֽיר׃ <tei:bibl>(תהלים מה:ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/9"/>
        <tei:lg>
          <tei:l>חֲׄמִשָּׁה עָשָׂר בְּאָב פְּדִיתַֽנִי</tei:l>
          <tei:l>קִׄבְרִי נִמְלַֽטְתִּי כִּי־עֲזַרְתַּֽנִי</tei:l>
          <tei:l>כִּי־חוֹלַ֥ת אַהֲבָ֖ה אָֽנִי׃ <tei:bibl>(שיר השירים ב:ה)</tei:bibl></tei:l>
          <tei:l>קָדוֹשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/10"/>
        <tei:lg>
          <tei:l>וַיִּקְרְבוּ בְּנֵי שֵֽׁבֶט חָמֵשׁ בְּנוֹת אָדָם</tei:l>
          <tei:l>וַהֲלֹא אִם־תִּתְחַתֵּֽנָּה לְזָר יֵאָבֵד כְּבוֹדָם</tei:l>
          <tei:l>יׇפְיָפִ֡יתָ מִבְּנֵ֬י אָדָ֗ם <tei:bibl>(תהלים מה:ג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/11"/>
        <tei:lg>
          <tei:l>זְכֹר־נָא אֶת־יְרֻשַּׁת מִשְׁפְּחוֹתֶֽיךָ</tei:l>
          <tei:l>זָכָר אֵין־לוֹ וּנְקֵבָה יֵשׁ וּמָה בְּנַחֲלָתֶֽךָ</tei:l>
          <tei:l>ה֣וּצַק חֵ֭ן בְּשִׂפְתוֹתֶ֑יךָ <tei:bibl>(תהלים מה:ג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/12"/>
        <tei:lg>
          <tei:l>חָשַׁב מֹשֶׁה וְשָׁמַע לְקוֹלָם</tei:l>
          <tei:l>חֲתָנִים יִתְחַתְּנוּ מִשִּׁבְטָם לִשְׁמִירַת גְּבוּלָם</tei:l>
          <tei:l>עַל־כֵּ֤ן בֵּרַכְךָ֖ אֱלֹהִ֣ים לְעוֹלָֽם׃ <tei:bibl>(תהלים מה:ג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/13"/>
        <tei:lg>
          <tei:l>הָׄלְכוּ וְעָבְרוּ שְׁנוֹת מָאתַֽיִם</tei:l>
          <tei:l>רְׄמִֽינְהוּ בְּעָיָה חֲדָשָׁה בֵּינְתַֽיִם</tei:l>
          <tei:l>תּוֹכוֹ֙ רָצ֣וּף אַהֲבָ֔ה מִבְּנ֖וֹת יְרוּשָׁלָֽ͏ִם׃ <tei:bibl>(שיר השירים ג:י)</tei:bibl></tei:l>
          <tei:l>קָדוֹשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/14"/>
        <tei:lg>
          <tei:l>טְמֵאָה הַגִּבְעָה הַקּוֹל יַעֲבֹר</tei:l>
          <tei:l>טִבְחוּ לָֽמוֹ תַּשְׁלִיכוּם לַבּוֹר</tei:l>
          <tei:l>חֲגֽוֹר־חַרְבְּךָ֣ עַל־יָרֵ֣ךְ גִּבּ֑וֹר <tei:bibl>(תהלים מה:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/15"/>
        <tei:lg>
          <tei:l>יִשְׂרָאֵל אָמַר אַחִי הָרַֽגְנוּ אֶת־כׇּל־בָּחוּרֶֽיךָ</tei:l>
          <tei:l>מִכַּֽעַס לְעֶֽצֶב הֲתַשְׁמִיד אֶת־אַחֶֽיךָ</tei:l>
          <tei:l>ה֝וֹדְךָ֗ וַהֲדָרֶֽךָ׃ <tei:bibl>(תהלים מה:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/16"/>
        <tei:lg>
          <tei:l>אַׄז אִסּוּרֵי חֲתֻנּוֹת בֵּין־שְׁבָטִים מְפִיגִים</tei:l>
          <tei:l>לַׄחֲמִשָּׁה עָשָׂר בְּאָב בְּכַלּוֹת כׇּל־שֵֽׁבֶט חֲתָנִים מִתְעַנְּגִים</tei:l>
          <tei:l>מַה־יָּפִית֙ וּמַה־נָּעַ֔מְתְּ אַהֲבָ֖ה בַּתַּֽעֲנוּגִֽים׃ <tei:bibl>(שיר השירים ז:ז)</tei:bibl></tei:l>
          <tei:l>קָדוֹשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/17"/>
        <tei:lg>
          <tei:l>כַּמָּה אִילָנוֹת נִצְרְכוּ בַּמִּקְדָּשׁ הָעֵץ הֻרְכַּב</tei:l>
          <tei:l>כְּמוֹ־נֵד בְּלִשְׁכָּתוֹ צִבּוּר הָעֵץ מִשְׁכָּב</tei:l>
          <tei:l>וַהֲדָ֬רְךָ֨ ׀ צְלַ֬ח רְכַ֗ב <tei:bibl>(תהלים מה:ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/18"/>
        <tei:lg>
          <tei:l>לֵהֶה כּֽוֹחַ־הַשֶּֽׁמֶשׁ אִם־הָעֵץ יְיֻבַּשׁ יְהִי סֶֽדֶק</tei:l>
          <tei:l>לְסַלֵּק תּוֹלָעוֹת קָשֶׁה בְּיוֹתֵר לִבְדֹּק בֶּֽדֶק</tei:l>
          <tei:l>עַֽל־דְּבַר־אֱ֭מֶת וְעַנְוָה־צֶ֑דֶק <tei:bibl>(תהלים מה:ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/19"/>
        <tei:lg>
          <tei:l>מַגָּל שָׁבְרוּ בְּיוֹם זֶה בְּבֵית מִקְדָּשֶֽׁךָ</tei:l>
          <tei:l>מִכָּאן קָֽרְאוּ־חַג הָעֵצִים לְקׇרְבְּנוֹת מוֹעֲדֶֽיךָ</tei:l>
          <tei:l>וְתוֹרְךָ֖ נוֹרָא֣וֹת יְמִינֶֽךָ׃ <tei:bibl>(תהלים מה:ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/20"/>
        <tei:lg>
          <tei:l>בַּׄחֲמִשָּׁה עָשָׂר בּוֹ בַּמִּקְדָּשׁ הָיָה יוֹם הֲנָאָה</tei:l>
          <tei:l>נַׄדְלִיק עוֹד אֵשׁ לַחְגֹּג וּלְבַעֵר כׇּל־שִׂנְאָה</tei:l>
          <tei:l>כִּֽי־עַזָּ֤ה כַמָּ֙וֶת֙ אַהֲבָ֔ה קָשָׁ֥ה כִשְׁא֖וֹל קִנְאָ֑ה <tei:bibl>(שיר השירים ח:ו)</tei:bibl></tei:l>
          <tei:l>קָדוֹשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/21"/>
        <tei:lg>
          <tei:l>נְבָט הוֹלִיד בֵּן אָרוּר הוּא מִבָּנִים</tei:l>
          <tei:l>נִקְרָא יָרׇבְעָם הִרְבָּה עֲבַרְיָנִים</tei:l>
          <tei:l>חִצֶּ֗יךָ שְׁנ֫וּנִ֥ים <tei:bibl>(תהלים מה:ו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/22"/>
        <tei:lg>
          <tei:l>סָר וְהֵסִיר אֶת יוֹ״ד שְׁבָטִים אֵָלּוּ</tei:l>
          <tei:l>סָגְדוּ לְעֶגְלֵי מַסֵּכָה אֲשֶׁר פִּסְּלוּ</tei:l>
          <tei:l>עַ֭מִּים תַּחְתֶּ֣יךָ יִפְּל֑וּ <tei:bibl>(תהלים מה:ו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/23"/>
        <tei:lg>
          <tei:l>עָמְדוּ פְּרוֹסְדָּיוֹת פֶּן צַדִּיק בָּעָם יֵלֵךְ</tei:l>
          <tei:l>עַד־כֹּה הֵם אָמְרוּ בְּשֵׁם יָרׇבְעָם הַמֶּֽלֶךְ</tei:l>
          <tei:l>בְּ֝לֵ֗ב אוֹיְבֵ֥י הַמֶּֽלֶךְ׃ <tei:bibl>(תהלים מה:ו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/24"/>
        <tei:lg>
          <tei:l>אַׄף עַל פִּי שֶׁמַּלְכוּת הַצָּפוֹן עָזְבָה</tei:l>
          <tei:l>בָּׄא הוֹשֵֽׁעַ בֶּן אֵלָה בְּסוֹף הַמְּרִיבָה</tei:l>
          <tei:l>מַ֣יִם רַבִּ֗ים לֹ֤א יֽוּכְלוּ֙ לְכַבּ֣וֹת אֶת־הָֽאַהֲבָ֔ה <tei:bibl>(שיר השירים ח:ז)</tei:bibl></tei:l>
          <tei:l>קָדוֹשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/25"/>
        <tei:lg>
          <tei:l>פְּרוֹסְדַּיּוֹת הִסּֽוֹגוּ הֵעִיד כְּמוֹ־עֵד</tei:l>
          <tei:l>פְּנוּ לַמָּקוֹם שֶׁתִּרְצוּ לַמּוֹעֵד</tei:l>
          <tei:l>כִּסְאֲךָ֣ אֱ֭לֹהִים עוֹלָ֣ם וָעֶ֑ד <tei:bibl>(תהלים מה:ז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/26"/>
        <tei:lg>
          <tei:l>צִדְקָתְךָ הוֹשֵֽׁעַ נֶֽגֶד חַטֹּאותֶֽיךָ</tei:l>
          <tei:l>צַוָּארְךָ בְּבַרְזֶל תִּוָּשַׁע אֻמָּתֶֽךָ</tei:l>
          <tei:l>שֵׁ֥בֶט מִ֝ישֹׁ֗ר שֵׁ֣בֶט מַלְכוּתֶֽךָ׃ <tei:bibl>(תהלים מה:ז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/27"/>
        <tei:lg>
          <tei:l>רְׄגָלִים עָלוּ בְּגִילָה רַבָּה</tei:l>
          <tei:l>הִׄנֵּה בַּת־עַמִּי לַמִּקְדָּשׁ שָֽׁבָה</tei:l>
          <tei:l>אִם־יִתֵּ֨ן אִ֜ישׁ אֶת־כׇּל־ה֤וֹן בֵּיתוֹ֙ בָּאַהֲבָ֔ה <tei:bibl>(שיר השירים ח:ז)</tei:bibl></tei:l>
          <tei:l>קָדוֹשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/28"/>
        <tei:lg>
          <tei:l>קַנָּאֵי בֵּיתָר נֶהֶרְגוּ בְּיַד רָשָׁע</tei:l>
          <tei:l>קְבוּרָה לֹא נִתְּנוּ אוֹי לְרוֹמִי זֶה פֶּֽשַׁע</tei:l>
          <tei:l>אָהַ֣בְתָּ צֶּדֶק֮ וַתִּשְׂנָ֫א־רֶ֥שַׁע <tei:bibl>(תהלים מה:ח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/29"/>
        <tei:lg>
          <tei:l>רְאֵה לֹא הִסְרִיחוּ עָשְׂתָה נֵס רוּחֲךָ</tei:l>
          <tei:l>רוֹמִי נָתַן־לָֽמוֹ קְבוּרַת מִבְטָחֲךָ</tei:l>
          <tei:l>עַל־כֵּ֤ן ׀ מְשָׁחֲךָ֡ <tei:bibl>(תהלים מה:ח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/30"/>
        <tei:lg>
          <tei:l>שִׁשָּׁה נִסִּים אֵֽלֶּה מִפִּי דְּבָרֶֽיךָ</tei:l>
          <tei:l>שִׁיר חָדָשׁ נָשִֽׁירָה בְּיוֹם זֶה מִזְמוֹרֶֽךָ</tei:l>
          <tei:l>אֱלֹהִ֣ים אֱ֭לֹהֶיךָ שֶׁ֥מֶן שָׂשׂ֗וֹן מֵחֲבֵרֶֽךָ׃ <tei:bibl>(תהלים מה:ח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/31"/>
        <tei:lg>
          <tei:l>מִׄיּוֹם זֶה צִיּוֹן תִּשְׂמְחִי בַּחֲתֻנּוֹתַֽיִךְ</tei:l>
          <tei:l>הַׄלְלִי בְּמוֹעֲדַֽיִךְ הוֹדִי לִקְבוּרוֹתַֽיִךְ</tei:l>
          <tei:l>זָכַ֤רְתִּי לָךְ֙ חֶ֣סֶד נְעוּרַ֔יִךְ אַהֲבַ֖ת כְּלוּלֹתָ֑יִךְ <tei:bibl>(ירמיהו ב:ב)</tei:bibl></tei:l>
          <tei:l>קָדוֹשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/32"/>
        <tei:lg>
          <tei:l>תְּנוּ רַבָּנָן בְּיוֹם זֶה רָקְדוּ בְּנוֹתֶֽיךָ</tei:l>
          <tei:l>תִּלְבֹּֽשֶׁת לְבָנָה לָבְשׁוּ בִּמְחוֹלוֹתֶֽיךָ</tei:l>
          <tei:l>מֹר־וַאֲהָל֣וֹת קְ֭צִיעוֹת כׇּל־בִּגְדֹתֶ֑יךָ <tei:bibl>(תהלים מה:ט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/33"/>
        <tei:lg>
          <tei:l>חוֹלוֹת בַּכְּרָמִים הִנֵּה־אִישׁ הִפְנֽוּךָ</tei:l>
          <tei:l>זְקֵנוֹת וּנְעָרוֹת רְאוֹתָן לְקָחֽוּךָ</tei:l>
          <tei:l>מִֽן־הֵ֥יכְלֵי שֵׁ֝֗ן מִנִּ֥י שִׂמְּחֽוּךָ׃ <tei:bibl>(תהלים מה:ט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/34"/>
        <tei:lg>
          <tei:l>כְּׄכַלָּה שֶׁחָתָן אוֹמֵר לָהּ שָׂמַחְתִּיךְ</tei:l>
          <tei:l>הַׄיּוֹם ט״וּ בְּאָב בַּת צִיּוֹן זָכַרְתִּיךְ</tei:l>
          <tei:l>נְׄוֵה חֵן בְּחִבָּתִי הֲלֹא חֲלִיתִיךָ</tei:l>
          <tei:l>מֵרָח֕וֹק יְהֹוָ֖ה נִרְאָ֣ה לִ֑י וְאַהֲבַ֤ת עוֹלָם֙ אֲהַבְתִּ֔יךְ <tei:bibl>(ירמיהו לא:ב)</tei:bibl></tei:l>
          <tei:l>קָדוֹשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahava_telavlev_kemo_perach_mayer/35"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">”הכל יודוך“ בשבת, ”המאיר לארץ“ בחול</tei:note>
          </tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
