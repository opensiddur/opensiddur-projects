    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:barukh_sheamar_68587">
        <tei:head>בָּרוּךְ שֶׁאָמַר</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:barukh_sheamar_68587/1"/>
        <tei:lg>
          <tei:l>בָּרוּךְ שֶׁאָמַר</tei:l>
          <tei:l>וְהָיָה הָעוֹלָם</tei:l>
          <tei:l>בָּרוּךְ הוּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:barukh_sheamar_68587/2"/>
        <tei:lg>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">א</tei:seg>וֹמֵר וְעוֹשֶׂה׃</tei:l>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">בּ</tei:seg>וֹרֵא בְּרֵאשִׁית׃</tei:l>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">גּ</tei:seg>וֹזֵר וּמְקַיֵּם׃</tei:l>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">דָּ</tei:seg>ן יְחִידִי לְכׇל־בָּאֵי הָעוֹלָם —</tei:l>
          <tei:l>בָּרוּךְ הוּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:barukh_sheamar_68587/3"/>
        <tei:lg>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">הַ</tei:seg>מְרַחֵם עַל־הָאָֽרֶץ׃</tei:l>
          <tei:l>בָּרוּךְ הַמְרַחֵם עַל־הַבְּרִיּוֹת</tei:l>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">וְ</tei:seg>ה֣וּא בְ֭אֶחָד וּמִ֣י יְשִׁיבֶ֑נּוּ <tei:bibl>(איוב כג:יג)</tei:bibl> —</tei:l>
          <tei:l>בָּרוּךְ הוּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:barukh_sheamar_68587/4"/>
        <tei:lg>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">זָ</tei:seg>ן וּמְפַרְנֵס לַכֹּל׃</tei:l>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">חַ</tei:seg>י לָעַד וְקַיָּם לָנֶֽצַח׃</tei:l>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">ט</tei:seg>וֹב וּמֵטִיב לַכֹּל׃</tei:l>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">יָ</tei:seg>חִיד בְּעוֹלָמוֹ —</tei:l>
          <tei:l>בָּרוּךְ הוּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:barukh_sheamar_68587/5"/>
        <tei:lg>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">כְּ</tei:seg>בוֹדוֹ מִמְּקוֹמוֹ׃</tei:l>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">לֹ</tei:seg>א־יִיעַ֖ף וְלֹ֣א יִיגָ֑ע</tei:l>
          <tei:l>אֵ֥ין חֵ֖קֶר לִתְבוּנָתֽוֹ <tei:bibl>(ישעיהו מא:ד)</tei:bibl> —</tei:l>
          <tei:l>בָּרוּךְ הוּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:barukh_sheamar_68587/6"/>
        <tei:lg>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">מַ</tei:seg>עֲבִיר אֲפֵלָה וּמֵבִיא אוֹרָה׃</tei:l>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">נֹ</tei:seg>תֵ֥ן לַיָּעֵ֖ף כֹּ֑חַ</tei:l>
          <tei:l>וּלְאֵ֥ין אוֹנִ֖ים עׇצְמָ֥ה יַרְבֶּֽה <tei:bibl>(ישעיה מ:כט)</tei:bibl> —</tei:l>
          <tei:l>בָּרוּךְ הוּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:barukh_sheamar_68587/7"/>
        <tei:lg>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">ס</tei:seg>וֹמֵךְ נוֹפְלִים רוֹפֵא חוֹלִים וּמַתִּיר אֲסוּרִים׃</tei:l>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">עֹ</tei:seg>שֶׂ֣ה גְ֭דֹלוֹת עַד־אֵ֣ין חֵ֑קֶר</tei:l>
          <tei:l>וְ֝נִפְלָא֗וֹת עַד־אֵ֥ין מִסְפָּֽר <tei:bibl>(איוב ט:י)</tei:bibl> —</tei:l>
          <tei:l>בָּרוּךְ הוּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:barukh_sheamar_68587/8"/>
        <tei:lg>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">פּ</tei:seg>וֹדֶה וּמַצִּיל׃</tei:l>
          <tei:l>בָּרוּךְ פֹּעֵ֥ל יְ֝שׁוּע֗וֹת בְּקֶ֣רֶב הָאָֽרֶץ׃ <tei:bibl>(תהלים ז:יב)</tei:bibl></tei:l>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">צַ</tei:seg>דִּיק וְחָסִיד בְּכׇל־הַדּוֹרוֹת —</tei:l>
          <tei:l>בָּרוּךְ הוּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:barukh_sheamar_68587/9"/>
        <tei:lg>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">קָ</tei:seg>רוֹב לְכׇל־קֹרְאָיו בֶּאֱמֶת׃</tei:l>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">רָ֣</tei:seg>ם וְנִשָּׂ֗א שֹׁכֵ֥ן עַד֙ וְקָד֣וֹשׁ שְׁמ֔וֹ <tei:bibl>(ישעיה נז:טו)</tei:bibl> —</tei:l>
          <tei:l>בָּרוּךְ הוּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:barukh_sheamar_68587/10"/>
        <tei:lg>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">שֶׁ</tei:seg>אֵין לְפָנָיו</tei:l>
          <tei:l>לֹא־עַוְלָה</tei:l>
          <tei:l>וְלֹא־שִׁכְחָה</tei:l>
          <tei:l>לֹא־כָּזָב</tei:l>
          <tei:l>וְלֹא־מִרְמָה</tei:l>
          <tei:l>לֹא־מַשּׂוֹא פָּנִים</tei:l>
          <tei:l>וְלֹא־מֶֽקַח שֹֽׁחַד —</tei:l>
          <tei:l>בָּרוּךְ הוּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:barukh_sheamar_68587/11"/>
        <tei:lg>
          <tei:l>בָּרוּךְ <tei:seg type="acrostic">תָּ</tei:seg>מִים בְּכׇל דְּרָכָיו</tei:l>
          <tei:l>כַּכָּתוּב —</tei:l>
          <tei:l>הָאֵל֮ תָּמִ֢ים דַּ֫רְכּ֥וֹ</tei:l>
          <tei:l>אִמְרַֽת־יְהֹוָ֥ה צְרוּפָ֑ה</tei:l>
          <tei:l>מָגֵ֥ן ה֝֗וּא לְכֹ֤ל ׀ הַחֹסִ֬ים בּֽוֹ׃ <tei:bibl>(תהלים יח:לא)</tei:bibl></tei:l>
          <tei:l>וִיבָֽרְכוּ֙ שֵׁ֣ם כְּבֹדֶ֔ךָ</tei:l>
          <tei:l>וּמְרוֹמַ֥ם עַל־כׇּל־בְּרָכָ֖ה וּתְהִלָּֽה׃ <tei:bibl>(נחמיה ט:ה)</tei:bibl></tei:l>
          <tei:l>כִּֽי־יְהֹוָ֣ה עֶלְי֣וֹן נוֹרָ֑א</tei:l>
          <tei:l>מֶ֥לֶךְ גָּ֝ד֗וֹל עַל־כׇּל־הָאָֽרֶץ׃ <tei:bibl>(תהלים מז:ג)</tei:bibl></tei:l>
          <tei:l>כׇּל־הָאָ֤רֶץ ׀ יִשְׁתַּחֲו֣וּ לְ֭ךָ וִיזַמְּרוּ־לָ֑ךְ</tei:l>
          <tei:l>יְזַמְּר֖וּ שִׁמְךָ֣ סֶֽלָה׃ <tei:bibl>(תהלים סו:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:barukh_sheamar_68587/12"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְהֹוָה אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>הָאֵל הַמֶּֽלֶךְ</tei:l>
          <tei:l>אָב הָרַחֲמָן</tei:l>
          <tei:l>הַמְּהֻלָּל הַמְשֻׁבָּח וְהַמְּפֹאָר בְּפִי עַמּוֹ</tei:l>
          <tei:l>וּבִלְשׁוֹן כׇּל־חֲסִידָיו וַעֲבָדָיו</tei:l>
          <tei:l>וּבְשִׁירֵי דָּוִד עַבְדְּךָ בֶּן־יִשַׁי</tei:l>
          <tei:l>נְהַלֶּלְךָ יְהֹוָה אֱלֹהֵֽינוּ</tei:l>
          <tei:l>נְשַׁבְּחָךְ</tei:l>
          <tei:l>נְפַאֲרָךְ</tei:l>
          <tei:l>נְרוֹמְמָךְ</tei:l>
          <tei:l>וְנַמְלִיכָךְ</tei:l>
          <tei:l>וְנַזְכִּיר אֶת־שִׁמְךָ מַלְכֵּֽנוּ</tei:l>
          <tei:l>אֱלֹהֵֽינוּ יָחִיד חַי הָעוֹלָמִים</tei:l>
          <tei:l>מֶֽלֶךְ מְשֻׁבָּח וּמְפֹאָר</tei:l>
          <tei:l>לַעֲדֵי־עַד לָנֶֽצַח.</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה</tei:l>
          <tei:l>מֶֽלֶךְ מְהֻלָּל בַּשְּׁבָחוֹת׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
