  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ena_katsiki_a_yevanic_translation_of_had_gadya">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ena_katsiki_a_yevanic_translation_of_had_gadya/1"/>
        <tei:lg>
          <tei:l>אֵנַה קַצִיקִי</tei:l>
          <tei:l>פּוּמַגֿוֹרַס אוֹפַּטֵרַסְמוּ</tei:l>
          <tei:l>מֵדִיוֹ אַסְפְּרַה.</tei:l>
          <tei:l>אֵנַה קַצִיקִי, אֵנַה קַצִיקִי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ena_katsiki_a_yevanic_translation_of_had_gadya/2"/>
        <tei:lg>
          <tei:l>קֵאִירְתֵֿי אִיגַֿטַה</tei:l>
          <tei:l>קֵפַֿגֵֿי טוֹקַצִיקִי</tei:l>
          <tei:l>פּוּמַגֿוֹרַס אוֹפַּטֵרַסְמוּ</tei:l>
          <tei:l>מֵדִיוֹ אַסְפְּרַה.</tei:l>
          <tei:l>אֵנַה קַצִיקִי, אֵנַה קַצִיקִי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ena_katsiki_a_yevanic_translation_of_had_gadya/3"/>
        <tei:lg>
          <tei:l>קֵאִירְתֵֿי אוֹסְקִילוֹס</tei:l>
          <tei:l>קֵפַֿגֵֿי טִיגַֿטַהה</tei:l>
          <tei:l>פּוּאֵפַֿגֵֿי טוֹקַצִיקִי</tei:l>
          <tei:l>פּוּמַגֿוֹרַס אוֹפַּטֵרַסְמוּ</tei:l>
          <tei:l>מֵדִיוֹ אַסְפְּרַה.</tei:l>
          <tei:l>אֵנַה קַצִיקִי, אֵנַה קַצִיקִי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ena_katsiki_a_yevanic_translation_of_had_gadya/4"/>
        <tei:lg>
          <tei:l>קֵאִירְתֵֿי טוֹקְסִילוֹ</tei:l>
          <tei:l>קֵבַֿרֵסֵי טוֹסְקִילִי</tei:l>
          <tei:l>פּוּאֵפַֿגֵֿי טִיגַֿטַה</tei:l>
          <tei:l>פּוּאֵפַֿגֵֿי טוֹקַצִיקִי</tei:l>
          <tei:l>פּוּמַגֿוֹרַס אוֹפַּטֵרַסְמוּ</tei:l>
          <tei:l>מֵדִיוֹ אַסְפְּרַה.</tei:l>
          <tei:l>אֵנַה קַצִיקִי, אֵנַה קַצִיקִי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ena_katsiki_a_yevanic_translation_of_had_gadya/5"/>
        <tei:lg>
          <tei:l>קֵאִירְתֵֿי אִיפֿוֹטִיַה</tei:l>
          <tei:l>קֵקִַיגֵֿי טוֹקְסִילוֹ</tei:l>
          <tei:l>פּוּבַֿרֵסֵי טוֹסְקִילוֹ</tei:l>
          <tei:l>פּוּאֵפַֿגֵֿי טִיגַֿטַה</tei:l>
          <tei:l>פּוּאֵפַֿגֵֿי טוֹקַצִיקִי</tei:l>
          <tei:l>פּוּמַגֿוֹרַס אוֹפַּטֵרַסְמוּ</tei:l>
          <tei:l>מֵדִיוֹ אַסְפְּרַה.</tei:l>
          <tei:l>אֵנַה קַצִיקִי, אֵנַה קַצִיקִי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ena_katsiki_a_yevanic_translation_of_had_gadya/6"/>
        <tei:lg>
          <tei:l>קֵאִירְתֵֿי טוֹנֵרוֹ</tei:l>
          <tei:l>קֵסְבִֿינֵי טִיפֿוֹטִיַה</tei:l>
          <tei:l>פּוּאֵקִַיגֵֿי טוֹקְסִילוֹ</tei:l>
          <tei:l>פּוּבַֿרֵסֵי טוֹסְקִילוֹ</tei:l>
          <tei:l>פּוּאֵפַֿגֵֿי טִיגַֿטַה</tei:l>
          <tei:l>פּוּאֵפַֿגֵֿי טוֹקַצִיקִי</tei:l>
          <tei:l>פּוּמַגֿוֹרַס אוֹפַּטֵרַסְמוּ</tei:l>
          <tei:l>מֵדִיוֹ אַסְפְּרַה.</tei:l>
          <tei:l>אֵנַה קַצִיקִי, אֵנַה קַצִיקִי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ena_katsiki_a_yevanic_translation_of_had_gadya/7"/>
        <tei:lg>
          <tei:l>קֵאִירְתֵֿי אוֹאַגֶֿלַדַֿה</tei:l>
          <tei:l>קֵאִיפִּיֵי טוֹנֵרוֹ</tei:l>
          <tei:l>פּוּאֵסְבִֿינֵי טִיפֿוֹטִיַה</tei:l>
          <tei:l>פּוּאֵקִַיגֵֿי טוֹקְסִילוֹ</tei:l>
          <tei:l>פּוּבַֿרֵסֵי טוֹסְקִילוֹ</tei:l>
          <tei:l>פּוּאֵפַֿגֵֿי טִיגַֿטַה</tei:l>
          <tei:l>פּוּאֵפַֿגֵֿי טוֹקַצִיקִי</tei:l>
          <tei:l>פּוּמַגֿוֹרַס אוֹפַּטֵרַסְמוּ</tei:l>
          <tei:l>מֵדִיוֹ אַסְפְּרַה.</tei:l>
          <tei:l>אֵנַה קַצִיקִי, אֵנַה קַצִיקִי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ena_katsiki_a_yevanic_translation_of_had_gadya/8"/>
        <tei:lg>
          <tei:l>קֵאִירְתֵֿי אוֹכַֿסַפִּי</tei:l>
          <tei:l>קֵסְפַֿכְּסֵי טִינַגֵֿלַדַֿה</tei:l>
          <tei:l>פּוּאִיפִּיֵי טוֹנֵרוֹ</tei:l>
          <tei:l>פּוּאֵסְבִֿינֵי טִיפֿוֹטִיַה</tei:l>
          <tei:l>פּוּאֵקִַיגֵֿי טוֹקְסִילוֹ</tei:l>
          <tei:l>פּוּבַֿרֵסֵי טוֹסְקִילוֹ</tei:l>
          <tei:l>פּוּאֵפַֿגֵֿי טִיגַֿטַה</tei:l>
          <tei:l>פּוּאֵפַֿגֵֿי טוֹקַצִיקִי</tei:l>
          <tei:l>פּוּמַגֿוֹרַס אוֹפַּטֵרַסְמוּ</tei:l>
          <tei:l>מֵדִיוֹ אַסְפְּרַה.</tei:l>
          <tei:l>אֵנַה קַצִיקִי, אֵנַה קַצִיקִי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ena_katsiki_a_yevanic_translation_of_had_gadya/9"/>
        <tei:lg>
          <tei:l>קֵאִירְתֵֿי אוֹתַֿנַטוֹס</tei:l>
          <tei:l>קֵסְפַֿכְּסֵי טוֹנְכַֿסַפִּי</tei:l>
          <tei:l>פּוּאֵסְפַֿכְּסֵי טִינַגֵֿלַדַֿה</tei:l>
          <tei:l>פּוּאִיפִּיֵי טוֹנֵרוֹ</tei:l>
          <tei:l>פּוּאֵסְבִֿינֵי טִיפֿוֹטִיַה</tei:l>
          <tei:l>פּוּאֵקִַיגֵֿי טוֹקְסִילוֹ</tei:l>
          <tei:l>פּוּבַֿרֵסֵי טוֹסְקִילוֹ</tei:l>
          <tei:l>פּוּאֵפַֿגֵֿי טִיגַֿטַה</tei:l>
          <tei:l>פּוּאֵפַֿגֵֿי טוֹקַצִיקִי</tei:l>
          <tei:l>פּוּמַגֿוֹרַס אוֹפַּטֵרַסְמוּ</tei:l>
          <tei:l>מֵדִיוֹ אַסְפְּרַה.</tei:l>
          <tei:l>אֵנַה קַצִיקִי, אֵנַה קַצִיקִי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ena_katsiki_a_yevanic_translation_of_had_gadya/10"/>
        <tei:lg>
          <tei:l>קֵאִירְתֵֿי הַקָּדוֹשׁ־בָּרוּךְ־הוּא</tei:l>
          <tei:l>קֵסְפַֿכְּסֵי טוֹ תַֿנַטוּ</tei:l>
          <tei:l>פּוּאֵסְפַֿכְּסֵי טוֹנְכַֿסַפִּי</tei:l>
          <tei:l>פּוּאֵסְפַֿכְּסֵי טִינַגֵֿלַדַֿה</tei:l>
          <tei:l>פּוּאִיפִּיֵי טוֹנֵרוֹ</tei:l>
          <tei:l>פּוּאֵסְבִֿינֵי טִיפֿוֹטִיַה</tei:l>
          <tei:l>פּוּאֵקִַיגֵֿי טוֹקְסִילוֹ</tei:l>
          <tei:l>פּוּבַֿרֵסֵי טוֹסְקִילוֹ</tei:l>
          <tei:l>פּוּאֵפַֿגֵֿי טִיגַֿטַה</tei:l>
          <tei:l>פּוּאֵפַֿגֵֿי טוֹקַצִיקִי</tei:l>
          <tei:l>פּוּמַגֿוֹרַס אוֹפַּטֵרַסְמוּ</tei:l>
          <tei:l>מֵדִיוֹ אַסְפְּרַה.</tei:l>
          <tei:l>אֵנַה קַצִיקִי, אֵנַה קַצִיקִי.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
