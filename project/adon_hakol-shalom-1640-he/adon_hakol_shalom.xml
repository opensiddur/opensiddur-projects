    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:adon_hakol_shalom">
        <tei:head>אֲדוֹן הַכֹּל</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_hakol_shalom/1"/>
        <tei:lg>
          <tei:l>אֲדוֹן הַכֹּל מְחַיֶּה כָל־נְשָׁמָה</tei:l>
          <tei:l>יְצַו חַסְדּוֹ לְבַת נָדִיב חֲכָמָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_hakol_shalom/2"/>
        <tei:lg>
          <tei:l>לְבוּשָׁה מֵעֲנַן תֹּאַר יְקָרוֹ</tei:l>
          <tei:l>וּמַשְׁפַּעַת עֲלֵי כָל־הָֽאֲדָמָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_hakol_shalom/3"/>
        <tei:lg>
          <tei:l>שְׁאוֹן גַּלֵּי גְבוּל יַמִּים תְּעוֹרֵר</tei:l>
          <tei:l>וְעִם דּוֹדָהּ בְּצִלּוֹ נֶֽעֱלָמָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_hakol_shalom/4"/>
        <tei:lg>
          <tei:l>בְּחֵן בַּעְלָהּ שְׁבָטֵֽינוּ תְּנַהֵל</tei:l>
          <tei:l>וּמַעְלָתָהּ מְהֻדֶּֽרֶת וְרָמָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_hakol_shalom/5"/>
        <tei:lg>
          <tei:l>זְמִירוֹת מִכְּנַף אֶֽרֶץ שְׁמַעְנוּם</tei:l>
          <tei:l>צְבִי צַדִּיק בְּמִזְרְחָה וְיָמָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_hakol_shalom/6"/>
        <tei:lg>
          <tei:l>יְשָׁרִים הוֹלְכִים תָּמִיד בְּיֹשֶׁר</tei:l>
          <tei:l>נְקִיִּים הֵם בְּלִי עָוֹן וְאַשְׁמָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_hakol_shalom/7"/>
        <tei:lg>
          <tei:l>שְׁמוּעָתָם לְטוֹב כֻּלָּם בְּרוּרִים</tei:l>
          <tei:l>וְלָהֶם נִכְסְפָה נַפְשִׁי בְּתֵימָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_hakol_shalom/8"/>
        <tei:lg>
          <tei:l>צֳרִי גִלְעָד שְׁלַח לָנוּ יְדִידִי</tei:l>
          <tei:l>בְּצִיּוֹן נִשְׂמְחָה גֶֽבֶר וְעַלְמָה</tei:l>
        </tei:lg>
      </tei:div>
