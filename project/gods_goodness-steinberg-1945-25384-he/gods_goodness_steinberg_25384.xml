  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:gods_goodness_steinberg_25384">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gods_goodness_steinberg_25384/8"/>
        <tei:lg>
          <tei:l>יְהוָ֤ה אֲדֹנֵ֗ינוּ</tei:l>
          <tei:l>מָֽה־אַדִּ֣יר שִׁ֭מְךָ בְּכָל־הָאָ֑רֶץ</tei:l>
          <tei:l>אֲשֶׁ֥ר תְּנָ֥ה ה֝וֹדְךָ֗ עַל־הַשָּׁמָֽיִם׃ <tei:bibl>(תהלים ח:ב)</tei:bibl></tei:l>
          <tei:l>כִּֽי־אֶרְאֶ֣ה שָׁ֭מֶיךָ מַעֲשֵׂ֣י אֶצְבְּעֹתֶ֑יךָ</tei:l>
          <tei:l>יָרֵ֥חַ וְ֝כוֹכָבִ֗ים אֲשֶׁ֣ר כּוֹנָֽנְתָּה׃ <tei:bibl>(תהלים ח:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gods_goodness_steinberg_25384/9"/>
        <tei:lg>
          <tei:l>מָֽה־אֱנ֥וֹשׁ כִּֽי־תִזְכְּרֶ֑נּוּ</tei:l>
          <tei:l>וּבֶן־אָ֝דָ֗ם כִּ֣י תִפְקְדֶֽנּוּ׃ <tei:bibl>(תהלים ח:ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gods_goodness_steinberg_25384/10"/>
        <tei:lg>
          <tei:l>וַתְּחַסְּרֵ֣הוּ מְּ֭עַט מֵאֱלֹהִ֑ים</tei:l>
          <tei:l>וְכָב֖וֹד וְהָדָ֣ר תְּעַטְּרֵֽהוּ׃ <tei:bibl>(תהלים ח:ו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gods_goodness_steinberg_25384/11"/>
        <tei:lg>
          <tei:l>תַּ֭מְשִׁילֵהוּ בְּמַעֲשֵׂ֣י יָדֶ֑יךָ</tei:l>
          <tei:l>כֹּ֝ל שַׁ֣תָּה תַֽחַת־רַגְלָֽיו׃ <tei:bibl>(תהלים ח:ז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gods_goodness_steinberg_25384/12"/>
        <tei:lg>
          <tei:l>צֹנֶ֣ה וַאֲלָפִ֣ים כֻּלָּ֑ם</tei:l>
          <tei:l>וְ֝גַ֗ם בַּהֲמ֥וֹת שָׂדָֽי׃ <tei:bibl>(תהלים ח:ח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gods_goodness_steinberg_25384/13"/>
        <tei:lg>
          <tei:l>צִפּ֣וֹר שָׁ֭מַיִם וּדְגֵ֣י הַיָּ֑ם</tei:l>
          <tei:l>עֹ֝בֵ֗ר אָרְח֥וֹת יַמִּֽים׃ <tei:bibl>(תהלים ח:ט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gods_goodness_steinberg_25384/14"/>
        <tei:lg>
          <tei:l>יְהוָ֥ה אֲדֹנֵ֑ינוּ</tei:l>
          <tei:l>מָֽה־אַדִּ֥יר שִׁ֝מְךָ֗ בְּכָל־הָאָֽרֶץ׃ <tei:bibl>(תהלים ח:י)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
