  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_dwelling_in_the_sukkah_of_the_livyatan_meir/2">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_dwelling_in_the_sukkah_of_the_livyatan_meir/2/1"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן מִלְּפָנֶיךָ</tei:l>
          <tei:l>ה׳ אֱלֹהֵינוּ</tei:l>
          <tei:l>וֵאלֹהֵי אֲבוֹתֵינוּ</tei:l>
          <tei:l>כְּשֵׁם שֶׁקִיַּמְתִּי</tei:l>
          <tei:l>וְיָשַׁבְתִּי בְּסוּכָּה זוּ</tei:l>
          <tei:l>כֵּן אֶזְכֶּה לְשָׁנָה הַבָּאָה</tei:l>
          <tei:l>לֵישֵׁב בְּסוּכָּה שֶׁל לִוְיָתָן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
