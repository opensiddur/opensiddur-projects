  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ein_keloheinu">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ein_keloheinu/ein"/>
        <tei:lg>
          <tei:l>לֵית בַּר מִין אֱלָהָנָא</tei:l>
          <tei:l>לֵית בַּר מִין רִבּוֹנָנָא</tei:l>
          <tei:l>לֵית בַּר מִין מַלְכָּנָא</tei:l>
          <tei:l>לֵית בַּר מִין פְּרִיקָנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ein_keloheinu/mi"/>
        <tei:lg>
          <tei:l>מְנָא אֱלָהָא הֵיךְ כֵּאלָהָנָא</tei:l>
          <tei:l>מְנָא רִבּוֹנָא הֵיךְ כְּרִבּוֹנָנָא</tei:l>
          <tei:l>מְנָא מַלְכָּא הֵיךְ כְּמַלְכָּנָא</tei:l>
          <tei:l>מְנָא פְּרִיקָא הֵיךְ כִפְרִיקָנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ein_keloheinu/nodeh"/>
        <tei:lg>
          <tei:l>נוֹדֵי קֳדָם אֱלָהָנָא</tei:l>
          <tei:l>נוֹדֵי קֳדָם רִבּוֹנָנָא</tei:l>
          <tei:l>נוֹדֵי קֳדָם מַלְכָּנָא</tei:l>
          <tei:l>נוֹדֵי קֳדָם פְּרִיקָנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ein_keloheinu/barukh"/>
        <tei:lg>
          <tei:l>בְּרִיךְ אֱלָהָנָא</tei:l>
          <tei:l>בְּרִיךְ רִבּוֹנָנָא</tei:l>
          <tei:l>בְּרִיךְ מַלְכָּנָא</tei:l>
          <tei:l>בְּרִיךְ פְּרִיקָנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ein_keloheinu/attah"/>
        <tei:lg>
          <tei:l>אָנְתְּ הוּא אֱלָהָנָא</tei:l>
          <tei:l>אָנְתְּ הוּא רִבּוֹנָנָא</tei:l>
          <tei:l>אָנְתְּ הוּא מַלְכָּנָא</tei:l>
          <tei:l>אָנְתְּ הוּא פְּרִיקָנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ein_keloheinu/incense"/>
        <tei:lg>
          <tei:l>אָנְתְּ הוּא דְּאַסִיקוּ אֲבָהֳתַנָא</tei:l>
          <tei:l>קֳדָמָךְ יַת־קְטֹרֶת בּוּסְמַיָּא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>אָנְתְּ הוּא תִפְרְקִינָנָא</tei:l>
          <tei:l>אַנְתְּ תְּקוּם תְּרַחֵם צִיוֹן</tei:l>
          <tei:l>אֲרוּם עִדָן לְמֵחוּס עֲלָהּ</tei:l>
          <tei:l>אֲרוּם אֲתָא זִמְנָא</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
