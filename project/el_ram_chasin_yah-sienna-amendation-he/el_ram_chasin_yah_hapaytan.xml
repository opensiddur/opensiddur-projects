    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:el_ram_chasin_yah_hapaytan">
        <tei:head>אל רם חסין יה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_ram_chasin_yah_hapaytan/3"/>
        <tei:lg>
          <tei:l>לְדוֹרְשֵׁי אַחְדוּת</tei:l>
          <tei:l>תֵּן נֶאֱמָנוּת</tei:l>
          <tei:l>כְּהָיְתָה לְרוּת</tei:l>
          <tei:l>הַמּוֹאֲבִיָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_ram_chasin_yah_hapaytan/5"/>
        <tei:lg>
          <tei:l>שְׁמַע בְּקֹלָהּ</tei:l>
          <tei:l>הָאֵם הַגְּבִירָה</tei:l>
          <tei:l>וַתִּצְחַק שָׂרָה</tei:l>
          <tei:l>אֵַשֶׁר פָּקָד יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_ram_chasin_yah_hapaytan/7"/>
        <tei:lg>
          <tei:l>תַּשִׁיב לְעַמָּךְ</tei:l>
          <tei:l>בְּקָרְאֵנוּ לָךְ</tei:l>
          <tei:l>כֵּן עָשְׂתָה רִבְקָה</tei:l>
          <tei:l>הִיא דּוֹרֶשֶׁת יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_ram_chasin_yah_hapaytan/9"/>
        <tei:lg>
          <tei:l>מֵי נָהָר שָׁמְרָה</tei:l>
          <tei:l>קְרִיאָת סוּף רָאָתָה</tei:l>
          <tei:l>עִמָּהּ נָשִׁירָה</tei:l>
          <tei:l>מִרְיָם נְּבִיאָת יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_ram_chasin_yah_hapaytan/11"/>
        <tei:lg>
          <tei:l>לְאוֹיבֵנוּ זְכֹר</tei:l>
          <tei:l>בְּיַד אִשָּׁה תִּמְכֹּר</tei:l>
          <tei:l>דְּבוֹרָה בּוֹעֶרֶת</tei:l>
          <tei:l>כְּלַפִּידָת יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_ram_chasin_yah_hapaytan/13"/>
        <tei:lg>
          <tei:l>עֻזָּה בֶּהָדָר</tei:l>
          <tei:l>בְּצֶדֶק נֹאמַר</tei:l>
          <tei:l>כִּי צָדְקָה תָּמָר</tei:l>
          <tei:l>אֵם מְשִׁיחַ יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_ram_chasin_yah_hapaytan/15"/>
        <tei:lg>
          <tei:l>תֵּן שָׁלוֹם בְּחֵיל</tei:l>
          <tei:l>לְעִירָךְ גּוֹאֵל</tei:l>
          <tei:l>עַל דִּמְעָת רָחֵל</tei:l>
          <tei:l>וּשְׁכִינַת יָהּ</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
