  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hanaavah_babanot_neeman">
        <tei:head>הַנָּאוָה בַּבָּנוֹת</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hanaavah_babanot_neeman/1"/>
        <tei:lg>
          <tei:l>הַנָּאוָה בַּבָּנוֹת,</tei:l>
          <tei:l>אָנָּא הָאִירִי פָּנַיִךְ אֵלַי,</tei:l>
          <tei:l>הָאִירִי פָּנַיִךְ אֵלַי!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hanaavah_babanot_neeman/2"/>
        <tei:lg>
          <tei:l>בּוֹא דּוֹדִי כִּי יָפִיתָ</tei:l>
          <tei:l>אַף נָעַמְתָּ עַד מְאוֹד.</tei:l>
          <tei:l>שְׁלַח יָדְךָ וְחַבְּקֵנִי,</tei:l>
          <tei:l>אַמְּצֵנִי עוֹד וָעוֹד.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
