  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:mah_tovu">
        <tei:head>Mah Tovu, translated from Rabbi David Einhorn's Olat Tamid (1858) by Joshua Giorgio-Rubin (2020)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mah_tovu/mah_tovu-varani"/>
        <tei:lg>
          <tei:l>[Mah Tovu]</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Trusting in Your infinite love, O God,</tei:l>
          <tei:l>we enter this, Your house;</tei:l>
          <tei:l>in reverence</tei:l>
          <tei:l>we draw near unto You in Your holy Temple.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>We love Your dwelling-place, O Eternal,</tei:l>
          <tei:l>this sanctuary that proclaims Your holy presence.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>We bend our knees before You</tei:l>
          <tei:l>and adore You.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>O Creator, graciously accept our prayer</tei:l>
          <tei:l>at this time.</tei:l>
          <tei:l>In the fullness of Your kindness,</tei:l>
          <tei:l>please answer us,</tei:l>
          <tei:l>for You are our stronghold and support.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>
            <tei:hi rend="italic">Amen</tei:hi>
          </tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
