  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:acheinu_veacheiyoteinu">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:acheinu_veacheiyoteinu/1"/>
        <tei:lg>
          <tei:l>Aḥeinu kol beit Yisrael,</tei:l>
          <tei:l>aḥ’yoteinu kol beit Yisrael</tei:l>
          <tei:l>han’tunim b’tsarah uvashivyah,</tei:l>
          <tei:l>ha’omdim bein bayam u’vein bayabashah.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:acheinu_veacheiyoteinu/3"/>
        <tei:lg>
          <tei:l>Hamaḳom y’raḥeim aleihem</tei:l>
          <tei:l>v’yotsiem mitsarah</tei:l>
          <tei:l>lirvaḥah,</tei:l>
          <tei:l>ume’afailah l’orah</tei:l>
          <tei:l>umishibud lig’ulah,</tei:l>
          <tei:l>hashta ba’agala</tei:l>
          <tei:l>uvizman ḳariv.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
