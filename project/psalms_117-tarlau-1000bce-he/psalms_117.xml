      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/117">
        <tei:head>תהלים קי״ז</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/117/1/a"/>
        <tei:lg>
          <tei:l>הַלְלוּ אֶת־יְהֹוָה כׇּל־גּוֹיִם</tei:l>
          <tei:l>שַׁבְּחוּהוּ כׇּל־הָאֻמִּים׃</tei:l>
          <tei:l>כִּי־גָבַר עָלֵינוּ חַסְדּוֹ</tei:l>
          <tei:l>וֶאֱמֶת־יְהֹוָה לְעוֹלָם הַלְלוּ־יָהּ׃</tei:l>
        </tei:lg>
      </tei:div>
