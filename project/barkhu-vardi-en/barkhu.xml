  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:barkhu">
        <tei:head>Barkhu, translation by Rabbi Levi Weiman-Kelman &amp; Shaul Vardi</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:barkhu/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">shaliaḥ tsibbur:</tei:note>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Praise YHVH to whom our praise is due!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:barkhu/2"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">Congregation:</tei:note>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Praised be YHVH to whom our praise is due,</tei:l>
          <tei:l>now and forever!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:barkhu/3"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">shaliaḥ tsibbur:</tei:note>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Praised be Adonai to whom our praise is due,</tei:l>
          <tei:l>now and forever!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
