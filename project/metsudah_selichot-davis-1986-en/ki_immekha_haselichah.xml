  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:ki_immekha_haselichah">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_immekha_haselichah/1"/>For with You is forgiveness,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_immekha_haselichah/2"/>in order that You be feared.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_immekha_haselichah/3"/>For with You is the source of life,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_immekha_haselichah/4"/>[and] in Your light shall we see light.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_immekha_haselichah/5"/>[Grant us] life, and do kindness with us,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_immekha_haselichah/6"/>and let Your precepts preserve our spirit.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_immekha_haselichah/7"/>We ask of You, life,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_immekha_haselichah/8"/>grant us length of days,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_immekha_haselichah/9"/>forever.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
