  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:ein_lanu_peh">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_lanu_peh/1"/>We have no mouth [words] to answer,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_lanu_peh/2"/>nor the brazeness to lift our head.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/49/8"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_lanu_peh/3"/>A man will not redeem his brother,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_lanu_peh/4"/>neither can he give to God his ransom.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/25/22"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_lanu_peh/5"/>Redeem Israel, O God,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_lanu_peh/6"/>from all its anguish.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/69/17"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_lanu_peh/7"/>Be gracious to us Adonoy with Your kindness,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_lanu_peh/8"/>with Your abundant mercies, turn to us.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/34/23"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_lanu_peh/9"/>Adonoy redeems the soul of His servants,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_lanu_peh/10"/>and none are doomed
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_lanu_peh/11"/>all who take refuge in Him.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
