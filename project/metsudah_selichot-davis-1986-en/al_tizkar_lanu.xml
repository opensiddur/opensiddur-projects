  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:al_tizkar_lanu">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/79/8"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/1"/>Remember not the sins of our ancestors;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/2"/>let Your compassion come swiftly toward us,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/3"/>for we have been brought very low.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:al_tizkar_lanu/selichot_tzom_gedaliah"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/8"/>For Adonoy hears the [cry] of the needy,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/9"/>and His bound ones, He does not shame.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/10"/>For our lives are spent in sorrow,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/11"/>and our years in sighing.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/12"/>For because of [our faith in] You
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/13"/>we are murdered each day;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/14"/>we are considered as sheep
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/15"/>to be slaughtered.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/16"/>For You will not forsake us forever, O God.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:al_tizkar_lanu/selichot_tzom_gedaliah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/4"/>The sins of our youth and our transgressions,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:al_tizkar_lanu/selichot_tzom_gedaliah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/5"/>remember not;
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:al_tizkar_lanu/selichot_tzom_gedaliah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/6"/>with Your kindliness remember us
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:al_tizkar_lanu/selichot_tzom_gedaliah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/7"/>for the sake of Your goodness, Adonoy.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_5"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
