  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:meein_kamokha_adonai">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_kamokha_adonai/1"/>There is none like You, Adonoy.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_kamokha_adonai/2"/>You are great,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_kamokha_adonai/3"/>and Your Name is great in its might.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/76/2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_kamokha_adonai/4"/>God is known in Judah,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_kamokha_adonai/5"/>in Israel, His Name is great.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_kamokha_adonai/6"/>Help us, Adonoy, our God,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_kamokha_adonai/7"/>for upon You, we depend,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_kamokha_adonai/8"/>and in Your Name, do we come.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/48/11"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_kamokha_adonai/9"/>As Your Name, God, so is Your praise
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_kamokha_adonai/10"/>to the ends of the earth;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_kamokha_adonai/11"/>Your hand is full of righteousness.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/18/10"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_kamokha_adonai/12"/>A tower of strength is the Name, Adonoy,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_kamokha_adonai/13"/>to Him rush the righteous and strong.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
