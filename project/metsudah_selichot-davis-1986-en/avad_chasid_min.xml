  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:avad_chasid_min">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:micah/7/2"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:avad_chasid_min/1"/>The pious have disappeared from the earth,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:avad_chasid_min/2"/>and uprightness in man no longer exists.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:avad_chasid_min/3"/>No one calls with Your Name in righteousness,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:avad_chasid_min/4"/>inspired to be steadfast with You.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/12/2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:avad_chasid_min/5"/>Deliver us Adonoy
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:avad_chasid_min/6"/>for the devoted man has ceased,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:avad_chasid_min/7"/>for the faithful have disappeared
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:avad_chasid_min/8"/>from among the sons of man.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/36/10"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:avad_chasid_min/9"/>For with You is the source of life,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:avad_chasid_min/10"/>in Your light shall we see light.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:avad_chasid_min/11"/>For with Adonoy there is loving-kindness,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:avad_chasid_min/12"/>and with Him there is much redemption.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/130/8"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:avad_chasid_min/13"/>And He will redeem Israel
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:avad_chasid_min/14"/>from all its iniquities.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
