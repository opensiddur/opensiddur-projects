    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:al_na_tashet">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_na_tashet/1"/>Do not, we beseech You
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_na_tashet/2"/>place upon us this sin,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_na_tashet/3"/>wherein we have acted foolishly and sinned.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_na_tashet/4"/>We have sinned, our Rock;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_na_tashet/5"/>pardon us our Creator.</tei:p>
      </tei:div>
