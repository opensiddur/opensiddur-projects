  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:kaddish/shalem">
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/chatzi"/>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/22"/>May their be acceptance
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/23"/>of the prayers and supplications
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/24"/>of the entire House of Israel
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/25"/>before their Father in heaven.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/26"/>And say, Amen.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/27"/>May there be abundant peace from heaven
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/53"/>and life for us
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/29"/>and for all Israel,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/30"/>—and say Amen.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/54"/>He Who makes peace in His high heavens
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/34"/>may He, make peace for us
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/35"/>and for all Israel,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/36"/>—and say Amen.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
