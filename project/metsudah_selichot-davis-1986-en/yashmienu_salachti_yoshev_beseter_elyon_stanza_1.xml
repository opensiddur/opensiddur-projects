  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yashmienu_salachti_yoshev_beseter_elyon/stanza_1">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_1/1"/>Let us hear “I have pardoned”;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_1/2"/>You Who dwells
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_1/3"/>in the shelter of the Most High;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_1/4"/>with Your right hand of deliverance,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_1/5"/>deliver a people poor and needy.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_1/6"/>When we cry to You,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_1/7"/>answer us with awesome righteousness,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_1/8"/>Adonoy, be our Helper!</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
