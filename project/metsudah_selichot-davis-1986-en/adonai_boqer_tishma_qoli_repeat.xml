  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:adonai_boqer_tishma_qoli/repeat">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_boqer_tishma_qoli/repeat/1"/>As a father has compassion on his children
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_boqer_tishma_qoli/repeat/2"/>so do You have compassion on us, Adonoy.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/3/9"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_boqer_tishma_qoli/repeat/3"/>Deliverance is Adonoy’s;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_boqer_tishma_qoli/repeat/4"/>upon Your people is Your blessing. Selah!
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_boqer_tishma_qoli/repeat/5"/>Adonoy of Hosts is with us,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_boqer_tishma_qoli/repeat/6"/>a stronghold for us is the God of Jacob. Selah!
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/84/13"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_boqer_tishma_qoli/repeat/7"/>Adonoy of Hosts!
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_boqer_tishma_qoli/repeat/8"/>fortunate is the man who trusts in You.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/20/10"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_boqer_tishma_qoli/repeat/9"/>Adonoy, deliver us!
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_boqer_tishma_qoli/repeat/10"/>the King will answer us on the day we call.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
