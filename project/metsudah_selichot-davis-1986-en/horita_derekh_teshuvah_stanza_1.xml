  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:horita_derekh_teshuvah/stanza_1">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_1/1"/>You taught the way of repentance
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_1/2"/>to the rebellious daughter [Israel];
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_1/3"/>between Rosh Hashana and Yom Kippur
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_1/4"/>we are to return unto You [in repentance].
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_1/5"/>Cause us to return to You, Adonoy,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_1/6"/>and we shall return.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
