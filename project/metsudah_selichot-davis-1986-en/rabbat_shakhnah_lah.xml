  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:rabbat_shakhnah_lah">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:rabbat_shakhnah_lah/1"/>Too long has our soul dwelt
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:rabbat_shakhnah_lah/2"/>with those who hate peace.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/120/7"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:rabbat_shakhnah_lah/3"/>I am for peace;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:rabbat_shakhnah_lah/4"/>but when I speak
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:rabbat_shakhnah_lah/5"/>they are for war.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:rabbat_shakhnah_lah/6"/>Let there be peace within your moats
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:rabbat_shakhnah_lah/7"/>serenity withing your palaces.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:rabbat_shakhnah_lah/8"/>Peace, peace to the far one
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:rabbat_shakhnah_lah/9"/>and to the near one,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:rabbat_shakhnah_lah/10"/>says Adonoy, and I will heal him.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:isaiah/26/12"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:rabbat_shakhnah_lah/11"/>Adonoy, arrange peace for us,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:rabbat_shakhnah_lah/12"/>for indeed all our works,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:rabbat_shakhnah_lah/13"/>have You done for us.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/29/11"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:rabbat_shakhnah_lah/14"/>Adonoy will give strength to His people,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:rabbat_shakhnah_lah/15"/>Adony will bless His people with peace.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:job/25/2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:rabbat_shakhnah_lah/16"/>Rule and awe are with Him,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:rabbat_shakhnah_lah/17"/>He Who makes peace in His high heavens.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:rabbat_shakhnah_lah/18"/>For you will go out [of exile] with joy,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:rabbat_shakhnah_lah/19"/>and be led forth in peace [to Zion].</tei:p>
      </tei:div>
