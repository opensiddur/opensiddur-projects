  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yoshev_beseter_elyon_maginni_vetzinnati/stanza_4">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_4/1"/>Gracious and Living One, be gracious to me,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_4/2"/>the sound of my cry is in my throat,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_4/3"/>answer me when You hear it.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_4/4"/>Increase Your forgiveness,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_4/5"/>inscribe me for life,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_4/6"/>let my righteousness testify for me.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_4/7"/>Give me my life as my request,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_4/8"/>and my people’s as my petition.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
