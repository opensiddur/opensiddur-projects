<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/27"/>above
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/28"/>all the blessings and hymns,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/chatzi/selichot_penitential_fourth_day"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/29"/>above
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/30"/>all the blessings and hymns,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/chatzi/selichot_penitential_fifth_day"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/31"/>above
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/32"/>all the blessings and hymns,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_5"/>
