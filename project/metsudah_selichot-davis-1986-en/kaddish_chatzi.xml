<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/22"/><tei:choice><tei:sic>far above</tei:sic><tei:corr>above</tei:corr></tei:choice>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_7"/>
<j:conditional xml:id="variant_8"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/chatzi/selichot_tzom_gedaliah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/chatzi/selichot_penitential_second_day"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/chatzi/selichot_penitential_third_day"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/chatzi/selichot_penitential_fourth_day"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/chatzi/selichot_penitential_fifth_day"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/chatzi/selichot_erev_yom_kippur"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/19"/>all the blessings and hymns,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_8"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/20"/>praises and consolations
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/21"/>which we utter in the world—and say Amen.</tei:p>
