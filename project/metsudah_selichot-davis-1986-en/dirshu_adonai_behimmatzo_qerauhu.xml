  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:dirshu_adonai_behimmatzo_qerauhu">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu/1"/>Seek Adonoy while He may be found,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu/2"/>call upon Him while He is near.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu/3"/>“Return to Me, and I will return to you,”
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu/4"/>says Adonoy of hosts.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:jonah/3/9"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu/5"/>He who knows shall return,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu/6"/>and God will relent
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu/7"/>and turn from His fierce anger,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu/8"/>and not destroy
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:joel/2/14"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu/9"/>He who knows shall return and repent,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu/10"/>and leave a blessing after him.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:joel/2/13"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu/11"/>Rend your hearts, not [merely] your clothes,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu/12"/>and return to Adonoy, your God.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu/13"/>For He is gracious and merciful,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu/14"/>slow to anger and abundant in kindness,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu/15"/>and relenting of evil.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
