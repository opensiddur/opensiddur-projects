  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:dirshu_adonai_behimmatzo_qerauhu_bihyoto">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu_bihyoto/1"/>Seek Adonoy while He may be found
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu_bihyoto/2"/>call upon while He is near.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:jeremiah/3/22"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu_bihyoto/3"/>Return, irreverent children,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu_bihyoto/4"/>I will heal your irreverence.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu_bihyoto/5"/>Behold we approach You
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu_bihyoto/6"/>for You are Adonoy, our God.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:hosea/14/2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu_bihyoto/7"/>Return, Israel to Adonoy, Your God,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu_bihyoto/8"/>for you have failed by your iniquity.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
