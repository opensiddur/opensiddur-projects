  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:ashrei_haam_yodei">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/89/16"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashrei_haam_yodei/1"/>Fortunate is the people
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashrei_haam_yodei/2"/>that understand the call of the teruah,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashrei_haam_yodei/3"/>Adonoy,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashrei_haam_yodei/4"/>in the light of Your Presence they will walk.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/98/6"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashrei_haam_yodei/5"/>With trumpets and the sound of the shofar
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashrei_haam_yodei/6"/>raise your voice before the King, Adonoy.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
