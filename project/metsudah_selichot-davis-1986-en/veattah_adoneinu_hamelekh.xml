  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:veattah_adoneinu_hamelekh">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_adoneinu_hamelekh/1"/>And now our Master, the King,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_adoneinu_hamelekh/2"/>the eyes of all Israel are on You.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_adoneinu_hamelekh/3"/>Adonoy is King, Adonoy was King,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_adoneinu_hamelekh/4"/>Adonoy will be King forever and ever.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_adoneinu_hamelekh/5"/>You are our King from of old,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_adoneinu_hamelekh/6"/>You effect deliverances in the midst of the earth.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_adoneinu_hamelekh/7"/>You are our King, God,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_adoneinu_hamelekh/8"/>command the deliverance of Jacob.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:zechariah/14/9"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_adoneinu_hamelekh/9"/>And it will be on that day,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_adoneinu_hamelekh/10"/>that Adonoy will be King
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_adoneinu_hamelekh/11"/>over the whole earth,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_adoneinu_hamelekh/12"/>on that day
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_adoneinu_hamelekh/13"/>Adonoy will be One
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_adoneinu_hamelekh/14"/>and His Name One.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
