  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:zekhor_rachamekha">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/25/6"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/1"/>Remember Your mercies, Adonoy,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/2"/>and kindlinesses
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/3"/>for they are from the beginning of the world.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/106/4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/4"/>Remember us Adonoy
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/5"/>with favor for Your people
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/6"/>recall us with Your deliverance.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/74/2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/7"/>Remember Your congregation
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/8"/>which You have acquired of old,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/9"/>You have redeemed the tribe
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/10"/>of Your inheritance,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/11"/>this mountain of Zion where You have dwelled.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/12"/>Remember, Adonoy, the affection of Jerusalem,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/13"/>the love of Zion, forget not until eternity.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/137/7"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/14"/>Remember, Adonoy,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/15"/>to the sons of Edom, the day of Jerusalem,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/16"/>[it was they] who said,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/17"/>“Raze it, raze it to its very foundations.”
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/102/14"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/18"/>You will arise
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/19"/>and have compassion on Zion,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/20"/>for it is time to be gracious to her,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/21"/>for the appointed time has come.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/32/13"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/22"/>Remember Abraham, Isaac, Israel,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/23"/>Your servants,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/24"/>to whom You swore by Your very Self,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/25"/>and You said to them:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/26"/>“I will multiply your seed
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/27"/>as the stars of the heavens;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/28"/>and all this land that I have promised,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/29"/>I will give to your descendants,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/30"/>and they will inherit it forever.”
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:deuteronomy/9/27"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/31"/>Remember Your servants,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/32"/>Abraham, Isaac, and Jacob;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/33"/>do not regard the stubborness of this people,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_rachamekha/34"/>or their wickedness, or their sin.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
