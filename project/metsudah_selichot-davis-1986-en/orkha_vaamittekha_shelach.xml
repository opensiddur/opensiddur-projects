      <tei:p>In returning Your <tei:hi rend="italic">Shechinah</tei:hi> to dwell among us.</tei:p>
    </tei:note>
    <tei:note type="commentary" target="#note_2" xml:lang="en">
      <tei:p>Israel’s.</tei:p>
    </tei:note>
    <tei:note type="commentary" target="#note_3" xml:lang="en">
      <tei:p>When he [Israel] lived on its own land.</tei:p>
    </tei:note>
    <tei:note type="commentary" target="#note_4" xml:lang="en">
      <tei:p>The sins.</tei:p>
    </tei:note>
