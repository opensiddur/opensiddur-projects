  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:nissa_levavenu_el">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:lamentations/3/41"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:nissa_levavenu_el/1"/>Let us lift our hearts with our hands
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:nissa_levavenu_el/2"/>to the Almighty in heaven.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:nissa_levavenu_el/3"/>Our help comes from Adonoy,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:nissa_levavenu_el/4"/>Maker of heaven and earth.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:nissa_levavenu_el/5"/>He will not let our feet slip;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:nissa_levavenu_el/6"/>He will not slumber—our Guardian.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/121/4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:nissa_levavenu_el/7"/>Behold, He does not slumber,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:nissa_levavenu_el/8"/>nor does He sleep, the Guardian of Israel.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:nissa_levavenu_el/9"/>Deliver, Adonoy, Your people,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:nissa_levavenu_el/10"/>the remnant of Israel.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
