  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:qiddemu_einay_ashmurot">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qiddemu_einay_ashmurot/1"/>My eyes were [opened] early
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qiddemu_einay_ashmurot/2"/>even before the [last two] night watches
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qiddemu_einay_ashmurot/3"/>to meditate in Your word.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/16/1"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qiddemu_einay_ashmurot/4"/>The arrangement of thoughts belong to man,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qiddemu_einay_ashmurot/5"/>but from Adonoy comes eloquent speech.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/102/1"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qiddemu_einay_ashmurot/6"/>A prayer of the poor
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qiddemu_einay_ashmurot/7"/>when he is enwrapped [with affliction]
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qiddemu_einay_ashmurot/8"/>and before Adonoy
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qiddemu_einay_ashmurot/9"/>he pours out his prayers.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:amos/4/13"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qiddemu_einay_ashmurot/10"/>For behold, He forms mountains
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qiddemu_einay_ashmurot/11"/>and creates winds;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qiddemu_einay_ashmurot/12"/>He recounts to man, his [secret] thoughts.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qiddemu_einay_ashmurot/13"/>He makes the morning dark
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qiddemu_einay_ashmurot/14"/>and trods over the high places on earth.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qiddemu_einay_ashmurot/15"/>Adonoy, God of Hosts is His Name.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
