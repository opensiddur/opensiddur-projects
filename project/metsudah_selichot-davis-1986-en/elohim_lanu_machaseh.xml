  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:elohim_lanu_machaseh">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/46/2"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohim_lanu_machaseh/1"/>God is our hope and strength,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohim_lanu_machaseh/2"/>our help in trouble, He is most accessible.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/67/2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohim_lanu_machaseh/3"/>May God favor us and bless us,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohim_lanu_machaseh/4"/>may He cause His countenance to shine
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohim_lanu_machaseh/5"/>among us forever.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohim_lanu_machaseh/6"/>God judges,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohim_lanu_machaseh/7"/>this one He humbles and this one He exalts.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/54/3"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohim_lanu_machaseh/8"/>God, deliver us with Your Name,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohim_lanu_machaseh/9"/>and with Your might, judge us.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohim_lanu_machaseh/10"/>God, hear our prayer,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohim_lanu_machaseh/11"/>give ear to the words of our mouth.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/80/20"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohim_lanu_machaseh/12"/>Adonoy, God of Hosts,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohim_lanu_machaseh/13"/>cause us to return to You,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohim_lanu_machaseh/14"/>enlighten us with Your countenance
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohim_lanu_machaseh/15"/>and we will be delivered.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
