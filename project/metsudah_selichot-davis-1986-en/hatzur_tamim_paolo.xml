  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hatzur_tamim_paolo">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:deuteronomy/32/4"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatzur_tamim_paolo/1"/>The Rock, His work is perfect,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatzur_tamim_paolo/2"/>for all His ways are justice.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatzur_tamim_paolo/3"/>Almighty of faithfulness, without iniquity,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatzur_tamim_paolo/4"/>just and right is He.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/119/91"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatzur_tamim_paolo/5"/>For Your judgement they stand today,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatzur_tamim_paolo/6"/>for they are all Your servants.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/81/4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatzur_tamim_paolo/7"/>Blow the shofar on the new month,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatzur_tamim_paolo/8"/>at the appointed time for our festive day.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/81/5"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatzur_tamim_paolo/9"/>For it is a statute for Israel,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatzur_tamim_paolo/10"/>a day of judgement of the God of Jacob.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/36/7"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatzur_tamim_paolo/11"/>Your righteousness
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatzur_tamim_paolo/12"/>is like the mighty mountains,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatzur_tamim_paolo/13"/>Your judgements like the great deep;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatzur_tamim_paolo/14"/>man and beast, You deliver, Adonoy.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
