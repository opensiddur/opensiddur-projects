  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:isaiah/55/6-7">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:isaiah/55/6_7/1"/>Seek Adonoy while He may be found
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:isaiah/55/6_7/2"/>call upon Him while He is near.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:isaiah/55/6_7/3"/>Let the wicked one forsake his way,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:isaiah/55/6_7/4"/>and the man of deceit, his thoughts;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:isaiah/55/6_7/5"/>and let him return to Adonoy,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:isaiah/55/6_7/6"/>and He will have compassion for him,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:isaiah/55/6_7/7"/>and to our God,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:isaiah/55/6_7/8"/>for He will abundantly pardon.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
