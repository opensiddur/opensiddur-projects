  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:amareinu_haazinah">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amareinu_haazinah/1"/>Give ear to our words, Adonoy!
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amareinu_haazinah/2"/>Consider our meditations.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amareinu_haazinah/3"/>May there be gracious acceptance
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amareinu_haazinah/4"/>for the words of our mouth,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amareinu_haazinah/5"/>and the meditation of our heart,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amareinu_haazinah/6"/>before You,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amareinu_haazinah/7"/>Adonoy, our Rock, and our Redeemer.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amareinu_haazinah/8"/>For to You Adonoy, we hope
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amareinu_haazinah/9"/>You will answer us Adonoy, our God.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
