  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:keayyal_taarog_al">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:keayyal_taarog_al/1"/>Like the stag yearns
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:keayyal_taarog_al/2"/>for flowing streams of water,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:keayyal_taarog_al/3"/>so does our soul yearn
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:keayyal_taarog_al/4"/>for You, O God.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:keayyal_taarog_al/5"/>O God, the insolent rise against us,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:keayyal_taarog_al/6"/>and the congregation of tyrants seek our soul,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:keayyal_taarog_al/7"/>and they do not set Your Presence
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:keayyal_taarog_al/8"/>before them, selah.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/83/13"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:keayyal_taarog_al/9"/>They said, we will inherit them,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:keayyal_taarog_al/10"/>[they who are] the favored of God.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:isaiah/64/11"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:keayyal_taarog_al/11"/>Because of this, will Adonoy restrain Himself,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:keayyal_taarog_al/12"/>be silent, and allow us to be tortured
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:keayyal_taarog_al/13"/>so greatly?
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
