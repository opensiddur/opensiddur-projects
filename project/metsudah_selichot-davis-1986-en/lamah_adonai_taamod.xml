  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:lamah_adonai_taamod">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/10/1"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:lamah_adonai_taamod/1"/>Why do You stand from afar, Adonoy,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:lamah_adonai_taamod/2"/>hiding Yourself in times of trouble?
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:lamah_adonai_taamod/3"/>Return for the sake of Your servants
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:lamah_adonai_taamod/4"/>the tribes of Your inheritance.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:lamah_adonai_taamod/5"/>You will grant truth to Jacob,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:lamah_adonai_taamod/6"/>kindliness to Abraham.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:lamah_adonai_taamod/7"/>As You have sworn to our fathers
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:lamah_adonai_taamod/8"/>from the days of old.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
