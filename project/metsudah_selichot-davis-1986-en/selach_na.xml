  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:selach_na">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/14/19"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:selach_na/1"/>“Please pardon the sins of this nation
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:selach_na/selichot_erev_rosh_hashanah"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:selach_na/9"/>with the immensity of Your kindness,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:selach_na/10"/>just as You forgave this nation
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:selach_na/selichot_erev_rosh_hashanah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:selach_na/2"/>in accordance with the greatness
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:selach_na/selichot_erev_rosh_hashanah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:selach_na/3"/>of Your lovingkindness;
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:selach_na/selichot_erev_rosh_hashanah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:selach_na/4"/>and as You forgave this people
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:selach_na/5"/>from when it left Egypt until now.”
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:selach_na/selichot_erev_rosh_hashanah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:selach_na/6"/>And there it is said:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_5"/>
<tei:note type="instruction" xml:lang="en"><tei:hi rend="italic">The Congregation says:</tei:hi></tei:note>
<j:conditional xml:id="variant_6"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:selach_na/selichot_erev_rosh_hashanah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:selach_na/7"/>“And Adonoy said,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_6"/>
<j:conditional xml:id="variant_7"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:selach_na/selichot_erev_rosh_hashanah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:selach_na/8"/>I have pardoned [them] as you have asked.”
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_7"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
