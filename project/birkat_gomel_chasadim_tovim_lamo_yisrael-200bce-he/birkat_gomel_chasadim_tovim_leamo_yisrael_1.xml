    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:birkat_gomel_chasadim_tovim_leamo_yisrael/1">
        <tei:head>בִּרְכַּת גּוֹמֵל חֲסָדִים טוֹבִים לְעַמּוֹ יִשְׂרָאֵל</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_gomel_chasadim_tovim_leamo_yisrael/1/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">”כי משי אפיה לימא“ <tei:bibl>(ברכות ס ב׳)</tei:bibl></tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_gomel_chasadim_tovim_leamo_yisrael/1/2"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>מֶלֶךְ הָעוֹלָם,</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>הַמַּעֲבִיר</tei:l>
          <tei:l>שֵׁנָה מֵעֵינָי</tei:l>
          <tei:l>וּתְנוּמָה מֵעַפְעַפָּי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_gomel_chasadim_tovim_leamo_yisrael/1/3"/>
        <tei:lg>
          <tei:l>וִיהִי רָצוֹן מִלְּפָנֶיךָ יְהֹוָה אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ</tei:l>
          <tei:l>שֶׁתַּרְגִּילֵנוּ</tei:l>
          <tei:l>בְּתוֹרָתֶךָ,</tei:l>
          <tei:l>וְדַבְּקֵנוּ</tei:l>
          <tei:l>בְּמִצְוֺתֶיךָ,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_gomel_chasadim_tovim_leamo_yisrael/1/4"/>
        <tei:lg>
          <tei:l>וְאַל תְּבִיאֵנוּ לֹא לִידֵי חֵטְא, וְלֹא לִידֵי עֲבֵרָה וְעָוֹן,</tei:l>
          <tei:l>וְלֹא לִידֵי נִסָּיוֹן, וְלֹא לִידֵי בִזָּיוֹן,</tei:l>
          <tei:l>וְאַל תַּשְׁלֶט בָּנוּ יֵצֶר הָרָע,</tei:l>
          <tei:l>וְהַרְחִיקֵנוּ מֵאָדָם רָע וּמֵחָבֵר רָע,</tei:l>
          <tei:l>וְדַבְּקֵנוּ בְּיֵצֶר הַטוֹב</tei:l>
          <tei:l>וּבְמַעֲשִׂים טוֹבִים,</tei:l>
          <tei:l>וְכֹף אֶת יִצְרֵנוּ</tei:l>
          <tei:l>לְהִשְׁתַּעְבֶּד לָךְ,</tei:l>
          <tei:l>וּתְנֵנוּ הַיּוֹם</tei:l>
          <tei:l>וּבְכָל יוֹם</tei:l>
          <tei:l>לְחֵן</tei:l>
          <tei:l>וּלְחֶסֶד וּלְרַחֲמִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_gomel_chasadim_tovim_leamo_yisrael/1/5"/>
        <tei:lg>
          <tei:l>בְּעֵינֶיךָ</tei:l>
          <tei:l>וּבְעֵינֵי כָל רוֹאֵינוּ,</tei:l>
          <tei:l>וְתִגְמְלֵנוּ חֲסָדִים טוֹבִים,</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה</tei:l>
          <tei:l>הַגּוֹמֵל חֲסָדִים טוֹבִים</tei:l>
          <tei:l>לְעַמּוֹ יִשְׂרָאֵל׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
