  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_cessation_of_the_disease_now_raging_gaster">
        <tei:head>תפלה על המגפה שתעצר</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_cessation_of_the_disease_now_raging_gaster/1"/>
        <tei:lg>
          <tei:l>אֵל מֶלֶךְ רַחוּם וְחַנּוּן,</tei:l>
          <tei:l>אֲשֶׁר בְּיָדְךָ נֶפֶשׁ כׇּל חָי</tei:l>
          <tei:l>וְרוּחַ כׇּל בְּשַׂר אִישׁ,</tei:l>
          <tei:l>מֵמִית וּמְחַיֶּה</tei:l>
          <tei:l>מוֹרִיד שְׁאוֹל וּמַעֲלֶה,</tei:l>
          <tei:l>הַבִּיטָה מִמְּעוֹן קָדְשְׁךָ וּרְאֵה</tei:l>
          <tei:l>כִּי עָלָה מָוֶת בְּחַלּוֹנֵינוּ</tei:l>
          <tei:l>בָּא בְּאַרְמְנוֹתֵינוּ</tei:l>
          <tei:l>לְהַכְרִית עוֹלָל מִחוּץ</tei:l>
          <tei:l>וּבַחוּרִים מֵרְחֹבוֹת, <tei:bibl>(ירמיה ט:כ)</tei:bibl></tei:l>
          <tei:l>מִבְּכוֹר הַמֶּלֶךְ הַיּוֹשֵׁב עַל כִּסְאוֹ</tei:l>
          <tei:l>עַד בְּכוֹר הַשְּׁבִי אֲשֶׁר בְּבֵית הַבּוֹר, <tei:bibl>(שמות יב:כט)</tei:bibl></tei:l>
          <tei:l>כׇּל רֹאשׁ לָחֳלִי</tei:l>
          <tei:l>וְכׇל לֵבָב דַּוָּי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_cessation_of_the_disease_now_raging_gaster/2"/>
        <tei:lg>
          <tei:l>אֲהָהּ אֱלֹהִים!</tei:l>
          <tei:l>שׁוּב מֵהֲרוֹן אַפֶּיךָ</tei:l>
          <tei:l>וֶאֱמוֹר לְמַלְאָךְ הַמַּשְׁחִית</tei:l>
          <tei:l>רַב עַתָּה הֶרֶף יָדֶיךָ׃ <tei:bibl>(שמואל ב׳ כד:טז חלק)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_cessation_of_the_disease_now_raging_gaster/3"/>
        <tei:lg>
          <tei:l>רְפָאֵנוּ ה׳ וְנֵרָפֵא</tei:l>
          <tei:l>הוֹשִׁיעֵנוּ וְנִוָּשֵׁעַ,</tei:l>
          <tei:l>הַעֲלֵה רְפוּאָה לְתַחֲלוּאֵינוּ</tei:l>
          <tei:l>חֲבוֹשׁ אֶת מַכְּתֵינוּ,</tei:l>
          <tei:l>הָסֵר חֹלִי וּמַדְוֶה מִקִּרְבֵּנוּ,</tei:l>
          <tei:l>מְחֵה דִמְעָה מֵעַל כׇּל פָּנִים</tei:l>
          <tei:l>וְשַׁלֵּם נִחוּמִים לָנוּ וְלַאֲבֵלֵינוּ,</tei:l>
          <tei:l>שְׁלַח לָנוּ מַרְפֵּא אֲרוּכָה מַרְפֵּא בְרָכָה מַרְפֵּא רַחֲמִים</tei:l>
          <tei:l>וְשָׁלוֹם וְחַיִּים וְאוֹרֶךְ יָמִים,</tei:l>
          <tei:l>וְכֵן יְהִי רָצוֹן</tei:l>
          <tei:l>וְנֹאמַר אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
