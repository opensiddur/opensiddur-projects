  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:that_americas_heroes_shall_not_have_died_in_vain_kaplan">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:that_americas_heroes_shall_not_have_died_in_vain_kaplan/16"/>
        <tei:lg>
          <tei:l>אֵל מָלֵא רַחֲמִים שׁוֹכֵן בַּמְּרוֹמִים</tei:l>
          <tei:l>הַמְצֵא מְנוּחָה נְכוֹנָה תַּֽחַת כַּנְפֵי הַשְּׁכִינָה.</tei:l>
          <tei:l>בְּמַעֲלוֹת קְדוֹשִׁים וּטְהוֹרִים</tei:l>
          <tei:l>כְּזֹֽהַר הָרָקִֽיעַ מַזְהִירִים.</tei:l>
          <tei:l>לְנִשְׁמוֹת אֵֽלֶּה שֶׁמָּסְרוּ נַפְשָׁם</tei:l>
          <tei:l>בְּעַד אַמֶרִיקָה וּשְׁאִפוֹתֶיהָ הַנַּעֲלוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:that_americas_heroes_shall_not_have_died_in_vain_kaplan/17"/>
        <tei:lg>
          <tei:l>אָנָּא בַּֽעַל הָרַחֲמִים.</tei:l>
          <tei:l>הַסְתִּירֵם בְּסֵֽתֶר כְּנָפֶֽיךָ לְעוֹלָמִים.</tei:l>
          <tei:l>וְתִצְרוֹר בִּצְרוֹר הַחַיִּים אֶת־נִשְׁמָתָם.</tei:l>
          <tei:l>אַתָּה הוּא נַחֲלָתָם.</tei:l>
          <tei:l>וְנֹאמַר אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
