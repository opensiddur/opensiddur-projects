    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:the_7_noachide_commands_varady">
        <tei:head>שֶׁבַע מִצְוֺת בְּנֵי נֹחַ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_7_noachide_commands_varady/1"/>
        <tei:lg>
          <tei:l>
            <tei:bibl>סנהדרין נ״ו ב</tei:bibl>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_7_noachide_commands_varady/2"/>
        <tei:lg>
          <tei:l>רַבִּי יְהוּדָה [בַּר אִלְעָאי] אוֹמֵר</tei:l>
          <tei:l>אָדָם הָרִאשׁוֹן לֹא נִצְטַוָּה</tei:l>
          <tei:l>אֶלָּא עַל עֲבוֹדָה זָרָה בִּלְבַד</tei:l>
          <tei:l>שֶׁנֶּאֱמַר וַיְצַו ה׳ אֱלֹהִים עַל־הָאָדָם</tei:l>
          <tei:l>לֵאמֹר מִכֹּל עֵץ־הַגָּן</tei:l>
          <tei:l>אָכֹל תֹּאכֵל׃</tei:l>
          <tei:l>וּמֵעֵץ הַדַּעַת טוֹב וָרָע</tei:l>
          <tei:l>לֹא תֹאכַל מִמֶּנּוּ <tei:bibl>(בראשית ב:טז-יז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_7_noachide_commands_varady/3"/>
        <tei:lg>
          <tei:l>רַבִּי יְהוּדָה בֶּן בְּתִירָה אוֹמֵר</tei:l>
          <tei:l>אַף עַל בִּרְכַּת הַשֵּׁם <tei:bibl>(בראשית ד:כו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_7_noachide_commands_varady/4"/>
        <tei:lg>
          <tei:l>וְיֵשׁ אוֹמְרִים</tei:l>
          <tei:l>אַף עַל הַדִּינִים <tei:bibl>(בראשית יח:יט-כא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_7_noachide_commands_varady/5"/>
        <tei:lg>
          <tei:l>
            <tei:bibl>סנהדרין נ״ו ב</tei:bibl>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_7_noachide_commands_varady/6"/>
        <tei:lg>
          <tei:l>דְתָנָא דְבֵי מְנַשֶּׁה</tei:l>
          <tei:l>שֶׁבַע מִצְוֺת נִצְטַוּוּ בְּנֵי נֹחַ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_7_noachide_commands_varady/7"/>
        <tei:lg>
          <tei:l>1. עֲבוֹדָה זָרָה <tei:bibl>(בראשית ב:טז-יז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_7_noachide_commands_varady/8"/>
        <tei:lg>
          <tei:l>2. וְגִלּוּי עֲרָיוֹת <tei:bibl>(בראשית ו:יב, בראשית ו:ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_7_noachide_commands_varady/9"/>
        <tei:lg>
          <tei:l>3. וּשְׁפִיכוּת דָּמִים <tei:bibl>(בראשית ד:יא, בראשית ט:ו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_7_noachide_commands_varady/10"/>
        <tei:lg>
          <tei:l>4. גֶּזֶל <tei:bibl>(בראשית ב:טז-יז; בראשית ו:ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_7_noachide_commands_varady/11"/>
        <tei:lg>
          <tei:l>5. וְאֵבֶר מִן הֶחַי <tei:bibl>(בראשית ט:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_7_noachide_commands_varady/12"/>
        <tei:lg>
          <tei:l>6. סֵרוּס <tei:bibl>(בראשית ט:כד, ישעיה נו:ג-ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_7_noachide_commands_varady/13"/>
        <tei:lg>
          <tei:l>7. וְכִּלְאַיִם <tei:bibl>(ישעיה מב:כב, בראשית ו:יט-כא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_7_noachide_commands_varady/14"/>
        <tei:lg>
          <tei:l>
            <tei:bibl>סנהדרין נ״ו א</tei:bibl>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_7_noachide_commands_varady/15"/>
        <tei:lg>
          <tei:l>רַבִּי חֲנַנְיָה בֶּן (גְּמָלָא) אוֹמֵר</tei:l>
          <tei:l>אַף עַל הַדָּם מִן הֶחָי <tei:bibl>(בראשית ט:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_7_noachide_commands_varady/16"/>
        <tei:lg>
          <tei:l>רַבִּי שִׁמְעוֹן אוֹמֵר</tei:l>
          <tei:l>אַף עַל הַכִּשּׁוּף <tei:bibl>(דברים יח:ט-יב)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
