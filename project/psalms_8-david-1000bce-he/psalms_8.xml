      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/8">
        <tei:head>תהלים ח׳ בלשון לאדינו</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/8/1-10"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">א</tei:hi> לַמְנַצֵּ֥חַ</tei:l>
          <tei:l>עַֽל־הַגִּתִּ֗ית</tei:l>
          <tei:l>מִזְמ֥וֹר לְדָוִֽד׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ב</tei:hi> יְהוָ֤ה אֲדֹנֵ֗ינוּ</tei:l>
          <tei:l>מָֽה־אַדִּ֣יר שִׁ֭מְךָ בְּכָל־הָאָ֑רֶץ</tei:l>
          <tei:l>אֲשֶׁ֥ר תְּנָ֥ה ה֝וֹדְךָ֗ עַל־הַשָּׁמָֽיִם׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ג</tei:hi> מִפִּ֤י עֽוֹלְלִ֨ים ׀ וְֽיֹנְקִים֮ יִסַּ֪דְתָּ֫ עֹ֥ז לְמַ֥עַן צוֹרְרֶ֑יךָ</tei:l>
          <tei:l>לְהַשְׁבִּ֥ית א֝וֹיֵ֗ב וּמִתְנַקֵּֽם׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ד</tei:hi> כִּֽי־אֶרְאֶ֣ה שָׁ֭מֶיךָ</tei:l>
          <tei:l>מַעֲשֵׂ֣י אֶצְבְּעֹתֶ֑יךָ</tei:l>
          <tei:l>יָרֵ֥חַ וְ֝כוֹכָבִ֗ים אֲשֶׁ֣ר כּוֹנָֽנְתָּה׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ה</tei:hi> מָֽה־אֱנ֥וֹשׁ כִּֽי־תִזְכְּרֶ֑נּוּ</tei:l>
          <tei:l>וּבֶן־אָ֝דָ֗ם כִּ֣י תִפְקְדֶֽנּוּ׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ו</tei:hi> וַתְּחַסְּרֵ֣הוּ מְּ֭עַט מֵאֱלֹהִ֑ים</tei:l>
          <tei:l>וְכָב֖וֹד וְהָדָ֣ר תְּעַטְּרֵֽהוּ׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ז</tei:hi> תַּ֭מְשִׁילֵהוּ בְּמַעֲשֵׂ֣י יָדֶ֑יךָ</tei:l>
          <tei:l>כֹּ֝ל שַׁ֣תָּה תַֽחַת־רַגְלָֽיו׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ח</tei:hi> צֹנֶ֣ה וַאֲלָפִ֣ים כֻּלָּ֑ם</tei:l>
          <tei:l>וְ֝גַ֗ם בַּהֲמ֥וֹת שָׂדָֽי׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ט</tei:hi> צִפּ֣וֹר שָׁ֭מַיִם</tei:l>
          <tei:l>וּדְגֵ֣י הַיָּ֑ם</tei:l>
          <tei:l>עֹ֝בֵ֗ר אָרְח֥וֹת יַמִּֽים׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">י</tei:hi> יְהוָ֥ה אֲדֹנֵ֑ינוּ</tei:l>
          <tei:l>מָֽה־אַדִּ֥יר שִׁ֝מְךָ֗ בְּכָל־הָאָֽרֶץ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
