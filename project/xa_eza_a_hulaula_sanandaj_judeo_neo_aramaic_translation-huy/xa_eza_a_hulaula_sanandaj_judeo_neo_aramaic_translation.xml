  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:xa_eza_a_hulaula_sanandaj_judeo_neo_aramaic_translation">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:xa_eza_a_hulaula_sanandaj_judeo_neo_aramaic_translation/1"/>
        <tei:lg>
          <tei:l>xa ʾəzza, xa ʾəzza</tei:l>
          <tei:l>tati šəqlale</tei:l>
          <tei:l>tre šahiye<tei:anchor xml:id="note_1"/></tei:l>
          <tei:l>xa ʾəzza, xa ʾəzza</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:xa_eza_a_hulaula_sanandaj_judeo_neo_aramaic_translation/2"/>
        <tei:lg>
          <tei:l>hiya qaṭu</tei:l>
          <tei:l>ʾəzzonăke xilale</tei:l>
          <tei:l>ʾəzzonăke tati šəqlale</tei:l>
          <tei:l>tre šahiye</tei:l>
          <tei:l>xa ʾəzza, xa ʾəzza</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:xa_eza_a_hulaula_sanandaj_judeo_neo_aramaic_translation/3"/>
        <tei:lg>
          <tei:l>hiye kalba</tei:l>
          <tei:l>qaṭwăke ngzale<tei:anchor xml:id="note_2"/></tei:l>
          <tei:l>ke ʾəzzonăke xilale</tei:l>
          <tei:l>ʾəzzonăke tati šəqlale</tei:l>
          <tei:l>tre šahiye</tei:l>
          <tei:l>xa ʾəzza, xa ʾəzza</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:xa_eza_a_hulaula_sanandaj_judeo_neo_aramaic_translation/4"/>
        <tei:lg>
          <tei:l>hiye ṣiwa</tei:l>
          <tei:l>kalbăke dile</tei:l>
          <tei:l>ke qaṭwăke ngzale</tei:l>
          <tei:l>ke ʾəzzonăke xilale</tei:l>
          <tei:l>ʾəzzonăke tati šəqlale</tei:l>
          <tei:l>tre šahiye</tei:l>
          <tei:l>xa ʾəzza, xa ʾəzza</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:xa_eza_a_hulaula_sanandaj_judeo_neo_aramaic_translation/5"/>
        <tei:lg>
          <tei:l>hiye nura</tei:l>
          <tei:l>ṣiwăke məqle</tei:l>
          <tei:l>ke kalbăke dile</tei:l>
          <tei:l>ke qaṭwăke ngzale</tei:l>
          <tei:l>ke ʾəzzonăke xilale</tei:l>
          <tei:l>ʾəzzonăke tati šəqlale</tei:l>
          <tei:l>tre šahiye</tei:l>
          <tei:l>xa ʾəzza, xa ʾəzza</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:xa_eza_a_hulaula_sanandaj_judeo_neo_aramaic_translation/6"/>
        <tei:lg>
          <tei:l>hiyen mae</tei:l>
          <tei:l>nurăke mtixlu</tei:l>
          <tei:l>ke ṣiwăke məqle</tei:l>
          <tei:l>ke kalbăke dile</tei:l>
          <tei:l>ke qaṭwăke ngzale</tei:l>
          <tei:l>ke ʾəzzonăke xilale</tei:l>
          <tei:l>ʾəzzonăke tati šəqlale</tei:l>
          <tei:l>tre šahiye</tei:l>
          <tei:l>xa ʾəzza, xa ʾəzza</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:xa_eza_a_hulaula_sanandaj_judeo_neo_aramaic_translation/7"/>
        <tei:lg>
          <tei:l>hiya torta</tei:l>
          <tei:l>make štenila</tei:l>
          <tei:l>ke nurăke mtixlu</tei:l>
          <tei:l>ke ṣiwăke məqle</tei:l>
          <tei:l>ke kalbăke dile</tei:l>
          <tei:l>ke qaṭwăke ngzale</tei:l>
          <tei:l>ke ʾəzzonăke xilale</tei:l>
          <tei:l>ʾəzzonăke tati šəqlale</tei:l>
          <tei:l>tre šahiye</tei:l>
          <tei:l>xa ʾəzza, xa ʾəzza</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:xa_eza_a_hulaula_sanandaj_judeo_neo_aramaic_translation/8"/>
        <tei:lg>
          <tei:l>hiye qăṣāb</tei:l>
          <tei:l>tortăke dəbḥale</tei:l>
          <tei:l>ke make štenila</tei:l>
          <tei:l>ke nurăke mtixlu</tei:l>
          <tei:l>ke ṣiwăke məqle</tei:l>
          <tei:l>ke kalbăke dile</tei:l>
          <tei:l>ke qaṭwăke ngzale</tei:l>
          <tei:l>ke ʾəzzonăke xilale</tei:l>
          <tei:l>ʾəzzonăke tati šəqlale</tei:l>
          <tei:l>tre šahiye</tei:l>
          <tei:l>xa ʾəzza, xa ʾəzza</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:xa_eza_a_hulaula_sanandaj_judeo_neo_aramaic_translation/9"/>
        <tei:lg>
          <tei:l>hiya frišta mola</tei:l>
          <tei:l>qăṣābăke dəbḥale</tei:l>
          <tei:l>ke tortăke dəbḥale</tei:l>
          <tei:l>ke make štenila</tei:l>
          <tei:l>ke nurăke mtixlu</tei:l>
          <tei:l>ke ṣiwăke məqle</tei:l>
          <tei:l>ke kalbăke dile</tei:l>
          <tei:l>ke qaṭwăke ngzale</tei:l>
          <tei:l>ke ʾəzzonăke xilale</tei:l>
          <tei:l>ʾəzzonăke tati šəqlale</tei:l>
          <tei:l>tre šahiye</tei:l>
          <tei:l>xa ʾəzza, xa ʾəzza</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:xa_eza_a_hulaula_sanandaj_judeo_neo_aramaic_translation/10"/>
        <tei:lg>
          <tei:l>hiye haqadoš barux hu</tei:l>
          <tei:l>frišta molăke dəbḥale</tei:l>
          <tei:l>ke qăṣābăke dəbḥale</tei:l>
          <tei:l>ke tortăke dəbḥale</tei:l>
          <tei:l>ke make štenila</tei:l>
          <tei:l>ke nurăke mtixlu</tei:l>
          <tei:l>ke ṣiwăke məqle</tei:l>
          <tei:l>ke kalbăke dile</tei:l>
          <tei:l>ke qaṭwăke ngzale</tei:l>
          <tei:l>ke ʾəzzonăke xilale</tei:l>
          <tei:l>ʾəzzonăke tati šəqlale</tei:l>
          <tei:l>tre šahiye</tei:l>
          <tei:l>xa ʾəzza, xa ʾəzza</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" n="1" target="#note_1">
      <tei:p>In Alan Niku’s text, <tei:hi rend="italic">zuze</tei:hi>. Here changed to the local currency, the <tei:hi rend="italic">šahi</tei:hi>.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="2" target="#note_2">
      <tei:p>In Alan Niku’s text, xilale — “ate it.” Here changed to the word for “bit it.”</tei:p>
    </tei:note>
  </tei:standOff>
</tei:TEI>