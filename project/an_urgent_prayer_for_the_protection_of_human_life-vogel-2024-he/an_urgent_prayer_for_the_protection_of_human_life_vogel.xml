  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:an_urgent_prayer_for_the_protection_of_human_life_vogel">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:an_urgent_prayer_for_the_protection_of_human_life_vogel/1"/>
        <tei:lg>
          <tei:l>אֱלֹהֵינוּ אֱלֹהֵי כָל בָּשָר</tei:l>
          <tei:l>יוֹצְרֵֽנוּ יוֹצֵר בְּרֵאשִׁית</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:an_urgent_prayer_for_the_protection_of_human_life_vogel/3"/>
        <tei:lg>
          <tei:l>אֲשֶׁר יַעֲשֶׂה אֹתָם הָאָדָם וָחַי בָּהֶם <tei:bibl>(ויקרא יח:ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:an_urgent_prayer_for_the_protection_of_human_life_vogel/11"/>
        <tei:lg>
          <tei:l>סוּר מֵרָע וַעֲשֵׂה־טוֹב</tei:l>
          <tei:l>בַּקֵּשׁ שָלוֹם וְרָדְפֵֽהוּ <tei:bibl>(תהלים לד:טו)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
