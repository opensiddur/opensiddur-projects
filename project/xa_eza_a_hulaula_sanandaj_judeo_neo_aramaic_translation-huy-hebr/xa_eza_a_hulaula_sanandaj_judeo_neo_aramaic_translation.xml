    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:xa_eza_a_hulaula_sanandaj_judeo_neo_aramaic_translation">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:xa_eza_a_hulaula_sanandaj_judeo_neo_aramaic_translation/1"/>
        <tei:lg>
          <tei:l>כַא עְזַּא, כַא עְזַּא</tei:l>
          <tei:l>תַּתִּי שְׁקְלַלֵי</tei:l>
          <tei:l>תְּרֵי שַׁהִיֵי</tei:l>
          <tei:l>כַא עְזַּא, כַא עְזַּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:xa_eza_a_hulaula_sanandaj_judeo_neo_aramaic_translation/2"/>
        <tei:lg>
          <tei:l>הִיַא קַטוּ</tei:l>
          <tei:l>עְזּוֹנֲכֵּי כִילַלֵי</tei:l>
          <tei:l>עְזּוֹנֲכֵּי תַּתִּי שְׁקְלַלֵי</tei:l>
          <tei:l>תְּרֵי שַׁהִיֵי</tei:l>
          <tei:l>כַא עְזַּא, כַא עְזַּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:xa_eza_a_hulaula_sanandaj_judeo_neo_aramaic_translation/3"/>
        <tei:lg>
          <tei:l>הִיֵי כַּלְבַּא</tei:l>
          <tei:l>קַטְוֲכֵּי נְגְזַלֵי</tei:l>
          <tei:l>כֵּעְזּוֹנֲכֵּי כִילַלֵי</tei:l>
          <tei:l>עְזּוֹנֲכֵּי תַּתִּי שְׁקְלַלֵי</tei:l>
          <tei:l>תְּרֵי שַׁהִיֵי</tei:l>
          <tei:l>כַא עְזַּא, כַא עְזַּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:xa_eza_a_hulaula_sanandaj_judeo_neo_aramaic_translation/4"/>
        <tei:lg>
          <tei:l>הִיֵי צִיוַא</tei:l>
          <tei:l>כַּלְבֲּכֵּי דִּילֵי</tei:l>
          <tei:l>כֵּקַטְוֲכֵּי נְגְזַלֵי</tei:l>
          <tei:l>כֵּעְזּוֹנֲכֵּי כִילַלֵי</tei:l>
          <tei:l>עְזּוֹנֲכֵּי תַּתִּי שְׁקְלַלֵי</tei:l>
          <tei:l>תְּרֵי שַׁהִיֵי</tei:l>
          <tei:l>כַא עְזַּא, כַא עְזַּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:xa_eza_a_hulaula_sanandaj_judeo_neo_aramaic_translation/5"/>
        <tei:lg>
          <tei:l>הִיֵי נוּרַא</tei:l>
          <tei:l>צִיוֲכֵּי מְקְלֵי</tei:l>
          <tei:l>כֵּכַּלְבֲּכֵּי דִּילֵי</tei:l>
          <tei:l>כֵּקַטְוֲכֵּי נְגְזַלֵי</tei:l>
          <tei:l>כֵּעְזּוֹנֲכֵּי כִילַלֵי</tei:l>
          <tei:l>עְזּוֹנֲכֵּי תַּתִּי שְׁקְלַלֵי</tei:l>
          <tei:l>תְּרֵי שַׁהִיֵי</tei:l>
          <tei:l>כַא עְזַּא, כַא עְזַּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:xa_eza_a_hulaula_sanandaj_judeo_neo_aramaic_translation/6"/>
        <tei:lg>
          <tei:l>הִיֵין מַאֵי</tei:l>
          <tei:l>נוּרֲכֵּי מְתִּכְלוּ</tei:l>
          <tei:l>כֵּצִיוֲכֵּי מְקְלֵי</tei:l>
          <tei:l>כֵּכַּלְבֲּכֵּי דִּילֵי</tei:l>
          <tei:l>כֵּקַטְוֲכֵּי נְגְזַלֵי</tei:l>
          <tei:l>כֵּעְזּוֹנֲכֵּי כִילַלֵי</tei:l>
          <tei:l>עְזּוֹנֲכֵּי תַּתִּי שְׁקְלַלֵי</tei:l>
          <tei:l>תְּרֵי שַׁהִיֵי</tei:l>
          <tei:l>כַא עְזַּא, כַא עְזַּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:xa_eza_a_hulaula_sanandaj_judeo_neo_aramaic_translation/7"/>
        <tei:lg>
          <tei:l>הִיַא תּוֹרְתַּא</tei:l>
          <tei:l>מַכֵּי שְׁתֵּנִילַה</tei:l>
          <tei:l>כֵּנוּרֲכֵּי מְתִּכְלוּ</tei:l>
          <tei:l>כֵּצִיוֲכֵּי מְקְלֵי</tei:l>
          <tei:l>כֵּכַּלְבֲּכֵּי דִּילֵי</tei:l>
          <tei:l>כֵּקַטְוֲכֵּי נְגְזַלֵי</tei:l>
          <tei:l>כֵּעְזּוֹנֲכֵּי כִילַלֵי</tei:l>
          <tei:l>עְזּוֹנֲכֵּי תַּתִּי שְׁקְלַלֵי</tei:l>
          <tei:l>תְּרֵי שַׁהִיֵי</tei:l>
          <tei:l>כַא עְזַּא, כַא עְזַּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:xa_eza_a_hulaula_sanandaj_judeo_neo_aramaic_translation/8"/>
        <tei:lg>
          <tei:l>הִיֵי קֲצַאבּ</tei:l>
          <tei:l>תּוֹרְתֲּכֵּי דְּבְּחַלֵי</tei:l>
          <tei:l>כֵּמַכֵּי שְׁתֵּנִילַה</tei:l>
          <tei:l>כֵּנוּרֲכֵּי מְתִּכְלוּ</tei:l>
          <tei:l>כֵּצִיוֲכֵּי מְקְלֵי</tei:l>
          <tei:l>כֵּכַּלְבֲּכֵּי דִּילֵי</tei:l>
          <tei:l>כֵּקַטְוֲכֵּי נְגְזַלֵי</tei:l>
          <tei:l>כֵּעְזּוֹנֲכֵּי כִילַלֵי</tei:l>
          <tei:l>עְזּוֹנֲכֵּי תַּתִּי שְׁקְלַלֵי</tei:l>
          <tei:l>תְּרֵי שַׁהִיֵי</tei:l>
          <tei:l>כַא עְזַּא, כַא עְזַּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:xa_eza_a_hulaula_sanandaj_judeo_neo_aramaic_translation/9"/>
        <tei:lg>
          <tei:l>הִיַא פְרִישְׁתַּא מוֹלַא</tei:l>
          <tei:l>קֲצַאבֲּכֵּי דְּבְּחַלֵי</tei:l>
          <tei:l>כֵּתּוֹרְתֲּכֵּי דְּבְּחַלֵי</tei:l>
          <tei:l>כֵּמַכֵּי שְׁתֵּנִילַה</tei:l>
          <tei:l>כֵּנוּרֲכֵּי מְתִּכְלוּ</tei:l>
          <tei:l>כֵּצִיוֲכֵּי מְקְלֵי</tei:l>
          <tei:l>כֵּכַּלְבֲּכֵּי דִּילֵי</tei:l>
          <tei:l>כֵּקַטְוֲכֵּי נְגְזַלֵי</tei:l>
          <tei:l>כֵּעְזּוֹנֲכֵּי כִילַלֵי</tei:l>
          <tei:l>עְזּוֹנֲכֵּי תַּתִּי שְׁקְלַלֵי</tei:l>
          <tei:l>תְּרֵי שַׁהִיֵי</tei:l>
          <tei:l>כַא עְזַּא, כַא עְזַּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:xa_eza_a_hulaula_sanandaj_judeo_neo_aramaic_translation/10"/>
        <tei:lg>
          <tei:l>הִיֵי הַקָּדוֹשׁ בָּרוּךְ הוּא</tei:l>
          <tei:l>פְרִישְׁתַּא מוֹלֲכֵּי דְּבְּחַלֵי</tei:l>
          <tei:l>כֵּקֲצַאבֲּכֵּי דְּבְּחַלֵי</tei:l>
          <tei:l>כֵּתּוֹרְתֲּכֵּי דְּבְּחַלֵי</tei:l>
          <tei:l>כֵּמַכֵּי שְׁתֵּנִילַה</tei:l>
          <tei:l>כֵּנוּרֲכֵּי מְתִּכְלוּ</tei:l>
          <tei:l>כֵּצִיוֲכֵּי מְקְלֵי</tei:l>
          <tei:l>כֵּכַּלְבֲּכֵּי דִּילֵי</tei:l>
          <tei:l>כֵּקַטְוֲכֵּי נְגְזַלֵי</tei:l>
          <tei:l>כֵּעְזּוֹנֲכֵּי כִילַלֵי</tei:l>
          <tei:l>עְזּוֹנֲכֵּי תַּתִּי שְׁקְלַלֵי</tei:l>
          <tei:l>תְּרֵי שַׁהִיֵי</tei:l>
          <tei:l>כַא עְזַּא, כַא עְזַּא׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
