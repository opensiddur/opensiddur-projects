    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:awa_fwampoptsyip">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:awa_fwampoptsyip/1"/>
        <tei:lg>
          <tei:l>אָוָה פְֿוָמְבוֹבְצְיִב, אָוָה פְֿוָמְבוֹבְצְיִב,</tei:l>
          <tei:l>אָֿה כוֹלָנוֹם אֿוֹאֶֿיַה סֶמְבוּלִל מֶתוֹלַרְיוֹאָה,</tei:l>
          <tei:l>אָוָה פְֿוָמְבוֹבְצְיִב, אָוָה פְֿוָמְבוֹבְצְיִב׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:awa_fwampoptsyip/2"/>
        <tei:lg>
          <tei:l>צָכרּ זָאוּ רִיתִי</tei:l>
          <tei:l>אֿוּלְתֶה יוֹם פְֿוָמְבוֹבְצְיִבִּית</tei:l>
          <tei:l>אָֿה כוֹלָנוֹם אֿוֹאֶֿיַה סֶמְבוּלִל מֶתוֹלַרְיוֹאָה,</tei:l>
          <tei:l>אָוָה פְֿוָמְבוֹבְצְיִב, אָוָה פְֿוָמְבוֹבְצְיִב׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:awa_fwampoptsyip/3"/>
        <tei:lg>
          <tei:l>צָכרּ זָאוּ נָנְתָע,</tei:l>
          <tei:l>אֿוּלְתֶה פְֿרִב רִיתִית,</tei:l>
          <tei:l>אָה יוֹם פְֿוָמְבוֹבְצְיִבִּית,</tei:l>
          <tei:l>אָֿה כוֹלָנוֹם אֿוֹאֶֿיַה סֶמְבוּלִל מֶתוֹלַרְיוֹאָה,</tei:l>
          <tei:l>אָוָה פְֿוָמְבוֹבְצְיִב, אָוָה פְֿוָמְבוֹבְצְיִב׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:awa_fwampoptsyip/4"/>
        <tei:lg>
          <tei:l>צָכרּ זָאוּ בֿוּלְצְיִב,</tei:l>
          <tei:l>אֿוּלְתֶה תָכוּך נָנְתָעִית,</tei:l>
          <tei:l>אָה פְֿרִב רִיתִית,</tei:l>
          <tei:l>אָה יוֹם פְֿוָמְבוֹבְצְיִבִּית,</tei:l>
          <tei:l>אָֿה כוֹלָנוֹם אֿוֹאֶֿיַה סֶמְבוּלִל מֶתוֹלַרְיוֹאָה,</tei:l>
          <tei:l>אָוָה פְֿוָמְבוֹבְצְיִב, אָוָה פְֿוָמְבוֹבְצְיִב׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:awa_fwampoptsyip/5"/>
        <tei:lg>
          <tei:l>צָכרּ זָאוּ טֶב</tei:l>
          <tei:l>אֿוּלְתֶה נֶק בֿוּלְצְיִבִית,</tei:l>
          <tei:l>אָה תָכוּך נָנְתָעִית,</tei:l>
          <tei:l>אָה פְֿרִב רִיתִית,</tei:l>
          <tei:l>אָה יוֹם פְֿוָמְבוֹבְצְיִבִּית,</tei:l>
          <tei:l>אָֿה כוֹלָנוֹם אֿוֹאֶֿיַה סֶמְבוּלִל מֶתוֹלַרְיוֹאָה,</tei:l>
          <tei:l>אָוָה פְֿוָמְבוֹבְצְיִב, אָוָה פְֿוָמְבוֹבְצְיִב׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:awa_fwampoptsyip/6"/>
        <tei:lg>
          <tei:l>צָכרּ זָאוּ בָי</tei:l>
          <tei:l>אֿוּלְתֶה תוֹע טֶבִית</tei:l>
          <tei:l>אָה נֶק בֿוּלְצְיִבִית,</tei:l>
          <tei:l>אָה תָכוּך נָנְתָעִית,</tei:l>
          <tei:l>אָה פְֿרִב רִיתִית,</tei:l>
          <tei:l>אָה יוֹם פְֿוָמְבוֹבְצְיִבִּית,</tei:l>
          <tei:l>אָֿה כוֹלָנוֹם אֿוֹאֶֿיַה סֶמְבוּלִל מֶתוֹלַרְיוֹאָה,</tei:l>
          <tei:l>אָוָה פְֿוָמְבוֹבְצְיִב, אָוָה פְֿוָמְבוֹבְצְיִב׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:awa_fwampoptsyip/7"/>
        <tei:lg>
          <tei:l>צָכרּ זָאוּ תָלִיאוֹאָע</tei:l>
          <tei:l>אֿוּלְתֶה נַך בָיִית</tei:l>
          <tei:l>אָה תוֹע טֶבִית</tei:l>
          <tei:l>אָה נֶק בֿוּלְצְיִבִית,</tei:l>
          <tei:l>אָה תָכוּך נָנְתָעִית,</tei:l>
          <tei:l>אָה פְֿרִב רִיתִית,</tei:l>
          <tei:l>אָה יוֹם פְֿוָמְבוֹבְצְיִבִּית,</tei:l>
          <tei:l>אָֿה כוֹלָנוֹם אֿוֹאֶֿיַה סֶמְבוּלִל מֶתוֹלַרְיוֹאָה,</tei:l>
          <tei:l>אָוָה פְֿוָמְבוֹבְצְיִב, אָוָה פְֿוָמְבוֹבְצְיִב׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:awa_fwampoptsyip/8"/>
        <tei:lg>
          <tei:l>צָכרּ זָאוּ תָרוֹנְיוּ,</tei:l>
          <tei:l>אֿוּלְתֶה צְבָע תָלִיאוֹאָעִית,</tei:l>
          <tei:l>אָה נַך בָיִית,</tei:l>
          <tei:l>אָה תוֹע טֶבִית,</tei:l>
          <tei:l>אָה נֶק בֿוּלְצְיִבִית,</tei:l>
          <tei:l>אָה תָכוּך נָנְתָעִית,</tei:l>
          <tei:l>אָה פְֿרִב רִיתִית,</tei:l>
          <tei:l>אָה יוֹם פְֿוָמְבוֹבְצְיִבִּית,</tei:l>
          <tei:l>אָֿה כוֹלָנוֹם אֿוֹאֶֿיַה סֶמְבוּלִל מֶתוֹלַרְיוֹאָה,</tei:l>
          <tei:l>אָוָה פְֿוָמְבוֹבְצְיִב, אָוָה פְֿוָמְבוֹבְצְיִב׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:awa_fwampoptsyip/9"/>
        <tei:lg>
          <tei:l>צָכרּ זָאוּ תִירֶאָה תִתֶרכוּבַה,</tei:l>
          <tei:l>אֿוּלְתֶה צְבָע תָרוֹנְיוּת,</tei:l>
          <tei:l>אָה צְבָע תָלִיאוֹאָעִית,</tei:l>
          <tei:l>אָה נַך בָיִית,</tei:l>
          <tei:l>אָה תוֹע טֶבִית,</tei:l>
          <tei:l>אָה נֶק בֿוּלְצְיִבִית,</tei:l>
          <tei:l>אָה תָכוּך נָנְתָעִית,</tei:l>
          <tei:l>אָה פְֿרִב רִיתִית,</tei:l>
          <tei:l>אָה יוֹם פְֿוָמְבוֹבְצְיִבִּית,</tei:l>
          <tei:l>אָֿה כוֹלָנוֹם אֿוֹאֶֿיַה סֶמְבוּלִל מֶתוֹלַרְיוֹאָה,</tei:l>
          <tei:l>אָוָה פְֿוָמְבוֹבְצְיִב, אָוָה פְֿוָמְבוֹבְצְיִב׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:awa_fwampoptsyip/10"/>
        <tei:lg>
          <tei:l>צָכרּ זָאוּ נָוְמָה סָאנוֹך</tei:l>
          <tei:l>אֿוּלְתֶה צְבָע תִירֶאָת תִתֶרכוּבַה,</tei:l>
          <tei:l>אָה צְבָע תָרוֹנְיוּת,</tei:l>
          <tei:l>אָה צְבָע תָלִיאוֹאָעִית,</tei:l>
          <tei:l>אָה נַך בָיִית,</tei:l>
          <tei:l>אָה תוֹע טֶבִית,</tei:l>
          <tei:l>אָה נֶק בֿוּלְצְיִבִית,</tei:l>
          <tei:l>אָה תָכוּך נָנְתָעִית,</tei:l>
          <tei:l>אָה פְֿרִב רִיתִית,</tei:l>
          <tei:l>אָה יוֹם פְֿוָמְבוֹבְצְיִבִּית,</tei:l>
          <tei:l>אָֿה כוֹלָנוֹם אֿוֹאֶֿיַה סֶמְבוּלִל מֶתוֹלַרְיוֹאָה,</tei:l>
          <tei:l>אָוָה פְֿוָמְבוֹבְצְיִב, אָוָה פְֿוָמְבוֹבְצְיִב׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
