    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:harachaman_for_all_humankind_and_all_living_creatures_schachter">
        <tei:head>הָרַחֲמָן לְכָל אָדָם וְהמְרַחֵם עַל־הַבְּרִיּוֹת</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:harachaman_for_all_humankind_and_all_living_creatures_schachter/1"/>
        <tei:lg>
          <tei:l>הָרַחֲמָן לְכָל אָדָם</tei:l>
          <tei:l>וְהַמְּרַחֵם עַל־הַבְּרִיּוֹת,</tei:l>
          <tei:l>הוּא יָבִיא לָנוּ יְמוֹת הַמָּשִׁיחַ בִּמְהֵרָה בְיָמֵינוּ,</tei:l>
          <tei:l>וִיְחַדֵּשׁ לָנוּ מִנְחַת בֵּית הַמִּקְדָּשׁ בִּמְקוֹמָהּ,</tei:l>
          <tei:l>כָּרָאוּי וּכְנָכוֹן כִּרְצוֹנוֹ,</tei:l>
          <tei:l>לְשֵׁם וְלִתְהִלָּה לְכׇל־הָעַמִּֽים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:harachaman_for_all_humankind_and_all_living_creatures_schachter/2"/>
        <tei:lg>
          <tei:l>כַּכָּתוּב עַל יַד נְבִיאֶךָ:</tei:l>
          <tei:l>בָּעֵ֤ת הַהִיא֙ אָבִ֣יא אֶתְכֶ֔ם</tei:l>
          <tei:l>וּבָעֵ֖ת קַבְּצִ֣י אֶתְכֶ֑ם</tei:l>
          <tei:l>כִּֽי־אֶתֵּ֨ן אֶתְכֶ֜ם לְשֵׁ֣ם וְלִתְהִלָּ֗ה</tei:l>
          <tei:l>בְּכֹל֙ עַמֵּ֣י הָאָ֔רֶץ</tei:l>
          <tei:l>בְּשׁוּבִ֧י אֶת־שְׁבוּתֵיכֶ֛ם</tei:l>
          <tei:l>לְעֵינֵיכֶ֖ם</tei:l>
          <tei:l>אָמַ֥ר יְהוָֽה׃ <tei:bibl>(צפניה ג:כ)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:harachaman_for_all_humankind_and_all_living_creatures_schachter/3"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר:</tei:l>
          <tei:l>וַהֲבִיאוֹתִ֞ים אֶל־הַ֣ר קׇדְשִׁ֗י</tei:l>
          <tei:l>וְשִׂמַּחְתִּים֙ בְּבֵ֣ית תְּפִלָּתִ֔י</tei:l>
          <tei:l>עוֹלֹתֵיהֶ֧ם וְזִבְחֵיהֶ֛ם</tei:l>
          <tei:l>לְרָצ֖וֹן עַֽל־מִזְבְּחִ֑י</tei:l>
          <tei:l>כִּ֣י בֵיתִ֔י בֵּית־תְּפִלָּ֥ה</tei:l>
          <tei:l>יִקָּרֵ֖א לְכׇל־הָעַמִּֽים׃ <tei:bibl>(ישעיה נו:ז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:harachaman_for_all_humankind_and_all_living_creatures_schachter/4"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר:</tei:l>
          <tei:l>וְעָֽרְבָה֙ לַֽיהוָ֔ה</tei:l>
          <tei:l>מִנְחַ֥ת יְהוּדָ֖ה וִירֽוּשָׁלִָ֑ם</tei:l>
          <tei:l>כִּימֵ֣י עֹולָ֔ם וּכְשָׁנִ֖ים קַדְמֹנִיֹּֽות׃ <tei:bibl>(מלאכי ג:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:harachaman_for_all_humankind_and_all_living_creatures_schachter/5"/>
        <tei:lg>
          <tei:l>אָמֵן סֶלָה.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
