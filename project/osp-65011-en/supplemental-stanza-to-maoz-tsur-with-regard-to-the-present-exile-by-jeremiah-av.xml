  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:supplemental_stanza_to_maoz_tsur_with_regard_to_the_present_exile_by_jeremiah_av_beit_din_of_wurzburg">
        <tei:head>Supplemental stanza to Maoz Tsur with regard to the present exile, by Rabbi Yirmiyah, av beit din of Würzburg</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:supplemental_stanza_to_maoz_tsur_with_regard_to_the_present_exile_by_jeremiah_av_beit_din_of_wurzburg/1"/>
        <tei:lg>
          <tei:l>May it be Your will,</tei:l>
          <tei:l><j:divineName>Unique One, splendid and resplendent</j:divineName>:</tei:l>
          <tei:l>redeem the remnant of Your sheep</tei:l>
          <tei:l>from Edom,<tei:anchor xml:id="note_3"/> Ishmael, and Qedar.<tei:anchor xml:id="note_4"/></tei:l>
          <tei:l><j:divineName>Merciful One</j:divineName>, noble in holiness,</tei:l>
          <tei:l>set relief for the flock;</tei:l>
          <tei:l>save Your inheritance,</tei:l>
          <tei:l><j:divineName>Deity of Vengeance</j:divineName>, appear<tei:anchor xml:id="note_5"/></tei:l>
          <tei:l>against Amalek in each generation.<tei:anchor xml:id="note_6"/></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
