    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:benei_afar_mi_manah">
        <tei:head>בְּנֵי עָפָר מִי מָנָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:benei_afar_mi_manah/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אָ</tei:seg>נָּא הוֹשִׁיעָה נָּא</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>נֵי עָפָר מִי מָנָה</tei:l>
          <tei:l><tei:seg type="acrostic">גּ</tei:seg>וֹאֵל הַצְלִיחָה נָא</tei:l>
          <tei:l><tei:seg type="acrostic">דּ</tei:seg>וֹרְשֶֽׁיךָ בְּכׇל עוֹנָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:benei_afar_mi_manah/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הָ</tei:seg>קֵם סֻכַּת דָּוִד הַנֹּפֶֽלֶת</tei:l>
          <tei:l><tei:seg type="acrostic">וּ</tei:seg>בַל תְּהִי עוֹד מָשְׁפֶּֽלֶת</tei:l>
          <tei:l><tei:seg type="acrostic">זְ</tei:seg>כוֹר אֲיֻמָּה הַנִּקְהֶֽלֶת</tei:l>
          <tei:l><tei:seg type="acrostic">ח</tei:seg>וֹפֲפָהּ וּבְצִלְּךָ נֶאֱהָֽלֶת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:benei_afar_mi_manah/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ט</tei:seg>וֹב הַצְמִיחַ שִׂמְחָתָם</tei:l>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>הּ כַּפֵּר אַשְׁמָתָם</tei:l>
          <tei:l><tei:seg type="acrostic">כַּ</tei:seg>לֵּה עַתָּה אַנְחוֹתָם</tei:l>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>מַעַנְךָ חִישׁ פְּדוּתָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:benei_afar_mi_manah/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מַ</tei:seg>לֵּא מִשְׁאֲלוֹת לִבָּם</tei:l>
          <tei:l><tei:seg type="acrostic">נ</tei:seg>וֹאֲקִים אֵלֶיךָ בְּכׇל לְבָבָם</tei:l>
          <tei:l><tei:seg type="acrostic">סָ</tei:seg>מְכֵם וְרִיב רִיבָם</tei:l>
          <tei:l><tei:seg type="acrostic">עַ</tei:seg>תָּה תִשְׁכּוֹן בְּקִרְבָּם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:benei_afar_mi_manah/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פָּ</tei:seg>נֹה תִפְנֶה לְפָאֳרָם</tei:l>
          <tei:l><tei:seg type="acrostic">צ</tei:seg>וּר אֱמוֹר לְעָזְרָם</tei:l>
          <tei:l><tei:seg type="acrostic">ק</tei:seg>וֹמֵם בֵּית הֲדָרָם</tei:l>
          <tei:l><tei:seg type="acrostic">רְ</tei:seg>אוֹתָם פִּתְאֹם שִׂבְרָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:benei_afar_mi_manah/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שָׁ</tei:seg>לֵם מְהֵרָה תִבְָנֶה</tei:l>
          <tei:l>שְׁלֵמֶיךָ בְּכֵן תַּעֲנֶה</tei:l>
          <tei:l><tei:seg type="acrostic">תַּ</tei:seg>כֶּה קָמֶֽיךָ כְּמַכַּת</tei:l>
          <tei:l>בְּכוֹרִים וּתְעַנֶּה</tei:l>
          <tei:l>תִּקְרָעֵם כִּקְרִיעַת יַם</tei:l>
          <tei:l>סוּף וְנִקְרָאֲךָ וְתַעֲנֶה׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
