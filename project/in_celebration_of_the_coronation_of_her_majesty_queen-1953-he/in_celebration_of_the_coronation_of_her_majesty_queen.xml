  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:in_celebration_of_the_coronation_of_her_majesty_queen">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_celebration_of_the_coronation_of_her_majesty_queen/3"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ג</tei:hi> יָפְיָפִ֡יתָ מִבְּנֵ֬י אָדָ֗ם ה֣וּצַק</tei:l>
          <tei:l>חֵ֭ן בְּשְׂפְתוֹתֶ֑יךָ</tei:l>
          <tei:l>עַל־כֵּ֤ן בֵּֽרַכְךָ֖ אֱלֹהִ֣ים לְעוֹלָֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_celebration_of_the_coronation_of_her_majesty_queen/4"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ה</tei:hi> וַהֲדָ֬רְךָ֨ ׀ צְלַ֬ח רְכַ֗ב עַֽל־דְּבַר־אֱ֭מֶת</tei:l>
          <tei:l>וְעַנְוָה־צֶ֑דֶק וְתוֹרְךָ֖ נוֹרָא֣וֹת יְמִינֶֽךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_celebration_of_the_coronation_of_her_majesty_queen/5"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ז</tei:hi> כִּסְאֲךָ֣ אֱ֭לֹהִים עוֹלָ֣ם וָעֶ֑ד</tei:l>
          <tei:l>שֵׁ֥בֶט מִ֝ישֹׁ֗ר שֵׁ֣בֶט מַלְכוּתֶֽךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_celebration_of_the_coronation_of_her_majesty_queen/6"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ח</tei:hi> אָהַ֣בְתָּ צֶּדֶק֮ וַתִּשְׂנָ֫א רֶ֥שַׁע</tei:l>
          <tei:l>עַל־כֵּ֤ן ׀ מְשָׁחֲךָ֡ אֱלֹהִ֣ים אֱ֭לֹהֶיךָ שֶׁ֥מֶן שָׂשׂ֗וֹן מֵֽחֲבֵרֶֽיךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_celebration_of_the_coronation_of_her_majesty_queen/7"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">יד</tei:hi> כָּל־כְּבוּדָּ֣ה בַת־מֶ֣לֶךְ פְּנִ֑ימָה</tei:l>
          <tei:l>מִֽמִּשְׁבְּצ֖וֹת זָהָ֣ב לְבוּשָֽׁהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_celebration_of_the_coronation_of_her_majesty_queen/8"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">יח</tei:hi> אַזְכִּ֣ירָה שִׁ֭מְךָ בְּכָל־דֹּ֣ר וָדֹ֑ר</tei:l>
          <tei:l>עַל־כֵּ֥ן עַמִּ֥ים יְ֝הוֹדֻ֗ךָ לְעֹלָ֥ם וָעֶֽד׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
