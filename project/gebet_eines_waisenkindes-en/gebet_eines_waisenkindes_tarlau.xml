  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:gebet_eines_waisenkindes_tarlau">
        <tei:head>Gebet eines Waisenkindes</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gebet_eines_waisenkindes_tarlau/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">Prayer of an orphan.</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gebet_eines_waisenkindes_tarlau/2"/>
        <tei:lg>
          <tei:l>Father in heaven, my heart is so heavy,</tei:l>
          <tei:l>I am so alone in the world,</tei:l>
          <tei:l>If it weren’t for the hope of You in me,</tei:l>
          <tei:l>I would not be alive anymore.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gebet_eines_waisenkindes_tarlau/3"/>
        <tei:lg>
          <tei:l>Deep in my heart I speak,</tei:l>
          <tei:l>When I walk lonely through the alleys:</tei:l>
          <tei:l>Father and mother left me,</tei:l>
          <tei:l>God will not leave me.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gebet_eines_waisenkindes_tarlau/4"/>
        <tei:lg>
          <tei:l>Father and mother rest</tei:l>
          <tei:l>From many a hardship and complaint,</tei:l>
          <tei:l>Yet I have a father’s house</tei:l>
          <tei:l>Above the din of the earth.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gebet_eines_waisenkindes_tarlau/5"/>
        <tei:lg>
          <tei:l>Yet a father’s hand supports</tei:l>
          <tei:l>Supports me on stony paths</tei:l>
          <tei:l>And will lead me to the eternal homeland</tei:l>
          <tei:l>Lead me full of grace.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gebet_eines_waisenkindes_tarlau/6"/>
        <tei:lg>
          <tei:l>Father in heaven, no child is so yours,</tei:l>
          <tei:l>Like an orphan in sorrow,</tei:l>
          <tei:l>May You be with me protectively</tei:l>
          <tei:l>Now and forever!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
