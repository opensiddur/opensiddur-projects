    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms">
        <tei:head>[בחודש אייר בראשון]</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/1"/>
        <tei:lg>
          <tei:l>[...]<tei:anchor xml:id="note_1"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/2"/>
        <tei:lg>
          <tei:l>[<tei:seg type="acrostic">א</tei:seg>...]<tei:anchor xml:id="note_2"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/3"/>
        <tei:lg>
          <tei:l>[<tei:seg type="acrostic">ב</tei:seg>...]</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">גָּ</tei:seg>ל֣וּי לְ֭פָנֶֽיךָ צַדִּ֣יק וְרָשָׁ֑ע</tei:l>
          <tei:l>וְלֹ֤א תְּבַקֵּ֣שׁ עֲלֵיהֶ֖ם עֵידֵ֣י אָדָֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">דַּ</tei:seg>יָּ֣ן דּ֭וֹרוֹת וְשׁוֹפֵ֣ט בְּצֶ֑דֶק</tei:l>
          <tei:l>י֝וֹדִ֗יעַ בְּדַרְכֵ֥י כׇּל־חַֽי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חָ</tei:seg>פַ֣צְתָּ בְּ֭צֶֽדֶק וּמָאַ֣סְתָּ בְּעָ֑וֶל<tei:anchor xml:id="note_3"/></tei:l>
          <tei:l>וְלֹ֤א יִתְיַצְּב֥וּ ה֝וֹלְלִ֗ים לְנֶ֣גֶד כְּבוֹדֶֽךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>הִבְדַּ֗לְתָּה עוֹלָם֮ בֵּין־חֹ֪שֶׁךְ ל֫א֥וֹר</tei:l>
          <tei:l>וּבֵ֣ין טָ֭מֵא לְטָה֑וֹר וּבֵ֥ין צֶ֝֗דֶק לְשָֽׁקֶר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זָ</tei:seg>רִ֣יתָה מֵ֭עַמְּךָ כׇּל־בְּנֵ֣י זָרִ֑ים</tei:l>
          <tei:l>וְטִהַ֥רְתָּ צֹ֝אנְךָ֗ מִן־חַיָּ֣ה טְמֵאָֽה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חׇ</tei:seg>כְמַ֣ת עֻ֭זְּךָ נָתַ֣תָּה לְעַבְדֶּ֑ךָ</tei:l>
          <tei:l>כִּ֗י מֵבִ֥ין בְּ֝כֻלָּ֗ם כְּחֶפְצֵ֥י רְצוֹנֶֽךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/10"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">טַ֣</tei:seg>עֲתָּה צְדָק֣וֹת בָּאָ֑רֶץ אֱמֶ֣ת</tei:l>
          <tei:l>וּ֝מִשְׁפָּ֗ט הִרְבֵּ֣יתָה בָּעוֹלָמִֽים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/11"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יִֽ</tei:seg>לְמְדוּ־שִׁ֣יר כׇּל־עוֹבְדֵ֣י שְׁמֶ֑ךָ</tei:l>
          <tei:l>אֲשֶׁ֥ר יַ֝אֲמִ֗ינוּ בְּדִבְרֵ֣י עַבְדֶּֽךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/12"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כְּ</tei:seg>נֶ֤גֶד כׇּל־הָ֭אָֽרֶץ יִרְבּ֣וּ צִדְקָתָ֑ם</tei:l>
          <tei:l>וּפׇעֳלֵ֥י<tei:anchor xml:id="note_5"/> ט֝וֹבָתָ֗ם אֲשֶֽׁר־אָהֲב֣וּ בִּלְבָבָֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/13"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כּ</tei:seg>וֹנַ֣נְתָּ דַּ֭רְכָּם אֶל־מִצְוֺתֶ֑ךָ</tei:l>
          <tei:l>וְיָשַׁ֥רְתָּה כּ֝וֹחָ֗ם בְּכׇל־מַעֲשֵׂ֥י פִּלְאֶֽךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/14"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>עוֹלָ֣ם ׀ לְ֭עוֹלָם יַעַבְד֣וּ אֶת־שְׁמֶ֑ךָ</tei:l>
          <tei:l>וּלְנֵ֥צַח נְ֝צָחִ֗ים יְרוֹמְמ֥וּ אֶת־שְׁמֶֽךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/15"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מִ֣</tei:seg>י כְ֭מַעֲשֶֽׂיךָ וּמִ֣י כִּפְעָלֶ֑יךָ<tei:anchor xml:id="note_6"/></tei:l>
          <tei:l>וּמִ֥י יִ֝דְמֶה־לָ֗ךְ עַל־רַ֥ב כׇּל־מַעֲשֶֽׂיךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/16"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מָ</tei:seg>חַ֣לְתָּ וְ֭סָלַֽחְתָּ אֶת־כׇּל־חַטֹּאתֵ֑ינוּ</tei:l>
          <tei:l>וְכִפַּ֥רְתָּ בְּ֝אַהֲבָ֗ה עַל־כׇּל־פְּשָׁעֵֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/17"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נִ</tei:seg>בֵּ֣אתָ בְ֭רוּחֲךָ עַל־פִּ֣י עַבְדֶּ֑ךָ</tei:l>
          <tei:l>כִּ֗י קָרַ֣בְתִּי קֵ֭ץ וְע֣וֹד לֹא־תְּאַחֵֽר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/18"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נִ</tei:seg>שְׁבַּ֣עְתָּ מֵ֭רֹאשׁ לְדָוִ֣יד עַבְדֶּ֑ךָ</tei:l>
          <tei:l>וּמָשַׁ֥חְתָּ בְּ֝רַחֲמֶ֗יךָ<tei:anchor xml:id="note_7"/> אֶת־שֹׁ֣רֶשׁ יִשַֽׁי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/19"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">סָ</tei:seg>מַ֣כְתָּ זְרוֹע֣וֹ בִּקְדֻשָּׁתֶ֑ךָ</tei:l>
          <tei:l>כִּ֗י הֵכִ֣ין שִׁ֝בְחֲךָ֗ עַד־אַ֥פְסֵי אָֽרֶץ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/20"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">עַ</tei:seg>מּ֣וּד ע֭וֹלָם שָׂ֣מְתָּה אֶת־שְׁמ֑וֹ</tei:l>
          <tei:l>וְג֥וֹדֵר פֶּ֖רֶץ וּבוֹנֶ֣ה חֳרָבֽוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/21"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פִּ</tei:seg>נָּ֬ה מְמֹאָסָ֗ה אֲשֶׁ֣ר מָ֭אֲסוּ הַבּוֹנִ֑ים</tei:l>
          <tei:l>וְעָלִ֥יתָ לְ֝רֹ֗אשׁ מֵעַ֥ל כׇּל־הָאֻמִּֽים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/22"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>אֵ֣ר וַ֭עֲטֶֽרֶת הִנְחַלְתּ֣וֹ בְּרִנָּ֑ה</tei:l>
          <tei:l>וְה֥וֹד כׇּל־הַ֝גּוֹיִ֗ם קָרָ֥אתָ אֶת־שְׁמֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/23"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">צֶ֣</tei:seg>דֶק וּ֭מִשְׁפָּט הִרְבֵּ֣יתָה בְּיָמָ֑יו</tei:l>
          <tei:l>וְשָׁל֥וֹם וּ֝בְרָכ֗וֹת עַד־בְּלִ֣י מִסְפָּֽר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/24"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">צָ</tei:seg>הֲל֣וּ לְ֭פָנֶיךָ כׇּל־בְּחִירֵ֣י צֶ֑דֶק</tei:l>
          <tei:l>כִּי יִ֝שְׂמְח֗וּ בְּאֶ֣רֶץ חֶמְדָּֽה:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/25"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קִ</tei:seg>דַּ֣שְׁתָּ עַל־פִּ֭יו אֶת־שֵׁ֣ם הַגָּד֑וֹל</tei:l>
          <tei:l>וְשִׁיר֥וֹת עֻ֝זְּךָ֗ יְסַפֵּ֥ר כׇּל־יֽוֹם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/26"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רֹ֣</tei:seg>ב כׇּל־מַ֭לְאָכִים עָשִׂ֣יתָ גְּדֻלָּת֑וֹ</tei:l>
          <tei:l>וּמֶ֤לֶךְ כׇּל־הָ֝אֻמִּ֗ים נְתַתּ֥וֹ לָנֶֽצַח׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/27"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שָׁ</tei:seg>בַ֣רְתָּ לְ֭פָנָיו כׇּל־מַלְכֵ֣י מִדְיָ֑ן</tei:l>
          <tei:l>וְטִבַּ֥עְתָּ בִּ֝מְצוּל֗וֹת כׇּל־שׂוֹנְאֵ֣י נַפְשֽׁוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/28"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">תָּ</tei:seg>מַ֣כְתָּ יְמִינ֣וֹ עַל־חַרְבּ֑וֹ וְחָזַ֥קְתָּ זְ֝רוֹע֗וֹ</tei:l>
          <tei:l>עַ֖ל כׇּל־גִּבּוֹרֵ֣י קֵדָֽר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/29"/>
        <tei:lg>
          <tei:l>לֹא־יָמ֣וּט רַ֭גְלוֹ כִּי־בָטַ֣ח בִּשְׁמֶ֑ךָ</tei:l>
          <tei:l>וְלֹ֨א יִכָּשֵׁ֬ל כּוֹח֗וֹ כִּ֖י עֲזַרְתּ֣וֹ בְּאַהֲבָֽה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/30"/>
        <tei:lg>
          <tei:l>אַשְׁרֵ֣י הַ֭גֶּֽבֶר אֲשֶֽׁר־יִבְטַ֣ח בִּדְבָרֶ֑ךָ</tei:l>
          <tei:l>כִּ֗י לְעוֹלָ֥ם ׀ לְ֝עוֹלָ֗ם לֹא־נִכְלְמ֥וּ פָּנָֽיו׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/31"/>
        <tei:lg>
          <tei:l>בְּ֭ךָ בָּטְחָ֣ה נַפְשִׁ֑י חׇ֝נֵּנִ֗י וַעֲנֵֽנִי׃</tei:l>
          <tei:l>בָּר֬וּךְ אַתָּ֗ה יְ֫הֹוָ֥ה אֵ֭ל עוֹנֶ֣ה לְעַבְּד֑וֹ בְּ֝כׇל־עֵ֗ת קוֹרְאָֽיו׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/32"/>
        <tei:lg>
          <tei:l>אֱלֹהֵ֬י הָרַחֲמָ֗ן רַ֝חֵ֗ם עָלֵֽינוּ׃</tei:l>
          <tei:l>בָּ֭רוּךְ שֵׁ֣ם כְּב֣וֹד מַלְכוּת֑וֹ לְ֝עוֹלָ֗ם וָעֶֽד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_1st_of_iyyar_the_first_psalm_of_the_additional_psalms/33"/>
        <tei:lg>
          <tei:l>בָּ֭רוּךְ שֵׁ֣ם כְּבוֹד֑וֹ לְ֝עוֹלָ֗ם וְעַֽד׃</tei:l>
          <tei:l>בָּ֤רֽוּךְ־יְהֹוָ֨ה אֱלֹהֵ֪י יִשְׂרָאֵ֡ל מִן־הָ֤עוֹלָ֨ם ׀ וְעַ֬ד הָעוֹלָ֗ם</tei:l>
          <tei:l>וְאָמַ֖ר כׇּל־הָעָ֥ם אָמֵֽן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" n="1" target="#note_1">
      <tei:p>On the basis of the following three psalms found in MS RNL Antonin 798, the introductory verse very likely specified this psalm in the context of the first day of the month or Rosh Ḥodesh Iyyar upon which David experienced a vision. –Aharon Varady</tei:p>
    </tei:note>
    <tei:note type="commentary" n="2" target="#note_2">
      <tei:p>The alphabetic acrostic would likely have begun here.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="3" target="#note_3">
      <tei:p>בעיול כתיב</tei:p>
    </tei:note>
    <tei:note type="commentary" n="5" target="#note_5">
      <tei:p>ופועלי כתיב</tei:p>
    </tei:note>
    <tei:note type="commentary" n="6" target="#note_6">
      <tei:p>כפועליך כתיב</tei:p>
    </tei:note>
    <tei:note type="commentary" n="7" target="#note_7">
      <tei:p>ברחמך כתיב</tei:p>
    </tei:note>
  </tei:standOff>
