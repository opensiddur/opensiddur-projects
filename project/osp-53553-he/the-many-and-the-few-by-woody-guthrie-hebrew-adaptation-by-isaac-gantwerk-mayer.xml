    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:the_many_and_the_few_by_woody_guthrie_hebrew_adaptation_by_isaac_gantwerk_mayer">
        <tei:head>רַבִּים בְּיַד מְעַטִּים (Rabim b'Yad M'atim) — a Hebrew adaptation of Woody Guthrie's Ḥanukkah ballad by Isaac Gantwerk Mayer</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_many_and_the_few_by_woody_guthrie_hebrew_adaptation_by_isaac_gantwerk_mayer/1"/>
        <tei:lg>
          <tei:l>שְׁמִי מֶֽלֶךְ כּֽוֹרֶשׁ וַאַֽעֲבֶר קוֹל</tei:l>
          <tei:l>תָּשׁוּב יְהוּדָה לְבֵיתָהּ</tei:l>
          <tei:l>לִבְנוֹת עוֹד־פַּֽעַם אֶת־בֵּית מִקְדָּשֵׁךְ</tei:l>
          <tei:l>בְּתוֹךְ עֲבַר נַהֲרָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_many_and_the_few_by_woody_guthrie_hebrew_adaptation_by_isaac_gantwerk_mayer/2"/>
        <tei:lg>
          <tei:l>זִמַּֽרְנוּ רָקַֽדְנוּ עַל־דֶּֽרֶךְ מִדְבָּר</tei:l>
          <tei:l>בְּשׁוּב לְאַדְמַת יִשְׂרָאֵל</tei:l>
          <tei:l>עָבַֽדְנוּ בְּמַעַדְרִים וְאִתִּים</tei:l>
          <tei:l>יָדֵֽינוּ כּוֹנְנוּ מַעֲשֶׂה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_many_and_the_few_by_woody_guthrie_hebrew_adaptation_by_isaac_gantwerk_mayer/3"/>
        <tei:lg>
          <tei:l>שְׁמִי עֶזְרָא הַכֹּהֵן הַסֹּפֵר</tei:l>
          <tei:l>הֵבֵֽאתִי אִתִּי אֶת־סִפְרִי</tei:l>
          <tei:l>הֶעֱלֵֽיתִי מֵאֶֽרֶץ בָּבֶל אֶת־צֹאנִי</tei:l>
          <tei:l>לְאֶֽרֶץ יִשְׂרָאֵל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_many_and_the_few_by_woody_guthrie_hebrew_adaptation_by_isaac_gantwerk_mayer/4"/>
        <tei:lg>
          <tei:l>אֶקְרָא לִפְנֵיכֶם אֶת־תַּלְמוּד תּוֹרָתִי</tei:l>
          <tei:l>תִּשְׁמְעוּ חֲזוֹן הַנְּבִיאִים</tei:l>
          <tei:l>וְאַתֶּם תִּפְרוּ וְתִרְבּוּ עַד־מְאֹד</tei:l>
          <tei:l>כִּי־תִּשְׁמֹר בַּתּוֹרָה בֶּאֱמֶת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_many_and_the_few_by_woody_guthrie_hebrew_adaptation_by_isaac_gantwerk_mayer/5"/>
        <tei:lg>
          <tei:l>שְׁמִי אָלֶכְּסַֽנְדֶּר קוֹרְאִים לִי גָּדוֹל</tei:l>
          <tei:l>חֲצִי כׇּל־הָאָֽרֶץ תַּחְתַּי</tei:l>
          <tei:l>קֽוּמוּ וְעִמְדוּ לְפָנַי עֲבָדַי</tei:l>
          <tei:l>כִּי־אֶגְוַע אֵאָסֵף אֶל־עַמִּי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_many_and_the_few_by_woody_guthrie_hebrew_adaptation_by_isaac_gantwerk_mayer/6"/>
        <tei:lg>
          <tei:l>אַתָּה מֶֽלֶךְ סוּרְיָה וּכְנַֽעַן תַּעֲמֹד</tei:l>
          <tei:l>אַנְטִיּֽוֹכוּס הָרְבִיעִי</tei:l>
          <tei:l>לְהַשְׁמִיד בַּיְּהוּדִים הַמְּמָאֲנִים</tei:l>
          <tei:l>לַעֲבֹד עֲבוֹדַת אֱלִּילִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_many_and_the_few_by_woody_guthrie_hebrew_adaptation_by_isaac_gantwerk_mayer/7"/>
        <tei:lg>
          <tei:l>שְׁמִי חַנָּה וּבְנִי בְּכוֹרִי</tei:l>
          <tei:l>עוֹמֵד לִפְנֵי הַנָּגִיד</tei:l>
          <tei:l>חֶטְאוֹ שֶׁשָּׁמַר אֶת־חֻקּוֹת הַשַּׁבָּת</tei:l>
          <tei:l>רָאִֽיתִי בַּהֲרִיגָתוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_many_and_the_few_by_woody_guthrie_hebrew_adaptation_by_isaac_gantwerk_mayer/8"/>
        <tei:lg>
          <tei:l>אֶחָד וְאֶחָד הִכּוּ אֶת־בָּנַי</tei:l>
          <tei:l>שִׁבְעָה נִרְצָחִים לְעֵינַי</tei:l>
          <tei:l>כִּי שָׁמְרוּ אֶת־מִצְוֺת הַתּוֹרָה הַקְּדוֹשָׁה</tei:l>
          <tei:l>אֲשַׁלֵּם בַּדָּמִי הַשָּׁפוּךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_many_and_the_few_by_woody_guthrie_hebrew_adaptation_by_isaac_gantwerk_mayer/9"/>
        <tei:lg>
          <tei:l>שְׁמִי מַתִּתְיָֽהוּ בָּנַי חֲמִשָּׁה</tei:l>
          <tei:l>וְדַֽרְנוּ בְּעִיר מוֹדִיעִין</tei:l>
          <tei:l>הַמֶּֽלֶךְ חִיְּבֵֽנוּ לַעֲבֹד אֱלִילִים</tei:l>
          <tei:l>הָרַֽגְנוּ אֶת־שְׁנֵי נְעָרָיו׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_many_and_the_few_by_woody_guthrie_hebrew_adaptation_by_isaac_gantwerk_mayer/10"/>
        <tei:lg>
          <tei:l>מֵאָה שֶׁיִּלָּחֲמוּ לִהְיוֹת יְהוּדִים</tei:l>
          <tei:l>עָלוּ הַגִּבְעָֽתָה אִתִּי</tei:l>
          <tei:l>עַל־עֶֽרֶשׂ דְּוַי אֶקְרָאֶה מַנְהִיגְכֶם</tei:l>
          <tei:l>הוּא יְהוּדָה הַמַּכַּבִּי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_many_and_the_few_by_woody_guthrie_hebrew_adaptation_by_isaac_gantwerk_mayer/11"/>
        <tei:lg>
          <tei:l>שְׁמִי יְהוּדָה הַמַּכַּבִּי</tei:l>
          <tei:l>עַל־שֵׁם הַמַּקֶּֽבֶת נִקְרָא</tei:l>
          <tei:l>לִפְנֵי הַקְּרָב נִתְפַּלֵּל לֵאלֹהִים</tei:l>
          <tei:l>עַד כׇּל־אוֹיְבֵֽינוּ יִפְּלוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_many_and_the_few_by_woody_guthrie_hebrew_adaptation_by_isaac_gantwerk_mayer/12"/>
        <tei:lg>
          <tei:l>הַמּוֹשֵׁל אַפּוֹלֽוֹנְיוֹס הָרַֽגְתִּי הַיּוֹם</tei:l>
          <tei:l>נִתַּֽצְנוּ אֶת־כׇּל־צְבָאוֹ</tei:l>
          <tei:l>הַמְּעַט חַיָּלָיו בָּרֽוּחַ בָּרְחוּ</tei:l>
          <tei:l>הָרֹב פְּגָרִים בֶּעָפָר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_many_and_the_few_by_woody_guthrie_hebrew_adaptation_by_isaac_gantwerk_mayer/13"/>
        <tei:lg>
          <tei:l>שְׁמִי סֵירוֹן וּבָאתִי מִסִּרְיוֹן</tei:l>
          <tei:l>לְהַשְׁמִיד אֶת־הַהוּא מַכַּבִּי</tei:l>
          <tei:l>חֵילִי הוּא גָּדוֹל וְחֵילוֹ הוּא קָטֹן</tei:l>
          <tei:l>אַךְ בְּכׇל־זֹאת הוּא נִצַּח אוֹתִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_many_and_the_few_by_woody_guthrie_hebrew_adaptation_by_isaac_gantwerk_mayer/14"/>
        <tei:lg>
          <tei:l>מְסִירַת הָרַבִּים בְּיַד הַמְּעַטִּים</tei:l>
          <tei:l>לָאֵל אֵין בִּכְלָל בְּעָיָה</tei:l>
          <tei:l>רַק כַּמָּה שָׁעוֹת וְנִשְׁבָּר צְבָאִי</tei:l>
          <tei:l>מִלֵּֽאנוּ אֶת־הָעֵֽמֶק בְּדָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_many_and_the_few_by_woody_guthrie_hebrew_adaptation_by_isaac_gantwerk_mayer/15"/>
        <tei:lg>
          <tei:l>לִיסִֽיַאס שְׁמִי וְזֹאת מַחֲשַׁבְתִּי</tei:l>
          <tei:l>לִשְׂרֹף בָּם בְּתוֹךְ שֵׁנָתָם</tei:l>
          <tei:l>בָּֽאתִי הִנָּם כְּבָר יָצְאוּ גַּם עָבְרוּ</tei:l>
          <tei:l>רֵיקָם הָיָה כׇּל־אׇהֳלָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_many_and_the_few_by_woody_guthrie_hebrew_adaptation_by_isaac_gantwerk_mayer/16"/>
        <tei:lg>
          <tei:l>וְהוּא הִסְתַּעֵר עֲלֵי־מַחֲנָתִי</tei:l>
          <tei:l>וְהֵמִית אֶת־אַלְפֵי חַיָּלַי</tei:l>
          <tei:l>פִּילַי פָּרָשַׁי וְכׇל־אֶֽלֶף רַגְלִי</tei:l>
          <tei:l>נָקַב יְהוּדָה בַּזָּנָב׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_many_and_the_few_by_woody_guthrie_hebrew_adaptation_by_isaac_gantwerk_mayer/17"/>
        <tei:lg>
          <tei:l>שִׁיר לִירוּשָׁלַֽיִם בְּשׁוּב יְהוּדָה</tei:l>
          <tei:l>לִבְנוֹת עוֹד הַפַּֽעַם בֵּיתִי</tei:l>
          <tei:l>לַעֲקֹר וּלְהַכְרִית בַּשָּׁמִיר וּבַשַּֽׁיִת</tei:l>
          <tei:l>שֶׁנָּבַט סָבִיב עַל־שְׁעָרַי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_many_and_the_few_by_woody_guthrie_hebrew_adaptation_by_isaac_gantwerk_mayer/18"/>
        <tei:lg>
          <tei:l>אֲבָנִים שְׁלֵמוּת נִבְנֶה בִּתְפִלָּה</tei:l>
          <tei:l>בִּלְבָבוֹת שְׁלֵמִים כַּיְּהוּדִים</tei:l>
          <tei:l>אַהֲבַת עוֹלַם חֶֽסֶד מָסְרוּ הַשּׂוֹנְאִים</tei:l>
          <tei:l>בְּיַד אוֹהֲבֵי אֱלֹהִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_many_and_the_few_by_woody_guthrie_hebrew_adaptation_by_isaac_gantwerk_mayer/19"/>
        <tei:lg>
          <tei:l>מָצָֽאנוּ כַּד שֶֽׁמֶן קָטָן בַּמִּקְדָּשׁ</tei:l>
          <tei:l>מַסְפִּיק רַק לַלַּֽיְלָה הַהוּא</tei:l>
          <tei:l>הַכַּד הַקָּטָן נִשְׂרַף שְׁמוֹנָה יָמִים</tei:l>
          <tei:l>לְהָאִיר אֶת־הָאוֹר הֶחָדָשׁ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_many_and_the_few_by_woody_guthrie_hebrew_adaptation_by_isaac_gantwerk_mayer/20"/>
        <tei:lg>
          <tei:l>לָכֵן שְׁמוֹנָה נֵרוֹת וְשַׁמָּשׁ נַדְלִיק</tei:l>
          <tei:l>כׇּל־חֹֽרֶף שֶׁבָּא וְיוֹצֵא</tei:l>
          <tei:l>נַזְכִּֽירָה רַבִּים בְּיַד מְעַטִּים</tei:l>
          <tei:l>וְזֶֽרַע יְהוּדָה נְבָרֵךְ</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
