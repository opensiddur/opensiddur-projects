    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:elohim_the_life_of_nature_kaplan">
        <tei:head>אלהים חיי הטבע</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_the_life_of_nature_kaplan/1"/>
        <tei:lg>
          <tei:l>אֲבוֹתֵֽינוּ נָתְנוּ גֹֽדֶל לָאֵל.</tei:l>
          <tei:l>אֶת־מַעֲשֵׂי יָדָיו</tei:l>
          <tei:l>בִּשְׁמֵי הָרָז מִמַּֽעַל סִפֵּֽרוּ.</tei:l>
          <tei:l>בַּחֲלִיפוֹת הַמַּרְאוֹת בָּאָֽרֶץ מִתָּֽחַת.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_the_life_of_nature_kaplan/2"/>
        <tei:lg>
          <tei:l>וּבְסֵֽדֶר הַמַּחֲזוֹר לַיָּמִים וְלַלֵּילוֹת.</tei:l>
          <tei:l>לַתְּקוּפוֹת וְלַשָּׁנִים.</tei:l>
          <tei:l>וּבְתַשְׁבֵּץ גּוֹרַל הָאָדָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_the_life_of_nature_kaplan/3"/>
        <tei:lg>
          <tei:l>וְהִנֵּה מוֹג הִתְמוֹגְגָה קִמֹּֽרֶת הַשַּֽׁחַר.</tei:l>
          <tei:l>לַֽיִל יְגַלֶּה נִבְכֵי חָלָל אֵין־מְצָרִים</tei:l>
          <tei:l>יְכַסְיֵֽמוֹ אוֹר הַיּוֹם.</tei:l>
          <tei:l>לַֽיִל יְגוֹלֵל שְׂדוֹת־רְאִיָּה נֶֽעֶדְרֵי־אֹֽפֶק.</tei:l>
          <tei:l>מֶרְחַקִּים לֹא שֵׁעֲרָם הַדִּמְיוֹן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_the_life_of_nature_kaplan/4"/>
        <tei:lg>
          <tei:l>נִדְהֲמָה דַֽעַת אֱנוֹשׁ.</tei:l>
          <tei:l>אַךְ מְהֵרָה קוֹם תָּקוּם.</tei:l>
          <tei:l>וּבַהֲצִיצָהּ דֶּֽרֶךְ אֹֽפֶל לֹא־תְחוּמִים.</tei:l>
          <tei:l>שׁוּב עַל־מְכוֹנָהּ תִּכּוֹן.</tei:l>
          <tei:l>לְאוֹר שְׁמָשׁוֹת רְחוֹקוֹת.</tei:l>
          <tei:l>כֻּוְּצוּ עַד־הָפְכָּם נִצּוֹצוֹת בּוֹעֲרִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_the_life_of_nature_kaplan/5"/>
        <tei:lg>
          <tei:l>עוֹטְפָה הַנְּשָׁמָה.</tei:l>
          <tei:l>אַךְ מְהֵרָה תָּשׁוּב תֶּֽחִי.</tei:l>
          <tei:l>שֵׁנִית תִּלְמַד לִקְרֹא שֵׁם אֱלֹהִים</tei:l>
          <tei:l>עַל־פְּנֵי רָקִיעַ. תְּכָנַֽתּוּ בְחָזוּת חֲדָשָׁה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_the_life_of_nature_kaplan/6"/>
        <tei:lg>
          <tei:l>שְׂאוּ־מָרוֹם עֵינֵיכֶם וּרְאוּ</tei:l>
          <tei:l>מִי־בָרָא אֵֽלֶּה.</tei:l>
          <tei:l>הַמּוֹצִיא בְּמִסְפָּר צְבָאָם</tei:l>
          <tei:l>לְכֻלָּם בְּשֵׁם יִקְרָא׃ <tei:bibl>(ישעיה מ:כו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_the_life_of_nature_kaplan/7"/>
        <tei:lg>
          <tei:l>אֱלֹהִים הוּא הָאַחְדּוּת</tei:l>
          <tei:l>הַמְגַשֶּֽׁרֶת עִמְקֵי חָלָל אֵין־חֵֽקֶר</tei:l>
          <tei:l>וּזְמַנֵי עוֹלָמִים אֵין־מִדָּה.</tei:l>
          <tei:l>הַמְקַשֶּֽׁרֶת אוֹתָם יַחְדָּו בְּמַעֲשֶׂה</tei:l>
          <tei:l>כְּמוֹ נַעֲשֶׂה אֲנַֽחְנוּ בְּמַחֲשָׁבָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_the_life_of_nature_kaplan/8"/>
        <tei:lg>
          <tei:l>אֱלֹהִים הוּא הַזֶּהוּת</tei:l>
          <tei:l>בַּחֹֽמֶר הַיְסוֹדִי אֲשֶׁר לְכוֹכְבֵי לֶכֶֽת וּלְכוֹכְבֵי שָֽׁבֶת.</tei:l>
          <tei:l>לְזֶה מְעוֹנֵֽנוּ הָאָֽרֶץ.</tei:l>
          <tei:l>וּלְכׇל־נֶֽפֶשׁ חַיָּה הַשּׁוֹכֶֽנֶת בָּהּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_the_life_of_nature_kaplan/9"/>
        <tei:lg>
          <tei:l>אֱלֹהִים הוּא הָאִחוּד</tei:l>
          <tei:l>לְכׇל־הֹוֶה.</tei:l>
          <tei:l>הַתְמָדַת הַתְּנוּעָה לְכׇל־אֲשֶׁר יָנֽוּעַ׃</tei:l>
          <tei:l>הַקֶּֽצֶב אֲשֶׁר לְדָבָר וְדָבָר.</tei:l>
          <tei:l>וְטִיב פְּעֻלָתָם הַהֲדָדִית׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_the_life_of_nature_kaplan/10"/>
        <tei:lg>
          <tei:l>הַמְקַשֵּׁר מַעֲדַנּוֹת כִּימָה</tei:l>
          <tei:l>מוֹשְׁכוֹת כְּסִיל יְפַתֵּֽחַ.</tei:l>
          <tei:l>מוֹצִיא מַזָּרוֹת בְּעִתּוֹ</tei:l>
          <tei:l>וְעַֽיִשׁ עַל־בָּנֶֽיהָ יַנְחֵם: <tei:bibl>(על פי איוב לח:לא-לב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_the_life_of_nature_kaplan/11"/>
        <tei:lg>
          <tei:l>אֱלֹהִים הוּא סוֹד־הַחַיִּים.</tei:l>
          <tei:l>הַמַּצִּית אֶת־הַחֹֽמֶר הַדָּמוּם.</tei:l>
          <tei:l>לִדְחִיפָה פְנִימִית וּלְמַטָּרָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_the_life_of_nature_kaplan/12"/>
        <tei:lg>
          <tei:l>הוּא הַשַּׁלְהֶֽבֶת הַיּוֹצֶֽרֶת.</tei:l>
          <tei:l>הַמְשַׁנָּה חֽוֹתַם־חֹֽמֶר לֹא־יִחְיֶה.</tei:l>
          <tei:l>עֲדֵי יִקְפֹּץ אֶל מֶמְשְׁלוֹת הֲוָיָה רָמוֹת מִן הָרָם.</tei:l>
          <tei:l>יֵאוֹר בְּזֹֽהַר לַֽהַט מֵרֶֽגֶשׁ.</tei:l>
          <tei:l>וּבְאַחֲרִיתוֹ יֵהָפֵךְ לְלַֽבַּת־אֵשׁ מַחֲשָׁבָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_the_life_of_nature_kaplan/13"/>
        <tei:lg>
          <tei:l>וְאַף כִּי אֵין רֶֽמֶז לִיצוּר חַי</tei:l>
          <tei:l>מַפְרִיעַ אֶת־דִּמְמַת הַנְּצָחִים אֲשֶׁר לַסְּפִירוֹת.</tei:l>
          <tei:l>לֹא נוֹאִיל לְדַמּוֹת כִּי זֹאת הָאָֽרֶץ.</tei:l>
          <tei:l>זֹאת הַנְּקוּדָה הַזְּעִירָה בָאֵין־סוֹף.</tei:l>
          <tei:l>רַק הִיא לְבַדָּהּ חֲנוּנָה דַּֽעַת אֱלֹהִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_the_life_of_nature_kaplan/14"/>
        <tei:lg>
          <tei:l>אָכֵן הַמּוֹפֵת הַהוּא</tei:l>
          <tei:l>הַמְקַשֵּׁר אֶת־הָעוֹלָמוֹת בְּמוֹסְדוֹת חֹֽמֶר.</tei:l>
          <tei:l>הוּא מְקַשֵּׁר אֶת־כׇּל־הָעוֹלָמוֹת</tei:l>
          <tei:l>יַחְדָּיו בְּמוֹסְרוֹת חַיִּים:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_the_life_of_nature_kaplan/15"/>
        <tei:lg>
          <tei:l>כִּי הִנֵּה יוֹצֵר הָרִים</tei:l>
          <tei:l>וּבֹרֵא רוּחַ</tei:l>
          <tei:l>וּמַגִּיד לְאָדָם מַה־שֵּׂחוֹ</tei:l>
          <tei:l>עֹשֵׂה שַׁחַר עֵיפָה</tei:l>
          <tei:l>וְדֹרֵךְ עַל־בָּמֳתֵי אָרֶץ</tei:l>
          <tei:l>יְיָ אֱלֹהֵי־צְבָאוֹת שְׁמוֹ׃ <tei:bibl>(עמוס ד:יג)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
