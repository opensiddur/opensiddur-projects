      <tei:div corresp="urn:x-opensiddur:text:prayer:hael_betaatsumot_uzekha">
        <tei:head>הָאֵל בְּתַעֲצֻמוֹת עֻזֶּךָ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hael_betaatsumot_uzekha/1"/>
        <tei:lg>
          <tei:l>הָאֵל בְּתַעֲצֻמוֹת עֻזֶּךָ,</tei:l>
          <tei:l>הַגָּדוֹל בִּכְבוֹד שְׁמֶךָ,</tei:l>
          <tei:l>הַגִּבּוֹר לָנֶצַח וְהַנּוֹרָא בְּנוֹרְאוֹתֶיךָ,</tei:l>
          <tei:l>הַמֶּלֶךְ הַיּושֵׁב עַל כִּסֵּא רָם וְנִשָּׂא.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
