    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:itti_milvanon_binyamin">
        <tei:head>אִתִּי מִלְּבָנוֹן</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itti_milvanon_binyamin/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אִ</tei:seg>תִּי מִלְּבָנוֹן כַּלָּה מֵרֹאשׁ אֲמָנָה תָּשׁוּרִי</tei:l>
          <tei:l>בְּטֹֽהַר עֲדָיֵי לְבוּשׁ הִתְכַּהֲנִי וְהִתְפָּאֲרִי</tei:l>
          <tei:l><tei:seg type="acrostic">בֹּֽ</tei:seg>שֶׂם רִקּֽוּחַ הִתְבַּשְּׂמִי מוֹר וּלְבוֹנָה הִתְקַטְּרִי</tei:l>
          <tei:l>כִּי בָא עֵת וְהִגִּֽיעַ שָׁעָה אֲשֶׁר לַמֶּֽלֶךְ תָּשׁוּרִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itti_milvanon_binyamin/2"/>
        <tei:lg>
          <tei:l>בֵּׄיׄןׄ שָׁדַי יָׄלִין אֶשְׁכּוֹל הַכֹּֽפֶר</tei:l>
          <tei:l>מְׄצַפְצֶפֶת נׄוֹאֶֽמֶת כַּלָּה בְּאִמְרֵי שֶֽׁפֶר</tei:l>
          <tei:l>בְּׄנֵׄי מְכוֹן זְׄבוּלוֹ רֹׄחֲׄשִׁים בְּלִי חֵֽפֶר</tei:l>
          <tei:l>חֹׄק זֵֽׄכֶר קְׄדֻשָּׁתוֹ נַעֲרִיץ וּנְסַפֵּר</tei:l>
          <tei:l>בְּמַֽעְלָה יִתְקַדַּשׁ וּבְמַֽטָּה יִסְתַּלְסֵל תָּמִיד לֵיל וָצֶֽפֶר׃</tei:l>
          <tei:l>קָדוֹשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itti_milvanon_binyamin/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">גַּ</tei:seg>ן נָעוּל קְרָאַֽנִי דוֹדִי</tei:l>
          <tei:l>חָמַק עָבַר וְשׁוֹמְרִים נָשְׂאוּ רְדִידִי</tei:l>
          <tei:l><tei:seg type="acrostic">דָּ</tei:seg>לְפָה עֵינִי וְגָרְסָה בְּזֵֽכֶר עׇנְיִי וּמְרוּדִי</tei:l>
          <tei:l>דִּדּוּי אַהֲבַת חֶֽסֶד תַּאֲוַת דּוֹדִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itti_milvanon_binyamin/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הֵ</tei:seg>ן בְּלֹא לֵב וָלֵב וְנֶֽפֶשׁ חֲפֵצָה</tei:l>
          <tei:l>חָתָן מִתְנַדֵּב וְכַלָּה רוֹצָה</tei:l>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>עַל־מַה זֶּה מִתְאַחֵר דִּיץ הָעֲלִיצָה</tei:l>
          <tei:l>שְׁלוּחִים הֵרִֽיצוּ לָזֶה וְלָזוֹ בִּמְרוּצָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itti_milvanon_binyamin/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זָ</tei:seg>כַר בָּהּ בְּרִית וּשְׁבוּעַת אָלָה</tei:l>
          <tei:l>אֲשֶׁר בִּשְׁעַת אֵרוּסֶֽיהָ כָּרַֽתִּי לִמְהֻלָּלָה</tei:l>
          <tei:l><tei:seg type="acrostic">חֶ</tei:seg>פְצִי וּרְצוֹנִי לְקַיֵּם בַּבֶּהָלָה</tei:l>
          <tei:l>הֵשִׁיב חָתָן לִשְׁלוּחֵי כַלָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itti_milvanon_binyamin/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">טָ</tei:seg>עֲנָה סְגֻלָּה אַף־הִיא יֹֽשֶׁר אֲמָרִים</tei:l>
          <tei:l>נְכוֹנָה אֲנִי וּמְקֻיֶּֽמֶת בְּהֵן הֵן הַדְּבָרִים</tei:l>
          <tei:l><tei:seg type="acrostic">יִ</tei:seg>גְמֹל רַק עִמִּי חֶֽסֶד וְיִזְכֹּר אַהֲבַת נְעוּרִים</tei:l>
          <tei:l>וִימַהֵר לִפְדּוֹתִי מִבֵּין חֲמוֹרִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itti_milvanon_binyamin/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כְּ</tei:seg>צִירֵי מַרְפֵּא וּשְׁלוּחֵי אֱמוּנִים</tei:l>
          <tei:l>נִתְמַצְּעוּ תְאוֹמִים בְּזִוּוּג חֲתָנִים</tei:l>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>דַבֵּר עַל־לֵב כַּלָּה דְּבָרִים הֲגוּנִים</tei:l>
          <tei:l>וּלְהַבְעִיר לֵב חָתָן בְּקִנְאַת מָגִנִּים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itti_milvanon_binyamin/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מְ</tei:seg>לוּכָה כְּהִתְבַּשְּׂרָה כַּלָּה בְּתַמְרוּקֶֽיהָ מְאֹד הִשְׁבִּיחָה</tei:l>
          <tei:l>רִמּוֹנֶיֽהָ הֵנֵֽצוּ וּסְמָדָרָהּ פִּתֵּחָה</tei:l>
          <tei:l><tei:seg type="acrostic">נָ</tei:seg>כוֹנוּ שָׁדֶֽיהָ וּשְׂעָרָהּ צִמֵּחָה</tei:l>
          <tei:l>וַתִּתְנָוֶה לַכֶּֽתֶר וְלַמַּלְכוּת הִצְלִיחָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itti_milvanon_binyamin/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ס</tei:seg>וֹא מַפְרִיכָהּ בִּרְאוֹתָהּ תָּמְהָה בְעֵינֶֽיהָ</tei:l>
          <tei:l>הֲלֹא זֹאת הַנְּמִבְזָה וְהַנְּקַלָּה הֵשִׁיבָה לִסְגָנֶֽיהָ</tei:l>
          <tei:l><tei:seg type="acrostic">עַ</tei:seg>ל־זֹאת שָׁלְחָה וְקָרְאָה לְאִצְטַגְנִינֶֽיהָ</tei:l>
          <tei:l>עָלֶֽיהָ חוֹשֶֽׁבֶת וְחוֹרֶֽקֶת שִׁנֶּֽיהָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itti_milvanon_binyamin/10"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>רִיץ חַיּוֹת נוֹהֵם וְלִבּוֹ מַכְבֵּד</tei:l>
          <tei:l>כַּלָּה לְעַנּוֹת בְּקוֹשִׁי לְשַׁעְבֵּד</tei:l>
          <tei:l><tei:seg type="acrostic">צִ</tei:seg>עֲרָהּ בְפֶֽרֶךְ וּבְעֹל כָּבֵד</tei:l>
          <tei:l>אוּלַי תִּתְגַנֶּה וְתִהְיֶה כִּכְלִי אֹבֵד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itti_milvanon_binyamin/11"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>רָא עָלָיו מוֹעֵד בַּחוּרָיו לִשְׁבֹּר</tei:l>
          <tei:l>צְפַרְדֵּֽעַ חֲנָמַל וְכִנִּים חֳמָרִים חֳמָרִים לִצְבֹּר</tei:l>
          <tei:l><tei:seg type="acrostic">רֶֽ</tei:seg>שֶׁף וְדֶֽבֶר וּבָרָד לְפָנָיו לַעֲבֹר</tei:l>
          <tei:l>וְרֵאשִׁית כׇּל־אוֹנִים בְּאׇהֳלֵי חָם לִקְבֹּר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itti_milvanon_binyamin/12"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שֻׁ</tei:seg>לְּחָה פְרוּכָה בְּעַל כׇּרְחָהּ מִמִּסְתּוֹלֵל</tei:l>
          <tei:l>וַתֵּצֶֽאנָה כׇל־הַנָּשִׁים אַחֲרֶֽיהָ בְּתֹף לְחוֹלֵל</tei:l>
          <tei:l><tei:seg type="acrostic">תַּ</tei:seg>נּוֹת לְאֵל זֶֽמֶר וְהוֹדָיוֹת שֶֽׁבַח וְהַלֵּל</tei:l>
          <tei:l>שֶׁכָּֽכָה אוֹתוֹת בַּדִּים מֵפֵר וְקוֹסָמִים יְהוֹלֵל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:itti_milvanon_binyamin/13"/>
        <tei:lg>
          <tei:l>בֵּׄיׄןׄ שָׁדַי יָׄלִין אֶשְׁכּוֹל הַכֹּֽפֶר</tei:l>
          <tei:l>מְׄצַפְצֶפֶת נׄוֹאֶֽמֶת כַּלָּה בְּאִמְרֵי שֶֽׁפֶר</tei:l>
          <tei:l>בְּׄנֵׄי מְכוֹן זְׄבוּלוֹ רֹׄחֲׄשִׁים בְּלִי חֵֽפֶר</tei:l>
          <tei:l>חֹׄק זֵֽׄכֶר קְׄדֻשָּׁתוֹ נַעֲרִיץ וּנְסַפֵּר</tei:l>
          <tei:l>בְּמַֽעְלָה יִתְקַדַּשׁ וּבְמַֽטָּה יִסְתַּלְסֵל תָּמִיד לֵיל וָצֶֽפֶר׃</tei:l>
          <tei:l>קָדוֹשׁ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
