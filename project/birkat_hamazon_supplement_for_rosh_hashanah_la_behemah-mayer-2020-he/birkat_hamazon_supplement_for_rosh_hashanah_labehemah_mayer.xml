    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_supplement_for_rosh_hashanah_labehemah_mayer">
        <tei:head>ברכת המזון לראש השנה לבהמה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_supplement_for_rosh_hashanah_labehemah_mayer/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">פתיחה בתהלים ח</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_supplement_for_rosh_hashanah_labehemah_mayer/2"/>
        <tei:lg>
          <tei:l>לַמְנַצֵּ֥חַ עַֽל־הַגִּתִּ֗ית</tei:l>
          <tei:l>מִזְמ֥וֹר לְדָוִֽד׃</tei:l>
          <tei:l>יְהֹוָ֤ה אֲדֹנֵ֗ינוּ מָֽה־אַדִּ֣יר שִׁ֭מְךָ בְּכׇל־הָאָ֑רֶץ</tei:l>
          <tei:l>אֲשֶׁ֥ר תְּנָ֥ה ה֝וֹדְךָ֗ עַל־הַשָּׁמָֽיִם׃</tei:l>
          <tei:l>מִפִּ֤י עוֹלְלִ֨ים ׀ וְֽיֹנְקִים֮ יִסַּ֢דְתָּ֫ עֹ֥ז לְמַ֥עַן צוֹרְרֶ֑יךָ</tei:l>
          <tei:l>לְהַשְׁבִּ֥ית א֝וֹיֵ֗ב וּמִתְנַקֵּֽם׃</tei:l>
          <tei:l>כִּֽי־אֶרְאֶ֣ה שָׁ֭מֶיךָ מַעֲשֵׂ֣ה אֶצְבְּעֹתֶ֑יךָ</tei:l>
          <tei:l>יָרֵ֥חַ וְ֝כוֹכָבִ֗ים אֲשֶׁ֣ר כּוֹנָֽנְתָּה׃</tei:l>
          <tei:l>מָה־אֱנ֥וֹשׁ כִּֽי־תִזְכְּרֶ֑נּוּ</tei:l>
          <tei:l>וּבֶן־אָ֝דָ֗ם כִּ֣י תִפְקְדֶֽנּוּ׃</tei:l>
          <tei:l>וַתְּחַסְּרֵ֣הוּ מְּ֭עַט מֵאֱלֹהִ֑ים</tei:l>
          <tei:l>וְכָב֖וֹד וְהָדָ֣ר תְּעַטְּרֵֽהוּ׃</tei:l>
          <tei:l>תַּ֭מְשִׁילֵהוּ בְּמַעֲשֵׂ֣י יָדֶ֑יךָ</tei:l>
          <tei:l>כֹּ֗֝ל שַׁ֣תָּה תַֽחַת־רַגְלָֽיו׃</tei:l>
          <tei:l>צֹנֶ֣ה וַאֲלָפִ֣ים כֻּלָּ֑ם</tei:l>
          <tei:l>וְ֝גַ֗ם בַּהֲמ֥וֹת שָׂדָֽי׃</tei:l>
          <tei:l>צִפּ֣וֹר שָׁ֭מַיִם וּדְגֵ֣י הַיָּ֑ם</tei:l>
          <tei:l>עֹ֝בֵ֗ר אׇרְח֥וֹת יַמִּֽים׃</tei:l>
          <tei:l>יְהֹוָ֥ה אֲדֹנֵ֑ינוּ</tei:l>
          <tei:l>מָה־אַדִּ֥יר שִׁ֝מְךָ֗ בְּכׇל־הָאָֽרֶץ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_supplement_for_rosh_hashanah_labehemah_mayer/3"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">שלושה שאכלו כאחד חיבים לזמן זימון</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_supplement_for_rosh_hashanah_labehemah_mayer/4"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">מזמן</tei:note> רַבּוֹתַי נְבָרֵךְ!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_supplement_for_rosh_hashanah_labehemah_mayer/5"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">קהל</tei:note> יְהִ֤י שֵׁ֣ם יְהֹוָ֣ה מְבֹרָ֑ךְ מֵ֝עַתָּ֗ה וְעַד־עוֹלָֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_supplement_for_rosh_hashanah_labehemah_mayer/6"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">מזמן</tei:note> יְהִ֤י שֵׁ֣ם יְהֹוָ֣ה מְבֹרָ֑ךְ מֵ֝עַתָּ֗ה וְעַד־עוֹלָֽם׃</tei:l>
          <tei:l>בִּרְשׁוּת מְרָנָן וְרַבָּנָן וְרַבּוֹתַי</tei:l>
          <tei:l>נְבָרֵךְ (<tei:note type="instruction">בעשרה</tei:note> אֱלֹהֵינוּ)</tei:l>
          <tei:l>שֶׁאָכַלְנוּ מִשֶּׁלוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_supplement_for_rosh_hashanah_labehemah_mayer/7"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">קהל</tei:note> בָּרוּךְ (<tei:note type="instruction">בעשרה</tei:note> אֱלֹהֵינוּ)</tei:l>
          <tei:l>שֶׁאָכַלְנוּ מִשֶּׁלוֹ</tei:l>
          <tei:l>וּבְטוּבוֹ חָיִינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_supplement_for_rosh_hashanah_labehemah_mayer/8"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">מזמן</tei:note> בָּרוּךְ (<tei:note type="instruction">בעשרה</tei:note> אֱלֹהֵינוּ)</tei:l>
          <tei:l>שֶׁאָכַלְנוּ מִשֶּׁלוֹ</tei:l>
          <tei:l>וּבְטוּבוֹ חָיִינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_supplement_for_rosh_hashanah_labehemah_mayer/9"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">קהל</tei:note> בָּרוּךְ הוּא וּבָרוּךְ שְׁמוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_supplement_for_rosh_hashanah_labehemah_mayer/10"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְהֹוָה אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם</tei:l>
          <tei:l>הַזָּן אֶת־הָעוֹלָם כֻּלּוֹ בְּטוּבוֹ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_supplement_for_rosh_hashanah_labehemah_mayer/11"/>
        <tei:lg>
          <tei:l>אֲ֯לָפִים בְּ֯הֵמוֹת גְּ֯מַלִּים דֻּ֯בִּים</tei:l>
          <tei:l>הָ֯רַחוּם וְ֯הַחַנּוּן זַ֯ן חַ֯יֵּי ט֯וֹבִים</tei:l>
          <tei:l>י֯וֹצְרָם כְּ֯נֶאֱמָר לָ֯רֹאשׁ מִ֯תְנַבְּאִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_supplement_for_rosh_hashanah_labehemah_mayer/12"/>
        <tei:lg>
          <tei:l>כָּאָמוּר</tei:l>
          <tei:l>וַיַּ֣עַשׂ אֱלֹהִים֩ אֶת־חַיַּ֨ת הָאָ֜רֶץ לְמִינָ֗הּ</tei:l>
          <tei:l>וְאֶת־הַבְּהֵמָה֙ לְמִינָ֔הּ</tei:l>
          <tei:l>וְאֵ֛ת כׇּל־רֶ֥מֶשׂ</tei:l>
          <tei:l>הָֽאֲדָמָ֖ה לְמִינֵ֑הוּ וַיַּ֥רְא אֱלֹהִ֖ים כִּי־טֽוֹב׃</tei:l>
          <tei:l>וְנֶאֱמַר פּוֹתֵ֥חַ אֶת־יָדֶ֑ךָ</tei:l>
          <tei:l>וּמַשְׂבִּ֖יעַ לְכׇל־חַ֣י רָצֽוֹן׃</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה הַזָּן אֶת־הַכּל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_supplement_for_rosh_hashanah_labehemah_mayer/13"/>
        <tei:lg>
          <tei:l>נָ֯כוֹן סִ֯יַּעְתָּנוּ עֲ֯בָדֶיךָ פְּ֯תָאִים</tei:l>
          <tei:l>צָ֯מַחְנוּ קֶ֯רֶן רְ֯אֵם שִׁ֯גְרֵי תְּ֯אוֹאִים</tei:l>
          <tei:l>יַ֯עַן צִ֯וַּתָּנוּ חָ֯סְדְּךָ עַל שׂוֹנְאִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_supplement_for_rosh_hashanah_labehemah_mayer/14"/>
        <tei:lg>
          <tei:l>כָּאָמוּר</tei:l>
          <tei:l>כִּֽי־תִרְאֶ֞ה חֲמ֣וֹר שֹׂנַאֲךָ֗ רֹבֵץ֙ תַּ֣חַת מַשָּׂא֔וֹ</tei:l>
          <tei:l>וְחָדַלְתָּ֖ מֵעֲזֹ֣ב ל֑וֹ</tei:l>
          <tei:l>עָזֹ֥ב תַּעֲזֹ֖ב עִמּֽוֹ׃</tei:l>
          <tei:l>וְנֶאֱמַר וְאָכַלְתָּ֖</tei:l>
          <tei:l>וְשָׂבָ֑עְתָּ</tei:l>
          <tei:l>וּבֵֽרַכְתָּ֙ אֶת־יְהֹוָ֣ה אֱלֹהֶ֔יךָ</tei:l>
          <tei:l>עַל־הָאָ֥רֶץ הַטֹּבָ֖ה אֲשֶׁ֥ר נָֽתַן־לָֽךְ׃</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה</tei:l>
          <tei:l>עַל הָאָרֶץ וְעַל הַמָּזוֹן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_supplement_for_rosh_hashanah_labehemah_mayer/15"/>
        <tei:lg>
          <tei:l>קׇ֯רְבָּנֶיךָ הַ֯נְּעִימֵי רֵ֯יחַ אֲ֯שֶׁר לִ֯מַּדְתָּנוּ</tei:l>
          <tei:l>בְּ֯נֵה נְ֯וֵה אֲ֯רוֹן בְּ֯רִיתְךָ רָ֯ם ה֯וּא מִ֯כֻּלָּנוּ</tei:l>
          <tei:l>הֲ֯לֹא כָּ֯רַתָּנוּ הַ֯בְּרִית נִ֯שְׁבַּעְתָּנוּ</tei:l>
          <tei:l>אָ֯ז מְ֯בִיאִים נַ֯חְנוּ תּוֹדוֹת מֵאִתָּנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_supplement_for_rosh_hashanah_labehemah_mayer/16"/>
        <tei:lg>
          <tei:l>כָּאָמוּר</tei:l>
          <tei:l>זְבַ֣ח לֵאלֹהִ֣ים תּוֹדָ֑ה</tei:l>
          <tei:l>וְשַׁלֵּ֖ם לְעֶלְי֣וֹן נְדָרֶֽיךָ׃</tei:l>
          <tei:l>וְנֶאֱמַר</tei:l>
          <tei:l>בֹּונֵ֣ה יְרוּשָׁלִַ֣ם יְהוָ֑ה</tei:l>
          <tei:l>נִדְחֵ֖י יִשְׂרָאֵ֣ל יְכַנֵּֽס׃</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה</tei:l>
          <tei:l>בּוֹנֵה בְרַחֲמָיו ירוּשָׁלַיִם</tei:l>
          <tei:l>אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_supplement_for_rosh_hashanah_labehemah_mayer/17"/>
        <tei:lg>
          <tei:l>אומר ברכה אחרונה לפי נוסח רגיל, אבל בפסוקי הרחמן אפשר להוסיף</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_supplement_for_rosh_hashanah_labehemah_mayer/18"/>
        <tei:lg>
          <tei:l>הָרַחֲמָן הוּא</tei:l>
          <tei:l>יְבָרֵךְ־נָא אֶת הַשָּׁנָה הַבָּאָה לְכׇל־חַיְתוֹ הָאָרֶץ וְאָז כׇּל־בְּנֵי־בָּשָׂר יְהַלְּלוּךָ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>