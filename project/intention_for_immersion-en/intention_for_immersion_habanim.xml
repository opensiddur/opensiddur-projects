  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:intention_for_immersion_habanim">
        <tei:head>Intention for Immersion [before Vaginoplasty], by the Em haBanim</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:intention_for_immersion_habanim/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">Before the evening prior to surgery, she ought to immerse in a pool of living waters without a blessing.</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:intention_for_immersion_habanim/2"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">The Em haBanim had the following intention as she immersed:</tei:note>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>Deep calls to deep to the sound of Your channels—</tei:l>
          <tei:l>all your breakers and waves have passed over me. <tei:bibl>(Psalms 42:8)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:intention_for_immersion_habanim/3"/>
        <tei:lg>
          <tei:l>May I believe that I will be who I will be.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
