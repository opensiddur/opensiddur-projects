  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:techinah_imahot_for_shabbat_mevorkhim_horowitz">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:techinah_imahot_for_shabbat_mevorkhim_horowitz/1"/>
        <tei:lg>
          <tei:l>יָהּ רִבּוֹן עָלַם וְעָלְמַיָא</tei:l>
          <tei:l>אַנְתְּ בָּרָאתָ בְּשִׁית יוֹמַיָא</tei:l>
          <tei:l>שְׁמַיָא וְאַרְעָא וְכָל יְצִיבָא</tei:l>
          <tei:l>בְּעֶשֶׂר אֲמָרַיָא׃</tei:l>
          <tei:l>וּבַשְׁבִיעִי נַחֲתָּ מִכּוּלְהוֹן אֲמָרַיָא</tei:l>
          <tei:l>וּפָּקַדְתָּא לְעַמָא קַדִשָׁא</tei:l>
          <tei:l>דִלְהוֹן נַחְתָא מִכָּל דִבְּרַיָא</tei:l>
          <tei:l>בְּרַם יַתְהוֹן עַסְקִין בְּחָפְצֵי שְׁמַיָא</tei:l>
          <tei:l>וְרָזֵי סְחָרַיָא׃</tei:l>
          <tei:l>וְעַמַיָא דְאַרְעָא וּנְשַׁיָא יְהוֹן עַסְקִין בְּדָרֵיהוֹן</tei:l>
          <tei:l>בְּלִישְׁנָא קְלִילַיָא</tei:l>
          <tei:l>מַה דְחַייְבִין בְּפּקוּרַיָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:techinah_imahot_for_shabbat_mevorkhim_horowitz/2"/>
        <tei:lg>
          <tei:l>וְכֵן יְהַבְתָּ לָן מוֹעֲדַיָא לְשִׂמְחַיָא</tei:l>
          <tei:l>וְירַחֲיָא לְדוּכְרָנַיָא</tei:l>
          <tei:l>וְכַּד הֲוֵינָה בִּירוּשָׁלַיִם קַרְתָּא דְשׁוּפְרַיָא׃</tei:l>
          <tei:l>אֲחַר בֵּית מוֹתְבָנָא דְאִמְנָא שְׁכִינְתָּא דְכָל שׁוּפְרַיָא</tei:l>
          <tei:l>וְעֵינִי הָעֵדָה הַוִין מְקַדְשִׁין לְפִי רְאוֹת עֵנַיָא</tei:l>
          <tei:l>וּבָעִידְנָא דְגָלִינָא לָא אִשְׁתָּאַר לָן בְּרַם לְבָרֵךְ יַרְחַיָא</tei:l>
          <tei:l>וְעֵת לְחָנְנָה כִּי בָא מוֹעֵד לְבָרֵךְ יַרְחַיָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:techinah_imahot_for_shabbat_mevorkhim_horowitz/3"/>
        <tei:lg>
          <tei:l>אֲנַן מְפָרְשִׁין כַּפַּיָא לְאָבוּנָא רַחֲמָנָא דְבִּשְׁמַיָא</tei:l>
          <tei:l>תִּיב לָן כִּימֵי קֶדֶם</tei:l>
          <tei:l>כִּי כָּשַׁל כֹּחַ הַסַבָּל</tei:l>
          <tei:l>לְגַרְיָא רְכִּיכָה כְּחוֹם צַהֲרַיָא</tei:l>
          <tei:l>שָׁבַת מְשׂוֹשֵׂנוּ חַגֵינוּ וְחָדְשֵׁנוּ</tei:l>
          <tei:l>אֲנַן כְּיַתְמֵי בְּלָא אָבוּהָ</tei:l>
          <tei:l>וּכְעָנָא בְּלָא רַעֲיָא</tei:l>
          <tei:l>יָדוֹ פָּרַשׁ צַר עַל כָּל מַחֲמַדֵי עַיִן</tei:l>
          <tei:l>וְאֵין אוֹמֵר הָשֵׁב</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:techinah_imahot_for_shabbat_mevorkhim_horowitz/4"/>
        <tei:lg>
          <tei:l>אֵל נְקָמוֹת יְיָ הוֹפִיַא מֵהַר פָּארָן</tei:l>
          <tei:l>מַאן דְעָנָה לְאַבְהָתָנָא</tei:l>
          <tei:l>הוּא יַעֲנֶה אוֹתָנָא בְּיַרְחַיָא דָא</tei:l>
          <tei:l>בִּזְכוּתָא דְהַרְרֵי קֶדֶם וּגְבָעוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:techinah_imahot_for_shabbat_mevorkhim_horowitz/5"/>
        <tei:lg>
          <tei:l>שָׂרָה דְפַקִיַת עָלֶיהָ</tei:l>
          <tei:l>אַל תִּגְעוּ בִּמְשִׁיחָי <tei:bibl>(תהלים קה:טו)</tei:bibl></tei:l>
          <tei:l>כֵּן צֶאֱצָאֶיהָ כָּל דְנָגַע בְּחוּ יִדְמוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:techinah_imahot_for_shabbat_mevorkhim_horowitz/6"/>
        <tei:lg>
          <tei:l>רִבְקָה דְגָמַרְתָּ לָן בִּרְכָתָא</tei:l>
          <tei:l>בַּעֲגָלָא תִּתְקַיֵים כֵּן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:techinah_imahot_for_shabbat_mevorkhim_horowitz/7"/>
        <tei:lg>
          <tei:l>רָחֵל דְאַבְטַחֲתָּא</tei:l>
          <tei:l>וְשׁוּבוּ בָּנִים לִגְבוּלָם׃ <tei:bibl>(ירמיה לא:טז)</tei:bibl></tei:l>
          <tei:l>הָשֵׁב שְׁבוּתֵינוּ מַהֵר בְּדִילָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:techinah_imahot_for_shabbat_mevorkhim_horowitz/8"/>
        <tei:lg>
          <tei:l>לֵאָה דְהַווּן עֵינַיָא רְכִּיכָא</tei:l>
          <tei:l>דְלָא תִּפּוֹל בְּגוֹרָלָא דִרְשִׁיעֲיָא</tei:l>
          <tei:l>בִּזְכוּתָא הֵאִיר עֵינַיָא מֵחֲשׁוֹכָא דְגָלוּתָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:techinah_imahot_for_shabbat_mevorkhim_horowitz/9"/>
        <tei:lg>
          <tei:l>יוֹנָה פִּיתָּה</tei:l>
          <tei:l>בְּחֶרֶב רַוְתָה</tei:l>
          <tei:l>כָּל הַיוֹם רְצוּצָה וַחֲמוּסָה׃</tei:l>
          <tei:l>בַּת אַבְרָהָם אָבִינוּ</tei:l>
          <tei:l>בְּרַתָּא׃ דְגָלוּתָא דְנַחֲתָא</tei:l>
          <tei:l>בַּת אַבְרָהָם אָבִינוּ</tei:l>
          <tei:l>יוֹשֶׁבֶת תַּחַת בַּעֲלִים קָשִׁים</tei:l>
          <tei:l>זֶה אוֹמֵר הַךְ</tei:l>
          <tei:l>וְזֶה אוֹמֵר אַף אֲנִי כָּמוֹהוּ׃</tei:l>
          <tei:l>הֶרֶב כַּבְּסֵנוּ</tei:l>
          <tei:l>כִּי כְּבַר לָקִינוּ כִּפְלַיִם בְּמֶרְיֵינוּ׃</tei:l>
          <tei:l>וְחַדֵשׁ וְהָבֵא לָן חוֹדֶשׁ הַזֶה לְחֶדְוָה</tei:l>
          <tei:l>יוֹמַיָא יַרְחַייָא דִמִתְהַפְּכִין מִבִּישָׁא לְטָבָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:techinah_imahot_for_shabbat_mevorkhim_horowitz/10"/>
        <tei:lg>
          <tei:l>גְאוֹן עוּזֵינ‎וּ</tei:l>
          <tei:l>הֲרֵם קַרְנֵינוּ</tei:l>
          <tei:l>הַב לָן מוֹהַר מַתָּנָתָא טַבְתָא</tei:l>
          <tei:l>בְּלִי צָרָה וְעַקְתָא</tei:l>
          <tei:l>בִּזְכוּת יַעֲקֹב בְּחִיר שֶׁבְּאָבוֹת</tei:l>
          <tei:l>בִּזְכוּתוֹ הַטוֹבָה לְרַבּוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:techinah_imahot_for_shabbat_mevorkhim_horowitz/11"/>
        <tei:lg>
          <tei:l>סְגוּלָתִי קָרָאתָ לָן</tei:l>
          <tei:l>וַאֲנָן קָרְאָן לָךְ דוֹדִי</tei:l>
          <tei:l>וְלָךְ אֲנַן מַצְלִין צְלוּתָא דְתֵּיתַב לָן</tei:l>
          <tei:l>וּלְכָל מוֹרָנָא מֵחַבְרַיָא סַפְרַיָא קַדִישַׁיָא׃</tei:l>
          <tei:l>וּמְסַדְרִין צְלוּתַיָא וּבְעוּתַיָא</tei:l>
          <tei:l>בְּנִין דוּכְרִין מֵעַלְמָא דִדְבוּרָא מִסִיטְרָא דְיַמִינָא</tei:l>
          <tei:l>חֲכִּימַיָא בּאוֹרַיְתָא וְנֶעֱבְדִין רְעוּתָא דַאֲהָבוּתָא דְבִּשְׁמַיָא׃</tei:l>
          <tei:l>בָּדְחִילָא וּרְחִימָא עִילָאָה דְעִילָאָה</tei:l>
          <tei:l>כְּמֹשֶׁה רַעֲיָא מְהֶמְנַיָא</tei:l>
          <tei:l>בְּרָא רְחִימָא דְאַבָּא דְאִימָא עִילָאִי</tei:l>
          <tei:l>אָמֵן כֵּן יְהִי רָצוֹן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
