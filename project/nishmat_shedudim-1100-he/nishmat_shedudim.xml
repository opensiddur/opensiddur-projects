      <tei:div corresp="urn:x-opensiddur:text:poem:nishmat_shedudim">
        <tei:head>נִשְׁמַת שְׁדוּדִים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nishmat_shedudim/1"/>
        <tei:lg>
          <tei:l>נִשְׁמַת שְׁׄדוּדִים נְדוּדִים בְּאַרְצוֹת מוֹנִים</tei:l>
          <tei:l>תְּשַׁׄבְּחָךְ מִדֵּי שָׁׄנָה בְשָׁנָה יֶהְגּוּ בְּקִינִים</tei:l>
          <tei:l>דִּבְרֵ֥י יִרְמְיָ֖הוּ בֶּן־חִלְקִיָּ֑הוּ מִן־הַכֹּֽהֲנִים֙׃ <tei:bibl>(ירמיה א:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nishmat_shedudim/2"/>
        <tei:lg>
          <tei:l>נִשְׁמַת מׄוֹרֶה פִּי עֲנָתוֹת וּמַקְשֶׁה רוּחוֹ</tei:l>
          <tei:l>תְּהַלְלָךְ מִׄדֵּי שָׁנָה בְשָׁנָה בְּזׇכְרוֹ דְּבַר מוֹכִיחוֹ</tei:l>
          <tei:l>דִּבְרֵ֥י יְהֹוָ֖ה אֲשֶׁ֣ר שְׁלָח֑וֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nishmat_shedudim/3"/>
        <tei:lg>
          <tei:l>נִשְׁמַת אֲׄמֵלִים עֲמֵלִים לִבָּם יִפְחַד</tei:l>
          <tei:l>תְּאַדְּרָךְ אׇׄזְנָם אָטְמוּ וְלֹא־שָׁמְעוּ יַֽחַד</tei:l>
          <tei:l>דִּבְרֵ֧י הַנְּבִיאִ֛ים פֶּה־אֶחָ֥ד׃ <tei:bibl>(מלכים א׳ כב:יב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nishmat_shedudim/4"/>
        <tei:lg>
          <tei:l>נִשְׁמַת לְׄכוּדִים בְּפַח חֶטְאָם וּבְמִכְמוֹר</tei:l>
          <tei:l>תְּלַׄהֲגָךְ לָׄהֶם תְּבַשֵּׂר דִּבְרֵי נִחוּמִים הָחֵל וְגָמוֹר</tei:l>
          <tei:l>דִּבְרֵ֥י שָׁל֖וֹם לֵאמֹֽר׃ <tei:bibl>(דברים ב:כו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nishmat_shedudim/5"/>
        <tei:lg>
          <tei:l>נִשְׁמַת שְׁׄפָלִים מְׄרוּדִים בְּמֶרְיָם</tei:l>
          <tei:l>תְּשׁוֹרְרָךְ אׄוֹמְרִים לְׄפָֽנֶיךָ בְּעֵת נִהְיָם</tei:l>
          <tei:l>וְאִֽלּוּ פִֽינוּ מָלֵא שִׁירָה כַּיָּם׃</tei:l>
        </tei:lg>
      </tei:div>
