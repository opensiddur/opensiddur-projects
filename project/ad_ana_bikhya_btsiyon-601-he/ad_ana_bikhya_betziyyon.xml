  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ad_ana_bikhya_betziyyon">
        <tei:head>עַד אָנָה בִּכְיָּה בְצִיּוֹן</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_ana_bikhya_betziyyon/1"/>
        <tei:lg>
          <tei:l>עַד אָֽנָה בִּכְיָּה בְצִיּוֹן</tei:l>
          <tei:l>וּמִסְפֵּד בִּירוּשָׁלָֽיִם׃</tei:l>
          <tei:l>תְּרַחֵם צִיּוֹן</tei:l>
          <tei:l>וְתִבְנֶה חוֹמוֹת יְרוּשָׁלָיִם:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_ana_bikhya_betziyyon/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אָ</tei:seg>ז בַּחֲטָאֵֽינוּ חָרַב מִקְדָּשׁ</tei:l>
          <tei:l>וּבַעֲוֹנוֹתֵינוּ נִשְׂרַף הֵיכָל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_ana_bikhya_betziyyon/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>אֶֽרֶץ חֻבְּרָה לָהּ<tei:anchor xml:id="note_1"/> קָשְׁרָה מִסְפֵּד</tei:l>
          <tei:l>וּצְבָא הַשָּׁמַֽיִם נָשְׂאוּ קִינָה:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_ana_bikhya_betziyyon/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">גַּ</tei:seg>ם בָּכוּ בְּמֶֽרֶר שִׁבְטֵי יַעֲקֹב</tei:l>
          <tei:l>וְאַף מַזָּלוֹת יִזְּלוּ דִּמְעָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_ana_bikhya_betziyyon/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">דִּ</tei:seg>גְלֵי יְשֻׁרוּן חָפוּ רֹאשָׁם</tei:l>
          <tei:l>וְכִימָה וּכְסִיל קָדְרוּ פְּנֵיהֶם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_ana_bikhya_betziyyon/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הֶ</tei:seg>עְתִּירוּ אָבוֹת וְאֵל כְּלֹא שׁוֹמֵֽעַ<tei:anchor xml:id="note_3"/></tei:l>
          <tei:l>צָעֲקוּ בָנִים וְלֹא עָנָה אָב׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_ana_bikhya_betziyyon/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>קוֹל הַתֹּר<tei:anchor xml:id="note_5"/> נִשְׁמַע בַּמָּרוֹם</tei:l>
          <tei:l>וְרוֹעֶה נֶאֱמָן לֹא הִטָּה אֹֽזֶן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_ana_bikhya_betziyyon/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זֶֽ</tei:seg>רַע קֹֽדֶשׁ לָבְשׁוּ שַׂקִּים</tei:l>
          <tei:l>וּצְבָא הַשָּׁמַֽיִם גַּם הֵם שַׂק הוּשַׂם כְּסוּתָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_ana_bikhya_betziyyon/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חָ</tei:seg>שַׁךְ הַשֶּֽׁמֶשׁ וְיָרֵֽחַ קָדַר</tei:l>
          <tei:l>וְכוֹכָבִים וּמַזָּלוֹת אָסְפוּ נׇגְהָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_ana_bikhya_betziyyon/10"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">טָ</tei:seg>לֶה רִאשׁוֹן בָּכָה בְּמַר נֶֽפֶשׁ</tei:l>
          <tei:l>עַל כִּי כְבָשָׂיו לָטֶֽבַח הוּבָֽלוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_ana_bikhya_betziyyon/11"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יְ</tei:seg>לָלָה הִשְׁמִיעַ שׁוֹר בַּמְּרוֹמִים</tei:l>
          <tei:l>כִּי עַל צַוָּארֵֽנוּ נִרְדַּֽפְנוּ כֻּלָּֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_ana_bikhya_betziyyon/12"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כּ</tei:seg>וֹכַב תְּאוֹמִים נִרְאָה חָלוּק</tei:l>
          <tei:l>כִּי דַּם אַחִים נִשְׁפַּךְ כַּמַּֽיִם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_ana_bikhya_betziyyon/13"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">לָ</tei:seg>אָֽרֶץ בִּקֵּשׁ לִנְפּוֹל<tei:anchor xml:id="note_10"/> סַרְטָן</tei:l>
          <tei:l>כִּי הִתְעַלַּֽפְנוּ<tei:anchor xml:id="note_11"/> מִפְּנֵי צָמָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_ana_bikhya_betziyyon/14"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מָ</tei:seg>רוֹם נִבְעַת מִפְּנֵי אַרְיֵה</tei:l>
          <tei:l>כִּי שַׁאֲגָתֵֽנוּ לֹא עָלְתָה לַמָּרוֹם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_ana_bikhya_betziyyon/15"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נֶ</tei:seg>הֶרְגוּ בְתוּלוֹת וְגַם בַּחוּרִים</tei:l>
          <tei:l>כִּי עַל כֵּן בְּתוּלָה קָדְרָה פָּנֶֽיהָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_ana_bikhya_betziyyon/16"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">סִ</tei:seg>בֵּב מֹאזְנַֽיִם וּבִקֵּשׁ תְּחִנָּה</tei:l>
          <tei:l>כִּי נִבְחַר לָֽמוֹ<tei:anchor xml:id="note_15"/> מָֽוֶת מֵחַיִּים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_ana_bikhya_betziyyon/17"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">עַ</tei:seg>קְרָב לָבַשׁ פַּחַד וּרְעָדָה</tei:l>
          <tei:l>כִּי בְּחֶֽרֶב וּבְרָעָב שְׁפָטָֽנוּ צוּרֵֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_ana_bikhya_betziyyon/18"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פַּ</tei:seg>לְגֵי מַֽיִם הוֹרִֽידוּ דִּמְעָה כַּנַּֽחַל</tei:l>
          <tei:l>כִּי אוֹת בַּקֶּֽשֶׁת לֹא נִתַּן לָֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_ana_bikhya_betziyyon/19"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">צָֽ</tei:seg>פוּ מַֽיִם עַל רֹאשֵֽׁנוּ</tei:l>
          <tei:l>וּבִדְלִי מָלֵא חִכֵּֽנוּ יָבֵשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_ana_bikhya_betziyyon/20"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קֵ</tei:seg>רַֽבְנוּ קׇרְבָּן וְלֹא נִתְקַבַּל<tei:anchor xml:id="note_21"/></tei:l>
          <tei:l>וּגְדִי פָּסַק שְׂעִיר חַטָּאתֵֽנוּ׃<tei:anchor xml:id="note_22"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_ana_bikhya_betziyyon/21"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רַ</tei:seg>חֲמָנִיּוֹת בִּשְּׁלוּ יַלְדֵּיהֶן</tei:l>
          <tei:l>וּמַזַּל דָּגִים הֶעֱלִים<tei:anchor xml:id="note_24"/> עֵינָיו׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_ana_bikhya_betziyyon/22"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שָׁ</tei:seg>כַֽחְנוּ שַׁבָּת בְּלִבּוֹת שׁוֹבָבִים</tei:l>
          <tei:l>שַׁדַּי שִׁכַּח כׇּל־צִדְקוֹתֵֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_ana_bikhya_betziyyon/23"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">תְּ</tei:seg>קַנֵּא לְצִיּוֹן קִנְאָה גְּדוֹלָה</tei:l>
          <tei:l>וְתָאִיר לְרַבָּֽתִי־עָם מֵאוֹר נׇגְהֶֽךָ:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_ana_bikhya_betziyyon/24"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">הקהל עומד ושליח הציבור אומר בקול:</tei:note>
          </tei:l>
          <tei:l>תְּרַחֵם צִיּוֹן כַּאֲשֶׁר אָמַֽרְתָּ</tei:l>
          <tei:l>וּתְכוֹנְנֶֽהָ כַּאֲשֶׁר דִּבַּֽרְתָּ</tei:l>
          <tei:l>תְּמַהֵר יְשׁוּעָה וְתָחִישׁ גְּאֻלָּה</tei:l>
          <tei:l>וְתָשׁוּב לִירוּשָׁלַֽיִם בְּרַחֲמִים רַבִּים:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_ana_bikhya_betziyyon/25"/>
        <tei:lg>
          <tei:l>כַּכָּתוּב עַל יַד נְבִיאֶֽךְ׃</tei:l>
          <tei:l>לָכֵ֞ן כֹּֽה־אָמַ֣ר יְהֹוָ֗ה</tei:l>
          <tei:l>שַׁ֤בְתִּי לִירוּשָׁלַ֙͏ִם֙ בְּֽרַחֲמִ֔ים</tei:l>
          <tei:l>בֵּיתִי֙ יִבָּ֣נֶה בָּ֔הּ</tei:l>
          <tei:l>נְאֻ֖ם יְהֹוָ֣ה צְבָא֑וֹת</tei:l>
          <tei:l>וְקָ֥ו<tei:anchor xml:id="note_26"/> יִנָּטֶ֖ה עַל־יְרוּשָׁלָֽ͏ִם׃ <tei:bibl>(זכריה א:טז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_ana_bikhya_betziyyon/26"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר׃</tei:l>
          <tei:l>ע֣וֹד ׀ קְרָ֣א לֵאמֹ֗ר</tei:l>
          <tei:l>כֹּ֤ה אָמַר֙ יְהֹוָ֣ה צְבָא֔וֹת</tei:l>
          <tei:l>ע֛וֹד תְּפוּצֶ֥נָה עָרַ֖י מִטּ֑וֹב</tei:l>
          <tei:l>וְנִחַ֨ם יְהֹוָ֥ה עוֹד֙ אֶת־צִיּ֔וֹן</tei:l>
          <tei:l>וּבָחַ֥ר ע֖וֹד בִּירוּשָׁלָֽ͏ִם׃ <tei:bibl>(זכריה א:יז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_ana_bikhya_betziyyon/27"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר׃</tei:l>
          <tei:l>כִּֽי־נִחַ֨ם יְהֹוָ֜ה צִיּ֗וֹן</tei:l>
          <tei:l>נִחַם֙ כׇּל־חׇרְבֹתֶ֔יהָ</tei:l>
          <tei:l>וַיָּ֤שֶׂם מִדְבָּרָהּ֙ כְּעֵ֔דֶן</tei:l>
          <tei:l>וְעַרְבָתָ֖הּ כְּגַן־יְהֹוָ֑ה</tei:l>
          <tei:l>שָׂשׂ֤וֹן וְשִׂמְחָה֙ יִמָּ֣צֵא בָ֔הּ</tei:l>
          <tei:l>תּוֹדָ֖ה וְק֥וֹל זִמְרָֽה׃ <tei:bibl>(ישעיה נא:ג)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" n="1" target="#note_1">
      <tei:p>כינוי לירושלים שלמעלה</tei:p>
    </tei:note>
    <tei:note type="commentary" n="3" target="#note_3">
      <tei:p>נ׳׳א וְלֹא שָׁמַע אֵל</tei:p>
    </tei:note>
    <tei:note type="commentary" n="5" target="#note_5">
      <tei:p>כינוי למשה רבנו</tei:p>
    </tei:note>
    <tei:note type="commentary" n="10" target="#note_10">
      <tei:p>נ׳׳א לִפֹּל ולית נפקא מינה</tei:p>
    </tei:note>
    <tei:note type="commentary" n="11" target="#note_11">
      <tei:p>נ׳׳א נִתְעַלַּֽפְנוּ ולית נפקא מינה</tei:p>
    </tei:note>
    <tei:note type="commentary" n="15" target="#note_15">
      <tei:p>נ׳׳א לָֽנוּ</tei:p>
    </tei:note>
    <tei:note type="commentary" n="21" target="#note_21">
      <tei:p>נ׳׳א נִתְקַבֵּל ולית נפקא מינה</tei:p>
    </tei:note>
    <tei:note type="commentary" n="22" target="#note_22">
      <tei:p>נ׳׳א חַטֹּאתֵֽינוּ</tei:p>
    </tei:note>
