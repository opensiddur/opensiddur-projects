  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:blessing_over_the_torah_reading_schachter_shalomi">
        <tei:head>Blessing over the Torah Reading, at Mishkan Shalom, Philadelphia</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_over_the_torah_reading_schachter_shalomi/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">Person called to the Torah:</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_over_the_torah_reading_schachter_shalomi/2"/>
        <tei:lg>
          <tei:l>Bless Yah, the blessed one.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_over_the_torah_reading_schachter_shalomi/3"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">The congregation responds</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_over_the_torah_reading_schachter_shalomi/4"/>
        <tei:lg>
          <tei:l>Bless Yah, the blessed one, forever.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_over_the_torah_reading_schachter_shalomi/5"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">Say the blessing:</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_over_the_torah_reading_schachter_shalomi/6"/>
        <tei:lg>
          <tei:l>Bless Yah, the blessed one, forever.</tei:l>
          <tei:l>Blessed are you, Yah,</tei:l>
          <tei:l>who has drawn us near to your service</tei:l>
          <tei:l>and has given us the Torah.</tei:l>
          <tei:l>Blessed are you, Yah, giver of the Torah.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_over_the_torah_reading_schachter_shalomi/7"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">When the reading is finished, touch the place the reading ended with your tsitsit.</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">Person called to the Torah:</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_over_the_torah_reading_schachter_shalomi/8"/>
        <tei:lg>
          <tei:l>Yah, the blessed one, Your presence fills creation</tei:l>
          <tei:l>You gave us the Torah of truth</tei:l>
          <tei:l>and implanted eternal life within us.</tei:l>
          <tei:l>Blessed are you, Yah, giver of Torah.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_over_the_torah_reading_schachter_shalomi/9"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">At this point, move to the other side of the Reader. The next aliyah will be called and then you will receive a Mi Sheberaḥ (a blessing). You then stand through the next reading. Return slowly to your seat when the next aliyah moves to the left of the Reader. (The reason for this is that you are in a hurry to get to the Torah, but reluctant to leave it.)</tei:note>
          </tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
