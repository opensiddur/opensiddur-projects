  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:yehallelukha_tarlau">
        <tei:head>יְהַלְלֽוּךָ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yehallelukha_tarlau/1"/>
        <tei:lg>
          <tei:l>יְהַלְלֽוּךָ יְיָ אֱלֹהֵֽינוּ (על) כָּל־מַעֲשֶֽׂיךָ,</tei:l>
          <tei:l>וַחֲסִידֶֽיךָ צַדִּיקִים עוֹשֵׂי רְצוֹנֶֽךָ,</tei:l>
          <tei:l>וְכָל־עַמְּךָ בֵּית יִשְׂרָאֵל,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yehallelukha_tarlau/3"/>
        <tei:lg>
          <tei:l>בְּרִנָּה יוֹדוּ וִיבָרְכוּ,</tei:l>
          <tei:l>וִישַׁבְּחוּ וִיפָאֲרוּ,</tei:l>
          <tei:l>וִירוֹמְמוּ וְיַעֲרִֽיצוּ,</tei:l>
          <tei:l>וְיַקְדִּֽישׁוּ וְיַמְלִֽיכוּ אֶת שִׁמְךָ מַלְכֵּֽנוּ.</tei:l>
          <tei:l>כִּי לְךָ טוֹב לְהוֹדוֹת,</tei:l>
          <tei:l>וּלְשִׁמְךָ נָאֶה לְזַמֵּר,</tei:l>
          <tei:l>כִּי מֵעוֹלָם וְעַד עוֹלָם אַתָּה אֵל.</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְיָ, מֶֽלֶךְ מְהֻלָּל בַּתִּשְׁבָּחוֹת:</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
