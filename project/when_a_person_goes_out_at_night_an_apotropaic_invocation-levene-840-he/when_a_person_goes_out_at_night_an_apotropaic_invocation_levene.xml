      <tei:div corresp="urn:x-opensiddur:text:prayer:when_a_person_goes_out_at_night_an_apotropaic_invocation_levene">
        <tei:head>כשיוצא אדם בלילה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:when_a_person_goes_out_at_night_an_apotropaic_invocation_levene/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כשיוצא אדם</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">[יחידי]</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">בלילה</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">בלא שעה</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">אומר:</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:when_a_person_goes_out_at_night_an_apotropaic_invocation_levene/2"/>
        <tei:lg>
          <tei:l>מימיני אל</tei:l>
          <tei:l>ומשמאלי עזיאל</tei:l>
          <tei:l>ומלפני נמואל</tei:l>
          <tei:l>ומאחורי שעשואל.</tei:l>
          <tei:l>שכינת אל על ראשי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:when_a_person_goes_out_at_night_an_apotropaic_invocation_levene/3"/>
        <tei:lg>
          <tei:l>הצילני ה׳</tei:l>
          <tei:l>מפגע רע</tei:l>
          <tei:l>ומשטן רע.</tei:l>
        </tei:lg>
      </tei:div>
