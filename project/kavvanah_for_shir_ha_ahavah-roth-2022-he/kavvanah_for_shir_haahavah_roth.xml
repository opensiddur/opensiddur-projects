    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:kavvanah_for_shir_haahavah_roth">
        <tei:head>כַּוָּנוֹתִי בְּשִׁיר הָאַהֲבָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kavvanah_for_shir_haahavah_roth/1"/>
        <tei:lg>
          <tei:l>רִבּוֹנוֹ שֶׁל עוֹלָם.</tei:l>
          <tei:l>גָּלוּי וְיָדוּעַ לְפָנֶיךָ כַּוָּנוֹתִי</tei:l>
          <tei:l>בְּשִׁיר הָאַהֲבָה</tei:l>
          <tei:l>שֶׁהִנְנִי מוֹצִיא בַּיּוֹם הַזֶּה לְבָנֶיךָ,</tei:l>
          <tei:l>אַחַי בְּנֵי יִשְׂרָאֵל.</tei:l>
          <tei:l>כִּי כַּוָּנָתִי לְרַפֵּא שִׁבְרֵי נַפְשׁוֹ שֶׁל יִשְׂרָאֵל</tei:l>
          <tei:l>אֲשֶׁר נִשְׁבְּרָה וְנִשְׂרְטָה בְּגָלוּתוֹ הַמַּר,</tei:l>
          <tei:l>כִּי נִשְׁכְּחָה תּוֹרַת הָאַהֲבָה מִלִּבָּם שֶׁל יִשְׂרָאֵל,</tei:l>
          <tei:l>מֵרוֹב צַעֲרָם וְדָחְקָם בְּגָלוּתָם,</tei:l>
          <tei:l>וּמֵחֲמַת זֶה</tei:l>
          <tei:l>הָיוּ מְשַׁדְּכִים לְעִתִּים תְּכוּפוֹת</tei:l>
          <tei:l>אֶת בְּנֵיהֶם וּבְנוֹתֵיהֶם</tei:l>
          <tei:l>לְלֹא גַּעְגּוּעַ וְאַהֲבָה אֲמִתִּיִּים בֵּינֵיהֶם,</tei:l>
          <tei:l>וּמַבִּיטִים לָרוֹב בְּעִקָּר עַל הַחִיצוֹנִיּוּת וְהַמִּשְׁפָּחָה,</tei:l>
          <tei:l>שֶׁלֹּא כְּדֶרֶךְ אֲבוֹתֵינוּ הַקְּדוֹשִׁים</tei:l>
          <tei:l>אֲבוֹת הָאוּמָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kavvanah_for_shir_haahavah_roth/2"/>
        <tei:lg>
          <tei:l>וְהִנְנִי בִּתְפִלָּה לְפָנֶיךָ אָבִי שֶׁבַּשָּׁמַיִם,</tei:l>
          <tei:l>שֶׁיְּהֵא הַשִּׁיר הַזֶּה מְעוֹרֵר אַהֲבָה וָאוֹר בָּעוֹלָם,</tei:l>
          <tei:l>וִיעוֹרֵר הַשִּׁיר אַהֲבַת דּוֹדִים,</tei:l>
          <tei:l>כִּי הִגִּיעַ עֵת דּוֹדִים,</tei:l>
          <tei:l>וְנִזְכֶּה בְּקָרוֹב לַחֲזוֹת בְּנוֹעַם אַהֲבָתְךָ</tei:l>
          <tei:l>וְאוֹרְךָ בְּהִתְגַּלּוּת אוֹר הַגְּאוּלָּה הַשְּׁלֵמָה עָלֵינוּ.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
