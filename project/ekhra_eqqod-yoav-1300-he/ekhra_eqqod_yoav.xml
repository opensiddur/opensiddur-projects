    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ekhra_eqqod_yoav">
        <tei:head>אֶכְרַע אֶקֹּד</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ekhra_eqqod_yoav/1"/>
        <tei:lg>
          <tei:l>אֶכְרַע אֶקֹּד לִפְנֵי מַלְכִּי</tei:l>
          <tei:l>אֶקְרָאֶה מִפָּנָיו אַבְרֵךְ</tei:l>
          <tei:l>שׁוֹפֵט יָשָׁר הוּא אֵלִי, כִּי</tei:l>
          <tei:l>יוֹרֶ֖ה חַטָּאִ֣ים בַּדָּֽרֶךְ׃</tei:l>
          <tei:l>אֶכְרַע אֶקֹּד...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ekhra_eqqod_yoav/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">י</tei:seg>וֹם זֶה יוֹם הַדִּין הוּא נִקְרָא</tei:l>
          <tei:l>מִשְׁפָּט הוּא לֵאלֹהֵי יַעֲקֹב</tei:l>
          <tei:l>יֹשֵׁב עַל־כִּסֵּא רָם נוֹרָא</tei:l>
          <tei:l>וּלְמִישׁוֹר יַיְשִׁיר הֶעָקֹב</tei:l>
          <tei:l>עַל־הֶאָח תּוֹךְ אֵשׁ בּוֹעֲרָה</tei:l>
          <tei:l>יַבְעִיר כׇל־אָח֙ עָק֣וֹב יַעְקֹ֔ב</tei:l>
          <tei:l>לָכֵן אַתְּ שׁוֹכֶֽבֶת חֵיקִי</tei:l>
          <tei:l>הִתְנַחֲמִי סִפְקִי עַל־יָרֵךְ</tei:l>
          <tei:l>עַל־בָּמוֹת יֵֽצֶר לֵב דִּרְכִי</tei:l>
          <tei:l>תִּרְדִּי בוֹ בַּעֲבוֹדַת פָּֽרֶךְ׃</tei:l>
          <tei:l>אֶכְרַע אֶקֹּד...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ekhra_eqqod_yoav/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וּ</tei:seg>בִתְרוּעַת מֶֽלֶךְ עוּרִי</tei:l>
          <tei:l>וּבִתְקֹֽעַ שׁוֹפָר שִׁמְעִי</tei:l>
          <tei:l>וּבִשְׁבָרִים יִצְרֵךְ שִׁבְרִי</tei:l>
          <tei:l>הַשְׁפִּֽילִי אוֹתוֹ הַכְנִֽיעִי</tei:l>
          <tei:l>וּזְדוֹן עׇרְלַת לֵב הָסִֽירִי</tei:l>
          <tei:l>הוֹחִילִי לֵאלֹהֵי יִשְׁעִי.</tei:l>
          <tei:l>שֽׁוּבִי שׁוּלַמִּית עָדָיו, כִּי</tei:l>
          <tei:l>חַנּוּן וְרַחוּם הוּא אַף אֶֽרֶךְ</tei:l>
          <tei:l>גּוֹאֵ֣ל מִשַּׁ֣חַת חַיָּ֑יְכִי</tei:l>
          <tei:l>אֵין לוֹ דִּמְיוֹן אַף לֹא עֵֽרֶךְ׃</tei:l>
          <tei:l>אֶכְרַע אֶקֹּד...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ekhra_eqqod_yoav/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אֵ</tei:seg>ל דָּרַשׁ סֵֽפֶר, וַיִּקְרָא</tei:l>
          <tei:l>אַיֵּה שֹׁקֵל אַיֵּה סֹפֵר</tei:l>
          <tei:l>וּלְצַדִּיק דּוֹרֵךְ הַיְשָׁרָה</tei:l>
          <tei:l>דּוֹדִי לִי אֶשְׁכּוֹל הַכֹּֽפֶר</tei:l>
          <tei:l>וּרְשָׁעִים יִשְׁתּוּ מֵי מָרָה</tei:l>
          <tei:l>אוֹכֶֽלֶת אֵשׁ כׇּל־הַכּוֹפֵר.</tei:l>
          <tei:l>וּמִמַּחֲצִית פִּשְׁעִי עֶרְכִּי</tei:l>
          <tei:l>מַעֲבִיר רִאשׁוֹן צוּר מִתְבָּרֵךְ</tei:l>
          <tei:l>וּמַכְרִֽיעַ מֹאזְנֵי צִדְקִי</tei:l>
          <tei:l>וּמֵשִׂים פְּעָמַי לַדֶּֽרֶךְ׃</tei:l>
          <tei:l>אֶכְרַע אֶקֹּד...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ekhra_eqqod_yoav/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בִּ</tei:seg>ינוּ־נָא זֹאת הָאֵל דִּרְשׁוּ</tei:l>
          <tei:l>מִיּוֹם דִּין עַד־יוֹם כַּפָּרָה</tei:l>
          <tei:l>וּבִנְתַּֽיִם פָּנָיו בַּקְּשׁוּ</tei:l>
          <tei:l>לֹא יַשְׁחִית בַּעֲבוּר הָעֲשָׂרָה</tei:l>
          <tei:l>וּבְכׇל־לֵב אוֹתוֹ תַקְדִּֽישׁוּ</tei:l>
          <tei:l>הוּא יַצִּילְכֶם מִכׇּל־צָרָה.</tei:l>
          <tei:l>גַּם אַתְּ נַפְשִׁי אֵלִי בָּרְכִי</tei:l>
          <tei:l>וּלְפָנָיו הַכְרִֽיעִי בֶֽרֶךְ</tei:l>
          <tei:l>הוּא יִגְמֹל חֶֽסֶד עָלָֽיְכִי</tei:l>
          <tei:l>ק֥וּמִי א֖וֹרִי כִּ֣י בָ֣א אוֹרֵ֑ךְ</tei:l>
          <tei:l>אֶכְרַע אֶקֹּד...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
