  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:el_male_rachamim_29393">
        <tei:head>אֵל מָלֵא רַחֲמִים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:el_male_rachamim_29393/1"/>
        <tei:lg>
          <tei:l>אֵל מָלֵא רַחֲמִים שׁוֹכֵן בַּמְּרוֹמִים,</tei:l>
          <tei:l>הַמְצֵא מְנוּחָה נְכוֹנָה עַל כַּנְפֵי הַשְּׁכִינָה,</tei:l>
          <tei:l>בְּמַעֲלוֹת קְדוֹשִׁים וּטְהוֹרִים</tei:l>
          <tei:l>כְּזוֹהַר הָרָקִיעַ מַזְהִירִים,</tei:l>
          <tei:l>(<tei:note type="instruction">שם</tei:note>) אֶת נִשְׁמַת‏</tei:l>
          <tei:l>שֶׁהָלַךְ לְעוֹלָמוֹ,</tei:l>
          <tei:l>תְּהֵא מְנוּחָתוֹ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:el_male_rachamim_29393/4"/>
        <tei:lg>
          <tei:l>לְזֶה אֲנִי אוֹמָר</tei:l>
          <tei:l>אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
