    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:non_e_come_lo_ded_nostro_a_renaissance_judeo_italian">
        <tei:head>אֵין כֵּאלֹהֵֽינוּ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:non_e_come_lo_ded_nostro_a_renaissance_judeo_italian/1"/>
        <tei:lg>
          <tei:l>אֵין כֵּאלֹהֵֽינוּ</tei:l>
          <tei:l>אֵין כַּאדוֹנֵֽינוּ</tei:l>
          <tei:l>אֵין כְּמַלְכֵּֽנוּ</tei:l>
          <tei:l>אֵין כְּמוֹשִׁיעֵֽנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:non_e_come_lo_ded_nostro_a_renaissance_judeo_italian/2"/>
        <tei:lg>
          <tei:l>מִי כֵאלֹהֵֽינוּ</tei:l>
          <tei:l>מִי כַּאדוֹנֵֽינוּ</tei:l>
          <tei:l>מִי כְמַלְכֵּֽנוּ</tei:l>
          <tei:l>מִי כְמוֹשִׁיעֵֽנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:non_e_come_lo_ded_nostro_a_renaissance_judeo_italian/3"/>
        <tei:lg>
          <tei:l>נוֹדֶה לֵאלֹהֵֽינוּ</tei:l>
          <tei:l>נוֹדֶה לַאדוֹנֵֽינוּ</tei:l>
          <tei:l>נוֹדֶה לְמַלְכֵּֽנוּ</tei:l>
          <tei:l>נוֹדֶה לְמוֹשִׁיעֵֽנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:non_e_come_lo_ded_nostro_a_renaissance_judeo_italian/4"/>
        <tei:lg>
          <tei:l>אַתָּה הוּא אֱלֹהֵֽינוּ</tei:l>
          <tei:l>אַתָּה הוּא אֲדוֹנֵֽינוּ</tei:l>
          <tei:l>אַתָּה הוּא מַלְכֵּֽנוּ</tei:l>
          <tei:l>אַתָּה הוּא מוֹשִׁיעֵֽנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:non_e_come_lo_ded_nostro_a_renaissance_judeo_italian/5"/>
        <tei:lg>
          <tei:l>יְהֹוָ֥ה חָפֵ֖ץ</tei:l>
          <tei:l>לְמַ֣עַן צִדְק֑וֹ</tei:l>
          <tei:l>יַגְדִּ֥יל תּוֹרָ֖ה וְיַאְדִּֽיר׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
