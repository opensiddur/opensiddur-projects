  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:birkat_hamappil">
        <tei:head>בִּרְכָּת הַמַּפִּיל</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamappil/1"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>הַמַּפִּיל חֶבְלֵי שֵׁנָה</tei:l>
          <tei:l>עַל עֵינָי וּתְנוּמָה</tei:l>
          <tei:l>עַל עַפְעַפָּי:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamappil/2"/>
        <tei:lg>
          <tei:l>וִיהִי רָצוֹן מִלְּפָנֶֽיךָ</tei:l>
          <tei:l>יְהֹוָה אֱלֹהַי וֵאלֹהֵי אֲבוֹתַי</tei:l>
          <tei:l>שֶׁתַּשְׁכִּיבֵֽנִי לְשָׁלוֹם</tei:l>
          <tei:l>וְתַעֲמִידֵֽנִי לְשָׁלוֹם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamappil/3"/>
        <tei:lg>
          <tei:l>וְאַל יְבַהֲלֽוּנִי רַעְיוֹנַי</tei:l>
          <tei:l>וַחֲלוֹמוֹת רָעִים וְהַרְהוֹרִים רָעִים</tei:l>
          <tei:l>וּתְהֵא מִטָּתִי שְׁלֵמָה לְפָנֶֽיךָ</tei:l>
          <tei:l>וְהָאֵר עֵינַי פֶּן אִישַׁן הַמָּֽוֶת</tei:l>
          <tei:l>כִּי אַתָּה הַמֵּאִיר לְאִישׁוֹן בַּת עָֽיִן:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamappil/4"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה</tei:l>
          <tei:l>הַמֵּאִיר לָעוֹלָם כֻּלּוֹ בִּכְבוֹדוֹ:</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
