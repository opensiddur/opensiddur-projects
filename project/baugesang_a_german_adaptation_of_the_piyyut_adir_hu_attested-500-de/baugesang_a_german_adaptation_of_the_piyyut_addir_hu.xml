  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:baugesang_a_german_adaptation_of_the_piyyut_addir_hu">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_a_german_adaptation_of_the_piyyut_addir_hu/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">Die Ceremonien, welche gebraucht werden bey den zwey Oster-Nächten mit grosser Andacht gebetten und vollbracht , und lauten also auß ihrem Kabala:</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_a_german_adaptation_of_the_piyyut_addir_hu/2"/>
        <tei:lg>
          <tei:l>Allmächtiger Gott,</tei:l>
          <tei:l>nun bau dein Tempel Schyro</tei:l>
          <tei:l>also in Schier und alsobald</tei:l>
          <tei:l>in unseren Tagen Schyro</tei:l>
          <tei:l>ja Schiro.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_a_german_adaptation_of_the_piyyut_addir_hu/3"/>
        <tei:lg>
          <tei:l>Barmhaffter GOtt,</tei:l>
          <tei:l>grosser GOtt,</tei:l>
          <tei:l>demühtiger GOtt,</tei:l>
          <tei:l>hoher GOtt,</tei:l>
          <tei:l>feiner GOtt,</tei:l>
          <tei:l>Süsser und demühtiger GOtt,</tei:l>
          <tei:l>Jüdischer GOtt,</tei:l>
          <tei:l>nun bau dein Tempel Schyro</tei:l>
          <tei:l>also Schier und alsobald,</tei:l>
          <tei:l>und baue dein Tempel Schiro.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_a_german_adaptation_of_the_piyyut_addir_hu/4"/>
        <tei:lg>
          <tei:l>Kräfftiger lebendiger mächtiger</tei:l>
          <tei:l>Namhaffter ewiger forchtsammer</tei:l>
          <tei:l>reicher Königlicher waherer</tei:l>
          <tei:l>schöner GOtt,</tei:l>
          <tei:l>nun bau dein Tempel Schyro also schier</tei:l>
          <tei:l>und alsobald</tei:l>
          <tei:l>in unseren Tägen<tei:anchor xml:id="note_2"/> Schiro.</tei:l>
          <tei:l>Nun baue dein Tempel Schiro.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" n="2" target="#note_2">
      <tei:p>Probably a typo for Tagen</tei:p>
