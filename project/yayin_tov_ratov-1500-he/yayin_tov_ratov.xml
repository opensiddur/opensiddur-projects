  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yayin_tov_ratov">
        <tei:head>יַֽיִן טוֹב</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yayin_tov_ratov/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יַֽ</tei:seg>יִן טוֹב רָטֹב הַשְׁקִֽינִי</tei:l>
          <tei:l>יָפָה מַרְאַֽיִךְ הַרְאִֽינִי</tei:l>
          <tei:l>בְּעֵינַֽיִךְ לִבַּבְתִּֽינִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yayin_tov_ratov/2"/>
        <tei:lg>
          <tei:l>אֲחוֹתִי כַלָּה חִישׁ עוּרִי</tei:l>
          <tei:l>זַמְּרִי וְשִׁיר דַבֵּֽרִי</tei:l>
          <tei:l>אֲחוֹתִי כַלָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yayin_tov_ratov/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">צְ</tei:seg>בִיָּה לִבִּי חֳמַרְמָר</tei:l>
          <tei:l>לִנְדוֹדֵךְ מְאֹד מַר־לִי מָר</tei:l>
          <tei:l>מָה־אֶעֱנֶה וּמָה־אוֹמַר</tei:l>
          <tei:l>אֲחוֹתִי כַלָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yayin_tov_ratov/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חָ</tei:seg>שַֽׁקְתִּי לִרְאוֹת פָּנַֽיִךְ</tei:l>
          <tei:l>טוֹבִים מִיַּֽיִן דּוֹדָֽיִךְ</tei:l>
          <tei:l>מַה־יָּפו־לִי פְּעָמָֽיִךְ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yayin_tov_ratov/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>רֵב קֵץ חֲזוֹן פְּדוּתֵךְ</tei:l>
          <tei:l>מַהֵר אָשִׁיב אֶת־שְׁבוּתֵךְ</tei:l>
          <tei:l>וְיֵשׁ־תִּקְוָ֥ה לְאַחֲרִיתֵ֖ךְ</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
