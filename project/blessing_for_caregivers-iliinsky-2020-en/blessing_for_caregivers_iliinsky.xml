  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:blessing_for_caregivers_iliinsky">
        <tei:head>Blessing for Caregivers, by Rabbi Me’irah Iliinsky</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_for_caregivers_iliinsky/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">For Caregivers</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_for_caregivers_iliinsky/2"/>
        <tei:lg>
          <tei:l>Know that your hands are the manifestation of love</tei:l>
          <tei:l>Your pace is the embodiment of patience</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_for_caregivers_iliinsky/3"/>
        <tei:lg>
          <tei:l>Your voice speaks gentleness</tei:l>
          <tei:l>Your being is selflessness</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_for_caregivers_iliinsky/4"/>
        <tei:lg>
          <tei:l>May you be kept from every harm and sickness</tei:l>
          <tei:l>May you experience joy in your kindness</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_for_caregivers_iliinsky/5"/>
        <tei:lg>
          <tei:l>May your heart be soothed by loving eyes gazing toward you</tei:l>
          <tei:l>May your soul be comforted in times of loss</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_for_caregivers_iliinsky/6"/>
        <tei:lg>
          <tei:l>And may you know that you are a blessing</tei:l>
          <tei:l>Bringing holiness into this world.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
