  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_amid_the_pandemic_mirvis">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_amid_the_pandemic_mirvis/1"/>
        <tei:lg>
          <tei:l>אָבִינוּ שֶׁבַּשָּׁמַיִם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_amid_the_pandemic_mirvis/2"/>
        <tei:lg>
          <tei:l>כִּי אַעֲלֶה אֲרֻכָה לָךְ</tei:l>
          <tei:l>וּמִמַּכּוֹתַיִךְ אֶרְפָּאֵךְ נְאֻם־ה׳ <tei:bibl>(ירמיה ל:יז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_amid_the_pandemic_mirvis/9"/>
        <tei:lg>
          <tei:l>וַאֲנִי תְפִלָּתִי־לְךָ יְהוָה עֵת רָצוֹן <tei:bibl>(תהלים סט:יד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_amid_the_pandemic_mirvis/10"/>
        <tei:lg>
          <tei:l>וְכֵן יְהִי רָצוֹן</tei:l>
          <tei:l>אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
