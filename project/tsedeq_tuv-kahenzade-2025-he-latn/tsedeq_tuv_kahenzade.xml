  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:tsedeq_tuv_kahenzade">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tsedeq_tuv_kahenzade/1"/>
        <tei:lg>
          <tei:l>Ṣed̲eq ṭûḇ, û-mēṭîḇ la’kōl mi’kōl û-ḇə’k̲ōl,</tei:l>
          <tei:l>Mēʾăsher ʾōsher la-məʾushâr bə’mîshôr</tei:l>
          <tei:l>ʾAshrei hâʾîsh ʾăsher ṣaddîq lə-maʿan ṣed̲eq.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tsedeq_tuv_kahenzade/2"/>
        <tei:lg>
          <tei:l>Rəṣôn hâʾAd̲ôn Tôrat̲ Tifʾeret̲ tâmîd̲,</tei:l>
          <tei:l>Ḥōq ha-Shōfēṭ Mishpaṭ Ṣed̲eq niṣ’ḥî</tei:l>
          <tei:l>ʾAk̲ēn kēn hûʾ hâ-Rōʕeh l’yîrēʾâv ləʕōlâm.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tsedeq_tuv_kahenzade/3"/>
        <tei:lg>
          <tei:l>Va’yishtaḥăvû la-Melek̲ she’ḥâfēṣ lə-haṣdēq,</tei:l>
          <tei:l>V’yîrannənû ʕammô ʕimmô bə’rinnâh nəhîrâh,</tei:l>
          <tei:l>Kî ʾēlâv ha-Mamlâkhâh ləʕōləmê ʕōlâmîm,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tsedeq_tuv_kahenzade/4"/>
        <tei:lg>
          <tei:l>ʾÂmēn.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
