  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:saturday_afternoon_request_barenblat">
        <tei:head>Saturday Afternoon Request, by Rabbi Rachel Barenblat</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:saturday_afternoon_request_barenblat/1"/>
        <tei:lg>
          <tei:l>Help me to silence</tei:l>
          <tei:l>my mind’s aggravation alarm,</tei:l>
          <tei:l>to quiet the voice which says</tei:l>
          <tei:l>the to-do list matters,</tei:l>
          <tei:l>to temporarily eschew</tei:l>
          <tei:l>continuous partial attention.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:saturday_afternoon_request_barenblat/2"/>
        <tei:lg>
          <tei:l>Open me to long slow conversations</tei:l>
          <tei:l>on the sunlit grass, to the beat</tei:l>
          <tei:l>of the hand-drummers who accompany</tei:l>
          <tei:l>the singing of psalms, to a boat</tei:l>
          <tei:l>lazily drifting on the glassy surface</tei:l>
          <tei:l>of my heart’s own pond.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:saturday_afternoon_request_barenblat/3"/>
        <tei:lg>
          <tei:l>You’re waiting for me</tei:l>
          <tei:l>like a lover, eager</tei:l>
          <tei:l>to embrace me again.</tei:l>
          <tei:l>Remind me: this is the way</tei:l>
          <tei:l>back to Eden, the bloom</tei:l>
          <tei:l>on the thirteen-petaled rose.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
