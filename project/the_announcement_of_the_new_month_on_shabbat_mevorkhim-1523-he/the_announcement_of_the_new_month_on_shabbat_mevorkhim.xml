  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:the_announcement_of_the_new_month_on_shabbat_mevorkhim">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_announcement_of_the_new_month_on_shabbat_mevorkhim/2"/>
        <tei:lg>
          <tei:l>יְהֹוָה אֱלֹהֵי יִשְׂרָאֵל</tei:l>
          <tei:l>בְּרַחֲמָיו הָרַבִּים וּבַחֲסָדָיו הַגְּדוֹלִים וְהַנְּעִימִים</tei:l>
          <tei:l>הוּא יַשְׁקִיף מִמְּעוֹנוֹ</tei:l>
          <tei:l>עַל מִקְדָּשׁוֹ</tei:l>
          <tei:l>וְעַל הֵיכָלוֹ</tei:l>
          <tei:l>וִינַעֲרֵֽהוּ מֵעֲפָרוֹ</tei:l>
          <tei:l>וִיקוֹמְמֵֽהוּ מֵהֲרִיסוּתוֹ</tei:l>
          <tei:l>וְיִבְנֵֽהוּ בִּנְיָן מְפֹאָר</tei:l>
          <tei:l>בִּנְיָן מְשֻׁכְלָל</tei:l>
          <tei:l>בִּנְיָן אֲשֶׁר לֹא יֵהָרֵס</tei:l>
          <tei:l>וְלֹא יִנָּתֵץ לְעוֹלָם בְּיָמֵֽינוּ</tei:l>
          <tei:l>וּבִימֵי כׇּל בֵּית יִשְׂרָאֵל</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_announcement_of_the_new_month_on_shabbat_mevorkhim/3"/>
        <tei:lg>
          <tei:l>כַּכָּתוּב</tei:l>
          <tei:l>בָּנֹ֥ה בָנִ֛יתִי בֵּ֥ית זְבֻ֖ל לָ֑ךְ</tei:l>
          <tei:l>מָכ֥וֹן לְשִׁבְתְּךָ֖ עוֹלָמִֽים׃ <tei:bibl>(מלכים א׳ ח:יג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_announcement_of_the_new_month_on_shabbat_mevorkhim/4"/>
        <tei:lg>
          <tei:l>וְכָתוּב</tei:l>
          <tei:l>ע֤וֹד אֶבְנֵךְ֙</tei:l>
          <tei:l>וְֽנִבְנֵ֔ית בְּתוּלַ֖ת יִשְׂרָאֵ֑ל</tei:l>
          <tei:l>ע֚וֹד תַּעְדִּ֣י תֻפַּ֔יִךְ</tei:l>
          <tei:l>וְיָצָ֖את בִּמְח֥וֹל מְשַׂחֲקִֽים׃ <tei:bibl>(ירמיה לא:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_announcement_of_the_new_month_on_shabbat_mevorkhim/5"/>
        <tei:lg>
          <tei:l>וְכָתוּב</tei:l>
          <tei:l>כֹּ֣ה ׀ אָמַ֣ר יְהֹוָ֗ה</tei:l>
          <tei:l>הִנְנִי־שָׁב֙ שְׁבוּת֙ אׇהֳלֵ֣י יַֽעֲק֔וֹב</tei:l>
          <tei:l>וּמִשְׁכְּנֹתָ֖יו אֲרַחֵ֑ם</tei:l>
          <tei:l>וְנִבְנְתָ֥ה עִיר֙ עַל־תִּלָּ֔הּ</tei:l>
          <tei:l>וְאַרְמ֖וֹן עַל־מִשְׁפָּט֥וֹ יֵשֵֽׁב׃ <tei:bibl>(ירמיה ל:יח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_announcement_of_the_new_month_on_shabbat_mevorkhim/6"/>
        <tei:lg>
          <tei:l>וְכָתוּב</tei:l>
          <tei:l>וּבָנ֥וּ בָתִּ֖ים</tei:l>
          <tei:l>וְיָשָׁ֑בוּ</tei:l>
          <tei:l>וְנָטְע֣וּ כְרָמִ֔ים</tei:l>
          <tei:l>וְאָכְל֖וּ פִּרְיָֽם׃ <tei:bibl>(ישעיה סד:כא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_announcement_of_the_new_month_on_shabbat_mevorkhim/7"/>
        <tei:lg>
          <tei:l>וְכָתוּב</tei:l>
          <tei:l>לֹ֤א יִבְנוּ֙ וְאַחֵ֣ר יֵשֵׁ֔ב</tei:l>
          <tei:l>לֹ֥א יִטְּע֖וּ וְאַחֵ֣ר יֹאכֵ֑ל</tei:l>
          <tei:l>כִּֽי־כִימֵ֤י הָעֵץ֙ יְמֵ֣י עַמִּ֔י</tei:l>
          <tei:l>וּמַעֲשֵׂ֥ה יְדֵיהֶ֖ם יְבַלּ֥וּ בְחִירָֽי׃ <tei:bibl>(ישעיה סד:כב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_announcement_of_the_new_month_on_shabbat_mevorkhim/8"/>
        <tei:lg>
          <tei:l>וְכָתוּב</tei:l>
          <tei:l>לֹ֤א יִֽיגְעוּ֙ לָרִ֔יק</tei:l>
          <tei:l>וְלֹ֥א יֵלְד֖וּ לַבֶּהָלָ֑ה</tei:l>
          <tei:l>כִּ֣י זֶ֜רַע בְּרוּכֵ֤י יְהֹוָה֙ הֵ֔מָּה</tei:l>
          <tei:l>וְצֶאֱצָאֵיהֶ֖ם אִתָּֽם׃ <tei:bibl>(ישעיה סד:כג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_announcement_of_the_new_month_on_shabbat_mevorkhim/9"/>
        <tei:lg>
          <tei:l>וְכָתוּב</tei:l>
          <tei:l>וְהָיָ֥ה טֶרֶם־יִקְרָ֖אוּ</tei:l>
          <tei:l>וַאֲנִ֣י אֶעֱנֶ֑ה</tei:l>
          <tei:l>ע֛וֹד הֵ֥ם מְדַבְּרִ֖ים</tei:l>
          <tei:l>וַאֲנִ֥י אֶשְׁמָֽע׃ <tei:bibl>(ישעיה סד:כד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_announcement_of_the_new_month_on_shabbat_mevorkhim/10"/>
        <tei:lg>
          <tei:l>וְכָתוּב</tei:l>
          <tei:l>וְֽ֠הָיָ֠ה מִסְפַּ֤ר בְּנֵֽי־יִשְׂרָאֵל֙ כְּח֣וֹל הַיָּ֔ם</tei:l>
          <tei:l>אֲשֶׁ֥ר לֹֽא־יִמַּ֖ד וְלֹ֣א יִסָּפֵ֑ר</tei:l>
          <tei:l>וְֽ֠הָיָ֠ה בִּמְק֞וֹם אֲשֶׁר־יֵאָמֵ֤ר לָהֶם֙ לֹא־עַמִּ֣י</tei:l>
          <tei:l>אַתֶּ֔ם יֵאָמֵ֥ר לָהֶ֖ם בְּנֵ֥י אֵֽל־חָֽי׃ <tei:bibl>(הושע ב:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_announcement_of_the_new_month_on_shabbat_mevorkhim/11"/>
        <tei:lg>
          <tei:l>וְכָתוּב</tei:l>
          <tei:l>וְהָיָ֣ה ׀ בַּיּ֣וֹם הַה֗וּא יִתָּקַע֮ בְּשׁוֹפָ֣ר גָּדוֹל֒</tei:l>
          <tei:l>וּבָ֗אוּ הָאֹֽבְדִים֙ בְּאֶ֣רֶץ אַשּׁ֔וּר</tei:l>
          <tei:l>וְהַנִּדָּחִ֖ים בְּאֶ֣רֶץ מִצְרָ֑יִם</tei:l>
          <tei:l>וְהִשְׁתַּחֲו֧וּ לַיהֹוָ֛ה</tei:l>
          <tei:l>בְּהַ֥ר הַקֹּ֖דֶשׁ בִּירוּשָׁלָֽ͏ִם׃ <tei:bibl>(ישעיה כז:יג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_announcement_of_the_new_month_on_shabbat_mevorkhim/12"/>
        <tei:lg>
          <tei:l>וְכָתוּב</tei:l>
          <tei:l>וְהָיָ֧ה יְהֹוָ֛ה לְמֶ֖לֶךְ עַל־כׇּל־הָאָ֑רֶץ</tei:l>
          <tei:l>בַּיּ֣וֹם הַה֗וּא יִהְיֶ֧ה יְהֹוָ֛ה אֶחָ֖ד</tei:l>
          <tei:l>וּשְׁמ֥וֹ אֶחָֽד׃ <tei:bibl>(זכריה יד:ט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_announcement_of_the_new_month_on_shabbat_mevorkhim/13"/>
        <tei:lg>
          <tei:l>וְכָתוּב</tei:l>
          <tei:l>וְהָיָ֣ה ׀ בְּאַחֲרִ֣ית הַיָּמִ֗ים</tei:l>
          <tei:l>נָכ֨וֹן יִֽהְיֶ֜ה הַ֤ר בֵּית־יְהֹוָה֙ בְּרֹ֣אשׁ הֶהָרִ֔ים</tei:l>
          <tei:l>וְנִשָּׂ֖א מִגְּבָע֑וֹת</tei:l>
          <tei:l>וְנָהֲר֥וּ אֵלָ֖יו כׇּל־הַגּוֹיִֽם׃ <tei:bibl>(ישעיה ב:ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_announcement_of_the_new_month_on_shabbat_mevorkhim/14"/>
        <tei:lg>
          <tei:l>וְכָתוּב</tei:l>
          <tei:l>וְֽהָלְכ֞וּ עַמִּ֣ים רַבִּ֗ים וְאָֽמְרוּ֙</tei:l>
          <tei:l>לְכ֣וּ ׀ וְנַעֲלֶ֣ה אֶל־הַר־יְהֹוָ֗ה</tei:l>
          <tei:l>אֶל־בֵּית֙ אֱלֹהֵ֣י יַעֲקֹ֔ב</tei:l>
          <tei:l>וְיֹרֵ֙נוּ֙ מִדְּרָכָ֔יו</tei:l>
          <tei:l>וְנֵלְכָ֖ה בְּאֹרְחֹתָ֑יו</tei:l>
          <tei:l>כִּ֤י מִצִּיּוֹן֙ תֵּצֵ֣א תוֹרָ֔ה</tei:l>
          <tei:l>וּדְבַר־יְהֹוָ֖ה מִירוּשָׁלָֽ͏ִם׃ <tei:bibl>(ישעיה ב:ג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_announcement_of_the_new_month_on_shabbat_mevorkhim/15"/>
        <tei:lg>
          <tei:l>וְכָתוּב</tei:l>
          <tei:l>וְשָׁפַט֙ בֵּ֣ין הַגּוֹיִ֔ם</tei:l>
          <tei:l>וְהוֹכִ֖יחַ לְעַמִּ֣ים רַבִּ֑ים</tei:l>
          <tei:l>וְכִתְּת֨וּ חַרְבוֹתָ֜ם לְאִתִּ֗ים</tei:l>
          <tei:l>וַחֲנִיתֽוֹתֵיהֶם֙ לְמַזְמֵר֔וֹת</tei:l>
          <tei:l>לֹא־יִשָּׂ֨א ג֤וֹי אֶל־גּוֹי֙ חֶ֔רֶב</tei:l>
          <tei:l>וְלֹֽא־יִלְמְד֥וּ ע֖וֹד מִלְחָמָֽה׃ <tei:bibl>(ישעיה ב:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_announcement_of_the_new_month_on_shabbat_mevorkhim/16"/>
        <tei:lg>
          <tei:l>וְכָתוּב</tei:l>
          <tei:l>בֵּ֖ית יַעֲקֹ֑ב לְכ֥וּ</tei:l>
          <tei:l>וְנֵלְכָ֖ה בְּא֥וֹר יְהֹוָֽה׃ <tei:bibl>(ישעיה ב:ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_announcement_of_the_new_month_on_shabbat_mevorkhim/17"/>
        <tei:lg>
          <tei:l>וְכָתוּב</tei:l>
          <tei:l>וְהִנֵּ֗ה כְּבוֹד֙ אֱלֹהֵ֣י יִשְׂרָאֵ֔ל</tei:l>
          <tei:l>בָּ֖א מִדֶּ֣רֶךְ הַקָּדִ֑ים</tei:l>
          <tei:l>וְקוֹל֗וֹ כְּקוֹל֙ מַ֣יִם רַבִּ֔ים</tei:l>
          <tei:l>וְהָאָ֖רֶץ הֵאִ֥ירָה מִכְּבֹדֽוֹ׃ <tei:bibl>(יחזקאל מג:ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_announcement_of_the_new_month_on_shabbat_mevorkhim/18"/>
        <tei:lg>
          <tei:l>כֵּן יָאִיר יְהֹוָה צְבָאוֹת עָלֵֽינוּ</tei:l>
          <tei:l>וְעַל כׇּל עַמּוֹ בֵּית יִשְׂרָאֵל</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_announcement_of_the_new_month_on_shabbat_mevorkhim/19"/>
        <tei:lg>
          <tei:l>הַקּוֹל כׇּל עַמָּא</tei:l>
          <tei:l>הָבוּ דַּעְתְּכוֹן לְמֵשְׁמַע קַל קִדּוּשׁ יַרְחָא הָדֵין</tei:l>
          <tei:l>כְּמָה דִּגְזָֽרוּ מָרָנָן וְרַבָּנָן חֲבוּרָא קַדִּישָׁא</tei:l>
          <tei:l>דְּהָווּ יַתְבִין בְּאַרְעָא דְּיִשְׂרָאֵל</tei:l>
          <tei:l>אִית לָן רֵישׁ יַרְחָא דִּ־פלוני</tei:l>
          <tei:l>בְּ־כך וכך בְּשַׁבָּת</tei:l>
          <tei:l>חֻשְׁבָּנֵיהּ וּמִנְיָנֵיהּ בְּ־כך בְּשַׁבָּת</tei:l>
          <tei:l>מַלְכָּא דְּעַלְמָא יַעַבְדִינֵּיהּ לְסִימָנָא טָבָא לָֽנָא</tei:l>
          <tei:l>וּלְכׇל עַמֵּהּ בֵּית יִשְׂרָאֵל</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>