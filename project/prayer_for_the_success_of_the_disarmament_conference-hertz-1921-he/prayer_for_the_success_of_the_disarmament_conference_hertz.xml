    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_the_success_of_the_disarmament_conference_hertz">
        <tei:head>תפלה להצלחת ועד השלום בװאשינגטון</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_success_of_the_disarmament_conference_hertz/1"/>
        <tei:lg>
          <tei:l>רִבּוֹן הָעוֹלָמִים ·</tei:l>
          <tei:l>חֲסָדֶֽיךָ יְיָ נַזְכִּיר בְּתוֹדָה ·</tei:l>
          <tei:l>וּתְהִלּוֹתֶֽיךָ נַגִּיד בִּרְנָנָה ·</tei:l>
          <tei:l>כְּעַל רַב טוּב</tei:l>
          <tei:l>אֲשֶׁר גָמַֽלְתָּ לְאַרְצֵֽנוּ הָאֲהוּבָה׃</tei:l>
          <tei:l>שְׁנוֹת מִסְפָּר עֶבְרָה וְשַׁמָּה סְבָבֽוּנוּ׃</tei:l>
          <tei:l>בְּחֲשְׁכֵּֽנוּ · לְךָ הָיוּ עֵינֵֽינוּ תְלוּיוֹת ·</tei:l>
          <tei:l>וַתְּהִי זְרֹעֲךָ לָֽנוּ לְאוֹרָה וִישׁוּעָה׃</tei:l>
          <tei:l>בָּא יוֹם בְּשׂוֹרָה</tei:l>
          <tei:l>וְקוֹל רַֽעַשׂ מִלְחָמָה כַּלִּֽיתָ מֵעָלֵֽינוּ ·</tei:l>
          <tei:l>יוֹם אֲשֶׁר בְּכָל שָׁנָה וְשָׁנָה</tei:l>
          <tei:l>אָב לְבָנִים יוֹדִֽיעַ אֶל אֲמִתֶּֽךָ</tei:l>
          <tei:l>אֲשֶׁר עָשִֽׂיתָ עִמָּֽנוּ לְהַפְלִיא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_success_of_the_disarmament_conference_hertz/2"/>
        <tei:lg>
          <tei:l>אַב הַשָּׁלוֹם ·</tei:l>
          <tei:l>בְּעֶֽצֶם הַשָּׁעָה הַזֹּאת</tei:l>
          <tei:l>נְדִיבֵי עַמִּים אַדִּירִים</tei:l>
          <tei:l>נֶאֳסָֽפוּ לְהַמְתִּיק סוֹד</tei:l>
          <tei:l>לְמַֽעַן לֹא יִבְטְחוּ גוֹיֵי הָאָֽרֶץ עוֹד בְּחֶֽרֶב עֻזָּם</tei:l>
          <tei:l>וְלֹא יִיגְעוּ עוֹד לַבֶּהָלָה׃</tei:l>
          <tei:l>אָנָּא הֱיֵה עִם פִּיפִיוֹת שְׁלוּחֵי עַמִּים</tei:l>
          <tei:l>שֶׁלֹּא יִכָּשְׁלוּ בִּלְשׁוֹנָם</tei:l>
          <tei:l>וְלֹא יִכָּלְמוּ בָם שְׁאוֹנָם׃</tei:l>
          <tei:l>חַדֵּשׁ לֵב טָהוֹר וְרֽוּחַ נָכוֹן</tei:l>
          <tei:l>בְּקֶֽרֶב מַלְאֲכֵי הַשָּׁלוֹם</tei:l>
          <tei:l>וְתַקְּנֵם בְּעֵצָה טוֹבָה מִלְּפָנֶֽיךָ ·</tei:l>
          <tei:l>וְיֵעָשׂוּ כֻלָּם אֲגֻדָּה אַחַת</tei:l>
          <tei:l>לְהַשְׁבִּית מִלְחָמוֹת עַד קְצֵה הָאָֽרֶץ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_success_of_the_disarmament_conference_hertz/3"/>
        <tei:lg>
          <tei:l>שׁוֹמֵר יִשְׂרָאֵל ·</tei:l>
          <tei:l>הַסְתֵּר עַמְּךָ וְנַחֲלָתְךָ</tei:l>
          <tei:l>בְּצֵל כְּנָפֶֽיךָ ·</tei:l>
          <tei:l>וְלֹא יוֹסִֽיפוּ עוֹד בְּנֵי עַוְלָה לְעַנּוֹתָם׃</tei:l>
          <tei:l>קָרֵב הַיָּמִים</tei:l>
          <tei:l>אֲשֶׁר יִוָּדַע בַּגּוֹיִם</tei:l>
          <tei:l>כִּי אָב אֶחָד לְכֻלָּֽנוּ</tei:l>
          <tei:l>וְאֵל אֶחָד בְּרָאָֽנוּ׃</tei:l>
          <tei:l>וּפְרוֹשֹ בִּמְהֵרָה סֻכַּת שְׁלוֹמֶֽךָ</tei:l>
          <tei:l>עַל כָּל יוֹשְׁבֵי תֵבֵל אַרְצֶֽךָ ·</tei:l>
          <tei:l>אָמֵן וְאָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
