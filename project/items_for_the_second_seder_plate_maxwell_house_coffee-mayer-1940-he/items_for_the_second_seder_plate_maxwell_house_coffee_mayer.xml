  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:items_for_the_second_seder_plate_maxwell_house_coffee_mayer">
        <tei:head>קָפֶה בֵּית מַכְּסְוֶיל</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:items_for_the_second_seder_plate_maxwell_house_coffee_mayer/5"/>
        <tei:lg>
          <tei:l>לָמָּה נִמְשְׁלוּ מִצְרִיִּים כְּמָרוֹר? לוֹמַר לָךְ, מַה מָרוֹר זֶה שֶׁתְּחִלָּתוֹ רַךְ וְסוֹפוֹ קָשֶׁה, אַף מִצְרִיִּים תְּחִלָּתָן רַכָּה וְסוֹפָן קָשֶׁה. <tei:bibl>(פסחים לט א׳)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:items_for_the_second_seder_plate_maxwell_house_coffee_mayer/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>צְרַיִם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:items_for_the_second_seder_plate_maxwell_house_coffee_mayer/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כִּ</tei:seg>תִּים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:items_for_the_second_seder_plate_maxwell_house_coffee_mayer/10"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">סְ</tei:seg>דֹם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:items_for_the_second_seder_plate_maxwell_house_coffee_mayer/11"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וַ</tei:seg>עֲמֹרָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:items_for_the_second_seder_plate_maxwell_house_coffee_mayer/12"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>וָן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:items_for_the_second_seder_plate_maxwell_house_coffee_mayer/13"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ל</tei:seg>וֹט</tei:l>
        </tei:lg>
