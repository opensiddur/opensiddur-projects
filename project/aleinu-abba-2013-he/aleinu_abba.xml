    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:aleinu_abba">
        <tei:head>עָלֵינוּ לְשַׁבֵּחַ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:aleinu_abba/1"/>
        <tei:lg>
          <tei:l>עָלֵֽינוּ לְשַׁבֵּֽחַ לַאֲדוֹן הַכֹּל</tei:l>
          <tei:l>לָתֵת גְּדֻלָּה לְיוֹצֵר בְּרֵאשִׁית.‏</tei:l>
          <tei:l>שֶׁלֹּא עָשָֽׂנוּ כְּגוֹיֵי הָאֲרָצוֹת</tei:l>
          <tei:l>וְלֹא שָׂמָֽנוּ כְּמִשְׁפְּחוֹת הָאֲדָמָה׃</tei:l>
          <tei:l>שֶׁלֹּא שָׂם חֶלְקֵֽנוּ כָּהֶם וְגֹרָלֵֽנוּ כְּכָל הֲמוֹנָם׃‏</tei:l>
          <tei:l>[. . .]</tei:l>
          <tei:l>וַאֲנַֽחְנוּ כּוֹרְעִים וּמִשְׁתַּחֲוִים</tei:l>
          <tei:l>וּמוֹדִים לִפְנֵי מֶֽלֶךְ מַלְכֵי הַמְּלָכִים</tei:l>
          <tei:l>הַקָּדוֹשׁ בָּרוּךְ הוּא׃‏</tei:l>
          <tei:l>שֶׁהוּא נוֹטֶ֣ה שָׁמַיִם֘ וְיֹסֵ֣ד אָרֶץ֒ <tei:bibl>(ישעיה נא:יג)‏</tei:bibl></tei:l>
          <tei:l>וּמוֹשַׁב יְקָרוֹ בַּשָּׁמַֽיִם מִמַּֽעַל וּשְׁכִינַת עֻזּוֹ בְּגָבְהֵי מְרוֹמִים׃‏</tei:l>
          <tei:l>הוּא אֱלֹהֵֽינוּ אֵין עוֹד אֱמֶת מַלְכֵּֽנוּ אֶֽפֶס זוּלָתוֹ</tei:l>
          <tei:l>כַּכָּתוּב בְּתוֹרָתוֹ:</tei:l>
          <tei:l>וְיָֽדַעְתָּ֣ הַיּ֗וֹם וַֽהֲשֵֽׁבֹתָ֘ אֶל־לְבָבֶ֒ךָ֒</tei:l>
          <tei:l>כִּ֤י יְהוָֹה֙ ה֣וּא הָֽאֱלֹהִ֔ים בַּשָּׁמַ֣יִם מִמַּ֔עַל</tei:l>
          <tei:l>וְעַל־הָאָ֖רֶץ מִתָּ֑חַת אֵ֖ין עֽוֹד: <tei:bibl>(דברים ד:לט)‏</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:aleinu_abba/2"/>
        <tei:lg>
          <tei:l>עַל כֵּן נְקַוֶּה לְּךָ יְיָ אֱלֹהֵֽינוּ</tei:l>
          <tei:l>לִרְאוֹת מְהֵרָה בְּתִפְאֶֽרֶת עֻזֶּֽךָ</tei:l>
          <tei:l>לְהַעֲבִיר גִּלּוּלִים מִן הָאָֽרֶץ וְהָאֱלִילִים כָּרוֹת יִכָּרֵתוּן</tei:l>
          <tei:l>לְתַקֵּן עוֹלָם בְּמַלְכוּת שַׁדַּי:‏</tei:l>
          <tei:l>וְכׇל בְּנֵי בָשָׂר יִקְרְאוּ בִשְׁמֶֽךָ</tei:l>
          <tei:l>לְהַפְנוֹת אֵלֶֽיךָ כָּל רִשְׁעֵי אָֽרֶץ:‏</tei:l>
          <tei:l>יַכִּֽירוּ וְיֵדְעוּ כָּל יוֹשְׁבֵי תֵבֵל כִּי לְךָ תִּכְרַע כָּל בֶּֽרֶךְ</tei:l>
          <tei:l>תִּשָּׁבַע כָּל לָשׁוֹן:‏</tei:l>
          <tei:l>לְפָנֶֽיךָ יְיָ אֱלֹהֵֽינוּ יִכְרְעוּ וְיִפּֽוֹלוּ</tei:l>
          <tei:l>וְלִכְבוֹד שִׁמְךָ יְקָר יִתֵּֽנוּ:‏</tei:l>
          <tei:l>וִיקַבְּלוּ כֻלָּם ׀ אֶת עֹל מַלְכוּתֶֽךָ</tei:l>
          <tei:l>וְתִמְלוֹךְ עֲלֵיהֶם מְהֵרָה לְעוֹלָם וָעֶד:‏</tei:l>
          <tei:l>כִּי הַמַּלְכוּת שֶׁלְּךָ הִיא</tei:l>
          <tei:l>וּלְעֽוֹלְמֵי עַד תִּמְלוֹךְ בְּכָבוֹד׃‏</tei:l>
          <tei:l>כַּכָּתוּב בְּתוֹרָתֶךָ:</tei:l>
          <tei:l>יְהוָ֥ה ׀ יִמְלֹ֖ךְ לְעֹלָ֥ם וָעֶֽד׃ <tei:bibl>(שמות טו:יח) </tei:bibl>‏</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:aleinu_abba/3"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר:‏</tei:l>
          <tei:l>וְהָיָ֧ה יְהוָ֛ה לְמֶ֖לֶךְ עַל־כָּל־הָאָ֑רֶץ</tei:l>
          <tei:l>בַּיּ֣וֹם הַה֗וּא יִהְיֶ֧ה</tei:l>
          <tei:l>יְהוָ֛ה אֶחָ֖ד</tei:l>
          <tei:l>וּשְׁמ֥וֹ אֶחָֽד׃ <tei:bibl>(זכריה יד:ט)‏</tei:bibl>‏</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
