    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:ana_elekh_meruchekha_najara">
        <tei:head>אָנָא אֵלֵךְ מֵרוּחֶךָ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ana_elekh_meruchekha_najara/1"/>
        <tei:lg>
          <tei:l>אָנָא אֵלֵךְ מֵרוּחֶךָ</tei:l>
          <tei:l>אָֽנָא מִפָּנֶֽיךָ אֶבְרַח</tei:l>
          <tei:l>אֶבְרַח מִמְּךָ אֵלֶֽיךָ</tei:l>
          <tei:l>וּבְצֵל יָדְךָ אָגִיל אֶפְרַח</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ana_elekh_meruchekha_najara/2"/>
        <tei:lg>
          <tei:l>יָהּ כְּבוֹדְךָ עוֹלָם מָלֵא</tei:l>
          <tei:l>אַתָּה הָאֵל־עֽוֹשֵׂה־פֶּֽלֶא</tei:l>
          <tei:l>אִם לַָשָּׁמַיִם אֶעֱלֶה</tei:l>
          <tei:l>שָׁם אֶמְצָא אוֹרְךָ יִזְרַח</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ana_elekh_meruchekha_najara/3"/>
        <tei:lg>
          <tei:l>שַׁחַק לֹא יְכַלְכֶּלְךָ</tei:l>
          <tei:l>וְאֶֽרֶץ לֹא תְכִילֶֽךָ</tei:l>
          <tei:l>מִי יְמַלֵּל רֹב גָּדְלְךָ</tei:l>
          <tei:l>לוּ פִיו כַּיָּם בְּקוֹל יִצְרַח</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ana_elekh_meruchekha_najara/4"/>
        <tei:lg>
          <tei:l>רְקִיעֵי רוּם הֵם כִּסְאֲךָ</tei:l>
          <tei:l>וְאֶֽרֶץ הֲדוֹם רַגְלֶֽךָ</tei:l>
          <tei:l>גָּדוֹל שִׁמְךָ וְהֵן לְךָ</tei:l>
          <tei:l>צָפוֹן דָּרוֹם מַֽעֲרַב מִזְרָח</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ana_elekh_meruchekha_najara/5"/>
        <tei:lg>
          <tei:l>אֶסַּק שָׁמַֽיִם שָׁם אוֹרְךָ</tei:l>
          <tei:l>אַצִּיעָה שְׁאוֹל הִנֶּֽךָ</tei:l>
          <tei:l>אַֽחֲרִית יָם גַּם שָׁם יָדְךָ</tei:l>
          <tei:l>תִּקָּחֵֽנִי בְּלִי טֹרַח</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ana_elekh_meruchekha_najara/6"/>
        <tei:lg>
          <tei:l>לָכֵן אֵין לִי מָנוֹס בִּלְתָּךְ</tei:l>
          <tei:l>וּבְחֶמְלָתָךְ אָבוֹא בֵיתָךְ</tei:l>
          <tei:l>וְאֶקַּח מָגֵן תּוֹרָתָךְ</tei:l>
          <tei:l>תּוֹרֵֽנִי דֶּֽרֶךְ וָאֹרַח</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
