  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:morgen_lieder_gutheim">
        <tei:head>Morgen-Lieder (Auf, auf, den Herrn zu loben)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:morgen_lieder_gutheim/1"/>
        <tei:lg>
          <tei:l>Pious Resignation.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:morgen_lieder_gutheim/2"/>
        <tei:lg>
          <tei:l>Arise to praise the Lord,</tei:l>
          <tei:l>Awake my yearning soul,</tei:l>
          <tei:l>strike deep the sounding chord,</tei:l>
          <tei:l>Thy Maker to extol!</tei:l>
          <tei:l>For God preserved our life,</tei:l>
          <tei:l>When darkness closed around,</tei:l>
          <tei:l>Midst dangers ever rife</tei:l>
          <tei:l>In Him we refuge found.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:morgen_lieder_gutheim/4"/>
        <tei:lg>
          <tei:l>Thou art my rock, my stay,</tei:l>
          <tei:l>My shield eternally</tei:l>
          <tei:l>And how can I repay</tei:l>
          <tei:l>Thy benefits to me?</tei:l>
          <tei:l>small is my offering:</tei:l>
          <tei:l>O may it favor find!</tei:l>
          <tei:l>With thanks and praise I bring</tei:l>
          <tei:l>A heart to Thee resigned.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
