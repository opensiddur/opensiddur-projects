  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:havdallah_thinking_of_those_suffering_from_long_covid_kanter_webber">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:havdallah_thinking_of_those_suffering_from_long_covid_kanter_webber/7"/>
        <tei:lg>
          <tei:l>עוּרָה לָמָּה תִישַׁן אֲדֹנָי</tei:l>
          <tei:l>הָקִיצָה אַל־תִּזְנַח לָנֶצַח׃</tei:l>
          <tei:l>לָמָּה־פָנֶיךָ תַסְתִּיר</tei:l>
          <tei:l>תִּשְׁכַּח עׇנְיֵנוּ וְלַחֲצֵנוּ׃</tei:l>
          <tei:l>כִּי שָׁחָה לֶעָפָר נַפְשֵׁנוּ</tei:l>
          <tei:l>דָּבְקָה לָאָרֶץ בִּטְנֵנוּ׃</tei:l>
          <tei:l>קוּמָה עֶזְרָתָה לָּנוּ</tei:l>
          <tei:l>וּפְדֵנוּ לְמַעַן חַסְדֶּךָ׃ <tei:bibl>(תהלים מד:כד-כז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:havdallah_thinking_of_those_suffering_from_long_covid_kanter_webber/12"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יי אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם</tei:l>
          <tei:l>מְקוֹר מַיִם חַיִּים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:havdallah_thinking_of_those_suffering_from_long_covid_kanter_webber/14"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יי אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם</tei:l>
          <tei:l>בּוֹרֵא מִינֵי בְשָׂמִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:havdallah_thinking_of_those_suffering_from_long_covid_kanter_webber/16"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יי אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם</tei:l>
          <tei:l>בּוֹרֵא מְאוֹרֵי הָאֵשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:havdallah_thinking_of_those_suffering_from_long_covid_kanter_webber/18"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יי אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם</tei:l>
          <tei:l>הַמַּבְדִיל בֵּין קֹדֶשׁ לְחוֹל:</tei:l>
        </tei:lg>
