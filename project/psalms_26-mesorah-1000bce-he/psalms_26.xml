  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/26">
        <tei:head>תהלים כ״ו</tei:head>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">לְדָוִד</tei:note>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>שׇׁפְטֵנִי יְהֹוָה</tei:l>
          <tei:l>כִּי־אֲנִי בְּתֻמִּי הָלַכְתִּי</tei:l>
          <tei:l>וּבַיהֹוָה בָּטַחְתִּי</tei:l>
          <tei:l>לֹא אֶמְעָד׃</tei:l>
          <tei:l>בְּחָנֵנִי יְהֹוָה וְנַסֵּנִי</tei:l>
          <tei:l>(צרופה) [צׇרְפָה] כִלְיוֹתַי וְלִבִּי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/26/3/a"/>
        <tei:lg>
          <tei:l>כִּי־חַסְדְּךָ לְנֶגֶד עֵינָי</tei:l>
          <tei:l>וְהִתְהַלַּכְתִּי בַּאֲמִתֶּךָ׃</tei:l>
          <tei:l>לֹא־יָשַׁבְתִּי</tei:l>
          <tei:l>עִם־מְתֵי־שָׁוְא</tei:l>
          <tei:l>וְעִם נַעֲלָמִים</tei:l>
          <tei:l>לֹא אָבוֹא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/26/5/a"/>
        <tei:lg>
          <tei:l>שָׂנֵאתִי קְהַל מְרֵעִים</tei:l>
          <tei:l>וְעִם־רְשָׁעִים לֹא אֵשֵׁב׃</tei:l>
          <tei:l>אֶרְחַץ</tei:l>
          <tei:l>בְּנִקָּיוֹן כַּפָּי</tei:l>
          <tei:l>וַאֲסֹבְבָה אֶת־מִזְבַּחֲךָ יְהֹוָה׃</tei:l>
          <tei:l>לַשְׁמִעַ בְּקוֹל תּוֹדָה</tei:l>
          <tei:l>וּלְסַפֵּר כׇּל־נִפְלְאוֹתֶיךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/26/8/a"/>
        <tei:lg>
          <tei:l>יְהֹוָה אָהַבְתִּי מְעוֹן בֵּיתֶךָ</tei:l>
          <tei:l>וּמְקוֹם מִשְׁכַּן כְּבוֹדֶךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/26/9/a"/>
        <tei:lg>
          <tei:l>אַל־תֶּאֱסֹף עִם־חַטָּאִים נַפְשִׁי</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְעִם־אַנְשֵׁי דָמִים חַיָּי׃</tei:l>
          <tei:l>אֲשֶׁר־בִּידֵיהֶם זִמָּה</tei:l>
          <tei:l>וִימִינָם מָלְאָה שֹּׁחַד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/26/11"/>
        <tei:lg>
          <tei:l>וַאֲנִי בְּתֻמִּי אֵלֵךְ</tei:l>
          <tei:l>פְּדֵנִי וְחׇנֵּנִי׃</tei:l>
          <tei:l>רַגְלִי עָמְדָה בְמִישׁוֹר</tei:l>
          <tei:l>בְּמַקְהֵלִים</tei:l>
          <tei:l>אֲבָרֵךְ יְהֹוָה׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
