    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_very_good_prayer_with_twenty_four_things_in_it">
        <tei:head>תְּפִלָּה מְעֻלָּה בְּיוֹתֵר כּוֹלֶלֶת כ״ד דְּבָרִים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_very_good_prayer_with_twenty_four_things_in_it/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">זאת התפלה כוללת כ״ד דברים והיא תפלה מעולה ביותר</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_very_good_prayer_with_twenty_four_things_in_it/2"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן מִלְּפָנֶֽיךָ יְהֹוָה אֱלֹהַי וֵאלֹהֵי אֲבוֹתָי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_very_good_prayer_with_twenty_four_things_in_it/3"/>
        <tei:lg>
          <tei:l>שֶׁיִּהְיוּ חוֹלֵי עַמְּךָ יִשְׂרָאֵל נִרְפָּאִים</tei:l>
          <tei:l>וְאַל־יְחַלּוּ הַבְּרִיאִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_very_good_prayer_with_twenty_four_things_in_it/4"/>
        <tei:lg>
          <tei:l>וְהַצִּילֵם מִיַּד אֻמָּה הָרְשָׁעָה</tei:l>
          <tei:l>וְדִקְדּוּקֵי עֲנִיּוּת וּמִכׇּל־מִקְרֶה וּפֶֽגַע רַע</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_very_good_prayer_with_twenty_four_things_in_it/5"/>
        <tei:lg>
          <tei:l>וְלַחֲשׂוּכֵי בָּנִים תֵּן זֶֽרַע עוֹסְקֵי תּוֹרָתֶֽךָ וְשִׁמְךָ יְרֵאִים</tei:l>
          <tei:l>וְתוֹצִיא מִמַּסְגֵּר כׇּל־הַכְּלוּאִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_very_good_prayer_with_twenty_four_things_in_it/6"/>
        <tei:lg>
          <tei:l>וְתִפְקֹד כׇּל־עֲקָרוֹת</tei:l>
          <tei:l>וְתַתִּיר לְטוֹב כׇּל־הֶהָרוֹת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_very_good_prayer_with_twenty_four_things_in_it/7"/>
        <tei:lg>
          <tei:l>וְתִתֶּן טֶֽרֶף לַעֲנִיִּים וְדַכִּים</tei:l>
          <tei:l>וּתְרַחֵם עַל־עַמְּךָ יִשְׂרָאֵל עוֹבְרֵי דְּרָכִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_very_good_prayer_with_twenty_four_things_in_it/8"/>
        <tei:lg>
          <tei:l>וְאֶת־הָאֲנוּסִים שֶׁיָּשֽׁוּבוּ</tei:l>
          <tei:l>וּמַעֲשֵׂיהֶם יֵיטִֽיבוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_very_good_prayer_with_twenty_four_things_in_it/9"/>
        <tei:lg>
          <tei:l>וְקָרֵב לָֽנוּ שְׁנַת גְּאֻלָּה</tei:l>
          <tei:l>וְלֹא־נָבוֹא עוֹד לִידֵי תַּקָּלָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_very_good_prayer_with_twenty_four_things_in_it/10"/>
        <tei:lg>
          <tei:l>וְתָסִיר כׇּל־הַדְּבָרִים הַמְּעַכְּבִים</tei:l>
          <tei:l>תְּשׁוּבָה מֵעַל־הַשָּׁבִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_very_good_prayer_with_twenty_four_things_in_it/11"/>
        <tei:lg>
          <tei:l>וְעִם־עֲבָדֶֽיךָ תִּזְכֹּר עַבְדֶּֽךָ</tei:l>
          <tei:l>אֲשֶׁר נַפְשׁוֹ וְטַרְפּוֹ בְּיָדֶֽךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_very_good_prayer_with_twenty_four_things_in_it/12"/>
        <tei:lg>
          <tei:l>בְּיִרְאָתְךָ וּבְתוֹרָתְךָ לְהַחֲזִיקוֹ</tei:l>
          <tei:l>וְלָתֵת לוֹ אֶת־חֻקּוֹ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_very_good_prayer_with_twenty_four_things_in_it/13"/>
        <tei:lg>
          <tei:l>לֶ֛חֶם לֶאֱכֹ֖ל וּבֶ֥גֶד לִלְבֹּֽשׁ</tei:l>
          <tei:l>קְרָאתִֽיךָ אֱלֹהַי אַל־אֵבוֹשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_very_good_prayer_with_twenty_four_things_in_it/14"/>
        <tei:lg>
          <tei:l>יִ֥הְיֽוּ־לְרָצ֨וֹן ׀ אִמְרֵי־פִ֡י</tei:l>
          <tei:l>וְהֶגְי֣וֹן לִבִּ֣י לְפָנֶ֑יךָ</tei:l>
          <tei:l>יְ֝הֹוָ֗ה צוּרִ֥י וְגֹאֲלִֽי׃ <tei:bibl>(תהלים יט:טו)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
