    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:eli_kevodi_burstein">
        <tei:head>אֵלִי כְּבוֹדִי: זמר לסעודה השלישית</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eli_kevodi_burstein/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">החזן קורא והקהל עונים אחריו:</tei:note>
          </tei:l>
          <tei:l>הִנֵּה בַּיַֽעַר נֶאֱבַדְתִּי</tei:l>
          <tei:l>עַד־בֹּֽאֲךָ לְהַנְחֵֽנִי.</tei:l>
          <tei:l>
            <tei:note type="instruction">הקהל אומרים שתי פעמים:</tei:note>
          </tei:l>
          <tei:l>אֵלִי כְּבוֹדִי, אַנְתְּ הוּא רְצוֹנִי</tei:l>
          <tei:l>בְּתוֹךְ הַחֹֽשֶׁךְ הִנְּךָ שִׁמְשִׁי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eli_kevodi_burstein/2"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">חזן:</tei:note> חַֽדּוּ דַּרְדַּר בַּשְׁבִילִים</tei:l>
          <tei:l>וַתַּנְעִילֵֽנִי בְּסַנְדָּלִים.</tei:l>
          <tei:l><tei:note type="instruction">קהל:</tei:note> אֵלִי כְּבוֹדִי, אַנְתְּ הוּא שְׂשׂוֹנִי</tei:l>
          <tei:l>אֲנִי עַבְדֶּֽךָ, מְלֹךְ עַל־נַפְשִׁי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eli_kevodi_burstein/3"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">חזן:</tei:note> הִפִּילַּֽנִי רֽוּחַ־יָמִין</tei:l>
          <tei:l>וַתּוֹצִיאֵֽנִי מִפִּי תַּנִּין.</tei:l>
          <tei:l><tei:note type="instruction">קהל:</tei:note> אֵלִי כְּבוֹדִי, אַנְתְּ הוּא מַצִּילִי</tei:l>
          <tei:l>בְּלֵיל הַסַֽעַר הִנְּךָ שִׁקְטִי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eli_kevodi_burstein/4"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">חזן:</tei:note> לוּלֵא מַחְסֵה חֻפָּתְךָ</tei:l>
          <tei:l>אֲזַי גָוַע עָז־גָּלְמִי.</tei:l>
          <tei:l><tei:note type="instruction">קהל:</tei:note> אֵלִי כְּבוֹדִי, אַנְתְּ הוּא מוֹשִׁיעִי</tei:l>
          <tei:l>מְאֹד קָטֹֽנְתִּי נֹֽכַח גִּבּוֹרִי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eli_kevodi_burstein/5"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">חזן:</tei:note> מַר בָּכִיתִי וָאֱהִי עֵירֹם</tei:l>
          <tei:l>וַתְּכַסֵּֽנִי בְּשָׁלוֹם.</tei:l>
          <tei:l><tei:note type="instruction">קהל:</tei:note> אֵלִי כְּבוֹדִי, אַנְתְּ הוּא מְזִינִי</tei:l>
          <tei:l>רָעֵב הָיִיתִי וְהֶאֱכַלְתָּֽנִי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eli_kevodi_burstein/6"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">חזן:</tei:note> רַֽבּוּ שֵׁדִים וַיַּבְחִידוּנִי</tei:l>
          <tei:l>וַיַּבְרִיחֵם חַנּוּנִי.</tei:l>
          <tei:l><tei:note type="instruction">קהל:</tei:note> אֵלִי כְּבוֹדִי, אַנְתְּ הוּא לוֹחֲמִי</tei:l>
          <tei:l>הֵן! הוּסַבֹּֽתִי וַתְּהִי חַרְבִּי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:eli_kevodi_burstein/7"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">חזן:</tei:note> נָהָֽתָה־נֶֽהִי קִרְיַת צִיּוֹנִי</tei:l>
          <tei:l>תָּסִיר יְגוֹנָהּ, יִחַדְּ עַמִּי.</tei:l>
          <tei:l><tei:note type="instruction">קהל:</tei:note> אֵלִי כְּבוֹדִי, אַנְתְּ הוּא תּוֹחַלְתִּי</tei:l>
          <tei:l>רַבּוֹת הֵכַנְתִּי לִמְשִׁיחִי.</tei:l>
        </tei:lg>
      </tei:div>
