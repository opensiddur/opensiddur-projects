      <tei:div corresp="urn:x-opensiddur:text:prayer:the_blessing_of_flowering_fruit_trees_in_the_spring_season_seidenberg/2">
        <tei:head>בִּרְכַּת הָאִילָנוֹת</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_blessing_of_flowering_fruit_trees_in_the_spring_season_seidenberg/2/1"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>בּוֹרֵא נְפָשׁוֹת רַבּוֹת</tei:l>
          <tei:l>וְחֶסְרוֹנָן עַל כָּל מַה שֶּׁבָּרָא(תָ)</tei:l>
          <tei:l>לְהַחֲיוֹת (בָּהֶם)</tei:l>
          <tei:l>נֶֽפֶשׁ כָּל חָי:</tei:l>
          <tei:l>בָּרוּךְ חַי הָעוֹלָמִים:‏</tei:l>
        </tei:lg>
      </tei:div>
