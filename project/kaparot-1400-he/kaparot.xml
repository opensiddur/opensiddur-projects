  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:kaparot">
        <tei:head>כַּפָּרוֹת</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaparot/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">נהוג לקיים את מנהג הכפרות השכם בבוקר בערב יום הכיפורים או קודם לכן בעשרת ימי תשובה.</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaparot/2"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">יש להחזיק את את כסף ה-‘כפרות’ ביד ימין ולומר:</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaparot/3"/>
        <tei:lg>
          <tei:l>בְּנֵי אָדָם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaparot/4"/>
        <tei:lg>
          <tei:l>יֹשְׁבֵי חֹשֶׁךְ וְצַלְמָוֶת</tei:l>
          <tei:l>אֲסִירֵי עֳנִי וּבַרְזֶל׃ <tei:bibl>(תהלים קז:י)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaparot/5"/>
        <tei:lg>
          <tei:l>יוֹצִיאֵם מֵחֹשֶׁךְ וְצַלְמָוֶת</tei:l>
          <tei:l>וּמוֹסְרוֹתֵיהֶם יְנַתֵּק׃ <tei:bibl>(תהלים קז:יד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaparot/6"/>
        <tei:lg>
          <tei:l>אֱוִלִים מִדֶּרֶךְ פִּשְׁעָם</tei:l>
          <tei:l>וּמֵעֲוֺנֹתֵיהֶם יִתְעַנּוּ׃</tei:l>
          <tei:l>כׇּל־אֹכֶל תְּתַעֵב נַפְשָׁם</tei:l>
          <tei:l>וַיַּגִּיעוּ עַד־שַׁעֲרֵי מָוֶת׃</tei:l>
          <tei:l>וַיִּזְעֲקוּ אֶל־יְהֹוָה בַּצַּר לָהֶם</tei:l>
          <tei:l>מִמְּצֻקוֹתֵיהֶם יוֹשִׁיעֵם׃</tei:l>
          <tei:l>יִשְׁלַח דְּבָרוֹ וְיִרְפָּאֵם</tei:l>
          <tei:l>וִימַלֵּט מִשְּׁחִיתוֹתָם׃</tei:l>
          <tei:l>יוֹדוּ לַיהֹוָה חַסְדּוֹ</tei:l>
          <tei:l>וְנִפְלְאוֹתָיו לִבְנֵי אָדָם׃ <tei:bibl>(תהלים קז:יז-כא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaparot/7"/>
        <tei:lg>
          <tei:l>אִם־יֵשׁ עָלָיו מַלְאָךְ</tei:l>
          <tei:l>מֵלִיץ אֶחָד מִנִּי־אָלֶף</tei:l>
          <tei:l>לְהַגִּיד לְאָדָם יָשְׁרוֹ׃</tei:l>
          <tei:l>וַיְחֻנֶּנּוּ וַיֹּאמֶר</tei:l>
          <tei:l>פְּדָעֵהוּ מֵרֶדֶת שָׁחַת</tei:l>
          <tei:l>מָצָאתִי כֹפֶר׃ <tei:bibl>(איוב לג:כג-כד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaparot/8"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">מסובבים את הכסף מעל הראש שלוש פעמים ואומרים:</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaparot/9"/>
        <tei:lg>
          <tei:l>זֶה חֲלִיפָתִי,</tei:l>
          <tei:l>זֶה תְּמוּרָתִי,</tei:l>
          <tei:l>זֶה כַּפָּרָתִי.</tei:l>
          <tei:l>זֶה הַכֶּסֶף יִנָּתֵן לִצְדָקָה</tei:l>
          <tei:l>וַאֲנִי אֵלֵךְ לְחַיִּים טוֹבִים אֲרֻכִּים וּלְשָׁלוֹם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaparot/10"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">אומרים את כל התפילה שלוש פעמים.</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kaparot/11"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">מבין יהודי גרמניה יש שאינם נוהגים לסובב את הכפרות מעל ראשם אלא לצרור את המעות ולהניחן על שולחן, להניח את ידם על הצרור ולומר “זו כפרתי”. את כסף ה’כפרות’ נותנים לצדקה.</tei:note>
          </tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
