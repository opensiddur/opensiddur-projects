    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:techinot_on_the_use_of_a_bomb_shelter_mayer">
        <tei:head>תחנות על שימוש במקלט</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:techinot_on_the_use_of_a_bomb_shelter_mayer/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">תחינה בעת ירידה לתוך המקלט</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:techinot_on_the_use_of_a_bomb_shelter_mayer/2"/>
        <tei:lg>
          <tei:l>לְשֵׁם יִחוּד</tei:l>
          <tei:l>קוּדְשָׁא בְּרִיךְ הוּא וּשְׁכִינְתֵּיהּ,</tei:l>
          <tei:l>בִּדְחִֽילוּ וּרְחִֽימוּ</tei:l>
          <tei:l>וּרְחִֽימוּ וּדְחִֽילוּ,</tei:l>
          <tei:l>לְיַחֲדָא שֵׁם יוֹ״ד ה״י בְּוָא״ו הֵ״י</tei:l>
          <tei:l>בְּיִחוּדָא שְׁלִים,</tei:l>
          <tei:l>בְּשֵׁם כׇּל־יִשְׂרָאֵל,</tei:l>
          <tei:l>הִנְנִי מוּכָן וּמְזֻמָּן</tei:l>
          <tei:l>לְקַיֵּם מִצְוַת עֲשֵׂה</tei:l>
          <tei:l>שֶׁל־פִּקּֽוּחַ נֶֽפֶשׁ</tei:l>
          <tei:l>כְּמוֹ שֶׁכָּתוּב בְּתוֹרָתֶֽךָ</tei:l>
          <tei:l>וּשְׁמַרְתֶּ֤ם אֶת־חֻקֹּתַי֙ וְאֶת־מִשְׁפָּטַ֔י</tei:l>
          <tei:l>אֲשֶׁ֨ר יַעֲשֶׂ֥ה אֹתָ֛ם הָאָדָ֖ם</tei:l>
          <tei:l>וָחַ֣י בָּהֶ֑ם׃ <tei:bibl>(ויקרא יח:ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:techinot_on_the_use_of_a_bomb_shelter_mayer/3"/>
        <tei:lg>
          <tei:l>וּכְשֵׁם שֶׁאֵרֵד לְתוֹךְ הַמִּקְלָט</tei:l>
          <tei:l>מִפְּנֵי רִשְׁפֵּי־הַשֶּֽׁלַח</tei:l>
          <tei:l>מוּטְלֵי אוֹיְבֵי עַמֶּֽךָ,</tei:l>
          <tei:l>כֵּן תְּזַכֵּֽנִי</tei:l>
          <tei:l>וְאֶעֱלֶה מִמֶּֽנּוּ,</tei:l>
          <tei:l>וְאֵצֵא בְּשָׁלוֹם וְשַׁלְוָה וָבֶֽטַח.</tei:l>
          <tei:l>וִיקֻיַּם בִּי</tei:l>
          <tei:l>וּבְכׇל־עַמְּךָ</tei:l>
          <tei:l>מִקְרָא שֶׁכָּתוּב</tei:l>
          <tei:l>שָׁ֭מָּה שִׁבַּ֣ר רִשְׁפֵי־קָ֑שֶׁת</tei:l>
          <tei:l>מָגֵ֬ן וְחֶ֖רֶב וּמִלְחָמָ֣ה סֶֽלָה׃ <tei:bibl>(תהלים עו:ד)</tei:bibl></tei:l>
          <tei:l>וְנֶאֱמַר</tei:l>
          <tei:l>וְיִשְׂמְח֨וּ כׇל־ח֪וֹסֵי בָ֡ךְ</tei:l>
          <tei:l>לְעוֹלָ֣ם יְ֭רַנֵּנוּ</tei:l>
          <tei:l>וְתָסֵ֣ךְ עָלֵ֑ימוֹ</tei:l>
          <tei:l>וְֽיַעְלְצ֥וּ בְ֝ךָ֗</tei:l>
          <tei:l>אֹהֲבֵ֥י שְׁמֶֽךָ׃ <tei:bibl>(תהלים ה:יב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:techinot_on_the_use_of_a_bomb_shelter_mayer/4"/>
        <tei:lg>
          <tei:l>וִיהִ֤י ׀ נֹ֤עַם אֲדֹנָ֥י אֱלֹהֵ֗ינוּ עָ֫לֵ֥ינוּ</tei:l>
          <tei:l>וּמַעֲשֵׂ֣ה יָ֭דֵינוּ כּוֹנְנָ֥ה עָלֵ֑ינוּ</tei:l>
          <tei:l>וּֽמַעֲשֵׂ֥ה יָ֝דֵ֗ינוּ כּוֹנְנֵֽהוּ׃ <tei:bibl>(תהלים צ:יז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:techinot_on_the_use_of_a_bomb_shelter_mayer/5"/>
        <tei:lg>
          <tei:l>יֹ֭שֵׁב בְּסֵ֣תֶר עֶלְי֑וֹן</tei:l>
          <tei:l>בְּצֵ֥ל שַׁ֝דַּ֗י יִתְלוֹנָֽן׃</tei:l>
          <tei:l>אֹמַ֗ר לַ֭יהֹוָה</tei:l>
          <tei:l>מַחְסִ֣י וּמְצוּדָתִ֑י</tei:l>
          <tei:l>אֱ֝לֹהַ֗י אֶבְטַח־בּֽוֹ׃ <tei:bibl>(תהלים צא:א-ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:techinot_on_the_use_of_a_bomb_shelter_mayer/6"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">בתוך המקלט,</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">קוראים תהלים קכ–קלד (שירי המעלות),</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">או לפחות תהלים ק״כ וק״ל (להלן)</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:techinot_on_the_use_of_a_bomb_shelter_mayer/7"/>
        <tei:lg>
          <tei:l><tei:bibl>תהלים ק״כ —</tei:bibl> שִׁ֗יר הַֽמַּ֫עֲל֥וֹת</tei:l>
          <tei:l>אֶל־יְ֭הֹוָה בַּצָּרָ֣תָה לִּ֑י</tei:l>
          <tei:l>קָ֝רָ֗אתִי וַֽיַּעֲנֵֽנִי׃</tei:l>
          <tei:l>יְֽהֹוָ֗ה הַצִּ֣ילָה נַ֭פְשִׁי</tei:l>
          <tei:l>מִשְּׂפַת־שֶׁ֑קֶר</tei:l>
          <tei:l>מִלָּשׁ֥וֹן רְמִיָּֽה׃</tei:l>
          <tei:l>מַה־יִּתֵּ֣ן לְ֭ךָ</tei:l>
          <tei:l>וּמַה־יֹּסִ֥יף לָ֗ךְ</tei:l>
          <tei:l>לָשׁ֥וֹן רְמִיָּֽה׃</tei:l>
          <tei:l>חִצֵּ֣י גִבּ֣וֹר שְׁנוּנִ֑ים</tei:l>
          <tei:l>עִ֗֝ם גַּחֲלֵ֥י רְתָמִֽים׃</tei:l>
          <tei:l>אֽוֹיָה־לִ֭י</tei:l>
          <tei:l>כִּי־גַ֣רְתִּי מֶ֑שֶׁךְ</tei:l>
          <tei:l>שָׁ֝כַ֗נְתִּי עִֽם־אׇהֳלֵ֥י קֵדָֽר׃</tei:l>
          <tei:l>רַ֭בַּת שָֽׁכְנָה־לָּ֣הּ נַפְשִׁ֑י</tei:l>
          <tei:l>עִ֗֝ם שׂוֹנֵ֥א שָׁלֽוֹם׃</tei:l>
          <tei:l>אֲֽנִי־שָׁ֭לוֹם</tei:l>
          <tei:l>וְכִ֣י אֲדַבֵּ֑ר</tei:l>
          <tei:l>הֵ֗֝מָּה לַמִּלְחָמָֽה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:techinot_on_the_use_of_a_bomb_shelter_mayer/8"/>
        <tei:lg>
          <tei:l><tei:bibl>תהלים ק״ל —</tei:bibl> שִׁ֥יר הַֽמַּעֲל֑וֹת</tei:l>
          <tei:l>מִמַּעֲמַקִּ֖ים קְרָאתִ֣יךָ יְהֹוָֽה׃</tei:l>
          <tei:l>אֲדֹנָי֮ שִׁמְעָ֢ה בְק֫וֹלִ֥י</tei:l>
          <tei:l>תִּהְיֶ֣ינָה אׇ֭זְנֶיךָ קַשֻּׁב֑וֹת</tei:l>
          <tei:l>לְ֝ק֗וֹל תַּחֲנוּנָֽי׃</tei:l>
          <tei:l>אִם־עֲוֺנ֥וֹת תִּשְׁמׇר־יָ֑הּ</tei:l>
          <tei:l>אֲ֝דֹנָ֗י מִ֣י יַעֲמֹֽד׃</tei:l>
          <tei:l>כִּֽי־עִמְּךָ֥ הַסְּלִיחָ֑ה</tei:l>
          <tei:l>לְ֝מַ֗עַן תִּוָּרֵֽא׃</tei:l>
          <tei:l>קִוִּ֣יתִי יְ֭הֹוָה</tei:l>
          <tei:l>קִוְּתָ֣ה נַפְשִׁ֑י</tei:l>
          <tei:l>וְֽלִדְבָר֥וֹ הוֹחָֽלְתִּי׃</tei:l>
          <tei:l>נַפְשִׁ֥י לַאדֹנָ֑י</tei:l>
          <tei:l>מִשֹּׁמְרִ֥ים לַ֝בֹּ֗קֶר</tei:l>
          <tei:l>שֹׁמְרִ֥ים לַבֹּֽקֶר׃</tei:l>
          <tei:l>יַחֵ֥ל יִשְׂרָאֵ֗ל אֶל־יְ֫הֹוָ֥ה</tei:l>
          <tei:l>כִּֽי־עִם־יְהֹוָ֥ה הַחֶ֑סֶד</tei:l>
          <tei:l>וְהַרְבֵּ֖ה עִמּ֣וֹ פְדֽוּת׃</tei:l>
          <tei:l>וְ֭הוּא יִפְדֶּ֣ה אֶת־יִשְׂרָאֵ֑ל</tei:l>
          <tei:l>מִ֝כֹּ֗ל עֲוֺנֹתָֽיו׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:techinot_on_the_use_of_a_bomb_shelter_mayer/9"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">תחינה בעת עליה מתוך המקלט</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:techinot_on_the_use_of_a_bomb_shelter_mayer/10"/>
        <tei:lg>
          <tei:l>הִנֵּה קִיַּֽמְתִּי,</tei:l>
          <tei:l>לְפִי מִעוּט כּוֹחִי</tei:l>
          <tei:l>וְכׇל־מַה שֶׁבְּיָדִי לְקַיֵּם,</tei:l>
          <tei:l>מִצְוַת עֲשֵׂה שֶׁל־פִּקּֽוּחַ נֶֽפֶשׁ</tei:l>
          <tei:l>כְּמוֹ שֶׁכָּתוּב בְּתוֹרָתֶֽךָ</tei:l>
          <tei:l>וּשְׁמַרְתֶּ֤ם אֶת־חֻקֹּתַי֙ וְאֶת־מִשְׁפָּטַ֔י</tei:l>
          <tei:l>אֲשֶׁ֨ר יַעֲשֶׂ֥ה אֹתָ֛ם הָאָדָ֖ם</tei:l>
          <tei:l>וָחַ֣י בָּהֶ֑ם׃ <tei:bibl>(ויקרא יח:ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:techinot_on_the_use_of_a_bomb_shelter_mayer/11"/>
        <tei:lg>
          <tei:l>וּכְשֵׁם שֶׁזָּכִֽיתִי לַעֲלוֹת וְלָצֵאת</tei:l>
          <tei:l>מִתּוֹךְ הַמִּקְלָט בָּעֵת הַזֹּאת,</tei:l>
          <tei:l>כֵּן תְּזַכֵּֽנִי—</tei:l>
          <tei:l>אוֹתִי וְאֶת־כׇּל־עַמְּךָ יִשְׂרָאֵל—</tei:l>
          <tei:l>שֶׁלֹּא נִצְטָרֵךְ בִּירִידָתוֹ עוֹד,</tei:l>
          <tei:l>שֶׁלֹּא־יִהְיֶה עוֹד צֹֽרֶךְ</tei:l>
          <tei:l>לַחְפֹּר מִקְלָטִים וְלַחֲסוֹת בָּם,</tei:l>
          <tei:l>לֹא עָלַי וְלֹא עַל־כׇּל־יִשְׂרָאֵל עַמֶּֽךָ</tei:l>
          <tei:l>וְלֹא עַל־כׇּל־יוֹשְׁבֵי תֵּבֵל בְּרוּאֶֽיךָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:techinot_on_the_use_of_a_bomb_shelter_mayer/12"/>
        <tei:lg>
          <tei:l>כַּכָּתוּב בִּנְבוּאַת יְשַׁעְיָֽהוּ חוֹזֶֽךָ</tei:l>
          <tei:l>וְכִתְּת֨וּ חַרְבוֹתָ֜ם לְאִתִּ֗ים</tei:l>
          <tei:l>וַחֲנִיתֽוֹתֵיהֶם֙ לְמַזְמֵר֔וֹת</tei:l>
          <tei:l>לֹא־יִשָּׂ֨א ג֤וֹי אֶל־גּוֹי֙ חֶ֔רֶב</tei:l>
          <tei:l>וְלֹֽא־יִלְמְד֥וּ ע֖וֹד מִלְחָמָֽה׃</tei:l>
          <tei:l>וּמִיכָֽיְהוּ הַדּוֹבֵר אֱמֶת</tei:l>
          <tei:l>בִּפְנֵי הַזֵּדִים</tei:l>
          <tei:l>הוֹסִיף לִנְבוּאָתוֹ בִּנְבוּאָתוֹ</tei:l>
          <tei:l>וְיָשְׁב֗וּ אִ֣ישׁ תַּ֧חַת גַּפְנ֛וֹ</tei:l>
          <tei:l>וְתַ֥חַת תְּאֵנָת֖וֹ</tei:l>
          <tei:l>וְאֵ֣ין מַחֲרִ֑יד</tei:l>
          <tei:l>כִּי־פִ֛י יְהֹוָ֥ה צְבָא֖וֹת דִּבֵּֽר׃</tei:l>
          <tei:l>אָמֵן כֵּן יְהִי רָצוֹן.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:techinot_on_the_use_of_a_bomb_shelter_mayer/13"/>
        <tei:lg>
          <tei:l>וִיהִ֤י ׀ נֹ֤עַם אֲדֹנָ֥י אֱלֹהֵ֗ינוּ עָ֫לֵ֥ינוּ</tei:l>
          <tei:l>וּמַעֲשֵׂ֣ה יָ֭דֵינוּ כּוֹנְנָ֥ה עָלֵ֑ינוּ</tei:l>
          <tei:l>וּֽמַעֲשֵׂ֥ה יָ֝דֵ֗ינוּ כּוֹנְנֵֽהוּ׃ <tei:bibl>(תהלים צ:יז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:techinot_on_the_use_of_a_bomb_shelter_mayer/14"/>
        <tei:lg>
          <tei:l>יֹ֭שֵׁב בְּסֵ֣תֶר עֶלְי֑וֹן</tei:l>
          <tei:l>בְּצֵ֥ל שַׁ֝דַּ֗י יִתְלוֹנָֽן׃</tei:l>
          <tei:l>אֹמַ֗ר לַ֭יהֹוָה מַחְסִ֣י וּמְצוּדָתִ֑י</tei:l>
          <tei:l>אֱ֝לֹהַ֗י אֶבְטַח־בּֽוֹ׃ <tei:bibl>(תהלים צא:א-ב)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
