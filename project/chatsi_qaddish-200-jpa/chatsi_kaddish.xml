  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:chatsi_kaddish">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:chatsi_kaddish/1"/>
        <tei:lg>
          <tei:l>יתגדל ויתקדש</tei:l>
          <tei:l>שמיה רבא אמן</tei:l>
          <tei:l>בעלמא דברא</tei:l>
          <tei:l>כרעותיה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:chatsi_kaddish/2"/>
        <tei:lg>
          <tei:l>וימליך מלכותיה</tei:l>
          <tei:l>בחייכון וביומיכון</tei:l>
          <tei:l>ובחייהון דכל בית ישראל</tei:l>
          <tei:l>בעגלא ובזמן קריב</tei:l>
          <tei:l>ואמרו אמן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:chatsi_kaddish/3"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">ועונין הצבור</tei:note> אמן</tei:l>
          <tei:l>יהא שמיה רבה מברך</tei:l>
          <tei:l>לעלם ולעלמי עלמיא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:chatsi_kaddish/4"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">ואומר</tei:note> ויתברך אמן</tei:l>
          <tei:l>ישתבח ויתרומם</tei:l>
          <tei:l>ויתנשא ויתהדר</tei:l>
          <tei:l>ויתעלה ויתקלס</tei:l>
          <tei:l>שמיא דקודשא</tei:l>
          <tei:l>בריך הוא אמן</tei:l>
          <tei:l>לעילא</tei:l>
          <tei:l>מכל ברכתא ושירתא</tei:l>
          <tei:l>תושבחתא ונחמתא</tei:l>
          <tei:l>דאמרן בעלמא</tei:l>
          <tei:l>ואמרו אמן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
