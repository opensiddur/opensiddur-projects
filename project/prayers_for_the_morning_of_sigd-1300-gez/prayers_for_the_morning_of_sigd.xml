  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd/1"/>
        <tei:lg>
          <tei:l>መናብረተ ፡ ቤተ ፡ ዳዊት ፤ ተዘያነዉ ፡ ደኅናሃ ፡ ለኢየሩሳሌም።</tei:l>
          <tei:l>ኢየሩሳሌምሰ ፡ ሕንጽት ፡ ከመ ፡ ሀገር ፤ እለ ፡ ከማሃ ፡ ኅቡረ ፡ ምስሌሁ።</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd/2"/>
        <tei:lg xml:lang="ahg">
          <tei:l>ጂጘ ፡ ጂጘ ፣</tei:l>
          <tei:l>ኢየሩሳሌም ፣</tei:l>
          <tei:l>ጂጘ ፡ ጂጘ ፡ ዋሲ።</tei:l>
          <tei:l>ጂጘ ፡ ጂጘ ፣</tei:l>
          <tei:l>ቤተ ፡ መቅደስ ፣</tei:l>
          <tei:l>ጂጘ ፡ ጂጘ ፡ ዋሲ፨</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd/3"/>
        <tei:lg>
          <tei:l>ወበእንተ ፡</tei:l>
          <tei:l>ቤተ ፡ ዳዊት ፤ ተዘያነዉ ፡ ደኅናሃ ፡ ለኢየሩሳሌም።</tei:l>
          <tei:l>ወበእንተ ፡ ቤተ ፡ እግዚአብሔር ፡ አምላኪየ ፣ ኀሠሥኩ ፡ ሠናይተኪ።</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd/4"/>
        <tei:lg xml:lang="ahg">
          <tei:l>ጀበረኵ ፡ እምኔን ፡ ጀበረኵ።</tei:l>
          <tei:l>ጀበረኵ ፡ እምኔን ፡ ጀበረኵ፨</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd/5"/>
        <tei:lg>
          <tei:l>እለ ፡ ይትቀነዩ ፡ በውስጥ ፡ ቤትየ ፣ ወይወርሱ ፡ መዛግብትየ።</tei:l>
          <tei:l>እለ ፡ ይተግሁ ፡ በውስጥ ፡ ቤትየ ፣ ወይወርሱ ፡ መዛግብትየ።</tei:l>
          <tei:l>አንበሩ ፡ ነዳይ ፡ ወምስኪን ፣ አኅደሩ ፡ ውስጥ ፡ ቤትክሙ።</tei:l>
          <tei:l>አንበሩ ፡ ነዳይ ፡ ወግዩር ፣ አኅደሩ ፡ ውስጥ ፡ ቤትክሙ።</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd/7"/>
        <tei:lg>
          <tei:l>ዖፍኒ ፡ ረከበት ፡ ላቲ ፡ ቤተ።</tei:l>
          <tei:l>ይቄድሱ ፡ ስምየ ፡ ቤተ ፡ ያዕቆብ።</tei:l>
          <tei:l>ይቄድሱ ፡ ስምየ ፡ ቤተ ፡ እስራኤል።</tei:l>
          <tei:l>መኳንንተ ፡ ቤተ ፡ ያዕቆብ።</tei:l>
          <tei:l>መኳንንተ ፡ ቤተ ፡ እስራኤል።</tei:l>
          <tei:l>ወይእዜኒ ፡ ቤተ ፡ ያዕቆብ።</tei:l>
          <tei:l>ስምዑኒ ፡ ቤተ ፡ እስራኤል።</tei:l>
          <tei:l>አርኅው ፡ ኆኃተ ፡ መኳንንት ፤ ወይትረኀዋ ፡ እለ ፡ እምፍጥረት።</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
