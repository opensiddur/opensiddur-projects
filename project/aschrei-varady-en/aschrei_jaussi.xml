  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:aschrei_jaussi">
        <tei:head>Aschrei — a paraliturgical Ashrei on relating to the divine by Rivka Jaussi</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:aschrei_jaussi/1"/>
        <tei:lg>
          <tei:l>my <j:divineName>God</j:divineName>,</tei:l>
          <tei:l>all your works give thanks to you.</tei:l>
          <tei:l>your holy ones praise you—</tei:l>
          <tei:l>with my words, I too want to praise you.</tei:l>
          <tei:l>in your name, I want to bless</tei:l>
          <tei:l>and be a blessing to others—</tei:l>
          <tei:l>every day, I want to honor you in this way.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:aschrei_jaussi/2"/>
        <tei:lg>
          <tei:l>my <j:divineName>God</j:divineName>,</tei:l>
          <tei:l>generation after generation tells of your wonders<tei:anchor xml:id="note_2"/></tei:l>
          <tei:l>and your silence—</tei:l>
          <tei:l>I too am a witness to this.</tei:l>
          <tei:l>you give attention to those</tei:l>
          <tei:l>who ask for you—</tei:l>
          <tei:l>so I too turn to you.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:aschrei_jaussi/3"/>
        <tei:lg>
          <tei:l>my <j:divineName>God</j:divineName></tei:l>
          <tei:l>I try to understand your uniqueness,</tei:l>
          <tei:l>now and again and again—</tei:l>
          <tei:l>in my prayer, in my actions.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
