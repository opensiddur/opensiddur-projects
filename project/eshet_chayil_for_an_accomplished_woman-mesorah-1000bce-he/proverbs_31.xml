    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:proverbs/31">
        <tei:head>אֵשֶׁת חַיִל</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/10"/>
        <tei:lg>
          <tei:l>אֵשֶׁת חַיִל מִי יִמְצָא וְרָחוֹק מִפְּנִינִים מִכְרָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/11/a"/>
        <tei:lg>
          <tei:l>בָּטַח בָּהּ לֵב בַּעְלָהּ וְשָׁלָל לא יֶחְסָר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/12"/>
        <tei:lg>
          <tei:l>גְּמָלַתְהוּ טוֹב וְלֹא רָע כֹּל יְמֵי חַיֶּיה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/13/a"/>
        <tei:lg>
          <tei:l>דָּרְשָׁה צֶמֶר וּפִשְׁתִּים וַתַּעַשֹ בְּחֵפֶץ כַּפֶּיהָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/14/a"/>
        <tei:lg>
          <tei:l>הָיְתָה כָּאֳנִיּות סוחֵר מִמֶּרְחָק תָּבִיא לַחְמָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/15/a"/>
        <tei:lg>
          <tei:l>וַתָּקָם בְּעוד לַיְלָה וַתִּתֵּן טֶרֶף לְבֵיתָהּ וְחֹק לְנַעֲרֹתֶיהָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/16"/>
        <tei:lg>
          <tei:l>זָמְמָה שָׂדֶה וַתִּקָּחֵהוּ מִפְּרִי כַפֶּיהָ נָטְעָה כָּרֶם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>חָגְרָה בְעוֹז מָתְנֶיהָ וַתְּאַמֵּץ זְרוֹעוֹתֶיהָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/18/a"/>
        <tei:lg>
          <tei:l>טָעֲמָה כִּי־טוב סַחְרָהּ לא־יִכְבֶּה בַלַּיְלָה נֵרָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/19/a"/>
        <tei:lg>
          <tei:l>יָדֶיהָ שִׁלְּחָה בַכִּישׁור וְכַפֶּיהָ תָּמְכוּ פָלֶך</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/20/a"/>
        <tei:lg>
          <tei:l>כַּפָּהּ פָּרְשָׂה לֶעָנִי וְיָדֶיהָ שִׁלְּחָה לָאֶבְיוֹן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/21"/>
        <tei:lg>
          <tei:l>לֹא תִירָא לְבֵיתָהּ מִשָּׁלֶג כִּי כָל בֵּיתָהּ לָבוּשׁ שָׁנִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/22/a"/>
        <tei:lg>
          <tei:l>מַרְבַדִּים עָשְֹתָה־לָּהּ שֵׁשׁ וְאַרְגָּמָן לְבוּשָׁהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/23"/>
        <tei:lg>
          <tei:l>נוֹדָע בַּשְּׁעָרִים בַּעְלָהּ בְּשִׁבְתּוֹ עִם זִקְנֵי אָרֶץ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/24/a"/>
        <tei:lg>
          <tei:l>סָדִין עָשְֹתָה וַתִּמְכֹּר וַחֲגור נָתְנָה לַכְּנַעֲנִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/25"/>
        <tei:lg>
          <tei:l>עֹז וְהָדָר לְבוּשָׁהּ וְתִשׂחַק לְיוֹם אַחֲרוֹן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/26"/>
        <tei:lg>
          <tei:l>פִּיהָ פָּתְחָה בְחָכְמָה וְתוֹרַת חֶסֶד עַל לְשׁוֹנָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/27"/>
        <tei:lg>
          <tei:l>צוֹפִיָּה הֲלִיכוֹת בֵּיתָהּ וְלֶחֶם עַצְלוּת לֹא תֹאכֵל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>קָמוּ בָנֶיהָ וַיְאַשְּׁרוּהָ בַּעְלָהּ וַיְהַלְלָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/29/a"/>
        <tei:lg>
          <tei:l>רַבּוֹת בָּנוֹת עָשׂוּ חָיִל וְאַתְּ עָלִית עַל כֻּלָּנָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/30"/>
        <tei:lg>
          <tei:l>שֶׁקֶר הַחֵן וְהֶבֶל הַיֹּפִי אִשָּׁה יִרְאַת ה’ הִיא תִתְהַלָּל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:proverbs/31/31"/>
        <tei:lg>
          <tei:l>תְּנוּ לָהּ מִפְּרִי יָדֶיָה וִיהַלְלוּהָ בַשְׁעָרִים מַעֲשֶׂיהָ</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
