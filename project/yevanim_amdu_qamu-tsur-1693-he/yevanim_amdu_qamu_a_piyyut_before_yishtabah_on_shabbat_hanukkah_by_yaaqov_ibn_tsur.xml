    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yevanim_amdu_qamu_a_piyyut_before_yishtabah_on_shabbat_hanukkah_by_yaaqov_ibn_tsur">
        <tei:head>יְוָנִים עָמְדוּ קָמוּ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yevanim_amdu_qamu_a_piyyut_before_yishtabah_on_shabbat_hanukkah_by_yaaqov_ibn_tsur/1"/>
        <tei:lg>
          <tei:l>יְׄוָנִים עָׄמְדוּ קָׄמוּ בִּׄזְדוֹנָם</tei:l>
          <tei:l>צׄוּׄרׄ עֻזִּי הִשְׁפַּלְתָּם הִפַּלְתָּם</tei:l>
          <tei:l>עַמְּךָ בְּךָ שָׂמוּ בִּטְחוֹנָם</tei:l>
          <tei:l>מִצַּר הוֹשַׁעְתָּם וְהִצַּלְתָּם</tei:l>
          <tei:l>קַרְנָם רוֹמַֽמְתָּ דַּנְתָּ אֶת־דִּינָם</tei:l>
          <tei:l>וְגַם נָקַֽמְתָּ אֶת־נִקְמָתָם</tei:l>
          <tei:l>וְגִבּוֹרֵיהֶם וְכׇל־הֲמוֹנָם</tei:l>
          <tei:l>בְּיַד־חַלָּשִׁים הֵן מְסַרְתָּם</tei:l>
          <tei:l>בְּרֹב חַסְדְּךָ מָעוֹז מַחְסֵֽנוּ</tei:l>
          <tei:l>הֵן פְּצִיתָנוּ מִיַּד שׁוֹסֵֽינוּ</tei:l>
          <tei:l>יִשְׁתַּבַּח שִׁמְךָ לָעַד מַלְכֵּֽנוּ</tei:l>
          <tei:l>בְּפִי יְשָׁרִים וּבְשִׂפְתוֹתָם׃</tei:l>
          <tei:l>בְּרֹב...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yevanim_amdu_qamu_a_piyyut_before_yishtabah_on_shabbat_hanukkah_by_yaaqov_ibn_tsur/2"/>
        <tei:lg>
          <tei:l>בְּתוֹךְ נָוְךָ צוּר וּבְחַצְרוֹתֶֽיךָ</tei:l>
          <tei:l>רָאשֵׁי אָבוֹת הִדְלִֽיקוּ נֵרוֹת</tei:l>
          <tei:l>נִסֶּֽיךָ וְגַם נִפְלְאוֹתֶֽיךָ</tei:l>
          <tei:l>הִגְדַּֽלְתָּ בְּעֹז וּבִגְבוּרוֹת</tei:l>
          <tei:l>צִדְקְךָ נֶהְגֶּה וּתְהִלּוֹתֶֽיךָ</tei:l>
          <tei:l>דּוֹדִי צַח יוֹצֵר הַמְּאוֹרוֹת</tei:l>
          <tei:l>וּנְפָאֵר תָּמִיד שֵׁם תִּפְאַרְתֶּֽךָ</tei:l>
          <tei:l>בְּהַלֵּל גָּמוּר וּבִזְמִירוֹת</tei:l>
          <tei:l>רַחוּם וְחַנּוּן מָגֵן יִשְׁעֵֽנוּ</tei:l>
          <tei:l>רֹב טוֹבוֹתֶֽיךָ עוֹד תַּשְׂבִּיעֵֽנוּ</tei:l>
          <tei:l>יָהּ וּפְצֵֽנוּ עוֹד מִמַּכְנִיעֵֽנוּ</tei:l>
          <tei:l>וְתַצִּילֵֽנוּ מִפַּח רִשְׁעָתָם׃</tei:l>
          <tei:l>בְּרֹב...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
