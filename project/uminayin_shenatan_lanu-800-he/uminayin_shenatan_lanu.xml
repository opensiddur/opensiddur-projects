  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:uminayin_shenatan_lanu">
        <tei:head>וּמִנַּֽיִן שֶׁנָּתַן־לָֽנוּ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:uminayin_shenatan_lanu/1"/>
        <tei:lg>
          <tei:l>וּמִנַּֽיִן שֶׁנָּתַן־לָֽנוּ אֶת־מָמוֹנָם? שֶׁנֶּאֱמַר — וַֽיְנַצְּל֖וּ אֶת־מִצְרָֽיִם׃ <tei:bibl>(שמות יב:לא)</tei:bibl> עֲשָׂאֽוּהָ כִּמְצוּלָה שֶׁאֵין בָּהּ דָּגִים׃ דָּבָר אַחֵר, עֲשָׂאֽוּהָ כִּמְצוּדָה שֶׁאֵין בָּהּ דָּגָן׃<tei:anchor xml:id="note_1"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:uminayin_shenatan_lanu/2"/>
        <tei:lg>
          <tei:l>לָמָּה מְחַבֵּב הַכָּתוּב אֶת־בִּזַּת הַיָּם יוֹתֵר מִבִּזַּת מִצְרַיִם? אֶלָּא מַה־שֶּׁהָיָה בַּבָּתִּים נָטְלוּ<tei:anchor xml:id="note_3"/> בְּמִצְרַיִם׃ וּמַה שֶּׁהָיָה בְּבָתֵּי תְּשׁוּרָאוֹת<tei:anchor xml:id="note_4"/> נָטְלוּ<tei:anchor xml:id="note_5"/> עַל־הַיָּם׃ וְכֵן הוּא אוֹמֵר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:uminayin_shenatan_lanu/3"/>
        <tei:lg>
          <tei:l>כַּנְפֵ֣י י֭וֹנָה נֶחְפָּ֣ה בַכֶּ֑סֶף <tei:bibl>(תהלים סח:יד</tei:bibl> —</tei:l>
          <tei:l>זוֹ בִּזַּת מִצְרַיִם׃</tei:l>
          <tei:l>וְ֝אֶבְרוֹתֶ֗יהָ בִּירַקְרַ֥ק חָרֽוּץ<tei:anchor xml:id="note_9"/> —</tei:l>
          <tei:l>זוֹ בִּזַּת הַיָּם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:uminayin_shenatan_lanu/4"/>
        <tei:lg>
          <tei:l>וַתִּרְבִּי֙ וַֽתִּגְדְּלִ֔י וַתָּבֹ֖אִי <tei:bibl>(יחזקאל טז:ז)</tei:bibl> —</tei:l>
          <tei:l>זוֹ בִּזַּת מִצְרַיִם׃</tei:l>
          <tei:l>בַּעֲדִ֣י עֲדָיִ֑ים<tei:anchor xml:id="note_11"/> —</tei:l>
          <tei:l>זוֹ בִּזַּת הַיָּם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:uminayin_shenatan_lanu/5"/>
        <tei:lg>
          <tei:l>תּוֹרֵ֤י זָהָב֙ נַֽעֲשֶׂה־לָּ֔ךְ <tei:bibl>(שיר השירים א:יא)</tei:bibl> —</tei:l>
          <tei:l>זוֹ בִּזַּת מִצְרַיִם׃</tei:l>
          <tei:l>עִ֖ם נְקֻדּ֥וֹת הַכָּֽסֶף<tei:anchor xml:id="note_13"/> —</tei:l>
          <tei:l>זוֹ בִּזַּת הַיָּם:</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" n="1" target="#note_1">
      <tei:p>ראה ברכות ט ׃בנוסח תימן אומרים — אִם עֲשָׂאֽוּהָ כִּמְצוּלָה זוֹ שֶׁאֵין בָּהּ דָּגִים, אִם עֲשָׂאֽוּהָ כִּמְצוּדָה זוֹ שֶׁאֵין בָּהּ דָּגָן׃</tei:p>
    </tei:note>
    <tei:note type="commentary" n="3" target="#note_3">
      <tei:p>בנוסח תימן אומרים — נְטָלֽוּהוּ</tei:p>
    </tei:note>
    <tei:note type="commentary" n="4" target="#note_4">
      <tei:p>בנוסח תימן אומרים — סוּרָאוֹת</tei:p>
    </tei:note>
