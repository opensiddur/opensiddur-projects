    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:shir_mizmor_lepurim_morais">
        <tei:head>שיר מזמור לפורים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shir_mizmor_lepurim_morais/1"/>
        <tei:lg>
          <tei:l>שיר מזמור לפורים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shir_mizmor_lepurim_morais/2"/>
        <tei:lg>
          <tei:l>פּוּרִים פּוּרִים! בָּרוּךְ תִּהְיֶה</tei:l>
          <tei:l>מַשִּׁיב רוּחַ פִּגְרֵי מֵתִים.</tei:l>
          <tei:l>זָכוּר לַטּוֹב! שִׁמְךָ תִּחְיֶה</tei:l>
          <tei:l>בְּלֵב אוֹהֲבֵי הַשּׁוֹתִים.</tei:l>
          <tei:l>הַמּוֹעֲדִים כֻּלָּם יִתַּֽמּוּ</tei:l>
          <tei:l>מִתּוֹךְ הָעָם מֹשֶׁה גָּאַל</tei:l>
          <tei:l>לְסוֹף יָמִים בַּחוּץ יֻשַּֽׂמוּ</tei:l>
          <tei:l>לִשְׁלוֹמְךָ לְבַד נִשְׁאַל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shir_mizmor_lepurim_morais/3"/>
        <tei:lg>
          <tei:l>כִּי כֵן נִגְזַר בִּזְמַן קַדְמוֹן</tei:l>
          <tei:l>בִּתְלוּת הָמָן עֲלֵי הָעֵץ</tei:l>
          <tei:l>“לִזְכֹּר הַנֵּס קָרְאוּ הָמוֹן</tei:l>
          <tei:l>לְהִשְׁתַּכֵּר עֲדִי אֵין קֵץ”</tei:l>
          <tei:l>אַל תִּפְחֲדוּ בְּהֶֽעֱרִים סוֹד</tei:l>
          <tei:l>רָאשֵׁי כַּת ה־פְּרוֹהִיבִּֽישׁוֹן</tei:l>
          <tei:l>בִּמְסִלּוֹתָם יִרְבֶּה הַשֹּׁד</tei:l>
          <tei:l>לֹא יַאֲרִֽיכוּ עוֹד לָשׁוֹן!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shir_mizmor_lepurim_morais/4"/>
        <tei:lg>
          <tei:l>לִשְׁנַת מִשֶּׁנִּכְנַס אֲדָר מַׄרְׄבִּׄיׄןׄ בְּׄשִׂׄמְׄחָׄהׄ לְפַׄקׄ</tei:l>
        </tei:lg>
      </tei:div>
