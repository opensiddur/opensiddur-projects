  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:wachad_gadia">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wachad_gadia/1"/>
        <tei:lg>
          <tei:l>واحد غديا، واحد غديا،</tei:l>
          <tei:l>الدي شرا لي بابا</tei:l>
          <tei:l>بزوز فلوس.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wachad_gadia/2"/>
        <tei:lg>
          <tei:l>وجات القطوس</tei:l>
          <tei:l>وكلات اجدي</tei:l>
          <tei:l>الدي شرا لي بابا</tei:l>
          <tei:l>بزوز فلوس،</tei:l>
          <tei:l>واحد غديا، واحد غديا،</tei:l>
          <tei:l>الدي شرا لي بابا</tei:l>
          <tei:l>بزوز فلوس.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wachad_gadia/3"/>
        <tei:lg>
          <tei:l>وجات الكلبة</tei:l>
          <tei:l>وغدبت القيّوس</tei:l>
          <tei:l>الدي كلات اجدي</tei:l>
          <tei:l>الدي شرا لي بابا</tei:l>
          <tei:l>بزوز فلوس،</tei:l>
          <tei:l>واحد غديا، واحد غديا،</tei:l>
          <tei:l>الدي شرا لي بابا</tei:l>
          <tei:l>بزوز فلوس.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wachad_gadia/4"/>
        <tei:lg>
          <tei:l>وجات العسا</tei:l>
          <tei:l>ودربت الكلبة،</tei:l>
          <tei:l>الدي غدمت القيّوس،</tei:l>
          <tei:l>الدي كلات اجدي،</tei:l>
          <tei:l>الدي شرا لي بابا</tei:l>
          <tei:l>بزوز فلوس،</tei:l>
          <tei:l>واحد غديا، واحد غديا،</tei:l>
          <tei:l>الدي شرا لي بابا</tei:l>
          <tei:l>بزوز فلوس.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wachad_gadia/5"/>
        <tei:lg>
          <tei:l>وجا النار</tei:l>
          <tei:l>واحرق العسا،</tei:l>
          <tei:l>الدي دربت الكلبة،</tei:l>
          <tei:l>الدي غدمت القيّوس،</tei:l>
          <tei:l>الدي كلات اجدي،</tei:l>
          <tei:l>الدي شرا لي بابا</tei:l>
          <tei:l>بزوز فلوس،</tei:l>
          <tei:l>واحد غديا، واحد غديا،</tei:l>
          <tei:l>الدي شرا لي بابا</tei:l>
          <tei:l>بزوز فلوس.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wachad_gadia/6"/>
        <tei:lg>
          <tei:l>وجا الماة</tei:l>
          <tei:l>وطفا النور،</tei:l>
          <tei:l>الدي احرق العسا،</tei:l>
          <tei:l>الدي دربت الكلبة،</tei:l>
          <tei:l>الدي غدمت القيّوس،</tei:l>
          <tei:l>الدي كلات اجدي،</tei:l>
          <tei:l>الدي شرا لي بابا</tei:l>
          <tei:l>بزوز فلوس،</tei:l>
          <tei:l>واحد غديا، واحد غديا،</tei:l>
          <tei:l>الدي شرا لي بابا</tei:l>
          <tei:l>بزوز فلوس.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wachad_gadia/7"/>
        <tei:lg>
          <tei:l>وجا التور</tei:l>
          <tei:l>وشرب الماة،</tei:l>
          <tei:l>الدي طفا النار،</tei:l>
          <tei:l>الدي احرق العسا،</tei:l>
          <tei:l>الدي دربت الكلبة،</tei:l>
          <tei:l>الدي غدمت القيّوس،</tei:l>
          <tei:l>الدي كلات اجدي،</tei:l>
          <tei:l>الدي شرا لي بابا</tei:l>
          <tei:l>بزوز فلوس،</tei:l>
          <tei:l>واحد غديا، واحد غديا،</tei:l>
          <tei:l>الدي شرا لي بابا</tei:l>
          <tei:l>بزوز فلوس.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wachad_gadia/8"/>
        <tei:lg>
          <tei:l>وجا الدباح</tei:l>
          <tei:l>ودبح التور،</tei:l>
          <tei:l>الدي شرب الماة،</tei:l>
          <tei:l>الدي طفا النار،</tei:l>
          <tei:l>الدي احرق العسا،</tei:l>
          <tei:l>الدي دربت الكلبة،</tei:l>
          <tei:l>الدي غدمت القيّوس،</tei:l>
          <tei:l>الدي كلات اجدي،</tei:l>
          <tei:l>الدي شرا لي بابا</tei:l>
          <tei:l>بزوز فلوس،</tei:l>
          <tei:l>واحد غديا، واحد غديا،</tei:l>
          <tei:l>الدي شرا لي بابا</tei:l>
          <tei:l>بزوز فلوس.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wachad_gadia/9"/>
        <tei:lg>
          <tei:l>وجا ملك الموت</tei:l>
          <tei:l>ودبح الدباح،</tei:l>
          <tei:l>الدي دبح التور،</tei:l>
          <tei:l>الدي شرب الماة،</tei:l>
          <tei:l>الدي طفا النار،</tei:l>
          <tei:l>الدي احرق العسا،</tei:l>
          <tei:l>الدي دربت الكلبة،</tei:l>
          <tei:l>الدي غدمت القيّوس،</tei:l>
          <tei:l>الدي كلات اجدي،</tei:l>
          <tei:l>الدي شرا لي بابا</tei:l>
          <tei:l>بزوز فلوس،</tei:l>
          <tei:l>واحد غديا، واحد غديا،</tei:l>
          <tei:l>الدي شرا لي بابا</tei:l>
          <tei:l>بزوز فلوس.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:wachad_gadia/10"/>
        <tei:lg>
          <tei:l>وجا هقدوش بروخ هوا</tei:l>
          <tei:l>ودبح ملك الموت،</tei:l>
          <tei:l>الدي دبح الدباح،</tei:l>
          <tei:l>الدي دبح التور،</tei:l>
          <tei:l>الدي شرب الماة،</tei:l>
          <tei:l>الدي طفا النار،</tei:l>
          <tei:l>الدي احرق العسا،</tei:l>
          <tei:l>الدي دربت الكلبة،</tei:l>
          <tei:l>الدي غدمت القيّوس،</tei:l>
          <tei:l>الدي كلات اجدي،</tei:l>
          <tei:l>الدي شرا لي بابا</tei:l>
          <tei:l>بزوز فلوس،</tei:l>
          <tei:l>واحد غديا، واحد غديا،</tei:l>
          <tei:l>الدي شرا لي بابا</tei:l>
          <tei:l>بزوز فلوس.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
