    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:blessed_are_you_who_made_me_a_woman">
        <tei:head>Blessed are you...who made me a woman, a variation of the morning blessing for Jewish women in Judeo-Provençal (ca. 14-15th c.)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessed_are_you_who_made_me_a_woman/1"/>
        <tei:lg>
          <tei:l>Blessed are you,</tei:l>
          <tei:l>Lord our God,</tei:l>
          <tei:l>king of eternity,</tei:l>
          <tei:l>who did not make me a slave.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessed_are_you_who_made_me_a_woman/2"/>
        <tei:lg>
          <tei:l>Blessed are you,</tei:l>
          <tei:l>Lord our God,</tei:l>
          <tei:l>king of eternity,</tei:l>
          <tei:l>who did not make me a Gentile.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessed_are_you_who_made_me_a_woman/3"/>
        <tei:lg>
          <tei:l>Blessed are you,</tei:l>
          <tei:l>Lord our God,</tei:l>
          <tei:l>king of eternity,</tei:l>
          <tei:l>who made me a woman.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
