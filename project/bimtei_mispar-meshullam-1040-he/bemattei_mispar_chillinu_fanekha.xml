      <tei:div corresp="urn:x-opensiddur:text:poem:bemattei_mispar_chillinu_fanekha">
        <tei:head>בִּמְתֵי מִסְפָּר</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bemattei_mispar_chillinu_fanekha/stanza_1"/>
        <tei:lg>
          <tei:l>בִּמְתֵי מִסְפָּר חִלִּֽינוּ פָנֶֽיךָ</tei:l>
          <tei:l>לְשַׁוְעַת נְכֵאִים אַל תַּעְלֵם אׇזְנֶֽךָ</tei:l>
          <tei:l>הַקְשֵׁב תְּחִנָּתָם מִשְּׁמֵי מְעוֹנֶֽךָ</tei:l>
          <tei:l>כְּבִימֵי מוֹר וַהֲדַס הוֹשַֽׁעְתָּ בָנֶֽיךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bemattei_mispar_chillinu_fanekha/stanza_2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">תְּ</tei:seg>הִלּוֹת יִשְׂרָאֵל אַתָּה יוֹשֵׁב</tei:l>
          <tei:l><tei:seg type="acrostic">שַׁ</tei:seg>וְעָתָם מַאֲזִין וְרִנָּתָם קוֹשֵׁב</tei:l>
          <tei:l><tei:seg type="acrostic">רִ</tei:seg>פְאוּת לְמַחַץ מַקְדִּים וּמְחַשֵּׁב</tei:l>
          <tei:l><tei:seg type="acrostic">קְ</tei:seg>נוּיֶֽיךָ לְהֵיטִיב וְנָוֵיהֶם לְיַשֵּׁב</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בִּמְתֵי מִסְפָּר חִלִּֽינוּ פָנֶֽיךָ...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bemattei_mispar_chillinu_fanekha/stanza_3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">צָ</tei:seg>ר וְאוֹיֵב הִלְטִישׁ עֵינָיו</tei:l>
          <tei:l><tei:seg type="acrostic">פִּ</tei:seg>יהוּ פָעַר לִשְׁאוֹף עָנָיו</tei:l>
          <tei:l><tei:seg type="acrostic">עִ</tei:seg>שֵּׁת בְּשֶׁלּוֹ לְהַשְׁמִיד קְהַל הֲמוֹנָיו</tei:l>
          <tei:l><tei:seg type="acrostic">סֶֽ</tei:seg>גֶל לְאַבֵּד חָרַת בְּנִשְׁתְּוָנָיו</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בִּמְתֵי מִסְפָּר חִלִּֽינוּ פָנֶֽיךָ...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bemattei_mispar_chillinu_fanekha/stanza_4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נ</tei:seg>וֹקֵם לְצָרִים וְנוֹטֵר לְאוֹיְבִים</tei:l>
          <tei:l><tei:seg type="acrostic">מָ</tei:seg>דַֽדְתָּ מִדָּתָם כְּזָדוּ לַאֲהוּבִים</tei:l>
          <tei:l><tei:seg type="acrostic">ל</tei:seg>וֹחֵם וְנִינָיו הוּתְלוּ מֻצְלָבִים</tei:l>
          <tei:l><tei:seg type="acrostic">כְּ</tei:seg>בַחֲרֽוֹזֶת דָּגִים חוֹרְזוּ תְּחוּבִים</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בִּמְתֵי מִסְפָּר חִלִּֽינוּ פָנֶֽיךָ...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bemattei_mispar_chillinu_fanekha/stanza_5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">י</tei:seg>וֹם אֲשֶׁר שִׂבְּרוּ צוֹרְרִים</tei:l>
          <tei:l><tei:seg type="acrostic">טִ</tei:seg>בְחָה לָשִׁית בְּעַם נְצוּרִים</tei:l>
          <tei:l><tei:seg type="acrostic">חֻ</tei:seg>לְּפָה הַדָּת וְנָפְלוּ פְגָרִים</tei:l>
          <tei:l><tei:seg type="acrostic">זֻ</tei:seg>לְעֲפוּ זוֹעֲמוּ מוּבָסִים מֻגָרִים</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בִּמְתֵי מִסְפָּר חִלִּֽינוּ פָנֶֽיךָ...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bemattei_mispar_chillinu_fanekha/stanza_6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וּ</tei:seg>בְכֵן יִתְעַלֶּה שִׁמְךָ וְיִתְנַשֵּׂא</tei:l>
          <tei:l><tei:seg type="acrostic">ה</tei:seg>וֹדְךָ שְׁמֵי שָׁמַֽיִם כִּסָּה</tei:l>
          <tei:l><tei:seg type="acrostic">דַּ</tei:seg>כִּים בְּרוֹמִמְךָ נְתוּנִים לִמְשִׁסָּה</tei:l>
          <tei:l><tei:seg type="acrostic">גֵּ</tei:seg>יא וַאֲפָסֶֽיהָ תְּהִלָּתְךָ מְכַסָּה</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בִּמְתֵי מִסְפָּר חִלִּֽינוּ פָנֶֽיךָ...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bemattei_mispar_chillinu_fanekha/stanza_7-stanza_8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בִּ</tei:seg>ינָה הֲגִינֵֽנוּ עַתָּה וּרְאֵה בַצָּר</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>אַפְּךָ קוּמָה עַל צוֹרֵר הַצָּר</tei:l>
          <tei:l><tei:seg type="acrostic">אָ</tei:seg>דוֹן קְרָאנוּךָ מִן הַמֵּצָר</tei:l>
          <tei:l><tei:seg type="acrostic">אָ</tei:seg>נָּא הוֹצִיאֵֽנוּ לַמֶּרְחָב וְחַלְּצֵֽנוּ מִצָּר</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בִּמְתֵי מִסְפָּר חִלִּֽינוּ פָנֶֽיךָ...</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מְ</tei:seg>אֹד תַּרְבֶּה לָֽנוּ מְחִילָה</tei:l>
          <tei:l><tei:seg type="acrostic">שְׁ</tei:seg>מַע תְּפִלָּה וְהַעֲבֵר תִּפְלָה</tei:l>
          <tei:l><tei:seg type="acrostic">ל</tei:seg>וֹחֲצֵֽינוּ יַשְׁלִֽימוּ אִתָּֽנוּ וַעֲוֺנוֹתֵֽינוּ תַשְׁלִיךְ בִּמְצוּלָה</tei:l>
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>מֶּֽנּוּ רַחֲמֶֽיךָ לֹא תִכְלָא</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בִּמְתֵי מִסְפָּר חִלִּֽינוּ פָנֶֽיךָ...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
