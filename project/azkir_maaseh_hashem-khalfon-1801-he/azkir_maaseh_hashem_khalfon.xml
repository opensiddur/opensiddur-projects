    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon">
        <tei:head>אַזְכִּיר מַעֲשֵׂה ה׳</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/1"/>
        <tei:lg>
          <tei:l>מִי כָמֹֽכָה וְאֵין כָּמֹֽכָה</tei:l>
          <tei:l>מִי דוֹמֶה לָךְ וְאֵין דּוֹמֶה לָךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אַ</tei:seg>זְכִּיר מַעֲשֵׂה יְיָ בִּקְהַל עֲדָתוֹ</tei:l>
          <tei:l>אֲ֠שֶׁר לֹֽא־עָזַ֥ב חַסְדּ֛וֹ וַאֲמִתּ֖וֹ</tei:l>
          <tei:l>כִּי זָכַר לְעוֹלָם בְּרִיתוֹ</tei:l>
          <tei:l>חַנּ֣וּן וְרַח֣וּם יהו֑ה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>רִיתוֹ זָכַר וְלֹא שְׁכָחָֽנוּ</tei:l>
          <tei:l>לֹא גְעָלָֽנוּ וְלֹא מְאָסָֽנוּ</tei:l>
          <tei:l>וְאִם יִסְרָֽנוּ לַמָּֽוֶת לֹא נְתָנָֽנוּ</tei:l>
          <tei:l>כִּ֣י אֵ֤ל רַחוּם֙ יהו֣ה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">גְּ</tei:seg>דוֹל הָעֵצָה וַעֲצָתוֹ הִיא תָקוּם</tei:l>
          <tei:l>מֵאוֹיֵב הָאַכְזָר דַּם עֲבָדָיו יִקּוֹם</tei:l>
          <tei:l>וַיָּֽפֶץ וַיַּשְׁלֵךְ בְּאֶֽפֶס מָקוֹם</tei:l>
          <tei:l>כִּ֛י י֥וֹם נָקָ֖ם לַֽיהו֑ה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">דַּ</tei:seg>רְכֵי אֵל מֵאָז נָכֽוֹנוּ</tei:l>
          <tei:l>מֵרוֹב עֲוֺנֵֽינוּ עֲצָבֽוּנוּ</tei:l>
          <tei:l>וְנָפַֽלְנוּ בְּיַד רְשָׁעִים וְעִנּֽוּנוּ</tei:l>
          <tei:l>לָ֣מָּה תַתְעֵ֤נוּ יהוה֙׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הַ</tei:seg>יּוֹם אַבִּֽיעָה חִידוֹת</tei:l>
          <tei:l>עַל־הַנִּסִּים וְעַל־הַנִּפְלָאוֹת</tei:l>
          <tei:l>שֶׁעָֽשָׂה־לָֽנוּ יוֹצֵר הָרוּחוֹת</tei:l>
          <tei:l>מַה־גָּדְל֣וּ מַעֲשֶׂ֣יךָ יהו֑ה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וַ</tei:seg>יְהִי בִּימֵי עַֽלִי בַּאֽשָׁה קָרָאמַֽלִי זֶֽרַע הַפַּרְתְּמִים</tei:l>
          <tei:l>אוֹהֵב יִשְׂרָאֵל וְהוֹלֵךְ תָּמִים</tei:l>
          <tei:l>בָּא עַלִי גּוּרְגִ׳י רָשָׁע וְאִישׁ דָּמִים</tei:l>
          <tei:l>אִישׁ־דָּמִ֥ים וּמִרְמָ֗ה יְתָ֘עֵ֥ב ׀ יהוֽה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זֶֽ</tei:seg>רַע מְרֵעִים שְׁנַת התקנ”ג בָּא לָעִיר</tei:l>
          <tei:l>בְּט’ אֳנִיּוֹת יָוָן וְתוֹגַרְמָה וּבְנֵי שֵׂעִיר</tei:l>
          <tei:l>בְּאֶחָד וְעֶשְׂרִים לְחֹדֶשׁ אָב עָלֶֽיהָ הֵעִיר</tei:l>
          <tei:l>לַעֲשׂ֥וֹת הָרַ֖ע בְּעֵינֵ֣י יהו֑ה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חֲ</tei:seg>רָדָה וְאֵימָה נָפְלָה עַל־הַמֶּֽלֶךְ</tei:l>
          <tei:l>וַיָּֽקׇם הוּא וְכׇל־אַנְשֵׁי בֵיתוֹ וַיֵּֽלֶךְ</tei:l>
          <tei:l>וְנָשָׁיו וּבְנֹתָיו בָּכֹה בָכוּ וַיֵּֽלֶךְ</tei:l>
          <tei:l>כִּי נָגְעָה בָם יַד־יהוה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/10"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">טָ</tei:seg>מַן שִׂנְאָה בְלִבּוֹ אִישׁ הַבְּלִיַֽעַל</tei:l>
          <tei:l>וַיִּשְׁקֶה אַנְשֵׁי הָעִיר כּוֹס שֶׁל־רַֽעַל</tei:l>
          <tei:l>וּבְכׇל־יוֹם וָיוֹם תּוֹסִיף חֲמָתוֹ וַתַּֽעַל</tei:l>
          <tei:l>וַיַּ֥עַשׂ הָרַ֖ע בְּעֵינֵ֣י יהו֑ה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/11"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>עַץ הָרָשָׁע בְּלִבּוֹ תַּחְבּוּלוֹת</tei:l>
          <tei:l>לַהֲרוֹג מֵאַנְשֵׁי הָעִיר בְּמִרְמוֹת</tei:l>
          <tei:l>וַתִּפּוֹל אֵימָתוֹ וּפַחְתּוֹ עַל־הַבְּרִיּוֹת</tei:l>
          <tei:l>וַיַּֽעַשׂ כׇּל־תּוֹעֲבוֹת יהוה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/12"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כְּ</tei:seg>אַרְיֵה שָׁאַג עַל־זֶֽרַע יַעֲקֹב</tei:l>
          <tei:l>וַיִּקַּח מֵאִתָּם כְּשִׁשִׁים אֶֽלֶף מַחְבּוּבּ</tei:l>
          <tei:l>וּבְכׇל־יוֹם וָיוֹם עֲלֵיהֶם יֶאֱרוֹב</tei:l>
          <tei:l>מֶ֤לֶךְ עַז֙ יִמְשׇׁל־בָּ֔ם נְאֻ֥ם יהו֥ה<tei:anchor xml:id="note_8"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/13"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">לֹ</tei:seg>א־נָח וְלֹא־שָׁקֵט מֵעַל־בְּנֵי יִשְׂרָאֵל</tei:l>
          <tei:l>וַיּוֹסֶף בְּכַעְסוֹ וּבְרִשְׁעוֹ לְהִתְעוֹלֵל</tei:l>
          <tei:l>וְאֵין־סוֹמֵךְ וְאֵין־מֵלִיץ עֲלֵיהֶם לְחוֹלֵל</tei:l>
          <tei:l>כִּֽי־אַתָּ֬ה לְבַדֶּ֑ךָ שִׁמְךָ֣ יהו֣ה׃<tei:anchor xml:id="note_10"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/14"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>כְּנַף הָאָֽרֶץ בָּאָה צָרָה</tei:l>
          <tei:l>עַל־שְׁנֵי עִבְרִים אַפּוֹ חָרָה</tei:l>
          <tei:l>וַיִּתְפְּשֵׂם וַיִּשְׂרְפֵם בְּאֵשׁ בּוֹעֲרָה</tei:l>
          <tei:l>אֵ֣ל קַנּ֤וֹא וְנֹקֵם֙ יהו֔ה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/15"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נַ</tei:seg>פְשֵֽׁנוּ עַד־מְאֹד נִבְהֲלָה</tei:l>
          <tei:l>כִּי רָאִֽינוּ בָּעֲרוּ בָהֶם הָאֵשׁ הַגְּדוֹלָה</tei:l>
          <tei:l>גוּפָם נִשְׂרַף וְנַפְשָׁם עוֹלָה</tei:l>
          <tei:l>לִפְנֵי הַמֶּֽלֶךְ הָאָדוֹן יהוה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/16"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">סָ</tei:seg>מַר בְּשָׂרֵֽנוּ בַּעֲשׂוֹתוֹ זֹאת</tei:l>
          <tei:l>וַעֲלֵיהֶם יִבְכּוּ בָּנִים גַּם אָבוֹת</tei:l>
          <tei:l>רָחוֹק וְקָרוֹב יִזְלוּ דְמָעוֹת</tei:l>
          <tei:l>אֶת־הַשְּׂרֵפָ֔ה אֲשֶׁ֖ר שָׂרַ֥ף יהוֽה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/17"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">עֲ</tei:seg>דַת עָרִיצִים נוֹעֲדוּ עָלֵֽינוּ</tei:l>
          <tei:l>לְהַשְׁמִיד וּלְהַכְרִית אֶת־שְׁמֵֽנוּ</tei:l>
          <tei:l>לוּלֵא יהוה שֶׁהָיָה עֶזְרָתֵֽנוּ</tei:l>
          <tei:l>כִּ֣י לֹ֥א לְעוֹלָ֖ם יִזְנַ֛ח אֲדֹנָֽי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/18"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פָּֽ</tei:seg>צוּ עָלֵֽינוּ פִּיהֶם הַמּוֹרְדִים</tei:l>
          <tei:l>וּבָֽנוּ בְּכׇל־יוֹם מַכִּים וְרוֹדִים</tei:l>
          <tei:l>מָֽשְׁלוּ בָֽנוּ יָוָן וַעֲבָדִים</tei:l>
          <tei:l>כׇּל־גּוֹיִ֥ם סְבָב֑וּנִי בְּשֵׁ֥ם י֝הו֗ה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/19"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">צָ</tei:seg>רִים עָֽבְדוּ בָּֽנוּ עֲבוֹדַת פָּֽרֶךְ</tei:l>
          <tei:l>לֹא חָמְלוּ עַל נַֽעַר זָקֵן וָהֵֽלֶךְ</tei:l>
          <tei:l>בְּכׇל־עֲבוֹדַת בֵּית הַמֶּֽלֶךְ</tei:l>
          <tei:l>בְּֽעֵ֘ינָ֤יו נִמְאָ֗ס וְאֶת־יִרְאֵ֣י יהו֣ה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/20"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קַֽ</tei:seg>יִץ וָחֹֽרֶף הָלַךְ עָבַר</tei:l>
          <tei:l>וְעֻלּוֹ עָלֵֽינוּ הוֹסִיף הָאַכְזָר</tei:l>
          <tei:l>בְּיַד אַכְזָרִים אוֹתָֽנוּ מָסַר</tei:l>
          <tei:l>וְאֵ֣ין שָׁל֔וֹם אָמַ֥ר יהו֖ה׃<tei:anchor xml:id="note_13"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/21"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רְ</tei:seg>שָׁעִים הוֹסִֽיפוּ בְּרִשְׁעָתָם</tei:l>
          <tei:l>עַל־תִּינוֹקוֹת שֶׁל־בֵּית רַבָּן בִּטְלוּם מִתּוֹרָתָם</tei:l>
          <tei:l>וַיִּקְחוּם לַעֲבוֹד עֲבוֹדָתָם</tei:l>
          <tei:l>הַעַל־אֵ֥לֶּה תִתְאַפַּ֖ק יהו֑ה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/22"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שָׁ</tei:seg>בְתוּ שַׁבָּת וְיוֹם טוֹב מִמֶּֽנּוּ</tei:l>
          <tei:l>וְחִלַּֽלְנוּ אוֹתָם בְּעַל כׇּרְחֵֽנוּ</tei:l>
          <tei:l>גַּם־עֲבוֹדַת כָּתֵף סָבַֽלְנוּ עַל־שִׁכְמֵֽנוּ</tei:l>
          <tei:l>זְכׇר־זֹ֗את א֭וֹיֵב חֵרֵ֣ף׀ יהו֑ה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/23"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">תָּ</tei:seg>מַךְ בְּרִשְׁעָתוֹ אִישׁ הַדָּמִים</tei:l>
          <tei:l>לַעֲבוֹד בָּֽנוּ עֲבוֹדַת הַיָּם בְּאֶֽפֶס דָּמִים</tei:l>
          <tei:l>בִּטֵּל מִמֶּֽנּוּ תְּפִלָּה וַעֲנִיַּת אָמֵנִים</tei:l>
          <tei:l>וְלֹ֣א אוּכַ֔ל לָב֖וֹא בֵּ֥ית יהוֽה׃<tei:anchor xml:id="note_14"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/24"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>מָּרוֹם הוֹצִיא כְּלֵי זַעְמוֹ</tei:l>
          <tei:l>וּמְסָרָֽנוּ בְּיַד אִישׁ יִמַּח שְׁמוֹ</tei:l>
          <tei:l>וּמְשָׁרְתָיו כְּאַרְיֵה נָהוֹם יִנְהֲמוּ</tei:l>
          <tei:l>יַצְמִיתֵ֑ם יַ֝צְמִיתֵ֗ם יהו֥ה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/25"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נַ֤</tei:seg>חְנוּ פָשַׁ֨עְנוּ֙ וּמָרִ֔ינוּ</tei:l>
          <tei:l>גָּדַל עֲוֺנֵֽנוּ וְגָבְרוּ חַטאֹתֵֽינוּ</tei:l>
          <tei:l>אַתָּה יהוה רִיבָה רִיבֵֽנוּ וּגְאָלֵֽנוּ</tei:l>
          <tei:l>נִצָּ֥ב לָרִ֖יב יהו֑ה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/26"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">צ</tei:seg>וּרֵֽנוּ אַתָּה תּוֹשִׁיעֵֽנוּ</tei:l>
          <tei:l>כִּי עָלֶֽיךָ הִשְׁלַֽכְנוּ יְהָבֵֽנוּ</tei:l>
          <tei:l>אַתָּה תָקוּם תָּשׁוּב תְּרַחֲמֵֽנוּ</tei:l>
          <tei:l>רַחֲמֶ֖יךָ רַבִּ֥ים ׀ יהו֑ה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/27"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>דֵֽנוּ אַתָּה יוֹשֵׁב שָׁמַֽיִם</tei:l>
          <tei:l>כִּי לָקִֽינוּ עַל־חַטֹאתֵינוּ כִּפְלַֽיִם</tei:l>
          <tei:l>כִּי בָֽאנוּ בָּאֵשׁ וּבַמַּֽיִם</tei:l>
          <tei:l>וְיָשֹׁ֛ב חֲר֥וֹן אַף־יהו֖ה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/28"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כָּ</tei:seg>לְתָה לִתְשׁוּעָתְךָ נַפְשֵֽׁנוּ</tei:l>
          <tei:l>כִּי אֵלֶֽיךָ קִוִּינוּ וּלְךָ חִכִּֽינוּ</tei:l>
          <tei:l>לְךָ תְלוּיוֹת עֵינֵֽינוּ וְלִבֵּֽנוּ</tei:l>
          <tei:l>יַחֵ֥ל יִשְׂרָאֵ֗ל אֶל־יה֫וה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/29"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אֱ</tei:seg>לֹהִים שָׁב וְנִחַם עַל־עַמּוֹ</tei:l>
          <tei:l>כִּי עָלְתָה צַעֲקָתָם לִפְנֵי כִסֵּא הֲדוֹמוֹ</tei:l>
          <tei:l>קִבֵּל וְשָׁמַע תְּפִלָּתָם מִשְׁמֵי מְרוֹמוֹ</tei:l>
          <tei:l>כִּֽי־שֹׁמֵ֣עַ אֶל־אֶבְיוֹנִ֣ים יהו֑ה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/30"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נִ</tei:seg>חַם יהו֑ה עַל־הָ֣רָעָ֔ה אֲשֶׁ֥ר דִּבֶּ֖ר לַעֲשׂ֥וֹת<tei:anchor xml:id="note_15"/></tei:l>
          <tei:l>וַיַּֽעַשׂ לָֽנוּ נָסִים וְנִפְלָאוֹת</tei:l>
          <tei:l>וַיּוֹצִיאֵֽנוּ מֵעַבְדוּת לְחֵרוּת</tei:l>
          <tei:l>תַּאֲוַ֬ת עֲנָוִ֣ים שָׁמַ֣עְתָּ יהו֑ה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/31"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">י</tei:seg>וֹם וָיוֹם נְסַפֶר תְּהִלָּתֶֽךָ</tei:l>
          <tei:l>כִּֽי־הִגְדַּ֥לְתָּ עַל־כׇּל־שִׁ֝מְךָ֗ אִמְרָתֶֽךָ</tei:l>
          <tei:l>וּבְכׇל־יוֹם נַגִיד נִפְלְאוֹתֶֽיךָ</tei:l>
          <tei:l>וּנְסַפֶר אֶת־מַעֲשֵׂה יהוה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/32"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אַ</tei:seg>חַר כׇּל־אֵֽלֶּה הַדְּבָרִים</tei:l>
          <tei:l>חַמֽוּדַא בַּֽאשָׁא לַעַֽלִי קָרָאמַֽלִי וּבָנָיו הֵרִים</tei:l>
          <tei:l>וַיְנַשְׂאֵֽהוּ מֵעַל כׇּל־הַשָּׂרִים</tei:l>
          <tei:l>כִּי לֶב־מֶ֭לֶךְ בְּיַד־יהו֑ה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/33"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בִּ</tei:seg>שְׁנַת קָנְתָ֥״ה יְמִינֽוֹ הֶרְאָֽנוּ יָדוֹ הַנִּפְלָאָה</tei:l>
          <tei:l>בְּזֶֽרַע עוֹבְדֵי פֶֽסֶל הַקִּנְאָה</tei:l>
          <tei:l>אַפּוֹ חָרָה מֵאָז רָאָה</tei:l>
          <tei:l>אֶת־הָאִישׁ שָׂנֵא יהוה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/34"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רָ</tei:seg>ץ וְהֵכִין לָהֶם מִלְחָמָה וּכְלֵי זַֽיִן</tei:l>
          <tei:l>וְהַכֶּֽסֶף נֶחְשַׁב לִפְנֵיהֶם כְּאַֽיִן</tei:l>
          <tei:l>וּפָרָשִׁים וְרַגְלִים מִסְפָּרָם אַֽיִן</tei:l>
          <tei:l>וַיַּעֲבֹר מַלְכָּם לִפְנֵי יהוה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/35"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הַ</tei:seg>יּוֹם יוֹם הַשַׁבָּת הִגִּיעָה הַמִּלְחָמָה</tei:l>
          <tei:l>עַל־פְּנֵי הָעִיר וַתִּחַן שָׁמָּה</tei:l>
          <tei:l>בְּשִׁשָׁה וְעֶשְׂרִים לְטֵֽבֵת דִּגְלָהּ הֵרִימָה</tei:l>
          <tei:l>כִּֽי־קָר֥וֹב יוֹם־יהו֖ה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/36"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>מָּחֳרַת הַשַׁבָּת יָצְאוּ לִקְרָאתָם</tei:l>
          <tei:l>וַיַּעַרְכוּ מִלְחָמָם אִתָּם</tei:l>
          <tei:l>וַיִּכְבְּשׁוּ אַנְשֵׁי הַמִּלְחָמָה מְקוֹמָם</tei:l>
          <tei:l>לא נוֹתַר דָּבָר נְאֻם יהוה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/37"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בִּ</tei:seg>רְאוֹתָם הַחַיָּלִים כִּי גָבְרָם יָדָם</tei:l>
          <tei:l>וַיֹּאמְרוּ בְלִבָּם בָּא יוֹם אֵידָם</tei:l>
          <tei:l>לֹא נִשְׁאַר מֵהֶם בְּהֵמָה וְאָדָם</tei:l>
          <tei:l>אָ֤דָֽם־וּבְהֵמָ֖ה תוֹשִׁ֣יעַ יהוֽה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/38"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נִ</tei:seg>כְנְסוּ הַחַיָּלִים עַל־הַשָּׂדוֹת</tei:l>
          <tei:l>וַיִּקְחוּ כׇּל־הָעֲבָדִים וְהַשְׁפָחוֹת</tei:l>
          <tei:l>וַיִּתְעוֹלְלוּ בַנָּשִׁים וּבַבְּתוּלוֹת</tei:l>
          <tei:l>וְלֹ֣א אָמְר֔וּ אַיֵּ֣ה יהו֔ה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/39"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רָ</tei:seg>אָה הָרָשָׁע כִּי כָלְתָה מַמְלַכְתּוֹ</tei:l>
          <tei:l>וַיּוֹצֵא הָאֲסִירִים אֲשֶׁר אִתּוֹ</tei:l>
          <tei:l>וַיִּתְפְּשֵׂם וַיַּהַרְגֵם בַּחֲמָתוֹ</tei:l>
          <tei:l>וַיּוֹרִידֵם לַטֶּֽבַח נְאֻם יהוה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/40"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פָּ</tei:seg>עַר פִּיו אַכְזָר לִבְלִי חוֹק</tei:l>
          <tei:l>וַיֹּֽאמֶר בְּלִבּוֹ לֹא עֵת לִשְׂחוֹק</tei:l>
          <tei:l>וַיָּבֵא עֲצוֹת מֵרָחוֹק</tei:l>
          <tei:l>לִבְרֽוֹחַ מִפְּנֵי יהוה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/41"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אַ</tei:seg>חַר חֲצוֹת לַֽיְלָה בָּאָה שִׁפְלוּתוֹ</tei:l>
          <tei:l>וּגְזֵרָה עוֹמֶֽדֶת לְעֻמָּתוֹ</tei:l>
          <tei:l>וַיִּבְרַח הוּא וְכׇל־אֲשֶׁר לוֹ</tei:l>
          <tei:l>בֵּ֣ית גֵּ֭אִים יִסַּ֥ח ׀ יהו֑ה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/42"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>מָחָר בִּקְשֽׁוּהוּ וְלֹא־נִמְצָא</tei:l>
          <tei:l>אַחַר אֲשֶׁר עָשָׂה כְּכׇל־אֲשֶׁר רָצָה</tei:l>
          <tei:l>וַיִּקַּח עִמּוֹ כׇּל־אֲשֶׁר מָצָא</tei:l>
          <tei:l>כֶּֽסֶף וְזָהָב אָמַר יהוה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/43"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כִּ</tei:seg>רְאוֹתָם כִּי בָרַח וְאֵינֶֽנּוּ</tei:l>
          <tei:l>וּסְפִינוֹתָיו נוֹסְעוֹת לְפָנֵֽינוּ</tei:l>
          <tei:l>וַיֵּלְכוּ וַיַּגִּֽידוּ לַאֲדוֹנֵֽנוּ</tei:l>
          <tei:l>בּאוּ וּרְאוּ אֶת־יְשׁוּעַת יהוה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/44"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">לֹ</tei:seg>א נַֽחְנוּ וְלֹא שָׁקָט לִבֵּֽנוּ</tei:l>
          <tei:l>מִפְּנֵי הַמִּלְחָמָה הַבָּאָה עָלֵֽינוּ</tei:l>
          <tei:l>כִּי שָׁמַֽעְנוּ אוֹמְרִים לָבוֹז וְלִשְׁלוֹל שְׁלָלֵנוּ</tei:l>
          <tei:l>וַיֹּאמְרוּ קֽוּמוּ כִּי נָתַן יהוה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/45"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>נוֹת בֹּֽקֶר בַּעֲלוֹת הַשַֽׁחַר</tei:l>
          <tei:l>בָּאוּ סִי׳ חְמֶד וְסִי׳ יֽוּסֶף לְפֶֽתַח הַשַֽׁעַר</tei:l>
          <tei:l>וַיִּשְׂמְחוּ בָם טַף וְזָקֵן וָנַֽעַר</tei:l>
          <tei:l>כֻּלָּם יָרֹֽנּוּ בִּגְאוֹן יהוה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/46"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וַ</tei:seg>יִּרְאוּ אֶת־אַנְשֵׁי הַמִּלְחָמָה כִּי הֵם רַבִּים</tei:l>
          <tei:l>וְהֵם כַּחֲמִשָּׁה אֶֽלֶף סוּסִים</tei:l>
          <tei:l>לְבַד מֵהַשָׂרִים וְהָרַגְלִים</tei:l>
          <tei:l>מָֽה־רַבּ֬וּ מַעֲשֶׂ֨יךָ ׀ יֽהו֔ה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/47"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נָ</tei:seg>מֵס לִבָּם וַיָּחֶרְדוּ חָרוֹד</tei:l>
          <tei:l>וַיַּעֲלוּ עַל־הַחוֹמָה וַיַּעַמְדוּ עָמוֹד</tei:l>
          <tei:l>וַיִּתְחַנְנוּ לִפְנֵיהֶם וַיִּסְגְדוּ סָגוֹד</tei:l>
          <tei:l>צָעַ֥ק לִבָּ֖ם אֶל־אֲדֹנָ֑י׃<tei:anchor xml:id="note_22"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/48"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נָֽ</tei:seg>תְנוּ אַנְשֵׁי הָעִיר קוֹלָם בִּצְעָקָה וּבְכִיָּה</tei:l>
          <tei:l>כִּי בָאָה תַּאֲנִיָּה וַאֲנִיָּה</tei:l>
          <tei:l>וְלִבָּם וְעֵינָם לָאֵל צוֹפִיָּה</tei:l>
          <tei:l>לֹ֣א יָשׁ֗וּב חֲרוֹן֙ אַף־יהו֔ה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/49"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רָ</tei:seg>אוּם בְּנֵי הַמֶּֽלֶךְ וַיְרַחֲמוּ עֲלֵיהֶם</tei:l>
          <tei:l>וַיָּבֹֽאוּ לִפְנֵי שָׂרֵי הַמִּלְחָמָה וַיִּשְׁתַּטְחוּ לִפְנֵיהֶם</tei:l>
          <tei:l>לְבִלְתִּי יִכָּנְסוּ הַחַיָּלִים אֲלֵיהֶם</tei:l>
          <tei:l>מֶ֥לֶךְ וְשָׂרִ֖ים נְאֻם־יהוֽה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/50"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וַ</tei:seg>יִּשְׁמְעוּ לָהֶם וַיִּתְּנוּ כָרוֹז</tei:l>
          <tei:l>לְבַל־יִכָּנֵס אִישׁ לִשְׁלל וְלָבוֹז</tei:l>
          <tei:l>וַיַּאֲמִֽינוּ וַיִּשְׂמְחוּ וַיַּעֲלוֹז</tei:l>
          <tei:l>כִּי גּוֹאֲלָם חָזָק יהוה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/51"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">י</tei:seg>וֹם הַשְּׁלִישִׁי בְּתִשְׁעָה וְעֶשְׂרִים</tei:l>
          <tei:l>נִכְנְסוּ סִי׳ חְמֶד וְסִי׳ יֽוּסֶף וְהַשָּׂרִים</tei:l>
          <tei:l>וַיּוֹשִֽׁיבוּ סִי׳ חְמֶד עַל־כִּסֵּא הַמְּלָכִים</tei:l>
          <tei:l>אֶת־כׇּל־אֵֽלֶּה פָּעַל יהוה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/52"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">צַ</tei:seg>עֲקַת הַשִּׂמְחָה נִשְׁמְעָה לְמֵרָחוֹק</tei:l>
          <tei:l>כִּי בָא אֵלֵֽינוּ הַמְּקַיֵּם בְּרִית וָחוֹק</tei:l>
          <tei:l>וְאַבֵּד הָאַכְזָר יִמַּח וְיִשְׁחוֹק</tei:l>
          <tei:l>כֵּ֠ן יֹאבְד֤וּ כָל־אוֹיְבֶ֙יךָ֙ יהו֔ה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/53"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>הָיָה כְּשֶֽׁבֶת סִי׳ חְמֶד עַל־כִּסֵּא מַמְלַכְתּוֹ</tei:l>
          <tei:l>וַיִּשְׁלַח וַיִּקְרָא לְכׇל־אַנְשֵׁי עֲדָתוֹ</tei:l>
          <tei:l>שְׁבוּ אִישׁ אִישׁ עַל־עֲבוֹדָתוֹ</tei:l>
          <tei:l>עֵֽינֵיכֶם֙ הָֽרֹאֹ֔ת אֶת־מַעֲשֵׂ֥ה יְהוָ֖ה׃<tei:anchor xml:id="note_27"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/54"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חַ</tei:seg>נּוּן הַנִּדְרָשׁ לְכׇל־שׁוֹאֲלוֹ</tei:l>
          <tei:l>וְלֹא־שִׁלֵּם לְאִישׁ כְּפִי פָעֲלוֹ</tei:l>
          <tei:l>וְדוֹרְשֵׁי יהוה שְׁמוֹ יְהַלְלוּ</tei:l>
          <tei:l>כִּ֤י לֹֽא־עָזַ֖בְתָּ דֹרְשֶׁ֣יךָ יהוֽה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/55"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זַ</tei:seg>ךְ וְיָשָׁר אַתָּה הֶחֱיִתָֽנוּ</tei:l>
          <tei:l>וּמִיַּד זָרִים אַכְזָרִים מְלַטְתָּֽנוּ</tei:l>
          <tei:l>שַׂ֭מְּחֵנוּ כִּימ֣וֹת עִנִּיתָ֑נוּ</tei:l>
          <tei:l>יִ֝שְׂמַ֗ח לֵ֤ב ׀ מְבַקְשֵׁ֬י יהוֽה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/56"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>רוֹב אַתָּה לְכׇל־מְבַקְשֶֽׁךָ</tei:l>
          <tei:l>וּמָצוּי לְכׇל־דּוֹרְשֶֽׁיךָ</tei:l>
          <tei:l>נָגִֽילָה וְנִשְׂמְחָה בִּישׁוּעָתֶֽךָ</tei:l>
          <tei:l>אָמֵן וְאָמֵן יֹאמַר יהוה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/57"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אִ</tei:seg>כְלוּ רֵעִים וְשִׁכְרוּ יְדִידִים</tei:l>
          <tei:l>כִּי הִצִילָֽנוּ אֱלֹהִים מִיַּד מַעֲבִידִים</tei:l>
          <tei:l>הִכָּם בְּאַף וְהִשְׁמִידֵם</tei:l>
          <tei:l>מִתַּ֖חַת שְׁמֵ֥י יהוֽה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/58"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>י הָאִישׁ צַדִּיק וִירֵא אֱלֹהִים</tei:l>
          <tei:l>לַעֲשׂוֹת יוֹם זֶה כִּימֵי הַפּוּרִים</tei:l>
          <tei:l>לָתֵת מַתָּנוֹת לַעֲנִיִּים מְרוּדִים</tei:l>
          <tei:l>לִקְרֹ֤א כֻלָּם֙ בְּשֵׁ֣ם יהו֔ה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azkir_maaseh_hashem_khalfon/59"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נַ</tei:seg>פְשֵֽׁנוּ מִיָּד צַר צוֹרֵר הָצִיל</tei:l>
          <tei:l>וְעָלֵֽינוּ לְהוֹדוֹת לְשַׁבֵּֽחַ וּלְהַלֵּל</tei:l>
          <tei:l>כִּי הוֹצִיאָֽנוּ מִיַּד עוֹבֵד אֱלִיל</tei:l>
          <tei:l>מִֽי־כָמֹ֤כָה בָּֽאֵלִם֙ יהו֔ה׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
