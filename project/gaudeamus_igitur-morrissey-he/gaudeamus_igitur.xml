    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:gaudeamus_igitur">
        <tei:head>אָז עוֹדֶֽנּוּ צְעִירִים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gaudeamus_igitur/1"/>
        <tei:lg>
          <tei:l>אָז עוֹדֶֽנּוּ צְעִירִים</tei:l>
          <tei:l>נָא נִשְׂמַח כֻּלָּֽנוּ!</tei:l>
          <tei:l>אַחֲרֵי סוֹף נְעוּרֵֽינוּ</tei:l>
          <tei:l>וְצָרוֹת בְּזִקְנוּתֵֽנוּ</tei:l>
          <tei:l>קֶֽבֶר יֹאחַז בָּֽנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gaudeamus_igitur/2"/>
        <tei:lg>
          <tei:l>מִי הוּא זֶה וְאֵי־זֶה הוּא</tei:l>
          <tei:l>הָיָה כָּאן בְּקֶֽדֶם?</tei:l>
          <tei:l>מִי עָלָה לִשְׁמֵי עֶלְיוֹן</tei:l>
          <tei:l>מִי שְׁאֹֽלָה הַתַּחְתּוֹן</tei:l>
          <tei:l>כְּבָר חַיֵּיהֶם גֶּֽדֶם!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gaudeamus_igitur/3"/>
        <tei:lg>
          <tei:l>מַה קֻּצְּרוּ יְמֵי חַיִּים,</tei:l>
          <tei:l>קָרוֹב יִגָּמֵֽרוּ!</tei:l>
          <tei:l>בִּמְהֵרָה יָבוֹא הַמָּֽוֶת</tei:l>
          <tei:l>יְבַלְּעֵנוּ כְּתִקְרֹֽבֶת</tei:l>
          <tei:l>אֵין אִישׁ יִשָּׁמֵֽרוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gaudeamus_igitur/4"/>
        <tei:lg>
          <tei:l>תְּחִי תְּחִי הַיְּשִׁיבָה</tei:l>
          <tei:l>יִחְיוּ־נָא רַבָּנֵֽינוּ!</tei:l>
          <tei:l>וְכׇל־תַּלְמִיד יְהִי בָּרוּךְ!</tei:l>
          <tei:l>יְחִי מוֹסָד זֶה בַּחִנּוּךְ!</tei:l>
          <tei:l>לָעַד יְחַנְּכֵֽנוּ!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gaudeamus_igitur/5"/>
        <tei:lg>
          <tei:l>גַּם תִּחְיֶינָה עַלְמְתִיּוֹת</tei:l>
          <tei:l>יָפוֹת וּנְעִימוֹת!</tei:l>
          <tei:l>גַּם תִּחְיֶינָה מַטְרוֹנִיּוֹת</tei:l>
          <tei:l>אֲדִיבוֹת וַחֲבִיבוֹת</tei:l>
          <tei:l>בַּעֲלוֹת שֵׁמוֹת!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gaudeamus_igitur/6"/>
        <tei:lg>
          <tei:l>תְּחִי מַלְכוּת הַצַּדִּיקִים!</tei:l>
          <tei:l>יִחְיוּ מוֹשְׁלֵי מֶמְשַׁלְתָּהּ!</tei:l>
          <tei:l>תְּחִי הָעִיר; הִיא בִּירָתֵנוּ!</tei:l>
          <tei:l>מִצְוַת צְדָקָה לְמַעֲנֵנוּ</tei:l>
          <tei:l>לִשְׁמֹר עַל־מִשְׁמַרְתָּהּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gaudeamus_igitur/7"/>
        <tei:lg>
          <tei:l>יֹאבַד צַֽעַר, יָנוּס יָגוֹן</tei:l>
          <tei:l>יִכָּרְתוּ שׂוֹנְאֵֽינוּ</tei:l>
          <tei:l>נָא יֻרְחַק יֵֽצֶר הָרַע</tei:l>
          <tei:l>עִם כׇּל־קוֹשְׁרִים עָלֵֽינוּ רַע</tei:l>
          <tei:l>וְעִם כׇּל־לוֹעֲגֵֽינוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gaudeamus_igitur/8"/>
        <tei:lg>
          <tei:l>מַה־גָּדְלוּ בְּיוֹם כָּזֶה</tei:l>
          <tei:l>הַקְהָלַת הַכּוֹלֵל!</tei:l>
          <tei:l>מִשִּׁבְעִים אֶֽרֶץ נִקְהֲלוּ</tei:l>
          <tei:l>מִיָּד עָמְדוּ, מִיָּד עָלוּ</tei:l>
          <tei:l>לוֹמַר דִּבְרֵי הַלֵּל.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gaudeamus_igitur/9"/>
        <tei:lg>
          <tei:l>יְחִי הַקָּהָל בַּתּוֹרָה</tei:l>
          <tei:l>וְכׇל־מִתְעַסְּקִים בָּהּ!</tei:l>
          <tei:l>אֱמֶת וָחֶֽסֶד נָא־יַפְרִֽיחוּ!</tei:l>
          <tei:l>רַוְחַת הָאָֽרֶץ, כֹּל יַרְבִּֽיחוּ!</tei:l>
          <tei:l>אַחְוָה וְאַהֲבָה!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gaudeamus_igitur/10"/>
        <tei:lg>
          <tei:l>יִפְרַח יְסוֹד יְשִׁיבָה זוֹ</tei:l>
          <tei:l>בְּחַצְרוֹתֶֽיהָ לָמַֽדְנוּ</tei:l>
          <tei:l>לְמַֽעַן אַחַי וְרֵעַי</tei:l>
          <tei:l>וּלְמַֽעַן כׇּל־נְפוּצוֹתַי</tei:l>
          <tei:l>לִמְקוֹמָהּ הׇאֳחַֽדְנוּ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
