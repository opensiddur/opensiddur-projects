  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:kavvanah_before_eating_or_drinking_on_yom_kippur_for_those_zilberstein">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kavvanah_before_eating_or_drinking_on_yom_kippur_for_those_zilberstein/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">חולה הצריך לאכול או לשתות ביום הכפורים,</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">טוב שיאמר לפני האכילה או השתיה הראשונה׃</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kavvanah_before_eating_or_drinking_on_yom_kippur_for_those_zilberstein/2"/>
        <tei:lg>
          <tei:l>הִנְנִי</tei:l>
          <tei:l>מוּכָן וּמְזֻמָּן</tei:l>
          <tei:l>לְקַיֵּם מִצְוַת</tei:l>
          <tei:l>אֲכִילָה וּשְׁתִיָּה בְּיוֹם הַכִּפּוּרִים,</tei:l>
          <tei:l>כְּמוֹ שֶׁכָּתַבְתָּ בְּתוֹרָתֶךָ</tei:l>
          <tei:l>”וּשְׁמַרְתֶּם אֶת־חֻקֹּתַי וְאֶת־מִשְׁפָּטַי</tei:l>
          <tei:l>אֲשֶׁר יַעֲשֶׂה אֹתָם הָאָדָם וָחַי בָּהֶם</tei:l>
          <tei:l>אֲנִי ה׳׃“ <tei:bibl>(ויקרא יח:ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kavvanah_before_eating_or_drinking_on_yom_kippur_for_those_zilberstein/3"/>
        <tei:lg>
          <tei:l>וּבִזְכוּת קִיּוּם מִצְוָה זוֹ,</tei:l>
          <tei:l>תַּחְתֹּם אוֹתִי,</tei:l>
          <tei:l>וְאֶת כׇּל חוֹלֵי עַמְּךָ יִשְׂרָאֵל</tei:l>
          <tei:l>לִרְפוּאָה שְׁלֵמָה,</tei:l>
          <tei:l>וְאֶזְכֶּה</tei:l>
          <tei:l>בְּיוֹם הַכִּפּוּרִים הַבָּא</tei:l>
          <tei:l>לְקַיֵּם שׁוּב</tei:l>
          <tei:l>”וְעִנִּיתֶם אֶת־נַפְשֹׁתֵיכֶם“ <tei:bibl>(ויקרא כג:לב)</tei:bibl></tei:l>
          <tei:l>כֵּן יְהִי רָצוֹן,</tei:l>
          <tei:l>אָמֵן.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
