  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:chad_ovadya_feigenbaum">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:chad_ovadya_feigenbaum/1"/>
        <tei:lg>
          <tei:l>חַד עוֹבַדְיָה, חַד עוֹבַדְיָה,</tei:l>
          <tei:l>דְּזַבִּין אַבָּא־מַסְטֶרָא</tei:l>
          <tei:l>בִּתְרֵי זוּזֵי —</tei:l>
          <tei:l>חַד עוֹבַדְיָה, חַד עוֹבַדְיָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:chad_ovadya_feigenbaum/2"/>
        <tei:lg>
          <tei:l>וְאָתָא בַּטְלָן</tei:l>
          <tei:l>וְאָכַל לְעוֹבַדְיָה,</tei:l>
          <tei:l>דְּזַבִּין אַבָּא־מַסְטֶרָא</tei:l>
          <tei:l>בִּתְרֵי זוּזֵי —</tei:l>
          <tei:l>חַד עוֹבַדְיָה, חַד עוֹבַדְיָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:chad_ovadya_feigenbaum/3"/>
        <tei:lg>
          <tei:l>וְאָתָא חֶנְוָנִי</tei:l>
          <tei:l>וְאָכַל לְבַטְלָן,</tei:l>
          <tei:l>דְּאָכַל לְעוֹבַדְיָה,</tei:l>
          <tei:l>דְּזַבִּין אַבָּא מַסְטֶרָא</tei:l>
          <tei:l>בִּתְרֵי זוּזֵי —</tei:l>
          <tei:l>חַד עוֹבַדְיָה, חַד עוֹבַדְיָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:chad_ovadya_feigenbaum/4"/>
        <tei:lg>
          <tei:l>וְאָתָא מַלְוֶה</tei:l>
          <tei:l>ובָלַע לְחֶנְוָנִי,</tei:l>
          <tei:l>דְּאָכַל לְבַטְלָן</tei:l>
          <tei:l>דְּאָכַל לְעוֹבַדְיָה,</tei:l>
          <tei:l>דְּזַבִּין אַבָּא־מַסְטֶרָא</tei:l>
          <tei:l>בִּתְרֵי זוּזֵי —</tei:l>
          <tei:l>חַד עוֹבַדְיָה, חַד עוֹבַדְיָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:chad_ovadya_feigenbaum/5"/>
        <tei:lg>
          <tei:l>וְאָתָא בַּנְקיִרָא</tei:l>
          <tei:l>וְאָכַל לְמַלְוֶה,</tei:l>
          <tei:l>דְבָלַע לְחֶנְוָנִי,</tei:l>
          <tei:l>דְּאָכַל לְבַטְלָן</tei:l>
          <tei:l>דְּאָכַל לְעוֹבַדְיָה,</tei:l>
          <tei:l>דְּזַבִּין אַבָּא־מַסְטֶרָא</tei:l>
          <tei:l>בִּתְרֵי זוּזֵי —</tei:l>
          <tei:l>חַד עוֹבַדְיָה, חַד עוֹבַדְיָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:chad_ovadya_feigenbaum/6"/>
        <tei:lg>
          <tei:l>וְאָתָא בַּנְקְרוּטָא</tei:l>
          <tei:l>וְהִכָּה לְבַּנְקיִרָא,</tei:l>
          <tei:l>דְּאָכַל לְמַלְוֶה,</tei:l>
          <tei:l>דְבָלַע לְחֶנְוָנִי,</tei:l>
          <tei:l>דְּאָכַל לְבַטְלָן</tei:l>
          <tei:l>דְּאָכַל לְעוֹבַדְיָה,</tei:l>
          <tei:l>דְּזַבִּין אַבָּא־מַסְטֶרָא</tei:l>
          <tei:l>בִּתְרֵי זוּזֵי —</tei:l>
          <tei:l>חַד עוֹבַדְיָה, חַד עוֹבַדְיָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:chad_ovadya_feigenbaum/7"/>
        <tei:lg>
          <tei:l>וְאָתָא קְריִזיִסָא</tei:l>
          <tei:l>וְשָׂרַף לְבַּנְקְרוּטָא,</tei:l>
          <tei:l>דְּהִכָּה לְבַּנְקיִרָא,</tei:l>
          <tei:l>דְּאָכַל לְמַלְוֶה,</tei:l>
          <tei:l>דְבָלַע לְחֶנְוָנִי,</tei:l>
          <tei:l>דְּאָכַל לְבַטְלָן</tei:l>
          <tei:l>דְּאָכַל לְעוֹבַדְיָה,</tei:l>
          <tei:l>דְּזַבִּין אַבָּא־מַסְטֶרָא</tei:l>
          <tei:l>בִּתְרֵי זוּזֵי —</tei:l>
          <tei:l>חַד עוֹבַדְיָה, חַד עוֹבַדְיָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:chad_ovadya_feigenbaum/8"/>
        <tei:lg>
          <tei:l>וְאָתָא הַרֶיווֹלוּצְיָא הַגְדוֹלָה</tei:l>
          <tei:l>וְשָׁחֲטָה לְקְריִזיִסָא,</tei:l>
          <tei:l>דְּשָׂרַף לְבַּנְקְרוּטָא,</tei:l>
          <tei:l>דְּהִכָּה לְבַּנְקיִרָא,</tei:l>
          <tei:l>דְּאָכַל לְמַלְוֶה,</tei:l>
          <tei:l>דְבָלַע לְחֶנְוָנִי,</tei:l>
          <tei:l>דְּאָכַל לְבַטְלָן</tei:l>
          <tei:l>דְּאָכַל לְעוֹבַדְיָה,</tei:l>
          <tei:l>דְּזַבִּין אַבָּא־מַסְטֶרָא</tei:l>
          <tei:l>בִּתְרֵי זוּזֵי —</tei:l>
          <tei:l>חַד עוֹבַדְיָה, חַד עוֹבַדְיָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:chad_ovadya_feigenbaum/9"/>
        <tei:lg>
          <tei:l>וְאָתָא הַסוֹצִיאַלִיזְמוּס בָּרוּךְ הוּא</tei:l>
          <tei:l>וְשָׁחַט לְרֶיווֹלוּצְיָא,</tei:l>
          <tei:l>דְּשָׁחֲטָה לְקְריִזיִסָא,</tei:l>
          <tei:l>דְּשָׂרַף לְבַּנְקְרוּטָא,</tei:l>
          <tei:l>דְּהִכָּה לְבַּנְקיִרָא,</tei:l>
          <tei:l>דְּאָכַל לְמַלְוֶה,</tei:l>
          <tei:l>דְבָלַע לְחֶנְוָנִי,</tei:l>
          <tei:l>דְּאָכַל לְבַטְלָן</tei:l>
          <tei:l>דְּאָכַל לְעוֹבַדְיָה,</tei:l>
          <tei:l>דְּזַבִּין אַבָּא־מַסְטֶרָא</tei:l>
          <tei:l>בִּתְרֵי זוּזֵי —</tei:l>
          <tei:l>חַד עוֹבַדְיָה, חַד עוֹבַדְיָה.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
