  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_hellner_eshed">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_hellner_eshed/1"/>
        <tei:lg>
          <tei:l>אֵל אֱלֹהֵי הָרוּחֹת לְכָל בָּשָׂר</tei:l>
          <tei:l>הִנֵּה אָנוּ לְפָנֶיךָ רוּחוֹת קְרוּעוֹת וְסוֹעוֹת מִצַּעַר</tei:l>
          <tei:l>חֲמֹל נָא עָלֵינוּ, בְּנֵי הָאָדָם, הַבְּרוּאִים בְּצַלְמְךָ,</tei:l>
          <tei:l>בִּפְקֹד אוֹתָנוּ עֵת שֶׁבֶר וְצָרָה,</tei:l>
          <tei:l>אֵימָה, מָוֶת וּבֶהָלָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_hellner_eshed/2"/>
        <tei:lg>
          <tei:l>יִגּוֹלּוּ נָא, אָנָּא, אָנָּא רַחֲמֵנוּ וְהָאַהֲבָה שֶׁבָּנוּ</tei:l>
          <tei:l>עַל מִדּוֹת הַדִּין, הַנְּקָמָה וְהָרֹעַ שֶׁבָּנוּ.</tei:l>
          <tei:l>שֶׁהִנֵּה בָּא הַכְּאֵב הָעַז וְהַבּוֹעֵר הַצּוֹעֵק וּמְבַקֵּשׁ נְקָמָה וְלֹא נֶחָמָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_hellner_eshed/3"/>
        <tei:lg>
          <tei:l>שִׁמְרִי עָלֵינוּ שְׁכִינַת עֻזֵּנוּ,</tei:l>
          <tei:l>עַל רוּחוֹתֵינוּ הַצְּרוּבוֹת,</tei:l>
          <tei:l>נִשְׁמוֹתֵינוּ הַמְּבֹהָלוֹת,</tei:l>
          <tei:l>עַל בְּשָׂרֵנוּ שֶׁנַּעֲשָׂה כֻּלּוֹ חִדּוּדִין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_hellner_eshed/4"/>
        <tei:lg>
          <tei:l>לְמַעַן יַעֲלֶה כַּשַּׁחַר וְיִזְרַח צֶלֶם אֱלֹהִים מִלִּבֵּנוּ הַמְּרֻסָּק.</tei:l>
          <tei:l>וְנַאֲמִין שֶׁעוֹד נִזְכֶּה וְנִרְאֶה בְּטוּב ה׳</tei:l>
          <tei:l>וְטוּב הָאָדָם בְּאֶרֶץ חַיִּים.</tei:l>
          <tei:l>אָמֵן</tei:l>
        </tei:lg>
      </tei:div>
