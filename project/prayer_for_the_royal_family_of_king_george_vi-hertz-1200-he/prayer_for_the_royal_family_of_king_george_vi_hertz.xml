    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_the_royal_family_of_king_george_vi_hertz">
        <tei:head>הַנּוֹתֵן תְּשׁוּעָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_royal_family_of_king_george_vi_hertz/2"/>
        <tei:lg>
          <tei:l>הַנּוֹתֵן תְּשׁוּעָה לַמְּלָכִים</tei:l>
          <tei:l>וּמֶמְשָׁלָה לַנְּסִיכִים</tei:l>
          <tei:l>מַלְכוּתוֹ מַלְכוּת כׇּל עוֹלָמִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_royal_family_of_king_george_vi_hertz/3"/>
        <tei:lg>
          <tei:l>הוּא יְבָרֵךְ</tei:l>
          <tei:l>אֶת אֲדוֹנֵֽינוּ הַמֶּֽלֶךְ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_royal_family_of_king_george_vi_hertz/4"/>
        <tei:lg>
          <tei:l>מֶֽלֶךְ מַלְכֵי הַמְּלָכִים</tei:l>
          <tei:l>בְּרַחֲמָיו יְחַיֵּֽיהוּ</tei:l>
          <tei:l>וְיִשְׁמְרֵֽהוּ</tei:l>
          <tei:l>וּמִכׇּל צָרָה וְיָגוֹן יַצִּילֵֽהוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_royal_family_of_king_george_vi_hertz/5"/>
        <tei:lg>
          <tei:l>וְיִתֵּן בְּלִבּוֹ</tei:l>
          <tei:l>וּבְלֵב כׇּל־יוֹעֲצַיו</tei:l>
          <tei:l>רֽוּחַ חָכְמָה וּבִינָה</tei:l>
          <tei:l>לְהַחֲזִיק שְׁלוֹם הַמַּלְכוּת</tei:l>
          <tei:l>וְשַׁלְוַת עַמּוֹ</tei:l>
          <tei:l>וְלַעֲשׂוֹת חֶֽסֶד וֶאֶמֶת עִם כׇּל יִשְׂרָאֵל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_royal_family_of_king_george_vi_hertz/6"/>
        <tei:lg>
          <tei:l>בְּיָמָיו וּבְיָמֵֽינוּ</tei:l>
          <tei:l>יִפְרֹשׂ אָבִֽינוּ שֶׁבַּשָׁמַֽיִם</tei:l>
          <tei:l>סֻכַּת שָׁלוֹם</tei:l>
          <tei:l>עַל־כׇּל־יוֹשְׁבֵי תֵבֵל</tei:l>
          <tei:l>וּבָא לְצִיּוֹן גּוֹאֵל</tei:l>
          <tei:l>וְנֺאמַר אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
