      <tei:div corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth">
        <tei:head>סֵדֶר סְפִירַת הָעֹמֶר</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/1"/>
        <tei:lg>
          <tei:l>לְשֵם יִחוּד</tei:l>
          <tei:l>קֻדְשָׁא בְּרִיךְ הוּא וּשְׁכִינְתֵּיהּ</tei:l>
          <tei:l>בִּדְחִילוּ וּרְחִימוּ,</tei:l>
          <tei:l>וּרְחִימוּ וּדְחִילוּ,</tei:l>
          <tei:l>לְיַחֵד שֵׁם יוּ״ד הֵ״א בְּוָא״ו הֵ״א</tei:l>
          <tei:l>בְּיִחוּדָא שְׁלִים</tei:l>
          <tei:l>בְּשֵׁם כָּל יִשְׂרָאֵל.‏</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/2"/>
        <tei:lg>
          <tei:l>הִנְנִי מוּכָן וּמְזוּמָן</tei:l>
          <tei:l>לְקַיֵים מִצְוַת עֲשֵׂה שֶׁל סְפִירַת הָעֽוֹמֶר,</tei:l>
          <tei:l>כְּמוֹ שֶׁכָּתוּב בַתּוֹרָה:‏</tei:l>
          <tei:l>וּסְפַרְתֶּ֤ם לָכֶם֙ מִמָּחֳרַ֣ת הַשַּׁבָּ֔ת</tei:l>
          <tei:l>מִיּוֹם֙ הֲבִ֣יאֲכֶ֔ם אֶת־עֹ֖מֶר הַתְּנוּפָ֑ה</tei:l>
          <tei:l>שֶׁ֥בַע שַׁבָּת֖וֹת תְּמִימֹ֥ת תִּהְיֶֽינָה׃‏‏‏</tei:l>
          <tei:l>עַ֣ד מִֽמָּחֳרַ֤ת הַשַּׁבָּת֙ הַשְּׁבִיעִ֔ת</tei:l>
          <tei:l>תִּסְפְּר֖וּ חֲמִשִּׁ֣ים י֑וֹם</tei:l>
          <tei:l>וְהִקְרַבְתֶּ֛ם מִנְחָ֥ה חֲדָשָׁ֖ה לַיהֹוָֽה׃‏ <tei:bibl>(ויקרא כג:טו-טז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/3"/>
        <tei:lg>
          <tei:l>וִיהִ֤י ׀ נֹ֤עַם אֲדֹנָ֥י אֱלֹהֵ֗ינוּ עָ֫לֵ֥ינוּ</tei:l>
          <tei:l>וּמַעֲשֵׂ֣ה יָ֭דֵינוּ כּוֹנְנָ֥ה עָלֵ֑ינוּ</tei:l>
          <tei:l>וּֽמַעֲשֵׂ֥ה יָ֝דֵ֗ינוּ כּוֹנְנֵֽהוּ׃ <tei:bibl>(תהילים צ:יז)</tei:bibl>‏</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/4"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>אֲשֶׁר קִדְּשָֽׁנוּ בְּמִצְוֺתָיו</tei:l>
          <tei:l>וְצִוָּֽנוּ עַל סְפִירַת הָעֹֽמֶר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/6"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">ט״ז ניסן:</tei:note> הַיּוֹם יוֹם אֶחָד לָעֹמֶר׃ (חֶסֶד שֶׁבְּחֶסֶד)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/7"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">י״ז ניסן:</tei:note> הַיּוֹם שְׁנֵי יָמִים לָעֹמֶר׃ (גְּבוּרָה שֶׁבְּחֶסֶד)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/8"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">י״ח ניסן:</tei:note> הַיּוֹם שְׁלֹשָׁה יָמִים לָעֹמֶר׃ (תִּפְאֶרֶת שֶׁבְּחֶסֶד)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/9"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">י״ט ניסן:</tei:note> הַיּוֹם אַרְבָּעָה יָמִים לָעֹמֶר׃ (נֶצַח שֶׁבְּחֶסֶד)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/10"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">כ׳ ניסן:</tei:note> הַיּוֹם חֲמִשָּׁה יָמִים לָעֹמֶר׃ (הוֹד שֶׁבְּחֶסֶד)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/11"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">כ״א ניסן:</tei:note> הַיּוֹם שִׁשָּׁה יָמִים לָעֹמֶר׃ (יְסוֹד שֶׁבְּחֶסֶד)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/12"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">כ״ב ניסן:</tei:note> הַיּוֹם שִׁבְעָה יָמִים, שֶׁהֵם שָׁבוּעַ אֶחָד לָעֹמֶר׃ (מַלְכוּת שֶׁבְּחֶסֶד)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/13"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">כ״ג ניסן:</tei:note> הַיּוֹם שְׁמוֹנָה יָמִים, שֶׁהֵם שָׁבוּעַ אֶחָד וְיוֹם אֶחָד לָעֹמֶר׃ (חֶסֶד שֶׁבִּגְּבוּרָה)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/14"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">כ״ד ניסן:</tei:note> הַיּוֹם תִּשְׁעָה יָמִים, שֶׁהֵם שָׁבוּעַ אֶחָד וּשְׁנֵי יָמִים לָעֹמֶר׃ (גְּבוּרָה שֶׁבִּגְּבוּרָה)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/15"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">כ״ה ניסן:</tei:note> הַיּוֹם עֲשָׂרָה יָמִים, שֶׁהֵם שָׁבוּעַ אֶחָד וּשְׁלֹשָׁה יָמִים לָעֹמֶר׃ (תִּפְאֶרֶת שֶׁבִּגְּבוּרָה)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/16"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">כ״ו ניסן:</tei:note> הַיּוֹם אַחַד עָשָׂר יוֹם, שֶׁהֵם שָׁבוּעַ אֶחָד וְאַרְבָּעָה יָמִים לָעֹמֶר׃ (נֶצַח שֶׁבִּגְּבוּרָה)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/17"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">כ״ז ניסן:</tei:note> הַיּוֹם שְׁנֵים עָשָׂר יוֹם, שֶׁהֵם שָׁבוּעַ אֶחָד וַחֲמִשָּׁה יָמִים לָעֹמֶר׃ (הוֹד שֶׁבִּגְּבוּרָה)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/18"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">כ״ח ניסן:</tei:note> הַיּוֹם שְׁלֹשָׁה עָשָׂר יוֹם, שֶׁהֵם שָׁבוּעַ אֶחָד וְשִׁשָּׁה יָמִים לָעֹמֶר׃ (יְסוֹד שֶׁבִּגְּבוּרָה)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/19"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">כ״ט ניסן:</tei:note> הַיּוֹם אַרְבָּעָה עָשָׂר יוֹם, שֶׁהֵם שְׁנֵי שָׁבוּעוֹת לָעֹמֶר׃ (מַלְכוּת שֶׁבִּגְּבוּרָה)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/20"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">ל׳ ניסן:</tei:note> הַיּוֹם חֲמִשָּׁה עָשָׂר יוֹם, שֶׁהֵם שְׁנֵי שָׁבוּעוֹת וְיוֹם אֶחָד לָעֹמֶר׃ (חֶסֶד שֶׁבְּתִּפְאֶרֶת)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/21"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">א׳ אייר:</tei:note> הַיּוֹם שִׁשָּׁה עָשָׂר יוֹם, שֶׁהֵם שְׁנֵי שָׁבוּעוֹת וּשְׁנֵי יָמִים לָעֹמֶר׃ (גְּבוּרָה שֶׁבְּתִּפְאֶרֶת)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/22"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">ב׳ אייר:</tei:note> הַיּוֹם שִׁבְעָה עָשָׂר יוֹם, שֶׁהֵם שְׁנֵי שָׁבוּעוֹת וּשְׁלֹשָׁה יָמִים לָעֹמֶר׃ (תִּפְאֶרֶת שֶׁבְּתִּפְאֶרֶת)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/23"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">ג׳ אייר:</tei:note> הַיּוֹם שְׁמוֹנָה עָשָׂר יוֹם, שֶׁהֵם שְׁנֵי שָׁבוּעוֹת וְאַרְבָּעָה יָמִים לָעֹמֶר׃ (נֶצַח שֶׁבְּתִּפְאֶרֶת)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/24"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">ד׳ אייר:</tei:note> הַיּוֹם תִּשְׁעָה עָשָׂר יוֹם, שֶׁהֵם שְׁנֵי שָׁבוּעוֹת וַחֲמִשָּׁה יָמִים לָעֹמֶר׃ (הוֹד שֶׁבְּתִּפְאֶרֶת)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/25"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">ה׳ אייר:</tei:note> הַיּוֹם עֶשְׂרִים יוֹם, שֶׁהֵם שְׁנֵי שָׁבוּעוֹת וְשִׁשָּׁה יָמִים לָעֹמֶר׃ (יְסוֹד שֶׁבְּתִּפְאֶרֶת)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/26"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">ו׳ אייר:</tei:note> הַיּוֹם אֶחָד וְעֶשְׂרִים יוֹם, שֶׁהֵם שְׁלֹשָׁה שָׁבוּעוֹת לָעֹמֶר׃ (מַלְכוּת שֶׁבְּתִּפְאֶרֶת)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/27"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">ז׳ אייר:</tei:note> הַיּוֹם שְׁנַֽיִם וְעֶשְׂרִים יוֹם, שֶׁהֵם שְׁלֹשָׁה שָׁבוּעוֹת וְיוֹם אֶחָד לָעֹמֶר׃ (חֶסֶד שֶׁבְּנֶצַח)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/28"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">ח׳ אייר:</tei:note> הַיּוֹם שְׁלֹשָׁה וְעֶשְׂרִים יוֹם, שֶׁהֵם שְׁלֹשָׁה שָׁבוּעוֹת וּשְׁנֵי יָמִים לָעֹמֶר׃ (גְּבוּרָה שֶׁבְּנֶצַח)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/29"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">ט׳ אייר:</tei:note> הַיּוֹם אַרְבָּעָה וְעֶשְׂרִים יוֹם, שֶׁהֵם שְׁלֹשָׁה שָׁבוּעוֹת וּשְׁלֹשָׁה יָמִים לָעֹמֶר׃ (תִּפְאֶרֶת שֶׁבְּנֶצַח)</tei:l>
        </tei:lg>
