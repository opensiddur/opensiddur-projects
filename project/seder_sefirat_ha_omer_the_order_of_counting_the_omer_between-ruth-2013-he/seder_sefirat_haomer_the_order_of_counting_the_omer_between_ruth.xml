          <tei:l><tei:hi rend="superscript">ו</tei:hi> יוֹד֖וּךָ עַמִּ֥ים ׀ אֱלֹהִ֑ים</tei:l>
          <tei:l>י֝וֹד֗וּךָ עַמִּ֥ים כֻּלָּֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/63"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ז</tei:hi> אֶ֭רֶץ נָתְנָ֣ה יְבוּלָ֑הּ</tei:l>
          <tei:l>יְ֝בָרְכֵ֗נוּ אֱלֹהִ֥ים אֱלֹהֵֽינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/64"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ח</tei:hi> יְבָרְכֵ֥נוּ אֱלֹהִ֑ים</tei:l>
          <tei:l>וְיִֽירְא֥וּ אֹ֝ת֗וֹ כָּל־אַפְסֵי־אָֽרֶץ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/65"/>
        <tei:lg>
          <tei:l>Yeriḥo as a seven walled Cretan labyrinth. (Farḥi Bible by Elisha ben Avraham Crescas, 14th c.)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/66"/>
        <tei:lg>
          <tei:l>אָנָּא בְּכֹחַ גְּדֻלַּת יְמִינְךָ</tei:l>
          <tei:l>תַּתִּיר צְרוּרָה</tei:l>
          <tei:l>(אב״ג ית״ץ)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/67"/>
        <tei:lg>
          <tei:l>קַבֵּל רִנַּת עַמְּךָ</tei:l>
          <tei:l>שַׂגְּבֵנוּ טַהֲרֵנוּ נוֹרָא</tei:l>
          <tei:l>(קר״ע שט״ן)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/68"/>
        <tei:lg>
          <tei:l>נָא גִבּוֹר</tei:l>
          <tei:l>דּוֹרְשֵׁי יִחוּדְךָ</tei:l>
          <tei:l>כְּבָבַת שָׁמְרֵם</tei:l>
          <tei:l>(נג״ד יכ״ש)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/69"/>
        <tei:lg>
          <tei:l>בָּרְכֵם טַהֲרֵם</tei:l>
          <tei:l>רַחֲמֵי צִדְקָתְךָ</tei:l>
          <tei:l>תָּמִיד גָּמְלֵם</tei:l>
          <tei:l>(בט״ר צת״ג)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/70"/>
        <tei:lg>
          <tei:l>חָסִין קָדוֹשׁ</tei:l>
          <tei:l>בְּרֹב טוּבְךָ</tei:l>
          <tei:l>נַהֵל עֲדָתֶךָ</tei:l>
          <tei:l>(חק״ב טנ״ע)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/71"/>
        <tei:lg>
          <tei:l>יָחִיד גֵּאֶה</tei:l>
          <tei:l>לְעַמְּךָ פְּנֵה</tei:l>
          <tei:l>זוֹכְרֵי קְדֻשָּׁתֶךָ</tei:l>
          <tei:l>(יג״ל פז״ק)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/72"/>
        <tei:lg>
          <tei:l>שַׁוְעָתֵנוּ קַבֵּל</tei:l>
          <tei:l>וּשְׁמַע צַעֲקָתֵנוּ</tei:l>
          <tei:l>יוֹדֵעַ תַּעֲלוּמוֹת</tei:l>
          <tei:l>(שק״ו צי״ת)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/73"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">בלחש:</tei:note>
          </tei:l>
          <tei:l>בָּרוּךְ שֵׁם</tei:l>
          <tei:l>כְּבוֹד מַלְכוּתוֹ</tei:l>
          <tei:l>לְעוֹלָם וָעֶד:‏</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/75"/>
        <tei:lg>
          <tei:l>רִבּוֹנוֹ שֶׁל עוֹלָם,‏</tei:l>
          <tei:l>אַתָּה צִוִּיתָנוּ עַל יְדֵי משֶׁה עַבְדֶּךָ</tei:l>
          <tei:l>לִסְפּוֹר סְפִירַת הָעוֹמֶר</tei:l>
          <tei:l>כְּדֵי לְטַהֲרֵנוּ</tei:l>
          <tei:l>מִקְלִפּוֹתֵינוּ וּמִטֻמְאוֹתֵינוּ,‏</tei:l>
          <tei:l>כְּמוֹ שֶׁכָּתַבְתָּ בְּתוֹרָתֶךָ:‏</tei:l>
          <tei:l>וּסְפַרְתֶּ֤ם לָכֶם֙ מִמָּחֳרַ֣ת הַשַּׁבָּ֔ת</tei:l>
          <tei:l>מִיֹּום֙ הֲבִ֣יאֲכֶ֔ם אֶת־עֹ֖מֶר הַתְּנוּפָ֑ה</tei:l>
          <tei:l>שֶׁ֥בַע שַׁבָּת֖וֹת תְּמִימֹ֥ת תִּהְיֶֽינָה׃</tei:l>
          <tei:l>עַ֣ד מִֽמָּחֳרַ֤ת הַשַּׁבָּת֙ הַשְּׁבִיעִ֔ת</tei:l>
          <tei:l>תִּסְפְּר֖וּ חֲמִשִּׁ֣ים י֑וֺם <tei:bibl>(ויקרא כג:טו-טז חלק)</tei:bibl> ‏</tei:l>
          <tei:l>כְּדֵי שֶׁיִּטָּהֲרוּ נַפְשׁוֹת עַמְּךָ יִשְׂרָאֵל מִזֻּהֲמָתָם,‏</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/76"/>
        <tei:lg>
          <tei:l>וּבְכֵן יְהִי רָצוֹן מִלְּפָנֶיךָ יְיָ אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ,‏</tei:l>
          <tei:l>שֶׁבִּזְכוּת סְפִירַת הָעוֹמֶר שֶׁסָּפַרְתִּי הַיּוֹם,‏</tei:l>
          <tei:l>יְתֻקַּן מַה שֶׁפָּגַמְתִּי בִּסְפִירָה</tei:l>
          <tei:l>
            <tei:note type="instruction">(...)</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:seder_sefirat_haomer_the_order_of_counting_the_omer_between_ruth/77"/>
        <tei:lg>
          <tei:l>וְאֶטָּהֵר וְאֶתְקַדֵּשׁ בִּקְדֻשָּׁה שֶׁל מַעְלָה,‏</tei:l>
          <tei:l>וְעַל יְדֵי זֶה יֻשְׁפַּע שֶׁפַע רַב בְּכָל הָעוֹלָמוֹת</tei:l>
          <tei:l>וּלְתַקֵּן אֶת נַפְשׁוֹתֵינוּ וְרוּחוֹתֵינוּ וְנִשְׁמוֹתֵינוּ מִכָּל סִיג וּפְגַם,‏</tei:l>
          <tei:l>וּלְטַהֲרֵנוּ וּלְקַדְּשֵׁנוּ בִּקְדֻשָׁתְךָ הָעֶלְיוֹנָה,‏</tei:l>
          <tei:l>אָמֵן סֶלָה:‏</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>