  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:an_ticcen_an_old_english_translation_of_had_gadya">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:an_ticcen_an_old_english_translation_of_had_gadya/1"/>
        <tei:lg xml:lang="ang">
          <tei:l>ɑːn ˈtitt͡ʃen | ɑːn ˈtitt͡ʃen</tei:l>
          <tei:l>θe ˈboxte hit miːn ˈfæder</tei:l>
          <tei:l>wið twɑːm ˈʃiɫɫiŋɡum</tei:l>
          <tei:l>ɑːn ˈtitt͡ʃen | ɑːn ˈtitt͡ʃen</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:an_ticcen_an_old_english_translation_of_had_gadya/2"/>
        <tei:lg xml:lang="ang">
          <tei:l>ond koːm seː kɑtː</tei:l>
          <tei:l>ond æːt θæt ˈtitt͡ʃen</tei:l>
          <tei:l>θe ˈboxte hit miːn ˈfæder</tei:l>
          <tei:l>wið twɑːm ˈʃiɫɫiŋɡum</tei:l>
          <tei:l>ɑːn ˈtitt͡ʃen | ɑːn ˈtitt͡ʃen</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:an_ticcen_an_old_english_translation_of_had_gadya/3"/>
        <tei:lg xml:lang="ang">
          <tei:l>ond koːm seː hund</tei:l>
          <tei:l>ond bɑːt ˈθone kɑtː</tei:l>
          <tei:l>θe æːt θæt ˈtitt͡ʃen</tei:l>
          <tei:l>θe ˈboxte hit miːn ˈfæder</tei:l>
          <tei:l>wið twɑːm ˈʃiɫɫiŋɡum</tei:l>
          <tei:l>ɑːn ˈtitt͡ʃen | ɑːn ˈtitt͡ʃen</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:an_ticcen_an_old_english_translation_of_had_gadya/4"/>
        <tei:lg xml:lang="ang">
          <tei:l>ond koːm seː stæf</tei:l>
          <tei:l>ond sloːx ˈθone hund</tei:l>
          <tei:l>θe bɑːt ˈθone kɑtː</tei:l>
          <tei:l>θe æːt θæt ˈtitt͡ʃen</tei:l>
          <tei:l>θe ˈboxte hit miːn ˈfæder</tei:l>
          <tei:l>wið twɑːm ˈʃiɫɫiŋɡum</tei:l>
          <tei:l>ɑːn ˈtitt͡ʃen | ɑːn ˈtitt͡ʃen</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:an_ticcen_an_old_english_translation_of_had_gadya/5"/>
        <tei:lg xml:lang="ang">
          <tei:l>ond koːm θæt fyːr</tei:l>
          <tei:l>ond ˈbærɣnde ˈθone stæf</tei:l>
          <tei:l>θe sloːx ˈθone hund</tei:l>
          <tei:l>θe bɑːt ˈθone kɑtː</tei:l>
          <tei:l>θe æːt θæt ˈtitt͡ʃen</tei:l>
          <tei:l>θe ˈboxte hit miːn ˈfæder</tei:l>
          <tei:l>wið twɑːm ˈʃiɫɫiŋɡum</tei:l>
          <tei:l>ɑːn ˈtitt͡ʃen | ɑːn ˈtitt͡ʃen</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:an_ticcen_an_old_english_translation_of_had_gadya/6"/>
        <tei:lg xml:lang="ang">
          <tei:l>ond koːm θæt ˈwæter</tei:l>
          <tei:l>ond ˈkwenkte θæt fyːr</tei:l>
          <tei:l>θe ˈbærɣnde ˈθone stæf</tei:l>
          <tei:l>θe sloːx ˈθone hund</tei:l>
          <tei:l>θe bɑːt ˈθone kɑtː</tei:l>
          <tei:l>θe æːt θæt ˈtitt͡ʃen</tei:l>
          <tei:l>θe ˈboxte hit miːn ˈfæder</tei:l>
          <tei:l>wið twɑːm ˈʃiɫɫiŋɡum</tei:l>
          <tei:l>ɑːn ˈtitt͡ʃen | ɑːn ˈtitt͡ʃen</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:an_ticcen_an_old_english_translation_of_had_gadya/7"/>
        <tei:lg xml:lang="ang">
          <tei:l>ond koːm θæt ˈr̥iːðer</tei:l>
          <tei:l>ond drɒŋk θæt ˈwæter</tei:l>
          <tei:l>θe ˈkwenkte θæt fyːr</tei:l>
          <tei:l>θe ˈbærɣnde ˈθone stæf</tei:l>
          <tei:l>θe sloːx ˈθone hund</tei:l>
          <tei:l>θe bɑːt ˈθone kɑtː</tei:l>
          <tei:l>θe æːt θæt ˈtitt͡ʃen</tei:l>
          <tei:l>θe ˈboxte hit miːn ˈfæder</tei:l>
          <tei:l>wið twɑːm ˈʃiɫɫiŋɡum</tei:l>
          <tei:l>ɑːn ˈtitt͡ʃen | ɑːn ˈtitt͡ʃen</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:an_ticcen_an_old_english_translation_of_had_gadya/8"/>
        <tei:lg xml:lang="ang">
          <tei:l>ond koːm seː ˈflæːʃˌmɑŋɡere</tei:l>
          <tei:l>ond ofˈsnɑːð θæt ˈr̥iːðer</tei:l>
          <tei:l>θe drɒŋk θæt ˈwæter</tei:l>
          <tei:l>θe ˈkwenkte θæt fyːr</tei:l>
          <tei:l>θe ˈbærɣnde ˈθone stæf</tei:l>
          <tei:l>θe sloːx ˈθone hund</tei:l>
          <tei:l>θe bɑːt ˈθone kɑtː</tei:l>
          <tei:l>θe æːt θæt ˈtitt͡ʃen</tei:l>
          <tei:l>θe ˈboxte hit miːn ˈfæder</tei:l>
          <tei:l>wið twɑːm ˈʃiɫɫiŋɡum</tei:l>
          <tei:l>ɑːn ˈtitt͡ʃen | ɑːn ˈtitt͡ʃen</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:an_ticcen_an_old_english_translation_of_had_gadya/9"/>
        <tei:lg xml:lang="ang">
          <tei:l>ond koːm seː ˈæːrendˌɡɑːst ˈdæ͜ɑːðes</tei:l>
          <tei:l>ond ofˈsnɑːð ˈθone ˈflæːʃˌmɑŋɡere</tei:l>
          <tei:l>θe ofˈsnɑːð θæt ˈr̥iːðer</tei:l>
          <tei:l>θe drɒŋk θæt ˈwæter</tei:l>
          <tei:l>θe ˈkwenkte θæt fyːr</tei:l>
          <tei:l>θe ˈbærɣnde ˈθone stæf</tei:l>
          <tei:l>θe sloːx ˈθone hund</tei:l>
          <tei:l>θe bɑːt ˈθone kɑtː</tei:l>
          <tei:l>θe æːt θæt ˈtitt͡ʃen</tei:l>
          <tei:l>θe ˈboxte hit miːn ˈfæder</tei:l>
          <tei:l>wið twɑːm ˈʃiɫɫiŋɡum</tei:l>
          <tei:l>ɑːn ˈtitt͡ʃen | ɑːn ˈtitt͡ʃen</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:an_ticcen_an_old_english_translation_of_had_gadya/10"/>
        <tei:lg xml:lang="ang">
          <tei:l>ond koːm seː ˈhɑːɫ.ɣɑ ɡod</tei:l>
          <tei:l>ond ofˈsnɑːð ˈθone ˈæːrendˌɡɑːst ˈdæ͜ɑːðes</tei:l>
          <tei:l>θe ofˈsnɑːð ˈθone ˈflæːʃˌmɑŋɡere</tei:l>
          <tei:l>θe ofˈsnɑːð θæt ˈr̥iːðer</tei:l>
          <tei:l>θe drɒŋk θæt ˈwæter</tei:l>
          <tei:l>θe ˈkwenkte θæt fyːr</tei:l>
          <tei:l>θe ˈbærɣnde ˈθone stæf</tei:l>
          <tei:l>θe sloːx ˈθone hund</tei:l>
          <tei:l>θe bɑːt ˈθone kɑtː</tei:l>
          <tei:l>θe æːt θæt ˈtitt͡ʃen</tei:l>
          <tei:l>θe ˈboxte hit miːn ˈfæder</tei:l>
          <tei:l>wið twɑːm ˈʃiɫɫiŋɡum</tei:l>
          <tei:l>ɑːn ˈtitt͡ʃen | ɑːn ˈtitt͡ʃen</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
