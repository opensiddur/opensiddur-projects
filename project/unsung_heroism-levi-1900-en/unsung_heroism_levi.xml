  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:unsung_heroism_levi">
        <tei:head>Unsung Heroism, a poem by Annie Josephine Levi (1900)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:unsung_heroism_levi/1"/>
        <tei:lg>
          <tei:l>Unsung Heroism</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:unsung_heroism_levi/2"/>
        <tei:lg>
          <tei:l>To smile when the heart is breaking,</tei:l>
          <tei:l>Concealing inward pain,</tei:l>
          <tei:l>To plod in the thorny pathways</tei:l>
          <tei:l>Through sun and mist and rain;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:unsung_heroism_levi/3"/>
        <tei:lg>
          <tei:l>To lighten a comrade’s burden</tei:l>
          <tei:l>By whisp’ring words of cheer,</tei:l>
          <tei:l>Dispersing the clouds of sorrow</tei:l>
          <tei:l>That heaven may appear;</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:unsung_heroism_levi/4"/>
        <tei:lg>
          <tei:l>To learn to be self-denying,</tei:l>
          <tei:l>Unwilling to repine,</tei:l>
          <tei:l>The soul ever upwards striving,</tei:l>
          <tei:l>To win the peace divine;—</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:unsung_heroism_levi/5"/>
        <tei:lg>
          <tei:l>These noble earthly struggles</tei:l>
          <tei:l>With glory shall adorn</tei:l>
          <tei:l>Their heroes—bequeathing mem’ries</tei:l>
          <tei:l>To races yet unborn.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
