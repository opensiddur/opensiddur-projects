  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd_27900">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd_27900/1"/>
        <tei:lg>
          <tei:l>ወጾሩ ፡ ታቦቶሙ፤</tei:l>
          <tei:l>ሚካኤል ፡ ምርሖሙ ።</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd_27900/2"/>
        <tei:lg>
          <tei:l>አርብዓ ፡ ዓመቱ ፡ በገዳም፤</tei:l>
          <tei:l>ሚካኤል ፡ ምርሖሙ ።</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd_27900/3"/>
        <tei:lg>
          <tei:l>መዓልተ ፡ በደመና፤</tei:l>
          <tei:l>ሚካኤል ፡ ምርሖሙ ።</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd_27900/4"/>
        <tei:lg>
          <tei:l>ወሌሊተኒ ፡ በዐምደ ፡ እሳት፤</tei:l>
          <tei:l>ሚካኤል ፡ ምርሖሙ ።</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd_27900/5"/>
        <tei:lg>
          <tei:l>አርባዕቱ ፡ መቃን ፡ እምኣፍኣ ፡ ለጽዮን ።</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd_27900/6"/>
        <tei:lg>
          <tei:l>ተንሥኢ ፡ ጽዮን፤</tei:l>
          <tei:l>ልበሲ ፡ ኅይለ ፡ መዝራዕተኪ ።</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayers_for_the_morning_of_sigd_27900/7"/>
        <tei:lg>
          <tei:l>ተንሥኢ ፡ ጽዮን፤</tei:l>
          <tei:l>አስተጋብኢ ፡ ዝሩዕ ፡ ሕዝብኪ ።</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
