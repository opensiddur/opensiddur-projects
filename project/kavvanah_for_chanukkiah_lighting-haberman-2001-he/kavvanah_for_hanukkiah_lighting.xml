    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:kavvanah_for_hanukkiah_lighting">
        <tei:head>כַּוָּנָה לְהַדְלָקַת נֵרוֹת חֲנֻכָּה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kavvanah_for_hanukkiah_lighting/1"/>
        <tei:lg>
          <tei:l>כַּוָּנָה לְהַדְלָקַת נֵרוֹת חֲנֻכָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kavvanah_for_hanukkiah_lighting/9"/>
        <tei:lg>
          <tei:l>יוֹצְרוֹת אוֹר וּבֹרֵאת חֹשֶׁךְ</tei:l>
          <tei:l>עוֹשֶׂה שָׁלוֹם וּבֹרֵאת אֶת הָרַע.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kavvanah_for_hanukkiah_lighting/10"/>
        <tei:lg>
          <tei:l>בְּרוּכָה שְׁכִינָה</tei:l>
          <tei:l>שִׁכְנֵי בְּתוֹכֵנוּ בִּקְדֻשָּׁה</tei:l>
          <tei:l>כְּשֶׁנֵּרוֹת הַחֲנֻכָּה שֶׁלָּנוּ דּוֹלְקִים</tei:l>
          <tei:l>וּבְכָל עֵת וּבְכָל שָׁעָה בִּשְׁלוֹמך</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kavvanah_for_hanukkiah_lighting/11"/>
        <tei:lg>
          <tei:l>אָמֵן.</tei:l>
          <tei:l>כֵּן יְהִי רָצוֹן.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
