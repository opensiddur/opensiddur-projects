  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:shokhen_ad">
        <tei:head>שׁוֹכֵן עַד</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shokhen_ad/1"/>
        <tei:lg>
          <tei:l>שׁוֹכֵן עַד מָּרוֹם וְקָּדוֹשׁ שְׁמוֹ.</tei:l>
          <tei:l>וְכָתוּב: רַנְּנוּ צַדִּיקִים בַּיהוה,</tei:l>
          <tei:l>לַיְשָׁרִים נָאוָה תְהִלָּה. <tei:bibl>(תהלים לג:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shokhen_ad/2"/>
        <tei:lg>
          <tei:l>בְּפִי <tei:seg type="acrostic">יְ</tei:seg>שָׁרִים תִּתְהַלָּל</tei:l>
          <tei:l>וּבְשִׂפְתֵי <tei:seg type="acrostic">צַ</tei:seg>דִּיקִים תִּתְבָּרַךְ</tei:l>
          <tei:l>וּבִלְשׁוֹן <tei:seg type="acrostic">חֲ</tei:seg>סִידִים תִּתְרוֹמָם</tei:l>
          <tei:l>וּבְקֶרֶב <tei:seg type="acrostic">קְ</tei:seg>דוֹשִׁים תִּתְקַדָּשׁ</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
