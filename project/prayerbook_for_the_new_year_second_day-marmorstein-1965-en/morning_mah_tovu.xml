        <tei:div facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n26.jpg">
          <tei:pb ed="1965" n="2" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n26.jpg"/>
          <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/day_two/morning_occurrences/morning_mah_tovu/quote/prayer/mah_tovu/mah_tovu" source="urn:x-opensiddur:text:prayer:mah_tovu/mah_tovu"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n26.jpg" n="2"/><tei:milestone unit="chapter" n="24" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/day_two/morning_occurrences/morning_mah_tovu/quote/prayer/mah_tovu/mah_tovu/quotation/numbers/24"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n26.jpg" n="2"/><tei:milestone unit="verse" n="5" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/day_two/morning_occurrences/morning_mah_tovu/quote/prayer/mah_tovu/mah_tovu/quotation/numbers/24/5"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n26.jpg" n="2"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/24/5">How becoming are your tents, O Jacob, your dwellings, O Israel.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/day_two/morning_occurrences/morning_mah_tovu/quote/prayer/mah_tovu/varani" source="urn:x-opensiddur:text:prayer:mah_tovu/varani"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n26.jpg" n="2"/><tei:milestone unit="chapter" n="5" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/day_two/morning_occurrences/morning_mah_tovu/quote/prayer/mah_tovu/varani/quotation/psalms/5"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n26.jpg" n="2"/><tei:milestone unit="verse" n="8" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/day_two/morning_occurrences/morning_mah_tovu/quote/prayer/mah_tovu/varani/quotation/psalms/5/8"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n26.jpg" n="2"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/5/8">And I through the abundance of Thy grace enter Thy house and bow down before Thy holy place in awe of Thee.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="chapter" n="26" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/day_two/morning_occurrences/morning_mah_tovu/quotation/psalms/26"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n26.jpg" n="2"/><tei:milestone unit="verse" n="8" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/day_two/morning_occurrences/morning_mah_tovu/quotation/psalms/26/8"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n26.jpg" n="2"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/26/8">O Lord, I love the site of Thy house, the place of the dwelling of Thy glory.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="chapter" n="95" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/day_two/morning_occurrences/morning_mah_tovu/quotation/psalms/95"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n26.jpg" n="2"/><tei:milestone unit="verse" n="6" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/day_two/morning_occurrences/morning_mah_tovu/quotation/psalms/95/6"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n26.jpg" n="2"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/95/6" type="adaptation">I bow, throw myself down and kneel before the Lord, my Maker.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="chapter" n="69" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/day_two/morning_occurrences/morning_mah_tovu/quotation/psalms/69"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n26.jpg" n="2"/><tei:milestone unit="verse" n="14" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/day_two/morning_occurrences/morning_mah_tovu/quotation/psalms/69/14"/><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-sheni-shel-rosh-hashanah-day-two-jenny-marmorstein-1965/page/n26.jpg" n="2"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/69/14">And as for me, my prayer is to Thee, O Lord, at a time of favour. O God, in the abundance of Thy grace respond to me with the truth of Thy salvation.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
        </tei:div>
