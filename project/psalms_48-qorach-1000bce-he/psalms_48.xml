    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/48">
        <tei:head>תהלים מ״ח</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/48/1-15"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">א</tei:hi> <tei:note type="instruction">שִׁ֥יר מִ֝זְמוֹר לִבְנֵי־קֹֽרַח׃</tei:note></tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ב</tei:hi> גָּ֘ד֤וֹל יְהוָ֣ה</tei:l>
          <tei:l>וּמְהֻלָּ֣ל מְאֹ֑ד בְּעִ֥יר אֱ֝לֹהֵ֗ינוּ</tei:l>
          <tei:l>הַר־קָדְשֽׁוֹ׃</tei:l>
          <tei:l><tei:hi rend="superscript">ג</tei:hi> יְפֵ֥ה נוֹף֮</tei:l>
          <tei:l>מְשׂ֪וֹשׂ כָּל־הָ֫אָ֥רֶץ</tei:l>
          <tei:l>הַר־צִ֭יּוֹן</tei:l>
          <tei:l>יַרְכְּתֵ֣י צָפ֑וֹן</tei:l>
          <tei:l>קִ֝רְיַ֗ת מֶ֣לֶךְ רָֽב׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ד</tei:hi> אֱלֹהִ֥ים בְּאַרְמְנוֹתֶ֗יהָ נוֹדַ֥ע</tei:l>
          <tei:l>לְמִשְׂגָּֽב׃</tei:l>
          <tei:l><tei:hi rend="superscript">ה</tei:hi> כִּֽי־הִנֵּ֣ה הַ֭מְּלָכִים נֽוֹעֲד֑וּ</tei:l>
          <tei:l>עָבְר֥וּ יַחְדָּֽו׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ו</tei:hi> הֵ֣מָּה רָ֭אוּ כֵּ֣ן תָּמָ֑הוּ</tei:l>
          <tei:l>נִבְהֲל֥וּ נֶחְפָּֽזוּ׃</tei:l>
          <tei:l><tei:hi rend="superscript">ז</tei:hi> רְ֭עָדָה</tei:l>
          <tei:l>אֲחָזָ֣תַם שָׁ֑ם</tei:l>
          <tei:l>חִ֝֗יל כַּיּוֹלֵֽדָה׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ח</tei:hi> בְּר֥וּחַ קָדִ֑ים</tei:l>
          <tei:l>תְּ֝שַׁבֵּ֗ר אֳנִיּ֥וֹת תַּרְשִֽׁישׁ׃</tei:l>
          <tei:l><tei:hi rend="superscript">ט</tei:hi> כַּאֲשֶׁ֤ר שָׁמַ֨עְנוּ ׀</tei:l>
          <tei:l>כֵּ֤ן רָאִ֗ינוּ</tei:l>
          <tei:l>בְּעִיר־יְהוָ֣ה</tei:l>
          <tei:l>צְ֭בָאוֹת בְּעִ֣יר אֱלֹהֵ֑ינוּ</tei:l>
          <tei:l>אֱלֹ֘הִ֤ים יְכוֹנְנֶ֖הָ עַד־עוֹלָ֣ם סֶֽלָה׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">י</tei:hi> דִּמִּ֣ינוּ אֱלֹהִ֣ים</tei:l>
          <tei:l>חַסְדֶּ֑ךָ</tei:l>
          <tei:l>בְּ֝קֶ֗רֶב הֵיכָלֶֽךָ׃</tei:l>
          <tei:l><tei:hi rend="superscript">יא</tei:hi> כְּשִׁמְךָ֤ אֱלֹהִ֗ים</tei:l>
          <tei:l>כֵּ֣ן תְּ֭הִלָּתְךָ</tei:l>
          <tei:l>עַל־קַצְוֵי־אֶ֑רֶץ</tei:l>
          <tei:l>צֶ֝֗דֶק</tei:l>
          <tei:l>מָלְאָ֥ה יְמִינֶֽךָ׃</tei:l>
          <tei:l><tei:hi rend="superscript">יב</tei:hi> יִשְׂמַ֤ח ׀ הַר־צִיּ֗וֹן</tei:l>
          <tei:l>תָּ֭גֵלְנָה בְּנ֣וֹת יְהוּדָ֑ה</tei:l>
          <tei:l>לְ֝מַ֗עַן מִשְׁפָּטֶֽיךָ׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">יג</tei:hi> סֹ֣בּוּ צִ֭יּוֹן וְהַקִּיפ֑וּהָ</tei:l>
          <tei:l>סִ֝פְר֗וּ מִגְדָּלֶֽיהָ׃</tei:l>
          <tei:l><tei:hi rend="superscript">יד</tei:hi> שִׁ֤יתוּ לִבְּכֶ֨ם ׀</tei:l>
          <tei:l>לְֽחֵילָ֗ה פַּסְּג֥וּ אַרְמְנוֹתֶ֑יהָ</tei:l>
          <tei:l>לְמַ֥עַן תְּ֝סַפְּר֗וּ</tei:l>
          <tei:l>לְד֣וֹר אַחֲרֽוֹן׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">טו</tei:hi> כִּ֤י זֶ֨ה ׀ אֱלֹהִ֣ים אֱ֭לֹהֵינוּ</tei:l>
          <tei:l>עוֹלָ֣ם וָעֶ֑ד</tei:l>
          <tei:l>ה֖וּא יְנַהֲגֵ֣נוּ עַל־מֽוּת׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
