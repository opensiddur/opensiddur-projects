    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_before_setting_off_to_battle_goren">
        <tei:head>תְּפִלָּה לִפְנֵי יְצִיאָה לַקְרָב</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_before_setting_off_to_battle_goren/1"/>
        <tei:lg>
          <tei:l>יְיָ צְבָאוֹת אֱלֹהֵי יִשְׂרָאֵל</tei:l>
          <tei:l>יוֹשֵׁב הַכְּרוּבִים! <tei:bibl>(ישעיה לז:טז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_before_setting_off_to_battle_goren/2"/>
        <tei:lg>
          <tei:l>אַתָּה צִוִּיתָנוּ בְתוֹרָתְךָ לֵאמֹר:</tei:l>
          <tei:l>שְׁמַע יִשְׂרָאֵל</tei:l>
          <tei:l>אַתֶּם קְרֵבִים הַיּוֹם לַמִּלְחָמָה עַל אֹיְבֵיכֶם,</tei:l>
          <tei:l>אַל יֵרַךְ לְבַבְכֶם</tei:l>
          <tei:l>אַל תִּירְאוּ</tei:l>
          <tei:l>וְאַל תַּחְפְּזוּ</tei:l>
          <tei:l>וְאַל תַּעַרְצוּ מִפְּנֵיהֶם,</tei:l>
          <tei:l>כִּי יְיָ אֱלֹהֵיכֶם הַהֹלֵךְ עִמָּכֶם</tei:l>
          <tei:l>לְהִלָּחֵם לָכֶם עִם אֹיְבֵיכֶם</tei:l>
          <tei:l>לְהוֹשִׁיעַ אֶתְכֶם. <tei:bibl>(דברים כ:ג-ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_before_setting_off_to_battle_goren/3"/>
        <tei:lg>
          <tei:l>וְעַתָּה הִנֵּה אֹיְבֶיךָ יֶהֱמָיוּן</tei:l>
          <tei:l>וּמְשַׂנְאֶיךָ נָשְׂאוּ רֹאשׁ,</tei:l>
          <tei:l>עַל עַמְּךָ יַעֲרִימוּ סוֹד</tei:l>
          <tei:l>וְיִתְיָעֲצוּ עַל צְפוּנֶיךָ,</tei:l>
          <tei:l>אָמְרוּ לְכוּ וְנַכְחִידֵם מִגּוֹי</tei:l>
          <tei:l>וְלֹא יִזָּכֵר שֵׁם יִשְׂרָאֵל עוֹד. <tei:bibl>(תהלים פג:ג-ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_before_setting_off_to_battle_goren/4"/>
        <tei:lg>
          <tei:l>הֱיֵה נָא עִם חַיָּלֵי צְבָא הֲגַנָּה לְיִשְׂרָאֵל</tei:l>
          <tei:l>שְׁלוּחֵי עַמְּךָ</tei:l>
          <tei:l>הַקְּרֵבִים הַיּוֹם לַמִּלְחָמָה עַל אוֹיְבֵיהֶם,</tei:l>
          <tei:l>חַזְּקֵנוּ וְאַמְצֵנוּ,</tei:l>
          <tei:l>רִיבָה אֶת יְרִיבֵנוּ</tei:l>
          <tei:l>לְחַם אֶת לֹחֲמֵינוּ,</tei:l>
          <tei:l>הַחֲזֵק מָגֵן וְצִנָּה</tei:l>
          <tei:l>וְקוּמָה עֶזְרָתָה לָּנוּ</tei:l>
          <tei:l>וּפְדֵנוּ לְמַעַן חַסְדֶּךָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_before_setting_off_to_battle_goren/5"/>
        <tei:lg>
          <tei:l>אֱלֹהַי, שִׁיתֵמוֹ כַּגַּלְגַּל,</tei:l>
          <tei:l>כְּקַשׁ לִפְנֵי רוּחַ,</tei:l>
          <tei:l>כְּאֵשׁ תִּבְעַר יָעַר,</tei:l>
          <tei:l>וּכְלֶהָבָה תְּלַהֵט הָרִים.</tei:l>
          <tei:l>כֵּן תִּרְדְּפֵם בְּסַעֲרֶךָ</tei:l>
          <tei:l>וּבְסוּפָתְךָ תְּבַהֲלֵם</tei:l>
          <tei:l>מַלֵּא פְּנֵיהֶם קָלוֹן</tei:l>
          <tei:l>וִיבַקְשׁוּ שְׁמְךָ יְיָ</tei:l>
          <tei:l>יֵבֹשׁוּ וְיִבָּהֲלוּ עֲדֵי־עַד</tei:l>
          <tei:l>וְיַחְפְּרוּ וְיֹאבֵדוּ. <tei:bibl>(תהלים פג:יד-יח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_before_setting_off_to_battle_goren/6"/>
        <tei:lg>
          <tei:l>אָנָּא יְיָ הוֹשִׁיעָה נָא׃</tei:l>
          <tei:l>אָנָּא יְיָ הַצְלִיחָה נָּא׃ <tei:bibl>(תהלים קיח:כה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_before_setting_off_to_battle_goren/7"/>
        <tei:lg>
          <tei:l>הָבָה לָּנוּ עֶזְרָת מִצָּר,</tei:l>
          <tei:l>וְשָׁוְא תְּשׁוּעַת אָדָם.</tei:l>
          <tei:l>בֵּאלֹהִים נַעֲשֶׂה חָיִל</tei:l>
          <tei:l>וְהוּא יָבוּס צָרֵינוּ <tei:bibl>(תהלים ס:יג-יד)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
