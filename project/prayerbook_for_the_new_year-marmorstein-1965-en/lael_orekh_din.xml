  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:lael_orekh_din" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n144.jpg">
        <tei:lg>
          <tei:l><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n144.jpg" n="58"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/1"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> God who arranges judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/2"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Congregation</tei:note> Who examines hearts on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/3"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> Who reveals secrets in judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/4"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Congregation</tei:note> Who speaks uprightness on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/5"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> Who considers opinions in judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/6"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Congregation</tei:note> Who in knowledge acts kindly on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/7"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> Who remembers His covenant in judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/8"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Congregation</tei:note> Who pities His creatures on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/9"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> Who cleanses those who trust in Him, in judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/10"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Congregation</tei:note> Who knows thoughts on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/11"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> Who suppresses His anger in judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/12"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Congregation</tei:note> Who clothes Himself in righteousness on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n146.jpg" n="59"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/13"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> Who forgives sins in judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/14"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Congregation</tei:note> Who is awe-inspiring in fame on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/15"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> Who pardons those carried by Him in judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/16"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Congregation</tei:note> Who answers those who call on Him on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/17"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> Who displays His compassion in judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/18"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Congregation</tei:note> Who observes what is concealed on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/19"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> Who acquires His slaves in judgment. <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/20"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader and congregation</tei:note> Who has compassion on His people on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/21"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> Who protects those who love Him, in judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/22"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Congregation</tei:note> Who supports His innocent ones on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
