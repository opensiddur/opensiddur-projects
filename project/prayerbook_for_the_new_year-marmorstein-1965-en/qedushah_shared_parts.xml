    <tei:body>
      <tei:div facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n238.jpg">
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/qadosh"/><tei:milestone unit="chapter" n="6" corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/qadosh/quotations/isaiah_6"/><tei:milestone unit="verse" n="3" corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/qadosh/quotations/isaiah_6/3"/><tei:milestone unit="verse-part" n="qadosh" corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/qadosh/quotations/isaiah_6/3/qadosh"/><tei:seg source="urn:x-opensiddur:text:bible:isaiah/6/3">‘Holy, Holy, Holy is the Lord of Hosts, the whole earth is full of His glory’.</tei:seg><tei:milestone unit="verse-part"/><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> </tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/barukh_kevod"/><tei:milestone unit="chapter" n="3" corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/barukh_kevod/quotations/ezekiel_3"/><tei:milestone unit="verse" n="12" corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/barukh_kevod/quotations/ezekiel_3/12"/><tei:seg source="urn:x-opensiddur:text:bible:ezekiel/3/12">Blessed be the glory of the Lord from His dwelling place.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> </tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/uvedivrei"/>And in Thy holy words it is written saying: </tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/ledor_vador"/>From generation to generation we will proclaim Thy greatness and for all eternity sanctify Thy holiness. Thy praise, O our God, shall not depart from our mouth for ever and ever, for Thou art God, a great and holy King. <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
