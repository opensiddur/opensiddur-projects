    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/attah_horeta_quiet" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n256.jpg">
        <tei:p><tei:milestone unit="chapter" n="4" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/attah_horeta_quiet/quotes/deuteronomy_4_35/deuteronomy_4"/><tei:milestone unit="verse" n="35" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/attah_horeta_quiet/quotes/deuteronomy_4_35/deuteronomy_4/35"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/4/35">You were taught to perceive that the Lord is God with none besides Him.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="chapter" n="4" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/attah_horeta_quiet/quotes/deuteronomy_4_39/deuteronomy_4"/><tei:milestone unit="verse" n="39" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/attah_horeta_quiet/quotes/deuteronomy_4_39/deuteronomy_4/39"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/4/39">You shall know this day and repeat it in your heart that the Lord is God in the heavens above and that on earth below there is no other.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="chapter" n="6" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/attah_horeta_quiet/quotes/deuteronomy_6_4/deuteronomy_6"/><tei:milestone unit="verse" n="4" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/attah_horeta_quiet/quotes/deuteronomy_6_4/deuteronomy_6/4"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/6/4">Hear, O Israel, the Lord is our God, the Lord is One.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="chapter" n="10" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/attah_horeta_quiet/quotes/deuteronomy_10_14/deuteronomy_10"/><tei:milestone unit="verse" n="14" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/attah_horeta_quiet/quotes/deuteronomy_10_14/deuteronomy_10/14"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/10/14">Behold to the Lord your God heaven and the highest heavens belong, the earth and all that is on it.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="chapter" n="10" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/attah_horeta_quiet/quotes/deuteronomy_10_17/deuteronomy_10"/><tei:milestone unit="verse" n="17" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/attah_horeta_quiet/quotes/deuteronomy_10_17/deuteronomy_10/17"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/10/17">For the Lord your God is the supreme God and the supreme Lord, the great, mighty and awe-inspiring God, who neither respects rank nor accepts bribes.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="chapter" n="32" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/attah_horeta_quiet/quotes/deuteronomy_32_3/deuteronomy_32"/><tei:milestone unit="verse" n="3" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/attah_horeta_quiet/quotes/deuteronomy_32_3/deuteronomy_32/3"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/32/3">For I call upon the Name of the Lord, ascribe greatness to our God.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="chapter" n="113" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/attah_horeta_quiet/quotes/psalms_113_2/psalms_113"/><tei:milestone unit="verse" n="2" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/attah_horeta_quiet/quotes/psalms_113_2/psalms_113/2"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/113/2">May the Name of the Lord be blessed from now until eternity.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> </tei:p>
      </tei:div>
