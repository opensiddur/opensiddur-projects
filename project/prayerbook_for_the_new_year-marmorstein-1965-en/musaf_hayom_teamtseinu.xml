      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/hayom_teamtseinu" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n316.jpg">
        <tei:lg>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/1"/>Strengthen us this day <tei:milestone unit="stanza"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/hayom_teamtseinu/amen/teametz"/>Amen <tei:milestone unit="prayer-part"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/2"/>Bless us this day <tei:milestone unit="stanza"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/hayom_teamtseinu/amen/tevarekh"/>Amen <tei:milestone unit="prayer-part"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/3"/>Exalt us this day <tei:milestone unit="stanza"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/hayom_teamtseinu/amen/tegaddel"/>Amen <tei:milestone unit="prayer-part"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/4"/>Seek us out for the good this day <tei:milestone unit="stanza"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/hayom_teamtseinu/amen/tidrosh"/>Amen <tei:milestone unit="prayer-part"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/techaddesh"/>Renew for us a good year on this day <tei:milestone unit="stanza"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/hayom_teamtseinu/amen/techaddesh"/>Amen <tei:milestone unit="prayer-part"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/21"/>Hear our cry on this day <tei:milestone unit="stanza"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/hayom_teamtseinu/amen/tishma"/>Amen <tei:milestone unit="prayer-part"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:hayom_teamtseinu/teqabbel"/>Accept in compassion and favour our prayer on this day <tei:milestone unit="stanza"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/hayom_teamtseinu/amen/teqabbel"/>Amen <tei:milestone unit="prayer-part"/></tei:l>
