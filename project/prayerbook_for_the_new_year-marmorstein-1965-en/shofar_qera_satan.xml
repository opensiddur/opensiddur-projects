  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n186.jpg">
        <tei:p><tei:milestone unit="chapter" n="3" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan/lamentations_3"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan/lamentations_3/56" n="56"/><tei:seg source="urn:x-opensiddur:text:bible:lamentations/3/56">My voice hast Thou heard, do not hide Thine ear to my plea for relief, to my cry.</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="chapter" n="119" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan/psalms_119"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan/psalms_119/160" n="160"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/119/160">The beginning of Thy word is truth, and Thy righteous judgment is for eternity.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan/psalms_119/122" n="122"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/119/122">Grant Thy servant an assurance of good, that the arrogant shall not oppress me.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan/psalms_119/162" n="162"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/119/162">I rejoice in Thy word like a man who has found abundant booty.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan/psalms_119/66" n="66"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/119/66">Teach me good sense and knowledge for I believe in Thy commandments.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan/psalms_119/108" n="108"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/119/108">Accept with favour the voluntary offerings of my mouth, O Lord, and teach me Thy judgments.</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
