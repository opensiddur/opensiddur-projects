  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/malkhuyot_close" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n208.jpg">
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/malkhuyot_close/text"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam">Our God and God of our fathers, reign over the whole world in Thy glory and rise above the whole earth in Thy grandeur. Shine forth in the exalted beauty of Thy might upon all the inhabitants of the territory of Thine earth so that every creature may recognize that Thou hast created it</tei:seg> <tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n210.jpg" n="95"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam">and that every form may understand that Thou hast formed it and all with breath in the nostrils may say: The Lord, the God of Israel, is King and His Kingdom rules over all. </tei:seg> <j:conditional type="marked" xml:id="musaf_malkhuyot_close_segment_2"><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam">Our God and God of our fathers, take pleasure in our rest.</tei:seg> <j:endConditional target="#musaf_malkhuyot_close_segment_2"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam"> Sanctify us through Thy commandments and grant our portion in Thy Torah, satisfy us with Thy goodness and gladden us with Thy help </tei:seg> <j:conditional type="marked" xml:id="musaf_malkhuyot_close_segment_4"><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam">and grant us, O Lord our God, in love and favour, Thy holy Sabbath as a portion so that Israel, who sanctifies Thy Name, may rest on it</tei:seg> <j:endConditional target="#musaf_malkhuyot_close_segment_4"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam"> and purify our heart to serve Thee in truth for Thou, O Lord, art truth and Thy word is truth and endures for ever. Blessed art Thou, O Lord King over the whole earth, who sanctifies </tei:seg> <j:conditional type="marked" xml:id="musaf_malkhuyot_close_segment_6"><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam">the Sabbath and</tei:seg> <j:endConditional target="#musaf_malkhuyot_close_segment_6"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam"> Israel and the Day of Remembrance.</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
