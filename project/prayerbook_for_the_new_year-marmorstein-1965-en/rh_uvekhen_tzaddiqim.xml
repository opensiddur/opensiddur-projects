      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/uvekhen_tzaddiqim" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n28.jpg">
