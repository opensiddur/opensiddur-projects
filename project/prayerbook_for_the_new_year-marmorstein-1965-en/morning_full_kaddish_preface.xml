        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n160.jpg" n="69"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish_preface/text"/><tei:milestone unit="chapter" n="14" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish_preface/quotations/numbers_14"/><tei:milestone unit="verse" n="17" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish_preface/quotations/numbers_14/17"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/14/17">And now let the power of the Lord appear great as Thou hast said.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>   <tei:milestone unit="chapter" n="25" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish_preface/quotations/psalms_25"/><tei:milestone unit="verse" n="6" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish_preface/quotations/psalms_25/6"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/25/6">Remember Thy mercies, O Lord, and Thine acts of loving-kindness for they exist since eternity.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
