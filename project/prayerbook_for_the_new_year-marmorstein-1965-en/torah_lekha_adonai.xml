    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/lekha_adonai" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n164.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n164.jpg" n="71"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/lekha_adonai/lekha"/><tei:milestone unit="chapter" n="29" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/lekha_adonai/quotations/lekha"/><tei:milestone unit="verse" n="11" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/lekha_adonai/quotations/lekha/11"/><tei:seg source="urn:x-opensiddur:text:bible:chronicles_1/29/11">Thine, O Lord, is greatness, might, glory, triumph and majesty. For all in heaven and on earth is Thine, O Lord, dominion and supremacy above all.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/lekha_adonai/romemu_hadom"/>  <tei:milestone unit="chapter" n="99" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/lekha_adonai/quotations/romemu_hadom"/><tei:milestone unit="verse" n="5" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/lekha_adonai/quotations/romemu_hadom/5"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/99/5">Exalt the Lord our God, and bow down at His footstool, Holy is He.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/lekha_adonai/romemu_har"/>  <tei:milestone unit="chapter" n="99" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/lekha_adonai/quotations/romemu_har"/><tei:milestone unit="verse" n="9" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/lekha_adonai/quotations/romemu_har/9"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/99/9">Exalt the Lord your God, and bow down before His holy mountain, for holy is the Lord our God.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
