    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/morning_barekhu" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n96.jpg">
        <j:conditional xml:id="morning_barekhu_condition">
          <j:all>
            <tei:fs type="opensiddur:quorum">
              <tei:f name="minyan">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:all>
        </j:conditional>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/morning_barekhu/call"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="en">Reader:</tei:note> <tei:seg source="urn:x-opensiddur:text:prayer:barekhu/call">Bless the Lord who is called blessed.</tei:seg> </tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/morning_barekhu/response"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="en">Congregation:</tei:note> <tei:seg source="urn:x-opensiddur:text:prayer:barekhu/response">Blessed is the Lord who is called blessed, for ever and ever.</tei:seg> </tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/morning_barekhu/yitbarakh"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="en">Congregation:</tei:note> <tei:seg source="urn:x-opensiddur:text:prayer:barekhu/yitbarakh">Blessed and praised, glorified, exalted and extolled be the Name of the Supreme King of Kings, the Holy One, blessed be He. He is the first and He is the last and beside Him there is no God. Make way before Him, who is enthroned above the clouds, Yah is His Name, and rejoice before Him, His Name is exalted above all blessing and fame. </tei:seg> <tei:milestone unit="prayer-part"/>Blessed be Him, His Name is exalted above and ever.  <tei:milestone unit="chapter" n="113"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/morning_barekhu/quoted_psalms_113_2" n="2"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/113/2">Let the Lord’s Name be blessed from now until eternity.</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
        <j:endConditional target="#morning_barekhu_condition"/>
      </tei:div>
    </tei:body>
