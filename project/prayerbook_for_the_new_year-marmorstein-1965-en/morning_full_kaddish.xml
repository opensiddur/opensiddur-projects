  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n160.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n160.jpg" n="69"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/yitgaddal"/><tei:seg source="urn:x-opensiddur:text:prayer:kaddish/yitgaddal">Exalted and sanctified be His great Name in the world that He has created according to His will. May His kingdom be established in your lifetime and in your days and in the lifetime of the whole House of Israel, speedily and in a short time, and say Amen.</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/yehe_shemeh"/><tei:seg source="urn:x-opensiddur:text:prayer:kaddish/yehe_shemeh">May His Great Name be praised to eternity and the eternity of eternities.</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/yitbarakh"/><tei:seg source="urn:x-opensiddur:text:prayer:kaddish/yitbarakh">Blessed and praised and glorified and elevated and exalted and adorned and raised on high and lauded be the Name of the Holy One, blessed be He; high, yea high, above all blessing and song, praise and comfort that has ever been spoken in the world, and say, Amen.</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/response_1"/>Accept our prayer with compassion and favour. <tei:milestone unit="prayer-part"/></tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/titqabbal_text"/><tei:seg source="urn:x-opensiddur:text:prayer:kaddish/titqabbal/text">May the prayer and the entreaty of all Israel find favour before their Father in heaven and say, Amen.</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/response_2"/><tei:milestone unit="chapter" n="113" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/quotations/response_psalms_113"/><tei:milestone unit="verse" n="2" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/quotations/response_psalms_113/2"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/113/2">Let the Name of the Lord be blessed from now unto eternity.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/yatom_yehe_shelama"/><tei:seg source="urn:x-opensiddur:text:prayer:kaddish/yatom/yehe_shelama">Let there be abundant peace from Heaven and life for us and for all Israel, and say Amen.</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/response_3"/><tei:milestone unit="chapter" n="121" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/quotations/response_psalms_121"/><tei:milestone unit="verse" n="2" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/quotations/response_psalms_121/2"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/121/2">My help is from the Lord, creator of heaven and earth.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/yatom_oseh_shalom"/><tei:seg source="urn:x-opensiddur:text:prayer:kaddish/yatom/oseh_shalom">May He who makes peace in His heights, make peace for us and for all Israel, and say Amen.</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
