        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hatorah/asher_bachar@prayerbook_for_the_new_year-marmorstein-1965-en"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:numbers/6/24-/6/26@prayerbook_for_the_new_year-marmorstein-1965-en"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:ellu_devarim@prayerbook_for_the_new_year-marmorstein-1965-en"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:elohai_neshamah@prayerbook_for_the_new_year-marmorstein-1965-en"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hashachar/lasekhvi@prayerbook_for_the_new_year-marmorstein-1965-en"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hashachar/shelo_asani_goy@prayerbook_for_the_new_year-marmorstein-1965-en"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hashachar/shelo_asani_aved@prayerbook_for_the_new_year-marmorstein-1965-en"/>
        <tei:div>
          <j:conditional xml:id="documentary_hashachar_men_en">
            <j:all>
              <tei:fs type="opensiddur:person">
                <tei:f name="gender">
                  <tei:symbol value="male"/>
                </tei:f>
              </tei:fs>
            </j:all>
          </j:conditional>
          <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hashachar/shelo_asani_ishah@prayerbook_for_the_new_year-marmorstein-1965-en"/>
          <j:endConditional target="#documentary_hashachar_men_en"/>
        </tei:div>
        <tei:div>
          <j:conditional xml:id="documentary_hashachar_women_en">
            <tei:note type="instruction" xml:lang="en">In place of the preceding benediction women say:</tei:note>
            <j:all>
              <tei:fs type="opensiddur:person">
                <tei:f name="gender">
                  <tei:symbol value="female"/>
                </tei:f>
              </tei:fs>
            </j:all>
          </j:conditional>
          <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hashachar/sheasani_kirtzono@prayerbook_for_the_new_year-marmorstein-1965-en"/>
          <j:endConditional target="#documentary_hashachar_women_en"/>
        </tei:div>
