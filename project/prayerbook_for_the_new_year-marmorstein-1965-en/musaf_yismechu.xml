      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/yismechu" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n206.jpg">
        <j:conditional type="marked" xml:id="musaf_yismechu_condition">
          <tei:note type="instruction" xml:lang="en">On the Sabbath</tei:note>
          <j:all>
            <tei:fs type="opensiddur:holiday-aggregate">
              <tei:f name="shabbat">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:all>
        </j:conditional>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/yismechu/text"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/yismechu_vemalkhutekha">Let those who observe the Sabbath and call it a delight, the people who sanctify the seventh day, rejoice in Thy kingdom. Let them all be satisfied and find delight out of Thine abundance. Thou hast favoured the seventh day and sanctified it, the most precious of days hast Thou called it, a reminder of the work of creation.</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
        <j:endConditional target="#musaf_yismechu_condition"/>
      </tei:div>
