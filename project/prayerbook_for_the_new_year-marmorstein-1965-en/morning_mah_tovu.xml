      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/morning_preliminaries/mah_tovu">
        <tei:div corresp="urn:x-opensiddur:text:prayer:mah_tovu" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n40.jpg">
          <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:mah_tovu/mah_tovu"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/24/5">How becoming are your tents, O Jacob, your dwellings, O Israel.</tei:seg> <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:mah_tovu/varani"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/5/8">And I through the abundance of Thy grace enter Thy house and bow down before Thy holy place in awe of Thee.</tei:seg> <tei:seg source="urn:x-opensiddur:text:bible:psalms/26/8">O Lord, I love the site of Thy house, the place of the dwelling of Thy glory.</tei:seg> <tei:seg source="urn:x-opensiddur:text:bible:psalms/95/6" type="adaptation">I bow, throw myself down and kneel before the Lord, my Maker.</tei:seg> <tei:seg source="urn:x-opensiddur:text:bible:psalms/69/14">And as for me, my prayer is to Thee, O Lord, at a time of favour. O God, in the abundance of Thy grace respond to me with the truth of Thy salvation.</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
        </tei:div>
      </tei:div>
    </tei:body>
