  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:kaddish/chatzi" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n24.jpg">
        <j:conditional xml:id="kaddish_chatzi_condition">
          <j:all>
            <tei:fs type="opensiddur:holiday-aggregate">
              <tei:f name="aseret-ymei-tshuva">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:all>
        </j:conditional>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:kaddish/yitgaddal"/>Exalted and sanctified be His Great Name in the world which He has created according to His will. May His Kingdom be established in your lifetime and in your days and in the lifetime of the whole House of Israel, speedily and in a short time, and say: Amen! </tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:kaddish/yehe_shemeh"/>May His Great Name be praised to eternity and the eternity of eternities! </tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:kaddish/yitbarakh"/>Blessed and praised and glorified and elevated and exalted and adorned and raised on high and lauded be the Name of the Holy One, blessed be He; high, yea high, above all blessing and song, praise and comfort that have ever been spoken in the world, and say Amen! <tei:milestone unit="prayer-part"/></tei:p>
        <j:endConditional target="#kaddish_chatzi_condition"/>
      </tei:div>
    </tei:body>
  </tei:text>
