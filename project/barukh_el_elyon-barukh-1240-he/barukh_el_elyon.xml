    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:barukh_el_elyon">
        <tei:head>בָּרוּךְ אֵל עֶלְיוֹן</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:barukh_el_elyon/1"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אֵל עֶלְיוֹן אֲשֶׁר נָתַן מְנוּחָה,</tei:l>
          <tei:l>לְנַפְשֵׁנוּ פִּדְיוֹן מִשְּׁאֵת וַאֲנָחָה.</tei:l>
          <tei:l>והוּא יִדְרשׁ לְצִיּוֹן עִיר הַנִּדָּחָה,</tei:l>
          <tei:l>עַד־אָנָה תּוּגְיוֹן נֶפֶשׁ נֶאֱנָחָה?</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>הַשּׁוֹמֵר שַׁבָּת, הַבֵּן עִם הַבַּת,</tei:l>
          <tei:l>לָאֵל יֵרָצוּ כְּמִנְחָה עַל־מַחֲבַת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:barukh_el_elyon/2"/>
        <tei:lg>
          <tei:l>רוֹכֵב בָּעֲרָבוֹת מֶלֶךְ עוֹלָמִים,</tei:l>
          <tei:l>אֶת־עַמוֹ לִשְׁבֹּת אִזֵּן בַּנְּעִימִים.</tei:l>
          <tei:l>בְּמַאֲכָלוֹת עֲרֵבוֹת, בְּמִינֵי מַטְעַמִים,</tei:l>
          <tei:l>בְּמַלְבּוּשֵׁי כָבוֹד זֶבַח מִשְׁפָּחָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:barukh_el_elyon/3-4"/>
        <tei:lg>
          <tei:l>ואַשְׁרֵי כָּל־חוֹכֶה לְתַשְׁלוּמֵי כֵפֶל,</tei:l>
          <tei:l>מֵאֵת כָּל סוֹכֶה שׁוֹכֵן בָּעֲרָפֶל.</tei:l>
          <tei:l>נַחֲלָה לוֹ יִזְכֶּה בָּהָר וּבַשָׁפֶל,</tei:l>
          <tei:l>נַחֲלָה וּמְנוּחָה, כַּשֶׁמֶשׁ לוֹ זָרְחָה.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>כָּל־שׁוֹמֵר שַׁבָּת כַּדָּת מֵחֲלָלוֹ,</tei:l>
          <tei:l>הֵן הַכְשֶׁר חִבַּת קֹדֶשׁ גּוֹרָלוֹ.</tei:l>
          <tei:l>ואִם יֵצֵא חוֹבַת הַיּוֹם אַשְׁרֵי לוֹ,</tei:l>
          <tei:l>לְאֵל אָדוֹן מְחוֹלְלוֹ מִנְחָה הִיא שְׁלוּחָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:barukh_el_elyon/5"/>
        <tei:lg>
          <tei:l>חֶמְדַּת הַיָּמִים קְרָאוֹ אֵלִי צוּר,</tei:l>
          <tei:l>ואַשְׁרֵי לִתְמִימִים אִם־יִהְיֶה נָצוּר.</tei:l>
          <tei:l>כֶּתֶר הִלּוֹמִים עַל־רֹאשָׁם יָצוּר,</tei:l>
          <tei:l>צוּר הָעוֹלָמִים רוּחוֹ בָּם נָחָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:barukh_el_elyon/6"/>
        <tei:lg>
          <tei:l>זָכוֹר אֶת־יוֹם השַׁבָּת לְקַדְּשׁוֹ,</tei:l>
          <tei:l>קַרְנוֹ כִּי גָּבְהָה נֵזֶר עַל־רֹאשׁוֹ.</tei:l>
          <tei:l>עַל־כֵּן יִתֵּן הַאָדָם לְנַפְשׁוֹ</tei:l>
          <tei:l>עֹנֶג וְגַם־שִׂמְחָה בָּהֶם לוֹ לְמָשְׁחָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:barukh_el_elyon/7"/>
        <tei:lg>
          <tei:l>קֹדֶשׁ הִיא לָכֶם שַׁבָּת הַמַּלְכָּה,</tei:l>
          <tei:l>אֶל־תּוֹךְ בָּתֵיכֶם לְהָנִיחַ בְּרָכָה.</tei:l>
          <tei:l>בְּכָל־מוֹשְׁבוֹתֵיכֶם לֹא תַעֲשׂוּ מְלָאכָה,</tei:l>
          <tei:l>בְּנֵיכֶם וּבְנוֹתֵיכֶם, עֶבֶד וְגַם־שִׁפְחָה.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
