  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:god_save_the_king">
        <tei:head>God Save the King (Hebrew translation with an additional stanza by Hyman Hurwitz 1831)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:god_save_the_king/1"/>
        <tei:lg>
          <tei:l>God save our noble King William!<tei:anchor xml:id="note_1"/></tei:l>
          <tei:l>Long live the King,</tei:l>
          <tei:l>God save the King!</tei:l>
          <tei:l>Send him victorious,</tei:l>
          <tei:l>Happy and glorious,</tei:l>
          <tei:l>Long to reign over us,</tei:l>
          <tei:l>God save the King!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:god_save_the_king/2"/>
        <tei:lg>
          <tei:l>O Lord our God arise,</tei:l>
          <tei:l>Scatter his enemies,</tei:l>
          <tei:l>And make them fall!</tei:l>
          <tei:l>Confound their politics,</tei:l>
          <tei:l>Frustrate their knavish tricks,</tei:l>
          <tei:l>On him our hearts are fix’d,</tei:l>
          <tei:l>O save us all!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:god_save_the_king/3"/>
        <tei:lg>
          <tei:l>Thy choicest gifts in store</tei:l>
          <tei:l>On him be pleased to pour,</tei:l>
          <tei:l>Long may he reign!</tei:l>
          <tei:l>May he defend our laws,</tei:l>
          <tei:l>And ever give us cause</tei:l>
          <tei:l>To sing with heart and voice,</tei:l>
          <tei:l>God save the King!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:god_save_the_king/4"/>
        <tei:lg>
          <tei:l>O, grant him long to see</tei:l>
          <tei:l>Friendship and unity</tei:l>
          <tei:l>Always encrease!</tei:l>
          <tei:l>May he his sceptre sway,</tei:l>
          <tei:l>All loyal souls obey,</tei:l>
          <tei:l>Join heart and voice, huzza!</tei:l>
          <tei:l>God save the King!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" n="1" target="#note_1">
      <tei:p>This would be King William IV (1765-1837) who reigned from 1830-1837.</tei:p>
    </tei:note>
  </tei:standOff>
