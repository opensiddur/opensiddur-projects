  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:al_hanissim_for_yom_haatsmaut_shmidman">
        <tei:head>על הניסים ליום העצמאות</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:al_hanissim_for_yom_haatsmaut_shmidman/1"/>
        <tei:lg>
          <tei:l>בִּימֵי קִבּוּץ שְׂרִידֵי יִשְׂרָאֵל</tei:l>
          <tei:l>מֵאַרְצוֹת חֹשֶׁךְ וְצַלְמָוֶת</tei:l>
          <tei:l>לְחֶמְדַּת נַחֲלָתָם,</tei:l>
          <tei:l>קָמוּ חֲלוּצֵי אֻמָּה,</tei:l>
          <tei:l>הֵרִימוּ נֵס</tei:l>
          <tei:l>וְחִבְּרוּ מְגִלָּה,</tei:l>
          <tei:l>וְתָבְעוּ אֶת זְכוּת הָעָם</tei:l>
          <tei:l>לַעֲמֹד בִּרְשׁוּת עַצְמוֹ,</tei:l>
          <tei:l>כְּמַמְלָכָה יְהוּדִית בְּאֶרֶץ מוֹלַדְתּוֹ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:al_hanissim_for_yom_haatsmaut_shmidman/2"/>
        <tei:lg>
          <tei:l>בְּתֻפִּים וּבִמְחוֹלוֹת רָקְדוּ בַּחוּצוֹת, טַף וְנָשִׁים, זְקֵנִים וּנְעָרִים, בְּקוֹלוֹת שִׂמְחָה וּבְצָהֳלָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:al_hanissim_for_yom_haatsmaut_shmidman/3"/>
        <tei:lg>
          <tei:l>בְּאוֹתָהּ שָׁעָה תְּקָפוּם בְּנֵי עַוְלָה,</tei:l>
          <tei:l>לְהַכְחִיד מִן הָאָרֶץ שֵׁם וּשְׁאֵרִית,</tei:l>
          <tei:l>וְלַיָּם לִזְרֹק כָּל שׁוֹמְרֵי אֱמוּנֶיהָ.</tei:l>
          <tei:l>וְאַתָּה לְיֵשַׁע עַמְּךָ מִהַרְתָּ,</tei:l>
          <tei:l>יְדֵי מְגִנֵּיהֶם חִזַּקְתָּ,</tei:l>
          <tei:l>וּכְלֵי אוֹיְבֵיהֶם נִפַּצְתָּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:al_hanissim_for_yom_haatsmaut_shmidman/4"/>
        <tei:lg>
          <tei:l>תְּקוּמַת פְּאֵר עָשִׂיתָ</tei:l>
          <tei:l>וּמְדִינַת הָדָר הֵקַמְתָּ,</tei:l>
          <tei:l>רֵאשִׁית שְׁאִיפַת דּוֹרוֹתֶיךָ,</tei:l>
          <tei:l>מַחְסֶה וּמָעוֹז לְכָל שְׁבוּת עַמֶּךָ.</tei:l>
        </tei:lg>
