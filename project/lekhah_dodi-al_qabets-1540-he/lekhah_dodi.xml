      <tei:div corresp="urn:x-opensiddur:text:poem:lekhah_dodi">
        <tei:head>לְכָה דוֹדִי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lekhah_dodi/refrain"/>
        <tei:lg>
          <tei:l>לְכָה דוֹדִי לִקְרַאת כַּלָּה.</tei:l>
          <tei:l>פְּנֵי שַׁבָּת נְקַבְּלָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lekhah_dodi/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שָׁ</tei:seg>מוֹר וְזָכוֹר בְּדִבּוּר אֶחָד</tei:l>
          <tei:l>הִשְׁמִיעָנוּ אֵל הַמְיֻחָד,</tei:l>
          <tei:l>יהוה אֶחָד וּשְׁמוֹ אֶחָד</tei:l>
          <tei:l>לְשֵׁם וּלְתִפְאֶרֶת וְלִתְהִלָּה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lekhah_dodi/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">לִ</tei:seg>קְרַאת שַׁבָּת לְכוּ וְנֵלְכָה,</tei:l>
          <tei:l>כִּי הִיא מְקוֹר הַבְּרָכָה,</tei:l>
          <tei:l>מֵרֹאשׁ מִקֶּדֶם נְסוּכָה,</tei:l>
          <tei:l>סוֹף מַעֲשֶׂה בְּמַחֲשָׁבָה תְּחִלָּה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lekhah_dodi/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>קְדַּשׁ מֶלֶךְ עִיר מְלוּכָה,</tei:l>
          <tei:l>קוּמִי צְאִי מִתּוֹךְ הַהֲפֵכָה</tei:l>
          <tei:l>רַב לָךְ שֶׁבֶת בְּעֵמֶק הַבָּכָא</tei:l>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>הוּא יַחֲמֹל עָלַיִךְ חֶמְלָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lekhah_dodi/4"/>
        <tei:lg>
          <tei:l>הִתְנַעֲרִי מֵעָפָר קוּמִי,</tei:l>
          <tei:l>לִבְשִׁי בִּגְדֵי תִפְאַרְתֵּךְ עַמִּי,</tei:l>
          <tei:l>עַל יַד בֶּן יִשַׁי בֵּית הַלַּחְמִי</tei:l>
          <tei:l>קָרְבָה אֶל נַפְשִׁי גְאָלָהּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lekhah_dodi/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הִ</tei:seg>תְעוֹרְרִי הִתְעוֹרְרִי</tei:l>
          <tei:l>כִּי בָא אוֹרֵךְ קוּמִי אוֹרִי,</tei:l>
          <tei:l>עוּרִי עוּרִי שִׁיר דַּבֵּרִי,</tei:l>
          <tei:l>כְּבוֹד יהוה עָלַיִךְ נִגְלָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lekhah_dodi/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">לֹ</tei:seg>א תֵבוֹשִׁי וְלֹא תִכָּלְמִי,</tei:l>
          <tei:l>מַה תִּשְׁתּוֹחֲחִי וּמַה תֶּהֱמִי,</tei:l>
          <tei:l>בָּךְ יֶחֱסוּ עֲנִיֵי עַמִּי,</tei:l>
          <tei:l>וְנִבְנְתָה עִיר עַל תִּלָּהּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lekhah_dodi/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>הָיוּ לִמְשִׁסָה שֹׁאסָיִךְ,</tei:l>
          <tei:l>וְרָחֲקוּ כָּל מְבַלְּעָיִךְ</tei:l>
          <tei:l>יָשִׂישׂ עָלַיִךְ אֱלֹהָיִךְ</tei:l>
          <tei:l>כִּמְשׂוֹשׂ חָתָן עַל כַּלָּה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lekhah_dodi/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>מִין וּשְׂמֹאל תִּפְרֹצִי,</tei:l>
          <tei:l>וְאֶת יהוה תַּעֲרִיצִי</tei:l>
          <tei:l>עַל יַד אִישׁ בֶּן פַּרְצִי</tei:l>
          <tei:l>וְנִשְׂמְחָה וְנָגִילָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">נוהגים לפנות לעבר המערב/הדלת לקבל פני שבת המלכה</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lekhah_dodi/9"/>
        <tei:lg>
          <tei:l>בּוֹאִי בְשָׁלוֹם עֲטֶרֶת בַּעְלָהּ</tei:l>
          <tei:l>גַּם בְּשִׂמְחָה וּבְצָהֳלָה</tei:l>
          <tei:l>תּוֹךְ אֱמוּנֵי עַם סְגֻלָּה,</tei:l>
          <tei:l>בּוֹאִי כַלָּה. בּוֹאִי כַלָּה.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
