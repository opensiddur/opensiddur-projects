    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:elohim_yisadenu_ezra">
        <tei:head>אֱלֹהִים יִסְעָדֵנוּ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_yisadenu_ezra/1"/>
        <tei:lg>
          <tei:l>אֱלֹהִים יִסְעָדֵנוּ</tei:l>
          <tei:l>בְּרָכָה בִּמְאַדֵּנוּ,</tei:l>
          <tei:l>וְזֶבֶד טוֹב יִזְבְּדֵנוּ</tei:l>
          <tei:l>בְּכׇל מִשְׁלַח יָדֵינוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_yisadenu_ezra/2"/>
        <tei:lg>
          <tei:l>בְּיוֹם רִאשׁוֹן לִמְלָאכָה</tei:l>
          <tei:l>יְצַו אִתָּנוּ בְּרָכָה</tei:l>
          <tei:l>וְיוֹם הַשֵּׁנִי כָּכָה</tei:l>
          <tei:l>יַמְתִּיק אֶת סוֹדֵנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_yisadenu_ezra/3"/>
        <tei:lg>
          <tei:l>רַבֵּה צְבָאֵי יִשְׁעִי</tei:l>
          <tei:l>בַּשְּׁלִישִׁי וּבָרְבִיעִי</tei:l>
          <tei:l>בַּחֲמִישִׁי אַךְ לֹא בְּעִי</tei:l>
          <tei:l>יִשְׁלַח אֶת פּוֹדֵנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_yisadenu_ezra/4"/>
        <tei:lg>
          <tei:l>הָכֵן טְבוֹחַ טֶבַח</tei:l>
          <tei:l>בְּיוֹם הַשִּׁשִּׁי זֶבַח</tei:l>
          <tei:l>קֹדֶשׁ הִלּוּל וָשֶׁבַח</tei:l>
          <tei:l>עַל כׇּל מַחְמַדֵּנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elohim_yisadenu_ezra/5"/>
        <tei:lg>
          <tei:l>מַעֲדַנִּים לְנַפְשֵׁנוּ</tei:l>
          <tei:l>נִתֵּן בְּיוֹם קָדְשֵׁנוּ</tei:l>
          <tei:l>וְרַעֲנָנָה עַרְשֵּׂנוּ</tei:l>
          <tei:l>וְלַיְלָה אוֹר בַּעֲדֵנוּ</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
