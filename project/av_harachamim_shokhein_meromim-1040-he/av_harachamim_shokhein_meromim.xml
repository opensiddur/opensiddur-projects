      <tei:div corresp="urn:x-opensiddur:text:prayer:av_harachamim_shokhein_meromim">
        <tei:head>אָב הָרַחֲמִים שׁוֹכֵן מְרוֹמִים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:av_harachamim_shokhein_meromim/2"/>
        <tei:lg>
          <tei:l>אָב הָרַחֲמִים</tei:l>
          <tei:l>שׁוֹכֵן מְרוֹמִים</tei:l>
          <tei:l>בְּרַחֲמָיו הָעֲצוּמִים</tei:l>
          <tei:l>הוּא יִפְקֹד בְּרַחֲמִים</tei:l>
          <tei:l>הַחֲסִידִים וְהַיְשָׁרִים וְהַתְּמִימִים</tei:l>
          <tei:l>קְהִלּוֹת הַקֹּדֶשׁ</tei:l>
          <tei:l>שֶׁמָּסְרוּ נַפְשָׁם עַל קְדֻשַּׁת הַשֵּׁם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:av_harachamim_shokhein_meromim/3"/>
        <tei:lg>
          <tei:l>הַנֶּאֱהָבִ֤ים וְהַנְּעִימִם֙ בְּחַיֵּיהֶ֔ם</tei:l>
          <tei:l>וּבְמוֹתָ֖ם לֹ֣א נִפְרָ֑דוּ</tei:l>
          <tei:l>מִנְּשָׁרִ֣ים קַ֔לּוּ מֵאֲרָי֖וֹת גָּבֵֽרוּ׃ <tei:bibl>(שמואל ב׳ א:כג)</tei:bibl></tei:l>
          <tei:l>לַעֲשׂוֹת רְצוֹן קוֹנָם וְחֵפֶץ צוּרָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:av_harachamim_shokhein_meromim/4"/>
        <tei:lg>
          <tei:l>יִזְכְּרֵם אֱלֹהֵינוּ לְטוֹבָה עִם שְׁאָר צַדִּיקֵי עוֹלָם׃</tei:l>
          <tei:l>וְיִנְקֹם לְעֵינֵינוּ נִקְמַת דַּם עֲבָדָיו הַשָּׁפוּךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:av_harachamim_shokhein_meromim/5"/>
        <tei:lg>
          <tei:l>כַּכָּתוּב בְּתוֹרַת מֹשֶׁה אִישׁ הָאֱלֹהִים —</tei:l>
          <tei:l>הַרְנִ֤ינוּ גוֹיִם֙ עַמּ֔וֹ</tei:l>
          <tei:l>כִּ֥י דַם־עֲבָדָ֖יו יִקּ֑וֹם</tei:l>
          <tei:l>וְנָקָם֙ יָשִׁ֣יב לְצָרָ֔יו</tei:l>
          <tei:l>וְכִפֶּ֥ר אַדְמָת֖וֹ עַמּֽוֹ׃ <tei:bibl>(דברים לב:מג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:av_harachamim_shokhein_meromim/6"/>
        <tei:lg>
          <tei:l>וְעַל יְדֵי עֲבָדֶיךָ הַנְּבִיאִים כָּתוּב לֵאמֹר —</tei:l>
          <tei:l>וְנִקֵּ֖יתִי דָּמָ֣ם</tei:l>
          <tei:l>לֹֽא־נִקֵּ֑יתִי</tei:l>
          <tei:l>וַיהֹוָ֖ה שֹׁכֵ֥ן בְּצִיּֽוֹן׃ <tei:bibl>(יואל ד:כא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:av_harachamim_shokhein_meromim/7"/>
        <tei:lg>
          <tei:l>וּבְכִתְבֵי הַקֹּדֶשׁ נֶאֱמַר —</tei:l>
          <tei:l>לָ֤מָּה ׀ יֹאמְר֣וּ הַגּוֹיִם֮</tei:l>
          <tei:l>אַיֵּ֢ה אֱֽלֹהֵ֫יהֶ֥ם</tei:l>
          <tei:l>יִוָּדַ֣ע בַּגֹּיִ֣ים לְעֵינֵ֑ינוּ</tei:l>
          <tei:l>נִ֝קְמַ֗ת דַּֽם־עֲבָדֶ֥יךָ הַשָּׁפֽוּךְ׃ <tei:bibl>(תהלים עט:י)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:av_harachamim_shokhein_meromim/8"/>
        <tei:lg>
          <tei:l>וְאוֹמֵר —</tei:l>
          <tei:l>כִּֽי־דֹרֵ֣שׁ דָּ֭מִים אוֹתָ֣ם זָכָ֑ר</tei:l>
          <tei:l>לֹֽא־שָׁ֝כַ֗ח צַעֲקַ֥ת [עניים] עֲנָוִֽים׃ <tei:bibl>(תהלים ט:יג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:av_harachamim_shokhein_meromim/9"/>
        <tei:lg>
          <tei:l>וְאוֹמֵר —</tei:l>
          <tei:l>יָדִ֣ין בַּ֭גּוֹיִם מָלֵ֣א גְוִיּ֑וֹת</tei:l>
          <tei:l>מָ֥חַץ רֹ֗֝אשׁ עַל־אֶ֥רֶץ רַבָּֽה׃</tei:l>
          <tei:l>מִ֭נַּחַל בַּדֶּ֣רֶךְ יִשְׁתֶּ֑ה</tei:l>
          <tei:l>עַל־כֵּ֗֝ן יָרִ֥ים רֹֽאשׁ׃ <tei:bibl>(תהלים קי:ז)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
