  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:items_for_the_second_seder_plate_beets_mayer">
        <tei:head>סִילְקָא דְּרָב הוּנָא</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:items_for_the_second_seder_plate_beets_mayer/3"/>
        <tei:lg>
          <tei:l>מַאי שְׁנֵי תַּבְשִׁילִין? אֲמַר רַב הוּנָא, ”סִילְקָא וַאֲרוּזָא.“ רָבָא הֲוָה מְהַדַּר אַסִּלְקָא וַאֲרוּזָא, הוֹאִיל וּנְפַק מִפּוּמֵיהּ דְּרַב הוּנָא.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:items_for_the_second_seder_plate_beets_mayer/7"/>
        <tei:lg>
          <tei:l>וָאֶעֱבֹ֤ר עָלַ֙יִךְ֙ וָֽאֶרְאֵ֔ךְ</tei:l>
          <tei:l>מִתְבּוֹסֶ֖סֶת בְּדָמָ֑יִךְ</tei:l>
          <tei:l>וָאֹ֤מַר לָךְ֙ בְּדָמַ֣יִךְ חֲיִ֔י</tei:l>
          <tei:l>וָאֹ֥מַר לָ֖ךְ בְּדָמַ֥יִךְ חֲיִֽי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:items_for_the_second_seder_plate_beets_mayer/9"/>
        <tei:lg>
          <tei:l>אָמַר רַב חִסְדָּא, ”תַּבְשִׁיל שֶׁל תְּרָדִין יָפֶה לַלֵּב וָטוֹב לְעֵינַיִם וְכָל שְׁכֵּן לִבְנֵי מֵעַיִם.“ אָמַר אַבַּיֵּי, ”וְהוּא דּיָתִיב אַבֵּי תְּפִי וְעָבִיד תּוּךְ תוּךְ!“</tei:l>
        </tei:lg>
      </tei:div>
