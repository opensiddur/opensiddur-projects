    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:kavvanah_for_returning_our_chamets_to_the_earth_seidenberg">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kavvanah_for_returning_our_chamets_to_the_earth_seidenberg/2"/>
        <tei:lg>
          <tei:l>כָׇּל־חֲמִירָא וַחֲמִיעָא דְּאִכָּא בִרְשׁוּתִי</tei:l>
          <tei:l>(דַּחֲמִתֵּהּ וּ)דְלָא חֲמִתֵּהּ</tei:l>
          <tei:l>(דְּבַעֲרִתֵּהּ וּ)דְלָא בַעֲרִתֵּהּ</tei:l>
          <tei:l>לִבְטִיל וְלֶהֱוֵי כְּעַפְרָא דְאַרְעָא׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
