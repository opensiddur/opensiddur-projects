  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:addir_hu">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_hu/1"/>
        <tei:lg>
          <tei:l>Magnificus (qui est)</tei:l>
          <tei:l>ille ædificabit domum suam brevi,</tei:l>
          <tei:l>citò in diebus nostris ocyus;</tei:l>
          <tei:l>(Ah) ædifica, ædifica, ædifica,</tei:l>
          <tei:l>ædifica domum tuam brevi.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:addir_hu/2"/>
        <tei:lg>
