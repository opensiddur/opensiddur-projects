  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:amulet_bowl_formula_for_exorcising_broken_or_malfunctioning_mayer">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:amulet_bowl_formula_for_exorcising_broken_or_malfunctioning_mayer/1"/>
        <tei:lg>
          <tei:l>אָסוּתָא מִן־שְׁמַיָּא</tei:l>
          <tei:l>לְבֵיתֵיהּ / לְבֵיתַהּ / לְבֵיתוֹהוֹי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:amulet_bowl_formula_for_exorcising_broken_or_malfunctioning_mayer/2"/>
        <tei:lg>
          <tei:l>אִתְּתֵיהּ / אִתְּתַהּ / אִתְּתוֹהוֹי</tei:l>
          <tei:l>אִינְשֵׁיהּ / אִינְשַׁהּ / אִינְשׁוֹהוֹי</tei:l>
          <tei:l>זוּגֵיהּ / זוּגַהּ / זוּגוֹהוֹי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:amulet_bowl_formula_for_exorcising_broken_or_malfunctioning_mayer/3"/>
        <tei:lg>
          <tei:l>בְּרַתֵּיה / בְּרַתַּהּ / בְּרַתּוֹהוֹי</tei:l>
          <tei:l>בְּנָתֵיהּ / בְּנָתָהָא / בְּנָתוֹהוֹי</tei:l>
          <tei:l>בְּרֵיהּ / בְּרַהּ / בְּרוֹהוֹי</tei:l>
          <tei:l>בְּנוֹהִי / בְּנָהָא / בְּנוֹהוֹי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:amulet_bowl_formula_for_exorcising_broken_or_malfunctioning_mayer/4"/>
        <tei:lg>
          <tei:l>קִנְיָנֵיהּ / קִנְיָנַהּ / קִנְיָנוֹהוֹי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:amulet_bowl_formula_for_exorcising_broken_or_malfunctioning_mayer/5"/>
        <tei:lg>
          <tei:l>וּמַכְבְּסֵיהּ / וּמַכְבְּסַהּ / וּמַכְבְּסוֹהוֹי</tei:l>
          <tei:l>וּמַחְשְׁבֵיהּ / וּמַחְשְׁבַהּ / וּמַחְשְׁבוֹהוֹי</tei:l>
          <tei:l>וּמַזְגְּנֵיהּ / וּמַזְגְּנַהּ / וּמַזְגְּנוֹהוֹי</tei:l>
          <tei:l>וּרְחִיקָּלֵיהּ / וּרְחִיקָּלַהּ / וּרְחִיקָּלוֹהוֹי</tei:l>
          <tei:l>וְתַנּוּרֵיהּ / וְתַנּוּרַהּ / וְתַנּוּרוֹהוֹי</tei:l>
          <tei:l>וּמַדְּפְסֵיהּ / וּמַדְּפְסַהּ / וּמַדְּפְסוֹהוֹי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:amulet_bowl_formula_for_exorcising_broken_or_malfunctioning_mayer/6"/>
        <tei:lg>
          <tei:l>דְּפלוני בַּר־פלוני / בַּת־פלוני / בֵּי־פלוני</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:amulet_bowl_formula_for_exorcising_broken_or_malfunctioning_mayer/7"/>
        <tei:lg>
          <tei:l>חֲתִימָא וּמְחַתְּמָא בְּעִיזְקְתָא דְּיקוק צְבָאוֹת</tei:l>
          <tei:l>רָזָא כִּיסִי הָדָא חַד רָזָא וְחַד גְּזָרָא</tei:l>
          <tei:l>דְּגָזַר עֲלַיְכִי רִבִּי יְהוֹשֻׁעַ בֶּן־פְּרַחְיָא</tei:l>
          <tei:l>קְבֵלַת שַׁמְתָּא דִּתְשַׁמְּתֵי</tei:l>
          <tei:l>וּתְהוֹן בְּשַׁמְתָּא דְּרִבִּי יְהוֹשֻׁעַ בַּר־פְּרַחְיָא</tei:l>
          <tei:l>וְתֶהֱוֵי בְּשַׁמְתָּא בִּשְׁמֵיהּ דְּאַשְׁמְדַי מַלְכָּא דְשֵׁדֵי</tei:l>
          <tei:l>וְתֶהֱוֵי בְּשַׁמְתָּא בִּשְׁמֵיהּ דְּהוֹרְמִיז בַּר־לִילִּית</tei:l>
          <tei:l>וְתֶהֱוֵי בְּשַׁמְתָּא בִּשְׁמֵיהּ דְּרַב יוֹסֵף שֵׁדָא</tei:l>
          <tei:l>וְתֶהֱוֵי בְּשַׁמְתָּא בִּשְׁמֵיהּ דְּשִׁיבְתָּא</tei:l>
          <tei:l>וְתֶהֱוֵי בְּשַׁמְתָּא בִּשְׁמֵיהּ דְּמִשַּׁבְרִירֵי שַׁבְרִירֵי בְּרִירֵי רִירֵי יְרֵי רֵי</tei:l>
          <tei:l>וְתֶהֱוֵי בְּשַׁמְתָּא דְּכָל שֵׁדֵי וְחִישִּׁיכֵי לִילִין וְלֵילְיָתָא</tei:l>
          <tei:l>דּאִית בְּאַרְעָא דְּיִשְׂרָאֵל וּדְאִית בְּבָבֶל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:amulet_bowl_formula_for_exorcising_broken_or_malfunctioning_mayer/8"/>
        <tei:lg>
          <tei:l>חֲתִימָא וּמְחַתְּמָא אַסְקוּפָתַי דִּילִי</tei:l>
          <tei:l>פלוני בַּר־פלוני / פלונית בַּת־פלוני / פלונו בֵּי־פלוני</tei:l>
          <tei:l>דַּד בְּשֵׁיר שֵׁירָא בְּזוֹם זִימְרָא</tei:l>
          <tei:l>בְּעִיזְקְתָא דְּיׄוׄכׄבׄרׄ זׄיׄוׄאׄ מׄצׄפׄץׄ הׄשׄתׄפׄאׄ אׄכׄתׄרׄיׄאׄלׄ</tei:l>
          <tei:l>מִן־שֵׁדִין וּמִן־דֵּוִין וּמִין־לִלִּין כּוּלְּהוֹן</tei:l>
          <tei:l>מִן־שְׂעָרְהוֹן</tei:l>
          <tei:l>פלוני בַּר־פלוני / פלונית בַּת־פלוני / פלונו בֵּי־פלוני</tei:l>
          <tei:l>מִן־דְּמֵיהוֹן שַׁקְלִית לְחַתְּמְהוֹן</tei:l>
          <tei:l>וּמִן־גְּלֵדְהוֹן שַׁקְלִית לְרַקְּעָה בְּהוֹן</tei:l>
          <tei:l>שְׁבָע שְׁבָע נְקִיט צוּצִיתֵיהּ</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
