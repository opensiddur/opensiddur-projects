  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:pledge_of_allegiance_to_the_family_of_earth_kelber">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:pledge_of_allegiance_to_the_family_of_earth_kelber/1"/>
        <tei:lg>
          <tei:l>אֶשְׂבַּע אֱמוּנִים לְכַדּוּר הָאָרֶץ, הָאֲדָמָה (הַשָּׁמַיִם וְהַיָּם)</tei:l>
          <tei:l>וְלַצִּמְחִיָּה, וּלְבַעֲלֵי חַיִּים וְחַיֵּי אָדָם</tei:l>
          <tei:l>שֶׁהוּא מְקַיֵּם,</tei:l>
          <tei:l>כּוֹכָב אֶחָד, בִּלְתִּי נִתָּן לַחֲלֻקָּה,</tei:l>
          <tei:l>עִם אֲוִיר, מַיִם וַאֲדָמָה בְּרִיאִים,</tei:l>
          <tei:l>וְעִם צֶדֶק כַּלְכָּלִי, שִׁוְיוֹן זְכוּיוֹת וְשָׁלוֹם</tei:l>
          <tei:l>לַכֹּל.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
