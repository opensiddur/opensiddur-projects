  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:azalat_yokheved">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azalat_yokheved/1"/>
        <tei:lg>
          <tei:l>אֲזַלַת יוֹכֶֽבֶד מְפַיְּיסָת לְמִצְרַיִֽם</tei:l>
          <tei:l>מִצְרַיִֽם מִצְרַֽיִם דִּילְמָא חֲמִית לִי לְמֹשֶׁה</tei:l>
          <tei:l>בְּחַיִּיךְ יוֹכֶֽבֶד לָא חֲמִיתִי יָתֵיהּ</tei:l>
          <tei:l>מִן־יוֹמָא דִּקְטַל בִּי כׇּל־בּוּכְרָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azalat_yokheved/2"/>
        <tei:lg>
          <tei:l>אֲזַלַת יוֹכֶֽבֶד מְפַיְּיסָת לְנִילוּס</tei:l>
          <tei:l>נִילוּס נִילוּס דִּילְמָא חֲמִית לִי לְמֹשֶׁה</tei:l>
          <tei:l>בְּחַיִּיךְ יוֹכֶֽבֶד לָא חֲמִיתִי יָתֵיהּ</tei:l>
          <tei:l>מִן־יוֹמָא דַּעֲבַד בִּי מֵימִי לִדְמָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azalat_yokheved/3"/>
        <tei:lg>
          <tei:l>אֲזַלַת יוֹכֶֽבֶד מְפַיְּיסָת לְיַמָּא</tei:l>
          <tei:l>יַמָּא יַמָּא דִּילְמָא חֲמִית לִי לְמֹשֶׁה</tei:l>
          <tei:l>בְּחַיִּיךְ יוֹכֶֽבֶד לָא חֲמִיתִי יָתֵיהּ</tei:l>
          <tei:l>מִן־יוֹמָא דְּאַעְבַּר בִּי תְּרֵין עֲשַׂר שִׁבְטִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azalat_yokheved/4"/>
        <tei:lg>
          <tei:l>אֲזַלַת יוֹכֶֽבֶד מְפַיְּיסָת לְמַדְבְּרָא</tei:l>
          <tei:l>מַדְבְּרָא מַדְבְּרָא דִּילְמָא חֲמִית לִי לְמֹשֶׁה</tei:l>
          <tei:l>בְּחַיִּיךְ יוֹכֶֽבֶד לָא חֲמִיתִי יָתֵיהּ</tei:l>
          <tei:l>מִן־יוֹמָא דְּאַנְחֵת עֲלַי לְיִשְׂרָאֵל מַנָּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azalat_yokheved/5"/>
        <tei:lg>
          <tei:l>אֲזַלַת יוֹכֶֽבֶד מְפַיְּיסָת לְסִינַי</tei:l>
          <tei:l>סִינַי סִינַי דִּילְמָא חֲמִית לִי לְמֹשֶׁה</tei:l>
          <tei:l>בְּחַיִּיךְ יוֹכֶֽבֶד לָא חֲמִיתִי יָתֵיהּ</tei:l>
          <tei:l>מִן־יוֹמָא דְּאַנְחֵת עֲלַי תְּרֵין לוּחֵי קְיָימָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:azalat_yokheved/6"/>
        <tei:lg>
          <tei:l>אֲזַלַת יוֹכֶֽבֶד מְפַיְּיסָת לְכֵיפָא</tei:l>
          <tei:l>כֵּיפָא כֵּיפָא דִּילְמָא חֲמִית לִי לְמֹשֶׁה</tei:l>
          <tei:l>בְּחַיִּיךְ יוֹכֶֽבֶד לָא חֲמִיתִי יָתֵיהּ</tei:l>
          <tei:l>מִן־יוֹמָא דִּמְחָא עֲלַי תְּרֵין שַׁרְבִיטִין׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
