      <tei:div corresp="urn:x-opensiddur:text:prayer:tefillat_nachem_for_the_peace_of_jerusalem_on_tishah_beav_mayer">
        <tei:head>תפילת נחם לשלם בירושלם</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tefillat_nachem_for_the_peace_of_jerusalem_on_tishah_beav_mayer/1"/>
        <tei:lg>
          <tei:l>נַחֵם <j:divineName>····</j:divineName> אֱלֹהֵֽינוּ</tei:l>
          <tei:l>אֶת אֲבֵלֵי צִיּוֹן</tei:l>
          <tei:l>וְאֵת אֲבֵלֵי יְרוּשָׁלָֽיִם.</tei:l>
          <tei:l>נִשְׁאַל שְׁלוֹם יְרוּשָׁלָֽיִם‪.‬</tei:l>
          <tei:l>יִשְׁלָֽיוּ אוֹהֲבֶֽיהָ,</tei:l>
          <tei:l>יְהִי שָׁלוֹם בְּחֵילָהּ,</tei:l>
          <tei:l>שַׁלְוָה בְּאַרְמוֹנוֹתֶֽיהָ. <tei:bibl>(כמו תהלים קכב:ו-ז)</tei:bibl></tei:l>
          <tei:l>וַאֲנַֽחְנוּ נִתְפַּלֵּל בַעֲדָהּ אֵלֶֽיךָ,</tei:l>
          <tei:l>כִּי בִשְׁלוֹמָהּ יִהְיֶה לָנוּ שָׁלוֹם. <tei:bibl>(כמו ירמיה כט:ז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tefillat_nachem_for_the_peace_of_jerusalem_on_tishah_beav_mayer/2"/>
        <tei:lg>
          <tei:l>אָכֵן, אָבִֽינוּ מָלְכֵּֽנוּ, הַחַנּוּן וְהָרַחוּם,</tei:l>
          <tei:l>עֹשֶׂה שָׁלוֹם שֶׁהַשָּׁלוֹם שֶׁלּוֹ,</tei:l>
          <tei:l>דְּרֹשׁ אֶת שְׁלוֹם הָעִיר אֲשֶׁר הִגְלֵֽיתָ אוֹתָֽנוּ שָֽׁמָּה. <tei:bibl>(כמו ירמיה כט:ז)</tei:bibl></tei:l>
          <tei:l>שׁוּבָה ···· אֶת־שְׁבִיתֵנוּ, <tei:bibl>(תהלים קכו:ד)</tei:bibl></tei:l>
          <tei:l>שׁוּבָה וְהִנָּחֵם עַל־עֲבָדֶֽיךָ. <tei:bibl>(תהלים צ:יג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tefillat_nachem_for_the_peace_of_jerusalem_on_tishah_beav_mayer/3"/>
        <tei:lg>
          <tei:l>וְאַז נַעֲלֶה אֶל־הַמָּקוֹם אֲשֶׁר־בָּחַֽרְתָּ לְשָׁכֵּן אֶת־שִׁמְךָ שָׁם, <tei:bibl>(כמו דברים טז:ו)</tei:bibl></tei:l>
          <tei:l>כִּימֵי עוֹלָם וּכְשָׁנִים קַדְמֹנִיּוֹת. <tei:bibl>(מלאכי ג:ד)</tei:bibl></tei:l>
          <tei:l>וּפְרוֹשׂ סֻכָּת שָׁלוֹם הַמְּכוֹנֶֽנֶת</tei:l>
          <tei:l>עַל סֻכָּת דָוִד הַנּוֹפֶֽלֶת,</tei:l>
          <tei:l>עַל הָעִיר אֲשֶׁר כׇּל תְּפִלּוֹתֵֽינוּ וְכׇל בַּקָּשׁוֹתֵֽינוּ,</tei:l>
          <tei:l>כׇּל תַּחֲנוּנֵֽינוּ וְכׇל קִינוֹתֵֽינוּ,</tei:l>
          <tei:l>כׇּל שִׁירֵֽינוּ וְכׇל זְמָרֵֽינוּ,</tei:l>
          <tei:l>אֵלֶֽיהָ פּוֹנִים אֲנָֽחְנוּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tefillat_nachem_for_the_peace_of_jerusalem_on_tishah_beav_mayer/4"/>
        <tei:lg>
          <tei:l>וּלְכׇל־גּוֹיִם</tei:l>
          <tei:l>קְרָא עַל שְׁלוֹם יְרוּשָׁלַֽיִם עִיר קׇדְשֶֽׁךָ,</tei:l>
          <tei:l>וְנָשִֽׁירָה וּנְזַמְּרָה וּנְרַנְּנָה בְּהַר שְׁלוֹמֶֽךָ‪,‬</tei:l>
          <tei:l>בִֹּשְׁלוֹם עוֹלְמֵי עוֹלָמִים‎,</tei:l>
          <tei:l>כַּכָּתוּב בְּדִבְרֵי נְבִיא תִּקְוָתֶֽךָ‎ –</tei:l>
          <tei:l>כִּי בֵיתִי בֵּית־תְּפִלָּה יִקָּרֵא לְכׇל־הָעַמִּים׃ <tei:bibl>(ישעיה נו:ז)</tei:bibl></tei:l>
          <tei:l>בָּרוּךְ אַתָּה ····, מְנַחֵם צִיּוֹן וּבוֹנֵה יְרוּשָׁלָֽיִם׃</tei:l>
        </tei:lg>
      </tei:div>
