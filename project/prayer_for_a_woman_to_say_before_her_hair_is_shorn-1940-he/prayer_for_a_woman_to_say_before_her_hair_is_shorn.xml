    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_a_woman_to_say_before_her_hair_is_shorn">
        <tei:head>תְּפִלָה לְאִשָׁה לְאָמְרָהּ לִפְנֵי שֶׁמְגַלַּחַת אֶת שַׁעֲרוֹת רֹאשָׁהּ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_a_woman_to_say_before_her_hair_is_shorn/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">בְּשָׁעָה שֶׁהָאִשָּׁה מְגַלַּחַת שַׂעֲרוֹת רֹאשָׁהּ</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">עֵת רָצוֹן הִיא לִפְנֵי הַקָּדוֹשׁ בָּרוּךְ הוּא,</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">וּבְיָדָהּ לְהִתְפַּלֵל עָלֶיהָ וְעַל בַּעְלָהּ וְצֶאֱצָאֶיהָ,</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">וְכֵן עַל שְׁאָר צָרְכֵי עַם יִשְׂרָאֵל.</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_a_woman_to_say_before_her_hair_is_shorn/2"/>
        <tei:lg>
          <tei:l>הִנְנִי מוּכָנָה וּמְזֻמֶּנֶת לְקַיֵּם מִצְוַת</tei:l>
          <tei:l>”וְעָשִׂיתָ כְכׇל אֲשֶׁר יוֹרוּךָ“, <tei:bibl>(דברים יז:י חלק)</tei:bibl></tei:l>
          <tei:l>לַעֲמֹד בַּנִּסָּיוֹן לְמַעַן טָהֳרַת וּקְדֻשַּׁת יִשְׂרָאֵל,</tei:l>
          <tei:l>וּלְגַלֵּחַ אֶת שַׂעֲרוֹת רֹאשִׁי</tei:l>
          <tei:l>כְּמִנְהַג נְשׁוֹת יִשְׂרָאֵל הַכְּשֵׁרוֹת וְהַצְּנוּעוֹת.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_a_woman_to_say_before_her_hair_is_shorn/3"/>
        <tei:lg>
          <tei:l>רִבּוֹן כׇּל הָעוֹלָמִים,</tei:l>
          <tei:l>כְּשֵׁם שֶׁשָּׁמַעְתָּ אֶת תְּפִלַּת חַנָּה</tei:l>
          <tei:l>כַּאֲשֶׁר עָמְדָה בְּבֵית מִקְדָּשֵׁנוּ בִּתְפִלָּה לְפָנֶיךָ,</tei:l>
          <tei:l>כֵּן שְׁמַע נָא לְקוֹל תְּחִנַּת <tei:note type="instruction">פְּלוֹנִית בַּת פְּלוֹנִית</tei:note> אֲמָתְךָ</tei:l>
          <tei:l>בְּשָעָה זוֹ שֶאֲנִי מְגַלַּחַת אֶת שַׂעֲרוֹת רֹאשִׁי</tei:l>
          <tei:l>לַעֲשׂוֹת רְצוֹנְךָ אָבִי שֶׁבַּשָּׁמַיִם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_a_woman_to_say_before_her_hair_is_shorn/4"/>
        <tei:lg>
          <tei:l>וִיהִי רָצוֹן מִלְפָנֶיךָ,</tei:l>
          <tei:l>שֶׁיֵּחָשֵׁב מַעֲשֶׂה זֶה כְּקָרְבָּן הַמֻּנָּח עַל גַּבֵּי הַמִּזְבֵּחַ,</tei:l>
          <tei:l>וְשַׂעֲרוֹת רֹאשִׁי הַמְגֻלָּחוֹת יֵחָשְׁבוּ</tei:l>
          <tei:l>כְּשַׂעֲרוֹת הַנָּזִיר</tei:l>
          <tei:l>הַנְּתוּנוֹת בָּאֵשׁ תַּחַת זֶבַח הַשְּׁלָמִים,</tei:l>
          <tei:l>וּתְהֵא הַשָּׁעָה הַזֹּאת שְׁעַת רַחֲמִים וְעֵת רָצוֹן מִלְפָנֶיךָ,</tei:l>
          <tei:l>לִשְׁלֹחַ רְפוּאָה שְׁלֵמָה לְכׇל חוֹלֵי יִשְׂרָאֵל</tei:l>
          <tei:l>וּבִפְרָט ל<tei:note type="instruction">פב״פ</tei:note>,</tei:l>
          <tei:l>וּלְהַמְצִיא זִוּוּגִים הֲגוּנִים לִבְנֵי וְלִבְנוֹת יִשְֹרָאֵל הַצְרִיכִים לְזֶה</tei:l>
          <tei:l>וּבִפְרָט ל<tei:note type="instruction">פב״פ</tei:note>,</tei:l>
          <tei:l>וּבִזְכוּת מִצְוָה זוֹ אֶזְכֶּה</tei:l>
          <tei:l>יַחַד עִם בַּעֲלִי <tei:note type="instruction">פְּלוֹנִי בן פְּלוֹנִית</tei:note></tei:l>
          <tei:l>לִרְאוֹת בָּנִים וְּבְנֵי בָנִים עוֹסְקִים בּתּוֹרָה וּבַמִצְווֹת,</tei:l>
          <tei:l>בְּלֹא שׁוּם פְּסוּל וְשֶׁמֶץ חַס וְשָׁלוֹם,</tei:l>
          <tei:l>וּבַעֲבוֹדַת בֵּית הַמִּקְדָּשׁ נִשְׂמַח כֻּלָּנוּ,</tei:l>
          <tei:l>אָמֵן וְאָמֵן.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
