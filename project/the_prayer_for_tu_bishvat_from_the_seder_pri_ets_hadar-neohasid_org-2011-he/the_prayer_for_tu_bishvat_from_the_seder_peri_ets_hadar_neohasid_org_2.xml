    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:the_prayer_for_tu_bishvat_from_the_seder_peri_ets_hadar_neohasid_org/2">
        <tei:head>תְּפִילַּת ט״וּ בִּשְׁבָט</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_prayer_for_tu_bishvat_from_the_seder_peri_ets_hadar_neohasid_org/2/1"/>
        <tei:lg>
          <tei:l>אָנָּא הָאֵל, הָעוֹשֶׂה וְהַיּוֹצֵר וְהַבּוֹרֵא וְהַמַּאֲצִיל עוֹלָמוֹת עֶלְיוֹנִים</tei:l>
          <tei:l>וְאִילָנִין וּדְשָׁאִים מִן הָאֲדָמָה הִצְמַחְתָּ</tei:l>
          <tei:l>בְּקוֹמָתָם וּבְצִבְיוֹנָם שֶׁל מַעְלָה.</tei:l>
          <tei:l>וְזֶה הַיּרֵחַ תְּחִילַּת מַעֲשֶׂיךָ לְהַחְנִיטָם וּלְחַדְּשָם</tei:l>
          <tei:l>כִּי כֵן יִמְלְאוּ יְמֵי הַחֲנוּטִים לְפֵירוֹת הָאִילָן הָעֶלְיוֹן,</tei:l>
          <tei:l>עֵץ הַחַיִּים אֲשֶׁר בְּתוֹךְ הַגָּן.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_prayer_for_tu_bishvat_from_the_seder_peri_ets_hadar_neohasid_org/2/2"/>
        <tei:lg>
          <tei:l>וִיהִי רָצוֹן מִלְפָנֶיךָ יְיָ אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ,</tei:l>
          <tei:l>שֶׁבְּכֹחַ סְגוּלַּת אֲכִילַת הַפֵּירוֹת שֶׁנֹּאכַל וּנְבָרֵךְ עֲלֵיהֶן עַתָּה</tei:l>
          <tei:l>וַאֲשֶׁר נֶהָנֶה בְּסוֹד שָׁרְשֵהֶן</tei:l>
          <tei:l>יִתְעוֹרֵר לְהַשְׁפִּיעַ עֲלֵיהֶן שֶׁפַע רָצוֹן בְּרָכָה וּנְדָבָה,</tei:l>
          <tei:l>לְהַגְדִּילָם וּלְהַצְמִיחָם,</tei:l>
          <tei:l>לְטוֹבָה וְלִבְרָכָה לְחַיִּים טוֹבִים וּלְשָׁלוֹם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_prayer_for_tu_bishvat_from_the_seder_peri_ets_hadar_neohasid_org/2/3"/>
        <tei:lg>
          <tei:l>וְיָשׁוּב עַתָּה הַכּל לְאֵיתָנוֹ הָרִאשׁוֹן</tei:l>
          <tei:l>וְנִרְאֲתָה הַקֶשֶׁת שָׂשׂ וּמִתְפָּאֵר בְּגָווֹנִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_prayer_for_tu_bishvat_from_the_seder_peri_ets_hadar_neohasid_org/2/4"/>
        <tei:lg>
          <tei:l>וְכָל הַנִּצוֹצוֹת</tei:l>
          <tei:l>שֶׁנִּתְפַּזְּרוּ עַל יָדֵינוּ</tei:l>
          <tei:l>אוֹ עַל יְדֵי אֲבוֹתֵינוּ</tei:l>
          <tei:l>וּבְעָוֹן אָדָם הָרִאשׁוֹן אֲשֶר חָטָא בְפֵירוֹת הָאִילָן</tei:l>
          <tei:l>עַתָּה יָשׁוּבוּ לְהִתְכַּלֵּל בְּעוֹז הֲדַר עֵץ הַחַיִים‏׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
