  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/150">
        <tei:head>Psalms 150, translated by Rabbi Zalman Schachter-Shalomi</tei:head>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l><tei:hi rend="bold">Hallelu-Yah!</tei:hi> Attune to God in holiness:</tei:l>
          <tei:l>be in awe of God who is mighty in the heavens.</tei:l>
          <tei:l>mark God for His potent acts:</tei:l>
          <tei:l>praise God for Her generosity.</tei:l>
          <tei:l>Salute God with trumpet sound:</tei:l>
          <tei:l>hail God with the strings and harp.</tei:l>
          <tei:l>Worship God with drum and dance:</tei:l>
          <tei:l>Intone to God with organ and flute.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/150/5/a"/>
        <tei:lg>
          <tei:l>Make rhythm to God with crashing cymbals:</tei:l>
          <tei:l>praise God with cymbals that ring out.</tei:l>
          <tei:l>Let all who breathe chant Yah.</tei:l>
          <tei:l>
            <tei:hi rend="bold">Hallelu-Yah.</tei:hi>
          </tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
