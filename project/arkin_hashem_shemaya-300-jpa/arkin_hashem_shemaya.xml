  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:arkin_hashem_shemaya">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:arkin_hashem_shemaya/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">א</tei:seg>רכין יוי שמיא לסיני</tei:l>
          <tei:l>ואמר למשה מהימני תא סוק׃</tei:l>
          <tei:l><tei:seg type="acrostic">ב</tei:seg>ני פלטין לא יבהלונך</tei:l>
          <tei:l>דנצח יתהון סבך מן רישא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:arkin_hashem_shemaya/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ג</tei:seg>ומרין דאתון הוה נוריה דנמרד</tei:l>
          <tei:l>ולא יכיל למכוי רגלוי דסבך׃</tei:l>
          <tei:l><tei:seg type="acrostic">ד</tei:seg>ביק לית בך נורא דמלאכי</tei:l>
          <tei:l>דעמך אשא אכלא אשא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:arkin_hashem_shemaya/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ה</tei:seg>א אנא מלביש לך פורפירין דידי</tei:l>
          <tei:l>דלית גבר אחרן דתקרב לותך׃</tei:l>
          <tei:l><tei:seg type="acrostic">ו</tei:seg>קבעית קרני הודא והדרא ברישך</tei:l>
          <tei:l>דאי קריב מלאכא תנגשיניה בהון׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:arkin_hashem_shemaya/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ז</tei:seg>עירא לא תהוי באנפך משה</tei:l>
          <tei:l>דלית את ידע מה חיבתך עלי׃</tei:l>
          <tei:l><tei:seg type="acrostic">ח</tei:seg>י אנא וקיים דיברית איקונך</tei:l>
          <tei:l>עד דלית שכלילית רומא ומכא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:arkin_hashem_shemaya/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ט</tei:seg>ירוני מרומא קמו להון תמהין</tei:l>
          <tei:l>די אכסנאה הכא מנן הוא׃</tei:l>
          <tei:l><tei:seg type="acrostic">י</tei:seg>ה יהיב רישו לבשרא למקרב הכא</tei:l>
          <tei:l>ומן כדין אנן אפרופסין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:arkin_hashem_shemaya/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כ</tei:seg>ד חמון מלאכיא דעני כדין להון</tei:l>
          <tei:l>די אכסנאה אנא מהודע לכון׃</tei:l>
          <tei:l><tei:seg type="acrostic">ל</tei:seg>ענותנותא איתקרי משה</tei:l>
          <tei:l>רעוהון דבניי מהימנא דביתי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:arkin_hashem_shemaya/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מ</tei:seg>כון שמיא ורמת ארעא</tei:l>
          <tei:l>ואשכח קאים בין חיותא</tei:l>
          <tei:l><tei:seg type="acrostic">נ</tei:seg>עו מלאכין לקביל אופנין</tei:l>
          <tei:l>כד חמון למשה קריב לערפליא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:arkin_hashem_shemaya/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ש</tei:seg>ערתא דגופיה קמו להון כחדא</tei:l>
          <tei:l>דאיקונין דיעקב הוא מזדקף לקיבליה׃</tei:l>
          <tei:l><tei:seg type="acrostic">ע</tei:seg>ול וקרב לך רעוהון דבנוי</tei:l>
          <tei:l>צוח מן כרסייה מלאכא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:arkin_hashem_shemaya/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פ</tei:seg>סול לך לוחין [מן] סמפרינון</tei:l>
          <tei:l>מן כרסייה דמלכא חייא׃</tei:l>
          <tei:l><tei:seg type="acrostic">צ</tei:seg>היל הוה ליביה דמשה וחדי</tei:l>
          <tei:l>דהוה רחמנא אפילוגוס דידיה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:arkin_hashem_shemaya/10"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ק</tei:seg>ריבו מלאכיא קדם כרסייה דקיריס</tei:l>
          <tei:l>ואמרין בבעו לא ישלט בן</tei:l>
          <tei:l><tei:seg type="acrostic">ר</tei:seg>ישא דכיפא בחוטריה תבר</tei:l>
          <tei:l>ואנן קשיין ליה למנגשא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:arkin_hashem_shemaya/11"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ש</tei:seg>די אמר ליה לא תדחל משה</tei:l>
          <tei:l>דמימרי יהא לך בסעדך׃</tei:l>
          <tei:l><tei:seg type="acrostic">ת</tei:seg>יסב אוריתא ותיתוב לך בשלם</tei:l>
          <tei:l>דלא אשכחית בנביאי כוותך׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
