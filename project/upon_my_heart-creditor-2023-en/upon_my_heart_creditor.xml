  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:upon_my_heart_creditor">
        <tei:head>Upon My Heart, a prayer-poem by Rabbi Menachem Creditor</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:upon_my_heart_creditor/1"/>
        <tei:lg>
          <tei:l>my heart keeps breaking</tei:l>
          <tei:l>so I grip it and feel something hard</tei:l>
          <tei:l>pressed up against it.</tei:l>
          <tei:l>and I know. I’ve always known</tei:l>
          <tei:l>but I know differently now.</tei:l>
          <tei:l>I hear my family’s heartbeat</tei:l>
          <tei:l>when I sleep and when I wake,</tei:l>
          <tei:l>walking on the way and sitting at home.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:upon_my_heart_creditor/2"/>
        <tei:lg>
          <tei:l>Listen, Israel:</tei:l>
          <tei:l>I place these words</tei:l>
          <tei:l>between my eyes</tei:l>
          <tei:l>and upon my heart.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
