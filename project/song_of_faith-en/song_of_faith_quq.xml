  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:song_of_faith_quq">
        <tei:head>Song of Faith, by Rabbi Avraham Yitsḥaq haKohen Ḳooḳ (ca. 1919)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:song_of_faith_quq/1"/>
        <tei:lg>
          <tei:l>Forever in our hearts lives<tei:anchor xml:id="note_1"/></tei:l>
          <tei:l>the loyal faith</tei:l>
          <tei:l>to return to our holy land,</tei:l>
          <tei:l>[and] the city where David encamped.<tei:anchor xml:id="note_2"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:song_of_faith_quq/2"/>
        <tei:lg>
          <tei:l>There we shall stand [to receive] our destiny,</tei:l>
          <tei:l>[which the] father of many [nations]<tei:anchor xml:id="note_3"/> acquired.</tei:l>
          <tei:l>There we shall live our life —</tei:l>
          <tei:l>the life of the innumerable community.<tei:anchor xml:id="note_4"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:song_of_faith_quq/3"/>
        <tei:lg>
          <tei:l>There we shall serve <j:divineName>our elo’ah</j:divineName></tei:l>
          <tei:l>with joy, happiness, and song.</tei:l>
          <tei:l>There we shall pilgrimage</tei:l>
          <tei:l>three times a year.<tei:anchor xml:id="note_5"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:song_of_faith_quq/4"/>
        <tei:lg>
          <tei:l>A Torah of Life is our desire,</tei:l>
          <tei:l>given from the mouth of <j:divineName>Elyon</j:divineName>.</tei:l>
          <tei:l>Eternal is our heritage.</tei:l>
          <tei:l>From the Wilderness it was gifted.<tei:anchor xml:id="note_6"/></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
