    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:deror_yiqra_dunash">
        <tei:head>דְּרוֹר יִקְרָא</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:deror_yiqra_dunash/1"/>
        <tei:lg>
          <tei:l>דְּרוֹר יִקְרָא</tei:l>
          <tei:l>לְבֵן עִם בַּת,</tei:l>
          <tei:l>וְיִנְצָרְכֶם כְּמוֹ בָבַת,</tei:l>
          <tei:l>נְעִים שִׁמְכֶם וְלֹא יֻשְׁבַּת,</tei:l>
          <tei:l>שְׁבוּ וְנֽוּחוּ בְּיוֹם שַׁבָּת.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:deror_yiqra_dunash/2"/>
        <tei:lg>
          <tei:l>דְּרוֹשׁ נָוִי וְאוּלָמִי,</tei:l>
          <tei:l>וְאוֹת יֶֽשַׁע עֲשֵׂה עִמִּי,</tei:l>
          <tei:l>נְטַע שׂוֹרֵק בְּתוֹךְ כַּרְמִי,</tei:l>
          <tei:l>שְׁעֵה שַׁוְעַת בְּנֵי עַמִּי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:deror_yiqra_dunash/3"/>
        <tei:lg>
          <tei:l>דְּרוֹךְ פּוּרָה בְּתוֹךְ בָּצְרָה,</tei:l>
          <tei:l>וְגַם בָּבֶל אֲשֶׁר גָּבְרָה,</tei:l>
          <tei:l>נְתוֹץ צָרַי בְּאַף וְעֶבְרָה,</tei:l>
          <tei:l>שְׁמַע קוֹלִי בְּיוֹם אֶקְרָא.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:deror_yiqra_dunash/4"/>
        <tei:lg>
          <tei:l>אֱלֹהִים תֵּן בַּמִּדְבָּר הַר,</tei:l>
          <tei:l>הֲדַס שִׁטָּה</tei:l>
          <tei:l>בְּרוֹשׁ תִּדְהָר,</tei:l>
          <tei:l>וְלַמַּזְהִיר</tei:l>
          <tei:l>וְלַנִּזְהָר,</tei:l>
          <tei:l>שְׁלוֹמִים תֵּן כְּמֵי נָהָר.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:deror_yiqra_dunash/5"/>
        <tei:lg>
          <tei:l>הֲדוֹךְ קָמַי אֵל קַנָּא,</tei:l>
          <tei:l>בְּמוֹג לֵבָב</tei:l>
          <tei:l>וּבַמְּגִנָּה,</tei:l>
          <tei:l>וְנַרְחִיב פֶּה וּנְמַלֶּֽאנָה,</tei:l>
          <tei:l>לְשׁוֹנֵנוּ לְךָ רִנָּה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:deror_yiqra_dunash/6"/>
        <tei:lg>
          <tei:l>דְּעֵה חָכְמָה לְנַפְשֶׁךָ,</tei:l>
          <tei:l>וְהִיא כֶֽתֶר לְרֹאשֶׁךָ,</tei:l>
          <tei:l>נְצוֹר מִצְוַת קְדוֹשֶׁךָ,</tei:l>
          <tei:l>שְׁמוֹר שַׁבַּת קָדְשֶׁךָ.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
