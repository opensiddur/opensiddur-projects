  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:gebed_voor_het_koninklijk_huis">
        <tei:head>הַנּוֹתֵן תְּשׁוּעָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gebed_voor_het_koninklijk_huis/1"/>
        <tei:lg>
          <tei:l>הַנּוֹתֵן תְּשׁוּעָה לַמְּלָכִים,</tei:l>
          <tei:l>וּמֶמְשָׁלָה לַנְּסִיכִים,</tei:l>
          <tei:l>מַלְכוּתוֹ מַלְכוּת כׇּל־עוֹלָמִים.</tei:l>
          <tei:l>הַפּוֹצֶה אֶת דָּוִד עַבְדּוֹ, מֵחֶֽרֶב רָעָה.</tei:l>
          <tei:l>הַנּוֹתֵן בַּיָּם דֶּֽרֶךְ,</tei:l>
          <tei:l>וּבְמַֽיִם עַזִּים נְתִיבָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gebed_voor_het_koninklijk_huis/2"/>
        <tei:lg>
          <tei:l>הוּא יְבָרֵךְ, וְיִשְׁמוֹר,</tei:l>
          <tei:l>וְיִנְצוֹר, וְיַעֲזוֹר,</tei:l>
          <tei:l>וִירוֹמֵם, וִיגַדֵּל,</tei:l>
          <tei:l>וִינַשֵּׂא לְמַֽעְלָה לְמַֽעְלָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gebed_voor_het_koninklijk_huis/4"/>
        <tei:lg>
          <tei:l>מֶֽלֶךְ מַלְכֵי הַמְּלָכִים</tei:l>
          <tei:l>בְּרַחֲמָיו, יִשְׁמְרֵם וִיְחַיֵם,</tei:l>
          <tei:l>וּמִכׇּל־צָרָה וָנֶֽזֶק יַצִּילֵם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gebed_voor_het_koninklijk_huis/5"/>
        <tei:lg>
          <tei:l>מֶֽלֶךְ מַלְכֵי הַמְּלָכִים</tei:l>
          <tei:l>בְּרַחֲמָיו, יָרִים וְיַגְבִּיהַּ כּוֹכַב מַעֲרַכְתָּם,</tei:l>
          <tei:l>וְיַאֲרִיכוּ יָמִים עַל מֶמְשַׁלְתָּם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gebed_voor_het_koninklijk_huis/6"/>
        <tei:lg>
          <tei:l>מֶֽלֶךְ מַלְכֵי הַמְּלָכִים</tei:l>
          <tei:l>בְּרַחֲמָיו, יִתֵּן בְּלִבָּם</tei:l>
          <tei:l>וּבְלֵב כׇּל־יוֹעֲצֵיהֶם וְשָׂרֵיהֶם,</tei:l>
          <tei:l>לַעֲשׂוֹת טוֹבָה עִמָּֽנוּ,</tei:l>
          <tei:l>וְעִם כׇּל יִשְׂרָאֵל אַחֵינוּ,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:gebed_voor_het_koninklijk_huis/7"/>
        <tei:lg>
          <tei:l>בִּימֵיהֶם וּבְיָמֵֽינוּ</tei:l>
          <tei:l>תִּוָּשַׁע יְהוּדָה,</tei:l>
          <tei:l>וְיִשְׂרָאֵל יִשְׁכּוֹן לָבֶטַח,</tei:l>
          <tei:l>וּבָא לְצִיּוֹן גּוֹאֵל,</tei:l>
          <tei:l>וְכֵן יְהִי רָצוֹן</tei:l>
          <tei:l>וָנֹאמַר אָמֵן:</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
