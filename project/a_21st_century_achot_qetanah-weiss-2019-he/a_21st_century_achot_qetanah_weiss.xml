      <tei:div corresp="urn:x-opensiddur:text:poem:a_21st_century_achot_qetanah_weiss">
        <tei:head>אחות קטנה במאה ה -21</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_21st_century_achot_qetanah_weiss/1"/>
        <tei:lg>
          <tei:l>למיטל הדרה, נ״י</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>”חכמה כ״ח המ״ה המורה על הרחמים“ <tei:bibl>(פרדס רמונים ח:ח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_21st_century_achot_qetanah_weiss/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הָ</tei:seg>אָחוֹת נְתָאֵר כִּקְטַנָּה</tei:l>
          <tei:l>לִפְנֵי שֶׁנָּבִין אֶת־עִקַּר מָהוּתָהּ</tei:l>
          <tei:l>חֲלוֹמוֹתֶיהָ וּתְפִלּוֹתֶיהָ</tei:l>
          <tei:l>עֲטֶרֶת שְׁאִיפוֹתֶיהָ</tei:l>
          <tei:l>אָךְ אֵיךְ נָבִין אֶת־קִלְלוֹתֶֽיהָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_21st_century_achot_qetanah_weiss/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ר</tei:seg>וֹאָה אֲנִי אֶת־מַאֲבָקֶֽיהָ</tei:l>
          <tei:l>אֵיךְ תִּתְמוֹדֵד עִם חֹֽסֶר הִגָּיוֹן וְשׂוֹנְאֶיהָ</tei:l>
          <tei:l>אוֹהֲבֶֽיהָ נְטָשֽׁוּהָ וְהִיא גַלְמוּדָה בְּהִשָּׁבֵר לִבָּהּ</tei:l>
          <tei:l>כַּמָּה שָׁנִים הִיא כְּבָר נִשְׁכָּֽחָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_21st_century_achot_qetanah_weiss/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>לֵב נִשְׁבָּר הִיא מִתְנַפֶּלֶת בִּתְפִלּוֹתֶֽיהָ</tei:l>
          <tei:l>מָרוֹת וְרַבּוֹת הַבָּעוֹתֶֽיהָ</tei:l>
          <tei:l>אָךְ תִּקְוָה תַצְמִֽיחַ וְתִפְרַח כְּנַחֲלוֹתֶֽיהָ</tei:l>
          <tei:l>וְהִיא תְשׁוּשָׁה מִכְּמִיהָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_21st_century_achot_qetanah_weiss/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רַ</tei:seg>בּוֹת בָּנוֹת עָֽשוּ חַֽיִל</tei:l>
          <tei:l>כָּךְ אָמַר הַגֶּֽבֶר</tei:l>
          <tei:l>שֶׁשָּׁכַח אוֹתָךְ לְרֶֽגַע</tei:l>
          <tei:l>נִפְרַד מִמֵּךְ לְפֶֽתַע</tei:l>
          <tei:l>וְאַת מְלֵאַת רֵֽתַע</tei:l>
          <tei:l>אַיֵּה הַזְּמָן הַנֶּעְלַם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_21st_century_achot_qetanah_weiss/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חֶ</tei:seg>מְלָה יֵשׁ לִי לָאָחוֹת הַקְּטַנָּה</tei:l>
          <tei:l>מַכְאוֹבָהּ וְסִפּוּרֶֽיהָ הֲרֵינִי מַאֲמִינָה</tei:l>
          <tei:l>קֹֽשִׁי מַצָּבָהּ</tei:l>
          <tei:l>מֻכָּרִים לִי הֵיטֵב</tei:l>
          <tei:l>וְאֶת־מְקוֹרוֹת חַיֶּֽיהָ</tei:l>
          <tei:l>מַכִּירָה אֲנִי אֶת־קִלְלוֹתֶיהָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_21st_century_achot_qetanah_weiss/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">לָֽ</tei:seg>מָּה תִסְבְּלִי, אָחוֹתִי הַקְּטַנָּה</tei:l>
          <tei:l>לָֽמָה גוֹרָלֵךְ מְעֻנֶּה</tei:l>
          <tei:l>עָתִידֵךְ לְבֶהָלָה</tei:l>
          <tei:l>מְלֹא סַכָּנָה</tei:l>
          <tei:l>הַלְוַאי נִשְׁכַּח אֶת־כׇּל־הַקְּלָלָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_21st_century_achot_qetanah_weiss/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חַ</tei:seg>כִּי, אָמְרוּ לָךְ,</tei:l>
          <tei:l>עַד שֶׁתְּגַדְּלִי</tei:l>
          <tei:l>אָז תִּהְיֶה לָךְ</tei:l>
          <tei:l>בְּחִירָה חׇפְשִׁית</tei:l>
          <tei:l>וּשְׁמַעְתִּים בֶּאֱמוּנָה וּבִתְמִיהָה</tei:l>
          <tei:l>כִּי כְּבָר הִכַּרְתְּ אֶת־אׇפְיָם הַפׇּגְעָנִי</tei:l>
          <tei:l>מַחֲווֹת קִלְלוֹתֶֽיהָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_21st_century_achot_qetanah_weiss/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נִ</tei:seg>תְמוֹדֵד עִם הַקֹּֽשִׁי</tei:l>
          <tei:l>הֲרֵי</tei:l>
          <tei:l>אַתְּ וַאֲנִי</tei:l>
          <tei:l>בְּהִתְנַגְּדוּת אַמִּיצָה קוֹלָנִית</tei:l>
          <tei:l>נַפְסִיק מִלְּבַקֵּשׁ מְחִילָה</tei:l>
          <tei:l>סוֹף סוֹף נִדְרֹשׁ כׇּל־בְּרָכָה</tei:l>
          <tei:l>תִכְלֶה שָׁנָה וְקִלְלוֹתֶֽיהָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_21st_century_achot_qetanah_weiss/10"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הִ</tei:seg>נָּךְ עַזָּה רַעְיָתִי</tei:l>
          <tei:l>אֲחוֹתִי הַקְּטַנָּה</tei:l>
          <tei:l>זֹאת הַקְּטַנָּה לִגְדוֹלָה תִהְיֶה</tei:l>
          <tei:l>תָחֵל שָׁנָה וּבִרְכוֹתֶֽיהָ</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
