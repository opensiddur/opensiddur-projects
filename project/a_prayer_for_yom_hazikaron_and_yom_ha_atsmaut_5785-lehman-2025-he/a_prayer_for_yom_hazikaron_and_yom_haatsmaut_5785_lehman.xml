    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_prayer_for_yom_hazikaron_and_yom_haatsmaut_5785_lehman">
        <tei:head>תְּפִלָּה לְיוֹם הַזִּכָּרוֹן וְיוֹם הָעַצְמָאוּת</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_yom_hazikaron_and_yom_haatsmaut_5785_lehman/1"/>
        <tei:lg>
          <tei:l>אֲבִינוּ שֶׁבַּשָּׁמַיִם</tei:l>
          <tei:l>צוּר יִשְׂרָאֵל וְגוֹאֲלוֹ</tei:l>
          <tei:l>בָּאִים אָנוּ לְפָנֶיךָ</tei:l>
          <tei:l>בְּעַיִן דּוֹמַעַת</tei:l>
          <tei:l>וּבְלֵב שָׁבוּר –</tei:l>
          <tei:l>הַמַּאֲמִין בַּטּוֹב</tei:l>
          <tei:l>וּמְבַקֵּשׁ נֶחָמָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_yom_hazikaron_and_yom_haatsmaut_5785_lehman/2"/>
        <tei:lg>
          <tei:l>רִשְׁעֵי עוֹלָם פָּגְעוּ בָּנוּ.</tei:l>
          <tei:l>הָרְגוּ וְחֲטְפוּ</tei:l>
          <tei:l>נָשִׁים, גְּבָרִים וָטַף</tei:l>
          <tei:l>וְחִלְּלוּ צֶלֶם אֱלֹהִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_yom_hazikaron_and_yom_haatsmaut_5785_lehman/3"/>
        <tei:lg>
          <tei:l>וּכְנֶגְדָּם</tei:l>
          <tei:l>אֶזְרָחִים וְחַיָּלִים מַסְרוּ נַפְשָׁם</tei:l>
          <tei:l>וּבִגְבוּרָה, מַאֲמָץ וּנְחִישוּת</tei:l>
          <tei:l>יָצְאוּ לְמִלְחָמָה</tei:l>
          <tei:l>וְזָקְפוּ אֶת כְּבוֹד יִשְׂרָאֵל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_yom_hazikaron_and_yom_haatsmaut_5785_lehman/4"/>
        <tei:lg>
          <tei:l>כְּאֵב וְגַאֲוָה מְצִיפִים אֶת לִבֵּנוּ</tei:l>
          <tei:l>כְּאֵב עַל הַמַּכּוֹת הַקָּשׁוֹת שֶׁסָּפַגְנוּ</tei:l>
          <tei:l>וְגַאֲוָה עַל הַגְּבוּרָה הָעִלָּאִית שֶׁרָאִינוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_yom_hazikaron_and_yom_haatsmaut_5785_lehman/5"/>
        <tei:lg>
          <tei:l>וּבְלֵב שָׁבוּר הַמַּאֲמִין בַּטּוֹב</tei:l>
          <tei:l>פּוֹרְסִים אָנוּ יָדֵינוּ לְפָנֶיךָ</tei:l>
          <tei:l>שֶׁתְּמַלֵּא אוֹתָנוּ וְאֶת הָעוֹלָם כֻּלּוֹ</tei:l>
          <tei:l>בְּתִקְוָה וּבְנֶחָמָה</tei:l>
          <tei:l>בְחַיִּים וּבְשָׁלוֹם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_yom_hazikaron_and_yom_haatsmaut_5785_lehman/6"/>
        <tei:lg>
          <tei:l>הָשֵׁב אֶת כׇּל חֲטוּפֵינוּ</tei:l>
          <tei:l>רַפֵּא אֶת כׇּל פְּצוּעֵינוּ</tei:l>
          <tei:l>הַגְבֵּר אֶת הָאַחְדוּת בֵּינֵנוּ</tei:l>
          <tei:l>וּפְקַח אֶת עֵינֵנוּ</tei:l>
          <tei:l>לִרְאוֹת אֶת כׇּל הַטּוֹב שֶׁיֵּשׁ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_yom_hazikaron_and_yom_haatsmaut_5785_lehman/7"/>
        <tei:lg>
          <tei:l>תֵּן לָנוּ כֹּחַ</tei:l>
          <tei:l>לְהִתְגַּבֵּר עַל הַכְּאֵב וְהַשְּׁכוֹל,</tei:l>
          <tei:l>לְסַיֵּעַ לְכׇל הַנִּצְרָכִים</tei:l>
          <tei:l>וּלְהַמְשִׁיךְ לִבְנוֹת וּלְשַׁכְלֵל</tei:l>
          <tei:l>אֶת מְדִינָתֵנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_yom_hazikaron_and_yom_haatsmaut_5785_lehman/8"/>
        <tei:lg>
          <tei:l>וְיִתְקַיֵּם בָּנוּ מִקְרָא שֶׁכָּתוּב:</tei:l>
          <tei:l>”קוּמִי אוֹרִי כִּי בָא אוֹרֵךְ</tei:l>
          <tei:l>וּכְבוֹד ה׳ עָלַיִךְ זָרָח“ <tei:bibl>(ישעיה ס:א)</tei:bibl>.</tei:l>
          <tei:l>וְנֹאמַר אָמֵן</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
