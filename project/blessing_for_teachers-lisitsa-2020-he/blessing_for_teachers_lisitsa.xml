    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:blessing_for_teachers_lisitsa">
        <tei:head>ברכה למורים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_for_teachers_lisitsa/1"/>
        <tei:lg>
          <tei:l>מִי שֶׁחָנֵן אֶת רַבָּנֵינוּ בּאַהֲבַת הַלִּמּוּד,</tei:l>
          <tei:l>הוּא יְבָרֵךְ אֶתְכֶם בְּסַקְרָנוּת,</tei:l>
          <tei:l>לַהַט הוֹרָאָה וְאַהֲבַת הַסֵּפֶר וְהַחָכְמָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_for_teachers_lisitsa/2"/>
        <tei:lg>
          <tei:l>מִי שֶׁחָנֵן אֶת נְבִיאֵי וּנְבִיאוֹת יִשְׂרָאֵל בִּמְסִירוּת הַנֶּפֶשׁ,</tei:l>
          <tei:l>הוּא יִטַּע בָּכֶם אֶת הַכֹּחַ לְהַתְמִיד,</tei:l>
          <tei:l>וִיחַזֵּק אֶת הָאֱמוּנָה שֶׁבַּדֶּרֶךְ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_for_teachers_lisitsa/3"/>
        <tei:lg>
          <tei:l>מִי שֶּׁבֵּרַךְ אֶת שִׁבְטֵי יִשְׂרָאֵל בְּרוּחַ הַיַּחַד, הָאַחֲוָה, הַשּׁוֹנוּת וְהָאַחְרָיוּת,</tei:l>
          <tei:l>הוּא יַנְחֶה אֶת כֻּלְכֶם בְּרוּחוֹ לְפְעֹל</tei:l>
          <tei:l>לְמַעַן קִיּוּם אֱנוֹשִׁי וְחֶבְרָתִי בְּצַלְמוֹ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessing_for_teachers_lisitsa/4"/>
        <tei:lg>
          <tei:l>כְּשֵׁם שֶׁנִּתְבָּרַכְנוּ בָּכֶם הַמּוֹרִים וְהַמּוֹרוֹת,</tei:l>
          <tei:l>כָּךְ תִּתְבָּרְכוּ בְּדַעַת עוֹלָמִים, חֵן וְחֶסֶד וְרַחֲמִים.</tei:l>
          <tei:l>יָאֵר יהוה לִבְּכֶם בֶּאֱמוּנָה,</tei:l>
          <tei:l>וְבְכֹחַ לְהַנְהִיג.</tei:l>
        </tei:lg>
      </tei:div>
