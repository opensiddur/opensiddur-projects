    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/150">
        <tei:head>תהלים ק״נ בלשון לאדינו</tei:head>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>הַ֥לְלוּ יָ֨הּ ׀</tei:l>
          <tei:l>הַֽלְלוּ־אֵ֥ל בְּקָדְשׁ֑וֹ</tei:l>
          <tei:l>הַֽ֝לְל֗וּהוּ בִּרְקִ֥יעַ עֻזּֽוֹ׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>הַֽלְל֥וּהוּ בִגְבוּרֹתָ֑יו</tei:l>
          <tei:l>הַֽ֝לְל֗וּהוּ כְּרֹ֣ב גֻּדְלֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/150/3/a"/>
        <tei:lg>
          <tei:l>הַֽ֭לְלוּהוּ בְּתֵ֣קַע שׁוֹפָ֑ר</tei:l>
          <tei:l>הַֽ֝לְל֗וּהוּ בְּנֵ֣בֶל וְכִנּֽוֹר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/150/4/a"/>
        <tei:lg>
          <tei:l>הַֽ֭לְלוּהוּ בְתֹ֣ף וּמָח֑וֹל</tei:l>
          <tei:l>הַֽ֝לְל֗וּהוּ בְּמִנִּ֥ים וְעוּגָֽב׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/150/5/a"/>
        <tei:lg>
          <tei:l>הַֽלְל֥וּהוּ בְצִלְצְלֵי־שָׁ֑מַע</tei:l>
          <tei:l>הַֽ֝לְל֗וּהוּ בְּֽצִלְצְלֵ֥י תְרוּעָֽה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/150/6"/>
        <tei:lg>
          <tei:l>כֹּ֣ל הַ֭נְּשָׁמָה תְּהַלֵּ֥ל יָ֗הּ</tei:l>
          <tei:l>הַֽלְלוּ־יָֽהּ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
