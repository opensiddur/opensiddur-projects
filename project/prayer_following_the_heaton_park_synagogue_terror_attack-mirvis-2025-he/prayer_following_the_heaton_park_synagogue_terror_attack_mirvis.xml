  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_following_the_heaton_park_synagogue_terror_attack_mirvis">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_following_the_heaton_park_synagogue_terror_attack_mirvis/1"/>
        <tei:lg>
          <tei:l>אבינו שבשמים, אדון העולמים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_following_the_heaton_park_synagogue_terror_attack_mirvis/4"/>
        <tei:lg>
          <tei:l>שכתוב</tei:l>
          <tei:l>הַעִדֹתִי בָכֶם הַיּוֹם</tei:l>
          <tei:l>אֶת־הַשָּׁמַיִם וְאֶת־הָאָרֶץ</tei:l>
          <tei:l>הַחַיִּים וְהַמָּוֶת</tei:l>
          <tei:l>נָתַתִּי לְפָנֶיךָ</tei:l>
          <tei:l>הַבְּרָכָה וְהַקְּלָלָה</tei:l>
          <tei:l>וּבָחַרְתָּ בַּחַיִּים לְמַעַן תִּחְיֶה</tei:l>
          <tei:l>אַתָּה וְזַרְעֶךָ׃ <tei:bibl>(דברים ל:יט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_following_the_heaton_park_synagogue_terror_attack_mirvis/5"/>
        <tei:lg>
          <tei:l>שכתוב</tei:l>
          <tei:l>וְנָתַתִּי לָכֶם לֵב חָדָשׁ</tei:l>
          <tei:l>וְרוּחַ חֲדָשָׁה אֶתֵּן בְּקִרְבְּכֶם</tei:l>
          <tei:l>וַהֲסִרֹתִי אֶת־לֵב הָאֶבֶן מִבְּשַׂרְכֶם</tei:l>
          <tei:l>וְנָתַתִּי לָכֶם לֵב בָּשָׂר׃ <tei:bibl>(יחזקאל לו:כו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_following_the_heaton_park_synagogue_terror_attack_mirvis/6"/>
        <tei:lg>
          <tei:l>ה׳</tei:l>
          <tei:l>שְׁמֹר וְהָגֵן עָלֵינוּ</tei:l>
          <tei:l>פּוֹרֵס סֻכַּת שְׁלוֹמֶֽךָ</tei:l>
          <tei:l>עַל־כָּל־יוֹשְׁבֵי תֵּבֵל אַרְצֶךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_following_the_heaton_park_synagogue_terror_attack_mirvis/7"/>
        <tei:lg>
          <tei:l>וכן יהי רצון</tei:l>
          <tei:l>ונאמר אמן</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
