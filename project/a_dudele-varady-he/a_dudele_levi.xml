  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:a_dudele_levi">
        <tei:head>א דוּדעלע (אַיֵּה אֶמְצָאֶךָּ)‏</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_dudele_levi/1"/>
        <tei:lg>
          <tei:l>רִבּוֹנוֹ שֶׁל עוֹלָם</tei:l>
          <tei:l>רִבּוֹנוֹ שֶׁל עוֹלָם</tei:l>
          <tei:l>רִבּוֹנוֹ שֶׁל עוֹלָם</tei:l>
          <tei:l>רִבּוֹנוֹ שֶׁל עוֹלָם</tei:l>
          <tei:l>רִבּוֹנוֹ שֶׁל עוֹלָם!</tei:l>
          <tei:l>אֲנִי רוֹצֶה לָשִׁיר לְךָ שִׁיר!</tei:l>
          <tei:l>אַתָּה־אַתָּה־אַתָּה</tei:l>
          <tei:l>אַתָּה־אַתָּה —</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_dudele_levi/2"/>
        <tei:lg>
          <tei:l>אַיֵּה אֶמְצָאֶךָּ?</tei:l>
          <tei:l>וְאַיֵּה לֹא אֶמְצָאֶךָּ?</tei:l>
          <tei:l>אָנָה אֶמְצָאֶךָּ?</tei:l>
          <tei:l>אַךְ אָנָה לֹא אֶמְצָאֶךָּ?</tei:l>
          <tei:l>אַתָּה־אַתָּה־אַתָּה</tei:l>
          <tei:l>אַתָּה־אַתָּה —</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_dudele_levi/3"/>
        <tei:lg>
          <tei:l>אוֹי, אִם אֲנִי אֵלֵךְ – אַתָּה</tei:l>
          <tei:l>אִם אֲנִי נִשְׁאָר – אַתָּה</tei:l>
          <tei:l>רַק אַתָּה</tei:l>
          <tei:l>תָּמִיד אַתָּה</tei:l>
          <tei:l>פֹּה אַתָּה</tei:l>
          <tei:l>שָׁם אַתָּה —</tei:l>
          <tei:l>אַתָּה־אַתָּה־אַתָּה</tei:l>
          <tei:l>אַתָּה־אַתָּה!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_dudele_levi/4"/>
        <tei:lg>
          <tei:l>כְּשֶׁזֶּה טוֹב – אַתָּה</tei:l>
          <tei:l>כְּשֶׁזֶּה, חָלִילָה, רַע –</tei:l>
          <tei:l>אוֹי, אַתָּה;</tei:l>
          <tei:l>אוֹי, אַתָּה־אַתָּה־אַתָּה־אַתָּה־אַתָּה־אַתָּה!</tei:l>
          <tei:l>אַתָּה־אַתָּה־אַתָּה־אַתָּה־אַתָּה־אַתָּה־אַתָּה!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_dudele_levi/5"/>
        <tei:lg>
          <tei:l>מִזְרָח – אַתָּה,</tei:l>
          <tei:l>מַעֲרָב – אַתָּה,</tei:l>
          <tei:l>צָפוֹן – אַתָּה,</tei:l>
          <tei:l>דָּרוֹם – אַתָּה!</tei:l>
          <tei:l>אַתָּה־אַתָּה־אַתָּה</tei:l>
          <tei:l>אַתָּה־אַתָּה־אַתָּה</tei:l>
          <tei:l>אַתָּה־אַתָּה־אַתָּה!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_dudele_levi/6"/>
        <tei:lg>
          <tei:l>שָׁמַיִם – אַתָּה</tei:l>
          <tei:l>אֶרֶץ – אַתָּה</tei:l>
          <tei:l>מַעְלָה – אַתָּה</tei:l>
          <tei:l>מַטֶּה – אַתָּה!</tei:l>
          <tei:l>אַתָּה־אַתָּה־אַתָּה</tei:l>
          <tei:l>אַתָּה־אַתָּה־אַתָּה</tei:l>
          <tei:l>אַתָּה־אַתָּה־אַתָּה</tei:l>
          <tei:l>אַתָּה־אַתָּה־אַתָּה</tei:l>
          <tei:l>אַתָּה אַתָּה אַתָּה!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:a_dudele_levi/7"/>
        <tei:lg>
          <tei:l>לְאָן אֲנִי עוֹבֵר</tei:l>
          <tei:l>וּלְאָן אֲנִי חוֹזֵר –</tei:l>
          <tei:l>אַתָּה – אַתָּה!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
