  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ena_katsiki_a_yevanic_translation_of_had_gadya">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ena_katsiki_a_yevanic_translation_of_had_gadya/1"/>
        <tei:lg>
          <tei:l>Éna katsíki</tei:l>
          <tei:l>pou m’agóras’ o patéras mou,</tei:l>
          <tei:l>me dyo áspra.</tei:l>
          <tei:l>Éna katsíki, éna katsíki.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ena_katsiki_a_yevanic_translation_of_had_gadya/2"/>
        <tei:lg>
          <tei:l>Kai írthe i gáta</tei:l>
          <tei:l>kai éfage to katsíki</tei:l>
          <tei:l>pou m’agóras’ o patéras mou,</tei:l>
          <tei:l>me dyo áspra.</tei:l>
          <tei:l>Éna katsíki, éna katsíki.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ena_katsiki_a_yevanic_translation_of_had_gadya/3"/>
        <tei:lg>
          <tei:l>Kai írthe o skýlos</tei:l>
          <tei:l>kai éfage ti gáta</tei:l>
          <tei:l>pou éfage to katsíki</tei:l>
          <tei:l>pou m’agóras’ o patéras mou,</tei:l>
          <tei:l>me dyo áspra.</tei:l>
          <tei:l>Éna katsíki, éna katsíki.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ena_katsiki_a_yevanic_translation_of_had_gadya/4"/>
        <tei:lg>
          <tei:l>Kai írthe to xýlo</tei:l>
          <tei:l>kai évárese to skýlo</tei:l>
          <tei:l>pou éfage ti gáta</tei:l>
          <tei:l>kai éfage to katsíki</tei:l>
          <tei:l>pou m’agóras’ o patéras mou,</tei:l>
          <tei:l>me dyo áspra.</tei:l>
          <tei:l>Éna katsíki, éna katsíki.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ena_katsiki_a_yevanic_translation_of_had_gadya/5"/>
        <tei:lg>
          <tei:l>Kai írthe i fotiá</tei:l>
          <tei:l>kai ékaige to xýlo</tei:l>
          <tei:l>pou évárese to skýlo</tei:l>
          <tei:l>pou éfage ti gáta</tei:l>
          <tei:l>kai éfage to katsíki</tei:l>
          <tei:l>pou m’agóras’ o patéras mou,</tei:l>
          <tei:l>me dyo áspra.</tei:l>
          <tei:l>Éna katsíki, éna katsíki.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ena_katsiki_a_yevanic_translation_of_had_gadya/6"/>
        <tei:lg>
          <tei:l>Kai írthe to neró</tei:l>
          <tei:l>kai ésvine ti fotiá</tei:l>
          <tei:l>pou ékaige to xýlo</tei:l>
          <tei:l>pou évárese to skýlo</tei:l>
          <tei:l>pou éfage ti gáta</tei:l>
          <tei:l>kai éfage to katsíki</tei:l>
          <tei:l>pou m’agóras’ o patéras mou,</tei:l>
          <tei:l>me dyo áspra.</tei:l>
          <tei:l>Éna katsíki, éna katsíki.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ena_katsiki_a_yevanic_translation_of_had_gadya/7"/>
        <tei:lg>
          <tei:l>Kai írthe o ageláda</tei:l>
          <tei:l>kai ípie to neró</tei:l>
          <tei:l>pou ésvine ti fotiá</tei:l>
          <tei:l>pou ékaige to xýlo</tei:l>
          <tei:l>pou évárese to skýlo</tei:l>
          <tei:l>pou éfage ti gáta</tei:l>
          <tei:l>kai éfage to katsíki</tei:l>
          <tei:l>pou m’agóras’ o patéras mou,</tei:l>
          <tei:l>me dyo áspra.</tei:l>
          <tei:l>Éna katsíki, éna katsíki.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ena_katsiki_a_yevanic_translation_of_had_gadya/8"/>
        <tei:lg>
          <tei:l>Kai írthe o chasápi</tei:l>
          <tei:l>kai ésfaxe tin ageláda</tei:l>
          <tei:l>pou ípie to neró</tei:l>
          <tei:l>pou ésvine ti fotiá</tei:l>
          <tei:l>pou ékaige to xýlo</tei:l>
          <tei:l>pou várese to skylí</tei:l>
          <tei:l>pou éfage ti gáta</tei:l>
          <tei:l>pou éfage to katsíki</tei:l>
          <tei:l>pou m’agóras’ o patéras mou,</tei:l>
          <tei:l>me dyo áspra.</tei:l>
          <tei:l>Éna katsíki, éna katsíki.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ena_katsiki_a_yevanic_translation_of_had_gadya/9"/>
        <tei:lg>
          <tei:l>Kai írthe o thanatos,</tei:l>
          <tei:l>kai ésfaxe ton chasápi</tei:l>
          <tei:l>pou ésfaxe tin ageláda</tei:l>
          <tei:l>pou ípie to neró</tei:l>
          <tei:l>pou ésvine ti fotiá</tei:l>
          <tei:l>pou ékaige to xýlo</tei:l>
          <tei:l>pou várese to skýlo</tei:l>
          <tei:l>pou éfage ti gáta</tei:l>
          <tei:l>pou éfage to katsíki</tei:l>
          <tei:l>pou m’agóras’ o patéras mou,</tei:l>
          <tei:l>me dyo áspra.</tei:l>
          <tei:l>Éna katsíki, éna katsíki.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ena_katsiki_a_yevanic_translation_of_had_gadya/10"/>
        <tei:lg>
          <tei:l>Kai írthe aKantosi Mparouchou</tei:l>
          <tei:l>kai ésfaxe to thanatou,</tei:l>
          <tei:l>pou ésfaxe ton chasápi</tei:l>
          <tei:l>pou ésfaxe tin ageláda</tei:l>
          <tei:l>pou ípie to neró</tei:l>
          <tei:l>pou ésvine ti fotiá</tei:l>
          <tei:l>pou ékaige to xýlo</tei:l>
          <tei:l>pou várese to skýlo</tei:l>
          <tei:l>pou éfage ti gáta</tei:l>
          <tei:l>pou éfage to katsíki</tei:l>
          <tei:l>pou m’agóras’ o patéras mou,</tei:l>
          <tei:l>me dyo áspra.</tei:l>
          <tei:l>Éna katsíki, éna katsíki.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
