  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/113">
        <tei:head>תהלים קי״ג</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/113/1/a"/>
        <tei:lg>
          <tei:l>הַלְלוּ־יָהּ הַלְלוּ עַבְדֵי יְהֹוָה</tei:l>
          <tei:l>הַלְלוּ אֶת־שֵׁם יְהֹוָה׃</tei:l>
          <tei:l>יְהִי שֵׁם יְהֹוָה מְבֹרָךְ</tei:l>
          <tei:l>מֵעַתָּה וְעַד־עוֹלָם׃</tei:l>
          <tei:l>מִמִּזְרַח־שֶׁמֶשׁ עַד־מְבוֹאוֹ</tei:l>
          <tei:l>מְהֻלָּל שֵׁם יְהֹוָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>רָם עַל־כׇּל־גּוֹיִם יְהֹוָה</tei:l>
          <tei:l>עַל הַשָּׁמַיִם כְּבוֹדוֹ׃</tei:l>
          <tei:l>מִי כַּיהֹוָה אֱלֹהֵינוּ הַמַּגְבִּיהִי לָשָׁבֶת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/113/6/a"/>
        <tei:lg>
          <tei:l>הַמַּשְׁפִּילִי לִרְאוֹת</tei:l>
          <tei:l>בַּשָּׁמַיִם וּבָאָרֶץ׃</tei:l>
          <tei:l>מְקִימִי מֵעָפָר דָּל</tei:l>
          <tei:l>מֵאַשְׁפֹּת יָרִים אֶבְיוֹן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/113/8/a"/>
        <tei:lg>
          <tei:l>לְהוֹשִׁיבִי עִם־נְדִיבִים</tei:l>
          <tei:l>עִם נְדִיבֵי עַמּוֹ׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>מוֹשִׁיבִי עֲקֶרֶת הַבַּיִת</tei:l>
          <tei:l>אֵם־הַבָּנִים</tei:l>
          <tei:l>שְׂמֵחָה הַלְלוּ־יָהּ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
