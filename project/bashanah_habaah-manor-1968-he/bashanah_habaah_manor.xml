  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:bashanah_habaah_manor">
        <tei:head>בַּשָּׁנָה הַבָּאָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bashanah_habaah_manor/1"/>
        <tei:lg>
          <tei:l>בַּשָּׁנָה הַבָּאָה</tei:l>
          <tei:l>נֵשֵׁב עַל הַמִּרְפֶּסֶת</tei:l>
          <tei:l>וְנִסְפֹּר צִפֳּרִים נוֹדְדוֹת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bashanah_habaah_manor/2"/>
        <tei:lg>
          <tei:l>יְלָדִים בְּחֻפְשָׁה</tei:l>
          <tei:l>יְשַׂחֲקוּ תּוֹפֶסֶת</tei:l>
          <tei:l>בֵין הַבַּיִת לְבֵין הַשָּׂדוֹת.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bashanah_habaah_manor/3"/>
        <tei:lg>
          <tei:l>עוֹד תִּרְאֶה עוֹד תִּרְאֶה</tei:l>
          <tei:l>כַּמָּה טוֹב יִהְיֶה</tei:l>
          <tei:l>בַּשָּׁנָה בַּשָּׁנָה הַבָּאָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bashanah_habaah_manor/4"/>
        <tei:lg>
          <tei:l>עֲנָבִים אֲדֻמִּים</tei:l>
          <tei:l>יַבְשִׁילוּ עַד הָעֶרֶב</tei:l>
          <tei:l>וְיֻגְּשׁוּ צוֹנְנִים לַשֻּׁלְחָן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bashanah_habaah_manor/5"/>
        <tei:lg>
          <tei:l>וְרוּחוֹת רְדוּמִים</tei:l>
          <tei:l>יִשְׂאוּ אֶל אֵם הַדֶּרֶךְ</tei:l>
          <tei:l>עִתּוֹנִים יְשָׁנִים וְעָנָן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bashanah_habaah_manor/6"/>
        <tei:lg>
          <tei:l>בַּשָּׁנָה הַבָּאָה</tei:l>
          <tei:l>נִפְרֹשׂ כַּפּוֹת יָדַיִם</tei:l>
          <tei:l>מוּל הָאוֹר הַנִּגָּר הַלָּבָן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bashanah_habaah_manor/7"/>
        <tei:lg>
          <tei:l>אֲנָפָה לְבָנָה</tei:l>
          <tei:l>תִּפְרֹשׂ בָּאוֹר כְּנָפַיִם</tei:l>
          <tei:l>וְהַשֶּׁמֶשׁ תִּזְרַח בְּתוֹכָן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:bashanah_habaah_manor/8"/>
        <tei:lg>
          <tei:l>עוֹד תִּרְאֶה...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
