  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/150">
        <tei:head>Psalms 150, translated by Isaac Gantwerk Mayer</tei:head>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>Praise <j:divineName>the SOURCE</j:divineName>!</tei:l>
          <tei:l>Praise <j:divineName>the CAUSE</j:divineName> in holiness,</tei:l>
          <tei:l>praise <j:divineName>God</j:divineName> in the firmament.</tei:l>
          <tei:l>Praise <j:divineName>God</j:divineName> in acts of glory,</tei:l>
          <tei:l>praise <j:divineName>God</j:divineName> for manifold greatness.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/150/3/a"/>
        <tei:lg>
          <tei:l>Praise <j:divineName>God</j:divineName> with blast of the shofar,</tei:l>
          <tei:l>praise <j:divineName>God</j:divineName> with lute and lyre,</tei:l>
          <tei:l>Praise <j:divineName>God</j:divineName> with drum and dance,</tei:l>
          <tei:l>praise <j:divineName>God</j:divineName> with harp and pipe.</tei:l>
          <tei:l>Praise <j:divineName>God</j:divineName> with cymbals sounding,</tei:l>
          <tei:l>praise <j:divineName>God</j:divineName> with cymbals resounding.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/150/6"/>
        <tei:lg>
          <tei:l>Let all with breath praise <j:divineName>the SOURCE</j:divineName>,</tei:l>
          <tei:l>praise <j:divineName>the SOURCE</j:divineName>!</tei:l>
          <tei:l>Let all with breath praise <j:divineName>the SOURCE</j:divineName>,</tei:l>
          <tei:l>praise <j:divineName>the SOURCE</j:divineName>!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
