      <tei:div corresp="urn:x-opensiddur:text:prayer:a_prayer_for_election_days_mayer">
        <tei:head>תְּפִלָּה לִימֵי בְּחִירוֹת</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_election_days_mayer/2"/>
        <tei:lg>
          <tei:l>הַנּוֹתֵן מֶמְשָׁלָה לְמוֹשְׁלִים</tei:l>
          <tei:l>וְשִׁלְטוֹן לְשׇׁלְטָנִים</tei:l>
          <tei:l>וְאַחְרָיוּת לָאֶזְרָחִים</tei:l>
          <tei:l>הַמֵּקִים שׁוֹפְטֵי צֶֽדֶק</tei:l>
          <tei:l>וְהַמַּשְׁפִּיל עֲרִֽיצֵי רָֽשָׁע</tei:l>
          <tei:l>הוּא יְבָרֵךְ וְיָאִיר וְיַשְׂכִּיל</tei:l>
          <tei:l>וְיִתֵּן חׇכְמָה וּבִינָה</tei:l>
          <tei:l>בְּלִבּוֹת כׇּל־מַצְבִּיעֵי הָאָֽרֶץ הַזֹּאת</tei:l>
          <tei:l>בְּיוֹם הַבְּחִירוֹת הַזֶּה</tei:l>
          <tei:l>לְהַצְבִּֽיעַ וְלִבְחֹר לָהֶם</tei:l>
          <tei:l>מֽוֹשְׁלֵי־צֶֽדֶק וְשֽׁוֹלְטֵי־יֹֽשֶׁר</tei:l>
          <tei:l>שֶׁיַּעַבְדוּ וְשֶׁיַּעַמְלוּ וְשֶׁיִּפְעֲלוּ</tei:l>
          <tei:l>בְּעַד טוֹבַת הָאָֽרֶץ</tei:l>
          <tei:l>וּבְעַד טוֹבַת הָעָם</tei:l>
          <tei:l>וּבְעַד טוֹבַת כׇּל־בָּאֵי הָעוֹלָם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_election_days_mayer/3"/>
        <tei:lg>
          <tei:l>וְלֹא כׇּל־הָרְשָׁעִים</tei:l>
          <tei:l>הֶעָרִיצִים וְהַמֻּשְׁחָתִים</tei:l>
          <tei:l>לֽוֹקְחֵי־שֹֽׁחַד אַנְשֵׁי־חָמָס וּבְנֵי־בְּלִיַּֽעַל</tei:l>
          <tei:l>כְּמוֹ שֶׁאָמַֽרְנוּ בְּלֵב שָׁלֵם בִּימֵי דִּינֵֽנוּ</tei:l>
          <tei:l>כִּי תַּעֲבִיר מֶמְשֶֽׁלֶת זָדוֹן מִן־הָאָֽרֶץ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_election_days_mayer/4"/>
        <tei:lg>
          <tei:l>תְּנֶֽנּוּ שֶׁנָּקִים וְשֶׁנַּעֲמִיד שׁוֹפְטִים יְשָׁרִים בְּעֵינֶֽיךָ</tei:l>
          <tei:l>וּבְעֵינֵי כׇּל־רוֹאֵֽינוּ</tei:l>
          <tei:l>כַּכָּתוּב בְּדִבְרֵי תּוֹרָתֶֽךָ —</tei:l>
          <tei:l>שֹׁפְטִ֣ים וְשֹֽׁטְרִ֗ים תִּֽתֶּן־לְךָ֙ בְּכׇל־שְׁעָרֶ֔יךָ</tei:l>
          <tei:l>אֲשֶׁ֨ר יְהֹוָ֧ה אֱלֹהֶ֛יךָ נֹתֵ֥ן לְךָ֖ לִשְׁבָטֶ֑יךָ</tei:l>
          <tei:l>וְשָׁפְט֥וּ אֶת־הָעָ֖ם מִשְׁפַּט־צֶֽדֶק׃ <tei:bibl>(דברים טז:יח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_election_days_mayer/5"/>
        <tei:lg>
          <tei:l>וְעַל־יְדֵי מַלְכְּךָ מְשִׁיחֶֽךָ שֶׁבּוֹ בָחַֽרְתָּ כָּתוּב —</tei:l>
          <tei:l>וְ֭עַתָּה מְלָכִ֣ים הַשְׂכִּ֑ילוּ</tei:l>
          <tei:l>הִ֝וָּסְר֗וּ שֹׁ֣פְטֵי אָֽרֶץ׃ <tei:bibl>(תהלים ב:י)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_election_days_mayer/6"/>
        <tei:lg>
          <tei:l>וּבְדִבְרֵי נְבִיאֶֽיךָ כָּתוּב לֵאמֹר —</tei:l>
          <tei:l>וַיָּ֥קֶם יְהֹוָ֖ה שֹׁפְטִ֑ים</tei:l>
          <tei:l>וַיּ֣וֹשִׁיע֔וּם מִיַּ֖ד שֹׁסֵיהֶֽם׃ <tei:bibl>(שופטים ב:טז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_election_days_mayer/7"/>
        <tei:lg>
          <tei:l>כִּי אַתָּה שׁוֹמֵֽעַ לְזַעֲקַת הָעָם</tei:l>
          <tei:l>וְיִוָּדַע בְּכׇל־יְצִירֶֽיךָ</tei:l>
          <tei:l>שֶׁמֶּֽלֶךְ אוֹהֵב צְדָקָה וּמִשְׁפַּט אָֽתָּה׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
