    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_prayer_for_the_kaiser">
        <tei:head>הַנּוֹתֵן תְּשׁוּעָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_the_kaiser/1"/>
        <tei:lg>
          <tei:l>הַנּוֹתֵן תְּשׁוּעָה לַמְּלָכִים</tei:l>
          <tei:l>וּמֶמְשָׁלָה לַנְּסִיכִים</tei:l>
          <tei:l>מַלְכוּתוֹ מַלְכוּת כׇּל עוֹלָמִים</tei:l>
          <tei:l>הַפּוֹצֶה אֶת־דָּוִד עַבְדּוֹ מֵחֶֽרֶב רָעָה</tei:l>
          <tei:l>הַנּוֹתֵן בַּיָּם דָּֽרֶךְ</tei:l>
          <tei:l>וּבְמַֽיִם עַזִּים נְתִיבָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_the_kaiser/2"/>
        <tei:lg>
          <tei:l>הוּא יְבָרֵךְ וְיִשְׁמוֹר וְיִנְצוֹר וְיַעֲזוֹר</tei:l>
          <tei:l>וִירוֹמֵם וִיגַדֵּל וִינַשֵּׂא לְמַֽעְלָה</tei:l>
          <tei:l>אֶת אֲדוֹנֵֽינוּ הַקֵּיסָר</tei:l>
          <tei:l>ניקאלאי אלכסנדראװיטש</tei:l>
          <tei:l>עִם אִשְׁתּוֹ הֲקֵיסָרֶיהָ הַכְבוֹדָהּ</tei:l>
          <tei:l>אלכסנדרא פעאדראװנא</tei:l>
          <tei:l>וְעִם אִמּוֹ הַקֵּיסָרִית הַכְבוֹדָהּ</tei:l>
          <tei:l>מאריא פעאדראװנא</tei:l>
          <tei:l>וְאֶת יוֹרֵשׁ הָעֶצֶר</tei:l>
          <tei:l>גערגי אלכסנדראװיטש</tei:l>
          <tei:l>יָרוּם הוֹדָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_the_kaiser/3"/>
        <tei:lg>
          <tei:l>מֶֽלֶךְ מַלְכֵי הַמְּלָכִים</tei:l>
          <tei:l>בְּרַחֲמָיו יְחַיֵּֽהוּ וְיִשְׁמְרֵֽהוּ</tei:l>
          <tei:l>וּמִכׇּל צָרָה וְיָגוֹן וָנֶֽזֶק יַצִּילֵֽהוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_the_kaiser/4"/>
        <tei:lg>
          <tei:l>וַיְדַבֵּר עַמִּים תַּחַת רַגְלָיו</tei:l>
          <tei:l>וְיַפִּיל שׂוֹנְאָיו לְפָנָיו</tei:l>
          <tei:l>וּבְכָל אֲשֶׁר יִפְנֶה יַצְלִיחַ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_the_kaiser/5"/>
        <tei:lg>
          <tei:l>מֶלֶךְ מַלְכֵי הַמְּלָכִים</tei:l>
          <tei:l>בְּרַחֲמָיו יִתֵּן בְּלִבּוֹ</tei:l>
          <tei:l>וּבְלֵב כׇּל יוֹעֲצָיו וְשָׂרָיו</tei:l>
          <tei:l>רַחֲמָנוֹת לַעֲשׂוֹת טוֹבוֹת עִמָּנוּ</tei:l>
          <tei:l>וְעִם כׇּל יִשְׂרָאֵל.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_the_kaiser/6"/>
        <tei:lg>
          <tei:l>בְּיָמָיו וּבְיָמֵינוּ תִּוָּשַׁע יְהוּדָה.</tei:l>
          <tei:l>וְיִשְׂרָאֵל יִשְׁכּוֹן לָבֶטַח</tei:l>
          <tei:l>וּבָא לְצִיּוֹן גּוֹאֵל.</tei:l>
          <tei:l>וְכֵן יְהִי רָצוֹן</tei:l>
          <tei:l>וְנֺאמַר אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
