      <tei:div corresp="urn:x-opensiddur:text:poem:ad_an_tsvi_mudach_yehudah">
        <tei:head>עַד־אָן צְבִי מֻדָּח</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_an_tsvi_mudach_yehudah/1"/>
        <tei:lg>
          <tei:l>עַד־אָן צְבִי מֻדָּח וְאֵין מְקַבֵּץ לוֹ</tei:l>
          <tei:l>נִגַּשׂ וְגַם־נֶאֱנָח גָּבַר מְאֹד חִילוֹ</tei:l>
          <tei:l>יִצְעַק וּמַר יִצְרַח מְאֹד עַל־שֹׁד חֶבְלוֹ</tei:l>
          <tei:l>וּמְחָרְפוֹ וּמְגַדְּפוֹ וַיִּרְדְּפוֹ</tei:l>
          <tei:l>עַל־צַוָּארוֹ שָׂם עֹל׃</tei:l>
          <tei:l>יַשְׁמִיד וְלֹא־יַחְמֹל וְהוּא־יִסְבֹּל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_an_tsvi_mudach_yehudah/2"/>
        <tei:lg>
          <tei:l>וָאֶצְעַק חָמָס לָאֵל וְאֵין־עֹנֶה</tei:l>
          <tei:l>עַל־כֵּן מְאֹד נָמָס לִבִּי וְגַם נַעֲנֶה</tei:l>
          <tei:l>גַּבִּי אֲשַׁו מִרְמָס אֶל־זָר וְאֶל־מוֹנֶה</tei:l>
          <tei:l>וְאֶדְאָֽגָה מִדְּאָגָה וְאֶשְׁאָֽגָה</tei:l>
          <tei:l>מִבּוֹר עָמֹק כִּשְׁאוֹל׃</tei:l>
          <tei:l>יַשְׁמִיד וְלֹא־יַחְמֹל וְהוּא־יִסְבֹּל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_an_tsvi_mudach_yehudah/3"/>
        <tei:lg>
          <tei:l>יָרְשׁוּ בְּנֵי זָרִים כׇּל־מַחְמַד עֵינַי</tei:l>
          <tei:l>וַיֵּלְכוּ בַגּוֹלָה שְׁבָטַי וְגַם־בָּנַי</tei:l>
          <tei:l>וַיַּעֲשׂוּ כָלָה קׇדְשִׁי וּמִשְׁכָּנִי</tei:l>
          <tei:l>הָרְגוּ בְאַף נָשִׁים וְטַף כָּרְתוּ עָנָף</tei:l>
          <tei:l>צוֹרְרַי וְנָתְנוּ קוֹל׃</tei:l>
          <tei:l>יַשְׁמִיד וְלֹא־יַחְמֹל וְהוּא־יִסְבֹּל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ad_an_tsvi_mudach_yehudah/4"/>
        <tei:lg>
          <tei:l>פּוֹעֵל יְשׁוּעוֹת אֵל עוּרָה וְהִנָּשֵׂא</tei:l>
          <tei:l>וּפְדֵה בְרַחֲמִים אֵל עַם־דַּל בְּךָ חוֹסֶה</tei:l>
          <tei:l>מַהֵר וְחִישׁ גּוֹאֵל לָֽנוּ יְהִי מַחְסֶה</tei:l>
          <tei:l>אֵל יוֹצְרִי שְׁלַח צֳרִי כִּי אֵין צוּרִי</tei:l>
          <tei:l>בִּלְעָדֶֽיךָ לִגְאֹל׃</tei:l>
          <tei:l>כִּי אֵין צוּרִי בִּלְעָדֶֽיךָ לִגְאֹל׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
