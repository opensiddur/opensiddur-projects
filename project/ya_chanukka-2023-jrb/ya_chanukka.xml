  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ya_chanukka">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ya_chanukka/1"/>
        <tei:lg>
          <tei:l>יָא חַנוּכָּה̈, יָא חַנוּכָּה̈</tei:l>
          <tei:l>בֵּין אַלְאַעְיָאדּ תַּלְמַעִין!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ya_chanukka/2"/>
        <tei:lg>
          <tei:l>פֿוֹקָא כֻּל֘ עִידִּן אַנְתְּ</tei:l>
          <tei:l>וַבִּכִּי נַחְנוּ פַֿרִחִין!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ya_chanukka/3"/>
        <tei:lg>
          <tei:l>לִנַחְתַּפִֿל בִּחֻרִ֘יַ֘תְּנָא</tei:l>
          <tei:l>פִֿי לֵילָאתּ תַֿמָאן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ya_chanukka/4"/>
        <tei:lg>
          <tei:l>יָא סֻפְנָאגּ, מִן אַגְּלִנָא,</tei:l>
          <tei:l>אִקְלִי אֲלְעַגִּין!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ya_chanukka/5"/>
        <tei:lg>
          <tei:l>וַבֵּינַמָא נֻגְּמַע</tei:l>
          <tei:l>תֻּחְרַקוּ נָאר אלֲזֵ֘יתּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ya_chanukka/6"/>
        <tei:lg>
          <tei:l>אֲלְאַצְ֗וָא תֻּצָ֗אוּ לִתַּדְֿכִּירֻנָא</tei:l>
          <tei:l>עַן תַּקְדִּיס אַלְמֻכָּאבִּיִ֘ין לִאלְבֵּיתּ!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
