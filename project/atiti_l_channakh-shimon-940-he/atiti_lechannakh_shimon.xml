    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:atiti_lechannakh_shimon">
        <tei:head>אָתִֽיתִי לְחַנְּנָךְ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:atiti_lechannakh_shimon/1"/>
        <tei:lg>
          <tei:l>מִסּוֹד חֲכָמִים וּנְבוֹנִים</tei:l>
          <tei:l>וּמִלֶּֽמֶד דַּֽעַת מְבִינִים</tei:l>
          <tei:l>אֶפְתְּחָה פִי בִּתְפִלָּה וּבְתַחֲנוּנִים</tei:l>
          <tei:l>לְחַלּוֹת וּלְחַנֵּן פְּנֵי מֶֽלֶךְ</tei:l>
          <tei:l>מַלְכֵי הַמְּלָכִים וַאֲדוֹנֵי הָאֲדוֹנִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:atiti_lechannakh_shimon/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אָ</tei:seg>תִֽיתִי לְחַנְּנָךְ בְּלֵב קָרֽוּעַ וּמֻרְתָּח</tei:l>
          <tei:l><tei:seg type="acrostic">בַּ</tei:seg>קֵּשׁ רַחֲמִים כְּעָנִי בַפֶּֽתַח</tei:l>
          <tei:l><tei:seg type="acrostic">גַּ</tei:seg>לְגֵּל רַחֲמֶֽיךָ וְדִין אַל תִּמְתַּח׃</tei:l>
          <tei:l>אֲ֭דֹנָי שְׂפָתַ֣י תִּפְתָּ֑ח׃ <tei:bibl>(תהלים נא:יז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:atiti_lechannakh_shimon/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">דָּ</tei:seg>בָר אֵין בְּפִי וּבִלְשׁוֹנִי מִלָּה</tei:l>
          <tei:l><tei:seg type="acrostic">הֵ</tei:seg>ן יְהֹוָה יָדַֽעְתָּ כֻלָּהּ</tei:l>
          <tei:l><tei:seg type="acrostic">וּ</tei:seg>מִמַּעֲמַקֵּי הַלֵּב לְפָנֶֽיךָ אוֹחִֽילָה׃</tei:l>
          <tei:l>אֶ֥חֱסֶ֨ה בְסֵ֖תֶר כְּנָפֶ֣יךָ סֶּֽלָה׃ <tei:bibl>(תהלים סא:ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:atiti_lechannakh_shimon/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זַ</tei:seg>לְעָפָה וּפַלָּצוּת אֲחָזֽוּנִי בְמוֹרָא</tei:l>
          <tei:l><tei:seg type="acrostic">חַ</tei:seg>לּוֹת פְּנֵי נוֹרָא בְּנֶֽפֶשׁ יְקָרָה</tei:l>
          <tei:l><tei:seg type="acrostic">ט</tei:seg>וּב טַעַם וָדַעַת קָטֹנְתִּי לְחַסְּרָה׃</tei:l>
          <tei:l>עַל־כֵּ֖ן זָחַ֥לְתִּי וָאִירָ֓א׃ <tei:bibl>(איוב סא:ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:atiti_lechannakh_shimon/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>גַעְתִּי בְאַנְחָתִי אֵיךְ לַעֲמוֹד לְפָנֶֽיךָ׃</tei:l>
          <tei:l><tei:seg type="acrostic">כִּ</tei:seg>י אֵין מַעֲשִׂים לְזַכּוֹת בְּעֵינֶֽיךָ</tei:l>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>חַלּוֹתְךָ שְׁלָחֽוּנִי מַקְהֲלוֹת הֲמוֹנֶֽךָ׃</tei:l>
          <tei:l>תָּכִ֥ין לִ֝בָּ֗ם תַּקְשִׁ֥יב אׇזְנֶֽךָ׃ <tei:bibl>(תהלים י:יז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:atiti_lechannakh_shimon/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מָ</tei:seg>ה אֲנִי וּמֶה חַיַּי תּוֹלֵעָה וְרִמָּה</tei:l>
          <tei:l><tei:seg type="acrostic">נִ</tei:seg>בְעַר מִדַּֽעַת וּבְאֶֽפֶס מְזִמָּה</tei:l>
          <tei:l><tei:seg type="acrostic">סָ</tei:seg>מַֽכְתִּי יְתֵדוֹתַי בְּסֵֽפֶר הַחׇכְמָה׃</tei:l>
          <tei:l>מַֽעֲנֶה־רַּ֭ךְ יָשִׁ֣יב חֵמָ֑ה׃ <tei:bibl>(משלי טו:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:atiti_lechannakh_shimon/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">עֻ</tei:seg>זִּי אֵלֶֽיךָ אֶשְׁמְרָה לְסַעֲדִי</tei:l>
          <tei:l><tei:seg type="acrostic">פֵּֽ</tei:seg>תַח דְּבָרֶֽיךָ הָאֵר לְהַגִּידִי</tei:l>
          <tei:l><tei:seg type="acrostic">צַ</tei:seg>דְּקֵֽנִי וְאַמְּצֵֽנִי וְתֵן לְאֵל יָדִי׃</tei:l>
          <tei:l>כִּֽי־אֱלֹהִ֥ים מִ֝שְׂגַּבִּ֗י אֱלֹהֵ֥י חַסְדִּֽי׃ <tei:bibl>(תהלים נט:יח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:atiti_lechannakh_shimon/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קְ</tei:seg>הָלֶֽיךָ עוֹמְדִים לְבַקֵּשׁ מְחִילָתֶֽךָ</tei:l>
          <tei:l><tei:seg type="acrostic">רַ</tei:seg>חֲמֶיךָ יִכְמְרוּ לְרַחֲמָם בְּחֶמְלָתֶֽךָ</tei:l>
          <tei:l><tei:seg type="acrostic">שׁ</tei:seg>וֹפְכִים לֵב כַּמַּֽיִם לְעֻמָּתֶֽךָ׃</tei:l>
          <tei:l>וְ֠אַתָּ֠ה תִּשְׁמַ֨ע הַשָּׁמַ֜יִם מְכ֤וֹן שִׁבְתֶּ֙ךָ֙׃ <tei:bibl>(מלכים א׳ ח:לט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:atiti_lechannakh_shimon/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">תְּ</tei:seg>חַזֵּק לְעַמְּךָ יָדָם הָרָפָה</tei:l>
          <tei:l><tei:seg type="acrostic">שְׁ</tei:seg>לַח <tei:seg type="acrostic">מֵ</tei:seg>אִתְּךָ <tei:seg type="acrostic">עֵֽ</tei:seg>זֶר <tei:seg type="acrostic">וּ</tei:seg>תְרוּפָה</tei:l>
          <tei:l><tei:seg type="acrostic">נ</tei:seg>וֹאֲמֶֽיךָ יַשִּׂיגוּ לְחַזֵּק וּלְתׇקְפָה</tei:l>
          <tei:l>כׇּל־אִמְרַ֣ת אֱל֣וֹהַּ צְרוּפָ֑ה׃ <tei:bibl>(משלי ל:ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:atiti_lechannakh_shimon/10"/>
        <tei:lg>
          <tei:l>בּוֹ שׁׄוּעַֽנְנוּ מֵׄעׄוֹלָם וַׄיַּעֲנֵנֽוּ נׄוֹרָאוֹת</tei:l>
          <tei:l>בְּׄרִׄצּׄוּׄי חִׄנּוּנֵֽנוּ קַׄבֵּל כְּהַעֲלָאוֹת</tei:l>
          <tei:l>יְׄחַׄלְּצֵֽנוּ בְּמָגִנּוֹ מִתַּחֲלוּאֵיׄ תוֹצָאוֹת</tei:l>
          <tei:l>כְּצִפֳּרִ֣ים עָפ֔וֹת כֵּ֗ן יָגֵ֛ן יְהֹוָ֥ה צְבָא֖וֹת <tei:bibl>(משלי ל:ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:atiti_lechannakh_shimon/11"/>
        <tei:lg>
          <tei:l>זׇכְרֵֽנוּ לְחַיִּים...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
