  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/1"/>
        <tei:lg>
          <tei:l>
            <tei:bibl>קהלת ט:יד-טו</tei:bibl>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/2"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">יד</tei:hi> עִ֣יר קְטַנָּ֔ה וַאֲנָשִׁ֥ים בָּ֖הּ מְעָ֑ט</tei:l>
          <tei:l>וּבָֽא־אֵלֶ֜יהָ מֶ֤לֶךְ גָּדוֹל֙ וְסָבַ֣ב אֹתָ֔הּ וּבָנָ֥ה עָלֶ֖יהָ מְצוֹדִ֥ים גְּדֹלִֽים׃</tei:l>
          <tei:l><tei:hi rend="superscript">טו</tei:hi> וּמָ֣צָא בָ֗הּ אִ֤ישׁ מִסְכֵּן֙ חָכָ֔ם וּמִלַּט־ה֥וּא אֶת־הָעִ֖יר בְּחָכְמָת֑וֹ</tei:l>
          <tei:l>וְאָדָם֙ לֹ֣א זָכַ֔ר אֶת־הָאִ֥ישׁ הַמִּסְכֵּ֖ן הַהֽוּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/4"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>אֲשֶׁר קִדְּשָׁנוּ בְּמִצְוֺתָיו</tei:l>
          <tei:l>וְצִוָּֽנוּ עַל נְטִילַת לוּלָב׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/5"/>
        <tei:lg>
          <tei:l>
            <tei:bibl>קהלת א:ה-ז</tei:bibl>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/6"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ד</tei:hi> דּ֤וֹר הֹלֵךְ֙ וְד֣וֹר בָּ֔א</tei:l>
          <tei:l>וְהָאָ֖רֶץ לְעוֹלָ֥ם עֹמָֽדֶת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/7"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ה</tei:hi> וְזָרַ֥ח הַשֶּׁ֖מֶשׁ</tei:l>
          <tei:l>וּבָ֣א הַשָּׁ֑מֶשׁ</tei:l>
          <tei:l>וְאֶ֨ל־מְקוֹמ֔וֹ שׁוֹאֵ֛ף זוֹרֵ֥חַֽ ה֖וּא שָֽׁם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/8"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ו</tei:hi> הוֹלֵךְ֙ אֶל־דָּר֔וֹם</tei:l>
          <tei:l>וְסוֹבֵ֖ב אֶל־צָפ֑וֹן</tei:l>
          <tei:l>סוֹבֵ֤ב׀ סֹבֵב֙ הוֹלֵ֣ךְ</tei:l>
          <tei:l>הָר֔וּחַ וְעַל־סְבִיבֹתָ֖יו שָׁ֥ב הָרֽוּחַ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/9"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ז</tei:hi> כָּל־הַנְּחָלִים֙ הֹלְכִ֣ים אֶל־הַיָּ֔ם</tei:l>
          <tei:l>וְהַיָּ֖ם אֵינֶ֣נּוּ מָלֵ֑א</tei:l>
          <tei:l>אֶל־מְק֗וֹם שֶׁ֤הַנְּחָלִים֙ הֹֽלְכִ֔ים</tei:l>
          <tei:l>שָׁ֛ם הֵ֥ם שָׁבִ֖ים לָלָֽכֶת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/11"/>
        <tei:lg>
          <tei:l>
            <tei:bibl>תהלים קיח:א</tei:bibl>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/12"/>
        <tei:lg>
          <tei:l>הוֹד֣וּ לַיְיָ כִּי־ט֑וֹב</tei:l>
          <tei:l>כִּ֖י לְעוֹלָ֣ם חַסְדּֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/13"/>
        <tei:lg>
          <tei:l>הוֹד֣וּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/14"/>
        <tei:lg>
          <tei:l>לַיְיָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/15"/>
        <tei:lg>
          <tei:l>כִּי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/16"/>
        <tei:lg>
          <tei:l>ט֑וֹב</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/17"/>
        <tei:lg>
          <tei:l>כִּ֖י</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/18"/>
        <tei:lg>
          <tei:l>לְעוֹלָ֣ם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/19"/>
        <tei:lg>
          <tei:l>חַסְדּֽוֹ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/20"/>
        <tei:lg>
          <tei:l>
            <tei:bibl>תהלים קיח:ב</tei:bibl>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/21"/>
        <tei:lg>
          <tei:l>יֹֽאמַר־נָ֥א יִשְׂרָאֵ֑ל</tei:l>
          <tei:l>כִּ֖י לְעוֹלָ֣ם חַסְדּֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/22"/>
        <tei:lg>
          <tei:l>יֹֽאמַר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/23"/>
        <tei:lg>
          <tei:l>נָ֥א</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/24"/>
        <tei:lg>
          <tei:l>יִשְׂרָאֵ֑ל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/25"/>
        <tei:lg>
          <tei:l>כִּ֖י</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/26"/>
        <tei:lg>
          <tei:l>לְעוֹלָ֣ם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/27"/>
        <tei:lg>
          <tei:l>חַסְדּֽוֹ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/29"/>
        <tei:lg>
          <tei:l>אָנָּ֣א יְ֭יָ הוֹשִׁ֘יעָ֥ה נָּ֑א</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/30"/>
        <tei:lg>
          <tei:l>אָנָּ֣א</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/31"/>
        <tei:lg>
          <tei:l>יְ֭יָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/32"/>
        <tei:lg>
          <tei:l>הוֹשִׁ֘יעָ֥ה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/33"/>
        <tei:lg>
          <tei:l>נָּ֑א</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/34"/>
        <tei:lg>
          <tei:l>
            <tei:bibl>קהלת ט:י</tei:bibl>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:occupy_the_lulav_the_ritual_for_shaking_the_four_species_spatz/35"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">י</tei:hi> כֹּ֠ל אֲשֶׁ֨ר תִּמְצָ֧א יָֽדְךָ֛ לַעֲשׂ֥וֹת בְּכֹחֲךָ֖ עֲשֵׂ֑ה</tei:l>
          <tei:l>כִּי֩ אֵ֨ין מַעֲשֶׂ֤ה וְחֶשְׁבּוֹן֙ וְדַ֣עַת וְחָכְמָ֔ה בִּשְׁא֕וֹל אֲשֶׁ֥ר אַתָּ֖ה הֹלֵ֥ךְ שָֽׁמָּה׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>