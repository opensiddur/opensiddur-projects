    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/12">
        <tei:head>תהלים י״ב בלשון לאדינו</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/12/1-9"/>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">א</tei:hi> לַמְנַצֵּ֥חַ</tei:l>
          <tei:l>עַֽל־הַשְּׁמִינִ֗ית</tei:l>
          <tei:l>מִזְמ֥וֹר לְדָוִֽד׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ב</tei:hi> הוֹשִׁ֣יעָה יְ֭הוָה</tei:l>
          <tei:l>כִּי־גָמַ֣ר חָסִ֑יד</tei:l>
          <tei:l>כִּי־פַ֥סּוּ אֱ֝מוּנִ֗ים מִבְּנֵ֥י אָדָֽם׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ג</tei:hi> שָׁ֤וְא ׀ יְֽדַבְּרוּ֮ אִ֤ישׁ אֶת־רֵ֫עֵ֥הוּ</tei:l>
          <tei:l>שְׂפַ֥ת חֲלָק֑וֹת</tei:l>
          <tei:l>בְּלֵ֖ב וָלֵ֣ב יְדַבֵּֽרוּ׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ד</tei:hi> יַכְרֵ֣ת יְ֭הוָה כָּל־שִׂפְתֵ֣י חֲלָק֑וֹת</tei:l>
          <tei:l>לָ֝שׁ֗וֹן מְדַבֶּ֥רֶת גְּדֹלֽוֹת׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ה</tei:hi> אֲשֶׁ֤ר אָֽמְר֨וּ ׀</tei:l>
          <tei:l>לִלְשֹׁנֵ֣נוּ נַ֭גְבִּיר</tei:l>
          <tei:l>שְׂפָתֵ֣ינוּ אִתָּ֑נוּ</tei:l>
          <tei:l>מִ֖י אָד֣וֹן לָֽנוּ׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ו</tei:hi> מִשֹּׁ֥ד עֲנִיִּים֮ מֵאַנְקַ֪ת</tei:l>
          <tei:l>אֶבְי֫וֹנִ֥ים עַתָּ֣ה אָ֭קוּם יֹאמַ֣ר יְהוָ֑ה</tei:l>
          <tei:l>אָשִׁ֥ית בְּ֝יֵ֗שַׁע יָפִ֥יחַֽ לֽוֹ׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ז</tei:hi> אִֽמֲר֣וֹת יְהוָה֮ אֲמָר֪וֹת טְהֹ֫ר֥וֹת כֶּ֣סֶף צָ֭רוּף</tei:l>
          <tei:l>בַּעֲלִ֣יל לָאָ֑רֶץ</tei:l>
          <tei:l>מְ֝זֻקָּ֗ק שִׁבְעָתָֽיִם׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ח</tei:hi> אַתָּֽה־יְהוָ֥ה תִּשְׁמְרֵ֑ם</tei:l>
          <tei:l>תִּצְּרֶ֓נּוּ ׀ מִן־הַדּ֖וֹר ז֣וּ לְעוֹלָֽם׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l><tei:hi rend="superscript">ט</tei:hi> סָבִ֗יב רְשָׁעִ֥ים יִתְהַלָּכ֑וּן</tei:l>
          <tei:l>כְּרֻ֥ם זֻ֝לּ֗וּת לִבְנֵ֥י אָדָֽם׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
