    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_for_the_break_fast_meal_of_sigd_mayer">
        <tei:head>ברכת המזון לסעודת סוף הצום לסיגד</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_for_the_break_fast_meal_of_sigd_mayer/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">מתחילים בתהלים קכ״ב בעברית (תהלים קי״א בגעז)</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_for_the_break_fast_meal_of_sigd_mayer/2"/>
        <tei:lg>
          <tei:l>שִׁ֥יר הַֽמַּעֲל֗וֹת לְדָ֫וִ֥ד</tei:l>
          <tei:l>שָׂ֭מַחְתִּי בְּאֹמְרִ֣ים לִ֑י</tei:l>
          <tei:l>בֵּ֖ית יְהֹוָ֣ה נֵלֵֽךְ׃</tei:l>
          <tei:l>עֹ֭מְדוֹת הָי֣וּ רַגְלֵ֑ינוּ</tei:l>
          <tei:l>בִּ֝שְׁעָרַ֗יִךְ יְרוּשָׁלָֽ͏ִם׃</tei:l>
          <tei:l>יְרוּשָׁלַ֥͏ִם הַבְּנוּיָ֑ה</tei:l>
          <tei:l>כְּ֝עִ֗יר שֶׁחֻבְּרָה־לָּ֥הּ יַחְדָּֽו׃</tei:l>
          <tei:l>שֶׁשָּׁ֨ם עָל֪וּ שְׁבָטִ֡ים</tei:l>
          <tei:l>שִׁבְטֵי־יָ֭הּ עֵד֣וּת לְיִשְׂרָאֵ֑ל</tei:l>
          <tei:l>לְ֝הֹד֗וֹת לְשֵׁ֣ם יְהֹוָֽה׃</tei:l>
          <tei:l>כִּ֤י שָׁ֨מָּה ׀ יָשְׁב֣וּ כִסְא֣וֹת לְמִשְׁפָּ֑ט</tei:l>
          <tei:l>כִּ֝סְא֗וֹת לְבֵ֣ית דָּוִֽד׃</tei:l>
          <tei:l>שַׁ֭אֲלוּ שְׁל֣וֹם יְרוּשָׁלָ֑͏ִם</tei:l>
          <tei:l>יִ֝שְׁלָ֗יוּ אֹהֲבָֽיִךְ׃</tei:l>
          <tei:l>יְהִי־שָׁל֥וֹם בְּחֵילֵ֑ךְ</tei:l>
          <tei:l>שַׁ֝לְוָ֗ה בְּאַרְמְנוֹתָֽיִךְ׃</tei:l>
          <tei:l>לְ֭מַעַן אַחַ֣י וְרֵעָ֑י</tei:l>
          <tei:l>אֲדַבְּרָה־נָּ֖א שָׁל֣וֹם בָּֽךְ׃</tei:l>
          <tei:l>לְ֭מַעַן בֵּית־יְהֹוָ֣ה אֱלֹהֵ֑ינוּ</tei:l>
          <tei:l>אֲבַקְשָׁ֖ה ט֣וֹב לָֽךְ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_for_the_break_fast_meal_of_sigd_mayer/3"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">שלושה שאכלו כאחד חיבים לזמן זימון</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_for_the_break_fast_meal_of_sigd_mayer/4"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">מזמן</tei:note> רַבּוֹתַי נְבָרֵךְ!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_for_the_break_fast_meal_of_sigd_mayer/5"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">קהל</tei:note> יְהִ֤י שֵׁ֣ם יְהֹוָ֣ה מְבֹרָ֑ךְ מֵ֝עַתָּ֗ה וְעַד־עוֹלָֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_for_the_break_fast_meal_of_sigd_mayer/6"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">מזמן</tei:note> יְהִ֤י שֵׁ֣ם יְהֹוָ֣ה מְבֹרָ֑ךְ מֵ֝עַתָּ֗ה וְעַד־עוֹלָֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_for_the_break_fast_meal_of_sigd_mayer/7"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">מזמן</tei:note> בִּרְשׁוּת מְרָנָן וְרַבָּנָן וְרַבּוֹתַי נְבָרֵךְ (<tei:note type="instruction">בעשרה</tei:note> אֱלֹהֵינוּ) שֶׁאָכַלְנוּ מִשֶּׁלוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_for_the_break_fast_meal_of_sigd_mayer/8"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">קהל</tei:note> בָּרוּךְ (<tei:note type="instruction">בעשרה</tei:note> אֱלֹהֵינוּ) שֶׁאָכַלְנוּ מִשֶּׁלוֹ וּבְטוּבוֹ חָיִינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_for_the_break_fast_meal_of_sigd_mayer/9"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">מזמן</tei:note> בָּרוּךְ (<tei:note type="instruction">בעשרה</tei:note> אֱלֹהֵינוּ) שֶׁאָכַלְנוּ מִשֶּׁלוֹ וּבְטוּבוֹ חָיִינוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_for_the_break_fast_meal_of_sigd_mayer/10"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">קהל</tei:note> בָּרוּךְ הוּא וּבָרוּךְ שְׁמוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_for_the_break_fast_meal_of_sigd_mayer/11"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם הַזָּן אֶת־הָעוֹלָם כֻּלּוֹ בְּטוּבוֹ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_for_the_break_fast_meal_of_sigd_mayer/12"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אַ</tei:seg>ז <tei:seg type="acrostic">בְּ</tei:seg>נֵי <tei:seg type="acrostic">גְ</tei:seg>וֹנְדַר <tei:seg type="acrostic">דָּ</tei:seg>נִים <tei:seg type="acrostic">הִ</tei:seg>תַּמְּרוּ (אבגד״ה)</tei:l>
          <tei:l><tei:seg type="acrostic">וּ</tei:seg>בְיוֹם <tei:seg type="acrostic">זֶ</tei:seg>ה <tei:seg type="acrostic">ח</tei:seg>וֹזְרִים <tei:seg type="acrostic">טְ</tei:seg>הוֹרִים <tei:seg type="acrostic">יְ</tei:seg>זַמְּרוּ (וזחט״י)</tei:l>
          <tei:l><tei:seg type="acrostic">כִּ</tei:seg>י <tei:seg type="acrostic">לַ</tei:seg>שָּׁמַֽיִם <tei:seg type="acrostic">מְ</tei:seg>רוֹמִים <tei:seg type="acrostic">נֹ</tei:seg>אמַר וַיֹּ֣אמְר֔וּ (יכלמ״נ)</tei:l>
          <tei:l>כָּאָמוּר</tei:l>
          <tei:l>וַיֹּ֣אמְר֔וּ כֹּ֛ל אֲשֶׁר־דִּבֶּ֥ר יְהֹוָ֖ה נַעֲשֶׂ֥ה וְנִשְׁמָֽע׃ <tei:bibl>(שמות כד:ז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_for_the_break_fast_meal_of_sigd_mayer/13"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר</tei:l>
          <tei:l>פּוֹתֵ֥חַ אֶת־יָדֶ֑ךָ וּמַשְׂבִּ֖יעַ לְכׇל־חַ֣י רָצֽוֹן׃ <tei:bibl>(תהלים קמה:טז)</tei:bibl></tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה הַזָּן אֶת־הַכּל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_for_the_break_fast_meal_of_sigd_mayer/14"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">סֵֽ</tei:seg>ימֵן <tei:seg type="acrostic">עֲ</tei:seg>דַת <tei:seg type="acrostic">פִּ</tei:seg>ינְחַס <tei:seg type="acrostic">צָ</tei:seg>מוּ (סעפ״צ)</tei:l>
          <tei:l><tei:seg type="acrostic">קֵ</tei:seg>סִּים <tei:seg type="acrostic">קָ</tei:seg>רְאוּ <tei:seg type="acrostic">רְ</tei:seg>בִיעִית <tei:seg type="acrostic">ר</tei:seg>וֹמְמוּ (קקר״ר)</tei:l>
          <tei:l><tei:seg type="acrostic">שְׁ</tei:seg>מָשׁוֹת <tei:seg type="acrostic">שׁ</tei:seg>וֹכְבוֹת <tei:seg type="acrostic">תַּ</tei:seg>עֲנִיּוֹתֵֽינוּ <tei:seg type="acrostic">תַּֽ</tei:seg>מּוּ (ששת״ת)</tei:l>
          <tei:l><tei:seg type="acrostic">י</tei:seg>וֹרְשֵׁי <tei:seg type="acrostic">צֶֽ</tei:seg>דֶק, <tei:seg type="acrostic">חִ</tei:seg>זְּקוּ! <tei:seg type="acrostic">קֽ</tei:seg>וּמוּ! וַיָּק֙וּמוּ֙ (יצח״ק)</tei:l>
          <tei:l>כָּאָמוּר</tei:l>
          <tei:l>וַיָּק֙וּמוּ֙ עַל־עׇמְדָ֔ם וַֽיִּקְרְא֗וּ בְּסֵ֨פֶר תּוֹרַ֧ת יְהֹוָ֛ה אֱלֹהֵיהֶ֖ם רְבִעִ֣ית הַיּ֑וֹם וּרְבִעִית֙ מִתְוַדִּ֣ים וּמִֽשְׁתַּחֲוִ֔ים לַיהֹוָ֖ה אֱלֹהֵיהֶֽם׃ <tei:bibl>(נחמיה ט:ג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_for_the_break_fast_meal_of_sigd_mayer/15"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר</tei:l>
          <tei:l>וְאָכַלְתָּ֖ וְשָׂבָ֑עְתָּ וּבֵֽרַכְתָּ֙ אֶת־יְהֹוָ֣ה אֱלֹהֶ֔יךָ עַל־הָאָ֥רֶץ הַטֹּבָ֖ה אֲשֶׁ֥ר נָֽתַן־לָֽךְ׃ <tei:bibl>(דברים ח:י)</tei:bibl></tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה עַל־הָאָֽרֶץ וְעַל־הַמָּזוֹן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_for_the_break_fast_meal_of_sigd_mayer/16"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הַ</tei:seg><tei:seg type="acrostic">ר</tei:seg> הָ<tei:seg type="acrostic">אֵ</tei:seg><tei:seg type="acrostic">ל</tei:seg> <tei:seg type="acrostic">בְּ</tei:seg><tei:seg type="acrostic">נֵ</tei:seg>ה! <tei:seg type="acrostic">אֲ</tei:seg><tei:seg type="acrostic">בָ</tei:seg>רְכָה <tei:seg type="acrostic">רָ</tei:seg><tei:seg type="acrostic">הִ</tei:seg>יטִי<tei:seg type="acrostic">ם</tei:seg> (הרא״ל ב״ן אברה״ם)</tei:l>
          <tei:l><tei:seg type="acrostic">כֹּ</tei:seg><tei:seg type="acrostic">ה</tei:seg> <tei:seg type="acrostic">נָ</tei:seg>שִׁיר: א<tei:seg type="acrostic">וֹ</tei:seg>י <tei:seg type="acrostic">יָ</tei:seg>הּ הַ<tei:seg type="acrostic">עֲ</tei:seg><tei:seg type="acrostic">ל</tei:seg>וּ נִלְקָטִים (כה״ן ויע״ל)</tei:l>
          <tei:l>הֶרְאֵיתָֽנוּ <tei:seg type="acrostic">חָ</tei:seg>זוֹן <tei:seg type="acrostic">זֹֽ</tei:seg>הַר <tei:seg type="acrostic">קִ</tei:seg>שּׁוּטִים (חז״ק)</tei:l>
          <tei:l>נַעֲלֶה כְּמוֹ שֶׁעָלוּ שְׁבָטִ֡ים</tei:l>
          <tei:l>כָּאָמוּר</tei:l>
          <tei:l>שֶׁשָּׁ֨ם עָל֪וּ שְׁבָטִ֡ים שִׁבְטֵי־יָ֭הּ עֵד֣וּת לְיִשְׂרָאֵ֑ל לְ֝הֹד֗וֹת לְשֵׁ֣ם יְהֹוָֽה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_for_the_break_fast_meal_of_sigd_mayer/17"/>
        <tei:lg>
          <tei:l>וְנֶאֱמַר</tei:l>
          <tei:l>בֹּונֵ֣ה יְרוּשָׁלִַ֣ם יְהוָ֑ה</tei:l>
          <tei:l>נִדְחֵ֖י יִשְׂרָאֵ֣ל יְכַנֵּֽס׃ <tei:bibl>(תהלים קמז:ב)</tei:bibl></tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה בּוֹנֵה בְרַחֲמָיו ירוּשָׁלַיִם אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkat_hamazon_for_the_break_fast_meal_of_sigd_mayer/18"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">אומר ברכה אחרונה לפי נוסח רגיל,</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">אבל בפסוקי הרחמן אפשר להוסיף</tei:note>
          </tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>הָרַחֲמָן</tei:l>
          <tei:l>הוּא יִתֶּן לָֽנוּ וּנְקַבְּלָה יוֹם שֶׁכֻּלּוֹ טוֹב׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>הָרַחֲמָן</tei:l>
          <tei:l>הוּא יְקַיֵּם וְיִשְׁמֹר אֶת־הַבְּרִית וְאֶת־הַחֶֽסֶד בֵּינוֹ וּבֵינֵֽינוּ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>