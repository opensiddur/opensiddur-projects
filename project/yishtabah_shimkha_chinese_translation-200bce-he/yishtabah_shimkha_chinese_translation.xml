      <tei:div corresp="urn:x-opensiddur:text:prayer:yishtabah_shimkha_chinese_translation">
        <tei:head>יִשְׁתַּבַּח שִׁמְךָ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:yishtabah_shimkha_chinese_translation/1"/>
        <tei:lg>
          <tei:l>יִשְׁתַּבַּח שִׁמְךָ לָעַד מַלְכֵּנוּ. הָאֵל הַמֶּלֶךְ הַגָּדוֹל וְהַקָּדוֹשׁ</tei:l>
          <tei:l>בַּשָּׁמַיִם וּבָאָרֶץ. כִּי לְךָ נָאֶה יְהֹוָה אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ׃</tei:l>
          <tei:l>שִׁיר וּשְׁבָחָה. הַלֵּל וְזִמְרָה. עוֹז וּמֶמְשָׁלָה. נֶצַח גְּדוּלָּה</tei:l>
          <tei:l>וּגְבוּרָה. תְּהִלָּה וְתִפְאֶרֶת. קְדֻשָּׁה וּמַלְכוּת׃ בְּרָכוֹת וְהוֹדָאוֹת</tei:l>
          <tei:l>מֵעַתָּה וְעַד עוֹלָם׃ בָּרוּךְ אַתָּה יְהֹוָה. אֵל מֶלֶךְ גָּדוֹל בַּתִּשְׁבָּחוֹת.</tei:l>
          <tei:l>אֵל הַהוֹדָאוֹת. אֲדוֹן הַנִּפְלָאוֹת. הַבּוֹחֵר בְּשִׁירֵי זִמְרָה.</tei:l>
          <tei:l>מֶלֶךְ אֵל חֵי הָעוֹלָמִים׃</tei:l>
        </tei:lg>
      </tei:div>
