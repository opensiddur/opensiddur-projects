    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac">
        <tei:head>אֵל ׀ אֱֽלֹהִים ה׳ דִּבֶּר וַיִּקְרָא</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אֵ֤</tei:seg>ל ׀ אֱֽלֹהִ֡ים יְֽהֹוָ֗ה דִּבֶּ֥ר וַיִּקְרָא</tei:l>
          <tei:l><tei:seg type="acrostic">אֶ</tei:seg>ל־הַשָּׁמַֽיִם מֵעָל וְהָאָֽרֶץ בְּמַאֲמָרוֹ בָּרָא</tei:l>
          <tei:l>שִׁמְעָ֤ה עַמִּ֨י ׀ וַאֲדַבֵּ֗רָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>רוּחוֹ שֻׁפְּרוּ שִׁבְעָתַֽיִם וְיַחְדָּו עָמָֽדוּ</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>ר֥וּחַ פִּ֗֝יו כׇּל־צְבָאָֽם וֻעָֽדוּ</tei:l>
          <tei:l>הִֽ֭תְהַלְלוּ בְּשֵׁ֣ם קׇדְשׁ֑וֹ וְהוֹדוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">גֵּ</tei:seg>א֢וּת לָ֫בֵ֥שׁ וְכִסֵּא מֵאָז נָכוֹן</tei:l>
          <tei:l><tei:seg type="acrostic">גְּ</tei:seg>בוּרוֹת עֶרְכָּם לְסַפֵּר מִי יִכּוֹן</tei:l>
          <tei:l>לְךָ֤ דֻֽמִיָּ֬ה תְהִלָּ֓ה אַף תִּכּוֹן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/4"/>
        <tei:lg>
          <tei:l>עֵֽדֹתֶ֨יךָ ׀ נֶאֶמְנ֬וּ מְאֹ֗ד וְנִסֶּֽיךָ</tei:l>
          <tei:l>תְּהִלּוֹת שִׁמְךָ יְסַפְּרוּ חוֹסֶֽיךָ</tei:l>
          <tei:l>דּ֣וֹר לְ֭דוֹר יְשַׁבַּ֣ח מַעֲשֶׂ֑יךָ׃</tei:l>
          <tei:l>קָדוֹשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">דֶּ</tei:seg>רֶךְ־ז֥וּ אֵלֵ֑ךְ הַשְׂכִּילֵֽנִי</tei:l>
          <tei:l><tei:seg type="acrostic">דָּ</tei:seg>בַ֥קְתִּי בְעֵדְוֺתֶ֑יךָ לַמְּדֵֽנִי</tei:l>
          <tei:l><tei:seg type="acrostic">דֶּ</tei:seg>רֶךְ־פִּקּוּדֶ֥יךָ הֲבִינֵ֑נִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הֵ</tei:seg>ן מִקְצֵה הַשָּׁמַֽיִם וְעַד יַרְכְּתֵיהֶם</tei:l>
          <tei:l><tei:seg type="acrostic">הִ</tei:seg>גְבִּיל חֲמֵשׁ מֵאוֹת שָׁנָה אַפְאֵיהֶם</tei:l>
          <tei:l>מִקְצֵ֥ה הָאָ֖רֶץ וְעַד־קְצֵ֥ה מִלֵּיהֶם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>תֹֽכֶן אֶחָד שָׂם בְּמַעֲבֵיהֶם</tei:l>
          <tei:l><tei:seg type="acrostic">וַ</tei:seg>אֲוִיר חֲלָלָם וּתְקוּפוֹתֵיהֶם</tei:l>
          <tei:l>לַ֝שֶּׁ֗מֶשׁ שָֽׂם־אֹ֥הֶל בָּהֶֽם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/8"/>
        <tei:lg>
          <tei:l>לְֽכוּ־חֲ֭זוּ מִפְעֲל֣וֹת אֱלֹהִים וְהַשְׂכִּֽילוּ</tei:l>
          <tei:l>נוֹרָאוֹת בְּהַקָּפוֹתָם יָחִֽילוּ</tei:l>
          <tei:l>יִרְאֵ֤י יְהֹוָ֨ה הַלְלוּ</tei:l>
          <tei:l>קָדוֹשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זָ</tei:seg>כַֽרְתִּי שִׁמְךָ וּבוֹ אֶתְהַלְלָה</tei:l>
          <tei:l><tei:seg type="acrostic">זַ</tei:seg>מֵּר לְשִׁמְךָ סֶֽלָה</tei:l>
          <tei:l>מִ֝פְלְא֗וֹת תְּמִ֣ים דֵּעִֽים נוֹרָא עֲלִילָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/10"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חֶֽ</tei:seg>בֶל מִדַּת שִׁבְעָה רְקִיעִים וְשִׁבְעָה אֲוֵירִים</tei:l>
          <tei:l><tei:seg type="acrostic">חֹ</tei:seg>ק שָׁנִים לְמִדָּתָם מְעוֹרְרִים</tei:l>
          <tei:l><tei:seg type="acrostic">חָ</tei:seg>שַׁק שִׁבְעָה אֲרָצוֹת מְחַזְּרִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/11"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ט</tei:seg>וּבוֹ הֶעֱדִיף בָּם בְּחַסְדּוֹ מֻגְבָּר</tei:l>
          <tei:l><tei:seg type="acrostic">טִ</tei:seg>יב כׇּל־תַּבְנִיתָם לֹא־יַעְדְּרוּ דָּבָר</tei:l>
          <tei:l><tei:seg type="acrostic">ט</tei:seg>וֹב הֶעֱמִידָם לָעַ֣ד לְעוֹלָ֑ם חׇק־נָ֝תַ֗ן וְלֹ֣א עָבָר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/12"/>
        <tei:lg>
          <tei:l>יִדֹּדוּן מְשָׁרְתָיו וּצְבָאָיו בְּכֻלָּם לְיַחֲדוֹ</tei:l>
          <tei:l>וְהוֹא אֱלֹהִים חַיִּים וְאֵין בִּלְעָדוֹ</tei:l>
          <tei:l>כִּֽי־נִשְׂגָּ֣ב שְׁמ֣וֹ לְבַדּ֑וֹ</tei:l>
          <tei:l>קָדוֹשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/13"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יִ</tei:seg>קֹּב שֵׁם רִאשׁוֹן וִילוֹן שָׁמַֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">יִ</tei:seg>חַד בּוֹ שִׁבְעָה מַחֲנַֽיִם</tei:l>
          <tei:l><tei:seg type="acrostic">יִ</tei:seg>שְׁמְעוּ לְשִׁבְעָה שׁוֹטְרִים עַל־שִׁבְעָה כִּסְאוֹתָֽיִם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/14"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כֻּ</tei:seg>לָּם לְשֵׁם נוֹרָא יַקְדִּישׁוּן</tei:l>
          <tei:l><tei:seg type="acrostic">כְּ</tei:seg>בוֹד שִׁגּוּבוֹ יְשַׁלְּשׁוּן</tei:l>
          <tei:l><tei:seg type="acrostic">כֹּ</tei:seg>ל אֲשֶׁר יְצַוֵּם וְיֵרָשׁוּן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/15"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">לִ</tei:seg>הֲטָם הָאֵשׁ וּמֵהָאֵשׁ יָצָֽאוּ</tei:l>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>מִצְוֺתָיו אֵימָה יְמֻלָּֽאוּ</tei:l>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>מַלְּאוֹת דְּבָרוֹ בְּשֵׁם יִקְרָֽאוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/16"/>
        <tei:lg>
          <tei:l>קוּמָ֞ה יְהֹוָ֤ה אֱלֹהִים֙ וּרְדֹף זֵדִים עַד־חוֹבָה</tei:l>
          <tei:l>וְיָפֻ֙צוּ֙ אֹֽיְבֶ֔יךָ בְּלִי סִבָּה</tei:l>
          <tei:l>אֵ֣ל נַ֭עֲרָץ בְּסוֹד־קְדֹשִׁ֣ים רַבָּ֑ה׃</tei:l>
          <tei:l>קָדוֹשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/17"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מַ</tei:seg>ה נּוֹרָא מַֽעַשׂ יוֹצֵר כֹּל בְּהַפְלֵא וָפֶֽלֶא</tei:l>
          <tei:l><tei:seg type="acrostic">מַ</tei:seg>עֲלוֹת שְׁתֵּים עֶשְׂרֵה בָּרָקִֽיעַ שֵׁנִי אֵֽלֶּה</tei:l>
          <tei:l><tei:seg type="acrostic">מַ</tei:seg>לְאֲכֵי זִֽיעַ וּרְתֵת עַל־כׇּל־מַעֲלֶה לְעַלֵּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/18"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נִ</tei:seg>רְאִים בּוֹ אוֹצְרוֹת בָּרָד וָשֶֽׁלֶג וּכְפוֹר אֵֽלֶּה וְכָאֵֽלֶּה</tei:l>
          <tei:l><tei:seg type="acrostic">נ</tei:seg>וֹרָאִים מַלְאָכִים מִלֵּא</tei:l>
          <tei:l><tei:seg type="acrostic">נ</tei:seg>וֹרָא מִנָּה שׁוֹטְרִים עֲלֵיהֶם דְּבָרוֹ לְמַלֵּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/19"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ס</tei:seg>וֹד אֱלֹהִים לִירֵאָיו לְהַשְׂכִּיל</tei:l>
          <tei:l><tei:seg type="acrostic">סַ</tei:seg>פֵּר עִזּוּז שְׁמוֹ כֹּֽחַ מִי יָכִיל</tei:l>
          <tei:l><tei:seg type="acrostic">סַ</tei:seg>פְּרוּ עֻזּוֹ סוֹדוֹת צְבָאָיו אֱלֹהִ֗ים זַמְּר֥וּ מַשְׂכִּֽיל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/20"/>
        <tei:lg>
          <tei:l>חֵֽקֶר כְּבוֹד אֱלֹהִים נוֹרָא</tei:l>
          <tei:l>מִצְוַ֥ת יְהֹוָ֥ה בָּ֝רָ֗ה</tei:l>
          <tei:l>כֹּל הַנִּקְרָא בִשְׁמוֹ לִכְבוֹדוֹ בָּרָא׃</tei:l>
          <tei:l>קָדוֹשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/21"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">עֹֽ</tei:seg>צֶם שְׁחָקִים אוֹצְרוֹת עֲרָפֶל וְרוּחוֹת</tei:l>
          <tei:l><tei:seg type="acrostic">עִ</tei:seg>זּוּז בְּרָקִים וּרְעָמִים בָּרָא מַגִּיד שֵׂחוֹת</tei:l>
          <tei:l><tei:seg type="acrostic">עֲ</tei:seg>מִידַת שְׁלֹשָׁה עַל כִּסְאוֹת שְׁלֹשָׁה מוֹכָחוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/22"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>אֵר לְשֵׁם קׇדְשׁוֹ יִתֵּֽנוּ</tei:l>
          <tei:l><tei:seg type="acrostic">פַּֽ</tei:seg>חַד וְאֵימָה יִשְׂאוּ קוֹל וְיָרֹֽנּוּ</tei:l>
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>נוֹת לְמִשְׁלַחְתּוֹ יְזֻמָּֽנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/23"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">צִ</tei:seg>חְצֽוּחַ זְבוּל נָטוּי בְּרֽוּחַ סְעָרָה</tei:l>
          <tei:l><tei:seg type="acrostic">צְ</tei:seg>מוּדִים בּוֹ גִּנְזֵי גְבוּרָה</tei:l>
          <tei:l>וְאוֹצְרוֹת טְלָלִים וְנַהֲרֵי אֵשׁ וּמַֽיִם מִזֶּה וּמִזֶּה בַּעֲבָרָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/24"/>
        <tei:lg>
          <tei:l>יְהֹוָה שָׁלוֹם עֹשֶׂה בִּמְרוֹמָיו</tei:l>
          <tei:l>לְהַלֵּל לְשֵׁם קׇדְשׁוֹ צְבָאָיו וּמַחֲנָיו</tei:l>
          <tei:l>מִי יַעֲרֹךְ לְהוֹדוֹת הִלּוּלָיו וּרְנָנָיו׃</tei:l>
          <tei:l>קָדוֹשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/25"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">קֶֽ</tei:seg>רֶן מָכוֹן יָקָר מְעֻלֶּה</tei:l>
          <tei:l>בְּמַלְאֲכֵי הוֹד וְגַאֲוָה מֻפְלֶא</tei:l>
          <tei:l>חֲיָלוֹת מְהַלְלִים לְבוֹרֵא אֵֽלֶּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/26"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רַ</tei:seg>בֵּי נְשִׂיאִים שְׁנֵים עָשָׂר</tei:l>
          <tei:l>שָׁלֹשׁ לְכׇל־רֽוּחַ שָׂר</tei:l>
          <tei:l>מְמֻנִּים עַל חׇדְשֵׁי תְּרֵיסָר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/27"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שִׁ</tei:seg>שִּׁי מָעוֹן וְאוֹצְרוֹתָיו מְלֵאִים נֹֽפֶת</tei:l>
          <tei:l>לַצַּדִּיקִים לְאוֹת וּלְמֽוֹפֵת</tei:l>
          <tei:l>וְאוֹר גָּדוֹל וְרִבֹּתַ֣יִם אַלְפֵ֣י שִׁנְאָ֑ן לָעוּף בָּעֹֽפֶת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/28"/>
        <tei:lg>
          <tei:l>שׁוֹנִים שִׁיר וְתִשְׁבָּחוֹת בְּמוֹרָאוֹת</tei:l>
          <tei:l>לְיוֹצֵר הַכֹּל וְעֹשֵׂה נִפְלָאוֹת</tei:l>
          <tei:l>הוּא הַמֶּֽלֶךְ יְהֹוָה צְבָאוֹת׃</tei:l>
          <tei:l>קָדוֹשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/29"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">תֹּֽ</tei:seg>קֶף עֲרָבוֹת אוֹרוֹ אוֹר שִׁבְעָתַֽיִם</tei:l>
          <tei:l>וְכִסֵּא עַל־חַיּוֹת בְּאַוֵּיר אַרְבַּעְתַּֽיִם</tei:l>
          <tei:l>נוֹשֵׂא וְנִרְאֶה נִשָּׂא לָעֵינַֽיִם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/30"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">תּ</tei:seg>וֹכוֹ אוֹצְרוֹת חַיִּים וּנְפָשׁוֹת</tei:l>
          <tei:l>וְכִתּוֹת מַלְאָכִים מְשַׁלְּשִׁים קְדֻשּׁוֹת</tei:l>
          <tei:l>וְעֵינֵיהֶם נוֹצְצִים בְּרַק אִשּׁוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/31"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">י</tei:seg>וֹשֵׁב בִּמְעוֹן קֹֽדֶשׁ קָדוֹשׁ וְנוֹרָא</tei:l>
          <tei:l>דּוֹרֵשׁ אֱמוּנָה וּמִשְׁפָּט עֹטֶה כַּשַּׂלְמָה אוֹרָה</tei:l>
          <tei:l>כֹּל לֹא שָׁרִים תְּמוּנָתוֹ וּתְמוּנָה מֶֽנּוּ לֹא נִסְתָּֽרָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/32"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">צֶֽ</tei:seg>דֶק מְפַלֵּס שׁוֹפֵט בֶּאֱמוּנָה</tei:l>
          <tei:l>סִפְרֵי אֵשׁ פְּתוּחִים לְפָנָיו הֵֽנָּה וָהֵֽנָּה</tei:l>
          <tei:l>וְכִתּוֹת טוֹבְלִים בִּנְהַר טֹֽהַר וּמִתְעַטְּפִים אֵשׁ לְבָנָה</tei:l>
          <tei:l>לְהַקְדִּישׁ קָדוֹשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/33"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חֵ֥</tei:seg>לֶק יְהֹוָ֖ה עַמּ֑וֹ יַעֲקֹ֖ב חֶ֥בֶל נַחֲלָתֽוֹ׃</tei:l>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>דוֹשׁ צִוָּה לָהֶם לְעֹלָם בְּרִיתוֹ</tei:l>
          <tei:l><tei:seg type="acrostic">בְּרֻבֵּי </tei:seg>תוֹרוֹתָיו לְהִשְׁתַּעְשֵׁעַ אֹם סְגֻלָּתוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/34"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מָשַׁ</tei:seg>ךְ לְעַמּוֹ חַסְדּוֹ וְגִלָּה סוֹד דָּתוֹ</tei:l>
          <tei:l><tei:seg type="acrostic">ה</tei:seg>וּקַם אֶחָד בַּשְּׁבִיעִי לְמִשְׁפַּט בְּרִיָּתוֹ</tei:l>
          <tei:l>חַיִּים כְּגָמַל לְנוֹצָר רִאשׁוֹן כִּדְמוּתוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/35"/>
        <tei:lg>
          <tei:l>זִכָּרוֹן חֹק לְעוֹלָם בְּרִיתוֹ</tei:l>
          <tei:l>דְּבָרוֹ נִצָּב לְכׇל־תּוֹלַדְתּוֹ</tei:l>
          <tei:l>לְמִשְׁפָּט עֲמֹד חֲרֵדִים מֵחֶרְדָּתוֹ׃</tei:l>
          <tei:l>קָדוֹשׁ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_elohim_hashem_diber_vayiqra_isaac/36"/>
        <tei:lg>
          <tei:l>לְרַחֲמִים לְדֹר וָדֹר אֱמוּנָתוֹ</tei:l>
          <tei:l>תִּקְע֣וּ בַחֹ֣דֶשׁ לְי֣וֹם חַגֵּֽנוּ כֵּֽסֶה</tei:l>
          <tei:l>וְהֵחָרְדוּ לָשׁוּב בֶּאֱמֶת מֵרֹֽעַ מַעֲשֶׂה</tei:l>
          <tei:l>עַל כֹּל יָבִיא בְּמִשְׁפָּט יוֹשֵׁב עַל־כִּסֵּא׃</tei:l>
          <tei:l>קָדוֹשׁ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
