  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:blessings_at_your_dawn_of_wakefulness_berakhot_sheasani/1">
        <tei:head>בְּרָכוֹת שֶׁעֲשָׁנִי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessings_at_your_dawn_of_wakefulness_berakhot_sheasani/1/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ברכות שעשני</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessings_at_your_dawn_of_wakefulness_berakhot_sheasani/1/2"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>מֶלֶךְ הָעוֹלָם,</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>שֶׁעָשַׂנִי</tei:l>
          <tei:l>בְּצָלְמוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessings_at_your_dawn_of_wakefulness_berakhot_sheasani/1/3"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>מֶלֶךְ הָעוֹלָם,</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>שֶׁעָשַֽׂנִי כִּרְצוֹנוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessings_at_your_dawn_of_wakefulness_berakhot_sheasani/1/4"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>מֶלֶךְ הָעוֹלָם,</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>שֶׁעָשַׂנִי</tei:l>
          <tei:l>יִשְׂרָאֵל׃</tei:l>
        </tei:lg>
