  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:piyyut_for_maariv_on_the_day_when_one_begins_requesting_rain_sobel">
        <tei:head>פיוט למעריב להתחלת בקשת גשם</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:piyyut_for_maariv_on_the_day_when_one_begins_requesting_rain_sobel/1"/>
        <tei:lg>
          <tei:l>בא״י אשר בדברו המעריב ערבים...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:piyyut_for_maariv_on_the_day_when_one_begins_requesting_rain_sobel/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אֶ</tei:seg>ל קֹ֨ר וָחֹ֜ם וְקַ֧יִץ וָחֹ֛רֶף<tei:anchor xml:id="note_1"/> נְטַר</tei:l>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>הַשְׁקוֹת כָּל־גֵּֽזַע וְחֹֽטֶר<tei:anchor xml:id="note_2"/></tei:l>
          <tei:l><tei:seg type="acrostic">יִ</tei:seg>תֵּן בְּעִתּוֹ הַטַּל וְהַמָּטָר<tei:anchor xml:id="note_3"/></tei:l>
          <tei:l><tei:seg type="acrostic">רַ</tei:seg>מְשָׁא בְּכֿוֹכְבַיָּא עֲטַר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:piyyut_for_maariv_on_the_day_when_one_begins_requesting_rain_sobel/3"/>
        <tei:lg>
          <tei:l>בא״י הַמַּעֲרִיב עֲרָבִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:piyyut_for_maariv_on_the_day_when_one_begins_requesting_rain_sobel/4"/>
        <tei:lg>
          <tei:l>אהבת עולם...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:piyyut_for_maariv_on_the_day_when_one_begins_requesting_rain_sobel/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נַ</tei:seg>עֲשֶׂ֥ה וְנִשְׁמָֽע<tei:anchor xml:id="note_7"/> אָמַר הַנִּטָּר</tei:l>
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>קוּדֶֽיךָ קִבַּֽלְנוּ וְחֻקֵּי הַשְּׁטָר</tei:l>
          <tei:l><tei:seg type="acrostic">סְ</tei:seg>גוּלֶֽיךָ יִשְׁאֲלֽוּךָ לְמָטָר</tei:l>
          <tei:l><tei:seg type="acrostic">חַ</tei:seg>ד וְחַד הִמְלִיכֽוּךָ בָּעֲטָר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:piyyut_for_maariv_on_the_day_when_one_begins_requesting_rain_sobel/6"/>
        <tei:lg>
          <tei:l>בא״י אוֹהֵב עַמּוֹ יִשְׂרָאֵל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:piyyut_for_maariv_on_the_day_when_one_begins_requesting_rain_sobel/7"/>
        <tei:lg>
          <tei:l>אמת ואמונה...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:piyyut_for_maariv_on_the_day_when_one_begins_requesting_rain_sobel/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בַּ</tei:seg>יָּם הִשְׁלַכְתֶּם<tei:anchor xml:id="note_9"/> וְאָנוּ נְטַר</tei:l>
          <tei:l><tei:seg type="acrostic">נְ</tei:seg>חֵה בְֿחַסְדְּךָ֖ עַם־ז֣וּ<tei:anchor xml:id="note_10"/> לְךָ קָטַר</tei:l>
          <tei:l><tei:seg type="acrostic">רְ</tei:seg>בִיבִים תֵּן וְתַֿעֲרֹף הַמָּטָר<tei:anchor xml:id="note_11"/></tei:l>
          <tei:l><tei:seg type="acrostic">חַ</tei:seg>יֵּֽנוּ גְּאָל<tei:anchor xml:id="note_12"/> אֶל־בֵּית הַמְּעֻטָּר<tei:anchor xml:id="note_13"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:piyyut_for_maariv_on_the_day_when_one_begins_requesting_rain_sobel/9"/>
        <tei:lg>
          <tei:l>בא״י גָּאַל יִשְׂרָאֵל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:piyyut_for_maariv_on_the_day_when_one_begins_requesting_rain_sobel/10"/>
        <tei:lg>
          <tei:l>השכיבנו ה׳ א־לקינו לשלום...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:piyyut_for_maariv_on_the_day_when_one_begins_requesting_rain_sobel/11"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>שִׁשִּׁים אַחַר תִּשְׁרִי נְטַר<tei:anchor xml:id="note_19"/></tei:l>
          <tei:l><tei:seg type="acrostic">חֲ</tei:seg>מִשָּׁה עָשָׂר אָז הֶחָג נִפְטַר<tei:anchor xml:id="note_20"/></tei:l>
          <tei:l><tei:seg type="acrostic">זְ</tei:seg>כוֹר בְּשׁוֹמֵֽעַ אִם שָׁכַח מָטָר<tei:anchor xml:id="note_21"/></tei:l>
          <tei:l><tei:seg type="acrostic">קַ</tei:seg>בֵּל הַתְּפִלָּה חוֹבְבֶֽיךָ יֲעַטָּר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:piyyut_for_maariv_on_the_day_when_one_begins_requesting_rain_sobel/12"/>
        <tei:lg>
          <tei:l>בא״י שׁוֹמֵר עַמּוֹ יִשְׂרָאֵל לָעַד׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" n="1" target="#note_1">
      <tei:p>בראשית ח:כב</tei:p>
    </tei:note>
    <tei:note type="commentary" n="2" target="#note_2">
      <tei:p>ע׳ ישעיהו יא:א</tei:p>
    </tei:note>
    <tei:note type="commentary" n="3" target="#note_3">
      <tei:p>ע׳ דברים יא:יד</tei:p>
    </tei:note>
    <tei:note type="commentary" n="7" target="#note_7">
      <tei:p>שמות כד:ז</tei:p>
    </tei:note>
    <tei:note type="commentary" n="9" target="#note_9">
      <tei:p>ע׳ נחמיה ט:יא</tei:p>
    </tei:note>
    <tei:note type="commentary" n="10" target="#note_10">
      <tei:p>שמות טו.יג</tei:p>
    </tei:note>
    <tei:note type="commentary" n="11" target="#note_11">
      <tei:p>ע׳ דברים לב:ב</tei:p>
    </tei:note>
    <tei:note type="commentary" n="12" target="#note_12">
      <tei:p>ע׳ תהלים קג.ד</tei:p>
    </tei:note>
    <tei:note type="commentary" n="13" target="#note_13">
      <tei:p>ע׳ רש״י על שיר השירים ג:יא</tei:p>
    </tei:note>
    <tei:note type="commentary" n="19" target="#note_19">
      <tei:p>ע׳ תענית דף י ע”א</tei:p>
    </tei:note>
    <tei:note type="commentary" n="20" target="#note_20">
      <tei:p>ע׳ משנה תענית א.ג</tei:p>
    </tei:note>
    <tei:note type="commentary" n="21" target="#note_21">
      <tei:p>שו”ע קיז.ד-ה ומ”ב שם ס”ק טו-טז</tei:p>
    </tei:note>
  </tei:standOff>
</tei:TEI>