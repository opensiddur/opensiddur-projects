  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:borei_ad_anah">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:borei_ad_anah/1"/>
        <tei:lg xml:lang="lad-Latn">
          <tei:l>Kreador, asta kuando</tei:l>
          <tei:l>tu palomba enkarselada</tei:l>
          <tei:l>i en laso enlasada</tei:l>
          <tei:l>miskina i desdechada,</tei:l>
          <tei:l>i sin sus ijos.</tei:l>
          <tei:l>esta solitaria,</tei:l>
          <tei:l>esklamando, sinyor!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:borei_ad_anah/2"/>
        <tei:lg xml:lang="lad-Latn">
          <tei:l>
            <tei:note type="instruction">Refran:</tei:note>
          </tei:l>
          <tei:l>Sinyor, sinyor, sinyor,</tei:l>
          <tei:l>Sinyor, sinyor, sinyor,</tei:l>
          <tei:l>esta solitaria,</tei:l>
          <tei:l>esklamando, sinyor!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:borei_ad_anah/3"/>
        <tei:lg xml:lang="lad-Latn">
          <tei:l>Miskina i esmovida,</tei:l>
          <tei:l>la palomba onde anda</tei:l>
          <tei:l>en yelada i en sekura</tei:l>
          <tei:l>pozada noche i dia</tei:l>
          <tei:l>i eya es muy medroza</tei:l>
          <tei:l>de espada la enganyoza</tei:l>
          <tei:l>i de dientes de leon.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:borei_ad_anah/4"/>
        <tei:lg xml:lang="lad-Latn">
          <tei:l>Ay, Dio! De ke la deshaste</tei:l>
          <tei:l>en poder de arevatador,</tei:l>
          <tei:l>i comiole el servis</tei:l>
          <tei:l>kavole el deredor?</tei:l>
          <tei:l>Pasaron los anyos</tei:l>
          <tei:l>tanbien verano, tanbien invierno</tei:l>
          <tei:l>sonportare a mi dolor.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:borei_ad_anah/5"/>
        <tei:lg xml:lang="lad-Latn">
          <tei:l>Ay, Dio! Ken alas le diese</tei:l>
          <tei:l>ken bolar pudiese</tei:l>
          <tei:l>por los montes koriese</tei:l>
          <tei:l>por las kuestas saltase</tei:l>
          <tei:l>por venir kon su kerido</tei:l>
          <tei:l>i dientro en eskondido</tei:l>
          <tei:l>olvidaria mi dolor.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:borei_ad_anah/6"/>
        <tei:lg xml:lang="lad-Latn">
          <tei:l>Akonsejan sovre eya</tei:l>
          <tei:l>konsejo de aboresyon</tei:l>
          <tei:l>estranyos los servientes</tei:l>
          <tei:l>idolos ke tres son</tei:l>
          <tei:l>ke nun es ayos virguenos</tei:l>
          <tei:l>grande<tei:anchor xml:id="note_1"/> era mi dolor,</tei:l>
          <tei:l>grande era mi dolor.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:borei_ad_anah/7"/>
        <tei:lg xml:lang="lad-Latn">
          <tei:l>Konsola su korason</tei:l>
          <tei:l>poderoso sovre los altos</tei:l>
          <tei:l>i avla konsolasiyon</tei:l>
          <tei:l>sovre korason de los afritos</tei:l>
          <tei:l>apanya puevlos enposhados</tei:l>
          <tei:l>entre puevlos dezromados</tei:l>
          <tei:l>i trae el regmidor.<tei:anchor xml:id="note_2"/></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" n="1" target="#note_1">
      <tei:p>Source here seems to read צראנדי which I believe to be a typo for the common word גראנדי meaning “great” and found in the parallel passage in the next verse</tei:p>
    </tei:note>
    <tei:note type="commentary" n="2" target="#note_2">
      <tei:p>Source here seems to read ריתמידור which I believe to be a typo for the common word ריגמידור meaning “redeemer”</tei:p>
    </tei:note>
  </tei:standOff>
</tei:TEI>