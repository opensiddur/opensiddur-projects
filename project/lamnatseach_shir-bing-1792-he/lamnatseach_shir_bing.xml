    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing">
        <tei:head>למנצח שיר</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/1"/>
        <tei:lg>
          <tei:l>נָפְלָה, נָפְלָה מַלְכוּת הָרֶשַּׁע</tei:l>
          <tei:l>חֵרֶם הִיא וּתְהִי תוֹעֵבָה,</tei:l>
          <tei:l>נִגְדַע עֹל, נִתְּקוּ מוֹסֵרוֹת</tei:l>
          <tei:l>שָׁבְתָה, שָׁבְתָה הַמַדְהֵבָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/2"/>
        <tei:lg>
          <tei:l>מַלְכֵי אֶרֶץ יַחְדָו נוֹעָדוּ,</tei:l>
          <tei:l>לָשׂוּם אוֹתָנוּ לַעֲבָדִים,</tei:l>
          <tei:l>כַּשׁוֹאָה מֶמֶרְחָק תָּבוֹא</tei:l>
          <tei:l>מִצָפוֹן בָּאוּ הַשׁוֹדְדִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/3"/>
        <tei:lg>
          <tei:l>קוּמוּ הַמְלֻמָדִים לַקְרָב,</tei:l>
          <tei:l>קוּמוּ וַעֲשׂוּ שֵׁם וּתְהִלָּה,</tei:l>
          <tei:l>מַעֲרְכוֹת עָרִיצִים לִפְנֵיכֶם</tei:l>
          <tei:l>רִדְפוּם, שִּׁימוּ בָהֶם תָּהְלָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/4"/>
        <tei:lg>
          <tei:l>קוּמוּ הַמִתְנַדְבִים בָּעָם</tei:l>
          <tei:l>הִתְחַזְקוּ וִהְיוּ לָאֲנָשִׁים,</tei:l>
          <tei:l>חֶרֶב לָכֶם, חֶרֶב נוֹקֶמֶת</tei:l>
          <tei:l>חֶרֶב לַשָׁוִים וּלְחָפְשִׁים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/5"/>
        <tei:lg>
          <tei:l>אַנְשֵׁי חַיִל לָכֶם הָעֹז</tei:l>
          <tei:l>לַמִתְנַשֵׂא אֶפֶס תִּקְיָה,</tei:l>
          <tei:l>מַרְגִיזֵי אֲרֶץ, שָׁוא לָכֶם</tei:l>
          <tei:l>לֹא תָבוֹא עוֹד רֶגֶל גַאְוָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/6"/>
        <tei:lg>
          <tei:l>גוּרוּ לָכֶם אַנְשֵׁי הַזְרוֹעַ</tei:l>
          <tei:l>וַאֲשֶׁר קִרְבָּם רוּחַ עִוְעִים,</tei:l>
          <tei:l>הִנֵה יוֹם עַל גֵאֶה וְרָם</tei:l>
          <tei:l>בָּא הַקֵץ חִרְדוּ לִרְגָעִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/7"/>
        <tei:lg>
          <tei:l>בּוֹשׁוּ הִכָּלְמוּ מִדַרְכְכֶם</tei:l>
          <tei:l>הַמְשַׁלְחִים בֵּין אַחִים מָדוֹן,</tei:l>
          <tei:l>כָּבוֹד לָכֶם שֶׁבֶת מֵרִיב׃</tei:l>
          <tei:l>כִּי לֹא תָקוּם תִקְוַת זָדוֹן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/8"/>
        <tei:lg>
          <tei:l>הַלוֹבְשִׁים אַדֶרֶת שֵׁעָר</tei:l>
          <tei:l>וּבְפֶה חָלָק יַעֲשׂוּ מִרְחֶה,</tei:l>
          <tei:l>הֵן שִׁמְכָם לִשְׁבוּעָה תַּנִיחוּ</tei:l>
          <tei:l>אַף חַטַאתְכֶם לֹא תִמָּחֶה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/9"/>
        <tei:lg>
          <tei:l>פִּנוֹת הָעָם יַחְדָו נֶאְסָפוּ</tei:l>
          <tei:l>הֵמָה חֻקֵּי צֶדֶק יוֹרוּנוּ,</tei:l>
          <tei:l>יַעֲמִידוּ אֶרֶץ בַּמִשְׁפָּט</tei:l>
          <tei:l>וּבְמַעְגְלֵי מִישׁוֹר יַדְרִיכוּנוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/10"/>
        <tei:lg>
          <tei:l>כַּשֶׁמֶשׁ מַרְפֵּא בִכְנָפָיהָ</tei:l>
          <tei:l>לִשְׂבֵעַת מַיִם עֵת זוֹרַחַת,</tei:l>
          <tei:l>כֵּן רִפְאוּת גוֹי יוֹם אַהְבַת יֹשֶׁר</tei:l>
          <tei:l>בִּלְבַב צַדִיקִים מִתְלַקַחַת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/11"/>
        <tei:lg>
          <tei:l>לִפְנֵיהֶם בַּחֲמַת מוֹשֵׁל מַוֶת</tei:l>
          <tei:l>חַסְדוֹ לַאֲשֶׁר יַחְפוֹץ יַטֵהוּ,</tei:l>
          <tei:l>אַחְרֵיהֶם הַדָּת עַל תִּלָה</tei:l>
          <tei:l>אִישׁ כִּפְעֻלָתוֹ יִקְרָאֵהוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/12"/>
        <tei:lg>
          <tei:l>לִפְנֵיהֶם יַעְבָר אִישׁ שָׂרֵהוּ</tei:l>
          <tei:l>וַאֲשֶׁר לֹא עָמֵל בּוֹ יֹאכְלֶנוּ,</tei:l>
          <tei:l>אַחְרֵיהֶם מֵעֲמָלוֹ יִשְׂבַּע</tei:l>
          <tei:l>בֶּטַח כִּי קוֹל נוֹגֵשׂ אֵינֶנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/13"/>
        <tei:lg>
          <tei:l>בָּרִאשׁוֹנָה הָעָם מִרְמָס</tei:l>
          <tei:l>הַפְּקֻדּוֹת לַאֲשֶׁר חֵן יִמְצָאוּ,</tei:l>
          <tei:l>כַּיוֹם אַל יִפּוֹל לֵב אִישׁ חָיִל</tei:l>
          <tei:l>הֵן עַמִים חַכְמֵי לֵב יִקְּרָאוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/14"/>
        <tei:lg>
          <tei:l>אִישׁ הָאֲדָמָה שׂרֵקּ נֹטֵעַ</tei:l>
          <tei:l>יִשְׁקוֹט וִיקַּו לַעֲשׂוֹת פִּרְיֵהוּ,</tei:l>
          <tei:l>כֵּן לֹא תִּכָּזֵב תִּקְוַת עָם</tei:l>
          <tei:l>יָשִׂים אַנְשֵׁי דַעַת מַחְסֵהוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/15"/>
        <tei:lg>
          <tei:l>אִם אֵיבָה בֵּין אַחִים פָּרָחָה</tei:l>
          <tei:l>יַד הִסְכְלוּת הָיְּתָה בַּמָעַל,</tei:l>
          <tei:l>יוֹם הַתְּבוּנָה מָרוֹם זָרָחָה</tei:l>
          <tei:l>הִנֵה נֻתַּץ מִזְבַּח הַבָּעַל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/16"/>
        <tei:lg>
          <tei:l>כָּבְתָה לַהַב הַמַשְׁטֵמָּה</tei:l>
          <tei:l>כׇּל עוֹשֵֹה טוֹב נָכוֹן בָּטוּחַ,</tei:l>
          <tei:l>לִיסוֹד מוּסָר הִנֵה שׁוּמָה׃</tei:l>
          <tei:l>אֵין שַׁלִיט לִכְּלוֹא אֶת הָרוּחַ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/17"/>
        <tei:lg>
          <tei:l>עַל כׇּל מַעֲשֶׂה אִם טוֹב אִם רָע</tei:l>
          <tei:l>הָאָדָם יִרְאֶה לָעֵינָיִם,</tei:l>
          <tei:l>הַאֱמֶת אִם שֶׁקֶר יִנְחַל לֵב</tei:l>
          <tei:l>יִבְחַן הַיוֹשְׁבִי בַשָׁמָיִם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/18"/>
        <tei:lg>
          <tei:l>מוֹסְרוֹת הַמַדָע כִּי נִתָּקוּ</tei:l>
          <tei:l>שָׁלוֹם לָאִישׁ יֵיטִיב מַעְשֵׂהוּ</tei:l>
          <tei:l>יוֹם נִגְלוֹת תּוֹרַת הָאָדָם</tei:l>
          <tei:l>סָרָה קִנְאַת אִישׁ מֵרֵעֵהוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/19"/>
        <tei:lg>
          <tei:l>תּוֹסֵף אֶרֶץ כֹּחָהּ לָעָם</tei:l>
          <tei:l>יָשִׁימוּ מִשְׁפָּחוֹת עָלֶיהָ,</tei:l>
          <tei:l>כִּי כֵן צִוָה יוֹצְּרָה לָשָׁבֶת</tei:l>
          <tei:l>תֵרֶב טּוֹבָה בִּרְכוֹת אוֹכְלֶיהָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/20"/>
        <tei:lg>
          <tei:l>בֵּית יַעֲקֹב! שָׁבַעְתָּ יָגוֹן</tei:l>
          <tei:l>יָרַדְתָּ פֶלָא עַל לֹא פָּשַׁע</tei:l>
          <tei:l>הָסֵר תּוּגָה כִּי יֵשׁ אַחְרִית,</tei:l>
          <tei:l>הִנֵה יוֹם הַפְּדוּת וּשְׁנַת יֶשַׁע׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/21"/>
        <tei:lg>
          <tei:l>גַם לֵב אַרְיֵה וּפְרִיץ חַיוֹת</tei:l>
          <tei:l>יִפּוֹל יוֹם נַפְשׁוֹ בִנְחֻשְׁתָּיִם,</tei:l>
          <tei:l>אַף חָכְמַת אָדָם תִּתְבַלָע</tei:l>
          <tei:l>תָּמָס יַהְלוֹךְ לִבּוֹ בַּמָיִם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/22"/>
        <tei:lg>
          <tei:l>גַם בָּנֶיךָ הוֹסִיפוּ לֶקַח —</tei:l>
          <tei:l>דִרְשׁוּ סִפְרֵי עִתִּים וּקְרָאוּ׃</tei:l>
          <tei:l>כִּי לִבָּם לֹא נִצְפַּן מִשֵׂכֶל —</tei:l>
          <tei:l>עֵת רַחֲמִים בָּאֲרָצוֹת מָצָאוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/23"/>
        <tei:lg>
          <tei:l>קוּמוּ אַחִים וּתְנוּ תוֹרָה</tei:l>
          <tei:l>הִתְחַזְקוּ וַעְשׂוּ כַמִצְוָה,</tei:l>
          <tei:l>דַת הָאָרֶץ לָנוּ מִשְׁמָרֶת</tei:l>
          <tei:l>כִּי בָאנוּ בִּבְרִית הָאַחְוָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/24"/>
        <tei:lg>
          <tei:l>עֵדִים אַתֶּם יוֹשְׁבֵי הָאָרֶץ</tei:l>
          <tei:l>עֵד מִזְבַּח הַבְּרִית בֵּינוֹתֵנוּ,</tei:l>
          <tei:l>אִם חֵפֶץ לָנוּ בַּחַיִים</tei:l>
          <tei:l>יוֹם בּוֹא שֵׁנִית בַּרְזֶל נַפְשֵׁנוּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/25"/>
        <tei:lg>
          <tei:l>נוֹרָא עֶלְיוֹן עַל כׇּל נוֹצָר</tei:l>
          <tei:l>נִפְלָאוֹת אֵלֵינוּ עָשִׂיתָ,</tei:l>
          <tei:l>צִבְאוֹת שַׁחַק יִשְׁמְרוּ חֻקֶּיךָ</tei:l>
          <tei:l>אִישׁ אִישׁ אֶל יַד מַעְגָל צִוִיתָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/26"/>
        <tei:lg>
          <tei:l>לָרוּח מִשְׁקָל לַיָם חֹק</tei:l>
          <tei:l>קֶצֶב לַכֹּל יָדְךָ עָשָׂתָה,</tei:l>
          <tei:l>מִצַלְמָוֶת תַּהְלוּכוֹת אוֹר</tei:l>
          <tei:l>וּסְדָרִים מִתֹּהוּ קָרָאתָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/27"/>
        <tei:lg>
          <tei:l>הָאֵר פָּנֶיךָ לִישָׁרִים</tei:l>
          <tei:l>יִתְרוֹן אֶרֶץ בַּכֹּל יִדְרוֹשׁוּ</tei:l>
          <tei:l>כִּי תוֹרֵם אַתָּה הַנְכוֹחָה</tei:l>
          <tei:l>דָתֵי עָם בִּתְבוּנָה יִפְרוֹשוּ,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/28"/>
        <tei:lg>
          <tei:l>אִם בַּרְזֶל שָׁמֶיךָ מַעָל</tei:l>
          <tei:l>שָוְא יַעְמּוֹל הַחוֹרֵשׁ לִזְרוֹעַ,</tei:l>
          <tei:l>וּמִי יִשְׁפּוֹט רֵאשִׁית עַמִים</tei:l>
          <tei:l>בִּלְתִּי תִּתְּךָ לוֹ לֵב לִשְׁמוֹעַ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/29"/>
        <tei:lg>
          <tei:l>אַשְׁרַיכֶם מַחְזִּיקֵי בַתּוֹם</tei:l>
          <tei:l>דוֹר אַחֲרוֹן בָּכֶם יִשְׁתַּבֵּחַ,</tei:l>
          <tei:l>הִנֵה הִצַבְתֶּם לָכֶם יָד</tei:l>
          <tei:l>שֵׁם יִכּוֹן עוֹלָם כַּיָרֵחַ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/30"/>
        <tei:lg>
          <tei:l>עַם נִבְרָא בָּכֵֶם יִתְבָּרֵךְ</tei:l>
          <tei:l>יַעַן קַמְתֶּם לַעְמוֹד בָּפָרֶץ,</tei:l>
          <tei:l>עֵקֶּב טוֹב תִּהְיוּ לִתְהִלָה</tei:l>
          <tei:l>כִּימֵי שָׁמַיִם עַל הָאָרֶץ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lamnatseach_shir_bing/31"/>
        <tei:lg>
          <tei:l>אַשְׁרֵךְ אֶרֶץ צָרְפַת אַשְׁרֵךְ,</tei:l>
          <tei:l>שָׁחוּ לֶעָפָר מַחְרִיבָיִךְ,</tei:l>
          <tei:l>שַלְוַת הַשְׁקֵט בִּנְוָת צִדְקֵּךְ,</tei:l>
          <tei:l>מִבְטַח עֹז בִּזְרוֹעַ בָּנָיִךְ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>