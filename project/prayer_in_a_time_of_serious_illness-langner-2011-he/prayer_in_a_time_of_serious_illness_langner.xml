  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_in_a_time_of_serious_illness_langner">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_in_a_time_of_serious_illness_langner/5"/>
        <tei:lg>
          <tei:l>כִּי מַלְאָכָיו יְצַוֶּה לָּךְ</tei:l>
          <tei:l>לִשְׁמָרְךָ בְּכָל דְּרָכֶיךָ׃ <tei:bibl>(תהלים צא:יא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_in_a_time_of_serious_illness_langner/7"/>
        <tei:lg>
          <tei:l>שְׁמַע יִשְׂרָאֵל</tei:l>
          <tei:l>יְיָ אֱלֹהֵינוּ</tei:l>
          <tei:l>יְיָ אֶחָד׃ <tei:bibl>(דברים ו:ד)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
