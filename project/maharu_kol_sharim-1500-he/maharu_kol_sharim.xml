    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:maharu_kol_sharim">
        <tei:head>מַֽהֲרוּ כׇּל־שָׁרִים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maharu_kol_sharim/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מַֽ</tei:seg>הֲרוּ כׇּל־שָׁרִים וּבְרֹב הוֹן וָאֵל</tei:l>
          <tei:l>שִֽׁירוּ שִׁירָה לָאֵל צוּר דַר בִּמְעוֹנַי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maharu_kol_sharim/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שֶׁ</tei:seg>גָּזַר יָם סוּף וּבְתוֹכוֹ עַם אֵל</tei:l>
          <tei:l>נִקְרָאִים בָּנִים עָבְרוּ בַּהֲמוֹנַי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maharu_kol_sharim/4"/>
        <tei:lg>
          <tei:l>אֶתְחַנֵּן אַמְתֵּן חַנּוּן</tei:l>
          <tei:l>טוֹב רֶֽנֶן אֶתֵּן מָרוֹם</tei:l>
          <tei:l>נְעִילָה וּתְהִלָּה</tei:l>
          <tei:l>וּתְחִנָּה לֵאלֹהֵי אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maharu_kol_sharim/5"/>
        <tei:lg>
          <tei:l>הִנֵּה עֵינָי הֵן לֹא־יָנוּם</tei:l>
          <tei:l>וְלֹא־יִשּׁוּנִי אִם־אֶתֵּן שֵׁנָה</tei:l>
          <tei:l>לָתֵת מַעֲלָה לְאֵל נַעֲלָה</tei:l>
          <tei:l>וְנִשָּׂא אָמֵן חַנּוּן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maharu_kol_sharim/6"/>
        <tei:lg>
          <tei:l>טוֹב נָתַן בּוֹ אֶתְחַתֵּן</tei:l>
          <tei:l>אֲשַׁנֵּן תּוֹרָה וָאֶתְּנָה</tei:l>
          <tei:l>יוֹם וָלַֽיְלָה שִׁיר וּרְנָנָה</tei:l>
          <tei:l>לֵאלֹהֵי מְרוֹמָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maharu_kol_sharim/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הַ</tei:seg>מְקַּוִים הַטּוֹב הוֹדוּ כִּי הָאֵל</tei:l>
          <tei:l>הוּא יוֹסִיף שֵׁנִית לְקִבּוּץ אֶת־בָּנַי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:maharu_kol_sharim/8"/>
        <tei:lg>
          <tei:l>אָ֣ז יָשִֽׁיר־מֹשֶׁה֩ וּבְנֵ֨י יִשְׂרָאֵ֜ל</tei:l>
          <tei:l>אֶת־הַשִּׁירָ֤ה הַזֹּאת֙ לַֽיהֹוָ֔ה׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
