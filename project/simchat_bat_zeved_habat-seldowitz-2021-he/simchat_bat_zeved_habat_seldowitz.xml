    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:simchat_bat_zeved_habat_seldowitz">
        <tei:head>שמחת בת (זבד הבת)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:simchat_bat_zeved_habat_seldowitz/1"/>
        <tei:lg>
          <tei:l>יוֹנָתִ֞י</tei:l>
          <tei:l>בְּחַגְוֵ֣י הַסֶּ֗לַע</tei:l>
          <tei:l>בְּסֵ֙תֶר֙ הַמַּדְרֵגָ֔ה</tei:l>
          <tei:l>הַרְאִ֙ינִי֙ אֶת־מַרְאַ֔יִךְ</tei:l>
          <tei:l>הַשְׁמִיעִ֖נִי אֶת־קוֹלֵ֑ךְ</tei:l>
          <tei:l>כִּי־קוֹלֵ֥ךְ עָרֵ֖ב</tei:l>
          <tei:l>וּמַרְאֵ֥יךְ נָאוֶֽה <tei:bibl>(שיר השירים ב:יד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:simchat_bat_zeved_habat_seldowitz/2"/>
        <tei:lg>
          <tei:l>אַחַ֥ת הִיא֙ יוֹנָתִ֣י תַמָּתִ֔י</tei:l>
          <tei:l>אַחַ֥ת הִיא֙ לְאִמָּ֔הּ</tei:l>
          <tei:l>בָּרָ֥ה הִ֖יא לְיֽוֹלַדְתָּ֑הּ</tei:l>
          <tei:l>רָא֤וּהָ בָנוֹת֙ וַֽיְאַשְּׁר֔וּהָ</tei:l>
          <tei:l>מְלָכ֥וֹת וּפִֽילַגְשִׁ֖ים וַֽיְהַלְלֽוּהָ <tei:bibl>(שיר השירים ו:ט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:simchat_bat_zeved_habat_seldowitz/4"/>
        <tei:lg>
          <tei:l>מִי שֶׁבֵּרַךְ אִמּוֹתֵינוּ</tei:l>
          <tei:l>שָׂרָה וְרִבְקָה. רָחֵל וְלֵאָה.</tei:l>
          <tei:l>וּמִרְיָם הַנְּבִיאָה וַאֲבִיגַיִל.</tei:l>
          <tei:l>וְאֶסְתֵּר הַמַּלְכָּה בַּת אֲבִיחַיִל.</tei:l>
          <tei:l>הוּא יְבָרֵךְ אֶת הַיַּלְדָּה הַנְּעִימָה הַזּאת.</tei:l>
          <tei:l>וְיִקָּרֵא שְׁמָהּ בְּיִשְׂרָאֵל</tei:l>
          <tei:l>
            <tei:note type="instruction">(שמהּ)</tei:note>
          </tei:l>
          <tei:l>בְּמַזַּל טוֹב וּבְשַׁעַת בְּרָכָה.</tei:l>
          <tei:l>וִיגַדְּלֶהָ בִּבְרִיאוּת שָׁלוֹם וּמְנוּחָה.</tei:l>
          <tei:l>לְתוֹרָה וּלְחֻפָּה וּלְמַעֲשִׂים טוֹבִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:simchat_bat_zeved_habat_seldowitz/5"/>
        <tei:lg>
          <tei:l>לְתוֹרָה וּלְחֻפָּה וּלְמַעֲשִׂים טוֹבִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:simchat_bat_zeved_habat_seldowitz/6"/>
        <tei:lg>
          <tei:l>וִיזַכֶּה לְאָבִיהָ וּלְאִמָּהּ לִרְאוֹת בְּשִׂמְחָתָהּ</tei:l>
          <tei:l>וּבְחֻפָּתָהּ. בְּבָנִים וְעשֶׁר וְכָבוֹד.</tei:l>
          <tei:l>דְּשֵׁנִים וְרַעֲנַנִּים יְנוּבוּן בְּשֵׂיבָה.</tei:l>
          <tei:l>וְכֵן יְהִי רָצוֹן</tei:l>
          <tei:l>וְנאמַר אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:simchat_bat_zeved_habat_seldowitz/8"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>ה׳ אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם</tei:l>
          <tei:l>הַגּוֹמֵל לְחַיָּבִים טוֹבוֹת</tei:l>
          <tei:l>שֶׁגְּמָלַנִי כׇּל טוֹב׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:simchat_bat_zeved_habat_seldowitz/9"/>
        <tei:lg>
          <tei:l>אָמֵן׃</tei:l>
          <tei:l>מִי שֶׁגְמַלְךָ כֹּל טוֹב</tei:l>
          <tei:l>הוּא יִגְמַלְךָ כֹּל טוֹב סֶלָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:simchat_bat_zeved_habat_seldowitz/10"/>
        <tei:lg>
          <tei:l>יְבָרֶכְךָ ה׳</tei:l>
          <tei:l>וְיִשְמְרֶךָ׃</tei:l>
          <tei:l>יָּאֵּר ה׳ פָּנָּיו אֵּלֶיךָ</tei:l>
          <tei:l>וִיחֻנֶךָּ׃</tei:l>
          <tei:l>יִשָּא ה׳ פָּנָּיו אֵּלֶיךָ</tei:l>
          <tei:l>וְיָּשֵּם לְךָ שָּלוֹם׃</tei:l>
          <tei:l>
            <tei:bibl>(במדבר ו:כד-כו)</tei:bibl>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:simchat_bat_zeved_habat_seldowitz/11"/>
        <tei:lg>
          <tei:l>מי שברך אבותינו</tei:l>
          <tei:l>אברהם יצחק ויעקב,</tei:l>
          <tei:l>הוא יברך את האשה היולדת</tei:l>
          <tei:l><tei:note type="instruction">(שם)</tei:note> בת <tei:note type="instruction">(שם האב)</tei:note></tei:l>
          <tei:l>ואת בתה הנולדה לה במזל טוב</tei:l>
          <tei:l>ויקרא שמה בישראל</tei:l>
          <tei:l><tei:note type="instruction">(שם)</tei:note> בת <tei:note type="instruction">(שם אב התנוקת)</tei:note></tei:l>
          <tei:l>בעבור שבעלה</tei:l>
          <tei:l>ואביה יתן לצדקה.</tei:l>
          <tei:l>בשכר זה</tei:l>
          <tei:l>יגדלה לתורה לחופה ולמעשים טובים</tei:l>
          <tei:l>ונאמר אמן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:simchat_bat_zeved_habat_seldowitz/13"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>ה׳ אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הַעוֹלָם</tei:l>
          <tei:l>הַטֹוב וְהַּמֵּטִיב׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:simchat_bat_zeved_habat_seldowitz/14"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>ה׳ אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הַעוֹלָם</tei:l>
          <tei:l>שֶׁהֶחֱיָנוּ וְקִיְּמָנוּ</tei:l>
          <tei:l>וְהִגִּיעָנוּ לַזְּמַן הַזֶּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:simchat_bat_zeved_habat_seldowitz/16"/>
        <tei:lg>
          <tei:l>וַתֹּ֣אמֶר שָׂרָ֔ה</tei:l>
          <tei:l>צְחֹ֕ק עָ֥שָׂה לִ֖י אֱלֹהִ֑ים כׇּל־הַשֹּׁמֵ֖עַ יִֽצְחַק־לִֽי׃ <tei:bibl>(בראשית כא:ו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:simchat_bat_zeved_habat_seldowitz/17"/>
        <tei:lg>
          <tei:l>וַתֹּ֣אמֶר לֵאָ֔ה... בָּ֣א גָ֑ד... בְּאׇשְׁרִ֕י...</tei:l>
          <tei:l>הַפַּ֙עַם֙ אוֹדֶ֣ה אֶת־יְהֹוָ֔ה׃ <tei:bibl>(בראשית כט:לה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:simchat_bat_zeved_habat_seldowitz/18"/>
        <tei:lg>
          <tei:l>וַתִּתְפַּלֵּ֤ל חַנָּה֙ וַתֹּאמַ֔ר</tei:l>
          <tei:l>אֵין־קָד֥וֹשׁ כַּיהֹוָ֖ה כִּ֣י אֵ֣ין בִּלְתֶּ֑ךָ וְאֵ֥ין צ֖וּר כֵּאלֹהֵֽינוּ׃ <tei:bibl>(שמואל א׳ ב:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:simchat_bat_zeved_habat_seldowitz/19"/>
        <tei:lg>
          <tei:l>שֶׁבַע נְבִיאוֹת מַאן נִינְהוּ</tei:l>
          <tei:l>שָׂרָה מִרְיָם דְּבוֹרָה חַנָּה אֲבִיגַיִל חוּלְדָּה וְאֶסְתֵּר׃ <tei:bibl>(מגילה יד א׳)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
