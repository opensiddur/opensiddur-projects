  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_berlin_pride_bar_ami">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_berlin_pride_bar_ami/1"/>
        <tei:lg>
          <tei:l>Quelle allen Mitgefühls und aller Liebe,</tei:l>
          <tei:l>an diesem Wochenende des Zusammenkommens und Feierns</tei:l>
          <tei:l>kommen wir mit dankbarem Herzen vor Dich.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_berlin_pride_bar_ami/2"/>
        <tei:lg>
          <tei:l>Mit der Einheit als unserem Leitlicht</tei:l>
          <tei:l>stehen wir in Stolz und Freude zusammen,</tei:l>
          <tei:l>um die Vielfalt Deiner Schöpfung zu umarmen.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_berlin_pride_bar_ami/3"/>
        <tei:lg>
          <tei:l>Möge Deine göttliche Gegenwart uns begleiten</tei:l>
          <tei:l>und diesen Anlass mit Deinem Segen erfüllen.</tei:l>
          <tei:l>Unsere Herzen sind erfüllt von Verständnis und Akzeptanz.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_berlin_pride_bar_ami/4"/>
        <tei:lg>
          <tei:l>Schenke uns den Mut, Grenzen abzubauen,</tei:l>
          <tei:l>um Vorurteile und Diskriminierung zu bekämpfen</tei:l>
          <tei:l>und eine Welt der Gerechtigkeit und Gleichheit zu schaffen.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_berlin_pride_bar_ami/5"/>
        <tei:lg>
          <tei:l>Im Geiste unserer heiligen Lehren</tei:l>
          <tei:l>lass uns den göttlichen Funken in jeder Seele erkennen</tei:l>
          <tei:l>und die Heiligkeit jedes Menschen ehren.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_berlin_pride_bar_ami/6"/>
        <tei:lg>
          <tei:l>Segne uns mit Stärke und Widerstandsfähigkeit,</tei:l>
          <tei:l>während wir uns bemühen, Herausforderungen zu meistern</tei:l>
          <tei:l>und den Weg in eine bessere Zukunft zu ebnen.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_berlin_pride_bar_ami/7"/>
        <tei:lg>
          <tei:l>In diesem heiligen Moment des Berlin Pride</tei:l>
          <tei:l>möge Deine Liebe durch uns fließen</tei:l>
          <tei:l>und uns in Einheit und Harmonie verbinden.</tei:l>
          <tei:l>Und so sagen wir:</tei:l>
          <tei:l><tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
