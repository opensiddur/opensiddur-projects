    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ashirah_keshirat_mosheh">
        <tei:head>אָשִֽׁירָה כְּשִׁירַת מֹשֶׁה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashirah_keshirat_mosheh/1"/>
        <tei:lg>
          <tei:l>אָשִֽׁירָה כְּשִׁירַת מֹשֶׁה</tei:l>
          <tei:l>שִׁיר לֹא יִנָּשֶׁה</tei:l>
          <tei:l>אָז יָשִׁיר מֹשֶׁה</tei:l>
          <tei:l>אֶת־דִּבְרֵי הַשִּׁירָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashirah_keshirat_mosheh/2"/>
        <tei:lg>
          <tei:l>אָשִֽׁירָה כְּשִׁירַת מִרְיָם</tei:l>
          <tei:l>עַל־שְׂפַת הַיָּם</tei:l>
          <tei:l>וַתָּֽשַׁר מִרְיָם</tei:l>
          <tei:l>אֶת־דִּבְרֵי הַשִּׁירָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashirah_keshirat_mosheh/3"/>
        <tei:lg>
          <tei:l>אָשִֽׁירָה כְּשִׁירַת יְהוֹשֻֽׁעַ</tei:l>
          <tei:l>בְּהַר הַגִּלְבּֽוֹעַ</tei:l>
          <tei:l>אָז יָשִׁיר יְהוֹשֻֽׁעַ</tei:l>
          <tei:l>אֶת־דִּבְרֵי הַשִּׁירָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashirah_keshirat_mosheh/4"/>
        <tei:lg>
          <tei:l>אָשִֽׁירָה כְּשִׁירַת דְּבוֹרָה</tei:l>
          <tei:l>בְּהַר תְּבֽוֹרָה</tei:l>
          <tei:l>וַתָּֽשַׁר דְּבוֹרָה</tei:l>
          <tei:l>אֶת־דִּבְרֵי הַשִּׁירָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashirah_keshirat_mosheh/5"/>
        <tei:lg>
          <tei:l>אָשִֽׁירָה כְּשִׁירַת חַנָּה</tei:l>
          <tei:l>עִם־בַּעֲלָהּ אֶלְקָנָה</tei:l>
          <tei:l>וַתָּֽשַׁר חַנָּה</tei:l>
          <tei:l>אֶת־דִּבְרֵי הַשִּׁירָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashirah_keshirat_mosheh/6"/>
        <tei:lg>
          <tei:l>אָשִֽׁירָה כְּשִׁירַת דָּוִד</tei:l>
          <tei:l>מִזְמוֹרִים יַצְמִיד</tei:l>
          <tei:l>וַיְדַבֵּר דָּוִד</tei:l>
          <tei:l>אֶת־דִּבְרֵי הַשִּׁירָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashirah_keshirat_mosheh/7"/>
        <tei:lg>
          <tei:l>אָשִֽׁירָה כְּשִׁירַת שְׁלֹמֹה</tei:l>
          <tei:l>בָּעֲטָרָ֗ה שֶׁעִטְּרָה־לּ֤וֹ אִמּוֹ֙</tei:l>
          <tei:l>שִׁ֥יר הַשִּׁירִ֖ים</tei:l>
          <tei:l>אֲשֶׁ֥ר לִשְׁלֹמֹֽה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashirah_keshirat_mosheh/8"/>
        <tei:lg>
          <tei:l>אָשִֽׁירָה כְּשִׁירַת יִשְׂרָאֵל</tei:l>
          <tei:l>בְּבִיאַת הַגּוֹאֵל</tei:l>
          <tei:l>אָז יָשִׁיר יִשְׂרָאֵל</tei:l>
          <tei:l>אֶת־דִּבְרֵי הַשִּׁירָה׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
