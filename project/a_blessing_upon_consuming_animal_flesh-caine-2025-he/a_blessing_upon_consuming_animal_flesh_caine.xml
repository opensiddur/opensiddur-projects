  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_blessing_upon_consuming_animal_flesh_caine">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_blessing_upon_consuming_animal_flesh_caine/2"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>ה׳ אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם</tei:l>
          <tei:l>בּוֹרֵא נֶפֶשׁ הַבָּשָׂר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_blessing_upon_consuming_animal_flesh_caine/4"/>
        <tei:lg>
          <tei:l>כִּי־הַדָּם הוּא בַּנֶּפֶשׁ יְכַפֵּר,</tei:l>
          <tei:l>לְכַפֵּר עַל־נַפְשֹׁתֵיכֶם,</tei:l>
          <tei:l>וַאֲנִי נְתַתִּיו לָכֶם עַל־הַמִּזְבֵּחַ׃ <tei:bibl>(אחר ויקרא יז:יא)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
