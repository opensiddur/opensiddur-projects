  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_pid_nezer_ayom_elazar_65983">
        <tei:head>אַאְפִּיד נֵֽזֶר אָיוֹם</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_pid_nezer_ayom_elazar_65983/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אַ</tei:seg>אְפִּיד נֵֽזֶר <tei:seg type="acrostic">אָ</tei:seg>יוֹם</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>שִׁלּוּשׁ קְדֻשָּׁה <tei:seg type="acrostic">בַּ</tei:seg>יּוֹם׃</tei:l>
          <tei:l><tei:seg type="acrostic">גִּ</tei:seg>בּֽוֹרֵי כֹחַ <tei:seg type="acrostic">גְּ</tei:seg>דֻלָּה</tei:l>
          <tei:l><tei:seg type="acrostic">דַּ</tei:seg>הֲרֽוּהוּ בְּבֵית <tei:seg type="acrostic">דְּ</tei:seg>גִילָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_pid_nezer_ayom_elazar_65983/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הֽ</tei:seg>וֹגֵי הֶֽגֶה <tei:seg type="acrostic">הֲ</tei:seg>מֻלָּה</tei:l>
          <tei:l><tei:seg type="acrostic">וַ</tei:seg>תְּקֽוּהוּ בְּהַלֵּל <tei:seg type="acrostic">וּ</tei:seg>מִלָּה׃</tei:l>
          <tei:l><tei:seg type="acrostic">ז</tei:seg>וֹכֵר לָעַד <tei:seg type="acrostic">זְ</tei:seg>כֻיּוֹת</tei:l>
          <tei:l><tei:seg type="acrostic">חַ</tei:seg>דְּשֽׁוּהוּ זֶֽמֶר <tei:seg type="acrostic">חַ</tei:seg>יּוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_pid_nezer_ayom_elazar_65983/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ט</tei:seg>וֹב עוֹמֵס <tei:seg type="acrostic">טֹֽ</tei:seg>רַח</tei:l>
          <tei:l><tei:seg type="acrostic">יַ</tei:seg>חֲדֽוּהוּ בְּחִדּוּשׁ <tei:seg type="acrostic">יָֽ</tei:seg>רֵחַ׃</tei:l>
          <tei:l><tei:seg type="acrostic">כּ</tei:seg>וֹבֵשׁ כׇּל <tei:seg type="acrostic">כְּ</tei:seg>עָסִים</tei:l>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>בַל אַף <tei:seg type="acrostic">לְ</tei:seg>הָשִׂים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_pid_nezer_ayom_elazar_65983/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מְ</tei:seg>שָׁרְתֵי בְּחִיל <tei:seg type="acrostic">מ</tei:seg>וֹרָא</tei:l>
          <tei:l><tei:seg type="acrostic">נָ</tei:seg>כְחָם הַלֲלוּ <tei:seg type="acrostic">נ</tei:seg>וֹרָא׃</tei:l>
          <tei:l><tei:seg type="acrostic">שַׂ</tei:seg>רְפֵי סְבִיב <tei:seg type="acrostic">סְ</tei:seg>עָרָה</tei:l>
          <tei:l><tei:seg type="acrostic">עֱ</tei:seg>נוּ לְמַעֲבִיר <tei:seg type="acrostic">עֶ</tei:seg>בְרָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_pid_nezer_ayom_elazar_65983/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>לִיאִים פִּצְחוּ <tei:seg type="acrostic">פֶ</tei:seg>ה</tei:l>
          <tei:l><tei:seg type="acrostic">צַ</tei:seg>לְצְלוּ הַכֹּל <tei:seg type="acrostic">צ</tei:seg>וֹפֶה׃</tei:l>
          <tei:l><tei:seg type="acrostic">קְ</tei:seg>הִלּוֹת עַם <tei:seg type="acrostic">קְ</tei:seg>דוֹשִׁים</tei:l>
          <tei:l><tei:seg type="acrostic">ר</tei:seg>וֹמֲמֽוּהוּ רִבֲבוֹת <tei:seg type="acrostic">ר</tei:seg>וֹעֲשִׁים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_pid_nezer_ayom_elazar_65983/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שֶֽׁ</tei:seg>מַע קוֹל <tei:seg type="acrostic">שׁ</tei:seg>וֹפָר</tei:l>
          <tei:l><tei:seg type="acrostic">תַּ</tei:seg>אֲזִין וְאַשְׁמָה <tei:seg type="acrostic">ת</tei:seg>וּפָר׃</tei:l>
          <tei:l><tei:note type="instruction">חזן:</tei:note> תְּשַׁלֵּשׁ שׁוֹפָרוֹת בְּהַר הַקֹּדֶשׁ</tei:l>
          <tei:l>וַאֲשַׁלֵּשׁ קְדֻשָּׁה בַּקֹּדֶשׁ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
