    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:el_mi_migoalei_avraham">
        <tei:head>אֶל מִי מִגּוֹאֲלֵי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_mi_migoalei_avraham/1"/>
        <tei:lg>
          <tei:l>אֶל מִי מִגּוֹאֲלֵי דָם אֶצְעַק</tei:l>
          <tei:l>וְיָדַי שָׁפְכוּ דָמִים</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_mi_migoalei_avraham/2"/>
        <tei:lg>
          <tei:l>בָּחַנְתִּי לִבּוֹת מְשַׂנְאִים</tei:l>
          <tei:l>וְאֵין שׂוֹנֵא אוֹתִי כִּלְבָבִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_mi_migoalei_avraham/3"/>
        <tei:lg>
          <tei:l>רָבוּ פִּצְעֵי אוֹיְבִים וּמַכּוֹתָם</tei:l>
          <tei:l>וְאֵין מוּכֵּה וּפָצוּעַ כְּנַפְשִׁי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_mi_migoalei_avraham/4"/>
        <tei:lg>
          <tei:l>הִדִּיחוּנִי מַשְׁחִיתִים לְחַבֵּל</tei:l>
          <tei:l>וְאֵין מַסִּית וּמַדִּיחַ כְּעֵינַי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_mi_migoalei_avraham/5"/>
        <tei:lg>
          <tei:l>מִגַּחַל אֶל גַּחַל הִתְהַלַּכְתִּי</tei:l>
          <tei:l>וְלֹא שְֹרָפַתְנִי אֵשׁ כְּחוֹם תַּאֲוָתִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_mi_migoalei_avraham/6"/>
        <tei:lg>
          <tei:l>בְּפַחִים נִלְכַּדְתִּי וּמְצוֹדוֹת</tei:l>
          <tei:l>וְלֹא לְכָדַנִי מוֹקֵשׁ כִּלְשׁוֹנִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_mi_migoalei_avraham/7"/>
        <tei:lg>
          <tei:l>נְשָׁכוּנִי נָחָשׁ וְעַקְרָב</tei:l>
          <tei:l>וְאֵין נוֹשֵׁךְ בְּשָׂרִי כְּשִׁינַּי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_mi_migoalei_avraham/8"/>
        <tei:lg>
          <tei:l>שׁוֹדְדִים עַל קַל רְדָפוּנִי</tei:l>
          <tei:l>וְאֵין רוֹדֵף אוֹתִי כְּרַגְלַי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_mi_migoalei_avraham/9"/>
        <tei:lg>
          <tei:l>מַכְאוֹבַי אִמְּצוּ מִמֶּנִּי</tei:l>
          <tei:l>וְאֵין מַכְאוֹבִי כְּמִרְיִי</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_mi_migoalei_avraham/10"/>
        <tei:lg>
          <tei:l>וִיכַבְּדוּ מַדְוֵי לְבָבִי</tei:l>
          <tei:l>וַעֲוֺנַי יוֹתֵר מִכּוּלָּם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_mi_migoalei_avraham/11"/>
        <tei:lg>
          <tei:l>אֶל מִי אֶצְעַק וְאֶל מִי</tei:l>
          <tei:l>וּמַחֲרִיבַי מִמֶּנִּי יֵצֵאוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_mi_migoalei_avraham/12"/>
        <tei:lg>
          <tei:l>לֹא מָצָאתִי לִי טוֹב</tei:l>
          <tei:l>כִּי אִם לָבוֹא בְּסֵתֶר רַחֲמֶיךָ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:el_mi_migoalei_avraham/13"/>
        <tei:lg>
          <tei:l>רַחֲמֶיךָ הַפְלֵא עַל לֵב הַנִּשְׁבָּר</tei:l>
          <tei:l>אֵל מֶלֶךְ יוֹשֵב עַל כִּסֵּא רַחֲמִים</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
