  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_wilderness_kavvanah_before_lighting_shabbat_candles_caine">
        <tei:head>A Wilderness Kavvanah before lighting Shabbat candles, by Rabbi Gila Caine</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_wilderness_kavvanah_before_lighting_shabbat_candles_caine/1"/>
        <tei:lg>
          <tei:l><j:divineName>My God</j:divineName> and <j:divineName>God of my ancestors</j:divineName>,</tei:l>
          <tei:l><j:divineName>Mother Earth</j:divineName>, <j:divineName>Mother of all mothers</j:divineName>.</tei:l>
          <tei:l><j:divineName>El Shadai</j:divineName>, <j:divineName>God of fields</j:divineName>,</tei:l>
          <tei:l><j:divineName>God of the Great sea</j:divineName>,</tei:l>
          <tei:l><j:divineName>Lord of wilderness</j:divineName>,</tei:l>
          <tei:l><j:divineName>Lady of endless forests</j:divineName>,</tei:l>
          <tei:l><j:divineName>Mistress of rivers</j:divineName>,</tei:l>
          <tei:l><j:divineName>Lady of swamps</j:divineName>,</tei:l>
          <tei:l><j:divineName>Goddess of the Wastelands</j:divineName>.</tei:l>
          <tei:l><j:divineName>Spirit-wind whistling through rocks</j:divineName>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_wilderness_kavvanah_before_lighting_shabbat_candles_caine/2"/>
        <tei:lg>
          <tei:l>Accept my Shabbat candles with love and compassion.</tei:l>
          <tei:l>Accept my fire as a burnt offering</tei:l>
          <tei:l>and my words as tribute.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_wilderness_kavvanah_before_lighting_shabbat_candles_caine/3"/>
        <tei:lg>
          <tei:l>Protect my family in our daily tumult</tei:l>
          <tei:l>guard my [<tei:note type="instruction">add:</tei:note> children and husband / wife / beloved]</tei:l>
          <tei:l>so we don’t lose our way</tei:l>
          <tei:l>between work and slavery.</tei:l>
          <tei:l>So we know how to let go.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_wilderness_kavvanah_before_lighting_shabbat_candles_caine/4"/>
        <tei:lg>
          <tei:l>Guard the sea,</tei:l>
          <tei:l>the great forests,</tei:l>
          <tei:l>protect each and every place with your mercy.</tei:l>
          <tei:l>Help us remember</tei:l>
          <tei:l>there is no place empty of your Awful holiness,</tei:l>
          <tei:l>but many places are empty of our sanctity,</tei:l>
          <tei:l>as is their preference.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_wilderness_kavvanah_before_lighting_shabbat_candles_caine/5"/>
        <tei:lg>
          <tei:l><j:divineName>Goddess of Mercy</j:divineName>,</tei:l>
          <tei:l><j:divineName>El Shaddai</j:divineName>,</tei:l>
          <tei:l>accept my prayer</tei:l>
          <tei:l>and direct my heart to the Wasteland.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
