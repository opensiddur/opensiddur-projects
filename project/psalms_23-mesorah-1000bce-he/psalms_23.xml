  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/23">
        <tei:head>תהלים כ״ג</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/23/1/a"/>
        <tei:lg>
          <tei:l>מִזְמ֥וֹר לְדָוִ֑ד</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/23/1/b"/>
        <tei:lg>
          <tei:l>יְהֹוָ֥ה רֹ֝עִ֗י</tei:l>
          <tei:l>לֹ֣א אֶחְסָֽר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/23/2/a"/>
        <tei:lg>
          <tei:l>בִּנְא֣וֹת דֶּ֭שֶׁא יַרְבִּיצֵ֑נִי</tei:l>
          <tei:l>עַל־מֵ֖י מְנֻח֣וֹת יְנַהֲלֵֽנִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/23/3"/>
        <tei:lg>
          <tei:l>נַפְשִׁ֥י יְשׁוֹבֵ֑ב</tei:l>
          <tei:l>יַֽנְחֵ֥נִי</tei:l>
          <tei:l>בְמַעְגְּלֵי־</tei:l>
          <tei:l>צֶ֝֗דֶק</tei:l>
          <tei:l>לְמַ֣עַן שְׁמֽוֹ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/23/4/a"/>
        <tei:lg>
          <tei:l>גַּ֤ם כִּֽי־אֵלֵ֨ךְ</tei:l>
          <tei:l>בְּגֵ֪יא צַלְמָ֡וֶת</tei:l>
          <tei:l>לֹא־אִ֘ירָ֤א רָ֗ע</tei:l>
          <tei:l>כִּי־אַתָּ֥ה עִמָּדִ֑י</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>שִׁבְטְךָ֥</tei:l>
          <tei:l>וּ֝מִשְׁעַנְתֶּ֗ךָ</tei:l>
          <tei:l>הֵ֣מָּה יְנַֽחֲמֻֽנִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/23/5/a"/>
        <tei:lg>
          <tei:l>תַּעֲרֹ֬ךְ לְפָנַ֨י ׀ שֻׁלְחָ֗ן</tei:l>
          <tei:l>נֶ֥גֶד צֹרְרָ֑י</tei:l>
          <tei:l>דִּשַּׁ֥נְתָּ בַשֶּׁ֥מֶן רֹ֝אשִׁ֗י</tei:l>
          <tei:l>כּוֹסִ֥י רְוָיָֽה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/23/6/a"/>
        <tei:lg>
          <tei:l>אַ֤ךְ ׀ ט֤וֹב וָחֶ֣סֶד</tei:l>
          <tei:l>יִ֭רְדְּפוּנִי כׇּל־יְמֵ֣י חַיָּ֑י</tei:l>
          <tei:l>וְשַׁבְתִּ֥י בְּבֵית־יְ֝הֹוָ֗ה לְאֹ֣רֶךְ יָמִֽים׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
