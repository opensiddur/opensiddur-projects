  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_agunot_refused_a_get_lisitsa">
        <tei:head>תפילה לעגונות ומסורבות הגט</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_agunot_refused_a_get_lisitsa/1"/>
        <tei:lg>
          <tei:l>מִי שֶׁעָנָה לְאִמּוֹתֵינוּ שָׂרָה רִבְקָה לֵאָה וְרָחֵל,</tei:l>
          <tei:l>הוּא יַעֲנֶה לַנָּשִׁים הָעֲגוּנוֹת וּמְסֹרָבוֹת הַגֵּט,</tei:l>
          <tei:l>וְיִפְרֹשׂ עֲלֵיהֶן סֻכַּת שָׁלוֹם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_agunot_refused_a_get_lisitsa/2"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן</tei:l>
          <tei:l>שֶׁיִּתֵּן חָכְמָה וְעֹז בְּיַד הַדַּיָּנִים</tei:l>
          <tei:l>לְהַתִּירָן מִכַּבְלֵיהֶן</tei:l>
          <tei:l>וִיעוֹרֵר תְּשׁוּבָה שְׁלֵמָה בְּלִבּוֹתֵיהֶם</tei:l>
          <tei:l>שֶׁל הַכּוֹבְלִים אוֹתָן.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_agunot_refused_a_get_lisitsa/3"/>
        <tei:lg>
          <tei:l>עוֹשֶׂה שָׁלוֹם בִּמְרוֹמָיו,</tei:l>
          <tei:l>הוּא יַעֲשֶׂה שָׁלוֹם עֲלֵיהֶן,</tei:l>
          <tei:l>וְנֹאמַר, אָמֵן.</tei:l>
        </tei:lg>
      </tei:div>
