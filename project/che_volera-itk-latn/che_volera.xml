  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:che_volera">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:che_volera/1"/>
        <tei:lg xml:lang="it">
          <tei:l>Che volera, che entendera,</tei:l>
          <tei:l>Quale cosa la contentera?</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:che_volera/2"/>
        <tei:lg xml:lang="it">
          <tei:l>Quale cosa vol di uno?</tei:l>
          <tei:l>Uno solo è il Creatore,</tei:l>
          <tei:l>baruḫ u baruḫ scemò.</tei:l>
          <tei:l>
            <tei:hi rend="italic">Amen!</tei:hi>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:che_volera/3"/>
        <tei:lg xml:lang="it">
          <tei:l>Quale cosa vol di due?</tei:l>
          <tei:l>Due tavole del patto,</tei:l>
          <tei:l>Uno solo è il Creatore,</tei:l>
          <tei:l>baruḫ u baruḫ scemò.</tei:l>
          <tei:l>
            <tei:hi rend="italic">Amen!</tei:hi>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:che_volera/4"/>
        <tei:lg xml:lang="it">
          <tei:l>Quale cosa vol di tre?</tei:l>
          <tei:l>Tre sono i nostri padri —</tei:l>
          <tei:l>Abraam, Gizḫac, e Giagnacob.</tei:l>
          <tei:l>Due tavole del patto,</tei:l>
          <tei:l>Uno solo è il Creatore,</tei:l>
          <tei:l>baruḫ u baruḫ scemò.</tei:l>
          <tei:l>
            <tei:hi rend="italic">Amen!</tei:hi>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:che_volera/5"/>
        <tei:lg xml:lang="it">
          <tei:l>Quale cosa vol di quattro?</tei:l>
          <tei:l>Quattro madri d’Israel —</tei:l>
          <tei:l>Sara, Ribca, Lea, Raḫel.</tei:l>
          <tei:l>Tre sono i nostri padri —</tei:l>
          <tei:l>Abraam, Gizḫac, e Giagnacob.</tei:l>
          <tei:l>Due tavole del patto,</tei:l>
          <tei:l>Uno solo è il Creatore,</tei:l>
          <tei:l>baruḫ u baruḫ scemò.</tei:l>
          <tei:l>
            <tei:hi rend="italic">Amen!</tei:hi>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:che_volera/6"/>
        <tei:lg xml:lang="it">
          <tei:l>Quale cosa vol di cinque?</tei:l>
          <tei:l>Cinque libri della Torà.</tei:l>
          <tei:l>Quattro madri d’Israel —</tei:l>
          <tei:l>Sara, Ribca, Lea, Raḫel.</tei:l>
          <tei:l>Tre sono i nostri padri —</tei:l>
          <tei:l>Abraam, Gizḫac, e Giagnacob.</tei:l>
          <tei:l>Due tavole del patto,</tei:l>
          <tei:l>Uno solo è il Creatore,</tei:l>
          <tei:l>baruḫ u baruḫ scemò.</tei:l>
          <tei:l>
            <tei:hi rend="italic">Amen!</tei:hi>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:che_volera/7"/>
        <tei:lg xml:lang="it">
          <tei:l>Quale cosa vol di sei?</tei:l>
          <tei:l>Sei i libri della Misnà.</tei:l>
          <tei:l>Cinque libri della Torà.</tei:l>
          <tei:l>Quattro madri d’Israel —</tei:l>
          <tei:l>Sara, Ribca, Lea, Raḫel.</tei:l>
          <tei:l>Tre sono i nostri padri —</tei:l>
          <tei:l>Abraam, Gizḫac, e Giagnacob.</tei:l>
          <tei:l>Due tavole del patto,</tei:l>
          <tei:l>Uno solo è il Creatore,</tei:l>
          <tei:l>baruḫ u baruḫ scemò.</tei:l>
          <tei:l>
            <tei:hi rend="italic">Amen!</tei:hi>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:che_volera/8"/>
        <tei:lg xml:lang="it">
          <tei:l>Quale cosa vol di sette?</tei:l>
          <tei:l>Sette giorni col Sciabbàd.</tei:l>
          <tei:l>Sei i libri della Misnà.</tei:l>
          <tei:l>Cinque libri della Torà.</tei:l>
          <tei:l>Quattro madri d’Israel —</tei:l>
          <tei:l>Sara, Ribca, Lea, Raḫel.</tei:l>
          <tei:l>Tre sono i nostri padri —</tei:l>
          <tei:l>Abraam, Gizḫac, e Giagnacob.</tei:l>
          <tei:l>Due tavole del patto,</tei:l>
          <tei:l>Uno solo è il Creatore,</tei:l>
          <tei:l>baruḫ u baruḫ scemò.</tei:l>
          <tei:l>
            <tei:hi rend="italic">Amen!</tei:hi>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:che_volera/9"/>
        <tei:lg xml:lang="it">
          <tei:l>Quale cosa vol di otto?</tei:l>
          <tei:l>Otto giorni della millà.</tei:l>
          <tei:l>Sette giorni col Sciabbàd.</tei:l>
          <tei:l>Sei i libri della Misnà.</tei:l>
          <tei:l>Cinque libri della Torà.</tei:l>
          <tei:l>Quattro madri d’Israel —</tei:l>
          <tei:l>Sara, Ribca, Lea, Raḫel.</tei:l>
          <tei:l>Tre sono i nostri padri —</tei:l>
          <tei:l>Abraam, Gizḫac, e Giagnacob.</tei:l>
          <tei:l>Due tavole del patto,</tei:l>
          <tei:l>Uno solo è il Creatore,</tei:l>
          <tei:l>baruḫ u baruḫ scemò.</tei:l>
          <tei:l>
            <tei:hi rend="italic">Amen!</tei:hi>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:che_volera/10"/>
        <tei:lg xml:lang="it">
          <tei:l>Quale cosa vol di nove?</tei:l>
          <tei:l>Nove mesi la partoriente.</tei:l>
          <tei:l>Otto giorni della millà.</tei:l>
          <tei:l>Sette giorni col Sciabbàd.</tei:l>
          <tei:l>Sei i libri della Misnà.</tei:l>
          <tei:l>Cinque libri della Torà.</tei:l>
          <tei:l>Quattro madri d’Israel —</tei:l>
          <tei:l>Sara, Ribca, Lea, Raḫel.</tei:l>
          <tei:l>Tre sono i nostri padri —</tei:l>
          <tei:l>Abraam, Gizḫac, e Giagnacob.</tei:l>
          <tei:l>Due tavole del patto,</tei:l>
          <tei:l>Uno solo è il Creatore,</tei:l>
          <tei:l>baruḫ u baruḫ scemò.</tei:l>
          <tei:l>
            <tei:hi rend="italic">Amen!</tei:hi>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:che_volera/11"/>
        <tei:lg xml:lang="it">
          <tei:l>Quale cosa vol di deci?</tei:l>
          <tei:l>Deci sono i commandamenti.</tei:l>
          <tei:l>Nove mesi la partoriente.</tei:l>
          <tei:l>Otto giorni della millà.</tei:l>
          <tei:l>Sette giorni col Sciabbàd.</tei:l>
          <tei:l>Sei i libri della Misnà.</tei:l>
          <tei:l>Cinque libri della Torà.</tei:l>
          <tei:l>Quattro madri d’Israel —</tei:l>
          <tei:l>Sara, Ribca, Lea, Raḫel.</tei:l>
          <tei:l>Tre sono i nostri padri —</tei:l>
          <tei:l>Abraam, Gizḫac, e Giagnacob.</tei:l>
          <tei:l>Due tavole del patto,</tei:l>
          <tei:l>Uno solo è il Creatore,</tei:l>
          <tei:l>baruḫ u baruḫ scemò.</tei:l>
          <tei:l>
            <tei:hi rend="italic">Amen!</tei:hi>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:che_volera/12"/>
        <tei:lg xml:lang="it">
          <tei:l>Quale cosa vol di undici?</tei:l>
          <tei:l>Undici son le principale stelle.</tei:l>
          <tei:l>Deci sono i commandamenti.</tei:l>
          <tei:l>Nove mesi la partoriente.</tei:l>
          <tei:l>Otto giorni della millà.</tei:l>
          <tei:l>Sette giorni col Sciabbàd.</tei:l>
          <tei:l>Sei i libri della Misnà.</tei:l>
          <tei:l>Cinque libri della Torà.</tei:l>
          <tei:l>Quattro madri d’Israel —</tei:l>
          <tei:l>Sara, Ribca, Lea, Raḫel.</tei:l>
          <tei:l>Tre sono i nostri padri —</tei:l>
          <tei:l>Abraam, Gizḫac, e Giagnacob.</tei:l>
          <tei:l>Due tavole del patto,</tei:l>
          <tei:l>Uno solo è il Creatore,</tei:l>
          <tei:l>baruḫ u baruḫ scemò.</tei:l>
          <tei:l>
            <tei:hi rend="italic">Amen!</tei:hi>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:che_volera/13"/>
        <tei:lg xml:lang="it">
          <tei:l>Quale cosa vol di dodici?</tei:l>
          <tei:l>Dodici tribù d’Israel.</tei:l>
          <tei:l>Undici son le principale stelle.</tei:l>
          <tei:l>Deci sono i commandamenti.</tei:l>
          <tei:l>Nove mesi la partoriente.</tei:l>
          <tei:l>Otto giorni della millà.</tei:l>
          <tei:l>Sette giorni col Sciabbàd.</tei:l>
          <tei:l>Sei i libri della Misnà.</tei:l>
          <tei:l>Cinque libri della Torà.</tei:l>
          <tei:l>Quattro madri d’Israel —</tei:l>
          <tei:l>Sara, Ribca, Lea, Raḫel.</tei:l>
          <tei:l>Tre sono i nostri padri —</tei:l>
          <tei:l>Abraam, Gizḫac, e Giagnacob.</tei:l>
          <tei:l>Due tavole del patto,</tei:l>
          <tei:l>Uno solo è il Creatore,</tei:l>
          <tei:l>baruḫ u baruḫ scemò.</tei:l>
          <tei:l>
            <tei:hi rend="italic">Amen!</tei:hi>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:che_volera/14"/>
        <tei:lg xml:lang="it">
          <tei:l>Quale cosa vol di tredici?</tei:l>
          <tei:l>Tredici articoli di fede.</tei:l>
          <tei:l>Dodici tribù d’Israel.</tei:l>
          <tei:l>Undici son le principale stelle.</tei:l>
          <tei:l>Deci sono i commandamenti.</tei:l>
          <tei:l>Nove mesi la partoriente.</tei:l>
          <tei:l>Otto giorni della millà.</tei:l>
          <tei:l>Sette giorni col Sciabbàd.</tei:l>
          <tei:l>Sei i libri della Misnà.</tei:l>
          <tei:l>Cinque libri della Torà.</tei:l>
          <tei:l>Quattro madri d’Israel —</tei:l>
          <tei:l>Sara, Ribca, Lea, Raḫel.</tei:l>
          <tei:l>Tre sono i nostri padri —</tei:l>
          <tei:l>Abraam, Gizḫac, e Giagnacob.</tei:l>
          <tei:l>Due tavole del patto,</tei:l>
          <tei:l>Uno solo è il Creatore,</tei:l>
          <tei:l>baruḫ u baruḫ scemò.</tei:l>
          <tei:l>
            <tei:hi rend="italic">Amen!</tei:hi>
          </tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
