  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:liturgical_additions_for_yachats">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:liturgical_additions_for_yachats/2"/>
        <tei:lg>
          <tei:l>הָאכְּדָּא קְצִס אלַלָּה לְבְּחַָאר עַלָא תְּנַעָאשׁ טְרִיק חִין</tei:l>
          <tei:l>כִׄרְגׅוּ אַגְׅדּוּדְּנָא וְלָאד יִשְׂרָאֵל מִן מְצַָאר</tei:l>
          <tei:l>עַלָא יֵד סִידְּנָא וְנַבִּינָא וְשָׁרִיפְׄנָא</tei:l>
          <tei:l>מוּסָה בִּן־עַמְרָם עַלֵיהִ אַסְּלָאם</tei:l>
          <tei:l>וְרְצָׄא כִּיף פַׄכְּהוּם מִן־הַָאדָאךְּ שִׁעְבּוּד׃</tei:l>
          <tei:l>הַָאכְּדָּא יְפֻׄכְּנָא מִן־הָאד לְגָּלוּת</tei:l>
          <tei:l>לְמַעַן שְׁמוֹ הַגָּדוֹל וְהַנּוֹרָא</tei:l>
          <tei:l>וְשָׁבוּ בָּנִים לִגְבוּלָם</tei:l>
          <tei:l>אָמֵן כֵּן יְהִי רָצוֹן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:liturgical_additions_for_yachats/4"/>
        <tei:lg>
          <tei:l>דְכִּיר לִגְׅדּוּדְּנָא לִּי כִׄרְגׅוּ מִן מְצַָאר</tei:l>
          <tei:l>וְעֲגַׅאיינְהוֹם מַצְרוּר פִׄתִיָיאבְּהוֹם עַלָא כּתַּפְנוֹם</tei:l>
        </tei:lg>
      </tei:div>
