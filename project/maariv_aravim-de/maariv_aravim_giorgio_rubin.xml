  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:maariv_aravim_giorgio_rubin">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:maariv_aravim_giorgio_rubin/1"/>
        <tei:lg>
          <tei:l>Gelobt seist Du,</tei:l>
          <tei:l>Ewiger, unser Gott,</tei:l>
          <tei:l>König der Welt,</tei:l>
          <tei:l>dessen Wort das dämmernde Zwielicht hervorruft,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:maariv_aravim_giorgio_rubin/2"/>
        <tei:lg>
          <tei:l>dessen Weisheit die Himmelspforten öffnet,</tei:l>
          <tei:l>die Zeiten ändert,</tei:l>
          <tei:l>Tag und Nacht wechseln heißt</tei:l>
          <tei:l>und den Kreislauf der Sterne ordnet</tei:l>
          <tei:l>im unermeßlichen Himmelsraume.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:maariv_aravim_giorgio_rubin/3"/>
        <tei:lg>
          <tei:l>Du bist Schöpfer des Tages und der Nacht</tei:l>
          <tei:l>und auf Dein Geheiß entrollen fich die Schwingen des Lichts</tei:l>
          <tei:l>und die Schatten der Finsterniß</tei:l>
          <tei:l>nach einer unüberschreitbaren Grenze.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:maariv_aravim_giorgio_rubin/4"/>
        <tei:lg>
          <tei:l>Du bist der Herr der Heere,</tei:l>
          <tei:l>der Ewiglebendige, unser König</tei:l>
          <tei:l>immerdar.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:maariv_aravim_giorgio_rubin/5"/>
        <tei:lg>
          <tei:l>Sei gepriesen, Ewiger,</tei:l>
          <tei:l>dessen Weisheit auch in der Dämmerung leuchtet.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
