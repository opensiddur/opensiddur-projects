    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_preceding_communal_prayer_during_the_coronavirus_holtzman">
        <tei:head>תפילה קודם תפילה בציבור בימי קורונה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_preceding_communal_prayer_during_the_coronavirus_holtzman/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">תפילה קודם תפילה בציבור</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_preceding_communal_prayer_during_the_coronavirus_holtzman/2"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן מִלְפָנֶיךָ</tei:l>
          <tei:l>שֶׁלֹא יִתְבּוֹדֵד שׁוּם אָדָם בְּסִבָּתִי,</tei:l>
          <tei:l>וְלֹא אֶתְבּוֹדֵד אֲנִי בְּסִבָּתָם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_preceding_communal_prayer_during_the_coronavirus_holtzman/3"/>
        <tei:lg>
          <tei:l>וְהַרְחִיקֵנִי מִכַּף כׇּל מְאֻמָּת</tei:l>
          <tei:l>וְסָפֵק מְאֻמָּת.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_preceding_communal_prayer_during_the_coronavirus_holtzman/4"/>
        <tei:lg>
          <tei:l>וְהַרְחִיקֵנִי מִמַּכְחִישׁ קוֹרוֹנָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_preceding_communal_prayer_during_the_coronavirus_holtzman/5"/>
        <tei:lg>
          <tei:l>וְאַל תְּבִיאֵנִי לִידֵי שְׁנֵי מֶטְרִים מִבַּעַל תַּסְמִינִים,</tei:l>
          <tei:l>בֵּין שֶׁהוּא עִם מַסֵּכָה וּבֵין שֶׁאֵינוֹ עִם מַסֵּכָה,</tei:l>
          <tei:l>וּמִדִּינוֹ שֶׁל בִּידוּד.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
