  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:mourners_kaddish_38408">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mourners_kaddish_38408/1"/>
        <tei:lg xml:lang="he">
          <tei:l>יִתְגַּדַּל</tei:l>
          <tei:l>וְיִתְקַדַּשׁ</tei:l>
          <tei:l>שְׁמֵהּ רַבָּא.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mourners_kaddish_38408/2"/>
        <tei:lg xml:lang="he">
          <tei:l>בְּעָלְמָא דִּי בְרָא כִרְעוּתֵהּ</tei:l>
          <tei:l>וְיַמְלִיךְ מַלְכוּתֵהּ,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mourners_kaddish_38408/3"/>
        <tei:lg xml:lang="he">
          <tei:l>בְּחַיֵּיכוֹן</tei:l>
          <tei:l>וּבְיוֹמֵיכוֹן</tei:l>
          <tei:l>וּבְחַיֵּי דְכׇל בֵּית יִשְׂרָאֵל,</tei:l>
          <tei:l>בַּעֲגָלָא וּבִזְמַן קָרִיב.</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mourners_kaddish_38408/4"/>
        <tei:lg xml:lang="he">
          <tei:l>יְהֵא שְׁמֵהּ רַבָּא מְבָרַךְ</tei:l>
          <tei:l>לְעָלַם וּלְעָלְמֵי עָלְמַיָּא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mourners_kaddish_38408/5"/>
        <tei:lg xml:lang="he">
          <tei:l>יִתְבָּרַךְ,</tei:l>
          <tei:l>וְיִשְׁתַּבַּח,</tei:l>
          <tei:l>וְיִתְפָּאֵר,</tei:l>
          <tei:l>וְיִתְרוֹמֵם,</tei:l>
          <tei:l>וְיִתְנַשּׂא,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mourners_kaddish_38408/6"/>
        <tei:lg xml:lang="he">
          <tei:l>וְיִתְהַדָּר,</tei:l>
          <tei:l>וְיִתְעַלֶּה,</tei:l>
          <tei:l>וְיִתְהַלָּל,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mourners_kaddish_38408/7"/>
        <tei:lg xml:lang="he">
          <tei:l>שְׁמֵהּ דְקֻדְשָׁא בְּרִיךְ הוּא.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mourners_kaddish_38408/8"/>
        <tei:lg xml:lang="he">
          <tei:l>לְעֵלָּא מִן כׇּל בִּרְכָתָא וְשִׁירָתָא,</tei:l>
          <tei:l>תֻּשְׁבְּחָתָא וְנֶחֱמָתָא,</tei:l>
          <tei:l>דַּאֲמִירָן בְּעָלְמָא,</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mourners_kaddish_38408/9"/>
        <tei:lg xml:lang="he">
          <tei:l>יְהֵא שְׁלָמָה רַבָּא מִן שְׁמַיָּא</tei:l>
          <tei:l>וְחַיִּים</tei:l>
          <tei:l>עָלֵינוּ וְעַל כׇּל יִשְֹרָאֵל,</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mourners_kaddish_38408/10"/>
        <tei:lg xml:lang="he">
          <tei:l>עוֹשֶׂה שָׁלוֹם בִּמְרוֹמָיו</tei:l>
          <tei:l>הוּא יַעֲשֶׂה שָׁלוֹם</tei:l>
          <tei:l>עָלֵינוּ וְעַל כׇּל יִשְׂרָאֵל</tei:l>
          <tei:l>וְעַל כׇּל יוֺשְׁבֵי תֵבֶל</tei:l>
          <tei:l>וְאִמְרוּ אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
