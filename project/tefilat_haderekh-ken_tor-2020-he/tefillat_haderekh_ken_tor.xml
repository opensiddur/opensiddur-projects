      <tei:div corresp="urn:x-opensiddur:text:prayer:tefillat_haderekh_ken_tor">
        <tei:head>תפילת הדרך</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:tefillat_haderekh_ken_tor/1"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן מִלְפָנַיִךְ</tei:l>
          <tei:l>רוּחַ שְׁכִינָה</tei:l>
          <tei:l>שֶׁתּוֹלִיכִי דְּרָכַי לְשָׁלוֹם</tei:l>
          <tei:l>וְתַצְעִידִי רַגְלַי לְשָׁלוֹם</tei:l>
          <tei:l>וְתַדְרִיכִי לִבִּי לְשָׁלוֹם</tei:l>
          <tei:l>וְתַגִּיעִינִי לִמְחוֹז חֶפְצִי</tei:l>
          <tei:l>לְחַיִּים וּלְשִׂמְחָה וּלְשָׁלוֹם</tei:l>
          <tei:l>הַצִּילִינִי מֵרִפְיוֹן הָרוּחַ וּמִתְּשִׁישׁוּת הַגּוּף</tei:l>
          <tei:l>וְהָפִיחִי כֹּחַ בְּפֹעַל יָדַי</tei:l>
          <tei:l>תְּנִי בִּי לֵב רוֹאֵה־טוֹב בְּכָל אָדָם,</tei:l>
          <tei:l>חָנֵּנִי בְּחֶסֶד וּבְרַחֲמִים לְחַזֵּק בַּהֶם אֶת שׁוּתָפַי וְאֶת עַצְמִי,</tei:l>
          <tei:l>אַמְּצִי רוּחִי לְהַמְשִׁיךְ וּלְבַקֵּשׁ,</tei:l>
          <tei:l>כִּי שׁוֹמַעַת אַתְּ קוֹל תַּחֲנוּן וְכָּל תְּפִלָּה</tei:l>
          <tei:l>וִיהִי רָצוֹן מִלְּפָנַיִךְ שֶׁיִתְקַיְּמוּ תְּפִלּוֹתַי</tei:l>
        </tei:lg>
