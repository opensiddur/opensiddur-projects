  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:morning_song_adler">
        <tei:head>Morning Song, a hymn by Felix Adler (1897)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:morning_song_adler/1"/>
        <tei:lg>
          <tei:l>Morning Song</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:morning_song_adler/2"/>
        <tei:lg>
          <tei:l>Splendor of the morning sunlight</tei:l>
          <tei:l>Shines into my heart to-day,</tei:l>
          <tei:l>Floods each cranny of my being</tei:l>
          <tei:l>With new strength and spirit gay.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:morning_song_adler/3"/>
        <tei:lg>
          <tei:l>Let me use the golden hours</tei:l>
          <tei:l>As they glide so swiftly by;</tei:l>
          <tei:l>Fill them with a precious freight of</tei:l>
          <tei:l>Truth and Love and Knowledge high.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:morning_song_adler/4"/>
        <tei:lg>
          <tei:l>And when evening comes and kindling</tei:l>
          <tei:l>Stars my conduct seem to ask,</tei:l>
          <tei:l>May I look aloft and tell them</tei:l>
          <tei:l>I have finished well my task.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
