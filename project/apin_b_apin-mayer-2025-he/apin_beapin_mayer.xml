  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:apin_beapin_mayer">
        <tei:head>אַפִּין בְּאַפִּין</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:apin_beapin_mayer/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אַ</tei:seg>פִּין בְּאַפִּין אִתְגְּלִי לְמֹשֶׁה</tei:l>
          <tei:l>הַכְדֵין קַם נְבִיָּא הֵיךְ־מֹשֶׁה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:apin_beapin_mayer/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>עוּ בְנֵי עַם חַבִּיב בִּסְפַר דְּמֹשֶׁה</tei:l>
          <tei:l>הַכְדֵין קַם נְבִיָּא הֵיךְ־מֹשֶׁה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:apin_beapin_mayer/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">גּ</tei:seg>וּבְרִין רַבְרְבִין בְּאַבְקָא דְמֹשֶׁה</tei:l>
          <tei:l>הַכְדֵין קַם נְבִיָּא הֵיךְ־מֹשֶׁה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:apin_beapin_mayer/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">דָּ</tei:seg>רוֹשַׁיָּא וּפַשַּׁרַיָּא תַּלְמִידוֹי דְמֹשֶׁה</tei:l>
          <tei:l>הַכְדֵין קַם נְבִיָּא הֵיךְ־מֹשֶׁה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:apin_beapin_mayer/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ה</tei:seg>וּא מוֹרְיָינָא וְרַבָּנָא מֹשֶׁה</tei:l>
          <tei:l>הַכְדֵין קַם נְבִיָּא הֵיךְ־מֹשֶׁה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:apin_beapin_mayer/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>כׇל־נְבִיאֵי עַבְדּוֹי דְּמֹשֶׁה</tei:l>
          <tei:l>הַכְדֵין קַם נְבִיָּא הֵיךְ־מֹשֶׁה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:apin_beapin_mayer/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">זַ</tei:seg>הֲרָא אַזְהֵיר מִן־אַנְפּוֹי דְּמֹשֶׁה</tei:l>
          <tei:l>הַכְדֵין קַם נְבִיָּא הֵיךְ־מֹשֶׁה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:apin_beapin_mayer/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">חֲ</tei:seg>זָא שְׁכִינְתָּא דֵאלָהָנָא מֹשֶׁה</tei:l>
          <tei:l>הַכְדֵין קַם נְבִיָּא הֵיךְ־מֹשֶׁה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:apin_beapin_mayer/9"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">טַ</tei:seg>עֲמֵי טָבֵי אַלֵּיף לָן מֹשֶׁה</tei:l>
          <tei:l>הַכְדֵין קַם נְבִיָּא הֵיךְ־מֹשֶׁה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:apin_beapin_mayer/10"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>דְעֵי נְבוּאֲתָא כְּמוֹזָא קֳדָם מֹשֶׁה</tei:l>
          <tei:l>הַכְדֵין קַם נְבִיָּא הֵיךְ־מֹשֶׁה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:apin_beapin_mayer/11"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כְּ</tei:seg>הֶדְיוֹטִין מַלְכַיָּא לׇקֳבֵל מֹשֶׁה</tei:l>
          <tei:l>הַכְדֵין קַם נְבִיָּא הֵיךְ־מֹשֶׁה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:apin_beapin_mayer/12"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">לֵ</tei:seg>יתֵי נְבִיאֵי בְּרוּמָא דְּמֹשֶׁה</tei:l>
          <tei:l>הַכְדֵין קַם נְבִיָּא הֵיךְ־מֹשֶׁה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:apin_beapin_mayer/13"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מַ</tei:seg>נּוּ דִּמְתִיל בְּקוּדְשָׁא לְמֹשֶׁה</tei:l>
          <tei:l>הַכְדֵין קַם נְבִיָּא הֵיךְ־מֹשֶׁה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:apin_beapin_mayer/14"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">נְ</tei:seg>חַתַת אוֹרָיְתַן בִּידָא דְּמֹשֶׁה</tei:l>
          <tei:l>הַכְדֵין קַם נְבִיָּא הֵיךְ־מֹשֶׁה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:apin_beapin_mayer/15"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">סָ</tei:seg>בַיָּא וְטַלְיָתָא אוֹקִירוּ לְמֹשֶׁה</tei:l>
          <tei:l>הַכְדֵין קַם נְבִיָּא הֵיךְ־מֹשֶׁה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:apin_beapin_mayer/16"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">עַ</tei:seg>בְדָּא דַייָ הֲוָה מֹשֶׁה</tei:l>
          <tei:l>הַכְדֵין קַם נְבִיָּא הֵיךְ־מֹשֶׁה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:apin_beapin_mayer/17"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פִּ</tei:seg>תְגָמִין עַסְרָא אַחֵית מֹשֶׁה</tei:l>
          <tei:l>הַכְדֵין קַם נְבִיָּא הֵיךְ־מֹשֶׁה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:apin_beapin_mayer/18"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">צְ</tei:seg>וַח וַאֲמָרָן לַנָא מֹשֶׁה</tei:l>
          <tei:l>הַכְדֵין קַם נְבִיָּא הֵיךְ־מֹשֶׁה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:apin_beapin_mayer/19"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">ק</tei:seg>וּדְשָׁא בְּרִיךְ הוּא מַלִּיל עִם־מֹשֶׁה</tei:l>
          <tei:l>הַכְדֵין קַם נְבִיָּא הֵיךְ־מֹשֶׁה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:apin_beapin_mayer/20"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רֵ</tei:seg>ישׁ נְבִיאֵי הֲוָה מֹשֶׁה</tei:l>
          <tei:l>הַכְדֵין קַם נְבִיָּא הֵיךְ־מֹשֶׁה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:apin_beapin_mayer/21"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שַׁ</tei:seg>בָּחוּ תַּלְמִידוֹי לֵיהּ לְמֹשֶׁה</tei:l>
          <tei:l>הַכְדֵין קַם נְבִיָּא הֵיךְ־מֹשֶׁה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:apin_beapin_mayer/22"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">תַּ</tei:seg>מָּן בְּטוּר נְבוֹ מִית מֹשֶׁה</tei:l>
          <tei:l>לָא־קַם נְבִיָּא עוֹד הֵיךְ־מֹשֶׁה׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
