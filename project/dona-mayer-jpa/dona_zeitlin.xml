  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:dona_zeitlin">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:dona_zeitlin/1"/>
        <tei:lg>
          <tei:l>עַל עֲגַלְתָּא מִתְּנַח עִיגְלָא</tei:l>
          <tei:l>בְּחַבְלִין תְּלָתָא מְקַטַּר</tei:l>
          <tei:l>וּלְעֵלָא טָיֵיס שַׁפְנִינָא</tei:l>
          <tei:l>דְּעַל עֲגַלְתָּא מְנַטַּר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:dona_zeitlin/2"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">פזמנא׃</tei:note> חוּכָא בְּחַקְלַיָּא</tei:l>
          <tei:l>רוּחַיָּא מְחַיְכִין</tei:l>
          <tei:l>בְּכוּלֵּי יוֹמָא עַד־פַּלְגוּת</tei:l>
          <tei:l>לֵילְוָתָא חֲשׁוּכִין</tei:l>
          <tei:l>דּוֹנָא דּוֹנָא...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:dona_zeitlin/3"/>
        <tei:lg>
          <tei:l>שְׁתּוֹק, בַּר תּוֹר! – נָזִיף אִיכָּרָא –</tei:l>
          <tei:l>וְאַמַּאי אַתְּ וְלָד תּוֹרָן?</tei:l>
          <tei:l>וְאִי בַּעֵית אִתְיְּלִיד</tei:l>
          <tei:l>לְצִפַּרְתָּא עִילִּיתָא עַל־בְּעִירָן!</tei:l>
          <tei:l><tei:note type="instruction">פזמנא׃</tei:note> חוּכָא בְּחַקְלַיָּא...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:dona_zeitlin/4"/>
        <tei:lg>
          <tei:l>יוֹם יוֹם עִיגְלִין מִתְקַּטְרִין</tei:l>
          <tei:l>וּלְאִיתְכַּסָּאָה מִדַּבְּרִין</tei:l>
          <tei:l>אַדְּהָכִי עוֹפָן דִּשְׁמַיָּא</tei:l>
          <tei:l>טָיְסִין כִּבְנֵי חוֹרִין</tei:l>
          <tei:l><tei:note type="instruction">פזמנא׃</tei:note> חוּכָא בְּחַקְלַיָּא...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
