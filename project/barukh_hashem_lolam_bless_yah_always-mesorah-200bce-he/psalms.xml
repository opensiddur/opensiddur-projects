  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms">
        <tei:head>ברוך ה׳ לעולם</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/89/53"/>
        <tei:lg>
          <tei:l>בָּר֖וּךְ יְהוָ֥ה לְ֝עוֹלָ֗ם אָ֘מֵ֥ן ׀ וְאָמֵֽן׃ <tei:bibl>(תהלים פט:נג)</tei:bibl></tei:l>
          <tei:l>בָּ֘ר֤וּךְ יְהוָ֨ה ׀ מִצִּיּ֗וֹן</tei:l>
          <tei:l>שֹׁ֘כֵ֤ן</tei:l>
          <tei:l>יְֽרוּשָׁלִָ֗ם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>הַֽלְלוּ־יָֽהּ׃ <tei:bibl>(תהלים קלה:כא)</tei:bibl></tei:l>
          <tei:l>בָּר֤וּךְ ׀ יְהוָ֣ה אֱ֭לֹהִים</tei:l>
          <tei:l>אֱלֹהֵ֣י יִשְׂרָאֵ֑ל</tei:l>
          <tei:l>עֹשֵׂ֖ה נִפְלָא֣וֹת לְבַדּֽוֹ׃ <tei:bibl>(תהלים עב:יח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/72/19"/>
        <tei:lg>
          <tei:l>וּבָר֤וּךְ ׀ שֵׁ֥ם כְּבוֹד֗וֹ</tei:l>
          <tei:l>לְע֫וֹלָ֥ם וְיִמָּלֵ֣א כְ֭בוֹדוֹ</tei:l>
          <tei:l>אֶת־כֹּ֥ל הָאָ֗רֶץ</tei:l>
          <tei:l>אָ֘מֵ֥ן ׀ וְאָמֵֽן׃ <tei:bibl>(תהלים עב:יט)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
