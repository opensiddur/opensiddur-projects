      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/pesuqei_dezimrah/yehi_khevod">
        <tei:head xml:lang="en">Yehi Chevod</tei:head>
        <tei:note type="description" xml:lang="en"><tei:hi rend="italic">This prayer, mentioned in </tei:hi>Maseches Sof’rim<tei:hi rend="italic"> 17:11 is a collection of 18 verses from<tei:hi rend="italic"> Psalms, Chronicles,</tei:hi> and </tei:hi>Proverbs,<tei:hi rend="italic"> in which the Divine Name (הויה) is mentioned 18 times. Great care should be taken to pronounce the “Name” with the utmost concentration, keeping in mind that He is the Supreme Master of all that exists.</tei:hi></tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:yehi_khevod"/>
      </tei:div>
