  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" target="#note_1" xml:lang="en">
      <tei:p>As an outgrowth of our penitence and our forgiveness we pray that we may be deemed worthy of Divine redemption.—<tei:hi rend="italic">Kuzari</tei:hi></tei:p>
    </tei:note>
  </tei:standOff>
