  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/geullah">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/geullah/9"/>Look upon our affliction, and defend our cause: and redeem us speedily<tei:anchor xml:id="note_1"/> for the sake of Your Name; because You are a Mighty Redeemer. Blessed are You, Adonoy, Redeemer of Israel.
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/geullah/chol_arvit_shemoneh_esreh_geullah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/geullah/10"/><tei:hi rend="italic">(On Fast Days, the Chazzan says “Answer us” and concludes, “Blessed are ... Who responds at times of trouble.”)</tei:hi>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/></tei:p>
