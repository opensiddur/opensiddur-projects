    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:avinu_malkenu/hachazirenu">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:avinu_malkenu/hachazirenu/1"/>Our Father, Our King! bring us back in wholehearted<tei:anchor xml:id="note_1"/> repentance before You.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" target="#note_1" xml:lang="en">
      <tei:p>Many repent out of their fear of God. Others repent out of their love for Him. We beseech God to bring us back in “wholehearted” repentance motivated by love, the most perfect form of penitence.—<tei:hi rend="italic">Etz Yosef</tei:hi></tei:p>
    </tei:note>
  </tei:standOff>
