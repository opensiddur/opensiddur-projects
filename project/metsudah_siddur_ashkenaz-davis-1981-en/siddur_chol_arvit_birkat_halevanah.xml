        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:sefirat_haomer/psalm_67"/>
        <tei:note type="instruction" xml:lang="en">
          <tei:hi rend="italic">עלינו is said, see p. 000.</tei:hi>
        </tei:note>
