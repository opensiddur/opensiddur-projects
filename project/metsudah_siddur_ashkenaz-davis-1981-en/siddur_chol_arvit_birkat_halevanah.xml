      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/arvit/birkat_halevanah">
        <tei:head xml:lang="en">Birkat HaLevana</tei:head>
        <tei:note type="instruction" xml:lang="en">
          <tei:hi rend="italic">This prayer is customarily recited in the open air, in clear sight of the moon, seven days after the birth of the new moon.</tei:hi>
        </tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/148/1-6"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:hinni_mukhan_umezuman"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:asher_bemaamaro_bara"/>
        <tei:note type="instruction" xml:lang="en">
          <tei:hi rend="italic">Recite three times:</tei:hi>
        </tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:barukh_yotzerekh_barukh"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:song_of_songs/2/8-9"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/121"/>
