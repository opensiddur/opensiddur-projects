  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/ledor_vador">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/ledor_vador/10"/>From generation to generation we will declare Your greatness, and to all eternity, we will sanctify Your holiness, and Your praise, our God, will not depart from our mouth forever and ever; because You are the Almighty Who is King; Great, and Holy. Blessed are You, Adonoy,
<tei:milestone unit="phrase"/>
<j:conditional xml:id="when_1"><j:none><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="aseret-ymei-tshuva"><tei:binary value="true"/></tei:f></tei:fs></j:none></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/ledor_vador/11"/>the Almighty, the Holy One.<tei:anchor xml:id="note_1"/>
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_1"/>
<j:conditional xml:id="when_2"><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="aseret-ymei-tshuva"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/ledor_vador/12"/>
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_2"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" target="#note_1" xml:lang="en">
      <tei:p>This blessing completes the section of <tei:hi rend="italic">Shemoneh Esrei</tei:hi> called <tei:hi rend="italic">Kedushah</tei:hi> (Holiness) which emphasizes that God is indeed awesome.</tei:p>
    </tei:note>
