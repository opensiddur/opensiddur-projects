  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:shabbat/arvit/veshameru">
        <tei:head xml:lang="en">Veshamru</tei:head>
        <j:conditional xml:id="when_1">
          <tei:note type="instruction" xml:lang="en">On Shabbos say:</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:exodus/31/16-17"/>
        <j:endConditional target="#when_1"/>
        <j:conditional xml:id="when_2">
          <tei:note type="instruction" xml:lang="en">On Pesach, Shavuos and Sukkos, say:</tei:note>
          <j:any>
            <tei:fs type="opensiddur:holiday">
              <tei:f name="pesah">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
            <tei:fs type="opensiddur:holiday">
              <tei:f name="shavuot">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
            <tei:fs type="opensiddur:holiday">
              <tei:f name="sukkot">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:any>
        </j:conditional>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:leviticus/23/44"/>
        <j:endConditional target="#when_2"/>
      </tei:div>
    </tei:body>
  </tei:text>
