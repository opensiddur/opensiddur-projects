  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/preparatory/tefillin">
        <tei:head xml:lang="en">Tefillin</tei:head>
        <j:declare xml:id="variants_1">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:leshem_yichud_qudsha/chol_arvit_sefirat_haomer">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:leshem_yichud_qudsha"/>
        <j:endDeclare target="#variants_1"/>
        <tei:note type="instruction" xml:lang="en">
          <tei:hi rend="italic">Place the “tefillin of the arm” on the muscle of your left arm, and before tightening it, say:</tei:hi>
        </tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:tefillin/lehanniach"/>
        <tei:note type="instruction" xml:lang="en">
          <tei:hi rend="italic">Wrap the strap around your arm 7 times and then place the “tefillin of the head” on your head above the region between your eyes, and say:</tei:hi>
        </tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:tefillin/al_mitzvat"/>
        <tei:note type="instruction" xml:lang="en">
          <tei:hi rend="italic">With the “tefillin of the head” in place, say:</tei:hi>
        </tei:note>
        <j:declare xml:id="variants_2">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:barukh_shem_kevod/chol_shacharit_preparatory_leolam_yehe_adam">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:barukh_shem_kevod/chol_shacharit_birkhot_keriat_shema_keriat_shema">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:barukh_shem_kevod/chol_arvit_birkhot_keriat_shema_keriat_shema">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:barukh_shem_kevod/chol_arvit_keriat_shema_al_hamittah">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:barukh_shem_kevod/shabbat_arvit_birkhot_keriat_shema_keriat_shema">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:barukh_shem_kevod"/>
        <j:endDeclare target="#variants_2"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:tefillin/umechokhmatekha"/>
        <tei:note type="instruction" xml:lang="en">
          <tei:hi rend="italic">When wrapping the strap around the middle finger of your left hand, say:</tei:hi>
        </tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:tefillin/verastikh"/>
        <tei:note type="instruction" xml:lang="en">
          <tei:hi rend="italic">The following chapters, found in Exodus 13:1-16, are recited while wearing the tefillin, since they make direct reference to the mitzvah of tefillin.</tei:hi>
        </tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:tefillin/parashiyot"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:exodus/13/11-16"/>
      </tei:div>
    </tei:body>
  </tei:text>
