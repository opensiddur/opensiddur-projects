      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/51/17">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/51/17/1"/>My Master,<tei:anchor xml:id="note_1"/> open my lips, and my mouth will declare Your praise.<tei:anchor xml:id="note_2"/></tei:p>
      </tei:div>
    </tei:body>
