  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/amirah_leshatz_lifnay_birkat_kohanim/before_call">
        <tei:p><j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/amirah_leshatz_lifnay_birkat_kohanim/before_call/chol_minchah_shemoneh_esreh_birkat_kohanim"><tei:binary value="true"/></tei:f></tei:fs></j:conditional><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/amirah_leshatz_lifnay_birkat_kohanim/before_call/2"/><tei:hi rend="small">Our God, and God of our fathers, bless us with the threefold blessing of the Torah, written by the hand of Moses, Your servant, pronounced from the mouth of Aaron and his sons, the <tei:hi rend="italic">kohanim,</tei:hi> Your holy people; as it is said: Adonoy bless you and guard you. Adonoy shine His countenance upon you and be gracious unto you. Adonoy turn His countenance toward you and grant you peace.</tei:hi><tei:anchor xml:id="note_1"/><tei:milestone unit="phrase"/><j:endConditional target="#variant_1"/><j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/amirah_leshatz_lifnay_birkat_kohanim/before_call/chol_minchah_shemoneh_esreh_birkat_kohanim"><tei:binary value="false"/></tei:f></tei:fs></j:conditional><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/amirah_leshatz_lifnay_birkat_kohanim/before_call/1"/>Our God, and God of our fathers, bless us with the threefold blessing of the Torah, written by the hand of Moses, Your servant, pronounced from the mouth of Aaron and his sons, the <tei:hi rend="italic">kohanim,</tei:hi> Your holy people; as it is said:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/></tei:p>
