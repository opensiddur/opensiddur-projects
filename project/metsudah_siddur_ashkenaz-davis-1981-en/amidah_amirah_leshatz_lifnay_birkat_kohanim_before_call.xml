  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" target="#note_1" xml:lang="en">
      <tei:p><tei:hi rend="italic">Rashi</tei:hi> paraphrases this blessing with the words יכבש כעסו, “May He withhold His anger.”</tei:p>
    </tei:note>
