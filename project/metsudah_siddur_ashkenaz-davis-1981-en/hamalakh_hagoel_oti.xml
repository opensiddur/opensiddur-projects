  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hamalakh_hagoel_oti">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:genesis/48/16"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamalakh_hagoel_oti/1"/>The angel who redeemed me from all evil<tei:anchor xml:id="note_1"/> May he bless the lads; and may they be called by my name and the names of my fathers, Abraham and Isaac; and may they multiply like fish within the land.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" target="#note_1" xml:lang="en">
      <tei:p>These are the words used by Jacob when he blessed Joseph, and his sons Ephraim and Menashe.—Genesis 48:16</tei:p>
    </tei:note>
