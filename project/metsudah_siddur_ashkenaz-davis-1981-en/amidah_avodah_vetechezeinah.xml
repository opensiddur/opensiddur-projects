  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/avodah/vetechezeinah">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/avodah/vetechezeinah/5"/>And may our eyes behold<tei:anchor xml:id="note_1"/> Your merciful return to Zion. Blessed are You, Adonoy, Who returns His Divine Presence to Zion.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" target="#note_1" xml:lang="en">
      <tei:p>We pray for the privilege of witnessing the visible revelation of the Divine Presence as it appeared to the prophets, to the pious, and to all who were delivered from Egypt.—<tei:hi rend="italic">Kuzari</tei:hi></tei:p>
    </tei:note>
