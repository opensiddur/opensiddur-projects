      <tei:div corresp="urn:x-opensiddur:text:prayer:asher_natan_yamim">
        <tei:p><j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:asher_natan_yamim/berakhot_birkat_hamazon"><tei:binary value="true"/></tei:f></tei:fs></j:conditional><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_natan_yamim/10"/>Blessed are You, Adonoy our God, King of the Universe, Who gave Festivals to His people Israel for remembrance.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:asher_natan_yamim/berakhot_birkat_hamazon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_natan_yamim/9"/>Blessed are You, Adonoy our God, King of the Universe, Who gave Yomim Tovim to His people Israel for happiness and joy, this day of (name the Yom Tov). Blessed are You, Adonoy, Sanctifier of Israel and the seasons.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/></tei:p>
