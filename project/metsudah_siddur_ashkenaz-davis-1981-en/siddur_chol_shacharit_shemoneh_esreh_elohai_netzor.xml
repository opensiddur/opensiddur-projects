      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/shemoneh_esreh/elohai_netzor">
        <tei:head xml:lang="en">Concluding Passage</tei:head>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/19/15"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/elohai_netzor/text"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/yatom/oseh_shalom"/>
        <j:declare xml:id="variants_1">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/yehi_ratzon/chol_shacharit_shemoneh_esreh_elohai_netzor">
              <tei:binary value="true"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/yehi_ratzon/chol_minchah_shemoneh_esreh_elohai_netzor">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/yehi_ratzon/chol_arvit_shemoneh_esreh_elohai_netzor">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/yehi_ratzon/shabbat_arvit_shemoneh_esreh_elohai_netzor">
