      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/minchah/shemoneh_esreh/binyan_yerushalayim">
        <tei:head xml:lang="en">Rebuilding Jerusalem</tei:head>
        <j:declare xml:id="variants_1">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/yerushalayim/chol_minchah_shemoneh_esreh_binyan_yerushalayim">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/yerushalayim"/>
        <j:endDeclare target="#variants_1"/>
        <j:conditional xml:id="when_1">
          <tei:note type="instruction" xml:lang="en">
            <tei:hi rend="italic">During Mincha services on the Ninth of Av, the following petition is added here:</tei:hi>
          </tei:note>
          <j:all>
            <tei:fs type="opensiddur:holiday">
              <tei:f name="tisha-bav">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
            <tei:fs type="opensiddur:service-time">
              <tei:f name="minha">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:all>
        </j:conditional>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/nachem_hashem_eloheinu"/>
        <j:endConditional target="#when_1"/>
        <j:conditional xml:id="when_2">
          <j:none>
            <tei:fs type="opensiddur:holiday">
              <tei:f name="tisha-bav">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:none>
        </j:conditional>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/yerushalayim/seal"/>
        <j:endConditional target="#when_2"/>
      </tei:div>
