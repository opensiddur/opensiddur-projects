      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/keriat_hatorah/removing/berikh_shemeh">
        <tei:head xml:lang="en">Berich Shmei</tei:head>
        <tei:note type="description" xml:lang="en"><tei:hi rend="italic">The following prayer is taken from the </tei:hi>Zohar<tei:hi rend="italic"> (</tei:hi>Parshas Vayakhail<tei:hi rend="italic">), the basic text of Kabbalah which was written by the Mishnaic sage Rabbi Shimon bar Yochai. The </tei:hi>Zohar<tei:hi rend="italic"> states, “When the Torah is taken out to be read before the congregation, the heavenly gates of mercy are opened, and the Divine love is aroused; therefore one should say the following prayer.</tei:hi></tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:berikh_shemeh/berikh"/>
      </tei:div>
    </tei:body>
