  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:exodus/31/16-17">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/31/16"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:exodus/31/16_17/12"/>And the Children of Israel shall preserve the Sabbath, to maintain the Sabbath for their generations as an everlasting covenant. Between Me and between the Children of Israel it is a sign for eternity, that [in] six days, Adonoy made the heavens and the earth, and on the seventh [day] He abstained from work and rested.<tei:anchor xml:id="note_1"/>
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<j:conditional xml:id="when_1"><tei:note type="instruction" xml:lang="en">On Pesach, Shavuos and Sukkos, say:</tei:note><j:any><tei:fs type="opensiddur:holiday"><tei:f name="pesah"><tei:binary value="true"/></tei:f></tei:fs><tei:fs type="opensiddur:holiday"><tei:f name="shavuot"><tei:binary value="true"/></tei:f></tei:fs><tei:fs type="opensiddur:holiday"><tei:f name="sukkot"><tei:binary value="true"/></tei:f></tei:fs></j:any></j:conditional>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:leviticus/23/44"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:exodus/31/16_17/13"/>And Moses recounted the appointed seasons of Adonoy to the Children of Israel.<tei:anchor xml:id="note_2"/>
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<j:endConditional target="#when_1"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" target="#note_1" xml:lang="en">
      <tei:p>Exodus 31:16-17. This is merely metaphorical, since God of course does not become tired, nor does He require rest.</tei:p>
    </tei:note>
    <tei:note type="commentary" target="#note_2" xml:lang="en">
      <tei:p>Leviticus 23:44.</tei:p>
