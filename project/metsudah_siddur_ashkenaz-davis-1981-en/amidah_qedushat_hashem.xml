  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/qedushat_hashem">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushat_hashem/16"/>You are holy and Your Name is holy and holy beings praise You every day, forever.
<tei:milestone unit="phrase"/>
<j:conditional xml:id="when_1"><j:none><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="aseret-ymei-tshuva"><tei:binary value="true"/></tei:f></tei:fs></j:none></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushat_hashem/17"/>Blessed are You, Adonoy, the Almighty, the Holy One.<tei:anchor xml:id="note_1"/>
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_1"/>
<j:conditional xml:id="when_2"><tei:note type="instruction" xml:lang="en"><tei:hi rend="italic">During the Ten Days of Penitence:</tei:hi></tei:note><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="aseret-ymei-tshuva"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushat_hashem/18"/>Blessed are You, Adonoy, the King, the Holy One.
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_2"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" target="#note_1" xml:lang="en">
      <tei:p>This blessing completes the section of <tei:hi rend="italic">Shemoneh Esrei</tei:hi> called <tei:hi rend="italic">Kedushah</tei:hi> (Holiness) which emphasizes that God is indeed awesome.</tei:p>
    </tei:note>
  </tei:standOff>
