      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/shalom/besefer_chayyim_hamevarekh">
        <tei:p><j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/shalom/besefer_chayyim_hamevarekh/chol_arvit_shemoneh_esreh_shalom"><tei:binary value="true"/></tei:f></tei:fs></j:conditional><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shalom/besefer_chayyim_hamevarekh/2"/>May we be remembered and inscribed before You in the book of life, blessing, peace and abundant maintenance; we and all Your people, the House of Israel, for a good life and peace. <j:conditional xml:id="inline_1" type="marked"><j:all><tei:fs type="opensiddur:practice"><tei:f name="oseh-hashalom-aseret-ymei-tshuva"><tei:binary value="true"/></tei:f></tei:fs><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="aseret-ymei-tshuva"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional><tei:note type="editorial" xml:lang="en">Translated by the editors; the Metsudah English does not translate this closing.</tei:note>Blessed are You, Adonoy, Who makes peace.<j:endConditional target="#inline_1"/>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/shalom/besefer_chayyim_hamevarekh/shabbat_arvit_shemoneh_esreh_shalom"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shalom/besefer_chayyim_hamevarekh/3"/>May we be remembered and inscribed before You in the book of life, blessing, peace and abundant maintenance; we and all Your people, the House of Israel, for a good life and peace. <j:conditional xml:id="inline_2" type="marked"><j:all><tei:fs type="opensiddur:practice"><tei:f name="oseh-hashalom-aseret-ymei-tshuva"><tei:binary value="true"/></tei:f></tei:fs><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="aseret-ymei-tshuva"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional><tei:note type="editorial" xml:lang="en">Translated by the editors; the Metsudah English does not translate this closing.</tei:note>Blessed are You, Adonoy, Who makes peace.<j:endConditional target="#inline_2"/>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/shalom/besefer_chayyim_hamevarekh/chol_arvit_shemoneh_esreh_shalom"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/shalom/besefer_chayyim_hamevarekh/shabbat_arvit_shemoneh_esreh_shalom"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/shalom/besefer_chayyim_hamevarekh/1"/>May we be remembered and inscribed before You in the book of life, blessing, peace and abundant maintenance; we and all Your people, the House of Israel, for a good life and peace.
