    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:rachamana_di_neshaya_mayer">
        <tei:head>רַחֲמָנָא</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:rachamana_di_neshaya_mayer/1"/>
        <tei:lg>
          <tei:l>רַֽחֲמָנָא</tei:l>
          <tei:l>אִדְכַּר לָן קְיָמַהּ דְּשָׂרָה דְּכִירָא.</tei:l>
          <tei:l>בְּדִיל וַיַּעֲבֹר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:rachamana_di_neshaya_mayer/2"/>
        <tei:lg>
          <tei:l>רַֽחֲמָנָא</tei:l>
          <tei:l>אִדְכַּר לָן קְיָמַהּ דְּרִבְקָה מְהַגְּנָא.</tei:l>
          <tei:l>בְּדִיל וַיַּעֲבֹר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:rachamana_di_neshaya_mayer/3"/>
        <tei:lg>
          <tei:l>רַֽחֲמָנָא</tei:l>
          <tei:l>אִדְכַּר לָן קְיָמוֹהוּן דְּלֵאָה רַבְּתָא וּדְרָחֵל זְעֶרְתָּא.</tei:l>
          <tei:l>בְּדִיל וַיַּעֲבֹר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:rachamana_di_neshaya_mayer/4"/>
        <tei:lg>
          <tei:l>רַֽחֲמָנָא</tei:l>
          <tei:l>אִדְכַּר לָן זְכוּתַהּ דְּסֶרַח חַכִּימָתָא.</tei:l>
          <tei:l>בְּדִיל וַיַּעֲבֹר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:rachamana_di_neshaya_mayer/5"/>
        <tei:lg>
          <tei:l>רַֽחֲמָנָא</tei:l>
          <tei:l>אִדְכַּר לָן זְכוּתַהּ דְּמִרְיָם נְבִיאֲתָא.</tei:l>
          <tei:l>בְּדִיל וַיַּעֲבֹר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:rachamana_di_neshaya_mayer/6"/>
        <tei:lg>
          <tei:l>רַֽחֲמָנָא</tei:l>
          <tei:l>אִדְכַּר לָן זְכוּתַהּ דִּדְבוֹרָה דַיְנָא.</tei:l>
          <tei:l>בְּדִיל וַיַּעֲבֹר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:rachamana_di_neshaya_mayer/7"/>
        <tei:lg>
          <tei:l>רַֽחֲמָנָא</tei:l>
          <tei:l>אִדְכַּר לָן זְכוּתַהּ דְּרוּת מְהֵימַנְתָּא.</tei:l>
          <tei:l>בְּדִיל וַיַּעֲבֹר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:rachamana_di_neshaya_mayer/8"/>
        <tei:lg>
          <tei:l>רַֽחֲמָנָא</tei:l>
          <tei:l>אִדְכַּר לָן זְכוּתַהּ דְּחַנָּה מְצַלְיָא.</tei:l>
          <tei:l>בְּדִיל וַיַּעֲבֹר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:rachamana_di_neshaya_mayer/9"/>
        <tei:lg>
          <tei:l>רַֽחֲמָנָא</tei:l>
          <tei:l>אִדְכַּר לָן זְכוּתַהּ דְאֶסְתֵּר מַלְכְּתָא.</tei:l>
          <tei:l>בְּדִיל וַיַּעֲבֹר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:rachamana_di_neshaya_mayer/10"/>
        <tei:lg>
          <tei:l>רַֽחֲמָנָא</tei:l>
          <tei:l>פְּתַח שְׁמַיָּא לִצְלוֹתִין,</tei:l>
          <tei:l>בְּדִיל וַיַּעֲבֹר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:rachamana_di_neshaya_mayer/11"/>
        <tei:lg>
          <tei:l>רַֽחֲמָנָא</tei:l>
          <tei:l>צְלוֹתַנָֽא קַבֵּל בְּרַֽעֲוָא,</tei:l>
          <tei:l>בְּדִיל וַיַּעֲבֹר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:rachamana_di_neshaya_mayer/12"/>
        <tei:lg>
          <tei:l>רַֽחֲמָנָא</tei:l>
          <tei:l>שַׁתָּא טַֽבְתָּא אַיְתִי עֲלַן,</tei:l>
          <tei:l>בְּדִיל וַיַּעֲבֹר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:rachamana_di_neshaya_mayer/13"/>
        <tei:lg>
          <tei:l>רַֽחֲמָנָא</tei:l>
          <tei:l>תּוּב מֵרֻגְזָךְ,</tei:l>
          <tei:l>בְּדִיל וַיַּעֲבֹר</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:rachamana_di_neshaya_mayer/14"/>
        <tei:lg>
          <tei:l>רַֽחֲמָנָא</tei:l>
          <tei:l>וְלָא נֶהְדָּר רֵיקָם מִן־קַמָּךְ,</tei:l>
          <tei:l>בְּדִיל וַיַּעֲבֹר</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
