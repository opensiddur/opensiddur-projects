              </tei:f>
            </tei:fs>
          </j:conditional>
          <j:transclude target="urn:x-opensiddur:text:prayer:el_melekh_yoshev"/>
          <j:transclude target="urn:x-opensiddur:text:prayer:vayaavor"/>
          <j:endConditional target="#penitential_tenth-tevet_day_pair_after_even_expanded"/>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tenth_tevet/refrain_instruction">
          <j:conditional xml:id="penitential_tenth-tevet_day_refrain_instruction_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="refrains_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tenth_tevet/refrain_instruction/printed">
            <tei:pb n="176" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n354_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Wherever the words (When, &amp;c.) occur at the end of the verses, repeat from “When our forefathers,” till “tenth month.” </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_tenth-tevet_day_refrain_instruction_printed"/>
        </tei:div>
        <j:transclude target="urn:x-opensiddur:text:poem:avotai_ki_vatehu_beshem_elohei_tsuri"/>
