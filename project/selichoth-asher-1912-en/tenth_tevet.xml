            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tenth_tevet/pair_after_avotai/printed">
            <tei:pb n="178" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n358_medium.jpg"/>
