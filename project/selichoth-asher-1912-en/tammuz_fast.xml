          <j:transclude target="urn:x-opensiddur:text:prayer:vayaavor"/>
          <j:endConditional target="#penitential_tammuz-fast_day_pair_after_sheeh_expanded"/>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tammuz_fast/conclusion_repeat">
          <j:conditional xml:id="penitential_tammuz-fast_day_conclusion_repeat_printed">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
                <tei:binary value="false"/>
              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tammuz_fast/conclusion_repeat/printed">
            <tei:pb n="187" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n376_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say from “O Lord, remember thy mercy,” page 164, till “mercy and pardon,” page 167. The Reader says “Let not sin,” &amp;c., and the Service is concluded as directed in page 167. </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_tammuz-fast_day_conclusion_repeat_printed"/>
