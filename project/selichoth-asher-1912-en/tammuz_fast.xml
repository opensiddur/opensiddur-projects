              </tei:f>
            </tei:fs>
          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tammuz_fast/pair_after_sheeh/printed">
            <tei:pb n="187" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n376_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say “Omnipotent King,” “And the Eternal passed,” &amp;c., pp. 11, 12. </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_tammuz-fast_day_pair_after_sheeh_printed"/>
          <j:conditional xml:id="penitential_tammuz-fast_day_pair_after_sheeh_expanded">
            <tei:fs type="asher:expansions">
              <tei:f name="prayers_present">
