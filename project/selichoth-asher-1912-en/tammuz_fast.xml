          </j:conditional>
          <j:transclude target="urn:x-opensiddur:text:prayer:el_melekh_yoshev"/>
          <j:transclude target="urn:x-opensiddur:text:prayer:vayaavor"/>
          <j:endConditional target="#penitential_tammuz-fast_day_pair_after_amar_expanded"/>
        </tei:div>
        <j:transclude target="urn:x-opensiddur:text:poem:sheeh_neessar"/>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/tammuz_fast/pair_after_sheeh">
          <j:conditional xml:id="penitential_tammuz-fast_day_pair_after_sheeh_printed">
