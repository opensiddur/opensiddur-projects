              </tei:f>
            </tei:fs>
          </j:conditional>
          <j:transclude target="urn:x-opensiddur:text:prayer:el_melekh_yoshev"/>
          <j:transclude target="urn:x-opensiddur:text:prayer:vayaavor"/>
          <j:endConditional target="#penitential_last-monday-fast_day_pair_after_afafunu_expanded"/>
        </tei:div>
        <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/last_monday_fast/haazinah_adonai_tefillatenu">
          <tei:pb n="172" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n346_medium.jpg"/>
          <tei:p>Give ear, O Lord, unto our prayer, attend to the voice of our supplication. Hear, O Lord, our voice, when we call; have also mercy upon us and answer us. Hear the right, O Lord, attend unto our cry. </tei:p>
        </tei:div>
