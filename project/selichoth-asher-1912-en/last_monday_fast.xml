          </j:conditional>
          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/last_monday_fast/pair_after_ozon/printed">
            <tei:pb n="173" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n348_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say “Omnipotent King,” “And the Eternal passed,” &amp;c., pp. 11, 12. </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_last-monday-fast_day_pair_after_ozon_printed"/>
