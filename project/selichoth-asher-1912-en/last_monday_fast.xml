          <tei:div corresp="urn:x-opensiddur:text:siddur:selichot/last_monday_fast/conclusion_repeat/printed">
            <tei:pb n="174" ed="1912" facs="https://archive.org/download/selichothdavidasher1912/page/n350_medium.jpg"/>
            <tei:note type="instruction" xml:lang="en">Say from “O Lord. remember thy mercy,” page 164, till “mercy and pardon,” page 167. The Reader says “Let not sin,” &amp;c., and the Service is concluded as directed in page 167. </tei:note>
          </tei:div>
          <j:endConditional target="#penitential_last-monday-fast_day_conclusion_repeat_printed"/>
