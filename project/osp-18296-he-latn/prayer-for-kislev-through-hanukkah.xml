  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_kislev_through_hanukkah">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_kislev_through_hanukkah/1"/>
        <tei:lg>
          <tei:l>Kumi ori ki va orekh</tei:l>
          <tei:l>ukhevod Adonai alayikh zaraḥ!</tei:l>
          <tei:l>Kihinneh haḥoshekh yekhasseh erets</tei:l>
          <tei:l>vaˈarafel leˈummim</tei:l>
          <tei:l>veˈalayikh yizraḥ Adonai</tei:l>
          <tei:l>ukhevodo alayikh yeraˈeh.</tei:l>
          <tei:l>Vehalekhu goyim leˈorekh</tei:l>
          <tei:l>umelakhim lenogahh zarḥekh.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_kislev_through_hanukkah/2"/>
        <tei:lg>
          <tei:l>Loˈyihyeh lakh od</tei:l>
          <tei:l>hashemesh leˈor yomam</tei:l>
          <tei:l>ulenogahh hayyareaḥ lo yaˈir lakh.</tei:l>
          <tei:l>Vehayalakh Adonai leˈor olam</tei:l>
          <tei:l>veˈlohayikh letifˈartekh.</tei:l>
          <tei:l>Lo yavo od shimshekh</tei:l>
          <tei:l>vireḥekh lo yeˈasef.</tei:l>
          <tei:l>Ki Adonai yihyeh lakh leˈor olam</tei:l>
          <tei:l>veshalemu yeme evlekh.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
