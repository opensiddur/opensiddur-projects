      <tei:div corresp="urn:x-opensiddur:text:poem:biti_arvot_project">
        <tei:head>בִּתִּי עַרְבוֹת – פיוט על תפילת רות ונעמי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:biti_arvot_project/1"/>
        <tei:lg>
          <tei:l>ותאמר נעמי</tei:l>
          <tei:l>בִּתִּי עַרְבוֹת שָׂדֵךְ שְׁבִי</tei:l>
          <tei:l>פֶּרַח וּפְרִי גַּנֵּךְ לָבִיא</tei:l>
          <tei:l>מָה לָךְ רְעוֹת מֵיצָר צְבִי</tei:l>
          <tei:l>מִצְאִי לָךְ מְנוּחָה בְּרֵעוּת וְשָׁלוֹם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:biti_arvot_project/2"/>
        <tei:lg>
          <tei:l>ותען רות</tei:l>
          <tei:l>לִבִּי אַחַר פְּעָמַיִךְ</tei:l>
          <tei:l>שָׂם פְּעָמָיו בִּנְדוֹדַיִךְ</tei:l>
          <tei:l>אֵין בַּיִת לִי כֶּאלֹהַיִךְ</tei:l>
          <tei:l>שֹׁכַנְתְּ בַּשָּׂדֶה אֹהָלַיִךְ שָׁלוֹם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:biti_arvot_project/3"/>
        <tei:lg>
          <tei:l>ותאמר נעמי</tei:l>
          <tei:l>בִּתִּי נִרְדִּי רֵיחוֹ אָבַד</tei:l>
          <tei:l>שִׂמְלַת יָגוֹן לְגֵוִי בַד</tei:l>
          <tei:l>לִבְשִׁי עֵלוֹם אֵל לָךְ זָבָד</tei:l>
          <tei:l>אֲנִי אֵלֵךְ לִמְקוֹם אִמּוֹתַי בְשָׁלוֹם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:biti_arvot_project/4"/>
        <tei:lg>
          <tei:l>ותען רות</tei:l>
          <tei:l>אַף אִם לִבֵּךְ עָטָה אֵבֶל</tei:l>
          <tei:l>שִׁירוֹ יֶעֱרַב מִשִּׁיר נֵבֶל</tei:l>
          <tei:l>חֵיקֵךְ חֶלְקִי מִכָּל חֵבֶל</tei:l>
          <tei:l>כִּי בוֹ תוֹרַת חַיִּים וְאַהֲבַת שָׁלוֹם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:biti_arvot_project/5"/>
        <tei:lg>
          <tei:l>ותאמר נעמי</tei:l>
          <tei:l>בִּתִּי יָדַעְתְּ כִּי לְפוּקָה</tei:l>
          <tei:l>הִיא לִי כוֹסִי כּוֹס מְצוּקָה</tei:l>
          <tei:l>וְעוֹד נַפְשֵׁךְ בִּי חֲבוּקָה</tei:l>
          <tei:l>אֲבַקְשָׁה נָּא טוֹב לָךְ אֲדַבְּרָה שָׁלוֹם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:biti_arvot_project/6"/>
        <tei:lg>
          <tei:l>ותען רות</tei:l>
          <tei:l>טוּב תּוֹרַת פִּיךְ לֹא אֶטּוֹשָׁה</tei:l>
          <tei:l>בּוֹ אַחֲזִיק לֹא אֵבוֹשָׁה</tei:l>
          <tei:l>גַּם כִּי אַזְקִין בָּךְ אֶדְרוֹשָׁה</tei:l>
          <tei:l>מָצָאתִי בְחֵילֵךְ שַׁלְוָה וְגַם שָׁלוֹם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:biti_arvot_project/7"/>
        <tei:lg>
          <tei:l>שִׂישִׂי שִׂמְחִי פִּרְצִי פֶרֶץ</tei:l>
          <tei:l>תּוֹרָה אֲשֶׁר בִּשְׁמֵי עֶרֶץ</tei:l>
          <tei:l>בָּךְ נָֽשְׁקָה אֱמֶת אֶרֶץ</tei:l>
          <tei:l>כִּי נָֽעֲמָה דַּרְכֵּךְ נְתִיבָתֵךְ שָׁלוֹם</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
