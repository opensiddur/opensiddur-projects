    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:ieste_el_pan_de_la_afrisiyon_kapor_mater">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:ieste_el_pan_de_la_afrisiyon_kapor_mater/1"/>
        <tei:lg>
          <tei:l>הָא לַחְמָא עַנְיָא דַּאֲכָֽלוּ אַבְהָתָנָֽא בְּאְַרעָא דְמִצְרָֽיִם. כָּל־דִּכְפִין יֵיתֵי וְיֵכֻל, כָּל־דִּצְרִיךְ יֵיתֵי וִיפְסַח. הָשַּׁתָּא הָכָא, לְשָׁנָה הַבָּאָה בְּאַרְעָא דְיִשְׂרָאֵל. הָשַּׁתָּא עַבְדֵי, לְשָׁנָה הַבָּאָה בְּנֵי וּבְנוֹת חוֹרִין׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
