  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:morning_prayer_levy_50236">
        <tei:head>Morning Prayer (for Very Young Children) by Rabbi Clifton Harby Levy (1927)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:morning_prayer_levy_50236/1"/>
        <tei:lg>
          <tei:l>Thank You, God,</tei:l>
          <tei:l>for the good night’s rest,</tei:l>
          <tei:l>and for the bright sunshine of today.</tei:l>
          <tei:l>May I be as good all day as I want to be,</tei:l>
          <tei:l>and will You help me to mind what I am told,</tei:l>
          <tei:l>and make every one love me</tei:l>
          <tei:l>more and more.</tei:l>
          <tei:l><tei:hi rend="italic">Amen</tei:hi>.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
