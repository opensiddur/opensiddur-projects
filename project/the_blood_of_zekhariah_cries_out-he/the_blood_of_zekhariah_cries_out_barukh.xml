    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:the_blood_of_zekhariah_cries_out_barukh">
        <tei:head>דָּם זְכַרְיָה מְבַכֶּה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_blood_of_zekhariah_cries_out_barukh/1"/>
        <tei:lg>
          <tei:l>דָּם זְכַרְיָה מְבַכֶּה דַי</tei:l>
          <tei:l>עַד מָתַי יְנַפְּצוּ טַפַּי</tei:l>
          <tei:l>וְהָאָרֶץ מֻשְׁקֵית מִדָּמַי</tei:l>
          <tei:l>רוֹתֵחַ דָּמִי עַל קְדוֹשַׁי</tei:l>
          <tei:l>אֵל נְקָמוֹת הוֹפִיעַ, זָכוֹר לֹא תִּשְׁכָּח</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_blood_of_zekhariah_cries_out_barukh/2"/>
        <tei:lg>
          <tei:l>כִּי אָֽנוּ עַמֶךָ וְאַתָּה אָבִינוּ</tei:l>
          <tei:l>אַיֶּכָּה, אֵיפֹה אֲמִתְּךָ, אֵיפֹה צִדְקֵנוּ</tei:l>
          <tei:l>פָּרְצוּ גְּבוּלוֹתֵינוּ שָׂרְפוּ שָׁמֵינוּ</tei:l>
          <tei:l>כְּיְאוֹר אָרוּ, וְכָּךְ זָרְמוּ דָּמֵינוּ</tei:l>
          <tei:l>הַמֶּלֶךְ הַמִּשְׁפָּט הוֹפִיעַ, חַדֵּשׁ יָמֵינוּ כְּקֶדֶם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_blood_of_zekhariah_cries_out_barukh/3"/>
        <tei:lg>
          <tei:l>עֲמוֹד, עֲמוֹד, עֲמוֹד, יַעֲמוֹד כָּל יִשְׂרָאֵל</tei:l>
          <tei:l>כִּי נִהְיְתָה וְנִראֲתָה עוֹד פַּעַם בְּיִשְׂרָאֵל</tei:l>
          <tei:l>אֵיכָה נִהְיְתָה הָרָעָה הַזֹּאת לְעַם בֵּרַךְ אֵל</tei:l>
          <tei:l>נַעֲמֹדָה וְיִמָּח חָמָס מִתַּחַת שְׁמֵי אֵל</tei:l>
          <tei:l>צַח וְאָדוֹם הוֹפִיעַ, וּבְרָעָתָם יַצְמִיתֵם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:the_blood_of_zekhariah_cries_out_barukh/4"/>
        <tei:lg>
          <tei:l>אוֹצְרוֹת שָׁמַיִם תִּפְתַּח</tei:l>
          <tei:l>וּמוֹרִיד כְּגֶּשֶׁם לְתְּשׁוּעוֹתֵינוּ יִפְתַּח</tei:l>
          <tei:l>חָמָס מֵהָאָרֶץ שְׁמוֹ יִמַּח</tei:l>
          <tei:l>וּבְהַלֵּל פִּיּוֹתֵינוּ נִפְתַּח</tei:l>
          <tei:l>הָעֲנֵנוּ בְיוֹם קָרְאֵֽנוּ הוֹפִיעַ, תְּנֲחַמֵנוּ תְּנֲחַמֵנוּ עַמֶךָ</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
