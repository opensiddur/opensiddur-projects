  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai">
        <tei:head>אֵין אַדִּיר כַּיְיָ (מִפִּי אֵל)‏</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai/1"/>
        <tei:lg>
          <tei:l>מִפִּי אֵל מִפִּי אֵל,</tei:l>
          <tei:l>יִתְבָּרַךְ יִשְׂרָאֵל</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai/2"/>
        <tei:lg>
          <tei:l>אֵין <tei:seg type="acrostic">אַ</tei:seg>דִיר כַּייָ,</tei:l>
          <tei:l>וְאֵין <tei:seg type="acrostic">בָּ</tei:seg>רוּךְ כְּבֶן עַמְרָם,</tei:l>
          <tei:l>וְאֵין <tei:seg type="acrostic">גְּ</tei:seg>דוֹלָה כַּתּוֹרָה,</tei:l>
          <tei:l>וְאֵין <tei:seg type="acrostic">דּ</tei:seg>וֹרְשָׁהּ כְּיִשְׂרָאֵל׃</tei:l>
          <tei:l>מִפִּי אֵל...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai/3"/>
        <tei:lg>
          <tei:l>אֵין <tei:seg type="acrostic">הָ</tei:seg>דוּר כַּייָ,</tei:l>
          <tei:l>וְאֵין <tei:seg type="acrostic">וָ</tei:seg>תִיק כְּבֶן עַמְרָם,</tei:l>
          <tei:l>וְאֵין <tei:seg type="acrostic">זַ</tei:seg>כָּה כַּתּוֹרָה,</tei:l>
          <tei:l>וְאֵין <tei:seg type="acrostic">ח</tei:seg>וֹמְדָה כְּיִשְׂרָאֵל׃</tei:l>
          <tei:l>מִפִּי אֵל...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai/4"/>
        <tei:lg>
          <tei:l>אֵין <tei:seg type="acrostic">טָ</tei:seg>הוֹר כַּייָ</tei:l>
          <tei:l>וְאֵין <tei:seg type="acrostic">יָ</tei:seg>שָׁר כְּבֶן עַמְרָם,</tei:l>
          <tei:l>וְאֵין <tei:seg type="acrostic">כְּ</tei:seg>בוּדָה כַּתּוֹרָה</tei:l>
          <tei:l>וְאֵין <tei:seg type="acrostic">ל</tei:seg>וֹמְדָהּ כְּיִשְׂרָאֵל׃</tei:l>
          <tei:l>מִפִּי אֵל...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai/5"/>
        <tei:lg>
          <tei:l>אֵין <tei:seg type="acrostic">מֶ</tei:seg>לֶךְ כַּייָ</tei:l>
          <tei:l>וְאֵין <tei:seg type="acrostic">נֶ</tei:seg>אֱמַן כְּבֶן עַמְרָם,</tei:l>
          <tei:l>וְאֵין <tei:seg type="acrostic">סְ</tei:seg>מוּכָה כַּתּוֹרָה</tei:l>
          <tei:l>וְאֵין <tei:seg type="acrostic">ע</tei:seg>וֹרְכָהּ כְּיִשְׂרָאֵל׃</tei:l>
          <tei:l>מִפִּי אֵל...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai/6"/>
        <tei:lg>
          <tei:l>אֵין <tei:seg type="acrostic">פּ</tei:seg>וֹדֶה כַּייָ</tei:l>
          <tei:l>וְאֵין <tei:seg type="acrostic">צַ</tei:seg>דִּיק כְּבֶן עַמְרָם,</tei:l>
          <tei:l>וְאֵין <tei:seg type="acrostic">קְ</tei:seg>דוּשָׁה כַּתּוֹרָה</tei:l>
          <tei:l>וְאֵין <tei:seg type="acrostic">ר</tei:seg>וֹחֲשָׁהּ כְּיִשְׂרָאֵל׃</tei:l>
          <tei:l>מִפִּי אֵל...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ayn_addir_kadonai/7"/>
        <tei:lg>
          <tei:l>אֵין <tei:seg type="acrostic">שָׁ</tei:seg>לֵם כַּייָ</tei:l>
          <tei:l>וְאֵין <tei:seg type="acrostic">תָּ</tei:seg>מִים כְּבֶן עַמְרָם,</tei:l>
          <tei:l>וְאֵין תְּמִימָה כַּתּוֹרָה</tei:l>
          <tei:l>וְאֵין תּוֹמְכָהּ כְּיִשְׂרָאֵל׃</tei:l>
          <tei:l>מִפִּי אֵל...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
