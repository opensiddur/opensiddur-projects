      <tei:div corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer">
        <tei:head>סדר ספירת הין</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/1"/>
        <tei:lg>
          <tei:l>סדר ספירת הין</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/2"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">(ביקום מקביל, שבו כל יהדות מתנהלת על פי הנורמות הרבניות ביקום שלנו, חוץ משני דברים — חגי מנחת היין ומנחת העצים כמו שמתוארים במגילת המקדש שבקומראן נכללו כחלק מהמקרא, ונשמר מנהג כתיבת השם הקודש בכתב עברי עתיק)</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/3"/>
        <tei:lg>
          <tei:l>הִנְנִי מוּכָן וּמְזוּמָן לְקַיֵּם מִצְוַת עֲשֵׂה</tei:l>
          <tei:l>כְּמוֹ שֶׁכָּתוּב בִּמְגִלַּת הַמִּקְדָּשׁ —</tei:l>
          <tei:l>וּסְפַרְתֶּ֣ם לָכֶ֗ם מִיּוֹם֙ הֲבִ֣יאֲכֶ֔ם אֶת־הַמִּנְחָ֥ה הַחֲדָשָׁ֖ה לַיהוה</tei:l>
          <tei:l>אֶת־לֶ֙חֶם֙ הַבִּכּוּרִ֔ים</tei:l>
          <tei:l>שִׁבְעָ֧ה שָׁבוּע֛וֹת שֶׁ֥בַע שַׁבָּת֖וֹת תְּמִימֹ֥ת תִּהְיֶֽינָה׃</tei:l>
          <tei:l>עַ֣ד מִֽמׇּחֳרַ֤ת הַשַּׁבָּת֙ הַשְּׁבִיעִ֔ת</tei:l>
          <tei:l>תִּסְפְּר֖וּ חֲמִשִּׁ֣ים יֽוֹם׃</tei:l>
          <tei:l>וְהִקְרַבְתֶּ֣ם ׀ שֶׁ֣מֶן חָדָ֗שׁ</tei:l>
          <tei:l>מִמֹּשְׁב֤וֹת מַטּוֹת֙ בְּנֵ֣י יִשְׂרָאֵ֔ל</tei:l>
          <tei:l>מַחֲצִ֧ית הֵהִ֛ין אֶחָ֖ד מִן־הַמַּטֶּ֑ה</tei:l>
          <tei:l>שֶׁ֥מֶן חָדָ֖שׁ כָּתִֽית׃</tei:l>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יהוה אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>אֲשֶׁר קִדְּשָֽׁנוּ בְּמִצְוֹתָיו</tei:l>
          <tei:l>וְצִוָּֽנוּ עַל סְפִירַת הַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/4"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כז בתמוז</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם יוֹם אֶחַד לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/5"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כח בתמוז</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁנֵי יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/6"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כט בתמוז</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁלֹשָׁה יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/7"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">א באב (ראש חודש אב)</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם אַרְבָּעָה יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/8"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ב באב</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם חֲמִשָּׁה יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/9"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ג באב</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שִׁשָּׁה יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/10"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ד באב</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שִׁבְעָה יָמִים שֶׁהֵם שָׁבֽוּעַ אֶחָד לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/11"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ה באב</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁמוֹנָה יָמִים שֶׁהֵם שָׁבֽוּעַ אֶחָד וְיוֹם אֶחָד לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/12"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ו באב</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם תִּשְׁעָה יָמִים שֶׁהֵם שָׁבֽוּעַ אֶחָד וּשְׁנֵי יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/13"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ז באב</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם עֲשָׂרָה יָמִים שֶׁהֵם שָׁבֽוּעַ אֶחָד וּשְׁלֹשָׁה יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/14"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ח באב</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם אַחַד עָשָׂר יוֹם שֶׁהֵם שָׁבֽוּעַ אֶחָד וְאַרְבָּעָה יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/15"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ט באב (צום תשעה באב)</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁנֵים עָשָׂר יוֹם שֶׁהֵם שָׁבֽוּעַ אֶחָד וַחֲמִשָׁה יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/16"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">י באב</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁלֹשָׁה עָשָׂר יוֹם שֶׁהֵם שָׁבֽוּעַ אֶחָד וְשִׁשָׁה יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/17"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">יא באב</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם אַרְבָּעָה עָשָׂר יוֹם שֶׁהֵם שְׁנֵי שָׁבוּעוֹת לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/18"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">יב באב</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם חֲמִשָּׁה עָשָׂר יוֹם שֶׁהֵם שְׁנֵי שָׁבוּעוֹת וְיוֹם אֶחָד לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/19"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">יג באב</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שִׁשָּׁה עָשָׂר יוֹם שֶׁהֵם שְׁנֵי שָׁבוּעוֹת וּשְׁנֵי יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/20"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">יד באב</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שִׁבְעָה עָשָׂר יוֹם שֶׁהֵם שְׁנֵי שָׁבוּעוֹת וּשְׁלֹשָׁה יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/21"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">טו באב (י״ה בהין)</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁמוֹנָה עָשָׂר יוֹם שֶׁהֵם שְׁנֵי שָׁבוּעוֹת וְאַרְבָּעָה יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/22"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">טז באב</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם תִּשְׁעָה עָשָׂר יוֹם שֶׁהֵם שְׁנֵי שָׁבוּעוֹת וַחֲמִשָּׁה יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/23"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">יז באב</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם עֶשְׂרִים יוֹם שֶׁהֵם שְׁנֵי שָׁבוּעוֹת וְשִׁשָּׁה יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/24"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">יח באב</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם אֶחָד וְעֶשְׂרִים יוֹם שֶׁהֵם שְׁלֹשָׁה שָׁבוּעוֹת לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/25"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">יט באב</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁנַֽיִם וְעֶשְׂרִים יוֹם שֶׁהֵם שְׁלֹשָׁה שָׁבוּעוֹת וְיוֹם אֶחָד לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/26"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כ באב</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁלֹשָׁה וְעֶשְׂרִים יוֹם שֶׁהֵם שְׁלֹשָׁה שָׁבוּעוֹת וּשְׁנֵי יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/27"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כא באב</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם אַרְבָּעָה וְעֶשְׂרִים יוֹם שֶׁהֵם שְׁלֹשָׁה שָׁבוּעוֹת וּשְׁלֹשָׁה יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/28"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כב באב</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם חֲמִשָּׁה וְעֶשְׂרִים יוֹם שֶׁהֵם שְׁלֹשָׁה שָׁבוּעוֹת וְאַרְבָּעָה יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/29"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כג באב</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שִׁשָּׁה וְעֶשְׂרִים יוֹם שֶׁהֵם שְׁלֹשָׁה שָׁבוּעוֹת וַחֲמִשָּׁה יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/30"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כד באב</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שִׁבְעָה וְעֶשְׂרִים יוֹם שֶׁהֵם שְׁלֹשָׁה שָׁבוּעוֹת וְשִׁשָּׁה יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/31"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כה באב</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁמוֹנָה וְעֶשְׂרִים יוֹם שֶׁהֵם אַרְבָּעָה שָׁבוּעוֹת לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/32"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כו באב</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם תִּשְׁעָה וְעֶשְׂרִים יוֹם שֶׁהֵם אַרְבָּעָה שָׁבוּעוֹת וְיוֹם אֶחָד לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/33"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כז באב</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁלֹשִׁים יוֹם שֶׁהֵם אַרְבָּעָה שָׁבוּעוֹת וּשְׁנֵי יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/34"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כח באב</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם אֶחָד וּשְׁלֹשִׁים יוֹם שֶׁהֵם אַרְבָּעָה שָׁבוּעוֹת וּשְׁלֹשָׁה יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/35"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כט באב</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁנַֽיִם וּשְׁלֹשִׁים יוֹם שֶׁהֵם אַרְבָּעָה שָׁבוּעוֹת וְאַרְבָּעָה יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/36"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ל באב</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁלֹשָׁה וּשְׁלֹשִׁים יוֹם שֶׁהֵם אַרְבָּעָה שָׁבוּעוֹת וַחֲמִשָּׁה יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/37"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">א באלול (ראש השנה לבהמות)</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם אַרְבָּעָה וּשְׁלֹשִׁים יוֹם שֶׁהֵם אַרְבָּעָה שָׁבוּעוֹת וְשִׁשָּׁה יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/38"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ב באלול</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם חֲמִשָּׁה וּשְׁלֹשִׁים יוֹם שֶׁהֵם חֲמִשָּׁה שָׁבוּעוֹת לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/39"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ג באלול</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שִׁשָּׁה וּשְׁלֹשִׁים יוֹם שֶׁהֵם חֲמִשָּׁה שָׁבוּעוֹת וְיוֹם אֶחָד לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/40"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ד באלול</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שִׁבְעָה וּשְׁלֹשִׁים יוֹם שֶׁהֵם חֲמִשָּׁה שָׁבוּעוֹת וּשְׁנֵי יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/41"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ה באלול</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁמוֹנָה וּשְׁלֹשִׁים יוֹם שֶׁהֵם חֲמִשָּׁה שָׁבוּעוֹת וּשְׁלֹשָׁה יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/42"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ו באלול</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם תִּשְׁעָה וּשְׁלֹשִׁים יוֹם שֶׁהֵם חֲמִשָּׁה שָׁבוּעוֹת וְאַרְבָּעָה יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/43"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ז באלול</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם אַרְבָּעִים יוֹם שֶׁהֵם חֲמִשָּׁה שָׁבוּעוֹת וַחֲמִשָּׁה יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/44"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ח באלול</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם אֶחָד וְאַרְבָּעִים יוֹם שֶׁהֵם חֲמִשָּׁה שָׁבוּעוֹת וְשִׁשָּׁה יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/45"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">ט באלול</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁנַֽיִם וְאַרְבָּעִים יוֹם שֶׁהֵם שִׁשָּׁה שָׁבוּעוֹת לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/46"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">י באלול</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁלֹשָׁה וְאַרְבָּעִים יוֹם שֶׁהֵם שִׁשָּׁה שָׁבוּעוֹת וְיוֹם אֶחָד לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/47"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">יא באלול</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם אַרְבָּעָה וְאַרְבָּעִים יוֹם שֶׁהֵם שִׁשָּׁה שָׁבוּעוֹת וּשְׁנֵי יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/48"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">יב באלול</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם חֲמִשָּׁה וְאַרְבָּעִים יוֹם שֶׁהֵם שִׁשָּׁה שָׁבוּעוֹת וּשְׁלֹשָׁה יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/49"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">יג באלול</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שִׁשָּׁה וְאַרְבָּעִים יוֹם שֶׁהֵם שִׁשָּׁה שָׁבוּעוֹת וְאַרְבָּעָה יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/50"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">יד באלול</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שִׁבְעָה וְאַרְבָּעִים יוֹם שֶׁהֵם שִׁשָּׁה שָׁבוּעוֹת וַחֲמִשָּׁה יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/51"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">טו באלול</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם שְׁמוֹנָה וְאַרְבָּעִים יוֹם שֶׁהֵם שִׁשָּׁה שָׁבוּעוֹת וְשִׁשָּׁה יָמִים לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/52"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">טז באלול (ערב חג השמן)</tei:note>
          </tei:l>
          <tei:l>הַיּוֹם תִּשְׁעָה וְאַרְבָּעִים יוֹם שֶׁהֵם שִׁבְעָה שָׁבוּעוֹת לַהִין׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/53"/>
        <tei:lg>
          <tei:l>הָרַחֲמָן הוּא יַחֲזִיר לָֽנוּ</tei:l>
          <tei:l>יִצְהַר בֵּית הַמִּקְדָשׁ לִמְקוֹמוֹ</tei:l>
          <tei:l>בִּמְהֵרָה בְיָמֵֽינוּ</tei:l>
          <tei:l>אָמֵן סֶֽלָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/54"/>
        <tei:lg>
          <tei:l>
            <tei:bibl>תהלים קלג</tei:bibl>
          </tei:l>
          <tei:l>שִׁ֥יר הַֽמַּעֲל֗וֹת לְדָ֫וִ֥ד</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/55"/>
        <tei:lg>
          <tei:l>הִנֵּ֣ה מַה־טּ֭וֹב וּמַה־נָּעִ֑ים</tei:l>
          <tei:l>שֶׁ֖בֶת אַחִ֣ים גַּם־יָֽחַד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/56"/>
        <tei:lg>
          <tei:l>כַּשֶּׁ֤מֶן הַטּ֨וֹב ׀ עַל־הָרֹ֗אשׁ</tei:l>
          <tei:l>יֹרֵ֗ד עַֽל־הַזָּקָ֥ן זְקַֽן־אַהֲרֹ֑ן</tei:l>
          <tei:l>שֶׁ֝יֹּרֵ֗ד עַל־פִּ֥י מִדּוֹתָֽיו׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:order_of_the_counting_of_the_hin_mayer/57"/>
        <tei:lg>
          <tei:l>כְּטַל־חֶרְמ֗וֹן שֶׁיֹּרֵד֮ עַל־הַרְרֵ֢י צִ֫יּ֥וֹן</tei:l>
          <tei:l>כִּ֤י שָׁ֨ם ׀ צִוָּ֣ה יהוה אֶת־הַבְּרָכָ֑ה</tei:l>
          <tei:l>חַ֝יִּ֗ים עַד־הָעוֹלָֽם׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
