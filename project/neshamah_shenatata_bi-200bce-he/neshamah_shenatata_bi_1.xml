  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:neshamah_shenatata_bi/1">
        <tei:head>אֱלֹהַי נְשָׁמָה שֶׁנָּתַתָּ בִּי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:neshamah_shenatata_bi/1/1"/>
        <tei:lg>
          <tei:l>אֱלֹהַי,</tei:l>
          <tei:l>נְשָׁמָה שֶׁנָּתַתָּ בִּי</tei:l>
          <tei:l>טְהוֹרָה הִיא,</tei:l>
          <tei:l>אַתָּה בְרָאתָהּ,</tei:l>
          <tei:l>אַתָּה יְצַרְתָּהּ,</tei:l>
          <tei:l>אַתָּה נְפַחְתָּהּ בִּי,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:neshamah_shenatata_bi/1/2"/>
        <tei:lg>
          <tei:l>וְאַתָּה מְשַׁמְּרָהּ בְּקִרְבִּי,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:neshamah_shenatata_bi/1/3"/>
        <tei:lg>
          <tei:l>וְאַתָּה עָתִיד</tei:l>
          <tei:l>לִטְּלָהּ מִמֶּנִּי,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:neshamah_shenatata_bi/1/4"/>
        <tei:lg>
          <tei:l>וּלְהַחֲזִירָהּ בִּי</tei:l>
          <tei:l>לֶעָתִיד לָבֹא.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:neshamah_shenatata_bi/1/5"/>
        <tei:lg>
          <tei:l>כָּל זְמַן שֶׁהַנְּשָׁמָה בְּקִרְבִּי</tei:l>
          <tei:l>מוֹדֶה אֲנִי לְפָנֶיךָ</tei:l>
          <tei:l>יְיָ אֱלֹהַי</tei:l>
          <tei:l>וֵאלֹהֵי אֲבוֹתַי,</tei:l>
          <tei:l>רִבּוֹן כָּל הַמַּעֲשִׂים, אֲדוֹן כָּל הַנְּשָׁמוֹת:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:neshamah_shenatata_bi/1/6"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>הַמַּחֲזִיר נְשָׁמוֹת</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:neshamah_shenatata_bi/1/7"/>
        <tei:lg>
          <tei:l>לִפְגָרִים מֵתִים:</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
