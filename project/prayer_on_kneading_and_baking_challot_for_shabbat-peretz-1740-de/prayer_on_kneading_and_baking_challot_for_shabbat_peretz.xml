  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_on_kneading_and_baking_challot_for_shabbat_peretz">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_on_kneading_and_baking_challot_for_shabbat_peretz/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">Von Perle, der Frau des Berditschewers, ist ein Gebet überliefert.</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">Wenn sie die Sabbatbrote knetete und buk, pflegte sie zu beten:</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_on_kneading_and_baking_challot_for_shabbat_peretz/2"/>
        <tei:lg>
          <tei:l>Herr der Welt,</tei:l>
          <tei:l>ich bitte dich, hilf mir,</tei:l>
          <tei:l>dass mein Levi Jizchak,</tei:l>
          <tei:l>wenn er am Sabbat über diese Brote den Segen spricht,</tei:l>
          <tei:l>dasselbe im Sinn habe</tei:l>
          <tei:l>wie ich</tei:l>
          <tei:l>in dieser Stunde, da ich sie knete und backe!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
