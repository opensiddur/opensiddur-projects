  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:an_alternate_yom_kippur_vidui_meyers/1">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:an_alternate_yom_kippur_vidui_meyers/1/1"/>
        <tei:lg>
          <tei:l>אֲנִי וְאַתָּה נְשַׁנֶּה אֶת הָעוֹלָם</tei:l>
          <tei:l>אֲנִי וְאַתָּה אָז יָבוֹאוּ כְּבָר כֻּלָּם</tei:l>
          <tei:l>אָמְרוּ אֶת זֶה קֹדֶם לְפָנַי</tei:l>
          <tei:l>לֹא מְשַׁנֶּה</tei:l>
          <tei:l>אֲנִי וְאַתָּה נְשַׁנֶּה אֶת הָעוֹלָם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:an_alternate_yom_kippur_vidui_meyers/1/2"/>
        <tei:lg>
          <tei:l>אֲנִי וְאַתָּה נְנַסֶּה מֵהַתְחָלָה</tei:l>
          <tei:l>יִהְיֶה לָנוּ רַע, אֵין דָּבָר זֶה לֹא נוֹרָא</tei:l>
          <tei:l>אָמְרוּ אֶת זֶה קֹדֶם לְפָנַי</tei:l>
          <tei:l>זֶה לֹא מְשַׁנֶּה</tei:l>
          <tei:l>אֲנִי וְאַתָּה נְשַׁנֶּה אֶת הָעוֹלָם</tei:l>
        </tei:lg>
      </tei:div>
