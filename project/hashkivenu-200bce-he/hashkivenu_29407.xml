  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hashkivenu_29407">
        <tei:head>הַשְׁכִּיבֵנוּ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hashkivenu_29407/1"/>
        <tei:lg>
          <tei:l>הַשְׁכִּיבֵֽנוּ אָבִֽינוּ לְשׁלוֹם</tei:l>
          <tei:l>וְהַעֲמִידֵנוּ מַלְכֵּנוּ</tei:l>
          <tei:l>לְחַיִּים טוֹבִים</tei:l>
          <tei:l>וּלְשָׁלוֹם</tei:l>
          <tei:l>וְתַקְּנֵנוּ מַלְכֵּנוּ</tei:l>
          <tei:l>בְּעֵצָה טוֹבָה מִלְּפָנֶיךָ</tei:l>
          <tei:l>וְהוֹשִׁיעֵנוּ מְהֵרָה לְמַעַן שְׁמֶךָ</tei:l>
          <tei:l>וְהָגֵן בַּעֲדֵנוּ מִפַּחַד לַיְלָה</tei:l>
          <tei:l>וְהָסֵר מֵעָלֵינוּ אוֹיֵב, דֶּבֶר, וְחֶרֶב, וְרָעָב וְיָגוֹן.</tei:l>
          <tei:l>וְהָסֵר הַשָּׂטָן מִלְּפָנֵינוּ וּמֵאַחֲרֵינוּ.</tei:l>
          <tei:l>וּשְׁמֹר צֵאתֵנוּ וּבוֹאֵנוּ</tei:l>
          <tei:l>מֵעַתָּה וְעַד עוֹלָם</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>שׁוֹמֵר עַמּוֹ יִשְׂרָאֵל לָעַד׃</tei:l>
        </tei:lg>
      </tei:div>
