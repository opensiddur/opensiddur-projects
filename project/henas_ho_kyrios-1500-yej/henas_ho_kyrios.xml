    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/1"/>
        <tei:lg>
          <tei:l><tei:anchor xml:id="note_1"/>I אִינָש אוֹקִירְיוֹש אוֹ תֶיאוֹש</tei:l>
          <tei:l>פַּנְדוֹ קְרַטוֹש קִי זוֹנְדָנוֹש</tei:l>
          <tei:l>דִיכוֹש טוֹרִישִי קֵי קוֹרְמִי</tei:l>
          <tei:l>וְיִשְׂרָאֵל הַלְלוּ־יָהּ:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/2"/>
        <tei:lg>
          <tei:l>II טִין יִש קֶיטִין תַלָשָה אְיפְלָשְי</tei:l>
          <tei:l>טוֹנוּרָנוֹ אַי תֵמֵילִיוֹשֶי</tei:l>
          <tei:l>מֶי לוגוֹ קַי מֶי פְרוֹנֵפֵשִי</tei:l>
          <tei:l>וְיִשְׂרָאֵל הַלְלוּ־יָהּ:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/3"/>
        <tei:lg>
          <tei:l>III אִשְטוֹ סִינַי אֵקַטֵבִיקֵי</tei:l>
          <tei:l>טוֹן אַיוֹ נוֹמוֹ מַשֶאֶדוֹקֶי</tei:l>
          <tei:l>מֵישְטֵיִיש מֵי אַסטְרָפָס קֵי מֵי וְרוֹנְדֵיש</tei:l>
          <tei:l>וְיִשְׂרָאֵל הַלְלוּ־יָהּ:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/4"/>
        <tei:lg>
          <tei:l>IV טוּ דוּלו טוּפִּישְתִיקוּ</tei:l>
          <tei:l>טוּטָפִינוּ קֵי טוּטַכְתִיקוּ</tei:l>
          <tei:l>שֵדְיוּ פְלָאקֵיש פְלֶיקְטִיקֵיש</tei:l>
          <tei:l>וְיִשְׂרָאֵל הַלְלוּ־יָהּ:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/5"/>
        <tei:lg>
          <tei:l>V קֵיאוֹ יִשְרָאֵל טוֹ דֵיכְטִיקֵי</tei:l>
          <tei:l>קֵי שְטִי קַרְדַיָיטוּ</tei:l>
          <tei:l>טו אֵיבָלִי אוֹ שָן וְלִישִידִי אַטִימִיטוֹ</tei:l>
          <tei:l>וְיִשְׂרָאֵל הַלְלוּ־יָהּ:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/6"/>
        <tei:lg>
          <tei:l>VI שָבָתוֹ קֵיפְּרִיטוֹמי</tei:l>
          <tei:l>אַדוֹקֵי אֵמָש מֵי פוֹלי טִימִי</tei:l>
          <tei:l>דִיכוֹש קָמִיָיא אַלִילוֹהִי</tei:l>
          <tei:l>וְיִשְׂרָאֵל הַלְלוּ־יָהּ:</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/7"/>
        <tei:lg>
          <tei:l><tei:anchor xml:id="note_7"/>A טוֹ פְרוֹטוֹ לוֹגוֹ פוּ מַש אִיפֵי</tei:l>
          <tei:l>אֵינָש תֵיאוֹש נָא פִיסְטֶיפְסוֹמֵי</tei:l>
          <tei:l>קֵי אַלוֹש נָא מִי פְרוֹסְקִינִיסוֹמֵי</tei:l>
          <tei:l>וְיִשְׂרָאֵל הַלְלוּ־יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/8"/>
        <tei:lg>
          <tei:l>B טוֹ דֶיפְטֶירוֹ לוֹגוֹ פוּאַקוּסְטִיקֵי</tei:l>
          <tei:l>טוֹ נוֹמַאטוּנָא מִי נוֹרְקִיסוֹמֵי</tei:l>
          <tei:l>מֵי פְסֶיפְטְיֵיאס.</tei:l>
          <tei:l>מֵי אַדִיקְיֵיאס קֵי מֵי פֶירְיֶיאלַאסְיֵיאס</tei:l>
          <tei:l>וְיִשְׂרָאֵל הַלְלוּ־יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/9"/>
        <tei:lg>
          <tei:l><tei:anchor xml:id="note_8"/>β טוֹן דֶפְטִירוֹן לוֹגוֹ אָפְמָס אִיפֶי</tei:l>
          <tei:l>מָנֶא קֵי פַּאטֵרָא נָאטִימִסוֹמֶי</tei:l>
          <tei:l>קֵי נָמִין טוּס וְלָאסְטִימִיסוֹמֵי</tei:l>
          <tei:l>וְיִשְׂרָאֵל הַלְלוּ־יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/10"/>
        <tei:lg>
          <tei:l>C טוֹ פַאטֵירָה קֵי טִי מַאנָה</tei:l>
          <tei:l>טִימִי נָא דוֹקוֹמֵי קֵיָייאחְרוֹנוּס פוֹלוּס נָא זִיסוֹמֵי</tei:l>
          <tei:l>אַפָאנוּ שְטִי יִיש קֵי טוֹ נוּרָאנוֹ</tei:l>
          <tei:l>וְיִשְׂרָאֵל הַלְלוּ־יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/11"/>
        <tei:lg>
          <tei:l>D אַפוּ סְקוֹטוֹמוֹ מַאקְרִיָיה נָא סְטְיקוֹמֵי</tei:l>
          <tei:l>קֵי טוֹן יִיינֵיקוֹן נָא מִי פִירָאזוֹמֶי</tei:l>
          <tei:l>מִידֶי מֶיקְלֶיפְִסִימְייוֹ.</tei:l>
          <tei:l>מִי דֵי מֵי מַארְטִירְייוֹ</tei:l>
          <tei:l>וְיִשְׂרָאֵל הַלְלוּ־יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/12"/>
        <tei:lg>
          <tei:l>E קַאתֵי לאוֹאִיס פְרָאמָה נָא מִי זִילֶיפְסוֹמֵי</tei:l>
          <tei:l>קֵי מֵי אַגָאפִי מֵיגָאלִי נִא זִיסוֹמֵי</tei:l>
          <tei:l>קֵי אֵינָש מִי טוֹן אַלוֹ נָא וֹוֹאִיתִיזוֹמֶי</tei:l>
          <tei:l>וְיִשְׂרָאֵל הַלְלוּ־יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/13"/>
        <tei:lg>
          <tei:l><tei:anchor xml:id="note_9"/>א טוֹ שַבַאתוֹ נַא אַיָיאְשוֹמֵי</tei:l>
          <tei:l>אֵיקְשִי מֶירֶיש נָא דוּלְיפְשוֹמֵי</tei:l>
          <tei:l>אִי שְתָא אֵיפְטַא נָא אַנַאפַפְשוֹמֶי</tei:l>
          <tei:l>וְיִשְׂרָאֵל הַלְלוּ־יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/14"/>
        <tei:lg>
          <tei:l>ב קִירִי קֵיי מִיטֵירַא נָא טִימִי שוֹמֵי</tei:l>
          <tei:l>יָא פוֹלוּש כְרוֹנוּש נַא זִישוֹמֵי</tei:l>
          <tei:l>תְרַאקוֹשְיוּש דֵיקָא קוֹשְמוּש קְלֵירוֹנוֹמִיסוֹמֵי</tei:l>
          <tei:l>וְיִשְׂרָאֵל הַלְלוּ־יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/15"/>
        <tei:lg>
          <tei:l>ג קֵיי נַא מִי שְקוֹטוֹשוּמֵי</tei:l>
          <tei:l>קַאמְיַא יִנֵיקָא מִי פִירָקְשוֹמֵי</tei:l>
          <tei:l>טִיפוֹטִיש מִי קְלֵפְשוֹמֵי</tei:l>
          <tei:l>וְיִשְׂרָאֵל הַלְלוּ־יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/16"/>
        <tei:lg>
          <tei:l>ד נַא מִי פְשֵפְטוֹמַרְטִירִישוֹמִי</tei:l>
          <tei:l>פַרָאמ*א קְשֵינוֹ מִי זִילֶיפְשוֹמֵי</tei:l>
          <tei:l>אֵינַש אִישטוֹן אַלוֹ נַא וֹויִטִישוֹמֵי</tei:l>
          <tei:l>וְיִשְׂרָאֵל הַלְלוּ־יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/17"/>
        <tei:lg>
          <tei:l>ה אוֹ טֵימוּ פַאנְדוֹש קַרַאטוֹרָא</tei:l>
          <tei:l>פִילַאקְשֵימַש גְלִיגוֹרַא</tei:l>
          <tei:l>סְטִילֵימַש טִין גֶאוּלָה</tei:l>
          <tei:l>וְיִשְׂרָאֵל הַלְלוּ־יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/18"/>
        <tei:lg>
          <tei:l><tei:anchor xml:id="note_13"/>ה1 אַפֵנְדִי פַנְדוֹקְרַאטוֹרַ</tei:l>
          <tei:l>סִמפַפִסֵימָס סִימֵרַה</tei:l>
          <tei:l>טִין גאולה סְטִילֵמַס אוֹגְלִיגוֹרַא</tei:l>
          <tei:l>וְיִשְׂרָאֵל הַלְלוּ־יָהּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:henas_ho_kyrios/19"/>
        <tei:lg>
          <tei:l>ו קֵי נַא אַנֵיבוּמֵי אִישטַא תִרִיאַ רְגַלִים</tei:l>
          <tei:l>מֵי טוֹ פִילֵימַא אוֹכְטַא בִיכוּרִים</tei:l>
          <tei:l>זִיגוֹנְדַש טוֹ קֹרְבַן עוֹלַה</tei:l>
          <tei:l>וְיִשְׂרָאֵל הַלְלוּ־יָהּ</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
