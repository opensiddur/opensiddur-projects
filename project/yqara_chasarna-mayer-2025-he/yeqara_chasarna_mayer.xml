    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yeqara_chasarna_mayer">
        <tei:head>יְקָרָא חֲסַרְנָא</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yeqara_chasarna_mayer/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">יְ</tei:seg>קָרָא חֲסַרְנָא לְמִפְתַּרְנָא מִילָּתָא קַדִּישָׁתָא דִּנְבִיאֵי׃</tei:l>
          <tei:l><tei:seg type="acrostic">צְ</tei:seg>לוּתִי עֲמִיקְתָּא מִילְּתָא פְּסִיקְתָּא וּמִדְרְשַׁי דַּמְיָן כִּבְדִיאֵי׃</tei:l>
          <tei:l><tei:seg type="acrostic">ח</tei:seg>וּכְמָא בָּעֲיָנָא בִּרְשׁוּתָא דְּרַחֲמָנָא לְאַחֲיָא מִנְהָגָא דְּאַנְשְׁיוּ׃</tei:l>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>רִיתִי בְּסִפְרֵי דְּפוּלְחָן מִן־דָּרֵי קַדְמָאִין דְּלֵית בְּהוֹן תַּשְׁיוּ׃</tei:l>
          <tei:l><tei:seg type="acrostic">חִ</tei:seg>יבְּתָא וּרְחִימוּ לְלִישָּׁנָא דְּתַרְגִּימוּ חַכִּימַיָּא וּבַר־עוּזִּיאֵל רֵישְׁהוֹן׃</tei:l>
          <tei:l><tei:seg type="acrostic">זְק</tei:seg>וֹף תּוּרְגְּמָנָא קֳדָם אַפְטַרְתָּנָא לְמִפְשַׁר נְבִיאֵי וְרָזֵיהוֹן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
