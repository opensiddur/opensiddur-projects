    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:kavvanah_before_working_with_the_holy_soil_of_erets_yisrael_sharabi">
        <tei:head>כַּוָּנָה לִפְנֵי עֲבוֹדָה בְּאַדְמַת הַקֹּדֶשׁ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kavvanah_before_working_with_the_holy_soil_of_erets_yisrael_sharabi/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">כְּזֶה הוּא הַסֵּדֶר לוֹמַר בְּשָׁעָה שֶׁמַּחֲזִיק בַּמַּעְדֵּר לַחֲפֹר חֲפִירָה לִנְטִיעָה:</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kavvanah_before_working_with_the_holy_soil_of_erets_yisrael_sharabi/2"/>
        <tei:lg>
          <tei:l>לְשֵׁם יִחוּד קוּדְשָׁא בְּרִיךְ הוּא וּשְׁכִינְתֵיהּ,</tei:l>
          <tei:l>בִּדְחִילוּ וּרְחִימוּ,</tei:l>
          <tei:l>הֲרֵינִי נוֹטֵל מַעְדֵּ״ר זֶה</tei:l>
          <tei:l>הָעוֹלָה בְּגִימַטְרִיָּה שַׁדַּ״י,</tei:l>
          <tei:l>לְהַכְרִית בּוֹ הַחוֹחִים וְהַקּוֹצִים,</tei:l>
          <tei:l>וְלַחֲצֹב בּוֹ כׇּל הַנִּיצוֹצִים</tei:l>
          <tei:l>מִתּוֹךְ אַדְמָתֵנוּ</tei:l>
          <tei:l>אַדְמַת הַקּוֹדֶשׁ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kavvanah_before_working_with_the_holy_soil_of_erets_yisrael_sharabi/3"/>
        <tei:lg>
          <tei:l>יְהִי רָצוֹן מִלְּפָנֶיךָ ה׳ אֱלֹהֵינוּ וְאֱלֹהֵי אֲבוֹתֵינוּ</tei:l>
          <tei:l>הַמַּצִּיב גְּבוּל וְהַמֵּשִׁיב בָּנִים לִגְבוּלָם,</tei:l>
          <tei:l>כִּי תְּחַזְּקֶנּוּ וְתַצְלִיחַ דְּרָכֵינוּ</tei:l>
          <tei:l>בַּעֲבוֹדָתֵנוּ עֲבוֹדַת הַקּוֹדֶשׁ</tei:l>
          <tei:l>עַל אַדְמַת הַקּוֹדֶשׁ,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kavvanah_before_working_with_the_holy_soil_of_erets_yisrael_sharabi/4"/>
        <tei:lg>
          <tei:l>וְנִזְכֶּה לִרְאוֹת בְּטָהֳרַת אַדְמַת יִשְׂרָאֵל</tei:l>
          <tei:l>מִטֻּמְאָתָהּ</tei:l>
          <tei:l>בְּעֵת שְׁיְּנַעֲרוּ</tei:l>
          <tei:l>רְשָׁעִים מִמֶּנָּה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:kavvanah_before_working_with_the_holy_soil_of_erets_yisrael_sharabi/5"/>
        <tei:lg>
          <tei:l>וְתָשׁוּב אֶל בַּעְלָהּ הָרִאשׁוֹן,</tei:l>
          <tei:l>עִם בִּנְיַן צִיּוֹן וִירוּשָׁלַיִם.</tei:l>
          <tei:l>אָמֵן, כֵּן יְהִי רָצוֹן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
