      <tei:div corresp="urn:x-opensiddur:text:prayer:gadol_adonai_umehullal">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:gadol_adonai_umehullal/1"/>גָּדוֹל יְהוָה וּמְהֻלָּל מְאֹד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:gadol_adonai_umehullal/2"/>בְּעִיר אֱלֹהֵינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:gadol_adonai_umehullal/3"/>הַר־קָדְשׁוֹ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/48/3"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:gadol_adonai_umehullal/4"/>יְפֵה נוֹף
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:gadol_adonai_umehullal/5"/>מְשׂוֹשׂ כָּל־הָאָרֶץ הַר־צִיּוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:gadol_adonai_umehullal/6"/>יַרְכְּתֵי צָפוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:gadol_adonai_umehullal/7"/>קִרְיַת מֶלֶךְ רָב:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:gadol_adonai_umehullal/8"/>הֵיטִיבָה בִרְצוֹנְךָ אֶת־צִיּוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:gadol_adonai_umehullal/9"/>תִּבְנֶה חוֹמוֹת יְרוּשָׁלִָם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:gadol_adonai_umehullal/10"/>יָשָׁב־נָא אַפְּךָ וַחֲמָתְךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:gadol_adonai_umehullal/11"/>מֵעִירְךָ יְרוּשָׁלִַם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:gadol_adonai_umehullal/12"/>הַר־קָדְשֶׁךָ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/102/22"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:gadol_adonai_umehullal/13"/>לְסַפֵּר בְּצִיּוֹן שֵׁם יְהוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:gadol_adonai_umehullal/14"/>וּתְהִלָּתוֹ בִּירוּשָׁלִָם:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:malachi/3/4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:gadol_adonai_umehullal/15"/>וְעָרְבָה לַיהוָֹה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:gadol_adonai_umehullal/16"/>מִנְחַת יְהוּדָה וִירוּשָׁלִָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:gadol_adonai_umehullal/17"/>כִּימֵי עוֹלָם וּכְשָׁנִים קַדְמֹנִיּוֹת:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/147/2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:gadol_adonai_umehullal/18"/>בּוֹנֵה יְרוּשָׁלִַם יְהוָֹה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:gadol_adonai_umehullal/19"/>נִדְחֵי יִשְׂרָאֵל יְכַנֵּס:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:samuel_1/12/22"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:gadol_adonai_umehullal/20"/>כִּי לֹא־יִטֹּשׁ יְהוָֹה אֶת עַמּוֹ
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:gadol_adonai_umehullal/21"/>וְנַחֲלָתוֹ לֹא יַעֲזֹב:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>