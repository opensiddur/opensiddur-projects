      <tei:div corresp="urn:x-opensiddur:text:poem:bein_keseh_leasor/stanza_1">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_1/1"/>בֵּין כֶּסֶה לֶעָשֹוֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_1/2"/>הִשְׁלַכְנוּ רֹעַ שְֹאוֹר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_1/3"/>צַדְּקֵנוּ בַּמִּשְׁפָּט
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_1/4"/>בְּאוֹר הַחַיִּים לֵאוֹר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_1/5"/>הִנְנוּ אָתָאנוּ לְךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_1/6"/>אַדִּיר וְנָאוֹר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_1/7"/>כִּי־עִמְּךָ מְקוֹר חַיִּים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_1/8"/>בְּאוֹרְךָ נִרְאֶה אוֹר:</tei:p>
