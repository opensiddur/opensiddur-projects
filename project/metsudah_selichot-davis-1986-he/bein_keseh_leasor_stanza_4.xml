      <tei:div corresp="urn:x-opensiddur:text:poem:bein_keseh_leasor/stanza_4">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_4/1"/>שׁוֹחֲרֶיךָ הִמָּצֵא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_4/2"/>לְחַנֶנְךָ עוֹמְדִים הַשְׁכֵּם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_4/3"/>לְבַל יָעֹז קַטֵּגוֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_4/4"/>בְּעֵינֶיךָ בַּל־יִתְחַכֵּם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_4/5"/>מְלִיצִים וּפְרַקְלִיטִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_4/6"/>בְּחַסְדְּךָ עִמָּם הַסְכֵּם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_4/7"/>כִּתְבוּ עַל־הַיְּהוּדִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_4/8"/>כַּטּוֹב בְּעֵינֵיכֶם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_4/9"/>בֵּין כֶּסֶה לֶעָשׂוֹר</tei:p>
      </tei:div>
