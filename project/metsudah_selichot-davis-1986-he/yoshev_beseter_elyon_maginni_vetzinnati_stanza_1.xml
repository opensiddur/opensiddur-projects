      <tei:div corresp="urn:x-opensiddur:text:poem:yoshev_beseter_elyon_maginni_vetzinnati/stanza_1">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_1/1"/>יֹשֵׁב בְּסֵתֶר עֶלְיוֹן,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_1/2"/>מָגִנִּי וְצִנָּתִי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_1/3"/>צַעֲקָתִי הַקְשִׁיבָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_1/4"/>וְהַאֲזִינָה רִנָּתִי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_1/5"/>חַטֵּא אֶת־חַטָּאתִי,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_1/6"/>קָדוֹשׁ תֵּן תִּקְוָתִי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_1/7"/>נַפְשִׁי בִּשְׁאֵלָתִי,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_1/8"/>וְעַמִּי בְּבַקָּשָׁתִי:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
