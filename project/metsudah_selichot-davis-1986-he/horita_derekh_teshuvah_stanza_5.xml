    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:horita_derekh_teshuvah/stanza_5">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_5/1"/>מְחַלֵּל יְצוּעֵי יוֹלְדוֹ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_5/2"/>אֲשֶׁר־פַּחַז כַּמַּיִם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_5/3"/>נָטָיוּ רַגְלָיו כִּמְעַט,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_5/4"/>לוּלֵי שָׁפַךְ לֵב כַּמַּיִם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_5/5"/>סָרַח גּוּר־אַרְיֵה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_5/6"/>בִּקְדֵשָׁה הִיא בָעֵינָיִם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_5/7"/>עֲוֹנוֹ הוֹדָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_5/8"/>וְהִכְרַעְתּוֹ לְצֶדֶק בְּכַף־מֹאזְנַיִם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_5/9"/>הֲשִׁיבֵנוּ יְהֹוָה אֵלֶיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_5/10"/>וְנָשׁוּבָה:</tei:p>
      </tei:div>
