        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_lanu_berit_avot/1"/>זְכוֹר לָֽנוּ בְּרִית אָבוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_lanu_berit_avot/2"/>כַּאֲשֶׁר אָמַֽרְתָּ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:leviticus/26/42"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_lanu_berit_avot/3"/>וְזָכַרְתִּי אֶת בְּרִיתִי יַעֲקוֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_lanu_berit_avot/4"/>וְאַף אֶת בְּרִיתִי יִצְחָק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_lanu_berit_avot/5"/>וְאַף אֶת בְּרִיתִי אַבְרָהָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_lanu_berit_avot/6"/>אֶזְכֹּר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_lanu_berit_avot/7"/>וְהָאָֽרֶץ אֶזְכֹּר:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
