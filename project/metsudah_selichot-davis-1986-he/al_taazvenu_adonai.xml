    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:al_taazvenu_adonai">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_taazvenu_adonai/1"/>אַל תַּעַזְבֵֽנוּ יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_taazvenu_adonai/2"/>אַל תִּרְחַק מִמֶּֽנּוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_taazvenu_adonai/3"/>אַל־תִּרְחַק מִמֶּנּוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_taazvenu_adonai/4"/>כִּי־צָרָה קְרוֹבָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_taazvenu_adonai/5"/>כִּי־אֵין עוֹזֵר׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_taazvenu_adonai/6"/>עֶזְרֵנוּ מֵעִם יְהוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_taazvenu_adonai/7"/>עֹשֵׂה שָׁמַיִם וָאָרֶץ׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_taazvenu_adonai/8"/>אַל־יִתֵּן לַמּוֹט רַגְלֵנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_taazvenu_adonai/9"/>אַל־יָנוּם שֹׁמְרֵנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_taazvenu_adonai/10"/>יְהֹוָה הוֹשִֽׁיעָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_taazvenu_adonai/11"/>הַמֶּֽלֶךְ יַעֲנֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_taazvenu_adonai/12"/>בְיוֹם קָרְאֵנוּ:</tei:p>
