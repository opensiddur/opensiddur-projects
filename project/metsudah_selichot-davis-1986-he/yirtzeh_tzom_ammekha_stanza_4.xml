      <tei:div corresp="urn:x-opensiddur:text:poem:yirtzeh_tzom_ammekha/stanza_4">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_4/1"/>קְרַב וּשְׁמַע רִנָּתִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_4/2"/>לְזַעֲקָתִי תִּפְתַּח שַׁעַר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_4/3"/>לְזַכּוֹת אֶת חַטָּאתִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_4/4"/>כְּמוֹ בֶן־שָׁנָה נַעַר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_4/5"/>וְתַחֲסֹם לְשׁוֹן מַשְׂטִינִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_4/6"/>וְאֶת־פִּיהוּ לֹא יִפְעַר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_4/7"/>יְהֹוָה בַּשָֹּטָן יִגְעַר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_4/8"/>קוּם־רֵד מַהֵר מִזֶּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_4/9"/>מָחָר יִהְיֶה הָאוֹת הַזֶּה:</tei:p>
      </tei:div>
