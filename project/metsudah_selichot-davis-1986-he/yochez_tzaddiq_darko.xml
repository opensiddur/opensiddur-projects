      <tei:div corresp="urn:x-opensiddur:text:prayer:yochez_tzaddiq_darko">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yochez_tzaddiq_darko/1"/>יֹאחֵז צַדִּיק דַּרְכּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yochez_tzaddiq_darko/2"/>וּטֳהָר־יָדַיִם יֹסִיף אֹמֶץ׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/31/25"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yochez_tzaddiq_darko/3"/>חִזְקוּ וְיַאֲמֵץ לְבַבְכֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yochez_tzaddiq_darko/4"/>כָּל־הַמְיַחֲלִים לַיהוָה׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yochez_tzaddiq_darko/5"/>בַּצַּר־לָנוּ נִקְרָא יְהוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yochez_tzaddiq_darko/6"/>וְאֶל־אֱלֹהֵינוּ נְשַׁוֵּעַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yochez_tzaddiq_darko/7"/>וְיִשְׁמַע מֵהֵיכָלוֹ קוֹלֵינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yochez_tzaddiq_darko/8"/>וְשַׁוְעָתֵנוּ לְפָנָיו תָּבוֹא׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yochez_tzaddiq_darko/9"/>עֲנֵנֵוּ יְהוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yochez_tzaddiq_darko/10"/>כִּי־טוֹב חַסְדֶּךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yochez_tzaddiq_darko/11"/>כְּרֹב רַחֲמֶיךָ פְּנֵה אֵלֵינוּ׃</tei:p>
