      <tei:div corresp="urn:x-opensiddur:text:poem:eshet_neurim_haahuvah">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eshet_neurim_haahuvah/1"/>אֵשֶׁת נְעוּרִים הָאֲהוּבָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eshet_neurim_haahuvah/2"/>אֲשֶׁר אֵרַשְׂתָּהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eshet_neurim_haahuvah/3"/>בְּרֹב־מֹהַר וְרֹב־טוֹבָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eshet_neurim_haahuvah/4"/>וְאֵיךְ עַתָּה יוֹשֶׁבֶת עֲלוּבָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eshet_neurim_haahuvah/5"/>גְּעוּלָה וּמְאוּסָה וַעֲזוּבָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eshet_neurim_haahuvah/6"/>לְבוּשָׁה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eshet_neurim_haahuvah/7"/>בַּעֲדִי עֲדָיִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eshet_neurim_haahuvah/8"/>אֲשֶׁר הִתְנֵיתָ בִּבְרִית
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eshet_neurim_haahuvah/9"/>וּבִתְנָאִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eshet_neurim_haahuvah/10"/>וְאֵיךְ עַתָּה סוֹבֶבֶת דְּלָתַיִם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eshet_neurim_haahuvah/11"/>וְשׁוֹכֶבֶת בֵּין שְׁפַתָּיִם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eshet_neurim_haahuvah/12"/>חֲבוּשָׁה בְּשֵׁשׁ וּמֶשִׁי כְּלוּלָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eshet_neurim_haahuvah/13"/>הִיא הָיְתָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eshet_neurim_haahuvah/14"/>בְּכָל הָאָרֶץ מְהֻלָּלָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eshet_neurim_haahuvah/15"/>וְאֵיךְ עַתָּה נֶחְשֶׁבֶת מְחֻלָּלָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eshet_neurim_haahuvah/16"/>לְלַעַג וּלְבֹשֶׁת וְלִקְלָלָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eshet_neurim_haahuvah/17"/>נְוַת פְּעָמִים בִּנְעָלֶיהָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eshet_neurim_haahuvah/18"/>אֲשֶׁר כְּנָפֶיךָ פְּרוּשִׂים עָלֶיהָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eshet_neurim_haahuvah/19"/>וְאֵיךְ עַתָּה נִגְּפוּ רַגְלֶיהָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eshet_neurim_haahuvah/20"/>עַל־הֶהָרִים אַחַר עוֹלָלֶיהָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eshet_neurim_haahuvah/21"/>נָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eshet_neurim_haahuvah/22"/>יוֹשֵׁב הַכְּרוּבִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eshet_neurim_haahuvah/23"/>תֵּרֶא בְּכָל־זֹאת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eshet_neurim_haahuvah/24"/>לֹא־פָנְתָה אֶל־רְהָבִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eshet_neurim_haahuvah/25"/>לֹא עַל פָּרָשִׁים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eshet_neurim_haahuvah/26"/>וְלֹא עַל־רוֹכְבִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eshet_neurim_haahuvah/27"/>כִּי עַל־רַחֲמֶיךָ הָרַבִּים:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
