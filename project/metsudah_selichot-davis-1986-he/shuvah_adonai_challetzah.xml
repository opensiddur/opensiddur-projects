      <tei:div corresp="urn:x-opensiddur:text:prayer:shuvah_adonai_challetzah">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_adonai_challetzah/1"/>שׁוּבָה יְהֹוָה חַלְּצָה נַפְשֵׁנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_adonai_challetzah/2"/>וְהוֹשִׁיעֵֽנוּ לְמַֽעַן חַסְדֶּֽךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_adonai_challetzah/3"/>שׁוּבוּ שׁוּבוּ אָמַרְתָּ לָנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_adonai_challetzah/4"/>וְעַל הַתְּשׁוּבָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_adonai_challetzah/5"/>מֵרֹאשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_adonai_challetzah/6"/>הִבְטַחְתָּנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_adonai_challetzah/7"/>זִבְחֵי אֱלֹהִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_adonai_challetzah/8"/>רוּחַ נִשְׁבָּרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_adonai_challetzah/9"/>לֵב־נִשְׁבָּר וְנִדְכֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_adonai_challetzah/10"/>אֱלֹהִים לֹא תִבְזֶה׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_adonai_challetzah/11"/>תָּבוֹא לְפָנֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_adonai_challetzah/12"/>אֶנְקַת אָסִיר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_adonai_challetzah/13"/>כְּגֹדֶל זְרוֹעֲךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_adonai_challetzah/14"/>הוֹתֵר בְּנֵי תְמוּתָה׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_adonai_challetzah/15"/>תִּתֵּן אֱמֶת לְיַעֲקֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_adonai_challetzah/16"/>חֶֽסֶד לְאַבְרָהָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_adonai_challetzah/17"/>אשֶׁר נִשְׁבַּֽעְתָּ לַאֲבוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_adonai_challetzah/18"/>מִימֵי קֶֽדֶם:</tei:p>
      </tei:div>
