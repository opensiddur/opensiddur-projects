      <tei:div corresp="urn:x-opensiddur:text:poem:horita_derekh_teshuvah/stanza_1">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_1/1"/>הוֹרֵיתָ דֶּרֶךְ תְּשׁוּבָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_1/2"/>לְבַת הַשּׁוֹבֵבָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_1/3"/>בֵּין כֶּסֶא לֶעָשֹוֹר,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_1/4"/>עָדֶיךָ לָשׁוּבָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_1/5"/>הֲשִׁיבֵנוּ יְהֹוָה אֵלֶיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_1/6"/>וְנָשׁוּבָה:</tei:p>
