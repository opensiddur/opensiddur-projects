      <tei:div corresp="urn:x-opensiddur:text:prayer:tashuv_terachamenu_tikhbosh">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tashuv_terachamenu_tikhbosh/1"/>תָּשׁוּב תְּרַחֲמֵנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tashuv_terachamenu_tikhbosh/2"/>תִּכְבֹּשׁ עֲוֺנֹתֵינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tashuv_terachamenu_tikhbosh/3"/>וְתַשְׁלִיךְ בִּמְצֻלוֹת יָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tashuv_terachamenu_tikhbosh/4"/>כָּל־חַטֹּאתֵינוּ׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tashuv_terachamenu_tikhbosh/5"/>שׁוּב מֵחֲרוֹן אַפֶּךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tashuv_terachamenu_tikhbosh/6"/>וְהִנָּחֵם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tashuv_terachamenu_tikhbosh/7"/>עַל־הָרָעָה לְעַמֶּךָ׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tashuv_terachamenu_tikhbosh/8"/>שׁוּבָה יְהוָה אֶת־שְׁבִיתֵנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tashuv_terachamenu_tikhbosh/9"/>כַּאֲפִיקִים בַּנֶּגֶב׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tashuv_terachamenu_tikhbosh/10"/>הֲשִׁיבֵנוּ יְהוָה אֵלֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tashuv_terachamenu_tikhbosh/11"/>וְנָשׁוּבָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tashuv_terachamenu_tikhbosh/12"/>חַדֵּשׁ יָמֵינוּ כְּקֶדֶם׃</tei:p>
