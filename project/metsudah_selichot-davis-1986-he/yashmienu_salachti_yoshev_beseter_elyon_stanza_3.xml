    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yashmienu_salachti_yoshev_beseter_elyon/stanza_3">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_3/1"/>בְּבֹא כְגַל הַגַּלְגָּל,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_3/2"/>לְהַחֲלִיף הַשִּׁטָּה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_3/3"/>רַעֲיָתְךָ יוֹנָתְךָ, לְךָ פּוֹנָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_3/4"/>הַבִּיטָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_3/5"/>בְּאַוַּת נַפְשָׁהּ הִגִּישָׁה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_3/6"/>לִפְתֹּחַ בַּחֲרָטָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_3/7"/>יְמִין פְּשׁוּטָה מִלְמַטָּה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_3/8"/>בְּצִפִּיָּתֵנוּ צִפִּינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_3/9"/>יְהֹוָה הֱיֵה עוֹזֵר לָנוּ:</tei:p>
