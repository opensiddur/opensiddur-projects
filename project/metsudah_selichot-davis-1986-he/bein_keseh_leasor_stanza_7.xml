      <tei:div corresp="urn:x-opensiddur:text:poem:bein_keseh_leasor/stanza_7">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_7/1"/>לְפַתּוֹתְךָ בְּתַחַן,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_7/2"/>עֲבָדֶיךָ מַסְכִּימִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_7/3"/>הִפָּתַח לָמּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_7/4"/>וּזְכֹר נִחוּמִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_7/5"/>חַסְדְּךָ הַפְלֵא,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_7/6"/>וְהַעֲבֵר כְּתָמִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_7/7"/>אֵל מֶלֶךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_7/8"/>יוֹשֵׁב עַל־כִּסֵּא רַחֲמִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_7/9"/>בֵּין כֶּסֶה לֶעָשׂוֹר</tei:p>
      </tei:div>
