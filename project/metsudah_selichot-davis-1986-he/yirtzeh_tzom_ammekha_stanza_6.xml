      <tei:div corresp="urn:x-opensiddur:text:poem:yirtzeh_tzom_ammekha/stanza_6">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_6/1"/>רְאֵה אֵין־מְכַפֵּר בַּעֲדִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_6/2"/>וְאֵין סוֹדֵר לִי סֵדֶר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_6/3"/>וּבִגְדֵי לָבָן אַיִן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_6/4"/>וְאֵין לוֹבֵשׁ הָאֵדֶר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_6/5"/>וְגַם אֵין־קָרְבָּן חוֹבָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_6/6"/>וְלֹא נְדָבָה וָנֶדֶר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_6/7"/>וְאַתָּה תְּכַפֵּר עָלַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_6/8"/>בּוֹחֵן כְּלָיוֹת וָחֵדֶר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_6/9"/>גְּדֹר פִּרְצַת צֹאנֶךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_6/10"/>וְשִֹים רֶוַח לָעֵדֶר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_6/11"/>וְתִבְנֶה לָמוֹ גָּדֵר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_6/12"/>מִזֶּה וְגָדֵר מִזֶּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_6/13"/>מָחָר יִהְיֶה הָאוֹת הַזֶּה:</tei:p>
