      <tei:div corresp="urn:x-opensiddur:text:prayer:keayyal_taarog_al">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:keayyal_taarog_al/1"/>כְּאַיָּל תַּעֲרֹג
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:keayyal_taarog_al/2"/>עַל־אֲפִיקֵי־מָיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:keayyal_taarog_al/3"/>כֵּן נַפְשֵׁנוּ תַעֲרֹג
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:keayyal_taarog_al/4"/>אֵלֶיךָ אֱלֹהִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:keayyal_taarog_al/5"/>אֱלֹהִים זֵדִים קָמוּ־עָלֵינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:keayyal_taarog_al/6"/>וַעֲדַת עָרִיצִים בִּקְשׁוּ נַפְשֵׁינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:keayyal_taarog_al/7"/>וְלֹא שָׂמוּךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:keayyal_taarog_al/8"/>לְנֶגְדָּם סֶלָה:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/83/13"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:keayyal_taarog_al/9"/>אֲשֶׁר אָמְרוּ נִירְשָׁה לָּנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:keayyal_taarog_al/10"/>אֵת נְאוֹת אֱלֹהִים:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:isaiah/64/11"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:keayyal_taarog_al/11"/>הַעַל־אֵלֶּה תִתְאַפַּק יְהוָֹה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:keayyal_taarog_al/12"/>תֶּחֱשֶׁה וּתְעַנֵּנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:keayyal_taarog_al/13"/>עַד־מְאֹד:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
