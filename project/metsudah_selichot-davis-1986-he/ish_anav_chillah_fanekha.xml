      <tei:div corresp="urn:x-opensiddur:text:poem:ish_anav_chillah_fanekha">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ish_anav_chillah_fanekha/1"/>וּכְשֶׁחָטְאוּ יִשְׂרָאֵל בַּמִּדְבָּר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ish_anav_chillah_fanekha/2"/>עָמַד מֹשֶׁה רַבֵּנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ish_anav_chillah_fanekha/3"/>בִּתְפִלָּה לְפָנֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ish_anav_chillah_fanekha/4"/>וּבִקֵּשׁ רַחֲמִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ish_anav_chillah_fanekha/5"/>עַל עַמְּךָ בֵּית יִשְׂרָאֵל.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ish_anav_chillah_fanekha/6"/>וְכָךְ אָמַר בִּתְפִלָּתוֹ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ish_anav_chillah_fanekha/7"/>מַלְכִּי וֵאלֹהָי.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
