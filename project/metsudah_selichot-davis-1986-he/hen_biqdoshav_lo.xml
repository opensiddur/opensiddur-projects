  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hen_biqdoshav_lo">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:job/15/15"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hen_biqdoshav_lo/1"/>הֵן בִּקְדֹשָׁיו לֹא יַאֲמִין
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hen_biqdoshav_lo/2"/>וְשָׁמַיִם לֹא־זַכּוּ בְעֵינָיו׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:job/25/6"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hen_biqdoshav_lo/3"/>אַף כִּי־אֱנוֹשׁ רִמָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hen_biqdoshav_lo/4"/>וּבֶן־אָדָם תּוֹלֵעָה׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hen_biqdoshav_lo/5"/>הִנְנוּ לְפָנֶיךָ בְּאַשְׁמָתֵינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hen_biqdoshav_lo/6"/>כִּי אֵין לַעֲמוֹד לְפָנֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hen_biqdoshav_lo/7"/>עַל־זֹאת׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/20/9"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hen_biqdoshav_lo/8"/>מִי־יֹאמַר זִכִּיתִי לִבִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hen_biqdoshav_lo/9"/>טָהַרְתִּי מֵחַטָּאתִי׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
