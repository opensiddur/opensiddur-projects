    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:betulat_bat_yehudah">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/1"/>אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/2"/>בְּתוּלַת בַּת יְהוּדָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/3"/>רַבַּת תַּאֲנִיָּה וַאֲנִיָּה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/4"/>מִתְיַפְּחָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/5"/>פּוֹרֶסֶת כַּף,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/6"/>מֵעִמְקֵי שִׁבְיָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/7"/>מִן־הַמֵּצַר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/8"/>קְרָאתִיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/9"/>עֲנֵנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/10"/>בַמֶּרְחָב יָהּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/11"/>מֵאֵשׁ וּמִמַּיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/12"/>תּוֹצִיאֶנָּה לָרְוָיָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/13"/>נוֹשֵׂאת עַיִן לְעֶזְרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/14"/>וּמַבֶּטֶת הֵנָּה וָהֵנָּה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/15"/>מִתְחוֹלֶלֶת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/16"/>כְּמַבְכִּירָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/17"/>בְּצִירֶיהָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/18"/>מִגְּזֵרוֹת עֲדִינָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/19"/>סוֹפֶקֶת כַּף אֶל כַּף,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/20"/>וְהוֹמָה בְּהֶגְיוֹנָהּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/21"/>אַיֵּה אֵיפוֹא תִּקְוָתִי,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/22"/>וְתִקְוָתִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/23"/>מִי־יְשׁוּרֶנָּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/24"/>יְדִידוּת נַפְשָׁהּ וּמִשְׁכְּנוֹתֶיהָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/25"/>וּצְבִי גְאוֹנָהּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/26"/>כְּנִתְּנוּ בְּיַד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/27"/>מְחָרְפֶיהָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/28"/>וּבְיַד מְעַנָּהּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/29"/>הַשּׁוֹאֶגֶת בְּתוֹךְ מוֹעֲדֶיהָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/30"/>וּבְקוֹלָהּ עָלֶיהָ נָתָנָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/31"/>אַיֵּה דְּבַר־יְהֹוָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/32"/>יָבֹא־נָא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/33"/>מִשְּׁבִי לְגָלוּת נְפוּצָה וּשְׁבוּרָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/34"/>אֲיֻמָּתֶךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/35"/>מִפְּנֵי זַעַם חֲמָתְךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/36"/>וּמֵאֵימַת עֶבְרָתֶךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/37"/>וּבְקֹצֶר־רוּחַ בְקוֹל־מַר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/38"/>שׁוֹאֶגֶת לְעֻמָּתֶךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/39"/>אַיֵּה קִנְאָתְךָ וּגְבוּרָתֶיךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/40"/>נָטַשְׁתָּ עַמְּךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/41"/>בֵּית־יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/42"/>בְּאֶרֶץ שִׁבְיָם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/43"/>נָדִים וְנָעִים בְּאֶרֶץ הָאוֹיֵב,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/44"/>כָּאֳנִיָּה בְּלֶב־יָם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/45"/>לְאָבוֹת שׁוֹאֲלִים עוֹלְלִים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/46"/>מוֹפְתֵי־רוֹעֶה אַיָּם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/47"/>אַיֵּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/48"/>הַמַּעֲלֵם מִיָּם:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:job/30/8"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/49"/>בְּנֵי־נָבָל, גַּם בְּנֵי בְלִי שֵׁם,
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/50"/>בּוֹסְסוּ נַחֲלָתֵנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/51"/>רִחֲקוּנוּ מֵעַל אַדְמָתֵנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/52"/>וּמִגְּבוּל אַרְצֵנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/53"/>אָמַרְנוּ נִגְזַרְנוּ, אָבְדָה תִקְוָתֵנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/54"/>אַיֵּה כָּל־נִפְלְאוֹתֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/55"/>אֲשֶׁר סִפְּרוּ־לָנוּ אֲבוֹתֵינוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/56"/>זְכֹר יְהֹוָה לִבְנֵי־אֱדוֹם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/57"/>חָרְבוֹת הֵיכָלָךְ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/58"/>רִצֵּץ אַבִּירַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/59"/>וְנִפֵּץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/60"/>עוֹלְלֵי־קְהָלָךְ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/61"/>חֲשֹׂף זְרֹעֲךָ בַּקֵּשׁ מִיָּדָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/62"/>מַרְעִית־חֶבְלָךְ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:betulat_bat_yehudah/63"/>אַיֵּה הָעֵדֶר נִתַּן־לָךְ:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
