      <tei:div corresp="urn:x-opensiddur:text:poem:maran_divishmaya/captive">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maran_divishmaya/captive/1"/>מָרָן דְּבִשְׁמַיָא לָךְ מִתְחַנֵּנָן,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maran_divishmaya/captive/2"/>כְּבַר שִׁבְיָא דְמִתְחַנֵּן לִשְׁבוּיֵהּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maran_divishmaya/captive/3"/>כֻּלְּהוֹן בְּנֵי־שִׁבְיָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maran_divishmaya/captive/4"/>בְּכַסְפָּא מִתְפָּרְקִין,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maran_divishmaya/captive/5"/>וְעַמָּךְ יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maran_divishmaya/captive/6"/>בְּרַחֲמֵי וּבְתַחֲנוּנֵי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maran_divishmaya/captive/7"/>הַב־לָן שְׁאֶלְתִּין וּבָעוּתִין,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maran_divishmaya/captive/8"/>דְלָא־נֶהֱדַר רֵיקָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maran_divishmaya/captive/9"/>מִן־קָדָמָךְ:</tei:p>
      </tei:div>
