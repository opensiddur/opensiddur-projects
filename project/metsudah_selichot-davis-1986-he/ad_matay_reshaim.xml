      <tei:div corresp="urn:x-opensiddur:text:prayer:ad_matay_reshaim">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/94/3"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ad_matay_reshaim/1"/>עַד־מָתַי רְשָׁעִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ad_matay_reshaim/2"/>יְהוָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ad_matay_reshaim/3"/>עַד־מָתַי רְשָׁעִים יַעֲלֹזוּ׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/83/4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ad_matay_reshaim/4"/>עַל־עַמְּךָ יַעֲרִימוּ סוֹד.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ad_matay_reshaim/5"/>וְיִתְיָעֲצוּ עַל־צְפוּנֶיךָ׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/79/2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ad_matay_reshaim/6"/>נָתְנוּ אֶת־נִבְלַת עֲבָדֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ad_matay_reshaim/7"/>מַאֲכָל לְעוֹף הַשָּׁמָיִם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ad_matay_reshaim/8"/>בְּשַׂר חֲסִידֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ad_matay_reshaim/9"/>לְחַיְתוֹ־אָרֶץ׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ad_matay_reshaim/10"/>וּפְרִי־בֶטֶן לֹא יְרַחֵמוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ad_matay_reshaim/11"/>עַל־בָּנִים לֹא־תָחוּס עֵינָם׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/69/25"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ad_matay_reshaim/12"/>שְׁפָךְ־עֲלֵיהֶם זַעְמֶךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ad_matay_reshaim/13"/>וַחֲרוֹן אַפְּךָ יַשִּׂיגֵם׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/85/7"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ad_matay_reshaim/14"/>הֲלֹא־אַתָּה תָּשׁוּב תְּחַיֵּנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ad_matay_reshaim/15"/>וְעַמְּךָ יִשְׂמְחוּ־בָךְ׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
