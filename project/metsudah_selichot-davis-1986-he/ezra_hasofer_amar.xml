      <tei:div corresp="urn:x-opensiddur:text:prayer:ezra_hasofer_amar">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/1"/>עֶזְרָא הַסּוֹפֵר אָמַר לְפָנֶֽיךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/2"/>אֱלֹהַי בּֽשְׁתִּי וְנִכְלַֽמְתִּי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/3"/>לְהָרִים אֱלֹהַי פָּנַי אֵלֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/4"/>כִּי עֲוֹנוֹתֵֽינוּ רָֽבוּ לְמַעְלָה רֹאשׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/5"/>וְאַשְׁמָתֵֽנוּ גָדְלָה עַד לַשָּׁמָֽיִם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/6"/>וְאַתָּה אֱלֽוֹהַּ סְלִיחוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/7"/>חַנּוּן וְרַחוּם אֶֽרֶךְ אַפַּֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/8"/>וְרַב חֶֽסֶד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/9"/>וְלֹא עֲזַבְתָּם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/10"/>אַל תַּעַזְבֵֽנוּ אָבִֽינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/11"/>וְאַל תִּטְּשֵֽׁנוּ בּוֹרְאֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/12"/>וְאַל תַּזְנִיחֵֽנוּ יוֹצְרֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/13"/>וְאַל תַּֽעַשׂ עִמָּֽנוּ כָּלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/14"/>כְּחַטֹּאתֵֽינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/15"/>וְקַיֶּם לָֽנוּ יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/16"/>אֶת הַדָּבָר שֶׁהִבְטַחְתָּֽנוּ בְּקַבָּלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/17"/>עַל יְדֵי יִרְמְיָה חוֹזָךְ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/18"/>כָּאָמוּר
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:jeremiah/50/20"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/19"/>בַּיָּמִים הָהֵם וּבָעֵת הַהִיא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/20"/>נְאֻם יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/21"/>יְבֻקַּשׁ אֶת עֲו‍ֹן יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/22"/>וְאֵינֶֽנּוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/23"/>וְאֶת חַטֹּאת יְהוּדָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/24"/>וְלֹא תִמְּצָאֶֽינָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/25"/>כִּי אֶסְלַח
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/26"/>לַאֲשֶׁר אַשְׁאִיר:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/27"/>עַמְּךָ וְנַחֲלָתְךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/28"/>רְעֵבֵי טוּבְךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/29"/>צְמֵאֵי חַסְדֶּֽךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/30"/>תְּאֵבֵי יִשְׁעֶֽךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/31"/>יַכִּֽירוּ וְיֵדְעוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/32"/>כִּי לַיהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezra_hasofer_amar/33"/>הָרַחֲמִים וְהַסְּלִיחוֹת:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
