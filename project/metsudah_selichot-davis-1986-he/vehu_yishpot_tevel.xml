      <tei:div corresp="urn:x-opensiddur:text:prayer:vehu_yishpot_tevel">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_yishpot_tevel/1"/>וְהוּא יִשְׁפֹּט־תֵּבֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_yishpot_tevel/2"/>בְּצֶדֶק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_yishpot_tevel/3"/>וּלְאֻמִּים בְּמֵישָׁרִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_yishpot_tevel/4"/>צֶדֶק וּמִשְׁפָּט
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_yishpot_tevel/5"/>מְכוֹן כִּסְאֶךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_yishpot_tevel/6"/>חֶסֶד וֶאֱמֶת יְקַדְּמוּ פָנֶיךָ׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_yishpot_tevel/7"/>מִלְּפָנֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_yishpot_tevel/8"/>מִשְׁפָּטֵנוּ יֵצֵא,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_yishpot_tevel/9"/>עֵינֶיךָ תֶּחֱזֶינָה מֵישָׁרִים׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_yishpot_tevel/10"/>וְתוֹצִיא כָאוֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_yishpot_tevel/11"/>צִדְקֵנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_yishpot_tevel/12"/>וּמִשְׁפָּטֵנוּ כַּצָּהֳרָיִם׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_yishpot_tevel/13"/>לְמִשְׁפָּטֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_yishpot_tevel/14"/>עָמְדוּ הַיּוֹם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_yishpot_tevel/15"/>כִּי הַכֹּל עֲבָדֶיךָ׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:isaiah/33/22"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_yishpot_tevel/16"/>כִּי יְהוָה שֹׁפְטֵנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_yishpot_tevel/17"/>יְהוָה מְחֹקְקֵנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_yishpot_tevel/18"/>יְהוָה מַלְכֵּנוּ הוּא יוֹשִׁיעֵנוּ׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/94/2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_yishpot_tevel/19"/>הִנָּשֵׂא שֹׁפֵט הָאָרֶץ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_yishpot_tevel/20"/>הָשֵׁב גְּמוּל עַל־גֵּאִים׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:genesis/18/25"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_yishpot_tevel/21"/>חָלִלָה לְּךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_yishpot_tevel/22"/>מֵעֲשֹׂת כַּדָּבָר הַזֶּה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_yishpot_tevel/23"/>לְהָמִית צַדִּיק עִם־רָשָׁע,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_yishpot_tevel/24"/>וְהָיָה כַצַּדִּיק כָּרָשָׁע,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_yishpot_tevel/25"/>חָלִלָה לָּךְ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_yishpot_tevel/26"/>הֲשֹׁפֵט כָּל־הָאָרֶץ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_yishpot_tevel/27"/>לֹא יַעֲשֶׂה מִשְׁפָּט׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
