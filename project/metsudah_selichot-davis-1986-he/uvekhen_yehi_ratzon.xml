      <tei:div corresp="urn:x-opensiddur:text:prayer:uvekhen_yehi_ratzon">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/1"/>וּבְכֵן יְהִי רָצוֹן מִלְפָנֶיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/2"/>יְהֹוָה אֱלֹהֵינוּ וֵאלֹהַי אֲבוֹתֵינוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/3"/>שֶׁתְּהֵא הַשָּׁנָה הַזֹּאת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/4"/>הַבָּאָה עֲלֵינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/5"/>וְעַל־עַמְּךָ בֵּית יִשְׂרָאֵל,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/6"/>קֵץ וְתַכְלִית לִשְׁבִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/7"/>עַמְּךָ בֵית יִשְׂרָאֵל,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/8"/>וְעֵת־סוֹף לְגָלוּתֵנוּ וּלְאֶבְלֵנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/9"/>וְאַחֲרִית־טוֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/10"/>לִימֵי־עָנְיֵנוּ וּמְרוּדֵנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/11"/>כִּי־מָשַׁךְ עָלֵנוּ הַשִּׁעְבּוּד,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/12"/>וְאָרַךְ עָלֵינוּ עֹל־גָּלֻיּוֹת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/13"/>וְהִנְּנוּ בְּכָל־יוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/14"/>הוֹלְכִים וְדַלִּים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/15"/>בִּרְבוֹת הַשָּׁנִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/16"/>אָנוּ נִמְעָטִים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/17"/>וּבִסְגוֹת הַזְּמַנִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/18"/>אָנוּ נִצְעָרִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/19"/>וְאֵין־לָנוּ לֹא־מְנַהֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/20"/>וְלֹא־מַחֲזִיק בְּיָדֵנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/21"/>כַּאֲשֶׁר אָמַרְתָּ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:jeremiah/15/5"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/22"/>כִּי מִי יַחֲמֹל עָלַיִךְ יְרוּשָׁלַיִם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/23"/>וּמִי־יָנוּד־לָךְ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/24"/>וּמִי־יָסוּר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/25"/>לִשְׁאֹל לְשָׁלוֹם לָךְ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/26"/>אוֹ מִי־יִגְדֹּר־גֶּדֶר,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/27"/>אוֹ מִי יַעֲמֹד בַּפֶּרֶץ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/28"/>וְאֵין עוֹד נָבִיא וְחוֹזֶה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/29"/>וְאֵין
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/30"/>קוֹרֵא בְשִׁמְךָ בֶּאֱמֶת,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/31"/>מִתְעוֹרֵר לְהַחֲזִיק־בָּךְ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/32"/>כִּי כֻלָּנוּ כַצֹּאן תָּעִינוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/33"/>אִישׁ אִישׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/34"/>לְדַרְכּוֹ הָרָעָה פָּנִינוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/35"/>כָּל־גֶּבֶר אַחֲרֵי בִּצְעוֹ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/36"/>וְכָל־אִישׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/37"/>אַחֲרֵי שְׁרִירוּת לִבּוֹ הָרָע.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/38"/>וְלֹא דַּי לָנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/39"/>בַּעֲוֹנוֹת הָרִאשׁוֹנִים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/40"/>כִּי־אִם הוֹסַפְנוּ עֲלֵיהֶם חֲדָשִׁים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/41"/>וְלֹא הֻזְהַרְנוּ בְּכָל־הָאַזְהָרוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/42"/>אֲשֶׁר הִזְהַרְתָּנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/43"/>וְלֹא הוּכַחְנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/44"/>מִכָּל הַתּוֹכָחוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/45"/>אֲשֶׁר הוֹכַחְתָנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/46"/>וּמַה־יֶּשׁ־לָנוּ עוֹד צְדָקָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:uvekhen_yehi_ratzon/47"/>וְלִזְעֹק־עוֹד אֶל־הַמֶּלֶךְ:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
