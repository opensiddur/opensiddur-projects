      <tei:div corresp="urn:x-opensiddur:text:poem:elekha_lev_venefesh_nishpokh_kamayim">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/1"/>אֵלֶיךָ לֵב וָנֶפֶשׁ נִשְׁפֹּךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/2"/>כַּמַּיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/3"/>כֻּלָּנוּ אֶל אֵל בַּשָּׁמָיִם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/4"/>אֵתָיוּ זְקֵנִים עִם עוֹלָלֵיכֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/5"/>הִזַּכּוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/6"/>וְהָסִירוּ רֹעַ מַעֲלְלֵיכֶם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/7"/>לְפָנָיו נַרְבֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/8"/>תְּחִנָּה וּבַקָּשָׁה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/9"/>עַל זֹאת מֵאֱלֹהֵינוּ נְבַקְּשָׁה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/10"/>יִרְגַּז הַטּוֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/11"/>עַל מְנֻוָּל.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/12"/>דַּרְכּוֹ יַעֲזֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/13"/>פּוֹשֵׁעַ וְעַוָּל:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/14"/>הֵכִינוּ לֵב וְהֵטִיבוּ מַחֲשָׁבָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/15"/>כִּי גָדוֹל כֹּחַ הַתְּשׁוּבָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/16"/>בִּקְהַל עָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/17"/>מִלִּין נַכְבִּיר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/18"/>וְלֹא יִמְאַס אֵל כַּבִּיר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/19"/>רוֹצֶה תְּשׁוּבַת בּוֹגֵד וְנִשְׁחַת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/20"/>לְהָשִׁיב נַפְשׁוֹ מִנִּי שַׁחַת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/21"/>שְׁמַע תַּחֲנוּן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/22"/>הֵעָתֵר לִמְבַקְשֶׁיךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/23"/>בְּנָשְֹאֵינוּ יָדֵינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/24"/>אֶל־דְּבִיר קָדְשֶׁךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/25"/>יִהְיוּ־נָא אִמְרֵי פִינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/26"/>לְרָצוֹן.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/27"/>וְכַפֵּר עַל־חַטֹּאתֵינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/28"/>אֹנֶס וְרָצוֹן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/29"/>חֲשֹׁב זְכֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/30"/>קְרִיאַת נְעִימֶיךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/31"/>וְהִנָּחֵם עַל הָרָעָה לְעַמֶּךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/32"/>וַעֲשֵֹה חֵפֶץ־עֲבָדֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/33"/>וִישַׁעְשְׁעוּן תַּנְחוּמֶיךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/34"/>סְמוּכִים בְּחַסְדֶּךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_lev_venefesh_nishpokh_kamayim/35"/>וּבְטוּחִים עַל־רַחֲמֶיךָ:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
