      <tei:div corresp="urn:x-opensiddur:text:prayer:ein_lanu_peh">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_lanu_peh/1"/>אֵין לָנוּ פֶּה לְהָשִׁיב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_lanu_peh/2"/>וְלֹא מֵצַח לְהָרִים רֹאשׁ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/49/8"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_lanu_peh/3"/>אָח לֹא־פָדֹה יִפְדֶּה אִישׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_lanu_peh/4"/>לֹא יִתֵּן לֵאלֹהִים כָּפְרוֹ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/25/22"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_lanu_peh/5"/>פְּדֵה אֱלֹהִים אֶת־יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_lanu_peh/6"/>מִכֹּל צָרוֹתָיו:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/69/17"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_lanu_peh/7"/>עֲנֵנוּ יְהוָה כִּי־טוֹב חַסְדֶּךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_lanu_peh/8"/>כְּרֹב רַחֲמֶיךָ פְּנֵה אֵלֵינוּ׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/34/23"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_lanu_peh/9"/>פּוֹדֶה יְהוָה נֶפֶשׁ עֲבָדָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_lanu_peh/10"/>וְלֹא יֶאְשְׁמוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_lanu_peh/11"/>כָּל הַחֹסִים בּוֹ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
