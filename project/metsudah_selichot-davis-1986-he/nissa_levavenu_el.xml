  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:nissa_levavenu_el">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:lamentations/3/41"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:nissa_levavenu_el/1"/>נִשָּׂא לְבָבֵנוּ אֶל כַּפָּיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:nissa_levavenu_el/2"/>אֶל אֵל בַּשָּׁמָיִם:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:nissa_levavenu_el/3"/>עֶזְרֵנוּ מֵעִם יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:nissa_levavenu_el/4"/>עוֹשֵׂה שָׁמַיִם וָאָרֶץ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:nissa_levavenu_el/5"/>אַל יִתֵּן לַמּוֹט רַגְלֵנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:nissa_levavenu_el/6"/>אַל יָנוּם שׁוֹמְרֵנוּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/121/4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:nissa_levavenu_el/7"/>הִנֵּה לֹא יָנוּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:nissa_levavenu_el/8"/>וְלֹא יִישָׁן שׁוֹמֵר יִשְׂרָאֵל:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:nissa_levavenu_el/9"/>הוֹשַׁע יְהֹוָה אֶת עַמְּךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:nissa_levavenu_el/10"/>אֵת שְׁאֵרִית יִשְׂרָאֵל:</tei:p>
      </tei:div>
