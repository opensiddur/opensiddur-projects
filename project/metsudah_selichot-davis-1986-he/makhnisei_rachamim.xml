      <tei:div corresp="urn:x-opensiddur:text:poem:makhnisei_rachamim">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:makhnisei_rachamim/1"/>מַכְנִיסֵי רַחֲמִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:makhnisei_rachamim/2"/>הַכְנִיסוּ רַחֲמֵינוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:makhnisei_rachamim/3"/>לִפְנֵי בַּעַל־הָרַחֲמִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:makhnisei_rachamim/4"/>מַשְׁמִיעֵי תְפִלָּה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:makhnisei_rachamim/5"/>הַשְׁמִיעוּ תְפִלָּתֵנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:makhnisei_rachamim/6"/>לִפְנֵי שׁוֹמֵעַ תְּפִלָּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:makhnisei_rachamim/7"/>מַשְׁמִיעֵי צְעָקָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:makhnisei_rachamim/8"/>הַשְׁמִיעוּ צַעֲקָתֵנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:makhnisei_rachamim/9"/>לִפְנֵי שׁוֹמֵעַ צְעָקָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:makhnisei_rachamim/10"/>מַכְנִיסֵי דִּמְעָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:makhnisei_rachamim/11"/>הַכְנִיסוּ דִמְעוֹתֵינוּ, לִפְנֵי מֶלֶךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:makhnisei_rachamim/12"/>מִתְרַצֶּה בִּדְמָעוֹת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:makhnisei_rachamim/13"/>הִשְׁתַּדְּלוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:makhnisei_rachamim/14"/>וְהַרְבּוּ תְחִנָּה וּבַקָּשָׁה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:makhnisei_rachamim/15"/>לִפְנֵי מֶלֶךְ אֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:makhnisei_rachamim/16"/>רָם וְנִשָּׂא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:makhnisei_rachamim/17"/>הַזְכִּירוּ לְפָנָיו הַשְׁמִיעוּ לְפָנָיו,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:makhnisei_rachamim/18"/>תּוֹרָה וּמַעֲשִׂים־טוֹבִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:makhnisei_rachamim/19"/>שֶׁל שׁוֹכְנֵי־עָפָר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:makhnisei_rachamim/20"/>יִזְכֹּר אַהֲבָתָם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:makhnisei_rachamim/21"/>וִיחַיֶּה זַרְעָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:makhnisei_rachamim/22"/>שֶׁלֹּא תֹאבַד שְׁאֵרִית־יַעֲקֹב:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:makhnisei_rachamim/23"/>כִּי־צֹאן רוֹעֶה־נֶאֱמָן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:makhnisei_rachamim/24"/>הָיָה לְחֶרְפָּה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:makhnisei_rachamim/25"/>יִשְׂרָאֵל גּוֹי־אֶחָד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:makhnisei_rachamim/26"/>לְמָשָׁל וְלִשְׁנִינָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:makhnisei_rachamim/27"/>מַהֵר עֲנֵנוּ אֱלֹהֵי יִשְׁעֵנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:makhnisei_rachamim/28"/>וּפְדֵנוּ מִכָּל־גְּזֵרוֹת קָשׁוֹת,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:makhnisei_rachamim/29"/>וְהוֹשִׁיעָה בְּרַחֲמֶיךָ הָרַבִּים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:makhnisei_rachamim/30"/>מְשִׁיחַ צִדְקָךְ וְעַמָּךְ:</tei:p>
      </tei:div>
    </tei:body>
