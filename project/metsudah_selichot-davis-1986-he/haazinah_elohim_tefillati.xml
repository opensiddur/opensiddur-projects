    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:haazinah_elohim_tefillati">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/55/2"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_elohim_tefillati/1"/>הַאֲזִינָה אֱלֹהִים תְּפִלָּתִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_elohim_tefillati/2"/>וְאַל־תִּתְעַלַּם מִתְּחִנָּתִי:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_elohim_tefillati/3"/>תִּכּוֹן תְּפִלָּתֵנוֹּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_elohim_tefillati/4"/>קְטֹרֶת לְפָנֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_elohim_tefillati/5"/>מַשְׂאַת כַּפֵּינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_elohim_tefillati/6"/>מִנְחַת־עָרֶב:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_elohim_tefillati/7"/>הַאֲזִינָה יְהוָה תְּפִלָּתֵנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_elohim_tefillati/8"/>הַקְשִׁיבָה לְקוֹל תַּחֲנוּנֵינוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_elohim_tefillati/9"/>הַקְשִׁיבָה לְקוֹל שַׁוְעָתֵנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_elohim_tefillati/10"/>מַלְכֵּנוּ וֵאלֹהֵינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_elohim_tefillati/11"/>כִּי־אֵלֶיךָ נִתְפַּלָּל:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:ezra/9/15"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_elohim_tefillati/12"/>יְהוָה אֱלֹהֵי יִשְׂרָאֵל צַדִּיק אַתָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_elohim_tefillati/13"/>כִּי־נִשְׁאַרְנוּ פְלֵיטָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_elohim_tefillati/14"/>כְּהַיּוֹם הַזֶּה:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
