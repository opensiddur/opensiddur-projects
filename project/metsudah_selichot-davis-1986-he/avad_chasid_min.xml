  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:avad_chasid_min">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:micah/7/2"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:avad_chasid_min/1"/>אָבַד חָסִיד מִן הָאָרֶץ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:avad_chasid_min/2"/>וְיָשָׁר בָּאָדָם אָיִן:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:avad_chasid_min/3"/>אֵין־קוֹרֵא בְשִׁמְךָ בְּצֶדֶק,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:avad_chasid_min/4"/>מִתְעוֹרֵר לְהַחֲזִיק בָּךְ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/12/2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:avad_chasid_min/5"/>הוֹשִׁיעָה יְהוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:avad_chasid_min/6"/>כִּי־גָמַר חָסִיד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:avad_chasid_min/7"/>כִּי־פַסּוּ אֱמוּנִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:avad_chasid_min/8"/>מִבְּנֵי אָדָם:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/36/10"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:avad_chasid_min/9"/>כִּי־עִמְּךָ מְקוֹר חַיִּים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:avad_chasid_min/10"/>בְּאוֹרְךָ נִרְאֶה־אוֹר׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:avad_chasid_min/11"/>כִּי־עִם־יְהוָה הַחֶסֶד,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:avad_chasid_min/12"/>וְהַרְבֵּה עִמּוֹ פְדוּת׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/130/8"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:avad_chasid_min/13"/>וְהוּא יִפְדֶּה אֶת־יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:avad_chasid_min/14"/>מִכֹּל עֲוֺנֹתָיו׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
