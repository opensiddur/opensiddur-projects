    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:al_tizkar_lanu">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/79/8"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/1"/>אַל תִּזְכָּר לָנוּ עֲו‍ֹנוֹת רִאשׁוֹנִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/2"/>מַהֵר יְקַדְּמוּנוּ רַחֲמֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/3"/>כִּי דַלּוֹנוּ מְאֹד:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:al_tizkar_lanu/selichot_tzom_gedaliah"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/8"/>כִּי־שֹׁמֵעַ אֶל־אֶבְיוֹנִים יְהוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/9"/>וְאֶת־אֲסִירָיו לֹא בָזָה׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/10"/>כִּי כָלוּ בְיָגוֹן חַיֵּינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/11"/>וּשְׁנוֹתֵינוּ בַּאֲנָחָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/12"/>כִּי־עָלֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/13"/>הֹרַגְנוּ כָל־הַיּוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/14"/>נֶחְשַׁבְנוּ כְּצֹאן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/15"/>טִבְחָה׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/16"/>כִּי לֹא יִזְנַח לְעוֹלָם אֲדֹנָי:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:al_tizkar_lanu/selichot_tzom_gedaliah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/4"/>חַטֹּאת נְעוּרֵינוּ וְפְשָׁעֵינוּ
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:al_tizkar_lanu/selichot_tzom_gedaliah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/5"/>אַל תִּזְכֹּר
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:al_tizkar_lanu/selichot_tzom_gedaliah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/6"/>כְּחַסְדְּךָ זְכָר לָנוּ אַתָּה
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:al_tizkar_lanu/selichot_tzom_gedaliah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_tizkar_lanu/7"/>לְמַעַן טוּבְךָ יְהֹוָה
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_5"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
