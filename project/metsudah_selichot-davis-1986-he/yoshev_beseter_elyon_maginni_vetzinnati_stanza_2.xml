      <tei:div corresp="urn:x-opensiddur:text:poem:yoshev_beseter_elyon_maginni_vetzinnati/stanza_2">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_2/1"/>צְדָקָה עֲשֵׁה לְעַמֶּךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_2/2"/>קָדוֹשׁ לְמַעַן שְׁמֶךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_2/3"/>כִּי פַּסּוּ תְּמִימֶיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_2/4"/>מַעֲבִירֵי זַעֲמֶיךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_2/5"/>וּמַגִּישֵׁי לַחְמֶךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_2/6"/>לָכֵן עַתָּה בָאתִי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_2/7"/>נַפְשִׁי בִּשְׁאֵלָתִי,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_2/8"/>וְעַמִּי בְּבַקָּשָׁתִי:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
