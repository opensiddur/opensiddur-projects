      <tei:div corresp="urn:x-opensiddur:text:prayer:zekhor_lanu_berit_rishonim">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_lanu_berit_rishonim/1"/>זְכוֹר לָֽנוּ בְּרִית רִאשׁוֹנִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_lanu_berit_rishonim/2"/>כַּאֲשֶׁר אָמַֽרְתָּ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:leviticus/26/45"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_lanu_berit_rishonim/3"/>וְזָכַרְתִּי לָהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_lanu_berit_rishonim/4"/>בְּרִית רִאשׁוֹנִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_lanu_berit_rishonim/5"/>אֲשֶׁר הוֹצֵֽאתִי אוֹתָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_lanu_berit_rishonim/6"/>מֵאֶֽרֶץ מִצְרַֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_lanu_berit_rishonim/7"/>לְעֵינֵי הַגּוֹיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_lanu_berit_rishonim/8"/>לִהְיוֹת לָהֶם לֵאלֹהִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_lanu_berit_rishonim/9"/>אֲנִי יְהֹוָה:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:zekhor_lanu_berit_rishonim/selichot_erev_rosh_hashanah"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_lanu_berit_rishonim/93"/>תֻּשְׂגַּב לְבַדְּךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_lanu_berit_rishonim/94"/>וְתִמְלֹךְ עַל כֹּל בְּיִחוּד:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_lanu_berit_rishonim/95"/>כַּכָּתוּב עַל יַד נְבִיאֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_lanu_berit_rishonim/96"/>וְהָיָה יְהֹוָה לְמֶֽלֶךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_lanu_berit_rishonim/97"/>עַל כָּל הָאָֽרֶץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_lanu_berit_rishonim/98"/>בַּיּוֹם הַהוּא יִהְיֶה יְהֹוָה אֶחָד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_lanu_berit_rishonim/99"/>וּשְׁמוֹ אֶחָד:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/></tei:p>
