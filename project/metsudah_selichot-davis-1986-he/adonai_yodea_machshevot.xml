      <tei:div corresp="urn:x-opensiddur:text:prayer:adonai_yodea_machshevot">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/94/11"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_yodea_machshevot/1"/>יְהוָה יֹדֵעַ מַחְשְׁבוֹת אָדָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_yodea_machshevot/2"/>כִּי־הֵמָּה הָבֶל׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_yodea_machshevot/3"/>תְּהִי נָא אָזְנְךָ קַשֶֽׁבֶת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_yodea_machshevot/4"/>וְעֵינֶֽיךָ פְּקוּחוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_yodea_machshevot/5"/>אֶל תְּפִלַּת עַמְּךָ יִשְׂרָאֵל:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:kings_1/8/50"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_yodea_machshevot/6"/>וְסָלַחְתָּ לְעַמְּךָ אֲשֶׁר חָטְאוּ־לָךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_yodea_machshevot/7"/>וּלְכָל־פִּשְׁעֵיהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_yodea_machshevot/8"/>אֲשֶׁר פָּשְׁעוּ־בָךְ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_yodea_machshevot/9"/>תִּתֵּן אֱמֶת לְיַעֲקֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_yodea_machshevot/10"/>חֶֽסֶד לְאַבְרָהָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_yodea_machshevot/11"/>אשֶׁר נִשְׁבַּֽעְתָּ לַאֲבוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_yodea_machshevot/12"/>מִימֵי קֶֽדֶם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_yodea_machshevot/13"/>יְהֹוָה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_yodea_machshevot/14"/>אֵל רַחוּם וְחַנּוּן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_yodea_machshevot/15"/>אֶֽרֶךְ אַפַּֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_yodea_machshevot/16"/>וְרַב חֶֽסֶד וֶֽאֱמֶת:</tei:p>
      </tei:div>
