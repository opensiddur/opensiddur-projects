      <tei:div corresp="urn:x-opensiddur:text:poem:maran_divishmaya/slave">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maran_divishmaya/slave/1"/>מָרָן דְבִשְׁמַיָא לָךְ מִתְחַנֵּנָן,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maran_divishmaya/slave/2"/>כְּעַבְדָּא דְּמִתְחַנֵּן לְמָרֵיהּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maran_divishmaya/slave/3"/>עֲשִׁיקֵי אֲנַן וּבַחֲשׁוֹכָא שָׁרִינָן.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maran_divishmaya/slave/4"/>מְרִירָן נַפְשִׁין
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maran_divishmaya/slave/5"/>מֵעַקְתִין דִּנְפִישִׁין:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maran_divishmaya/slave/6"/>חֵילָא לֵית־בָּן לְרַצוּיָךְ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maran_divishmaya/slave/7"/>מָרָן. עֲבִיד בְּדִיל קַיָּמָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:maran_divishmaya/slave/8"/>דִגְזַרְתְּ עִם־אֲבְהָתָנָא:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
