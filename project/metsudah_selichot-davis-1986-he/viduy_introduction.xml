    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:viduy/introduction">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/1"/>אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/2"/>תָּבֹא לְפָנֶֽיךָ תְּפִלָּתֵֽנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/3"/>וְאַל תִּתְעַלַּם מִתְּחִנָּתֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/4"/>שֶׁאֵין אֲנַֽחְנוּ עַזֵּי פָנִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/5"/>וּקְשֵׁי עֹֽרֶף
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/6"/>לוֹמַר לְפָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/7"/>יְהֹוָה אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/8"/>צַדִּיקִים אֲנַֽחְנוּ וְלֹא חָטָֽאנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/9"/>אֲבָל אֲנַֽחְנוּ וַאֲבוֹתֵֽינוּ חָטָֽאנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/10"/>אָשַֽׁמְנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/11"/>בָּגַֽדְנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/12"/>גָּזַֽלְנוּ. דִּבַּֽרְנוּ דֹּֽפִי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/13"/>הֶעֱוִֽינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/14"/>וְהִרְשַֽׁעְנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/15"/>זַֽדְנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/16"/>חָמַֽסְנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/17"/>טָפַֽלְנוּ שֶֽׁקֶר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/18"/>יָעַֽצְנוּ רָע.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/19"/>כִּזַּֽבְנוּ. לַֽצְנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/20"/>מָרַֽדְנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/21"/>נִאַֽצְנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/22"/>סָרַֽרְנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/23"/>עָוִֽינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/24"/>פָּשַֽׁעְנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/25"/>צָרַֽרְנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/26"/>קִשִּֽׁינוּ עֹֽרֶף.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/27"/>רָשַֽׁעְנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/28"/>שִׁחַֽתְנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/29"/>תִּעַֽבְנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/30"/>תָּעִֽינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/31"/>תִּעְתָּֽעְנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/32"/>סַֽרְנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/33"/>מִמִּצְוֹתֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/34"/>וּמִמִּשְׁפָּטֶֽיךָ הַטּוֹבִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/35"/>וְלֹא שָֽׁוָה לָֽנוּ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:nehemiah/9/33"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/36"/>וְאַתָּה צַדִּיק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/37"/>עַל כָּל הַבָּא עָלֵֽינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/38"/>כִּי אֱמֶת עָשִֽׂיתָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:viduy/introduction/39"/>וַאֲנַֽחְנוּ הִרְשָֽׁעְנוּ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
