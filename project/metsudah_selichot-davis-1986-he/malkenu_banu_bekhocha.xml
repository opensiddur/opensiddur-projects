      <tei:div corresp="urn:x-opensiddur:text:prayer:malkenu_banu_bekhocha">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/1"/>מַלְכֵּנוּ בָּאנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/2"/>בְּכֹחַ יִחוּדֶךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/3"/>כִּי־אֵין לָנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/4"/>בַּמֶּה לְקַדְּמֶךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/5"/>כִּי אִם מַלְכוּתְךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/6"/>וּמַעְבָּדֶיךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/7"/>לָכֵן בְּכָל לֵב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/8"/>נְיַחֲדֶךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/9"/>נְיַחֲדֶךָ יַחַד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/10"/>גְּדוֹלֵינוּ וּקְטַנֵּינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/11"/>מְחָק נָא שְׁטָרֵי חוֹבוֹתֵינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/12"/>וּכְתֹב בְּסֵפֶר הַחַיִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/13"/>זִכְרוֹנֵנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/14"/>וְתִגְזֹר עַתָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/15"/>לְהֵיטִיב שְׁנוֹתֵינוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/16"/>שְׁמַע יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/17"/>יְהֹוָה אֱלֹהֵינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/18"/>יְהֹוָה אֶחָד:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/19"/>סְגֻלָּה אֲשֶׁר־פָּדִיתָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/20"/>בְּמַסּוֹת בְּאוֹתוֹת וּבְנִסִּים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/21"/>בְּשִׁמְךָ חוֹסִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/22"/>וְעַל־שְׁמַע פּוֹרְסִים.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/20/8"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/23"/>אֵלֶּה בָרֶכֶב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/24"/>וְאֵלֶּה בַסּוּסִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/25"/>וַאֲנַחְנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/26"/>בְּשֵׁם־יְהֹוָה אֱלֹהֵינוּ עוֹמְסִים:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/27"/>עוֹמְסִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/28"/>בְּיִרְאָה וּבְפַחַד וּבְרַעַד.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/29"/>לְעוֹדְדָם מֵאֻמּוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/30"/>וּלְהַסְעַד.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/31"/>כְּמוֹ בְּדִבְרֵי קָדְשְׁךָ מוּעַד.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/20/9"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/32"/>הֵמַּה כָּרְעוּ וְנָפָלוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:malkenu_banu_bekhocha/33"/>וַאֲנַחְנוּ קַמְנוּ וַנִּתְעוֹדָד:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
