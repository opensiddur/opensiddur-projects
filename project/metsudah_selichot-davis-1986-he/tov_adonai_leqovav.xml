      <tei:div corresp="urn:x-opensiddur:text:prayer:tov_adonai_leqovav">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tov_adonai_leqovav/1"/>טוֹב יְהֹוָה לְקֹוָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tov_adonai_leqovav/2"/>לְנֶפֶשׁ תִּדְרְשֶׁנּוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tov_adonai_leqovav/3"/>כָּל הַיּוֹם כְּלִמָּתֵנוּ נֶגְדֵּנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tov_adonai_leqovav/4"/>וּבוֹשֶׁת פָּנֵינוּ כִּסָּתְנוּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/44/23"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tov_adonai_leqovav/5"/>כִּי עָלֶיךָ הוֹרַגְנוּ כָּל הַיּוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tov_adonai_leqovav/6"/>נֶחְשַׁבְנוּ כְּצֹאן טִבְחָה:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/44/19"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tov_adonai_leqovav/7"/>לֹא נָסוֹג אָחוֹר לִבֵּנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tov_adonai_leqovav/8"/>וַתֵּט אֲשׁוּרֵינוּ מִנִּי אָרְחֶךָ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/9/13"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tov_adonai_leqovav/9"/>כִּי דוֹרֵשׁ דָּמִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tov_adonai_leqovav/10"/>אוֹתָם זָכָר,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tov_adonai_leqovav/11"/>לֹא שָׁכַח צַעֲקַת עֲנָוִים:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
