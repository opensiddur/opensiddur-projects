    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hirshanu_ufashanu_lakhen">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hirshanu_ufashanu_lakhen/1"/>הִרְשַֽׁעְנוּ וּפָשַֽׁעְנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hirshanu_ufashanu_lakhen/2"/>לָכֵן לֹא נוֹשָֽׁעְנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hirshanu_ufashanu_lakhen/3"/>וְתֵן בְּלִבֵּֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hirshanu_ufashanu_lakhen/4"/>לַעֲזוֹב דֶּֽרֶךְ רֶֽשַׁע,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hirshanu_ufashanu_lakhen/5"/>וְחִישׁ לָֽנוּ יֶֽשַׁע,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hirshanu_ufashanu_lakhen/6"/>כַּכָּתוּב עַל יַד נְבִיאֶֽךָ
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:isaiah/55/7"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hirshanu_ufashanu_lakhen/7"/>יַעֲזוֹב רָשָׁע דַרְכּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hirshanu_ufashanu_lakhen/8"/>וְאִישׁ אָֽוֶן מַחְשְׁבוֹתָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hirshanu_ufashanu_lakhen/9"/>וְיָשׁוֹב אֶל יְהוָֹה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hirshanu_ufashanu_lakhen/10"/>וִירַחֲמֵֽהוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hirshanu_ufashanu_lakhen/11"/>וְאֶל אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hirshanu_ufashanu_lakhen/12"/>כִּי יַרְבֶּה לִסְלֽוֹחַ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
