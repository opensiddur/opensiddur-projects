      <tei:div corresp="urn:x-opensiddur:text:prayer:dirshu_adonai_behimmatzo_qerauhu_bihyoto_qarov">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:isaiah/55/6"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu_bihyoto_qarov/1"/>דִּרְשׁוּ יְהוָה בְּהִמָּצְאוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu_bihyoto_qarov/2"/>קְרָאֻהוּ בִּהְיוֹתוֹ קָרוֹב׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu_bihyoto_qarov/3"/>קָרוֹב יְהוָה לְכָל־קֹרְאָיו,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu_bihyoto_qarov/4"/>לְכֹל אֲשֶׁר יִקְרָאֻהוּ בֶאֱמֶת׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/34/19"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu_bihyoto_qarov/5"/>קָרוֹב יְהוָה לְנִשְׁבְּרֵי־לֵב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu_bihyoto_qarov/6"/>וְאֶת־דַּכְּאֵי־רוּחַ יוֹשִׁיעַ׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:deuteronomy/4/7"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu_bihyoto_qarov/7"/>כִּי מִי־גוֹי גָּדוֹל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu_bihyoto_qarov/8"/>אֲשֶׁר־לוֹ אֱלֹהִים קְרֹבִים אֵלָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu_bihyoto_qarov/9"/>כַּיהוָה אֱלֹהֵינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu_bihyoto_qarov/10"/>בְּכָּל־קָרְאֵנוּ אֵלָיו׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu_bihyoto_qarov/11"/>לְמַעַנְךָ אֱלֹהֵינוּ עֲשֵׂה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu_bihyoto_qarov/12"/>וְלֹא לָנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu_bihyoto_qarov/13"/>רְאֵה עֲמִידָתֵֽנוּ דַּלִּים וְרֵקִים:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
