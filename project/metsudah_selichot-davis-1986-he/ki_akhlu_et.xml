  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:ki_akhlu_et">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/79/7"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_akhlu_et/1"/>כִּי אָכְלוּ אֶת־יַעֲקֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_akhlu_et/2"/>וְאֶת־נָוֵהוּ הֵשַׁמּוּ׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_akhlu_et/3"/>אָהֳלֵי אֱדוֹם וְיִשְׁמְעֵאלִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_akhlu_et/4"/>מוֹאָב וְהַגְרִים׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_akhlu_et/5"/>כִּי־שָׂבְעָה בְרָעוֹת נַפְשֵׁנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_akhlu_et/6"/>וְחַיֵּינוּ לִשְׁאוֹל הִגִּיעוּ׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_akhlu_et/7"/>וְאַתָּה מַלְכֵּנוּ מִקֶּדֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_akhlu_et/8"/>פֹּעֵל יְשׁוּעוֹת בְּקֶרֶב הָאָרֶץ׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_akhlu_et/9"/>וְהוֹצֵא כָאוֹר צִדְקֵנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_akhlu_et/10"/>וּמִשְׁפְּטֵנוּ כַּצָּהֳרָיִם׃</tei:p>
      </tei:div>
