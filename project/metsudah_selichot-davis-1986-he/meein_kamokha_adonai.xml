      <tei:div corresp="urn:x-opensiddur:text:prayer:meein_kamokha_adonai">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_kamokha_adonai/1"/>מֵאֵין כָּמוֹךָ יְהוָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_kamokha_adonai/2"/>גָּדוֹל אַתָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_kamokha_adonai/3"/>וְגָדוֹל שִׁמְךָ בִּגְבוּרָה:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/76/2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_kamokha_adonai/4"/>נוֹדָע בִּיהוּדָה אֱלֹהִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_kamokha_adonai/5"/>בְּיִשְׂרָאֵל גָּדוֹל שְׁמוֹ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_kamokha_adonai/6"/>עָזְרֵנוּ יְהוָה אֱלֹהֵינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_kamokha_adonai/7"/>כִּי־עָלֶיךָ נִשְׁעַנּוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_kamokha_adonai/8"/>וּבְשִׁמְךָ בָאנוּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/48/11"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_kamokha_adonai/9"/>כְּשִׁמְךָ אֱלֹהִים כֵּן תְּהִלָּתְךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_kamokha_adonai/10"/>עַל־קַצְוֵי־אֶרֶץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_kamokha_adonai/11"/>צֶדֶק מָלְאָה יְמִינֶךָ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/18/10"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_kamokha_adonai/12"/>מִגְדַּל עֹז שֵׁם יְהוָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:meein_kamokha_adonai/13"/>בּוֹ יָרוּץ צַדִּיק וְנִשְׂגָּב:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
