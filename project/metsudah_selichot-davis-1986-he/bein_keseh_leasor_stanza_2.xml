      <tei:div corresp="urn:x-opensiddur:text:poem:bein_keseh_leasor/stanza_2">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_2/1"/>אָדוֹן עִמְּךָ סְלִיחָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_2/2"/>סְלַח וּמְחַל לְשָׁבֶיךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_2/3"/>לְעֵת חִתּוּם גְּזַר דִּינֶךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_2/4"/>לְטוֹבָה זָכְרָה אֲהוּבֶיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_2/5"/>יִוָּדַע כִּי אֱלֹהִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_2/6"/>בִּישֻׁרוּן קְרוֹבֶיךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_2/7"/>וְשִֹימֵנוּ כַּחוֹתָם עַל־לִבֶּךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_2/8"/>בֵּין כֶּסֶה לֶעָשׂוֹר</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
