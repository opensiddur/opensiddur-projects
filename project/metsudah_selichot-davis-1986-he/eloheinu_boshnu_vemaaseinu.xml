    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:eloheinu_boshnu_vemaaseinu">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eloheinu_boshnu_vemaaseinu/1"/>אֱלֹהֵינוּ בּוֹשְׁנוּ בְמַעֲשֵׂינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eloheinu_boshnu_vemaaseinu/2"/>וְנִכְלַמְנוּ בַּעֲוֹנֵינוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eloheinu_boshnu_vemaaseinu/3"/>אֱלֹהֵינוּ בּוֹשְׁנוּ וְנִכְלַמְנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eloheinu_boshnu_vemaaseinu/4"/>לֶהָרִים אֱלֹהֵינוּ פָּנֵינוּ אֵלֶיךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eloheinu_boshnu_vemaaseinu/5"/>לֹא כַחֲטָאֵינוּ תַּעֲשֶׂה לָנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eloheinu_boshnu_vemaaseinu/6"/>וְלֹא כַעֲוֹנֹתֵינוּ תִּגְמוֹל עָלֵינוּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/130/3"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eloheinu_boshnu_vemaaseinu/7"/>אִם עֲוֹנוֹת תִּשְׁמָר יָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eloheinu_boshnu_vemaaseinu/8"/>אֲדֹנָי מִי יַעֲמוֹד:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eloheinu_boshnu_vemaaseinu/9"/>כִּי עִמְּךָ הַסְּלִיחָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eloheinu_boshnu_vemaaseinu/10"/>לְמַעַן תִּוָּרֵא:</tei:p>
      </tei:div>
