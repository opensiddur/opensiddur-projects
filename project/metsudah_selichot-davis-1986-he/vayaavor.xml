  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:vayaavor">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/34/6"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/1"/>וַיַּעֲבֹר יְהֺוָה עַל פָּנָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/2"/>וַיִּקְרָא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/3"/>יְהֺוָה יְהֺוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/4"/>אֵל רַחוּם וְחַנּוּן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/5"/>אֶֽרֶךְ אַפַּֽיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/6"/>וְרַב־חֶֽסֶד וֶאֱמֶת:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/34/7"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/7"/>נֹצֵר חֶֽסֶד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/8"/>לָאֲלָפִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/9"/>נֹשֵׂא עָוֹן וָפֶֽשַׁע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/10"/>וְחַטָּאָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/11"/>וְנַקֵּה:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/12"/>וְסָלַחְתָּ לַעֲוֺנֵֽנוּ וּלְחַטָּאתֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/13"/>וּנְחַלְתָּֽנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/14"/>סְלַח־לָֽנוּ אָבִֽינוּ כִּי־חָטָֽאנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/15"/>מְחַל־לָֽנוּ מַלְכֵּֽנוּ כִּי־פָשָֽׁעְנוּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/86/5"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/16"/>כִּי־אַתָּה אֲדֺנָי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/17"/>טוֹב וְסַלָּח
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/18"/>וְרַב־חֶֽסֶד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaavor/19"/>לְכָל־קוֹרְאֶֽיךָ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
