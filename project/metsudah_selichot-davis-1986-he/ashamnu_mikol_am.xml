      <tei:div corresp="urn:x-opensiddur:text:poem:ashamnu_mikol_am">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu_mikol_am/1"/>אָשַׁמְנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu_mikol_am/2"/>מִכָּל־עָם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu_mikol_am/3"/>בֹּשְׁנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu_mikol_am/4"/>מִכָּל־דּוֹר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu_mikol_am/5"/>גָּלָה מִמֶּנּוּ מָשׂוֹשׂ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu_mikol_am/6"/>דָּוֶה לִבֵּנוּ בַּחֲטָאֵינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu_mikol_am/7"/>הֻחְבַּל אִוּוּיֵנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu_mikol_am/8"/>וְנִפְרַע פְּאֵרֵנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu_mikol_am/9"/>זְבוּל בֵּית־מִקְדָּשֵׁנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu_mikol_am/10"/>חָרַב בַּעֲוֹנֵינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu_mikol_am/11"/>טִירָתֵנוּ הָיְתָה לְשַׁמָּה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu_mikol_am/12"/>יֹפִי אַדְמָתֵנוּ לְזָרִים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu_mikol_am/13"/>כֹּחֵנוּ לְנָכְרִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu_mikol_am/14"/>וַעֲדַיִן לֹא שַׁבְנוּ מִטָּעוּתֵנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu_mikol_am/15"/>וְהֵאֵיךְ נָעִיז פָּנֵינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu_mikol_am/16"/>וְנַקְשֶׁה עָרְפֵּנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu_mikol_am/17"/>לוֹמַר לְפָנֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu_mikol_am/18"/>יְהֹוָה אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu_mikol_am/19"/>צַדִּיקִים אֲנַחְנוּ וְלֹא חָטָאנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ashamnu_mikol_am/20"/>אֲבָל אֲנַחְנוּ וַאֲבוֹתֵינוּ חָטָאנוּ:</tei:p>
      </tei:div>
