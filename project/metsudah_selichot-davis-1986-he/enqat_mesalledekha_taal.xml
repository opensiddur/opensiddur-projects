    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:enqat_mesalledekha_taal">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/1"/>אֶנְקַת מְסַלְּדֶיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/2"/>תַּעַל לִפְנֵי כִסֵּא כְבוֹדֶךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/3"/>מַלֵּא מִשְׁאֲלוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/4"/>עַם מְיַחֲדֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/5"/>שׁוֹמֵעַ תְּפִלַּת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/6"/>בָּאֵי עָדֶיךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/7"/>סְלָחָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/8"/>מִבּוֹא בַמִּשְׁפָּט,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/9"/>עַל עִנּוּי וְעַל־עִוּוּת מִשְׁפָּט.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/10"/>כִּי אִם לְפִי מִשְׁפָּט,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/11"/>מִי יִצְדַּק לְפָנֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/12"/>אֱלֹהֵי הַמִּשְׁפָּט:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/13"/>יְדֵי עַם הַדְּחוּיִים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/14"/>תֶּחֱזַקְנָה כְּאָז
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/15"/>הֱיוֹת־לְךָ אֲחוּיִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/16"/>כִּי אִם לְפִי רְאוּיִים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/17"/>מַה יִּתְרוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/18"/>שֶׁהֵם חַיִּים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/19"/>לְךָ בְּהִתְחַנְּנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/20"/>בְּמוֹ פִי,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/21"/>קַבְּלֵנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/22"/>כִּבְמִכְלַל יֹפִי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/23"/>כִּי אִם לְפִי דֹפִי,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/24"/>הֵן־אֲנִי יָדִי שַׂמְתִּי לְמוֹ־פִי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/25"/>נָאוֹר,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/26"/>כְּרַב־חֶסֶד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/27"/>עִמָּנוּ תִפְעַל,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/28"/>וְלֹא תְשַׁלֵּם לָנוּ כְּמִפְעַל.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/29"/>כִּי אִם לְפִי פֹּעַל.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/30"/>מִי יֹאמַר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/31"/>זִכִּיתִי לִבִּי מִמַּעַל.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/32"/>וְאִם הֵמַרְנוּ אֹמֶר,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/33"/>שְׁעֵה וְקַבֵּל זֶמֶר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/34"/>כִּי אִם לְפִי מֶמֶר,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/35"/>מַה יַעֲשׂוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/36"/>שׁוֹכְנֵי בַתֵּי חֹמֶר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/37"/>בְּרַחֲמִים וְלֹא בְכַעַס,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/38"/>הַיּוֹם וּבְכָל־יוֹם תַּעַשׂ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/39"/>כִּי אִם לְפִי מַעַשׂ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:enqat_mesalledekha_taal/40"/>וַאֲנַחְנוּ לֹא־נֵדַע מַה־נַּעַשׂ:</tei:p>
      </tei:div>
    </tei:body>
