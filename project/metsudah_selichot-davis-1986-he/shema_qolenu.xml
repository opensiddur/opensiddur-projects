      <tei:div corresp="urn:x-opensiddur:text:prayer:shema_qolenu">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_qolenu/1"/>שְׁמַע קוֹלֵֽנוּ יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_qolenu/2"/>חוּס וְרַחֵם עָלֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_qolenu/3"/>וְקַבֵּל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_qolenu/4"/>בְּרַחֲמִים וּבְרָצוֹן אֶת תְּפִלָּתֵֽנוּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:lamentations/5/21"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_qolenu/5"/>הֲשִׁיבֵֽנוּ יְהֹוָה אֵלֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_qolenu/6"/>וְנָשֽׁוּבָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_qolenu/7"/>חַדֵּשׁ יָמֵֽינוּ כְּקֶֽדֶם:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/51/13"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_qolenu/8"/>אַל תַּשְׁלִיכֵֽנוּ מִלְּפָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_qolenu/9"/>וְרֽוּחַ קָדְשְׁךָ אַל תִּקַּח מִמֶּֽנּוּ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_qolenu/10"/>אַל תַּשְׁלִיכֵֽנוּ לְעֵת זִקְנָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_qolenu/11"/>כִּכְלוֹת כֹּחֵֽנוּ אַל תַּעַזְבֵֽנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_qolenu/12"/>אַל תַּעַזְבֵֽנוּ יְהֹוָה אֱלֹהֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_qolenu/13"/>אַל תִּרְחַק מִמֶּֽנּוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_qolenu/14"/>עֲשֵׂה עִמָּֽנוּ אוֹת לְטוֹבָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_qolenu/15"/>וְיִרְאוּ שׂוֹנְאֵֽינוּ וְיֵבֽשׁוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_qolenu/16"/>כִּי אַתָּה יְהֹוָה עֲזַרְתָּֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shema_qolenu/17"/>וְנִחַמְתָּֽנוּ:</tei:p>
      </tei:div>
