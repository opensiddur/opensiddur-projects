      <tei:div corresp="urn:x-opensiddur:text:poem:adon_din_im_yiddeqen">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/1"/>אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/2"/>אָדוֹן דִּין אִם יְדֻקְדַּק.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/3"/>בְּחֵקֶר פֹּעַל אִם יֻבְדַּק.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/4"/>גֶּבֶר לְפָנֶיךָ לֹא יִצְדַּק:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/5"/>דֹּפִי תִּתֵּן בִּצְבָא מַעְלָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/6"/>הֵן בְּמַלְאָכֶיךָ תָּשִֹים תָּהֳלָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/7"/>וְאַף שׁוֹתֶה כַּמַּיִם עַוְלָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/8"/>זְכוּת וּצְדָקָה אֵין בָּנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/9"/>חֵטְא וְרֶשַׁע כֻּלָּנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/10"/>טוֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/11"/>אַל־תָּבֹא בְּמִשְׁפָּט עִמָּנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/12"/>יֶהֱמוּ מֵעֶיךָ עָלֵינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/13"/>כְּרוֹב רַחֲמֶיךָ פְּנֵה אֵלֵינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/14"/>לְבִלְתִּי כְּרֹעַ מַעֲלָלֵינוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/15"/>מְשׁוּבוֹתֵינוּ רַבּוּ מִלִּמְנוֹת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/16"/>נִיחוֹחִים אַיִן וְקָרְבָּנוֹת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/17"/>סְלִיחָה מְצֹא לַעֲוֹנוֹת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/18"/>עַל־צִדְקוֹתֵינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/19"/>אֵין אָנוּ סְמוּכִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/20"/>פֶּשַׁע וְעָווֹן מְלֻכְלָכִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/21"/>צְדָקָה מְצֹא תַּחַן עוֹרְכִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/22"/>קַו אַל־תִּמְתַּח בְּאוֹרְחוֹתֵינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/23"/>רִמָּה וְתוֹלֵעָה אַחֲרִיתֵנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/24"/>שָׁוְא וְהֶבֶל שְׁנוֹתֵינוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/25"/>תָּשׁוּב עַל־הָרָעָה תִּנָּחֵם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/26"/>זֶה דַרְכְּךָ חִנָּם מְרַחֵם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/27"/>בְּרַחֲמֶיךָ הָרַבִּים עָלֵינוּ רַחֵם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/28"/>דְּרָכֶיךָ הוֹדַעְתָּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/29"/>לֶעָנָו לְהוֹרוֹת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/30"/>יִדַּעְתּוֹ שְׁלֹשׁ עֶשְֹרֵה סְדוּרוֹת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/31"/>הִבְטַחְתּוֹ שֶׁאֵין רֵיקָם חוֹזְרוֹת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/32"/>חַנּוּן,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/33"/>בָּם סִדַּרְנוּ לְפָנֶיךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/34"/>זַעַק קְשֹׁב מִמִּתְחַנְּנֶיךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/35"/>וְאַל תְּשִׁיבֵנוּ רֵיקָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adon_din_im_yiddeqen/36"/>מִלְּפָנֶיךָ:</tei:p>
      </tei:div>
