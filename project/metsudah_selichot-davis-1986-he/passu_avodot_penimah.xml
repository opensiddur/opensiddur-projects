      <tei:div corresp="urn:x-opensiddur:text:prayer:passu_avodot_penimah">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:passu_avodot_penimah/1"/>פַּסּוּ עֲבוֹדוֹת־פְּנִימָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:passu_avodot_penimah/2"/>וּשְׂעִירֵי כַפָּרָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:passu_avodot_penimah/3"/>וְאָפֵס כֹּהֵן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:passu_avodot_penimah/4"/>לְשַׁכֵּךְ עֶבְרָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:passu_avodot_penimah/5"/>וְנִשְׁאַרְנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:passu_avodot_penimah/6"/>כְּלֵב אִשָּׁה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:passu_avodot_penimah/7"/>מְצֵרָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:passu_avodot_penimah/8"/>שְׁעוּנִים בְּאֹמֶר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:passu_avodot_penimah/9"/>יַעַנְךָ יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:passu_avodot_penimah/10"/>בְּיוֹם צָרָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:passu_avodot_penimah/11"/>צָרָה בִּהְיוֹת לְיַעֲקֹב.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:passu_avodot_penimah/12"/>זֶה־יֹאמַר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:passu_avodot_penimah/13"/>לַיהֹוָה־אָנִי בְּלִי לַעֲקֹב.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:passu_avodot_penimah/14"/>וְזֶה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:passu_avodot_penimah/15"/>יִקְרָא בְשֵׁם יַעֲקֹב.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:passu_avodot_penimah/16"/>וְכֻלָּם שְׁעוּנִים בְּהַבְטָחַת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:passu_avodot_penimah/17"/>שֵׁם אֱלֹהֵי יַעֲקֹב:</tei:p>
      </tei:div>
