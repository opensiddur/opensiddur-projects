      <tei:div corresp="urn:x-opensiddur:text:prayer:dirshu_adonai_behimmatzo_qerauhu_bihyoto">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu_bihyoto/1"/>דִּרְשׁוּ יְהוָה בְּהִמָּצְאוֹ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu_bihyoto/2"/>קְרָאֻהוּ בִּהְיוֹתוֹ קָרוֹב׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:jeremiah/3/22"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu_bihyoto/3"/>שׁוּבוּ בָּנִים שׁוֹבָבִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu_bihyoto/4"/>אֶרְפָּה מְשׁוּבֹתֵיכֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu_bihyoto/5"/>הִנְנוּ אָתָנוּ לָךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu_bihyoto/6"/>כִּי אַתָּה יְהֹוָה אֱלֹהֵינוּ׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:hosea/14/2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu_bihyoto/7"/>שׁוּבָה יִשְׂרָאֵל עַד יְהוָה אֱלֹהֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu_bihyoto/8"/>כִּי כָשַׁלְתָּ בַּעֲוֺנֶךָ׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
