    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:lamah_adonai_taamod">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/10/1"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:lamah_adonai_taamod/1"/>לָמָה יְהוָה תַּעֲמֹד בְּרָחוֹק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:lamah_adonai_taamod/2"/>תַּעְלִים לְעִתּוֹת בַּצָּרָה׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:lamah_adonai_taamod/3"/>שׁוּב לְמַעַן עֲבָדֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:lamah_adonai_taamod/4"/>שִׁבְטֵי נַחֲלָתֶךָ׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:lamah_adonai_taamod/5"/>תִּתֵּן אֱמֶת לְיַעֲקֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:lamah_adonai_taamod/6"/>חֶסֶד לְאַבְרָהָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:lamah_adonai_taamod/7"/>אֲשֶׁר־נִשְׁבַּעְתָּ לַאֲבֹתֵינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:lamah_adonai_taamod/8"/>מִימֵי קֶדֶם׃</tei:p>
      </tei:div>
