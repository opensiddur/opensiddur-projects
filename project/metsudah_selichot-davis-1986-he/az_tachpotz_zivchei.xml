  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:az_tachpotz_zivchei">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:az_tachpotz_zivchei/1"/>אָז תַּחְפֹּץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:az_tachpotz_zivchei/2"/>זִבְחֵי־צֶדֶק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:az_tachpotz_zivchei/3"/>עוֹלָה וְכָלִיל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:az_tachpotz_zivchei/4"/>אָז יַעֲלוּ עַל־מִזְבַּחֲךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:az_tachpotz_zivchei/5"/>פָרִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:az_tachpotz_zivchei/6"/>תִּתֵּן אֱמֶת לְיַעֲקֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:az_tachpotz_zivchei/7"/>חֶסֶד לְאַבְרָהָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:az_tachpotz_zivchei/8"/>אֲשֶׁר־נִשְׁבַּעְתָּ לַאֲבֹתֵינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:az_tachpotz_zivchei/9"/>מִימֵי קֶדֶם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:az_tachpotz_zivchei/10"/>וְחֶסֶד יְהוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:az_tachpotz_zivchei/11"/>מֵעוֹלָם וְעַד עוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:az_tachpotz_zivchei/12"/>עַל יְרֵאָיו,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:az_tachpotz_zivchei/13"/>וְצִדְקָתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:az_tachpotz_zivchei/14"/>לִבְנֵי בָנִים:</tei:p>
