      <tei:div corresp="urn:x-opensiddur:text:prayer:kaddish/shalem">
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:kaddish/chatzi"/>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/22"/>תִּתְקַבֵּל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/23"/>צְלוֹתְהוֹן וּבָעוּתְהוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/24"/>דְּכָל (בֵּית) יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/25"/>קֳדָם אֲבוּהוֹן דִּי בִשְׁמַיָּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/26"/>וְאִמְרוּ אָמֵן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/27"/>יְהֵא שְׁלָמָא רַבָּא מִן שְׁמַיָּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/53"/>וְחַיִּים עָלֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/29"/>וְעַל כָּל יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/30"/>וְאִמְרוּ אָמֵן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/54"/>עֹשֶׂה שָׁלוֹם בִּמְרוֹמָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/34"/>הוּא יַעֲשֶׂה שָׁלוֹם עָלֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/35"/>וְעַל כָּל יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/shalem/36"/>וְאִמְרוּ אָמֵן:</tei:p>
