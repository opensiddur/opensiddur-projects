    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:horita_derekh_teshuvah/stanza_3">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_3/1"/>הֵן רֹאשׁ עַפְרוֹת תֵּבֵל,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_3/2"/>אֲשֶׁר רִאשׁוֹן נוֹצָר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_3/3"/>וְנִסִּיתוֹ בְּמִצְוָה קַלָּה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_3/4"/>וְאוֹתָהּ לֹא־נָצָר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_3/5"/>זָעַמְתָּ וְאָנַפְתָּ עָלָיו,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_3/6"/>שְׁנוֹתָיו לְקַצֵּר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_3/7"/>חָזַר־בִּתְשׁוּבָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_3/8"/>וְכָאִישׁוֹן הוּנְצָר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_3/9"/>הֲשִׁיבֵנוּ יְהֹוָה אֵלֶיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_3/10"/>וְנָשׁוּבָה:</tei:p>
      </tei:div>
