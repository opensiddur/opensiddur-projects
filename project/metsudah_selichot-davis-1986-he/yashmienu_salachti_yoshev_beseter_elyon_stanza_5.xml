    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yashmienu_salachti_yoshev_beseter_elyon/stanza_5">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_5/1"/>לַחֲבַצֶּלֶת פְּתַח דֶּלֶת,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_5/2"/>אֱלוֹהַּ מִמַּעַל.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_5/3"/>בִּינָה הֲגִיגִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_5/4"/>לְהַצִּיגִי בְּתוֹךְ שַׁעַר הַנִּנְעָל.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_5/5"/>רַחֲמֵנוּ קַדְמֵנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_5/6"/>צֳרִי וּמָזוֹר הַתְעַל.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_5/7"/>בָּרֵר חִכִּי, לְהַצְדִּיקִי,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_5/8"/>יְבֻקַּשׁ עָוֹן וְאֵינֶנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_5/9"/>יְהֹוָה הֱיֵה עוֹזֵר לָנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_5/10"/>יוֹנַת אֵלֶם מִשָּׁלֵם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_5/11"/>חֵלֶק יָפֶה תַּגִּיעַ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_5/12"/>אוֹת צֶדֶק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_5/13"/>בְּהִצְטַדֵּק בְּיִרְאָתְךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_5/14"/>לְהוֹשִׁיעָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_5/15"/>לְךָ תִּקְרָא עֵת לְשַׁחְרְרָהּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_5/16"/>אָדוֹן בְּזוֹ הַשָּׁעָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_5/17"/>וַתֵּק תִּיק מִנַּרְתֵּק,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_5/18"/>כָּאוֹר תּוֹצִיא דִינֵנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_5/19"/>יְהֹוָה הֱיֵה עוֹזֵר לָנוּ:</tei:p>
      </tei:div>
