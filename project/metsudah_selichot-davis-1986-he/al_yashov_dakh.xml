  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:al_yashov_dakh">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/74/21"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_yashov_dakh/1"/>אַל־יָשֹׁב דַּךְ נִכְלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_yashov_dakh/2"/>עָנִי וְאֶבְיוֹן יְהַלְלוּ שְׁמֶךָ׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/22/12"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_yashov_dakh/3"/>אַל־תִּרְחַק מִמֶּנּוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_yashov_dakh/4"/>כִּי־צָרָה קְרוֹבָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_yashov_dakh/5"/>כִּי־אֵין עוֹזֵר׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_yashov_dakh/6"/>כִּי אֶסְלַח לַעֲוֺנָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_yashov_dakh/7"/>וּלְחַטָּאתָם לֹא אֶזְכָּר־עוֹד׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_yashov_dakh/8"/>וְסָלַחְתָּ לְעַמְּךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_yashov_dakh/9"/>אֲשֶׁר חָטְאוּ־לָךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_yashov_dakh/10"/>וּלְכָל־פִּשְׁעֵיהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_yashov_dakh/11"/>אֲשֶׁר פָּשְׁעוּ־בָךְ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_yashov_dakh/12"/>וּנְתַתָּם לְרַחֲמִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_yashov_dakh/13"/>לִפְנֵי שֹׁבֵיהֶם׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_yashov_dakh/14"/>וְאַתָּה אֱלוֹהַּ סְלִיחוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_yashov_dakh/15"/>חַנּוּן וְרַחוּם אֶרֶךְ־אַפַּיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_yashov_dakh/16"/>וְרַב־חֶסֶד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_yashov_dakh/17"/>וְלֹא עֲזַבְתָּם׃</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
