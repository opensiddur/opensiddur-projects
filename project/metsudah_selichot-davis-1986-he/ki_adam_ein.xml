  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:ki_adam_ein">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:ecclesiastes/7/20"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_adam_ein/1"/>כִּי אָדָם אֵין צַדִּיק בָּאָרֶץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_adam_ein/2"/>אֲשֶׁר יַעֲשֶׂה־טּוֹב וְלֹא יֶחֱטָא:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_adam_ein/3"/>כִּי יֵצֶר לֵב הָאָדָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_adam_ein/4"/>רַע מִנְּעֻרָיו:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_adam_ein/5"/>כִּי־תְבַקֵּשׁ לַעֲוֺנֵינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_adam_ein/6"/>וּלְחַטָּאתֵנוּ תִדְרוֹשׁ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_adam_ein/7"/>שַׁתָּה עֲוֺנֹתֵינוּ לְנֶגְדֶּךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_adam_ein/8"/>עֲלֻמֵנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_adam_ein/9"/>לִמְאוֹר פָּנֶיךָ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/103/15"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_adam_ein/10"/>אֱנוֹשׁ כֶּחָצִיר יָמָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_adam_ein/11"/>כְּצִיץ הַשָּׂדֶה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_adam_ein/12"/>כֵּן יָצִיץ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_adam_ein/13"/>וְאַתָּה יְהוָה חַנּוּן וְרַחוּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_adam_ein/14"/>אֶרֶךְ אַפַּיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_adam_ein/15"/>וְרַב חֶסֶד וֶאֱמֶת:</tei:p>
      </tei:div>
