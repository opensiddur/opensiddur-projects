  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yashmienu_salachti_yoshev_beseter_elyon/stanza_6">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_6/1"/>תַּצְלִיחִי בְּמִשְׁלָחִי,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_6/2"/>אָשִׁיב שׁוֹלְחִי דָּבָר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_6/3"/>חִזַּקְתָּ חֹק חַקְתָּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_6/4"/>עֶשֶׂר וְשָׁלֹשׁ כִּמְדֻבָּר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_6/5"/>מַחֲזִיקָם וְלֹא רֵיקָם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_6/6"/>שֻׁלַּחְתִּי לְהִתְגַּבָּר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_6/7"/>וְכֹה תַעֲשֶׂה עָוֹן נֹשֵׂא,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_6/8"/>עַתָּה תָשׁוּב תְּרַחֲמֵנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_6/9"/>יְהֹוָה הֱיֵה עוֹזֵר לָנוּ:</tei:p>
