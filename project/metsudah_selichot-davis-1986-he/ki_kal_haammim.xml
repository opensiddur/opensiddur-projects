  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:ki_kal_haammim">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:micah/4/5"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_kal_haammim/1"/>כִּי כָּל־הָעַמִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_kal_haammim/2"/>יֵלְכוּ אִישׁ בְּשֵׁם אֱלֹהָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_kal_haammim/3"/>וַאֲנַחְנוּ נֵלֵךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_kal_haammim/4"/>בְּשֵׁם־יְהוָה אֱלֹהֵינוּ לְעוֹלָם וָעֶד׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_kal_haammim/5"/>וַאֲנַחְנוּ בְחַסְדְּךָ בָטַחְנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_kal_haammim/6"/>יָגֵל לִבֵּנוּ בִּישׁוּעָתֶךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_kal_haammim/7"/>וַאֲנַחְנוּ נָשִׁיר עֻזֶּךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_kal_haammim/8"/>נְרַנֵּן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_kal_haammim/9"/>לַבֹּקֶר חַסְדֶּךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_kal_haammim/10"/>וַאֲנַחְנוּ בְּרֹב חַסְדְּךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_kal_haammim/11"/>נָבוֹא בֵיתֶֽךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_kal_haammim/12"/>נִשְׁתַּחֲוֶה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_kal_haammim/13"/>אֶל הֵיכַל־קָדְשְׁךָ בְּיִרְאָתֶֽךָ:</tei:p>
      </tei:div>
