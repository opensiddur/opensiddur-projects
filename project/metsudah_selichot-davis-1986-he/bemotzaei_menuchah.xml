      <tei:div corresp="urn:x-opensiddur:text:poem:bemotzaei_menuchah">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/1"/>בְּמוֹצָאֵי מְנוּחָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/2"/>קִדַּמְנוּךָ תְּחִלָּה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/3"/>הַט אָזְנְךָ מִמָּרוֹם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/4"/>יוֹשֵׁב תְּהִלָּה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/5"/>לִשְׁמֹעַ אֶל־הָרִנָּה וְאֶל־הַתְּפִלָּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/6"/>אֶת־יְמִין עֹז עוֹרְרָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/7"/>לַעֲשׂוֹת חָיִל.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/8"/>בְּצֶדֶק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/9"/>נֶעֱקַד,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/10"/>וְנִשְׁחַט תְּמוּרוֹ אָיִל.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/11"/>גְּנוֹן נָא גִזְעוֹ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/12"/>בְּזַעֲקָם בְּעוֹד לָיִל.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/13"/>לִשְׁמֹעַ אֶל־הָרִנָּה וְאֶל־הַתְּפִלָּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/14"/>דְּרוֹשׁ־נָא דּוֹרְשֶׁיךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/15"/>בְּדָרְשָׁם פָּנֶיךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/16"/>הִדָּרֶשׁ לָמוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/17"/>מִשְּׁמֵי מְעוֹנֶךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/18"/>וּלְשַׁוְעַת חִנּוּנָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/19"/>אַל תַּעְלֵם אָזְנֶךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/20"/>לִשְׁמֹעַ אֶל־הָרִנָּה וְאֶל־הַתְּפִלָּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/21"/>זוֹחֲלִים וְרוֹעֲדִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/22"/>מִיּוֹם בֹּאֶךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/23"/>חָלִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/24"/>כְּמַבְכִּירָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/25"/>מֵעֶבְרַת מַשָּׂאֶךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/26"/>טִנּוּפָם מְחֵה נָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/27"/>וְיוֹדוּ פְּלָאֶיךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/28"/>לִשְׁמֹעַ אֶל־הָרִנָּה וְאֶל־הַתְּפִלָּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/29"/>יוֹצֵר אַתָּה לְכָל־יְצִיר נוֹצָר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/30"/>כּוֹנַנְתָּ מֵאָז תֶּרֶף
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/31"/>לְחַלְּצָם מִמֵּצָר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/32"/>לְחוֹנְנָם חִנָּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/33"/>מֵאוֹצָר הַמְּנֻצָּר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/34"/>לִשְׁמֹעַ אֶל־הָרִנָּה וְאֶל־הַתְּפִלָּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/35"/>מָרוֹם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/36"/>אִם־עָצְמוּ פִּשְׁעֵי קְהָלֶךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/37"/>נָא סַגְּבֵם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/38"/>מֵאוֹצָר הַמּוּכָן בִּזְבוּלֶךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/39"/>עָדֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/40"/>לָחֹן חִנָּם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/41"/>בָּאִים אֵלֶיךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/42"/>לִשְׁמֹעַ אֶל־הָרִנָּה וְאֶל־הַתְּפִלָּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/43"/>פְּנֵה־נָא אֶל־הַתְּלָאוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/44"/>וְאַל לַחַטָּאוֹת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/45"/>צַדֵּק צוֹעֲקֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/46"/>מַפְלִיא פְלָאוֹת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/47"/>קְשׁוֹב־נָא חִנּוּנָם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/48"/>אֱלֹהִים יְהֹוָה צְבָאוֹת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/49"/>לִשְׁמֹעַ אֶל־הָרִנָּה וְאֶל־הַתְּפִלָּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/50"/>רְצֵה עֲתִירָתָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/51"/>בְּעָמְדָם בַּלֵּילוֹת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/52"/>שְׁעֵה נָא בְרָצוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/53"/>כְּקָרְבַּן כָּלִיל וְעוֹלוֹת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/54"/>תַּרְאֵם נִסֶּיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/55"/>עוֹשֶׂה גְדוֹלוֹת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bemotzaei_menuchah/56"/>לִשְׁמֹעַ אֶל־הָרִנָּה וְאֶל־הַתְּפִלָּה:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
