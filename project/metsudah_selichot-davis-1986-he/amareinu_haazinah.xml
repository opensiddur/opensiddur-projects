    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:amareinu_haazinah">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amareinu_haazinah/1"/>אֲמָרֵֽינוּ הַאֲזִֽינָה יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amareinu_haazinah/2"/>בִּֽינָה הֲגִיגֵֽנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amareinu_haazinah/3"/>יִהְיוּ לְרָצוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amareinu_haazinah/4"/>אִמְרֵי פִֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amareinu_haazinah/5"/>וְהֶגְיוֹן לִבֵּֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amareinu_haazinah/6"/>לְפָנֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amareinu_haazinah/7"/>יְהֹוָה צוּרֵֽנוּ וְגוֹאֲלֵֽנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amareinu_haazinah/8"/>כִּי לְךָ יְהֹוָה הוֹחָֽלְנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amareinu_haazinah/9"/>אַתָּה תַעֲנֶה אֲדֹנָי אֱלֹהֵֽינוּ:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
