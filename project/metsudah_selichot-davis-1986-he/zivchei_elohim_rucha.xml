      <tei:div corresp="urn:x-opensiddur:text:prayer:zivchei_elohim_rucha">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha/1"/>זִבְחֵי אֱלֹהִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha/2"/>רוּחַ נִשְׁבָּרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha/3"/>לֵב־נִשְׁבָּר וְנִדְכֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha/4"/>אֱלֹהִים לֹא תִבְזֶה:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/51/21"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha/5"/>אָז תַּחְפֹּץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha/6"/>זִבְחֵי־צֶדֶק
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha/7"/>עוֹלָה וְכָלִיל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha/8"/>אָז יַעֲלוּ עַל־מִזְבַּחֲךָ פָרִים:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/103/17"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha/9"/>וְחֶסֶד יְהוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha/10"/>מֵעוֹלָם וְעַד־עוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha/11"/>עַל־יְרֵאָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha/12"/>וְצִדְקָתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha/13"/>לִבְנֵי בָנִים:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:genesis/22/16"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha/14"/>וַיֹּאמֶר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha/15"/>בִּי נִשְׁבַּעְתִּי נְאֻם־יְהוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha/16"/>כִּי יַעַן אֲשֶׁר עָשִׂיתָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha/17"/>אֶת־הַדָּבָר הַזֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha/18"/>וְלֹא חָשַׂכְתָּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha/19"/>אֶת־בִּנְךָ אֶת־יְחִידֶךָ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
