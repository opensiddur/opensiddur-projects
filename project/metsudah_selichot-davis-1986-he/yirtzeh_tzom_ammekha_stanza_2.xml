    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yirtzeh_tzom_ammekha/stanza_2">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_2/1"/>צִדְקָתְךָ הִתְאַזָּר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_2/2"/>שׁוֹכֵן עַד וּמְרוֹמָם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_2/3"/>סְמֹךְ נָא הַנִּכְשָׁלִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_2/4"/>שְׁלַח יָדְךָ לַהֲקִימָם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_2/5"/>אֲשֶׁר דִּמְעָם שִׁקּוּיָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_2/6"/>וְאַנְחָתָם הִיא לַחְמָם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_2/7"/>וְתִנְקֹם דַּם עֲבָדֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_2/8"/>מֵאוֹיְבֶיךָ עַד תֻּמָּם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_2/9"/>וְתִדְרֹשׁ לְשֶׁפֶךְ דָּמָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_2/10"/>לָדַעַת מַה־זֶּה וְעַל־מַה־זֶּה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_2/11"/>מָחָר יִהְיֶה הָאוֹת הַזֶּה:</tei:p>
