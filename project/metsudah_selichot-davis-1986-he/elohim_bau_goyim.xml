      <tei:div corresp="urn:x-opensiddur:text:prayer:elohim_bau_goyim">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohim_bau_goyim/1"/>אֱ‍לֹהִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohim_bau_goyim/2"/>בָּאוּ גוֹיִם בְּנַחֲלָתֶךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohim_bau_goyim/3"/>טִמְּאוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohim_bau_goyim/4"/>אֶת הֵיכַל קָדְשֶׁךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohim_bau_goyim/5"/>שָׂמוּ אֶת יְרוּשָׁלַ‍ִם לְעִיִּים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohim_bau_goyim/6"/>שְׁפָךְ־עֲלֵיהֶם זַעְמֶךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohim_bau_goyim/7"/>וַחֲרוֹן אַפְּךָ יַשִּׂיגֵם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohim_bau_goyim/8"/>הִנָּשֵׂא שֹׁפֵט הָאָרֶץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohim_bau_goyim/9"/>הָשֵׁב גְּמוּל עַל־גֵּאִים:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/28/4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohim_bau_goyim/10"/>תֶּן־לָהֶם כְּפָעֳלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohim_bau_goyim/11"/>וּכְרֹעַ מַעַלְלֵיהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohim_bau_goyim/12"/>כְּמַעֲשֵׂה יְדֵיהֶם תֵּן לָהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohim_bau_goyim/13"/>הָשֵׁב גְּמוּלָם לָהֶם:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohim_bau_goyim/14"/>הֵיטִיבָה בִרְצוֹנְךָ אֶת־צִיּוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elohim_bau_goyim/15"/>תִּבְנֶה חוֹמוֹת יְרוּשָׁלִָם:</tei:p>
      </tei:div>
