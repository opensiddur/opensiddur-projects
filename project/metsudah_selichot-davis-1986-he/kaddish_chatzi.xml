      <tei:div corresp="urn:x-opensiddur:text:prayer:kaddish/chatzi">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/1"/>יִתְגַּדַּל וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/2"/>בְּעָלְמָא דִּי בְרָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/3"/>כִרְעוּתֵהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/4"/>וְיַמְלִיךְ מַלְכוּתֵהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/7"/>בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/9"/>וּבְחַיֵּי דְכָל בֵּית יִשְׂרָאֵל,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/10"/>בַּעֲגָלָא וּבִזְמַן קָרִיב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/11"/>וְאִמְרוּ אָמֵן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/12"/>יְהֵא שְׁמֵהּ רַבָּא מְבָרַךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/13"/>לְעָלַם וּלְעָלְמֵי עָלְמַיָּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/14"/>יִתְבָּרַךְ וְיִשְׁתַּבַּח
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/15"/>וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְנַשֵּׂא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/16"/>וְיִתְהַדָּר וְיִתְעַלֶּה וְיִתְהַלָּל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/17"/>שְׁמֵהּ דְקוּדְשָׁא, בְּרִיךְ הוּא
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/chatzi/selichot_tzom_gedaliah"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/23"/>לְעֵֽלָּא וּלְעֵֽלָּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/24"/>מִכָּל בִּרְכָתָא וְשִׁירָתָא,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/chatzi/selichot_penitential_second_day"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
