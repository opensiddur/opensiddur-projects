<j:endConditional target="#variant_6"/>
<j:conditional xml:id="variant_7"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/chatzi/selichot_tzom_gedaliah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/chatzi/selichot_penitential_second_day"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/chatzi/selichot_penitential_third_day"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/chatzi/selichot_penitential_fourth_day"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/chatzi/selichot_penitential_fifth_day"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:kaddish/chatzi/selichot_erev_yom_kippur"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kaddish/chatzi/22"/>לְעֵֽלָּא
<tei:milestone unit="phrase"/>
