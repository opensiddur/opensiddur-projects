      <tei:div corresp="urn:x-opensiddur:text:poem:yoshev_beseter_elyon_maginni_vetzinnati/stanza_4">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_4/1"/>חַנּוּן חַי חָנֵּנִי,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_4/2"/>לְקוֹל זַעֲקִי בִּגְרוֹנִי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_4/3"/>בְּשָׁמְעֲךָ תַּעֲנֵנִי,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_4/4"/>סְלִיחָתְךָ תַּרְבֵּנִי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_4/5"/>חַיִּים תִּכְתְּבֵנִי,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_4/6"/>וְעָנְתָה בִּי צִדְקָתִי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_4/7"/>נַפְשִׁי בִּשְׁאֵלָתִי,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_4/8"/>וְעַמִּי בְּבַקָּשָׁתִי:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
