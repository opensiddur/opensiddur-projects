      <tei:div corresp="urn:x-opensiddur:text:poem:horita_derekh_teshuvah/stanza_8">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_8/1"/>בּוֹחֵן כְלָיוֹת וָלֵב,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_8/2"/>נֶאֶזָר בִּגְבוּרָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_8/3"/>יַדְּעֵנוּ מַדַּע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_8/4"/>לֶכֶת בְּאֹרַח יְשָׁרָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_8/5"/>מְשׁוּבוֹתֵינוּ אִם־רָבּוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_8/6"/>בְּפֶשַׁע וּסְרָרָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_8/7"/>נָא לְמַעַנְךָ הֲשִׁיבֵנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_8/8"/>עֲשׂוֹת תְּשׁוּבָה כַּשׁוּרָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_8/9"/>הֲשִׁיבֵנוּ יְהֹוָה אֵלֶיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_8/10"/>וְנָשׁוּבָה:</tei:p>
      </tei:div>
