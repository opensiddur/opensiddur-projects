      <tei:div corresp="urn:x-opensiddur:text:prayer:tavo_lefanekha_tefillatenu">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tavo_lefanekha_tefillatenu/1"/>תָּבֹא לְפָנֶיךָ תְּפִלָּתֵנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tavo_lefanekha_tefillatenu/2"/>וְאַל תִּתְעַלַּם מִתְּחִנָּתֵנוּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/79/11"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tavo_lefanekha_tefillatenu/3"/>תָּבוֹא לְפָנֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tavo_lefanekha_tefillatenu/4"/>אֶנְקַת אָסִיר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tavo_lefanekha_tefillatenu/5"/>כְּגֹדֶל זְרוֹעֲךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tavo_lefanekha_tefillatenu/6"/>הוֹתֵר בְּנֵי תְמוּתָה׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:tavo_lefanekha_tefillatenu/selichot_penitential_fourth_day"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tavo_lefanekha_tefillatenu/7"/>אֲדֹנָי שִׁמְעָה בְקוֹלֵנוּ,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:tavo_lefanekha_tefillatenu/selichot_penitential_fourth_day"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tavo_lefanekha_tefillatenu/8"/>תִּהְיֶינָה אָזְנֶיךָ קַשֻּׁבוֹת,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:tavo_lefanekha_tefillatenu/selichot_penitential_fourth_day"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tavo_lefanekha_tefillatenu/9"/>לְקוֹל תַּחֲנוּנֵינוּ:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:tavo_lefanekha_tefillatenu/selichot_penitential_fourth_day"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tavo_lefanekha_tefillatenu/10"/>תְּהִי נָא אָזְנְךָ קַשֶּׁבֶת,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:tavo_lefanekha_tefillatenu/selichot_penitential_fourth_day"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tavo_lefanekha_tefillatenu/11"/>וְעֵינֶיךָ פְקוּחוֹת
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_5"/>
<j:conditional xml:id="variant_6"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:tavo_lefanekha_tefillatenu/selichot_penitential_fourth_day"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:tavo_lefanekha_tefillatenu/12"/>עַל עַמְּךָ יִשְׂרָאֵל:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_6"/></tei:p>
      </tei:div>
