    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yoshev_beseter_elyon_maginni_vetzinnati/stanza_7">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_7/1"/>יֵרָצוּ עֲבָדֶיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_7/2"/>לְמַעַן שֵׁם כְּבוֹדֶךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_7/3"/>מְיַחֲדֶיךָ מְעִידֶיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_7/4"/>כִּי אֵין בִּלְעָדֶיךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_7/5"/>בַּקֵּשׁ נָא אוֹבְדֶיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_7/6"/>הֵן בָּאוּ עָדֶיךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_7/7"/>כִּי טוֹבִים דֹּדֶיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_7/8"/>פָּנֶיךָ בִּקַּשְׁתִּי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_7/9"/>נַפְשִׁי בִּשְׁאֵלָתִי,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_7/10"/>וְעַמִּי בְּבַקָּשָׁתִי:</tei:p>
