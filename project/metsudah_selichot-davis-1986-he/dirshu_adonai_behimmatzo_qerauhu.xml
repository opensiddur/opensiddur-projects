      <tei:div corresp="urn:x-opensiddur:text:prayer:dirshu_adonai_behimmatzo_qerauhu">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu/1"/>דִּרְשׁוּ יְהוָה בְּהִמָּצְאוֹ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu/2"/>קְרָאֻהוּ בִּהְיוֹתוֹ קָרוֹב׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu/3"/>שׁוּבוּ אֵלַי וְאָשׁוּבָה אֲלֵיכֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu/4"/>אָמַר יְהוָה צְבָאוֹת:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:jonah/3/9"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu/5"/>מִי־יוֹדֵעַ יָשׁוּב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu/6"/>וְנִחַם הָאֱלֹהִים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu/7"/>וְשָׁב מֵחֲרוֹן אַפּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu/8"/>וְלֹא נֹאבֵד׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:joel/2/14"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu/9"/>מִי יוֹדֵעַ יָשׁוּב וְנִחָם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu/10"/>וְהִשְׁאִיר אַחֲרָיו בְּרָכָה׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:joel/2/13"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu/11"/>וְקִרְעוּ לְבַבְכֶם וְאַל־בִּגְדֵיכֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu/12"/>וְשׁוּבוּ אֶל־יְהוָה אֱלֹהֵיכֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu/13"/>כִּי־חַנּוּן וְרַחוּם הוּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu/14"/>אֶרֶךְ אַפַּיִם וְרַב־חֶסֶד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:dirshu_adonai_behimmatzo_qerauhu/15"/>וְנִחָם עַל־הָרָעָה׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
