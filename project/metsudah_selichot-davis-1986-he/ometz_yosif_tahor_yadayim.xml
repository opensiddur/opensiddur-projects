      <tei:div corresp="urn:x-opensiddur:text:poem:ometz_yosif_tahor_yadayim">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/1"/>אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/2"/>אֹמֶץ יוֹסִיף טְהָר־יָדַיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/3"/>וכֹחוֹ יִגְדַּל וְיִישַׁר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/4"/>בְּמִקְרָא אִלְמָלֵא כָתוּב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/5"/>לְאָמְרוֹ אִי־אֶפְשָׁר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/6"/>גֵּאֶה נִתְעַטֵּף כִּשְׁלִיחַ־צִבּוּר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/7"/>וּשְׁלֹשׁ־עֶשְׂרֵה מִדּוֹת הִכְשִׁיר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/8"/>דִּבְרַת יְקָרוֹ הֶעֱבִיר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/9"/>וְהֶרְאָה לְמֹשֶׁה קֶשֶׁר הַמְקֻשָּׁר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/10"/>הִזְהִירוֹ וְאָמַר־לוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/11"/>כָּל־זְמַן שֶׁחוֹטְאִין בָּנַי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/12"/>וְכַסֵּדֶר הַזֶּה יִהְיוּ עוֹשִׂין לְפָנַי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/13"/>זוֹ־הִיא הַמִּדָּה לִסְלֹחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/14"/>אֲנִי יְהֹוָה יְהֹוָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/15"/>חַנּוּן קֹדֶם שֶׁיֶּחֱטָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/16"/>וְאַחַר שֶׁיֶּחֱטָא וְיָשׁוּב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/17"/>אֵלּוּ דְּרָכַי וְעִנְיָנָי:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/18"/>טוֹב וְסַלָּח וְרַב־חֶסֶד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/19"/>כְּלַפֵּי חֶסֶד מַגְבִּיר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/20"/>יָשׁוּב יְרַחֵם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/21"/>כּוֹבֵשׁ וְנוֹשֵׂא וּפָנִים מַסְבִּיר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/22"/>כָּךְ הִיא הַמִּדָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/23"/>רִאשׁוֹן רִאשׁוֹן מַעֲבִיר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/24"/>לִמְחֹל וְלִסְלֹחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/25"/>רַחֲמָיו וַחֲסָדָיו לְהַגְבִּיר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/26"/>כָּמוֹךָ מִי־מוֹרֶה תַחְבֹּשֶׁת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/27"/>חָסִיד וְרוֹפֵא אֻמָּן.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/28"/>לְפִי הַמַּכָּה גְדוֹלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/29"/>מְלוּגְמָתְךָ תְּזֻמָּן.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/30"/>מוּעָטִים דָּמִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/31"/>חוֹלֶה הַבָּא אֶצְלְךָ לְיָדוֹ אִמָּן.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/32"/>נִשְׁתַּיֵּר מִשֶּׁלָּךְ חִנָּם חָנֵּנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/33"/>רַחֲמָן וְנֶאֱמָן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/34"/>סַמְּךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/35"/>סַם חַיִּים מֻפְלָאָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/36"/>לְמַלָּנִית.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/37"/>עִקָּרֵי כוֹסְךָ יָפִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/38"/>וְקִלּוּרֵי מַטְלָנִית.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/39"/>פָּתוֹחַ בְּיָדְךָ כֵּיוָן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/40"/>נַרְתֵּק הָאִסְפְּלָנִית.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/41"/>צֳרִי לְהַתְעִיל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/42"/>מַחַץ חִבַּת חוֹלָנִית:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/43"/>פּוֹעֵל עִם בַּעַל־הַבַּיִת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/44"/>וּבֶאֱמוּנָה נוֹהֵג־בּוֹ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/45"/>צוֹפֶה לִתֵּן שְׂכָרוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/46"/>מַה־שְּׁבָחוֹ וּמַה טּוּבוֹ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/47"/>קִלְקֵל וְנִתְעַצֵּל בִּמְלַאכְתּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/48"/>שֶׁבַח רַבּוֹ אִם־קֵרְבוֹ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/49"/>לַיהֹוָה אֱלֹהֵינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/50"/>הָרַחֲמִים וְהַסְּלִיחוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/51"/>כִּי מָרַדְנוּ בוֹ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/52"/>קֹשֶׁט מִדּוֹתֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/53"/>תְּרוּמוֹת וַהֲגוּנוֹת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/54"/>רְאִיַּת דּוּגְמָתְךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/55"/>לְמַסְפִּיק לְמוֹרְדָיו מְזוֹנוֹת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/56"/>שְׁאֵרִית יוֹסֵף
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/57"/>מְקַוֶּה מְצֹא סְלִיחָה לַעֲווֹנוֹת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/58"/>תִּגְמֹל הַטּוֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/59"/>כְּיוֹסֵף לְאֶחָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ometz_yosif_tahor_yadayim/60"/>צִדְקוֹתֶיךָ נֶצַח לְתַנּוֹת:</tei:p>
      </tei:div>
    </tei:body>
