    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:veattah_hashevota_lo">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_hashevota_lo/1"/>וְאַתָּה הֲשֵׁבוֹתָ־לוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_hashevota_lo/2"/>כְּדַרְכֵי טוּבְךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_hashevota_lo/3"/>וְדִבַּרְתָּ וְאָמַרְתָּ־לוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_hashevota_lo/4"/>סָלַחְתִּי כִּדְבָרֶךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_hashevota_lo/5"/>וַאֲנַחְנוּ בֹּשְׁנוּ בְּמַעֲשֵׂינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_hashevota_lo/6"/>וְנִכְלַמְנוּ בַּעֲוֹנֵינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_hashevota_lo/7"/>וְהֻשְׁחֲרוּ פָּנֵינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_hashevota_lo/8"/>מִפְּנֵי חַטֹּאתֵינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_hashevota_lo/9"/>וְנִכְפְּפָה קוֹמָתֵנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_hashevota_lo/10"/>מִפְּנֵי אַשְׁמָתֵינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_hashevota_lo/11"/>וְאֵין לָנוּ פֶּה לְהָשִׁיב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_hashevota_lo/12"/>וְלֹא מֵצַח לְהָרִים רֹאשׁ:</tei:p>
