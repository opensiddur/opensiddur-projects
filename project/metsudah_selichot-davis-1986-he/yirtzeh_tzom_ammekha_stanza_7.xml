      <tei:div corresp="urn:x-opensiddur:text:poem:yirtzeh_tzom_ammekha/stanza_7">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_7/1"/>צֵל קוֹרָתְךָ בָּאוּ בָּנִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_7/2"/>אֲשֶׁר נִגְרָשׁוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_7/3"/>בֵּיתְךָ כְּנִתְוַעֲדוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_7/4"/>רָעֲשׁוּ וְגַם נִתְגָּעֲשׁוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_7/5"/>חֶסֶד אֲבוֹתָם תִּזְכֹּר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_7/6"/>עֵת לָרִיב יִגָּשׁוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_7/7"/>אֱמֶת וְשָׁלוֹם נִפְגָּשׁוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_7/8"/>גַּם אֶת־זֶה לְעֻמַּת זֶה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_7/9"/>מָחָר יִהְיֶה הָאוֹת הַזֶּה:</tei:p>
      </tei:div>
