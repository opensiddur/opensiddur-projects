    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:haazinah_adonai_tefillatenu">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_adonai_tefillatenu/1"/>הַאֲזִינָה יְהוָה תְּפִלָּתֵנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_adonai_tefillatenu/2"/>הַקְשִׁיבָה לְקוֹל תַּחֲנוּנֵינוּ׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_adonai_tefillatenu/3"/>מַה־נֹּאמַר לְפָנֶֽיךָ יְהֹוָה אֱלֹהֵֽינוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_adonai_tefillatenu/4"/>מַה־נְּדַבֵּר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_adonai_tefillatenu/5"/>וּמַה־נִּצְטַדָּק:
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:haazinah_adonai_tefillatenu/selichot_erev_rosh_hashanah"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_adonai_tefillatenu/14"/>אֱלֹהֵינוּ בֹּשְׁנוּ וְנִכְלַמְנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_adonai_tefillatenu/15"/>לְהָרִים אֱלֹהֵינוּ פָּנֵינוּ אֵלֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_adonai_tefillatenu/16"/>כִּי־רַבּוּ מְשׁוּבֹתֵינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_adonai_tefillatenu/17"/>לְךָ חָטָאנוּ׃
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_adonai_tefillatenu/6"/>חָטָאנוּ עִם־אֲבוֹתֵינוּ
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:haazinah_adonai_tefillatenu/selichot_erev_rosh_hashanah"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_adonai_tefillatenu/18"/>הֶעֱוִינוּ וְהִרְשָׁעְנוּ׃
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:haazinah_adonai_tefillatenu/selichot_erev_rosh_hashanah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_adonai_tefillatenu/7"/>הֶעֱוִינוּ
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:haazinah_adonai_tefillatenu/selichot_erev_rosh_hashanah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_adonai_tefillatenu/8"/>וְהִרְשָׁעְנוּ׃
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_adonai_tefillatenu/9"/>חַטֹּאת נְעוּרֵינוּ וּפְשָׁעֵינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_adonai_tefillatenu/10"/>אַל־תִּזְכֹּר
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:haazinah_adonai_tefillatenu/selichot_erev_rosh_hashanah"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_adonai_tefillatenu/19"/>כְּחַסְדְּךָ זְכָר־לָנוּ־אַתָּה
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_5"/>
<j:conditional xml:id="variant_6"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:haazinah_adonai_tefillatenu/selichot_erev_rosh_hashanah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_adonai_tefillatenu/11"/>כְּחַסְדְּךָ
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_6"/>
<j:conditional xml:id="variant_7"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:haazinah_adonai_tefillatenu/selichot_erev_rosh_hashanah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_adonai_tefillatenu/12"/>זְכָר־לָנוּ־אַתָּה
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_7"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:haazinah_adonai_tefillatenu/13"/>לְמַעַן טוּבְךָ יְהוָה׃</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
