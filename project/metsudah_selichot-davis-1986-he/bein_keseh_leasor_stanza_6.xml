      <tei:div corresp="urn:x-opensiddur:text:poem:bein_keseh_leasor/stanza_6">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_6/1"/>לֹא לְפִי רְאוּיִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_6/2"/>תִּשְׁפֹּט הֲמוֹנַי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_6/3"/>יְשֻׁרוּן מְיַחֲדֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_6/4"/>אַף בְּלַחַץ מוֹנַי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_6/5"/>גְּלִיפַת כְּתָב צַוֵּה לִשְׁבַח
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_6/6"/>וְלֹא לִגְנַאי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_6/7"/>מִפְתַּח פִּתּוּחֵי חוֹתָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_6/8"/>קֹדֶשׁ לַיהֹוָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:bein_keseh_leasor/stanza_6/9"/>בֵּין כֶּסֶה לֶעָשׂוֹר</tei:p>
      </tei:div>
