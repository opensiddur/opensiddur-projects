    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:machei_umassei">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:machei_umassei/1"/>מַחֵי וּמַסֵּי, מֵמִית וּמְחַיֶּה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:machei_umassei/2"/>מַסִּיק מִשְּׁאוֹל, לְחַיֵּי־עָלְמָא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:machei_umassei/3"/>בְּרָא כַּד־חָטֵי, אָבוּהִי לַקְיֵהּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:machei_umassei/4"/>אָבוּהִי דְחָיִיס,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:machei_umassei/5"/>אַסֵּי לִכְאֵבֵיהּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:machei_umassei/6"/>עַבְדָא דְמָרִיד, נָפִיק בְּקוֹלָר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:machei_umassei/7"/>מָרֵהּ תָּאִיב, וְתַבִּיר קוֹלָרֵיהּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:machei_umassei/8"/>בְּרָךְ בּוּכְרָךְ אֲנָן,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:machei_umassei/9"/>וְחָטִּינָן קַמָּךְ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:machei_umassei/10"/>הָא רָוֵי נַפְשִׁין בְּגִדִין מְרָרִין:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:machei_umassei/11"/>עַבְדָּךְ אֲנָן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:machei_umassei/12"/>וּמְרוֹדִינָן קַמָּךְ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:machei_umassei/13"/>הָא בְּבִיזְתָא,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:machei_umassei/14"/>הָא בְּשִׁבְיָא, הָא בְּמַלְקְיוּתָא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:machei_umassei/15"/>בְּמָטוּ מִנָּךְ בְּרַחֲמָךְ דִּנְפִישִׁין.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:machei_umassei/16"/>אַסֵּי לְכְאֵיבִין דִּתְקוֹף עֲלָן,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:machei_umassei/17"/>עַד דְּלָא נֶהֱוֵי גְּמִירָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:machei_umassei/18"/>בַּשִּׁבְיָא:</tei:p>
      </tei:div>
