    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:horita_derekh_teshuvah/stanza_7">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_7/1"/>שָׁנְנוּ לְשׁוֹנָם כְּחֵץ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_7/2"/>אַנְשֵׁי עִיר הַגְּדוֹלָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_7/3"/>שִׁגְיוֹנָם וּזְדוֹנָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_7/4"/>רָבּוּ עַד־לְמַעְלָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_7/5"/>תִּתְּךָ חֲזוֹן הֲפִיכָתָם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_7/6"/>אֲחָזוּם רֶתֶת וְחַלְחָלָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_7/7"/>תְּשׁוּבָה עָשֹוּ כְּהֹגֶן,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_7/8"/>וְלִפְנֵי כִּסֵּא־כְבוֹדְךָ נִתְקַבְּלָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_7/9"/>הֲשִׁיבֵנוּ יְהֹוָה אֵלֶיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_7/10"/>וְנָשׁוּבָה:</tei:p>
      </tei:div>
