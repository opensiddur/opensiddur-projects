    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yirtzeh_tzom_ammekha/stanza_3">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_3/1"/>חַנּוּן חֹן עַמְּךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_3/2"/>אֲשֶׁר לְשִׁמְךָ הוּא מַאֲמִין.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_3/3"/>סַנֵּגוֹר עָלַי תְּמַנֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_3/4"/>אֲשֶׁר חַטָּאתִי יַטְמִין.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_3/5"/>וְחוֹבִי בִּשְֹמֹאל יַכְמִין
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_3/6"/>זְכוּתִי יַעֲלֶה בִּימִין.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_3/7"/>וְאֵפֶר יִצְחָק יַזְמִין
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_3/8"/>אֲשֶׁר יאֹמַר כִּי הוּא זֶה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yirtzeh_tzom_ammekha/stanza_3/9"/>מָחָר יִהְיֶה הָאוֹת הַזֶּה:</tei:p>
      </tei:div>
