      <tei:div corresp="urn:x-opensiddur:text:prayer:adonai_elohei_tzevaot">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_elohei_tzevaot/1"/>יְהוָה אֱלֹהֵי צְבָאוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_elohei_tzevaot/2"/>מִי־כָמוֹךָ חֲסִין יָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_elohei_tzevaot/3"/>וֶאֱמוּנָתְךָ סְבִיבוֹתֶיךָ׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_elohei_tzevaot/4"/>אֲדֹנָי שִׁמְעָה בְקוֹלֵנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_elohei_tzevaot/5"/>תִּהְיֶינָה אָזְנֶיךָ קַשֻּׁבוֹת,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_elohei_tzevaot/6"/>לְקוֹל תַּחֲנוּנֵינוּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:daniel/9/9"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_elohei_tzevaot/7"/>לַאדֹנָי אֱלֹהֵינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_elohei_tzevaot/8"/>הָרַחֲמִים וְהַסְּלִחוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_elohei_tzevaot/9"/>כִּי מָרַדְנוּ בּוֹ׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
