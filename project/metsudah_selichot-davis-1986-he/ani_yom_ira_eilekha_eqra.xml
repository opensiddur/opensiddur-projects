      <tei:div corresp="urn:x-opensiddur:text:poem:ani_yom_ira_eilekha_eqra">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/1"/>אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/2"/>אֲנִי יוֹם אִירָא אֵלֶיךָ אֶקְרָא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/3"/>בַּל־יַעַשְׁקוּנִי זֵדִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/4"/>עוֹזְבֵי־יְקָרָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/5"/>גְּמוּל לְהָשִׁיב לָהֶם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/6"/>שֵׁב לְבַקְּרָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/7"/>דִּין רָשָׁע וְעַוָּל,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/8"/>מְלוֹאָם יִקְרָא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/9"/>הַחוֹשְׁבִים לְהַשְׁכִּיחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/10"/>שֵׁם־קֹדֶשׁ הַנִּכְבָּד.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/11"/>וּלְהַרְגִּיל שֵׁם־טֻמְאָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/12"/>נִקְלֶה וְנֶעֱבָד.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/13"/>זֶה דַרְכָּם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/14"/>טוּבֵי־עָם אִבָּד.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/15"/>חֲשֹךְ הַשְּׁאָר,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/16"/>מִכָּתְשָׁם בְּבֵית הַבָּד:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/17"/>טְרֹף טֶרֶף
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/18"/>אָדָם, לִמְּדוּ כִּמְדֻבָּר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/19"/>יַדּוּ גּוֹרָל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/20"/>כְּעַל־הֶפְקֵר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/21"/>בַּמִּדְבָּר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/22"/>כִּמְעַט כָּלוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/23"/>וְלֹא יַעַדְּרוּ דָבָר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/24"/>לוּלֵי רַחֲמֶיךָ, אָדוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/25"/>בְּחֶסֶד דַּבָּר:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/26"/>מִי־יְהַרְהֵר אַחַר מִדּוֹתֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/27"/>לְדַיְּנָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/28"/>נוֹכְחָיו לְהָשִׁיב מֵחֲלָצָיו לְזַיְּנָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/29"/>סַרְנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/30"/>וְסֹעַרְנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/31"/>וְנִשְׁמְטָה חֶרֶב הַיּוֹנָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/32"/>עִמְּךָ הַדִּין,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/33"/>וְיָדְךָ עַל־הָעֶלְיוֹנָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/34"/>פֶּן יֹאמַר יָכֹלְתִּי, בַּעַל־הַמּוֹט.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/35"/>צָרֵי יְהוּדָה יָגִילוּ כִּי־אֶמֹּט.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/36"/>קְרָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/37"/>לִמְכוּרֵי־חִנָּם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/38"/>שְׁנַת שָׁמוֹט.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/39"/>רָשָׁע הַפּוֹשֵׁט יָד,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/40"/>יִסֹּג אָחוֹר וְיִקְמֹט:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/41"/>שְׁטָרְךָ קוֹדֵם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/42"/>וְלוֹ נוֹשִׁים מְבַקְּשִׁים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/43"/>שִׁעְבּוּדָךְ לְהַרְחִיק,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/44"/>רַבּוּ צוֹרְרִים קָשִׁים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/45"/>תְּחוּמֵי סִמָּנֵי מְצָרֶיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/46"/>לַעֲקֹר מְבַקְּשִׁים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/47"/>תְּבוּאָה קִדַּשְׁתָּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/48"/>בְּלוּעָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/49"/>מְלִילוֹת וְקַשִׁים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/50"/>שֶׁפֶט רָעָה, תָּבֹא עֲלֵיהֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/51"/>וְהַאֲשִׁימֵם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/52"/>לָמוֹ עוֹלֵל, וְהִתְעוֹלֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/53"/>בְּכֹבֶד יְשִׁימֵם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/54"/>מְנָת־כּוֹסָם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/55"/>פַּחֵי מִפַּח הַגְשִׁימֵם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/56"/>הֲשִׁיבֵם שִׁבְעָתַיִם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/57"/>נְקַם־בְּרִית וְהַשְׁמֵם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/58"/>הָעִיר קִרְיַת טִירַת־נָוָךְ, נַהֲלֵנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/59"/>יָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/60"/>גְּאוּלִים דֶּרֶךְ לַעֲבֹר קְהָלֵנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/61"/>בְּךָ תוֹחַלְתֵּנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/62"/>וְאַתָּה רַב מְחוֹלְלֵנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ani_yom_ira_eilekha_eqra/63"/>נַחֲמֵנוּ נָא, יְהִי חַסְדְּךָ עָלֵינוּ:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
