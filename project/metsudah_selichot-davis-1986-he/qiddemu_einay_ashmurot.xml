      <tei:div corresp="urn:x-opensiddur:text:prayer:qiddemu_einay_ashmurot">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qiddemu_einay_ashmurot/1"/>קִדְּמוּ עֵינַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qiddemu_einay_ashmurot/2"/>אַשְׁמֻרוֹת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qiddemu_einay_ashmurot/3"/>לָשִׂיחַ בְּאִמְרָתֶךָ׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/16/1"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qiddemu_einay_ashmurot/4"/>לְאָדָם מַעַרְכֵי־לֵב.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qiddemu_einay_ashmurot/5"/>וּמֵיְהוָה מַעֲנֵה לָשׁוֹן׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/102/1"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qiddemu_einay_ashmurot/6"/>תְּפִלָּה לְעָנִי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qiddemu_einay_ashmurot/7"/>כִי־יַעֲטֹף.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qiddemu_einay_ashmurot/8"/>וְלִפְנֵי יְהוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qiddemu_einay_ashmurot/9"/>יִשְׁפֹּךְ שִׂיחוֹ׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:amos/4/13"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qiddemu_einay_ashmurot/10"/>כִּי הִנֵּה יוֹצֵר הָרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qiddemu_einay_ashmurot/11"/>וּבֹרֵא רוּחַ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qiddemu_einay_ashmurot/12"/>וּמַגִּיד לְאָדָם מַה־שֵּׂחוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qiddemu_einay_ashmurot/13"/>עֹשֵׂה שַׁחַר עֵיפָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qiddemu_einay_ashmurot/14"/>וְדֹרֵךְ עַל־בָּמֳתֵי אָרֶץ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qiddemu_einay_ashmurot/15"/>יְהוָה אֱלֹהֵי־צְבָאוֹת שְׁמוֹ׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
