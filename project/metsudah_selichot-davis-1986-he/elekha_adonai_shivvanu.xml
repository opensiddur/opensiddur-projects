      <tei:div corresp="urn:x-opensiddur:text:prayer:elekha_adonai_shivvanu">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_adonai_shivvanu/1"/>אֵלֶיךָ יְהוָה שִׁוַּעְנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_adonai_shivvanu/2"/>וּבַבֹּקֶר תְּפִלָּתֵנוּ תְקַדְּמֶךָּ׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_adonai_shivvanu/3"/>יְהוָה בֹּקֶר תִּשְׁמַע קוֹלֵנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_adonai_shivvanu/4"/>בֹּקֶר נַעֲרָךְ־לְךָ וַנְצַפֶּה׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_adonai_shivvanu/5"/>נַפְשֵׁנוּ לַאדֹנָי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_adonai_shivvanu/6"/>מִשֹּׁמְרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_adonai_shivvanu/7"/>לַבֹּקֶר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_adonai_shivvanu/8"/>שֹׁמְרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_adonai_shivvanu/9"/>לַבֹּקֶר׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/51/19"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_adonai_shivvanu/10"/>זִבְחֵי אֱלֹהִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_adonai_shivvanu/11"/>רוּחַ נִשְׁבָּרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_adonai_shivvanu/12"/>לֵב־נִשְׁבָּר וְנִדְכֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_adonai_shivvanu/13"/>אֱלֹהִים לֹא תִבְזֶה׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
