      <tei:div corresp="urn:x-opensiddur:text:prayer:el_erekh_appayim_attah">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim_attah/1"/>אֵל אֶֽרֶךְ־אַפַּֽיִם אַתָּה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim_attah/2"/>וּבַֽעַל הָרַחֲמִים נִקְרֵֽאתָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim_attah/3"/>וְדֶֽרֶךְ תְּשׁוּבָה הוֹרֵֽיתָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim_attah/5"/>גְּדֻלַּת רַחֲמֶֽיךָ וַחֲסָדֶֽיךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim_attah/6"/>תִּזְכֺּר הַיּוֹם וּבְכָל־יוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim_attah/7"/>לְזֶֽרַע יְדִידֶֽיךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim_attah/8"/>תֵּֽפֶן אֵלֵֽינוּ בְּרַחֲמִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim_attah/9"/>כִּי אַתָּה הוּא בַּֽעַל הָרַחֲמִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim_attah/10"/>בְּתַחֲנוּן וּבִתְפִלָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim_attah/11"/>פָּנֶֽיךָ נְקַדֵּם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim_attah/12"/>כְּהוֹדַֽעְתָּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim_attah/13"/>לֶעָנָיו מִקֶּֽדֶם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim_attah/14"/>מֵחֲרוֹן אַפְּךָ שׁוּב.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim_attah/15"/>כְּמוֹ בְּתוֹרָתְךָ כָּתוּב:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim_attah/16"/>וּבְצֵל כְּנָפֶֽיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim_attah/17"/>נֶחֱסֶה וְנִתְלוֹנָן.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim_attah/18"/>כְּיוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim_attah/19"/>וַיֵֽרֶד יְהֺוָה בֶּעָנָן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim_attah/20"/>תַּעֲבֺר עַל־פֶּֽשַׁע
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim_attah/21"/>וְתִמְחֶה אָשָׁם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim_attah/22"/>כְּיוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim_attah/23"/>וַַיִּתְיַצֵּב עִמּוֹ שָׁם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim_attah/24"/>תַּאֲזִין שַׁוְעָתֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim_attah/25"/>וְתַקְשִׁיב מֶֽנוּ מַאֲמַר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim_attah/26"/>כְּיוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim_attah/27"/>וַיִּקְרָא בְשֵׁם יְהֹוָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:el_erekh_appayim_attah/28"/>וְשָׁם נֶאֱמַר:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
