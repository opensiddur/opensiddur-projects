  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:habbet_mishamayim_ureeh">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:isaiah/63/15"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:habbet_mishamayim_ureeh/1"/>הַבֵּט מִשָּׁמַיִם וּרְאֵה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:habbet_mishamayim_ureeh/2"/>מִזְּבוּל קָדְשְׁךָ וְתִפְאַרְתֶּךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:habbet_mishamayim_ureeh/3"/>אַיֵּה קִנְאָתְךָ וּגְבוּרֹתֶךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:habbet_mishamayim_ureeh/4"/>הֲמוֹן מֵעֶיךָ וְרַחֲמֶיךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:habbet_mishamayim_ureeh/5"/>אֵלֵינוּ הִתְאַפָּקוּ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:habbet_mishamayim_ureeh/6"/>אַתָּה פוֹרַרְתָּ בְעָזְּךָ יָם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:habbet_mishamayim_ureeh/7"/>שִׁבַּרְתָּ רָאשֵׁי תַנִּינִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:habbet_mishamayim_ureeh/8"/>עַל־הַמָּיִם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:habbet_mishamayim_ureeh/9"/>אִם־עֲוֹנֵינוּ עָנוּ בָנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:habbet_mishamayim_ureeh/10"/>יְהֹוָה עֲשֵׂה לְמַעַן שְׁמֶךָ:</tei:p>
      </tei:div>
