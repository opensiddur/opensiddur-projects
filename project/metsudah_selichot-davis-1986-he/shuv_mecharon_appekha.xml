      <tei:div corresp="urn:x-opensiddur:text:prayer:shuv_mecharon_appekha">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuv_mecharon_appekha/1"/>שׁוּב מֵחֲרוֹן אַפֶּךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuv_mecharon_appekha/2"/>וְהִנָּחֵם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuv_mecharon_appekha/3"/>עַל־הָרָעָה לְעַמֶּךָ׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuv_mecharon_appekha/4"/>שׁוּב לְמַעַן עֲבָדֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuv_mecharon_appekha/5"/>שִׁבְטֵי נַחֲלָתֶךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuv_mecharon_appekha/6"/>שׁוּבָה יְהוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuv_mecharon_appekha/7"/>רִבְבוֹת אַלְפֵי יִשְׂרָאֵל:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/126/4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuv_mecharon_appekha/8"/>שׁוּבָה יְהוָה אֶת־שְׁבִיתֵנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuv_mecharon_appekha/9"/>כַּאֲפִיקִים בַּנֶּגֶב׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuv_mecharon_appekha/10"/>שׁוּבוּ שׁוּבוּ אָמַרְתָּ לָנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuv_mecharon_appekha/11"/>וְעַל הַתְּשׁוּבָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuv_mecharon_appekha/12"/>מֵרֹאשׁ הִבְטַחְתָּנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuv_mecharon_appekha/13"/>הֲשִׁיבֵנוּ יְהוָה אֵלֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuv_mecharon_appekha/14"/>וְנָשׁוּבָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuv_mecharon_appekha/15"/>חַדֵּשׁ יָמֵינוּ כְּקֶדֶם׃</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
