      <tei:div corresp="urn:x-opensiddur:text:prayer:shuvah_adonai_et">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_adonai_et/1"/>שׁוּבָה יְהוָה אֶת־שְׁבִיתֵנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_adonai_et/2"/>כַּאֲפִיקִים בַּנֶּגֶב׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_adonai_et/3"/>שׁוּב מֵחֲרוֹן אַפֶּךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_adonai_et/4"/>וְהִנָּחֵם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_adonai_et/5"/>עַל־הָרָעָה לְעַמֶּךָ׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/90/13"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_adonai_et/6"/>שׁוּבָה יְהוָה עַד־מָתָי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_adonai_et/7"/>וְהִנָּחֵם עַל־עֲבָדֶיךָ׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/85/5"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_adonai_et/8"/>שׁוּבֵנוּ אֱלֹהֵי יִשְׁעֵנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_adonai_et/9"/>וְהָפֵר כַּעַסְךָ עִמָּנוּ׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
