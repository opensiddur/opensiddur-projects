  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:im_avoneinu_anu">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:jeremiah/14/7"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:im_avoneinu_anu/1"/>אִם־עֲוֺנֵינוּ עָנוּ בָנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:im_avoneinu_anu/2"/>יְהוָֹה עֲשֵׂה לְמַעַן שְׁמֶךָ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:im_avoneinu_anu/3"/>יְהוָֹה אֱלֹהִים סְלַח נָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:im_avoneinu_anu/4"/>לַעֲוֹן יַעֲקֹב כִּי קָטֹן הוּא:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/44/26"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:im_avoneinu_anu/5"/>כִּי שָׁחָה לֶעָפָר נַפְשֵׁנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:im_avoneinu_anu/6"/>דָּבְקָה לָאָרֶץ בִּטְנֵנוּ׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/44/24"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:im_avoneinu_anu/7"/>עוּרָה לָמָּה תִישַׁן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:im_avoneinu_anu/8"/>אֲדֹנָי, הָקִיצָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:im_avoneinu_anu/9"/>אַל־תִּזְנַח לָנֶצַח׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/14/17"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:im_avoneinu_anu/10"/>וְעַתָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:im_avoneinu_anu/11"/>יִגְדַּל־נָא כֹּחַ אֲדֹנָי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:im_avoneinu_anu/12"/>כַּאֲשֶׁר דִּבַּרְתָּ לֵאמֹר׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
