      <tei:div corresp="urn:x-opensiddur:text:prayer:shuvah_yisrael_ad">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_yisrael_ad/1"/>שׁוּבָה יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_yisrael_ad/2"/>עַד יְהוָה אֱלֹהֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_yisrael_ad/3"/>כִּי כָשַׁלְתָּ בַּעֲוֺנֶךָ׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_yisrael_ad/4"/>יְהֹוָה אַל בְּאַפְּךָ תוֹכִיחֵנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_yisrael_ad/5"/>וְאַל בַּחֲמָתְךָ תְיַסְּרֵנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_yisrael_ad/6"/>טָבַעְנוּ בִּיוֵן מְצוּלָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_yisrael_ad/7"/>וְאֵין מָעֳמָד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_yisrael_ad/8"/>בָּאנוּ בְמַעֲמַקֵּי־מַיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_yisrael_ad/9"/>וְשִׁבֹּלֶת שְׁטָפָתְנוּ׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_yisrael_ad/10"/>הֲשִׁיבֵנוּ יְהוָה אֵלֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_yisrael_ad/11"/>וְנָשׁוּבָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:shuvah_yisrael_ad/12"/>חַדֵּשׁ יָמֵינוּ כְּקֶדֶם׃</tei:p>
