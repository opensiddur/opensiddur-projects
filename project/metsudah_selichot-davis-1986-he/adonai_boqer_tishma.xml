      <tei:div corresp="urn:x-opensiddur:text:prayer:adonai_boqer_tishma">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_boqer_tishma/1"/>יְהוָה בֹּקֶר תִּשְׁמַע קוֹלֵנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_boqer_tishma/2"/>בֹּקֶר נַעֲרָךְ־לְךָ וּנְצַפֶּה׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_boqer_tishma/3"/>קָרְבָה אֶל־נַפְשֵׁנוּ גְאָלָהּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_boqer_tishma/4"/>לְמַעַן שִׁמְךָ פְּדֵנוּ׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/85/8"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_boqer_tishma/5"/>הַרְאֵנוּ יְהוָה חַסְדֶּךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_boqer_tishma/6"/>וְיֶשְׁעֲךָ תִּתֶּן־לָנוּ׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
