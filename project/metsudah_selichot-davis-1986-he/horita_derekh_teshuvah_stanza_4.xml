    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:horita_derekh_teshuvah/stanza_4">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_4/1"/>טָעָה גִזְעוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_4/2"/>דְּמֵי־אָחִיו בְּשָׁפְכוֹ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_4/3"/>יִסַּרְתּוֹ בְּנָע וָנָד,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_4/4"/>לֶכֶת כֹּה וָכֹה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_4/5"/>כָּעֵת שָׁב־אֵלֶיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_4/6"/>וְעָזַב רֹעַ דַּרְכּוֹ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_4/7"/>לְשִׁבְעָתַיִם הֶאֱרַכְתּוֹ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_4/8"/>כָּל־מוֹצְאוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_4/9"/>בְּלִי־לְהַכּוֹ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_4/10"/>הֲשִׁיבֵנוּ יְהֹוָה אֵלֶיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:horita_derekh_teshuvah/stanza_4/11"/>וְנָשׁוּבָה:</tei:p>
      </tei:div>
