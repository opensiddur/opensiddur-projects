      <tei:div corresp="urn:x-opensiddur:text:prayer:ki_immekha_haselichah">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_immekha_haselichah/1"/>כִּי עִמְּךָ הַסְּלִיחָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_immekha_haselichah/2"/>לְמַעַן תִּוָּרֵא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_immekha_haselichah/3"/>כִּי־עִמְּךָ מְקוֹר חַיִּים,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_immekha_haselichah/4"/>בְּאוֹרְךָ נִרְאֶה־אוֹר׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_immekha_haselichah/5"/>חַיִּים וָחֶסֶד תַּעֲשֶׂה עִמָּנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_immekha_haselichah/6"/>וּפְקֻדָּתְךָ תִּשְׁמוֹר רוּחֵנוּ׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_immekha_haselichah/7"/>חַיִּים נִשְׁאַל מִמְּךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_immekha_haselichah/8"/>תִּתֶּן לָנוּ, אֹרֶךְ יָמִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ki_immekha_haselichah/9"/>עוֹלָם וָעֶד׃</tei:p>
      </tei:div>
