<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/11"/>עַל־שְׁאֵרִית־יִשְׂרָאֵל,
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_6"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:poem:zekhor_berit_avraham/selichot_tzom_gedaliah"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/60"/>וְהוֹשִׁיעֵנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/61"/>לְמַעַן שְׁמֶךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/62"/>פְּעֻלַּת רִאשׁוֹנִים חֲסִידֶךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/63"/>זְכוֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/64"/>עֹז יְדִידֶיךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/65"/>צַוֵּה יְשׁוּעַת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/66"/>עֲבָדֶיךָ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/67"/>גַּלֵּה כָּמוּס סוֹדֶיךָ:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_6"/>
<j:conditional xml:id="variant_7"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:poem:zekhor_berit_avraham/selichot_tzom_gedaliah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
