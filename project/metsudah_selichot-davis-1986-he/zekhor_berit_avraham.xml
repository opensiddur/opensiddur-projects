      <tei:div corresp="urn:x-opensiddur:text:poem:zekhor_berit_avraham">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/1"/>זְכֹר בְּרִית־אַבְרָהָם,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/2"/>וַעֲקֵדַת־יִצְחָק.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/3"/>וְהָשֵׁב שְׁבוּת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/4"/>אָהֳלֵי־יַעֲקֹב,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/5"/>וְהוֹשִׁיעֵנוּ לְמַעַן שְׁמֶךָ:
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:poem:zekhor_berit_avraham/selichot_tzom_gedaliah"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/56"/>אַשְׁמָתֵנוּ כִּי רַבָּה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/57"/>בֵּית מִקְדָּשֵׁנוּ לְחוֹבָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/58"/>בָּגַדְנוּ בִּיתֵרָה חִבָּה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/59"/>וַתְּהִי לְהֶפֶךְ סִבָּה.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:poem:zekhor_berit_avraham/selichot_tzom_gedaliah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/6"/>אָבַדְנוּ מֵאֶרֶץ־טוֹבָה בְּחִפָּזוֹן.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:poem:zekhor_berit_avraham/selichot_tzom_gedaliah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/7"/>אָרְכוּ הַיָּמִים וּדְבַר כָּל־חָזוֹן.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:poem:zekhor_berit_avraham/selichot_tzom_gedaliah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/8"/>בְּיִשְׂרָאֵל חָדְלוּ פְרָזוֹן.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:poem:zekhor_berit_avraham/selichot_tzom_gedaliah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/9"/>בְּמַשְׁמַנֵּנוּ שֻׁלַּח רָזוֹן.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_5"/>
