<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/35"/>וְאִמָּהוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/36"/>וְהַשְּׁבָטִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/37"/>רַחֲמֶיךָ וַחֲסָדֶיךָ בִּרְבוֹת־עִתִּים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/38"/>יָהּ זְכֹר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/39"/>לְמֻכִּים וְנִמְרָטִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/40"/>וְעָלֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/41"/>כָּל־הַיּוֹם נִשְׁחָטִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/42"/>וְשׁוּב בְרַחֲמִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/43"/>עַל־שְׁאֵרִית־יִשְׂרָאֵל,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/44"/>וְהוֹשִׁיעֵנוּ לְמַעַן שְׁמֶךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/45"/>דּוֹרֵשׁ דָּמִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/46"/>דּוֹן דִּינֵנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/47"/>הָשֵׁב שִׁבְעָתַיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/48"/>אֶל־חֵיק־מְעַנֵּינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/49"/>חִנָּם נִמְכַּרְנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/50"/>וְלֹא בְכֶסֶף פְּדֵנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/51"/>זְקֹף בֵּית־מִקְדָּשְׁךָ הַשָּׁמֵם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/52"/>לְעֵינֵינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/53"/>וְהָשֵׁב שְׁבוּת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/54"/>אָהֳלֵי־יַעֲקֹב,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/55"/>וְהוֹשִׁיעֵנוּ לְמַעַן שְׁמֶךָ:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>