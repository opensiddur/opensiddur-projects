<j:endConditional target="#variant_15"/>
<j:conditional xml:id="variant_16"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:poem:zekhor_berit_avraham/selichot_tzom_gedaliah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zekhor_berit_avraham/22"/>וְכָל־מַחֲמַדֶּיהָ טְבוּעוֹת וּגְנוּזוֹת.
