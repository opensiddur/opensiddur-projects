    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:veattah_adoneinu_hamelekh">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_adoneinu_hamelekh/1"/>וְאַתָּה אֲדוֹנֵינוּ הַמֶּלֶךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_adoneinu_hamelekh/2"/>עֵינֵי כָל יִשְׂרָאֵל עָלֶיךָ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_adoneinu_hamelekh/3"/>יְהוָֹה מֶלֶךְ יְהוָֹה מָלָךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_adoneinu_hamelekh/4"/>יְהוָֹה יִמְלֹךְ לְעוֹלָם וָעֶד:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_adoneinu_hamelekh/5"/>אַתָּה הוּא מַלְכֵּנוּ מִקֶּדֶם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_adoneinu_hamelekh/6"/>פֹּעֵל יְשׁוּעוֹת בְּקֶרֶב הָאָרֶץ׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_adoneinu_hamelekh/7"/>אַתָּה־הוּא מַלְכֵּנוּ אֱלֹהִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_adoneinu_hamelekh/8"/>צַוֵּה יְשׁוּעוֹת יַעֲקֹב׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:zechariah/14/9"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_adoneinu_hamelekh/9"/>וְהָיָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_adoneinu_hamelekh/10"/>יְהוָֹה לְמֶלֶךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_adoneinu_hamelekh/11"/>עַל־כָּל־הָאָרֶץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_adoneinu_hamelekh/12"/>בַּיּוֹם הַהוּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_adoneinu_hamelekh/13"/>יִהְיֶה יְהוָֹה אֶחָד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veattah_adoneinu_hamelekh/14"/>וּשְׁמוֹ אֶחָד׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
