    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yoshev_beseter_elyon_maginni_vetzinnati/stanza_8">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_8/1"/>קוֹלִי יֶעֱרַב נָא,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_8/2"/>כְּמֵחִים תּוֹךְ צִיּוֹנָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_8/3"/>לְטוֹבָה הִפָּנֶה־נָּא,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_8/4"/>לְהַמְצִיאֵנִי חֲנִינָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_8/5"/>כִּי אֶל־מִי אֶפְנֶה־נָּא,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_8/6"/>בְּאֵין מַשְׁעֵן וּמַשְׁעֵנָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_8/7"/>לִמְיַחֲלֶיךָ סְלַח־נָא,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_8/8"/>הַשְׁמִיעֵם סָלַחְתִּי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_8/9"/>נַפְשִׁי בִּשְׁאֵלָתִי,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_8/10"/>וְעַמִּי בְּבַקָּשָׁתִי:</tei:p>
