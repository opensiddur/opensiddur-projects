  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hatteh_elohai_oznekha">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatteh_elohai_oznekha/1"/>הַטֵּה אֱלֹהַי אָזְנְךָ וּשְׁמָע,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatteh_elohai_oznekha/5"/>פְּקַח עֵינֶֽיךָ וּרְאֵה שֹׁמְמֹתֵֽינוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatteh_elohai_oznekha/4"/>וְהָעִיר אֲשֶׁר נִקְרָא שִׁמְךָ עָלֶֽיהָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatteh_elohai_oznekha/6"/>כִּי לֹא עַל צִדְקֹתֵֽינוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatteh_elohai_oznekha/7"/>אֲנַֽחְנוּ מַפִּילִים תַּחֲנוּנֵֽינוּ לְפָנֶֽיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatteh_elohai_oznekha/8"/>כִּי עַל רַחֲמֶֽיךָ הָרַבִּים:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:daniel/9/19"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatteh_elohai_oznekha/9"/>אֲדֹנָי שְׁמָֽעָה, אֲדֹנָי סְלָֽחָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatteh_elohai_oznekha/10"/>אֲדֹנָי הַקְשִֽׁיבָה וַעֲשֵׂה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatteh_elohai_oznekha/11"/>אַל תְּאַחַר.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatteh_elohai_oznekha/12"/>לְמַעַנְךָ אֱלֹהַי,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatteh_elohai_oznekha/13"/>כִּי שִׁמְךָ נִקְרָא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatteh_elohai_oznekha/14"/>עַל עִירְךָ וְעַל עַמֶּֽךָ:</tei:p>
      </tei:div>
