      <tei:div corresp="urn:x-opensiddur:text:poem:miqveh_yisrael_moshio_beet_tzarah">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/1"/>מִקְוֵה יִשְֹרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/2"/>מוֹשִׁיעוֹ בְּעֵת־צָרָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/3"/>שׁוֹמְרוֹ וְצִלּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/4"/>וּמַצִּילוֹ בְּיוֹם־עֶבְרָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/5"/>הִמָּלֵא רַחֲמִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/6"/>עַל־עֲנִיָּה סוֹעֲרָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/7"/>בְּדוּדָה וּשְׁדוּדָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/8"/>כְּאוּבָה וּצְעוּרָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/9"/>רְמוּסָה בְּיַד־צַר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/10"/>וּבֶעָפָר מְעֻפָּרָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/11"/>שְׁכוּלָה וְגַלְמוּדָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/12"/>גּוֹלָה וְסוּרָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/13"/>מֵאֲרָיוֹת וְדֻבִּים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/14"/>דְּרוּסָה וּשְׁבוּרָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/15"/>וּכְצֹאן בְּלִי־רוֹעֶה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/16"/>תּוֹעָה וּפְזוּרָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/17"/>אָדוֹן עַד־מָתַי
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/18"/>לֹא־תַבִּיט בַּצָּרָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/19"/>לָמָּה לָנֶצַח תַּעַזְבֶנָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/20"/>בְּיַד־עוֹכְרָהּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/21"/>בְּרַחֲמֶיךָ הוֹצִיאָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/22"/>מֵאֲפֵלָה לְאוֹרָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/23"/>אַל־תִּנְאַץ לְמַעַן־שִׁמְךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/24"/>כַּחַמָּה בָּרָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/25"/>בָּחַרְתָּ מִכָּל־עָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/26"/>בְּשָֹפָה בְרוּרָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/27"/>שׁוּר־נָא בְּעָנְיָהּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/28"/>וְנַעֲרָה מֵעֲפָרָהּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/29"/>לְחַם לוֹחֲמָה וּצְרֹר צוֹרְרָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/30"/>וּנְקֹם נִקְמָתָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/31"/>וְנִקְמַת בֵּית־הַבְּחִירָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/32"/>מִגְּרוּ וּפִגְּרוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/33"/>וְהִסִּיקוּ־בוֹ הַבְעָרָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/34"/>חִלְּלוּ וְנִאֲצוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/35"/>שֵׁם־הַנִּכְבָּד וְהַנּוֹרָא.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/36"/>זְכֹר חֶרְפַּת־נָבָל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/37"/>חֵרֵף בַּאֲמִירָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/38"/>קוּמָה יְהֹוָה בְּאַפֶּךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/39"/>וְהִנָּשֵֹא לְהִתְגַּבְּרָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/40"/>וְאַל־תִּשְׁכַּח
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/41"/>קוֹל־צוֹרְרֶיךָ עוֹלֶה בִּתְדִירָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/42"/>אַבֵּד וְגַדַּע מַלְכוּת אֲרוּרָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/43"/>מְבַשֵּׂר־שָׁלוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/44"/>לְעַמְּךָ תִּשְׁלַח מְהֵרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/45"/>צִיוֹן לְנַחֵם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/46"/>וּפִרְצוֹתֶיהָ לְגָדְרָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/47"/>כִּי־לְךָ יְהֹוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:miqveh_yisrael_moshio_beet_tzarah/48"/>הַגְּדֻלָּה וְהַגְּבוּרָה:</tei:p>
      </tei:div>
    </tei:body>
