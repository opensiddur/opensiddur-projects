  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:yisrael_nosha_badonai">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:isaiah/45/17"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yisrael_nosha_badonai/1"/>יִשְׂרָאֵל נוֹשַׁע בַּיהוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yisrael_nosha_badonai/2"/>תְּשׁוּעַת עוֹלָמִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yisrael_nosha_badonai/3"/>לֹא־תֵבֹשׁוּ וְלֹא־תִכָּלְמוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yisrael_nosha_badonai/4"/>עַד־עוֹלְמֵי עַד׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yisrael_nosha_badonai/5"/>מִקְוֵה יִשְׂרָאֵל יְהוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yisrael_nosha_badonai/6"/>מוֹשִׁיעוֹ בְּעֵת צָרָה:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:jeremiah/17/13"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yisrael_nosha_badonai/7"/>מִקְוֵה יִשְׂרָאֵל יְהוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yisrael_nosha_badonai/8"/>כָּל־עֹזְבֶיךָ יֵבֹשׁוּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:jeremiah/31/17"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yisrael_nosha_badonai/9"/>וְיֵשׁ־תִּקְוָה לְאַחֲרִיתֵךְ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yisrael_nosha_badonai/10"/>נְאֻם־יְהוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yisrael_nosha_badonai/11"/>וְשָׁבוּ בָנִים לִגְבוּלָם׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/40/2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yisrael_nosha_badonai/12"/>קַוֺּה קִוִּיתִי יְהוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yisrael_nosha_badonai/13"/>וַיֵּט אֵלַי וַיִּשְׁמַע שַׁוְעָתִי׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yisrael_nosha_badonai/14"/>לְךָ אֲדֹנָי הַצְּדָקָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yisrael_nosha_badonai/15"/>וְלָנוּ בֹּשֶׁת הַפָּנִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yisrael_nosha_badonai/16"/>כַּיּוֹם הַזֶּה:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/51/20"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yisrael_nosha_badonai/17"/>הֵיטִיבָה בִרְצוֹנְךָ אֶת־צִיּוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yisrael_nosha_badonai/18"/>תִּבְנֶה חוֹמוֹת יְרוּשָׁלִָם׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
