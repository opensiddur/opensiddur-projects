      <tei:div corresp="urn:x-opensiddur:text:prayer:zivchei_elohim_rucha_nishbarah">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha_nishbarah/1"/>זִבְחֵי אֱלֹהִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha_nishbarah/2"/>רוּחַ נִשְׁבָּרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha_nishbarah/3"/>לֵב־נִשְׁבָּר וְנִדְכֶּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha_nishbarah/4"/>אֱלֹהִים לֹא תִבְזֶה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha_nishbarah/5"/>תִּתֵּן אֱמֶת לְיַעֲקֹב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha_nishbarah/6"/>חֶסֶד לְאַבְרָהָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha_nishbarah/7"/>אֲשֶׁר־נִשְׁבַּעְתָּ לַאֲבֹתֵינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha_nishbarah/8"/>מִימֵי קֶדֶם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha_nishbarah/9"/>וְחֶסֶד יְהוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha_nishbarah/10"/>מֵעוֹלָם וְעַד עוֹלָם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha_nishbarah/11"/>עַל יְרֵאָיו,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha_nishbarah/12"/>וְצִדְקָתוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha_nishbarah/13"/>לִבְנֵי בָנִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha_nishbarah/14"/>קָרוֹב יְהוָה לְנִשְׁבְּרֵי־לֵב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:zivchei_elohim_rucha_nishbarah/15"/>וְאֶת־דַּכְּאֵי־רוּחַ יוֹשִׁיעַ:</tei:p>
      </tei:div>
    </tei:body>
