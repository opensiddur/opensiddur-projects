      <tei:div corresp="urn:x-opensiddur:text:poem:leeineinu_ashuqu_amalenu">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:leeineinu_ashuqu_amalenu/1"/>לְעֵינֵינוּ עָשְׁקוּ עֲמָלֵנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:leeineinu_ashuqu_amalenu/2"/>מְמֻשָּׁךְ וּמְמוֹרָט מִמֶּנּוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:leeineinu_ashuqu_amalenu/3"/>נָתְנוּ עֻלָּם עָלֵינוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:leeineinu_ashuqu_amalenu/4"/>סָבַלְנוּ עַל־שִׁכְמֵנוּ.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:lamentations/5/8"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:leeineinu_ashuqu_amalenu/5"/>עֲבָדִים מָשְׁלוּ בָנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:leeineinu_ashuqu_amalenu/6"/>פּוֹרֵק אֵין מִיָּדָם.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:leeineinu_ashuqu_amalenu/7"/>צָרוֹת רַבּוֹת סְבָבוּנוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:leeineinu_ashuqu_amalenu/8"/>קְרָאנוּךָ יְהוָֹה אֱלֹהֵינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:leeineinu_ashuqu_amalenu/9"/>רָחַקְתָּ מִמֶּנּוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:leeineinu_ashuqu_amalenu/10"/>בַּעֲוֹנֵינוּ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:leeineinu_ashuqu_amalenu/11"/>שַׁבְנוּ מֵאַחֲרֶיךָ,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:leeineinu_ashuqu_amalenu/12"/>תָּעִינוּ וְאָבָדְנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:leeineinu_ashuqu_amalenu/13"/>וַעֲדַיִן לֹא שַׁבְנוּ מִטָּעוּתֵנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:leeineinu_ashuqu_amalenu/14"/>וְהֵאֵיךְ נָעִיז פָּנֵינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:leeineinu_ashuqu_amalenu/15"/>וְנַקְשֶׁה עָרְפֵּנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:leeineinu_ashuqu_amalenu/16"/>לוֹמַר לְפָנֶיךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:leeineinu_ashuqu_amalenu/17"/>יְהֹוָה אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:leeineinu_ashuqu_amalenu/18"/>צַדִּיקִים אֲנַחְנוּ וְלֹא חָטָאנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:leeineinu_ashuqu_amalenu/19"/>אֲבָל אֲנַחְנוּ וַאֲבוֹתֵינוּ חָטָאנוּ:</tei:p>
      </tei:div>
