  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hatzur_tamim_paolo">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:deuteronomy/32/4"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatzur_tamim_paolo/1"/>הַצּוּר תָּמִים פָּעֳלוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatzur_tamim_paolo/2"/>כִּי כָל־דְּרָכָיו מִשְׁפָּט
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatzur_tamim_paolo/3"/>אֵל אֱמוּנָה וְאֵין עָוֶל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatzur_tamim_paolo/4"/>צַדִּיק וְיָשָׁר הוּא׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/119/91"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatzur_tamim_paolo/5"/>לְמִשְׁפָּטֶיךָ עָמְדוּ הַיּוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatzur_tamim_paolo/6"/>כִּי הַכֹּל עֲבָדֶיךָ׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/81/4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatzur_tamim_paolo/7"/>תִּקְעוּ בַחֹדֶשׁ שׁוֹפָר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatzur_tamim_paolo/8"/>בַּכֵּסֶה לְיוֹם חַגֵּנוּ׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/81/5"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatzur_tamim_paolo/9"/>כִּי חֹק לְיִשְׂרָאֵל הוּא
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatzur_tamim_paolo/10"/>מִשְׁפָּט לֵאלֹהֵי יַעֲקֹב׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/36/7"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatzur_tamim_paolo/11"/>צִדְקָתְךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatzur_tamim_paolo/12"/>כְּהַרְרֵי־אֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatzur_tamim_paolo/13"/>מִשְׁפָּטֶךָ תְּהוֹם רַבָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hatzur_tamim_paolo/14"/>אָדָם־וּבְהֵמָה תוֹשִׁיעַ יְהוָה׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
