      <tei:div corresp="urn:x-opensiddur:text:prayer:elekha_adonai_nafshenu">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_adonai_nafshenu/1"/>אֵלֶיךָ יְהוָה נַפְשֵׁנוּ נִשָּׂא׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_adonai_nafshenu/2"/>נִשָּׂא לְבָבֵנוּ אֶל־כַּפָּיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_adonai_nafshenu/3"/>אֶל־אֵל בַּשָּׁמָיִם׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_adonai_nafshenu/4"/>כִּי־עָלֶיךָ הֹרַגְנוּ כָל־הַיּוֹם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_adonai_nafshenu/5"/>נֶחְשַׁבְנוּ כְּצֹאן טִבְחָה׃
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_adonai_nafshenu/6"/>עוּרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_adonai_nafshenu/7"/>לָמָּה תִישַׁן אֲדֹנָי,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_adonai_nafshenu/8"/>הָקִיצָה אַל־תִּזְנַח לָנֶצַח׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/44/25"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_adonai_nafshenu/9"/>לָמָּה־פָנֶיךָ תַסְתִּיר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_adonai_nafshenu/10"/>תִּשְׁכַּח עָנְיֵנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_adonai_nafshenu/11"/>וְלַחֲצֵנוּ׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_adonai_nafshenu/12"/>כִּי שָׁחָה לֶעָפָר נַפְשֵׁנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_adonai_nafshenu/13"/>דָּבְקָה לָאָרֶץ בִּטְנֵנוּ׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/44/27"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_adonai_nafshenu/14"/>קוּמָה עֶזְרָתָה לָּנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:elekha_adonai_nafshenu/15"/>וּפְדֵנוּ לְמַעַן חַסְדֶּךָ׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
