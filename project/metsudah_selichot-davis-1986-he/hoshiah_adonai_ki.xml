      <tei:div corresp="urn:x-opensiddur:text:prayer:hoshiah_adonai_ki">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshiah_adonai_ki/1"/>הוֹשִׁיעָה יְהוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshiah_adonai_ki/2"/>כִּי־גָמַר חָסִיד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshiah_adonai_ki/3"/>כִּי־פַסּוּ אֱמוּנִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshiah_adonai_ki/4"/>מִבְּנֵי אָדָם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshiah_adonai_ki/5"/>אָבַד חָסִיד מִן־הָאָרֶץ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshiah_adonai_ki/6"/>וְיָשָׁר בָּאָדָם אָיִן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshiah_adonai_ki/7"/>רְאֵה כִּי־אֵין אִישׁ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshiah_adonai_ki/8"/>וְהִשְׁתּוֹמֵם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshiah_adonai_ki/9"/>כִּי אֵין מַפְגִּיעַ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshiah_adonai_ki/10"/>אַתָּה־הוּא מַלְכֵּנוּ אֱלֹהִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshiah_adonai_ki/11"/>צַוֵּה יְשׁוּעוֹת יַעֲקֹב׃
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/131/3"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshiah_adonai_ki/12"/>יַחֵל יִשְׂרָאֵל אֶל־יְהוָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hoshiah_adonai_ki/13"/>מֵעַתָּה וְעַד־עוֹלָם׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
