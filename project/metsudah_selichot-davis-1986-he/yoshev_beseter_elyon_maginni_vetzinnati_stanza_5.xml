      <tei:div corresp="urn:x-opensiddur:text:poem:yoshev_beseter_elyon_maginni_vetzinnati/stanza_5">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_5/1"/>זֶה אֵלִי הוֹשִׁיעָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_5/2"/>וּזְכֻיּוֹת הַכְרִיעָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_5/3"/>וּמִזְּבוּלְךָ הוֹפִיעָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_5/4"/>חֹן סֹעֲרָה וְסֹעָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_5/5"/>וּמְלָשְׁנִי הַבְלִיעָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_5/6"/>צֹאנְךָ מִלְּהַפְשִׁיעָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_5/7"/>פֶּן אֶרְאֶה בָרָעָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_5/8"/>בְּאָבְדַן מוֹלַדְתִּי.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yoshev_beseter_elyon_maginni_vetzinnati/stanza_5/9"/>נַפְשִׁי בִּשְׁאֵלָתִי,</tei:p>
      </tei:div>
    </tei:body>
