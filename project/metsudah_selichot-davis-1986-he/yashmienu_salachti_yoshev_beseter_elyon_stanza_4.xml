    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yashmienu_salachti_yoshev_beseter_elyon/stanza_4">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_4/1"/>שׁוֹאֵל חֶסֶד בְּהִוָּסֵד,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_4/2"/>הִנְּנִי תֹאמַר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_4/3"/>מָרוּת יֶצֶר הִבָּצֵר,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_4/4"/>קָבוּעַ כְּבַמַּסְמָר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_4/5"/>וּלְצַוָּאר כְּמוֹ סַוָּאר,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_4/6"/>הוּטַל לְמִשְׁמָר.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_4/7"/>וּמִי אָזַר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_4/8"/>זֵר לְזָר,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_4/9"/>וּמִי אַכְזָר כִּי יְעִירֶנּוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:yashmienu_salachti_yoshev_beseter_elyon/stanza_4/10"/>יְהֹוָה הֱיֵה עוֹזֵר לָנוּ:</tei:p>
