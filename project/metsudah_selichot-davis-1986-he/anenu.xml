      <tei:div corresp="urn:x-opensiddur:text:prayer:anenu">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/1"/>עֲנֵנוּ יְהֹוָה עֲנֵנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/2"/>עֲנֵֽנוּ אֱלֹהֵֽינוּ עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/3"/>עֲנֵֽנוּ אָבִֽינוּ עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/4"/>עֲנֵֽנוּ בּוֹרְאֵֽנוּ עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/5"/>עֲנֵנוּ גּוֹאֲלֵֽנוּ עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/6"/>עֲנֵנוּ דוֹרְשֵׁנוּ עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/7"/>עֲנֵנוּ הָאֵל הַנֶּאֱמָן עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/8"/>עֲנֵנוּ וָתִיק וְחָסִיד
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/9"/>עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/10"/>עֲנֵֽנוּ זַךְ וְיָשָׁר עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/11"/>עֲנֵֽנוּ חַי וְקַיָּם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/12"/>עֲנֵֽנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/13"/>עֲנֵֽנוּ טוֹב וּמֵטִיב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/14"/>עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/15"/>עֲנֵנוּ יוֹדֵֽעַ יֶֽצֶר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/16"/>עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/17"/>עֲנֵֽנוּ כּוֹבֵשׁ כְּעָסִים עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/18"/>עֲנֵֽנוּ לוֹבֵשׁ צְדָקוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/19"/>עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/20"/>עֲנֵֽנוּ מֶֽלֶךְ מַלְכֵי הַמְלָכִים עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/21"/>עֲנֵֽנוּ נוֹרָא וְנִשְׂגָּב
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/22"/>עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/23"/>עֲנֵֽנוּ סוֹלֵחַ וּמוֹחֵל עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/24"/>עֲנֵֽנוּ עוֹנֶה בְּעֵת צָרָה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/25"/>עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/26"/>עֲנֵֽנוּ פּוֹדֶה וּמַצִּיל עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/27"/>עֲנֵֽנוּ צַדִּיק וְיָשָׁר עֲנֵנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/28"/>עֲנֵֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/29"/>קָרוֹב לְקוֹרְאָיו
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/30"/>עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/31"/>עֲנֵֽנוּ רַחוּם וְחַנּוּן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/32"/>עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/33"/>עֲנֵֽנוּ שׁוֹמֵֽעַ אֶל אֶבְיוֹנִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/34"/>עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/35"/>עֲנֵֽנוּ תּוֹמֵךְ תְּמִימִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/36"/>עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/37"/>עֲנֵֽנוּ אֱלֹהֵי אֲבוֹתֵֽינוּ עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/38"/>עֲנֵֽנוּ אֱלֹהֵי אַבְרָהָם עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/39"/>עֲנֵֽנוּ פַּֽחַד יִצְחָק עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/40"/>עֲנֵֽנוּ אֲבִיר יַעֲקֹב עֲנֵנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/41"/>עֲנֵֽנוּ עֶזְרַת הַשְּׁבָטִים עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/42"/>עֲנֵֽנוּ מִשְׂגַּב אִמָּהוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/43"/>עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/44"/>עֲנֵנוּ קָשֶׁה לִכְעוֹס
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/45"/>עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/46"/>עֲנֵנוּ רַךְ לִרְצוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/47"/>עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/48"/>עֲנֵֽנוּ עוֹנֶה בְּעֵת רָצוֹן
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/49"/>עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/50"/>עֲנֵֽנוּ אֲבִי יְתוֹמִים עֲנֵֽנוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/51"/>עֲנֵֽנוּ דַיַּן אַלְמָנוֹת
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anenu/52"/>עֲנֵֽנוּ:</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
