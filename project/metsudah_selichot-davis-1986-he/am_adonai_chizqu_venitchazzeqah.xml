      <tei:div corresp="urn:x-opensiddur:text:poem:am_adonai_chizqu_venitchazzeqah">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/1"/>עַם יְהֹוָה חִזְקוּ וְנִתְחַזְּקָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/2"/>וְקִרְאוּ אֶל אֱלֹהִים בְּחָזְקָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/3"/>אִישׁ אָוֶן יִתְוַדֶּה אֲשָׁמֵהוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/4"/>וְיָשֹׁב אֶל יְהֹוָה וִירַחֲמֵהוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/5"/>לִקְרֹא לְלֹא יָנוּם וְלֹא־יִישָׁן.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/6"/>שׁוֹמֵר יִשְׂרָאֵל
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/7"/>עוּרָה לָמָּה־תִישָׁן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/8"/>יוֹשֶׁר זְכֹר וְכִשְׁרוֹן מַעֲשֶֹה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/9"/>וַיהֹוָה הַטּוֹב בְּעֵינָיו יַעֲשֶֹה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/10"/>הִבְטִיחָנוּ אֱלֹהִים אֱמֶת.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/11"/>כִּי לֹא אֶחְפֹּץ בְּמוֹת הַמֵּת:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/12"/>בְּהִמָּצְאוֹ דִּרְשׁוּהוּ בְּתַחַן לִקְרֹב.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/13"/>קְרָאֻהוּ בִּהְיוֹתוֹ קָרוֹב:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/14"/>רַצּוּהוּ חַלּוּהוּ בְּאֵימָה עִבְדוּהוּ.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/15"/>כָּל זֶרַע יַעֲקֹב כַּבְּדוּהוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/16"/>שְׁקֹד דַּלְתוֹת אֶרֶךְ אַפַּיִם.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/17"/>נִשָּׂא לְבָבֵנוּ אֶל כַּפָּיִם:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/18"/>מִי יוֹדֵעַ רַצּוֹת וְיוֹאֵל.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/19"/>הִכּוֹן לִקְרַאת אֱלֹהֶיךָ יִשְֹרָאֵל:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/20"/>עִרְכוּ שֶׁוַע וּתְפִלָּה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/21"/>לְצָרָה.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/22"/>קַדְּשׁוּ צוֹם קִרְאוּ עֲצָרָה:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/23"/>יְבַקֵּשׁ יְפַלֵּל אֱלֹהִים עוֹבֵד.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/24"/>וְשָׁב מֵחֲרוֹן־אַפּוֹ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/25"/>וְלֹא נֹאבֵד:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/26"/>הֲיִרְצֶה שַׁי וָתֶשֶׁר
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/27"/>מֵהַשְׁמֵן.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/28"/>בְּרִבְבוֹת נַחֲלֵי שָׁמֶן:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/29"/>חֲפֹץ שְׁמֹעַ מִתַּקְרוּבַת עוֹלִים.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/30"/>לְהַקְשִׁיב מֵחֵלֶב אֵילִים:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/31"/>זְכוּת לַמֵּד וְיַשֵּׁר עָקֹב.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/32"/>זְכֹר אֵלֶּה לְיַעֲקֹב:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/33"/>קְחוּ עִמָּכֶם דְּבָרִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:am_adonai_chizqu_venitchazzeqah/34"/>וְשָֹפָה בְּשִׁלּוּם פָּרִים:</tei:p>
      </tei:div>
