      <tei:div corresp="urn:x-opensiddur:text:prayer:adonai_boqer_tishma_qoli/repeat">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_boqer_tishma_qoli/repeat/1"/>כְּרַחֵם אָב עַל בָּנִים
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_boqer_tishma_qoli/repeat/2"/>כֵּן תְּרַחֵם יְהֹוָה עָלֵֽינוּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/3/9"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_boqer_tishma_qoli/repeat/3"/>לַיהֹוָה הַיְשׁוּעָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_boqer_tishma_qoli/repeat/4"/>עַל עַמְּךָ בִרְכָתֶֽךָ סֶּֽלָה:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_boqer_tishma_qoli/repeat/5"/>יְהֹוָה צְבָאוֹת עִמָּֽנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_boqer_tishma_qoli/repeat/6"/>מִשְׂגָּב לָֽנוּ, אֱלֹהֵי יַעֲקֹב סֶֽלָה:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/84/13"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_boqer_tishma_qoli/repeat/7"/>יְהֹוָה צְבָאוֹת,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_boqer_tishma_qoli/repeat/8"/>אַשְׁרֵי אָדָם בֹּֽטֵֽחַ בָּךְ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/20/10"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_boqer_tishma_qoli/repeat/9"/>יְהֹוָה הוֹשִֽׁיעָה,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:adonai_boqer_tishma_qoli/repeat/10"/>הַמֶּֽלֶךְ יַעֲנֵֽנוּ בְיוֹם קָרְאֵנוּ:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
