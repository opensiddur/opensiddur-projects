    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:af_orach_mishpatekha">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:isaiah/26/8"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:af_orach_mishpatekha/1"/>אַף אֹרַח מִשְׁפָּטֶיךָ יְהוָֹה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:af_orach_mishpatekha/2"/>קִוִּינוּךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:af_orach_mishpatekha/3"/>לְשִׁמְךָ וּלְזִכְרְךָ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:af_orach_mishpatekha/4"/>תַּאֲוַת־נָפֶשׁ׃
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:af_orach_mishpatekha/5"/>קַוֹּה קִוִּינוּ יְהוָֹה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:af_orach_mishpatekha/6"/>וַיֵּט אֵלֵינוּ וַיִּשְׁמַע שַׁוְעָתֵנוּ:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:af_orach_mishpatekha/7"/>וְעַתָּה מַה קִּוִּינוּ יְהוָֹה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:af_orach_mishpatekha/8"/>תּוֹחַלְתֵּנוּ לְךָ הִיא:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:af_orach_mishpatekha/9"/>אַךְ אֶל אֱלֹהִים דּוּמִיָּה נַפְשֵׁנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:af_orach_mishpatekha/10"/>מִמֶּנּוּ יְשׁוּעָתֵנוּ:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/42/2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:af_orach_mishpatekha/11"/>כְּאַיָּל תַּעֲרֹג
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:af_orach_mishpatekha/12"/>עַל אֲפִיקֵי מָיִם
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:af_orach_mishpatekha/13"/>כֵּן נַפְשֵׁנוּ תַעֲרוֹג
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:af_orach_mishpatekha/14"/>אֵלֶיךָ אֱלֹהִים:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/23/6"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:af_orach_mishpatekha/15"/>אַךְ טוֹב וָחֶסֶד יִרְדְּפוּנוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:af_orach_mishpatekha/16"/>כָּל יְמֵי חַיֵּינוּ
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:af_orach_mishpatekha/17"/>וְשַׁבְנוּ בְּבֵית יְהוָֹה
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:af_orach_mishpatekha/18"/>לְאֹרֶךְ יָמִים:
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
