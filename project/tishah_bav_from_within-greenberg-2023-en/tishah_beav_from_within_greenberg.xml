  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:tishah_beav_from_within_greenberg">
        <tei:head>Tishah b'Av from Within, a prayer-poem by Todd Greenberg</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tishah_beav_from_within_greenberg/1"/>
        <tei:lg>
          <tei:l>within the broken walls of the temple lives</tei:l>
          <tei:l>the history of the destructions</tei:l>
          <tei:l>honor, remember, mourn</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tishah_beav_from_within_greenberg/2"/>
        <tei:lg>
          <tei:l>we will most likely not</tei:l>
          <tei:l>build that third temple for the</tei:l>
          <tei:l>re-building now is from within</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tishah_beav_from_within_greenberg/3"/>
        <tei:lg>
          <tei:l>deconstruct your temples,</tei:l>
          <tei:l>the ones that don’t work</tei:l>
          <tei:l>honor, remember, mourn</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tishah_beav_from_within_greenberg/4"/>
        <tei:lg>
          <tei:l>reconstructing the self</tei:l>
          <tei:l>build the internal tabernacle</tei:l>
          <tei:l>that cannot be taken away</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tishah_beav_from_within_greenberg/5"/>
        <tei:lg>
          <tei:l>help others to build their own</tei:l>
          <tei:l>temples, there own relationship</tei:l>
          <tei:l>with the Infinite</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:tishah_beav_from_within_greenberg/6"/>
        <tei:lg>
          <tei:l>listen to your Torah</tei:l>
          <tei:l>resurrection and</tei:l>
          <tei:l>new beginnings will come</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
