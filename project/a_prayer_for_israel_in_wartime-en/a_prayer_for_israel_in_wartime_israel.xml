  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_prayer_for_israel_in_wartime_israel">
        <tei:head>A Prayer for Israel in Wartime, in simplified Hebrew (Masorti Movement in Israel 2023)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_israel_in_wartime_israel/1"/>
        <tei:lg>
          <tei:l>May God who blessed our forefathers (Abraham, Isaac and Jacob)</tei:l>
          <tei:l>and our foremothers (Sarah, Rebecca, Rachel and Leah),</tei:l>
          <tei:l>bless the people living in our country</tei:l>
          <tei:l>whose enemies have been attacking them constantly with rockets.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_israel_in_wartime_israel/2"/>
        <tei:lg>
          <tei:l>God, help us to be strong against our enemies.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_israel_in_wartime_israel/3"/>
        <tei:lg>
          <tei:l>God, keep us safe.</tei:l>
          <tei:l>God, guard us wherever we are.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_israel_in_wartime_israel/4"/>
        <tei:lg>
          <tei:l>God, help all those injured recuperate</tei:l>
          <tei:l>and return to health.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_israel_in_wartime_israel/5"/>
        <tei:lg>
          <tei:l>God, help the leaders</tei:l>
          <tei:l>who are deciding how to respond</tei:l>
          <tei:l>against our enemies</tei:l>
          <tei:l>make wise and good decisions.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_israel_in_wartime_israel/6"/>
        <tei:lg>
          <tei:l>God, bless the men and women of the Israeli Defence Forces.</tei:l>
          <tei:l>God, safeguard our men and women soldiers.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_israel_in_wartime_israel/7"/>
        <tei:lg>
          <tei:l>God, help those who were forced to leave their homes</tei:l>
          <tei:l>because of the war</tei:l>
          <tei:l>return home quickly.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_israel_in_wartime_israel/8"/>
        <tei:lg>
          <tei:l>God, grant peace,</tei:l>
          <tei:l>quiet and safety</tei:l>
          <tei:l>to our families and to us all.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_israel_in_wartime_israel/9"/>
        <tei:lg>
          <tei:l>Blessed are you God</tei:l>
          <tei:l>who hears our prayers.</tei:l>
          <tei:l>And let us say, <tei:hi rend="italic">Amen</tei:hi></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
