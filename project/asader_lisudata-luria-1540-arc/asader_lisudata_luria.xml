  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:asader_lisudata_luria">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:asader_lisudata_luria/1"/>
        <tei:lg xml:lang="he">
          <tei:l>אֲסַדֵּר לִסְעוּדָתָא.</tei:l>
          <tei:l>בְּצַפְרָא דְשַׁבַּתָּא.</tei:l>
          <tei:l>וְאַזְמִין בָּהּ הַשְׁתָּא.</tei:l>
          <tei:l>עַתִּיקָא קַדִּישָׁא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:asader_lisudata_luria/2"/>
        <tei:lg xml:lang="he">
          <tei:l>נְהוֹרֵיהּ יִשְׁרֵי בָהּ.</tei:l>
          <tei:l>בְּקִידוּשָׁא רַבָּא.</tei:l>
          <tei:l>וּבְחַמְרָא טָבָא.</tei:l>
          <tei:l>דְּבֵהּ תֶּחֱדֵי נַפְשָׁא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:asader_lisudata_luria/3"/>
        <tei:lg xml:lang="he">
          <tei:l>יְשַׁדֵּר לָן שׁוּפְרֵהּ.</tei:l>
          <tei:l>וְנֶחֱזֵי בִיקָרֵהּ.</tei:l>
          <tei:l>וְיַחֲזֵי לָן סִתְרֵהּ.</tei:l>
          <tei:l>דְּאִתְאַמַּר בִּלְחִישָׁא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:asader_lisudata_luria/4"/>
        <tei:lg xml:lang="he">
          <tei:l>יְגַלֵּי לָן טַעֲמֵי.</tei:l>
          <tei:l>דְּבִתְרֵיסַר נַהֲמֵי.</tei:l>
          <tei:l>דְּאִינוּן אָת בִּשְׁמֵהּ.</tei:l>
          <tei:l>כְּפִילָא וּקְלִישָׁא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:asader_lisudata_luria/5"/>
        <tei:lg xml:lang="he">
          <tei:l>צְרוֹרָא דִלְעֵילָא.</tei:l>
          <tei:l>דְּבֵהּ חַיֵּי כֹלָּא.</tei:l>
          <tei:l>וְיִתְרַבֵּי חֵילָא.</tei:l>
          <tei:l>וְתִיסַק עַד רֵישָׁא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:asader_lisudata_luria/6"/>
        <tei:lg xml:lang="he">
          <tei:l>חֲדוּ חַצְדֵּי (<tei:note type="instruction">נ״א:</tei:note> מְחַצְדֵּי) חַקְלָא.</tei:l>
          <tei:l>בְּדִבּוּר וּבְקָלָא.</tei:l>
          <tei:l>וּמַלְלוּ מִלָּה.</tei:l>
          <tei:l>מְתִיקָא כְּדוּבְשָׁא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:asader_lisudata_luria/7"/>
        <tei:lg xml:lang="he">
          <tei:l>קֳדָם רִבּוֹן עָלְמִין.</tei:l>
          <tei:l>בְּמִלִּין סְתִימִין.</tei:l>
          <tei:l>תְּגַלּוּן פִּתְגָמִין.</tei:l>
          <tei:l>וְתֵימְרוּן חִדּוּשָׁא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:asader_lisudata_luria/8"/>
        <tei:lg xml:lang="he">
          <tei:l>לְעַטֵּר פְּתוֹרָא.</tei:l>
          <tei:l>בְּרָזָא יַקִּירָא.</tei:l>
          <tei:l>עֲמִיקָא וּטְמִירָא.</tei:l>
          <tei:l>וְלָאו מִילְּתָא אַוְשָׁא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:asader_lisudata_luria/9"/>
        <tei:lg xml:lang="he">
          <tei:l>וְאִלֵּין מִלַּיָּא.</tei:l>
          <tei:l>יְהוֹן לִרְקִיעַיָּא.</tei:l>
          <tei:l>וְתַמָּן מָאן שַׁרְיָא.</tei:l>
          <tei:l>הֲלָא הַהוּא שִׁמְשָׁא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:asader_lisudata_luria/10"/>
        <tei:lg xml:lang="he">
          <tei:l>רְבוּ יַתִּיר יַסְגֵּי.</tei:l>
          <tei:l>לְעֵילָא מִן דַּרְגֵּהּ.</tei:l>
          <tei:l>וְיִסַּב בַּת זוּגֵהּ.</tei:l>
          <tei:l>דַּהֲוַת פְּרִישָׁא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:asader_lisudata_luria/11"/>
        <tei:lg xml:lang="he">
          <tei:l>יָדַי אַסְחֵי אֲנָא.</tei:l>
          <tei:l>לְגַבֵּי חַד מָנָא.</tei:l>
          <tei:l>לְסִטְרָא חוֹרִינָא.</tei:l>
          <tei:l>דְּלֵית בָּהּ מַמָּשָׁא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:asader_lisudata_luria/12"/>
        <tei:lg xml:lang="he">
          <tei:l>אֲזַמֵּן בִּתְלָתָא.</tei:l>
          <tei:l>בְּכַסָּא דְבִרְכָתָא.</tei:l>
          <tei:l>לְעִלַּת עִלָּתָא.</tei:l>
          <tei:l>עַתִּיקָא קַדִּישָׁא׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
