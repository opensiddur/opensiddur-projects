  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:regalim/kiddush">
        <tei:head xml:lang="en">Kiddush for Yom Tov Evenings</tei:head>
        <j:conditional xml:id="when_1">
          <tei:note type="instruction" xml:lang="en">When Yom Tov occurs on Shabbos, begin here:</tei:note>
          <j:all>
            <tei:fs type="opensiddur:holiday-aggregate">
              <tei:f name="shabbat">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
            <tei:fs type="opensiddur:holiday-aggregate">
              <tei:f name="yom-tov">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:all>
        </j:conditional>
        <tei:note type="instruction" xml:lang="en">Recite quietly:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:kiddush/vayekhulu"/>
        <j:endConditional target="#when_1"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:borei_peri_hagafen/text"/>
        <j:declare xml:id="variants_1">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:kiddush/savri/shabbat_day_meal_kiddush">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:kiddush/savri"/>
        <j:endDeclare target="#variants_1"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:hamotzi"/>
        <j:declare xml:id="variants_2">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:birkhot_hatorah/asher_bachar/regalim_kiddush">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hatorah/asher_bachar"/>
        <j:endDeclare target="#variants_2"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:veromemanu_mikal_lashon"/>
        <j:conditional xml:id="when_2">
          <tei:note type="instruction" xml:lang="en">(On the last two nights of Pesach the following berachah is omitted)</tei:note>
          <j:none>
            <tei:fs type="opensiddur:holiday">
              <tei:f name="pesah">
                <tei:numeric value="7" max="8"/>
              </tei:f>
            </tei:fs>
          </j:none>
        </j:conditional>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:shehecheyanu"/>
        <j:endConditional target="#when_2"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:leshev_basukkah"/>
        <j:conditional xml:id="when_3">
          <tei:note type="instruction" xml:lang="en">(When Yom Tov occurs at the conclusion of Shabbos, the following two berachos are said before the berachah of “ שֶׁהֶחֱיָנוּ , Who has kept us alive”):</tei:note>
          <j:all>
            <tei:fs type="opensiddur:holiday-aggregate">
              <tei:f name="yom-tov">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
            <tei:fs type="opensiddur:holiday-aggregate">
              <tei:f name="motzaei-shabbat">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:all>
        </j:conditional>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:borei_meorei_haesh"/>
        <j:endConditional target="#when_3"/>
        <j:declare xml:id="variants_3">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:hamavdil_bein_qodesh_lechol/regalim_kiddush">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:hamavdil_bein_qodesh_lechol"/>
        <j:endDeclare target="#variants_3"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:hamavdil_bein_qodesh_leqodesh"/>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>