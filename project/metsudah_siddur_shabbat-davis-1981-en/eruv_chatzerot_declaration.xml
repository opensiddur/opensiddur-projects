  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:eruv_chatzerot/declaration">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eruv_chatzerot/declaration/1"/>By means of this <tei:hi rend="italic">eiruv</tei:hi>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eruv_chatzerot/declaration/2"/>it will be permissible for us
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eruv_chatzerot/declaration/3"/>to take out and to bring in
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eruv_chatzerot/declaration/4"/>from the houses into the courtyard
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eruv_chatzerot/declaration/5"/>and from the courtyard into the houses
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eruv_chatzerot/declaration/6"/>and from one house into another,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eruv_chatzerot/declaration/7"/>for all the Jews
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:eruv_chatzerot/declaration/8"/>who live in the houses of the courtyard.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
