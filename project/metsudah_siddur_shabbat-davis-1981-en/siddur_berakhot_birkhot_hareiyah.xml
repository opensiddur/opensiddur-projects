  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:berakhot/birkhot_hareiyah">
        <tei:head xml:lang="en">Berachos Said Upon Witnessing Phenomenal Sights</tei:head>
        <tei:note type="instruction" xml:lang="en">When seeing shooting stars, a comet, or witnessing a hurricane or lightning say:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:oseh_maaseh_vereshit"/>
        <tei:note type="instruction" xml:lang="en">Upon hearing thunder, say:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:shekocho_ugevurato"/>
        <tei:note type="instruction" xml:lang="en">When seeing a rainbow say:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:zokher_haberit"/>
        <tei:note type="instruction" xml:lang="en">When seeing great seas, or tall mountains which are famous for their great height, say:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:oseh_maaseh_vereshit"/>
        <tei:note type="instruction" xml:lang="en">Upon seeing a place where you had experienced a life-saving miracle, you should say:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:sheasah_li_nes"/>
        <tei:note type="instruction" xml:lang="en">Upon seeing a place where your parents or ancestors were miraculously saved, say:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:sheasah_nes_leavi"/>
      </tei:div>
    </tei:body>
  </tei:text>
