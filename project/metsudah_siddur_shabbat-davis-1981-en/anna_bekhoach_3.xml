        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anna_bekhoach/3/1"/>Please! Mighty One,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:anna_bekhoach/3/2"/>those who seek Your Unity,<tei:anchor xml:id="note_1"/>
