  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:asher_natan_yamim">
        <tei:p><tei:note type="instruction" xml:lang="en">If you forgot to say יַעֲלֶה וְיָבֹא on Yom Tov:</tei:note><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_natan_yamim/1"/>Blessed are You, Adonoy
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_natan_yamim/2"/>King of the Universe,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_natan_yamim/3"/>Who gave Yomim Tovim
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:asher_natan_yamim/berakhot_birkat_hamazon"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_natan_yamim/8"/>to His people Israel for remembrance.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:asher_natan_yamim/berakhot_birkat_hamazon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_natan_yamim/4"/>to His people Israel for happiness and joy,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:asher_natan_yamim/berakhot_birkat_hamazon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_natan_yamim/5"/>this day of (<tei:hi rend="italic">name the Yom Tov</tei:hi>)
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:asher_natan_yamim/berakhot_birkat_hamazon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_natan_yamim/6"/>Blessed are You, Adonoy,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:asher_natan_yamim/berakhot_birkat_hamazon"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:asher_natan_yamim/7"/>Sanctifier of Israel and the seasons.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_5"/></tei:p>
