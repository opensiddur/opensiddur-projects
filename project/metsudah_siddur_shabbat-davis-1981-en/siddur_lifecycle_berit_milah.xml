    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:lifecycle/berit_milah">
        <tei:head xml:lang="en">Service at a Circumcision</tei:head>
        <tei:note type="instruction" xml:lang="en">Upon the arrival of the child, all those present at the service rise and say:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:barukh_haba_zeh"/>
        <tei:note type="instruction" xml:lang="en">The Mohel places the child upon the knees of the Sandek, and before performing the actual circumcision, he says:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:al_hamilah"/>
        <tei:note type="instruction" xml:lang="en">As the Mohel performs the act of circumcision the father of the child says:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:lehakhniso_bivrito"/>
        <tei:note type="instruction" xml:lang="en">All those present proclaim:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:keshem_shenikhnas_laberit"/>
        <tei:note type="instruction" xml:lang="en">One of the distinguished relatives or guests is given the honor of reciting the following Berachos:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:borei_peri_hagafen/text"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:asher_qiddesh_yedid"/>
      </tei:div>
    </tei:body>
  </tei:text>
