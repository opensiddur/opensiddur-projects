      <tei:div corresp="urn:x-opensiddur:text:siddur:berakhot/birkat_halevanah">
        <tei:head xml:lang="en">Kiddush Levanah</tei:head>
        <tei:note type="instruction" xml:lang="en">This prayer is customarily recited in the open air, in clear sight of the moon, seven days after the birth of the new moon.</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/148/1-6"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:asher_bemaamaro_bara"/>
        <tei:note type="instruction" xml:lang="en">Recite three times:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:barukh_yotzerekh_barukh"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/121"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/150"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:tana_devei_rabbi"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:sefirat_haomer/psalm_67"/>
        <tei:note type="instruction" xml:lang="en">עלינו is said, see p. 000.</tei:note>
      </tei:div>
