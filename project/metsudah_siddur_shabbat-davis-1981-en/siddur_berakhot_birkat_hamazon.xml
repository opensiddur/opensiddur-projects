  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:berakhot/birkat_hamazon">
        <tei:head xml:lang="en">Birchas Hamazon</tei:head>
        <j:conditional xml:id="when_1">
          <tei:note type="instruction" xml:lang="en">Psalm 126 is recited on Shabbos, Yom Tov and other festive occasions such as weddings, circumcisions or redemption of the first born.</tei:note>
          <j:any>
            <j:any>
              <tei:fs type="opensiddur:holiday-aggregate">
                <tei:f name="shabbat">
                  <tei:binary value="true"/>
                </tei:f>
              </tei:fs>
              <tei:fs type="opensiddur:holiday-aggregate">
                <tei:f name="yom-tov">
                  <tei:binary value="true"/>
                </tei:f>
              </tei:fs>
            </j:any>
            <tei:fs type="opensiddur:override">
              <tei:f name="wedding">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
            <tei:fs type="opensiddur:override">
              <tei:f name="sheva-brachot">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
            <tei:fs type="opensiddur:override">
              <tei:f name="brit-milah">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:any>
        </j:conditional>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkat_hamazon/shir_hamaalot"/>
        <j:endConditional target="#when_1"/>
        <j:conditional xml:id="when_2">
          <tei:note type="instruction" xml:lang="en">When three or more males aged 13 or older eat together, one of them leads the group in reciting the Birkas Hamazon.</tei:note>
          <tei:fs type="opensiddur:meal-context">
            <tei:f name="zimmun">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
        <tei:note type="instruction" xml:lang="en">The leader begins by saying:</tei:note>
        <j:declare xml:id="variants_1">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:birkat_hamazon/zimmun/lifecycle_sheva_berakhot_birkat_hamazon">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:birkat_hamazon/zimmun/lifecycle_berit_milah_birkat_hamazon">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkat_hamazon/zimmun"/>
        <j:endDeclare target="#variants_1"/>
        <j:endConditional target="#when_2"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkat_hamazon/hazan"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkat_hamazon/nodeh"/>
        <tei:note type="instruction" xml:lang="en">On regular weekdays, continue, “For everything” on page 000</tei:note>
        <j:conditional xml:id="when_3">
          <tei:note type="instruction" xml:lang="en">On Chanukah add:</tei:note>
          <tei:fs type="opensiddur:holiday">
            <tei:f name="hanukkah">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
        <j:declare xml:id="variants_2">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_arvit_amidah">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/berakhot_birkat_hamazon">
              <tei:binary value="true"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_shacharit_amidah">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_musaf_amidah">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_minchah_amidah">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:al_hanissim"/>
        <j:endDeclare target="#variants_2"/>
        <j:endConditional target="#when_3"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkat_hamazon/veal_hakol"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkat_hamazon/rachem"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkat_hamazon/eloheinu_avinu"/>
        <tei:note type="instruction" xml:lang="en">On regular weekdays, continue, “Rebuild” on page 000</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkat_hamazon/retzeh_vehachalitzenu"/>
        <j:conditional xml:id="when_4">
          <tei:note type="instruction" xml:lang="en">On Rosh Chodesh and Yom Tov, add:</tei:note>
          <j:any>
            <tei:fs type="opensiddur:holiday">
              <tei:f name="rosh-hodesh">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
            <tei:fs type="opensiddur:holiday-aggregate">
              <tei:f name="yom-tov">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:any>
        </j:conditional>
        <j:declare xml:id="variants_3">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:yaaleh_veyavo/berakhot_birkat_hamazon">
              <tei:binary value="true"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:yaaleh_veyavo/shabbat_shacharit_amidah">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:yaaleh_veyavo/shabbat_minchah_amidah">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:yaaleh_veyavo/regalim_amidah">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:yaaleh_veyavo"/>
        <j:endDeclare target="#variants_3"/>
        <j:endConditional target="#when_4"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkat_hamazon/uveneh_yerushalayim"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkat_hamazon/hatov_vehametiv"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkat_hamazon/yiru_et_adonai"/>
        <tei:note type="instruction" xml:lang="en">The following blessings are said in the event you forgot to say רְצֵה or יַעֲלֶה וְיָבֹא and reminded yourself before starting the fourth blesing, הַטוֹב וְהַמֵּטִיב .</tei:note>
        <tei:note type="instruction" xml:lang="en">If you forgot to say רְצֵה on Shabbos:</tei:note>
        <j:declare xml:id="variants_4">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:asher_natan_shabbatot/berakhot_birkat_hamazon">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:asher_natan_shabbatot/berakhot_birkat_hamazon_407">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:asher_natan_shabbatot/berakhot_birkat_hamazon_424">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:asher_natan_shabbatot"/>
        <j:endDeclare target="#variants_4"/>
        <tei:note type="instruction" xml:lang="en">If you forgot to say יַעֲלֶה וְיָבֹא on Rosh Chodesh:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:asher_natan_rashei"/>
        <tei:note type="instruction" xml:lang="en">If Rosh Chodesh occurs on Shabbos and you forgot to say רְצֵה and יַעֲלֶה וְיָבֹא :</tei:note>
        <j:declare xml:id="variants_5">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:asher_natan_shabbatot/berakhot_birkat_hamazon">
              <tei:binary value="true"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:asher_natan_shabbatot/berakhot_birkat_hamazon_407">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:asher_natan_shabbatot/berakhot_birkat_hamazon_424">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:asher_natan_shabbatot"/>
        <j:endDeclare target="#variants_5"/>
        <tei:note type="instruction" xml:lang="en">If you forgot to say יַעֲלֶה וְיָבֹא on Yom Tov:</tei:note>
        <j:declare xml:id="variants_6">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:asher_natan_yamim/berakhot_birkat_hamazon">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:asher_natan_yamim"/>
        <j:endDeclare target="#variants_6"/>
        <tei:note type="instruction" xml:lang="en">If Yom Tov occurs on Shabbos and you forgot to say רְצֵה and יַעֲלֶה וְיָבֹא :</tei:note>
        <j:declare xml:id="variants_7">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:asher_natan_shabbatot/berakhot_birkat_hamazon">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:asher_natan_shabbatot/berakhot_birkat_hamazon_407">
              <tei:binary value="true"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:asher_natan_shabbatot/berakhot_birkat_hamazon_424">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:asher_natan_shabbatot"/>
        <j:endDeclare target="#variants_7"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:veyamim_tovim_lesason"/>
        <tei:note type="instruction" xml:lang="en">If you forgot to say יַעֲלֶה וְיָבֹא on Rosh Hashanah:</tei:note>
        <j:declare xml:id="variants_8">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:asher_natan_yamim/berakhot_birkat_hamazon">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:asher_natan_yamim"/>
        <j:endDeclare target="#variants_8"/>
        <tei:note type="instruction" xml:lang="en">If Rosh Hashanah occurs on Shabbos and you forgot to say רְצֵה and יַעֲלֶה וְיָבֹא :</tei:note>
        <j:declare xml:id="variants_9">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:asher_natan_shabbatot/berakhot_birkat_hamazon">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:asher_natan_shabbatot/berakhot_birkat_hamazon_407">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:asher_natan_shabbatot/berakhot_birkat_hamazon_424">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:asher_natan_shabbatot"/>
        <j:endDeclare target="#variants_9"/>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>