      <tei:div corresp="urn:x-opensiddur:text:siddur:shabbat/shacharit/torah/yequm_purqan">
        <tei:head xml:lang="en">Yekum Purkon</tei:head>
        <j:conditional xml:id="when_1">
          <tei:note type="instruction" xml:lang="en">The following three prayers are said only on Sabbath, they are not said on Yom Tov that occurs on weekdays.</tei:note>
          <tei:fs type="opensiddur:holiday-aggregate">
            <tei:f name="shabbat">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:conditional>
        <tei:note type="instruction" xml:lang="en">According to Mishna Berurah 101:19 one who prays without a minyan should not say any of the following prayers, but rather begin <tei:hi rend="italic">Father of Compassion</tei:hi> on page 000.</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:yequm_purqan/congregation"/>
        <j:endConditional target="#when_1"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:yequm_purqan/scholars"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:mi_sheberakh/kol_haqahal"/>
      </tei:div>
    </tei:body>
  </tei:text>
