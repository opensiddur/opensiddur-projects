      <tei:div corresp="urn:x-opensiddur:text:siddur:shabbat/leil_shabbat/birkat_habanim">
        <tei:head xml:lang="en">Blessing the Children</tei:head>
        <tei:note type="instruction" xml:lang="en">It has become a widely accepted custom for parents to bless their children on the eve of Shabbos.</tei:note>
        <tei:note type="instruction" xml:lang="en">The placing of both hands upon the child's head when giving the blessing, symbolizes that the blessing is bestowed with fullness of spirit and heart.</tei:note>
        <tei:note type="instruction" xml:lang="en">For a boy:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkat_horim/sons"/>
