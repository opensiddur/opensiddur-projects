  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:veromemanu_mikal_lashon">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/1"/>and exalted us above all (tongues) languages,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/2"/>and sanctified us with His commandments.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/3"/>And [You] gave us Adonoy, our God,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/4"/>in love
<tei:milestone unit="phrase"/>
<tei:note type="instruction" xml:lang="en">(Add on Shabbos:</tei:note>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/5"/>Shabbosos for rest, and)
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/6"/>appointed festivals for rejoicing
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/7"/>festivals and seasons for happiness,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/8"/>this day of:
<tei:milestone unit="phrase"/>
<tei:note type="instruction" xml:lang="en">(Add on Shabbos:</tei:note>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/9"/>this Shabbos day, and)
<tei:milestone unit="phrase"/>
<j:conditional xml:id="when_1"><tei:note type="instruction" xml:lang="en">On Pesach</tei:note><tei:fs type="opensiddur:holiday"><tei:f name="pesah"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/10"/>the Festival of Matzos,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/11"/>the season of our Freedom,
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_1"/>
<j:conditional xml:id="when_2"><tei:note type="instruction" xml:lang="en">On Shavuos</tei:note><tei:fs type="opensiddur:holiday"><tei:f name="shavuot"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/12"/>the Festival of Shavuos,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/13"/>the season of the giving of our Torah,
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_2"/>
<j:conditional xml:id="when_3"><tei:note type="instruction" xml:lang="en">On Sukkos</tei:note><tei:fs type="opensiddur:holiday"><tei:f name="sukkot"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/14"/>the Festival of Sukkos,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/15"/>the season of our rejoicing,
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_3"/>
<tei:note type="instruction" xml:lang="en">On Shemini Atseres and Simchas Torah</tei:note>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/16"/>the Festival of Shemini Atseres
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/17"/>the season of our rejoicing
<tei:milestone unit="phrase"/>
<tei:note type="instruction" xml:lang="en">(Add on Shabbos:</tei:note>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/18"/>with love)
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/19"/>a day of holy assembly
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/20"/>commemorating the exodus from Egypt.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/21"/>For us have You chosen
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/22"/>and us have You sanctified
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/23"/>from among all peoples;
<tei:milestone unit="phrase"/>
<tei:note type="instruction" xml:lang="en">(Add on Shabbos:</tei:note>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/24"/>and Shabbos)
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/25"/>and Your appointed festivals of holiness
<tei:milestone unit="phrase"/>
<tei:note type="instruction" xml:lang="en">(Add on Shabbos:</tei:note>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/26"/>with love and pleasure)
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/27"/>in joy and in happiness
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/28"/>You gave us for a heritage.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/29"/>Blessed are You, Adonoy,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/30"/>Sanctifier of
<tei:milestone unit="phrase"/>
<tei:note type="instruction" xml:lang="en">(Add on Shabbos:</tei:note>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/31"/>Shabbos, and)
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:veromemanu_mikal_lashon/32"/>Israel and the seasons.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
