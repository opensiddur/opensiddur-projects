  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:numbers/6/22-27">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/6/22-27/1"/>And Adonoy spoke to Moses, saying,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/6/22-27/2"/>Speak to Aaron and to his sons, saying,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/6/22-27/3"/>thus shall you bless the Children of Israel,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/6/22-27/4"/>say to them:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/6/22-27/5"/>May Adonoy bless you and guard you.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/6/22-27/6"/>May Adonoy shine
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/6/22-27/7"/>His countenance upon you
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/6/22-27/8"/>and be gracious unto you.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/6/22-27/9"/>May Adonoy turn
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/6/22-27/10"/>His countenance toward you
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/6/22-27/11"/>and grant you peace.<tei:anchor xml:id="note_1"/>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/6/27"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/6/22-27/12"/>And they shall set My Name
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/6/22-27/13"/>upon the Children of Israel,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/6/22-27/14"/>and I shall bless them.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
