  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hinneh_el_yeshuati">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hinneh_el_yeshuati/1"/>Behold! The Almighty is my deliverance—
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hinneh_el_yeshuati/2"/>I will trust in Him and will not fear;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hinneh_el_yeshuati/3"/>for the strength and retribution of God
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hinneh_el_yeshuati/4"/>Adonoy was the cause of my deliverance.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hinneh_el_yeshuati/5"/>And you will draw water with joy,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hinneh_el_yeshuati/6"/>from the wellsprings of deliverance.<tei:anchor xml:id="note_1"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hinneh_el_yeshuati/7"/>To Adonoy belongs deliverance
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hinneh_el_yeshuati/8"/>upon Your people is Your blessing, selah.<tei:anchor xml:id="note_2"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" target="#note_1" xml:lang="en">
