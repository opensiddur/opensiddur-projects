  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/teshuvah">
        <tei:head xml:lang="en">PRAYER FOR PENITENCE</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/teshuvah/1"/>Cause us to return, our Father,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/teshuvah/2"/>to Your Torah
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/teshuvah/3"/>and bring us near, our King, to Your service;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/teshuvah/4"/>and bring us back
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/teshuvah/5"/>in whole-hearted repentance before You
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/teshuvah/6"/>Blessed are You, Adonoy,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/teshuvah/7"/>Who desires penitence.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
