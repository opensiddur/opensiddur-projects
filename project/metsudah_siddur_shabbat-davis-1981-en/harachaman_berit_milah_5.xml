  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:harachaman_berit_milah/5">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/5/1"/>May the Merciful One send us His Messiah,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/5/2"/>who walks in perfect wholesomeness,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/5/3"/>in the merit of the blood of circumcision,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/5/4"/>to bring good tidings
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/5/5"/>and consolations
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/5/6"/>to the que people (who are)
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/5/7"/>dispersed and scattered among the nations.
<tei:milestone unit="phrase"/>
<tei:note type="instruction" xml:lang="en">All respond:</tei:note>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/5/8"/>Amein</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
