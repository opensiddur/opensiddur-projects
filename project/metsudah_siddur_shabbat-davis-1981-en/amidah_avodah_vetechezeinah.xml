      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/avodah/vetechezeinah">
        <tei:p><tei:note type="instruction" xml:lang="en">If you forgot to say this, see page 000.</tei:note><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/avodah/vetechezeinah/1"/>And may our eyes behold
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/avodah/vetechezeinah/2"/>Your merciful return to Zion.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/avodah/vetechezeinah/3"/>Blessed are You, Adonoy,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/avodah/vetechezeinah/4"/>Who returns His Divine Presence to Zion.</tei:p>
