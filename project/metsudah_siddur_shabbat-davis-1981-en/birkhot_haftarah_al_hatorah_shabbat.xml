    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:birkhot_haftarah/al_hatorah_shabbat">
        <tei:p><j:conditional xml:id="when_1"><tei:note type="instruction" xml:lang="en">On Fast-days the berachos end here.</tei:note><j:none><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="minor-fast"><tei:binary value="true"/></tei:f></tei:fs><tei:fs type="opensiddur:holiday"><tei:f name="tisha-bav"><tei:binary value="true"/></tei:f></tei:fs></j:none></j:conditional><j:endConditional target="#when_1"/><j:conditional xml:id="when_2"><tei:note type="instruction" xml:lang="en">On Shabbos conclude with this berachah:</tei:note><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:conditional><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_shabbat/1"/>For the Torah, for the Divine Service
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_shabbat/2"/>for the Prophets,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_shabbat/3"/>and for this Sabbath Day
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_shabbat/4"/>which You gave us, Adonoy, our God,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_shabbat/5"/>for holiness and for rest,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_shabbat/6"/>for honor and for glory.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_shabbat/7"/>For all this, Adonoy, our God,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_shabbat/8"/>we thank You,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_shabbat/9"/>and bless You;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_shabbat/10"/>blessed be Your Name
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_shabbat/11"/>by the mouth of all the living
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_shabbat/12"/>continually forever.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_shabbat/13"/>Blessed are You, Adonoy,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_haftarah/al_hatorah_shabbat/14"/>Sanctifier of the Sabbath.
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_2"/></tei:p>
      </tei:div>
