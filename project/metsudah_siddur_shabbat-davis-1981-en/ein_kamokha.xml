  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:ein_kamokha">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/86/8"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_kamokha/1"/>There is none like You
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_kamokha/2"/>among gods, my master,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_kamokha/3"/>and nothing like Your works.<tei:anchor xml:id="note_1"/>
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_kamokha/4"/>Your kingship is the kingship for all worlds
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_kamokha/5"/>and Your dominion is in every generation.<tei:anchor xml:id="note_2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_kamokha/6"/>Adonoy is King, Adonoy was King,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_kamokha/7"/>Adonoy will be King forever and ever.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_kamokha/8"/>Adonoy will give strength to His people
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ein_kamokha/9"/>Adonoy will bless His people with peace.<tei:anchor xml:id="note_3"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
