  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:ribbono_shel_olam/malle_mishalot/vaani">
        <tei:p><tei:note type="instruction" xml:lang="en">The following verse is then said three times:</tei:note><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam/malle_mishalot/vaani/1"/>But as for me,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam/malle_mishalot/vaani/2"/>may my prayer to You, Adonoy,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam/malle_mishalot/vaani/3"/>be at a favorable time;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam/malle_mishalot/vaani/4"/>God, in the abundance of Your kindness,
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:ribbono_shel_olam/malle_mishalot/vaani/shabbat_minchah_torah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ribbono_shel_olam/malle_mishalot/vaani/5"/>answer me with the truth of Your deliverance.<tei:anchor xml:id="note_1"/>
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/></tei:p>
