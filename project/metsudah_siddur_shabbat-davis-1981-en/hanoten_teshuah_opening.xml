  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hanoten_teshuah/opening">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/opening/1"/>He Who grants deliverance to kings,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/opening/2"/>and dominion to princes,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/opening/3"/>His kingship is a kingship of all worlds;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/opening/4"/>He [Who] rescued David, His servant,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/opening/5"/>from the evil sword,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/opening/6"/>Who put a road through the sea,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/opening/7"/>and a path amid the mighty waters;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/opening/8"/>may He bless, preserve, and guard,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/opening/9"/>help, exalt, and make great,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/opening/10"/>and raise high
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/opening/11"/>the President of these United States,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hanoten_teshuah/opening/12"/>and the Vice President.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
