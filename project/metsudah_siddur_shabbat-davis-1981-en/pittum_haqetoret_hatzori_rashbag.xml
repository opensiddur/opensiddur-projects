  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:pittum_haqetoret_hatzori/rashbag">
        <tei:p><j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:pittum_haqetoret_hatzori/rashbag/shabbat_musaf_ein_keloheinu"><tei:binary value="true"/></tei:f></tei:fs></j:conditional><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/20"/>Rabbi Shimon ben Gamliel says:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:pittum_haqetoret_hatzori/rashbag/shabbat_musaf_ein_keloheinu"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/1"/>Rabbi Shimon ben Gamliel
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:pittum_haqetoret_hatzori/rashbag/shabbat_musaf_ein_keloheinu"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/19"/>says:
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/2"/>“The balm is nothing but sap
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/3"/>which drips from the balsam tree.
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:pittum_haqetoret_hatzori/rashbag/shabbat_musaf_ein_keloheinu"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/21"/>Why was Carshina lye used?
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/22"/>To refine the onycha
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:pittum_haqetoret_hatzori/rashbag/shabbat_musaf_ein_keloheinu"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/4"/>the lye of Carshina was used
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_5"/>
<j:conditional xml:id="variant_6"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:pittum_haqetoret_hatzori/rashbag/shabbat_musaf_ein_keloheinu"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/5"/>for rubbing the onycha
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_6"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/6"/>in order to refine its appearance.
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_7"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:pittum_haqetoret_hatzori/rashbag/shabbat_musaf_ein_keloheinu"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/23"/>Why was Cyprus wine used?
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/24"/>The onycha was soaked in it
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_7"/>
<j:conditional xml:id="variant_8"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:pittum_haqetoret_hatzori/rashbag/shabbat_musaf_ein_keloheinu"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/7"/>The Cyprus wine was used
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_8"/>
<j:conditional xml:id="variant_9"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:pittum_haqetoret_hatzori/rashbag/shabbat_musaf_ein_keloheinu"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/8"/>to soak the onycha
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_9"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/9"/>to give it a pungent odor.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/10"/>Though the water of Raglayim<tei:anchor xml:id="note_1"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/11"/>was well suited for that purpose,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/12"/>they did not bring
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/13"/>the water of Raglayim into the Temple
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:pittum_haqetoret_hatzori/rashbag/14"/>because it would be disrespectful.<tei:anchor xml:id="note_2"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" target="#note_1" xml:lang="en">
      <tei:p>This water came from a well named Raglayim.—Kol Bo</tei:p>
    </tei:note>
    <tei:note type="commentary" target="#note_2" xml:lang="en">
      <tei:p>Since Mai Raglayim (lit., water from the feet) is a euphemism for urine, it would have been disrespectful to use this water in the Temple. Others hold that the term “waters of Raglayim” actually refers to urine, which could have been used as a soaking agent were it not indecent to bring it into a sacred place.—Kol Bo</tei:p>
    </tei:note>
  </tei:standOff>
</tei:TEI>