  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:vezot_hatorah">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:deuteronomy/4/44"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vezot_hatorah/1"/>This is the Torah which Moses placed
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vezot_hatorah/2"/>before the children of Israel.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:vezot_hatorah/shabbat_minchah_berikh_shemeh"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vezot_hatorah/3"/>at Adonoy's command by the hand of Moses.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/3/18"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vezot_hatorah/4"/>It is a tree of life
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vezot_hatorah/5"/>to those who grasp to it,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vezot_hatorah/6"/>and those who support it are fortunate.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/3/17"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vezot_hatorah/7"/>Its ways are ways of pleasantness,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vezot_hatorah/8"/>and all its paths are peace.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:proverbs/3/16"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vezot_hatorah/9"/>Long life is at its right,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vezot_hatorah/10"/>at its left, riches and honor.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:isaiah/42/21"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vezot_hatorah/11"/>Adonoy desired,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vezot_hatorah/12"/>for the sake of His righteousness,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vezot_hatorah/13"/>to make the Torah great and to glorify it.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
