  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:emet_veemunah/seal">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veemunah/seal/1"/>And it is said,
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:jeremiah/31/11"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veemunah/seal/2"/>“For Adonoy has liberated Jacob
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veemunah/seal/3"/>and redeemed him
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veemunah/seal/4"/>from a hand, mightier than his.”<tei:anchor xml:id="note_1"/>
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veemunah/seal/5"/>Blessed are You, Adonoy
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:emet_veemunah/seal/6"/>Who has redeemed Israel.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
