  <tei:standOff type="notes">
    <tei:note type="commentary" target="#note_1" xml:lang="en">
      <tei:p>The joy that radiates from a Jewish face on Shabbos is brighter than on any other day.—Siach Yitzchok</tei:p>
    </tei:note>
