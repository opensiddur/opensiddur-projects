        <tei:p><j:conditional xml:id="when_1"><tei:note type="instruction" xml:lang="en">A woman says:</tei:note><tei:fs type="opensiddur:person"><tei:f name="gender"><tei:symbol value="female"/></tei:f></tei:fs></j:conditional><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/sheasani_kirtzono/1"/>Blessed are You, Adonoy
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/sheasani_kirtzono/2"/>our God, King of the Universe,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkhot_hashachar/sheasani_kirtzono/3"/>Who made me according to His will.
<tei:milestone unit="phrase"/>
