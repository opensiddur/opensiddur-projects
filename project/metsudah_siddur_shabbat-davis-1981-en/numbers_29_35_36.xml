  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:numbers/29/35-36">
        <tei:head xml:lang="en">On Shemini Atseres and Simchas Torah:</tei:head>
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/29/35"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/35_36/1"/>“On the eighth day,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/35_36/2"/>let it be [a time] of remaining over for you,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/35_36/3"/>all work of labor you shall not do.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/35_36/4"/>And you shall bring a burnt-offering,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/35_36/5"/>a fire-offering of pleasing savor to Adonoy:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/35_36/6"/>one bullock, one ram,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/35_36/7"/>seven male yearling lambs</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
