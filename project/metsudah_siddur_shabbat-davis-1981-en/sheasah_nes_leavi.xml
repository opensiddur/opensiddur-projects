  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:sheasah_nes_leavi">
        <tei:p><tei:note type="instruction" xml:lang="en">Upon seeing a place where your parents or ancestors were miraculously saved, say:</tei:note><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheasah_nes_leavi/1"/>Blessed are You, Adonoy
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheasah_nes_leavi/2"/>our God, King of the Universe,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheasah_nes_leavi/3"/>Who performed a miracle
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheasah_nes_leavi/4"/>for my mother/my father
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:sheasah_nes_leavi/5"/>at this place.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
