      <tei:div corresp="urn:x-opensiddur:text:siddur:regalim/musaf/tal">
        <tei:head xml:lang="en">Prayer for Dew</tei:head>
        <tei:note type="instruction" xml:lang="en">This special prayer for dew is recited on the first day of Passover, during the Musaf Service. (In some congregations it is recited before Musaf.) The Ark is opened and the Chazzan recites the Musaf Shemoneh Esrei from the beginning until וּמוֹשִׁיעַ וּמָגֵן (and Deliverer and Shield).</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:tefillat_tal"/>
        <tei:note type="instruction" xml:lang="en">The Chazzan continues his repetition of the Shemoneh Esrei.</tei:note>
      </tei:div>
    </tei:body>
  </tei:text>
