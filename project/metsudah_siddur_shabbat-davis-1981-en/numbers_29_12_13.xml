  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:numbers/29/12-13">
        <tei:head xml:lang="en">On the first two days of Sukkos:</tei:head>
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/29/12"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/12-13/1"/>“And on the fifteenth day
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/12-13/2"/>of the seventh month
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/12-13/3"/>a holy assembly it shall be for you;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/12-13/4"/>all work of labor you shall not do,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/12-13/5"/>and you shall celebrate a Festival to Adonoy
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/12-13/6"/>for seven days.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/12-13/7"/>And you shall bring a burnt offering,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/12-13/8"/>a fire-offering of pleasing savor to Adonoy,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/12-13/9"/>thirteen young bullocks
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/12-13/10"/>two rams,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/29/12-13/11"/>fourteen male yearling lambs,</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
