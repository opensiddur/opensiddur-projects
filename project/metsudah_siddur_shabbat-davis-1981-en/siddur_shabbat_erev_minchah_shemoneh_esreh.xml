          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/tzaddiqim/shabbat_conclusion_amidah">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/tzaddiqim"/>
        <j:endDeclare target="#variants_7"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/yerushalayim"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/david"/>
        <j:declare xml:id="variants_8">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/tefillah/opening/shabbat_conclusion_amidah">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/tefillah/opening"/>
        <j:endDeclare target="#variants_8"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/avodah/retzeh"/>
        <tei:note type="instruction" xml:lang="en">On regular weekdays continue, “And may our eyes,” on p. 000.</tei:note>
        <j:conditional xml:id="when_2">
          <tei:note type="instruction" xml:lang="en">On Rosh Chodesh and on Chol HaMoed, the following prayer is added:</tei:note>
          <j:any>
            <tei:fs type="opensiddur:holiday">
              <tei:f name="rosh-hodesh">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
            <tei:fs type="opensiddur:holiday-aggregate">
              <tei:f name="chol-hamoed">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:any>
        </j:conditional>
        <j:declare xml:id="variants_9">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:yaaleh_veyavo/berakhot_birkat_hamazon">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:yaaleh_veyavo/shabbat_shacharit_amidah">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:yaaleh_veyavo/shabbat_minchah_amidah">
