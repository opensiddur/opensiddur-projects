      <tei:div corresp="urn:x-opensiddur:text:siddur:shabbat/erev_minchah/shemoneh_esreh">
        <tei:head xml:lang="en">Shemoneh Esrei</tei:head>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:deuteronomy/32/3"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/adonai_sefatai"/>
        <j:declare xml:id="variants_1">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/avot/shabbat_arvit_vaykhulu">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/avot/regalim_amidah">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/avot/regalim_musaf_amidah">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/avot"/>
        <j:endDeclare target="#variants_1"/>
        <j:declare xml:id="variants_2">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/gevurot/shabbat_shacharit_amidah">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/gevurot/shabbat_musaf_amidah">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/gevurot/regalim_amidah">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/gevurot/regalim_musaf_amidah">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/gevurot"/>
        <j:endDeclare target="#variants_2"/>
        <j:conditional xml:id="when_1">
          <tei:note type="instruction" xml:lang="en">(When the Chazzan repeats the Shemoneh Esrei, the Kedushah is said here)</tei:note>
          <j:all>
            <tei:fs type="opensiddur:recitation">
              <tei:f name="repetition">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
            <tei:fs type="opensiddur:quorum">
              <tei:f name="minyan">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
          </j:all>
        </j:conditional>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/qedushah/neqaddesh"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/qedushah/qadosh"/>
        <j:declare xml:id="variants_3">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/qedushah/leummatam/shabbat_shacharit_amidah">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/qedushah/leummatam/shabbat_minchah_amidah">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/qedushah/leummatam/regalim_amidah">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/qedushah/leummatam/regalim_amidah_101">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/qedushah/leummatam"/>
        <j:endDeclare target="#variants_3"/>
        <j:endConditional target="#when_1"/>
        <j:declare xml:id="variants_4">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/qedushat_hashem/shabbat_shacharit_amidah">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/qedushat_hashem/shabbat_musaf_amidah">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/qedushat_hashem/regalim_amidah">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/qedushat_hashem/regalim_musaf_amidah">
              <tei:binary value="false"/>
            </tei:f>
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/qedushat_hashem/regalim_musaf_qedushat_hayom">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/qedushat_hashem"/>
        <j:endDeclare target="#variants_4"/>
        <tei:note type="instruction" xml:lang="en">If you mistakenly said, “the Almighty” instead of “the King,” or if you are in doubt, see page 000.</tei:note>
        <j:declare xml:id="variants_5">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:amidah/binah/shabbat_conclusion_amidah">
              <tei:binary value="false"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/binah"/>
        <j:endDeclare target="#variants_5"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/teshuvah"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/selichah"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/geullah"/>
        <tei:note type="instruction" xml:lang="en">(On Fast Days, the Chazzan says “Answer us” which is on page 000 and concludes, “Blessed are . . . Who responds at times of trouble.”)</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/refuah"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/shanim"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/qibbutz_galuyot"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/mishpat"/>
        <tei:note type="instruction" xml:lang="en">If you mistakenly said, “King, Lover of righteousness and justice,” instead of “the King of Justice,” see page 000.</tei:note>
