  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hamavdil_bein_qodesh_lechol">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamavdil_bein_qodesh_lechol/1"/>Blessed are You, Adonoy,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamavdil_bein_qodesh_lechol/2"/>our God, King of the Universe,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamavdil_bein_qodesh_lechol/3"/>Who makes distinction
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamavdil_bein_qodesh_lechol/4"/>between sacred and unhallowed,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamavdil_bein_qodesh_lechol/5"/>between light and darkness,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamavdil_bein_qodesh_lechol/6"/>between Israel and the peoples,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamavdil_bein_qodesh_lechol/7"/>between the seventh day
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hamavdil_bein_qodesh_lechol/8"/>and the six work days.
<tei:milestone unit="phrase"/>
