  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/retzeh_vimnuchatenu">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vimnuchatenu/1"/>Our God, and God of our fathers,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vimnuchatenu/2"/>be pleased with our rest,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vimnuchatenu/3"/>sanctify us with Your commandments
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vimnuchatenu/4"/>and give us our share in Your Torah;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vimnuchatenu/5"/>satisfy us from Your goodness
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vimnuchatenu/6"/>and gladden our souls with Your deliverance,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vimnuchatenu/7"/>and purify our hearts to serve You in truth.
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/retzeh_vimnuchatenu/regalim_amidah"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vimnuchatenu/16"/>and give us as a heritage, Adonoy, our God,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/retzeh_vimnuchatenu/regalim_musaf_qedushat_hayom"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vimnuchatenu/17"/>and give us as a heritage, Adonoy, our God,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/retzeh_vimnuchatenu/regalim_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/retzeh_vimnuchatenu/regalim_musaf_qedushat_hayom"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vimnuchatenu/8"/>And give us as our inheritance,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/retzeh_vimnuchatenu/regalim_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/retzeh_vimnuchatenu/regalim_musaf_qedushat_hayom"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vimnuchatenu/9"/>Adonoy our God,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vimnuchatenu/10"/>in love and in pleasure
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/retzeh_vimnuchatenu/regalim_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/retzeh_vimnuchatenu/regalim_musaf_qedushat_hayom"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vimnuchatenu/11"/>Your holy Sabbath;
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_5"/>
<j:conditional xml:id="variant_6"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/retzeh_vimnuchatenu/regalim_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/retzeh_vimnuchatenu/regalim_musaf_qedushat_hayom"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vimnuchatenu/12"/>and may Israel rest thereon—
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_6"/>
<j:conditional xml:id="variant_7"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/retzeh_vimnuchatenu/regalim_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/retzeh_vimnuchatenu/regalim_musaf_qedushat_hayom"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vimnuchatenu/13"/>the sanctifiers of Your Name.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_7"/>
<j:conditional xml:id="variant_8"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/retzeh_vimnuchatenu/regalim_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/retzeh_vimnuchatenu/regalim_musaf_qedushat_hayom"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vimnuchatenu/14"/>Blessed are You, Adonoy,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_8"/>
<j:conditional xml:id="variant_9"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/retzeh_vimnuchatenu/regalim_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:amidah/retzeh_vimnuchatenu/regalim_musaf_qedushat_hayom"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/retzeh_vimnuchatenu/15"/>Sanctifier of the Sabbath.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_9"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
