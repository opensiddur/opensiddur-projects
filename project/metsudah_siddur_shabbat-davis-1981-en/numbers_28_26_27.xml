  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:numbers/28/26-27">
        <tei:p><tei:note type="instruction" xml:lang="en">Continue on page 000 “ אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ Our God and God of our fathers.<tei:hi rend="italic"> ” On the Sabbath say “ יִשְׂמְחוּ , they will rejoice,” page 000, before saying</tei:hi> Our God.</tei:note><j:conditional xml:id="when_1"><tei:note type="instruction" xml:lang="en">On Shavuos:</tei:note><tei:fs type="opensiddur:holiday"><tei:f name="shavuot"><tei:binary value="true"/></tei:f></tei:fs></j:conditional><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/28/26"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/28/26-27/1"/>And on the day of the first fruits,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/28/26-27/2"/>when you bring a new meal-offering<tei:anchor xml:id="note_1"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/28/26-27/3"/>to Adonoy
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/28/26-27/4"/>on your [Festival of] Weeks,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/28/26-27/5"/>a holy assembly it shall be for you;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/28/26-27/6"/>all work of labor you shall not do.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/28/27"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/28/26-27/7"/>And you will bring a burnt-offering
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/28/26-27/8"/>for a pleasing savor to Adonoy;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/28/26-27/9"/>two young bullocks,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/28/26-27/10"/>one ram,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:numbers/28/26-27/11"/>seven male yearling lambs.<tei:anchor xml:id="note_2"/>
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<j:endConditional target="#when_1"/></tei:p>
      </tei:div>
