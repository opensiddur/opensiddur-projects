  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:shabbat/shacharit/el_adon">
        <tei:head xml:lang="en">Eil Adon</tei:head>
        <j:transclude type="external" target="urn:x-opensiddur:text:poem:el_adon"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:yotzer_or/lael_asher_shavat"/>
        <tei:note type="instruction" xml:lang="en">On Shabbos, continue “Be blessed,” on page 000.</tei:note>
        <j:conditional xml:id="when_1">
          <tei:note type="instruction" xml:lang="en">When Yom Tov occurs on weekdays, say:</tei:note>
          <j:all>
            <tei:fs type="opensiddur:holiday-aggregate">
              <tei:f name="yom-tov">
                <tei:binary value="true"/>
              </tei:f>
            </tei:fs>
            <j:none>
              <tei:fs type="opensiddur:holiday-aggregate">
                <tei:f name="shabbat">
                  <tei:binary value="true"/>
                </tei:f>
              </tei:fs>
            </j:none>
          </j:all>
        </j:conditional>
        <j:declare xml:id="variants_1">
          <tei:fs type="opensiddur:variant">
            <tei:f name="urn:x-opensiddur:condition:prayer:yotzer_or/hameir/shabbat_shacharit_el_adon">
              <tei:binary value="true"/>
            </tei:f>
          </tei:fs>
        </j:declare>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:yotzer_or/hameir"/>
        <j:endDeclare target="#variants_1"/>
        <j:endConditional target="#when_1"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:yotzer_or/el_barukh"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:yotzer_or/et_shem"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:yotzer_or/qadosh"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:yotzer_or/vehaofannim"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:yotzer_or/barukh_kevod"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:yotzer_or/lael_barukh"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:yotzer_or/or_chadash"/>
        <tei:note type="instruction" xml:lang="en">In the second of the blessings that precede <tei:hi rend="italic">Shema</tei:hi> we praise God for His goodness in giving us His Torah, and pray for His help in the study of Torah. None of our petitions for the material goods of life approaches the fervor of this prayer for knowledge of the Torah and steadfastness in obeying it.</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:ahavah_rabbah"/>
