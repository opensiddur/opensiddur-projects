      <tei:div corresp="urn:x-opensiddur:text:siddur:shabbat/minchah/qorban_tamid">
        <tei:head xml:lang="en">Korban Tamid (Daily Offering)</tei:head>
        <tei:note type="instruction" xml:lang="en">The <tei:hi rend="italic">Tamid</tei:hi>-offerings, two daily offerings of one lamb at a time, were offered once in the morning and once in the afternoon. The former was the first public- offering brought on the Altar each day. And the latter terminated the day's offerings. These animals were purchased from the annual half-shekel gifts of the people and were offered on behalf of the entire Jewish People. Before reading this passage we offer a brief prayer.</tei:note>
        <tei:note type="instruction" xml:lang="en">Some do not say the following prayer on Sabbath and Yom Tov.</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:qorbanot/yehi_ratzon_miqdash"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:qorbanot/tamid"/>
