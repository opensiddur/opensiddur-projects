  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:kol_meqaddesh/5">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/5/1"/>It is a holy day,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/5/2"/>from arrival till departure;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/5/3"/>all the seed of Jacob honor it
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/5/4"/>according to the King's word and decree—
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/5/5"/>to rest on it and to rejoice
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/5/6"/>with the pleasure of food and drink—
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/5/7"/>“The entire congregation of Israel
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:kol_meqaddesh/5/8"/>will do it.”<tei:anchor xml:id="note_1"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" target="#note_1" xml:lang="en">
      <tei:p>Exodus 12:47.</tei:p>
