  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:harachaman_berit_milah/1">
        <tei:p><tei:note type="instruction" xml:lang="en">Recite “Birchas Hamazon” on page 000.</tei:note><tei:note type="instruction" xml:lang="en">After Birchas Hamazon, the leader says</tei:note><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/1/1"/>May the Merciful One bless
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/1/2"/>the boy's father and mother
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/1/3"/>and may they merit to raise him,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/1/4"/>to educate him
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/1/5"/>and to rear him in wisdom.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/1/6"/>From this eighth day onward
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/1/7"/>may his blood find acceptance,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/1/8"/>and may Adonoy his God be with him.
<tei:milestone unit="phrase"/>
<tei:note type="instruction" xml:lang="en">All respond:</tei:note>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:harachaman_berit_milah/1/9"/>Amein</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
