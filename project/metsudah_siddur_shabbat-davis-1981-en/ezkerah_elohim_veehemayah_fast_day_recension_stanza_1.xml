      <tei:div corresp="urn:x-opensiddur:text:poem:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1">
        <tei:p><tei:note type="instruction" xml:lang="en">On a regular Shabbos, continue “Blessed is the Name” on page 000.</tei:note><j:conditional xml:id="when_1"><tei:note type="instruction" xml:lang="en">When Yom Tov occurs on Weekdays say the following verse three times:</tei:note><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="yom-tov"><tei:binary value="true"/></tei:f></tei:fs><j:none><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:none></j:all></j:conditional><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/1"/>Adonoy, Adonoy,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/2"/>Almighty, Compassionate, and Gracious,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/3"/>Slow to anger
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/4"/>and Abounding in kindness and truth.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:exodus/34/7"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/5"/>He preserves kindness
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/6"/>for thousands of generations,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/7"/>forgiving iniquity, transgression and sin,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:ezkerah_elohim_veehemayah/fast_day_recension/stanza_1/18"/>and He cleanses [the penitent].<tei:anchor xml:id="note_1"/>
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<j:endConditional target="#when_1"/></tei:p>
