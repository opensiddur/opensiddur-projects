  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:birkat_kohanim">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_kohanim/1"/>May Adonoy bless you and guard you.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_kohanim/2"/>May Adonoy shine His countenance
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_kohanim/8"/>upon you
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_kohanim/4"/>and be gracious unto you.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_kohanim/5"/>May Adonoy turn His countenance
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_kohanim/9"/>toward you
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:birkat_kohanim/7"/>and grant you peace.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
