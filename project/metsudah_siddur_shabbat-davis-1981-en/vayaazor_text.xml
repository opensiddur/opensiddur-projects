  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:vayaazor/text">
        <tei:p><tei:note type="instruction" xml:lang="en">When the Torah is unrolled, the Reader says:</tei:note><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaazor/text/1"/>May He help, shield, and deliver
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaazor/text/2"/>all who take refuge in Him,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaazor/text/3"/>and let us say: Amein.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaazor/text/4"/>Let us all ascribe greatness to our God
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaazor/text/5"/>and give honor to the Torah.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaazor/text/6"/>Let the Kohein come forward.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaazor/text/7"/>Arise, son of , the Kohein,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaazor/text/8"/>Blessed is He Who gave the Torah
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaazor/text/9"/>to His people, Israel, in His holiness.
<tei:milestone unit="phrase"/>
<tei:note type="instruction" xml:lang="en">The Congregation responds:</tei:note>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:deuteronomy/4/4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaazor/text/10"/>And you who cling to Adonoy, Your God,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vayaazor/text/11"/>are all alive today.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
