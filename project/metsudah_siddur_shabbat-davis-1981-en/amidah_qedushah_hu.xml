  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/hu">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/hu/1"/>He is our God, He is our Father,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/hu/2"/>He is our King, He is our Deliverer,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/hu/3"/>He will deliver us
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/hu/4"/>and redeem us again
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/hu/5"/>and He will let us hear in His mercy
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/hu/6"/>a second time
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/hu/7"/>in the presence of all the living
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/hu/8"/>saying:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/hu/9"/>Behold, I have redeemed you
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/hu/10"/>from this final [exile] as from the first,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/hu/11"/>to be your God.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/hu/12"/>“I am Adonoy, your God.”</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
