<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:vehu_rachum_arokh/shabbat_minchah_uva_letziyyon"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:vehu_rachum_arokh/shabbat_conclusion_amidah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_rachum_arokh/6"/>withhold not Your mercy from me;
