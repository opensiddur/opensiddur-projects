    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:al_hanissim">
        <tei:p><j:conditional xml:id="when_1"><tei:note type="instruction" xml:lang="en">(On Chanukah and Purim the following prayer is added. If you omitted it, you need not repeat the Shemoneh Esrei. If, however, you became aware of your omission before concluding the blessing, you should say it at that time, and conclude by saying, “ וְעַל כֻּלָּם , and for all the foregoing.”)</tei:note><j:any><tei:fs type="opensiddur:holiday"><tei:f name="hanukkah"><tei:binary value="true"/></tei:f></tei:fs><tei:fs type="opensiddur:holiday"><tei:f name="purim-observed"><tei:binary value="true"/></tei:f></tei:fs></j:any></j:conditional><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/1"/>[We thank You] for the miracles
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/2"/>for the redemption, for the mighty deeds,
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_shacharit_amidah"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/72"/>for the deliverances, and for the wars
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_musaf_amidah"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/73"/>for the deliverances, and for the wars
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_shacharit_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_musaf_amidah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/3"/>for the deliverances, for the wonders
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_shacharit_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_musaf_amidah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/4"/>for the consolations and for the wars
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_5"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/5"/>that You performed for our fathers
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/6"/>in those days at this season.
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_1"/>
<j:conditional xml:id="when_6"><tei:note type="instruction" xml:lang="en">On Chanukah:</tei:note><tei:fs type="opensiddur:holiday"><tei:f name="hanukkah"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/7"/>In the days of Matisyahu,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/8"/>son of Yochanan the High Priest,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/9"/>the Hasmonean and his sons,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/10"/>when the evil Greek kingdom rose up
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/11"/>against Your people Israel
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/12"/>to make them forget Your Torah
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/13"/>and to turn them away
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/14"/>from the statutes of Your will—
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/15"/>You, in Your abundant mercy,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/16"/>stood by them in their time of distress,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/17"/>You defended their cause,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/18"/>You judged their grievances,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/19"/>You avenged them.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/20"/>You delivered the mighty
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/21"/>into the hands of the weak,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/22"/>many into the hands of the few,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/23"/>defiled people into the hands of the undefiled,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/24"/>the wicked into the hands of the righteous,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/25"/>and insolent [sinners] into the hands of
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/26"/>diligent students of Your Torah.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/27"/>And You made Yourself
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/28"/>a great and sanctified name in Your world.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/29"/>And for Your people, Israel,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/30"/>You performed a great deliverance
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/31"/>and redemption unto this very day.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/32"/>Afterwards, Your sons entered
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/33"/>the Holy of Holies of Your Abode,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/34"/>cleaned Your Temple,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/35"/>purified Your Sanctuary,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/36"/>and kindled lights
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/37"/>in the Courtyards of Your Sanctuary,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/38"/>and designated these eight days of Chanukah
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/39"/>to thank and praise Your great Name.
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_6"/>
<j:conditional xml:id="when_7"><tei:note type="instruction" xml:lang="en">On Purim:</tei:note><tei:fs type="opensiddur:holiday"><tei:f name="purim-observed"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<j:conditional xml:id="variant_8"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_arvit_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/berakhot_birkat_hamazon"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_shacharit_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_musaf_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_minchah_amidah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/40"/>In the days of Mordechai and Esther
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_8"/>
<j:conditional xml:id="variant_9"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_arvit_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/berakhot_birkat_hamazon"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_shacharit_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_musaf_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_minchah_amidah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/41"/>in Shushan the Capital [of Persia],
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_9"/>
<j:conditional xml:id="variant_10"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_arvit_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/berakhot_birkat_hamazon"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_shacharit_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_musaf_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_minchah_amidah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/42"/>when the evil Haman rose up against them,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_10"/>
<j:conditional xml:id="variant_11"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_arvit_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/berakhot_birkat_hamazon"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_shacharit_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_musaf_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_minchah_amidah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/43"/>he sought to destroy, to kill,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_11"/>
<j:conditional xml:id="variant_12"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_arvit_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/berakhot_birkat_hamazon"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_shacharit_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_musaf_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_minchah_amidah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/44"/>and to annihilate all the Jews,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_12"/>
<j:conditional xml:id="variant_13"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_arvit_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/berakhot_birkat_hamazon"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_shacharit_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_musaf_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_minchah_amidah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/45"/>young and old, infants and women,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_13"/>
<j:conditional xml:id="variant_14"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_arvit_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/berakhot_birkat_hamazon"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_shacharit_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_musaf_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_minchah_amidah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/46"/>in one day, the thirteenth day
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_14"/>
<j:conditional xml:id="variant_15"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_arvit_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/berakhot_birkat_hamazon"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_shacharit_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_musaf_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_minchah_amidah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/47"/>of the twelfth month,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_15"/>
<j:conditional xml:id="variant_16"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_arvit_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/berakhot_birkat_hamazon"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_shacharit_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_musaf_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_minchah_amidah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/48"/>which is the month of Adar,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_16"/>
<j:conditional xml:id="variant_17"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_arvit_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/berakhot_birkat_hamazon"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_shacharit_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_musaf_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_minchah_amidah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/49"/>and to plunder their wealth—
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_17"/>
<j:conditional xml:id="variant_18"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_arvit_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/berakhot_birkat_hamazon"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_shacharit_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_musaf_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_minchah_amidah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/50"/>And You, in Your abundant mercy,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_18"/>
<j:conditional xml:id="variant_19"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_arvit_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/berakhot_birkat_hamazon"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_shacharit_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_musaf_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_minchah_amidah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/51"/>annulled his counsel,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_19"/>
<j:conditional xml:id="variant_20"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_arvit_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/berakhot_birkat_hamazon"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_shacharit_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_musaf_amidah"><tei:binary value="false"/></tei:f><tei:f name="urn:x-opensiddur:condition:prayer:al_hanissim/shabbat_minchah_amidah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:al_hanissim/52"/>frustrated his intention,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_20"/>
