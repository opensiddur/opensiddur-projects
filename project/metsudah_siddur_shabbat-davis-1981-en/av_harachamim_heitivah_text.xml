  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:av_harachamim/heitivah/text">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/heitivah/text/1"/>Father of compassion!
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/51/20"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/heitivah/text/2"/>Do good, as You see fit, to Zion.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/heitivah/text/3"/>May You rebuild the walls of Jerusalem.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/heitivah/text/4"/>For in You alone do we trust,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/heitivah/text/5"/>King,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/heitivah/text/6"/>Almighty,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/heitivah/text/7"/>Exalted and Uplifted, Master of worlds.
<tei:milestone unit="phrase"/>
<tei:note type="instruction" xml:lang="en">When the Holy Ark is opened, the following is said:</tei:note>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/10/35"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/heitivah/text/8"/>And whenever the Ark traveled
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/heitivah/text/9"/>Moses would say: “Rise, Adonoy
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/heitivah/text/10"/>and let Your enemies be scattered,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/heitivah/text/11"/>and those who hate You, flee before You.”<tei:anchor xml:id="note_1"/>
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/heitivah/text/12"/>For from Zion will go forth the Torah,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/heitivah/text/13"/>and the word of Adonoy from Jerusalem.<tei:anchor xml:id="note_2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/heitivah/text/14"/>Blessed is He Who gave the Torah
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:av_harachamim/heitivah/text/15"/>to His people Israel in His holiness.</tei:p>
      </tei:div>
