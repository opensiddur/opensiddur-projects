  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/148/1-6">
        <tei:p><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/148/1"/><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/148/1-6/1"/>Praise God.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/148/1-6/2"/>Praise Adonoy from the sky,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/148/1-6/3"/>praise Him in the heavens!
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/148/2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/148/1-6/4"/>Praise Him all His angels,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/148/1-6/5"/>praise Him all His hosts!
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/148/3"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/148/1-6/6"/>Praise Him sun and moon;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/148/1-6/7"/>praise Him all the stars of light.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/148/4"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/148/1-6/8"/>Praise Him skies of skies
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/148/1-6/9"/>and the waters that are above the skies.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/148/5"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/148/1-6/10"/>They will praise the Name of Adonoy,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/148/1-6/11"/>for He commanded and they were created.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:psalms/148/6"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/148/1-6/12"/>He established them for all time,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/148/1-6/13"/>as long as the world exists.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:psalms/148/1-6/14"/>He decreed [it] unalterable.<tei:anchor xml:id="note_1"/>
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
