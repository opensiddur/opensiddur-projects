  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:vehiqravtem_isheh_olah">
        <tei:head xml:lang="en">On Chol Hamoed and on the last two days of Pesach:</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehiqravtem_isheh_olah/1"/>“And you shall bring a fire-offering,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehiqravtem_isheh_olah/2"/>a burnt-offering to Adonoy:
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehiqravtem_isheh_olah/3"/>two young bullocks
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehiqravtem_isheh_olah/4"/>and one ram,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehiqravtem_isheh_olah/5"/>and seven male yearling lambs
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehiqravtem_isheh_olah/6"/>without blemish they shall be for you.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
