  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:keshem_shenikhnas_laberit">
        <tei:p><tei:note type="instruction" xml:lang="en">All those present proclaim:</tei:note><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:keshem_shenikhnas_laberit/1"/>Amein!
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:keshem_shenikhnas_laberit/2"/>Even as he has entered into the covenant,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:keshem_shenikhnas_laberit/3"/>so may he enter into the [study of] Torah,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:keshem_shenikhnas_laberit/4"/><tei:hi rend="italic">chupah</tei:hi> [the nuptial canopy], and good deeds.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
