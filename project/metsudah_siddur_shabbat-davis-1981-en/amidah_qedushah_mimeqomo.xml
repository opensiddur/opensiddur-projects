  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/mimeqomo">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/mimeqomo/1"/>From His place, He will turn in compassion,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/mimeqomo/2"/>and favor the people
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/mimeqomo/3"/>who proclaim the Oneness of His Name;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/mimeqomo/4"/>evening and morning, each day, continually,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/mimeqomo/5"/>twice each day, with love, they recite “Shema.”</tei:p>
      </tei:div>
