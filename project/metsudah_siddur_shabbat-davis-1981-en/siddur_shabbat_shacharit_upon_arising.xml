      <tei:div corresp="urn:x-opensiddur:text:siddur:shabbat/shacharit/upon_arising">
        <tei:head xml:lang="en">Upon Arising in the Morning</tei:head>
        <tei:note type="instruction" xml:lang="en">Upon waking in the morning, even before washing your hands, say:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:modeh_ani"/>
        <tei:note type="instruction" xml:lang="en">After washing your hands, say:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:bible:psalms/111/10"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:barukh_shem_kevod"/>
        <tei:note type="instruction" xml:lang="en">Before putting on your tallis katan say:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:al_mitzvat_tzitzit"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:tallith/yehi_ratzon"/>
