  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/birkat_kohanim">
        <tei:head xml:lang="en">Birkas Kohanim</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/1"/>Our God, and God of our fathers, bless us
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/2"/>with the threefold blessing of the Torah,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/3"/>written by the hand of Moses, Your servant,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/4"/>pronounced from the mouth of Aaron
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/5"/>and his sons, the <tei:hi rend="italic">kohanim,</tei:hi> Your holy people;
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/6"/>as it is said:
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/6/24"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/7"/>Adonoy bless you and guard you.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/6/25"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/8"/>Adonoy shine His countenance upon you
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/9"/>and be gracious unto you.
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/6/26"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/10"/>Adonoy turn His countenance toward you
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/11"/>and grant you peace.
<tei:milestone unit="phrase"/>
<tei:milestone unit="verse"/>
<j:conditional xml:id="when_1"><tei:note type="instruction" xml:lang="en">After Birkas Kohanim the congregation says:</tei:note><j:all><tei:fs type="opensiddur:quorum"><tei:f name="minyan"><tei:binary value="true"/></tei:f></tei:fs><tei:fs type="opensiddur:recitation"><tei:f name="repetition"><tei:binary value="true"/></tei:f></tei:fs><tei:fs type="opensiddur:practice"><tei:f name="birkat-kohanim"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/12"/>Mighty One on high who dwells in might,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/13"/>You are peace and Your Name is peace.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/14"/>May it be Your will that You grant us
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/15"/>and all of Your people, the House of Israel
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/16"/>life and blessing
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/birkat_kohanim/17"/>for a safeguard to peace.
<tei:milestone unit="phrase"/>
<j:endConditional target="#when_1"/></tei:p>
      </tei:div>
