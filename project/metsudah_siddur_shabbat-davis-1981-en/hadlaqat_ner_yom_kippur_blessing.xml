    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hadlaqat_ner_yom_kippur/blessing">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_yom_kippur/blessing/1"/>Blessed are You, Adonoy
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_yom_kippur/blessing/2"/>our God, King of the Universe,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_yom_kippur/blessing/3"/>Who sanctified us with His commandments
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_yom_kippur/blessing/4"/>and commanded us
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:hadlaqat_ner_yom_kippur/blessing/shabbat_candles_yom_tov"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_yom_kippur/blessing/6"/>to kindle the Yom Tov light.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:hadlaqat_ner_yom_kippur/blessing/shabbat_candles_yom_tov"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_yom_kippur/blessing/5"/>to kindle the Shabbos light.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:hadlaqat_ner_yom_kippur/blessing/shabbat_candles_shabbat_yom_tov"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:hadlaqat_ner_yom_kippur/blessing/7"/>and Yom Tov light.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/></tei:p>
