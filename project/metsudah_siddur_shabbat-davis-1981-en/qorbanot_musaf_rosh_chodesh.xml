    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:qorbanot/musaf/rosh_chodesh">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/musaf/rosh_chodesh/1"/>And on your Rosh Chodesh days
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/musaf/rosh_chodesh/2"/>you shall bring a burnt-offering to Adonoy
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/musaf/rosh_chodesh/3"/>two young bullocks,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/musaf/rosh_chodesh/4"/>one ram,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/musaf/rosh_chodesh/5"/>seven male yearling lambs
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:qorbanot/musaf/rosh_chodesh/6"/>without blemish.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
