    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:berakhot/various">
        <tei:head xml:lang="en">Various Other Berachos</tei:head>
        <tei:note type="instruction" xml:lang="en">Upon hearing good news that concerns both yourself and others, say:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:hatov_vehametiv"/>
        <tei:note type="instruction" xml:lang="en">Upon hearing tragic news, say:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:dayyan_haemet"/>
        <tei:note type="instruction" xml:lang="en">When putting on a new suit or dress for the first time, say:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:birkhot_hashachar/malbish_arummim"/>
        <tei:note type="instruction" xml:lang="en">When you smell fragrant spices, say:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:borei_minei_vesamim"/>
        <tei:note type="instruction" xml:lang="en">When you smell fragrant shrubs or flowers, say:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:bore_atzei_vesamim"/>
        <tei:note type="instruction" xml:lang="en">When you smell fragrant herbs, say:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:bore_isvei_vesamim"/>
      </tei:div>
    </tei:body>
  </tei:text>
