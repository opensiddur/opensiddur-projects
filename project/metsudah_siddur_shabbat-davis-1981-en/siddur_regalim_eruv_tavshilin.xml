      <tei:div corresp="urn:x-opensiddur:text:siddur:regalim/eruv_tavshilin">
        <tei:head xml:lang="en">Eiruv Tavshilin</tei:head>
        <tei:note type="instruction" xml:lang="en">When Yom Tov occurs on Thursday and Friday, an eiruv tavshilin must be prepared on the preceding Wednesday. The head of the family should take bread or matzoh and an item of cooked food such as meat or fish, put them on a plate and say the following berachah:</tei:note>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:eruv_tavshilin/blessing"/>
        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:eruv_tavshilin/declaration"/>
        <tei:note type="instruction" xml:lang="en">The food of the eiruv should be eaten at one of the Shabbos meals.</tei:note>
      </tei:div>
    </tei:body>
  </tei:text>
