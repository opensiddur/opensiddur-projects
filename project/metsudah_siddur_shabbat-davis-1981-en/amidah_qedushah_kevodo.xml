      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/qedushah/kevodo">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/kevodo/1"/>His glory fills the world,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/kevodo/2"/>His ministering angels ask one another—
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/kevodo/3"/>“Where is the place of His glory?”
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/qedushah/kevodo/regalim_musaf_amidah"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/kevodo/5"/>to revere Him
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/qedushah/kevodo/4"/>Facing them, they offer praise and say:</tei:p>
