  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/binah">
        <tei:head xml:lang="en">PRAYER FOR UNDERSTANDING</tei:head>
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/1"/>You favor man with perception
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/2"/>and teach mankind understanding.
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/binah/shabbat_conclusion_amidah"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="prayer" corresp="urn:x-opensiddur:text:prayer:amidah/attah_chonantanu/text"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/7"/>(You have favored us
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/8"/>[with the ability] to know Your Torah
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/9"/>and taught us to fulfill
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/10"/>the statutes of Your will.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/11"/>You made a distinction, Adonoy, our God,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/12"/>between sacred and unhallowed,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/13"/>between light and darkness,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/14"/>between Israel and the peoples,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/15"/>between the seventh day
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/16"/>and the six work days.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/17"/>Our Father, our King,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/18"/>commence for us
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/19"/>the days that approach us,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/20"/>in peace,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/21"/>devoid of all sin,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/22"/>and cleansed of all iniquity,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/23"/>and devoted to the fear of You.)
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/24"/>And grant us from Your
<tei:milestone unit="phrase"/>
<tei:milestone unit="prayer"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/binah/shabbat_conclusion_amidah"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/3"/>Grant us from Your
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/4"/>wisdom, understanding and knowledge.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/5"/>Blessed are You, Adonoy,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/binah/6"/>Grantor of perception.</tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
