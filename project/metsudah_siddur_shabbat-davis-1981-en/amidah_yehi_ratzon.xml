  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:amidah/yehi_ratzon">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yehi_ratzon/1"/>May it be Your will,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yehi_ratzon/2"/>Adonoy, our God, and the God of our Fathers
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_1"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/yehi_ratzon/shabbat_shacharit_qorban_tamid"><tei:binary value="true"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yehi_ratzon/9"/>to have compassion on us,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yehi_ratzon/10"/>to forgive us all our sins, [done unknowingly],
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yehi_ratzon/11"/>to atone all our iniquities, [done knowingly],
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yehi_ratzon/12"/>to pardon all our [malicious] transgressions,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yehi_ratzon/13"/>and may You build the Holy Temple
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_1"/>
<j:conditional xml:id="variant_2"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/yehi_ratzon/shabbat_shacharit_qorban_tamid"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yehi_ratzon/3"/>that the Holy Temple be rebuilt
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_2"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yehi_ratzon/4"/>speedily in our days,
<tei:milestone unit="phrase"/>
<j:conditional xml:id="variant_3"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/yehi_ratzon/shabbat_shacharit_qorban_tamid"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yehi_ratzon/5"/>and grant us our share in Your Torah.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_3"/>
<j:conditional xml:id="variant_4"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/yehi_ratzon/shabbat_shacharit_qorban_tamid"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yehi_ratzon/6"/>And there we will serve You reverently
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_4"/>
<j:conditional xml:id="variant_5"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/yehi_ratzon/shabbat_shacharit_qorban_tamid"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yehi_ratzon/7"/>as in the days of old,
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_5"/>
<j:conditional xml:id="variant_6"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/yehi_ratzon/shabbat_shacharit_qorban_tamid"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yehi_ratzon/8"/>and in earlier years.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_6"/>
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:malachi/3/4"/>
<j:conditional xml:id="variant_7"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/yehi_ratzon/shabbat_shacharit_qorban_tamid"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yehi_ratzon/14"/>And let Adonoy be pleased
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_7"/>
<j:conditional xml:id="variant_8"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/yehi_ratzon/shabbat_shacharit_qorban_tamid"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yehi_ratzon/15"/>with the offerings of Judah and Jerusalem
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_8"/>
<j:conditional xml:id="variant_9"><tei:fs type="opensiddur:variant"><tei:f name="urn:x-opensiddur:condition:prayer:amidah/yehi_ratzon/shabbat_shacharit_qorban_tamid"><tei:binary value="false"/></tei:f></tei:fs></j:conditional>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:amidah/yehi_ratzon/16"/>as in the days of old and in earlier years.
<tei:milestone unit="phrase"/>
<j:endConditional target="#variant_9"/>
<tei:milestone unit="verse"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
