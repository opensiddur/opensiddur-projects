  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:vehu_rachum">
        <tei:p><tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_rachum/1"/>And He, the Merciful One,
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_rachum/2"/>atones iniquity; and does not destroy.
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_rachum/3"/>He frequently withdraws His anger
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_rachum/4"/>and does not arouse all His rage.<tei:anchor xml:id="note_1"/>
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_rachum/5"/>Adonoy, deliver [us!]
<tei:milestone unit="phrase" corresp="urn:x-opensiddur:text:metsudah:vehu_rachum/6"/>The King will answer us on the day we call.<tei:anchor xml:id="note_2"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
