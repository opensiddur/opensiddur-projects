    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ahavah_piyyut_for_the_shabbat_before_shavuot_isaac">
        <tei:head>אהבה לשבת לפני שבעות</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahavah_piyyut_for_the_shabbat_before_shavuot_isaac/1"/>
        <tei:lg>
          <tei:l>אֲיֻמָּתִי</tei:l>
          <tei:l>יוֹנָה יַעֲלַת חֵן מַה לָּךְ כִּי תִבְכִּי</tei:l>
          <tei:l>מְשִׁיחֵךְ יָבֹא לְךָ קֽוּמִי לָךְ וּלְכִי</tei:l>
          <tei:l>כִּי אֲנִי מוֹשִׁיעֵךְ וְגוֹאֲלֵךְ אֲשֶׁר תְּחַכִּי</tei:l>
          <tei:l>וְעַתָּה֙ כִּ֣י אׇמְנָ֔ם כִּ֥י גֹאֵ֖ל אָנֹ֑כִי׃ <tei:bibl>(רות ג:יב)</tei:bibl></tei:l>
          <tei:l>אֲיֻמָּתִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahavah_piyyut_for_the_shabbat_before_shavuot_isaac/2"/>
        <tei:lg>
          <tei:l>אֱיָלוּתִי</tei:l>
          <tei:l>צוֹפִים אֲשֶׁר צָפוּ נְבוּאָה הַחֲרוּשָׁה</tei:l>
          <tei:l>לִקְרֹא לַעֲזוּבָה אֲשֶׁר הַיּוֹם גְּרוּשָׁה</tei:l>
          <tei:l>חֲשׁוּקָה לִהְיוֹת עוֹד וְגַם תִּהְיֶה דְּרוּשָׁה</tei:l>
          <tei:l>כִּ֥י לְךָ֛ מִשְׁפַּ֥ט הַגְּאֻלָּ֖ה וְהַיְּרֻשָּׁה׃ <tei:bibl>(נראה תהלים ז:ד)</tei:bibl></tei:l>
          <tei:l>אֱיָלוּתִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahavah_piyyut_for_the_shabbat_before_shavuot_isaac/3"/>
        <tei:lg>
          <tei:l>אֲיֻמָּתִי</tei:l>
          <tei:l>חֲשַׁקְתִּיךְ יְפֵה־פִיָּה אוֹתָךְ בִּרְאוֹתִי</tei:l>
          <tei:l>בְּעׇבְרִי עָלַֽיִךְ בְּכׇרְתִי אֶת־בְּרִיתִי</tei:l>
          <tei:l>וְעוֹד אֲנִי אֲקַבְּצֵךְ אֶל־בֵּית מְנוּחָתִי</tei:l>
          <tei:l>אֶל־הַמָּק֖וֹם אֲשֶׁ֥ר הֲכִנֹֽתִי׃ <tei:bibl>(שמות כג:כ)</tei:bibl></tei:l>
          <tei:l>אֲיֻמָּתִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahavah_piyyut_for_the_shabbat_before_shavuot_isaac/4"/>
        <tei:lg>
          <tei:l>אֱיָלוּתִי</tei:l>
          <tei:l>קָרַב צִיר נֶאֱמָן בְּנׇתְנוֹ תּוּשִׁיָּה</tei:l>
          <tei:l>וְצִוַּֽנִי לִהְיוֹת טְהוֹרָה וּנְקִיָּה</tei:l>
          <tei:l>אִם־תִּשְׁמֹֽרִי וְאִם לֹא־תֵּלְכִי בַּשִּׁבְיָה</tei:l>
          <tei:l>וַיְהִ֛י כַּאֲשֶׁ֥ר פָּֽתַר־לָ֖נוּ כֵּ֣ן הָיָ֑ה׃ <tei:bibl>(בראשית מא:יג)</tei:bibl></tei:l>
          <tei:l>אֱיָלוּתִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahavah_piyyut_for_the_shabbat_before_shavuot_isaac/5"/>
        <tei:lg>
          <tei:l>אֲיֻמָּתִי</tei:l>
          <tei:l>בְּחוּנָה בְּכוּר עֹֽנִי בְּמַסְגֵּר מַנְעוּלָךְ</tei:l>
          <tei:l>עוֹד תַּעֲדִי עֶדְיֵךְ בְּזֶֽמֶר מַהֲלָלָךְ</tei:l>
          <tei:l>עֲטֶֽרֶת תִּפְאֶֽרֶת אֲשֶׁר הִיא מַכְלוּלָךְ</tei:l>
          <tei:l>ט֚וֹב תִּתִּ֣י אֹתָ֣הּ לָ֔ךְ׃ <tei:bibl>(בראשית כט:יט)</tei:bibl></tei:l>
          <tei:l>אֲיֻמָּתִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahavah_piyyut_for_the_shabbat_before_shavuot_isaac/6"/>
        <tei:lg>
          <tei:l>אֱיָלוּתִי</tei:l>
          <tei:l>נְדִיבָה הָיִֽיתִי מְקֻשֶּֽׁטֶת בְּכׇל־פְּאֵר</tei:l>
          <tei:l>יְצָאֽוּנִי בָּנַי נִין וָנֶֽכֶד וּשְׁאֵר</tei:l>
          <tei:l>בְּחֹֽשֶׁךְ בּוֹר עָמֹק וְאֵין־לִי מִי יָאֵר</tei:l>
          <tei:l>וְהָאֶ֥בֶן גְּדֹלָ֖ה עַל־פִּ֥י הַבְּאֵֽר׃ <tei:bibl>(בראשית כט:ב)</tei:bibl></tei:l>
          <tei:l>אֱיָלוּתִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahavah_piyyut_for_the_shabbat_before_shavuot_isaac/7"/>
        <tei:lg>
          <tei:l>אֲיֻמָּתִי</tei:l>
          <tei:l>רַעְיָתִי צְאִי־לָךְ מִבֵּין יְדֵי צָרִים</tei:l>
          <tei:l>אֲשֶׁר מְפַתִּים לְךָ בְּפִתּוּי דְּבָרִים</tei:l>
          <tei:l>יַֽעַן לֹא־אָבִית דְּלֹק אַחֲרֵי זָרִים</tei:l>
          <tei:l>לְבִלְתִּי־לֶ֗כֶת אַֽחֲרֵי֙ הַבַּ֣חוּרִ֔ים׃ <tei:bibl>(רות ג:י)</tei:bibl></tei:l>
          <tei:l>אֲיֻמָּתִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahavah_piyyut_for_the_shabbat_before_shavuot_isaac/8"/>
        <tei:lg>
          <tei:l>אֱיָלוּתִי</tei:l>
          <tei:l>וַאֲנִי בְּגָלוּת עֲצוּרָה בִּרְגָזוֹת</tei:l>
          <tei:l>בְּהֶבְלָם פִּתּֽוּנִי וְיַעֲנֽוּנִי עַזּוֹת</tei:l>
          <tei:l>לַעֲזֹב אֶת־שִׁמְךָ וְאֶת־עֵד חָזוֹת</tei:l>
          <tei:l>יְהֹוָ֣ה אֱ֭לֹהַי אִם־עָשִׂ֣יתִי זֹ֑את׃ <tei:bibl>(תהלים ז:ד)</tei:bibl></tei:l>
          <tei:l>אֱיָלוּתִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahavah_piyyut_for_the_shabbat_before_shavuot_isaac/9"/>
        <tei:lg>
          <tei:l>אֲיֻמָּתִי</tei:l>
          <tei:l>הֵן בִּי נִשְׁבַּֽעְתִּי לֶאֱסֹף נִכְבָּשַׁי</tei:l>
          <tei:l>הֲלֹא אָז הַמְּלָכִים לָךְ יוֹבִֽילוּ שַׁי</tei:l>
          <tei:l>הֵן עַד לְאֻמִּים שַֽׂמְתִּי לִקְדוֹשַׁי</tei:l>
          <tei:l>הִנֵּ֨ה רָאִ֜יתִי בֵּ֣ן לְיִשַׁי֮׃</tei:l>
          <tei:l>אֲיֻמָּתִי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ahavah_piyyut_for_the_shabbat_before_shavuot_isaac/10"/>
        <tei:lg>
          <tei:l>וְקֵרַבְתָּֽנוּ לְשִׁמְךָ הַגָּדוֹל סֶֽלָה בֶּאֱמֶת</tei:l>
          <tei:l>לְהוֹדוֹת לְךָ וּלְיַחֶדְךָ בְּאַהֲבָה׃</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה הַבּוֹחֵר בְּעַמּוֹ יִשְׂרָאֵל בְּאַהֲבָה׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
