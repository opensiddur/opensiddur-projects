    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:untitled_prayer_singer">
        <tei:head>רִבּוֹנוֹ שֶׁל עוֹלָם</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:untitled_prayer_singer/1"/>
        <tei:lg>
          <tei:l>רִבּוֹנוֹ שֶׁל עוֹלָם,</tei:l>
          <tei:l>תֵּן בְּלִבִּי אַהֲבַת יִשְׂרָאֵל</tei:l>
          <tei:l>וּמְנוּחַת הַנֶּפֶשׁ.</tei:l>
          <tei:l>הֲבִינֵנִי לִרְאוֹת בְּכׇל בְּרִיאָה וּבְרִיאָה אֶת בּוֹרְאָהּ</tei:l>
          <tei:l>וְאֶת חַסְדּוֹ לְכׇל נִבְרָא.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:untitled_prayer_singer/2"/>
        <tei:lg>
          <tei:l>אֵין בְּכׇל הָעוֹלָם</tei:l>
          <tei:l>אַף טִפַּת מַיִם אַחַת</tei:l>
          <tei:l>אוֹ חֵלֶק קָטָן שֶׁל אָבָק</tei:l>
          <tei:l>שֶׁאֵין אוֹרְךָ בָּהֶם</tei:l>
          <tei:l>וְשֶׁהֵם חוּץ מִמֶּמְשַׁלְתְּךָ.</tei:l>
          <tei:l>אֵין יְצוּר בְּלִי יוֹצְרוֹ.</tei:l>
          <tei:l>לָכֵן בֶּן הַדַּעַת הוּא לְעוֹלָם בְּשִׂמְחָה.</tei:l>
          <tei:l>אָבִיו וְאִמּוֹ הֵם רַק גּוּפִים</tei:l>
          <tei:l>שֶׁהַיּוֹם כָּאן וּמָחָר בַּקֶּבֶר.</tei:l>
          <tei:l>כׇּל יְדִידָיו,</tei:l>
          <tei:l>כׇּל הוֹנוֹ וּכְבוֹדוֹ</tei:l>
          <tei:l>הֵם רַק כְּצֵל עוֹבֵר.</tei:l>
          <tei:l>הוּא בְּעַצְמוֹ הוּא כְּעָנָן פּוֹרֵחַ,</tei:l>
          <tei:l>כְּקִיקָיוֹן דְּיוֹנָה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:untitled_prayer_singer/3"/>
        <tei:lg>
          <tei:l>אֲבָל אַתָּה מֵעוֹלָם אַתָּה</tei:l>
          <tei:l>וּלְעוֹלָם תִּהְיֶה.</tei:l>
          <tei:l>אַתָּה הִנְּךָ הַמַּמָּשׁוּת הַיְּחִידָה,</tei:l>
          <tei:l>יְסוֹד כׇּל דָּבָר.</tei:l>
          <tei:l>אַךְ בְּךָ כׇּל הַשְּׁאֵלוֹת מְתֹרָצִים,</tei:l>
          <tei:l>כׇּל הַקֻּשִּׁיּוֹת מֻפְרָכִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:untitled_prayer_singer/4"/>
        <tei:lg>
          <tei:l>אֵין בְּךָ נִפְתָּל וְעֹנֶשׁ,</tei:l>
          <tei:l>לֹא עַוְלָה וּמוּם.</tei:l>
          <tei:l>הָרַע יְסוֹדוֹ בַּדְּבָרִים הָעוֹבְרִים,</tei:l>
          <tei:l>לֹא בַּקִּיּוּם הַנִּצְחִי.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:untitled_prayer_singer/5"/>
        <tei:lg>
          <tei:l>אַתָּה יוֹדֵעַ לָמָּה בָּרָאתָ אֶת הָרַע</tei:l>
          <tei:l>וּמָה אֲנַחְנוּ לִדְרֹשׁ אַחֲרֵי מִדּוֹתֶךָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:untitled_prayer_singer/6"/>
        <tei:lg>
          <tei:l>יֵשׁ לָנוּ בָּעוֹלָם הַזֶּה רַק נֶחָמָה אַחַת:</tei:l>
          <tei:l>שֶׁאַתָּה אָבִינוּ וּבְיָדֵנוּ לַעֲבֹד אוֹתְךָ</tei:l>
          <tei:l>בְּשִׂמְחָה, בְּיִרְאָה, בְּאַהֲבָה כׇּל יְמֵי חַיֵּינוּ,</tei:l>
          <tei:l>וְשֶׁנָּתַתָּ לָנוּ שֵׂכֶל לְהָבִין אֵיזוֹ דְּבָרִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:untitled_prayer_singer/7"/>
        <tei:lg>
          <tei:l>אַף אִם אֵין אֲנַחְנוּ יוֹדְעִים תַּכְלִית חַיֵּינוּ</tei:l>
          <tei:l>וְלָמָּה שְׁלַחְתָּנוּ לְעוֹלָם הַזֶּה לִסְבֹּל,</tei:l>
          <tei:l>מְבִינִים אֲנַחְנוּ כִּי חוֹבָתֵנוּ הִיא לִבְנוֹת וְלֹא לַהֲרֹס,</tei:l>
          <tei:l>לְנַחֵם וְלֹא לְהַכּוֹת,</tei:l>
          <tei:l>לְשַׂמֵּחַ וְלֹא לְהַעֲצִיב אֶת בְּרִיּוֹתֶיךָ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:untitled_prayer_singer/8"/>
        <tei:lg>
          <tei:l>יֵשׁ רַק שִׂמְחָה אַחַת:</tei:l>
          <tei:l>לְהַרְבּוֹת אֶת סְכוּם הַשִּׂמְחָה בָּעוֹלָם וְלֹא לְהַמְעִיטוֹ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:untitled_prayer_singer/9"/>
        <tei:lg>
          <tei:l>רֻץ אַחֲרֵי הָאֹשֶׁר</tei:l>
          <tei:l>אֲבָל אַל תַשִּׂיגֵנוּ עַל חֶשְׁבּוֹן שְׁכֵנֶךָ וְאָחִיךָ,</tei:l>
          <tei:l>כִּי הוּא אַתָּה וְאַתָּה הוּא,</tei:l>
          <tei:l>אַחִים אַתֶּם, בְּנֵי אֱלֹהִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:untitled_prayer_singer/10"/>
        <tei:lg>
          <tei:l>אֱלוֹהַּ,</tei:l>
          <tei:l>נְצֹר לְשׁוֹנִי מֵרָע</tei:l>
          <tei:l>וּשְׂפָתַי מִדַּבֵּר מִרְמָה</tei:l>
          <tei:l>וּמוֹחִי מִלַּחֲשֹׁב אָוֶן.</tei:l>
          <tei:l>פְּתַח לִבִּי בְּמִצְווֹתֶיךָ</tei:l>
          <tei:l>וְאַחֲרֵי תוֹרָתֶךָ תִּרְדֹּף נַפְשִׁי</tei:l>
          <tei:l>וְשֶׁכׇּל מַעֲשַׂי יִהְיוּ לְשֵׁם שָׁמַיִם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:untitled_prayer_singer/11"/>
        <tei:lg>
          <tei:l>הַיְּהוּדִים הַיְּרֵאִים</tei:l>
          <tei:l>הֵם הָאֲנָשִׁים הַיְּחִידִים שֶׁאֵינָם מַזִּיקִים זֶה לָזֶה</tei:l>
          <tei:l>לֹא בְּכוֹחַ וְלֹא בְּפֹעַל.</tei:l>
          <tei:l>לֹא יִלָּחֲמוּ לְעוֹלָם זֶה בָּזֶה</tei:l>
          <tei:l>וְלָכֵן הֵם סֵמֶל הַשָּׁלוֹם בָּעוֹלָם,</tei:l>
          <tei:l>כְּמוֹ שֶׁכָּתוּב וְרַב שְׁלוֹם בָּנָיִךְ. <tei:bibl>(ישעיה נד:יג)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
