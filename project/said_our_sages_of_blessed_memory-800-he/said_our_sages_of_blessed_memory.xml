  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:said_our_sages_of_blessed_memory">
        <tei:head>אָמְרוּ רַבּוֹתֵֽינוּ זִכְרוֹנָם לִבְרָכָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:said_our_sages_of_blessed_memory/1"/>
        <tei:lg>
          <tei:l>אָמְרוּ רַבּוֹתֵֽינוּ זִכְרוֹנָם לִבְרָכָה —</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:said_our_sages_of_blessed_memory/2"/>
        <tei:lg>
          <tei:l>כְּשֶׁיָּרַד הַקָּדוֹשׁ בָּרוּךְ הוּא עַל הַמִּצְרִים בְּמִצְרַֽיִם יָרְדוּ עִמּוֹ תִּשְׁעַת אֲלָפִים רְבָבוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:said_our_sages_of_blessed_memory/3"/>
        <tei:lg>
          <tei:l>מֵהֶם מַלְאֲכֵי אֵשׁ, וּמֵהֶם מַלְאֲכֵי בָרָד, וּמֵהֶם מַלְאֲכֵי זִֽיעַ, וּמֵהֶם מַלְאֲכֵי רְתֵת, וּמֵהֶם מַלְאֲכֵי חַלְחָלָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:said_our_sages_of_blessed_memory/4"/>
        <tei:lg>
          <tei:l>וּרְתֵת וְחַלְחָלָה אוֹחֶֽזֶת לְמִי־שֶׁהוּא רוֹאֶה אוֹתָם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:said_our_sages_of_blessed_memory/5"/>
        <tei:lg>
          <tei:l>אָמְרוּ לְפָנָיו — רִבּוֹנוֹ שֶׁל־עוֹלָם,<tei:anchor xml:id="note_1"/> וַהֲלֹא מֶֽלֶךְ בָּשָׂר וָדָם כְּשֶׁהוּא יוֹרֵד לַמִּלְחָמָה שָׂרָיו וַעֲבָדָיו מַקִּיפִין בִּכְבוֹדוֹ? וְאַתָּה מֶֽלֶךְ מַלְכֵי הַמְּלָכִים!<tei:anchor xml:id="note_2"/> דַּיָּן עָלֵֽינוּ שֶׁאֲנַֽחְנוּ עֲבָדֶֽיךָ וְהֵם בְּנֵי בְרִיתֶֽךָ! נֵרֵד וְנַעֲשֶׂה עִמָּם מִלְחָמָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:said_our_sages_of_blessed_memory/6"/>
        <tei:lg>
          <tei:l>אָמַר לָהֶם — אֵין דַּעְתִּי מִתְקָרֶֽרֶת עַד שֶׁאֵרֵד אֲנִי בְּעַצְמִי, אֲנִי בִּכְבוֹדִי, אֲנִי בִּגְדֻלָּתִי, אֲנִי בִּקְדֻשָּׁתִי, אֲנִי יהוה, אֲנִי הוּא וְלֹא אַחֵר׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" n="1" target="#note_1">
      <tei:p>יש אומרים — אֱלֹהֵי הָאֱלֹהִים וַאֲדוֹנֵי הָאַדוֹנִים</tei:p>
    </tei:note>
    <tei:note type="commentary" n="2" target="#note_2">
      <tei:p>יש אומרים — הַקָּדוֹשׁ בָּרוּךְ הוּא</tei:p>
    </tei:note>
  </tei:standOff>
