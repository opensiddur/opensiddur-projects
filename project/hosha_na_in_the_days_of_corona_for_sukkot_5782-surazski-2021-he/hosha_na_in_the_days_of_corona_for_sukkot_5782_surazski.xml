      <tei:div corresp="urn:x-opensiddur:text:prayer:hosha_na_in_the_days_of_corona_for_sukkot_5782_surazski">
        <tei:head>הושע־נא לימי הקרונה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_in_the_days_of_corona_for_sukkot_5782_surazski/1"/>
        <tei:lg>
          <tei:l>הוֹשַׁע נָא לְמַעַנְךָ אֱלֹהֵינוּ הוֹשַׁע נָא׃</tei:l>
          <tei:l>הוֹשַׁע נָא לְמַעַנְךָ בּוֹרְאֵנוּ הוֹשַׁע נָא׃</tei:l>
          <tei:l>הוֹשַׁע נָא לְמַעַנְךָ גּוֹאֲלֵנוּ הוֹשַׁע נָא׃</tei:l>
          <tei:l>הוֹשַׁע נָא לְמַעַנְךָ דּוֹרְשֵׁנוּ הוֹשַׁע נָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_in_the_days_of_corona_for_sukkot_5782_surazski/2"/>
        <tei:lg>
          <tei:l>לְמַעַן אֲהוּבֵינוּ</tei:l>
          <tei:l>לְמַעַן בְּרִיאוּתֵנוּ</tei:l>
          <tei:l>לְמַעַן גּוֹרָלֵנוּ</tei:l>
          <tei:l>לְמַעַן דִּמְעוֹתֵינוּ</tei:l>
          <tei:l>לְמַעַן הוֹרֵינוּ</tei:l>
          <tei:l>לְמַעַן וָתִיקֵי עָרֵינוּ</tei:l>
          <tei:l>לְמַעַן זְקֵנֵנוּ</tei:l>
          <tei:l>לְמַעַן חֶבְרָתֵנוּ</tei:l>
          <tei:l>לְמַעַן טוֹבֵי מוֹשְׁלֵנוּ</tei:l>
          <tei:l>לְמַעַן יְלָדֵינוּ</tei:l>
          <tei:l>לְמַעַן כְּמִיהָתֵנוּ</tei:l>
          <tei:l>לְמַעַן לְבָבֵנוּ</tei:l>
          <tei:l>לְמַעַן מִנְיָנֵנוּ</tei:l>
          <tei:l>לְמַעַן נִשְׁמָתֵנוּ</tei:l>
          <tei:l>לְמַעַן סִבְלֵנוּ</tei:l>
          <tei:l>לְמַעַן עוֹלָמֵנוּ</tei:l>
          <tei:l>לְמַעַן פַּרְנָסָתֵנוּ</tei:l>
          <tei:l>לְמַעַן צְעִירֵנוּ</tei:l>
          <tei:l>לְמַעַן קְהָלֵנוּ</tei:l>
          <tei:l>לְמַעַן רוֹפְאֵנוּ</tei:l>
          <tei:l>לְמַעַן שְׁפִיּוּתֵנוּ</tei:l>
          <tei:l>לְמַעַן תִּקְוָתֵנוּ</tei:l>
          <tei:l>הוֹשַׁע נָע׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
