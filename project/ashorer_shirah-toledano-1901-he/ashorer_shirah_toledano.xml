  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ashorer_shirah_toledano">
        <tei:head>אֲשׁוֹרֵר שִׁירָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashorer_shirah_toledano/1"/>
        <tei:lg>
          <tei:l>אֲשׁוֹרֵר שִׁירָה לִכְבוֹד הַתּוֹרָה</tei:l>
          <tei:l>מִפָּז יְקָרָה זַכָּה וּבָרָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashorer_shirah_toledano/2"/>
        <tei:lg>
          <tei:l>תּוֹרָה תְּמִימָה נְעִימָה רַבָּה</tei:l>
          <tei:l>פֶּתִי מַחְכִּימָה עַיִן מְאִירָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashorer_shirah_toledano/3"/>
        <tei:lg>
          <tei:l>אַשְׁרֵי הַגֶּבֶר עַל יִצְרוֹ גּוֹבֵר</tei:l>
          <tei:l>מֵישָׁרִים דּוֹבֵר בּוֹחֵר בַּתּוֹרָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashorer_shirah_toledano/4"/>
        <tei:lg>
          <tei:l>נֶאֱמָן שְׁמוֹ בּוֹחֵר בְּעַמּוֹ</tei:l>
          <tei:l>לִהְיוֹת לוֹ לִשְׁמוֹ אוּמָּה נִבְחֲרָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ashorer_shirah_toledano/5"/>
        <tei:lg>
          <tei:l>נִתְּנָה לָנוּ עַל יַד רוֹעֵנוּ</tei:l>
          <tei:l>מֹשֶׁה רַבֵּנוּ בְּחִיר הָאֻמָּה</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
