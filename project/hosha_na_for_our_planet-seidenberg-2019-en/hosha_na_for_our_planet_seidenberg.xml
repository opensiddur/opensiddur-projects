  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hosha_na_for_our_planet_seidenberg">
        <tei:head>Hosha-na for Our Planet, by Rabbi David Seidenberg (neohasid·org)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_our_planet_seidenberg/1"/>
        <tei:lg>
          <tei:l>Our God, Please save!</tei:l>
          <tei:l>Our Creator, Please save!</tei:l>
          <tei:l>Our Redeemer, Please save!</tei:l>
          <tei:l>Our Seeker, Please save!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_our_planet_seidenberg/2"/>
        <tei:lg>
          <tei:l><tei:hi rend="italic">Hoshana!</tei:hi> Please save aquifers from poison and drought! <tei:hi rend="italic">Hoshana!</tei:hi></tei:l>
          <tei:l>Save bees from pesticides and fungus and collapse! <tei:hi rend="italic">Hoshana!</tei:hi></tei:l>
          <tei:l>Save bedrock from fracking and earthquakes! <tei:hi rend="italic">Hoshana!</tei:hi></tei:l>
          <tei:l>Save the breathing of this blue planet! <tei:hi rend="italic">Hoshana!</tei:hi></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_our_planet_seidenberg/3"/>
        <tei:lg>
          <tei:l>Save clouds from withholding their treasures! <tei:hi rend="italic">Hoshana!</tei:hi></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_our_planet_seidenberg/4"/>
        <tei:lg>
          <tei:l>Save Earth and all that fills her! <tei:hi rend="italic">Hoshana!</tei:hi></tei:l>
          <tei:l>Save the forests from clearcutting, and from conflagration! <tei:hi rend="italic">Hoshana!</tei:hi></tei:l>
          <tei:l>Save flesh and spirit and soul in every being! <tei:hi rend="italic">Hoshana!</tei:hi></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_our_planet_seidenberg/5"/>
        <tei:lg>
          <tei:l>Save glistening rivers from becoming rivers of oil and blood! <tei:hi rend="italic">Hoshana!</tei:hi></tei:l>
          <tei:l>Save habitat and home and species! <tei:hi rend="italic">Hoshana!</tei:hi></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_our_planet_seidenberg/6"/>
        <tei:lg>
          <tei:l>Please save! Keep drought from decimating! <tei:hi rend="italic">Hoshana!</tei:hi></tei:l>
          <tei:l>Save lodgepole and ponderosa from pine beetle! <tei:hi rend="italic">Hoshana!</tei:hi></tei:l>
          <tei:l>Save mollusk and plankton shells from being eaten away by the sea they drink and breathe! <tei:hi rend="italic">Hoshana!</tei:hi></tei:l>
          <tei:l>Save northern plains from flowing oil! <tei:hi rend="italic">Hoshana!</tei:hi></tei:l>
          <tei:l>Save our will and vision from despair! <tei:hi rend="italic">Hoshana!</tei:hi></tei:l>
          <tei:l>Save our prayers from being empty words! <tei:hi rend="italic">Hoshana!</tei:hi></tei:l>
          <tei:l>Save pipelines already pumping from leaks! <tei:hi rend="italic">Hoshana!</tei:hi></tei:l>
          <tei:l>Save refugees from drowning and war and hate! <tei:hi rend="italic">Hoshana!</tei:hi></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_our_planet_seidenberg/7"/>
        <tei:lg>
          <tei:l>Please save! Renew the face of the Earth! <tei:hi rend="italic">Hoshana!</tei:hi></tei:l>
          <tei:l>Save sacred lands from being stripped and stolen and despoiled! <tei:hi rend="italic">Hoshana!</tei:hi></tei:l>
          <tei:l>Save seas from inundating islands and cities! <tei:hi rend="italic">Hoshana!</tei:hi></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_our_planet_seidenberg/8"/>
        <tei:lg>
          <tei:l>Please save! Show us the rainbow rejoicing in its colors! <tei:hi rend="italic">Hoshana!</tei:hi></tei:l>
          <tei:l>Save the weave and web of Life! <tei:hi rend="italic">Hoshana!</tei:hi></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_our_planet_seidenberg/9"/>
        <tei:lg>
          <tei:l>Please save a world suspended in the nothingness of space! <tei:hi rend="italic">Hoshana!</tei:hi></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_our_planet_seidenberg/10"/>
        <tei:lg>
          <tei:l>Save, please! <tei:hi rend="italic">Hoshana!</tei:hi></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
