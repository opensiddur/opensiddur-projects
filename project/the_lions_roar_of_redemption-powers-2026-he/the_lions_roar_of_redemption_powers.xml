  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:the_lions_roar_of_redemption_powers">
        <tei:head>גאולת שאגת הארי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_lions_roar_of_redemption_powers/1"/>
        <tei:lg>
          <tei:l>דָּקְרוּ צָרִים<tei:anchor xml:id="note_1"/> בְּיוֹם חַג,<tei:anchor xml:id="note_2"/> בְּטֶבַח תִּקְוָה נֶהְדַּף</tei:l>
          <tei:l>דְּבַר בֶּן הָאָדָם<tei:anchor xml:id="note_3"/> הוּצַב לְיוֹשֵׁב לָבֶטַח<tei:anchor xml:id="note_4"/> גּוֹיִם מְאֻסַּף<tei:anchor xml:id="note_5"/></tei:l>
          <tei:l>דָּרַךְ גּוֹג חִצָּיו וְשָׁלַח הַרְחֵק מֵאֶרֶץ פָּרַס<tei:anchor xml:id="note_6"/></tei:l>
          <tei:l>דּוֹר נִצָּחוֹן לֹא נִכְנָע, נַפְשׁוֹ בּוֹעֵר וְלֹא נִשְׂרָף׃<tei:anchor xml:id="note_7"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_lions_roar_of_redemption_powers/2"/>
        <tei:lg>
          <tei:l>וּפָרְצוּ גְּבוּל בְּעֵת צָרָה, אֶל אֶרֶץ צִיָּה לְעֵת קֵץ פּוֹרִיָּה<tei:anchor xml:id="note_8"/></tei:l>
          <tei:l>וְדַם עֲנָוִים צוֹעֵק מֵאֲדָמָה, לִפְרִיסַת הַמַּעֲרָכָה</tei:l>
          <tei:l>וְעַל צְבָא גּוֹג הָאַכְזָר וְהָרָשָׁע, נִיצָּב הָעָם בִּגְבוּרָה</tei:l>
          <tei:l>וְחַרְבוֹת בַּרְזֶל בְּיָדָם וְאִם יִשְׁאַג מִי לֹא יִירָא׃<tei:anchor xml:id="note_9"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_lions_roar_of_redemption_powers/3"/>
        <tei:lg>
          <tei:l>דִּינָם יֻתַּן בְּפֶתַע עֹז, פּוֹתְחֵי הָרָעָה מִצָּפוֹן<tei:anchor xml:id="note_10"/></tei:l>
          <tei:l>דְּעוּ שֶׁהַחֶשְׁבּוֹן יוּשְׁלַם, בְּהִשָּׁמְדָם בְּתִמָּהוֹן</tei:l>
          <tei:l>דַּאֲגָה וָפַחַד וּפַחַת<tei:anchor xml:id="note_11"/> יָצָא לְכָל העוֹלָם בְּשָׁמְעוֹ</tei:l>
          <tei:l>דֶּרֶךְ הַקֶּשֶׁר בַּכִּיס<tei:anchor xml:id="note_12"/> חֲמֵשֶׁת אֲלָפִים בִּין רֶגַע יִפּוֹל.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_lions_roar_of_redemption_powers/4"/>
        <tei:lg>
          <tei:l>הִתְעוֹרְרִי הִתְעוֹרְרִי,<tei:anchor xml:id="note_13"/> עַמִּי קָם כְּלָבִיא</tei:l>
          <tei:l>הִנֵּה אָנֹכִי שׁוֹלֵחַ לָכֶם אֶת אֵלִיָּה הַנָּבִיא<tei:anchor xml:id="note_14"/></tei:l>
          <tei:l>הֲרֵי הוּא בָּא לְהָשִׁיב לֵב אָבוֹת עַל בָּנִים</tei:l>
          <tei:l>הַדָּא הוּא דִכְתִיב: לֹא בְּחַיִל וְלֹא בְּכֹחַ כִּי אִם בְּרוּחִי׃<tei:anchor xml:id="note_15"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_lions_roar_of_redemption_powers/5"/>
        <tei:lg>
          <tei:l>לִירוּשָׁלַיִם עִירְךָ בְּרַחֲמִים תָּשׁוּב<tei:anchor xml:id="note_16"/></tei:l>
          <tei:l>לְלוֹמְדֵי תוֹרָה וַהֲלָכָה וּמִדְרָשׁ וּמִשְׁנָה וְתַלְמוּד</tei:l>
          <tei:l>לְגִבּוֹרֵי חַיִל נֶאֶמְצוּ,<tei:anchor xml:id="note_17"/> בִּשְׁבִיל זֶה רַגְלַיִם עָמְדוּ<tei:anchor xml:id="note_18"/></tei:l>
          <tei:l>לוּלֵי תוֹרָתְךָ שַׁעֲשׁוּעָי אָז בְּעָנְיֵנוּ אָבַדְנוּ׃<tei:anchor xml:id="note_19"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_lions_roar_of_redemption_powers/6"/>
        <tei:lg>
          <tei:l>לְצִיּוֹן גּוֹאֵל בָּא<tei:anchor xml:id="note_20"/> כַּאֲשֶׁר גָּלוּ עֵיְנֵי הַכֹּל</tei:l>
          <tei:l>וּלְשָׁבֵי פֶשַׁע בְּיַעֲקֹב חוֹזְרֵי דַּת הָעֶלְיוֹן</tei:l>
          <tei:l>לְשׁוֹנֵנוּ רִנָּה בִּרְאוֹת הָאוֹיֵב שֶׁיִּפּוֹל</tei:l>
          <tei:l>לָבִיא יָקוּם אַרְיֵה יִשְׁאַג, אָז יֹאמְרוּ בַּגּוֹיִם ה’ גָּדוֹל׃<tei:anchor xml:id="note_21"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_lions_roar_of_redemption_powers/7"/>
        <tei:lg>
          <tei:l>נִגְלָה בְּרַעַשׁ גָּדוֹל אַדִּיר וְחָזָקה וּבְאַזְעָקָה</tei:l>
          <tei:l>נָטָה זְרוֹעוֹ עַל שׂוֹנְאָיו הִפִּילָם אֶל שְׁאוֹל תַּחְתִּיָּה</tei:l>
          <tei:l>נִיצָּב רַגְלוֹ עַל הַר הַזֵּיתִים<tei:anchor xml:id="note_22"/> וְהִנֵּה אָדֹם בְּשַׂלְמָה<tei:anchor xml:id="note_23"/></tei:l>
          <tei:l>נִפְתַּח לְבֵית דָּוִד מָקוֹר לְחַטָּאת וּלְנִדָּה׃<tei:anchor xml:id="note_24"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_lions_roar_of_redemption_powers/8"/>
        <tei:lg>
          <tei:l>יְמִין ה’ רוֹמֵמָה,<tei:anchor xml:id="note_25"/> גָּבַר עַל עַמּוֹ חֲסָדָיו</tei:l>
          <tei:l>יִרְקַב שֵׁם רְשָׁעִים,<tei:anchor xml:id="note_26"/> עֲלֵיהֶם הַר כְּגִיגִית כְּפָאָהּ<tei:anchor xml:id="note_27"/></tei:l>
          <tei:l>יְשׁוּעַת עוֹלָמִים לְיִשְׂרָאֵל וּבְאֵר שַׁחַת לָאייתולה<tei:anchor xml:id="note_28"/></tei:l>
          <tei:l>יִשְׁאַג הָאֲרִי מִמְּעוֹנוֹ,<tei:anchor xml:id="note_29"/> אוֹר חָדָשׁ עַל צִיּוֹן הָאִירָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_lions_roar_of_redemption_powers/9"/>
        <tei:lg>
          <tei:l>סֹלּוּ דֶרֶךְ כָּל גּוֹיִם לְעִיר ה׳ לְעוֹנַת סְתָיו<tei:anchor xml:id="note_30"/></tei:l>
          <tei:l>סֻכּוֹת בְּנוּ לְעַצְמְכֶם, הִנֵּה נָתַתִּי מִצְוָה קַלָּה<tei:anchor xml:id="note_31"/></tei:l>
          <tei:l>סוּרוּ סְרוּחוּ סוֹרְרִים, בְּעָטוּ בָהּ כְּפוּיֵי טוֹבָה</tei:l>
          <tei:l>סוּפָה וּסְעָרָה לְעַם הַגַּג<tei:anchor xml:id="note_32"/> וּלְסֹכְכֵי סְכָךְ שָלום וְשַׁלְוָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:the_lions_roar_of_redemption_powers/10"/>
        <tei:lg>
          <tei:l>נִפְלָאוֹת תִּרְאֵנוּ כָּפוּל עַל יְצִיאָה מִמֵּיצָר וּבוֹר<tei:anchor xml:id="note_33"/></tei:l>
          <tei:l>נֶאֱמַר לֹא עוֹד “יִגְדַּל ה’ אֲשֶׁר הוֹצִיא אֶת עַמּוֹ מֵאֶרֶץ הַיְאוֹר”<tei:anchor xml:id="note_34"/></tei:l>
          <tei:l>נִסִּים אַחֲרוֹנִים יִגְבְּרוּ עַד בְּלִי דַּי, לָרִאשׁוֹנִים יִקְחוּ אֶת הַמָּקוֹם</tei:l>
          <tei:l>נֵצַח נְצָחִים קְדֻשָּׁתְךָ נַקְדִּישׁ בַּחַיִּים וּבְשִׂמְחָה וּבְשָׁלוֹם׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" n="1" target="#note_1">
      <tei:p>זכריה יב, י: “והביטו אלי את אשר דקרו”.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="2" target="#note_2">
      <tei:p>שמחת תורה תשפ״ד.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="3" target="#note_3">
      <tei:p>פנייה קבועה ליחזקאל בנבואות גוג (יחזקאל לח).</tei:p>
    </tei:note>
    <tei:note type="commentary" n="4" target="#note_4">
      <tei:p>שם, יב: “הַמְאֻסָּף מִגּוֹיִם”.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="5" target="#note_5">
      <tei:p>יחזקאל לח יא: “כֻּלָּם יֹשְׁבִים בְּאֵין חוֹמָה.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="6" target="#note_6">
      <tei:p>יחזקאל לח, ה: “פָּרַס כּוּשׁ וּפוּט אִתָּם”.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="7" target="#note_7">
      <tei:p>הסנה הבוער.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="8" target="#note_8">
      <tei:p>נגב המערבי (עוטף עזה), שהיה שממה דורות ופרח עד הקץ, כנבואת יחזקאל לח, ח: “אֶל אֶרֶץ מְשׁוֹבֶבֶת מֵחֶרֶב... וְהִיא מִגּוֹיִם הוּצָאָה וְיָשְׁבוּ לָבֶטַח כֻּלָּם”.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="9" target="#note_9">
      <tei:p>עמוס ג, ח: “אריה שאג מי לא יירא”.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="10" target="#note_10">
      <tei:p>ירמיהו א, יד: “מצפון תפתח הרעה”.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="11" target="#note_11">
      <tei:p>ישעיהו כד, יז.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="12" target="#note_12">
      <tei:p>רמז למבצע הביפרים׃</tei:p>
    </tei:note>
    <tei:note type="commentary" n="13" target="#note_13">
      <tei:p>ישעיהו נב, א.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="14" target="#note_14">
      <tei:p>מלאכי ג, כג.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="15" target="#note_15">
      <tei:p>זכריה ד, ו.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="16" target="#note_16">
      <tei:p>שמונה עשרי.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="17" target="#note_17">
      <tei:p>זכריה יב, ה: “אָמְצָה לִּי יֹשְׁבֵי יְרוּשָׁלִַם”. הכוח של הלוחמים נובע מהתפילה של אנשי ירושלים.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="18" target="#note_18">
      <tei:p>תהלים קכב, ב. וראה רש״י שם</tei:p>
    </tei:note>
    <tei:note type="commentary" n="19" target="#note_19">
      <tei:p>תהלים קיט, צב.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="20" target="#note_20">
      <tei:p>ישעיהו נט, כ.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="21" target="#note_21">
      <tei:p>תהלים קכו, ב.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="22" target="#note_22">
      <tei:p>זכריה יד, ד.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="23" target="#note_23">
      <tei:p>ישעיהו סג, א: “חמוץ בגדים מבצרה”.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="24" target="#note_24">
      <tei:p>זכריה יג, א.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="25" target="#note_25">
      <tei:p>תהלים קיח, טז.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="26" target="#note_26">
      <tei:p>משלי י, ז.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="27" target="#note_27">
      <tei:p>עבודה זרה ב, ב. כפיית הדין על הרשעים.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="28" target="#note_28">
      <tei:p>נפילת שלטון הרשע האיראני כהבטחה ודאית.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="29" target="#note_29">
      <tei:p>ירמיהו כה, ל.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="30" target="#note_30">
      <tei:p>חג הסוכות והגאולה העתידית הצמודה לו.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="31" target="#note_31">
      <tei:p>עבודה זרה ג, א: המבחן של הגויים בסוכה.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="32" target="#note_32">
      <tei:p>רמז לשוני ל”גוג”. האויבים בוטחים ב”כוחי ועוצם ידי” המסומל ע״י הגגות והמבצרים, מול ישראל החוסים תחת הסכך.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="33" target="#note_33">
      <tei:p>רמז למצרים (מיצר/עזה) ולבור יוסף (בור/מנהרות עזה).</tei:p>
    </tei:note>
    <tei:note type="commentary" n="34" target="#note_34">
      <tei:p>ירמיהו טז, טו: הגאולה שתשכיח את יציאת מצרים.</tei:p>
    </tei:note>
  </tei:standOff>
