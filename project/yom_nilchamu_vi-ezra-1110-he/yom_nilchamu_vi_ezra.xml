    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yom_nilchamu_vi_ezra">
        <tei:head>יוֹם נִלְחֲמוּ בִי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_nilchamu_vi_ezra/1"/>
        <tei:lg>
          <tei:l>יוֹם נִלְחֲמוּ בִי יַֽחַד שְׁכֵנַי</tei:l>
          <tei:l>חַסְדֵי יְהֹוָה הָיוּ אֲזֵנָי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_nilchamu_vi_ezra/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אֶ</tei:seg>עְרֹג כְּאַיָּלִים עַל־אֲפִיקִים</tei:l>
          <tei:l>עַל־רוּם מְשַׂנְאִים כִּבְנֵי עֲנָקִים</tei:l>
          <tei:l>קָדְרוּ מְאוֹרֵי אוֹר בַּשְּׁחָקִים</tei:l>
          <tei:l>שָׁחָה אֲלוּמַּת בָּנַי וּפָנַי</tei:l>
          <tei:l>נָפְלוּ וְאֵין לִי חֵֽפֶץ בְּשָׁנָי׃</tei:l>
          <tei:l>יוֹם...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_nilchamu_vi_ezra/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בָּ</tei:seg>נַי יְתוֹמִים בְּחֵי אֲבִיהֶם</tei:l>
          <tei:l>וּמְכַֽחֲשֵׁי־אֵל הָמוּ עֲלֵיהֶם</tei:l>
          <tei:l>שָׁפְכוּ כְּמַֽיִם דַּם עוֹלֲלֵיהֶם</tei:l>
          <tei:l>עַל־עֵץ הֲמוֹנַי תָּלוּ לְפָנָי</tei:l>
          <tei:l>וַיְרַטְּשׁוּ אֵם עַל־בֵּן לְעֵינָי׃</tei:l>
          <tei:l>יוֹם...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_nilchamu_vi_ezra/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">רַ</tei:seg>בּוֹת קְרָאֽוּנִי מֵאֵין סְפוֹרוֹת</tei:l>
          <tei:l>מֵֽתוּ רְעֵבוֹת נָשִׁים יְקָרוֹת</tei:l>
          <tei:l>הָיוּ בְנֵיהֶם לָהֶן לְבָרוֹת</tei:l>
          <tei:l>סָפוּ בְּאַוַּת לֶֽחֶם קְטַנָּי</tei:l>
          <tei:l>הַעַל־אֵ֥לֶּה תִתְאַפַּ֖ק יְהֹוָ֑ה׃</tei:l>
          <tei:l>יוֹם...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_nilchamu_vi_ezra/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הַ</tei:seg>נֶּהֱרָגִים בְּרַגְלָם סְחָבוּם</tei:l>
          <tei:l>עַל־עֵץ תְּלָאוּם שָׁמָּה עֲזָבוּם</tei:l>
          <tei:l>בָּנוֹת עֲדִינוֹת שׁוֹבִים שְׁבָבוּם</tei:l>
          <tei:l>הִתְאַבְּלוּ עַל־אֵֽלֶּה זְקֵנָי</tei:l>
          <tei:l>מוֹעֵד וְשַׁבָּת שִׁכַּח יְהֹוָה׃</tei:l>
          <tei:l>יוֹם...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yom_nilchamu_vi_ezra/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מָ</tei:seg>תַי בְּאוֹיְבַי אֶרְאֶה נְקָמוֹת</tei:l>
          <tei:l>בָּנִים תְּקַבֵּץ מִקְצֵה אֲדָמוֹת</tei:l>
          <tei:l>תָּשׁוּב וְתוֹשִׁיב עָרִים נְשָׁמוֹת</tei:l>
          <tei:l>יְשִׁירוּן בְּבֵיתָךְ שָׁרַי וְנוֹגְנַי</tei:l>
          <tei:l>וִיבָרְכוּ אֶת־שִׁמְךָ יְהֹוָה׃</tei:l>
          <tei:l>יְשִׁירוּן...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
