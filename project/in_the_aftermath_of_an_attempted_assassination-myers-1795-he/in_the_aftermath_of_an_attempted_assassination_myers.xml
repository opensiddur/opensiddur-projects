  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">אחר תפלת ערבית החזן והקהל יזכרו מזמור החלים אלו כמספר ה׳׃</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/2"/>
        <tei:lg>
          <tei:l>תהלים ד׳</tei:l>
          <tei:l>למנצח בנגינות׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/3"/>
        <tei:lg>
          <tei:l>תהלים ה׳</tei:l>
          <tei:l>למנצח אל הנחילות׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/4"/>
        <tei:lg>
          <tei:l>תהלים כ״א</tei:l>
          <tei:l>למנצח מזמור לדוד</tei:l>
          <tei:l>ה׳ בעזך ישמח מלך׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/5"/>
        <tei:lg>
          <tei:l>תהלים כ״ג</tei:l>
          <tei:l>מזמור לדוד</tei:l>
          <tei:l>ה׳ רעי לא אחסר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/6"/>
        <tei:lg>
          <tei:l>תהלים ל״ג</tei:l>
          <tei:l>רננו צדיקים ב״ה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/7"/>
        <tei:lg>
          <tei:l>תהלים ס״א</tei:l>
          <tei:l>למנצח על נגינת לדוד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/8"/>
        <tei:lg>
          <tei:l>תהלים ס״ו</tei:l>
          <tei:l>למנצח שיר מזמור׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/9"/>
        <tei:lg>
          <tei:l>תהלים ע״ב</tei:l>
          <tei:l>לשלמה אלהים משפטיך למלך תן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/10"/>
        <tei:lg>
          <tei:l>תהלים צ״א</tei:l>
          <tei:l>ישב בסתר עליון׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/11"/>
        <tei:lg>
          <tei:l>תהלים צ״ה</tei:l>
          <tei:l>לכו נרננה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/12"/>
        <tei:lg>
          <tei:l>תהלים ק׳</tei:l>
          <tei:l>מזמור לתודה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/13"/>
        <tei:lg>
          <tei:l>תהלים ק״ז</tei:l>
          <tei:l>הודו לה׳ כי טוב</tei:l>
          <tei:l>כי לעולם חסדו׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/14"/>
        <tei:lg>
          <tei:l>תהלים קי״ז</tei:l>
          <tei:l>הללו את ה׳ כל גוים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/15"/>
        <tei:lg>
          <tei:l>תהלים קכ״א</tei:l>
          <tei:l>שיר למעלות</tei:l>
          <tei:l>אשא עיני אל ההרים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/16"/>
        <tei:lg>
          <tei:l>תהלים קכ״ח</tei:l>
          <tei:l>שיר המעלות</tei:l>
          <tei:l>אשרי כל יראה ה׳</tei:l>
          <tei:l>הולך בדרכיו׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/17"/>
        <tei:lg>
          <tei:l>תהלים קל״ח</tei:l>
          <tei:l>לדוד</tei:l>
          <tei:l>אודך בכל לבי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/18"/>
        <tei:lg>
          <tei:l>תהלים קמ״ט</tei:l>
          <tei:l>הללויה</tei:l>
          <tei:l>שירו לה׳׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/19"/>
        <tei:lg>
          <tei:l>תהלים ק״נ</tei:l>
          <tei:l>הללויה</tei:l>
          <tei:l>הללו אל בקדשו׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/20"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">אח״כ יאמרו פסוקים אלו</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/21"/>
        <tei:lg>
          <tei:l>לה׳ הישועה</tei:l>
          <tei:l>על עמך ברכתך סלה: <tei:bibl>(תהלים ג:ט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/22"/>
        <tei:lg>
          <tei:l>ה׳ צבאות עמנו</tei:l>
          <tei:l>מישגב לנו אלהי יעקב סלה׃ <tei:bibl>(תהלים מו:ח, תהלים מו:יב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/23"/>
        <tei:lg>
          <tei:l>ה׳ צבאות</tei:l>
          <tei:l>אשרי אדם בוטח בך׃ <tei:bibl>(תהלים פג:יג)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/24"/>
        <tei:lg>
          <tei:l>ברוך הגבר אשר יבטח בה׳</tei:l>
          <tei:l>והיה ה׳ מבטחו׃ <tei:bibl>(ירמיה יז:ז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/25"/>
        <tei:lg>
          <tei:l>ישא ברכה מאת ה׳</tei:l>
          <tei:l>וצדקה מאלהי ישעו׃ <tei:bibl>(תהלים כד:ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/26"/>
        <tei:lg>
          <tei:l>הנה כי כן יברך גבר ירא ה׳׃ <tei:bibl>(תהלים קכח:ד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/27"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">אח״כ יאמר החזן הודאה זו בקול רם</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">והקהל עמו בלחש</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">וכן יאמרו אותה מדי יום ביומו</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">בבוקר קודם אשרי ובא לציון</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">ובערב לאחר תפלת מנחה</tei:note>
          </tei:l>
          <tei:l>
            <tei:note type="instruction">עד י״ד ימים</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/28"/>
        <tei:lg>
          <tei:l>ה׳ אלהי צבאות</tei:l>
          <tei:l>מי כמוך הסין יה</tei:l>
          <tei:l>לך שמים</tei:l>
          <tei:l>אף לך ארץ</tei:l>
          <tei:l>תבל ומלאה אתה יסרתם</tei:l>
          <tei:l>האל הגדול הגבור והנורא</tei:l>
          <tei:l>בששה ימים כל היציר ברא</tei:l>
          <tei:l>ישב על כסא רחמים</tei:l>
          <tei:l>ומתנהג עם ברואיו</tei:l>
          <tei:l>במדת החסד ובמדת הרחמים</tei:l>
          <tei:l>המפליא הסדיו להועיל</tei:l>
          <tei:l>האחד ואין זולתו</tei:l>
          <tei:l>מושיע וגואל</tei:l>
          <tei:l>מי ימלל גבורות ה׳</tei:l>
          <tei:l>ישמיע כל תהלתו</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/29"/>
        <tei:lg>
          <tei:l>ה׳ אדוננו</tei:l>
          <tei:l>מה אדיר שמך בכל הארץ</tei:l>
          <tei:l>לך ה׳ הממלכה</tei:l>
          <tei:l>והמתנשא לכל לראש</tei:l>
          <tei:l>ומה יקר הסדך אשר הגדלת לעשות עמנו</tei:l>
          <tei:l>ואת כל העם דרי איי בריטניא</tei:l>
          <tei:l>אשר אנחנו בקרבם וחוסים בצילם</tei:l>
          <tei:l>כי נתת הוד המלוכה</tei:l>
          <tei:l>ותשת עטרת פז</tei:l>
          <tei:l>לראש צמח צדיק</tei:l>
          <tei:l>הוא אדוננו המלך האדיר והחסיד</tei:l>
          <tei:l>גורגי השלישי ירום הודו</tei:l>
          <tei:l>הדורש טוב לעמו</tei:l>
          <tei:l>ודובר שלום</tei:l>
          <tei:l>לכל יושבי ארצינו וסביבותינוי</tei:l>
          <tei:l>ועיניו תמיד פקוחות</tei:l>
          <tei:l>להישיר דרכינו ולהגין עלינו משוגאינו</tei:l>
          <tei:l>כי אהבת נפש אהבנו</tei:l>
          <tei:l>ובשלומו שלום לנו</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/30"/>
        <tei:lg>
          <tei:l>ועתה בעוננו</tei:l>
          <tei:l>משיח ה׳ כמעט נלכד בשחיתותינו</tei:l>
          <tei:l>לולי ה׳ עוזר לנו בהשנחתו עלינו</tei:l>
          <tei:l>בקום עליו אדם בליעל והעיז פניו איש רשע</tei:l>
          <tei:l>להרים יד במלכנו ואדוננו</tei:l>
          <tei:l>לשלוח יד במשיח ה׳</tei:l>
          <tei:l>ולמנוע הטוב והשלוה ממדינותינו</tei:l>
          <tei:l>ולשפוך דם נקי בתוכינו</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/31"/>
        <tei:lg>
          <tei:l>ואתה ה׳ מגן בעדינו</tei:l>
          <tei:l>כבודינו ומרים ראשינו</tei:l>
          <tei:l>וכרהם אב על בנים</tei:l>
          <tei:l>רחמת עלינו ועל זרענו וטפינו</tei:l>
          <tei:l>סכת באברתך על נזר ראשינו</tei:l>
          <tei:l>הפרת עצת איש צר ואויב הרע הזה</tei:l>
          <tei:l>וקלקלת את מחשבתו הרעה</tei:l>
          <tei:l>אשר השב לעשות</tei:l>
          <tei:l>ויבא אדוננו המלך בשלום אל ביתו</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/32"/>
        <tei:lg>
          <tei:l>הנה כי כן עלינו</tei:l>
          <tei:l>להודות להלל לשבח</tei:l>
          <tei:l>לפאר לרומם ולהדר</tei:l>
          <tei:l>את שמך ה׳ אלהינו</tei:l>
          <tei:l>על החסד הגדול אשר גמלתנו</tei:l>
          <tei:l>לכן באנו אל מעון ביתך</tei:l>
          <tei:l>נשתחוה אל היכל קדשך ביראתך</tei:l>
          <tei:l>ונודה לשמך</tei:l>
          <tei:l>על החסדך ועל אמתך׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/33"/>
        <tei:lg>
          <tei:l>זרע יעקב ברוכי ה׳</tei:l>
          <tei:l>תנו כבוד ותודה לה׳ אלהינו</tei:l>
          <tei:l>הודו לה׳</tei:l>
          <tei:l>קראו בשמו</tei:l>
          <tei:l>הודיעו בעמים עלילותיו</tei:l>
          <tei:l>כי גדול ה׳ ומהולל מאד</tei:l>
          <tei:l>ונורא הוא על כל אלהים</tei:l>
          <tei:l>מגדל ישועות מלכו</tei:l>
          <tei:l>ועושה חסד למשיחו</tei:l>
          <tei:l>לגורגי ולזרעו עד עולם׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/34"/>
        <tei:lg>
          <tei:l>אלהינו ואלהי אבותינו</tei:l>
          <tei:l>עשה עמנו אות לטובה</tei:l>
          <tei:l>ויראו שונאינו ויבושו</tei:l>
          <tei:l>כי אתה ה׳ עזרתנו ונחמתנו׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/35"/>
        <tei:lg>
          <tei:l>ה׳ אלהי ישראל</tei:l>
          <tei:l>בוחן לבב ומישרים תרצה</tei:l>
          <tei:l>הכן לבב אויבי המלך</tei:l>
          <tei:l>לשוב מדרכם הרעה</tei:l>
          <tei:l>ויחד לבבם לאהבת מלכם</tei:l>
          <tei:l>ולא ירעו ולא ישחיתו לנפשם</tei:l>
          <tei:l>אז יאמרו בגוים</tei:l>
          <tei:l>הגדיל ה׳ לעשות עם אלה</tei:l>
          <tei:l>הגדיל ה׳ לעשות עמנו</tei:l>
          <tei:l>היינו שמחים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/36"/>
        <tei:lg>
          <tei:l>אבינו</tei:l>
          <tei:l>אב הרחמן</tei:l>
          <tei:l>אדון השלום</tei:l>
          <tei:l>תן שלום בעולם</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/37"/>
        <tei:lg>
          <tei:l>אלהינו שבשמים</tei:l>
          <tei:l>שים שלום בינינו</tei:l>
          <tei:l>ובמדינתינו</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/38"/>
        <tei:lg>
          <tei:l>אבינו מלכינו</tei:l>
          <tei:l>תן חיים ושלום ואריכת ימים ושנים</tei:l>
          <tei:l>לאדוננו המלך</tei:l>
          <tei:l>והמלכה</tei:l>
          <tei:l>ולגורגי פרינס אף װעליס</tei:l>
          <tei:l>ולפרינסעס אף װעליס</tei:l>
          <tei:l>ולכל זרע המלוכה</tei:l>
          <tei:l>ולא יעדר מזרעו</tei:l>
          <tei:l>יושב על כסא ממלכתו</tei:l>
          <tei:l>בשלום ובשלוה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/39"/>
        <tei:lg>
          <tei:l>ומכל נזק צער יגון ואנחה תצילהו</tei:l>
          <tei:l>יבלה בטוב ימיו ושנותיו בנעימים</tei:l>
          <tei:l>ובעת בואו בכלח אלי קבר</tei:l>
          <tei:l>זקן ושבע ימים</tei:l>
          <tei:l>תסתירהו בצל כנפיך</tei:l>
          <tei:l>ויתעדן מזיו כבודך</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/40"/>
        <tei:lg>
          <tei:l>אבינו</tei:l>
          <tei:l>אב הרחמן אדון השלום</tei:l>
          <tei:l>פתח לנו שערי רחמים</tei:l>
          <tei:l>שערי שלום ושלוה השקט ובטח</tei:l>
          <tei:l>וה׳ ששמו שלום</tei:l>
          <tei:l>יברך את עמו בשלום</tei:l>
          <tei:l>אמן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:in_the_aftermath_of_an_attempted_assassination_myers/41"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">הנותן תשועה וכו׳</tei:note>
          </tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>