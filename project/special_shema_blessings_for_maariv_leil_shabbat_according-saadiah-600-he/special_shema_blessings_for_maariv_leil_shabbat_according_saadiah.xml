    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:special_shema_blessings_for_maariv_leil_shabbat_according_saadiah">
        <tei:head>שמע לערבית ליל שבת על פי הרס״ג</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:special_shema_blessings_for_maariv_leil_shabbat_according_saadiah/1"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְהֹוָה אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>אֲשֶׁר כִּלָּה מַעֲשָׂיו בַּיּוֹם הַשְּׁבִיעִי</tei:l>
          <tei:l>וַיִּקְרָאֵֽהוּ עֹֽנֶג שַׁבָּת קׇדְשׁוֹ<tei:anchor xml:id="note_1"/></tei:l>
          <tei:l>מֵעֶֽרֶב עַד־עֶֽרֶב</tei:l>
          <tei:l>הִתְקִין<tei:anchor xml:id="note_2"/> מְנוּחָה</tei:l>
          <tei:l>לְעַמּוֹ יִשְׂרָאֵל</tei:l>
          <tei:l>כִּרְצוֹנוֹ<tei:anchor xml:id="note_3"/></tei:l>
          <tei:l>גּוֹלֵל אוֹר מִפְּנֵי חֹֽשֶׁךְ</tei:l>
          <tei:l>וְחֹֽשֶׁךְ מִפְּנֵי אוֹר׃</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה</tei:l>
          <tei:l>הַמַּעֲרִיב עֲרָבִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:special_shema_blessings_for_maariv_leil_shabbat_according_saadiah/2"/>
        <tei:lg>
          <tei:l>לְמַֽעַן אַהֲבַת עֲמֻסִים</tei:l>
          <tei:l>נָטַֽעְתָּ עֵץ חַיִּים</tei:l>
          <tei:l>שַׁבָּת קִדַּֽשְׁתָּ מִיָּמִים</tei:l>
          <tei:l>וְאוֹתָהּ הִנְחַֽלְתָּ לַתְּמִימִים</tei:l>
          <tei:l>וְאַהֲבָתְךָ לֹא־תָסוּר מִמֶּֽנּוּ</tei:l>
          <tei:l>כִּי הִיא עֲטֶֽרֶת רֹאשֵֽׁנוּ</tei:l>
          <tei:l>נֶֽצַח נְצָחִים</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה</tei:l>
          <tei:l>אוֹהֵב אֶת־עַמּוֹ יִשְׂרָאֵל אָמֵן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:special_shema_blessings_for_maariv_leil_shabbat_according_saadiah/3"/>
        <tei:lg>
          <tei:l>שְׁמַ֖ע יִשְׂרָאֵ֑ל... <tei:bibl>(דברים ה:ד-ט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:special_shema_blessings_for_maariv_leil_shabbat_according_saadiah/4"/>
        <tei:lg>
          <tei:l>וְהָיָ֗ה אִם־שָׁמֹ֤עַ... <tei:bibl>(דברים יא:יג-כא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:special_shema_blessings_for_maariv_leil_shabbat_according_saadiah/5"/>
        <tei:lg>
          <tei:l>וַיֹּ֥אמֶר... <tei:bibl>(במדבר טו:לז-מא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:special_shema_blessings_for_maariv_leil_shabbat_according_saadiah/6"/>
        <tei:lg>
          <tei:l>אֱמֶת <tei:seg type="acrostic">אֱ</tei:seg>מוּנָתְךָ<tei:anchor xml:id="note_7"/></tei:l>
          <tei:l><tei:seg type="acrostic">בַּ</tei:seg>שְּׁבִיעִי קִיַּֽמְתָּ</tei:l>
          <tei:l><tei:seg type="acrostic">גָּ</tei:seg>זַֽרְתָּ <tei:seg type="acrostic">דִּ</tei:seg>בַּֽרְתָּ</tei:l>
          <tei:l><tei:seg type="acrostic">הִ</tei:seg>קְשַֽׁבְנוּ <tei:seg type="acrostic">וְ</tei:seg>שָׁמַֽעְנוּ <tei:seg type="acrostic">זָ</tei:seg>כוֹר</tei:l>
          <tei:l><tei:seg type="acrostic">חִ</tei:seg>מַּֽדְתָּ <tei:seg type="acrostic">טְ</tei:seg>הוֹרִים <tei:seg type="acrostic">יִ</tei:seg>ירָשׁוּהָ</tei:l>
          <tei:l><tei:seg type="acrostic">כְּ</tei:seg>תוּבָה הִיא <tei:seg type="acrostic">לְ</tei:seg>רֹאשׁ אַרְבָּעָה</tei:l>
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>שְּׁעַת <tei:seg type="acrostic">נְ</tei:seg>תִינָתָהּ<tei:anchor xml:id="note_8"/></tei:l>
          <tei:l><tei:seg type="acrostic">שָׂ</tei:seg>מַח־בָּהּ לֵב יְשֻׁרוּן</tei:l>
          <tei:l><tei:seg type="acrostic">עֵ</tei:seg>דָה <tei:seg type="acrostic">פָּ</tei:seg>דִֽיתָ</tei:l>
          <tei:l><tei:seg type="acrostic">צְ</tei:seg>דָקָה <tei:seg type="acrostic">קָ</tei:seg>נִֽיתָ</tei:l>
          <tei:l><tei:seg type="acrostic">ר</tei:seg>וֹמַֽמְתָּ <tei:seg type="acrostic">שַׁ</tei:seg>בָּת <tei:seg type="acrostic">תָּ</tei:seg>מִיד בֵּינְךָ לְבֵינֵֽינוּ<tei:anchor xml:id="note_9"/></tei:l>
          <tei:l>כִּי בְּשֵֽׁשֶׁת יָמִים עוֹלָמְךָ תִּכַּֽנְתָּ<tei:anchor xml:id="note_10"/></tei:l>
          <tei:l>וּבַשְּׁבִיעִי נַֽחְתָּ</tei:l>
          <tei:l>לְמַֽעַן שֶׁתַּנִּֽיחַ</tei:l>
          <tei:l>לְעַמְּךָ יִשְׂרָאֵל</tei:l>
          <tei:l>אָבוֹת וּבָנִים</tei:l>
          <tei:l>כְּעָֽלוּ מִן־הַיָּם</tei:l>
          <tei:l>בְּגִילָה בְּרִנָּה<tei:anchor xml:id="note_11"/></tei:l>
          <tei:l>וְאָמְרוּ כֻלָּם׃</tei:l>
          <tei:l>מִֽי־כָמֹ֤כָה בָּֽאֵלִם֙ יְהֹוָ֔ה</tei:l>
          <tei:l>מִ֥י כָּמֹ֖כָה נֶאְדָּ֣ר בַּקֹּ֑דֶשׁ</tei:l>
          <tei:l>נוֹרָ֥א תְהִלֹּ֖ת עֹ֥שֵׂה פֶֽלֶא׃ <tei:bibl>(שמות טו:יא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:special_shema_blessings_for_maariv_leil_shabbat_according_saadiah/7"/>
        <tei:lg>
          <tei:l>שׁוֹמְרֵי שְׁבִיעִי רָאוּ גְּבוּרָתְךָ<tei:anchor xml:id="note_18"/> עַל־הַיָּם</tei:l>
          <tei:l>יַֽחַד כֻּלָּם הוֹדוּ וְהִמְלִֽיכוּ וְאָמְרוּ</tei:l>
          <tei:l>יְהֹוָ֥ה ׀ יִמְלֹ֖ךְ לְעֹלָ֥ם וָעֶֽד׃ <tei:bibl>(שמות טו:יח)</tei:bibl></tei:l>
          <tei:l>בִּגְלַל אָבוֹת</tei:l>
          <tei:l>הוֹשַׁעְתָּ בָּנִים</tei:l>
          <tei:l>וְתָבִיא גְּאֻלָּה</tei:l>
          <tei:l>לִבְנֵי בְּנֵיהֶם׃<tei:anchor xml:id="note_19"/></tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה</tei:l>
          <tei:l>גָּאַל יִשְׂרָאֵל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:special_shema_blessings_for_maariv_leil_shabbat_according_saadiah/8"/>
        <tei:lg>
          <tei:l>הַשְׁכִּיבֵֽנוּ יְהֹוָה אֱלֹהֵֽינוּ לְשָׁלוֹם</tei:l>
          <tei:l>וְהַעֲמִידֵֽנוּ לְחַיִּים וּלְשָׁלוֹם</tei:l>
          <tei:l>וּפְרֹס עָלֵֽינוּ סֻכַּת שָׁלוֹם</tei:l>
          <tei:l>כַּדָּבָר שֶׁנֶּאֱמַר</tei:l>
          <tei:l>וְיָשַׁ֥ב עַמִּ֖י</tei:l>
          <tei:l>בִּנְוֵ֣ה שָׁל֑וֹם</tei:l>
          <tei:l>וּֽבְמִשְׁכְּנוֹת֙ מִבְטַחִ֔ים</tei:l>
          <tei:l>וּבִמְנוּחֹ֖ת שַׁאֲנַנּֽוֹת׃ <tei:bibl>(ישעיה לב:יח)</tei:bibl></tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה</tei:l>
          <tei:l>הַפּוֹרֵשׂ סֻכַּת שָׁלוֹם</tei:l>
          <tei:l>עַל־עַמּוֹ יִשְׂרָאֵל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:special_shema_blessings_for_maariv_leil_shabbat_according_saadiah/9"/>
        <tei:lg>
          <tei:l>וְשָׁמְר֥וּ בְנֵֽי־יִשְׂרָאֵ֖ל אֶת־הַשַּׁבָּ֑ת</tei:l>
          <tei:l>לַעֲשׂ֧וֹת אֶת־הַשַּׁבָּ֛ת לְדֹרֹתָ֖ם</tei:l>
          <tei:l>בְּרִ֥ית עוֹלָֽם׃</tei:l>
          <tei:l>בֵּינִ֗י וּבֵין֙ בְּנֵ֣י יִשְׂרָאֵ֔ל</tei:l>
          <tei:l>א֥וֹת הִ֖וא לְעֹלָ֑ם</tei:l>
          <tei:l>כִּי־שֵׁ֣שֶׁת יָמִ֗ים</tei:l>
          <tei:l>עָשָׂ֤ה יְהֹוָה֙ אֶת־הַשָּׁמַ֣יִם וְאֶת־הָאָ֔רֶץ</tei:l>
          <tei:l>וּבַיּוֹם֙ הַשְּׁבִיעִ֔י שָׁבַ֖ת</tei:l>
          <tei:l>וַיִּנָּפַֽשׁ׃ <tei:bibl>(שמות לא:טז-יז)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:special_shema_blessings_for_maariv_leil_shabbat_according_saadiah/10"/>
        <tei:lg>
          <tei:l>יִרְאוּ עֵינֵֽינוּ</tei:l>
          <tei:l>וְיִשְׂמַח לִבֵּֽנוּ</tei:l>
          <tei:l>וְתָגֵל נַפְשֵֽׁנוּ</tei:l>
          <tei:l>בִּישׁוּעָתְךָ מַלְכֵּֽנוּ</tei:l>
          <tei:l>בֶּאֱמוֹר לְצִיּוֹן מָלַךְ אֱלֺהָֽיִךְ</tei:l>
          <tei:l>כִּי הַמַּלְכוּת שֶׁלְּךָ הִיא</tei:l>
          <tei:l>וּלְעוֹלְמֵי עַד תִּמְלוֹךְ בְּכָבוֹד׃</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה</tei:l>
          <tei:l>הַמּוֹלֵךְ בִּכְבוֹדוֹ תָּמִיד</tei:l>
          <tei:l>לְעוֹלָם וָעֶד</tei:l>
          <tei:l>אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
  <tei:standOff type="notes">
    <tei:note type="commentary" n="1" target="#note_1">
      <tei:p>In the Italian rite, the words עֹֽנֶג שַׁבָּת קׇדְשׁוֹ are replaced with שַׁבָּת קֹֽדֶשׁ.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="2" target="#note_2">
      <tei:p>In the Italian rite, the word הִתְקִין is replaced with וּנְתָנוֹ.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="3" target="#note_3">
      <tei:p>In the Italian rite, the word כִּרְצוֹנוֹ is replaced by בִּקְדוּשָׁתוֹ, after which the blessing is concluded with בּוֹרֵא יוֹמָם וָלַיְלָה up to אֵל חַי וְקַיָּם as per a regular maˁariv service.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="7" target="#note_7">
      <tei:p>In the Italian rite, the word אֱמוּנָתְךָ is replaced with וֶאֱמוּנָה</tei:p>
    </tei:note>
    <tei:note type="commentary" n="8" target="#note_8">
      <tei:p>In the Italian rite, the words מִשְּׁעַת נְתִינָתָהּ are replaced with מֵעֵת נִתְּנָה.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="9" target="#note_9">
      <tei:p>In the Italian rite, the words אוֹת הִיא לְעוֹלָם are inserted here.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="10" target="#note_10">
      <tei:p>In the Italian rite, the word תִּכַּֽנְתָּ is replaced with תִּקַּֽנְתָּ</tei:p>
    </tei:note>
    <tei:note type="commentary" n="11" target="#note_11">
      <tei:p>In the Italian rite, אָבוֹת וּבָנִים כְּעָֽלוּ מִן־הַיָּם בְּגִילָה בְּרִנָּה is replaced withוְלִכְבוֹד שִׁמְךָ שִׁבְּחוּ וְזִמֵּרוּ בָּרוּךְ הוּא מֹשֶׁה וּבְנֵי יִשְׂרָאֵל לְךָ עָנוּ שִׁירָה בְּשִׂמְחָה רַבָּה.</tei:p>
    </tei:note>
    <tei:note type="commentary" n="18" target="#note_18">
      <tei:p>In the Italian rite, גְּבוּרָתְךָ is replaced with גְּבוּרוֹתֶיךָ</tei:p>
    </tei:note>
    <tei:note type="commentary" n="19" target="#note_19">
      <tei:p>This entire last line, in the Italian rite, is replaced with תָּחִישׁ יְשׁוּעָה לְשׁוֹמְרֵי עֲנֻגָּה תִּפְדֶּה לְצֹאנְךָ וְאַל־יִהְיוּ עוֹד לְבִזָּה כַּכָּתוּב וְהוֹשַׁעְתִּ֣י לְצֹאנִ֔י וְלֹא־תִהְיֶ֥ינָה ע֖וֹד לָבַ֑ז</tei:p>
    </tei:note>
  </tei:standOff>
</tei:TEI>