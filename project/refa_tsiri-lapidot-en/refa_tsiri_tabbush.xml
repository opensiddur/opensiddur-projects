  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:refa_tsiri_tabbush">
        <tei:head>Refa Tsiri, a piyyuṭ for healing by Rabbi Refael Antebi Tabbush (ca. late 19th c.)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:refa_tsiri_tabbush/1"/>
        <tei:lg>
          <tei:l>Heal my pain Oh Loyal God</tei:l>
          <tei:l>for you are a skilled healer</tei:l>
          <tei:l>You lead me, You see my weakness</tei:l>
          <tei:l>and grant strength to my soul</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:refa_tsiri_tabbush/2"/>
        <tei:lg>
          <tei:l>Open the gate of mercy</tei:l>
          <tei:l>High dweller of the heavens</tei:l>
          <tei:l>Upon your servant bestow your grace</tei:l>
          <tei:l>there would be no mercy if not for You</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:refa_tsiri_tabbush/3"/>
        <tei:lg>
          <tei:l>Oh Living God desire my prayer</tei:l>
          <tei:l>and hasten to my aid</tei:l>
          <tei:l>And speedily call for the redemption</tei:l>
          <tei:l>of the nation born to the Lady [Sarah]</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
