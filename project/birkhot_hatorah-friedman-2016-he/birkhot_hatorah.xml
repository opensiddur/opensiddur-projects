  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:birkhot_hatorah">
        <tei:head>בִּרְכוֹת הַתּוֹרָה</tei:head>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם,</tei:l>
          <tei:l>אֲשֶׁר קִדְּשָֽׁנוּ בְּמִצְוֺתָיו,</tei:l>
          <tei:l>וְצִוָּֽנוּ עַל דִבְרֵי תוֹרָה׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְהַעֲרֶב נָא יְיָ אֱלֹהֵֽינוּ</tei:l>
          <tei:l>אֶת דִּבְרֵי תוֹרָתְךָ בְּפִֽינוּ,</tei:l>
          <tei:l>וּבְפִי כׇל עַמְּךָ בֵּית יִשְׂרָאֵל.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וְנִהְיֶה אֲנַֽחְנוּ וְצֶאֱצָאֵֽינוּ,</tei:l>
          <tei:l>וְצֶאֱצָאֵי כׇל עַמְּךָ בֵּית יִשְׂרָאֵל,</tei:l>
          <tei:l>כֻּלָּנוּ יוֹדְעֵי שְׁמֶֽךָ</tei:l>
          <tei:l>וְלוֹמְדֵי תוֹרָתְךָ לִשְׁמָהּ.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>הַמְלַמֵּד תּוֹרָה</tei:l>
          <tei:l>לְעַמּוֹ יִשְׂרָאֵל׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:birkhot_hatorah/asher_bachar"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם,</tei:l>
          <tei:l>אֲשֶׁר בְָּחַר בְָּנוּ מִכׇּל הָעַמִּים,</tei:l>
          <tei:l>וְנָֽתַן לָֽנוּ אֶת תּוֹרָתוֹ.</tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>נוֹתֵן הַתּוֹרָה׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
