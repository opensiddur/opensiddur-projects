  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:on_the_decalogue_kaplan">
        <tei:head>On the Decalogue, life wisdom for a Bnei Mitsvah by Rabbi Dr. Mordecai Kaplan (ca. 1920s)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_decalogue_kaplan/1"/>
        <tei:lg>
          <tei:l>1. I am <j:divineName>YHVH your elo’ah</j:divineName> who brought you out of the land of Mitstrayim, from the house of slaves. <tei:bibl>(Exodus 20:2, Deuteronomy 5:6)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_decalogue_kaplan/2"/>
        <tei:lg>
          <tei:l>2. You shall have no other deities besides Me... <tei:bibl>(Exodus 20:3-6, Deuteronomy 5:7-10)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_decalogue_kaplan/3"/>
        <tei:lg>
          <tei:l>3. You shall not swear falsely by the name of <j:divineName>YHVH your elo’ah</j:divineName> <tei:bibl>(Exodus 20:7, Deuteronomy 5:11)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_decalogue_kaplan/4"/>
        <tei:lg>
          <tei:l>4. Remember and Preserve the Sabbath day to keep it holy... <tei:bibl>(Exodus 20:8-11, Deuteronomy 5:12-15)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_decalogue_kaplan/5"/>
        <tei:lg>
          <tei:l>5. Honor your father and your mother... <tei:bibl>(Exodus 20:12, Deuteronomy 5:16)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_decalogue_kaplan/6"/>
        <tei:lg>
          <tei:l>6. You shall not murder. <tei:bibl>(Exodus 20:13, Deuteronomy 5:17)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_decalogue_kaplan/7"/>
        <tei:lg>
          <tei:l>7. You shall not commit adultery. <tei:bibl>(Exodus 20:13, Deuteronomy 5:17)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_decalogue_kaplan/8"/>
        <tei:lg>
          <tei:l>8. You shall not steal. <tei:bibl>(Exodus 20:13, Deuteronomy 5:17)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_decalogue_kaplan/9"/>
        <tei:lg>
          <tei:l>9. You shall not, against your neighbor, bear false witness <tei:bibl>(Exodus 20:13, Deuteronomy 5:17)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:on_the_decalogue_kaplan/10"/>
        <tei:lg>
          <tei:l>10. You shall not covet your neighbor’s house... <tei:bibl>(Exodus 20:14, Deuteronomy 5:18)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
