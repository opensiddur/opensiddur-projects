      <tei:div corresp="urn:x-opensiddur:text:prayer:uvemaqhalot_rivvot_chinese_translation">
        <tei:head>וּבְמַקְהֲלוֹת רִבְבוֹת</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:uvemaqhalot_rivvot_chinese_translation/1"/>
        <tei:lg>
          <tei:l>וּבְמַקְהֲלוֹת רִבְבוֹת עַמְּךָ בֵּית יִשְׂרָאֵל בְּרִנָּה</tei:l>
          <tei:l>יִתְפָּאֵר שִׁמְךָ, מַלְכֵּנוּ, בְּכָל דּוֹר וָדוֹר, שֶׁכֵּן חוֹבַת כָּל הַיְצוּרִים</tei:l>
          <tei:l>לְפָנֶיךָ, יְיָ אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ, לְהוֹדוֹת לְהַלֵּל</tei:l>
          <tei:l>לְשַׁבֵּחַ, לְפָאֵר לְרוֹמֵם לְהַדֵּר, לְבָרֵךְ, לְעַלֵּה וּלְקַלֵּס</tei:l>
          <tei:l>עַל כָּל דִּבְרֵי שִׁירוֹת וְתִשְׁבְּחוֹת דָּוִד בֶּן יִשַׁי</tei:l>
          <tei:l>עַבְדְּךָ, מְשִׁיחֶךָ.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
