  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:non_e_come_lo_ded_nostro_a_renaissance_judeo_italian">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:non_e_come_lo_ded_nostro_a_renaissance_judeo_italian/1"/>
        <tei:lg>
          <tei:l>Nessuno è come il <j:divineName>Dio</j:divineName> nostro.</tei:l>
          <tei:l>Nessuno è come il <j:divineName>Signore</j:divineName> nostro.</tei:l>
          <tei:l>Nessuno è come il <j:divineName>Re</j:divineName> nostro.</tei:l>
          <tei:l>Nessuno è come il <j:divineName>Salvatore</j:divineName> nostro.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:non_e_come_lo_ded_nostro_a_renaissance_judeo_italian/2"/>
        <tei:lg>
          <tei:l>Chi è come il <j:divineName>Dio</j:divineName> nostro?</tei:l>
          <tei:l>Chi è come il <j:divineName>Signore</j:divineName> nostro?</tei:l>
          <tei:l>Chi è come il <j:divineName>Re</j:divineName> nostro?</tei:l>
          <tei:l>Chi è come il <j:divineName>Salvatore</j:divineName> nostro?</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:non_e_come_lo_ded_nostro_a_renaissance_judeo_italian/3"/>
        <tei:lg>
          <tei:l>Lodiámo al <j:divineName>Dio</j:divineName> nostro!</tei:l>
          <tei:l>Lodiámo al <j:divineName>Signore</j:divineName> nostro!</tei:l>
          <tei:l>Lodiámo al <j:divineName>Re</j:divineName> nostro!</tei:l>
          <tei:l>Lodiámo al <j:divineName>Salvatore</j:divineName> nostro!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:non_e_come_lo_ded_nostro_a_renaissance_judeo_italian/4"/>
        <tei:lg>
          <tei:l>Tu sei il <j:divineName>Dio</j:divineName> nostro!</tei:l>
          <tei:l>Tu sei il <j:divineName>Signore</j:divineName> nostro!</tei:l>
          <tei:l>Tu sei il <j:divineName>Re</j:divineName> nostro!</tei:l>
          <tei:l>Tu sei il <j:divineName>Salvatore</j:divineName> nostro!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:non_e_come_lo_ded_nostro_a_renaissance_judeo_italian/5"/>
        <tei:lg>
          <tei:l><j:divineName>L’Eterno</j:divineName> s’è volùto,</tei:l>
          <tei:l>per la sua giustizia,</tei:l>
          <tei:l>di rendere la Torà grande e magnifica;</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
