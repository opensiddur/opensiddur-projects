      <tei:div corresp="urn:x-opensiddur:text:poem:adon_olam_in_marathi_translation">
        <tei:head>אֲדוֹן עוֹלָם (מנהג הספרדים במזרח)‏</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam_in_marathi_translation/1"/>
        <tei:lg>
          <tei:l>אֲדוֹן עֽוֹלָם אֲשֶׁר מָלָךְ</tei:l>
          <tei:l>בְּטֶֽרֶם כׇּל־יְצִיר נִבְרָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam_in_marathi_translation/2"/>
        <tei:lg>
          <tei:l>לְעֵת נַֽעֲשָׂה כְּחֶפְצוֹ כֹּל</tei:l>
          <tei:l>אֲזַי מֶֽלֶךְ שְׁמוֹ נִקְרָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam_in_marathi_translation/3"/>
        <tei:lg>
          <tei:l>וְאַֽחֲרֵי כִּכְלּוֹת הַכֹּל</tei:l>
          <tei:l>לְבַדּוֹ יִמְלֹךְ נוֹרָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam_in_marathi_translation/4"/>
        <tei:lg>
          <tei:l>וְהוּא הָיָה וְהוּא הֹוֶה</tei:l>
          <tei:l>וְהוּא יִֽהְיֶה בְּתִפְאָרָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam_in_marathi_translation/5"/>
        <tei:lg>
          <tei:l>וְהוּא אֶחָד וְאֵין שֵׁנִי</tei:l>
          <tei:l>לְהַמְשִׁיל לוֹ לְהַחְבִּירָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam_in_marathi_translation/6"/>
        <tei:lg>
          <tei:l>בְּלִי רֵאֽשִׁית בְּלִי תַּכְלִית</tei:l>
          <tei:l>וְלוֹ הָעוֹז וְהַמִּשְׂרָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam_in_marathi_translation/7"/>
        <tei:lg>
          <tei:l>בְּלִי עֶֽרֶךְ בְּלִי דִמְיוֹן</tei:l>
          <tei:l>בְּלִי שִׁנּוּי וּתְּמוּרָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam_in_marathi_translation/8"/>
        <tei:lg>
          <tei:l>בְּלִי חִבּוּר בְּלִי פִירוּד</tei:l>
          <tei:l>גָּדוֹל־כֹּֽחַ וּגְבוּרָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam_in_marathi_translation/9"/>
        <tei:lg>
          <tei:l>וְהוּא אֵלִי וְחַי גּֽוֹאֲלִי</tei:l>
          <tei:l>וְצוּר חֶבְלִי בְּיוֹם צָרָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam_in_marathi_translation/10"/>
        <tei:lg>
          <tei:l>וְהוּא נִסִּי וּמָֽנוֹס לִי</tei:l>
          <tei:l>מְנָת כּוֹסִי בְּיוֹם אֶקְרָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam_in_marathi_translation/11"/>
        <tei:lg>
          <tei:l>וְהוּא רוֹפֵא וְהוּא מַרְפֵּא</tei:l>
          <tei:l>וְהוּא צוֹפֶה וְהוּא עֶזְרָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam_in_marathi_translation/12"/>
        <tei:lg>
          <tei:l>בְּיָדוֹ אַפְקִיד רוּחִי</tei:l>
          <tei:l>בְּעֵת אִישָׁן וְאָעִֽירָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam_in_marathi_translation/13"/>
        <tei:lg>
          <tei:l>וְעִם־רוּחִי גְּוִיָּתִי</tei:l>
          <tei:l>אֲדנָֺי לִי וְלֹא אִירָא׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam_in_marathi_translation/14"/>
        <tei:lg>
          <tei:l>בְּמִקְדָּשׁוֹ תָּגֵל נַפְשִׁי</tei:l>
          <tei:l>מְשִׁיחֵנוּ יִשְׁלַח מְהֵרָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adon_olam_in_marathi_translation/15"/>
        <tei:lg>
          <tei:l>וְאָז נָשִׁיר בְּבֵית קָדְשִׁי</tei:l>
          <tei:l>אָמֵן אָמֵן שֵׁם הַנּוֹרָא׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
