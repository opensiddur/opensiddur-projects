  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:ein_keloheinu">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ein_keloheinu/ein"/>
        <tei:lg>
          <tei:l>לֵיס אלֲלָהּ אִלָ֘א רַבַּ֘נָא</tei:l>
          <tei:l>לֵיְס אלֲלָהּ אִלַ֘א סַיִ֘דַּנָא</tei:l>
          <tei:l>לֵיְס אלֲלָהּ אִלַ֘א מַלִכַּנָא</tei:l>
          <tei:l>לֵיְס אלֲלָהּ אִלַ֘א גָׄאְיִתַׄנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ein_keloheinu/mi"/>
        <tei:lg>
          <tei:l>מַן מַתַׄל רַבַּ֘נָא</tei:l>
          <tei:l>מַן מַתַׄל סַיִ֘דַּנָא</tei:l>
          <tei:l>מַן מַתַׄל מַלִכַּנָא</tei:l>
          <tei:l>מַן מַתַׄל גָׄאְיִתַׄנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ein_keloheinu/nodeh"/>
        <tei:lg>
          <tei:l>נַשְׁכֻּר רַבַּ֘נָא</tei:l>
          <tei:l>נַשְׁכֻּר סַיִ֘דַּנָא</tei:l>
          <tei:l>נַשְׁכֻּר מַלִכַּנָא</tei:l>
          <tei:l>נַשְׁכֻּר גָׄאְיִתַׄנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ein_keloheinu/barukh"/>
        <tei:lg>
          <tei:l>מֻבָּארַךּ רַבַּ֘נָא</tei:l>
          <tei:l>מֻבָּארַךּ סַיִ֘דַּנָא</tei:l>
          <tei:l>מֻבָּארַךּ מַלִכַּנָא</tei:l>
          <tei:l>מֻבָּארַךּ גָׄאְיִתַׄנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ein_keloheinu/attah"/>
        <tei:lg>
          <tei:l>אַנְתַּ הוּאַ רַבַּ֘נָא</tei:l>
          <tei:l>אַנְתַּ הוּאַ סַיִ֘דַּנָא</tei:l>
          <tei:l>אַנְתַּ הוּאַ מַלִכַּנָא</tei:l>
          <tei:l>אַנְתַּ הוּאַ גָׄאְיִתַׄנָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:ein_keloheinu/incense"/>
        <tei:lg>
          <tei:l>אַנְתַּ הוּאַ אַלַ֘דִֿי אִיָ֘אךָּ אַחְרַקוּא</tei:l>
          <tei:l>אַגְּדָּאדֻּנָא אַלְבֻּכׄוּר קֻדָּ֘אמַךָּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza"/>
        <tei:lg>
          <tei:l>אַנְתַּ תַּגׄוּתָׄאנָא</tei:l>
          <tei:l>אַנְתַּ תַּקוּם תַּרְחַם צִיּוֹן</tei:l>
          <tei:l>פַאִנַ֘ה וַקְתּ תַּרוּפַהָא פִיהָ</tei:l>
          <tei:l>וַקַדּ בַּלַגׄ אלֲמוֹעִדּ</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
