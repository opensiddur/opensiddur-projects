  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:taglicher_psalm_meditativ_jaussi">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:taglicher_psalm_meditativ_jaussi/2"/>
        <tei:lg>
          <tei:l>שְׂאוּ שְׁעָרִים רָאשֵׁיכֶם וּשְׂאוּ פִּתְחֵי עוֹלָם <tei:bibl>(תהלים כד:ט חלק)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:taglicher_psalm_meditativ_jaussi/4"/>
        <tei:lg>
          <tei:l>דִּמִּינוּ אֱלֹהִים חַסְדֶּךָ <tei:bibl>(תהלים מח:י חלק)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:taglicher_psalm_meditativ_jaussi/6"/>
        <tei:lg>
          <tei:l>קוּמָה אֱלֹהִים שׇׁפְטָה הָאָרֶץ <tei:bibl>(תהלים פב:ח חלק)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:taglicher_psalm_meditativ_jaussi/8"/>
        <tei:lg>
          <tei:l>בְּרֹב שַׂרְעַפַּי בְּקִרְבִּי תַּנְחוּמֶיךָ יְשַׁעַשְׁעוּ נַפְשִׁי׃ <tei:bibl>(תהלים צד:יט)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:taglicher_psalm_meditativ_jaussi/10"/>
        <tei:lg>
          <tei:l>תִּקְעוּ בַחֹדֶשׁ שׁוֹפָר בַּכֵּסֶה לְיוֹם חַגֵּנוּ׃</tei:l>
          <tei:l>כִּי חֹק לְיִשְׂרָאֵל הוּא מִשְׁפָּט לֵאלֹהֵי יַעֲקֹב׃ <tei:bibl>(תהלים פא:ד-ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:taglicher_psalm_meditativ_jaussi/12"/>
        <tei:lg>
          <tei:l>נָכוֹן כִּסְאֲךָ מֵאָז מֵעוֹלָם אָתָּה׃ <tei:bibl>(תהלים צג:ב)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:taglicher_psalm_meditativ_jaussi/14"/>
        <tei:lg>
          <tei:l>מַה־גָּדְלוּ מַעֲשֶׂיךָ יְהֹוָה מְאֹד עָמְקוּ מַחְשְׁבֹתֶיךָ׃ <tei:bibl>(תהלים צג:ו)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
