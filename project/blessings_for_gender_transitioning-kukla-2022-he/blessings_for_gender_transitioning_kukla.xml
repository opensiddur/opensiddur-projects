  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:blessings_for_gender_transitioning_kukla">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessings_for_gender_transitioning_kukla/3"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם</tei:l>
          <tei:l>הַמַּעֲבִיר אֶת הָעוֹבְרִים׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessings_for_gender_transitioning_kukla/5"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם</tei:l>
          <tei:l>שֶׁעָשָׂנִי בְּצַלְמוֹ וְכִרְצוֹנָה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:blessings_for_gender_transitioning_kukla/7"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְיָ אֱלֹהֵינוּ</tei:l>
          <tei:l>מֶלֶךְ הָעוֹלָם,</tei:l>
          <tei:l>שֶׁהֶחֱיָנוּ</tei:l>
          <tei:l>וְקִיְּמָנוּ</tei:l>
          <tei:l>וְהִגִּיעָנוּ לַזְּמָן הַזֶּה׃</tei:l>
        </tei:lg>
      </tei:div>
