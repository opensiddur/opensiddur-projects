  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:abunan_debishmaya_meir">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:abunan_debishmaya_meir/1"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">אֲ</tei:seg>בוּנָן דְּבִשְׁמַיָּא וּבָרְיַן</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>רִי בּוּכְרִי קַרְיַן</tei:l>
          <tei:l><tei:seg type="acrostic">גַּ</tei:seg>דְפֵי נִשְׁרִין טַרְיַן</tei:l>
          <tei:l><tei:seg type="acrostic">דַּ</tei:seg>לִּיק קַמַּן מְנָרְיָן</tei:l>
          <tei:l><tei:seg type="acrostic">ה</tei:seg>וֹדַעֲא חִבְּתִין לִבְרְיָן</tei:l>
          <tei:l><tei:seg type="acrostic">וּ</tei:seg>לְאוּמֵּי דִּבְעָלְמָא שָׁרְיַן</tei:l>
          <tei:l><tei:seg type="acrostic">זְ</tei:seg>הִירִין לֶיהֱווֹן וּמַתְרְיָן</tei:l>
          <tei:l><tei:seg type="acrostic">חַ</tei:seg>בּוֹבֵי לַן וְאוֹקֹריָן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:abunan_debishmaya_meir/2"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">טְ</tei:seg>פֵי לָא מִסְתְּ־יָן</tei:l>
          <tei:l><tei:seg type="acrostic">יֹ</tei:seg>קַרְיָן דְּלָא בָּעְיָן</tei:l>
          <tei:l><tei:seg type="acrostic">כְּ</tei:seg>נִישִׁין עֲלַן וְאַתְיָן</tei:l>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>שַׁעְבֵּד בֵּן וְלִמְחוֹיַן</tei:l>
          <tei:l><tei:seg type="acrostic">מַ</tei:seg>חַן וְקַטְלָן מְשַׁנּיָן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:abunan_debishmaya_meir/3"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">נְ</tei:seg>טִיר לְהַהוּא עִניָן</tei:l>
          <tei:l><tei:seg type="acrostic">סַ</tei:seg>דַּר יוֹאֵל בְּחֶזְיָן</tei:l>
          <tei:l><tei:seg type="acrostic">עַ</tei:seg>מְמִין לְכַנּוֹשֵׁי בִּזְיָן</tei:l>
          <tei:l><tei:seg type="acrostic">פִּ</tei:seg>ילּוּג דִּינָא מֵישַׁרְיָן</tei:l>
          <tei:l><tei:seg type="acrostic">צְ</tei:seg>בִירִין מַשְׁרְיָן מַשְׁרְיָן</tei:l>
          <tei:l><tei:seg type="acrostic">קְ</tei:seg>שִׁיט פּוֹרְפִּירוֹן דְּגֵיוְיָן</tei:l>
          <tei:l><tei:seg type="acrostic">רָ</tei:seg>בֵי קְטִילִין וְשַׁבְיָן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:abunan_debishmaya_meir/4"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">שְׁ</tei:seg>קֵיל וּטְרֵי בְּעִנְיָן</tei:l>
          <tei:l><tei:seg type="acrostic">תַּ</tei:seg>קִּיפָא דְיִשְׂרָאֵל וְדַיָּן</tei:l>
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>צְרַיִם וֶאֱדוֹם זִיוָיָן</tei:l>
          <tei:l><tei:seg type="acrostic">אָ</tei:seg>חָד מְחַטְרָא הָוְיָן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:abunan_debishmaya_meir/5"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">יִ</tei:seg>תְעַדֵּי כִּתְרִין תִּניָן</tei:l>
          <tei:l><tei:seg type="acrostic">רֵ</tei:seg>ישָׁא פַרְעֹה לְסַניָן</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>טִיבוּ דַּהֲווֹ אַכְסְנָיָּן</tei:l>
          <tei:l><tei:seg type="acrostic">רְ</tei:seg>חוֹקֵי דְּלָא מַנְיָן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:abunan_debishmaya_meir/6"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>רָא לָא בָעְיָן</tei:l>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>הוֹרֵי וְסָתוֹרֵי בִּניָן</tei:l>
          <tei:l><tei:seg type="acrostic">יְ</tei:seg>רוּשְׁלֵם בְּאַתְרָא דְפַסְיָן</tei:l>
          <tei:l><tei:seg type="acrostic">צְ</tei:seg>לִיבִין וְיִתְעַבְדוּן כַּסיָן</tei:l>
          <tei:l><tei:seg type="acrostic">חַ</tei:seg>יָּבְתָא דְּאִיתְרְגְוֹשְׁתָהָא סַגִּיָּן</tei:l>
          <tei:l><tei:seg type="acrostic">קְ</tei:seg>טִילֵא תַּמָּן מִתְרַמְיָן</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:abunan_debishmaya_meir/7"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">חַ</tei:seg>סִּינָא זַכַּי תִּנְיָן</tei:l>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>נֵי לְעַמֵּיהּ בְּקִנְיָן</tei:l>
          <tei:l><tei:seg type="acrostic">וּ</tei:seg>בְזִיו שְׁכִינְתֵּיהּ מִתְחַנְּיָן</tei:l>
          <tei:l><tei:seg type="acrostic">אַ</tei:seg>נְהָרוּת עָלַם מִתְמַלְּיָן</tei:l>
          <tei:l><tei:seg type="acrostic">מִ</tei:seg>תְפַּנְּקִין וּמִתְעַדְּנִין וּמִתְעַלּיָן</tei:l>
          <tei:l><tei:seg type="acrostic">צִ</tei:seg>יהֲרֵי יְמָמֵי וְלֵילְיָן</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
