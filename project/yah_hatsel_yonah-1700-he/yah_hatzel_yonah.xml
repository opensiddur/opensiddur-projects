  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:yah_hatzel_yonah">
        <tei:head>יָהּ הַצֵּל יוֹנָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yah_hatzel_yonah/1"/>
        <tei:lg>
          <tei:l>יָהּ הַצֵּל יוֹנָה מְחַכָּה</tei:l>
          <tei:l>וְדִמְעָתָהּ לָךְ מְפַכָּה</tei:l>
          <tei:l>וְתִשְׂמַח בָּךְ אַתָּה מַלְכָּהּ</tei:l>
          <tei:l>בִּשְׁמוֹנַת יְמֵי חֲנֻכָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yah_hatzel_yonah/2"/>
        <tei:lg>
          <tei:l>וְתִשְׂמַח בָּךְ אַתָּה מַלְכָּהּ</tei:l>
          <tei:l>בִּשְׁמוֹנַת יְמֵי חֲנֻכָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yah_hatzel_yonah/3"/>
        <tei:lg>
          <tei:l>הוֹדוּ לְגֵאֶה עַל־גֵּאִים</tei:l>
          <tei:l>וְנוֹרָא עַל־כׇּל־נוֹרָאִים</tei:l>
          <tei:l>הִצִּיל אֶת־נִין חַשְׁמוֹנָאִים</tei:l>
          <tei:l>מִיָּד צָר כִּי־בָהֶם הִכָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yah_hatzel_yonah/4"/>
        <tei:lg>
          <tei:l>וְתִשְׂמַח בָּךְ אַתָּה מַלְכָּהּ</tei:l>
          <tei:l>בִּשְׁמוֹנַת יְמֵי חֲנֻכָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yah_hatzel_yonah/5"/>
        <tei:lg>
          <tei:l>וְיָשִֽׁירוּ עַמָּךְ שִׁירוֹת</tei:l>
          <tei:l>וּזְמִירוֹת מִפָּז יְקָרוֹת</tei:l>
          <tei:l>בְּהַדְלִיקָם אֶת־הַנֵּרוֹת</tei:l>
          <tei:l>בִּשְׁמוֹנַת יְמֵי חֲנֻכָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yah_hatzel_yonah/6"/>
        <tei:lg>
          <tei:l>וְתִשְׂמַח בָּךְ אַתָּה מַלְכָּהּ</tei:l>
          <tei:l>בִּשְׁמוֹנַת יְמֵי חֲנֻכָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yah_hatzel_yonah/7"/>
        <tei:lg>
          <tei:l>דִּרְשׁוּ לָאֵל כׇּל־לְבָבוֹת</tei:l>
          <tei:l>כִּי־גָמַל עָלֵֽינוּ טוֹבוֹת</tei:l>
          <tei:l>שִׂמְחוּ בָנִים עִם־הָאָבוֹת</tei:l>
          <tei:l>בְּדָת מִנִּי־יָם אֲרֻכָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yah_hatzel_yonah/8"/>
        <tei:lg>
          <tei:l>וְתִשְׂמַח בָּךְ אַתָּה מַלְכָּהּ</tei:l>
          <tei:l>בִּשְׁמוֹנַת יְמֵי חֲנֻכָּה׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yah_hatzel_yonah/9"/>
        <tei:lg>
          <tei:l>הָאֵל יָמֵֽינוּ יְחַדֵּשׁ</tei:l>
          <tei:l>וְצָר לַהֲרִיגָה יְקַדֵּשׁ</tei:l>
          <tei:l>יִשְׁלַֽח־עֶזְרְךָ֥ מִקֹּ֑דֶשׁ</tei:l>
          <tei:l>וּ֝מִצִּיּ֗וֹן יִסְעָדֶֽךָּ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:yah_hatzel_yonah/10"/>
        <tei:lg>
          <tei:l>וְתִשְׂמַח בָּךְ אַתָּה מַלְכָּהּ</tei:l>
          <tei:l>בִּשְׁמוֹנַת יְמֵי חֲנֻכָּה׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
