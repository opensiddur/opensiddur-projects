    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:nachamu">
        <tei:head>נַחֲמוּ נַחֲמוּ עַמִּי</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nachamu/1"/>
        <tei:lg>
          <tei:l>נַחֲמוּ נַחֲמוּ עַמִּי <tei:bibl>(ישעיהו מ:א)</tei:bibl> – יֹאמַר אֶשְׂכּוֹל כֹּֽפֶר,</tei:l>
          <tei:l>לְנַחֵם אֶת כׇּל־הַנִמְצָא כָּתוּב בַּסֵּפֶר,</tei:l>
          <tei:l>לָשׂוּם לַאֲבֵלֵי צִיּוֹן פְּאֵר תַּחַת אֵפֶר.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nachamu/2"/>
        <tei:lg>
          <tei:l>עַל־חַלְלֵי בַּת־עַמִּי לְמִי הוֹמֶה עֲלֵי,</tei:l>
          <tei:l>וְעַל־בֵּית אוּלַמִּי וְעַל־שִׁמְמוֹת הֵיכָלַי,</tei:l>
          <tei:l>מָקוֹם הַנִּקְרָא בִּשְׁמִי, וּקְרָאתִיו הֲדוֹם רַגְלַי,</tei:l>
          <tei:l>שָׂמוּ אוֹתוֹ לְעִיִּים בְּנֵי־עֵיפָה וָאֵֽפֶר׃<tei:anchor xml:id="note_4"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nachamu/3"/>
        <tei:lg>
          <tei:l>דַּבְּרוּ אֶל<tei:anchor xml:id="note_10"/> צִיּוֹן וְקָרְאוּ אֵלֶֽיהָ,</tei:l>
          <tei:l>וְהֵסִ֩ירָה֩ אֶת־שִׂמְלַ֨ת שִׁבְיָ֜הּ מֵעָלֶ֗יהָ, <tei:bibl>(דברים כא:יג)</tei:bibl>,</tei:l>
          <tei:l>בְּשׁוּבָהּ לֹא־יוֹסִיף לְטַמֵּא הֵיכָלֶֽיהָ,</tei:l>
          <tei:l>וְאַל־יִמְשֹׁל עַם נׇכְרִי בִּצְבִי נַחֲלַת שֶֽׁפֶר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nachamu/4"/>
        <tei:lg>
          <tei:l>נַחֵם עַם מֵאֶבְלוֹ וְכַפֵּר עַל־אַשְׁמָתוֹ,</tei:l>
          <tei:l>וְהָקֵל אֶת־סִבְלוֹ וְהַעֲבֵר אֶת־כְּלִמָּתוֹ,</tei:l>
          <tei:l>וּשְׁלַח מַלְאַךְ רַחֲמִים לְרַפֵּא אֶת־מְגוּרָתוֹ,</tei:l>
          <tei:l>וּפְדֵה עַמְּךָ מִשַּֽׁחַת לֵאמֹר ”מָצָ֥אתִי כֹֽפֶר“ <tei:bibl>(איוב לג:כד)</tei:bibl>.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nachamu/5"/>
        <tei:lg>
          <tei:l>נַחֲמוּ נַחֲמוּ עַמִּי <tei:bibl>(ישעיהו מ:א)</tei:bibl> – יֹאמַר אֶשְׂכּוֹל כֹּֽפֶר,</tei:l>
          <tei:l>לְנַחֵם אֶת כׇּל־הַנִמְצָא כָּתוּב בַּסֵּפֶר,</tei:l>
          <tei:l>לָשׂוּם לַאֲבֵלֵי צִיּוֹן פְּאֵר תַּחַת אֵפֶר.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nachamu/6"/>
        <tei:lg>
          <tei:l>אֶשָּׂא נֵס לַגּוֹיִם לַשּׁוֹכְנִים בְּכׇל־תֵּבֵל,</tei:l>
          <tei:l>לְשׁוֹבֵב לְהַר<tei:anchor xml:id="note_17"/> צִיּוֹן קְרוּאָה נַחֲלַת חֶבֶל,</tei:l>
          <tei:l>לָשׂוּם שֶׁמֶן שָׂשׂוֹן בְּרֹאשָׁהּ תַּחַת אֵבֶל,</tei:l>
          <tei:l>מְעִילָם וּמֵעֵיבָל, וּמֵעֵיפָה וָאֵפֶר׃<tei:anchor xml:id="note_18"/></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nachamu/7"/>
        <tei:lg>
          <tei:l>אֲשִׁיבֵם אֶל־נְוֵה קׇדְשָׁם, מִתְעַלְּפִים בַּהֲמוֹנָם,</tei:l>
          <tei:l>יָרֹנּוּ בִּמְחוֹלוֹת כִּי אֲנַחֵם<tei:anchor xml:id="note_23"/> מֵאֶבְלָם,</tei:l>
          <tei:l>וְאֶהְפֹּךְ אֶבְלָם לְשָׂשׂוֹן וְשִׂמַּחְתִּים מִיגוֹנָם,</tei:l>
          <tei:l>וְאָז כׇּל־שׂוֹטְנָם וּמוֹנָם, יַעֲטוּ בּוּז וְחֵֽפֶר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:nachamu/8"/>
        <tei:lg>
          <tei:l>יְרוּשָׁלַיִם אֶבְנֶה וְאֶהְיֶה סְבִיבוֹתֶֽיהָ,</tei:l>
          <tei:l>לְחוֹמַת אֵשׁ וּלְכָבוֹד בְּבָתֵּי מוֹשְׁבוֹתֶֽיהָ,</tei:l>
          <tei:l>וְאָז יֹאמְרוּ בָעַמִּים בִּרְכוֹת<tei:anchor xml:id="note_28"/> טוֹבוֹתֶיהָ,</tei:l>
          <tei:l>נִחַ֨ם יְהֹוָ֜ה צִיּ֗וֹן נִחַם֙ כׇּל־חׇרְבֹתֶ֔יהָ,</tei:l>
          <tei:l>וְתָשִׁיב בְּתוֹכָהּ לָעַד נוֹחֲלֵי אִמְרֵי שֶֽׁפֶר׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
