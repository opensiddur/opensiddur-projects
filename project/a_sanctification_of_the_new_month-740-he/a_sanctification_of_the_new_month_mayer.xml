    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer">
        <tei:head>קידוש לראש חודש, לפי מסכת סופרים</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/1"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">החזן:</tei:note> בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְהֹוָה אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>בּוֹרֵא פְּרִי הַגֶּֽפֶן!</tei:l>
          <tei:l><tei:note type="instruction">הקהל:</tei:note> אָמֵן!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/2"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">החזן:</tei:note> בָּרוּךְ אַתָּה</tei:l>
          <tei:l>יְהֹוָה אֱלֹהֵֽינוּ</tei:l>
          <tei:l>מֶֽלֶךְ הָעוֹלָם</tei:l>
          <tei:l>אֲשֶׁר גִּלָּה סוֹד חִדּוּשׁ הַיָּרֵֽחַ,</tei:l>
          <tei:l>הוֹרָם וְלִמְּדָם זְמַנִּים, חֳדָשִׁים, וְיָמִים טוֹבִים,</tei:l>
          <tei:l>מִנָּה נְבוֹנִים סוֹדְרֵי עִתִּים.</tei:l>
          <tei:l>פִּלֵּס צוּרֵֽינוּ קֵיצִי רְגָעִים</tei:l>
          <tei:l>שֶׁבָּם מְתַקֵּן אוֹתָם חֳדָשִׁים וּמוֹעֲדִים,</tei:l>
          <tei:l>דִּכְתִיב — עָשָׂ֣ה יָ֭רֵחַ לְמוֹעֲדִ֑ים</tei:l>
          <tei:l>שֶׁ֝֗מֶשׁ יָדַ֥ע מְבוֹאֽוֹ׃ <tei:bibl>(תהלים קד:יט)</tei:bibl></tei:l>
          <tei:l>וְנֶאֱמַר — כִּ֣י כַאֲשֶׁ֣ר הַשָּׁמַ֣יִם הַ֠חֲדָשִׁ֠ים</tei:l>
          <tei:l>וְהָאָ֨רֶץ הַחֲדָשָׁ֜ה אֲשֶׁ֨ר אֲנִ֥י עֹשֶׂ֛ה׃ <tei:bibl>(ישעיהו סו:כב)</tei:bibl></tei:l>
          <tei:l>בָּרוּךְ אַתָּה יְהֹוָה</tei:l>
          <tei:l>מְקַדֵּשׁ יִשְׂרָאֵל</tei:l>
          <tei:l>וְרָאשֵׁי חֳדָשִׁים!</tei:l>
          <tei:l><tei:note type="instruction">הקהל:</tei:note> אָמֵן!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/3"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">החזן:</tei:note> הוֹד֣וּ לַיהֹוָ֣ה כִּי־ט֑וֹב</tei:l>
          <tei:l><tei:note type="instruction">הקהל:</tei:note> כִּ֖י לְעוֹלָ֣ם חַסְדּֽוֹ׃ <tei:bibl>(תהלים קלו:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/4"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">החזן:</tei:note> (<tei:note type="instruction">נאסף בגבולות ירושלים:</tei:note> בַּיּוֹם הַזֶּה בִּירוּשָׁלַֽיִם)</tei:l>
          <tei:l>שָׂשִׂים וּשְׂמֵחִים כֻּלָּֽנוּ בַּמָּקוֹם.</tei:l>
          <tei:l>אֵלִיָּֽהוּ הַנָּבִיא בִּמְהֵרָה יָבוֹא אֵלֵֽינוּ!</tei:l>
          <tei:l>הַמֶּֽלֶךְ הַמָּשִֽׁיחַ יַצְמִֽיחַ בְּיָמֵֽינוּ</tei:l>
          <tei:l>אֶת הַשָּׁנִים בְּבִנְיַן בֵּית הַמִּקְדָּשׁ!</tei:l>
          <tei:l><tei:note type="instruction">הקהל:</tei:note> אָמֵן!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/5"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">החזן:</tei:note> יִרְבּוּ שְׂמָחוֹת בְּיִשְׂרָאֵל!</tei:l>
          <tei:l><tei:note type="instruction">הקהל:</tei:note> אָמֵן!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/6"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">החזן:</tei:note> יִרְבּוּ בְּשׂוֹרוֹת טוֹבוֹת בְּיִשְׂרָאֵל!</tei:l>
          <tei:l><tei:note type="instruction">הקהל:</tei:note> אָמֵן!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/7"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">החזן:</tei:note> יִרְבּוּ יָמִים טוֹבִים בְּיִשְׂרָאֵל!</tei:l>
          <tei:l><tei:note type="instruction">הקהל:</tei:note> אָמֵן!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/8"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">החזן:</tei:note> יִרְבּוּ תַּלְמִידֵי תּוֹרָה בְּיִשְׂרָאֵל!</tei:l>
          <tei:l><tei:note type="instruction">הקהל:</tei:note> אָמֵן!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/9"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">החזן:</tei:note> מְקֻדָּשׁ הַחֹֽדֶשׁ!</tei:l>
          <tei:l><tei:note type="instruction">הקהל:</tei:note> מְקֻדָּשׁ!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/10"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">החזן:</tei:note> מְקֻדָּשׁ בְּרֹאשׁ חֹֽדֶשׁ!</tei:l>
          <tei:l><tei:note type="instruction">הקהל:</tei:note> מְקֻדָּשׁ!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/11"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">החזן:</tei:note> מְקֻדָּשׁ בִּזְמַנּוֹ!</tei:l>
          <tei:l><tei:note type="instruction">הקהל:</tei:note> מְקֻדָּשׁ!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/12"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">החזן:</tei:note> מְקֻדָּשׁ בְּעִבּוּרוֹ!</tei:l>
          <tei:l><tei:note type="instruction">הקהל:</tei:note> מְקֻדָּשׁ!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/13"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">החזן:</tei:note> מְקֻדָּשׁ בַּתּוֹרָה!</tei:l>
          <tei:l><tei:note type="instruction">הקהל:</tei:note> מְקֻדָּשׁ!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/14"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">החזן:</tei:note> מְקֻדָּשׁ בַּהֲלָכָה!</tei:l>
          <tei:l><tei:note type="instruction">הקהל:</tei:note> מְקֻדָּשׁ!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/15"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">החזן:</tei:note> מְקֻדָּשׁ בָּעֶלְיוֹנִים!</tei:l>
          <tei:l><tei:note type="instruction">הקהל:</tei:note> מְקֻדָּשׁ!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/16"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">החזן:</tei:note> מְקֻדָּשׁ בַּתַּחְתּוֹנִים!</tei:l>
          <tei:l><tei:note type="instruction">הקהל:</tei:note> מְקֻדָּשׁ!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/17"/>
        <tei:lg>
          <tei:l>(<tei:note type="instruction">נאסף בארץ ישראל:</tei:note></tei:l>
          <tei:l><tei:note type="instruction">החזן:</tei:note> מְקֻדָּשׁ בְּאֶֽרֶץ יִשְׂרָאֵל!</tei:l>
          <tei:l><tei:note type="instruction">הקהל:</tei:note> מְקֻדָּשׁ!)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/18"/>
        <tei:lg>
          <tei:l>(<tei:note type="instruction">נאסף בגבולות ירושלים:</tei:note></tei:l>
          <tei:l><tei:note type="instruction">החזן:</tei:note> מְקֻדָּשׁ בְּצִיּוֹן!</tei:l>
          <tei:l><tei:note type="instruction">הקהל:</tei:note> מְקֻדָּשׁ!)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/19"/>
        <tei:lg>
          <tei:l>(<tei:note type="instruction">נאסף בגבולות ירושלים:</tei:note></tei:l>
          <tei:l><tei:note type="instruction">החזן:</tei:note> מְקֻדָּשׁ בִּירוּשָׁלַֽיִם!</tei:l>
          <tei:l><tei:note type="instruction">הקהל:</tei:note> מְקֻדָּשׁ!)</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/20"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">החזן:</tei:note> מְקֻדָּשׁ בְּכׇל מְקוֹמוֹת יִשְׂרָאֵל!</tei:l>
          <tei:l><tei:note type="instruction">הקהל:</tei:note> מְקֻדָּשׁ!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/21"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">החזן:</tei:note> מְקֻדָּשׁ בְּפִי רַבּוֹתֵֽינוּ!</tei:l>
          <tei:l><tei:note type="instruction">הקהל:</tei:note> מְקֻדָּשׁ!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/22"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">החזן:</tei:note> מְקֻדָּשׁ בְּבֵית הַוַּֽעַד!</tei:l>
          <tei:l><tei:note type="instruction">הקהל:</tei:note> מְקֻדָּשׁ!</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/23"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">החזן:</tei:note> הוֹד֣וּ לַיהֹוָ֣ה כִּי־ט֑וֹב</tei:l>
          <tei:l><tei:note type="instruction">הקהל:</tei:note>כִּ֖י לְעוֹלָ֣ם חַסְדּֽוֹ׃ <tei:bibl>(תהלים קלו:א)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_sanctification_of_the_new_month_mayer/24"/>
        <tei:lg>
          <tei:l><tei:note type="instruction">החזן:</tei:note> וְכֻלְּכֶם בְּרוּכִים!</tei:l>
          <tei:l><tei:note type="instruction">הקהל:</tei:note>וְגַם אַתָּה בָּרוּךְ!</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
