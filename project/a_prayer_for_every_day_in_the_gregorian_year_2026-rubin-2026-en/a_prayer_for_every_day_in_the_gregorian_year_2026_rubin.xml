  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_prayer_for_every_day_in_the_gregorian_year_2026_rubin">
        <tei:head>A prayer for every day in the Gregorian year 2026, by Miriam Rubin</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_every_day_in_the_gregorian_year_2026_rubin/1"/>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">Say this prayer everyday of 2026</tei:note>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_every_day_in_the_gregorian_year_2026_rubin/2"/>
        <tei:lg>
          <tei:l><j:divineName>Creator</j:divineName> &amp; <j:divineName>Sustainer of Life</j:divineName>:</tei:l>
          <tei:l>Please bless each &amp; every human being today.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_every_day_in_the_gregorian_year_2026_rubin/3"/>
        <tei:lg>
          <tei:l>Align our bodies, minds &amp; actions</tei:l>
          <tei:l>with health, love, wisdom &amp; joy.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_every_day_in_the_gregorian_year_2026_rubin/4"/>
        <tei:lg>
          <tei:l>Guide each and every human</tei:l>
          <tei:l>to realize our highest joy, calling &amp; purpose.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_every_day_in_the_gregorian_year_2026_rubin/5"/>
        <tei:lg>
          <tei:l>Help us to think</tei:l>
          <tei:l>clearly, creatively, compassionately &amp; courageously.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_every_day_in_the_gregorian_year_2026_rubin/6"/>
        <tei:lg>
          <tei:l>May our actions today shape our world</tei:l>
          <tei:l>to become a more compassionate, more loving,</tei:l>
          <tei:l>and more just world for all.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_every_day_in_the_gregorian_year_2026_rubin/7"/>
        <tei:lg>
          <tei:l><tei:hi rend="italic">Amen</tei:hi>.</tei:l>
          <tei:l>And so it is.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
