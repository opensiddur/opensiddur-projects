  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:mah_tovu">
        <tei:head>מַה־טֹּבֽוּ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:mah_tovu/mah_tovu-varani"/>
        <tei:lg>
          <tei:l>מַה־טֹּבֽוּ אֹהָלֶֽיךָ יַעֲקֹב</tei:l>
          <tei:l>מִשְׁכְּנֹתֶֽיךָ יִשְׂרָאֵל׃ <tei:bibl>(במדבר כד:ה)</tei:bibl></tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וַֽאֲנִי בְּרֹב חַסְדְּךָ</tei:l>
          <tei:l>אָבֹא בֵיתֶֽךָ</tei:l>
          <tei:l>אֶשְׁתַּֽחֲוֶה אֶל־הֵיכַל קָדְשְׁךָ</tei:l>
          <tei:l>בְּיִרְאָתֶֽךָ׃ <tei:bibl>(תהלים ה:ח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>יְהֹוָה אָהַבְתִּי מְעוֹן בֵּיתֶֽךָ</tei:l>
          <tei:l>וּמְקוֹם מִשְׁכַּן כְּבוֹדֶֽךָ׃ <tei:bibl>(תהלים כו:ח)</tei:bibl></tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וַֽאֲנִי אֶשְׁתַּחֲוֶה וְאֶכְרָֽעָה</tei:l>
          <tei:l>אֶבְרְכָה לִפְנֵי־יְהֹוָה עֹשִׂי׃ <tei:bibl>(תהלים צה:ו)</tei:bibl></tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>וַֽאֲנִי תְפִילָתִי־לְךָ ׀</tei:l>
          <tei:l>יְהֹוָה עֵת רָצוֹן.</tei:l>
          <tei:l>אֱלֹהִים, בְּרָב־חַסְדֶּךָ,</tei:l>
          <tei:l>עֲנֵֽנִי</tei:l>
          <tei:l>בֶּאֱמֶת יִשְׁעֶֽךָ׃ <tei:bibl>(תהלים סט:יד)</tei:bibl></tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>אָמֵן׃</tei:l>
        </tei:lg>
      </tei:div>
