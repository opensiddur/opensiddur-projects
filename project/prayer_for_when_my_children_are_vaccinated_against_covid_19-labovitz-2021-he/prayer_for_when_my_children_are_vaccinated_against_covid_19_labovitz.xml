      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_when_my_children_are_vaccinated_against_covid_19_labovitz">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_when_my_children_are_vaccinated_against_covid_19_labovitz/1"/>
        <tei:lg>
          <tei:l>מוֹדִים אֲנַחְנוּ לָךְ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_when_my_children_are_vaccinated_against_covid_19_labovitz/4"/>
        <tei:lg>
          <tei:l>בָּרוּךְ ...</tei:l>
          <tei:l>שֶׁהֶחֱיָנוּ</tei:l>
          <tei:l>וְקִיְּמָנוּ</tei:l>
          <tei:l>וְהִגִּיעָנוּ לַזְּמַן הַזֶּה׃</tei:l>
        </tei:lg>
      </tei:div>
