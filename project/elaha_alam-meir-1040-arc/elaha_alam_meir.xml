  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:elaha_alam_meir">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elaha_alam_meir/1"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">אֱ</tei:seg>לָהָא עָלַם דְמִלְּקַדְמִין בְּמֵימְרֵיהּ עָלְמָא בְּרָא</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>תוּשְׁבְּחָתָא אֲנָא מְנַגֵּן שְׁבַח שִׁירָה דְבָרָא</tei:l>
          <tei:l><tei:seg type="acrostic">גְּ</tei:seg>בוּרָן עָלַם לֵיהּ וְנִצְחָנֵי תְדִירָא</tei:l>
          <tei:l><tei:seg type="acrostic">דְּ</tei:seg>לֵיהּ תְפִיסָא מַלְכוּ וְקִילּוּס לֵיהּ סְדִירָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elaha_alam_meir/2"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">הֲ</tei:seg>לָא פְּרִישׁ יָאוּת לְגוֹ מְכִילְתָּא סְבִירָא</tei:l>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>דָמֵי מְתַל לְמַלְכָּא דְּאִיקְּלַע לְגוֹ בִּירָא</tei:l>
          <tei:l><tei:seg type="acrostic">זְ</tei:seg>רִיזִין כׇּלקַמּוֹי מְקַלְּסֵי דִיבֵּירָא</tei:l>
          <tei:l><tei:seg type="acrostic">חֲ</tei:seg>כִּימָא דֵין וְעַתִּיר וְרַחֲמָן וְגִיבָּרָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elaha_alam_meir/3"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">טִ</tei:seg>פֵּישָׁא הוּא וּמִסְכֵּן וְחַלָּשׁ וְאַכְזָרָא</tei:l>
          <tei:l><tei:seg type="acrostic">יַ</tei:seg>תִּירָא חֲנִיפוּתָא חֲדָא לָא אִיתְגְּזִירָא</tei:l>
          <tei:l><tei:seg type="acrostic">כְּ</tei:seg>לִילָא דְשִׁבְחָא וְתַגָּא דְהַדְרָא</tei:l>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>וָת מָרֵי מַלְכִין בְּכׇלסִיטְרָא הָדרָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elaha_alam_meir/4"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">מַ</tei:seg>סְהֲדֵי בֵּיהּ קְרָאֵי דְּדִילֵיהּ הִיא גְּבוּרָא</tei:l>
          <tei:l><tei:seg type="acrostic">נְ</tei:seg>פִישֵׁי לְפָרוֹשֵׁײַ לְמַטְרָח צִיבּוּרָא</tei:l>
          <tei:l><tei:seg type="acrostic">סַ</tei:seg>גִּיאָה הִיא חׇכְמְתָא וּמַנְדְּעֵיהּ יַתִּירָא</tei:l>
          <tei:l><tei:seg type="acrostic">עֲ</tei:seg>דִיפָא הִ עוּתְרֵיהּ בְּפוֹמְבֵּי עַתִּירָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elaha_alam_meir/5"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>רַקְמַטְיָא דִּידֵיהּ סְפִינְתָּא רַבָּא צְבִירָא</tei:l>
          <tei:l><tei:seg type="acrostic">צְ</tei:seg>רָרֵי כְסַף וּדְהַב תַּוָּנֵי דִדְבִירָא</tei:l>
          <tei:l><tei:seg type="acrostic">קְ</tei:seg>שׁוֹט וּמְהֵימָן הוּא בְּהֵימָנוּ קְיַיסְטְרָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elaha_alam_meir/6"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">רְ</tei:seg>חִימוֹהִי מְרַחֵם לְאַלְפֵי דָּר לְמִטְּרָא</tei:l>
          <tei:l><tei:seg type="acrostic">שְׁ</tei:seg>בִיל אוֹרְחָתֵיהּ דֵּין וְלָא בָּטֵיל תְּדִירָא</tei:l>
          <tei:l><tei:seg type="acrostic">תְּ</tei:seg>קוֹף הֲדַר שׁוּפְרֵיהּ לָא לְדַמּוֹיֵי סִדְרָא</tei:l>
          <tei:l><tei:seg type="acrostic">מְ</tei:seg>צַע אֵילֵי מְרוֹמָא שַׁחֲקִים וּמְדוֹרָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elaha_alam_meir/7"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">אָ</tei:seg>תָא הוּא בְּגוֹ רִיבְוָן וְדוּגְמָא וְהֶכֵּירָא</tei:l>
          <tei:l><tei:seg type="acrostic">יְ</tei:seg>קָרָא כְּאֵין דּוּגְמֵיהּ כְּבִשְׁבוּעָה חֲמִירָא</tei:l>
          <tei:l><tei:seg type="acrostic">רְ</tei:seg>שִׁים בִּשְׁבַח שִׁבְחִין דְּלִשְׁלֹמֹה אֲמִירָא</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>פוּם טְלַיֵי וְיָנְקֵי וּבִמְעוֹי עוֹבָרָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elaha_alam_meir/8"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">יְ</tei:seg>הַבוּ לֵיהּ שִׁבְחָא לְפוּם חֵיל לְסוֹבָרָא</tei:l>
          <tei:l><tei:seg type="acrostic">רְ</tei:seg>גַשׁ חֵיל קַדִּישִׁין בְּשִׁילְהֵי אֲדַר בָּתְרָא</tei:l>
          <tei:l>רְבוּ שְׁמָךְ רִיבּוֹנַן תְּקוֹף מַה בְּכׇל אַתְרָא</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>גוֹ עָנָם אִיתגְּאִי לִי קְרָא לִי בְּרָא בוּכְרָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elaha_alam_meir/9"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">יְ</tei:seg>קָרֵיהּ אַגְאִיתֵיהּ בְּלֵיל חַג לְאִידְּכָרָא</tei:l>
          <tei:l><tei:seg type="acrostic">יַ</tei:seg>תִּירָא עַל יַמָּא כְּמלְאַךְ דַּבָּרָא</tei:l>
          <tei:l><tei:seg type="acrostic">צְ</tei:seg>בֵיתִי לְשַׁבּוֹחֵי בְּמַלְכוּת לְגַבָּרָא</tei:l>
          <tei:l><tei:seg type="acrostic">חַ</tei:seg>בִּיבָא לִישָּׁנָא פְּתַח מֹשֶׁה סָפְרָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elaha_alam_meir/10"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">קֳ</tei:seg>בֵיל כׇּל יִשְׂרָאֵל תְּלַקִינּוּן בִּסְפָרָא</tei:l>
          <tei:l><tei:seg type="acrostic">בַּ</tei:seg>אֲזַי דְנֶיחָמֵי פְּתַחוּ לְאִיתְּעָרָא</tei:l>
          <tei:l><tei:seg type="acrostic">רְ</tei:seg>בוּ מַלְכוּ וְגֵיאוּ דְּלֵיכָּא לְשַׁעֲרָא</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>אִיתְגְּלָיוּתֵיהּ לְגֵיוְתָנֵי תְּבָרָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elaha_alam_meir/11"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">יִ</tei:seg>מָאֲכוּן וְיֵעֲלוּן לְגוֹ מְחִילֵּי עַפְרָא</tei:l>
          <tei:l><tei:seg type="acrostic">שְׁ</tei:seg>בִיל כֵּן אִיכְּפֵל לְגֵאוּתֵיהּ בְּשׁוּפְרָא</tei:l>
          <tei:l><tei:seg type="acrostic">מְ</tei:seg>טוּל עֲתִיד לְמַיְתֵי לְאַמְטוֹיֵי אֶפְרָא</tei:l>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>תִתְגְלֵי פּוּרְקָנָא כְּאַיַּלְתָּא דְּצַפְרָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elaha_alam_meir/12"/>
        <tei:lg xml:lang="he">
          <tei:l>לְעִידָּן זְעִירָא לְאִיתְעוֹרֵי נְגַהּ בִּשְׁפַרְפָּרָא</tei:l>
          <tei:l><tei:seg type="acrostic">אֲ</tei:seg>רֵי אַתְּ הוּא מָרֵי דְּיִשְׂרָאֵל נְהוֹרָא</tei:l>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>רוֹמְמָךְ וְאוֹדִיָיךְ בְּתוּשְׁבְּחָן וְשַׁבְהוֹרָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elaha_alam_meir/13"/>
        <tei:lg xml:lang="he">
          <tei:l>לְעִידָּן דִּי תִּתְגְּלֵי לַשְּׁאָרָא</tei:l>
          <tei:l>זָכוּ נִצְחָנִים לָךְ וְלִשְׁמָךְ לְאַשָּׁרָא</tei:l>
          <tei:l><tei:seg type="acrostic">רַ</tei:seg>וַּיחַ לִשָּׁן דּוּכָרָא שִׁבְחָא לִזְמָרָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elaha_alam_meir/14"/>
        <tei:lg xml:lang="he">
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>חלּוֹפֵי שִׁיטְּתָא דְּבַעֲנָם אִיתְאָמְרָא</tei:l>
          <tei:l><tei:seg type="acrostic">טְ</tei:seg>פֵילָא הִיא לְגַבַּהּ כְּלָל לָא מִתְעַקְּרָא</tei:l>
          <tei:l><tei:seg type="acrostic">וְ</tei:seg>שִׁיעְבּוּד מַלְכְוָתָא לְמִיקְּרֵו עִיקָּרָא</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>אַרְעָא וּבִשְׁמַיָּא שִׁבְחָא מִתְגַּבְּרָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:elaha_alam_meir/15"/>
        <tei:lg xml:lang="he">
          <tei:l>לְכִי סָלְקִין וְקָלְסִין דְּמִיכֵי אַרְעָא וּמַדְבְּרָא</tei:l>
          <tei:l>מִנָּא הָדָא מִילְּתָא רְמִיזָא וּמִתְיַשְּׁרָא</tei:l>
          <tei:l>כְּאָז יָשִׁיר מֹשֶׁה שַׁבַּח הָדָא שִׁירָא׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
