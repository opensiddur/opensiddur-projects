    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_prayer_for_relatives_to_recite_prior_to_the_donation_levine_68983">
        <tei:head>תְּפִלָּה לִקְרוֹבֵי מִשְׁפָּחָה קֹדֶם תְּרוּמַת אֵיבְרֵי יְקִירָתָם שֶׁנִּפְטְרָה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_relatives_to_recite_prior_to_the_donation_levine_68983/1"/>
        <tei:lg>
          <tei:l>ה׳ נָתַן וַה׳ לָקָח</tei:l>
          <tei:l>יְהִי שֵׁם ה׳ מְבֹרָךְ <tei:bibl>(איוב א:כא)</tei:bibl></tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_relatives_to_recite_prior_to_the_donation_levine_68983/2"/>
        <tei:lg>
          <tei:l>רִבּוֹנוֹ שֶׁל עוֹלָם,</tei:l>
          <tei:l>יְקִירָתֵנוּ (<tei:note type="instruction">פלונית בת פלוני ופלונית</tei:note>)</tei:l>
          <tei:l>נִלְקְחָה לְבֵית עוֹלָמָהּ.</tei:l>
          <tei:l>כּוֹאֲבִים וְדוֹאֲבִים,</tei:l>
          <tei:l>אָנוּ מְבַכִּים אֶת הִסְתַּלְּקוּתָהּ.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_relatives_to_recite_prior_to_the_donation_levine_68983/3"/>
        <tei:lg>
          <tei:l>אָבִינוּ שֶׁבַּשָּׁמַיִם,</tei:l>
          <tei:l>בִּשְׁעַת אֲנִינוּת קָשָׁה זוֹ,</tei:l>
          <tei:l>כְּשֶׁמֵּתֵנוּ מֻטָּל לְפָנֵינוּ, מְבַקְּשִׁים</tei:l>
          <tei:l>אָנוּ לְהוֹסִיף חַיִּים,</tei:l>
          <tei:l>טוֹבָה וּבְרָכָה בָּעוֹלָם,</tei:l>
          <tei:l>עַל פִּי הַשְׁקָפָתָהּ שֶׁל הַמְּנוֹחָה.</tei:l>
          <tei:l>וְעַל כֵּן בָּאִים אָנוּ לִתְרֹם אֵיבָרִים מִגּוּפָהּ</tei:l>
          <tei:l>לְקַיֵּם מִצְוַת פִּקּוּחַ נֶפֶשׁ,</tei:l>
          <tei:l>לְהַצִּיל חַיִּים וּלְהַעֲנִיק רְפוּאָה לְחוֹלִים</tei:l>
          <tei:l>הַזְּקוּקִים לִישׁוּעָה,</tei:l>
          <tei:l>וְאוֹמֵר הַכָּתוּב:</tei:l>
          <tei:l>”עוֹלָם חֶסֶד יִבָּנֶה“ <tei:bibl>(תהלים פט:ג)</tei:bibl>.</tei:l>
          <tei:l>תַּעֲמֹד זְכוּת זוֹ</tei:l>
          <tei:l>לְעִלּוּי נִשְׁמַת הַנִּפְטֶרֶת.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_relatives_to_recite_prior_to_the_donation_levine_68983/4"/>
        <tei:lg>
          <tei:l>וִיהִי רָצוֹן מִלְּפָנֶיךָ, מֶלֶךְ חַי וְקַיָּם,</tei:l>
          <tei:l>שֶׁהַשְׁתָּלַת הָאֵיבָרִים בְּגוּפָם שֶׁל הַנִּתְרָמִים תִּצְלַח,</tei:l>
          <tei:l>וְיִזְכּוּ הֵם לִרְפוּאָה שְׁלֵמָה בִּמְהֵרָה</tei:l>
          <tei:l>וּלְהַאֲרִיךְ יָמִים וְשָׁנִים בַּטּוֹב</tei:l>
          <tei:l>וּבַנְּעִימִים.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_relatives_to_recite_prior_to_the_donation_levine_68983/5"/>
        <tei:lg>
          <tei:l>בּוֹרֵא עוֹלָם,</tei:l>
          <tei:l>בּוֹחֵן כְּלָיוֹת וָלֵב,</tei:l>
          <tei:l>הַבֵּט נָא מִשָּׁמַיִם</tei:l>
          <tei:l>וּרְאֵה עֲמִידָתֵנוּ וְהִתְעַסְּקוּתֵנוּ בְּשָׁעָה זוֹ</tei:l>
          <tei:l>בְּהַצָּלַת נְפָשׁוֹת.</tei:l>
          <tei:l>רַחֵם עָלֵינוּ</tei:l>
          <tei:l>וְחַזְּקֵנוּ וְאַמְּצֵנו עַתָּה</tei:l>
          <tei:l>לְאַחַר אָבְדַן יְקִירָתֵנוּ.</tei:l>
          <tei:l>כִּי אֵל שׁוֹמֵעַ תְּפִלּוֹת וְתַחֲנוּנִים אַתָּה.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_prayer_for_relatives_to_recite_prior_to_the_donation_levine_68983/6"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה שׁוֹמֵעַ תְּפִלָּה.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
