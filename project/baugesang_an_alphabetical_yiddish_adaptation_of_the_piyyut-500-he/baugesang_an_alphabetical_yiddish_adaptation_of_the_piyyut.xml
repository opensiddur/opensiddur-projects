  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:baugesang_an_alphabetical_yiddish_adaptation_of_the_piyyut">
        <tei:head>בּױגעזאנג</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_an_alphabetical_yiddish_adaptation_of_the_piyyut/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אַ</tei:seg>דִּיר הוּא, אַדִּיר הוּא</tei:l>
          <tei:l>יִבְנֶה בֵּיתוֹ בְּקָרוֹב.</tei:l>
          <tei:l>בִּמְהֵרָה, בִּמְהֵרָה,</tei:l>
          <tei:l>בְּיָמֵינוּ בְּקָרוֹב.</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>אֵל בְּנֵה, אֵל בְּנֵה,</tei:l>
          <tei:l>בְּנֵה בֵּיתְךָ בְּקָרוֹב.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_an_alphabetical_yiddish_adaptation_of_the_piyyut/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">בָּ</tei:seg>חוּר הוּא</tei:l>
          <tei:l>יִבְנֶה בֵּיתוֹ בְּקָרוֹב...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_an_alphabetical_yiddish_adaptation_of_the_piyyut/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">גָּ</tei:seg>דוֹל הוּא.</tei:l>
          <tei:l><tei:seg type="acrostic">דָּ</tei:seg>גוּל הוּא.</tei:l>
          <tei:l>יִבְנֶה בֵּיתוֹ בְּקָרוֹב...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_an_alphabetical_yiddish_adaptation_of_the_piyyut/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הָ</tei:seg>דוּר הוּא.</tei:l>
          <tei:l><tei:seg type="acrostic">וָ</tei:seg>תִיק הוּא.</tei:l>
          <tei:l><tei:seg type="acrostic">זַ</tei:seg>כַּאי הוּא.</tei:l>
          <tei:l><tei:seg type="acrostic">חָ</tei:seg>סִיד הוּא.</tei:l>
          <tei:l>יִבְנֶה בֵּיתוֹ בְּקָרוֹב...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_an_alphabetical_yiddish_adaptation_of_the_piyyut/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">טָ</tei:seg>הוֹר הוּא.</tei:l>
          <tei:l><tei:seg type="acrostic">יָ</tei:seg>חִיד הוּא.</tei:l>
          <tei:l>יִבְנֶה בֵּיתוֹ בְּקָרוֹב...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_an_alphabetical_yiddish_adaptation_of_the_piyyut/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">כַּ</tei:seg>בִּיר הוּא.</tei:l>
          <tei:l><tei:seg type="acrostic">לָ</tei:seg>מוּד הוּא.</tei:l>
          <tei:l><tei:seg type="acrostic">מֶ</tei:seg>לֶךְ הוּא.</tei:l>
          <tei:l><tei:seg type="acrostic">נָ</tei:seg>אוֹר הוּא.</tei:l>
          <tei:l><tei:seg type="acrostic">סַ</tei:seg>גִּיב הוּא.</tei:l>
          <tei:l><tei:seg type="acrostic">עִ</tei:seg>זּוּז הוּא.</tei:l>
          <tei:l>יִבְנֶה בֵּיתוֹ בְּקָרוֹב...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_an_alphabetical_yiddish_adaptation_of_the_piyyut/7"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פּ</tei:seg>וֹדֶה הוּא.</tei:l>
          <tei:l><tei:seg type="acrostic">צַ</tei:seg>דִּיק הוּא.</tei:l>
          <tei:l><tei:seg type="acrostic">קָ</tei:seg>דוֹשׁ הוּא.</tei:l>
          <tei:l><tei:seg type="acrostic">רַ</tei:seg>חוּם הוּא.</tei:l>
          <tei:l>יִבְנֶה בֵּיתוֹ בְּקָרוֹב...</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:baugesang_an_alphabetical_yiddish_adaptation_of_the_piyyut/8"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שַׁ</tei:seg>דַּי הוּא.</tei:l>
          <tei:l><tei:seg type="acrostic">תַּ</tei:seg>קִּיף הוּא.</tei:l>
          <tei:l>יִבְנֶה בֵּיתוֹ בְּקָרוֹב...</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
