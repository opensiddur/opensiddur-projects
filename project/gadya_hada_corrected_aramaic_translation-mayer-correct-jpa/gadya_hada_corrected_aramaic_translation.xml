  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:gadya_hada_corrected_aramaic_translation">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:gadya_hada_corrected_aramaic_translation/1"/>
        <tei:lg>
          <tei:l>גַּדְיָא חֲדָא, גַּדְיָא חֲדָא</tei:l>
          <tei:l>דִּזְבֵין אַבָּא</tei:l>
          <tei:l>בִּתְרֵי זוּזֵי</tei:l>
          <tei:l>גַּדְיָא חֲדָא, גַּדְיָא חֲדָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:gadya_hada_corrected_aramaic_translation/2"/>
        <tei:lg>
          <tei:l>וַאֲתָא שׁוּנָּרָא</tei:l>
          <tei:l>וַאֲכַל יָת־גַּדְיָא</tei:l>
          <tei:l>דִּזְבֵין אַבָּא</tei:l>
          <tei:l>בִּתְרֵי זוּזֵי</tei:l>
          <tei:l>גַּדְיָא חֲדָא, גַּדְיָא חֲדָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:gadya_hada_corrected_aramaic_translation/3"/>
        <tei:lg>
          <tei:l>וַאֲתָא כַּלְבָּא</tei:l>
          <tei:l>וּנְכֵית לְשׁוּנָּרָא</tei:l>
          <tei:l>דַּאֲכַל יָת־גַּדְיָא</tei:l>
          <tei:l>דִּזְבֵין אַבָּא</tei:l>
          <tei:l>בִּתְרֵי זוּזֵי</tei:l>
          <tei:l>גַּדְיָא חֲדָא, גַּדְיָא חֲדָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:gadya_hada_corrected_aramaic_translation/4"/>
        <tei:lg>
          <tei:l>וַאֲתָא חוּטְרָא</tei:l>
          <tei:l>וּמְחֵי יָת־כַּלְבָּא</tei:l>
          <tei:l>דִּנְכֵית לְשׁוּנָּרָא</tei:l>
          <tei:l>דַּאֲכַל יָת־גַּדְיָא</tei:l>
          <tei:l>דִּזְבֵין אַבָּא</tei:l>
          <tei:l>בִּתְרֵי זוּזֵי</tei:l>
          <tei:l>גַּדְיָא חֲדָא, גַּדְיָא חֲדָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:gadya_hada_corrected_aramaic_translation/5"/>
        <tei:lg>
          <tei:l>וַאֲתָא נוּרָא</tei:l>
          <tei:l>וְאוֹקִיד יָת־חוּטְרָא</tei:l>
          <tei:l>דִּמְחֵי יָת־כַּלְבָּא</tei:l>
          <tei:l>דִּנְכֵית לְשׁוּנָּרָא</tei:l>
          <tei:l>דַּאֲכַל יָת־גַּדְיָא</tei:l>
          <tei:l>דִּזְבֵין אַבָּא</tei:l>
          <tei:l>בִּתְרֵי זוּזֵי</tei:l>
          <tei:l>גַּדְיָא חֲדָא, גַּדְיָא חֲדָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:gadya_hada_corrected_aramaic_translation/6"/>
        <tei:lg>
          <tei:l>וַאֲתוֹ מַיָּא</tei:l>
          <tei:l>וְאַדְעִיכוּ יָת־נוּרָא</tei:l>
          <tei:l>דְּאוֹקִיד יָת־חוּטְרָא</tei:l>
          <tei:l>דִּמְחֵי יָת־כַּלְבָּא</tei:l>
          <tei:l>דִּנְכֵית לְשׁוּנָּרָא</tei:l>
          <tei:l>דַּאֲכַל יָת־גַּדְיָא</tei:l>
          <tei:l>דִּזְבֵין אַבָּא</tei:l>
          <tei:l>בִּתְרֵי זוּזֵי</tei:l>
          <tei:l>גַּדְיָא חֲדָא, גַּדְיָא חֲדָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:gadya_hada_corrected_aramaic_translation/7"/>
        <tei:lg>
          <tei:l>וַאֲתָא תּוֹרָא</tei:l>
          <tei:l>וּשְׁתֵי יָת־מַיָּא</tei:l>
          <tei:l>דְּאַדְעִיכוּ יָת־נוּרָא</tei:l>
          <tei:l>דְּאוֹקִיד יָת־חוּטְרָא</tei:l>
          <tei:l>דִּמְחֵי יָת־כַּלְבָּא</tei:l>
          <tei:l>דִּנְכֵית לְשׁוּנָּרָא</tei:l>
          <tei:l>דַּאֲכַל יָת־גַּדְיָא</tei:l>
          <tei:l>דִּזְבֵין אַבָּא</tei:l>
          <tei:l>בִּתְרֵי זוּזֵי</tei:l>
          <tei:l>גַּדְיָא חֲדָא, גַּדְיָא חֲדָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:gadya_hada_corrected_aramaic_translation/8"/>
        <tei:lg>
          <tei:l>וַאֲתָא טַבָּחָא</tei:l>
          <tei:l>וּנְכֵיס יָת־תּוֹרָא</tei:l>
          <tei:l>דִּשְׁתֵי יָת־מַיָּא</tei:l>
          <tei:l>דְּאַדְעִיכוּ יָת־נוּרָא</tei:l>
          <tei:l>דְּאוֹקִיד יָת־חוּטְרָא</tei:l>
          <tei:l>דִּמְחֵי יָת־כַּלְבָּא</tei:l>
          <tei:l>דִּנְכֵית לְשׁוּנָּרָא</tei:l>
          <tei:l>דַּאֲכַל יָת־גַּדְיָא</tei:l>
          <tei:l>דִּזְבֵין אַבָּא</tei:l>
          <tei:l>בִּתְרֵי זוּזֵי</tei:l>
          <tei:l>גַּדְיָא חֲדָא, גַּדְיָא חֲדָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:gadya_hada_corrected_aramaic_translation/9"/>
        <tei:lg>
          <tei:l>וַאֲתָא מַלְאֲכָא דְּמוֹתָא</tei:l>
          <tei:l>וּנְכֵיס יָת־טַבָּחָא</tei:l>
          <tei:l>דִּנְכֵיס יָת־תּוֹרָא</tei:l>
          <tei:l>דִּשְׁתֵי יָת־מַיָּא</tei:l>
          <tei:l>דְּאַדְעִיכוּ יָת־נוּרָא</tei:l>
          <tei:l>דְּאוֹקִיד יָת־חוּטְרָא</tei:l>
          <tei:l>דִּמְחֵי יָת־כַּלְבָּא</tei:l>
          <tei:l>דִּנְכֵית לְשׁוּנָּרָא</tei:l>
          <tei:l>דַּאֲכַל יָת־גַּדְיָא</tei:l>
          <tei:l>דִּזְבֵין אַבָּא</tei:l>
          <tei:l>בִּתְרֵי זוּזֵי</tei:l>
          <tei:l>גַּדְיָא חֲדָא, גַּדְיָא חֲדָא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:gadya_hada_corrected_aramaic_translation/10"/>
        <tei:lg>
          <tei:l>וַאֲתָא קוּדְשָׁא בְּרִיךְ הוּא</tei:l>
          <tei:l>וּנְכֵיס יָת־מַלְאֲכָא דְּמוֹתָא</tei:l>
          <tei:l>דִּנְכֵיס יָת־טַבָּחָא</tei:l>
          <tei:l>דִּנְכֵיס יָת־תּוֹרָא</tei:l>
          <tei:l>דִּשְׁתֵי יָת־מַיָּא</tei:l>
          <tei:l>דְּאַדְעִיכוּ יָת־נוּרָא</tei:l>
          <tei:l>דְּאוֹקִיד יָת־חוּטְרָא</tei:l>
          <tei:l>דִּמְחֵי יָת־כַּלְבָּא</tei:l>
          <tei:l>דִּנְכֵית לְשׁוּנָּרָא</tei:l>
          <tei:l>דַּאֲכַל יָת־גַּדְיָא</tei:l>
          <tei:l>דִּזְבֵין אַבָּא</tei:l>
          <tei:l>בִּתְרֵי זוּזֵי</tei:l>
          <tei:l>גַּדְיָא חֲדָא, גַּדְיָא חֲדָא</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
