  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:a_scholars_prayer_for_intellectual_honesty">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:a_scholars_prayer_for_intellectual_honesty/1"/>
        <tei:lg>
          <tei:l>מִן הַפַּחְדָנוּת שֶׁמִּסְתַּתֶּרֶת מֵאֲמִתּוֹת חֲדָשׁוֹת</tei:l>
          <tei:l>מִן הָעַצְלוּת שֶׁמִּסְתַּפֶּקֶת בַּחֲצָאֵי אֲמִתּוֹת,</tei:l>
          <tei:l>מִן הַיְּהִירוּת שֶׁסוֹבֶרֶת שֶׁהִיא יוֹדַעַת אֶת כׇּל הָאֱמֶת לְאֲמִיתוֹ,</tei:l>
          <tei:l>דַּיַּין הָאֱמֶת, הַצִּילֵנוּ.</tei:l>
          <tei:l>כַּכָּתוּב בְּיָדְךָ אַפְקִיד רוּחִי</tei:l>
          <tei:l>פָּדִיתָה אוֹתִי יְהוָה אֵל אֱמֶת׃ <tei:bibl>(תהלים לא:ו)</tei:bibl></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
