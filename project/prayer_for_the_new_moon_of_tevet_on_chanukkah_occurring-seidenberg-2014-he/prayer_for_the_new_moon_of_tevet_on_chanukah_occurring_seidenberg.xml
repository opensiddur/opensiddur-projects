        <tei:head>תפילה לראש חודש טבת ותקופת החורף על חנוכּה</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_new_moon_of_tevet_on_chanukah_occurring_seidenberg/4"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>הַמַּעֲרִיב עֲרָבִים:‏</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_new_moon_of_tevet_on_chanukah_occurring_seidenberg/5"/>
        <tei:lg>
          <tei:l>בָּרוּךְ אַתָּה יְיָ</tei:l>
          <tei:l>יוֹצֵר אוֹר וּבוֹרֵא חֹֽשֶׁךְ</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>יוֹצֵר הַמְּאֹרֹת׃</tei:l>
        </tei:lg>
      </tei:div>
