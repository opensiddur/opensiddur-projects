  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hosha_na_for_our_planet_seidenberg">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_our_planet_seidenberg/1"/>
        <tei:lg xml:lang="en">
          <tei:l>
            <tei:hi rend="italic">Hoshana Eloheinu Hoshana!</tei:hi>
          </tei:l>
          <tei:l>
            <tei:hi rend="italic">Hoshana Bor’einu Hoshana!</tei:hi>
          </tei:l>
          <tei:l>
            <tei:hi rend="italic">Hoshana Go’aleinu Hoshana!</tei:hi>
          </tei:l>
          <tei:l>
            <tei:hi rend="italic">Hoshana Dorsheinu Hoshana!</tei:hi>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_our_planet_seidenberg/2"/>
        <tei:lg xml:lang="he">
          <tei:l>!הושענא</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_our_planet_seidenberg/3"/>
        <tei:lg xml:lang="en">
          <tei:l>
            <tei:hi rend="italic">Hoshana ananim mil’ham’ni’a otzroteihem!</tei:hi>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_our_planet_seidenberg/4"/>
        <tei:lg xml:lang="en">
          <tei:l>
            <tei:hi rend="italic">Hoshana Eretz u-m’lo’ah!</tei:hi>
          </tei:l>
          <tei:l>
            <tei:hi rend="italic">Hoshana!</tei:hi>
          </tei:l>
          <tei:l>
            <tei:hi rend="italic">Hoshana basar v’ruach u-n’shamah b’khol b’ri’ah!</tei:hi>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_our_planet_seidenberg/7"/>
        <tei:lg xml:lang="en">
          <tei:l>
            <tei:hi rend="italic">Hoshana! Chidush p’nei ha’adamah!</tei:hi>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_our_planet_seidenberg/8"/>
        <tei:lg xml:lang="en">
          <tei:l>
            <tei:hi rend="italic">Hoshana! Her’eh lanu et ha-keshet sas u-mit’pa’er b’govanin shelo!</tei:hi>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_our_planet_seidenberg/9"/>
        <tei:lg xml:lang="en">
          <tei:l>
            <tei:hi rend="italic">Hoshana olam t’luyah al b’li mah!</tei:hi>
          </tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:hosha_na_for_our_planet_seidenberg/10"/>
        <tei:lg xml:lang="he">
          <tei:l>!הושענא</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
