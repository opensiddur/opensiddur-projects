      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/142">
        <tei:head>תהלים קמ״ב</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/142/1-8"/>
        <tei:lg>
          <tei:l>מַשְׂכִּיל לְדָוִד,</tei:l>
          <tei:l>בִּהְיוֹתוֹ בַמְּעָרָה תְפִלָּה׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>קוֹלִי אֶל יְהוָה אֶזְעָק,</tei:l>
          <tei:l>קוֹלִי אֶל יְהוָה אֶתְחַנָּן׃</tei:l>
          <tei:l>אֶשְׁפֹּךְ לְפָנָיו שִׂיחִי,</tei:l>
          <tei:l>צָרָתִי לְפָנָיו אַגִּיד׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>בְּהִתְעַטֵּף עָלַי רוּחִי וְאַתָּה יָדַֽעְתָּ נְתִיבָתִי,</tei:l>
          <tei:l>בְּאֹֽרַח זוּ אֲהַלֵּךְ טָמְנוּ פַח לִי׃</tei:l>
          <tei:l>הַבֵּיט יָמִין וּרְאֵה וְאֵין לִי מַכִּיר,</tei:l>
          <tei:l>אָבַד מָנוֹס מִמֶּֽנִּי אֵין דּוֹרֵשׁ לְנַפְשִׁי׃</tei:l>
          <tei:l>זָעַקְתִּי אֵלֶֽיךָ יְהוָה אָמַֽרְתִּי אַתָּה מַחְסִי,</tei:l>
          <tei:l>חֶלְקִי בְּאֶֽרֶץ הַחַיִּֽים׃</tei:l>
          <tei:l>הַקְשִֽׁיבָה אֶל רִנָּתִי כִּי דַלּֽוֹתִי מְאֹד,</tei:l>
          <tei:l>הַצִּילֵֽנִי מֵרֹדְפַי כִּי אָמְצוּ מִמֶּֽנִּי׃</tei:l>
          <tei:l>הוֹצִֽיאָה מִמַּסְגֵּר נַפְשִׁי לְהוֹדוֹת אֶת שְׁמֶֽךָ,</tei:l>
          <tei:l>בִּי יַכְתִּֽרוּ צַדִּיקִים</tei:l>
          <tei:l>כִּי תִגְמֹל עָלָי׃</tei:l>
        </tei:lg>
        <tei:lg>
          <tei:l>
            <tei:note type="instruction">מִי שֶׁבֵּרַךְ לְפִדְיוֹן שְׁבוּיִם</tei:note>
          </tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
