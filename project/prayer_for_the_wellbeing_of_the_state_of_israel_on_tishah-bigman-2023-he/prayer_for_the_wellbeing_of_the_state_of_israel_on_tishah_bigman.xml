      <tei:div corresp="urn:x-opensiddur:text:prayer:prayer_for_the_wellbeing_of_the_state_of_israel_on_tishah_bigman">
        <tei:head>תפילה לתשעה באב</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_wellbeing_of_the_state_of_israel_on_tishah_bigman/1"/>
        <tei:lg>
          <tei:l>אַתָּה יָצַרְתָּ עוֹלָמְךָ מִקֶּדֶם</tei:l>
          <tei:l>בָּרָאתָ בְּרִיּוֹת אֵין קֵץ</tei:l>
          <tei:l>וַתְּחַסֵּר מְעַט אֶת הָאָדָם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_wellbeing_of_the_state_of_israel_on_tishah_bigman/2"/>
        <tei:lg>
          <tei:l>עֲבָדֶיךָ גָּאַלְתָּ מֵעָרִיצוּת מִצְרַיִם</tei:l>
          <tei:l>בְּשׂוֹרָה לְבָאֵי עוֹלָם</tei:l>
          <tei:l>לַעֲשׂוֹת צְדָקָה וּמִשְׁפְט.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_wellbeing_of_the_state_of_israel_on_tishah_bigman/3"/>
        <tei:lg>
          <tei:l>אַךְ כִּסְדֹם הָיִינוּ</tei:l>
          <tei:l>וּפַעֲמַיִם מֵאַרְצֵנוּ גָּלִינוּ</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_wellbeing_of_the_state_of_israel_on_tishah_bigman/4"/>
        <tei:lg>
          <tei:l>וְשׁוּב גְּאַלְתָּנוּ מִצָרֵינוּ</tei:l>
          <tei:l>וַהֲבֵאתָנוּ לְצִיּוֹן עִיר צֶדָק</tei:l>
          <tei:l>כִּבְשֹוֹרָה לְבָאֵי עוֹלָם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_wellbeing_of_the_state_of_israel_on_tishah_bigman/5"/>
        <tei:lg>
          <tei:l>וְשׁוּב אָנוּ הוֹלְכִים שֶׁבִי</tei:l>
          <tei:l>שִׁכּוֹרֵי כֹּחַ וּבֶצַע.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_wellbeing_of_the_state_of_israel_on_tishah_bigman/6"/>
        <tei:lg>
          <tei:l>הֲשִׁיבֵנוּ אֵלֶיךָ</tei:l>
          <tei:l>וּבָרְכֵנוּ כְּאֶחָד בְּאוֹר פָּנֶיךָ</tei:l>
          <tei:l>וְרַב שְׁלוֹם בָּנֶיךָ</tei:l>
          <tei:l>עִם כׇּל בָּאֵי עוֹלָם.</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:prayer_for_the_wellbeing_of_the_state_of_israel_on_tishah_bigman/7"/>
        <tei:lg>
          <tei:l>כִּי צִיּוֹן בְּמִשְׁפָּט תִּפָּדֶה</tei:l>
          <tei:l>שָׂשׂוֹן וְשִׂמְחָה יִמָּצֵא בָהּ.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
