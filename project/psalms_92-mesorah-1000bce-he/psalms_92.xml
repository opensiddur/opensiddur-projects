      <tei:div corresp="urn:x-opensiddur:text:bible:psalms/92">
        <tei:head>תהלים צ״ב</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/92/1"/>
        <tei:lg>
          <tei:l>מִזְמ֥וֹר שִׁ֗יר לְי֣וֹם הַשַּׁבָּֽת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/92/2/a"/>
        <tei:lg>
          <tei:l>ט֗וֹב לְהֹד֥וֹת לַיהֹוָ֑ה</tei:l>
          <tei:l>וּלְזַמֵּ֖ר לְשִׁמְךָ֣ עֶלְיֽוֹן׃</tei:l>
          <tei:l>לְהַגִּ֣יד בַּבֹּ֣קֶר חַסְדֶּ֑ךָ</tei:l>
          <tei:l>וֶ֝אֱמ֥וּנָתְךָ֗ בַּלֵּילֽוֹת׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/92/4/a"/>
        <tei:lg>
          <tei:l>עֲֽלֵי־עָ֭שׂוֹר וַעֲלֵי־נָ֑בֶל</tei:l>
          <tei:l>עֲלֵ֖י הִגָּי֣וֹן בְּכִנּֽוֹר׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/92/5/a"/>
        <tei:lg>
          <tei:l>כִּ֤י שִׂמַּחְתַּ֣נִי יְהֹוָ֣ה בְּפׇעֳלֶ֑ך</tei:l>
          <tei:l>בְּֽמַעֲשֵׂ֖י יָדֶ֣יךָ אֲרַנֵּֽן׃</tei:l>
          <tei:l>מַה־גָּדְל֣וּ מַעֲשֶׂ֣יךָ יְהֹוָ֑ה</tei:l>
          <tei:l>מְ֝אֹ֗ד עָמְק֥וּ מַחְשְׁבֹתֶֽיךָ׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/92/7/a"/>
        <tei:lg>
          <tei:l>אִֽישׁ־בַּ֭עַר לֹ֣א יֵדָ֑ע</tei:l>
          <tei:l>וּ֝כְסִ֗יל לֹא־יָבִ֥ין אֶת־זֹֽאת׃</tei:l>
          <tei:l>בִּפְרֹ֤חַ רְשָׁעִ֨ים ׀ כְּמ֥וֹ עֵ֗שֶׂב</tei:l>
          <tei:l>וַ֭יָּצִיצוּ כׇּל־פֹּ֣עֲלֵי אָ֑וֶן</tei:l>
          <tei:l>לְהִשָּׁמְדָ֥ם עֲדֵי־עַֽד׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/92/9"/>
        <tei:lg>
          <tei:l>וְאַתָּ֥ה מָר֗וֹם לְעֹלָ֥ם יְהֹוָֽה׃</tei:l>
          <tei:l>כִּ֤י הִנֵּ֪ה אֹיְבֶ֡יךָ ׀ יְֽהֹוָ֗ה</tei:l>
          <tei:l>כִּֽי־הִנֵּ֣ה אֹיְבֶ֣יךָ יֹאבֵ֑דוּ</tei:l>
          <tei:l>יִ֝תְפָּרְד֗וּ כׇּל־פֹּ֥עֲלֵי אָֽוֶן׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/92/11/a"/>
        <tei:lg>
          <tei:l>וַתָּ֣רֶם כִּרְאֵ֣ים קַרְנִ֑י</tei:l>
          <tei:l>בַּ֝לֹּתִ֗י בְּשֶׁ֣מֶן רַעֲנָֽן׃</tei:l>
          <tei:l>וַתַּבֵּ֥ט עֵינִ֗י בְּשׁ֫וּרָ֥י</tei:l>
          <tei:l>בַּקָּמִ֖ים עָלַ֥י מְרֵעִ֗ים</tei:l>
          <tei:l>תִּשְׁמַ֥עְנָה אׇזְנָֽי׃</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:bible:psalms/92/13/a"/>
        <tei:lg>
          <tei:l>צַ֭דִּיק כַּתָּמָ֣ר יִפְרָ֑ח</tei:l>
          <tei:l>כְּאֶ֖רֶז בַּלְּבָנ֣וֹן יִשְׂגֶּֽה׃</tei:l>
          <tei:l>שְׁ֭תוּלִים בְּבֵ֣ית יְהֹוָ֑ה</tei:l>
          <tei:l>בְּחַצְר֖וֹת אֱלֹהֵ֣ינוּ יַפְרִֽיחוּ׃</tei:l>
          <tei:l>ע֭וֹד יְנוּב֣וּן בְּשֵׂיבָ֑ה</tei:l>
          <tei:l>דְּשֵׁנִ֖ים וְֽרַעֲנַנִּ֣ים יִהְיֽוּ׃</tei:l>
          <tei:l>לְ֭הַגִּיד כִּֽי־יָשָׁ֣ר יְהֹוָ֑ה</tei:l>
          <tei:l>צ֝וּרִ֗י וְֽלֹא־עַוְלָ֥תָה עלתה בּֽוֹ׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
