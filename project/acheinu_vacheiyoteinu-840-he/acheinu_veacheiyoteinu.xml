  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:acheinu_veacheiyoteinu">
        <tei:head>אַחֵֽינוּ וְאַחֱיוֹתֵנוּ</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:acheinu_veacheiyoteinu/1"/>
        <tei:lg>
          <tei:l>אַחֵינוּ כָּל בֵּית יִשְׂרָאֵל,</tei:l>
          <tei:l>אַחֵיוֹתֵנוּ כָּל בֵּית יִשְׂרָאֵל,</tei:l>
          <tei:l>הַנְּתוּנִים בְּצָרָה, בְּצָרָה וּבַשִּׁבְיָה</tei:l>
          <tei:l>הָעוֹמְדִים בֵּין בַּיָּם וּבֵין בַּיַּבָּשָׁה,</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:prayer:acheinu_veacheiyoteinu/3"/>
        <tei:lg>
          <tei:l>הַמָּקוֹם יְרַחֵם עֲלֵיהֶם,</tei:l>
          <tei:l>וְיוֹצִיאֵם מִצָּרָה</tei:l>
          <tei:l>לִרְוָחָה,</tei:l>
          <tei:l>וּמֵאֲפֵלָה לְאוֹרָה,</tei:l>
          <tei:l>וּמִשִּׁעְבּוּד לִגְאֻלָּה,</tei:l>
          <tei:l>הַשְׁתָּא בַּעֲגָלָא</tei:l>
          <tei:l>וּבִזְמַן קָרִיב.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
