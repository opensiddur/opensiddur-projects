  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:shalom_lekh_dodi_gabirol">
        <tei:head>Shalom Lekh (l'Ven) Dodi, by Shlomo ibn Gabirol (ca. 11th c.)</tei:head>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shalom_lekh_dodi_gabirol/1"/>
        <tei:lg>
          <tei:l>Hello, my dear</tei:l>
          <tei:l>Pure and ruddy</tei:l>
          <tei:l>Hello, already</tei:l>
          <tei:l>Beautiful as a pomegranate</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shalom_lekh_dodi_gabirol/2"/>
        <tei:lg>
          <tei:l>Run to meet your sister</tei:l>
          <tei:l>Go out to save her</tei:l>
          <tei:l>Successful as the son of Yishai</tei:l>
          <tei:l>Out of all the people</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shalom_lekh_dodi_gabirol/3"/>
        <tei:lg>
          <tei:l>Why o beautiful</tei:l>
          <tei:l>Do you tempt love</tei:l>
          <tei:l>And make your voice</tei:l>
          <tei:l>Ring like a bell?</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shalom_lekh_dodi_gabirol/4"/>
        <tei:lg>
          <tei:l>The time that it wishes</tei:l>
          <tei:l>I will hasten love</tei:l>
          <tei:l>In its time I will come to you</tei:l>
          <tei:l>Like dew on mount Hermon.</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
