  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:amar_kiris_lemosheh">
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_kiris_lemosheh/1"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">אֲ</tei:seg>מַר קִירִיס לְמֹשֶׁה מִן־גוֹ שְׁכִינְתָּה</tei:l>
          <tei:l><tei:seg type="acrostic">בְּ</tei:seg>גִין מָה אַתְּ דָּחִיל מִן־מוֹתָה</tei:l>
          <tei:l><tei:seg type="acrostic">גְּ</tei:seg>זָרִית עַל כׇּל־בִּירְיְתָה</tei:l>
          <tei:l><tei:seg type="acrostic">דַּ</tei:seg>ע דְּתַמָּן אִינּוּן כׇּל־אֲבָהָתָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_kiris_lemosheh/2"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">הֲ</tei:seg>לָא מְשֶׁה כַּד שְׁמַע מִלְּתָה</tei:l>
          <tei:l><tei:seg type="acrostic">וּ</tei:seg>בָהִיא שַׁעֲתָה אֲזַל לְחֶבְרוֹן רַבְּתָה</tei:l>
          <tei:l><tei:seg type="acrostic">זְ</tei:seg>עַק וּקְרָא לְאָדָם מִן־גוֹ קְבוּרְתָּה</tei:l>
          <tei:l><tei:seg type="acrostic">חֲ</tei:seg>מֵי לִי לְמָה חֲטִיתָה בְּגוֹ גִּנְּתָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_kiris_lemosheh/3"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">טְ</tei:seg>עַמְתָּ וַאֲכַלְתָּ מִן אִילָן דַּעְתָּה</tei:l>
          <tei:l><tei:seg type="acrostic">יְ</tei:seg>הַבְתָּ לִבְנָיךְ בְּכִיתָה וְאַלִּיתָה</tei:l>
          <tei:l><tei:seg type="acrostic">כׇּ</tei:seg>ל־גִּנְּתָה הַוָת קֳדָמָיךְ וְלָא שְׂבַעְתָּה</tei:l>
          <tei:l><tei:seg type="acrostic">לְ</tei:seg>מָה בְּפִקּוּדוֹי דְּקִירִיס מְרַדְתָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_kiris_lemosheh/4"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">מַ</tei:seg>ן־אַתְּ אֲמַר לֵיהּ אָדָם בְּחוּכְמְתָה</tei:l>
          <tei:l><tei:seg type="acrostic">נֵ</tei:seg>דַע אִן אִית בָּךְ דַּעַת בִּינְתָה</tei:l>
          <tei:l><tei:seg type="acrostic">סִ</tei:seg>ימָן קְשֵׁה הוּא דֵּן דְּעוֹרַרְתָּ יָתִי מִן־שִׁנְתָה</tei:l>
          <tei:l><tei:seg type="acrostic">עֲ</tei:seg>נָה וַאֲמַר אֲנָה הוּא מֹשֶׁה דְּקַבֵּלִית אוֹרַיתָה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_kiris_lemosheh/5"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">פְּ</tei:seg>תַח פֻּמֵהּ וַאֲמַר לֵיהּ אִתְּבּוֹנַן מָה קְרֵיתָה</tei:l>
          <tei:l><tei:seg type="acrostic">צֲ</tei:seg>פֵי דִּתְרֵין אַלְפִין דִּשְׁנִין קַדְמַת יָתִי אוֹרַיתָה</tei:l>
          <tei:l><tei:seg type="acrostic">קַ</tei:seg>בֵּיל עָלָיךְ מֹשֶׁה כָּס מוֹתָה</tei:l>
          <tei:l><tei:seg type="acrostic">רְ</tei:seg>שִׁים הוּא שְׁמִי לְמוֹתָה וְלִי לְמָה אוֹכַחְתָּה</tei:l>
        </tei:lg>
        <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:amar_kiris_lemosheh/6"/>
        <tei:lg>
          <tei:l><tei:seg type="acrostic">שְׁ</tei:seg>מַע מֹשֶׁה וְזַלְגַת בֵּיהּ דִּמְעֲתָה</tei:l>
          <tei:l><tei:seg type="acrostic">תִּ</tei:seg>תְנַיַּיח נַפְשָׁךְ עִם־כׇּל־אֲבָהָתָה׃</tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
